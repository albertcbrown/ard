// Jenkins multibranch job `ard-ci`: the checks for every same-repository branch, pull request and release tag Jenkins
// builds (never forks, never worker/* branches; the job definition decides that).
//
// This file runs from whatever branch is built, so it binds NO credential. Its agent is the Jenkins pod template
// `ard-ci`, defined with the job (no service account token, no credential); nothing here may bring its own pod.
// Publishing is not done here: on `main` it starts `ard-build`, and on a release tag `ard-release`. Those jobs keep their
// Jenkinsfiles outside this repository and refuse any start but this job's `main` build (or the tag's own build) and a
// person.
//
// It is a protected path (.ard/config.yaml merge.protected_paths: Jenkinsfile*), so ard's merger never lands a change to
// it without a human approval.

def releaseTag = /^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$/

pipeline {
    agent {
        kubernetes {
            inheritFrom 'ard-ci'
            defaultContainer 'golang'
        }
    }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    stages {
        stage('lint') {
            steps {
                sh 'git config --global --add safe.directory "*"'
                sh 'make lint'
            }
        }
        stage('test') {
            steps {
                sh 'make test'
            }
        }
        stage('build') {
            steps {
                sh 'make build'
            }
        }
        stage('chart-test') {
            steps {
                container('helm') {
                    sh 'apk add --no-cache bash yq >/dev/null && make chart-test'
                }
            }
        }
        stage('publish') {
            // Only main, after every stage above passed. The commit is passed in full; ard-build checks it is on main.
            when { branch 'main' }
            steps {
                script {
                    def commit = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                    build job: '/ard-build', wait: false, parameters: [string(name: 'GIT_COMMIT', value: commit)]
                }
            }
        }
        stage('release') {
            // Only a tag vX.Y.Z (no pre-release suffix); ard-release checks the tag again and that its commit is on main.
            when { tag pattern: '^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$', comparator: 'REGEXP' }
            steps {
                script {
                    if (!(env.TAG_NAME ==~ releaseTag)) {
                        error("not a release tag: ${env.TAG_NAME}")
                    }
                    build job: '/ard-release', wait: false, parameters: [string(name: 'TAG', value: env.TAG_NAME)]
                }
            }
        }
    }
}
