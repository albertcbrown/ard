{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EZNngXoeEQc1Qtrzze3Enc","type":"tool_result","content":"# Release: build ard with GoReleaser and attach the archives and checksums to\n# the notes-only release version.yml created for a v* tag, then update the\n# Homebrew cask in albertcbrown/homebrew-tap.\n#\n# Inert until switched on: it does nothing unless the repository variable\n# ARD_VERSIONING is \"on\" and the release environment holds TAP_GITHUB_TOKEN\n# (a token that can push to albertcbrown/homebrew-tap only). Without the token\n# it says so and stops; it never half-publishes.\n#\n# Only the newest v* tag is released on a tag push, so version.yml's backfill\n# of many historical tags does not publish one release per tag. Use\n# workflow_dispatch with a tag to build an older one on purpose.\n#\n# Settings and recovery: docs/runbooks/release.md. Design: docs/proposal.md\n# (Delivery) and #177.\nname: release\n\non:\n  push:\n    tags: ['v*']\n  workflow_dispatch:\n    inputs:\n      tag:\n        description: Tag to release (vX.Y.Z); must already have a release\n        required: true\n        type: string\n\n# One release at a time; never cancel one that is uploading.\nconcurrency:\n  group: release\n  cancel-in-progress: false\n\npermissions:\n  contents: read\n\njobs:\n  release:\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n    environment: release\n    permissions:\n      contents: write # upload assets to the existing release only\n    env:\n      ENABLED: ${{ vars.ARD_VERSIONING }}\n      EVENT: ${{ github.event_name }}\n      PUSHED_TAG: ${{ github.ref_name }}\n      INPUT_TAG: ${{ inputs.tag }}\n      HAS_TAP_TOKEN: ${{ secrets.TAP_GITHUB_TOKEN != '' }}\n    steps:\n      - name: Decide\n        id: decide\n        shell: bash\n        run: |\n          set -euo pipefail\n          skip() { echo \"::notice title=release::$1\"; echo \"run=false\" >>\"$GITHUB_OUTPUT\"; exit 0; }\n          [[ \"${ENABLED:-}\" == on ]] || skip \"ARD_VERSIONING is not on; nothing to release\"\n          [[ \"${HAS_TAP_TOKEN:-}\" == true ]] || skip \"the release environment has no TAP_GITHUB_TOKEN; create the tap token first (docs/runbooks/release.md)\"\n          if [[ \"$EVENT\" == workflow_dispatch ]]; then tag=$INPUT_TAG; else tag=$PUSHED_TAG; fi\n          [[ \"$tag\" =~ ^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$ ]] || { echo \"::error title=release::not a vX.Y.Z tag: $tag\"; exit 2; }\n          echo \"tag=$tag\" >>\"$GITHUB_OUTPUT\"\n          echo \"run=true\" >>\"$GITHUB_OUTPUT\"\n\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0\n        if: steps.decide.outputs.run == 'true'\n        with:\n          ref: refs/tags/${{ steps.decide.outputs.tag }}\n          fetch-depth: 0\n          fetch-tags: true\n          persist-credentials: false\n\n      - name: Newest tag only on push\n        id: newest\n        if: steps.decide.outputs.run == 'true'\n        shell: bash\n        env:\n          TAG: ${{ steps.decide.outputs.tag }}\n        run: |\n          set -euo pipefail\n          newest=$(git tag -l 'v*' | grep -E '^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$' | sort -V | tail -n 1)\n          if [[ \"$EVENT\" == push && \"$TAG\" != \"$newest\" ]]; then\n33-    name: ard\n34-\n35:homebrew_casks:\n36-  - name: ard\n37-    directory: Casks\n38-    homepage: https://github.com/albertcbrown/ard\n39-    description: Autonomous repository development agents driven by GitHub issues\n40-    # The token comes from the environment of the release workflow.\n41-    repository:\n42-      owner: albertcbrown\n43-      name: homebrew-tap\n44-      token: \"{{ .Env.TAP_GITHUB_TOKEN }}\"\n45-    url:\n46-      template: \"https://github.com/albertcbrown/ard/releases/download/{{ .Tag }}/{{ .ArtifactName }}\"\n47-    dependencies:\n--\n52-    # Accepted risk (see docs/proposal.md): the binary is not signed or notarized\n53-    # yet, so Gatekeeper's quarantine flag is cleared after install.\n54:    hooks:\n55-      post:\n56-        install: |\n57-          system_command \"/usr/bin/xattr\",\n58-                         args: [\"-dr\", \"com.apple.quarantine\", \"#{staged_path}/ard\"]","is_error":false}]},"parent_tool_use_id":null,"session_id":"45379bcf-1105-43f4-9d7c-90b4cdbd049a","uuid":"b6bca927-14c3-47f3-80c9-96cf8376308b","timestamp":"2026-11-25T08:50:18.851Z","tool_use_result":{"stdout":"# Release: build ard with GoReleaser and attach the archives and checksums to\n# the notes-only release version.yml created for a v* tag, then update the\n# Homebrew cask in albertcbrown/homebrew-tap.\n#\n# Inert until switched on: it does nothing unless the repository variable\n# ARD_VERSIONING is \"on\" and the release environment holds TAP_GITHUB_TOKEN\n# (a token that can push to albertcbrown/homebrew-tap only). Without the token\n# it says so and stops; it never half-publishes.\n#\n# Only the newest v* tag is released on a tag push, so version.yml's backfill\n# of many historical tags does not publish one release per tag. Use\n# workflow_dispatch with a tag to build an older one on purpose.\n#\n# Settings and recovery: docs/runbooks/release.md. Design: docs/proposal.md\n# (Delivery) and #177.\nname: release\n\non:\n  push:\n    tags: ['v*']\n  workflow_dispatch:\n    inputs:\n      tag:\n        description: Tag to release (vX.Y.Z); must already have a release\n        required: true\n        type: string\n\n# One release at a time; never cancel one that is uploading.\nconcurrency:\n  group: release\n  cancel-in-progress: false\n\npermissions:\n  contents: read\n\njobs:\n  release:\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n    environment: release\n    permissions:\n      contents: write # upload assets to the existing release only\n    env:\n      ENABLED: ${{ vars.ARD_VERSIONING }}\n      EVENT: ${{ github.event_name }}\n      PUSHED_TAG: ${{ github.ref_name }}\n      INPUT_TAG: ${{ inputs.tag }}\n      HAS_TAP_TOKEN: ${{ secrets.TAP_GITHUB_TOKEN != '' }}\n    steps:\n      - name: Decide\n        id: decide\n        shell: bash\n        run: |\n          set -euo pipefail\n          skip() { echo \"::notice title=release::$1\"; echo \"run=false\" >>\"$GITHUB_OUTPUT\"; exit 0; }\n          [[ \"${ENABLED:-}\" == on ]] || skip \"ARD_VERSIONING is not on; nothing to release\"\n          [[ \"${HAS_TAP_TOKEN:-}\" == true ]] || skip \"the release environment has no TAP_GITHUB_TOKEN; create the tap token first (docs/runbooks/release.md)\"\n          if [[ \"$EVENT\" == workflow_dispatch ]]; then tag=$INPUT_TAG; else tag=$PUSHED_TAG; fi\n          [[ \"$tag\" =~ ^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$ ]] || { echo \"::error title=release::not a vX.Y.Z tag: $tag\"; exit 2; }\n          echo \"tag=$tag\" >>\"$GITHUB_OUTPUT\"\n          echo \"run=true\" >>\"$GITHUB_OUTPUT\"\n\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0\n        if: steps.decide.outputs.run == 'true'\n        with:\n          ref: refs/tags/${{ steps.decide.outputs.tag }}\n          fetch-depth: 0\n          fetch-tags: true\n          persist-credentials: false\n\n      - name: Newest tag only on push\n        id: newest\n        if: steps.decide.outputs.run == 'true'\n        shell: bash\n        env:\n          TAG: ${{ steps.decide.outputs.tag }}\n        run: |\n          set -euo pipefail\n          newest=$(git tag -l 'v*' | grep -E '^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$' | sort -V | tail -n 1)\n          if [[ \"$EVENT\" == push && \"$TAG\" != \"$newest\" ]]; then\n33-    name: ard\n34-\n35:homebrew_casks:\n36-  - name: ard\n37-    directory: Casks\n38-    homepage: https://github.com/albertcbrown/ard\n39-    description: Autonomous repository development agents driven by GitHub issues\n40-    # The token comes from the environment of the release workflow.\n41-    repository:\n42-      owner: albertcbrown\n43-      name: homebrew-tap\n44-      token: \"{{ .Env.TAP_GITHUB_TOKEN }}\"\n45-    url:\n46-      template: \"https://github.com/albertcbrown/ard/releases/download/{{ .Tag }}/{{ .ArtifactName }}\"\n47-    dependencies:\n--\n52-    # Accepted risk (see docs/proposal.md): the binary is not signed or notarized\n53-    # yet, so Gatekeeper's quarantine flag is cleared after install.\n54:    hooks:\n55-      post:\n56-        install: |\n57-          system_command \"/usr/bin/xattr\",\n58-                         args: [\"-dr\", \"com.apple.quarantine\", \"#{staged_path}/ard\"]","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01EZNngXoeEQc1Qtrzze3Enc","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
