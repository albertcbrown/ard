); see the Guardrails section of the proposal.","+","+## Build from source","+","+```sh"," git clone https://github.com/albertcbrown/ard"," cd ard"," make build"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_01AQaqyspGxKX5YqqRgAbnzQ","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
