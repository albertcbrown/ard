n--- a/internal/github/types.go\n+++ b/internal/github/types.go\n@@ -284,3 +284,36 @@ type CheckRun struct {\n \tStatus      string // queued|in_progress|completed|waiting|requested|pending\n \tConclusion  string // set when Status is completed\n }\n+\n+// Ruleset is an active branch ruleset of a repository.\n+type Ruleset struct {\n+\tID          int64\n+\tName        string\n+\tTarget      string        // \"branch\"\n+\tEnforcement string        // \"active\"\n+\tBranches    []string      // ref_name include patterns, e.g. \"~DEFAULT_BRANCH\", \"refs/heads/main\"\n+\tExclude     []string      // ref_name exclude patterns\n+\tRules       []string      // rule types, e.g. \"pull_request\"\n+\tBypass      []BypassActor // who may bypass\n+}\n+\n+// BypassActor is one entry of a ruleset's bypass list.\n+type BypassActor struct {\n+\tActorType string // \"Integration\", \"Team\", \"RepositoryRole\", ...\n+\tActorID   int64\n+\tMode      string // \"always\" or \"pull_request\"\n+}\n+\n+// MergeSettings are the merge methods a repository allows.\n+type MergeSettings struct {\n+\tAllowRebaseMerge bool\n+\tAllowSquashMerge bool\n+\tAllowMergeCommit bool\n+}\n+\n+// AppInfo is the public data of a GitHub App.\n+type AppInfo struct {\n+\tID          int64\n+\tSlug        string\n+\tPermissions map[string]string // permission name -> \"read\" | \"write\" | \"admin\"\n+}\ndiff --git a/internal/setupcmd/cmd.go b/internal/setupcmd/cmd.go\nindex 29876f1..773a75c 100644\n--- a/internal/setupcmd/cmd.go\n+++ b/internal/setupcmd/cmd.go\n@@ -49,6 +49,8 @@ func Command(ctx context.Context, e *cli.Env, o cli.SetupOpts) error {\n \t}\n \td := Deps{\n \t\tReader:  rd,\n+\t\tPolicy:  rd,\n+\t\tRepo:    repo,\n \t\tWriter:  fx,\n \t\tDesired: want,\n \t\t// Placeholder until the shared permission check (#302) lands: the\ndiff --git a/internal/setupcmd/policy.go b/internal/setupcmd/policy.go\nnew file mode 100644\nindex 0000000..43bf4ee\n--- /dev/null\n+++ b/internal/setupcmd/policy.go\n@@ -0,0 +1,112 @@\n+package setupcmd\n+\n+import (\n+\t\"fmt\"\n+\t\"strings\"\n+\n+\t\"github.com/albertcbrown/ard/internal/github\"\n+)\n+\n+// The policy `ard setup` checks against. It is built in, never read from\n+// repository content or configuration: a pull request must not be able to\n+// weaken what checks it.\n+const (\n+\tpolicyBranch     = \"main\"\n+\tpolicyBypassMode = \"always\"\n+\tpolicyVersioning = \"ARD_VERSIONING\"\n+\tpolicyPRRule     = \"pull_request\"\n+)\n+\n+// forbiddenAppPerms are App permissions the ard App must not have.\n+var forbiddenAppPerms = []string{\"workflows\", \"administration\"}\n+\n+func rulesURL(r github.Repo) string { return \"https://github.com/\" + r.String() + \"/settings/rules\" }\n+\n+func installURL(r github.Repo) string {\n+\treturn \"https://github.com/\" + r.String() + \"/settings/installations\"\n+}\n+\n+// coversPolicyBranch reports whether a ruleset's ref conditions include main.\n+func coversPolicyBranch(rs github.Ruleset) bool {\n+\tref := \"refs/heads/\" + policyBranch\n+\tfor _, x := range rs.Exclude {\n+\t\tif x == ref {\n+\t\t\treturn false\n+\t\t}\n+\t}\n+\tfor _, x := range rs.Branches {\n+\t\tif x == ref || x == \"~DEFAULT_BRANCH\" || x == \"~ALL\" {\n+\t\t\treturn true\n+\t\t}\n+\t}\n+\treturn false\n+}\n+\n+// checkRuleset checks that main's active rulesets require a pull request and\n+// that the ard App is the only bypass actor, with mode always.\n+func checkRuleset(repo github.Repo, rs []github.Ruleset, app github.AppInfo) Row {\n+\tvar problems []string\n+\thasPR := false\n+\tappBypass := false\n+\tfor _, r := range rs {\n+\t\tif r.Enforcement != \"active\" || r.Target != \"branch\" || !coversPolicyBranch(r) {\n+\t\t\tcontinue\n+\t\t}\n+\t\tfor _, t := range r.Rules {\n+\t\t\tif t == policyPRRule {\n+\t\t\t\thasPR = true\n+\t\t\t}\n+\t\t}\n+\t\tfor _, b := range r.Bypass {\n+\t\t\tisApp := b.ActorType == \"Integration\" && b.ActorID == app.ID\n+\t\t\tswitch {\n+\t\t\tcase isApp && b.Mode == policyBypassMode:\n+\t\t\t\tappBypass = true\n+\t\t\tcase isApp:\n+\t\t\t\tproblems = append(problems, fmt.Sprintf(\"the App's bypass mode is %q in ruleset %q, want %q\", b.Mode, r.Name, policyBypassMode))\n+\t\t\tdefault:\n+\t\t\t\tproblems = append(problems, fmt.Sprintf(\"unexpected bypass actor %s %d (%s) in ruleset %q\", b.ActorType, b.ActorID, b.Mode, r.Name))\n+\t\t\t}\n+\t\t}\n+\t}\n+\tif !hasPR {\n+\t\tproblems = append(problems, \"no active ruleset on \"+policyBranch+\" requires a pull request\")\n+\t}\n+\tif !appBypass {\n+\t\tproblems = append(problems, fmt.Sprintf(\"the ard App is not an %q bypass actor\", policyBypassMode))\n+\t}\n+\tif len(problems) == 0 {\n+\t\treturn Row{Name: rulesetName, Status: StatusOK, Detail: policyBranch + \" requires a pull request; only the ard App bypasses\"}\n+\t}\n+\treturn Row{Name: rulesetName, Status: StatusDrift, Detail: strings.Join(problems, \"; \") + \". Fix in \" + rulesURL(repo)}\n+}\n+\n+// checkAppPerms checks the App holds none of the forbidden permissions.\n+func checkAppPerms(repo github.Repo, app github.AppInfo) Row {\n+\tvar bad []string\n+\tfor _, p := range forbiddenAppPerms {\n+\t\tif lvl, ok := app.Permissions[p]; ok && lvl != \"\" {\n+\t\t\tbad = append(bad, p)\n+\t\t}\n+\t}\n+\tif len(bad) == 0 {\n+\t\treturn Row{Name: appPermName, Status: StatusOK, Detail: \"no workflows or administration permission\"}\n+\t}\n+\treturn Row{Name: appPermName, Status: StatusDrift, Detail: \"the App has the \" + strings.Join(bad, \", \") + \" permission; remove it in \" + installURL(repo)}\n+}\n+\n+// checkMerge checks that rebase merge is off when versioning is on.\n+func checkMerge(repo github.Repo, ms github.MergeSettings, versioning bool) Row {\n+\tif versioning && ms.AllowRebaseMerge {\n+\t\treturn Row{Name: mergeName, Status: StatusDrift, Detail: fmt.Sprintf(\"allow_rebase_merge is on while %s is on; run: gh api -X PATCH repos/%s -F allow_rebase_merge=false\", policyVersioning, repo)}\n+\t}\n+\treturn Row{Name: mergeName, Status: StatusOK, Detail: \"merge settings match the policy\"}\n+}\n+\n+func versioningOn(v string) bool {\n+\tswitch strings.ToLower(strings.TrimSpace(v)) {\n+\tcase \"1\", \"true\", \"on\", \"yes\":\n+\t\treturn true\n+\t}\n+\treturn false\n+}\ndiff --git a/internal/setupcmd/policy_test.go b/internal/setupcmd/policy_test.go\nnew file mode 100644\nindex 0000000..193f3e0\n--- /dev/null\n+++ b/internal/setupcmd/policy_test.go\n@@ -0,0 +1,221 @@\n+package setupcmd\n+\n+import (\n+\t\"bytes\"\n+\t\"context\"\n+\t\"io\"\n+\t\"strings\"\n+\t\"testing\"\n+\n+\t\"github.com/albertcbrown/ard/internal/github\"\n+\t\"github.com/albertcbrown/ard/internal/github/fake\"\n+)\n+\n+var testRepo = github.Repo{Owner: \"o\", Name: \"r\"}\n+\n+const appSlug = \"ard-test\" // the fake's identity is ard-test[bot]\n+\n+var appBypass = github.BypassActor{ActorType: \"Integration\", ActorID: 77, Mode: \"always\"}\n+\n+func goodRuleset() github.Ruleset {\n+\treturn github.Ruleset{ID: 1, Name: \"main\", Target: \"branch\", Enforcement: \"active\",\n+\t\tBranches: []string{\"~DEFAULT_BRANCH\"}, Rules: []string{\"deletion\", \"pull_request\"}, Bypass: []github.BypassActor{appBypass}}\n+}\n+\n+// policyFake returns a fake that satisfies the whole policy.\n+func policyFake() *fake.Fake {\n+\tf := fake.New()\n+\tf.SetApp(appSlug, github.AppInfo{ID: 77, Permissions: map[string]string{\"contents\": \"write\", \"pull_requests\": \"write\"}})\n+\tf.SetRulesets(goodRuleset())\n+\treturn f\n+}\n+\n+func policyDeps(f *fake.Fake) Deps {\n+\td := deps(f)\n+\td.Policy, d.Repo = f, testRepo\n+\treturn d\n+}\n+\n+func row(t *testing.T, r Report, name string) Row {\n+\tt.Helper()\n+\tfor _, x := range r.Rows {\n+\t\tif x.Name == name {\n+\t\t\treturn x\n+\t\t}\n+\t}\n+\tt.Fatalf(\"no %s row in %+v\", name, r.Rows)\n+\treturn Row{}\n+}\n+\n+func runCheck(t *testing.T, f *fake.Fake) Report {\n+\tt.Helper()\n+\trep, err := Run(context.Background(), policyDeps(f), Opts{Check: true}, io.Discard)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\treturn rep\n+}\n+\n+func TestPolicyAllOK(t *testing.T) {\n+\trep := runCheck(t, policyFake())\n+\tfor _, n := range []string{rulesetName, appPermName, mergeName} {\n+\t\tif r := row(t, rep, n); r.Status != StatusOK {\n+\t\t\tt.Errorf(\"%s = %+v\", n, r)\n+\t\t}\n+\t}\n+}\n+\n+func TestRulesetDrift(t *testing.T) {\n+\tother := github.BypassActor{ActorType: \"Team\", ActorID: 5, Mode: \"always\"}\n+\tpr := func(m string) github.BypassActor { a := appBypass; a.Mode = m; return a }\n+\tcases := []struct {\n+\t\tname   string\n+\t\tmut    func(*github.Ruleset)\n+\t\trs     []github.Ruleset // replaces the single ruleset when set\n+\t\tdetail string\n+\t}{\n+\t\t{\"no pull request\", func(r *github.Ruleset) { r.Rules = []string{\"deletion\"} }, nil, \"requires a pull request\"},\n+\t\t{\"extra bypass\", func(r *github.Ruleset) { r.Bypass = append(r.Bypass, other) }, nil, \"unexpected bypass actor Team 5\"},\n+\t\t{\"pull_request mode\", func(r *github.Ruleset) { r.Bypass = []github.BypassActor{pr(\"pull_request\")} }, nil, `bypass mode is \"pull_request\"`},\n+\t\t{\"app missing\", func(r *github.Ruleset) { r.Bypass = nil }, nil, \"not an \\\"always\\\" bypass actor\"},\n+\t\t{\"other branch\", func(r *github.Ruleset) { r.Branches = []string{\"refs/heads/dev\"} }, nil, \"requires a pull request\"},\n+\t\t{\"excluded\", func(r *github.Ruleset) { r.Exclude = []string{\"refs/heads/main\"} }, nil, \"requires a pull request\"},\n+\t\t{\"not active\", func(r *github.Ruleset) { r.Enforcement = \"evaluate\" }, nil, \"requires a pull request\"},\n+\t\t{\"none\", nil, []github.Ruleset{}, \"requires a pull request\"},\n+\t}\n+\tfor _, c := range cases {\n+\t\tt.Run(c.name, func(t *testing.T) {\n+\t\t\tf := policyFake()\n+\t\t\trs := []github.Ruleset{goodRuleset()}\n+\t\t\tif c.rs != nil {\n+\t\t\t\trs = c.rs\n+\t\t\t} else {\n+\t\t\t\tc.mut(&rs[0])\n+\t\t\t}\n+\t\t\tf.SetRulesets(rs...)\n+\t\t\tr := row(t, runCheck(t, f), rulesetName)\n+\t\t\tif r.Status != StatusDrift || !strings.Contains(r.Detail, c.detail) || !strings.Contains(r.Detail, \"https://github.com/o/r/settings/rules\") {\n+\t\t\t\tt.Errorf(\"row = %+v\", r)\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+func TestRulesetsUnion(t *testing.T) {\n+\tf := policyFake()\n+\ta, b := goodRuleset(), goodRuleset()\n+\ta.Rules, a.Bypass = []string{\"pull_request\"}, nil\n+\tb.ID, b.Rules, b.Branches = 2, []string{\"deletion\"}, []string{\"refs/heads/main\"}\n+\tf.SetRulesets(a, b)\n+\tif r := row(t, runCheck(t, f), rulesetName); r.Status != StatusOK {\n+\t\tt.Errorf(\"row = %+v\", r)\n+\t}\n+}\n+\n+func TestRulesetForbiddenIsManual(t *testing.T) {\n+\tf := policyFake()\n+\tf.FailNext(\"ListRulesets\", github.ErrForbidden)\n+\tvar out bytes.Buffer\n+\trep, err := Run(context.Background(), policyDeps(f), Opts{Check: true}, &out)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tr := row(t, rep, rulesetName)\n+\tif r.Status != StatusManual || !strings.Contains(r.Detail, \"gh api repos/o/r/rulesets\") || rep.Green() {\n+\t\tt.Errorf(\"row = %+v\", r)\n+\t}\n+\tPrint(&out, rep, false)\n+\tif !strings.Contains(out.String(), \"manual: ruleset: \") {\n+\t\tt.Errorf(\"out = %q\", out.String())\n+\t}\n+}\n+\n+func TestAppPerms(t *testing.T) {\n+\tfor _, p := range []string{\"workflows\", \"administration\"} {\n+\t\tf := policyFake()\n+\t\tf.SetApp(appSlug, github.AppInfo{ID: 77, Permissions: map[string]string{p: \"write\"}})\n+\t\tr := row(t, runCheck(t, f), appPermName)\n+\t\tif r.Status != StatusDrift || !strings.Contains(r.Detail, p) || !strings.Contains(r.Detail, \"settings/installations\") {\n+\t\t\tt.Errorf(\"%s: row = %+v\", p, r)\n+\t\t}\n+\t}\n+}\n+\n+func TestAppUnknownIsManual(t *testing.T) {\n+\tf := fake.New()\n+\tf.SetRulesets(goodRuleset())\n+\trep := runCheck(t, f)\n+\tfor _, n := range []string{rulesetName, appPermName} {\n+\t\tif r := row(t, rep, n); r.Status != StatusManual || !strings.Contains(r.Detail, \"gh api apps/\"+appSlug) {\n+\t\t\tt.Errorf(\"%s = %+v\", n, r)\n+\t\t}\n+\t}\n+}\n+\n+func TestMergeRebaseVersioning(t *testing.T) {\n+\tfor _, c := range []struct {\n+\t\tval    string\n+\t\tset    bool\n+\t\trebase bool\n+\t\twant   Status\n+\t}{\n+\t\t{\"on\", true, true, StatusDrift},\n+\t\t{\"true\", true, false, StatusOK},\n+\t\t{\"off\", true, true, StatusOK},\n+\t\t{\"\", false, true, StatusOK},\n+\t} {\n+\t\tf := policyFake()\n+\t\tf.SetMergeSettings(github.MergeSettings{AllowRebaseMerge: c.rebase})\n+\t\tif c.set {\n+\t\t\tf.SetVariable(\"ARD_VERSIONING\", c.val)\n+\t\t}\n+\t\tr := row(t, runCheck(t, f), mergeName)\n+\t\tif r.Status != c.want {\n+\t\t\tt.Errorf(\"%+v: row = %+v\", c, r)\n+\t\t}\n+\t\tif c.want == StatusDrift && !strings.Contains(r.Detail, \"gh api -X PATCH repos/o/r -F allow_rebase_merge=false\") {\n+\t\t\tt.Errorf(\"detail = %q\", r.Detail)\n+\t\t}\n+\t}\n+}\n+\n+func TestMergeVariableForbiddenIsManual(t *testing.T) {\n+\tf := policyFake()\n+\tf.FailNext(\"GetVariable\", github.ErrForbidden)\n+\tif r := row(t, runCheck(t, f), mergeName); r.Status != StatusManual || !strings.Contains(r.Detail, \"gh variable get\") {\n+\t\tt.Errorf(\"row = %+v\", r)\n+\t}\n+}\n+\n+func TestChecksNeverWrite(t *testing.T) {\n+\tf := policyFake()\n+\tf.SetMergeSettings(github.MergeSettings{AllowRebaseMerge: true})\n+\tf.SetVariable(\"ARD_VERSIONING\", \"on\")\n+\trunCheck(t, f)\n+\tif n := len(f.Writes()); n != 0 {\n+\t\tt.Errorf(\"writes = %d\", n)\n+\t}\n+}\n+\n+func TestPolicyDriftBlocksApply(t *testing.T) {\n+\tf := policyFake()\n+\tf.SetRulesets()\n+\trep, err := Run(context.Background(), policyDeps(f), Opts{}, io.Discard)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif r := labelRow(t, rep); r.Status != StatusDrift || len(f.Writes()) != 0 {\n+\t\tt.Errorf(\"labels = %+v writes = %d\", r, len(f.Writes()))\n+\t}\n+}\n+\n+func TestPolicyGreenStillApplies(t *testing.T) {\n+\tf := policyFake()\n+\trep, err := Run(context.Background(), policyDeps(f), Opts{}, io.Discard)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}