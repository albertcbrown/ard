redCheck{Context: c.Context, IntegrationID: c.GetIntegrationID()})\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\treturn out, nextPage(resp), nil\n\t})\n\tif err != nil {\n\t\terr = h.fail(ctx, fmt.Sprintf(\"required checks of %q\", branch), 0, err)\n\t\t// Only a failure on the first page means \"no rules API\"; a later page\n\t\t// failing after page 1 read fine is an ordinary error.\n\t\tif failedPage <= 1 && rulesUnavailable(err) {\n\t\t\treturn RequiredChecksResult{}, nil\n\t\t}\n\t\treturn RequiredChecksResult{}, err\n\t}\n\tres := RequiredChecksResult{Available: true, Checks: normalizeChecks(items)}\n\tfor k := range unevaluated {\n\t\tres.Unevaluated = append(res.Unevaluated, k)\n\t}\n\tsort.Strings(res.Unevaluated)\n\treturn res, nil\n}\n\t\t\tout[i] = s\n\t\t}\n\t}\n\treturn out\n}\n\nfunc (h *HTTP) AppID(ctx context.Context, slug string) (int64, error) {\n\tapp, _, err := h.gh.Apps.Get(ctx, slug)\n\tif err != nil {\n\t\treturn 0, h.fail(ctx, fmt.Sprintf(\"get app %s\", slug), 0, err)\n\t}\n\treturn app.GetID(), nil\n}\n\n// ---- Writer ----\n\nfunc (h *HTTP) CreateIssue(ctx context.Context, in NewIssue) (Issue, error) {\n\treq := &gogh.IssueRequest{Title: &in.Title, Body: &in.Body}\n\tif len(in.Labels) > 0 {\n\t\treq.Labels = &in.Labels\n\t}\n\ti, _, err := h.gh.Issues.Create(ctx, h.o(), h.r(), req)\n\tif err != nil {\n\t\treturn Issue{}, h.fail(ctx, \"create issue\", 0, err)\n\t}\n\treturn issueFrom(i), nil\n}\n\nfunc (h *HTTP) UpdateIssue(ctx context.Context, n int, u IssueUpdate) error {\n\treq := &gogh.IssueRequest{Title: u.Title, Body: u.Body}\n\tif u.State != nil {\n\t\ts := string(*u.State)\n\t\treq.State = &s\n\t}\n\tif u.StateReason != nil {\n\t\ts := string(*u.StateReason)\n\t\treq.StateReason = &s\n\t}\n\t_, _, err := h.gh.Issues.Edit(ctx, h.o(), h.r(), n, req)\n\treturn h.fail(ctx, fmt.Sprintf(\"update issue %d\", n), n, err)\n}\n\nfunc (h *HTTP) PinIssue(ctx context.Context, n int) error {\n\tis, err := h.GetIssue(ctx, n)\n\tif err != nil {\n\t