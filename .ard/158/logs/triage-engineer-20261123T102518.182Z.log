returns the longest variant starting at b[i], or nil.\nfunc (s *Secrets) matchAt(b []byte, i int) *variant {\n\tfor _, idx := range s.byFirst[b[i]] {\n\t\tv := &s.variants[idx]\n\t\tend := i + len(v.text)\n\t\tif len(b) < end || string(b[i:end]) != string(v.text) {\n\t\t\tcontinue\n\t\t}\n\t\tif v.boundary && end < len(b) && isNameByte(b[end]) {\n\t\t\tcontinue // not at a path boundary: try a shorter candidate\n\t\t}\n\t\treturn v\n\t}\n\treturn nil\n}\ndoc.go\nentropy.go\nhelpers_test.go\nhostpath.go\nhostpath_test.go\npath.go\npath_test.go\nrace_off_test.go\nrace_on_test.go\nredact.go\nredact_test.go\nreplace.go\nrules.go\nscan.go\nscan_test.go\nsecrets.go\nsecrets_test.go\ntruncate.go\ntruncate_test.go\n(eval):1: no matches found: --include=*.go\n14:  protected_paths:\n15-    - .github/\n16-    - .ard/config.yaml\n17-    - .ard/scanners/\n18-    - .ard/triage/\n19-    - .ard/workers/\n20-    - .ard/reviewers/\n21-    - \"**/CODEOWNERS\"\n22-    # Agent instructions a PR could plant to steer later agents.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_011jubZfvyRDnsQCfDjgNJAj","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
