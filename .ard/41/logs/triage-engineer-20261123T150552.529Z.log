ateComment(ctx context.Context, n int, body string) (Comment, error)\n41:\tCreatePR(ctx context.Context, in NewPR) (PullRequest, error)\n42:\tUpdatePR(ctx context.Context, n int, u PRUpdate) error\n43:\tMarkReady(ctx context.Context, n int) error                             // GraphQL markPullRequestReadyForReview\n44:\tCreateReview(ctx context.Context, n int, in ReviewInput) (int64, error) // returns the review id\n45:\tUpdateBranch(ctx context.Context, n int, expectedHeadSHA string) error\n46:\tMergePR(ctx context.Context, n int, in MergeInput) (MergeResult, error)\n47:\tDeleteBranch(ctx context.Context, branch string) error // nil if already gone\n}\n\n// ambiguous reports more than one branch for one role and issue (only a human\n// can have made the second) and parks the issue. No job is claimed.\nfunc (l *Loop) ambiguous(ctx context.Context, log *slog.Logger, n int) {\n\tmarker := \"<!-- \" + labels.Prefix + \"worker branches -->\"\n\ttext := fmt.Sprintf(\"**ard · worker · not started**\\n\\nThere is more than one branch for this issue and worker role, so ard cannot tell which one to continue. \"+\n\t\t\"Delete the extra branch and remove `%s` to continue.\", labels.NeedsHuman)\n\tif err := agentjob.PostOnce(ctx, l.d.Reader, l.d.Effects, n, marker, text); err != nil {\n\t\tlog.Error(\"worker.ambiguous_failed\", \"error\", err)\n\t\treturn\n\t}\n\tif err := l.d.Effects.AddLabels(ctx, n, labels.NeedsHuman); err != nil {\n\t\tlog.Error(\"worker.ambiguous_failed\", \"error\", err)\n\t\treturn\n\t}\n\tlog.Warn(\"worker.ambiguous_branches\")\n}\n\nfunc (s *Store) AppendEvent(ctx context.Context, e Event) error {\n\tif e.Kind == \"\" {\n\t\treturn fmt.Errorf(\"append event: empty kind\")\n\t}\n\tif e.At.IsZero() {\n\t\te.At = s.now()\n\t}\n\treturn insertEvent(ctx, s.db, e)\n}\n\n// Events returns matching events in ascending id order.\npackage servecmd\n\nimport (\n\t\"github.com/albertcbrown/ard/internal/agent\"\n\t\"github.com/albertcbrown/ard/internal/agent/claude\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n\t\"github.com/albertcbrown/ard/internal/reviewer\"\n)\n\n// reviewerLoop builds the reviewer loop (#35). It reuses the process-wide\n// executor, Finisher and result parser, so it adds no second Closer,\n// committer or executor. It returns nil, and logs, when the executor cannot\n// be built.\nfunc reviewerLoop(w *wiring) controller.Loop {\n\tex, err := w.newExecutor()\n\tif err != nil {\n\t\tw.Log.Error(\"review.unavailable\", \"error\", err)\n\t\treturn nil\n\t}\n\tfin, err := w.finisher()\n\tif err != nil {\n\t\tw.Log.Error(\"review.unavailable\", \"error\", err)\n\t\treturn nil\n\t}\n\treg, err := agent.NewRegistry(claude.New(claude.Options{}))\n\tif err != nil {\n\t\tpanic(err) // a duplicate adapter name is a programming error\n\t}\n\treturn reviewer.New(reviewer.Deps{\n\t\tReader: w.Reader, Effects: w.Effects, Store: w.Store,\n\t\tExecutor: ex, Finisher: fin, Git: gitx.New(\"\"),\n\t\tPool:   func() reviewer.Offerer { return w.Pool() },\n\t\tAgents: reg, Parse: w.parseFunc(), Model: w.Model,\n\t\tRepo: w.Repo, RepoDir: w.Root, RemoteURL: w.RemoteURL, Token: w.Token, Log: w.Log,\n\t})\n}\ndocs/proposal.md:310:**Review feedback loops back here.** When any reviewer ends with `ard:review:<role>:changes`, the controller re-requests `ard:worker:<role>` on the issue and increments the round. The worker fixes on the same branch, and only the reviewers that asked for changes run again. The merger sends a PR back the same way when its branch conflicts with `main`. After `max_review_rounds` (default 3) the issue goes to `ard:needs-human`.\ndocs/proposal.md:353:It squash-merges with the worker's commit title and the `Ard-Job` trailer, then deletes the branch, so `.ard/<issue#>/` and its logs land on `main` with the code. If updating the branch conflicts, it re-requests the worker for a rebase round, which counts toward `max_review_rounds`.","is_error":false}]},"