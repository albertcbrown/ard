and the review runs again. The loop never edits the PR.\n//\n// # Marking ready\n//\n// After each close-out, and on every tick (so a restart cannot miss it), the\n// loop marks a draft App PR on a worker/ branch ready for review when every\n// requested review role is :done at the PR's current head (the head recorded\n// by its newest claim, ignoring commits that only touch .ard/<issue>/), and\n// none of :changes, :running, ard:executor:failed, ard:needs-human, ard:hold or\n// ard:tests:failed is set. It logs review.marked_ready; a failed MarkReady is\n// logged and retried next tick, never failing close-out. In --dry-run only the\n// effects ledger gets a line. It never converts a PR back to draft and never\n// merges.\n//\n// In --dry-run the loop logs review.would_claim and stops claiming: no fetch, no job\n// row, no pool slot, no label.\npackage reviewer\n      57 internal/reviewer/branch.go\n     165 internal/reviewer/candidates.go\n     115 internal/reviewer/candidates_test.go\n      61 internal/reviewer/doc.go\n     345 internal/reviewer/harness_test.go\n      26 internal/reviewer/input.go\n     236 internal/reviewer/loop.go\n     141 internal/reviewer/ready.go\n     260 internal/reviewer/ready_test.go\n     228 internal/reviewer/run.go\n     248 internal/reviewer/run_test.go\n      68 internal/reviewer/unit_test.go\n      85 internal/worker/branch.go\n     123 internal/worker/candidates.go\n     137 internal/worker/candidates_test.go\n      46 internal/worker/doc.go\n     159 internal/worker/facts.go\n     176 internal/worker/guard.go\n     479 internal/worker/harness_test.go\n     264 internal/worker/loop.go\n     876 internal/worker/loop_test.go\n     102 internal/worker/pr.go\n     825 internal/worker/run.go\n      27 internal/worker/type.go\n     235 internal/worker/unit_test.go\n     185 internal/closeout/review.go\n     709 internal/state/jobs.go\n    6378 total\n0001_init.sql\n0002_reaper.sql\n0003_admissions.sql\n0004_limits.sql\n0005_usage.sql\n0