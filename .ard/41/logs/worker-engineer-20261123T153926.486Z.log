{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CaXRbJ4fXw2qu8RLdp6rE6","type":"tool_result","content":"\t\treturn fmt.Errorf(\"%s job needs a positive issue, got %d\", n.Stage, n.Issue)\n\t}\n\tif len(n.Data) > 0 && !json.Valid(n.Data) {\n\t\treturn fmt.Errorf(\"claim data is not valid JSON\")\n\t}\n\treturn nil\n}\n\n// CreateJob is the claim record: in one transaction it mints the ULID,\n// inserts a running job with attempt 0 and appends a \"claim\" event.\n//\n// If the newest earlier job with the same stage, role and issue stopped at a\n// usage limit (limit_stop = 1) that no job re-runs yet, the new job is its\n// re-run: after_limit points at it and retry_of is copied from it. A limit\n// stop therefore neither uses up nor grants the automatic retry: a fresh job's\n// limit stop leaves its one retry unused, and the limit stop of an automatic\n// retry leaves its re-run still linked to the original, so it gets no second\n// retry.\n//\n// Otherwise, if the newest earlier job that failed into an automatic retry\n// (auto_retry = 1) is referenced by no job yet, the new job is that retry and\n// its retry_of points at it. Any other claim, including a human retry after a\n// plain failure, has retry_of unset. Only the first claim after a handoff or\n// a limit stop is linked.\nfunc (s *Store) CreateJob(ctx context.Context, n NewJob) (Job, error) {\n\tif err := n.validate(); err != nil {\n\t\treturn Job{}, fmt.Errorf(\"create job: %w\", err)\n\t}\n\tid, err := s.newID()\n\tif err != nil {\n\t\treturn Job{}, err\n\t}\n\tnow := s.now()\n\ttx, err := s.db.BeginTx(ctx, nil)\n\tif err != nil {\n\t\treturn Job{}, fmt.Errorf(\"create job: begin: %w\", err)\n\t}\n\tdefer tx.Rollback() //nolint:errcheck\n\tvar pr any\n\tif n.PR != 0 {\n\t\tpr = n.PR\n\t}\n\tvar branch any\n\tif n.Branch != \"\" {\n\t\tbranch = n.Branch\n\t}\n\tvar prevID string\n\tvar prevRetryOf sql.NullString\n\terr = tx.QueryRowContext(ctx, `SELECT p.id, p.retry_of FROM jobs p\n\t\tWHERE p.stage = ? AND p.role = ? AND p.issue = ?\n\t\tORDER BY p.created_at DESC, p.id DESC LIMIT 1`, n.Stage, n.Role, n.Issue).Scan(&prevID, &prevRetryOf)\n\tvar afterLimit, retryOf any\n\tswitch {\n\tcase errors.Is(err, sql.ErrNoRows):\n\tcase err != nil:\n\t\treturn Job{}, fmt.Errorf(\"claim %s/%s issue %d: find previous job: %w\", n.Stage, n.Role, n.Issue, err)\n\tdefault:\n\t\tvar limited int\n\t\tif err := tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM jobs p WHERE p.id = ? AND p.status = 'failed' AND p.limit_stop = 1\n\t\t\tAND NOT EXISTS (SELECT 1 FROM jobs c WHERE c.after_limit = p.id)`, prevID).Scan(&limited); err != nil {\n\t\t\treturn Job{}, fmt.Errorf(\"claim %s/%s issue %d: check limit stop: %w\", n.Stage, n.Role, n.Issue, err)\n\t\t}\n\t\tif limited > 0 {\n\t\t\tafterLimit = prevID\n\t\t\tif prevRetryOf.Valid {\n\t\t\t\tretryOf = prevRetryOf.String\n\t\t\t}\n\t\t}\n\t}\n\tretryExpr := `(SELECT p.id FROM jobs p WHERE p.stage = ? AND p.role = ? AND p.issue = ? AND p.auto_retry = 1\n\t\t     AND p.status = 'failed' AND NOT EXISTS (SELECT 1 FROM jobs c WHERE c.retry_of = p.id)\n\t\t   ORDER BY p.created_at DESC, p.id DESC LIMIT 1)`\n\targs := []any{id, n.Stage, n.Role, n.Issue, pr, branch}\n\tif afterLimit != nil {\n\t\tretryExpr = `?`\n\t\targs = append(args, retryOf)\n\t} else {\n\t\targs = append(args, n.Stage, n.Role, n.Issue)\n\t}\n\targs = append(args, afterLimit, now.Unix(), now.Unix())\n\tif _, err := tx.ExecContext(ctx, `INSERT INTO jobs(id, stage, role, issue, pr, status, attempt, branch, retry_of, after_limit, created_at, updated_at)\n\t\tVALUES(?,?,?,?,?,'running',0,?,`+retryExpr+`,?,?,?)`, args...); err != nil {\n\t\tif isUnique(err) {\n\t\t\treturn Job{}, fmt.Errorf(\"claim %s/%s issue %d: %w\", n.Stage, n.Role, n.Issue, ErrConflict)\n\t\t}\n\t\treturn Job{}, fmt.Errorf(\"claim %s/%s issue %d: %w\", n.Stage, n.Role, n.Issue, err)\n\t}\n\tif err := insertEvent(ctx, tx, Event{At: now, Kind: EventClaim, JobID: id, Issue: n.Issue, Stage: n.Stage, Role: n.Role, Data: n.Data}); err != nil {\n\t\treturn Job{}, err\n\t}\n\tif err := tx.Commit(); err != nil {\n\t\treturn Job{}, fmt.Errorf(\"claim job %s: commit: %w\", id, err)\n\t}\n\treturn s.Job(ctx, id)\n}\n\n\tif d.Poll <= 0 {\n\t\td.Poll = defaultPoll\n\t}\n\tif d.Now == nil {\n\t\td.Now = time.Now\n\t}\n\tif d.Log == nil {\n\t\td.Log = slog.Default()\n\t}\n\treturn &Loop{d: d}\n}\n\n// Name implements controller.Loop.\nfunc (*Loop) Name() string { return \"reviewers\" }\n\n// Interval implements controller.Loop.\nfunc (*Loop) Interval(c *config.Resolved) time.Duration {\n\tif c == nil || c.Intervals.Reviewers <= 0 {\n\t\treturn defaultInterval\n\t}\n\treturn time.Duration(c.Intervals.Reviewers)\n}\n\n// TickTimeout implements controller.TickTimeouter. A tick never waits for a\n// job.\nfunc (*Loop) TickTimeout(*config.Resolved) time.Duration { return 5 * time.Minute }\n\n// Claims implements controller.Loop: the loop is skipped while paused.\nfunc (*Loop) Claims() bool { return true }\n\nfunc (l *Loop) offer(cfg *config.Resolved, cands []pool.Candidate) []pool.Decision {\n30:type Job struct {\n31-\tID            string\n32-\tStage, Role   string\n33-\tIssue, PR     int // Issue is 0 only for stage scanner; PR 0 means none\n34-\tStatus        Status\n35-\tAttempt       int\n36-\tHandle        json.RawMessage // opaque executor handle (#18)\n37-\tCloseoutPhase string\n38-\tCloseoutPlan  json.RawMessage\n39-\tFailReason    string\n40-\tKeepUntil     time.Time\n41-\tCleanedAt     time.Time\n42-\tCostUSD       *float64\n43-\tCreatedAt     time.Time\n44-\tUpdatedAt     time.Time\n45-\tEndedAt       time.Time\n46-\t// Branch is the branch close-out commits to (worker and review jobs).\n47-\tBranch string\n48-\t// RetryOf is the id of the failed job this job is the automatic retry of.\n49-\tRetryOf string\n50-\t// AutoRetry is true when this failed job handed off to one automatic retry.\n51-\tAutoRetry bool\n52-\t// KillReason is why the Reaper killed the job, set before the kill.","is_error":false}]},"parent_tool_use_id":null,"session_id":"cdc0f494-ef68-48c0-8855-e4e66ae11845","uuid":"e2d53a93-890f-4216-a2a4-3ab3504fb471","timestamp":"2026-11-23T15:39:40.845Z","tool_use_result":{"stdout":"\t\treturn fmt.Errorf(\"%s job needs a positive issue, got %d\", n.Stage, n.Issue)\n\t}\n\tif len(n.Data) > 0 && !json.Valid(n.Data) {\n\t\treturn fmt.Errorf(\"claim data is not valid JSON\")\n\t}\n\treturn nil\n}\n\n// CreateJob is the claim record: in one transaction it mints the ULID,\n// inserts a running job with attempt 0 and appends a \"claim\" event.\n//\n// If the newest earlier job with the same stage, role and issue stopped at a\n// usage limit (limit_stop = 1) that no job re-runs yet, the new job is its\n// re-run: after_limit points at it and retry_of is copied from it. A limit\n// stop therefore neither uses up nor grants the automatic retry: a fresh job's\n// limit stop leaves its one retry unused, and the limit stop of an automatic\n// retry leaves its re-run still linked to the original, so it gets no second\n// retry.\n//\n// Otherwise, if the newest earlier job that failed into an automatic retry\n// (auto_retry = 1) is referenced by no job yet, the new job is that retry and\n// its retry_of points at it. Any other claim, including a human retry after a\n// plain failure, has retry_of unset. Only the first claim after a handoff or\n// a limit stop is linked.\nfunc (s *Store) CreateJob(ctx context.Context, n NewJob) (Job, error) {\n\tif err := n.validate(); err != nil {\n\t\treturn Job{}, fmt.Errorf(\"create job: %w\", err)\n\t}\n\tid, err := s.newID()\n\tif err != nil {\n\t\treturn Job{}, err\n\t}\n\tnow := s.now()\n\ttx, err := s.db.BeginTx(ctx, nil)\n\tif err != nil {\n\t\treturn Job{}, fmt.Errorf(\"create job: begin: %w\", err)\n\t}\n\tdefer tx.Rollback() //nolint:errcheck\n\tvar pr any\n\tif n.PR != 0 {\n\t\tpr = n.PR\n\t}\n\tvar branch any\n\tif n.Branch != \"\" {\n\t\tbranch = n.Branch\n\t}\n\tvar prevID stri