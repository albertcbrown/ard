{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B3GYWuUUTdE1KmWujshjh1","type":"tool_result","content":"func (l *Loop) Tick(ctx context.Context, env controller.Env) error {\n\td := l.d\n\tlog := env.Log\n\tif log == nil {\n\t\tlog = d.Log\n\t}\n\tif env.Cfg == nil || env.Cfg.SHA == \"\" {\n\t\treturn nil\n\t}\n\tid, err := d.Reader.Identity(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"merge: identify github user: %w\", err)\n\t}\n\tl.mu.Lock()\n\tl.ticks++\n\tn := l.ticks\n\tl.mu.Unlock()\n\tt := &tick{l: l, cfg: env.Cfg, log: log, self: id.Login, dry: d.Effects.DryRun(), n: n, stopping: env.Stopping}\n\n\tprs, err := t.candidates(ctx)\n\tif err != nil {\n\t\treturn err\n\t}\n\tl.forget(prs)\n\tif len(prs) == 0 {\n\t\treturn nil\n\t}\n\tif err := t.prepare(ctx); err != nil {\n\t\treturn err\n\t}\n\tfor _, pr := range prs {\n\t\tif ctx.Err() != nil || t.isStopping() {\n\t\t\tbreak\n\t\t}\n\t\tif t.consider(ctx, pr) {\n\t\t\tbreak // merged: main moved\n\t\t}\n\t}\n\treturn errors.Join(t.errs...)\n}\n\nfunc (t *tick) isStopping() bool {\n\tselect {\n\tcase <-t.stopping:\n\t\treturn true\n\tdefault:\n\t\treturn false\n\t}\n}\n\n// candidates lists the open worker PRs of the App on main, oldest first.\nfunc (t *tick) candidates(ctx context.Context) ([]github.PullRequest, error) {\n\tprs, err := t.l.d.Reader.ListPRs(ctx, github.ListPRsOpts{State: github.StateOpen, Base: \"main\"})\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"merge: list PRs: %w\", err)\n\t}\n\tvar out []github.PullRequest\n\tfor _, pr := range prs {\n\t\tif pr.State != github.StateOpen || pr.Merged || pr.Draft || pr.BaseRef != \"main\" || !strings.EqualFold(pr.Author, t.self) {\n\t\t\tcontinue\n\t\t}\n\t\tif _, _, ok := parseBranch(pr.HeadRef); !ok {\n\t\t\tcontinue\n\t\t}\n\t\tout = append(out, pr)\n\t}\n\tsort.Slice(out, func(i, j int) bool { return out[i].Number < out[j].Number })\n\treturn out, nil\n}\n\n// forget drops head sightings of PRs that are no longer candidates.\nfunc (l *Loop) forget(prs []github.PullRequest) {\n\tlive := map[int]bool{}\n\tfor _, pr := range prs {\n\t\tlive[pr.Number] = true\n\t}\n\tl.mu.Lock()\n\tdefer l.mu.Unlock()\n\tfor n := range l.heads {\n\t\tif !live[n] {\n\t\t\tdelete(l.heads, n)\n\t\t}\n\t}\n}\n\n// sawHead records head as PR n's current head and reports whether it has been\n// known for at least one earlier tick and the grace period.\nfunc (t *tick) sawHead(n int, head string) (graceOver bool) {\n\tl := t.l\n\tnow := l.d.Now()\n\tl.mu.Lock()\n\tdefer l.mu.Unlock()\n\th, ok := l.heads[n]\n\tif !ok || h.sha != head {\n\t\tl.heads[n] = headSeen{sha: head, at: now, tick: t.n}\n\t\treturn false\n\t}\n\treturn h.tick < t.n && now.Sub(h.at) >= l.d.NoCIGrace\n}\n\n// prepare reads, once per tick, what every PR shares: the required checks and\n// main's tip. An unreadable rules answer merges nothing this tick.\nfunc (t *tick) prepare(ctx context.Context) error {\n\td := t.l.d\n\tres, err := d.Reader.RequiredChecks(ctx, \"main\")\n\tif err != nil {\n\t\tt.log.Error(\"merge.required_checks_failed\", \"error\", err)\n\t\treturn fmt.Errorf(\"merge: read required checks: %w\", err)\n\t}\n\tif len(res.Unevaluated) > 0 {\n\t\tt.log.Warn(\"merge.rules_not_evaluated\", \"rules\", strings.Join(res.Unevaluated, \",\"),\n// Package prgate decides whether a worker PR's requested reviews have passed\n// at its current head. The reviewer loop (#194, mark ready) and the merger\n// (#46) share it, so the two can never disagree about \"reviewed\".\n//\n// The rule has three parts: the label rule (Labels), the record of which head\n// each review saw (ReviewedHeads) and the head comparison (Covers). All are\n// pure or read-only, and every git error fails closed.\npackage prgate\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/labels\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// Reasons a Verdict is not OK.\nconst (\n\tReasonNoReviews = \"no_reviews\"\n\tReasonPending   = \"reviews_pending\"\n\tReasonChanges   = \"reviews_changes\"\n\tReasonRunning   = \"reviews_running\"\n\tReasonBlocked   = \"blocked_label\"\n\tReasonStale     = \"reviews_stale\"\n)\n\n// Verdict is the outcome of the label rule.\ntype Verdict struct {\n\tOK     bool\n\tReason string   // one of the Reason* constants; \"\" when OK\n\tRoles  []string // requested review roles, in the order of the roles argument\n}\n\n// blocking are the PR labels that stop every automatic step.\nvar blocking = []string{labels.NeedsHuman, labels.Hold, labels.TestsFailed, labels.ExecutorFailed}\n\n// Blocked reports whether the PR carries a label that stops automation.\nfunc Blocked(prLabels []string) bool { return HasAny(prLabels, blocking) }\n\n// Labels applies the label rule: at least one ard:review:<role> request among\n// roles, each requested role has :done and neither :changes nor :running, and\n// the PR carries none of needs-human, hold, tests:failed, executor:failed.\n// Pure.\nfunc Labels(prLabels []string, roles []string) Verdict {\n\tif Blocked(prLabels) {\n\t\treturn Verdict{Reason: ReasonBlocked}\n\t}\n\tvar requested []string\n\tfor _, role := range roles {\n\t\tif !HasLabel(prLabels, labels.Request(labels.StageReview, role)) {\n\t\t\tcontinue\n\t\t}\n\t\tswitch {\n\t\tcase HasLabel(prLabels, labels.Changes(role)):\n\t\t\treturn Verdict{Reason: ReasonChanges, Roles: requested}\n\t\tcase HasLabel(prLabels, labels.Running(labels.StageReview, role)):\n\t\t\treturn Verdict{Reason: ReasonRunning, Roles: requested}\n\t\tcase !HasLabel(prLabels, labels.Done(labels.StageReview, role)):\n\t\t\treturn Verdict{Reason: ReasonPending, Roles: requested}\n\t\t}\n\t\trequested = append(requested, role)\n\t}\n\tif len(requested) == 0 {\n\t\treturn Verdict{Reason: ReasonNoReviews}\n\t}\n\treturn Verdict{OK: true, Roles: requested}\n}\n\n// HasLabel reports whether have holds want, ignoring case as GitHub does.\nfunc HasLabel(have []string, want string) bool {\n\tfor _, h := range have {\n\t\tif strings.EqualFold(h, want) {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// HasAny reports whether have holds any of want.\nfunc HasAny(have, want []string) bool {\n\tfor _, w := range want {\n\t\tif HasLabel(have, w) {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// Git is the part of *gitx.Git Covers uses.\ntype Git interface {\n\tCodeChanged(ctx context.Context, repoDir, from, to string, exclude ...string) ([]string, error)\n}\n\n// Covers reports whether a review (or approval) given at commit reviewed still\n// covers head, and the paths that break the cover. base \"\" is the plain rule:\n// the head is covered when no path outside .ard/<issue>/ (the close-out\n// directory of the PR's own issue) changed between the two. With base = merge-base(main, head), a changed path is also tolerated\n// when head has the base's version of it, because it came from main (an\n// update-branch merge). A path both the PR and main changed since the review\n// is not covered. Any git error fails closed: the error is returned and the\n// head is not covered.\nfunc Covers(ctx context.Context, g Git, repoDir, reviewed, head, base string, issue int) (bool, []string, error) {\n\tif reviewed == \"\" || head == \"\" {\n\t\treturn false, nil, nil\n\t}\n\tif reviewed == head {\n\t\treturn true, nil, nil\n\t}\n\tsince, err := g.CodeChanged(ctx, repoDir, reviewed, head)\n\tif err != nil {\n\t\treturn false, nil, err\n\t}\n\tsince = dropIssuePaths(since, issue)\n\tif len(since) == 0 {\n\t\treturn true, nil, nil\n\t}\n\tif base == \"\" {\n\t\treturn false, since, nil\n\t}\n\town, err := g.CodeChanged(ctx, repoDir, base, head)\n\tif err != nil {\n\t\treturn false, nil, err\n\t}\n\townSet := make(map[string]bool, len(own))\n\tfor _, p := range own {\n\t\townSet[p] = true\n\t}\n\tvar broken []string\n\tfor _, p := range since {\n\t\tif ownSet[p] {\n\t\t\tbroken = append(broken, p)\n\t\t}\n\t}\n\treturn len(broken) == 0, broken, nil\n}\n\nfunc dropIssuePaths(paths []string, issue int) []string {\n\tvar out []string\n\tfor _, p := range paths {\n\t\tif !strings.HasPrefix(p, fmt.Sprintf(\".ard/%d/\", issue)) {\n\t\t\tout = append(out, p)\n\t\t}\n\t}\n\treturn out\n}\n\n// IsIssuePath reports whether p is under .ard/<digits>/, the one place\n// close-out commits land.\nfunc IsIssuePath(p string) bool {\n\trest, ok := strings.CutPrefix(p, \".ard/\")\n\tif !ok {\n\t\treturn false\n\t}\n\tdir, _, found := strings.Cut(rest, \"/\")\n\treturn found && isDigits(dir)\n}\n\n// Store is the part of *state.Store ReviewedHeads uses.\ntype Store interface {\n\tEvents(ctx context.Context, f state.EventFilter) ([]state.Event, error)\n}\n\n// ReviewedHeads returns, per role, the head SHA recorded by that role's newest\n// review claim of the issue. A role without a record is absent.\nfunc ReviewedHeads(ctx context.Context, s Store, issue int, roles []string) (map[string]string, error) {\n\tevs, err := s.Events(ctx, state.EventFilter{Kind: state.EventClaim, Issue: issue, Stage: \"review\"})\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"read review claims: %w\", err)\n\t}\n\twant := map[string]bool{}\n\tfor _, r := range roles {\n\t\twant[r] = true\n\t}\n\tout := map[string]string{}\n\tfor _, e := range evs { // ascending: later claims overwrite\n\t\tif e.Issue != issue || e.Stage != \"review\" || !want[e.Role] {\n\t\t\tcontinue\n\t\t}\n\t\tvar data struct {\n\t\t\tHead string `json:\"head\"`\n\t\t}\n\t\tif json.Unmarshal(e.Data, &data) == nil && data.Head != \"\" {\n\t\t\tout[e.Role] = data.Head\n\t\t}\n\t}\n\treturn out, nil\n}\npackage prgate\n\nimport \"strings\"\n\n// ParseWorkerBranch splits worker/<role>-<issue#>-<slug>. The issue is the\n// first dash-separated segment after the first that is all ASCII digits, the\n// role is the segments before it and at least one segment (the slug) must\n// follow. Config rejects worker role names with an all-digit segment, so the\n// split is exact: worker/v2-eng-7-2024-roadmap is role v2-eng, issue 7.\nfunc ParseWorkerBranch(ref string) (role string, issue int, ok bool) {\n\trest, found := strings.CutPrefix(ref, \"worker/\")\n\tif !found {\n\t\treturn \"\", 0, false\n\t}\n\tsegs := strings.Split(rest, \"-\")\n\tfor i := 1; i < len(segs)-1; i++ {\n\t\tif !isDigits(segs[i]) {\n\t\t\tcontinue\n\t\t}\n\t\tn := 0\n\t\tfor _, c := range segs[i] {\n\t\t\tn = n*10 + int(c-'0')\n\t\t\tif n > 1<<30 {\n\t\t\t\treturn \"\", 0, false\n\t\t\t}\n\t\t}\n\t\tif n == 0 || segs[0] == \"\" || segs[len(segs)-1] == \"\" {\n\t\t\treturn \"\", 0, false\n\t\t}\n\t\tfor _, s := range segs[:i] {\n\t\t\tif s == \"\" {\n\t\t\t\treturn \"\", 0, false\n\t\t\t}\n\t\t}\n\t\treturn strings.Join(segs[:i], \"-\"), n, true\n\t}\n\treturn \"\", 0, false\n}\n\nfunc isDigits(s string) bool {\n\tif s == \"\" {\n\t\treturn false\n\t}\n\tfor _, c := range s {\n\t\tif c < '0' || c > '9' {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\tCloseoutsOf(ctx context.Context, issue int, stage string) ([]state.Job, error)\n}, issue int) (worker, jobID string, ok bool, err error) {\n\tjobs, err := s.CloseoutsOf(ctx, issue, StageTriage)\n\tif err != nil {\n\t\treturn \"\", \"\", false, fmt.Errorf(\"lead worker of issue %d: %w\", issue, err)\n\t}\n\tfor _, sj := range jobs {\n\t\trec, err := decode(sj)\n\t\tif err != nil {\n\t\t\treturn \"\", \"\", false, fmt.Errorf(\"lead worker of issue %d: %w\", issue, err)\n\t\t}\n\t\tif rec.Job.Role != \"lead\" || rec.Phase != PhaseClosed || rec.Plan.Outcome != OutcomeDone {\n\t\t\tcontinue\n\t\t}\n\t\tworker, jobID, ok = rec.Plan.Worker, rec.Job.ID, true\n\t}\n\treturn worker, jobID, ok, nil\n}\n\n// ReviewPassed returns the commit the newest closed review close-out of role\n// on PR pr approved, ok only when that close-out finished with outcome done,\n// carries a review plan and the head had not moved during the review. The\n// merger trusts this record, not the :done label, which a person with triage\n// access can add.\nfunc Review