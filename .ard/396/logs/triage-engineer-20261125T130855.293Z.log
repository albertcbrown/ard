pend(errs, fmt.Errorf(\"triage role %s: %w\", role.Name, err))\n\t\t\tcontinue\n\t\t}\n\t\thits, err := l.d.Reader.SearchIssues(ctx, q, github.SearchOpts{Sort: \"created\", Order: \"asc\", Max: 50})\n\t\tif err != nil {\n\t\t\terrs = append(errs, fmt.Errorf(\"triage role %s: search: %w\", role.Name, err))\n\t\t\tcontinue\n\t\t}\n\t\tfor _, hit := range hits {\n\t\t\tif busy[hit.Number] {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tc, ok, err := t.consider(ctx, role, hit.Number)\n\t\t\tif err != nil {\n\t\t\t\terrs = append(errs, err)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif ok {\n\t\t\t\tbusy[c.issue.Number] = true\n\t\t\t\tout = append(out, c)\n\t\t\t}\n\t\t}\n\t}\n\treturn out, errs\n}\n\n// consider re-reads issue n (search is eventually consistent), then gates it.\nfunc (t *tick) consider(ctx context.Context, role config.Role, n int) (candidate, bool, error) {\n\tl := t.l\n\tis, err := l.d.Reader.GetIssue(ctx, n)\n\tif err != nil {\n\t\tif errors.Is(err, github.ErrNotFound) {\n\t\t\treturn candidate{}, false, nil\n\t\t}\n\t\treturn candidate{}, false, fmt.Errorf(\"triage issue %d: re-read: %w\", n, err)\n\t}\n\tif is.State != github.StateOpen || is.IsPR || !hasLabel(is.Labels, labels.Request(labels.StageTriage, role.Name)) ||\n\t\thasAny(is.Labels, excluded(role.Name)) {\n\t\treturn candidate{}, false, nil\n\t}\n\tif dep, held := heldBy(role, is.Labels); held {\n\t\t// Not a candidate, so it does not mark the issue busy: the prerequisite\n\t\t// may still claim it this tick. Held before intake, so it costs no reads.\n\t\tt.log.Info(\"triage.held\", \"issue\", n, \"role\", role.Name, \"waiting_for\", dep)\n\t\treturn candidate{}, false, nil\n\t}\n\tc := candidate{role: role, issue: is}\n\tif strings.EqualFold(is.Author, t.self) { // scanner issues: the App rewrites its own bodies\n\t\tc.reason = intake.ReasonAppAuthored\n\t\treturn c, true, nil\n\t}\n\thash := agentjob.BodyHash(is)\n\tvar stored *state.Admission\n\tif a, err := l.d.Store.Admission(ctx, n); err == nil {\n\t\tstored = &a\n\t} else if !errors.Is(err, state.ErrNotFound) {\n\t\treturn candidate{}, false, fmt.Errorf(\"triage issue %d: read admission: %w\", n, err)\n\t}\n\tlead := role.Name == leadRole\n\tif !lead && (stored == nil || stored.BodyHash == hash) {\n\t\tif stored == nil {\n\t\t\tt.log.Info(\"triage.not_admitted\", \"issue\", n, \"role\", role.Name)\n\t\t\treturn candidate{}, false, nil\n\t\t}\n\t\tc.reason = intake.ReasonAdmitted\n\t\treturn c, true, nil\n\t}\n\tj := t.judge(is)\n\tvar d, lr intake.Decision\n\tif lead {\n\t\tif d, err = j.decide(ctx, t.cfg.Intake); err != nil {\n\t\t\treturn candidate{}, false, err\n\t\t\tbusy[j.Issue] = true\n\t\t}\n\t}\n\tvar out []candidate\n\tvar errs []error\n\tfor _, role := range t.cfg.RolesOf(config.KindWorker) {\n\t\tq, err := query.RoleQuery{\n\t\t\tType: query.TypeIssue, Request: labels.Request(labels.StageWorker, role.Name),\n\t\t\tStates: []string{labels.Running(labels.StageWorker, role.Name), labels.Done(labels.StageWorker, role.Name)},\n\t\t\tGuards: []string{labels.ExecutorFailed, labels.NeedsHuman, labels.Hold},\n\t\t}.Build()\n\t\tif err != nil {\n\t\t\terrs = append(errs, fmt.Errorf(\"worker role %s: %w\", role.Name, err))\n\t\t\tcontinue\n\t\t}\n\t\thits, err := l.d.Reader.SearchIssues(ctx, q, github.SearchOpts{Sort: \"created\", Order: \"asc\", Max: 50})\n\t\tif err != nil {\n\t\t\terrs = append(errs, fmt.Errorf(\"worker role %s: search: %w\", role.Name, err))\n\t\t\tcontinue\n\t\t}\n\t\tfor _, hit := range hits {\n\t\t\tif busy[hit.Number] {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tc, ok, err := t.consider(ctx, role, hit.Number)\n\t\t\tif err != nil {\n\t\t\t\terrs = append(errs, err)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif ok {\n\t\t\t\tbusy[c.issue.Number] = true\n\t\t\t\tout = append(out, c)\n\t\t\t}\n\t\t}\n\t}\n\treturn out, errs\n}\n\n// consider re-reads issue n (search is eventually consistent), then checks\n// approval and admission. #30 owns adding ard:worker:<role>; these checks are\n// defence in depth.\nfunc (t *tick) consider(ctx context.Context, role config.Role, n int) (candidate, bool, error) {\n\tl := t.l\n\tis, err := l.d.Reader.GetIssue(ctx, n)\n\tif err != nil {\n\t\tif errors.Is(err, github.ErrNotFound) {\n\t\t\treturn candidate{}, false, nil\n\t\t}\n\t\treturn candidate{}, false, fmt.Errorf(\"worker issue %d: re-read: %w\", n, err)\n\t}\n\tif is.State != github.StateOpen || is.IsPR || !hasLabel(is.Labels, labels.Request(labels.StageWorker, role.Name)) ||\n\t\thasAny(is.Labels, excludedLabels(role.Name)) {\n\t\treturn candidate{}, false, nil\n\t}\n\tif t.cfg.RequireApproval && !hasLabel(is.Labels, labels.Approved) {\n\t\tt.log.Info(\"worker.awaiting_approval\", \"issue\", n, \"role\", role.Name)\n\t\treturn candidate{}, false, nil\n\t}\n\tok, err := t.recheck().Admitted(ctx, is)\n\tif err != nil || !ok {\n\t\treturn candidate{}, false, err\n\t}\n\treturn candidate{role: role, issue: is}, true, nil\n}\n\n// recheck is the admission re-check, shared with the reviewer (package agentjob).\nfunc (t *tick) recheck() agentjob.Recheck {\n\td := t.l.d\n\treturn agentjob.Recheck{Stage: \"worker\", Stopped: \"changing code\", Label: intake.Label(t.cfg.Intake),\n\t\tSelf: t.self, Dry: t.dry, Log: t.log, Store: d.Store, Reader: d.Reader, Effects: d.Effects}\n}\n\nfunc hasAny(have []string, want []string) bool {\n\tfor _, w := range want {\n\t\tif hasLabel(have, w) {\n\t\t\treturn true\n\t\tif j.Stage == \"worker\" {\n\t\t\tworkerBusy[j.Issue] = true\n\t\t}\n\t}\n\tvar out []candidate\n\tvar errs []error\n\tfor _, role := range t.cfg.RolesOf(config.KindReviewer) {\n\t\tq, err := query.RoleQuery{\n\t\t\tType: query.TypePR, Request: labels.Request(labels.StageReview, role.Name),\n\t\t\tStates: []string{labels.Running(labels.StageReview, role.Name), labels.Done(labels.StageReview, role.Name), labels.Changes(role.Name)},\n\t\t\tGuards: []string{labels.ExecutorFailed, labels.NeedsHuman, labels.Hold, labels.TestsFailed},\n\t\t}.Build()\n\t\tif err != nil {\n\t\t\terrs = append(errs, fmt.Errorf(\"review role %s: %w\", role.Name, err))\n\t\t\tcontinue\n\t\t}\n\t\thits, err := l.d.Reader.SearchIssues(ctx, q, github.SearchOpts{Sort: \"created\", Order: \"asc\", Max: 50})\n\t\tif err != nil {\n\t\t\terrs = append(errs, fmt.Errorf(\"review role %s: search: %w\", role.Name, err))\n\t\t\tcontinue\n\t\t}\n\t\tfor _, hit := range hits {\n\t\t\tc, ok, err := t.consider(ctx, role, hit, workerBusy)\n\t\t\tif err != nil {\n\t\t\t\terrs = append(errs, err)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif ok {\n\t\t\t\tout = append(out, c)\n\t\t\t}\n\t\t}\n\t}\n\treturn out, errs\n}\n\nfunc (t *tick) skip(pr int, role, reason string) {\n\tt.log.Info(\"review.skip\", \"pr\", pr, \"role\", role, \"reason\", reason)\n}\n\n// consider re-reads PR hit.Number (search is eventually consistent) and its\n// issue, then applies the rules in the package comment.\nfunc (t *tick) consider(ctx context.Context, role config.Role, hit github.Issue, workerBusy map[int]bool) (candidate, bool, error) {\n\tl := t.l\n\tn := hit.Number\n\tpr, err := l.d.Reader.GetPR(ctx, n)\n\tif err != nil {\n\t\tif errors.Is(err, github.ErrNotFound) {\n\t\t\treturn candidate{}, false, nil\n\t\t}\n\t\treturn candidate{}, false, fmt.Errorf(\"review PR %d: re-read: %w\", n, err)\n\t}\n\tif pr.State != github.StateOpen || pr.Merged || !hasLabel(pr.Labels, labels.Request(labels.StageReview, role.Name)) ||\n\t\thasAny(pr.Labels, excludedLabels(role.Name)) {\n\t\treturn candidate{}, false, nil\n\t}\n\tif !strings.EqualFold(pr.Author, t.self) {\n\t\tt.skip(n, role.Name, skipNotAppPR)\n\t\treturn candidate{}, false, nil\n\t}\n\tif pr.BaseRef != \"main\" {\n\t\tt.skip(n, role.Name, skipBaseNotMain)\n\t\treturn candidate{}, false, nil\n\t}\n\t_, issueN, ok := parseWorkerBranch(pr.HeadRef)\n\tif !ok {\n\t\tt.skip(n, role.Name, skipNotWorkerRef)\n\t\treturn candidate{}, false, nil\n\t}\n\tis, err := l.d.Reader.GetIssue(ctx, issueN)\n\tif err != nil {\n\t\tif errors.Is(err, github.ErrNotFound) {\n\t\t\tt.skip(n, role.Name, skipIssueClosed)\n\t\t\treturn candidate{}, false, nil\n\t\t}\n\t\treturn candidate{}, false, fmt.Errorf(\"review PR %d: read issue %d: %w\", n, issueN, err)\n\t}\n\tswitch {\n\tcase is.State != github.StateOpen || is.IsPR:\n\t\tt.skip(n, role.Name, skipIssueClosed)\n\t\treturn candidate{}, false, nil\n\tcase hasLabel(is.Labels, labels.NeedsHuman) || hasLabel(is.Labels, labels.Hold):\n\t\tt.skip(n, role.Name, skipIssueBlocked)\n\t\treturn candidate{}, false, nil\n\tcase workerBusy[issueN]:\n\t\tt.skip(n, role.Name, skipWorkerRunning)\n\t\treturn candidate{}, false, nil\n\t}\n\tok, err = t.recheck().Admitted(ctx, is)\n\tif err != nil || !ok {\n\t\treturn candidate{}, false, err\n\t}\n\treturn candidate{role: role, pr: pr, issue: is, since: hit.CreatedAt}, true, nil\n}\n\nfunc hasAny(have []string, want []string) bool {\n\tfor _, w := range want {\n\t\tcase c.Class == ClassTriage && (triageHeld[c.Number] || triageGranted[c.Number]):\n\t\t\td.Verdict, d.Reason = DeniedIssueBusy, fmt.Sprintf(\"a triage job on #%d is already held\", c.Number)\n\t\tcase free > 0:\n\t\t\tfree--\n\t\t\ts := &Slot{pool: p, cand: c, grantedAt: now}\n\t\t\tp.held[c.Key()] = s\n\t\t\tif c.Class == ClassTriage {\n\t\t\t\ttriageGranted[c.Number] = true\n\t\t\t}\n\t\t\tdelete(p.firstDenied, c.Key())\n\t\t\tp.starved[c.Class] = false\n\t\t\td.Verdict, d.Slot = Granted, s\n\t\t\tp.log.Debug(\"pool.grant\", \"loop\", loop, \"key\", c.Key(), \"class\", c.Class.String(), \"role\", c.Role, \"number\", c.Number)\n\t\tcase capDenied < reserved:\n\t\t\tcapDenied++\n\t\t\td.Verdict, d.Reason = DeniedOutranked, fmt.Sprintf(\"outranked by %d higher-ranked waiting job(s)\", reserved)\n\t}\n\treturn out\n}\n\n// checkStarvationLocked logs one pool.starved warning when a class's oldest\n// wait first crosses StarveAfter. It re-arms once the class has no waiting\n// demand (a grant also clears the flag in Offer).\nfunc (p *Pool) checkStarvationLocked(now time.Time) {\n\tw := p.waitingLocked(now)\n\tfor c := ClassReview; c <= ClassScanner; c++ {\n\t\tws, ok := w[c]\n\t\tif !ok {\n\t\t\tp.starved[c] = false\n\t\t\tcontinue\n\t\t}\n\t\tif ws.oldest >= p.starveAfter && !p.starved[c] {\n\t\t\tp.starved[c] = true\n\t\t\tp.log.Warn(\"pool.starved\", \"class\", c.String(), \"waiting\", ws.count, \"oldest_wait\", ws.oldest.String())\n\t\t}\n\t}\n}\n\n// DemandLoops returns the sorted names of loops whose demand is live at now\n// and still has a non-scanner candidate that is not held. It does not change state.\nfunc (p *Pool) DemandLoops(now time.Time) []string {\n\tp.mu.Lock()\ndocs/proposal.md:50:Every label starts with `ard:`, and every stage uses one grammar: `ard:<stage>:<role>` requests work, `:running` marks a claim, `:done` marks completion. A loop picks up an issue that has the request label and none of `:running`, `:done`, `ard:executor:failed`, `ard:needs-human` or `ard:hold`.\ndocs/proposal.md:63:        ard:hold, ard:needs-human and ard:pause\ndocs/proposal.md:83:| `ard:hold` | Human | Controller ignores this issue or PR entirely |\ndocs/proposal.md:85:Four more labels sit outside the grammar: `ard:approved` (human go-ahead before a worker starts; counts only when a triage-or-higher collaborator added it after triage finished), `ard:tests:failed` (worker could not get tests green; set by worker close-out on the issue and the PR, cleared by a green run), `ard:keep` (hold failed-job resources past 24 h) and `ard:pause` (on the pinned status issue, stops all new claims). `ard labels sync` creates and updates the full set from the resolved config, idempotently, and never deletes a label: stale `ard:` labels are only reported. In `label` mode a custom `intake.label` is part of the catalogue: sync creates it with a description saying it admits the issue to triage, and switching back to the default leaves the old custom label reported as stale, never deleted. `ard labels sync` and `ard config check` reject an intake label that is one of ard's own label names, naming `intake.label`; `ard serve` logs `config.intake_invalid` once per distinct value. `--repo owner/name` names the repository; when omitted, it is read from the `origin` remote. Role names are at most 31 characters and scanner names at most 38, because GitHub caps a label at 50 characters. Worker role names may not contain an all-digit segment (`eng-12`), so branch names stay unambiguous.\ndocs/proposal.md:87:**One query per role per poll.** For example: `is:open label:\"ard:triage:architect\" -label:\"ard:triage:architect:running\" -label:\"ard:triage:architect:done\" -label:ard:executor:failed -label:ard:needs-human -label:ard:hold`. Six triage roles every 15 minutes, plus four reviewers, a worker and the merger every 5, is about 100 searches an hour, well under GitHub's limits.\ndocs/proposal.md:185:**Directories outlive their issues as the audit trail.** The janitor loop (`internal/janitor`) wakes daily but works once per 30 days (the timestamp is in memory, so a restart costs one extra harmless pass). It lists `.ard/` on a fresh fetch of `main`, finds closed issues (not PRs) with a directory whose close date is more than 90 days old, re-fetches each to catch a reopen, skips any carrying `ard:keep` or `ard:hold`, and deletes the issue's files through the main committer as `ard(janitor:prune)`, in requests of at most 256 files. Only numbered issue directories are candidates, and the committer's path guard enforces it; git history keeps what was deleted. Pause stops it.\ndocs/proposal.md:213:6. **File.** Edits and closes first, then joins, then new issues. Create the issue with `ard:scanner:<name>` plus the route's label (`ard:pending` by default), then queue `.ard/<issue#>/issue.md` to the committer. The issue comes first because its number names the directory. A committer failure is logged and does not undo the issue: its body already carries the checklist. **An issue with `ard:hold` is never edited, joined, commented on or closed**, and a close waits while any `ard:<stage>:<role>:running` label is on the issue, so a running job is not orphaned. Edits never rewrite `issue.md`, because after a claim the branch may own `.ard/<issue#>/`.\ndocs/proposal.md:227:**The stale closer is a built-in scanner.** It has no role directory and needs no job slot, executor or worktree; its settings live in the top-level `stale:` block of `config.yaml`. It is a plain controller loop that runs every 24 hours and is skipped while paused. It closes scanner issues still at `ard:pending` with no activity (issues filed under `route: none` or `needs-human` lack `ard:pending` and are never candidates; #204 may widen this) for `stale.inactive_for` (default 30 days), as not planned, with a comment. Activity means a timeline event by anyone other than the ard App. It never closes an issue that has a `:running` label, `ard:hold`, `ard:needs-human`, a linked open PR, or a human author (any author other than the App), and it closes nothing when the client is not authenticated as an App. It only comments and closes: suppression happens on the owning scanner's next reconcile, which suppresses every not-planned close for `stale.suppress_for`. A reopened issue gets a fresh comment when it goes stale again.\ndocs/proposal.md:281:**A deterministic gate starts the worker.** Once per triage tick, after the intake sweep, the controller searches for open issues that carry `ard:triage:lead:done` and none of `ard:pending`, `ard:needs-human`, `ard:hold`, `ard:executor:failed` or any configured worker's request label (the exclusion keeps gated issues from filling the 100-hit window). It re-reads each hit and decides from labels alone. \"Requested\" means the request label is present, \"done\" means `:done` is present. The gate waits while any triage job of the issue is running or any requested `ard:triage:<role>` lacks its `:done`; it leaves an issue alone once any `ard:worker:<role>` label exists (a worker already gated, started by a human, or in a fix round). When triage is finished it adds the lead's chosen `ard:worker:<role>`. The choice is read from the lead's close-out record in controller state, the value close-out validated, not from the committed `triage-lead.md`. It needs no pool slot and runs in the same conditions as the rest of the tick.\ndocs/proposal.md:340:4. **`:running` with no record.** Every 5 minutes, for each configured triage, worker and reviewer role, an open issue or PR that has the `:running` label but no running job (and none that ended in the last 10 minutes) gets one comment, `ard:executor:failed` and the label removed. It is a core-API list per role, not a search. It is skipped in dry-run, whose database never matches real labels, and for issues held with `ard:hold`.\n(eval):1: no matches found: --include=*.go\ninternal/github/client.go:14:\tSearchIssues(ctx context.Context, q string, o SearchOpts) ([]Issue, error) // client prepends \"repo:owner/name \"\ninternal/github/http.go:434:\topts := &gogh.IssueListByRepoOptions{State: string(state), Labels: o.Labels, Since: o.Since}\ninternal/github/http.go:457:func (h *HTTP) SearchIssues(ctx context.Context, q string, o SearchOpts) ([]Issue, error) {\ninternal/github/http.go:466:\topts := &gogh.SearchOptions{Sort: o.Sort, Order: o.Order}\ninternal/github/http.go:470:\t\tres, resp, err := h.gh.Search.Issues(ctx, full, opts)\ninternal/github/http.go:528:\t\tls, resp, err := h.gh.Issues.ListLabels(ctx, h.o(), h.r(), opts)\ninternal/github/http_test.go:111:\t\tstrings.Join(got.Labels, \",\") != \"ard:pending,type:feature\" || !strings.Contains(got.Body, \"ignore previous\") {\ninternal/github/http_test.go:142:\tgot, err := h.ListIssues(context.Background(), ListIssuesOpts{State: StateAll, Labels: []string{\"a\", \"b\"}, Since: since})\ninternal/github/http_test.go:189:\tgot, err := h.SearchIssues(context.Background(), `is:open label:\"x y\"`, SearchOpts{Sort: \"updated\", Order: \"asc\", Max: 3})\ninternal/github/http_test.go:198:\tgot, _ = h.SearchIssues(context.Background(), \"is:open\", SearchOpts{Max: 2})","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_0164VfjAtYxf1HWtpWUrBfmU","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
