turn candidate{}, false, nil\n\t\t}\n\t\tc.reason = intake.ReasonAdmitted\n\t\treturn c, true, nil\n\t}\n\tj := t.judge(is)\n\tvar d, lr intake.Decision\n\tif lead {\n\t\tif d, err = j.decide(ctx, t.cfg.Intake); err != nil {\n\t\t\treturn candidate{}, false, err\n\t\t}\n\t}\n\tif stored != nil && stored.BodyHash != hash {\n\t\tif t.cfg.Intake.Mode == config.IntakeLabel && lead {\n\t\t\tlr = d\n\t\t} else if lr, err = j.decide(ctx, config.Intake{Mode: config.IntakeLabel, Label: t.cfg.Intake.Label}); err != nil {\n\t\t\treturn candidate{}, false, err\n\t\t}\n\t}\n\ttmpl := state.Admission{Issue: n, Mode: string(t.cfg.Intake.Mode), BodyHash: hash, LabeledAt: later(is.CreatedAt, is.UpdatedAt)}\n\tv, rec := gate(lead, stored, d, lr, tmpl)\n\tt.log.Info(\"triage.gate\", \"issue\", n, \"role\", role.Name, \"verdict\", v.String(), \"outcome\", string(d.Outcome), \"reason\", string(d.Reason), \"actor\", d.Actor)\n\tswitch v {\n\tcase vRefuse:\n\t\treturn candidate{}, false, t.refuse(ctx, is, d)\n\tcase vRegate:\n\t\treturn candidate{}, false, t.regate(ctx, is, hash)\n\tcase vSkip:\n\t\treturn candidate{}, false, nil\n\t}\n\tc.rec = rec\n\tif rec != nil {\n\t\tc.reason = intake.Reason(rec.Reason)\n\t} else {\n\t\tc.reason = intake.ReasonAdmitted // passed on the stored admission: the body hash still matches\n\t}\n\treturn c, true, nil\n}\n\n// later returns the later of two times. In all mode an admission has no\n// labeled event, so its LabeledAt is the issue's updated_at: any label event\n// before the admission is at or before it.\nfunc later(a, b time.Time) time.Time {\n\tif b.After(a) {\n\t\treturn b\n\t}\n\treturn a\n}\n\t\t\tlog.Warn(\"triage.no_model_credential\", \"hint\", \"agent jobs will not be claimed until one is set\")\n\t\t}\n\t\tl.offer(cfg, nil)\n\t\treturn nil\n\t}\n\tid, err := l.d.Reader.Identity(ctx)\n\tif err != nil {\n\t\tl.offer(cfg, nil)\n\t\treturn fmt.Errorf(\"triage: identify github user: %w\", err)\n\t}\n\tvar errs []error\n\tenabledAt, err := l.enabledAt(ctx, cfg)\n\tif err != nil {\n\t\terrs = append(errs, err)\n\t}\n\tt := &tick{l: l, cfg: cfg, log: log, self: id.Login, enabledAt: enabledAt, dry: dry}\n\terrs = append(errs, t.sweep(ctx)...)\n\terrs = append(errs, t.fanIn(ctx)...)\n\tcands, cerrs := t.candidates(ctx)\n\terrs = append(errs, cerrs...)\n\n\tif dry {\n\t\t// Dry-run never claims: no job row, no slot, no label.\n\t\tfor _, c := range cands {\n\t\t\tlog.Info(\"triage.would_claim\", \"issue\", c.issue.Number, \"role\", c.role.Name, \"reason\", string(c.reason))\n\t\t}\n\t\tl.offer(cfg, nil)\n\t\treturn errors.Join(errs...)\n\t}\n\n\tpcs := make([]pool.Candidate, len(cands))\n\tfor i, c := range cands {\n\t\tpcs[i] = pool.Candidate{Class: pool.ClassTriage, Role: c.role.Name, Number: c.issue.Number, Since: c.issue.CreatedAt}\n\t}\n\tdecs := l.offer(cfg, pcs)\n\tstopped := false\n\tfor i, d := range decs {\n\t\tif d.Verdict != pool.Granted || d.Slot == nil {\n\t\t\tcontinue\n\t\t}\n\t\tif stopped {\n\t\t\td.Slot.Release()\n\t\t\tcontinue\n\t\t}\n\t\tc := cands[i]\n\t\tname := fmt.Sprintf(\"triage:%s:%d\", c.role.Name, c.issue.Number)\n\t\tslot := d.Slot\n\t\tif err := env.Inflight.Go(name, func(wctx context.Context) { l.run(wctx, env, cfg, c, slot) }); err != nil {\n\t\t\tslot.Release()\n\t\t\tstopped = true\n\t\t\terrs = append(errs, fmt.Errorf(\"triage: %w\", err))\n\t\t}\n\t}\n\treturn errors.Join(errs...)\n}\n\n// tick holds what one Tick passes between its steps.\ntype tick struct {\n\tl         *Loop\n\tcfg       *config.Resolved\n\tlog       *slog.Logger\n\tself      string\n\tenabledAt time.Time\n\tdry       bool\n}\n\nfunc (t *tick) event(ctx context.Context, issue int, action string, outcome, reason, actor string) {\n\tdata, _ := json.Marshal(map[string]string{\"outcome\": outcome, \"reason\": reason, \"actor\": actor, \"action\": action})\n\tif err := t.l.d.Store.AppendEvent(ctx, state.Event{Kind: state.EventIntake, Issue: issue, Stage: stageTriage, Data: data}); err != nil {\n\t\tt.log.Warn(\"triage.event_failed\", \"issue\", issue, \"action\", action, \"error\", err)\n\t}\n}\n\n// excluded are the labels that keep an issue out of every triage query.\nfunc excluded(role string) []string {\n\treturn []string{\n\t\tlabels.Running(labels.StageTriage, role), labels.Done(labels.StageTriage, role),\n\t\tlabels.ExecutorFailed, labels.NeedsHuman, labels.Hold,\n\t}\n}\n// Package query builds GitHub issue-search queries for ard's request labels.\n// It has no dependency on internal/github.\npackage query\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"strings\"\n)\n\n// Type selects the is:issue / is:pr qualifier.\ntype Type string\n\nconst (\n\tTypeAny   Type = \"\"\n\tTypeIssue Type = \"issue\"\n\tTypePR    Type = \"pr\"\n)\n\n// RoleQuery describes \"open items carrying Request but none of States or\n// Guards\". The result carries no repo: qualifier; SearchIssues adds it.\ntype RoleQuery struct {\n\tType    Type\n\tRequest string   // included label, always quoted\n\tStates  []string // excluded role-state labels, always quoted\n\tGuards  []string // excluded static labels, bare unless they need quoting\n}\n\n// Build renders the query string.\nfunc (q RoleQuery) Build() (string, error) {\n\tif q.Request == \"\" {\n\t\treturn \"\", errors.New(\"query: empty request label\")\n\t}\n\tparts := []string{\"is:open\"}\n\tif q.Type != TypeAny {\n\t\tparts = append(parts, \"is:\"+string(q.Type))\n\t}\n\tif err := check(q.Request); err != nil {\n\t\treturn \"\", err\n\t}\n\tparts = append(parts, `label:\"`+q.Request+`\"`)\n\tfor _, s := range q.States {\n\t\tif err := check(s); err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\tparts = append(parts, `-label:\"`+s+`\"`)\n\t}\n\tfor _, g := range q.Guards {\n\t\tif err := check(g); err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\tif needsQuote(g) {\n\t\t\tg = `\"` + g + `\"`\n\t\t}\n\t\tparts = append(parts, \"-label:\"+g)\n\t}\n\treturn strings.Join(parts, \" \"), nil\n}\n\nfunc check(label string) error {\n\tif label == \"\" {\n\t\treturn errors.New(\"query: empty label\")\n\t}\n\tif strings.ContainsAny(label, \"\\\"\\n\\r\") {\n\t\treturn fmt.Errorf(\"query: label %q contains a quote or newline\", label)\n\t}\n\treturn nil\n}\n\nfunc needsQuote(s string) bool {\n\tfor _, r := range s {\n\t\tswitch {\n\t\tcase r >= 'a' && r <= 'z', r >= 'A' && r <= 'Z', r >= '0' && r <= '9':\n\t\tcase strings.ContainsRune(\":._/-\", r):\n\t\tdefault:\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_013vFLrpCBvEuc3tcfKCGP9i","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
