{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011ChPjh4zWcxNRJJCNtMdPZ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DfYCuemhVdkUwysMUirKoZ","name":"Bash","input":{"command":"cat >> internal/labels/labels_test.go <<'E'\n\nfunc TestPriority(t *testing.T) {\n\ttests := []struct {\n\t\tname string\n\t\tin   []string\n\t\twant int\n\t}{\n\t\t{\"none\", nil, 2},\n\t\t{\"unrelated\", []string{\"bug\", Pending}, 2},\n\t\t{\"p1\", []string{P1}, 1},\n\t\t{\"p3\", []string{P3}, 3},\n\t\t{\"highest wins\", []string{P3, P0, P2}, 0},\n\t\t{\"mixed case\", []string{\"ARD:P1\", \"x\"}, 1},\n\t\t{\"p2 explicit\", []string{P2}, 2},\n\t}\n\tfor _, tc := range tests {\n\t\tif got := Priority(tc.in); got != tc.want {\n\t\t\tt.Errorf(\"%s: Priority(%v) = %d, want %d\", tc.name, tc.in, got, tc.want)\n\t\t}\n\t}\n}\n\nfunc TestPriorityLabelsAreStaticAndNotIntake(t *testing.T) {\n\tfor _, l := range Priorities() {\n\t\tif !IsPriority(strings.ToUpper(l)) {\n\t\t\tt.Errorf(\"IsPriority(%q) = false\", l)\n\t\t}\n\t\tif p, ok := Parse(l); !ok || p.Kind != KindStatic {\n\t\t\tt.Errorf(\"Parse(%q) = %v, %v; want static\", l, p, ok)\n\t\t}\n\t\tif CheckIntake(l) == nil {\n\t\t\tt.Errorf(\"CheckIntake(%q) accepted a priority label\", l)\n\t\t}\n\t}\n\tif IsPriority(Pending) {\n\t\tt.Error(\"ard:pending is not a priority label\")\n\t}\n}\nE\npython3 - <<'E'\np='internal/github/query/query_test.go'\ns=open(p).read()\ns=s.replace('''\t\t{\n\t\t\tname: \"issue type\",''','''\t\t{\n\t\t\tname: \"any of\",\n\t\t\tq:    RoleQuery{Type: TypeIssue, Request: \"x\", AnyOf: []string{\"ard:p0\", \"ard:p1\"}, Guards: []string{\"ard:hold\"}},\n\t\t\twant: `is:open is:issue label:\"x\" label:\"ard:p0\",\"ard:p1\" -label:ard:hold`,\n\t\t},\n\t\t{\n\t\t\tname:    \"any of with quote\",\n\t\t\tq:       RoleQuery{Request: \"x\", AnyOf: []string{`a\"b`}},\n\t\t\twantErr: true,\n\t\t},\n\t\t{\n\t\t\tname: \"issue type\",''',1)\nopen(p,'w').write(s)\nE\ncat >> internal/pool/pool_test.go <<'E'\n\nfunc prio(c Candidate, p int) Candidate { c.Priority = p; return c }\n\nfunc TestLessPriority(t *testing.T) {\n\toldP3 := prio(cand(ClassWorker, \"w\", 1, 0), 3)\n\tnewP1 := prio(cand(ClassWorker, \"w\", 2, 10), 1)\n\toldP1 := prio(cand(ClassWorker, \"w\", 3, 5), 1)\n\tp3Review := prio(cand(ClassReview, \"r\", 4, 50), 3)\n\tp0Triage := prio(cand(ClassTriage, \"t\", 5, 0), 0)\n\tif !less(newP1, oldP3) {\n\t\tt.Error(\"a P1 must rank before an older P3 in the same class\")\n\t}\n\tif !less(oldP1, newP1) {\n\t\tt.Error(\"equal priority falls back to the oldest Since\")\n\t}\n\tif !less(p3Review, p0Triage) {\n\t\tt.Error(\"priority must never cross classes\")\n\t}\n\twant := []string{oldP1.Key(), newP1.Key(), oldP3.Key()}\n\tfor _, in := range permutations([]Candidate{oldP3, newP1, oldP1}) {\n\t\tp, _ := newPool(1)\n\t\tds := p.Offer(\"w\", 0, in)\n\t\tvar got []string\n\t\tfor _, d := range ds {\n\t\t\tif d.Verdict == Granted {\n\t\t\t\tgot = append(got, d.Cand.Key())\n\t\t\t}\n\t\t}\n\t\tif len(got) != 1 || got[0] != want[0] {\n\t\t\tt.Fatalf(\"one slot went to %v, want %s\", got, want[0])\n\t\t}\n\t}\n}\n\nfunc TestReservationFollowsPriority(t *testing.T) {\n\tp, _ := newPool(1)\n\thold := p.Offer(\"w\", 0, []Candidate{prio(cand(ClassWorker, \"w\", 9, 0), 2)})[0].Slot\n\toldP3 := prio(cand(ClassWorker, \"w\", 1, 0), 3)\n\tnewP0 := prio(cand(ClassWorker, \"w\", 2, 10), 0)\n\tp.Offer(\"a\", time.Hour, []Candidate{oldP3})\n\tp.Offer(\"b\", time.Hour, []Candidate{newP0})\n\thold.Release()\n\t// The freed slot is reserved for the P0 waiter, so the P3 is outranked.\n\tif d := p.Offer(\"a\", time.Hour, []Candidate{oldP3})[0]; d.Verdict == Granted {\n\t\tt.Fatalf(\"P3 took the slot reserved for a waiting P0: %v\", d.Verdict)\n\t}\n\tif d := p.Offer(\"b\", time.Hour, []Candidate{newP0})[0]; d.Verdict != Granted {\n\t\tt.Fatalf(\"P0 verdict = %v, want granted\", d.Verdict)\n\t}\n}\n\nfunc TestStarvationWarnsOncePerEpisode(t *testing.T) {\n\tva