 -113,3 +113,38 @@ func TestCandidatesRegateAnEditedHumanIssue(t *testing.T) {\n \t\tt.Errorf(\"want a regate comment and needs-human on the issue: %v\", cs)\n \t}\n }\n+\n+func TestCandidatePriority(t *testing.T) {\n+\ttests := []struct {\n+\t\tname string\n+\t\tmut  func(*scenario)\n+\t\twant int\n+\t}{\n+\t\t{\"unlabelled is P2\", func(*scenario) {}, 2},\n+\t\t{\"issue P0\", func(s *scenario) { s.issue.Labels = append(s.issue.Labels, labels.P0) }, 0},\n+\t\t{\"issue P3\", func(s *scenario) { s.issue.Labels = append(s.issue.Labels, labels.P3) }, 3},\n+\t\t{\"PR P0 on a P3 issue\", func(s *scenario) {\n+\t\t\ts.pr.Labels = append(s.pr.Labels, labels.P0)\n+\t\t\ts.issue.Labels = append(s.issue.Labels, labels.P3)\n+\t\t}, 0},\n+\t\t{\"PR P3 on a P1 issue\", func(s *scenario) {\n+\t\t\ts.pr.Labels = append(s.pr.Labels, labels.P3)\n+\t\t\ts.issue.Labels = append(s.issue.Labels, labels.P1)\n+\t\t}, 1},\n+\t\t{\"PR P1 and P3\", func(s *scenario) { s.pr.Labels = append(s.pr.Labels, labels.P3, labels.P1) }, 1},\n+\t}\n+\tfor _, tc := range tests {\n+\t\tt.Run(tc.name, func(t *testing.T) {\n+\t\t\th := newHarness(t)\n+\t\t\th.scenario(tc.mut)\n+\t\t\ttk := &tick{l: h.loop, cfg: h.cfg, log: quiet, self: self}\n+\t\t\tcands, errs := tk.candidates(context.Background())\n+\t\t\tif len(errs) != 0 || len(cands) != 1 {\n+\t\t\t\tt.Fatalf(\"cands %d, errs %v\", len(cands), errs)\n+\t\t\t}\n+\t\t\tif cands[0].priority != tc.want {\n+\t\t\t\tt.Errorf(\"priority = %d, want %d\", cands[0].priority, tc.want)\n+\t\t\t}\n+\t\t})\n+\t}\n+}\ndiff --git a/internal/reviewer/loop.go b/internal/reviewer/loop.go\nindex b9e6036..e7e2789 100644\n--- a/internal/reviewer/loop.go\n+++ b/internal/reviewer/loop.go\n@@ -6,6 +6,7 @@ import (\n \t\"errors\"\n \t\"fmt\"\n \t\"log/slog\"\n+\t\"sort\"\n \t\"sync\"\n \t\"time\"\n \n@@ -194,8 +195,18 @@ func (l *Loop) Tick(ctx context.Context, env controller.Env) error {\n \tcands, errs := t.candidates(ctx)\n \n \tif dry {\n+\t\tsort.SliceStable(cands, func(i, j int) bool {\n+\t\t\ta, b := cands[i], cands[j]\n+\t\t\tif a.priority != b.priority {\n+\t\t\t\treturn a.priority < b.priority\n+\t\t\t}\n+\t\t\tif !a.since.Equal(b.since) {\n+\t\t\t\treturn a.since.Before(b.since)\n+\t\t\t}\n+\t\t\treturn a.pr.Number < b.pr.Number\n+\t\t})\n \t\tfor _, c := range cands {\n-\t\t\tlog.Info(\"review.would_claim\", \"pr\", c.pr.Number, \"issue\", c.issue.Number, \"role\", c.role.Name)\n+\t\t\tlog.Info(\"review.would_claim\", \"pr\", c.pr.Number, \"issue\", c.issue.Number, \"role\", c.role.Name, \"priority\", c.priority)\n \t\t}\n \t\tl.offer(cfg, nil)\n \t\treturn errors.Join(errs...)\n@@ -203,7 +214,7 @@ func (l *Loop) Tick(ctx context.Context, env controller.Env) error {\n \n \tpcs := make([]pool.Candidate, len(cands))\n \tfor i, c := range cands {\n-\t\tpcs[i] = pool.Candidate{Class: pool.ClassReview, Role: c.role.Name, Number: c.pr.Number, Since: c.since}\n+\t\tpcs[i] = pool.Candidate{Class: pool.ClassReview, Role: c.role.Name, Number: c.pr.Number, Since: c.since, Priority: c.priority}\n \t}\n \tdecs := l.offer(cfg, pcs)","numLines":899,"startLine":1,"totalLines":1297,"truncatedByTokenCap":true}},"tool_result_meta":[{"id":"toolu_01MHG17KKt6o3W5MoiPyjHdU","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
