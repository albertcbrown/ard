spec: Spec{Intake: \"ard:worker:engineer\", Workers: []string{\"engineer\"}}, wantErr: []string{\"intake.label\"}, noErr: \"duplicate\"},\n202\t \t\t{name: \"clash and bad role\", spec: Spec{Intake: \"ard:needs-human\", Workers: []string{\"Foo\"}}, wantErr: []string{\"intake.label\", `worker \"Foo\"`}},\n203\t-\t\t{name: \"50 runes\", spec: Spec{Intake: \"ard:\" + strings.Repeat(\"é\", 46)}, wantName: \"ard:\" + strings.Repeat(\"é\", 46), wantLen: 10},\n204\t+\t\t{name: \"50 runes\", spec: Spec{Intake: \"ard:\" + strings.Repeat(\"é\", 46)}, wantName: \"ard:\" + strings.Repeat(\"é\", 46), wantLen: 14},\n205\t \t\t{name: \"51 runes\", spec: Spec{Intake: \"ard:\" + strings.Repeat(\"é\", 47)}, wantErr: []string{\"intake.label: label\"}},\n206\t \t\t{name: \"too long\", spec: Spec{Intake: \"ard:\" + strings.Repeat(\"a\", 47)}, wantErr: []string{\"intake.label: label\"}},\n207\t \t}\n208\tdiff --git a/internal/labels/colors.go b/internal/labels/colors.go\n209\tindex 17c397e..a3a295e 100644\n210\t--- a/internal/labels/colors.go\n211\t+++ b/internal/labels/colors.go\n212\t@@ -36,6 +36,10 @@ var staticStyles = map[string]style{\n213\t \tApproved:       {\"bfdadc\", \"ard: human go-ahead for the worker to start\"},\n214\t \tKeep:           {\"cfd3d7\", \"ard: keep failed-job resources past 24 h\"},\n215\t \tPause:          {\"5c5c5c\", \"ard: on the status issue, stops all new claims\"},\n216\t+\tP0:             {\"b60205\", \"ard priority 0 (highest); unlabelled counts as P2\"},\n217\t+\tP1:             {\"d93f0b\", \"ard priority 1; unlabelled counts as P2\"},\n218\t+\tP2:             {\"fbca04\", \"ard priority 2 (the default when unlabelled)\"},\n219\t+\tP3:             {\"c2e0c6\", \"ard priority 3 (lowest)\"},\n220\t }\n221\t \n222\t // intakeStyle is the custom intake label's style. It shares ard:pending's\n223\tdiff --git a/internal/labels/labels.go b/internal/labels/labels.go\n224\tindex 55710a8..ca3fc07 100644\n225\t--- a/internal/labels/labels.go\n226\t+++ b/internal/labels/labels.go\n227\t@@ -51,9 +51,52 @@ const (\n228\t \tPause          = \"ard:pause\"\n229\t )\n230\t \n231\t-// Static lists the nine static labels in a fixed order.\n232\t+// The priority labels. Humans set them; ard never does. Unlabelled counts as\n233\t+// P2 and several labels count as the highest (see Priority).\n234\t+const (\n235\t+\tP0 = \"ard:p0\"\n236\t+\tP1 = \"ard:p1\"\n237\t+\tP2 = \"ard:p2\"\n238\t+\tP3 = \"ard:p3\"\n239\t+)\n240\t+\n241\t+// DefaultPriority is the priority of an item with no priority label.\n242\t+const DefaultPriority = 2\n243\t+\n244\t+// Static lists the thirteen static labels in a fixed order.\n245\t func Static() []string {\n246\t-\treturn []string{Pending, ExecutorFailed, NeedsHuman, NeedsApproval, Hold, Approved, TestsFailed, Keep, Pause}\n247\t+\treturn []string{Pending, ExecutorFailed, NeedsHuman, NeedsApproval, Hold, Approved, TestsFailed, Keep, Pause, P0, P1, P2, P3}\n248\t+}\n249\t+\n250\t+// Priorities lists the priority labels, highest priority first.\n251\t+func Priorities() []string { return []string{P0, P1, P2, P3} }\n252\t+\n253\t+// IsPriority reports whether l is one of the priority labels\n254\t+// (case-insensitively).\n255\t+func IsPriority(l string) bool {\n256\t+\tfor _, p := range Priorities() {\n257\t+\t\tif strings.EqualFold(l, p) {\n258\t+\t\t\treturn true\n259\t+\t\t}\n260\t+\t}\n261\t+\treturn false\n262\t+}\n263\t+\n264\t+// Priority returns 0..3 for the highest priority label in ls (P0 is 0). With\n265\t+// no priority label it returns DefaultPriority (2).\n266\t+func Priority(ls []string) int {\n267\t+\tbest := -1\n268\t+\tfor _, l := range ls {\n269\t+\t\tfor i, p := range Priorities() {\n270\t+\t\t\tif strings.EqualFold(l, p) && (best < 0 || i < best) {\n271\t+\t\t\t\tbest = i\n272\t+\t\t\t}\n273\t+\t\t}\n274\t+\t}\n275\t+\tif best < 0 {\n276\t+\t\treturn DefaultPriority\n277\t+\t}\n278\t+\treturn best\n279\t }\n280\t \n281\t // Name builds ard:<stage>:<role>[:<state>]. Request(StageTriage, \"lead\") is\n282\tdiff --git a/internal/labels/labels_test.go b/internal/labels/labels_test.go\n283\tindex ea89dec..6ee6f06 100644\n284\t--- a/internal/labels/labels_test.go\n285\t+++ b/internal/labels/labels_test.go\n286\t@@ -88,8 +88,8 @@ func TestValidRoleName(t *testing.T) {\n287\t }\n288\t \n289\t func TestStaticAreParsedStatic(t *testing.T) {\n290\t-\tif len(Static()) != 9 {\n291\t-\t\tt.Fatalf(\"Static() has %d labels, want 9\", len(Static()))\n292\t+\tif len(Static()) != 13 {\n293\t+\t\tt.Fatalf(\"Static() has %d labels, want 13\", len(Static()))\n294\t \t}\n295\t \tfor _, s := range Static() {\n296\t \t\tif p, ok := Parse(s); !ok || p.Kind != KindStatic {\n297\t@@ -134,3 +134,41 @@ func TestCheckIntake(t *testing.T) {\n298\t \t\t}\n299\t \t}\n300\t }\n301\t+\n302\t+func TestPriority(t *testing.T) {\n303\t+\ttests := []struct {\n304\t+\t\tname string\n305\t+\t\tin   []string\n306\t+\t\twant int\n307\t+\t}{\n308\t+\t\t{\"none\", nil, 2},\n309\t+\t\t{\"unrelated\", []string{\"bug\", Pending}, 2},\n310\t+\t\t{\"p1\", []string{P1}, 1},\n311\t+\t\t{\"p3\", []string{P3}, 3},\n312\t+\t\t{\"highest wins\", []string{P3, P0, P2}, 0},\n313\t+\t\t{\"mixed case\", []string{\"ARD:P1\", \"x\"}, 1},\n314\t+\t\t{\"p2 explicit\", []string{P2}, 2},\n315\t+\t}\n316\t+\tfor _, tc := range tests {\n317\t+\t\tif got := Priority(tc.in); got != tc.want {\n318\t+\t\t\tt.Errorf(\"%s: Priority(%v) = %d, want %d\", tc.name, tc.in, got, tc.want)\n319\t+\t\t}\n320\t+\t}\n321\t+}\n322\t+\n323\t+func TestPriorityLabelsAreStaticAndNotIntake(t *testing.T) {\n324\t+\tfor _, l := range Priorities() {\n325\t+\t\tif !IsPriority(strings.ToUpper(l)) {\n326\t+\t\t\tt.Errorf(\"IsPriority(%q) = false\", l)\n327\t+\t\t}\n328\t+\t\tif p, ok := Parse(l); !ok || p.Kind != KindStatic {\n329\t+\t\t\tt.Errorf(\"Parse(%q) = %v, %v; want static\", l, p, ok)\n330\t+\t\t}\n331\t+\t\tif CheckIntake(l) == nil {\n332\t+\t\t\tt.Errorf(\"CheckIntake(%q) accepted a priority label\", l)\n333\t+\t\t}\n334\t+\t}\n335\t