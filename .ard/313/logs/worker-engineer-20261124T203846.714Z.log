reate config dir: %w\", err)\n\t}\n\tif err := os.Chmod(cfg, 0o700); err != nil {\n\t\treturn \"\", fmt.Errorf(\"create config dir: %w\", err)\n\t}\n\treturn cfg, nil\n}\n\n// scrub removes each path from the worktree: a regular file or a symlink\n// (the link itself). A missing path is fine. It fails if the parent directory\n// is a symlink (os.Root would follow it inside the worktree) and never removes\n// a directory.\nfunc scrub(wt string, paths []string) error {\n\tif len(paths) == 0 {\n\t\treturn nil\n\t}\n\tr, err := os.OpenRoot(wt)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"open worktree: %w\", err)\n\t}\n\tdefer r.Close()\n\tfor _, p := range paths {\n\t\trel := filepath.FromSlash(p)\n\t\tparent, err := r.Lstat(filepath.Dir(rel))\n\t\tswitch {\n\t\tcase errors.Is(err, fs.ErrNotExist):\n\t\t\tcontinue\n\t\tcase err != nil:\n\t\t\treturn fmt.Errorf(\"scrub %s: %w\", p, err)\n\t\tcase parent.Mode()&fs.ModeSymlink != 0 || !parent.IsDir():\n\t\t\treturn fmt.Errorf(\"scrub %s: parent %s is not a plain directory\", p, filepath.Dir(p))\n\t\t}\n\t\tst, err := r.Lstat(rel)\n\t\tswitch {\n\t\tcase errors.Is(err, fs.ErrNotExist):\n\t\t\tcontinue\n\t\tcase err != nil:\n\t\t\treturn fmt.Errorf(\"scrub %s: %w\", p, err)\n\t\tcase !st.Mode().IsRegular() && st.Mode()&fs.ModeSymlink == 0:\n\t\t\treturn fmt.Errorf(\"scrub %s: not a file\", p)\n\t\t}\n\t\tif err := r.Remove(rel); err != nil && !errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn fmt.Errorf(\"scrub %s: %w\", p, err)\n\t\t}\n\t}\n\treturn nil\n}\n\n// rejectSymlink fails when rel already exists as a symlink: even a link that\n// stays inside the worktree would let a branch swap what an input resolves to.\nfunc rejectSymlink(r *os.Root, rel string) error {\n\tif st, err := r.Lstat(rel); err == nil && st.Mode()&fs.ModeSymlink != 0 {\n\t\treturn fmt.Errorf(\"%s is a symlink\", rel)\n\t}\n\treturn nil\n}\nEOF\ncat > workspace.go <<'EOF'\npackage workspace\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n)\n\n// Git is the small slice of git the workspace needs for worktrees.\ntype Git interface {\n\tRevParse(ctx context.Context, repo, rev string) (string, error)\n\t// WorktreeAdd creates a detached worktree at dir, at sha.\n\tWorktreeAdd(ctx context.Context, repo, dir, sha string) error\n\tWorktreeRemove(ctx context.Context, repo, dir string, force bool) error\n\tWorktreePrune(ctx context.Context, repo string) error\n}\n\n// Options configures a Workspace.\ntype Options struct {\n\tRoot string // absolute; required\n\tGit  Git    // required: the worktree runner\n\n\tSidecarGit     SidecarGit               // default gitx.New(\"\")\n\tSidecarURL     func(repo string) string // default https://github.com/<repo>.git\n\tSidecarToken   gitx.TokenFunc           // nil = no auth header\n\tSidecarTimeout time.Duration            // init + fetch + export bound; default 2m\n\n\t// CloneDir, if set, is the only repository Remove runs git worktree\n\t// admin in. A handle whose RepoDir differs (stored before #113, when\n\t// RepoDir was the operator's checkout) has its worktree made writable and\n\t// removed with os.RemoveAll, with no git call, and one\n\t// executor.cleanup_foreign_repo Info log. \"\" = always use h.RepoDir.\n\tCloneDir string\n\n\tNow func() time.Time\n\tLog *slog.Logger\n}\n\n// Workspace builds and removes job directories under Root.\ntype Workspace struct {\n\troot           string\n\tgit            Git\n\tsgit           SidecarGit\n\tsidecarURL     func(repo string) string\n\tsidecarToken   gitx.TokenFunc\n\tsidecarTimeout time.Duration\n\tcloneDir       string\n\tnow            func() time.Time\n\tlog            *slog.Logger\n\n\tmu           sync.Mutex\n\tsidecarLocks map[string]chan struct{} // per cache dir, 1-buffer slot; guarded by mu\n}\n\n// New returns a Workspace with defaults applied.\nfunc New(o Options) (*Workspace, error) {\n\tif !filepath.IsAbs(o.Root) {\n\t\treturn nil, fmt.Errorf(\"root %q is not absolute\", o.Root)\n\t}\n\tif o.Git == nil {\n\t\treturn nil, fmt.Errorf(\"workspace: no git runner\")\n\t}\n\tif o.Now == nil {\n\t\to.Now = time.Now\n\t}\n\tif o.Log == nil {\n\t\to.Log = slog.Default()\n\t}\n\tif o.SidecarGit == nil {\n\t\to.SidecarGit = gitx.New(\"\")\n\t}\n\tif o.SidecarURL == nil {\n\t\to.SidecarURL = defaultSidecarURL\n\t}\n\tif o.SidecarTimeout <= 0 {\n\t\to.SidecarTimeout = defaultSidecarTimeout\n\t}\n\treturn &Workspace{root: o.Root, git: o.Git, sgit: o.SidecarGit, sidecarURL: o.SidecarURL,\n\t\tsidecarToken: o.SidecarToken, sidecarTimeout: o.SidecarTimeout, cloneDir: cleanDir(o.CloneDir),\n\t\tnow: o.Now, log: o.Log, sidecarLocks: map[string]chan struct{}{}}, nil\n}\n\n// cleanDir is filepath.Clean, but keeps \"\" as \"\".\nfunc cleanDir(p string) string {\n\tif p == \"\" {\n\t\treturn \"\"\n\t}\n\treturn filepath.Clean(p)\n}\n\nvar _ = os.Stat\nEOF\nsed -i '/^var _ = os.Stat$/d;/^\\t\"os\"$/d' workspace.go\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3274,"cache_read_input_tokens":47060,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3274},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8bdaac18-5a4f-4826-ae27-f4bf499b1975","uuid":"18d588ba-8616-4a76-91be-b22e5295e937","timestamp":"2026-11-24T20:39:40.409Z","request_id":"req_011ChNQ4guWZPiodvdRZxGAi"}
