{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Skz3QJFjSJzCAKubybJMyu","type":"tool_result","content":".:\nerrors.go\nexecutor.go\nlocal\nvalidate.go\nvalidate_test.go\n\nlocal:\nagentimage_test.go\nbytesreader.go\ncleanup_test.go\nconfigdir_test.go\ndocker.go\ndocker_integration_test.go\nenv.go\ngit.go\nhostwarn.go\nhostwarn_test.go\nlayout.go\nlocal.go\nlocal_test.go\nmisc_test.go\nproc_other.go\nproc_unix.go\nsidecar.go\nsidecar_test.go\ntail.go\ntestdata\nzombie_linux.go\nzombie_linux_test.go\nzombie_other.go\nzombie_test.go\n     190 local/agentimage_test.go\n       8 local/bytesreader.go\n     101 local/cleanup_test.go\n     260 local/configdir_test.go\n     159 local/docker.go\n     114 local/docker_integration_test.go\n     156 local/env.go\n     112 local/git.go\n      80 local/hostwarn.go\n     149 local/hostwarn_test.go\n      50 local/layout.go\n     486 local/local.go\n     842 local/local_test.go\n     166 local/misc_test.go\n       6 local/proc_other.go\n     333 local/proc_unix.go\n     166 local/sidecar.go\n     433 local/sidecar_test.go\n      48 local/tail.go\n      32 local/zombie_linux.go\n      28 local/zombie_linux_test.go\n       7 local/zombie_other.go\n      49 local/zombie_test.go\n    3975 total\npackage local\n\nimport (\n\t\"fmt\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/repopath\"\n)\n\n// repoDir is <root>/<kind>/<owner>/<repo>, lowercased and validated.\nfunc (l *Local) repoDir(kind, repo string) (string, error) {\n\treturn repopath.Join(filepath.Join(l.root, kind), repo)\n}\n\n// WorktreePath is where a job's worktree lives.\nfunc (l *Local) WorktreePath(repo, jobID string) (string, error) {\n\td, err := l.repoDir(\"work\", repo)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\treturn filepath.Join(d, jobID), nil\n}\n\nfunc (l *Local) homePath(repo, jobID string) (string, error) {\n\td, err := l.repoDir(\"work\", repo)\n\tif err != nil {\n\t\treturn \"\",