[b:]\n# remove configDirName const\na=s.index('// configDirName'); b=s.index('// Prepare creates')\ns=s[:a]+s[b:]\n# Prepare\na=s.index('// Prepare creates'); b=s.index('// chmodReadOnly removes')\nprep='''// Prepare builds the job's directories through the workspace and, for a\n// Dockerfile role, ensures the image. It starts no process.\nfunc (l *Local) Prepare(ctx context.Context, j executor.Job) (h executor.Handle, err error) {\n\th, err = l.ws.Prepare(ctx, j)\n\tif err != nil {\n\t\treturn h, err\n\t}\n\tdefer func() {\n\t\tif err != nil {\n\t\t\tif derr := l.ws.Discard(context.WithoutCancel(ctx), h); derr != nil {\n\t\t\t\terr = errors.Join(err, derr)\n\t\t\t}\n\t\t\th = executor.Handle{}\n\t\t}\n\t}()\n\tuseDocker := j.Dockerfile != \"\"\n\tif !useDocker && l.agentImage != \"\" && !j.TrustedInput {\n\t\tuseDocker = true\n\t}\n\tif useDocker {\n\t\th.Kind = \"docker\"\n\t\th.Container = \"ard-\" + j.ID\n\t\tif j.Dockerfile != \"\" {\n\t\t\t// A role's own Dockerfile wins over the default image.\n\t\t\th.Image, err = l.ensureImage(ctx, j, h.LogPath)\n\t\t} else {\n\t\t\t// No fallback to host mode: any failure fails Prepare.\n\t\t\th.Image = l.agentImage\n\t\t\terr = l.ensurePulled(ctx, l.agentImage, h.LogPath)\n\t\t}\n\t\tif err != nil {\n\t\t\treturn h, err\n\t\t}\n\t\th.View = executor.Paths{Work: \"/work\", Role: \"/role\", ConfigDir: \"/ard-config\"}\n\t\tif h.HistoryDir != \"\" {\n\t\t\th.View.History = \"/history\"\n\t\t}\n\t\tif h.SidecarDir != \"\" {\n\t\t\th.View.Sidecar = \"/sidecar\"\n\t\t}\n\t} else if j.ReadOnly {\n\t\t// Last: nothing else may need to write into the worktree.\n\t\tif err = workspace.ChmodReadOnly(h.Worktree); err != nil {\n\t\t\treturn h, fmt.Errorf(\"make worktree read-only: %w\", err)\n\t\t}\n\t}\n\treturn h, nil\n}\n\n// WorktreePath is where a job's worktree lives.\nfunc (l *Local) WorktreePath(repo, jobID string) (string, error) {\n\treturn l.ws.WorktreePath(repo, jobID)\n}\n\n// LogBase is the log file basename (no extension); see workspace.LogBase.\nfunc LogBase(stage, role string, ts time.Time) string { return workspace.LogBase(stage, role, ts) }\n\n'''\ns=s[:a]+prep+s[b:]\n# drop chmod funcs\na=s.index('// chmodReadOnly removes'); b=s.index('// Logs opens')\ns=s[:a]+s[b:]\n# Prune and scrub etc\na=s.index('// Prune deletes')\ns=s[:a]+'''// Prune deletes host log files older than olderThan, then empty dirs.\nfunc (l *Local) Prune(ctx context.Context, olderThan time.Duration) error {\n\treturn l.ws.Prune(ctx, olderThan)\n}\n'''\ns=s.replace('\\t\"io/fs\"\\n','').replace('\\t\"github.com/albertcbrown/ard/internal/gitx\"\\n','\\t\"github.com/albertcbrown/ard/internal/executor/workspace\"\\n')\nopen('local.go','w').write(s)\n\np=open('proc_unix.go').read()\na=p.index('\\tif !o.KeepWorktree {'); b=p.index('\\tif tr := l.track(h.JobID); tr != nil {\\n\\t\\tselect')\np=p[:a]+'''\tif !o.KeepWorktree {\n\t\tif err := l.ws.Remove(ctx, h); err != nil {\n\t\t\terrs = append(errs, err)\n\t\t}\n\t}\n'''+p[b:]\np=p.replace('l.checkEnv(','l.policy().CheckEnv(').replace('l.checkFixed(','l.policy().CheckFixed(')\nopen('proc_unix.go','w').write(p)\nd=open('docker.go').read()\nd=d.replace('ardEnv(h)','executor.ArdEnv(h)').replace('configDirName','workspace.ConfigDirName')\nopen('docker.go','w').write(d)\ng=open('git.go').read()\na=g.index('// gitRunner is'); b=g.index('type execGit')\ng=g[:a]+'// gitRunner is the git slice the executor needs for worktrees.\\ntype gitRunner = workspace.Git\\n\\n'+g[b:]\nopen('git.go','w').write(g)\ne=open('env.go').read()\ne+='''\n// policy is the env allow-list policy of this executor.\nfunc (l *Local) policy() executor.EnvPolicy {\n\treturn executor.EnvPolicy{AllowEnv: l.allowEnv, AllowFixed: l.allowFixed}\n}\n'''\nopen('env.go','w').write(e)\nEOF\nhead -20 git.go docker.go | grep -n \"import\\|\\\"\" ; gofmt -l .; go build ./ 2>&1 | head -30"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tok