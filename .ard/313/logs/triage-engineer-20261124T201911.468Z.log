121\t\t\to.AllowFixed = []string{\"CLAUDE_CONFIG_DIR\", \"DISABLE_AUTOUPDATER\", \"CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC\", \"CLAUDE_CODE_DISABLE_BACKGROUND_TASKS\"}\n122\t\t}\n123\t\tif o.ConfigDirEnv == \"\" {\n124\t\t\to.ConfigDirEnv = \"CLAUDE_CONFIG_DIR\"\n125\t\t}\n126\t\tif o.KillGrace <= 0 {\n127\t\t\to.KillGrace = 10 * time.Second\n128\t\t}\n129\t\tif o.BuildTimeout <= 0 {\n130\t\t\to.BuildTimeout = 15 * time.Minute\n131\t\t}\n132\t\tif o.Now == nil {\n133\t\t\to.Now = time.Now\n134\t\t}\n135\t\tif o.Log == nil {\n136\t\t\to.Log = slog.Default()\n137\t\t}\n138\t\tif o.SidecarGit == nil {\n139\t\t\to.SidecarGit = gitx.New(\"\")\n140\t\t}\n141\t\tif o.SidecarURL == nil {\n142\t\t\to.SidecarURL = defaultSidecarURL\n143\t\t}\n144\t\tif o.SidecarTimeout <= 0 {\n145\t\t\to.SidecarTimeout = defaultSidecarTimeout\n146\t\t}\n147\t\tallow := map[string]bool{}\n148\t\tfor _, n := range o.AllowEnv {\n149\t\t\tallow[n] = true\n150\t\t}\n151\t\tfixed := map[string]bool{}\n152\t\tfor _, n := range o.AllowFixed {\n153\t\t\tfixed[n] = true\n154\t\t}\n155\t\treturn &Local{configDirEnv: o.ConfigDirEnv, allowFixed: fixed, root: o.Root, dockerBin: o.DockerBin, agentImage: o.AgentImage, pathEnv: o.PathEnv, git: o.Git,\n156\t\t\tallowEnv: allow, grace: o.KillGrace, buildTimeout: o.BuildTimeout, now: o.Now, log: o.Log, onHostUntrusted: o.OnHostUntrusted,\n157\t\t\ttracks: map[string]*track{}, sgit: o.SidecarGit, sidecarURL: o.SidecarURL, sidecarToken: o.SidecarToken,\n158\t\t\tsidecarTimeout: o.SidecarTimeout, cloneDir: cleanDir(o.CloneDir)}, nil\n159\t}\n160\t\n161\t// configDirName is the per-job agent config dir inside the job home. Under\n162\t// HOME, the CLI's default ~/.claude resolves to the same fresh dir even if\n163\t// the config-dir variable were dropped.\n164\tconst configDirName = \".claude\"\n165\t\n166\t// Prepare creates the worktree, writes inputs, creates log files and, for a\n167\t// Dockerfile role, ensures the image. It starts no process.\n168\tfunc (l *Local) Prepare(ctx context.Context, j executor.Job) (h executor.Handle, err error) {\n169\t\tif err := j.Validate(); err != nil {\n170\t\t\treturn h, err\n171\t\t}\n172\t\twt, err := l.WorktreePath(j.Repo, j.ID)\n173\t\tif err != nil {\n174\t\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, err)\n175\t\t}\n176\t\tif _, err := os.Lstat(wt); err == nil {\n177\t\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, executor.ErrExists)\n178\t\t}\n179\t\tsha, err := l.git.RevParse(ctx, j.RepoDir, j.Ref)\n180\t\tif err != nil {\n181\t\t\treturn h, fmt.Errorf(\"resolve ref %q: %w: %w\", j.Ref, executor.ErrClone, err)\n182\t\t}\n183\t\tnow := l.now().UTC()\n184\t\tbase := LogBase(j.Stage, j.Role, now)\n185\t\tlogDir, err := l.logDir(j.Repo, j.Issue)\n186\t\tif err != nil {\n187\t\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, err)\n188\t\t}\n189\t\thome, err := l.homePath(j.Repo, j.ID)\n190\t\tif err != nil {\n191\t\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, err)\n192\t\t}\n193\t\th = executor.Handle{\n194\t\t\tJobID: j.ID, Kind: \"host\", Issue: j.Issue, Stage: j.Stage, Role: j.Role,\n195\t\t\tWorktree: wt, Home: home, RepoDir: j.RepoDir, BaseSHA: sha,\n196\t\t\tLogPath: filepath.Join(logDir, base+\".log\"), StdoutPath: filepath.Join(logDir, base+\".stdout\"),\n197\t\t\tView:    executor.Paths{Work: wt, Role: j.RoleDir},\n198\t\t\tRoleDir: j.RoleDir, ReadOnly: j.ReadOnly, Network: j.Network,\n199\t\t\tTrustedInput: j.TrustedInput, PreparedAt: now, Timeout: j.Timeout,\n200\t\t}\n201\t\tvar created []string // paths to remove on failure\n202\t\tworktreeAdded := false\n203\t\tdefer func() {\n204\t\t\tif err == nil {\n205\t\t\t\treturn\n206\t\t\t}\n207\t\t\tif worktreeAdded {\n208\t\t\t\tchmodWritable(wt)\n209\t\t\t\tif rerr := l.git.WorktreeRemove(context.WithoutCancel(ctx), j.RepoDir, wt, true); rerr != nil {\n210\t\t\t\t\terr = errors.Join(err, rerr)\n211\t\t\t\t}\n212\t\t\t\tremoveAllWritable(wt)\n213\t\t\t\tl.git.WorktreePrune(context.WithoutCancel(ctx), j.RepoDir)\n214\t\t\t}\n215\t\t\tfor _, p := range created {\n216\t\t\t\tremoveAllWritable(p) // a sidecar tree under home is a-w\n217\t\t\t}\n218\t\t\th = executor.Handle{}\n219\t\t}()\n220\t\n221\t\tif err = os.MkdirAll(filepath.Dir(wt), 0o755); err != nil {\n222\t\t\treturn h, fmt.Errorf(\"create work dir: %w\", err)\n223\t\t}\n224\t\tif err = l.git.WorktreeAdd(ctx, j.RepoDir, wt, sha); err != nil {\n225\t\t\treturn h, fmt.Errorf(\"add worktree: %w: %w\", executor.ErrClone, err)\n226\t\t}\n227\t\tworktreeAdded = true\n228\t\tif err = scrub(wt, j.Scrub); err != nil {\n229\t\t\treturn h, err\n230\t\t}\n231\t\th.Scrubbed = append([]string(nil), j.Scrub...)\n232\t\tif len(j.Inputs) > 0 {\n233\t\t\t// os.Root refuses to follow symlinks out of the worktree, so a\n234\t\t\t// committed symlink at an input path cannot redirect the write.\n235\t\t\tvar r *os.Root\n236\t\t\tif r, err = os.OpenRoot(wt); err != nil {\n237\t\t\t\treturn h, fmt.Errorf(\"open worktree: %w\", err)\n238\t\t\t}\n239\t\t\tdefer r.Close()\n240\t\t\tfor _, f := range j.Inputs {\n241\t\t\t\trel := filepath.FromSlash(f.Path)\n242\t\t\t\tif err = r.MkdirAll(filepath.Dir(rel), 0o755); err != nil {\n243\t\t\t\t\treturn h, fmt.Errorf(\"write input %s: %w\", f.Path, err)\n244\t\t\t\t}\n245\t\t\t\tif err = rejectSymlink(r, rel); err != nil {\n246\t\t\t\t\treturn h, fmt.Errorf(\"write input %s: %w\", f.Path, err)\n247\t\t\t\t}\n248\t\t\t\tif err = r.WriteFile(rel, f.Data, 0o644); err != nil {\n249\t\t\t\t\treturn h, fmt.Errorf(\"write input %s: %w\", f.Path, err)\n250\t\t\t\t}\n251\t\t\t}\n252\t\t}\n253\t\tif err = os.MkdirAll(filepath.Join(home, \"tmp\"), 0o700); err != nil {\n254\t\t\treturn h, fmt.Errorf(\"create home: %w\", err)\n255\t\t}\n256\t\tcreated = append(created, home)\n257\t\t// The config dir lives inside home, so Cleanup and this function's\n258\t\t// failure path remove it with home. 0700 is forced past the umask.\n259\t\tcfg := filepath.Join(home, configDirName)\n260\t\tif err = os.Mkdir(cfg, 0o700); err != nil {\n261\t\t\treturn h, fmt.Errorf(\"create config dir: %w\", err)\n262\t\t}\n263\t\tif err = os.Chmod(cfg, 0o700); err != nil {\n264\t\t\treturn h, fmt.Errorf(\"create config dir: %w\", err)\n265\t\t}\n266\t\th.View.ConfigDir = cfg\n267\t\tif j.History {\n268\t\t\t// Host mode hands over the live clone: read-only is enforced only by the\n269\t\t\t// Docker mount (:ro), not on the host.\n270\t\t\th.HistoryDir, h.View.History = j.RepoDir, j.RepoDir\n271\t\t}\n272\t\t// --- sidecar (#28): the executor clones, pins and mounts it read-only ---\n273\t\tif j.Sidecar != (executor.Sidecar{}) {\n274\t\t\tdest := filepath.Join(home, sidecarDirName)\n275\t\t\tvar scSHA string\n276\t\t\tvar fetched bool\n277\t\t\tif scSHA, fetched, err = l.materialise(ctx, j.Repo, j.Sidecar, dest); err != nil {\n278\t\t\t\treturn h, err\n279\t\t\t}\n280\t\t\th.SidecarDir, h.Sidecar, h.SidecarSHA = dest, j.Sidecar, scSHA\n281\t\t\th.View.Sidecar = dest\n282\t\t\tl.log.Info(\"executor.sidecar_ready\", \"job\", j.ID, \"repo\", j.Sidecar.Repo, \"ref\", j.Sidecar.Ref, \"sha\", scSHA, \"fetched\", fetched)\n283\t\t}\n284\t\t// --- end sidecar ---\n285\t\tif err = os.MkdirAll(logDir, 0o700); err != nil {\n286\t\t\treturn h, fmt.Errorf(\"create log dir: %w\", err)\n287\t\t}\n288\t\tfor _, p := range []string{h.LogPath, h.StdoutPath} {\n289\t\t\tvar f *os.File\n290\t\t\tif f, err = os.OpenFile(p, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o600); err != nil {\n291\t\t\t\treturn h, fmt.Errorf(\"create log %s: %w\", p, err)\n292\t\t\t}\n293\t\t\tf.Close()\n294\t\t\tcreated = append(created, p)\n295\t\t}\n296\t\tif h.SidecarDir != \"\" { // #28: read-only in both modes; Docker also mounts :ro\n297\t\t\tif err = chmodReadOnly(h.SidecarDir); err != nil {\n298\t\t\t\treturn h, fmt.Errorf(\"make sidecar read-only: %w\", err)\n299\t\t\t}\n300\t\t}\n301\t\tuseDocker := j.Dockerfile != \"\"\n302\t\tif !useDocker && l.agentImage != \"\" && !j.TrustedInput {\n303\t\t\tuseDocker = true\n304\t\t}\n305\t\tif useDocker {\n306\t\t\th.Kind = \"docker\"\n307\t\t\th.Container = \"ard-\" + j.ID\n308\t\t\tif j.Dockerfile != \"\" {\n309\t\t\t\t// A role's own Dockerfile wins over the default image.\n310\t\t\t\th.Image, err = l.ensureImage(ctx, j, h.LogPath)\n311\t\t\t} else {\n312\t\t\t\t// No fallback to host mode: any failure fails Prepare.\n313\t\t\t\th.Image = l.agentImage\n314\t\t\t\terr = l.ensurePulled(ctx, l.agentImage, h.LogPath)\n315\t\t\t}\n316\t\t\tif err != nil {\n317\t\t\t\treturn h, err\n318\t\t\t}\n319\t\t\th.View = executor.Paths{Work: \"/work\", Role: \"/role\", ConfigDir: \"/ard-config\"}\n320\t\t\tif h.HistoryDir != \"\" {\n321\t\t\t\th.View.History = \"/history\"\n322\t\t\t}\n323\t\t\tif h.SidecarDir != \"\" {\n324\t\t\t\th.View.Sidecar = \"/sidecar\"\n325\t\t\t}\n326\t\t} else if j.ReadOnly {\n327\t\t\t// Last: nothing else may need to write into the worktree.\n328\t\t\tif err = chmodReadOnly(wt); err != nil {\n329\t\t\t\treturn h, fmt.Errorf(\"make worktree read-only: %w\", err)\n330\t\t\t}\n331\t\t}\n332\t\treturn h, nil\n333\t}\n334\t\n335\t// chmodReadOnly removes write permission recursively (host mode ReadOnly).\n336\tfunc chmodReadOnly(root string) error {\n337\t\treturn filepath.WalkDir(root, func(p string, d fs.DirEntry, err error) error {\n338\t\t\tif err != nil || d.Type()&fs.ModeSymlink != 0 {\n339\t\t\t\treturn err\n340\t\t\t}\n341\t\t\tst, err := d.Info()\n342\t\t\tif err != nil {\n343\t\t\t\treturn err\n344\t\t\t}\n345\t\t\treturn os.Chmod(p, st.Mode().Perm()&^0o222)\n346\t\t})\n347\t}\n348\t\n349\t// chmodWritable restores owner write permission so the tree can be removed.\n350\t// Directories are made writable and searchable before they are read, so a\n351\t// 0000 or 0555 directory (the Go module cache) is handled. Symlinks are\n352\t// never followed or chmodded.\n353\tfunc chmodWritable(root string) {\n354\t\tst, err := os.Lstat(root)\n355\t\tif err != nil || st.Mode()&fs.ModeSymlink != 0 {\n356\t\t\treturn\n357\t\t}\n358\t\tif !st.IsDir() {\n359\t\t\tif st.Mode().IsRegular() {\n360\t\t\t\tos.Chmod(root, st.Mode().Perm()|0o200)\n361\t\t\t}\n362\t\t\treturn\n363\t\t}\n364\t\tos.Chmod(root, st.Mode().Perm()|0o700)\n365\t\tentries, err := os.ReadDir(root)\n366\t\tif err != nil {\n367\t\t\treturn\n368\t\t}\n369\t\tfor _, e := range entries {\n370\t\t\tchmodWritable(filepath.Join(root, e.Name()))\n371\t\t}\n372\t}\n373\t\n374\t// removeAllWritable removes path even when it holds read-only trees.\n375\tfunc removeAllWritable(path string) error {\n376\t\tchmodWritable(path)\n377\t\treturn os.RemoveAll(path)\n378\t}\n379\t\n380\t// Logs opens the selected log file.\n381\tfunc (l *Local) Logs(ctx context.Context, h executor.Handle, o executor.LogsOptions) (io.ReadCloser, error) {\n382\t\tp := h.LogPath\n383\t\tif o.Stream == executor.Stdout {\n384\t\t\tp = h.StdoutPath\n385\t\t}\n386\t\tf, err := os.Open(p)\n387\t\tif err != nil {\n388\t\t\treturn nil, fmt.Errorf(\"open log: %w\", err)\n389\t\t}\n390\t\tif o.TailLines <= 0 {\n391\t\t\treturn f, nil\n392\t\t}\n393\t\tdefer f.Close()\n394\t\tb, err := tailLines(f, o.TailLines)\n395\t\tif err != nil {\n396\t\t\treturn nil, fmt.Errorf(\"tail log: %w\", err)\n397\t\t}\n398\t\treturn io.NopCloser(bytesReader(b)), nil\n399\t}\n400\t\n401\t// Prune deletes host log files older than olderThan, then empty dirs.\n402\tfunc (l *Local) Prune(ctx context.Context, olderThan time.Duration) error {\n403\t\tcutoff := l.now().Add(-olderThan)\n404\t\tdir := filepath.Join(l.root, \"logs\")\n405\t\tvar dirs []string\n406\t\terr := filepath.WalkDir(dir, func(p string, d fs.DirEntry, err error) error {\n407\t\t\tif err != nil {\n408\t\t\t\tif errors.Is(err, fs.ErrNotExist) {\n409\t\t\t\t\treturn nil\n410\t\t\t\t}\n411\t\t\t\treturn err\n412\t\t\t}\n413\t\t\tif d.IsDir() {\n414\t\t\t\tdirs = append(dirs, p)\n415\t\t\t\treturn nil\n416\t\t\t}\n417\t\t\tif st, e := d.Info(); e == nil && st.ModTime().Before(cutoff) {\n418\t\t\t\treturn os.Remove(p)\n419\t\t\t}\n420\t\t\treturn nil\n421\t\t})\n422\t\tfor i := len(dirs) - 1; i > 0; i-- { // deepest first, keep logs/ itself\n423\t\t\tos.Remove(dirs[i]) // fails harmlessly when not empty\n424\t\t}\n425\t\tif err != nil {\n426\t\t\treturn fmt.Errorf(\"prune logs: %w\", err)\n427\t\t}\n428\t\treturn nil\n429\t}"}]},"parent_tool_use_id":null,"session_id":"51958001-3eb4-4bc4-913e-d4f98190c01b","uuid":"1f2b5cc8-973c-4eb4-9d01-80ea23c9e88d","timestamp":"2026-11-24T20:19:21.965Z","tool_use_result":{"type":"text","file":{"filePath":"/work/internal/executor/local/local.go","content":"\tPathEnv    string   // PATH for host jobs; default the controller's PATH\n\tAllowEnv   []string // model-key names; default ANTHROPIC_API_KEY, CLAUDE_CODE_OAUTH_TOKEN\n\tAllowFixed []string // names allowed in Command.Fixed; default CLAUDE_CONFIG_DIR, DISABLE_AUTOUPDATER, CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC, CLAUDE_CODE_DISABLE_BACKGROUND_TASKS\n\t// ConfigDirEnv is the Fixed name whose value must equal View.ConfigDir,\n\t// the job's own config dir. Default CLAUDE_CONFIG_DIR.\n\tConfigDirEnv string\n\tKillGrace    time.Duration // default 10s\n\tBuildTimeout time.Duration // default 15m\n\tNow          func() time.Time\n\tLog          *slog.Logger\n\t// OnHostUntrusted, if set, is called once per host-mode job that reads\n\t// untrusted input, right after the process starts. serve records an\n\t// events row through it. nil = log only.\n\tOnHostUntrusted func(ctx context.Context, h executor.Handle) error\n\n\t// Sidecar clone (see sidecar.go).\n\tSidecarGit     sidecarGit               // default gitx.New(\"\")\n\tSidecarURL     func(repo string) string // default https://github.com/<repo>.git\n\tSidecarToken   gitx.TokenFunc           // nil = no auth header (local remotes in tests)\n\tSidecarTimeout time.Duration            // init + fetch + export bound; default 2m\n\n\t// CloneDir, if set, is the only repository Cleanup runs git worktree\n\t// admin in. A handle whose RepoDir differs (stored before #113, when\n\t// RepoDir was the operator's checkout) has its worktree made writable and\n\t// removed with os.RemoveAll, with no git call, and one\n\t// executor.cleanup_foreign_repo Info log. \"\" = always use h.RepoDir.\n\tCloneDir string\n}\n\n// Local implements executor.Executor on this host.\ntype Local struct {\n\troot, dockerBin, pathEnv string\n\tagentImage               string\n\tgit                      gitRunner\n\tallowEnv, allowFixed     map[string]bool\n\tconfigDirEnv             string\n\tgrace, buildTimeout      time.Duration\n\tnow                      func() time.Time\n\tlog                      *slog.Logger\n\tonHostUntrusted          func(ctx context.Context, h executor.Handle) error\n\n\tsgit           sidecarGit\n\tsidecarURL     func(repo string) string\n\tsidecarToken   gitx.TokenFunc\n\tsidecarTimeout time.Duration\n\tcloneDir       string\n\n\tmu           sync.Mutex\n\ttracks       map[string]*track\n\tsidecarLocks map[string]chan struct{} // per cache dir, 1-buffer slot; guarded by mu\n}\n\nvar _ executor.Executor = (*Local)(nil)\n\nfunc defaultPath() string {\n\tif p := os.Getenv(\"PATH\"); p != \"\" {\n\t\treturn p\n\t}\n\treturn \"/usr/local/bin:/usr/bin:/bin\"\n}\n\n// New returns a Local with defaults applied.\nfunc New(o Options) (*Local, error) {\n\tif o.Root == \"\" {\n\t\thome, err := os.UserHomeDir()\n\t\tif err != nil {\n\t\t\treturn nil, fmt.Errorf(\"find home: %w\", err)\n\t\t}\n\t\to.Root = filepath.Join(home, \".ard\")\n\t}\n\tif !filepath.IsAbs(o.Root) {\n\t\treturn nil, fmt.Errorf(\"root %q is not absolute\", o.Root)\n\t}\n\tif o.Git == nil {\n\t\to.Git = execGit{bin: \"git\"}\n\t}\n\tif o.AgentImage != \"\" {\n\t\tif err := executor.CheckImageRef(o.AgentImage); err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t}\n\tif o.DockerBin == \"\" {\n\t\to.DockerBin = \"docker\"\n\t}\n\tif o.PathEnv == \"\" {\n\t\to.PathEnv = defaultPath()\n\t}\n\tif o.AllowEnv == nil {\n\t\to.AllowEnv = []string{\"ANTHROPIC_API_KEY\", \"CLAUDE_CODE_OAUTH_TOKEN\"}\n\t}\n\tif o.AllowFixed == nil {\n\t\to.AllowFixed = []string{\"CLAUDE_CONFIG_DIR\", \"DISABLE_AUTOUPDATER\", \"CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC\", \"CLAUDE_CODE_DISABLE_BACKGROUND_TASKS\"}\n\t}\n\tif o.ConfigDirEnv == \"\" {\n\t\to.ConfigDirEnv = \"CLAUDE_CONFIG_DIR\"\n\t}\n\tif o.KillGrace <= 0 {\n\t\to.KillGrace = 10 * time.Second\n\t}\n\tif o.BuildTimeout <= 0 {\n\t\to.BuildTimeout = 15 * time.Minute\n\t}\n\tif o.Now == nil {\n\t\to.Now = time.Now\n\t}\n\tif o.Log == nil {\n\t\to.Log = slog.Default()\n\t}\n\tif o.SidecarGit == nil {\n\t\to.SidecarGit = gitx.New(\"\")\n\t}\n\tif o.SidecarURL == nil {\n\t\to.SidecarURL = defaultSidecarURL\n\t}\n\tif o.SidecarTimeout <= 0 {\n\t\to.SidecarTimeout = defaultSidecarTimeout\n\t}\n\tallow := map[string]bool{}\n\tfor _, n := range o.AllowEnv {\n\t\tallow[n] = true\n\t}\n\tfixed := map[string]bool{}\n\tfor _, n := range o.AllowFixed {\n\t\tfixed[n] = true\n\t}\n\treturn &Local{configDirEnv: o.ConfigDirEnv, allowFixed: fixed, root: o.Root, dockerBin: o.DockerBin, agentImage: o.AgentImage, pathEnv: o.PathEnv, git: o.Git,\n\t\tallowEnv: allow, grace: o.KillGrace, buildTimeout: o.BuildTimeout, now: o.Now, log: o.Log, onHostUntrusted: o.OnHostUntrusted,\n\t\ttracks: map[string]*track{}, sgit: o.SidecarGit, sidecarURL: o.SidecarURL, sidecarToken: o.SidecarToken,\n\t\tsidecarTimeout: o.SidecarTimeout, cloneDir: cleanDir(o.CloneDir)}, nil\n}\n\n// configDirName is the per-job agent config dir inside the job home. Under\n// HOME, the CLI's default ~/.claude resolves to the same fresh dir even if\n// the config-dir variable were dropped.\nconst configDirName = \".claude\"\n\n// Prepare creates the worktree, writes inputs, creates log files and, for a\n// Dockerfile role, ensures the image. It starts no process.\nfunc (l *Local) Prepare(ctx context.Context, j executor.Job) (h executor.Handle, err error) {\n\tif err := j.Validate(); err != nil {\n\t\treturn h, err\n\t}\n\twt, err := l.WorktreePath(j.Repo, j.ID)\n\tif err != nil {\n\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, err)\n\t}\n\tif _, err := os.Lstat(wt); err == nil {\n\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, executor.ErrExists)\n\t}\n\tsha, err := l.git.RevParse(ctx, j.RepoDir, j.Ref)\n\tif err != nil {\n\t\treturn h, fmt.Errorf(\"resolve ref %q: %w: %w\", j.Ref, executor.ErrClone, err)\n\t}\n\tnow := l.now().UTC()\n\tbase := LogBase(j.Stage, j.Role, now)\n\tlogDir, err := l.logDir(j.Repo, j.Issue)\n\tif err != nil {\n\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, err)\n\t}\n\thome, err := l.homePath(j.Repo, j.ID)\n\tif err != nil {\n\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, err)\n\t}\n\th = executor.Handle{\n\t\tJobID: j.ID, Kind: \"host\", Issue: j.Issue, Stage: j.Stage, Role: j.Role,\n\t\tWorktree: wt, Home: home, RepoDir: j.RepoDir, BaseSHA: sha,\n\t\tLogPath: filepath.Join(logDir, base+\".log\"), StdoutPath: filepath.Join(logDir, base+\".stdout\"),\n\t\tView:    executor.Paths{Work: wt, Role: j.RoleDir},\n\t\tRoleDir: j.RoleDir, ReadOnly: j.ReadOnly, Network: j.Network,\n\t\tTrustedInput: j.TrustedInput, PreparedAt: now, Timeout: j.Timeout,\n\t}\n\tvar created []string // paths to remove on failure\n\tworktreeAdded := false\n\tdefer func() {\n\t\tif err == nil {\n\t\t\treturn\n\t\t}\n\t\tif worktreeAdded {\n\t\t\tchmodWritable(wt)\n\t\t\tif rerr := l.git.WorktreeRemove(context.WithoutCancel(ctx), j.RepoDir, wt, true); rerr != nil {\n\t\t\t\terr = errors.Join(err, rerr)\n\t\t\t}\n\t\t\tremoveAllWritable(wt)\n\t\t\tl.git.WorktreePrune(context.WithoutCancel(ctx), j.RepoDir)\n\t\t}\n\t\tfor _, p := range created {\n\t\t\tremoveAllWritable(p) // a sidecar tree under home is a-w\n\t\t}\n\t\th = executor.Handle{}\n\t}()\n\n\tif err = os.MkdirAll(filepath.Dir(wt), 0o755); err != nil {\n\t\treturn h, fmt.Errorf(\"create work dir: %w\", err)\n\t}\n\tif err = l.git.WorktreeAdd(ctx, j.RepoDir, wt, sha); err != nil {\n\t\treturn h, fmt.Errorf(\"add worktree: %w: %w\", executor.ErrClone, err)\n\t}\n\tworktreeAdded = true\n\tif err = scrub(wt, j.Scrub); err != nil {\n\t\treturn h, err\n\t}\n\th.Scrubbed = append([]string(nil), j.Scrub...)\n\tif len(j.Inputs) > 0 {\n\t\t// os.Root refuses to follow symlinks out of the worktree, so a\n\t\t// committed symlink at an input path cannot redirect the write.\n\t\tvar r *os.Root\n\t\tif r, err = os.OpenRoot(wt); err != nil {\n\t\t\treturn h, fmt.Errorf(\"open worktree: %w\", err)\n\t\t}\n\t\tdefer r.Close()\n\t\tfor _, f := range j.Inputs {\n\t\t\trel := filepath.FromSlash(f.Path)\n\t\t\tif err = r.MkdirAll(filepath.Dir(rel), 0o755); err != nil {\n\t\t\t\treturn h, fmt.Errorf(\"write input %s: %w\", f.Path, err)\n\t\t\t}\n\t\t\tif err = rejectSymlink(r, rel); err != nil {\n\t\t\t\treturn h, fmt.Errorf(\"write input %s: %w\", f.Path, err)\n\t\t\t}\n\t\t\tif err = r.WriteFile(rel, f.Data, 0o644); err != nil {\n\t\t\t\treturn h, fmt.Errorf(\"write input %s: %w\", f.Path, err)\n\t\t\t}\n\t\t}\n\t}\n\tif err = os.MkdirAll(filepath.Join(home, \"tmp\"), 0o700); err != nil {\n\t\treturn h, fmt.Errorf(\"create home: %w\", err)\n\t}\n\tcreated = append(created, home)\n\t// The config dir lives inside home, so Cleanup and this function's\n\t// failure path remove it with home. 0700 is forced past the umask.\n\tcfg := filepath.Join(home, configDirName)\n\tif err = os.Mkdir(cfg, 0o700); err != nil {\n\t\treturn h, fmt.Errorf(\"create config dir: %w\", err)\n\t}\n\tif err = os.Chmod(cfg, 0o700); err != nil {\n\t\treturn h, fmt.Errorf(\"create config dir: %w\", err)\n\t}\n\th.View.ConfigDir = cfg\n\tif j.History {\n\t\t// Host mode hands over the live clone: read-only is enforced only by the\n\t\t// Docker mount (:ro), not on the host.\n\t\th.HistoryDir, h.View.History = j.RepoDir, j.RepoDir\n\t}\n\t// --- sidecar (#28): the executor clones, pins and mounts it read-only ---\n\tif j.Sidecar != (executor.Sidecar{}) {\n\t\tdest := filepath.Join(home, sidecarDirName)\n\t\tvar scSHA string\n\t\tvar fetched bool\n\t\tif scSHA, fetched, err = l.materialise(ctx, j.Repo, j.Sidecar, dest); err != nil {\n\t\t\treturn h, err\n\t\t}\n\t\th.SidecarDir, h.Sidecar, h.SidecarSHA = dest, j.Sidecar, scSHA\n\t\th.View.Sidecar = dest\n\t\tl.log.Info(\"executor.sidecar_ready\", \"job\", j.ID, \"repo\", j.Sidecar.Repo, \"ref\", j.Sidecar.Ref, \"sha\", scSHA, \"fetched\", fetched)\n\t}\n\t// --- end sidecar ---\n\tif err = os.MkdirAll(logDir, 0o700); err != nil {\n\t\treturn h, fmt.Errorf(\"create log dir: %w\", err)\n\t}\n\tfor _, p := range []string{h.LogPath, h.StdoutPath} {\n\t\tvar f *os.File\n\t\tif f, err = os.OpenFile(p, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o600); err != nil {\n\t\t\treturn h, fmt.Errorf(\"create log %s: %w\", p, err)\n\t\t}\n\t\tf.Close()\n\t\tcreated = append(created, p)\n\t}\n\tif h.SidecarDir != \"\" { // #28: read-only in both modes; Docker also mounts :ro\n\t\tif err = chmodReadOnly(h.SidecarDir); err != nil {\n\t\t\treturn h, fmt.Errorf(\"make sidecar read-only: %w\", err)\n\t\t}\n\t}\n\tuseDocker := j.Dockerfile != \"\"\n\tif !useDocker && l.agentImage != \"\" && !j.TrustedInput {\n\t\tuseDocker = true\n\t}\n\tif useDocker {\n\t\th.Kind = \"docker\"\n\t\th.Container = \"ard-\" + j.ID\n\t\tif j.Dockerfile != \"\" {\n\t\t\t// A role's own Dockerfile wins over the default image.\n\t\t\th.Image, err = l.ensureImage(ctx, j, h.LogPath)\n\t\t} else {\n\t\t\t// No fallback to host mode: any failure fails Prepare.\n\t\t\th.Image = l.agentImage\n\t\t\terr = l.ensurePulled(ctx, l.agentImage, h.LogPath)\n\t\t}\n\t\tif err != nil {\n\t\t\treturn h, err\n\t\t}\n\t\th.View = executor.Paths{Work: \"/work\", Role: \"/role\", ConfigDir: \"/ard-config\"}\n\t\tif h.HistoryDir != \"\" {\n\t\t\th.View.History = \"/history\"\n\t\t}\n\t\tif h.SidecarDir != \"\" {\n\t\t\th.View.Sidecar = \"/sidecar\"\n\t\t}\n\t} else if j.ReadOnly {\n\t\t// Last: nothing else may need to write into the worktree.\n\t\tif err = chmodReadOnly(wt); err != nil {\n\t\t\treturn h, fmt.Errorf(\"make worktree read-only: %w\", err)\n\t\t}\n\t}\n\treturn h, nil\n}\n\n// chmodReadOnly removes write permission recursively (host mode ReadOnly).\nfunc chmodReadOnly(root string) error {\n\treturn filepath.WalkDir(root, func(p string, d fs.DirEntry, err error) error {\n\t\tif err != nil || d.Type()&fs.ModeSymlink != 0 {\n\t\t\treturn err\n\t\t}\n\t\tst, err := d.Info()\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\treturn os.Chmod(p, st.Mode().Perm()&^0o222)\n\t})\n}\n\n// chmodWritable restores owner write permission so the tree can be removed.\n// Directories are made writable and searchable before they are read, so a\n// 0000 or 0555 directory (the Go module cache) is handled. Symlinks are\n// never followed or chmodded.\nfunc chmodWritable(root string) {\n\tst, err := os.Lstat(root)\n\tif err != nil || st.Mode()&fs.ModeSymlink != 0 {\n\t\treturn\n\t}\n\tif !st.IsDir() {\n\t\tif st.Mode().IsRegular() {\n\t\t\tos.Chmod(root, st.Mode().Perm()|0o200)\n\t\t}\n\t\treturn\n\t}\n\tos.Chmod(root, st.Mode().Perm()|0o700)\n\tentries, err := os.ReadDir(root)\n\tif err != nil {\n\t\treturn\n\t}\n\tfor _, e := range entries {\n\t\tchmodWritable(filepath.Join(root, e.Name()))\n\t}\n}\n\n// removeAllWritable removes path even when it holds read-only trees.\nfunc removeAllWritable(path string) error {\n\tchmodWritable(path)\n\treturn os.RemoveAll(path)\n}\n\n// Logs opens the selected log file.\nfunc (l *Local) Logs(ctx context.Context, h executor.Handle, o executor.LogsOptions) (io.ReadCloser, error) {\n\tp := h.LogPath\n\tif o.Stream == executor.Stdout {\n\t\tp = h.StdoutPath\n\t}\n\tf, err := os.Open(p)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"open log: %w\", err)\n\t}\n\tif o.TailLines <= 0 {\n\t\treturn f, nil\n\t}\n\tdefer f.Close()\n\tb, err := tailLines(f, o.TailLines)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"tail log: %w\", err)\n\t}\n\treturn io.NopCloser(bytesReader(b)), nil\n}\n\n// Prune deletes host log files older than olderThan, then empty dirs.\nfunc (l *Local) Prune(ctx context.Context, olderThan time.Duration) error {\n\tcutoff := l.now().Add(-olderThan)\n\tdir := filepath.Join(l.root, \"logs\")\n\tvar dirs []string\n\terr := filepath.WalkDir(dir, func(p string, d fs.DirEntry, err error) error {\n\t\tif err != nil {\n\t\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\t\treturn nil\n\t\t\t}\n\t\t\treturn err\n\t\t}\n\t\tif d.IsDir() {\n\t\t\tdirs = append(dirs, p)\n\t\t\treturn nil\n\t\t}\n\t\tif st, e := d.Info(); e == nil && st.ModTime().Before(cutoff) {\n\t\t\treturn os.Remove(p)\n\t\t}\n\t\treturn nil\n\t})\n\tfor i := len(dirs) - 1; i > 0; i-- { // deepest first, keep logs/ itself\n\t\tos.Remove(dirs[i]) // fails harmlessly when not empty\n\t}\n\tif err != nil {\n\t\treturn fmt.Errorf(\"prune logs: %w\", err)\n\t}\n\treturn nil\n}","numLines":400,"startLine":30,"totalLines":487}},"tool_result_meta":[{"id":"toolu_01GxpeMsxa7pyGi2jUJ7NVc2","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
