      |  94 +++++++\n 23 files changed, 1095 insertions(+), 575 deletions(-)\n\ndiff --git a/docs/layout.md b/docs/layout.md\nindex 51a9331..a92b478 100644\n--- a/docs/layout.md\n+++ b/docs/layout.md\n@@ -15,7 +15,8 @@ internal/config/            .ard/config.yaml + role directory loading into a Res\n internal/configcmd/         `ard config check` handler: prints the resolved config, returns validation errors; `--ref` checks a commit\n internal/configsrc/         config from origin/main: a snapshot per SHA under ~/.ard/config/<owner>/<repo>/ (what `ard serve` reads)\n internal/executor/          Executor interface and plain-data job types\n-internal/executor/local/    git worktree + host subprocess or docker run, watchdog, logs\n+internal/executor/local/    host subprocess or docker run, watchdog, tracking; calls workspace\n+internal/executor/workspace/ job worktree, home, config dir, inputs, sidecar export, logs and their removal; shared by local and kube\n internal/agent/             Adapter interface, Spec/Result types, Registry (pure: builds argv, parses output)\n internal/agent/claude/      Claude Code adapter (`claude -p`, stream-json parser)\n internal/modelauth/         picks the one model credential (OAuth token or API key) from the controller env and carries its value to the executor; never logged\ndiff --git a/internal/executor/envpolicy.go b/internal/executor/envpolicy.go\nnew file mode 100644\nindex 0000000..1215098\n--- /dev/null\n+++ b/internal/executor/envpolicy.go\n@@ -0,0 +1,88 @@\n+package executor\n+\n+import (\n+\t\"fmt\"\n+\t\"regexp\"\n+\t\"strconv\"\n+\t\"strings\"\n+)\n+\n+var baseNames = map[string]bool{\n+\t\"PATH\": true, \"HOME\": true, \"LANG\": true, \"TMPDIR\": true,\n+\t\"GIT_TERMINAL_PROMPT\": true, \"GIT_CONFIG_NOSYSTEM\": true, \"GIT_CONFIG_GLOBAL\": true,\n+}\n+\n+var ghRE = regexp.MustCompile(`(?i)^(GH|GITHUB)_|GITHUB`)\n+\n+var secretRE = regexp.MustCompile(`(?i)TOKEN|SECRET|PASSWORD|KEY|CREDENTIAL`)\n+\n+// ArdEnv returns the ARD_* entries with the paths as the process sees them.\n+func ArdEnv(h Handle) []string {\n+\te := []string{\n+\t\t\"ARD_JOB=\" + h.JobID,\n+\t\t\"ARD_ISSUE=\" + strconv.Itoa(h.Issue),\n+\t\t\"ARD_STAGE=\" + h.Stage,\n+\t\t\"ARD_ROLE=\" + h.Role,\n+\t\t\"ARD_WORK=\" + h.View.Work,\n+\t\t\"ARD_ROLE_DIR=\" + h.View.Role,\n+\t}\n+\tif h.Network != NetworkOn {\n+\t\te = append(e, \"ARD_NETWORK=0\")\n+\t} else {\n+\t\te = append(e, \"ARD_NETWORK=1\")\n+\t}\n+\tif h.View.Sidecar != \"\" {\n+\t\te = append(e, \"ARD_SIDECAR=\"+h.View.Sidecar)\n+\t}\n+\tif h.View.History != \"\" {\n+\t\te = append(e, \"ARD_HISTORY=\"+h.View.History)\n+\t}\n+\treturn e\n+}\n+\n+// EnvPolicy says which names a job's Command.Env and Command.Fixed may carry.\n+type EnvPolicy struct {\n+\tAllowEnv, AllowFixed map[string]bool\n+}\n+\n+// CheckEnv validates Command.Env: only AllowEnv names may be added.\n+func (p EnvPolicy) CheckEnv(env []string) error {\n+\t// One credential per job: the CLI prefers the API key, so a second\n+\t// entry would silently win or be ignored.\n+\tif len(env) > 1 {\n+\t\treturn fmt.Errorf(\"%w: at most one credential per job\", ErrForbiddenEnv)\n+\t}\n+\tfor _, kv := range env {\n+\t\tname, _, ok := strings.Cut(kv, \"=\")\n+\t\tswitch {\n+\t\tcase !ok || name == \"\":\n+\t\t\treturn fmt.Errorf(\"%w: entry without name=value\", ErrForbiddenEnv)\n+\t\tcase ghRE.MatchString(name), baseNames[name], strings.HasPrefix(name, \"ARD_\"), name == \"SSH_AUTH_SOCK\":\n+\t\t\treturn fmt.Errorf(\"%w: %s\", ErrForbiddenEnv, name)\n+\t\tcase !p.AllowEnv[name]:\n+\t\t\treturn fmt.Errorf(\"%w: %s is not in the allow list\", ErrForbiddenEnv, name)\n+\t\t}\n+\t}\n+\treturn nil\n+}\n+\n+// CheckFixed validates Command.Fixed: only AllowFixed names, and never the\n+// executor's own, GitHub or secret-shaped names.\n+func (p EnvPolicy) CheckFixed(env []string) error {\n+\tfor _, kv := range env {\n+\t\tname, _, ok := strings.Cut(kv, \"=\")\n+\t\tswitch {\n+\t\tcase !ok || name == \"\":\n+\t\t\treturn fmt.Errorf(\"%w: entry without name=value\", ErrForbiddenEnv)\n+\t\tcase ghRE.MatchString(name), baseNames[name], strings.HasPrefix(name, \"ARD_\"), name == \"SSH_AUTH_SOCK\", secretRE.MatchString(name):\n+\t\t\treturn fmt.Errorf(\"%w: %s\", ErrForbiddenEnv, name)\n+\t\tcase !p.AllowFixed[name]:\n+\t\t\treturn fmt.Errorf(\"%w: %s is not in the fixed allow list\", ErrForbiddenEnv, name)\n+\t\t}\n+\t}\n+\treturn nil\n+}\n+\n+// IsGitHubEnvName reports whether name looks like a GitHub credential\n+// variable; executors drop these from what they pass on.\n+func IsGitHubEnvName(name string) bool { return ghRE.MatchString(name) }\ndiff --git a/internal/executor/envpolicy_test.go b/internal/executor/envpolicy_test.go\nnew file mode 100644\nindex 0000000..2c35dc4\n--- /dev/null\n+++ b/internal/executor/envpolicy_test.go\n@@ -0,0 +1,54 @@\n+package executor\n+\n+import (\n+\t\"errors\"\n+\t\"testing\"\n+)\n+\n+func TestEnvPolicy(t *testing.T) {\n+\tp := EnvPolicy{\n+\t\tAllowEnv:   map[string]bool{\"ANTHROPIC_API_KEY\": true},\n+\t\tAllowFixed: map[string]bool{\"CLAUDE_CONFIG_DIR\": true, \"MY_KEY\": true},\n+\t}\n+\ttests := []struct {\n+\t\tname  string\n+\t\tfixed bool\n+\t\tin    []string\n+\t\tbad   bool\n+\t}{\n+\t\t{\"two credentials\", false, []string{\"ANTHROPIC_API_KEY=a\", \"ANTHROPIC_API_KEY=b\"}, true},\n+\t\t{\"GH_TOKEN\", false, []string{\"GH_TOKEN=x\"}, true},\n+\t\t{\"ARD_X\", false, []string{\"ARD_X=1\"}, true},\n+\t\t{\"not allowed\", false, []string{\"OTHER=1\"}, true},\n+\t\t{\"no value\", false, []string{\"ANTHROPIC_API_KEY\"}, true},\n+\t\t{\"allowed\", false, []string{\"ANTHROPIC_API_KEY=k\"}, false},\n+\t\t{\"fixed secret-shaped\", true, []string{\"MY_KEY=x\"}, true},\n+\t\t{\"fixed base name\", true, []string{\"HOME=/x\"}, true},\n+\t\t{\"fixed not allowed\", true, []string{\"FOO=1\"}, true},\n+\t\t{\"fixed allowed\", true, []string{\"CLAUDE_CONFIG_DIR=/cfg\"}, false},\n+\t}\n+\tfor _, tc := range tests {\n+\t\tt.Run(tc.name, func(t *testing.