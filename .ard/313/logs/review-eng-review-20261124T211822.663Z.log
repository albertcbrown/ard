  132\t\treturn err\n   133\t}\n     1\tpackage workspace\n     2\t\n     3\timport (\n     4\t\t\"context\"\n     5\t\t\"errors\"\n     6\t\t\"fmt\"\n     7\t\t\"io/fs\"\n     8\t\t\"os\"\n     9\t\t\"path/filepath\"\n    10\t\t\"time\"\n    11\t\n    12\t\t\"github.com/albertcbrown/ard/internal/executor\"\n    13\t)\n    14\t\n    15\t// Remove deletes the worktree and home of h and prunes git's registration.\n    16\tfunc (w *Workspace) Remove(ctx context.Context, h executor.Handle) error {\n    17\t\tvar errs []error\n    18\t\tforeign := w.cloneDir != \"\" && filepath.Clean(h.RepoDir) != w.cloneDir\n    19\t\tif _, err := os.Stat(h.Worktree); err == nil {\n    20\t\t\tChmodWritable(h.Worktree)\n    21\t\t\tif foreign {\n    22\t\t\t\t// Stored before #113: RepoDir is the operator's checkout, where\n    23\t\t\t\t// ard never runs git. The registration there dangles until the\n    24\t\t\t\t// operator's own `git worktree prune`.\n    25\t\t\t\tw.log.Info(\"executor.cleanup_foreign_repo\", \"job\", h.JobID, \"repo_dir\", h.RepoDir, \"clone\", w.cloneDir)\n    26\t\t\t\tif err := RemoveAllWritable(h.Worktree); err != nil {\n    27\t\t\t\t\terrs = append(errs, err)\n    28\t\t\t\t}\n    29\t\t\t} else if err := w.git.WorktreeRemove(context.WithoutCancel(ctx), h.RepoDir, h.Worktree, true); err != nil {\n    30\t\t\t\terrs = append(errs, err)\n    31\t\t\t\tRemoveAllWritable(h.Worktree)\n    32\t\t\t}\n    33\t\t}\n    34\t\t// Home holds a-w trees (sidecar, Go module cache); derived from Home, not h.SidecarDir\n    35\t\tif err := RemoveAllWritable(h.Home); err != nil {\n    36\t\t\terrs = append(errs, err)\n    37\t\t}\n    38\t\tif !foreign {\n    39\t\t\tif err := w.git.WorktreePrune(context.WithoutCancel(ctx), h.RepoDir); err != nil {\n    40\t\t\t\terrs = append(errs, err)\n    41\t\t\t}\n    42\t\t}\n    43\t\treturn errors.Join(errs...)\n    44\t}\n    45\t\n    46\t// Prune deletes host log files older than olderThan, then empty dirs.\n    47\tfunc (w *Work