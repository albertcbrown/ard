{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012bMaEfkHdLz7QqFLNQboCC","type":"tool_result","content":"     1\tpackage workspace\n     2\t\n     3\timport (\n     4\t\t\"context\"\n     5\t\t\"errors\"\n     6\t\t\"fmt\"\n     7\t\t\"os\"\n     8\t\t\"path/filepath\"\n     9\t\n    10\t\t\"github.com/albertcbrown/ard/internal/executor\"\n    11\t)\n    12\t\n    13\t// Prepare creates the worktree, writes inputs, makes the home and config dir,\n    14\t// exports the sidecar and creates the log files. It returns a host Handle\n    15\t// (Kind \"host\"); a caller that runs Docker adjusts it. On error it removes\n    16\t// everything it made.\n    17\tfunc (w *Workspace) Prepare(ctx context.Context, j executor.Job) (h executor.Handle, err error) {\n    18\t\tif err := j.Validate(); err != nil {\n    19\t\t\treturn h, err\n    20\t\t}\n    21\t\twt, err := w.WorktreePath(j.Repo, j.ID)\n    22\t\tif err != nil {\n    23\t\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, err)\n    24\t\t}\n    25\t\tif _, err := os.Lstat(wt); err == nil {\n    26\t\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, executor.ErrExists)\n    27\t\t}\n    28\t\tsha, err := w.git.RevParse(ctx, j.RepoDir, j.Ref)\n    29\t\tif err != nil {\n    30\t\t\treturn h, fmt.Errorf(\"resolve ref %q: %w: %w\", j.Ref, executor.ErrClone, err)\n    31\t\t}\n    32\t\tnow := w.now().UTC()\n    33\t\tbase := LogBase(j.Stage, j.Role, now)\n    34\t\tlogDir, err := w.LogDir(j.Repo, j.Issue)\n    35\t\tif err != nil {\n    36\t\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, err)\n    37\t\t}\n    38\t\thome, err := w.HomePath(j.Repo, j.ID)\n    39\t\tif err != nil {\n    40\t\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, err)\n    41\t\t}\n    42\t\th = executor.Handle{\n    43\t\t\tJobID: j.ID, Kind: \"host\", Issue: j.Issue, Stage: j.Stage, Role: j.Role,\n    44\t\t\tWorktree: wt, Home: home, RepoDir: j.RepoDir, BaseSHA: sha,\n    45\t\t\tLogPath: filepath.Join(logDir, base+\".log\"), StdoutPath: filepath.Join(logDir, base+\".stdout\"),\n    46\t\t\tView:    executor.Paths{Work: wt, Role: j.RoleDir},\n    47\t\t\tRoleDir: j.RoleDir, ReadOnly: j.ReadOnly, Network: j.Network,\n    48\t\t\tTrustedInput: j.TrustedInput, PreparedAt: now, Timeout: j.Timeout,\n    49\t\t}\n    50\t\tvar created []string // paths to remove on failure\n    51\t\tworktreeAdded := false\n    52\t\tdefer func() {\n    53\t\t\tif err == nil {\n    54\t\t\t\treturn\n    55\t\t\t}\n    56\t\t\tif worktreeAdded {\n    57\t\t\t\tChmodWritable(wt)\n    58\t\t\t\tif rerr := w.git.WorktreeRemove(context.WithoutCancel(ctx), j.RepoDir, wt, true); rerr != nil {\n    59\t\t\t\t\terr = errors.Join(err, rerr)\n    60\t\t\t\t}\n    61\t\t\t\tRemoveAllWritable(wt)\n    62\t\t\t\tw.git.WorktreePrune(context.WithoutCancel(ctx), j.RepoDir)\n    63\t\t\t}\n    64\t\t\tfor _, p := range created {\n    65\t\t\t\tRemoveAllWritable(p) // a sidecar tree under home is a-w\n    66\t\t\t}\n    67\t\t\th = executor.Handle{}\n    68\t\t}()\n    69\t\n    70\t\tif err = os.MkdirAll(filepath.Dir(wt), 0o755); err != nil {\n    71\t\t\treturn h, fmt.Errorf(\"create work dir: %w\", err)\n    72\t\t}\n    73\t\tif err = w.git.WorktreeAdd(ctx, j.RepoDir, wt, sha); err != nil {\n    74\t\t\treturn h, fmt.Errorf(\"add worktree: %w: %w\", executor.ErrClone, err)\n    75\t\t}\n    76\t\tworktreeAdded = true\n    77\t\t// The config dir lives inside home, so Remove and this function's\n    78\t\t// failure path remove it with home.\n    79\t\tcreated = append(created, home)\n    80\t\tvar pop Populated\n    81\t\tif pop, err = Populate(PopulateSpec{Tree: wt, Home: home, Scrub: j.Scrub, Inputs: j.Inputs}); err != nil {\n    82\t\t\treturn h, err\n    83\t\t}\n    84\t\th.Scrubbed = pop.Scrubbed\n    85\t\th.View.ConfigDir = pop.ConfigDir\n    86\t\tif j.History {\n    87\t\t\t// Host mode hands over the live clone: read-only is enforced only by the\n    88\t\t\t// Docker mount (:ro), not on the host.\n  