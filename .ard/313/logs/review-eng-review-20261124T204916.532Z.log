t}\ndiff --git a/internal/executor/workspace/populate.go b/internal/executor/workspace/populate.go\nnew file mode 100644\nindex 0000000..126df35\n--- /dev/null\n+++ b/internal/executor/workspace/populate.go\n@@ -0,0 +1,137 @@\n+// Package workspace is the filesystem half of an executor: the job worktree,\n+// home, config dir, inputs, sidecar export, logs and their removal. It is\n+// shared by the local executor and, for Populate and MakeHome, by code that\n+// runs inside a pod.\n+package workspace\n+\n+import (\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"io/fs\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\n+\t\"github.com/albertcbrown/ard/internal/executor\"\n+)\n+\n+// ConfigDirName is the per-job agent config dir inside the job home. Under\n+// HOME, the CLI's default ~/.claude resolves to the same fresh dir even if\n+// the config-dir variable were dropped.\n+const ConfigDirName = \".claude\"\n+\n+// PopulateSpec says what to do to a checked-out tree.\n+type PopulateSpec struct {\n+\tTree   string          // the worktree\n+\tHome   string          // job home; \"\" = make none\n+\tScrub  []string        // tree-relative paths to remove\n+\tInputs []executor.File // files to write into the tree\n+}\n+\n+// Populated reports what Populate did.\n+type Populated struct {\n+\tScrubbed  []string\n+\tConfigDir string // \"\" when Home was \"\"\n+}\n+\n+// Populate scrubs paths, writes inputs, then makes the home, in that order.\n+func Populate(s PopulateSpec) (Populated, error) {\n+\tvar p Populated\n+\tif err := scrub(s.Tree, s.Scrub); err != nil {\n+\t\treturn p, err\n+\t}\n+\tp.Scrubbed = append([]string(nil), s.Scrub...)\n+\tif len(s.Inputs) > 0 {\n+\t\t// os.Root refuses to follow symlinks out of the worktree, so a\n+\t\t// committed symlink at an input path cannot redirect the write.\n+\t\tr, err := os.OpenRoot(s.Tree)\n+\t\tif err != nil {\n+\t\t\treturn p, fmt.Errorf(\"open worktree: %w\", err)\n+\t\t}\n+\t\tdefer r.Close()\n+\t\tfor _, f := range s.Inputs {\n+\t\t\trel := filepath.FromSlash(f.Path)\n+\t\t\tif err := r.MkdirAll(filepath.Dir(rel), 0o755); err != nil {\n+\t\t\t\treturn p, fmt.Errorf(\"write input %s: %w\", f.Path, err)\n+\t\t\t}\n+\t\t\tif err := rejectSymlink(r, rel); err != nil {\n+\t\t\t\treturn p, fmt.Errorf(\"write input %s: %w\", f.Path, err)\n+\t\t\t}\n+\t\t\tif err := r.WriteFile(rel, f.Data, 0o644); err != nil {\n+\t\t\t\treturn p, fmt.Errorf(\"write input %s: %w\", f.Path, err)\n+\t\t\t}\n+\t\t}\n+\t}\n+\tif s.Home != \"\" {\n+\t\tcfg, err := MakeHome(s.Home)\n+\t\tif err != nil {\n+\t\t\treturn p, err\n+\t\t}\n+\t\tp.ConfigDir = cfg\n+\t}\n+\treturn p, nil\n+}\n+\n+// MakeHome creates home/tmp and the config dir inside home, both 0700 past\n+// the umask, and returns the config dir.\n+func MakeHome(home string) (configDir string, err error) {\n+\tif err := os.MkdirAll(filepath.Join(home, \"tmp\"), 0o700); err != nil {\n+\t\treturn \"\", fmt.Errorf(\"create home: %w\", err)\n+\t}\n+\tcfg := filepath.Join(home, ConfigDirName)\n+\tif err := os.Mkdir(cfg, 0o700); err != nil {\n+\t\treturn \"\", fmt.Errorf(\"create config dir: %w\", err)\n+\t}\n+\tif err := os.Chmod(cfg, 0o700); err != nil {\n+\t\treturn \"\", fmt.Errorf(\"create config dir: %w\", err)\n+\t}\n+\treturn cfg, nil\n+}\n+\n+// scrub removes each path from the worktree: a regular file or a symlink\n+// (the link itself). A missing path is fine. It fails if the parent directory\n+// is a symlink (os.Root would follow it inside the worktree) and never removes\n+// a directory.\n+func scrub(wt string, paths []string) error {\n+\tif len(paths) == 0 {\n+\t\treturn nil\n+\t}\n+\tr, err := os.OpenRoot(wt)\n+\tif err != nil {\n+\t\treturn fmt.Errorf(\"open worktree: %w\", err)\n+\t}\n+\tdefer r.Close()\n+\tfor _, p := range paths {\n+\t\trel := filepath.FromSlash(p)\n+\t\tparent, err := r.Lstat(filepath.Dir(rel))\n+\t\tswitch {\n+\t\tcase errors.Is(err, fs.ErrNotExist):\n+\t\t\tcontinue\n+\t\tcase err != nil:\n+\t\t\treturn fmt.Errorf(\"scrub %s: %w\", p, err)\n+\t\tcase parent.Mode()&fs.ModeSymlink != 0 || !parent.IsDir():\n+\t\t\treturn fmt.Errorf(\"scrub %s: parent %s is not a plain directory\", p, filepath.Dir(p))\n+\t\t}\n+\t\tst, err := r.Lstat(rel)\n+\t\tswitch {\n+\t\tcase errors.Is(err, fs.ErrNotExist):\n+\t\t\tcontinue\n+\t\tcase err != nil:\n+\t\t\treturn fmt.Errorf(\"scrub %s: %w\", p, err)\n+\t\tcase !st.Mode().IsRegular() && st.Mode()&fs.ModeSymlink == 0:\n+\t\t\treturn fmt.Errorf(\"scrub %s: not a file\", p)\n+\t\t}\n+\t\tif err := r.Remove(rel); err != nil && !errors.Is(err, fs.ErrNotExist) {\n+\t\t\treturn fmt.Errorf(\"scrub %s: %w\", p, err)\n+\t\t}\n+\t}\n+\treturn nil\n+}\n+\n+// rejectSymlink fails when rel already exists as a symlink: even a link that\n+// stays inside the worktree would let a branch swap what an input resolves to.\n+func rejectSymlink(r *os.Root, rel string) error {\n+\tif st, err := r.Lstat(rel); err == nil && st.Mode()&fs.ModeSymlink != 0 {\n+\t\treturn fmt.Errorf(\"%s is a symlink\", rel)\n+\t}\n+\treturn nil\n+}\ndiff --git a/internal/executor/workspace/populate_test.go b/internal/executor/workspace/populate_test.go\nnew file mode 100644\nindex 0000000..696585a\n--- /dev/null\n+++ b/internal/executor/workspace/populate_test.go\n@@ -0,0 +1,122 @@\n+package workspace\n+\n+import (\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"syscall\"\n+\t\"testing\"\n+\n+\t\"github.com/albertcbrown/ard/internal/executor\"\n+)\n+\n+func TestScrubGuards(t *testing.T) {\n+\tconst rel = \".ard/7/worker-dev.md\"\n+\ttests := []struct {\n+\t\tname  string\n+\t\tsetup func(t *testing.T, repo string)\n+\t\tfail  bool\n+\t}{\n+\t\t{\"parent is a symlink\", func(t *testing.T, repo string) {\n+\t\t\tif err := os.MkdirAll(filepath.Join(repo, \"elsewhere\"), 0o755); err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t\tif err := os.WriteFile(filepath.Join(repo, \"elsewhere/worker-dev.md\"), []byte(\"x\"), 0o644); err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t\tif err := os.MkdirAll(filepath.Join(repo, \".ard\"), 0o755); err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t\tif err := os.Symlink(\"../elsewhere\", filepath.Join(repo, \".ard/7\")); err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t}, true},\n+\t\t{\"target is a directory\", func(t *testing.T, repo string) {\n+\t\t\tif err := os.MkdirAll(filepath.Join(repo, rel), 0o755); err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t\tif err := os.WriteFile(filepath.Join(repo, rel, \"keep\"), []byte(\"x\"), 0o644); err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t}, true},\n+\t\t{\"target is a symlink: link removed\", func(t *testing.T, repo string) {\n+\t\t\tif err := os.MkdirAll(filepath.Join(repo, \".ard/7\"), 0o755); err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t\tif err := os.Symlink(\"../../a.txt\", filepath.Join(repo, rel)); err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t}, false},\n+\t}\n+\tfor _, c := range tests {\n+\t\tt.Run(c.name, func(t *testing.T) {\n+\t\t\twt := t.TempDir()\n+\t\t\tc.setup(t, wt)\n+\t\t\terr := scrub(wt, []string{rel})\n+\t\t\tif (err != nil) != c.fail {\n+\t\t\t\tt.Fatalf(\"err = %v, want failure %v\", err, c.fail)\n+\t\t\t}\n+\t\t\tif !c.fail {\n+\t\t\t\tif _, err := os.Lstat(filepath.Join(wt, rel)); err == nil {\n+\t\t\t\t\tt.Error(\"link still there\")\n+\t\t\t\t}\n+\t\t\t}\n+\t\t\tif c.name == \"parent is a symlink\" {\n+\t\t\t\tif _, err := os.Stat(filepath.Join(wt, \"elsewhere/worker-dev.md\")); err != nil {\n+\t\t\t\t\tt.Error(\"file behind the symlink was removed\")\n+\t\t\t\t}\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+func TestPopulate(t *testing.T) {\n+\tt.Run(\"inputs and home\", func(t *testing.T) {\n+\t\tfor _, mask := range []int{0o077, 0o022} {\n+\t\t\told := syscall.Umask(mask)\n+\t\t\ttree, home := t.TempDir(), filepath.Join(t.TempDir(), \"h\")\n+\t\t\tp, err := Populate(PopulateSpec{Tree: tree, Home: home, Scrub: []string{\"gone\"},\n+\t\t\t\tInputs: []executor.File{{Path: \"a/b/in.txt\", Data: []byte(\"x\")}}})\n+\t\t\tsyscall.Umask(old)\n+\t\t\tif err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t\tif b, err := os.ReadFile(filepath.Join(tree, \"a/b/in.txt\")); err != nil || string(b) != \"x\" {\n+\t\t\t\tt.Errorf(\"input: %q %v\", b, err)\n+\t\t\t}\n+\t\t\tif p.ConfigDir != filepath.Join(home, ConfigDirName) || len(p.Scrubbed) != 1 || p.Scrubbed[0] != \"gone\" {\n+\t\t\t\tt.Errorf(\"populated = %+v\", p)\n+\t\t\t}\n+\t\t\tfor _, d := range []string{filepath.Join(home, \"tmp\"), p.ConfigDir} {\n+\t\t\t\tif st, err := os.Stat(d); err != nil || st.Mode().Perm() != 0o700 {\n+\t\t\t\t\tt.Errorf(\"%s: %v %v\", d, st, err)\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\t})\n+\tt.Run(\"no home\", func(t *testing.T) {\n+\t\tp, err := Populate(PopulateSpec{Tree: t.TempDir()})\n+\t\tif err != nil || p.ConfigDir != \"\" {\n+\t\t\tt.Errorf(\"%+v %v\", p, err)\n+\t\t}\n+\t})\n+\tt.Run(\"input over symlink fails\", func(t *testing.T) {\n+\t\ttree := t.TempDir()\n+\t\tif err := os.Symlink(\"elsewhere\", filepath.Join(tree, \"in.txt\")); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\t_, err := Populate(PopulateSpec{Tree: tree, Inputs: []executor.File{{Path: \"in.txt\", Data: []byte(\"x\")}}})\n+\t\tif err == nil {\n+\t\t\tt.Error(\"want error\")\n+\t\t}\n+\t\tif _, err := os.Lstat(filepath.Join(tree, \"elsewhere\")); err == nil {\n+\t\t\tt.Error(\"write followed the symlink\")\n+\t\t}\n+\t})\n+\tt.Run(\"scrub of a directory fails\", func(t *testing.T) {\n+\t\ttree := t.TempDir()\n+\t\tos.Mkdir(filepath.Join(tree, \"d\"), 0o755)\n+\t\tif _, err := Populate(PopulateSpec{Tree: tree, Scrub: []string{\"d\"}}); err == nil {\n+\t\t\tt.Error(\"want error\")\n+\t\t}\n+\t})\n+}\ndiff --git a/internal/executor/workspace/prepare.go b/internal/executor/workspace/prepare.go\nnew file mode 100644\nindex 0000000..f6aab08\n--- /dev/null\n+++ b/internal/executor/workspace/prepare.go\n@@ -0,0 +1,133 @@\n+package workspace\n+\n+import (\n+\t\"context\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\n+\t\"github.com/albertcbrown/ard/internal/executor\"\n+)\n+\n+// Prepare creates the worktree, writes inputs, makes the home and config dir,\n+// exports the sidecar and creates the log files. It returns a host Handle\n+// (Kind \"host\"); a caller that runs Docker adjusts it. On error it removes\n+// everything it made.\n+func (w *Workspace) Prepare(ctx context.Context, j executor.Job) (h executor.Handle, err error) {\n+\tif err := j.Validate(); err != nil {\n+\t\treturn h, err\n+\t}\n+\twt, err := w.WorktreePath(j.Repo, j.ID)\n+\tif err != nil {\n+\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, err)\n+\t}\n+\tif _, err := os.Lstat(wt); err == nil {\n+\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, executor.ErrExists)\n+\t}\n+\tsha, err := w.git.RevParse(ctx, j.RepoDir, j.Ref)\n+\tif err != nil {\n+\t\treturn h, fmt.Errorf(\"resolve ref %q: %w: %w\", j.Ref, executor.ErrClone, err)\n+\t}\n+\tnow := w.now().UTC()\n+\tbase := LogBase(j.Stage, j.Role, now)\n+\tlogDir, err := w.LogDir(j.Repo, j.Issue)\n+\tif err != nil {\n+\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, err)\n+\t}\n+\thome, err := w.HomePath(j.Repo, j.ID)\n+\tif err != nil {\n+\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, err)\n+\t}\n+\th = executor.Handle{\n+\t\tJobID: j.ID, Kind: \"host\", Issue: j.Issue, Stage: j.Stage, Role: j.Role,\n+\t\tWorktree: wt, Home: home, RepoDir: j.RepoDir, BaseSHA: sha,\n+\t\tLogPath: filepath.Join(logDir, base+\".log\"), StdoutPath: filepath.Join(logDir, base+\".stdout\"),\n+\t\tView:    executor.Paths{Work: wt, Role: j.RoleDir},\n+\t\tRoleDir: j.RoleDir, ReadOnly: j.ReadOnly, Network: j.Network,\n+\t\tTrustedInput: j.TrustedInput, PreparedAt: now, Timeout: j.Timeout,\n+\t}\n+\tvar created []string // paths to remove on failure\n+\tworktreeAdded := false\n+\tdefer func() {\n+\t\tif err == nil {\n+\t\t\treturn\n+\t\t}\n+\t\tif worktreeAdded {\n+\t\t\tChmodWritable(wt)\n+\t\t\tif rerr := w.git.WorktreeRemove(context.WithoutCancel(ctx), j.RepoDir, wt, true); rerr != nil {\n+\t\t\t\terr = errors.Join(err, rerr)\n+\t\t\t}\n+\t\t\tRemoveAllWritable(wt)\n+\t\t\tw.git.WorktreePrune(context.WithoutCancel(ctx), j.RepoDir)\n+\t\t}\n+\t\tfor _, p := range created {\n+\t\t\tRemoveAllWritable(p) // a sidecar tree under home is a-w\n+\t\t}\n+\t\th = executor.Handle{}\n+\t}()\n+\n+\tif err = os.MkdirAll(filepath.Dir(wt), 0o755); err != nil {\n+\t\treturn h, fmt.Errorf(\"create work dir: %w\", err)\n+\t}\n+\tif err = w.git.WorktreeAdd(ctx, j.RepoDir, wt, sha); err != nil {\n+\t\treturn h, fmt.Errorf(\"add worktree: %w: %w\", executor.ErrClone, err)\n+\t}\n+\tworktreeAdded = true\n+\t// The config dir lives inside home, so Remove and this function's\n+\t// failure path remove it with home.\n+\tcreated = append(created, home)\n+\tvar pop Populated\n+\tif pop, err = Populate(PopulateSpec{Tree: wt, Home: home, Scrub: j.Scrub, Inputs: j.Inputs}); err != nil {\n+\t\treturn h, err\n+\t}\n+\th.Scrubbed = pop.Scrubbed\n+\th.View.ConfigDir = pop.ConfigDir\n+\tif j.History {\n+\t\t// Host mode hands over the live clone: read-only is enforced only by the\n+\t\t// Docker mount (:ro), not on the host.\n+\t\th.HistoryDir, h.View.History = j.RepoDir, j.RepoDir\n+\t}\n+\t// --- sidecar (#28): the executor clones, pins and mounts it read-only ---\n+\tif j.Sidecar != (executor.Sidecar{}) {\n+\t\tdest := filepath.Join(home, sidecarDirName)\n+\t\tvar scSHA string\n+\t\tvar fetched bool\n+\t\tif scSHA, fetched, err = w.materialise(ctx, j.Repo, j.Sidecar, dest); err != nil {\n+\t\t\treturn h, err\n+\t\t}\n+\t\th.SidecarDir, h.Sidecar, h.SidecarSHA = dest, j.Sidecar, scSHA\n+\t\th.View.Sidecar = dest\n+\t\tw.log.Info(\"executor.sidecar_ready\", \"job\", j.ID, \"repo\", j.Sidecar.Repo, \"ref\", j.Sidecar.Ref, \"sha\", scSHA, \"fetched\", fetched)\n+\t}\n+\t// --- end sidecar ---\n+\tif err = os.MkdirAll(logDir, 0o700); err != nil {\n+\t\treturn h, fmt.Errorf(\"create log dir: %w\", err)\n+\t}\n+\tfor _, p := range []string{h.LogPath, h.StdoutPath} {\n+\t\tvar f *os.File\n+\t\tif f, err = os.OpenFile(p, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o600); err != nil {\n+\t\t\treturn h, fmt.Errorf(\"create log %s: %w\", p, err)\n+\t\t}\n+\t\tf.Close()\n+\t\tcreated = append(created, p)\n+\t}\n+\tif h.SidecarDir != \"\" { // #28: read-only in both modes; Docker also mounts :ro\n+\t\tif err = ChmodReadOnly(h.SidecarDir); err != nil {\n+\t\t\treturn h, fmt.Errorf(\"make sidecar read-only: %w\", err)\n+\t\t}\n+\t}\n+\treturn h, nil\n+}\n+\n+// Discard removes everything Prepare made for h, log files included. A caller\n+// whose own steps after a successful Prepare fail uses it.\n+func (w *Workspace) Discard(ctx context.Context, h executor.Handle) error {\n+\terr := w.Remove(ctx, h)\n+\tfor _, p := range []string{h.LogPath, h.StdoutPath} {\n+\t\tif p != \"\" {\n+\t\t\tos.Remove(p)\n+\t\t}\n+\t}\n+\treturn err\n+}\ndiff --git a/internal/executor/workspace/prepare_test.go b/internal/executor/workspace/prepare_test.go\nnew file mode 100644\nindex 0000000..c5679fa\n--- /dev/null\n+++ b/internal/executor/workspace/prepare_test.go\n@@ -0,0 +1,107 @@\n+//go:build unix\n+\n+package workspace\n+\n+import (\n+\t\"context\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"testing\"\n+\t\"time\"\n+\n+\t\"github.com/albertcbrown/ard/internal/executor\"\n+)\n+\n+// recGit is a fake worktree runner: WorktreeAdd makes the directory.\n+type recGit struct {\n+\tnopGit\n+\tpruned, removed int\n+}\n+\n+func (g *recGit) RevParse(context.Context, string, string) (string, error) { return \"abc\", nil }\n+func (g *recGit) WorktreeAdd(_ context.Context, _, dir, _ string) error {\n+\treturn os.MkdirAll(dir, 0o755)\n+}\n+func (g *recGit) WorktreeRemove(_ context.Context, _, dir string, _ bool) error {\n+\tg.removed++\n+\tos.RemoveAll(dir)\n+\treturn nil\n+}\n+func (g *recGit) WorktreePrune(context.Context, string) error { g.pruned++; return nil }\n+\n+func testJob() executor.Job {\n+\treturn executor.Job{ID: \"J1\", Repo: \"o/r\", Issue: 7, Stage: \"worker\", Role: \"dev\",\n+\t\tRepoDir: \"/repo\", Ref: \"HEAD\", RoleDir: \"/role\", Timeout: time.Minute}\n+}\n+\n+func TestDiscard(t *testing.T) {\n+\tg := &recGit{}\n+\tw, err := New(Options{Root: t.TempDir(), Git: g})\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tctx := context.Background()\n+\th, err := w.Prepare(ctx, testJob())\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif h.Kind != \"host\" || h.View.ConfigDir != filepath.Join(h.Home, ConfigDirName) {\n+\t\tt.Errorf(\"handle = %+v\", h)\n+\t}\n+\tif err := w.Discard(ctx, h); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tfor _, p := range []string{h.Worktree, h.Home, h.LogPath, h.StdoutPath} {\n+\t\tif _, err := os.Lstat(p); !os.IsNotExist(err) {\n+\t\t\tt.Errorf(\"%s remains: %v\", p, err)\n+\t\t}\n+\t}\n+\tif g.pruned != 1 || g.removed != 1 {\n+\t\tt.Errorf(\"pruned %d removed %d, want 1 1\", g.pruned, g.removed)\n+\t}\n+}\n+\n+// A failure after the home exists removes worktree and home.\n+func TestPrepareRollback(t *testing.T) {\n+\tg := &recGit{}\n+\troot := t.TempDir()\n+\tw, _ := New(Options{Root: root, Git: g})\n+\tj := testJob()\n+\t// Block the log dir so the failure comes after home creation.\n+\tlogDir, _ := w.LogDir(j.Repo, j.Issue)\n+\tos.MkdirAll(filepath.Dir(logDir), 0o755)\n+\tos.WriteFile(logDir, []byte(\"file\"), 0o644)\n+\tif _, err := w.Prepare(context.Background(), j); err == nil {\n+\t\tt.Fatal(\"want error\")\n+\t}\n+\twt, _ := w.WorktreePath(j.Repo, j.ID)\n+\thome, _ := w.HomePath(j.Repo, j.ID)\n+\tfor _, p := range []string{wt, home} {\n+\t\tif _, err := os.Lstat(p); !os.IsNotExist(err) {\n+\t\t\tt.Errorf(\"%s remains: %v\", p, err)\n+\t\t}\n+\t}\n+\tif g.pruned != 1 {\n+\t\tt.Errorf(\"pruned %d\", g.pruned)\n+\t}\n+}\n+\n+func TestRemoveForeignRepoMakesNoGitCall(t *testing.T) {\n+\tg := &recGit{}\n+\tw, _ := New(Options{Root: t.TempDir(), Git: g, CloneDir: \"/clone\"})\n+\tctx := context.Background()\n+\th, err := w.Prepare(ctx, testJob()) // RepoDir /repo != CloneDir\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tg.pruned, g.removed = 0, 0\n+\tif err := w.Remove(ctx, h); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif g.pruned != 0 || g.removed != 0 {\n+\t\tt.Errorf(\"git called: %+v\", g)\n+\t}\n+\tif _, err := os.Lstat(h.Worktree); !os.IsNotExist(err) {\n+\t\tt.Error(\"worktree remains\")\n+\t}\n+}\ndiff --git a/internal/executor/workspace/remove.go b/internal/executor/workspace/remove.go\nnew file mode 100644\nindex 0000000..f3eaa43\n--- /dev/null\n+++ b/internal/executor/workspace/remove.go\n@@ -0,0 +1,74 @@\n+package workspace\n+\n+import (\n+\t\"context\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"io/fs\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"time\"\n+\n+\t\"github.com/albertcbrown/ard/internal/executor\"\n+)\n+\n+// Remove deletes the worktree and home of h and prunes git's registration.\n+func (w *Workspace) Remove(ctx context.Context, h executor.Handle) error {\n+\tvar errs []error\n+\tforeign := w.cloneDir != \"\" && filepath.Clean(h.RepoDir) != w.cloneDir\n+\tif _, err := os.Stat(h.Worktree); err == nil {\n+\t\tChmodWritable(h.Worktree)\n+\t\tif foreign {\n+\t\t\t// Stored before #113: RepoDir is the operator's checkout, where\n+\t\t\t// ard never runs git. The registration there dangles until the\n+\t\t\t// operator's own `git worktree prune`.\n+\t\t\tw.log.Info(\"executor.cleanup_foreign_repo\", \"job\", h.JobID, \"repo_dir\", h.RepoDir, \"clone\", w.cloneDir)\n+\t\t\tif err := RemoveAllWritable(h.Worktree); err != nil {\n+\t\t\t\terrs = append(errs, err)\n+\t\t\t}\n+\t\t} else if err := w.git.WorktreeRemove(context.WithoutCancel(ctx), h.RepoDir, h.Worktree, true); err != nil {\n+\t\t\terrs = append(errs, err)\n+\t\t\tRemoveAllWritable(h.Worktree)\n+\t\t}\n+\t}\n+\t// Home holds a-w trees (sidecar, Go module cache); derived from Home, not h.SidecarDir\n+\tif err := RemoveAllWritable(h.Home); err != nil {\n+\t\terrs = append(errs, err)\n+\t}\n+\tif !foreign {\n+\t\tif err := w.git.WorktreePrune(context.WithoutCancel(ctx), h.RepoDir); err != nil {\n+\t\t\terrs = append(errs, err)\n+\t\t}\n+\t}\n+\treturn errors.Join(errs...)\n+}\n+\n+// Prune deletes host log files older than olderThan, then empty dirs.\n+func (w *Workspace) Prune(ctx context.Context, olderThan time.Duration) error {\n+\tcutoff := w.now().Add(-olderThan)\n+\tdir := filepath.Join(w.root, \"logs\")\n+\tvar dirs []string\n+\terr := filepath.WalkDir(dir, func(p string, d fs.DirEntry, err error) error {\n+\t\tif err != nil {\n+\t\t\tif errors.Is(err, fs.ErrNotExist) {\n+\t\t\t\treturn nil\n+\t\t\t}\n+\t\t\treturn err\n+\t\t}\n+\t\tif d.IsDir() {\n+\t\t\tdirs = append(dirs, p)\n+\t\t\treturn nil\n+\t\t}\n+\t\tif st, e := d.Info(); e == nil && st.ModTime().Before(cutoff) {\n+\t\t\treturn os.Remove(p)\n+\t\t}\n+\t\treturn nil\n+\t})\n+\tfor i := len(dirs) - 1; i > 0; i-- { // deepest first, keep logs/ itself\n+\t\tos.Remove(dirs[i]) // fails harmlessly when not empty\n+\t}\n+\tif err != nil {\n+\t\treturn fmt.Errorf(\"prune logs: %w\", err)\n+\t}\n+\treturn nil\n+}\ndiff --git a/internal/executor/local/cleanup_test.go b/internal/executor/workspace/remove_test.go\nsimilarity index 53%\nrename from internal/executor/local/cleanup_test.go\nrename to internal/executor/workspace/remove_test.go\nindex 558ba24..a660d6c 100644\n--- a/internal/executor/local/cleanup_test.go\n+++ b/internal/executor/workspace/remove_test.go\n@@ -1,9 +1,13 @@\n-package local\n+//go:build unix\n+\n+package workspace\n \n import (\n+\t\"context\"\n \t\"os\"\n \t\"path/filepath\"\n \t\"testing\"\n+\t\"time\"\n )\n \n func mustMkdir(t *testing.T, p string) {\n@@ -33,7 +37,7 @@ func TestRemoveAllWritable_ReadOnlyTree(t *testing.T) {\n \tif err := os.Chmod(mod, 0o555); err != nil {\n \t\tt.Fatal(err)\n \t}\n-\tif err := removeAllWritable(home); err != nil {\n+\tif err := RemoveAllWritable(home); err != nil {\n \t\tt.Fatal(err)\n \t}\n \tif _, err := os.Lstat(home); !os.IsNotExist(err) {\n@@ -51,7 +55,7 @@ func TestRemoveAllWritable_UnreadableDir(t *testing.T) {\n \tif err := os.Chmod(d, 0); err != nil {\n \t\tt.Fatal(err)\n \t}\n-\tif err := rem