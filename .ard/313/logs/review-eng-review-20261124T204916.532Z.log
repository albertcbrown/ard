*testing.T, repo string) {\n1432\t+\t\t\tif err := os.MkdirAll(filepath.Join(repo, \".ard/7\"), 0o755); err != nil {\n1433\t+\t\t\t\tt.Fatal(err)\n1434\t+\t\t\t}\n1435\t+\t\t\tif err := os.Symlink(\"../../a.txt\", filepath.Join(repo, rel)); err != nil {\n1436\t+\t\t\t\tt.Fatal(err)\n1437\t+\t\t\t}\n1438\t+\t\t}, false},\n1439\t+\t}\n1440\t+\tfor _, c := range tests {\n1441\t+\t\tt.Run(c.name, func(t *testing.T) {\n1442\t+\t\t\twt := t.TempDir()\n1443\t+\t\t\tc.setup(t, wt)\n1444\t+\t\t\terr := scrub(wt, []string{rel})\n1445\t+\t\t\tif (err != nil) != c.fail {\n1446\t+\t\t\t\tt.Fatalf(\"err = %v, want failure %v\", err, c.fail)\n1447\t+\t\t\t}\n1448\t+\t\t\tif !c.fail {\n1449\t+\t\t\t\tif _, err := os.Lstat(filepath.Join(wt, rel)); err == nil {\n1450\t+\t\t\t\t\tt.Error(\"link still there\")\n1451\t+\t\t\t\t}\n1452\t+\t\t\t}\n1453\t+\t\t\tif c.name == \"parent is a symlink\" {\n1454\t+\t\t\t\tif _, err := os.Stat(filepath.Join(wt, \"elsewhere/worker-dev.md\")); err != nil {\n1455\t+\t\t\t\t\tt.Error(\"file behind the symlink was removed\")\n1456\t+\t\t\t\t}\n1457\t+\t\t\t}\n1458\t+\t\t})\n1459\t+\t}\n1460\t+}\n1461\t+\n1462\t+func TestPopulate(t *testing.T) {\n1463\t+\tt.Run(\"inputs and home\", func(t *testing.T) {\n1464\t+\t\tfor _, mask := range []int{0o077, 0o022} {\n1465\t+\t\t\told := syscall.Umask(mask)\n1466\t+\t\t\ttree, home := t.TempDir(), filepath.Join(t.TempDir(), \"h\")\n1467\t+\t\t\tp, err := Populate(PopulateSpec{Tree: tree, Home: home, Scrub: []string{\"gone\"},\n1468\t+\t\t\t\tInputs: []executor.File{{Path: \"a/b/in.txt\", Data: []byte(\"x\")}}})\n1469\t+\t\t\tsyscall.Umask(old)\n1470\t+\t\t\tif err != nil {\n1471\t+\t\t\t\tt.Fatal(err)\n1472\t+\t\t\t}\n1473\t+\t\t\tif b, err := os.ReadFile(filepath.Join(tree, \"a/b/in.txt\")); err != nil || string(b) != \"x\" {\n1474\t+\t\t\t\tt.Errorf(\"input: %q %v\", b, err)\n1475\t+\t\t\t}\n1476\t+\t\t\tif p.ConfigDir != filepath.Join(home, ConfigDirName) || len(p.Scrubbed) != 1 || p.Scrubbed[0] != \"gone\" {\n1477\t+\t\t\t\tt.Errorf(\"populated = %+v\", p)\n1478\t+\t\t\t}\n1479\t+\t\t\tfor _, d := range []string{filepath.Join(home, \"tmp\"), p.ConfigDir} {\n1480\t+\t\t\t\tif st, err := os.Stat(d); err != nil || st.Mode().Perm() != 0o700 {\n1481\t+\t\t\t\t\tt.Errorf(\"%s: %v %v\", d, st, err)\n1482\t+\t\t\t\t}\n1483\t+\t\t\t}\n1484\t+\t\t}\n1485\t+\t})\n1486\t+\tt.Run(\"no home\", func(t *testing.T) {\n1487\t+\t\tp, err := Populate(PopulateSpec{Tree: t.TempDir()})\n1488\t+\t\tif err != nil || p.ConfigDir != \"\" {\n1489\t+\t\t\tt.Errorf(\"%+v %v\", p, err)\n1490\t+\t\t}\n1491\t+\t})\n1492\t+\tt.Run(\"input over symlink fails\", func(t *testing.T) {\n1493\t+\t\ttree := t.TempDir()\n1494\t+\t\tif err := os.Symlink(\"elsewhere\", filepath.Join(tree, \"in.txt\")); err != nil {\n1495\t+\t\t\tt.Fatal(err)\n1496\t+\t\t}\n1497\t+\t\t_, err := Populate(PopulateSpec{Tree: tree, Inputs: []executor.File{{Path: \"in.txt\", Data: []byte(\"x\")}}})\n1498\t+\t\tif err == nil {\n1499\t+\t\t\tt.Error(\"want error\")\n1500\t+\t\t}\n1501\t+\t\tif _, err := os.Lstat(filepath.Join(tree, \"elsewhere\")); err == nil {\n1502\t+\t\t\tt.Error(\"write followed the symlink\")\n1503\t+\t\t}\n1504\t+\t})\n1505\t+\tt.Run(\"scrub of a directory fails\", func(t *testing.T) {\n1506\t+\t\ttree := t.TempDir()\n1507\t+\t\tos.Mkdir(filepath.Join(tree, \"d\"), 0o755)\n1508\t+\t\tif _, err := Populate(PopulateSpec{Tree: tree, Scrub: []string{\"d\"}}); err == nil {\n1509\t+\t\t\tt.Error(\"want error\")\n1510\t+\t\t}\n1511\t+\t})\n1512\t+}\n1513\tdiff --git a/internal/executor/workspace/prepare.go b/internal/executor/workspace/prepare.go\n1514\tnew file mode 100644\n1515\tindex 0000000..f6aab08\n1516\t--- /dev/null\n1517\t+++ b/internal/executor/workspace/prepare.go\n1518\t@@ -0,0 +1,133 @@\n1519\t+package workspace\n1520\t+\n1521\t+import (\n1522\t+\t\"context\"\n1523\t+\t\"errors\"\n1524\t+\t\"fmt\"\n1525\t+\t\"os\"\n1526\t+\t\"path/filepath\"\n1527\t+\n1528\t+\t\"github.com/albertcbrown/ard/internal/executor\"\n1529\t+)\n1530\t+\n1531\t+// Prepare creates the worktree, writes inputs, makes the home and config dir,\n1532\t+// exports the sidecar and creates the log files. It returns a host Handle\n1533\t+// (Kind \"host\"); a caller that runs Docker adjusts it. On error it removes\n1534\t+// everything it made.\n1535\t+func (w *Workspace) Prepare(ctx context.Context, j executor.Job) (h executor.Handle, err error) {\n1536\t+\tif err := j.Validate(); err != nil {\n1537\t+\t\treturn h, err\n1538\t+\t}\n1539\t+\twt, err := w.WorktreePath(j.Repo, j.ID)\n1540\t+\tif err != nil {\n1541\t+\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, err)\n1542\t+\t}\n1543\t+\tif _, err := os.Lstat(wt); err == nil {\n1544\t+\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, executor.ErrExists)\n1545\t+\t}\n1546\t+\tsha, err := w.git.RevParse(ctx, j.RepoDir, j.Ref)\n1547\t+\tif err != nil {\n1548\t+\t\treturn h, fmt.Errorf(\"resolve ref %q: %w: %w\", j.Ref, executor.ErrClone, err)\n1549\t+\t}\n1550\t+\tnow := w.now().UTC()\n1551\t+\tbase := LogBase(j.Stage, j.Role, now)\n1552\t+\tlogDir, err := w.LogDir(j.Repo, j.Issue)\n1553\t+\tif err != nil {\n1554\t+\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, err)\n1555\t+\t}\n1556\t+\thome, err := w.HomePath(j.Repo, j.ID)\n1557\t+\tif err != nil {\n1558\t+\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, err)\n1559\t+\t}\n1560\t+\th = executor.Handle{\n1561\t+\t\tJobID: j.ID, Kind: \"host\", Issue: j.Issue, Stage: j.Stage, Role: j.Role,\n1562\t+\t\tWorktree: wt, Home: home, RepoDir: j.RepoDir, BaseSHA: sha,\n1563\t+\t\tLogPath: filepath.Join(logDir, base+\".log\"), StdoutPath: filepath.Join(logDir, base+\".stdout\"),\n1564\t+\t\tView:    executor.Paths{Work: wt, Role: j.RoleDir},\n1565\t+\t\tRoleDir: j.RoleDir, ReadOnly: j.ReadOnly, Network: j.Network,\n1566\t+\t\tTrustedInput: j.TrustedInput, PreparedAt: now, Timeout: j.Timeout,\n1567\t+\t}\n1568\t+\tvar created []string // paths to remove on failure\n1569\t+\tworktreeAdded := false\n1570\t+\tdefer func() {\n1571\t+\t\tif err == nil {\n1572\t+\t\t\treturn\n1573\t+\t\t}\n1574\t+\t\tif worktreeAdded {\n1575\t+\t\t\tChmodWritable(wt)\n1576\t+\t\t\tif rerr := w.git.WorktreeRemove(context.WithoutCancel(ctx), j.RepoDir, wt, true); rerr != nil {\n1577\t+\t\t\t\terr = errors.Join(err, rerr)\n1578\t+\t\t\t}\n1579\t+\t\t\tRemoveAllWritable(wt)\n1580\t+\t\t\tw.git.WorktreePrune(context.WithoutCancel(ctx), j.RepoDir)\n1581\t+\t\t}\n1582\t+\t\tfor _, p := range created {\n1583\t+\t\t\tRemoveAllWritable(p) // a sidecar tree under home is a-w\n1584\t+\t\t}\n1585\t+\t\th = executor.Handle{}\n1586\t+\t}()\n1587\t+\n1588\t+\tif err = os.MkdirAll(filepath.Dir(wt), 0o755); err != nil {\n1589\t+\t\treturn h, fmt.Errorf(\"create work dir: %w\", err)\n1590\t+\t}\n1591\t+\tif err = w.git.WorktreeAdd(ctx, j.RepoDir, wt, sha); err != nil {\n1592\t+\t\treturn h, fmt.Errorf(\"add worktree: %w: %w\", executor.ErrClone, err)\n1593\t+\t}\n1594\t+\tworktreeAdded = true\n1595\t+\t// The config dir lives inside home, so Remove and this function's\n1596\t+\t// failure path remove it with home.\n1597\t+\tcreated = append(created, home)\n1598\t+\tvar pop Populated\n1599\t+\tif pop, err = Populate(PopulateSpec{Tree: wt, Home: home, Scrub: j.Scrub, Inputs: j.Inputs}); err != nil {\n1600\t+\t\treturn h, err\n1601\t+\t}\n1602\t+\th.Scrubbed = pop.Scrubbed\n1603\t+\th.View.ConfigDir = pop.ConfigDir\n1604\t+\tif j.History {\n1605\t+\t\t// Host mode hands over the live clone: read-only is enforced only by the\n1606\t+\t\t// Docker mount (:ro), not on the host.\n1607\t+\t\th.HistoryDir, h.View.History = j.RepoDir, j.RepoDir\n1608\t+\t}\n1609\t+\t// --- sidecar (#28): the executor clones, pins and mounts it read-only ---\n1610\t+\tif j.Sidecar != (executor.Sidecar{}) {\n1611\t+\t\tdest := filepath.Join(home, sidecarDirName)\n1612\t+\t\tvar scSHA string\n1613\t+\t\tvar fetched bool\n1614\t+\t\tif scSHA, fetched, err = w.materialise(ctx, j.Repo, j.Sidecar, dest); err != nil {\n1615\t+\t\t\treturn h, err\n1616\t+\t\t}\n1617\t+\t\th.SidecarDir, h.Sidecar, h.SidecarSHA = dest, j.Sidecar, scSHA\n1618\t+\t\th.View.Sidecar = dest\n1619\t+\t\tw.log.Info(\"executor.sidecar_ready\", \"job\", j.ID, \"repo\", j.Sidecar.Repo, \"ref\", j.Sidecar.Ref, \"sha\", scSHA, \"fetched\", fetched)\n1620\t+\t}\n1621\t+\t// --- end sidecar ---\n1622\t+\tif err = os.MkdirAll(logDir, 0o700); err != nil {\n1623\t+\t\treturn h, fmt.Errorf(\"create log dir: %w\", err)\n1624\t+\t}\n1625\t+\tfor _, p := range []string{h.LogPath, h.StdoutPath} {\n1626\t+\t\tvar f *os.File\n1627\t+\t\tif f, err = os.OpenFile(p, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o600); err != nil {\n1628\t+\t\t\treturn h, fmt.Errorf(\"create log %s: %w\", p, err)\n1629\t+\t\t}\n1630\t+\t\tf.Close()\n1631\t+\t\tcreated = append(created, p)\n1632\t+\t}\n1633\t+\tif h.SidecarDir != \"\" { // #28: read-only in both modes; Docker also mounts :ro\n1634\t+\t\tif err = ChmodReadOnly(h.SidecarDir); err != nil {\n1635\t+\t\t\treturn h, fmt.Errorf(\"make sidecar read-only: %w\", err)\n1636\t+\t\t}\n1637\t+\t}\n1638\t+\treturn h, nil\n1639\t+}\n1640\t+\n1641\t+// Discard removes everything Prepare made for h, log files included. A caller\n1642\t+// whose own steps after a successful Prepare fail uses it.\n1643\t+func (w *Workspace) Discard(ctx context.Context, h executor.Handle) error {\n1644\t+\terr := w.Remove(ctx, h)\n1645\t+\tfor _, p := range []string{h.LogPath, h.StdoutPath} {\n1646\t+\t\tif p != \"\" {\n1647\t+\t\t\tos.Remove(p)\n1648\t+\t\t}\n1649\t+\t}\n1650\t+\treturn err\n1651\t+}\n1652\tdiff --git a/internal/executor/workspace/prepare_test.go b/internal/executor/workspace/prepare_test.go\n1653\tnew file mode 100644\n1654\tindex 0000000..c5679fa\n1655\t--- /dev/null\n1656\t+++ b/internal/executor/workspace/prepare_test.go\n1657\t@@ -0,0 +1,107 @@\n1658\t+//go:build unix\n1659\t+\n1660\t+package workspace\n1661\t+\n1662\t+import (\n1663\t+\t\"context\"\n1664\t+\t\"os\"\n1665\t+\t\"path/filepath\"\n1666\t+\t\"testing\"\n1667\t+\t\"ti