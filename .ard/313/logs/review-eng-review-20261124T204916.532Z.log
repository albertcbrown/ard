 (Populated, error) {\n1285\t+\tvar p Populated\n1286\t+\tif err := scrub(s.Tree, s.Scrub); err != nil {\n1287\t+\t\treturn p, err\n1288\t+\t}\n1289\t+\tp.Scrubbed = append([]string(nil), s.Scrub...)\n1290\t+\tif len(s.Inputs) > 0 {\n1291\t+\t\t// os.Root refuses to follow symlinks out of the worktree, so a\n1292\t+\t\t// committed symlink at an input path cannot redirect the write.\n1293\t+\t\tr, err := os.OpenRoot(s.Tree)\n1294\t+\t\tif err != nil {\n1295\t+\t\t\treturn p, fmt.Errorf(\"open worktree: %w\", err)\n1296\t+\t\t}\n1297\t+\t\tdefer r.Close()\n1298\t+\t\tfor _, f := range s.Inputs {\n1299\t+\t\t\trel := filepath.FromSlash(f.Path)\n1300\t+\t\t\tif err := r.MkdirAll(filepath.Dir(rel), 0o755); err != nil {\n1301\t+\t\t\t\treturn p, fmt.Errorf(\"write input %s: %w\", f.Path, err)\n1302\t+\t\t\t}\n1303\t+\t\t\tif err := rejectSymlink(r, rel); err != nil {\n1304\t+\t\t\t\treturn p, fmt.Errorf(\"write input %s: %w\", f.Path, err)\n1305\t+\t\t\t}\n1306\t+\t\t\tif err := r.WriteFile(rel, f.Data, 0o644); err != nil {\n1307\t+\t\t\t\treturn p, fmt.Errorf(\"write input %s: %w\", f.Path, err)\n1308\t+\t\t\t}\n1309\t+\t\t}\n1310\t+\t}\n1311\t+\tif s.Home != \"\" {\n1312\t+\t\tcfg, err := MakeHome(s.Home)\n1313\t+\t\tif err != nil {\n1314\t+\t\t\treturn p, err\n1315\t+\t\t}\n1316\t+\t\tp.ConfigDir = cfg\n1317\t+\t}\n1318\t+\treturn p, nil\n1319\t+}\n1320\t+\n1321\t+// MakeHome creates home/tmp and the config dir inside home, both 0700 past\n1322\t+// the umask, and returns the config dir.\n1323\t+func MakeHome(home string) (configDir string, err error) {\n1324\t+\tif err := os.MkdirAll(filepath.Join(home, \"tmp\"), 0o700); err != nil {\n1325\t+\t\treturn \"\", fmt.Errorf(\"create home: %w\", err)\n1326\t+\t}\n1327\t+\tcfg := filepath.Join(home, ConfigDirName)\n1328\t+\tif err := os.Mkdir(cfg, 0o700); err != nil {\n1329\t+\t\treturn \"\", fmt.Errorf(\"create config dir: %w\", err)\n1330\t+\t}\n1331\t+\tif err := os.Chmod(cfg, 0o700); err != nil {\n1332\t+\t\treturn \"\", fmt.Errorf(\"create config dir: %w\", err)\n1333\t+\t}\n1334\t+\treturn cfg, nil\n1335\t+}\n1336\t+\n1337\t+// scrub removes each path from the worktree: a regular file or a symlink\n1338\t+// (the link itself). A missing path is fine. It fails if the parent directory\n1339\t+// is a symlink (os.Root would follow it inside the worktree) and never removes\n1340\t+// a directory.\n1341\t+func scrub(wt string, paths []string) error {\n1342\t+\tif len(paths) == 0 {\n1343\t+\t\treturn nil\n1344\t+\t}\n1345\t+\tr, err := os.OpenRoot(wt)\n1346\t+\tif err != nil {\n1347\t+\t\treturn fmt.Errorf(\"open worktree: %w\", err)\n1348\t+\t}\n1349\t+\tdefer r.Close()\n1350\t+\tfor _, p := range paths {\n1351\t+\t\trel := filepath.FromSlash(p)\n1352\t+\t\tparent, err := r.Lstat(filepath.Dir(rel))\n1353\t+\t\tswitch {\n1354\t+\t\tcase errors.Is(err, fs.ErrNotExist):\n1355\t+\t\t\tcontinue\n1356\t+\t\tcase err != nil:\n1357\t+\t\t\treturn fmt.Errorf(\"scrub %s: %w\", p, err)\n1358\t+\t\tcase parent.Mode()&fs.ModeSymlink != 0 || !parent.IsDir():\n1359\t+\t\t\treturn fmt.Errorf(\"scrub %s: parent %s is not a plain directory\", p, filepath.Dir(p))\n1360\t+\t\t}\n1361\t+\t\tst, err := r.Lstat(rel)\n1362\t+\t\tswitch {\n1363\t+\t\tcase errors.Is(err, fs.ErrNotExist):\n1364\t+\t\t\tcontinue\n1365\t+\t\tcase err != nil:\n1366\t+\t\t\treturn fmt.Errorf(\"scrub %s: %w\", p, err)\n1367\t+\t\tcase !st.Mode().IsRegular() && st.Mode()&fs.ModeSymlink == 0:\n1368\t+\t\t\treturn fmt.Errorf(\"scrub %s: not a file\", p)\n1369\t+\t\t}\n1370\t+\t\tif err := r.Remove(rel); err != nil && !errors.Is(err, fs.ErrNotExist) {\n1371\t+\t\t\treturn fmt.Errorf(\"scrub %s: %w\", p, err)\n1372\t+\t\t}\n1373\t+\t}\n1374\t+\treturn nil\n1375\t+}\n1376\t+\n1377\t+// rejectSymlink fails when rel already exists as a symlink: even a link that\n1378\t+// stays inside the worktree would let a branch swap what an input resolves to.\n1379\t+func rejectSymlink(r *os.Root, rel string) error {\n1380\t+\tif st, err := r.Lstat(re