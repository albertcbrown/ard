il\n\t}\n\tg := book.Gate(policyOf(cfg.Limits), tierOf(c))\n\tif g.Deny {\n\t\tgu := g.Until\n\t\tif now := time.Now(); !gu.After(now) {\n\t\t\tgu = now.Add(gateRecheck)\n\t\t}\n\t\tif gu.After(until) {\n\t\t\tuntil = gu\n\t\t}\n\t}\n\treturn until\n}\n\n// gateRecheck is how long a threshold denial lasts when the reading carries no\n// reset time.\nconst gateRecheck = 5 * time.Minute\n\nfunc isClaude(role config.Role) bool { return role.Agent == \"claude\" }\n\nfunc tierOf(c pool.Candidate) limits.Tier {\n\tif c.Class == pool.ClassReview {\n\t\treturn limits.TierReviewer\n\t}\n\treturn limits.TierWorker\n}\n\nfunc policyOf(l config.Limits) limits.Policy {\n\tp := limits.Policy{StopWorkersPct: l.StopWorkersPct, StopAllPct: l.StopAllPct, WeeklyStopAllPct: l.WeeklyStopAllPct}\n\tcopy(p.WeeklyByDay[:], l.WeeklyStopWorkersPctByDay)\n\treturn p\n}\n\n// annotate is the pool's Options.Annotate: it marks a candidate that runs the\n// Claude agent (it counts toward the one-job rule) and sets Serial while the\n// 5-hour usage is at or above stop_workers_pct. Deterministic scanners and\n// roles of other agents are left alone.\nfunc (w *wiring) annotate(c pool.Candidate) pool.Candidate {\n\tcfg, role, ok := w.limitRole(c)\n\tif !ok || (role.Kind == config.KindScanner && role.ScanPath != \"\") || !isClaude(role) {\n\t\treturn c\n\t}\n\tc.Agent = true\n\tw.initMu.Lock()\n\tbook := w.lim\n\tw.initMu.Unlock()\n\tif book != nil {\n\t\tc.Serial = book.Gate(policyOf(cfg.Limits), tierOf(c)).Serial\n\t}\n\treturn c\n}\n\n'''\nopen(r,'w').write(s[:i]+new+s[j:])\na='internal/servecmd/adopt.go'\nsub(a,'budget func(pool.Candidate) (bool, string)) (*pool.Pool','budget func(pool.Candidate) (bool, string), annotate ...func(pool.Candidate) pool.Candidate) (*pool.Pool')\nsub(a,'''\treturn pool.New(pool.Options{Max: maxPods, Held: held, Log: log, Limited: limited, Budget: budget}), nil''','''\topts := pool.Options{Max: maxPods, Held: held, Log: log, Limited: limited, Budget: budget}\n\tif len(annotate) > 0 {\n\t\topts.Annotate = annotate[0]\n\t}\n\treturn pool.New(opts), nil''')\nsub(a,'non-nil, is the pool\\'s Options.Budget: it refuses candidates at a daily cap.','non-nil, is the pool\\'s Options.Budget: it refuses candidates at a daily cap.\\n// annotate, when given, is the pool\\'s Options.Annotate (the one-job rule).')\nsub('internal/servecmd/serve.go','w.limitedFor, w.budgetGate().Denied)','w.limitedFor, w.budgetGate().Denied, w.annotate)')\nEOF\ngo build ./... && go vet ./internal/servecmd ./internal/pool"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1264,"cache_read_input_tokens":65962,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1264},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a202292d-aebe-442f-b3a4-7ee5df5f1615","uuid":"b6c6dd1e-b069-4618-afe7-6526edb0ddb6","timestamp":"2026-11-27T19:47:08.673Z","request_id":"req_011ChU1W1TWueWMoAWo6bKSa"}
