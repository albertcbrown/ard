{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SaDZtqzFjkRtYGKtcZupBa","type":"tool_result","content":"package pool\n\nimport \"time\"\n\n// Candidate is one job a loop would like to start.\ntype Candidate struct {\n\tClass Class\n\t// Role is the role directory name, e.g. \"lead\", \"security-review\", \"cve\".\n\tRole string\n\t// Number is the issue (triage, worker) or PR (review) number, and 0 for\n\t// scanner runs. Negative numbers are allowed (dry-run synthetic issues).\n\tNumber int\n\t// Since is when the job became eligible; required. Triage and worker use\n\t// the issue's created_at, reviewers the PR's created_at, and a scanner run\n\t// the time it became due (last run plus interval).\n\tSince time.Time\n\t// Priority orders candidates within a class: 0 (ard:p0) first, 3 last.\n\t// The zero value is P0, so callers must set it; labels.Priority returns 2\n\t// for an unlabelled item, and scanner runs use 2.\n\tPriority int\n}\n\n// Key returns KeyFor(c.Class, c.Role, c.Number); callers never build keys by hand.\nfunc (c Candidate) Key() string { return KeyFor(c.Class, c.Role, c.Number) }\n\n// invalid returns the first rule the candidate breaks, or \"\".\nfunc (c Candidate) invalid() string {\n\tswitch {\n\tcase !c.Class.valid():\n\t\treturn \"unknown class \" + c.Class.String()\n\tcase c.Role == \"\":\n\t\treturn \"empty role\"\n\tcase c.Since.IsZero():\n\t\treturn \"zero Since\"\n\tcase c.Class == ClassScanner && c.Number != 0:\n\t\treturn \"scanner candidate must have number 0\"\n\tcase c.Class != ClassScanner && c.Number == 0:\n\t\treturn c.Class.String() + \" candidate must have a non-zero number\"\n\t}\n\treturn \"\"\n}\n\n// less is a total order on distinct keys: class, then Priority (lower first), then oldest Since, then\n// lower Number, then Role. It does not depend on input order.\nfunc less(a, b Candidate) bool {\n\tif a.Class != b.Class {\n\t\treturn a.Class < b.Class\n\t}\n\tif a.Priority != b.Priority {\n\t\treturn a.Priority < b.Priority\n\t}\n\tif !a.Since.Equal(b.Since) {\n\t\treturn a.Since.Before(b.Since)\n\t}\n\tif a.Number != b.Number {\n\t\treturn a.Number < b.Number\n\t}\n\treturn a.Role < b.Role\n}\npackage pool\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"io\"\n\t\"log/slog\"\n\t\"sort\"\n\t\"sync\"\n\t\"time\"\n)\n\n// Verdict is the pool's answer for one candidate.\ntype Verdict int\n\n// Verdicts. Anything other than Granted means the loop touches no label and\n// writes no state; the candidate is offered again next tick.\nconst (\n\tGranted         Verdict = iota\n\tDeniedFull              // no slot was free for it, and no other loop reserved one\n\tDeniedOutranked         // higher-ranked live demand from another loop reserved the free slots\n\tDeniedIssueBusy         // triage only: a triage job on the same issue is held or granted earlier in the batch\n\tDeniedDuplicate         // same key already held, or earlier in this batch\n\tDeniedInvalid           // malformed candidate (caller bug)\n\tDeniedLimited           // its account or model family is out of quota until a reset time\n\tDeniedBudget            // a daily dollar or token cap is reached\n)\n\nvar verdictNames = [...]string{\"granted\", \"full\", \"outranked\", \"issue-busy\", \"duplicate\", \"invalid\", \"limited\", \"budget\"}\n\n// String returns the verdict's log name.\nfunc (v Verdict) String() string {\n\tif v >= 0 && int(v) < len(verdictNames) {\n\t\treturn verdictNames[v]\n\t}\n\treturn fmt.Sprintf(\"verdict(%d)\", int(v))\n}\n\n// Decision is the result for one offered candidate.\ntype Decision struct {\n\tCandidate Candidate\n\tVerdict   Verdict\n\tSlot      *Slot  // non-nil if and only if Verdict == Granted\n\tReason    string // human-readable, for logs and the status issue\n}\n\n// Held is a job already running when the pool is built (restart recovery).\ntype Held struct {\n\tCandidate Candidate\n\tJobID     string\n}\n\n// Options configures New.\ntype Options struct {\n\tMax         int              // cfg.MaxPods; values < 1 are treated as 1\n\tNow         func() time.Time // nil means time.Now\n\tLog         *slog.Logger     // nil means discard\n\tHeld        []Held           // running jobs from state; held even if they exceed Max\n\tStarveAfter time.Duration    // 0 means 24h\n\t// Limited reports when a candidate may next start because its account or\n\t// model family is out of quota: zero or a past time means it may start\n\t// now. nil disables the check. A limited candidate takes no slot and\n\t// reserves no demand: it does not hold lower classes back.\n\tLimited func(c Candidate) time.Time\n\t// Budget reports whether a daily dollar or token cap forbids starting c, with the\n\t// reason. nil disables the check. A refused candidate takes no slot and\n\t// reserves no demand; a job already held is never affected.\n\tBudget func(c Candidate) (denied bool, reason string)\n}\n\n// Pool is the in-memory slot arbiter. One mutex guards all state; there are\n// no goroutines or timers, and demand expiry is evaluated lazily.\ntype Pool struct {\n\tmu          sync.Mutex\n\tmax         int\n\tnow         func() time.Time\n\tlog         *slog.Logger\n\tstarveAfter time.Duration\n\tlimited     func(c Candidate) time.Time\n\tbudget      func(c Candidate) (bool, string)\n\theld        map[string]*Slot\n\tdemand      map[string]*loopDemand\n\tfirstDenied map[string]time.Time\n\tstarved     map[Class]bool\n\trefused     map[refusalKey]*refusal\n\tfreed       chan struct{}\n}\n\n// New builds a pool, adopting o.Held.\nfunc New(o Options) *Pool {\n\tp := &Pool{\n\t\tmax:         max(1, o.Max),\n\t\tnow:         o.Now,\n\t\tlog:         o.Log,\n\t\tstarveAfter: o.StarveAfter,\n\t\tlimited:     o.Limited,\n\t\tbudget:      o.Budget,\n\t\theld:        map[string]*Slot{},\n\t\tdemand:      map[string]*loopDemand{},\n\t\tfirstDenied: map[string]time.Time{},\n\t\tstarved:     map[Class]bool{},\n\t\trefused:     map[refusalKey]*refusal{},\n\t\tfreed:       make(chan struct{}, 1),\n\t}\n\tif p.now == nil {\n\t\tp.now = time.Now\n\t}\n\tif p.log == nil {\n\t\tp.log = slog.New(slog.NewTextHandler(io.Discard, nil))\n\t}\n\tif p.starveAfter == 0 {\n\t\tp.starveAfter = 24 * time.Hour\n\t}\n\tfor _, h := range o.Held {\n\t\tk := h.Candidate.Key()\n\t\tif p.held[k] != nil {\n\t\t\tp.log.Warn(\"pool.adopt_duplicate\", \"key\", k, \"job_id\", h.JobID)\n\t\t\tcontinue\n\t\t}\n\t\tp.held[k] = &Slot{pool: p, cand: h.Candidate, jobID: h.JobID, grantedAt: p.now(), adopted: true}\n\t}\n\tif len(p.held) > p.max {\n\t\tp.log.Warn(\"pool.adopt_over_max\", \"held\", len(p.held), \"max\", p.max)\n\t}\n\treturn p\n}\n\n// SetMax changes the cap. It never revokes held slots; n < 1 is treated as 1.\nfunc (p *Pool) SetMax(n int) {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\told := p.max\n\tp.max = max(1, n)\n\tif p.max > old {\n\t\tp.signalLocked()\n\t}\n}\n\n// Freed returns a channel that receives when a slot is released or the cap is\n// raised. It is buffered with one place and sent to without blocking, so\n// several releases coalesce into one pending signal.\nfunc (p *Pool) Freed() <-chan struct{} { return p.freed }\n\nfunc (p *Pool) signalLocked() {\n\tselect {\n\tcase p.freed <- struct{}{}:\n\tdefault:\n\t}\n}\n\n// Lookup returns the held slot for key, for close-out and the Reaper after a restart.\nfunc (p *Pool) Lookup(key string) (*Slot, bool) {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\ts, ok := p.held[key]\n\treturn s, ok\n}\n\ntype item struct {\n\tcand Candidate\n\tidx  int // index into decisions; -1 for foreign demand\n}\n\n// Offer ranks cands against held slots and other loops' live demand and\n// returns one Decision per candidate, in input order. It replaces loop's\n// demand entry, which expires ttl after this call (ttl <= 0 records none).\n// Loops must call Offer once per tick even with no candidates, so stale\n// demand clears.\nfunc (p *Pool) Offer(loop string, ttl time.Duration, cands []Candidate) []Decision {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\tnow := p.now()\n\tp.purgeLocked(now)\n\n\tfree0 := max(0, p.max-len(p.held))\n\tfree := free0\n\tdecisions := make([]Decision, len(cands))\n\ttriageHeld := map[int]bool{}\n\tfor _, s := range p.held {\n\t\tif s.cand.Class == ClassTriage {\n\t\t\ttriageHeld[s.cand.Number] = true\n\t\t}\n\t}\n\n\t// Validation and duplicates.\n\tinBatch := map[string]bool{}\n\tvar items []item\n\tfor i, c := range cands {\n\t\tdecisions[i].Candidate = c\n\t\tif why := c.invalid(); why != \"\" {\n\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedInvalid, why\n\t\t\tp.log.Warn(\"pool.invalid\", \"loop\", loop, \"class\", c.Class.String(), \"role\", c.Role, \"number\", c.Number, \"reason\", why)\n\t\t\tcontinue\n\t\t}\n\t\tk := c.Key()\n\t\tif p.held[k] != nil || inBatch[k] {\n\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedDuplicate, \"already held or offered earlier in this batch\"\n\t\t\tcontinue\n\t\t}\n\t\tif p.limited != nil {\n\t\t\tif until := p.limited(c); now.Before(until) {\n\t\t\t\tdecisions[i].Verdict = DeniedLimited\n\t\t\t\tdecisions[i].Reason = \"usage limit until \" + until.UTC().Format(\"15:04\") + \" UTC\"\n\t\t\t\tp.noteRefusalLocked(c, DeniedLimited, now)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tif p.budget != nil {\n\t\t\tif denied, why := p.budget(c); denied {\n\t\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedBudget, why\n\t\t\t\tp.noteRefusalLocked(c, DeniedBudget, now)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tinBatch[k] = true\n\t\titems = append(items, item{c, i})\n\t}\n\tfor _, c := range p.foreignLocked(loop, now, inBatch, triageHeld) {\n\t\titems = append(items, item{c, -1})\n\t}\n\tsort.Slice(items, func(a, b int) bool { return less(items[a].cand, items[b].cand) })\n\n\t// Walk the merged ranking.\n\treserved := 0\n\ttriageGranted := map[int]bool{}\n\tvar denied []Candidate\n\tcapDenied := 0\n\tfor _, it := range items {\n\t\tif it.idx < 0 {\n\t\t\tif free > 0 {\n\t\t\t\tfree--\n\t\t\t\treserved++\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\td := &decisions[it.idx]\n\t\tc := it.cand\n\t\tswitch {\n\t\tcase c.Class == ClassTriage && (triageHeld[c.Number] || triageGranted[c.Number]):\n\t\t\td.Verdict, d.Reason = DeniedIssueBusy, fmt.Sprintf(\"a triage job on #%d is already held\", c.Number)\n\t\tcase free > 0:\n\t\t\tfree--\n\t\t\ts := &Slot{pool: p, cand: c, grantedAt: now}\n\t\t\tp.held[c.Key()] = s\n\t\t\tif c.Class == ClassTriage {\n\t\t\t\ttriageGranted[c.Number] = true\n\t\t\t}\n\t\t\tdelete(p.firstDenied, c.Key())\n\t\t\td.Verdict, d.Slot = Granted, s\n\t\t\tp.log.Debug(\"pool.grant\", \"loop\", loop, \"key\", c.Key(), \"class\", c.Class.String(), \"role\", c.Role, \"number\", c.Number)\n\t\tcase capDenied < reserved:\n\t\t\tcapDenied++\n\t\t\td.Verdict, d.Reason = DeniedOutranked, fmt.Sprintf(\"outranked by %d higher-ranked waiting job(s)\", reserved)\n\t\t\tdenied = append(denied, c)\n\t\tdefault:\n\t\t\tcapDenied++\n\t\t\td.Verdict, d.Reason = DeniedFull, \"no free slot\"\n\t\t\tdenied = append(denied, c)\n\t\t}\n\t}\n\tp.setDemandLocked(loop, now, ttl, denied)\n\tp.checkStarvationLocked(now)\n\n\tif p.log.Enabled(context.Background(), slog.LevelDebug) {\n\t\tcounts := map[string]int{}\n\t\tfor _, d := range decisions {\n\t\t\tcounts[d.Verdict.String()]++\n\t\t}\n\t\tp.log.Debug(\"pool.offer\", \"loop\", loop, \"verdicts\", fmt.Sprint(counts), \"free_before\", free0, \"free_after\", max(0, p.max-len(p.held)))\n\t}\n\treturn decisions\n}\npackage servecmd\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/agent\"\n\t\"github.com/albertcbrown/ard/internal/agent/claude\"\n\t\"github.com/albertcbrown/ard/internal/closeout\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n\t\"github.com/albertcbrown/ard/internal/executor\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n\t\"github.com/albertcbrown/ard/internal/limits\"\n\t\"github.com/albertcbrown/ard/internal/pool\"\n\t\"github.com/albertcbrown/ard/internal/reaper\"\n\t\"github.com/albertcbrown/ard/internal/redact\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// cfgRoles answers close-out's role questions from the latest loaded config.\ntype cfgRoles struct{ w *wiring }\n\nfunc (c cfgRoles) Role(k config.Kind, name string) (config.Role, bool) {\n\tcfg := c.w.cfg.Load()\n\tif cfg == nil {\n\t\treturn config.Role{}, false\n\t}\n\treturn cfg.Role(k, name)\n}\n\n// gitleaksOptions reports whether the optional gitleaks pass is enabled in the\n// latest loaded config, and which binary to run.\nfunc (w *wiring) gitleaksOptions() (redact.GitleaksOptions, bool) {\n\tcfg := w.cfg.Load()\n\tif cfg == nil || !cfg.Redact.Gitleaks.Enabled {\n\t\treturn redact.GitleaksOptions{}, false\n\t}\n\treturn redact.GitleaksOptions{Path: cfg.Redact.Gitleaks.Path}, true\n}\n\n// closer returns the one *closeout.Closer of this process. The triage, worker\n// and reviewer loops and the Reaper share it: its per-job busy lock only\n// serialises close-outs within one instance.\nfunc (w *wiring) closer() *closeout.Closer {\n\tw.initMu.Lock()\n\tdefer w.initMu.Unlock()\n\tif w.cl != nil {\n\t\treturn w.cl\n\t}\n\tstaging := filepath.Join(w.StateDir, \"closeout\")\n\tif w.StateDir == \"\" {\n\t\tstaging = filepath.Join(w.ardRoot(), \"closeout\")\n\t}\n\tvar getPR func(context.Context, int) (github.PullRequest, error)\n\tif w.Reader != nil {\n\t\tgetPR = w.Reader.GetPR\n\t}\n\t// Network switches the network bounce (#385) on: a needs-network worker is\n\t// sent to the triage engineer, which re-arms the lead (#386).\n\tw.cl = closeout.New(closeout.Deps{\n\t\tEffects: w.Effects, Comments: w.Reader, Committer: closeoutCommitter{w}, Store: w.Store,\n\t\tRoles: cfgRoles{w}, Network: w.Store,\n\t\t// The job's model credentials are in the controller's environment.\n\t\t// Host paths are replaced by placeholders in the same pass.\n\t\tNewRedactor: closeout.JobRedactor(w.environ, w.hostPaths(), w.gitleaksOptions),\n\t\t// Job worktrees belong to the agent: git runs in the controller's own\n\t\t// clone (w.Root) and never trusts a worktree's .git, index or config.\n\t\tChanged: func(ctx context.Context, worktree, base string, paths ...string) ([]gitx.PathChange, error) {\n\t\t\treturn gitx.New(\"\").ChangedSince(ctx, w.Root, worktree, base, paths...)\n\t\t},\n\t\tBaseFile: func(ctx context.Context, _, rev, path string, maxBytes int64) ([]byte, bool, error) {\n\t\t\treturn gitx.New(\"\").FileAt(ctx, w.Root, rev, path, maxBytes)\n\t\t},\n\t\tPR:         getPR,\n\t\tRepo:       w.Repo,\n\t\tStagingDir: staging,\n\t\tLog:        w.Log,\n\t\tWake:       w.wakeLoops,\n\t})\n\treturn w.cl\n}\n\n// reaperParts builds, once, the Finisher and Reaper that every loop shares.\nfunc (w *wiring) reaperParts() (*reaper.Finisher, *reaper.Reaper, error) {\n\tw.initMu.Lock()\n\tif w.fin != nil {\n\t\tdefer w.initMu.Unlock()\n\t\treturn w.fin, w.rp, nil\n\t}\n\tw.initMu.Unlock()\n\tex, err := w.newExecutor()\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\tcl := w.closer()\n\tw.initMu.Lock()\n\tdefer w.initMu.Unlock()\n\tif w.fin != nil {\n\t\treturn w.fin, w.rp, nil\n\t}\n\tstarted := w.Started\n\tif started.IsZero() {\n\t\tstarted = time.Now()\n\t}\n\t// With no credential Auth is \"\": only the rate_limit_event and limit-message\n\t// signals count as a usage limit.\n\tw.fin = &reaper.Finisher{Closer: cl, Cleaner: ex, Store: w.Store, Start: started, Log: w.Log,\n\t\tClassify: reaper.UsageLimitClassifier(w.Model.Auth), Limits: lazyLimits{w}, Readings: readingObserver{w}}\n\tw.rp = reaper.New(reaper.Deps{\n\t\tStore: w.Store, Executor: ex, Finisher: w.fin, Closer: cl,\n\t\tPool:   func() reaper.Lookup { return w.Pool() },\n\t\tReader: w.Reader, Effects: w.Effects, Parse: w.parseFunc(), Log: w.Log,\n\t})\n\treturn w.fin, w.rp, nil\n}\n\n// lazyLimits is the Finisher's LimitRecorder. The book opens on first use (the\n// closeout-resume hook opens it at startup and fails serve on a read error), so\n// building the Finisher needs no state store.\ntype lazyLimits struct{ w *wiring }\n\nfunc (l lazyLimits) Exhaust(ctx context.Context, family string, resetsAt time.Time) (time.Time, error) {\n\tb, err := l.w.limitsBook(ctx)\n\tif err != nil {\n\t\treturn time.Time{}, err\n\t}\n\treturn b.Exhaust(ctx, family, resetsAt)\n}\n\nfunc (l lazyLimits) Succeeded(ctx context.Context, family string) error {\n\tb, err := l.w.limitsBook(ctx)\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn b.Succeeded(ctx, family)\n}\n\n// limitsBook returns the one limits book of this process, opened on first use.\n// An open error is a real store read failure (a corrupt value only logs), so\n// it is returned and not cached.\nfunc (w *wiring) limitsBook(ctx context.Context) (*limits.Book, error) {\n\tw.initMu.Lock()\n\tdefer w.initMu.Unlock()\n\tif w.lim != nil {\n\t\treturn w.lim, nil\n\t}\n\tb, err := limits.Open(ctx, w.Store, time.Now, w.Log)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"serve: %w\", err)\n\t}\n\tw.lim = b\n\treturn b, nil\n}\n\n// limitedFor is the pool's Options.Limited: when a candidate may next start\n// given the usage limits recorded so far. Deterministic scanners use no model\n// and are never limited. A role missing from the config is never offered, so\n// it is not limited either.\nfunc (w *wiring) limitedFor(c pool.Candidate) time.Time {\n\tvar kind config.Kind\n\tswitch c.Class {\n\tcase pool.ClassScanner:\n\t\tkind = config.KindScanner\n\tcase pool.ClassTriage:\n\t\tkind = config.KindTriage\n\tcase pool.ClassWorker:\n\t\tkind = config.KindWorker\n\tcase pool.ClassReview:\n\t\tkind = config.KindReviewer\n\tdefault:\n\t\treturn time.Time{}\n\t}\n\tcfg := w.cfg.Load()\n\tif cfg == nil {\n\t\treturn time.Time{}\n\t}\n\trole, ok := cfg.Role(kind, c.Role)\n\tif !ok || (kind == config.KindScanner && role.ScanPath != \"\") {\n\t\treturn time.Time{}\n\t}\n\tw.initMu.Lock()\n\tbook := w.lim\n\tw.initMu.Unlock()\n\tif book == nil {\n\t\treturn time.Time{}\n\t}\n\treturn book.Until(limits.FamilyOf(role.Model))\n}\n\n// finisher returns the shared Finisher the loops call when a job's process\n// has stopped (see package reaper for the contract).\nfunc (w *wiring) finisher() (*reaper.Finisher, error) {\n\tf, _, err := w.reaperParts()\n\treturn f, err\n}\n\n// reaperLoop returns the Reaper loop, or nil when the executor cannot be built.\nfunc reaperLoop(w *wiring) controller.Loop {\n\t_, r, err := w.reaperParts()\n\tif err != nil {\n\t\tw.Log.Error(\"reaper.executor_unavailable\", \"error\", err)\n\t\treturn nil\n\t}\n\treturn r\n}\n\n// resumeCloseouts is the closeout-resume startup hook. It runs before the pool\n// is adopted, so it never touches the pool.\nfunc (w *wiring) resumeCloseouts(ctx context.Context) error {\n\t// A store that cannot be read means state is broken: fail startup.\n\tif _, err := w.limitsBook(ctx); err != nil {\n\t\treturn fmt.Errorf(\"closeout-resume: %w\", err)\n\t}\n\t_, r, err := w.reaperParts()\n\tif err != nil {\n\t\t// Without an executor nothing runs jobs either; do not keep serve down.\n\t\tw.Log.Error(\"reaper.resume_skipped\", \"error\", err)\n\t\treturn nil\n\t}\n\treturn r.ResumeAll(ctx)\n}\n\n// parseFunc reads a job's agent result from its stdout log, with the adapter\n// its role is configured for.\nfunc (w *wiring) parseFunc() reaper.ParseFunc {\n\treg, err := agent.NewRegistry(claude.New(claude.Options{}))\n\tif err != nil {\n\t\tpanic(err) // a duplicate adapter name is a programming error\n\t}\n\treturn func(ctx context.Context, cfg *config.Resolved, sj state.Job, h executor.Handle, exitCode int) (agent.Result, error) {\n\t\tif cfg == nil {\n\t\t\treturn agent.Result{}, errors.New(\"no config loaded\")\n\t\t}\n\t\tvar kind config.Kind\n\t\tswitch sj.Stage {\n\t\tcase closeout.StageTriage:\n\t\t\tkind = config.KindTriage\n\t\tcase closeout.StageWorker:\n\t\t\tkind = config.KindWorker\n\t\tcase closeout.StageReview:\n\t\t\tkind = config.KindReviewer\n\t\tdefault:\n\t\t\treturn agent.Result{}, fmt.Errorf(\"stage %q has no agent\", sj.Stage)\n\t\t}\n\t\trole, ok := cfg.Role(kind, sj.Role)\n\t\tif !ok {\n\t\t\treturn agent.Result{}, fmt.Errorf(\"role %s/%s is not configured\", kind, sj.Role)\n\t\t}\n\t\ta, err := reg.Get(role.Agent)\n\t\tif err != nil {\n\t\t\treturn agent.Result{}, err\n\t\t}\n\t\tif h.StdoutPath == \"\" {\n\t\t\treturn agent.Result{}, errors.New(\"job has no stdout log\")\n\t\t}\n\t\tf, err := os.Open(h.StdoutPath)\n\t\tif err != nil {\n\t\t\treturn agent.Result{}, fmt.Errorf(\"open stdout log: %w\", err)\n\t\t}\n\t\tdefer f.Close()\n\t\tres, err := a.Parse(f, exitCode)\n\t\tif errors.Is(err, agent.ErrNoResult) {\n\t\t\treturn res, nil // a killed job has no result event: the partial result is the answer\n\t\t}\n\t\treturn res, err\n\t}\n}\n// Package limits is the controller's book of exhausted usage limits: the\n// reactive half of subscription limit handling (#81). When a job stops at a\n// limit, the Reaper's Finisher records it here and the pool starts no agent\n// job for the exhausted account or model family until it resets. Observed\n// readings, thresholds and status comments are #63's.\n//\n// The book is persisted in the controller database's meta table, so a pause\n// survives a restart. It never kills a running job.\npackage limits\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\nconst (\n\t// DefaultPause is the first pause when the CLI gave no reset time.\n\tDefaultPause = 30 * time.Minute\n\t// BackoffCap is the longest pause chosen without a reset time. Each\n\t// further stop with no reset doubles the pause up to this; a job that\n\t// succeeds resets it.\n\tBackoffCap = 4 * time.Hour\n\t// MaxPause clamps a reset time that is far away: a misread unit must not\n\t// block the account for years.\n\tMaxPause = 8 * 24 * time.Hour\n\n\tmetaKey = \"limits.exhausted\"\n)\n\n// Meta is the key-value store the book persists in (*state.Store).\ntype Meta interface {\n\tMeta(ctx context.Context, key string) (string, error) // errors.Is(err, state.ErrNotFound) = empty book\n\tSetMeta(ctx context.Context, key, value string) error\n}\n\n// entry is one exhausted family. Family \"\" is the whole account.\ntype entry struct {\n\tUntil int64 `json:\"until\"`          // Unix seconds\n\tStep  int   `json:\"step,omitempty\"` // consecutive stops with no reset time\n}\n\n// Book records which families are exhausted and until when.\ntype Book struct {\n\tmu       sync.Mutex\n\tentries  map[string]entry\n\treadings map[string]Reading\n\tmeta     Meta\n\tnow      func() time.Time\n\tlog      *slog.Logger\n}\n\n// Open loads the book. A missing key gives an empty book; a malformed value\n// logs WARN limits.corrupt and gives an empty book (the next Exhaust\n// overwrites it). Only a read error from meta is returned.\nfunc Open(ctx context.Context, m Meta, now func() time.Time, log *slog.Logger) (*Book, error) {\n\tif now == nil {\n\t\tnow = time.Now\n\t}\n\tif log == nil {\n\t\tlog = slog.Default()\n\t}\n\tb := &Book{entries: map[string]entry{}, readings: map[string]Reading{}, meta: m, now: now, log: log}\n\tv, err := m.Meta(ctx, metaKey)\n\tswitch {\n\tcase errors.Is(err, state.ErrNotFound):\n\tcase err != nil:\n\t\treturn nil, fmt.Errorf(\"open limits book: %w\", err)\n\tdefault:\n\t\tvar got map[string]entry\n\t\tif err := json.Unmarshal([]byte(v), &got); err != nil {\n\t\t\tlog.Warn(\"limits.corrupt\", \"error\", err)\n\t\t} else if got != nil {\nagent/agent.go:159:type Window struct {\nagent/agent.go-160-\tType        string    // raw window name, e.g. \"five_hour\", \"seven_day\"\nagent/agent.go-161-\tUtilization float64   // exactly as the stream reports it (a 0-1 fraction or a percent); not normalised\nagent/agent.go-162-\tStatus      string    // raw status, e.g. \"allowed\", \"allowed_warning\", \"rejected\"\nagent/agent.go-163-\tResetsAt    time.Time // UTC; zero when absent\nagent/agent.go-164-}\nagent/agent.go-165-\nagent/agent.go-166-// Transient reports whether a failed run looks worth one automatic retry.\nagent/agent.go-167-func (r Result) Transient() bool {","is_error":false}]},"parent_tool_use_id":null,"session_id":"a202292d-aebe-442f-b3a4-7ee5df5f1615","uuid":"fd450874-77cf-4a7a-85ca-a3e4c166a28e","timestamp":"2026-11-27T19:44:56.427Z","tool_use_result":{"stdout":"package pool\n\nimport \"time\"\n\n// Candidate is one job a loop would like to start.\ntype Candidate struct {\n\tClass Class\n\t// Role is the role directory name, e.g. \"lead\", \"security-review\", \"cve\".\n\tRole string\n\t// Number is the issue (triage, worker) or PR (review) number, and 0 for\n\t// scanner runs. Negative numbers are allowed (dry-run synthetic issues).\n\tNumber int\n\t// Since is when the job became eligible; required. Triage and worker use\n\t// the issue's created_at, reviewers the PR's created_at, and a scanner run\n\t// the time it became due (last run plus interval).\n\tSince time.Time\n\t// Priority orders candidates within a class: 0 (ard:p0) first, 3 last.\n\t// The zero value is P0, so callers must set it; labels.Priority returns 2\n\t// for an unlabelled item, and scanner runs use 2.\n\tPriority int\n}\n\n// Key returns KeyFor(c.Class, c.Role, c.Number); callers never build keys by hand.\nfunc (c Candidate) Key() string { return KeyFor(c.Class, c.Role, c.Number) }\n\n// invalid returns the first rule the candidate breaks, or \"\".\nfunc (c Candidate) invalid() string {\n\tswitch {\n\tcase !c.Class.valid():\n\t\treturn \"unknown class \" + c.Class.String()\n\tcase c.Role == \"\":\n\t\treturn \"empty role\"\n\tcase c.Since.IsZero():\n\t\treturn \"zero Since\"\n\tcase c.Class == ClassScanner && c.Number != 0:\n\t\treturn \"scanner candidate must have number 0\"\n\tcase c.Class != ClassScanner && c.Number == 0:\n\t\treturn c.Class.String() + \" candidate must have a non-zero number\"\n\t}\n\treturn \"\"\n}\n\n// less is a total order on distinct keys: class, then Priority (lower first), then oldest Since, then\n// lower Number, then Role. It does not depend on input order.\nfunc less(a, b Candidate) bool {\n\tif a.Class != b.Class {\n\t\treturn a.Class < b.Class\n\t}\n\tif a.Priority != b.Priority {\n\t\treturn a.Priority < b.Priority\n\t}\n\tif !a.Since.Equal(b.Since) {\n\t\treturn a.Since.Before(b.Since)\n\t}\n\tif a.Number != b.Number {\n\t\treturn a.Number < b.Number\n\t}\n\treturn a.Role < b.Role\n}\npackage pool\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"io\"\n\t\"log/slog\"\n\t\"sort\"\n\t\"sync\"\n\t\"time\"\n)\n\n// Verdict is the pool's answer for one candidate.\ntype Verdict int\n\n// Verdicts. Anything other than Granted means the loop touches no label and\n// writes no state; the candidate is offered again next tick.\nconst (\n\tGranted         Verdict = iota\n\tDeniedFull              // no slot was free for it, and no other loop reserved one\n\tDeniedOutranked         // higher-ranked live demand from another loop reserved the free slots\n\tDeniedIssueBusy         // triage only: a triage job on the same issue is held or granted earlier in the batch\n\tDeniedDuplicate         // same key already held, or earlier in this batch\n\tDeniedInvalid           // malformed candidate (caller bug)\n\tDeniedLimited           // its account or model family is out of quota until a reset time\n\tDeniedBudget            // a daily dollar or token cap is reached\n)\n\nvar verdictNames = [...]string{\"granted\", \"full\", \"outranked\", \"issue-busy\", \"duplicate\", \"invalid\", \"limited\", \"budget\"}\n\n// String returns the verdict's log name.\nfunc (v Verdict) String() string {\n\tif v >= 0 && int(v) < len(verdictNames) {\n\t\treturn verdictNames[v]\n\t}\n\treturn fmt.Sprintf(\"verdict(%d)\", int(v))\n}\n\n// Decision is the result for one offered candidate.\ntype Decision struct {\n\tCandidate Candidate\n\tVerdict   Verdict\n\tSlot      *Slot  // non-nil if and only if Verdict == Granted\n\tReason    string // human-readable, for logs and the status issue\n}\n\n// Held is a job already running when the pool is built (restart recovery).\ntype Held struct {\n\tCandidate Candidate\n\tJobID     string\n}\n\n// Options configures New.\ntype Options struct {\n\tMax         int              // cfg.MaxPods; values < 1 are treated as 1\n\tNow         func() time.Time // nil means time.Now\n\tLog         *slog.Logger     // nil means discard\n\tHeld        []Held           // running jobs from state; held even if they exceed Max\n\tStarveAfter time.Duration    // 0 means 24h\n\t// Limited reports when a candidate may next start because its account or\n\t// model family is out of quota: zero or a past time means it may start\n\t// now. nil disables the check. A limited candidate takes no slot and\n\t// reserves no demand: it does not hold lower classes back.\n\tLimited func(c Candidate) time.Time\n\t// Budget reports whether a daily dollar or token cap forbids starting c, with the\n\t// reason. nil disables the check. A refused candidate takes no slot and\n\t// reserves no demand; a job already held is never affected.\n\tBudget func(c Candidate) (denied bool, reason string)\n}\n\n// Pool is the in-memory slot arbiter. One mutex guards all state; there are\n// no goroutines or timers, and demand expiry is evaluated lazily.\ntype Pool struct {\n\tmu          sync.Mutex\n\tmax         int\n\tnow         func() time.Time\n\tlog         *slog.Logger\n\tstarveAfter time.Duration\n\tlimited     func(c Candidate) time.Time\n\tbudget      func(c Candidate) (bool, string)\n\theld        map[string]*Slot\n\tdemand      map[string]*loopDemand\n\tfirstDenied map[string]time.Time\n\tstarved     map[Class]bool\n\trefused     map[refusalKey]*refusal\n\tfreed       chan struct{}\n}\n\n// New builds a pool, adopting o.Held.\nfunc New(o Options) *Pool {\n\tp := &Pool{\n\t\tmax:         max(1, o.Max),\n\t\tnow:         o.Now,\n\t\tlog:         o.Log,\n\t\tstarveAfter: o.StarveAfter,\n\t\tlimited:     o.Limited,\n\t\tbudget:      o.Budget,\n\t\theld:        map[string]*Slot{},\n\t\tdemand:      map[string]*loopDemand{},\n\t\tfirstDenied: map[string]time.Time{},\n\t\tstarved:     map[Class]bool{},\n\t\trefused:     map[refusalKey]*refusal{},\n\t\tfreed:       make(chan struct{}, 1),\n\t}\n\tif p.now == nil {\n\t\tp.now = time.Now\n\t}\n\tif p.log == nil {\n\t\tp.log = slog.New(slog.NewTextHandler(io.Discard, nil))\n\t}\n\tif p.starveAfter == 0 {\n\t\tp.starveAfter = 24 * time.Hour\n\t}\n\tfor _, h := range o.Held {\n\t\tk := h.Candidate.Key()\n\t\tif p.held[k] != nil {\n\t\t\tp.log.Warn(\"pool.adopt_duplicate\", \"key\", k, \"job_id\", h.JobID)\n\t\t\tcontinue\n\t\t}\n\t\tp.held[k] = &Slot{pool: p, cand: h.Candidate, jobID: h.JobID, grantedAt: p.now(), adopted: true}\n\t}\n\tif len(p.held) > p.max {\n\t\tp.log.Warn(\"pool.adopt_over_max\", \"held\", len(p.held), \"max\", p.max)\n\t}\n\treturn p\n}\n\n// SetMax changes the cap. It never revokes held slots; n < 1 is treated as 1.\nfunc (p *Pool) SetMax(n int) {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\told := p.max\n\tp.max = max(1, n)\n\tif p.max > old {\n\t\tp.signalLocked()\n\t}\n}\n\n// Freed returns a channel that receives when a slot is released or the cap is\n// raised. It is buffered with one place and sent to without blocking, so\n// several releases coalesce into one pending signal.\nfunc (p *Pool) Freed() <-chan struct{} { return p.freed }\n\nfunc (p *Pool) signalLocked() {\n\tselect {\n\tcase p.freed <- struct{}{}:\n\tdefault:\n\t}\n}\n\n// Lookup returns the held slot for key, for close-out and the Reaper after a restart.\nfunc (p *Pool) Lookup(key string) (*Slot, bool) {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\ts, ok := p.held[key]\n\treturn s, ok\n}\n\ntype item struct {\n\tcand Candidate\n\tidx  int // index into decisions; -1 for foreign demand\n}\n\n// Offer ranks cands against held slots and other loops' live demand and\n// returns one Decision per candidate, in input order. It replaces loop's\n// demand entry, which expires ttl after this call (ttl <= 0 records none).\n// Loops must call Offer once per tick even with no candidates, so stale\n// demand clears.\nfunc (p *Pool) Offer(loop string, ttl time.Duration, cands []Candidate) []Decision {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\tnow := p.now()\n\tp.purgeLocked(now)\n\n\tfree0 := max(0, p.max-len(p.held))\n\tfree := free0\n\tdecisions := make([]Decision, len(cands))\n\ttriageHeld := map[int]bool{}\n\tfor _, s := range p.held {\n\t\tif s.cand.Class == ClassTriage {\n\t\t\ttriageHeld[s.cand.Number] = true\n\t\t}\n\t}\n\n\t// Validation and duplicates.\n\tinBatch := map[string]bool{}\n\tvar items []item\n\tfor i, c := range cands {\n\t\tdecisions[i].Candidate = c\n\t\tif why := c.invalid(); why != \"\" {\n\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedInvalid, why\n\t\t\tp.log.Warn(\"pool.invalid\", \"loop\", loop, \"class\", c.Class.String(), \"role\", c.Role, \"number\", c.Number, \"reason\", why)\n\t\t\tcontinue\n\t\t}\n\t\tk := c.Key()\n\t\tif p.held[k] != nil || inBatch[k] {\n\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedDuplicate, \"already held or offered earlier in this batch\"\n\t\t\tcontinue\n\t\t}\n\t\tif p.limited != nil {\n\t\t\tif until := p.limited(c); now.Before(until) {\n\t\t\t\tdecisions[i].Verdict = DeniedLimited\n\t\t\t\tdecisions[i].Reason = \"usage limit until \" + until.UTC().Format(\"15:04\") + \" UTC\"\n\t\t\t\tp.noteRefusalLocked(c, DeniedLimited, now)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tif p.budget != nil {\n\t\t\tif denied, why := p.budget(c); denied {\n\t\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedBudget, why\n\t\t\t\tp.noteRefusalLocked(c, DeniedBudget, now)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tinBatch[k] = true\n\t\titems = append(items, item{c, i})\n\t}\n\tfor _, c := range p.foreignLocked(loop, now, inBatch, triageHeld) {\n\t\titems = append(items, item{c, -1})\n\t}\n\tsort.Slice(items, func(a, b int) bool { return less(items[a].cand, items[b].cand) })\n\n\t// Walk the merged ranking.\n\treserved := 0\n\ttriageGranted := map[int]bool{}\n\tvar denied []Candidate\n\tcapDenied := 0\n\tfor _, it := range items {\n\t\tif it.idx < 0 {\n\t\t\tif free > 0 {\n\t\t\t\tfree--\n\t\t\t\treserved++\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\td := &decisions[it.idx]\n\t\tc := it.cand\n\t\tswitch {\n\t\tcase c.Class == ClassTriage && (triageHeld[c.Number] || triageGranted[c.Number]):\n\t\t\td.Verdict, d.Reason = DeniedIssueBusy, fmt.Sprintf(\"a triage job on #%d is already held\", c.Number)\n\t\tcase free > 0:\n\t\t\tfree--\n\t\t\ts := &Slot{pool: p, cand: c, grantedAt: now}\n\t\t\tp.held[c.Key()] = s\n\t\t\tif c.Class == ClassTriage {\n\t\t\t\ttriageGranted[c.Number] = true\n\t\t\t}\n\t\t\tdelete(p.firstDenied, c.Key())\n\t\t\td.Verdict, d.Slot = Granted, s\n\t\t\tp.log.Debug(\"pool.grant\", \"loop\", loop, \"key\", c.Key(), \"class\", c.Class.String(), \"role\", c.Role, \"number\", c.Number)\n\t\tcase capDenied < reserved:\n\t\t\tcapDenied++\n\t\t\td.Verdict, d.Reason = DeniedOutranked, fmt.Sprintf(\"outranked by %d higher-ranked waiting job(s)\", reserved)\n\t\t\tdenied = append(denied, c)\n\t\tdefault:\n\t\t\tcapDenied++\n\t\t\td.Verdict, d.Reason = DeniedFull, \"no free slot\"\n\t\t\tdenied = append(denied, c)\n\t\t}\n\t}\n\tp.setDemandLocked(loop, now, ttl, denied)\n\tp.checkStarvationLocked(now)\n\n\tif p.log.Enabled(context.Background(), slog.LevelDebug) {\n\t\tcounts := map[string]int{}\n\t\tfor _, d := range decisions {\n\t\t\tcounts[d.Verdict.String()]++\n\t\t}\n\t\tp.log.Debug(\"pool.offer\", \"loop\", loop, \"verdicts\", fmt.Sprint(counts), \"free_before\", free0, \"free_after\", max(0, p.max-len(p.held)))\n\t}\n\treturn decisions\n}\npackage servecmd\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/agent\"\n\t\"github.com/albertcbrown/ard/internal/agent/claude\"\n\t\"github.com/albertcbrown/ard/internal/closeout\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n\t\"github.com/albertcbrown/ard/internal/executor\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n\t\"github.com/albertcbrown/ard/internal/limits\"\n\t\"github.com/albertcbrown/ard/internal/pool\"\n\t\"github.com/albertcbrown/ard/internal/reaper\"\n\t\"github.com/albertcbrown/ard/internal/redact\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// cfgRoles answers close-out's role questions from the latest loaded config.\ntype cfgRoles struct{ w *wiring }\n\nfunc (c cfgRoles) Role(k config.Kind, name string) (config.Role, bool) {\n\tcfg := c.w.cfg.Load()\n\tif cfg == nil {\n\t\treturn config.Role{}, false\n\t}\n\treturn cfg.Role(k, name)\n}\n\n// gitleaksOptions reports whether the optional gitleaks pass is enabled in the\n// latest loaded config, and which binary to run.\nfunc (w *wiring) gitleaksOptions() (redact.GitleaksOptions, bool) {\n\tcfg := w.cfg.Load()\n\tif cfg == nil || !cfg.Redact.Gitleaks.Enabled {\n\t\treturn redact.GitleaksOptions{}, false\n\t}\n\treturn redact.GitleaksOptions{Path: cfg.Redact.Gitleaks.Path}, true\n}\n\n// closer returns the one *closeout.Closer of this process. The triage, worker\n// and reviewer loops and the Reaper share it: its per-job busy lock only\n// serialises close-outs within one instance.\nfunc (w *wiring) closer() *closeout.Closer {\n\tw.initMu.Lock()\n\tdefer w.initMu.Unlock()\n\tif w.cl != nil {\n\t\treturn w.cl\n\t}\n\tstaging := filepath.Join(w.StateDir, \"closeout\")\n\tif w.StateDir == \"\" {\n\t\tstaging = filepath.Join(w.ardRoot(), \"closeout\")\n\t}\n\tvar getPR func(context.Context, int) (github.PullRequest, error)\n\tif w.Reader != nil {\n\t\tgetPR = w.Reader.GetPR\n\t}\n\t// Network switches the network bounce (#385) on: a needs-network worker is\n\t// sent to the triage engineer, which re-arms the lead (#386).\n\tw.cl = closeout.New(closeout.Deps{\n\t\tEffects: w.Effects, Comments: w.Reader, Committer: closeoutCommitter{w}, Store: w.Store,\n\t\tRoles: cfgRoles{w}, Network: w.Store,\n\t\t// The job's model credentials are in the controller's environment.\n\t\t// Host paths are replaced by placeholders in the same pass.\n\t\tNewRedactor: closeout.JobRedactor(w.environ, w.hostPaths(), w.gitleaksOptions),\n\t\t// Job worktrees belong to the agent: git runs in the controller's own\n\t\t// clone (w.Root) and never trusts a worktree's .git, index or config.\n\t\tChanged: func(ctx context.Context, worktree, base string, paths ...string) ([]gitx.PathChange, error) {\n\t\t\treturn gitx.New(\"\").ChangedSince(ctx, w.Root, worktree, base, paths...)\n\t\t},\n\t\tBaseFile: func(ctx context.Context, _, rev, path string, maxBytes int64) ([]byte, bool, error) {\n\t\t\treturn gitx.New(\"\").FileAt(ctx, w.Root, rev, path, maxBytes)\n\t\t},\n\t\tPR:         getPR,\n\t\tRepo:       w.Repo,\n\t\tStagingDir: staging,\n\t\tLog:        w.Log,\n\t\tWake:       w.wakeLoops,\n\t})\n\treturn w.cl\n}\n\n// reaperParts builds, once, the Finisher and Reaper that every loop shares.\nfunc (w *wiring) reaperParts() (*reaper.Finisher, *reaper.Reaper, error) {\n\tw.initMu.Lock()\n\tif w.fin != nil {\n\t\tdefer w.initMu.Unlock()\n\t\treturn w.fin, w.rp, nil\n\t}\n\tw.initMu.Unlock()\n\tex, err := w.newExecutor()\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\tcl := w.closer()\n\tw.initMu.Lock()\n\tdefer w.initMu.Unlock()\n\tif w.fin != nil {\n\t\treturn w.fin, w.rp, nil\n\t}\n\tstarted := w.Started\n\tif started.IsZero() {\n\t\tstarted = time.Now()\n\t}\n\t// With no credential Auth is \"\": only the rate_limit_event and limit-message\n\t// signals count as a usage limit.\n\tw.fin = &reaper.Finisher{Closer: cl, Cleaner: ex, Store: w.Store, Start: started, Log: w.Log,\n\t\tClassify: reaper.UsageLimitClassifier(w.Model.Auth), Limits: lazyLimits{w}, Readings: readingObserver{w}}\n\tw.rp = reaper.New(reaper.Deps{\n\t\tStore: w.Store, Executor: ex, Finisher: w.fin, Closer: cl,\n\t\tPool:   func() reaper.Lookup { return w.Pool() },\n\t\tReader: w.Reader, Effects: w.Effects, Parse: w.parseFunc(), Log: w.Log,\n\t})\n\treturn w.fin, w.rp, nil\n}\n\n// lazyLimits is the Finisher's LimitRecorder. The book opens on first use (the\n// closeout-resume hook opens it at startup and fails serve on a read error), so\n// building the Finisher needs no state store.\ntype lazyLimits struct{ w *wiring }\n\nfunc (l lazyLimits) Exhaust(ctx context.Context, family string, resetsAt time.Time) (time.Time, error) {\n\tb, err := l.w.limitsBook(ctx)\n\tif err != nil {\n\t\treturn time.Time{}, err\n\t}\n\treturn b.Exhaust(ctx, family, resetsAt)\n}\n\nfunc (l lazyLimits) Succeeded(ctx context.Context, family string) error {\n\tb, err := l.w.limitsBook(ctx)\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn b.Succeeded(ctx, family)\n}\n\n// limitsBook returns the one limits book of this process, opened on first use.\n// An open error is a real store read failure (a corrupt value only logs), so\n// it is returned and not cached.\nfunc (w *wiring) limitsBook(ctx context.Context) (*limits.Book, error) {\n\tw.initMu.Lock()\n\tdefer w.initMu.Unlock()\n\tif w.lim != nil {\n\t\treturn w.lim, nil\n\t}\n\tb, err := limits.Open(ctx, w.Store, time.Now, w.Log)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"serve: %w\", err)\n\t}\n\tw.lim = b\n\treturn b, nil\n}\n\n// limitedFor is the pool's Options.Limited: when a candidate may next start\n// given the usage limits recorded so far. Deterministic scanners use no model\n// and are never limited. A role missing from the config is never offered, so\n// it is not limited either.\nfunc (w *wiring) limitedFor(c pool.Candidate) time.Time {\n\tvar kind config.Kind\n\tswitch c.Class {\n\tcase pool.ClassScanner:\n\t\tkind = config.KindScanner\n\tcase pool.ClassTriage:\n\t\tkind = config.KindTriage\n\tcase pool.ClassWorker:\n\t\tkind = config.KindWorker\n\tcase pool.ClassReview:\n\t\tkind = config.KindReviewer\n\tdefault:\n\t\treturn time.Time{}\n\t}\n\tcfg := w.cfg.Load()\n\tif cfg == nil {\n\t\treturn time.Time{}\n\t}\n\trole, ok := cfg.Role(kind, c.Role)\n\tif !ok || (kind == config.KindScanner && role.ScanPath != \"\") {\n\t\treturn time.Time{}\n\t}\n\tw.initMu.Lock()\n\tbook := w.lim\n\tw.initMu.Unlock()\n\tif book == nil {\n\t\treturn time.Time{}\n\t}\n\treturn book.Until(limits.FamilyOf(role.Model))\n}\n\n// finisher returns the shared Finisher the loops call when a job's process\n// has stopped (see package reaper for the contract).\nfunc (w *wiring) finisher() (*reaper.Finisher, error) {\n\tf, _, err := w.reaperParts()\n\treturn f, err\n}\n\n// reaperLoop returns the Reaper loop, or nil when the executor cannot be built.\nfunc reaperLoop(w *wiring) controller.Loop {\n\t_, r, err := w.reaperParts()\n\tif err != nil {\n\t\tw.Log.Error(\"reaper.executor_unavailable\", \"error\", err)\n\t\treturn nil\n\t}\n\treturn r\n}\n\n// resumeCloseouts is the closeout-resume startup hook. It runs before the pool\n// is adopted, so it never touches the pool.\nfunc (w *wiring) resumeCloseouts(ctx context.Context) error {\n\t// A store that cannot be read means state is broken: fail startup.\n\tif _, err := w.limitsBook(ctx); err != nil {\n\t\treturn fmt.Errorf(\"closeout-resume: %w\", err)\n\t}\n\t_, r, err := w.reaperParts()\n\tif err != nil {\n\t\t// Without an executor nothing runs jobs either; do not keep serve down.\n\t\tw.Log.Error(\"reaper.resume_skipped\", \"error\", err)\n\t\treturn nil\n\t}\n\treturn r.ResumeAll(ctx)\n}\n\n// parseFunc reads a job's agent result from its stdout log, with the adapter\n// its role is configured for.\nfunc (w *wiring) parseFunc() reaper.ParseFunc {\n\treg, err := agent.NewRegistry(claude.New(claude.Options{}))\n\tif err != nil {\n\t\tpanic(err) // a duplicate adapter name is a programming error\n\t}\n\treturn func(ctx context.Context, cfg *config.Resolved, sj state.Job, h executor.Handle, exitCode int) (agent.Result, error) {\n\t\tif cfg == nil {\n\t\t\treturn agent.Result{}, errors.New(\"no config loaded\")\n\t\t}\n\t\tvar kind config.Kind\n\t\tswitch sj.Stage {\n\t\tcase closeout.StageTriage:\n\t\t\tkind = config.KindTriage\n\t\tcase closeout.StageWorker:\n\t\t\tkind = config.KindWorker\n\t\tcase closeout.StageReview:\n\t\t\tkind = config.KindReviewer\n\t\tdefault:\n\t\t\treturn agent.Result{}, fmt.Errorf(\"stage %q has no agent\", sj.Stage)\n\t\t}\n\t\trole, ok := cfg.Role(kind, sj.Role)\n\t\tif !ok {\n\t\t\treturn agent.Result{}, fmt.Errorf(\"role %s/%s is not configured\", kind, sj.Role)\n\t\t}\n\t\ta, err := reg.Get(role.Agent)\n\t\tif err != nil {\n\t\t\treturn agent.Result{}, err\n\t\t}\n\t\tif h.StdoutPath == \"\" {\n\t\t\treturn agent.Result{}, errors.New(\"job has no stdout log\")\n\t\t}\n\t\tf, err := os.Open(h.StdoutPath)\n\t\tif err != nil {\n\t\t\treturn agent.Result{}, fmt.Errorf(\"open stdout log: %w\", err)\n\t\t}\n\t\tdefer f.Close()\n\t\tres, err := a.Parse(f, exitCode)\n\t\tif errors.Is(err, agent.ErrNoResult) {\n\t\t\treturn res, nil // a killed job has no result event: the partial result is the answer\n\t\t}\n\t\treturn res, err\n\t}\n}\n// Package limits is the controller's book of exhausted usage limits: the\n// reactive half of subscription limit handling (#81). When a job stops at a\n// limit, the Reaper's Finisher records it here and the pool starts no agent\n// job for the exhausted account or model family until it resets. Observed\n// readings, thresholds and status comments are #63's.\n//\n// The book is persisted in the controller database's meta table, so a pause\n// survives a restart. It never kills a running job.\npackage limits\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\nconst (\n\t// DefaultPause is the first pause when the CLI gave no reset time.\n\tDefaultPause = 30 * time.Minute\n\t// BackoffCap is the longest pause chosen without a reset time. Each\n\t// further stop with no reset doubles the pause up to this; a job that\n\t// succeeds resets it.\n\tBackoffCap = 4 * time.Hour\n\t// MaxPause clamps a reset time that is far away: a misread unit must not\n\t// block the account for years.\n\tMaxPause = 8 * 24 * time.Hour\n\n\tmetaKey = \"limits.exhausted\"\n)\n\n// Meta is the key-value store the book persists in (*state.Store).\ntype Meta interface {\n\tMeta(ctx context.Context, key string) (string, error) // errors.Is(err, state.ErrNotFound) = empty book\n\tSetMeta(ctx context.Context, key, value string) error\n}\n\n// entry is one exhausted family. Family \"\" is the whole account.\ntype entry struct {\n\tUntil int64 `json:\"until\"`          // Unix seconds\n\tStep  int   `json:\"step,omitempty\"` // consecutive stops with no reset time\n}\n\n// Book records which families are exhausted and until when.\ntype Book struct {\n\tmu       sync.Mutex\n\tentries  map[string]entry\n\treadings map[string]Reading\n\tmeta     Meta\n\tnow      func() time.Time\n\tlog      *slog.Logger\n}\n\n// Open loads the book. A missing key gives an empty book; a malformed value\n// logs WARN limits.corrupt and gives an empty book (the next Exhaust\n// overwrites it). Only a read error from meta is returned.\nfunc Open(ctx context.Context, m Meta, now func() time.Time, log *slog.Logger) (*Book, error) {\n\tif now == nil {\n\t\tnow = time.Now\n\t}\n\tif log == nil {\n\t\tlog = slog.Default()\n\t}\n\tb := &Book{entries: map[string]entry{}, readings: map[string]Reading{}, meta: m, now: now, log: log}\n\tv, err := m.Meta(ctx, metaKey)\n\tswitch {\n\tcase errors.Is(err, state.ErrNotFound):\n\tcase err != nil:\n\t\treturn nil, fmt.Errorf(\"open limits book: %w\", err)\n\tdefault:\n\t\tvar got map[string]entry\n\t\tif err := json.Unmarshal([]byte(v), &got); err