{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U3VWL8jpaezhK4FYXNNybb","type":"tool_result","content":"// Package limits is the controller's book of exhausted usage limits: the\n// reactive half of subscription limit handling (#81). When a job stops at a\n// limit, the Reaper's Finisher records it here and the pool starts no agent\n// job for the exhausted account or model family until it resets. Observed\n// readings, thresholds and status comments are #63's.\n//\n// The book is persisted in the controller database's meta table, so a pause\n// survives a restart. It never kills a running job.\npackage limits\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\nconst (\n\t// DefaultPause is the first pause when the CLI gave no reset time.\n\tDefaultPause = 30 * time.Minute\n\t// BackoffCap is the longest pause chosen without a reset time. Each\n\t// further stop with no reset doubles the pause up to this; a job that\n\t// succeeds resets it.\n\tBackoffCap = 4 * time.Hour\n\t// MaxPause clamps a reset time that is far away: a misread unit must not\n\t// block the account for years.\n\tMaxPause = 8 * 24 * time.Hour\n\n\tmetaKey = \"limits.exhausted\"\n)\n\n// Meta is the key-value store the book persists in (*state.Store).\ntype Meta interface {\n\tMeta(ctx context.Context, key string) (string, error) // errors.Is(err, state.ErrNotFound) = empty book\n\tSetMeta(ctx context.Context, key, value string) error\n}\n\n// entry is one exhausted family. Family \"\" is the whole account.\ntype entry struct {\n\tUntil int64 `json:\"until\"`          // Unix seconds\n\tStep  int   `json:\"step,omitempty\"` // consecutive stops with no reset time\n}\n\n// Book records which families are exhausted and until when.\ntype Book struct {\n\tmu       sync.Mutex\n\tentries  map[string]entry\n\treadings map[string]Reading\n\tmeta     Meta\n\tnow      func() time.Time\n\tlog      *slog.Logger\n}\n\n// Open loads the book. A missing key gives an empty book; a malformed value\n// logs WARN limits.corrupt and gives an empty book (the next Exhaust\n// overwrites it). Only a read error from meta is returned.\nfunc Open(ctx context.Context, m Meta, now func() time.Time, log *slog.Logger) (*Book, error) {\n\tif now == nil {\n\t\tnow = time.Now\n\t}\n\tif log == nil {\n\t\tlog = slog.Default()\n\t}\n\tb := &Book{entries: map[string]entry{}, readings: map[string]Reading{}, meta: m, now: now, log: log}\n\tv, err := m.Meta(ctx, metaKey)\n\tswitch {\n\tcase errors.Is(err, state.ErrNotFound):\n\tcase err != nil:\n\t\treturn nil, fmt.Errorf(\"open limits book: %w\", err)\n\tdefault:\n\t\tvar got map[string]entry\n\t\tif err := json.Unmarshal([]byte(v), &got); err != nil {\n\t\t\tlog.Warn(\"limits.corrupt\", \"error\", err)\n\t\t} else if got != nil {\n\t\t\tb.entries = got\n\t\t}\n\t}\n\tif err := b.loadReadings(ctx); err != nil {\n\t\treturn nil, err\n\t}\n\treturn b, nil\n}\n\nfunc backoff(step int) time.Duration {\n\td := DefaultPause\n\tfor i := 0; i < step && d < BackoffCap; i++ {\n\t\td *= 2\n\t}\n\treturn min(d, BackoffCap)\n}\n\n// Exhaust records that family (or the whole account when \"\") is out of quota\n// and returns the effective time it is blocked until.\n//\n// A resetsAt in the future is used as given, clamped to MaxPause. A zero or\n// past resetsAt means the CLI gave no reset: the pause is DefaultPause, then\n// doubles with each further stop to BackoffCap, but only once the previous\n// pause has run out. A stop recorded while the family is already paused (a job\n// that was running when the limit hit) changes nothing, so Exhaust is\n// idempotent. The later of the old and new times is kept, and the book is\n// persisted before Exhaust returns; on a persist error memory is unchanged.\nfunc (b *Book) Exhaust(ctx context.Context, family string, resetsAt time.Time) (time.Time, error) {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tnow := b.now()\n\told, had := b.entries[family]\n\toldUntil := time.Unix(old.Until, 0)\n\tnext := old\n\tvar until time.Time\n\tswitch {\n\tcase resetsAt.After(now):\n\t\tuntil = resetsAt\n\t\tif limit := now.Add(MaxPause); until.After(limit) {\n\t\t\tuntil = limit\n\t\t}\n\t\tnext.Step = 0\n\tcase had && now.Before(oldUntil):\n\t\tuntil = oldUntil\n\tdefault:\n\t\tuntil = now.Add(backoff(old.Step))\n\t\tnext.Step = old.Step + 1\n\t\tb.log.Info(\"limits.backoff\", \"family\", family, \"step\", next.Step, \"pause\", backoff(old.Step).String(), \"until\", until.UTC())\n\t}\n\tif had && until.Before(oldUntil) {\n\t\tuntil, next = oldUntil, old\n\t}\n\tnext.Until = until.Unix()\n\tupdated := b.pruned(now)\n\tupdated[family] = next\n\tif err := b.persist(ctx, updated); err != nil {\n\t\treturn time.Time{}, err\n\t}\n\tb.entries = updated\n\tif next.Until != old.Until || !had {\n\t\tb.log.Info(\"limits.exhausted\", \"family\", family, \"until\", until.UTC())\n\t}\n\treturn time.Unix(next.Until, 0).UTC(), nil\n}\n\n// Succeeded resets the backoff of family and the whole account after a job\n// ended successfully. It leaves the blocked-until times alone.\nfunc (b *Book) Succeeded(ctx context.Context, family string) error {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tupdated := b.pruned(b.now())\n\tchanged := false\n\tfor k, e := range updated {\n\t\tif e.Step != 0 && (family == \"\" || k == \"\" || k == family) {\n\t\t\te.Step = 0\n\t\t\tupdated[k] = e\n\t\t\tchanged = true\n\t\t}\n\t}\n\tif !changed {\n\t\treturn nil\n\t}\n\tupdated = pruneExpired(updated, b.now())\n\tif err := b.persist(ctx, updated); err != nil {\n\t\treturn err\n\t}\n\tb.entries = updated\n\treturn nil\n}\n\n// pruned copies the entries, dropping those that have expired with no backoff\n// to remember.\nfunc (b *Book) pruned(now time.Time) map[string]entry {\n\treturn pruneExpired(b.entries, now)\n}\n\nfunc pruneExpired(in map[string]entry, now time.Time) map[string]entry {\n\tout := make(map[string]entry, len(in)+1)\n\tfor k, e := range in {\n\t\tif e.Step > 0 || now.Before(time.Unix(e.Until, 0)) {\n\t\t\tout[k] = e\n\t\t}\n\t}\n\treturn out\n}\n\nfunc (b *Book) persist(ctx context.Context, m map[string]entry) error {\n\traw, err := json.Marshal(m)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"encode limits book: %w\", err)\n\t}\n\tif err := b.meta.SetMeta(ctx, metaKey, string(raw)); err != nil {\n\t\treturn fmt.Errorf(\"persist limits book: %w\", err)\n\t}\n\treturn nil\n}\n\n// Until returns the time a role on family may next start, or zero when it may\n// start now. It is the later of the whole-account entry and the family's own.\n// An unknown family (\"\", for example a role on the CLI default model) is\n// blocked by any entry, so it fails closed. Blocked means now is before the\n// returned time; at that time the role is free.\nfunc (b *Book) Until(family string) time.Time {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tnow := b.now()\n\tvar latest time.Time\n\tfor k, e := range b.entries {\n\t\tif family != \"\" && k != \"\" && k != family {\n\t\t\tcontinue\n\t\t}\n\t\tif t := time.Unix(e.Until, 0); now.Before(t) && t.After(latest) {\n\t\t\tlatest = t\n\t\t}\n\t}\n\tif latest.IsZero() {\n\t\treturn latest\n\t}\n\treturn latest.UTC()\n}\n\n// FamilyOf maps a model name to its limit family: \"opus\", \"sonnet\" or\n// \"haiku\" by case-insensitive substring, otherwise \"\".\nfunc FamilyOf(model string) string {\n\tm := strings.ToLower(model)\n\tfor _, f := range []string{\"opus\", \"sonnet\", \"haiku\"} {\n\t\tif strings.Contains(m, f) {\n\t\t\treturn f\n\t\t}\n\t}\n\treturn \"\"\n}\npackage limits\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"sort\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/agent\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\nconst readingsKey = \"limits.readings\"\n\n// maxReadings bounds the persisted readings: a new window type is ignored\n// once the book holds this many.\nconst maxReadings = 16\n\n// Reading is the latest observed usage of one subscription window. Nothing\n// gates on it yet (#63).\ntype Reading struct {\n\tWindow      string    `json:\"window\"`\n\tUtilization float64   `json:\"utilization\"` // as the stream reports it\n\tStatus      string    `json:\"status\"`\n\tResetsAt    time.Time `json:\"resets_at\"`\n\tObservedAt  time.Time `json:\"observed_at\"`\n}\n\n// loadReadings reads the persisted readings; called by Open.\nfunc (b *Book) loadReadings(ctx context.Context) error {\n\tv, err := b.meta.Meta(ctx, readingsKey)\n\tswitch {\n\tcase errors.Is(err, state.ErrNotFound):\n\t\treturn nil\n\tcase err != nil:\n\t\treturn fmt.Errorf(\"open limits readings: %w\", err)\n\t}\n\tvar got map[string]Reading\n\tif err := json.Unmarshal([]byte(v), &got); err != nil {\n\t\tb.log.Warn(\"limits.corrupt\", \"key\", readingsKey, \"error\", err)\n\t\treturn nil\n\t}\n\tif got != nil {\n\t\tb.readings = got\n\t}\n\treturn nil\n}\n\n// Observe records the latest reading of each window in ws, stamped with the\n// book's clock, and persists them. A window whose reading is unchanged is\n// skipped, so observing the same step twice neither logs nor writes twice.\n// A new window type is ignored once the book holds 16. An empty ws is a no-op. On a persist error memory is unchanged.\nfunc (b *Book) Observe(ctx context.Context, ws []agent.Window) error {\n\tif len(ws) == 0 {\n\t\treturn nil\n\t}\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tnow := b.now().UTC()\n\tnext := make(map[string]Reading, len(b.readings)+len(ws))\n\tfor k, r := range b.readings {\n\t\tnext[k] = r\n\t}\n\tvar changed []Reading\n\tfor _, w := range ws {\n\t\tr := Reading{Window: w.Type, Utilization: w.Utilization, Status: w.Status, ResetsAt: w.ResetsAt.UTC(), ObservedAt: now}\n\t\told, ok := next[w.Type]\n\t\tif !ok && len(next) >= maxReadings {\n\t\t\tcontinue\n\t\t}\n\t\tif ok && old.Utilization == r.Utilization && old.Status == r.Status && old.ResetsAt.Equal(r.ResetsAt) {\n\t\t\tcontinue\n\t\t}\n\t\tnext[w.Type] = r\n\t\tchanged = append(changed, r)\n\t}\n\tif len(changed) == 0 {\n\t\treturn nil\n\t}\n\traw, err := json.Marshal(next)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"encode limits readings: %w\", err)\n\t}\n\tif err := b.meta.SetMeta(ctx, readingsKey, string(raw)); err != nil {\n\t\treturn fmt.Errorf(\"persist limits readings: %w\", err)\n\t}\n\tb.readings = next\n\tfor _, r := range changed {\n\t\tb.log.Info(\"limits.reading\", \"window\", r.Window, \"utilization\", r.Utilization, \"status\", r.Status, \"resets_at\", r.ResetsAt)\n\t}\n\treturn nil\n}\n\n// Readings returns a copy of the latest reading per window, sorted by window.\nfunc (b *Book) Readings() []Reading {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tout := make([]Reading, 0, len(b.readings))\n\tfor _, r := range b.readings {\n\t\tout = append(out, r)\n\t}\n\tsort.Slice(out, func(i, j int) bool { return out[i].Window < out[j].Window })\n\treturn out\n}\npackage pool\n\nimport \"time\"\n\n// Candidate is one job a loop would like to start.\ntype Candidate struct {\n\tClass Class\n\t// Role is the role directory name, e.g. \"lead\", \"security-review\", \"cve\".\n\tRole string\n\t// Number is the issue (triage, worker) or PR (review) number, and 0 for\n\t// scanner runs. Negative numbers are allowed (dry-run synthetic issues).\n\tNumber int\n\t// Since is when the job became eligible; required. Triage and worker use\n\t// the issue's created_at, reviewers the PR's created_at, and a scanner run\n\t// the time it became due (last run plus interval).\n\tSince time.Time\n\t// Priority orders candidates within a class: 0 (ard:p0) first, 3 last.\n\t// The zero value is P0, so callers must set it; labels.Priority returns 2\n\t// for an unlabelled item, and scanner runs use 2.\n\tPriority int\n}\n\n// Key returns KeyFor(c.Class, c.Role, c.Number); callers never build keys by hand.\nfunc (c Candidate) Key() string { return KeyFor(c.Class, c.Role, c.Number) }\n\n// invalid returns the first rule the candidate breaks, or \"\".\nfunc (c Candidate) invalid() string {\n\tswitch {\n\tcase !c.Class.valid():\n\t\treturn \"unknown class \" + c.Class.String()\n\tcase c.Role == \"\":\n\t\treturn \"empty role\"\n\tcase c.Since.IsZero():\n\t\treturn \"zero Since\"\n\tcase c.Class == ClassScanner && c.Number != 0:\n\t\treturn \"scanner candidate must have number 0\"\n\tcase c.Class != ClassScanner && c.Number == 0:\n\t\treturn c.Class.String() + \" candidate must have a non-zero number\"\n\t}\n\treturn \"\"\n}\n\n// less is a total order on distinct keys: class, then Priority (lower first), then oldest Since, then\n// lower Number, then Role. It does not depend on input order.\nfunc less(a, b Candidate) bool {\n\tif a.Class != b.Class {\n\t\treturn a.Class < b.Class\n\t}\n\tif a.Priority != b.Priority {\n\t\treturn a.Priority < b.Priority\n\t}\n\tif !a.Since.Equal(b.Since) {\n\t\treturn a.Since.Before(b.Since)\n\t}\n\tif a.Number != b.Number {\n\t\treturn a.Number < b.Number\n\t}\n\treturn a.Role < b.Role\n}\n\tif w.lim != nil {\n\t\treturn w.lim, nil\n\t}\n\tb, err := limits.Open(ctx, w.Store, time.Now, w.Log)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"serve: %w\", err)\n\t}\n\tw.lim = b\n\treturn b, nil\n}\n\n// limitedFor is the pool's Options.Limited: when a candidate may next start\n// given the usage limits recorded so far. Deterministic scanners use no model\n// and are never limited. A role missing from the config is never offered, so\n// it is not limited either.\nfunc (w *wiring) limitedFor(c pool.Candidate) time.Time {\n\tvar kind config.Kind\n\tswitch c.Class {\n\tcase pool.ClassScanner:\n\t\tkind = config.KindScanner\n\tcase pool.ClassTriage:\n\t\tkind = config.KindTriage\n\tcase pool.ClassWorker:\n\t\tkind = config.KindWorker\n\tcase pool.ClassReview:\n\t\tkind = config.KindReviewer\n\tdefault:\n\t\treturn time.Time{}\n\t}\n\tcfg := w.cfg.Load()\n\tif cfg == nil {\n\t\treturn time.Time{}\n\t}\n\trole, ok := cfg.Role(kind, c.Role)\n\tif !ok || (kind == config.KindScanner && role.ScanPath != \"\") {\n\t\treturn time.Time{}\n\t}\n\tw.initMu.Lock()\n\tbook := w.lim\n\tw.initMu.Unlock()\n\tif book == nil {\n\t\treturn time.Time{}\n\t}\n\treturn book.Until(limits.FamilyOf(role.Model))\n}\n\n// finisher returns the shared Finisher the loops call when a job's process\n// has stopped (see package reaper for the contract).\nfunc (w *wiring) finisher() (*reaper.Finisher, error) {\n\tf, _, err := w.reaperParts()\n\treturn f, err\n}\n\n// reaperLoop returns the Reaper loop, or nil when the executor cannot be built.\nfunc reaperLoop(w *wiring) controller.Loop {\n\t_, r, err := w.reaperParts()\n\tif err != nil {\n\t\tw.Log.Error(\"reaper.executor_unavailable\", \"error\", err)\n\t\treturn nil\n\t}\n\treturn r\n}\n\n// resumeCloseouts is the closeout-resume startup hook. It runs before the pool\n// is adopted, so it never touches the pool.\nfunc (w *wiring) resumeCloseouts(ctx context.Context) error {\n\t// A store that cannot be read means state is broken: fail startup.\n\tif _, err := w.limitsBook(ctx); err != nil {\n\t\treturn fmt.Errorf(\"closeout-resume: %w\", err)\n\t}\n\t_, r, err := w.reaperParts()\n\tif err != nil {\n\t\t// Without an executor nothing runs jobs either; do not keep serve down.\n\t\tw.Log.Error(\"reaper.resume_skipped\", \"error\", err)\n\t\treturn nil\n\t}\n\treturn r.ResumeAll(ctx)\n}\n\n// parseFunc reads a job's agent result from its stdout log, with the adapter\n// its role is configured for.\npackage servecmd\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/agent\"\n\t\"github.com/albertcbrown/ard/internal/agent/claude\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/limits\"\n\t\"github.com/albertcbrown/ard/internal/modelauth\"\n\t\"github.com/albertcbrown/ard/internal/pool\"\n\t\"github.com/albertcbrown/ard/internal/reaper\"\n)\n\ntype fakeClock struct{ t time.Time }\n\nfunc (c *fakeClock) now() time.Time { return c.t }\n\nvar limitT0 = time.Date(2026, 11, 22, 12, 0, 0, 0, time.UTC)\n\nfunc limitWiring(t *testing.T, clk *fakeClock) *wiring {\n\tt.Helper()\n\tw := newTestWiring(t)\n\tbook, err := limits.Open(context.Background(), w.Store, clk.now, w.Log)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tw.lim = book\n\tw.cfg.Store(&config.Resolved{Roles: []config.Role{\n\t\t{Kind: config.KindScanner, Name: \"cve\", ScanPath: \"roles/scanner/cve/scan\"},\n\t\t{Kind: config.KindScanner, Name: \"llm-scan\"},\n\t\t{Kind: config.KindTriage, Name: \"lead\"},\n\t\t{Kind: config.KindWorker, Name: \"engineer\", Model: \"claude-opus-4-1\"},\n\t\t{Kind: config.KindReviewer, Name: \"sec\", Model: \"sonnet\"},\n\t}})\n\treturn w\n}\n\nfunc cand(c pool.Class, role string, n int) pool.Candidate {\n\treturn pool.Candidate{Class: c, Role: role, Number: n, Since: limitT0.Add(-time.Hour)}\n}\n\nfunc TestLimitedFor(t *testing.T) {\n\tclk := &fakeClock{limitT0}\n\tw := limitWiring(t, clk)\n\tuntil, err := w.lim.Exhaust(context.Background(), \"opus\", limitT0.Add(time.Hour))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\ttests := []struct {\n\t\tname string\n\t\tc    pool.Candidate\n\t\twant time.Time\n\t}{\n\t\t{\"deterministic scanner is never limited\", cand(pool.ClassScanner, \"cve\", 0), time.Time{}},\ninternal/servecmd/adopt.go:52:\t\t\tCandidate: pool.Candidate{Class: class, Role: j.Role, Number: n, Since: j.CreatedAt},\ninternal/servecmd/adopt.go:63:func adoptPool(ctx context.Context, l jobLister, maxPods int, log *slog.Logger, limited func(pool.Candidate) time.Time, budget func(pool.Candidate) (bool, string)) (*pool.Pool, error) {\ninternal/servecmd/reaping.go:165:func (w *wiring) limitedFor(c pool.Candidate) time.Time {\ninternal/pool/pool.go:41:\tCandidate Candidate\ninternal/pool/pool.go:49:\tCandidate Candidate\ninternal/pool/pool.go:64:\tLimited func(c Candidate) time.Time\ninternal/pool/pool.go:68:\tBudget func(c Candidate) (denied bool, reason string)\ninternal/pool/pool.go:79:\tlimited     func(c Candidate) time.Time\ninternal/pool/pool.go:80:\tbudget      func(c Candidate) (bool, string)\ninternal/pool/pool.go:115:\t\tk := h.Candidate.Key()\ninternal/pool/pool.go:120:\t\tp.held[k] = &Slot{pool: p, cand: h.Candidate, jobID: h.JobID, grantedAt: p.now(), adopted: true}\ninternal/pool/pool.go:160:\tcand Candidate\ninternal/pool/pool.go:169:func (p *Pool) Offer(loop string, ttl time.Duration, cands []Candidate) []Decision {\ninternal/pool/pool.go:189:\t\tdecisions[i].Candidate = c\ninternal/pool/pool.go:226:\tvar denied []Candidate\nTODO.md\nlayout.md\nproposal.md\nrunbooks\nsite\n309:## Executors and the Reaper","is_error":false}]},"parent_tool_use_id":null,"session_id":"748a3d80-7d7b-4b04-ada8-d4203eb53dab","uuid":"1c008ea4-8f96-4cef-942f-a686f9da94b6","timestamp":"2026-11-26T19:02:02.889Z","tool_use_result":{"stdout":"// Package limits is the controller's book of exhausted usage limits: the\n// reactive half of subscription limit handling (#81). When a job stops at a\n// limit, the Reaper's Finisher records it here and the pool starts no agent\n// job for the exhausted account or model family until it resets. Observed\n// readings, thresholds and status comments are #63's.\n//\n// The book is persisted in the controller database's meta table, so a pause\n// survives a restart. It never kills a running job.\npackage limits\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\nconst (\n\t// DefaultPause is the first pause when the CLI gave no reset time.\n\tDefaultPause = 30 * time.Minute\n\t// BackoffCap is the longest pause chosen without a reset time. Each\n\t// further stop with no reset doubles the pause up to this; a job that\n\t// succeeds resets it.\n\tBackoffCap = 4 * time.Hour\n\t// MaxPause clamps a reset time that is far away: a misread unit must not\n\t// block the account for years.\n\tMaxPause = 8 * 24 * time.Hour\n\n\tmetaKey = \"limits.exhausted\"\n)\n\n// Meta is the key-value store the book persists in (*state.Store).\ntype Meta interface {\n\tMeta(ctx context.Context, key string) (string, error) // errors.Is(err, state.ErrNotFound) = empty book\n\tSetMeta(ctx context.Context, key, value string) error\n}\n\n// entry is one exhausted family. Family \"\" is the whole account.\ntype entry struct {\n\tUntil int64 `json:\"until\"`          // Unix seconds\n\tStep  int   `json:\"step,omitempty\"` // consecutive stops with no reset time\n}\n\n// Book records which families are exhausted and until when.\ntype Book struct {\n\tmu       sync.Mutex\n\tentries  map[string]entry\n\treadings map[string]Reading\n\tmeta     Meta\n\tnow      func() time.Time\n\tlog      *slog.Logger\n}\n\n// Open loads the book. A missing key gives an empty book; a malformed value\n// logs WARN limits.corrupt and gives an empty book (the next Exhaust\n// overwrites it). Only a read error from meta is returned.\nfunc Open(ctx context.Context, m Meta, now func() time.Time, log *slog.Logger) (*Book, error) {\n\tif now == nil {\n\t\tnow = time.Now\n\t}\n\tif log == nil {\n\t\tlog = slog.Default()\n\t}\n\tb := &Book{entries: map[string]entry{}, readings: map[string]Reading{}, meta: m, now: now, log: log}\n\tv, err := m.Meta(ctx, metaKey)\n\tswitch {\n\tcase errors.Is(err, state.ErrNotFound):\n\tcase err != nil:\n\t\treturn nil, fmt.Errorf(\"open limits book: %w\", err)\n\tdefault:\n\t\tvar got map[string]entry\n\t\tif err := json.Unmarshal([]byte(v), &got); err != nil {\n\t\t\tlog.Warn(\"limits.corrupt\", \"error\", err)\n\t\t} else if got != nil {\n\t\t\tb.entries = got\n\t\t}\n\t}\n\tif err := b.loadReadings(ctx); err != nil {\n\t\treturn nil, err\n\t}\n\treturn b, nil\n}\n\nfunc backoff(step int) time.Duration {\n\td := DefaultPause\n\tfor i := 0; i < step && d < BackoffCap; i++ {\n\t\td *= 2\n\t}\n\treturn min(d, BackoffCap)\n}\n\n// Exhaust records that family (or the whole account when \"\") is out of quota\n// and returns the effective time it is blocked until.\n//\n// A resetsAt in the future is used as given, clamped to MaxPause. A zero or\n// past resetsAt means the CLI gave no reset: the pause is DefaultPause, then\n// doubles with each further stop to BackoffCap, but only once the previous\n// pause has run out. A stop recorded while the family is already paused (a job\n// that was running when the limit hit) changes nothing, so Exhaust is\n// idempotent. The later of the old and new times is kept, and the book is\n// persisted before Exhaust returns; on a persist error memory is unchanged.\nfunc (b *Book) Exhaust(ctx context.Context, family string, resetsAt time.Time) (time.Time, error) {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tnow := b.now()\n\told, had := b.entries[family]\n\toldUntil := time.Unix(old.Until, 0)\n\tnext := old\n\tvar until time.Time\n\tswitch {\n\tcase resetsAt.After(now):\n\t\tuntil = resetsAt\n\t\tif limit := now.Add(MaxPause); until.After(limit) {\n\t\t\tuntil = limit\n\t\t}\n\t\tnext.Step = 0\n\tcase had && now.Before(oldUntil):\n\t\tuntil = oldUntil\n\tdefault:\n\t\tuntil = now.Add(backoff(old.Step))\n\t\tnext.Step = old.Step + 1\n\t\tb.log.Info(\"limits.backoff\", \"family\", family, \"step\", next.Step, \"pause\", backoff(old.Step).String(), \"until\", until.UTC())\n\t}\n\tif had && until.Before(oldUntil) {\n\t\tuntil, next = oldUntil, old\n\t}\n\tnext.Until = until.Unix()\n\tupdated := b.pruned(now)\n\tupdated[family] = next\n\tif err := b.persist(ctx, updated); err != nil {\n\t\treturn time.Time{}, err\n\t}\n\tb.entries = updated\n\tif next.Until != old.Until || !had {\n\t\tb.log.Info(\"limits.exhausted\", \"family\", family, \"until\", until.UTC())\n\t}\n\treturn time.Unix(next.Until, 0).UTC(), nil\n}\n\n// Succeeded resets the backoff of family and the whole account after a job\n// ended successfully. It leaves the blocked-until times alone.\nfunc (b *Book) Succeeded(ctx context.Context, family string) error {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tupdated := b.pruned(b.now())\n\tchanged := false\n\tfor k, e := range updated {\n\t\tif e.Step != 0 && (family == \"\" || k == \"\" || k == family) {\n\t\t\te.Step = 0\n\t\t\tupdated[k] = e\n\t\t\tchanged = true\n\t\t}\n\t}\n\tif !changed {\n\t\treturn nil\n\t}\n\tupdated = pruneExpired(updated, b.now())\n\tif err := b.persist(ctx, updated); err != nil {\n\t\treturn err\n\t}\n\tb.entries = updated\n\treturn nil\n}\n\n// pruned copies the entries, dropping those that have expired with no backoff\n// to remember.\nfunc (b *Book) pruned(now time.Time) map[string]entry {\n\treturn pruneExpired(b.entries, now)\n}\n\nfunc pruneExpired(in map[string]entry, now time.Time) map[string]entry {\n\tout := make(map[string]entry, len(in)+1)\n\tfor k, e := range in {\n\t\tif e.Step > 0 || now.Before(time.Unix(e.Until, 0)) {\n\t\t\tout[k] = e\n\t\t}\n\t}\n\treturn out\n}\n\nfunc (b *Book) persist(ctx context.Context, m map[string]entry) error {\n\traw, err := json.Marshal(m)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"encode limits book: %w\", err)\n\t}\n\tif err := b.meta.SetMeta(ctx, metaKey, string(raw)); err != nil {\n\t\treturn fmt.Errorf(\"persist limits book: %w\", err)\n\t}\n\treturn nil\n}\n\n// Until returns the time a role on family may next start, or zero when it may\n// start now. It is the later of the whole-account entry and the family's own.\n// An unknown family (\"\", for example a role on the CLI default model) is\n// blocked by any entry, so it fails closed. Blocked means now is before the\n// returned time; at that time the role is free.\nfunc (b *Book) Until(family string) time.Time {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tnow := b.now()\n\tvar latest time.Time\n\tfor k, e := range b.entries {\n\t\tif family != \"\" && k != \"\" && k != family {\n\t\t\tcontinue\n\t\t}\n\t\tif t := time.Unix(e.Until, 0); now.Before(t) && t.After(latest) {\n\t\t\tlatest = t\n\t\t}\n\t}\n\tif latest.IsZero() {\n\t\treturn latest\n\t}\n\treturn latest.UTC()\n}\n\n// FamilyOf maps a model name to its limit family: \"opus\", \"sonnet\" or\n// \"haiku\" by case-insensitive substring, otherwise \"\".\nfunc FamilyOf(model string) string {\n\tm := strings.ToLower(model)\n\tfor _, f := range []string{\"opus\", \"sonnet\", \"haiku\"} {\n\t\tif strings.Contains(m, f) {\n\t\t\treturn f\n\t\t}\n\t}\n\treturn \"\"\n}\npackage limits\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"sort\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/agent\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\nconst readingsKey = \"limits.readings\"\n\n// maxReadings bounds the persisted readings: a new window type is ignored\n// once the book holds this many.\nconst maxReadings = 16\n\n// Reading is the latest observed usage of one subscription window. Nothing\n// gates on it yet (#63).\ntype Reading struct {\n\tWindow      string    `json:\"window\"`\n\tUtilization float64   `json:\"utilization\"` // as the stream reports it\n\tStatus      string    `json:\"status\"`\n\tResetsAt    time.Time `json:\"resets_at\"`\n\tObservedAt  time.Time `json:\"observed_at\"`\n}\n\n// loadReadings reads the persisted readings; called by Open.\nfunc (b *Book) loadReadings(ctx context.Context) error {\n\tv, err := b.meta.Meta(ctx, readingsKey)\n\tswitch {\n\tcase errors.Is(err, state.ErrNotFound):\n\t\treturn nil\n\tcase err != nil:\n\t\treturn fmt.Errorf(\"open limits readings: %w\", err)\n\t}\n\tvar got map[string]Reading\n\tif err := json.Unmarshal([]byte(v), &got); err != nil {\n\t\tb.log.Warn(\"limits.corrupt\", \"key\", readingsKey, \"error\", err)\n\t\treturn nil\n\t}\n\tif got != nil {\n\t\tb.readings = got\n\t}\n\treturn nil\n}\n\n// Observe records the latest reading of each window in ws, stamped with the\n// book's clock, and persists them. A window whose reading is unchanged is\n// skipped, so observing the same step twice neither logs nor writes twice.\n// A new window type is ignored once the book holds 16. An empty ws is a no-op. On a persist error memory is unchanged.\nfunc (b *Book) Observe(ctx context.Context, ws []agent.Window) error {\n\tif len(ws) == 0 {\n\t\treturn nil\n\t}\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tnow := b.now().UTC()\n\tnext := make(map[string]Reading, len(b.readings)+len(ws))\n\tfor k, r := range b.readings {\n\t\tnext[k] = r\n\t}\n\tvar changed []Reading\n\tfor _, w := range ws {\n\t\tr := Reading{Window: w.Type, Utilization: w.Utilization, Status: w.Status, ResetsAt: w.ResetsAt.UTC(), ObservedAt: now}\n\t\told, ok := next[w.Type]\n\t\tif !ok && len(next) >= maxReadings {\n\t\t\tcontinue\n\t\t}\n\t\tif ok && old.Utilization == r.Utilization && old.Status == r.Status && old.ResetsAt.Equal(r.ResetsAt) {\n\t\t\tcontinue\n\t\t}\n\t\tnext[w.Type] = r\n\t\tchanged = append(changed, r)\n\t}\n\tif len(changed) == 0 {\n\t\treturn nil\n\t}\n\traw, err := json.Marshal(next)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"encode limits readings: %w\", err)\n\t}\n\tif err := b.meta.SetMeta(ctx, readingsKey, string(raw)); err != nil {\n\t\treturn fmt.Errorf(\"persist limits readings: %w\", err)\n\t}\n\tb.readings = next\n\tfor _, r := range changed {\n\t\tb.log.Info(\"limits.reading\", \"window\", r.Window, \"utilization\", r.Utilization, \"status\", r.Status, \"resets_at\", r.ResetsAt)\n\t}\n\treturn nil\n}\n\n// Readings returns a copy of the latest reading per window, sorted by window.\nfunc (b *Book) Readings() []Reading {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tout := make([]Reading, 0, len(b.readings))\n\tfor _, r := range b.readings {\n\t\tout = append(out, r)\n\t}\n\tsort.Slice(out, func(i, j int) bool { return out[i].Window < out[j].Window })\n\treturn out\n}\npackage pool\n\nimport \"time\"\n\n// Candidate is one job a loop would like to start.\ntype Candidate struct {\n\tClass Class\n\t// Role is the role directory name, e.g. \"lead\", \"security-review\", \"cve\".\n\tRole string\n\t// Number is the issue (triage, worker) or PR (review) number, and 0 for\n\t// scanner runs. Negative numbers are allowed (dry-run synthetic issues).\n\tNumber int\n\t// Since is when the job became eligible; required. Triage and worker use\n\t// the issue's created_at, reviewers the PR's created_at, and a scanner run\n\t// the time it became due (last run plus interval).\n\tSince time.Time\n\t// Priority orders candidates within a class: 0 (ard:p0) first, 3 last.\n\t// The zero value is P0, so callers must set it; labels.Priority returns 2\n\t// for an unlabelled item, and scanner runs use 2.\n\tPriority int\n}\n\n// Key returns KeyFor(c.Class, c.Role, c.Number); callers never build keys by hand.\nfunc (c Candidate) Key() string { return KeyFor(c.Class, c.Role, c.Number) }\n\n// invalid returns the first rule the candidate breaks, or \"\".\nfunc (c Candidate) invalid() string {\n\tswitch {\n\tcase !c.Class.valid():\n\t\treturn \"unknown class \" + c.Class.String()\n\tcase c.Role == \"\":\n\t\treturn \"empty role\"\n\tcase c.Since.IsZero():\n\t\treturn \"zero Since\"\n\tcase c.Class == ClassScanner && c.Number != 0:\n\t\treturn \"scanner candidate must have number 0\"\n\tcase c.Class != ClassScanner && c.Number == 0:\n\t\treturn c.Class.String() + \" candidate must have a non-zero number\"\n\t}\n\treturn \"\"\n}\n\n// less is a total order on distinct keys: class, then Priority (lower first), then oldest Since, then\n// lower Number, then Role. It does not depend on input order.\nfunc less(a, b Candidate) bool {\n\tif a.Class != b.Class {\n\t\treturn a.Class < b.Class\n\t}\n\tif a.Priority != b.Priority {\n\t\treturn a.Priority < b.Priority\n\t}\n\tif !a.Since.Equal(b.Since) {\n\t\treturn a.Since.Before(b.Since)\n\t}\n\tif a.Number != b.Number {\n\t\treturn a.Number < b.Number\n\t}\n\treturn a.Role < b.Role\n}\n\tif w.lim != nil {\n\t\treturn w.lim, nil\n\t}\n\tb, err := limits.Open(ctx, w.Store, time.Now, w.Log)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"serve: %w\", err)\n\t}\n\tw.lim = b\n\treturn b, nil\n}\n\n// limitedFor is the pool's Options.Limited: when a candidate may next start\n// given the usage limits recorded so far. Deterministic scanners use no model\n// and are never limited. A role missing from the config is never offered, so\n// it is not limited either.\nfunc (w *wiring) limitedFor(c pool.Candidate) time.Time {\n\tvar kind config.Kind\n\tswitch c.Class {\n\tcase pool.ClassScanner:\n\t\tkind = config.KindScanner\n\tcase pool.ClassTriage:\n\t\tkind = config.KindTriage\n\tcase pool.ClassWorker:\n\t\tkind = config.KindWorker\n\tcase pool.ClassReview:\n\t\tkind = config.KindReviewer\n\tdefault:\n\t\treturn time.Time{}\n\t}\n\tcfg := w.cfg.Load()\n\tif cfg == nil {\n\t\treturn time.Time{}\n\t}\n\trole, ok := cfg.Role(kind, c.Role)\n\tif !ok || (kind == config.KindScanner && role.ScanPath != \"\") {\n\t\treturn time.Time{}\n\t}\n\tw.initMu.Lock()\n\tbook := w.lim\n\tw.initMu.Unlock()\n\tif book == nil {\n\t\treturn time.Time{}\n\t}\n\treturn book.Until(limits.FamilyOf(role.Model))\n}\n\n// finisher returns the shared Finisher the loops call when a job's process\n// has stopped (see package reaper for the contract).\nfunc (w *wiring) finisher() (*reaper.Finisher, error) {\n\tf, _, err := w.reaperParts()\n\treturn f, err\n}\n\n// reaperLoop returns the Reaper loop, or nil when the executor cannot be built.\nfunc reaperLoop(w *wiring) controller.Loop {\n\t_, r, err := w.reaperParts()\n\tif err != nil {\n\t\tw.Log.Error(\"reaper.executor_unavailable\", \"error\", err)\n\t\treturn nil\n\t}\n\treturn r\n}\n\n// resumeCloseouts is the closeout-resume startup hook. It runs before the pool\n// is adopted, so it never touches the pool.\nfunc (w *wiring) resumeCloseouts(ctx context.Context) error {\n\t// A store that cannot be read means state is broken: fail startup.\n\tif _, err := w.limitsBook(ctx); err != nil {\n\t\treturn fmt.Errorf(\"closeout-resume: %w\", err)\n\t}\n\t_, r, err := w.reaperParts()\n\tif err != nil {\n\t\t// Without an executor nothing runs jobs either; do not keep serve down.\n\t\tw.Log.Error(\"reaper.resume_skipped\", \"error\", err)\n\t\treturn nil\n\t}\n\treturn r.ResumeAll(ctx)\n}\n\n// parseFunc reads a job's agent result from its stdout log, with the adapter\n// its role is configured for.\npackage servecmd\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/agent\"\n\t\"github.com/albertcbrown/ard/internal/agent/claude\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/limits\"\n\t\"github.com/albertcbrown/ard/internal/modelauth\"\n\t\"github.com/albertcbrown/ard/internal/pool\"\n\t\"github.com/albertcbrown/ard/internal/reaper\"\n)\n\ntype fakeClock struct{ t time.Time }\n\nfunc (c *fakeClock) now() time.Time { return c.t }\n\nvar limitT0 = time.Date(2026, 11, 22, 12, 0, 0, 0, time.UTC)\n\nfunc limitWiring(t *testing.T, clk *fakeClock) *wiring {\n\tt.Helper()\n\tw := newTestWiring(t)\n\tbook, err := limits.Open(context.Background(), w.Store, clk.now, w.Log)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tw.lim = book\n\tw.cfg.Store(&config.Resolved{Roles: []config.Role{\n\t\t{Kind: config.KindScanner, Name: \"cve\", ScanPath: \"roles/scanner/cve/scan\"},\n\t\t{Kind: config.KindScanner, Name: \"llm-scan\"},\n\t\t{Kind: config.KindTriage, Name: \"lead\"},\n\t\t{Kind: config.KindWorker, Name: \"engineer\", Model: \"claude-opus-4-1\"},\n\t\t{Kind: config.KindReviewer, Name: \"sec\", Model: \"sonnet\"},\n\t}})\n\treturn w\n}\n\nfunc cand(c pool.Class, role string, n int) pool.Candidate {\n\treturn pool.Candidate{Class: c, Role: role, Number: n, Since: limitT0.Add(-time.Hour)}\n}\n\nfunc TestLimitedFor(t *testing.T) {\n\tclk := &fakeClock{limitT0}\n\tw := limitWiring(t, clk)\n\tuntil, err := w.lim.Exhaust(context.Background(), \"opus\", limitT0.Add(time.Hour))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\ttests := []struct {\n\t\tname string\n\t\tc    pool.Candidate\n\t\twant time.Time\n\t}{\n\t\t{\"deterministic scanner is never limited\", cand(pool.ClassScanner, \"cve\", 0), time.Time{}},\ninternal/servecmd/adopt.go:52:\t\t\tCandidate: pool.Candidate{Class: class, Role: j.Role, Number: n, Since: j.CreatedAt},\ninternal/servecmd/adopt.go:63:func adoptPool(ctx context.Context, l jobLister, maxPods int, log *slog.Logger, limited func(pool.Candidate) time.Time, budget func(pool.Candidate) (bool, string)) (*pool.Pool, error) {\ninternal/servecmd/reaping.go:165:func (w *wiring) limitedFor(c pool.Candidate) time.Time {\ninternal/pool/pool.go:41:\tCandidate Candidate\ninternal/pool/pool.go:49:\tCandidate Candidate\ninternal/pool/pool.go:64:\tLimited func(c Candidate) time.Time\ninternal/pool/pool.go:68:\tBudget func(c Candidate) (denied bool, reason string)\ninternal/pool/pool.go:79:\tlimited     func(c Candidate) time.Time\ninternal/pool/pool.go:80:\tbudget      func(c Candidate) (bool, string)\ninternal/pool/pool.go:115:\t\tk := h.Candidate.Key()\ninternal/pool/pool.go:120:\t\tp.held[k] = &Slot{pool: p, cand: h.Candidate, jobID: h.JobID, grantedAt: p.now(), adopted: true}\ninternal/pool/pool.go:160:\tcand Candidate\ninternal/pool/pool.go:169:func (p *Pool) Offer(loop string, ttl time.Duration, cands []Candidate) []Decision {\ninternal/pool/pool.go:189:\t\tdecisions[i].Candidate = c\ninternal/pool/pool.go:226:\tvar denied []Candidate\nTODO.md\nlayout.md\nproposal.md\nrunbooks\nsite\n309:## Executors and the Reaper","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01U3VWL8jpaezhK4FYXNNybb","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
