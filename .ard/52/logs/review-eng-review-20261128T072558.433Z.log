\")\n \tb.WriteString(\"- `scanners/trufflehog-history` is included. It scans the full git history weekly for leaked credentials, with the same fingerprints as `scanners/trufflehog`, and its issues never autoclose. It reads the controller's clone through a read-only mount and needs the same TruffleHog binary. To opt out, delete `.ard/scanners/trufflehog-history/` and its `scanners/trufflehog-history` line under `overrides:` in `.ard/config.yaml` before merging.\\n\")\n+\tb.WriteString(\"- `scanners/architecture` is included. It is an LLM scanner that checks the code against your ADRs and architecture docs every 3 days, with spend capped at $2 per run. Its issues carry no `ard:pending`, so a human sends them to triage. It runs as a host subprocess (#84). To opt out, delete `.ard/scanners/architecture/` and its `scanners/architecture` line under `overrides:` in `.ard/config.yaml` before merging.\\n\")\n \tb.WriteString(\"\\n## Follow-up ard does not do\\n\\n\")\n \tb.WriteString(\"ard never writes `.github/`, so do this by hand\")\n \tstep2 := \"Set the repository variable `ARD_BOT_LOGIN` to the App's `<slug>[bot]` login.\"\ndiff --git a/internal/initcmd/initcmd_test.go b/internal/initcmd/initcmd_test.go\nindex 1b525ac..caf28b0 100644\n--- a/internal/initcmd/initcmd_test.go\n+++ b/internal/initcmd/initcmd_test.go\n@@ -147,7 +147,7 @@ func snapshot(t *testing.T, dir string) map[string]string {\n \treturn m\n }\n \n-var starterTree = []string{\".ard/PRODUCT.md\", \".ard/TECH_STACK.md\", \".ard/VISION.md\", \".ard/config.yaml\", \".ard/reviewers/eng-review/prompt.txt\", \".ard/reviewers/license-review/allowlist.txt\", \".ard/reviewers/license-review/prompt.txt\", \".ard/reviewers/product-manager-review/prompt.txt\", \".ard/reviewers/security-review/Dockerfile\", \".ard/reviewers/security-review/aid\", \".ard/reviewers/security-review/normalize.jq\", \".ard/reviewers/security-review/prompt.txt\", \".ard/reviewers/security-review/rules/security.yml\", \".ard/scanners/cve/D