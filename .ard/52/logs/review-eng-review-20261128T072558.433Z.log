"unexpected limits: %+v\", r)\n143\t+\t}\n144\t+\tif !r.LLMScanner() || !r.ReadsUntrusted() {\n145\t+\t\tt.Errorf(\"LLMScanner=%v ReadsUntrusted=%v\", r.LLMScanner(), r.ReadsUntrusted())\n146\t+\t}\n147\t+}\n148\t+\n149\t+func TestArchitectureInHostUntrusted(t *testing.T) {\n150\t+\tres, err := config.LoadFS(starterFS(t, true), \"/repo\")\n151\t+\tif err != nil {\n152\t+\t\tt.Fatal(err)\n153\t+\t}\n154\t+\tfor _, r := range res.HostUntrusted() {\n155\t+\t\tif r.Kind == config.KindScanner && r.Name == \"architecture\" {\n156\t+\t\t\treturn\n157\t+\t\t}\n158\t+\t}\n159\t+\tt.Errorf(\"HostUntrusted = %v, want scanners/architecture\", res.HostUntrusted())\n160\t+}\n161\t+\n162\t+func TestArchitecturePromptContract(t *testing.T) {\n163\t+\tp := architecturePrompt(t)\n164\t+\tif !utf8.ValidString(p) || len(p) >= 64<<10 {\n165\t+\t\tt.Fatalf(\"prompt invalid UTF-8 or too large (%d bytes)\", len(p))\n166\t+\t}\n167\t+\tfor _, s := range []string{\"$ARD_OUT/findings.jsonl\", \"UNTRUSTED\", \"<rule>:<path>[:<symbol>]\", \"$ARD_SIDECAR\", \"write an empty $ARD_OUT/findings.jsonl and stop\",\n168\t+\t\t\"fingerprint\", \"title\", \"severity\", \"group\", \"files\", \"body\"} {\n169\t+\t\tif !strings.Contains(p, s) {\n170\t+\t\t\tt.Errorf(\"prompt lacks %q\", s)\n171\t+\t\t}\n172\t+\t}\n173\t+\tfor _, s := range []string{\"autoclose\", \"gh \"} {\n174\t+\t\tif strings.Contains(p, s) {\n175\t+\t\t\tt.Errorf(\"prompt contains %q\", s)\n176\t+\t\t}\n177\t+\t}\n178\t+}\n179\t+\n180\t+func architectureExamples(t *testing.T) []string {\n181\t+\tt.Helper()\n182\t+\tvar out []string\n183\t+\tfor _, l := range strings.Split(architecturePrompt(t), \"\\n\") {\n184\t+\t\tif strings.HasPrefix(l, `{\"fingerprint\":`) {\n185\t+\t\t\tout = append(out, l)\n186\t+\t\t}\n187\t+\t}\n188\t+\tif len(out) < 2 {\n189\t+\t\tt.Fatalf(\"found %d example lines, want at least 2\", len(out))\n190\t+\t}\n191\t+\treturn out\n192\t+}\n193\t+\n194\t+func TestArchitecturePromptExamplesDecode(t *testing.T) {\n195\t+\tfsys := fstest.MapFS{}\n196\t+\tfs, err := scanner.DecodeFindings(strings.NewReader(strings.Join(architectureExamples(t), \"\\n\")))\n197\t+\tif err != nil {\n198\t+\t\tt.Fatalf(\"DecodeFindings: %v\", err)\n199\t+\t}\n200\t+\tfor _, f := range fs {\n201\t+\t\tfor _, p := range f.Files {\n202\t+\t\t\tfsys[p] = &fstest.MapFile{}\n203\t+\t\t}\n204\t+\t}\n205\t+\texists := func(p string) bool { _, err := fsys.Open(p); return err == nil }\n206\t+\tif errs := scanner.CheckLLMFingerprints(fs, exists); len(errs) > 0 {\n207\t+\t\tt.Fatalf(\"CheckLLMFingerprints: %v\", errs)\n208\t+\t}\n209\t+\tfor _, f := range fs {\n210\t+\t\trule, p, _, _ := scanner.ParseLLMFingerprint(f.Fingerprint)\n211\t+\t\tif n := utf8.RuneCountInString(f.Title); n > 120 {\n212\t+\t\t\tt.Errorf(\"title %q has %d runes\", f.Title, n)\n213\t+\t\t}\n214\t+\t\tif !strings.HasPrefix(f.Title, p+\": \") || !strings.HasSuffix(f.Title, \"(\"+rule+\")\") {\n215\t+\t\t\tt.Errorf(\"title %q is not <path>: ... (<rule>)\", f.Title)\n216\t+\t\t}\n217\t+\t\tif f.Severity == scanner.SevCritical || f.Severity == scanner.SevInfo {\n218\t+\t\t\tt.Errorf(\"severity %q\", f.Severity)\n219\t+\t\t}\n220\t+\t\tif f.Group != \"\" {\n221\t+\t\t\tt.Errorf(\"group %q\", f.Group)\n222\t+\t\t}\n223\t+\t}\n224\t+}\n225\t+\n226\t+func TestArchitectureExampleChecksCatchDrift(t *testing.T) {\n227\t+\tbad := []scanner.Finding{\n228\t+\t\t{Fingerprint: \"adr-1:a/b.go\", Files: []string{\"c.go\"}},\n229\t+\t\t{Fingerprint: \"ADR-1:a/b.go\", Files: []string{\"a/b.go\"}},\n230\t+\t\t{Fingerprint: \"adr-1:a/b.go:x y\", Files: []string{\"a/b.go\"}},\n231\t+\t}\n232\t+\tif errs := scanner.CheckLLMFingerprints(bad, nil); len(errs) != 3 {\n233\t+\t\tt.Errorf(\"got %d errors, want 3: %v\", len(errs), errs)\n234\t+\t}\n235\t+}\n236\tdiff --git a/internal/roles/config.yaml b/internal/roles/config.yaml\n237\tindex 3ecd129..20d8188 100644\n238\t--- a/internal/roles/config.yaml\n239\t+++ b/internal/roles/config.yaml\n240\t@@ -50,6 +50,8 @@ overri