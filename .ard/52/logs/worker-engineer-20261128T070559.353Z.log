/Dockerfile\", \".ard/scanners/missing-tests/missingtests.go\", \".ard/scanners/missing-tests/scan\", \".ard/scanners/trufflehog-history/Dockerfile\", \".ard/scanners/trufflehog-history/exclude-paths\", \".ard/scanners/trufflehog-history/findings.jq\", \".ard/scanners/trufflehog-history/history\", \".ard/scanners/trufflehog-history/scan\", \".ard/scanners/trufflehog/Dockerfile\", \".ard/scanners/trufflehog/exclude-paths\", \".ard/scanners/trufflehog/findings.jq\", \".ard/scanners/trufflehog/scan\", \".ard/triage/architect/prompt.txt\", \".ard/triage/designer/prompt.txt\", \".ard/triage/documentation-planner/prompt.txt\", \".ard/triage/engineer/prompt.txt\", \".ard/triage/lead/prompt.txt\", \".ard/triage/product-manager/prompt.txt\", \".ard/workers/engineer/prompt.txt\"}\n../initcmd/initcmd_test.go:164:\tif got := strings.TrimSpace(gittest.Run(t, h.bare, \"ls-tree\", \"-r\", \"ard-init\", \"--\", \".ard/scanners/cve/scan\")); !strings.HasPrefix(got, \"100755 \") {\n../initcmd/initcmd_test.go:214:\tfor _, s := range []string{\"bot-commits.yml\", \"ARD_BOT_LOGIN\", \"Squash and merge\", \".ard/scanners/cve/scan\", \".ard/scanners/error-codes/Dockerfile\", \".ard/scanners/error-codes/errcodes.jq\", \".ard/scanners/error-codes/scan\", \".ard/scanners/trufflehog/scan\", \"delete `.ard/scanners/trufflehog/`\", \".ard/triage/lead/prompt.txt\", \".ard/triage/engineer/prompt.txt\", \".ard/workers/engineer/prompt.txt\", \".ard/reviewers/eng-review/prompt.txt\", \".ard/reviewers/security-review/prompt.txt\", \".ard/reviewers/product-manager-review/prompt.txt\"} {\n../initcmd/initcmd_test.go:228:\tfor _, s := range []string{\"add  .ard/scanners/cve/scan (0755)\", \"add  .ard/config.yaml\", \"opened PR #\"} {\n../initcmd/initcmd_test.go:537:\t\tif f.Path == \".ard/config.yaml\" || slices.Contains(ContextPaths(), f.Path) || f.Path == \".ard/scanners/cve/scan\" {\n../initcmd/local_test.go:44:\tfi, err := os.Stat(filepath.Join(h.clone, \".ard/scanners/cve/scan\"))\npackage scanner\n\nimport (\n\t\"bufio\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"path\"\n\t\"strings\"\n\t\"unicode\"\n\t\"unicode/utf8\"\n)\n\n// Severity of a finding.\ntype Severity string\n\n// The five severities, highest first.\nconst (\n\tSevCritical Severity = \"critical\"\n\tSevHigh     Severity = \"high\"\n\tSevMedium   Severity = \"medium\"\n\tSevLow      Severity = \"low\"\n\tSevInfo     Severity = \"info\"\n)\n\n// Rank orders severities: critical is 5, info is 1, an unknown value is 0.\nfunc (s Severity) Rank() int {\n\tswitch s {\n\tcase SevCritical:\n\t\treturn 5\n\tcase SevHigh:\n\t\treturn 4\n\tcase SevMedium:\n\t\treturn 3\n\tcase SevLow:\n\t\treturn 2\n\tcase SevInfo:\n\t\treturn 1\n\t}\n\treturn 0\n}\n\n// Valid reports whether s is one of the five severities.\nfunc (s Severity) Valid() bool { return s.Rank() > 0 }\n\n// Limits on scanner output. Any violation fails the whole run.\nconst (\n\tMaxLineBytes   = 1 << 20  // one JSONL line\n\tMaxStreamBytes = 16 << 20 // the whole stdout\n\tMaxFindings    = 10000\n\tMaxBodyBytes   = 64 << 10\n\tMaxFingerprint = 512 // bytes\n\tMaxTitleRunes  = 200\n\tMaxGroupBytes  = 256\n\tMaxFiles       = 1000\n\tmaxPathBytes   = 4096\n\tmaxErrorLines  = 20\n)\n\n// Finding is one line of scanner output.\ntype Finding struct {\n\tFingerprint string   `json:\"fingerprint\"` // required; stable across runs\n\tTitle       string   `json:\"title\"`       // required; one line\n\tSeverity    Severity `json:\"severity\"`    // required\n\tGroup       string   `json:\"group\"`       // optional; \"\" = one issue per finding\n\tFiles       []string `json:\"files\"`       // optional; repo-relative\n\tBody        string   `json:\"body\"`        // optional markdown\n}\n\n// DecodeError is one invalid line of scanner output.\ntype DecodeError struct {\n\tLine int\n\tMsg  string\n}\n\nfunc (e DecodeError) Error() string { return fmt.Sprintf(\"line %d: %s\", e.Line, e.Msg) }\n\n// DecodeErrors lists the invalid lines of a scanner's output, at most 20.\ntype DecodeErrors []DecodeError\n\nfunc (e DecodeErrors) Error() string {\n\tparts := make([]string, 0, len(e))\n\tfor _, d := range e {\n\t\tparts = append(parts, d.Error())\n\t}\n\treturn \"invalid scanner output: \" + strings.Join(parts, \"; \")\n}\n\n// DecodeFindings parses scanner stdout as JSON lines, strictly: unknown keys,\n// a missing required key, a bad value, a duplicate fingerprint or an\n// oversized line or stream are errors. Blank lines are skipped. It never\n// returns partial findings, so a half-parsed run can never trigger autoclose.\nfunc DecodeFindings(r io.Reader) ([]Finding, error) {\n\tvar (\n\t\tout  []Finding\n\t\terrs DecodeErrors\n\t\tseen = map[string]int{}\n\t\tn    int\n\t\tread int\n\t)\n\tfail := func(line int, format string, a ...any) {\n\t\tif len(errs) < maxErrorLines {\n\t\t\terrs = append(errs, DecodeError{Line: line, Msg: fmt.Sprintf(format, a...)})\n\t\t}\n\t}\n\tbr := bufio.NewReaderSize(r, 64<<10)\n\tfor {\n\t\tline, tooLong, err := readLine(br, MaxLineBytes)\n\t\tread += len(line)\n\t\tif tooLong {\n\t\t\tfail(n+1, \"longer than %d bytes\", MaxLineBytes)\n\t\t\treturn nil, errs\n\t\t}\n\t\tif len(line) > 0 || err == nil {\n\t\t\tn++\n\t\t\tif t := strings.TrimSpace(string(line)); t != \"\" {\n\t\t\t\tif len(out)+1 > MaxFindings {\n\t\t\t\t\tfail(n, \"more than %d findings\", MaxFindings)\n\t\t\t\t\treturn nil, errs\n\t\t\t\t}\n45-\treturn rule, p, symbol, true\n46-}\n47-\n48-// CheckLLMFingerprints validates every finding's fingerprint against the LLM\n49-// grammar, requires its path to be listed in the finding's Files and, via\n50-// exists, to be present in the repository. A nil exists treats every path as\n51-// present. Errors carry the 1-based finding index and fixed text only, never\n52-// the fingerprint or any finding text; at most 20 are returned.\n53:func CheckLLMFingerprints(fs []Finding, exists func(path string) bool) DecodeErrors {\n54-\tvar errs DecodeErrors\n55-\tfail := func(i int, msg string) {\n56-\t\tif len(errs) < maxErrorLines {\n57-\t\t\terrs = append(errs, DecodeError{Line: i + 1, Msg: msg})\n58-\t\t}\n59-\t}\n60-\tfor i, f := range fs {\n61-\t\t_, p, _, ok := ParseLLMFingerprint(f.Fingerprint)\n62-\t\tif !ok {\n63-\t\t\tfail(i, \"fingerprint is not rule:path[:symbol]\")\n64-\t\t\tcontinue\n65-\t\t}\n66-\t\tlisted := false\n67-\t\tfor _, file := range f.Files {\n68-\t\t\tif file == p {\n69-\t\t\t\tlisted = true\n70-\t\t\t\tbreak\n71-\t\t\t}\n72-\t\t}\n73-\t\tif !listed {\n74-\t\t\tfail(i, \"fingerprint path is not in files\")\n75-\t\t\tcontinue\n76-\t\t}\n77-\t\tif exists != nil && !exists(p) {\n78-\t\t\tfail(i, \"fingerprint path does not exist\")\n79-\t\t}\n80-\t}\n81-\treturn errs\n82-}\n83-\n84-// LLMGrammarLines summarises errors as \"invalid findings at lines 3, 7 (and\n85-// N more)\", for logs. It contains line numbers only.\n86-func LLMGrammarLines(errs DecodeErrors) string {\n87-\tconst show = 5\n88-\tvar nums []string\n89-\tfor i, e := range errs {\n90-\t\tif i == show {\n91-\t\t\tbreak\n92-\t\t}\n93-\t\tnums = append(nums, fmt.Sprint(e.Line))","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_012rn3NbJuo11nunLmArE3sN","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
