\n\t\treturn 4\n\tcase SevMedium:\n\t\treturn 3\n\tcase SevLow:\n\t\treturn 2\n\tcase SevInfo:\n\t\treturn 1\n\t}\n\treturn 0\n}\n\n// Valid reports whether s is one of the five severities.\nfunc (s Severity) Valid() bool { return s.Rank() > 0 }\n\n// Limits on scanner output. Any violation fails the whole run.\nconst (\n\tMaxLineBytes   = 1 << 20  // one JSONL line\n\tMaxStreamBytes = 16 << 20 // the whole stdout\n\tMaxFindings    = 10000\n\tMaxBodyBytes   = 64 << 10\n\tMaxFingerprint = 512 // bytes\n\tMaxTitleRunes  = 200\n\tMaxGroupBytes  = 256\n\tMaxFiles       = 1000\n\tmaxPathBytes   = 4096\n\tmaxErrorLines  = 20\n)\n\n// Finding is one line of scanner output.\ntype Finding struct {\n\tFingerprint string   `json:\"fingerprint\"` // required; stable across runs\n\tTitle       string   `json:\"title\"`       // required; one line\n\tSeverity    Severity `json:\"severity\"`    // required\n\tGroup       string   `json:\"group\"`       // optional; \"\" = one issue per finding\n\tFiles       []string `json:\"files\"`       // optional; repo-relative\n\tBody        string   `json:\"body\"`        // optional markdown\n}\n\n// DecodeError is one invalid line of scanner output.\ntype DecodeError struct {\n\tLine int\n\tMsg  string\n}\n\nfunc (e DecodeError) Error() string { return fmt.Sprintf(\"line %d: %s\", e.Line, e.Msg) }\n\n// DecodeErrors lists the invalid lines of a scanner's output, at most 20.\ntype DecodeErrors []DecodeError\n\nfunc (e DecodeErrors) Error() string {\n\tparts := make([]string, 0, len(e))\n\tfor _, d := range e {\n\t\tparts = append(parts, d.Error())\n\t}\n\treturn \"invalid scanner output: \" + strings.Join(parts, \"; \")\n}\n\n// DecodeFindings parses scanner stdout as JSON lines, strictly: unknown keys,\n// a missing required key, a bad value, a duplicate fingerprint or an\n// oversized line or stream are errors. Blank lines are skipped. It never\n// returns partial findings, so a half-parsed run can never trigger autoclose.\nfunc DecodeFindings(r io.Reader) ([]Finding, error) {\n\tvar (\n\t\tout  []Finding\n\t\terrs DecodeErrors\n\t\tseen = map[string]int{}\n\t\tn    int\n\t\tread int\n\t)\n\tfail := func(line int, format string, a ...any) {\n\t\tif len(errs) < maxErrorLines {\n\t\t\terrs = append(errs, DecodeError{Line: line, Msg: fmt.Sprintf(format, a...)})\n\t\t}\n\t}\n\tbr := bufio.NewReaderSize(r, 64<<10)\n\tfor {\n\t\tline, tooLong, err := readLine(br, MaxLineBytes)\n\t\tread += len(line)\n\t\tif tooLong {\n\t\t\tfail(n+1, \"longer than %d bytes\", MaxLineBytes)\n\t\t\treturn nil, errs\n\t\t}\n\t\tif len(line) > 0 || err == nil {\n\t\t\tn++\n\t\t\tif t := strings.TrimSpace(string(line)); t != \"\" {\n\t\t\t\tif len(out)+1 > MaxFindings {\n\t\t\t\t\tfail(n, \"more than %d findings\", MaxFindings)\n\t\t\t\t\treturn nil, errs\n\t\t\t\t}\n45-\treturn rule, p, symbol, true\n46-}\n47-\n48-// CheckLLMFingerprints validates every finding's fingerprint against the LLM\n49-// grammar, requires its path to be listed in the finding's Files and, via\n50-// exists, to be present in the repository. A nil exists treats every path as\n51-// present. Errors carry the 1-based finding index and fixed text only, never\n52-// the fingerprint or any finding text; at most 20 are returned.\n53:func CheckLLMFingerprints(fs []Finding, exists func(path string) bool) DecodeErrors {\n54-\tvar errs DecodeErrors\n55-\tfail := func(i int, msg string) {\n56-\t\tif len(errs) < maxErrorLines {\n57-\t\t\terrs = append(errs, DecodeError{Line: i + 1, Msg: msg})\n58-\t\t}\n59-\t}\n60-\tfor i, f := range fs {\n61-\t\t_, p, _, ok := ParseLLMFingerprint(f.Fingerprint)\n62-\t\tif !ok {\n63-\t\t\tfail(i, \"fingerprint is not rule:path[:symbol]\")\n64-\t\t\tcontinue\n65-\t\t}\n66-\t\tlisted := false\n67-\t\tfor _, file := range f.Files {\n68-\t\t\tif file == p {\n69-\t\t\t\tlisted = true\n70-\t\t\t\tbreak\n71-\t\t\t}\n72-\t\t}\n73-\t\tif !listed {\n74-\t\t\tfail(i, \"fingerprint path is not in files\")\n75-\t\t\tcontinue\n76-\t\t}\n77-\t\tif exists != nil && !exists(p) {\n78-\t\t\tfail(i, \"fingerprint path does not exist\")\n79-\t\t}\n80-\t}\n81-\treturn errs\n82-}\n83-\n84-// LLMGrammarLines summarises errors as \"invalid findings at lines 3, 7 (and\n85-// N more)\", for logs. It contains line numbers only.\n86-func LLMGrammarLines(errs DecodeErrors) string {\n87-\tconst show = 5\n88-\tvar nums []string\n89-\tfor i, e := range errs {\n90-\t\tif i == show {\n91-\t\t\tbreak\n92-\t\t}\n93-\t\tnums = append(nums, fmt.Sprint(e.Line))","is_error":false}]},"parent_tool_use_id":null,"session_id":"ca5ddae6-22d1-4b15-a7d7-5ce436945bda","uuid":"e6e3252d-ea3e-4e31-8c78-d90c1bc4963e","timestamp":"2026-11-28T07:06:05.019Z","tool_use_result":{"stdout":"// Package roles holds the starter .ard/ tree that `ard init` (#27) proposes\n// to a target repo. Paths in FS are relative to .ard/ (for example\n// \"config.yaml\" or \"scanners/cve/scan\"). embed.FS reports every file as 0444,\n// so the writer must commit files named in ExecutableNames as 100755.\npackage roles\n\nimport \"embed\"\n\n// FS is the starter .ard/ tree `ard init` proposes: config.yaml, the repo context templates PRODUCT.md, VISION.md and TECH_STACK.md, plus the role\n// directories (scanners/cve, scanners/lts, scanners/docs, scanners/error-codes, scanners/lint, scanners/missing-tests, scanners/trufflehog, scanners/trufflehog-history, triage/lead, triage/engineer, triage/product-manager, triage/architect, triage/designer, triage/documentation-planner, workers/engineer, reviewers/eng-review, reviewers/license-review, reviewers/product-manager-review and reviewers/security-review); paths are relative to .ard/.\n//\n// scanners/missing-tests is left out until its scan driver exists; re-add it when wiring it in.\n//\n//go:embed config.yaml PRODUCT.md VISION.md TECH_STACK.md reviewers scanners/cve scanners/docs scanners/error-codes scanners/lint scanners/lts scanners/missing-tests scanners/trufflehog scanners/trufflehog-history triage workers\nvar FS embed.FS\n\n// ExecutableNames lists base names that must be written 0755.\nvar ExecutableNames = []string{\"scan\", \"aid\"}\n# ard configuration, proposed by `ard init`. Edit freely; this file is yours.\n# Anything unset takes its built-in default (docs/proposal.md, Configuration).\n# Validate with `ard config check`. ard serve reads this file from origin/main.\n\n# label: only issues a maintainer labels for triage enter the pipeline.\n# all: every human-filed issue enters.\nintake: { mode: label }\n\nmerge:\n  # A PR touching any of these waits for a human approval. There is no\n  # built-in list: removing an entry removes its gate. An entry ending in /\n  # is a directory prefix; anything else is a glob (quote globs starting with *).\n  protected_paths:\n    - .github/\n    - .ard/config.yaml\n    # ard init records the starter hashes here; editing it changes what init may overwrite.\n    - .ard/ard-init.lock\n    - .ard/scanners/\n    - .ard/triage/\n    - .ard/workers/\n    - .ard/reviewers/\n    # Repo context docs every agent reads; a PR could plant instructions in them.\n    - .ard/PRODUCT.md\n    - .ard/VISION.md\n    - .ard/TECH_STACK.md\n    - \"**/CODEOWNERS\"\n    # Agent instructions a PR could plant to steer later agents.\n    - CLAUDE.md\n    - \"**/CLAUDE.md\"\n    - AGENTS.md\n    - \"**/AGENTS.md\"\n    - .claude/\n    - .mcp.json\n    # Linter config a PR could weaken: disabling a linter silently autocloses its issues.\n    - \"**/.golangci.yml\"\n    - \"**/.golangci.yaml\"\n    - \"**/.golangci.toml\"\n    - \"**/.golangci.json\"\n\noverrides:\n  scanners/cve: { every: 6h, max_open: 10, group_size: 1, autoclose: true }\n  scanners/lts: { every: 7d, max_open: 5, group_size: 1, autoclose: true }\n  scanners/docs: { every: 3d, max_open: 3, group_size: 10, autoclose: true }\n  scanners/error-codes: { every: 24h, group_size: 20, autoclose: true }\n  scanners/missing-tests: { every: 24h, max_open: 5, group_size: 10, autoclose: true }\n  # needs a human-made `baseline` next to `scan`; see its Dockerfile\n  scanners/lint: { every: 24h, max_open: 3, group_size: 20, autoclose: true }\n  # Leaked credentials go straight to a human: route: needs-human files without\n  # ard:pending, so no agent triages them.\n  scanners/trufflehog: { every: 24h, max_open: 5, group_size: 1, autoclose: true, route: needs-human, timeout: 30m }\n  # Full git history (read-only mount of the clone); history never goes away, so no autoclose.\n  scanners/trufflehog-history: { every: 7d, max_open: 5, group_size: 1, autoclose: false, route: needs-human, timeout: 60m }\n  triage/lead:  { model: claude-opus-5-5, timeout: 15m }\n  triage/product-manager: { model: claude-opus-5-5 }\n  triage/architect: { model: claude-opus-5-5, after: [product-manager] }\n  triage/designer: { model: claude-haiku-5-5 }\n  triage/documentation-planner: { model: claude-haiku-5-5, after: [designer] }\n  triage/engineer: { model: claude-sonnet-5-5, after: [architect, documentation-planner] }\n  # timeout covers the whole worker job (agent, tests, fix rounds). tests is your\n  # repo's test command; \"\" turns the test step off. Over diff_warn_lines changed\n  # lines the PR goes ahead with a \"Large change\" note; over diff_max_lines it is\n  # held for a human.\n  workers/engineer: { model: claude-sonnet-5-5, timeout: 60m, tests: make lint test, diff_warn_lines: 2000, diff_max_lines: 3000 }\n  reviewers/eng-review: { model: claude-sonnet-5-5 }\n  reviewers/security-review: { model: claude-opus-5-5 }\n  # Runs only when a dependency manifest or lockfile changes. allowlist.txt in\n  # its directory (or a sidecar's licenses/allowlist.txt) is the license policy.\n  reviewers/license-review: { model: claude-sonnet-5-5, when: { paths: [\"**/go.mod\", \"**/go.sum\", \"**/package.json\", \"**/package-lock.json\", \"**/npm-shrinkwrap.json\"] } }\n  # Runs when the issue had product-manager triage. To also run it for UI\n  # changes, add paths, for example: when: { triage: [product-manager], paths: [\"web/**\", \"ui/**\"] }\n  reviewers/product-manager-review: { model: claude-sonnet-5-5, when: { triage: [product-manager] } }\npackage roles\n\nimport (\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\t\"unicode/utf8\"\n\n\t\"github.com/albertcbrown/ard/internal/agent\"\n\t\"github.com/albertcbrown/ard/internal/closeout\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n)\n\nconst leadPromptPath = \"triage/lead/prompt.txt\"\n\ntype stubRoles map[config.Kind][]string\n\nfunc (s stubRoles) Role(k config.Kind, name string) (config.Role, bool) {\n\tfor _, n := range s[k] {\n\t\tif n == name {\n\t\t\treturn config.Role{Kind: k, Name: name}, true\n\t\t}\n\t}\n\treturn config.Role{}, false\n}\n\nvar leadStubRoles = stubRoles{\n\tconfig.KindTriage:   {\"architect\", \"product-manager\", \"designer\", \"documentation-planner\", \"engineer\"},\n\tconfig.KindWorker:   {\"engineer\"},\n\tconfig.KindReviewer: {\"eng-review\"},\n}\n\nfunc TestEmbeddedLeadLoadsAsTriage(t *testing.T) {\n\tres, err := config.LoadFS(starterFS(t, true), \"/repo\")\n\tif err != nil {\n\t\tt.Fatalf(\"LoadFS: %v\", err)\n\t}\n\tlead, ok := res.Role(config.KindTriage, \"lead\")\n\tif !ok {\n\t\tt.Fatalf(\"no triage role lead in %+v\", res.Roles)\n\t}\n\tif lead.PromptPath != \".ard/triage/lead/prompt.txt\" || lead.Dockerfile != \"\" || lead.Extra != nil || lead.ScanPath != \"\" {\n\t\tt.Errorf(\"unexpected role: %+v\", lead)\n\t}\n\tif lead.Model != \"claude-opus-5-5\" || lead.Timeout != 15*time.Minute || lead.Agent != \"claude\" {\n\t\tt.Errorf(\"model=%q timeout=%v agent=%q\", lead.Model, lead.Timeout, lead.Agent)\n\t}\n\t// Accepted under #84: no Dockerfile, so the lead runs as a host subprocess\n\t// and config check warns. Adding a Dockerfile is a deliberate test change.\n\tfound := false\n\tfor _, r := range res.HostUntrusted() {\n\t\tfound = found || (r.Kind == config.KindTriage && r.Name == \"lead\")\n\t}\n\tif !found {\n\t\tt.Errorf(\"HostUntrusted = %v, want it to include triage/lead\", res.HostUntrusted())\n\t}\n}\n\nfunc TestLeadPromptShape(t *testing.T) {\nscanners/cve:\nDockerfile\nmerge.jq\nscan\n\nscanners/docs:\nDockerfile\ndocscan.go\nscan\n\nscanners/error-codes:\nDockerfile\nerrcodes.jq\nscan\n\nscanners/lint:\nDockerfile\nnormalize.jq\nscan\n\nscanners/lts:\nDockerfile\neol.jq\nproducts.json\nrefs.jq\nscan\n\nscanners/missing-tests:\nDockerfile\nmissingtests.go\nscan\n\nscanners/trufflehog:\nDockerfile\nexclude-paths\nfindings.jq\nscan\n\nscanners/trufflehog-history:\nDockerfile\nexclude-paths\nfindings.jq\nhistory\nscan\nroles_test.go:35:\twant := []string{\"PRODUCT.md\", \"TECH_STACK.md\", \"VISION.md\", \"config.yaml\", \"reviewers/eng-review/prompt.txt\", \"reviewers/license-review/allowlist.txt\", \"reviewers/license-review/prompt.txt\", \"reviewers/product-manager-review/prompt.txt\", \"reviewers/security-review/Dockerfile\", \"reviewers/security-review/aid\", \"reviewers/security-review/normalize.jq\", \"reviewers/security-review/prompt.txt\", \"reviewers/security-review/rules/security.yml\", \"scanners/cve/Dockerfile\", \"scanners/cve/merge.jq\", \"scanners/cve/scan\", \"scanners/docs/Dockerfile\", \"scanners/docs/docscan.go\", \"scanners/docs/scan\", \"scanners/error-codes/Dockerfile\", \"scanners/error-codes/errcodes.jq\", \"scanners/error-codes/scan\", \"scanners/lint/Dockerfile\", \"scanners/lint/normalize.jq\", \"scanners/lint/scan\", \"scanners/lts/Dockerfile\", \"scanners/lts/eol.jq\", \"scanners/lts/products.json\", \"scanners/lts/refs.jq\", \"scanners/lts/scan\", \"scanners/missing-tests/Dockerfile\", \"scanners/missing-tests/missingtests.go\", \"scanners/missing-tests/scan\", \"scanners/trufflehog-history/Dockerfile\", \"scanners/trufflehog-history/exclude-paths\", \"scanners/trufflehog-history/findings.jq\", \"scanners/trufflehog-history/history\", \"scanners/trufflehog-history/scan\", \"scanners/trufflehog/Dockerfile\", \"scanners/trufflehog/exclude-pat