codeError is one invalid line of scanner output.\ntype DecodeError struct {\n\tLine int\n\tMsg  string\n}\n\nfunc (e DecodeError) Error() string { return fmt.Sprintf(\"line %d: %s\", e.Line, e.Msg) }\n\n// DecodeErrors lists the invalid lines of a scanner's output, at most 20.\ntype DecodeErrors []DecodeError\n\nfunc (e DecodeErrors) Error() string {\n\tparts := make([]string, 0, len(e))\n\tfor _, d := range e {\n\t\tparts = append(parts, d.Error())\n\t}\n\treturn \"invalid scanner output: \" + strings.Join(parts, \"; \")\n}\n\n// DecodeFindings parses scanner stdout as JSON lines, strictly: unknown keys,\n// a missing required key, a bad value, a duplicate fingerprint or an\n// oversized line or stream are errors. Blank lines are skipped. It never\n// returns partial findings, so a half-parsed run can never trigger autoclose.\npackage scanner\n\nimport (\n\t\"fmt\"\n\t\"path\"\n\t\"regexp\"\n\t\"strings\"\n)\n\nvar (\n\tllmRuleRe   = regexp.MustCompile(`^[a-z0-9][a-z0-9-]{0,63}$`)\n\tllmPathRe   = regexp.MustCompile(`^[A-Za-z0-9._/@+-]+$`)\n\tllmSymbolRe = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_./-]{0,127}$`)\n)\n\n// ParseLLMFingerprint splits an LLM scanner fingerprint, \"rule:path\" or\n// \"rule:path:symbol\", and reports whether it is well formed. The path must\n// be a clean, relative, repo-style path without \"..\" segments.\nfunc ParseLLMFingerprint(fp string) (rule, p, symbol string, ok bool) {\n\tif len(fp) > MaxFingerprint {\n\t\treturn \"\", \"\", \"\", false\n\t}\n\tparts := strings.Split(fp, \":\")\n\tif len(parts) < 2 || len(parts) > 3 {\n\t\treturn \"\", \"\", \"\", false\n\t}\n\trule, p = parts[0], parts[1]\n\tif len(parts) == 3 {\n\t\tsymbol = parts[2]\n\t\tif !llmSymbolRe.MatchString(symbol) {\n\t\t\treturn \"\", \"\", \"\", false\n\t\t}\n\t}\n\tif !llmRuleRe.MatchString(rule) || !llmPathRe.MatchString(p) {\n\t\treturn \"\", \"\", \"\", false\n\t}\n\tif p == \".\" || strings.HasPrefix(p, \"/\") || path.Clean(p) != p {\n\t\treturn \"\", \"\", \"\", false\n\t}\n\tfor _, seg := range strings.Split(p, \"/\") {\n\t\tif seg == \"..\" {\n\t\t\treturn \"\", \"\", \"\", false\n\t\t}\n\t}\n\treturn rule, p, symbol, true\n}\n\n// CheckLLMFingerprints validates every finding's fingerprint against the LLM\n// grammar, requires its path to be listed in the finding's Files and, via\n// exists, to be present in the repository. A nil exists treats every path as\n// present. Errors carry the 1-based finding index and fixed text only, never\n// the fingerprint or any finding text; at most 20 are returned.\nfunc CheckLLMFingerprints(fs []Finding, exists func(path string) bool) DecodeErrors {\n\tvar errs DecodeErrors\n\tfail := func(i int, msg string) {\n\t\tif len(errs) < maxErrorLines {\n\t\t\terrs = append(errs, DecodeError{Line: i + 1, Msg: msg})\n\t\t}\n\t}\n\tfor i, f := range fs {\n\t\t_, p, _, ok := ParseLLMFingerprint(f.Fingerprint)\n\t\tif !ok {\n\t\t\tfail(i, \"fingerprint is not rule:path[:symbol]\")\n\t\t\tcontinue\n\t\t}\n\t\tlisted := false\n\t\tfor _, file := range f.Files {\n\t\t\tif file == p {\n\t\t\t\tlisted = true\n\t\t\t\tbreak\n| Scanner | Engine | Every | Group size | Auto-close |\n| --- | --- | --- | --- | --- |\n| cve | osv-scanner and govulncheck (trivy and the Dependabot alerts API later) | 6 h | 1 | yes |\n| lts | endoflife.date v1 API + manifests: go.mod, package.json, Dockerfile `FROM`, Helm `values.yaml` images | 7 d | 1 per component (product and cycle) | yes |\n| lint | golangci-lint per Go module (the repo's config, or the role's `golangci.yml`), plus `//nolint` directives, minus the role directory's `baseline` | 24 h | 20 per rule and directory | yes |\n| error-codes | pattern match over source, registry and docs files (`sh` + `jq`) | 24 h | 20 | yes |\n| trufflehog | leaked-credential scan of the current commit (`sh` + `jq` + TruffleHog) | 24 h | 1 | yes |\n| missing-tests | `go test` coverage plus exported functions with no test (`sh` + Go helper) | 24 h | 10 per package | yes |\n| truffl