+\tif err := os.WriteFile(bin, []byte(script), 0o755); err != nil {\n250\t+\t\tt.Fatal(err)\n251\t+\t}\n252\t+\treturn bin, calls\n253\t+}\n254\t+\n255\t+func (f *fixture) withAgentImage(t *testing.T, bin, ref string) {\n256\t+\tt.Helper()\n257\t+\to := f.opts\n258\t+\to.DockerBin, o.AgentImage = bin, ref\n259\t+\tl, err := New(o)\n260\t+\tif err != nil {\n261\t+\t\tt.Fatal(err)\n262\t+\t}\n263\t+\tf.l = l\n264\t+}\n265\t+\n266\t+func TestNewRejectsBadAgentImage(t *testing.T) {\n267\t+\tfor _, ref := range []string{\"ard-agent:dev\", \"-x\", \"a b\", \"sha256:abc\"} {\n268\t+\t\tif _, err := New(Options{Root: t.TempDir(), AgentImage: ref}); err == nil {\n269\t+\t\t\tt.Errorf(\"%q accepted\", ref)\n270\t+\t\t}\n271\t+\t}\n272\t+}\n273\t+\n274\t+func TestPrepareDefaultImage(t *testing.T) {\n275\t+\tf := newFixture(t)\n276\t+\tbin, calls := fakeDocker(t)\n277\t+\tf.withAgentImage(t, bin, \"sha256:0123456789ab\")\n278\t+\th, err := f.l.Prepare(context.Background(), f.job(time.Minute))\n279\t+\tif err != nil {\n280\t+\t\tt.Fatal(err)\n281\t+\t}\n282\t+\tdefer f.l.Cleanup(context.Background(), h, executor.CleanupOptions{})\n283\t+\tif h.Kind != \"docker\" || h.Image != \"sha256:0123456789ab\" || h.Container != \"ard-\"+h.JobID {\n284\t+\t\tt.Errorf(\"handle = %+v\", h)\n285\t+\t}\n286\t+\tif h.View.Work != \"/work\" || h.View.Role != \"/role\" || h.View.ConfigDir != \"/ard-config\" {\n287\t+\t\tt.Errorf(\"view = %+v\", h.View)\n288\t+\t}\n289\t+\tb, _ := os.ReadFile(calls)\n290\t+\tif strings.Contains(string(b), \"pull\") {\n291\t+\t\tt.Errorf(\"local image was pulled: %s\", b)\n292\t+\t}\n293\t+}\n294\t+\n295\t+func TestPrepareDockerfileWins(t *testing.T) {\n296\t+\tf := newFixture(t)\n297\t+\tbin, _ := fakeDocker(t)\n298\t+\tf.withAgentImage(t, bin, testDigestRef)\n299\t+\tos.WriteFile(filepath.Join(f.roleDir, \"Dockerfile\"), []byte(\"FROM scratch\\n\"), 0o644)\n300\t+\tj := f.job(time.Minute)\n301\t+\tj.Dockerfile = filepath.Join(f.roleDir, \"Dockerfile\")\n302\t+\th,