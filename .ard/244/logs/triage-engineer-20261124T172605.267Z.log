tring // config key, for messages\n\tRepo string // \"owner/name\"\n\tRef  string // branch, tag or full 40-hex SHA (gitref.Check)\n}\n\n// File is a worktree-relative file written 0644 by Prepare.\ntype File struct {\n\tPath string\n\tData []byte\n}\n\n// Paths are the locations as the job process sees them. ConfigDir is the\n// job's empty agent-CLI config dir (host: <home>/.claude; Docker:\n// /ard-config); it is empty on a handle stored before it existed.\n//\n// History is the bare clone with all fetched refs, read-only (enforced only by\n// the Docker mount; host mode gives the writable live clone); empty when the\n// job has no History. A Kubernetes executor must supply a read-only copy\n// (for example an init container running git clone --mirror, or a bundle","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_017HxnvMEBcLxpMqGXtyYjb1","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
