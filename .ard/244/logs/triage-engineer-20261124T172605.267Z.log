{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018F15V8ZgbK4h1VLA6uCBFj","type":"tool_result","content":"./Makefile\n./deploy/agent/Dockerfile\n./deploy/test-agent-image.sh\n./internal/servecmd/serve_test.go\n./internal/servecmd/cfgloader.go\n./internal/servecmd/cfgloader_test.go\n./internal/configcmd/config_test.go\n./internal/state/events.go\n./internal/executor/local/hostwarn.go\n./internal/executor/local/hostwarn_test.go\n./docs/runbooks/gate-2.md\n./docs/proposal.md\npackage executor\n\nimport (\n\t\"fmt\"\n\t\"path\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/gitref\"\n\t\"github.com/albertcbrown/ard/internal/repopath\"\n)\n\nvar (\n\tidRE   = regexp.MustCompile(`^[0-9A-Za-z]{1,64}$`)\n\troleRE = regexp.MustCompile(`^[a-z0-9][a-z0-9-]*$`)\n)\n\nvar stages = map[string]bool{\"scanner\": true, \"triage\": true, \"worker\": true, \"review\": true}\n\n// Validate checks the job's fields.\nfunc (j Job) Validate() error {\n\tbad := func(format string, a ...any) error {\n\t\treturn fmt.Errorf(\"%w: %s\", ErrInvalidJob, fmt.Sprintf(format, a...))\n\t}\n\tswitch {\n\tcase !idRE.MatchString(j.ID):\n\t\treturn bad(\"id %q\", j.ID)\n\tcase !validRepo(j.Repo):\n\t\treturn bad(\"repo %q\", j.Repo)\n\tcase j.Issue < 0:\n\t\treturn bad(\"issue %d\", j.Issue)\n\tcase !stages[j.Stage]:\n\t\treturn bad(\"stage %q\", j.Stage)\n\tcase !roleRE.MatchString(j.Role):\n\t\treturn bad(\"role %q\", j.Role)\n\tcase j.Ref == \"\" || strings.HasPrefix(j.Ref, \"-\"):\n\t\treturn bad(\"ref %q\", j.Ref)\n\tcase j.TrustedInput && j.Stage != \"scanner\":\n\t\treturn bad(\"trusted input is only valid for a scanner job\")\n\tcase j.History && j.Stage != \"scanner\":\n\t\treturn bad(\"history is only valid for a scanner job\")\n\tcase j.Timeout <= 0:\n\t\treturn bad(\"timeout %s\", j.Timeout)\n\t}\n\tfor name, p := range map[string]string{\"repo dir\": j.RepoDir, \"role dir\": j.RoleDir} {\n\t\tif !filepath.IsAbs(p) {\n\t\t\treturn bad(\"%s %q is not absolute\", name, p)\n\t\t}\n\t}\n\tfor name, p := range map[string]string{\"dockerfile\": j.Dockerfile} {\n\t\tif p != \"\" && !filepath.IsAbs(p) {\n\t\t\treturn bad(\"%s %q is not absolute\", name, p)\n\t\t}\n\t}\n\tif j.Sidecar != (Sidecar{}) {\n\t\tif !validRepo(j.Sidecar.Repo) {\n\t\t\treturn bad(\"sidecar repo %q\", j.Sidecar.Repo)\n\t\t}\n\t\tif err := gitref.Check(j.Sidecar.Ref); err != nil {\n\t\t\treturn bad(\"sidecar ref: %v\", err)\n\t\t}\n\t}\n\tfor _, f := range j.Inputs {\n\t\tif err := CheckInputPath(f.Path); err != nil {\n\t\t\treturn bad(\"input: %v\", err)\n\t\t}\n\t}\n\tfor _, p := range j.Scrub {\n\t\tfor _, f := range j.Inputs {\n\t\t\tif path.Clean(filepath.ToSlash(f.Path)) == p {\n\t\t\t\treturn bad(\"scrub: %q is also an input\", p)\n\t\t\t}\n\t\t}\n\t\tif err := checkScrubPath(j.Issue, p); err != nil {\n\t\t\treturn bad(\"scrub: %v\", err)\n\t\t}\n\t}\n\treturn nil\n}\n\n// checkScrubPath requires p to be a file directly inside .ard/<issue>/.\nfunc checkScrubPath(issue int, p string) error {\n\tif err := CheckInputPath(p); err != nil {\n\t\treturn err\n\t}\n\tif issue < 1 {\n\t\treturn fmt.Errorf(\"path %q needs an issue\", p)\n\t}\n\tdir := fmt.Sprintf(\".ard/%d\", issue)\n\tif path.Clean(p) != p || path.Dir(p) != dir || path.Base(p) == \"logs\" {\n\t\treturn fmt.Errorf(\"path %q must be a file directly under %s/\", p, dir)\n\t}\n\treturn nil\n}\n\nfunc validRepo(repo string) bool {\n\t_, _, err := repopath.Parts(repo)\n\treturn err == nil\n}\n\n// CheckInputPath rejects absolute paths, \"..\", and anything under .git.\nfunc CheckInputPath(p string) error {\n\tif p == \"\" || path.IsAbs(p) || filepath.IsAbs(p) {\n\t\treturn fmt.Errorf(\"path %q must be relative\", p)\n\t}\n\tc := path.Clean(filepath.ToSlash(p))\n\tif c == \"..\" || strings.HasPrefix(c, \"../\") || strings.Contains(filepath.ToSlash(p), \"..\") {\n\t\treturn fmt.Errorf(\"path %q escapes the worktree\", p)\n\t}\n\tif c == \".git\" || strings.HasPrefix(c, \".git/\") {\n\t\treturn fmt.Errorf(\"path %q is inside .git\", p)\n\t}\n\treturn nil\n}\npackage local\n\nimport (\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/executor\"\n)\n\n// imageTag is a content-addressed tag: it changes when any file or mode in\n// the role directory changes.\nfunc imageTag(stage, role, roleDir string) (string, error) {\n\tvar files []string\n\terr := filepath.WalkDir(roleDir, func(p string, d fs.DirEntry, err error) error {\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif d.Type().IsRegular() {\n\t\t\tfiles = append(files, p)\n\t\t}\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tsort.Strings(files)\n\th := sha256.New()\n\tfor _, p := range files {\n\t\trel, _ := filepath.Rel(roleDir, p)\n\t\tst, err := os.Stat(p)\n\t\tif err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\tb, err := os.ReadFile(p)\n\t\tif err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\tfmt.Fprintf(h, \"%s\\x00%o\\x00%d\\x00\", filepath.ToSlash(rel), st.Mode().Perm(), len(b))\n\t\th.Write(b)\n\t}\n\treturn fmt.Sprintf(\"ard-role-%s-%s:%s\", stage, role, hex.EncodeToString(h.Sum(nil))[:12]), nil\n}\n\n// runArgv builds the `docker run` argv. Secret values never appear: entries\n// in modelEnv are passed by name and the value travels in the CLI's env.\nfunc (l *Local) runArgv(h executor.Handle, cmd executor.Command, stdin bool) []string {\n\ta := []string{\"run\", \"--rm\", \"--name\", h.Container, \"--init\",\n\t\t\"--user\", fmt.Sprintf(\"%d:%d\", os.Getuid(), os.Getgid()),\n\t\t\"--cap-drop\", \"ALL\", \"--security-opt\", \"no-new-privileges\", \"--tmpfs\", \"/tmp\",\n\t\t\"--label\", \"ard.job=\" + h.JobID,\n\t\t\"--label\", \"ard.issue=\" + strconv.Itoa(h.Issue),\n\t\t\"--label\", \"ard.stage=\" + h.Stage,\n\t\t\"--label\", \"ard.role=\" + h.Role,\n\t}\n\twork := h.Worktree + \":/work\"\n\tif h.ReadOnly {\n\t\twork += \":ro\"\n\t}\n\ta = append(a, \"-v\", work, \"-v\", h.RoleDir+\":/role:ro\")\n\tif h.SidecarDir != \"\" {\n\t\ta = append(a, \"-v\", h.SidecarDir+\":/sidecar:ro\")\n\t}\n\tif h.HistoryDir != \"\" {\n\t\t// Never writable. git needs safe.directory for a mount owned by another user.\n\t\ta = append(a, \"-v\", h.HistoryDir+\":/history:ro\",\n\t\t\t\"-e\", \"GIT_CONFIG_COUNT=1\", \"-e\", \"GIT_CONFIG_KEY_0=safe.directory\", \"-e\", \"GIT_CONFIG_VALUE_0=/history\")\n\t}\n\tif h.View.ConfigDir != \"\" {\n\t\ta = append(a, \"-v\", filepath.Join(h.Home, configDirName)+\":/ard-config\")\n\t}\n\ta = append(a, \"-w\", \"/work\", \"-e\", \"HOME=/tmp\", \"-e\", \"LANG=C.UTF-8\", \"-e\", \"GIT_TERMINAL_PROMPT=0\")\n\tfor _, kv := range ardEnv(h) {\n\t\ta = append(a, \"-e\", kv)\n\t}\n\tfor _, kv := range cmd.Fixed {\n\t\ta = append(a, \"-e\", kv)\n\t}\n\tfor _, kv := range cmd.Env {\n\t\tname, _, _ := strings.Cut(kv, \"=\")\n\t\ta = append(a, \"-e\", name)\n\t}\n\tif stdin {\n\t\ta = append(a, \"-i\")\n\t}\n\ta = append(a, h.Image, cmd.Path)\n\treturn append(a, cmd.Args...)\n}\n\nfunc (l *Local) docker(ctx context.Context, args ...string) ([]byte, error) {\n\tc := exec.CommandContext(ctx, l.dockerBin, args...)\n\tc.Env = os.Environ()\n\treturn c.CombinedOutput()\n}\n\n// ensureImage builds the role image unless the tag already exists. Build\n// output is appended to logPath.\nfunc (l *Local) ensureImage(ctx context.Context, j executor.Job, logPath string) (string, error) {\n\ttag, err := imageTag(j.Stage, j.Role, j.RoleDir)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"hash role dir: %w\", err)\n\t}\n\tif _, err := l.docker(ctx, \"image\", \"inspect\", tag); err == nil {\n\t\treturn tag, nil\n\t}\n\tbctx, cancel := context.WithTimeout(ctx, l.buildTimeout)\n\tdefer cancel()\n\tout, err := l.docker(bctx, \"build\", \"-t\", tag, \"-f\", j.Dockerfile, j.RoleDir)\n\tif f, ferr := os.OpenFile(logPath, os.O_APPEND|os.O_WRONLY, 0o600); ferr == nil {\n\t\tf.Write(out)\n\t\tf.Close()\n\t}\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"docker build %s: %w\", tag, err)\n\t}\n\treturn tag, nil\n}\n\nfunc (l *Local) dockerKill(sig string, h executor.Handle) {\n\tctx, cancel := context.WithTimeout(context.Background(), 20e9)\n\tdefer cancel()\n\tl.docker(ctx, \"kill\", \"--signal\", sig, h.Container)\n}\n\nfunc (l *Local) dockerRunning(ctx context.Context, h executor.Handle) bool {\n\tout, err := l.docker(ctx, \"inspect\", \"-f\", \"{{.State.Running}}\", h.Container)\n\treturn err == nil && strings.TrimSpace(string(out)) == \"true\"\n}\npackage local\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/executor\"\n)\n\n// EventHostUntrusted is the slog message of every host-mode warning.\nconst EventHostUntrusted = \"executor.host_untrusted\"\n\nconst hostHint = \"add a Dockerfile to the role directory to run it under Docker\"\n\n// HostReach lists what a host-mode job can reach as the controller's uid.\n// It returns a fresh slice.\nfunc HostReach() []string {\n\treturn []string{\n\t\t\"the GitHub App private key file (ARD_GITHUB_PRIVATE_KEY_FILE) by absolute path\",\n\t\t\"~/.config/gh\",\n\t\t\"write access to the controller's clone (~/.ard/repos/<owner>/<repo>.git)\",\n\t\t\"~/.ard: controller state, config snapshots, the pause file and other jobs' worktrees and logs\",\n\t\t\"undoing chmod a-w on a read-only worktree\",\n\t}\n}\n\n// WarnHostRole logs one WARN for a role that reads untrusted input and has\n// no Dockerfile. kind and name come from config.Role; this package does not\n// import config.\nfunc WarnHostRole(log *slog.Logger, kind, name string) {\n\tlog.Warn(EventHostUntrusted, \"kind\", kind, \"role\", name,\n\t\t\"reaches\", strings.Join(HostReach(), \"; \"), \"hint\", hostHint)\n}\n\n// HostRoleText is the plain-text form of the warning, for writing straight to\n// stderr so it survives --log-level. It ends in a newline.\nfunc HostRoleText(kind, name string) string {\n\treturn fmt.Sprintf(\"WARNING: %s role %q reads untrusted input but has no Dockerfile, so its jobs run as a host subprocess \"+\n\t\t\"under the controller's uid and can reach: %s. Hint: %s.\\n\",\n\t\tkind, name, strings.Join(HostReach(), \"; \"), hostHint)\n}\n\n// hostUntrusted reports whether a started job should warn: host mode and\n// not marked TrustedInput.\nfunc hostUntrusted(h executor.Handle) bool { return h.Kind == \"host\" && !h.TrustedInput }\n\n// warnHostJob logs the per-job WARN and calls OnHostUntrusted. A hook error\n// is logged and does not fail Start: the job is already running.\nfunc (l *Local) warnHostJob(ctx context.Context, h executor.Handle) {\n\tl.log.Warn(EventHostUntrusted, \"job\", h.JobID, \"issue\", h.Issue, \"stage\", h.Stage, \"role\", h.Role,\n\t\t\"reaches\", strings.Join(HostReach(), \"; \"), \"hint\", hostHint)\n\tif l.onHostUntrusted == nil {\n\t\treturn\n\t}\n\tif err := l.onHostUntrusted(ctx, h); err != nil {\n\t\tl.log.Error(\"executor.host_untrusted_not_recorded\", \"job\", h.JobID, \"error\", err)\n\t}\n}\n// Package local is the executor that runs jobs on this host: a detached git\n// worktree, then a host subprocess or an attached `docker run`.\npackage local\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"io/fs\"\n\t\"log/slog\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/executor\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n)\n\n// Options configures Local.\ntype Options struct {\n\tRoot       string    // default $HOME/.ard\n\tGit        gitRunner // default: the git binary on PATH\n\tDockerBin  string    // default \"docker\"\n\tPathEnv    string    // PATH for host jobs; default the controller's PATH\n\tAllowEnv   []string  // model-key names; default ANTHROPIC_API_KEY, CLAUDE_CODE_OAUTH_TOKEN\n\tAllowFixed []string  // names allowed in Command.Fixed; default CLAUDE_CONFIG_DIR, DISABLE_AUTOUPDATER, CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC, CLAUDE_CODE_DISABLE_BACKGROUND_TASKS\n\t// ConfigDirEnv is the Fixed name whose value must equal View.ConfigDir,\n\t// the job's own config dir. Default CLAUDE_CONFIG_DIR.\n\tConfigDirEnv string\n\tKillGrace    time.Duration // default 10s\n\tBuildTimeout time.Duration // default 15m\n\tNow          func() time.Time\n\tLog          *slog.Logger\n\t// OnHostUntrusted, if set, is called once per host-mode job that reads\n\t// untrusted input, right after the process starts. serve records an\n\t// events row through it. nil = log only.\n\tOnHostUntrusted func(ctx context.Context, h executor.Handle) error\n\n\t// Sidecar clone (see sidecar.go).\n\tSidecarGit     sidecarGit               // default gitx.New(\"\")\n\tSidecarURL     func(repo string) string // default https://github.com/<repo>.git\n\tSidecarToken   gitx.TokenFunc           // nil = no auth header (local remotes in tests)\n\tSidecarTimeout time.Duration            // init + fetch + export bound; default 2m\n\n\t// CloneDir, if set, is the only repository Cleanup runs git worktree\n\t// admin in. A handle whose RepoDir differs (stored before #113, when\n\t// RepoDir was the operator's checkout) has its worktree made writable and\n\t// removed with os.RemoveAll, with no git call, and one\n\t// executor.cleanup_foreign_repo Info log. \"\" = always use h.RepoDir.\n\tCloneDir string\n}\n\n// Local implements executor.Executor on this host.\ntype Local struct {\n\troot, dockerBin, pathEnv string\n\tgit                      gitRunner\n\tallowEnv, allowFixed     map[string]bool\n\tconfigDirEnv             string\n\tgrace, buildTimeout      time.Duration\n\tnow                      func() time.Time\n\tlog                      *slog.Logger\n\tonHostUntrusted          func(ctx context.Context, h executor.Handle) error\n\n\tsgit           sidecarGit\n\tsidecarURL     func(repo string) string\n\tsidecarToken   gitx.TokenFunc\n\tsidecarTimeout time.Duration\n\tcloneDir   