{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q3h9qWtWircjmXPQjnM78V","type":"tool_result","content":"// RoleBudgetUSDPerDay is the role's own daily cap in USD. set is false when\n// the role has no override (an override of 0 or less counts as unset); then\n// only the repo-wide Resolved.BudgetUSDPerDay applies to it.\nfunc (r *Resolved) RoleBudgetUSDPerDay(role Role) (cap float64, set bool) {\n\tif role.BudgetUSDPerDay > 0 {\n\t\treturn role.BudgetUSDPerDay, true\n\t}\n\treturn 0, false\n}\n\n// HostUntrusted returns the roles that read untrusted input and have no\n// Dockerfile, so the local executor runs them as a host subprocess under the\n// controller's uid. Canonical order (kind, then name). It returns nothing\n// when Executor is \"k8s\", where host mode does not exist.\nfunc (r *Resolved) HostUntrusted() []Role {\n\tif r.Executor == \"k8s\" {\n\t\treturn nil\n\t}\n\tvar out []Role\n\tfor _, role := range r.Roles {\n\t\tif role.ReadsUntrusted() && role.Dockerfile == \"\" {\n\t\t\tout = append(out, role)\n\t\t}\n\t}\n\treturn out\n}\n\n// SidecarFor returns the sidecar the role mounts; ok is false when it has none.\n// Loops set executor.Sidecar.Name from role.Sidecar so errors name the key.\nfunc (r *Resolved) SidecarFor(role Role) (sc Sidecar, ok bool) {\n\tif role.Sidecar == \"\" {\n\t\treturn Sidecar{}, false\n\t}\n\tsc, ok = r.Sidecars[role.Sidecar]\n\treturn sc, ok\n}\n\n// RolesOf returns every role of the given kind, in canonical order.\nfunc (r *Resolved) RolesOf(k Kind) []Role {\n\tvar out []Role\n\t\treturn fmt.Errorf(\"ard config check: %w\", err)\n\t}\n\troot, err := config.RepoRoot(e.ConfigPath)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard config check: %w\", err)\n\t}\n\tvar res *config.Resolved\n\tvar loadErr error\n\tif o.Ref == \"\" {\n\t\tres, loadErr = config.Load(root)\n\t} else if res, loadErr, err = loadRef(ctx, root, o.Ref); err != nil {\n\t\treturn err\n\t}\n\tif res != nil {\n\t\tif ie := intakeErr(res); ie != nil {\n\t\t\tloadErr = errors.Join(loadErr, ie)\n\t\t}\n\t\tfor _, r := range res.HostUntrusted() {\n\t\t\tlocal.WarnHostRole(e.Log, string(r.Kind), r.Name)\n\t\t\t// Loud: also straight to stderr, whatever --log-level says.\n\t\t\tfmt.Fprint(e.Stderr, local.HostRoleText(string(r.Kind), r.Name))\n\t\t}\n\t\tif allReviewersGated(res) {\n\t\t\tfmt.Fprintln(e.Stderr, \"ard config check: warning: every reviewer has a when: rule, so a PR that matches none of them gets no review and stays a draft\")\n\t\t}\n\t\tif yamlErr := res.WriteYAML(e.Stdout); yamlErr != nil {\n\t\t\tfmt.Fprintf(e.Stderr, \"ard config check: rendering resolved config: %v\\n\", yamlErr)\n\t\t}\n\t}\n\treturn loadErr\n}\n\n// allReviewersGated reports whether reviewer roles exist and each has a when:\n// rule.\nfunc allReviewersGated(res *config.Resolved) bool {\n\trs := res.RolesOf(config.KindReviewer)\n\tfor _, r := range rs {\n\t\tif r.When == nil {\n\t\t\treturn false\n\t\t}\n\t}\n// maxConfigErrorBytes caps the error text posted to the status issue.\nconst maxConfigErrorBytes = 4000\n\ntype commenter interface {\n\tCreateComment(ctx context.Context, n int, body string) (github.Comment, error)\n}\n\n// cfgLoader loads config through a configsrc.Source and, when the load fails,\n// tells the status issue once per distinct error. A successful load clears\n// the memory, so the same failure after a recovery is reported again. It is\n// safe for concurrent use: every loop calls it each tick.\ntype cfgLoader struct {\n\tsrc *configsrc.Source\n\tfx  commenter\n\tlog *slog.Logger\n\t// stderr receives the host-mode warning in plain text, so it survives\n\t// --log-level. nil = log only.\n\tstderr io.Writer\n\tissue  func() int // the status issue number; <= 0 when unknown or synthetic\n\t// paths replaces the controller host's paths in the error text posted to\n\t// the status issue. nil = post a fixed message, never the error.\n\tpaths *redact.Secrets\n\n\tmu   sync.Mutex\n\tlast string // the last error text posted\n\t// warned holds the roles already warned about as host-mode, by kind/name.\n\twarned map[string]bool\n\t// badIntake holds the invalid intake labels already logged.\n\tbadIntake map[string]bool\n}\n\nfunc (c *cfgLoader) Load(ctx context.Context) (*config.Resolved, error) {\n\tres, err := c.src.Load(ctx)\n\tif err != nil {\n\t\tc.report(ctx, err)\n\t\treturn nil, err\n\t}\n\tc.mu.Lock()\n\tc.last = \"\"\n\tc.mu.Unlock()\n\tc.warnHost(res)\n\tc.warnIntake(res)\n\treturn res, nil\n}\n\n// warnHost logs executor.host_untrusted once per role per process, and writes\n// it to stderr: at the first successful load (startup, or the first tick\n// after a startup that could not load) and for any role a later config adds.\nfunc (c *cfgLoader) warnHost(res *config.Resolved) {\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\tfor _, r := range res.HostUntrusted() {\n\t\tkey := string(r.Kind) + \"/\" + r.Name\n\t\tif c.warned[key] {\n\t\t\tcontinue\n\t\t}\n\t\tif c.warned == nil {\n\t\t\tc.warned = map[string]bool{}\n\t\t}\n\t\tc.warned[key] = true\n\t\tlocal.WarnHostRole(c.log, string(r.Kind), r.Name)\n\t\tif c.stderr != nil {\n\t\t\tfmt.Fprint(c.stderr, local.HostRoleText(string(r.Kind), r.Name))\n\t\t}\n\t}\n}\n\n// warnIntake logs config.intake_invalid once per distinct invalid intake\n// label. The config still loads: intake.Admit skips every issue instead.\nfunc (c *cfgLoader) warnIntake(res *config.Resolved) {\n\tif res.Intake.Mode != config.IntakeLabel {\n\t\treturn\n\t}\n\terr := labels.CheckIntake(res.Intake.Label)\n\tif err == nil {\n\t\treturn\n\t}\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\tif c.badIntake[res.Intake.Label] {\n\t\treturn\n223:\tloader := &cfgLoader{paths: paths, src: src, fx: d.Effects, log: log, stderr: e.Stderr, issue: func() int { return int(w.statusIssue.Load()) }}\n224-\n225-\t// An origin/main whose config cannot be loaded does not abort startup:\n226-\t// serve starts paused, tells the status issue, and retries every tick.\n227-\t