ntImage(t, bin, \"sha256:0123456789ab\")\n260\t+\th, err := f.l.Prepare(context.Background(), f.job(time.Minute))\n261\t+\tif err != nil {\n262\t+\t\tt.Fatal(err)\n263\t+\t}\n264\t+\tdefer f.l.Cleanup(context.Background(), h, executor.CleanupOptions{})\n265\t+\tif h.Kind != \"docker\" || h.Image != \"sha256:0123456789ab\" || h.Container != \"ard-\"+h.JobID {\n266\t+\t\tt.Errorf(\"handle = %+v\", h)\n267\t+\t}\n268\t+\tif h.View.Work != \"/work\" || h.View.Role != \"/role\" || h.View.ConfigDir != \"/ard-config\" {\n269\t+\t\tt.Errorf(\"view = %+v\", h.View)\n270\t+\t}\n271\t+\tb, _ := os.ReadFile(calls)\n272\t+\tif strings.Contains(string(b), \"pull\") {\n273\t+\t\tt.Errorf(\"local image was pulled: %s\", b)\n274\t+\t}\n275\t+}\n276\t+\n277\t+func TestPrepareDockerfileWins(t *testing.T) {\n278\t+\tf := newFixture(t)\n279\t+\tbin, _ := fakeDocker(t)\n280\t+\tf.withAgentImage(t, bin, testDigestRef)\n281\t+\tos.WriteFile(filepath.Join(f.roleDir, \"Dockerfile\"), []byte(\"FROM scratch\\n\"), 0o644)\n282\t+\tj := f.job(time.Minute)\n283\t+\tj.Dockerfile = filepath.Join(f.roleDir, \"Dockerfile\")\n284\t+\th, err := f.l.Prepare(context.Background(), j)\n285\t+\tif err != nil {\n286\t+\t\tt.Fatal(err)\n287\t+\t}\n288\t+\tdefer f.l.Cleanup(context.Background(), h, executor.CleanupOptions{})\n289\t+\tif h.Kind != \"docker\" || !strings.HasPrefix(h.Image, \"ard-role-\") {\n290\t+\t\tt.Errorf(\"handle = %+v\", h)\n291\t+\t}\n292\t+}\n293\t+\n294\t+func TestPrepareTrustedScannerStaysHost(t *testing.T) {\n295\t+\tf := newFixture(t)\n296\t+\tbin, calls := fakeDocker(t)\n297\t+\tf.withAgentImage(t, bin, testDigestRef)\n298\t+\tj := f.job(time.Minute)\n299\t+\tj.Stage, j.TrustedInput = \"scanner\", true\n300\t+\th, err := f.l.Prepare(context.Background(), j)\n301\t+\tif err != nil {\n302\t+\t\tt.Fatal(err)\n303\t+\t}\n304\t+\tdefer f.l.Cleanup(context.Background(), h, executor.CleanupOptions{})\n305\t+\tif h.Kind != \"host\" {\n306\t+\t\tt.Errorf(\"kind = %q\", h.Kind)\n307\t+\t}\n308\t+\tif _, err := os.Stat(calls); err == nil {\n309\t+\t\tt.Error(\"docker was called\")\n310\t+\t}\n311\t+}\n312\t+\n313\t+func TestPrepareUnsetUnchanged(t *testing.T) {\n314\t+\tf := newFixture(t)\n315\t+\th, err := f.l.Prepare(context.Background(), f.job(time.Minute))\n316\t+\tif err != nil {\n317\t+\t\tt.Fatal(err)\n318\t+\t}\n319\t+\tdefer f.l.Cleanup(context.Background(), h, executor.CleanupOptions{})\n320\t+\tif h.Kind != \"host\" {\n321\t+\t\tt.Errorf(\"kind = %q\", h.Kind)\n322\t+\t}\n323\t+}\n324\t+\n325\t+func TestPrepareDockerDownNoFallback(t *testing.T) {\n326\t+\tf := newFixture(t)\n327\t+\tbin, _ := fakeDocker(t, \"all\")\n328\t+\tf.withAgentImage(t, bin, testDigestRef)\n329\t+\tj := f.job(time.Minute)\n330\t+\th, err := f.l.Prepare(context.Background(), j)\n331\t+\tif err == nil {\n332\t+\t\tt.Fatal(\"Prepare succeeded with Docker down\")\n333\t+\t}\n334\t+\tif h.Kind == \"host\" {\n335\t+\t\tt.Error(\"fell back to host mode\")\n336\t+\t}\n337\t+\tif _, err := os.Stat(mustWT(t, f.l, j)); !os.IsNotExist(err) {\n338\t+\t\tt.Error(\"worktree left behind\")\n339\t+\t}\n340\t+}\n341\t+\n342\t+func TestEnsurePulled(t *testing.T) {\n343\t+\tctx := context.Background()\n344\t+\tlog := filepath.Join(t.TempDir(), \"log\")\n345\t+\tos.WriteFile(log, nil, 0o600)\n346\t+\n347\t+\tbin, calls := fakeDocker(t)\n348\t+\tl, _ := New(Options{Root: t.TempDir(), DockerBin: bin})\n349\t+\tif err := l.ensurePulled(ctx, testDigestRef, log); err != nil {\n350\t+\t\tt.Fatal(err)\n351\t+\t}\n352\t+\tif b, _ := os.ReadFile(calls); strings.Contains(string(b), \"pull\") {\n353\t+\t\tt.Errorf(\"present image pulled: %s\", b)\n354\t+\t}\n355\t+\n356\t+\tbin, calls = fakeDocker(t, \"inspect\")\n357\t+\tl, _ = New(Options{Root: t.TempDir(), DockerBin: bin})\n358\t+\tif err := l.ensurePulled(ctx, testDigestRef, log); err != nil {\n359\t+\t\tt.Fatal(err)\n360\t+\t}\n361\t+\tif b, _ := os.ReadFile(calls); !strings.Contains(string(b), \"pull \"+testDigestRef) {\n362\t+\t\tt.Errorf(\"no pull: %s\", b)\n363\t+\t}\n364\t+\n365\t+\tbin, _ = fakeDocker(t, \"inspect\", \"pull\")\n366\t+\tl, _ = New(Options{Root: t.TempDir(), DockerBin: bin})\n367\t+\tif err := l.ensurePulled(ctx, testDigestRef, log); err == nil {\n368\t+\t\tt.Error(\"pull failure not reported\")\n369\t+\t}\n370\t+\tif err := l.ensurePulled(ctx, \"sha256:0123456789ab\", log); err == nil {\n371\t+\t\tt.Error(\"missing local image ID not reported\")\n372\t+\t}\n373\t+}\n374\t+\n375\t+func TestRunArgvBuildvcsFlag(t *testing.T) {\n376\t+\tl, _ := New(Options{Root: \"/r\"})\n377\t+\th := executor.Handle{JobID: \"J\", Container: \"ard-J\", Image: \"sha256:0123456789ab\", Worktree: \"/r/w\", RoleDir: \"/role\",\n378\t+\t\tRepoDir: \"/r/repos/o/r.git\"}\n379\t+\tjoined := strings.Join(l.runArgv(h, executor.Command{Path: \"/role/x\"}, false), \" \")\n380\t+\tfor _, w := range []string{\"GOFLAGS=-buildvcs=false\", \"--cap-drop ALL\", \"no-new-privileges\"} {\n381\t+\t\tif !strings.Contains(joined, w) {\n382\t+\t\t\tt.Errorf(\"missing %q\", w)\n383\t+\t\t}\n384\t+\t}\n385\t+\tif strings.Contains(joined, h.RepoDir) {\n386\t+\t\tt.Errorf(\"controller clone mounted: %s\", joined)\n387\t+\t}\n388\t+}\n389\tdiff --git a/internal/executor/local/docker.go b/internal/executor/local/docker.go\n390\tindex 586254d..3af5c9c 100644\n391\t--- a/internal/executor/local/docker.go\n392\t+++ b/internal/executor/local/docker.go\n393\t@@ -77,7 +77,7 @@ func (l *Local) runArgv(h executor.Handle, cmd executor.Command, stdin bool) []s\n394\t \tif h.View.ConfigDir != \"\" {\n395\t \t\ta = append(a, \"-v\", filepath.Join(h.Home, configDirName)+\":/ard-config\")\n396\t \t}\n397\t-\ta = append(a, \"-w\", \"/work\", \"-e\", \"HOME=/tmp\", \"-e\", \"LANG=C.UTF-8\", \"-e\", \"GIT_TERMINAL_PROMPT=0\")\n398\t+\ta = append(a, \"-w\", \"/work\", \"-e\", \"HOME=/tmp\", \"-e\", \"GOFLAGS=-buildvcs=false\", \"-e\", \"LANG=C.UTF-8\", \"-e\", \"GIT_TERMINAL_PROMPT=0\")\n399\t \tfor _, kv := range ardEnv(h) {\n400\t \t\ta = append(a, \"-