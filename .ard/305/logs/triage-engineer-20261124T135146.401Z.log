{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018JSRAyrFkhDiWghiuuR3MU","type":"tool_result","content":"// Package state is the controller's local SQLite state: jobs, attempts, events\n// and a small key/value table. It is storage only; policy belongs to callers.\n// Local state is not a GitHub side effect, so it does not go through effects;\n// dry-run isolation comes from a separate directory (see Dir).\npackage state\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/repopath\"\n)\n\n// Dir returns <root>/state[-dryrun]/<owner>/<repo> for repo \"owner/name\", both\n// parts lowercased (see repopath). Nested so \"a-b/c\" and \"a/b-c\" never share.\nfunc Dir(root, repo string, dryRun bool) (string, error) {\n\tbase := \"state\"\n\tif dryRun {\n\t\tbase = \"state-dryrun\"\n\t}\n\td, err := repopath.Join(filepath.Join(root, base), repo)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"state dir: %w\", err)\n\t}\n\treturn d, nil\n}\n\n// ErrLegacyDir means a pre-#82 flat state directory exists for the repo.\nvar ErrLegacyDir = errors.New(\"legacy flat state directory\")\n\n// CheckLegacy returns an error wrapping ErrLegacyDir when root/state/ or\n// root/state-dryrun/ holds a flat <owner>-<name> directory for repo. It\n// creates nothing. Nothing ever writes a file directly into\n// state[-dryrun]/<owner>/, so a directory that directly holds a file is a\n// legacy one; a directory holding only subdirectories is the owner directory\n// of another repo (for example state/a-b/ for a-b/c, when checking a/b).\nfunc CheckLegacy(root, repo string) error {\n\towner, name, err := repopath.Parts(repo)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"legacy state check: %w\", err)\n\t}\n\twant := owner + \"-\" + name\n\tfor _, base := range []string{\"state\", \"state-dryrun\"} {\n\t\tnd, err := Dir(root, repo, base == \"state-dryrun\")\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"legacy state check: %w\", err)\n\t\t}\n\t\tbaseDir := filepath.Join(root, base)\n\t\tentries, err := os.ReadDir(baseDir)\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\tcontinue\n\t\t}\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"legacy state check: %w\", err)\n\t\t}\n\t\tfor _, e := range entries {\n\t\t\tif !e.IsDir() || !strings.EqualFold(e.Name(), want) {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\told := filepath.Join(baseDir, e.Name())\n\t\t\tsub, err := os.ReadDir(old)\n\t\t\tif err != nil {\n\t\t\t\treturn fmt.Errorf(\"legacy state check: %w\", err)\n\t\t\t}\n\t\t\tfor _, s := range sub {\n\t\t\t\tif !s.IsDir() {\n\t\t\t\t\treturn fmt.Errorf(\"%w: found %s (from an older ard; it may belong to %s or another repo with the same dashed name). This version uses %s. Move or remove it by hand; ard does not migrate it (#82)\",\n\t\t\t\t\t\tErrLegacyDir, old, repo, nd)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn nil\n}\n\n// EnsureDir creates dir with mode 0700.\nfunc EnsureDir(dir string) error {\n\tif err := os.MkdirAll(dir, 0o700); err != nil {\n\t\treturn fmt.Errorf(\"create state dir %s: %w\", dir, err)\n\t}\n\tif err := os.Chmod(dir, 0o700); err != nil {\n\t\treturn fmt.Errorf(\"chmod state dir %s: %w\", dir, err)\n\t}\n\treturn nil\n}\n// Leader is a held leader lock. The lock dies with the process, so a crashed\n// controller never leaves a stale lock behind.\ntype Leader struct {\n\tf    *os.File\n\tpath string\n}\n\n// LockPath returns <home>/.ard/locks/<owner>/<repo>.lock, lowercased. It is\n// the same in dry-run and live mode, so the two exclude each other on one\n// repo. The directory must be on a local filesystem: flock is unreliable on\n// network filesystems.\nfunc LockPath(home, owner, repo string) (string, error) {\n\tp, err := repopath.Join(filepath.Join(home, \".ard\", \"locks\"), owner+\"/\"+repo)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"leader lock: %w\", err)\n\t}\n\treturn p + \".lock\", nil\n}\n\n// AcquireLeader takes an exclusive, non-blocking flock on path. When another\n// holder has it, the error wraps ErrLeaderHeld and names the holder.\nfunc AcquireLeader(path string) (*Leader, error) {\n\tif err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {\n\t\treturn nil, fmt.Errorf(\"leader lock: create %s: %w\", filepath.Dir(path), err)\n\t}\n\tf, err := os.OpenFile(path, os.O_RDWR|os.O_CREATE, 0o600)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"leader lock: open %s: %w\", path, err)\n\t}\n\tif err := syscall.Flock(int(f.Fd()), syscall.LOCK_EX|syscall.LOCK_NB); err != nil {\n\t\tdefer f.Close()\n\t\tif errors.Is(err, syscall.EWOULDBLOCK) {\n\t\t\treturn nil, fmt.Errorf(\"%w: %s\", ErrLeaderHeld, holder(path))\n\t\t}\n\t\treturn nil, fmt.Errorf(\"leader lock: flock %s: %w\", path, err)\n\t}\n\thost, _ := os.Hostname()\n\tif err := f.Truncate(0); err == nil {\n\t\tfmt.Fprintf(f, \"pid=%d host=%s started=%s\\n\", os.Getpid(), host, time.Now().UTC().Format(time.RFC3339))\n\t}\n\treturn &Leader{f: f, path: path}, nil\n}\n\n// holder describes the lock holder from the lock file, or says it is unknown\n// (for example while the holder is mid-write).\nfunc holder(path string) string {\n\tb, err := os.ReadFile(path)\n\ts := strings.TrimSpace(string(b))\n\tif err != nil || !strings.HasPrefix(s, \"pid=\") {\n\t\treturn fmt.Sprintf(\"holder unknown (%s)\", path)\n\t}\n\t\tdefer d.Close()\n\t}\n\n\tlog := e.Log\n\t// The controller's own bare clone: every config fetch, committer lane and\n\t// executor worktree uses it, never the operator's checkout (#113).\n\tclone, err := openClone(ctx, gitx.New(\"\"), home, repo, d.RemoteURL, d.Token, log)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard serve: %w\", err)\n\t}\n\t// Config comes from origin/main, not from the working tree (#87): a merged\n\t// change applies on the next tick without a pull, and every job of a tick\n\t// runs against one commit.\n\tcacheDir, err := repopath.Join(filepath.Join(home, \".ard\", \"config\"), repo.String())\n\