{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011ChPJd9mikzsh3Vee7STS9","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01B8XNoff6b6t4F7ZQP2Cfv3","name":"Bash","input":{"command":"mkdir -p internal/jobpod && cd internal/jobpod\ncat > contract.go <<'E'\n// Package jobpod is the single contract between the controller and a job's\n// pod under the Kubernetes executor: container names, paths, Secret items, the\n// input manifest, the result route and the naming rules. The executor code and\n// the pod-side code both import it and never each other. It imports only\n// executor and gitref.\npackage jobpod\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/executor\"\n)\n\n// Containers.\nconst (\n\tContainerPre   = \"pre\"\n\tContainerAgent = \"agent\"\n\tContainerPost  = \"post\"\n)\n\n// Identities. GID is the pod's fsGroup.\nconst (\n\tAgentUID   = 65532\n\tSidecarUID = 65533 // pre and post\n\tGID        = 65532\n)\n\n// Volume mounts.\nconst (\n\tMountWork   = \"/work\"    // tree without .git; pre rw, agent rw or ro, post ro\n\tMountJob    = \"/job\"     // pre and agent\n\tMountOut    = \"/out\"     // agent rw, post ro\n\tMountCtl    = \"/ctl\"     // pre only: git dirs and pre's HOME\n\tMountBin    = \"/ard-bin\" // pre rw, agent ro\n\tMountTmp    = \"/tmp\"     // agent only\n\tJobHome     = \"/job/home\"\n\tJobRole     = \"/job/role\"\n\tJobSidecar  = \"/job/sidecar\"\n\tJobHistory  = \"/job/history\"\n\tAgentBin    = \"/ard-bin/ard\"\n\tAgentTmpDir = \"/tmp\"\n)\n\n// Volume names.\nconst (\n\tVolWork = \"work\"\n\tVolJob  = \"job\"\n\tVolOut  = \"out\"\n\tVolCtl  = \"ctl\"\n\tVolBin  = \"ard-bin\"\n\tVolTmp  = \"tmp\"\n)\n\n// AgentPaths is the job's view from inside the agent container.\nvar AgentPaths = executor.Paths{\n\tWork:      MountWork,\n\tRole:      JobRole,\n\tSidecar:   JobSidecar,\n\tConfigDir: JobHome + \"/.claude\",\n\tHistory:   JobHistory,\n}\n\n// Secret items. The Secret is named PodName(id), one per job.\nconst (\n\tItemManifest = \"manifest.json\" // pre only\n\tItemToken    = \"token\"         // pre only\n\tItemKey      = \"result-key\"    // post only\n\n\tPreSecretDir  = \"/var/run/ard/pre\"\n\tPostSecretDir = \"/var/run/ard/post\"\n\tSecretMode    = 0o440\n\n\tEnvAPIKey     = \"ANTHROPIC_API_KEY\"\n\tEnvOAuthToken = \"CLAUDE_CODE_OAUTH_TOKEN\"\n)\n\n// Result route, served by post on the pod IP.\nconst (\n\tResultPort     = 8080\n\tResultPortName = \"ard-result\"\n\tResultPath     = \"/v1/result\"\n\tAuthHeader     = \"Authorization\" // value \"Bearer <key>\"\n\tAuthScheme     = \"Bearer \"\n)\n\n// Result archive (gzip tar) and marker.\nconst (\n\tRootWork   = \"work\"\n\tRootOut    = \"out\"\n\tStdoutName = \"stdout\"\n\tDoneName   = \"done\" // in /out, never packed\n)\n\n// Exit codes of pre; a short reason goes to /dev/termination-log.\nconst (\n\tExitTransient = 1\n\tExitPermanent = 3 // a retry cannot help\n)\n\n// Names and labels.\nconst (\n\tPodPrefix = \"ard-job-\"\n\tMaxJobID  = 63 - len(PodPrefix)\n\n\tComponentJob = \"ard-job\"\n\n\tLabelPartOf    = \"app.kubernetes.io/part-of\"\n\tLabelComponent = \"app.kubernetes.io/component\"\n\tLabelInstance  = \"app.kubernetes.io/instance\"\n\tLabelRepo      = \"ard.albertcbrown/repo\"\n\tLabelNetwork   = \"ard.albertcbrown/network\"\n\tLabelJob       = \"ard.albertcbrown/job\"\n\tLabelIssue     = \"ard.albertcbrown/issue\"\n\tLabelStage     = \"ard.albertcbrown/stage\"\n\tLabelRole      = \"ard.albertcbrown/role\"\n)\n\n// PodName is the pod and Secret name for a job id (ULIDs are case-insensitive).\nfunc PodName(id string) string { return PodPrefix + strings.ToLower(id) }\n\n// RepoLabel is a label-safe value for a repo: 16 hex of sha256 of the\n// lowercased \"owner/name\".\nfunc RepoLabel(repo string) string {\n\tsum := sha256.Sum256([]byte(strings.ToLower(repo)))\n\treturn hex.EncodeToString(sum[:8])\n}\n\n// LabelValue makes s a valid label value of at most 63 characters. A value\n// that fits and is already valid is returned as is; otherwise invalid\n// characters become \"_\" and a long value is cut and ends in a short hash.\nfunc LabelValue(s string) string {\n\tb := []byte(s)\n\tchanged := false\n\tfor i, c := range b {\n\t\tif !labelChar(c) {\n\t\t\tb[i] = '_'\n\t\t\tchanged = true\n\t\t}\n\t}\n\tv := string(b)\n\tif len(v) <= 63 && !changed {\n\t\treturn trimLabel(v)\n\t}\n\tsum := sha256.Sum256([]byte(s))\n\th := hex.EncodeToString(sum[:4])\n\tif len(v) > 63-1-len(h) {\n\t\tv = v[:63-1-len(h)]\n\t}\n\treturn trimLabel(v) + \"-\" + h\n}\n\nfunc labelChar(c byte) bool {\n\treturn c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '-' || c == '_' || c == '.'\n}\n\nfunc trimLabel(v string) string {\n\treturn strings.Trim(v, \"-_.\")\n}\nE\ncat > manifest.go <<'E'\npackage jobpod\n\nimport (\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"path\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/executor\"\n\t\"github.com/albertcbrown/ard/internal/gitref\"\n)\n\n// ManifestVersion is the only accepted Manifest.V.\nconst ManifestVersion = 1\n\n// MaxManifestBytes caps the encoded manifest: base64 in JSON grows inputs by a\n// third and a Secret holds at most 1 MiB.\nconst MaxManifestBytes = 768 << 10\n\n// ErrTooLarge means the encoded manifest is over MaxManifestBytes.\nvar ErrTooLarge = errors.New(\"jobpod: manifest too large\")\n\n// Source is a repository tree at a pinned commit.\ntype Source struct {\n\tRepo string // owner/name\n\tSHA  string // 40 hex\n\tPath string // directory in the repo; unused for sidecars\n}\n\n// Manifest tells pre what to build.\ntype Manifest struct {\n\tV        int\n\tRepo     string // owner/name\n\tBaseSHA  string\n\tHistory  bool\n\tReadOnly bool\n\tRole     Source  // role dir at the config commit\n\tSidecar  *Source // pinned SHA\n\tScrub    []string\n\tInputs   []executor.File\n}\n\n// Encode validates and