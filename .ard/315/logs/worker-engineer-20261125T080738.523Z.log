} {\n\t\tif s == \".\" || s == \"..\" || strings.ContainsAny(s, \" \\t\\r\\n\\x00\\\\\") {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\n// cleanRel reports whether p is a non-empty, clean, relative path inside its root.\nfunc cleanRel(p string) bool {\n\tif p == \"\" || strings.ContainsAny(p, \"\\x00\\\\\") || path.IsAbs(p) {\n\t\treturn false\n\t}\n\tc := path.Clean(p)\n\treturn c == p && c != \".\" && c != \"..\" && !strings.HasPrefix(c, \"../\")\n}\nE\ncat > secret.go <<'E'\npackage jobpod\n\nimport (\n\t\"crypto/rand\"\n\t\"crypto/sha256\"\n\t\"crypto/subtle\"\n\t\"encoding/base64\"\n\t\"fmt\"\n)\n\n// NewKey returns a fresh 32-byte result key, raw base64url.\nfunc NewKey() (string, error) {\n\tb := make([]byte, 32)\n\tif _, err := rand.Read(b); err != nil {\n\t\treturn \"\", fmt.Errorf(\"jobpod: key: %w\", err)\n\t}\n\treturn base64.RawURLEncoding.EncodeToString(b), nil\n}\n\n// SecretData builds the per-job Secret's items. modelName must be one of the\n// two model credential variables the cluster policy allows.\nfunc SecretData(manifest []byte, token, key, modelName, modelValue string) (map[string][]byte, error) {\n\tif modelName != EnvAPIKey && modelName != EnvOAuthToken {\n\t\treturn nil, fmt.Errorf(\"jobpod: model credential name %q not allowed\", modelName)\n\t}\n\treturn map[string][]byte{\n\t\tItemManifest: manifest,\n\t\tItemToken:    []byte(token),\n\t\tItemKey:      []byte(key),\n\t\tmodelName:    []byte(modelValue),\n\t}, nil\n}\n\n// KeyMatches compares keys in constant time (over their sha256 sums). An empty\n// want never matches.\nfunc KeyMatches(got, want string) bool {\n\tif want == \"\" {\n\t\treturn false\n\t}\n\tg, w := sha256.Sum256([]byte(got)), sha256.Sum256([]byte(want))\n\treturn subtle.ConstantTimeCompare(g[:], w[:]) == 1\n}\nE\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":338,"cache_read_input_tokens":41926,