th: \".ard/workers/engineer\"},\n\t\tSidecar: &Source{Repo: \"o/side\", SHA: sha},\n\t\tScrub:   []string{\".ard-input\"},\n\t\tInputs:  []executor.File{{Path: \".ard-input/1/issue.md\", Data: []byte(\"hi\")}},\n\t}\n}\n\nfunc TestManifestRoundTrip(t *testing.T) {\n\tm := valid()\n\tb, err := Encode(m)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgot, err := Decode(b)\n\tif err != nil || !reflect.DeepEqual(got, m) {\n\t\tt.Fatalf(\"got %+v, %v\", got, err)\n\t}\n}\n\nfunc TestManifestSizeCap(t *testing.T) {\n\tm := valid()\n\tm.Inputs = []executor.File{{Path: \"a\", Data: nil}}\n\tbase, err := Encode(m)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// Base64 grows 3 bytes to 4; find a payload whose encoding is exactly at\n\t// the cap, then one byte more.\n\tn := (MaxManifestBytes - len(base)) / 4 * 3\n\tm.Inputs[0].Data = make([]byte, n)\n\tb, err := Encode(m)\n\tif err != nil {\n\t\tt.Fatalf(\"under cap: %v\", err)\n\t}\n\tm.Inputs[0].Data = make([]byte, n+3*(MaxManifestBytes-len(b))/4+3)\n\tif _, err := Encode(m); !errors.Is(err, ErrTooLarge) {\n\t\tt.Fatalf(\"over cap: %v\", err)\n\t}\n\tif _, err := Decode(make([]byte, MaxManifestBytes+1)); !errors.Is(err, ErrTooLarge) {\n\t\tt.Fatalf(\"decode over cap: %v\", err)\n\t}\n}\n\nfunc TestManifestRefuses(t *testing.T) {\n\tfor name, mut := range map[string]func(*Manifest){\n\t\t\"bad base sha\":   func(m *Manifest) { m.BaseSHA = \"abc\" },\n\t\t\"bad role sha\":   func(m *Manifest) { m.Role.SHA = \"main\" },\n\t\t\"bad sidecar\":    func(m *Manifest) { m.Sidecar.SHA = strings.ToUpper(sha) },\n\t\t\"input dotdot\":   func(m *Manifest) { m.Inputs[0].Path = \"../x\" },\n\t\t\"input absolute\": func(m *Manifest) { m.Inputs[0].Path = \"/etc/x\" },\n\t\t\"input unclean\":  func(m *Manifest) { m.Inputs[0].Path = \"a/../b\" },\n\t\t\"scrub absolute\": func(m *Manifest) { m.Scrub = []string{\"/abs\"} },\n\t\t\"unknown V\":      func(m *Manifest) { m.V = 2 },\n\t\t\"bad repo\":       func(m *Manifest) { m.Repo = \"norepo\" },\n\t\t\"role path\":      func(m *Manifest) { m.Role.Path = \"../../x\" },\n\t} {\n\t\tt.Run(name, func(t *testing.T) {\n\t\t\tm := valid()\n\t\t\tmut(&m)\n\t\t\tif _, err := Encode(m); err == nil {\n\t\t\t\tt.Error(\"Encode accepted\")\n\t\t\t}\n\t\t})\n\t}\n\tif _, err := Decode([]byte(`{\"V\":1,\"Inputs\":[{\"Path\":\"../x\"}]}`)); err == nil {\n\t\tt.Error(\"Decode accepted bad manifest\")\n\t}\n\tif _, err := Decode([]byte(`not json`)); err == nil {\n\t\tt.Error(\"Decode accepted junk\")\n\t}\n}\nE\ncat > secret_test.go <<'E'\npackage jobpod\n\nimport \"testing\"\n\nfunc TestKeyMatches(t *testing.T) {\n\tfor _, tc := range []struct {\n\t\tgot, want string\n\t\tok        bool\n\t}{{\"abc\", \"abc\", true}, {\"abc\", \"abd\", false}, {\"\", \"\", false}, {\"\", \"abc\", false}, {\"abc\", \"\", false}} {\n\t\tif KeyMatches(tc.got, tc.want) != tc.ok {\n\t\t\tt.Errorf(\"KeyMatches(%q,%q) != %v\", tc.got, tc.want, tc.ok)\n\t\t}\n\t}\n}\n\nfunc TestNewKey(t *testing.T) {\n\ta, err := NewKey()\n\tb, _ := NewKey()\n\tif err != nil || len(a) != 43 || a == b {\n\t\tt.Fatalf(\"keys %q %q, %v\", a, b, err)\n\t}\n}\n\nfunc TestSecretData(t *testing.T) {\n\td, err := SecretData([]byte(\"m\"), \"t\", \"k\", EnvAPIKey, \"v\")\n\tif err != nil || string(d[ItemManifest]) != \"m\" || string(d[ItemToken]) != \"t\" || string(d[ItemKey]) != \"k\" || string(d[EnvAPIKey]) != \"v\" {\n\t\tt.Fatalf(\"%v %v\", d, err)\n\t}\n\tif _, err := SecretData(nil, \"t\", \"k\", \"PATH\", \"v\"); err == nil {\n\t\tt.Error(\"accepted unknown model name\")\n\t}\n}\nE\ncd ../..; gofmt -l internal/jobpod internal/github; go vet ./internal/jobpod ./internal/github && go test ./internal/jobpod 2>&1 | tail -20"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4472,"cache_read_input_tokens":42264,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4472},"output_tokens":6,"