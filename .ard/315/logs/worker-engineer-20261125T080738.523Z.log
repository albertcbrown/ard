NSTALLATION_ID\"))\n\t\tkeyEnv  = getenv(\"ARD_GITHUB_PRIVATE_KEY\")\n\t\tkeyFile = strings.TrimSpace(getenv(\"ARD_GITHUB_PRIVATE_KEY_FILE\"))\n\t\ttoken   = strings.TrimSpace(getenv(\"ARD_GITHUB_TOKEN\"))\n217:func newAPIClient(rt http.RoundTripper) *http.Client {\n218-\treturn &http.Client{Transport: rt, CheckRedirect: refuseRedirect}\n219-}\n220-\n221-// fail is mapErr for repo-scoped calls: a refused redirect is classified by\n222-// probing the repository (see \"Guardrails\" in the proposal). n > 0 means the op\n223-// names an issue or PR number. nil in, nil out.\n224-func (h *HTTP) fail(ctx context.Context, op string, n int, err error) error {\n225-\tvar rerr *gogh.RedirectionError\n226-\tif err == nil || !errors.As(err, &rerr) {\n227-\t\treturn mapErr(op, err)\n228-\t}\n229-\treturn fmt.Errorf(\"github: %s: %w\", op, h.classifyRedirect(ctx, n, rerr))\n230-}\n231-\n232-// classifyRedirect decides what a refused redirect means. Only positive\n94-\n95-// statusError maps a failed response to ard's error vocabulary. Rate limits\n96-// are recognised earlier, in the retry transport.\n97:func statusError(status int, body []byte) error {\n98-\tmsg := errorMessage(body)\n99-\tswitch status {\n100-\tcase http.StatusUnauthorized:\n101-\t\treturn fmt.Errorf(\"%w: %s\", ErrUnauthorized, msg)\n102-\tcase http.StatusForbidden:\n103-\t\treturn fmt.Errorf(\"%w: %s\", ErrForbidden, msg)\n104-\tcase http.StatusNotFound, http.StatusGone:\n105-\t\treturn fmt.Errorf(\"%w: %s\", ErrNotFound, msg)\n106-\t}\n107-\treturn &HTTPError{Status: status, Message: msg}\n108-}\n109-\n110-// errorMessage extracts GitHub's {\"message\": ...} (plus field errors) from a body.\n111-func errorMessage(body []byte) string {\n112-\tvar v struct {\n113-\t\tMessage string `json:\"message\"`\n114-\t\tErrors  []struct {\n115-\t\t\tCode    string `json:\"code\"`\n116-\t\t\tField   string `json:\"field\"`\n117-\t\t\tMessage string `json:\"message\"`\n118-\t\t} `json:\"errors\"`\n119-\t}\n120-\tif err := json.Unmarshal(body, &v); err != nil || v.Message == \"\" {\n121-\t\ts := strings.TrimSpace(string(body))\n122-\t\tif len(s) > 200 {\ninternal/executor/executor.go:78:type File struct {\ninternal/executor/executor.go-79-\tPath string\ninternal/executor/executor.go-80-\tData []byte\ninternal/executor/executor.go-81-}\ninternal/executor/executor.go-82-\ninternal/executor/executor.go-83-// Paths are the locations as the job process sees them. ConfigDir is the\ninternal/executor/executor.go-84-// job's empty agent-CLI config dir (host: <home>/.claude; Docker:\ninternal/executor/executor.go-85-// /ard-config); it is empty on a handle stored before it existed.\ninternal/executor/executor.go-86-//\ninternal/executor/executor.go:92:type Paths struct{ Work, Role, Sidecar, ConfigDir, History string }\ninternal/executor/executor.go-93-\ninternal/executor/executor.go-94-// Command is what to run. Paths must come from Handle.View.\ninternal/executor/executor.go-95-type Command struct {\ninternal/executor/executor.go-96-\tPath string\ninternal/executor/executor.go-97-\tArgs []string\ninternal/executor/executor.go-98-\tEnv  []string // \"NAME=value\" secrets; only names the executor allows (AllowEnv)\ninternal/executor/executor.go-99-\t// Fixed holds non-secret \"NAME=value\" settings the CLI needs (for example\ninternal/executor/executor.go-100-\t// an agent adapter's config dir). Only names on the executor's AllowFixed\ninternal/executor/executor.go-101-\t// list are accepted; the executor's own names, GitHub credentials and\ninternal/executor/executor.go-102-\t// secret-shaped names are always refused.\ninternal/executor/executor.go-103-\tFixed []string\ninternal/executor/executor.go-104-\tStdin io.Reader\ninternal/gitref/gitref.go:16:func IsSHA(ref string) bool { return len(ref) == 40 && isHex(ref, false) }\ninternal/gitref/gitref.go-17-\ninternal/gitref/gitref.go-18-func isHex(s string, upper bool) bool {\ninternal/gitref/gitref.go-19-\tfor i := 0; i < len(s); i++ {\ninternal/gitref/gitref.go-20-\t\tc := s[i]\ninternal/gitref/gitref.go-21-\t\tswitch {\ninternal/agent/             Adapter interface, Spec/Result types, Registry (pure: builds argv, parses output)\ninternal/agent/claude/      Claude Code adapter (`claude -p`, stream-json parser)\ninternal/modelauth/         picks the one model credential (OAuth token or API key) from the controller env and carries its value to the executor; never logged\ninternal/state/             SQLite controller and scanner state (sqlitex, scannerdb)\ninternal/scanner/           scanner pipeline: findings, markers, reconcile, diff, group, ExecEngine, the scanners Loop, rebuild\ninternal/costblock/         the issue body's ard-owned cost block: render, strict parse, strip (admission), splice, per-issue Locks; leaf, stdlib only\ninternal/tarball/          safe streaming tar.gz pack/unpack through os.Root; leaf, stdlib only\ninternal/costs/             the costs Loop: writes each dirty issue's cost table from state; Claims() false so it runs while paused\ninternal/scanner/stale/     the stale closer: a plain controller Loop that comments and closes untouched scanner issues\ninternal/agentjob/          helpers the agent loops share: untrusted-input snapshot, admission re-check, agent command and executor job builders, handle save, shutdown-aware wait, post-once\ninternal/worker/            the worker loop: claim, agent/test/fix steps, diff guard, code-lane push, draft PR, FinishWith\ninternal/servecmd/          `ard serve` and `ard rebuild-state`: dependency wiring (lock, state, effects, pool adoption, controller); registerLoops takes one line per loop\ninternal/redact/            log redaction (secrets and host paths), secret scan and 1 MiB cap (leaf library; close-out commits only LogResult.Clean)\ninternal/github/types.go:9:type Repo struct{ Owner, Name string }\ninternal/github/types.go-10-\ninternal/github/types.go-11-// String returns \"owner/name\".\ninternal/github/types.go-12-func (r Repo) String() string { return r.Owner + \"/\" + r.Name }\ninternal/github/types.go-13-\ninternal/github/types.go-14-// State is the open/closed state of an issue or PR. StateAll is valid only as\ninternal/github/types.go-15-// a list filter.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Cd4uGJi3aTEVU7tw5rbpgg","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Wic6uNeMu5UPofYQT7nhuS","type":"tool_result","content":"293:**Sidecar repos are context, read-only.** A role's sidecar (for example `vpe-specs`) is cloned by the executor, not the loop: the loop passes the role's resolved sidecar (repo and ref) on the job. The executor keeps one shallow (depth 1) bare object cache per sidecar repo at `~/.ard/sidecars/<controlled-owner>/<controlled-repo>/<sidecar-owner>/<sidecar-repo>.git`, shared by every job of that controlled repo, and exports the commit into the job home as `<job home>/sidecar` (plain files: no `.git`, `chmod -R a-w` in both modes, and a `:ro` mount under Docker). The job sees it at `$ARD_SIDECAR`. `ref` is a branch, tag or full 40-character SHA (an abbreviated SHA is a config error). A SHA already in the cache needs no network; a branch or tag is re-fetched (depth 1) for every job. Whatever the ref, `Prepare` resolves it to a full commit SHA and records it on the job's handle (and in the `executor.sidecar_ready` log), so a job is reproducible. Symlinks and submodules in the sidecar are rejected and the tree is capped at 64 MiB, like config snapshots. A fetch failure (network, auth, a stale lock, which the executor clears by rebuilding the cache once) is the transient `clone_failed`; a ref or SHA that does not exist, or a repo the App cannot read, is a permanent failure that names the sidecar. A role that wants a spec changed says so in `plan.md`; editing the sidecar is out of scope for v1.\n299:Local-executor details: the role directory (and its `Dockerfile`) is mounted from the config snapshot at the job's SHA, not from the working tree. The job worktree is always detached at a SHA resolved from the job's ref (the executor never checks out a branch; the committer owns branch worktrees). The controller's clone is a bare repository ard owns at `~/.ard/repos/<owner>/<repo>.git` (lowercased), with no remote, no stored credential and auto-gc off (`gc.auto=0`, `maintenance.auto=false`). `ard serve` creates it on first start and seeds it with one fetch of `main` (up to 30 min; if that fails, serve starts paused and the next start retries), and later starts reuse it. Config loads and committer lanes fetch into it, and every committer and executor worktree is cut from it (lanes under `~/.ard/work/<owner>/<repo>/lanes/`). `ard serve` never writes to the operator's checkout: it reads it only for the `origin` fallback of `--repo` and the local `paused` key. To rebuild a damaged clone, stop serve, `rm -rf` it and restart. Upgrading from a version that used the checkout: ard deletes its old lane and job worktree directories without running git there, so the old `refs/ard/*` refs and the dangling worktree registrations stay in the checkout until you remove them (`git for-each-ref --format='delete %(refname)' refs/ard/ | git update-ref --stdin; git worktree prune`). Every `git worktree add`, `remove` and `prune` on the controller's clone, by the executor and the committer's lanes alike, takes one in-process lock keyed by the clone's common git directory, because git's worktree bookkeeping is not safe under concurrent admin commands; fetches, commits and pushes do not take it. Each such command also has a 30 s deadline, and cleanup runs even when the job's context is cancelled, so one hung git cannot stall every lane. Do not run `git worktree prune` (or add/remove) in `~/.ard/repos/<owner>/<repo>.git` by hand while `ard serve` runs: the lock is per process and cannot cover a human's git. The operator's own checkout is free to use. The host keeps two files per job: `<base>.log` (stdout and stderr combined, the heartbeat source and the committed log) and `<base>.stdout` (stdout only, parsed by the adapter). A read-only job (`ReadOnly`, used by scanners) gets the worktree mounted `:ro` under Docker, or `chmod -R a-w` on the host. The heartbeat is the log file's mtime while the PID is alive; liveness alone is not a beat. Phase 0 local jobs do not survive a controller restart: the pipes belong to the controller, so after a restart the job reports `orphaned` (PID alive, start time verified) or `gone`, and the Reaper kills and fails it. The executor is not an effect: it never calls GitHub or commits, so jobs run normally under `--dry-run`. Sidecar auth: the sidecar fetch runs in the controller with the GitHub App installation token in a host-scoped `http.<url>.extraheader` passed through git's environment, never argv; the job receives plain files and no credential, and the cache stores no remote and no token. The App must be installed on the sidecar repo with contents:read. Host-mode jobs can reach `~/.ard/sidecars`, but it holds no credential. Host-mode jobs run as the controller's uid: they can read the GitHub App key and `~/.config/gh` by absolute path, write the controller's clone, and undo `chmod a-w`. Host mode is allowed for every role ([#84](https://github.com/albertcbrown/ard/issues/84)), but a role that reads untrusted input (every triage, worker and reviewer role, and an LLM scanner) warns loudly when it has no `Dockerfile`; deterministic scanners are exempt, and nothing warns under `executor: k8s`, where every job runs in a container. `ard config check` and the first successful config load of `ard serve` (and any role a later config adds) log one `executor.host_untrusted` WARN per such role and also write it to stderr, so it survives `--log-level`. The local executor logs the WARN again for every host-mode job of such a role and appends a `host_untrusted` row to the `events` table. **Default agent image under the local executor (#244, part of #55).** `ard serve` and `ard config check` read the host setting `ARD_AGENT_IMAGE`: a digest-pinned reference (`<name>@sha256:<64 hex>`) or a local image ID (`sha256:<hex>` from `make agent-image`); tags are refused (`executor.CheckImageRef`, `ErrImageRef`), and an invalid value stops startup. When it is set, `Prepare` runs every job that reads untrusted input and has no `Dockerfile` (triage, worker agent, test and fix steps, reviewer, and LLM scanner jobs) under Docker in that image, with the same flags and mounts as a Dockerfile role (`--cap-drop ALL`, `no-new-privileges`, worktree at `/work`, role directory `:ro`, and so on). A role's own `Dockerfile` wins. Deterministic scanners (trusted input) stay on the host. A local image is used as is; a digest that is not present is pulled. There is no fallback to host mode: `ard serve` runs `docker version` at startup and fails if Docker is down, and a job whose Docker setup fails at `Prepare` fails there. The controller's clone is not mounted, so `git` has no repository inside the container; every Docker job gets `GOFLAGS=-buildvcs=false` so `go build` does not fail on VCS stamping. Unset keeps today's behaviour. With it set, `ard config check` and `ard serve` no longer log or record `executor.host_untrusted` for roles it covers, and the hint of the warning names `ARD_AGENT_IMAGE`. Each warning lists what the job can reach, including `~/.ard` (state, config snapshots, the pause file, other jobs' worktrees and logs). The owner accepts this risk while ard runs only on owner-controlled repos, and revisits it when moving to the spark cluster, where every job runs in a container once the k8s executor (#54) lands. Until then the Gate 1 dry-run soak on spark (see Rollout and Delivery) runs `ard serve` with the local executor in a pod, and the deterministic cve scanner runs there as a host subprocess of the controller container: its role directory has no `Dockerfile`, and the `ard` image carries its pinned tools. Only deterministic scanners run in that pod: it starts `ard serve --loops scanners,stale,reaper` ([#187](https://github.com/albertcbrown/ard/issues/187)), so the triage, worker and reviewer loops never run there, even though `.ard/config.yaml` on `main` has agent roles. `--loops` takes a comma-separated list of loop names (scanners, stale, triage, workers, reviewers, reviewfix, merger, janitor, reaper, budget; `budget` is the status-issue notice loop, the claim gate is always on), defaults to every loop, and rejects an unknown name with exit 2. `ard serve` and `ard config check` refuse to run on git older than 2.47.0, because the committer's fetches fail on older versions.\n307:| Workspace | `git worktree` of the controller's clone (`~/.ard/repos/<owner>/<repo>.git`) under `~/.ard/work/<owner>/<repo>/<job-id>`; sidecar exported into the job home | a bare Pod whose `pre` init container fetches the repo at `BaseSHA` with a per-job read-only installation token and runs the same `workspace` code as local `Prepare` into size-limited `emptyDir` volumes; the agent gets `work` with no `.git` |\n314:Kubernetes-executor details (decided, design revision 3 of [#54](https://github.com/albertcbrown/ard/issues/54), recorded in [#312](https://github.com/albertcbrown/ard/issues/312); the work is split across later parts of #54, and #317 splits into the API layer and the executor). There is no job API on `ard serve`. **Pod shape.** `pre` fetches with the token passed through `http.extraheader` from the environment, never argv or `.git/config`; the git dir is on a `ctl` volume the agent does not mount; the role dir comes from `cfg.SHA`, so the k8s executor refuses a config without a SHA; sidecars are at pinned SHAs; the untrusted inputs and the scrub list travel in the per-job Secret, capped at 768 KiB (over the cap is a permanent failure with a named cause); `pre` copies the static `ard` binary. The `agent` container mounts only `work` and `out` and holds only its model credential via `secretKeyRef`: no GitHub token, no key, no Secret volume, no SA token. It tees stdout to `out/stdout`, enforces its own deadline, writes a done marker and reaps orphans as PID 1. `post` has its own pinned image and never runs a binary from a shared volume. It serves one route, `GET /v1/result`, on the pod IP, guarded by a preshared 32-byte `crypto/rand` key unique to the pod, mounted only in `post` and kept in memory by the controller, compared in constant time. It answers 409 until the agent has terminated and the marker exists, builds the tar in Go and never runs git, serves one request at a time, has header and idle timeouts, never logs Authorization, and exits 0 after the controller confirms or at the deadline. The transport is plain HTTP inside the cluster (the owner's choice): the key grants only this job's result, and a NetworkPolicy limits who can connect.\n367:3. **Run the aid, then the agent.** After the pin, a role with an executable `aid` in its directory (reviewers only, like a scanner's `scan`; #205) has it run by the controller as its own executor job at the pinned head, before the agent, so the findings of its deterministic tools do not depend on the host or on the agent choosing to run them. The tool finds; the agent explains, ranks and confirms. The aid job is read-only, has no `Env` and no `Fixed` entries (no model credential, no GitHub token), runs with `--network none` under Docker (a role `Dockerfile` or `ARD_AGENT_IMAGE`; known CVEs stay with the `cve` scanner, so the aid never queries vulnerability databases), and has its own timeout of 5 minutes (shorter if the role's is), counted inside the review job's timeout: the agent gets what is left, at least one minute. Its inputs are `.ard-input/<issue#>/changed.txt` (one path per line, `.ard/<issue#>/` left out) and `diff.patch`. Its output is JSONL on stdout, one object per result with exactly `tool`, `rule`, `file`, `line`, `severity` (`critical`, `high`, `medium`, `low`, `info`) and `message`, capped at 256 KiB (more is a failure). ard validates it: a line that is not JSON, has an unknown key, a bad tool, rule, severity or line, or a path that is absolute, has `..` or is not in `changed.txt` is dropped and counted; a message is redacted, cut at 1 KiB and secret-scanned like a log, and a line that still trips the scanner is dropped. Matched text is never kept: the aid must print rule ids and positions only. The result is written to `.ard-input/<issue#>/aid.jsonl` and is the first of the agent's untrusted inputs; the starter prompt reads it first and runs the tools itself only when the file is absent. **Failure:** a failed, timed-out or invalid aid (any dropped line counts as invalid) never stops the review. The input says the aid failed and why, and close-out turns an `approve` into `changes` with a note. **Blocking:** a `gitleaks` result on a line the PR added becomes a blocking `high` finding with a `[secret]` message that ard adds to the review in code (carrying the rule id only); the agent cannot drop it, and an `approve` becomes `changes`. gosec and semgrep results stay advisory. Both rules apply only to roles that have an `aid`. **Host mode:** with no role `Dockerfile` and no `ARD_AGENT_IMAGE`, the aid runs on the host, as ard-owned code that reads but never executes PR code; its environment holds no credential, but nothing enforces its network, and it runs as the controller's uid without a sandbox: the residual risk of #84 applies to it too. The starter `security-review/aid` pins gosec, gitleaks and semgrep (vendored local rules, `--metrics=off`, `--disable-nosem`) in the role's `Dockerfile`, built on the default ard-agent image (k8s role images stay with #245). Then **run the agent** with `.ard/reviewers/<role>/prompt.txt` and these untrusted inputs: `.ard-input/<issue#>/diff.patch` (the controller's diff from the merge base with `main` to the pinned head, `--stat` then the patch, taken with `--text`, `--no-textconv` and attributes read from the empty tree so a `.gitattributes` entry cannot hide a change, with this issue's `.ard/<issue#>/` left out and cut at 1 MiB), `.ard-input/<issue#>/issue.md` and `comments.md` (written by the loop, never committed), the committed `.ard/<issue#>/` (plan, triage and worker role files and logs) and the sidecar (security policy, license allowlist). The loop runs every git command against the controller clone, never in the reviewer's worktree (the agent itself may run read-only git there). In a later round it also gets `.ard-input/<issue#>/previous-review.md`, its own earlier report, read from the pinned head, and says which findings are resolved.\n377:**The starter security reviewer (`reviewers/security-review`, #43).** `.ard/reviewers/security-review/prompt.txt` looks for injection, authz gaps, secrets and unsafe dependencies the change introduces or makes reachable, plus other weaknesses. It has the same untrusted inputs, Trust rules (steering text in the change is a blocking `high` finding), write rules and role-file format as eng-review, with `role: security-review` and a `## Checks` body. It never builds, tests or runs the repository's code. It runs, when they are installed: gitleaks over the changed files with `--redact`; gosec on changed Go packages with `-nosec`; and semgrep with `--metrics=off` and `--disable-nosem`, using only a rule file already in the repository that the change does not touch, or the sidecar's. Suppressions the change adds are reviewed as part of the change. It skips a missing tool and says so, never downloads rules or vulnerability data, and never copies a secret it finds into its report (file, line and kind only). Each finding's first line starts with `[injection]`, `[authz]`, `[secret]`, `[dependency]` or `[other]`. Critical and high block, medium only when it is one of the four kinds with a nameable exploit, low and info never; `needs-human` only when there is nothing to review. The starter override is Opus 5.5 (#8) with the default 30m timeout and no `when:`. The role's `aid` (#205) runs gitleaks, gosec and semgrep in controller code before the agent (Reviewer loop, step 3); the prompt reads `aid.jsonl` first and runs the tools itself only when it is absent. It ships a `Dockerfile` (the default ard-agent image plus the pinned tools), so it runs under Docker. The same fetched-file check applies, and an unverified fetched file is a high finding; it still never runs repository code (#301).\npackage github\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"net\"\n\t\"net/http\"\n\t\"strings\"\n\t\"time\"\n)\n\n// Sentinel errors; match with errors.Is.\nvar (\n\tErrNotFound      = errors.New(\"github: not found\")\n\tErrUnauthorized  = errors.New(\"github: unauthorized\")\n\tErrForbidden     = errors.New(\"github: forbidden\")\n\tErrConflict      = errors.New(\"github: conflict\")\n\tErrNotMergeable  = errors.New(\"github: not mergeable\")\n\tErrReadOnly      = errors.New(\"github: client is read-only (dry-run)\")\n\tErrNoCredentials = errors.New(\"github: no credentials configured\")\n\n\t// ErrRepoMoved means the configured repository redirects: it was renamed or\n\t// transferred. Not transient; point ard at the new name.\n\tErrRepoMoved = errors.New(\"github: repository has moved\")\n)\n\n// RateLimitError means GitHub throttled us and the wait was exhausted or\n// longer than Config.MaxWait.","is_error":false}]},"parent_tool_use_id":null,"session_id":"2a18f649-007f-4cc8-9b6c-7c63fae24122","uuid":"890e32b6-1ab1-4429-a8e8-6d1b960772a7","timestamp":"2026-11-25T08:07:48.255Z","tool_use_result":{"stdout":"293:**Sidecar repos are context, read-only.** A role's sidecar (for example `vpe-specs`) is cloned by the executor, not the loop: the loop passes the role's resolved sidecar (repo and ref) on the job. The executor keeps one shallow (depth 1) bare object cache per sidecar repo at `~/.ard/sidecars/<controlled-owner>/<controlled-repo>/<sidecar-owner>/<sidecar-repo>.git`, shared by every job of that controlled repo, and exports the commit into the job home as `<job home>/sidecar` (plain files: no `.git`, `chmod -R a-w` in both modes, and a `:ro` mount under Docker). The job sees it at `$ARD_SIDECAR`. `ref` is a branch, tag or full 40-character SHA (an abbreviated SHA is a config error). A SHA already in the cache needs no network; a branch or tag is re-fetched (depth 1) for every job. Whatever the ref, `Prepare` resolves it to a full commit SHA and records it on the job's handle (and in the `executor.sidecar_ready` log), so a job is reproducible. Symlinks and submodules in the sidecar are rejected and the tree is capped at 64 MiB, like config snapshots. A fetch failure (network, auth, a stale lock, which the executor clears by rebuilding the cache once) is the transient `clone_failed`; a ref or SHA that does not exist, or a repo the App cannot read, is a permanent failure that names the sidecar. A role that wants a spec changed says so in `plan.md`; editing the sidecar is out of scope for v1.\n299:Local-executor details: the role directory (and its `Dockerfile`) is mounted from the config snapshot at the job's SHA, not from the working tree. The job worktree is always detached at a SHA resolved from the job's ref (the executor never checks out a branch; the committer owns branch worktrees). The controller's clone is a bare repository ard owns at `~/.ard/repos/<owner>/<repo>.git` (lowercased), with no remote, no stored credential and auto-gc off (`gc.auto=0`, `maintenance.auto=false`). `ard serve` creates it on first start and seeds it with one fetch of `main` (up to 30 min; if that fails, serve starts paused and the next start retries), and later starts reuse it. Config loads and committer lanes fetch into it, and every committer and executor worktree is cut from it (lanes under `~/.ard/work/<owner>/<repo>/lanes/`). `ard serve` never writes to the operator's checkout: it reads it only for the `origin` fallback of `--repo` and the local `paused` key. To rebuild a damaged clone, stop serve, `rm -rf` it and restart. Upgrading from a version that used the checkout: ard deletes its old lane and job worktree directories without running git there, so the old `refs/ard/*` refs and the dangling worktree registrations stay in the checkout until you remove them (`git for-each-ref --format='delete %(refname)' refs/ard/ | git update-ref --stdin; git worktree prune`). Every `git worktree add`, `remove` and `prune` on the controller's clone, by the executor and the committer's lanes alike, takes one in-process lock keyed by the clone's common git directory, because git's worktree bookkeeping is not safe under concurrent admin commands; fetches, commits and pushes do not take it. Each such command also has a 30 s deadline, and cleanup runs even when the job's context is cancelled, so one hung git cannot stall every lane. Do not run `git worktree prune` (or add/remove) in `~/.ard/repos/<owner>/<repo>.git` by hand while `ard serve` runs: the lock is per process and cannot cover a human's git. The operator's own checkout is free to use. The host keeps two files per job: `<base>.log` (stdout and stderr combined, the heartbeat source and the committed log) and `<base>.stdout` (stdout only, parsed by the adapter). A read-only job (`ReadOnly`, used by scanners) gets the worktree mounted `:ro` under Docker, or `chmod -R a-w` on the host. The heartbeat is the log file's mtime while the PID is alive; liveness alone is not a beat. Phase 0 local jobs do not survive a controller restart: the pipes belong to the controller, so after a restart the job reports `orphaned` (PID alive, start time verified) or `gone`, and the Reaper kills and fails it. The executor is not an effect: it never calls GitHub or commits, so jobs run normally under `--dry-run`. Sidecar auth: the sidecar fetch runs in the controller with the GitHub App installation token in a host-scoped `http.<url>.extraheader` passed through git's environment, never argv; the job receives plain files and no credential, and the cache stores no remote and no token. The App must be installed on the sidecar repo with contents:read. Host-mode jobs can reach `~/.ard/sidecars`, but it holds no credential. Host-mode jobs run as the controller's uid: they can read the GitHub App key and `~/.config/gh` by absolute path, write the controller's clone, and undo `chmod a-w`. Host mode is allowed for every role ([#84](https://github.com/albertcbrown/ard/issues/84)), but a role that reads untrusted input (every triage, worker and reviewer role, and an LLM scanner) warns loudly when it has no `Dockerfile`; deterministic scanners are exempt, and nothing warns under `executor: k8s`, where every job runs in a container. `ard config check` and the first successful config load of `ard serve` (and any role a later config adds) log one `executor.host_untrusted` WARN per such role and also write it to stderr, so it survives `--log-level`. The local executor logs the WARN again for every host-mode job of such a role and appends a `host_untrusted` row to the `events` table. **Default agent image under the local executor (#244, part of #55).** `ard serve` and `ard config check` read the host setting `ARD_AGENT_IMAGE`: a digest-pinned reference (`<name>@sha256:<64 hex>`) or a local image ID (`sha256:<hex>` from `make agent-image`); tags are refused (`executor.CheckImageRef`, `ErrImageRef`), and an invalid value stops startup. When it is set, `Prepare` runs every job that reads untrusted input and has no `Dockerfile` (triage, worker agent, test and fix steps, reviewer, and LLM scanner jobs) under Docker in that image, with the same flags and mounts as a Dockerfile role (`--cap-drop ALL`, `no-new-privileges`, worktree at `/work`, role directory `:ro`, and so on). A role's own `Dockerfile` wins. Deterministic scanners (trusted input) stay on the host. A local image is used as is; a digest that is not present is pulled. There is no fallback to host mode: `ard serve` runs `docker version` at startup and fails if Docker is down, and a job whose Docker setup fails at `Prepare` fails there. The controller's clone is not mounted, so `git` has no repository inside the container; every Docker job gets `GOFLAGS=-buildvcs=false` so `go build` does not fail on VCS stamping. Unset keeps today's behaviour. With it set, `ard config check` and `ard serve` no longer log or record `executor.host_untrusted` for roles it covers, and the hint of the warning names `ARD_AGENT_IMAGE`. Each warning lists what the job can reach, including `~/.ard` (state, config snapshots, the pause file, other jobs' worktrees and logs). The owner accepts this risk while ard runs only on owner-controlled repos, and revisits it when moving to the spark cluster, where every job runs in a container once the k8s executor (#54) lands. Until then the Gate 1 dry-run soak on spark (see Rollout and Delivery) runs `ard serve` with the local executor in a pod, and the deterministic cve scanner runs there as a host subprocess of the controller container: its role directory has no `Dockerfile`, and the `ard` image carries its pinned tools. Only deterministic scanners run in that pod: it starts `ard serve --loops scanners,stale,reaper` ([#187](https://github.com/albertcbrown/ard/issues/187)), so the triage, worker and reviewer loops never run there, even though `.ard/config.yaml` on `main` has agent roles. `--loops` takes a comma-separated list of loop names (scanners, stale, triage, workers, reviewers, reviewfix, merger, janitor, reaper, budget; `budget` is the status-issue notice loop, the claim gate is always on), defaults to every loop, and rejects an unknown name with exit 2. `ard serve` and `ard config check` refuse to run on git older than 2.47.0, because the committer's fetches fail on older versions.\n307:| Workspace | `git worktree` of the controller's clone (`~/.ard/repos/<owner>/<repo>.git`) under `~/.ard/work/<owner>/<repo>/<job-id>`; sidecar exported into the job home | a bare Pod whose `pre` init container fetches the repo at `BaseSHA` with a per-job read-only installation token and runs the same `workspace` code as local `Prepare` into size-limited `emptyDir` volumes; the agent gets `work` with no `.git` |\n314:Kubernetes-executor details (decided, design revision 3 of [#54](https://github.com/albertcbrown/ar