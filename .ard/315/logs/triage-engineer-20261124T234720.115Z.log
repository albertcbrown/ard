ample an init container running git clone --mirror, or a bundle\n// volume) at the same place.\ntype Paths struct{ Work, Role, Sidecar, ConfigDir, History string }\n\n// Command is what to run. Paths must come from Handle.View.\ntype Command struct {\n66:\t// at Paths.History (and $ARD_HISTORY). Only valid with Stage \"scanner\".\n83:// Paths are the locations as the job process sees them. ConfigDir is the\n92:type Paths struct{ Work, Role, Sidecar, ConfigDir, History string }\ninternal/github/http.go:217:func newAPIClient(rt http.RoundTripper) *http.Client {\ninternal/github/errors.go:97:func statusError(status int, body []byte) error {\n26:internal/tarball/          safe streaming tar.gz pack/unpack through os.Root; leaf, stdlib only","is_error":false}]},"parent_tool_use_id":null,"session_id":"4ca5283a-c17d-433a-b32b-2ff2ca952490","uuid":"8cd98377-4fa6-4c89-a891-fa86d431f74a","timestamp":"2026-11-24T23:47:30.075Z","tool_use_result":{"stdout":"\t}\n\treturn tok, nil\n}\n\nfunc (a *AppAuth) installation(ctx context.Context) (*ghinstallation.Transport, error) {\n\ta.mu.Lock()\n\tdefer a.mu.Unlock()\n\tif a.inst != nil {\n\t\treturn a.inst, nil\n\t}\n\tbase := a.base\n\tif base == nil {\n\t\tbase = http.DefaultTransport\n\t}\n\tid := a.InstallationID\n\tif id == 0 {\n\t\tvar err error\n\t\tif id, err = a.discover(ctx, base); err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t}\n\tt, err := ghinstallation.New(base, a.AppID, id, a.PrivateKey)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"github: app transport: %w\", err)\n\t}\n\tif a.baseURL != \"\" {\n\t\tt.BaseURL = a.baseURL\n\t}\n\t// Token refresh must not follow redirects either.\n\tt.Client = newAPIClient(base)\n\ta.inst = t\n\treturn t, nil\n}\n\nfunc (a *AppAuth) discover(ctx context.Context, base http.RoundTripper) (int64, error) {\n\tif a.repo == (Repo{}) {\n\t\treturn 0, errors.New(\"github: cannot discover installation without a repo\")\n\t}\n\tjwt, err := a.appsTransport(base)\n\tif err != nil {\n\t\treturn 