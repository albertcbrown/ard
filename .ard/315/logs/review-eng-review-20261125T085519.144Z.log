allation id\n53\t }\n54\t \n55\t // configure is called by New with the repo and API base URL.\n56\t@@ -113,6 +114,7 @@ func (a *AppAuth) installation(ctx context.Context) (*ghinstallation.Transport,\n57\t \t\t\treturn nil, err\n58\t \t\t}\n59\t \t}\n60\t+\ta.instID = id\n61\t \tt, err := ghinstallation.New(base, a.AppID, id, a.PrivateKey)\n62\t \tif err != nil {\n63\t \t\treturn nil, fmt.Errorf(\"github: app transport: %w\", err)\n64\t@@ -126,6 +128,22 @@ func (a *AppAuth) installation(ctx context.Context) (*ghinstallation.Transport,\n65\t \treturn t, nil\n66\t }\n67\t \n68\t+// installationID returns the installation id, discovering it when unknown.\n69\t+func (a *AppAuth) installationID(ctx context.Context) (int64, error) {\n70\t+\ta.mu.Lock()\n71\t+\tid := a.instID\n72\t+\ta.mu.Unlock()\n73\t+\tif id != 0 {\n74\t+\t\treturn id, nil\n75\t+\t}\n76\t+\tif _, err := a.installation(ctx); err != nil {\n77\t+\t\treturn 0, err\n78\t+\t}\n79\t+\ta.mu.Lock()\n80\t+\tdefer a.mu.Unlock()\n81\t+\treturn a.instID, nil\n82\t+}\n83\t+\n84\t func (a *AppAuth) discover(ctx context.Context, base http.RoundTripper) (int64, error) {\n85\t \tif a.repo == (Repo{}) {\n86\t \t\treturn 0, errors.New(\"github: cannot discover installation without a repo\")\n87\tdiff --git a/internal/github/scoped.go b/internal/github/scoped.go\n88\tnew file mode 100644\n89\tindex 0000000..430669a\n90\t--- /dev/null\n91\t+++ b/internal/github/scoped.go\n92\t@@ -0,0 +1,146 @@\n93\t+package github\n94\t+\n95\t+import (\n96\t+\t\"bytes\"\n97\t+\t\"context\"\n98\t+\t\"encoding/json\"\n99\t+\t\"errors\"\n100\t+\t\"fmt\"\n101\t+\t\"io\"\n102\t+\t\"log/slog\"\n103\t+\t\"net/http\"\n104\t+\t\"strings\"\n105\t+\t\"time\"\n106\t+)\n107\t+\n108\t+// ErrCannotScope means the credentials cannot mint scoped tokens.\n109\t+var ErrCannotScope = errors.New(\"github: a personal access token cannot be scoped down; the k8s executor needs GitHub App auth\")\n110\t+\n111\t+// ErrNotInInstallation means a requested repository is not covered by the\n112\t+// App installation.\n113\t+var ErrNotInInstallation = errors.New(\"github: repository is not in the app installation\")\n114\t+\n115\t+// ScopedToken is a short-lived installation token. Its value never reaches a\n116\t+// log or an error message through fmt or slog.\n117\t+type ScopedToken struct {\n118\t+\tValue     string\n119\t+\tExpiresAt time.Time\n120\t+}\n121\t+\n122\t+const redactedToken = \"[token]\"\n123\t+\n124\t+// String hides the value.\n125\t+func (ScopedToken) String() string { return redactedToken }\n126\t+\n127\t+// GoString hides the value for %#v.\n128\t+func (ScopedToken) GoString() string { return redactedToken }\n129\t+\n130\t+// LogValue hides the value from slog.\n131\t+func (ScopedToken) LogValue() slog.Value { return slog.StringValue(redactedToken) }\n132\t+\n133\t+// ScopedMinter returns a as an *AppAuth, or ErrCannotScope for any other kind.\n134\t+func ScopedMinter(a Auth) (*AppAuth, error) {\n135\t+\tif app, ok := a.(*AppAuth); ok && app != nil {\n136\t+\t\treturn app, nil\n137\t+\t}\n138\t+\treturn nil, ErrCannotScope\n139\t+}\n140\t+\n141\t+func (a *AppAuth) apiBase() (http.RoundTripper, string) {\n142\t+\ta.mu.Lock()\n143\t+\tdefer a.mu.Unlock()\n144\t+\tbase := a.base\n145\t+\tif base == nil {\n146\t+\t\tbase = http.DefaultTransport\n147\t+\t}\n148\t+\tu := a.baseURL\n149\t+\tif u == \"\" {\n150\t+\t\tu = defaultBaseURL\n151\t+\t}\n152\t+\treturn base, strings.TrimRight(u, \"/\")\n153\t+}\n154\t+\n155\t+// MintReadToken mints an installation token limited to contents:read on repos.\n156\t+// Every repo must belong to the installation's owner; otherwise no request is made.\n157\t+func (a *AppAuth) MintReadToken(ctx context.Context, repos []Repo) (ScopedToken, error) {\n158\t+\tif len(repos) == 0 {\n159\t+\t\treturn ScopedToken{}, errors.New(\"github: no repositories to scope the token to\")\n160\t+\t}\n161\t+\ta.mu.Lock()\n162\t+\towner := a.repo.Owner\n163\t+\ta.mu.Unlock()\n164\t+\tnames := make([]string, 0, len(repos))\n165\t+\tfor _, r := range repos {\n166\t+\t\tif r.Name == \"\" || !strings.EqualFold(r.Owner, owner) {\n167\t+\t\t\treturn ScopedToken{}, fmt.Errorf(\"%w: %s\", ErrNotInInstallation, r)\n168\t+\t\t}\n169\t+\t\tnames = append(names, r.Name)\n170\t+\t}\n171\t+\tid, err := a.installationID(ctx)\n172\t+\tif err != nil {\n173\t+\t\treturn ScopedToken{}, err\n174\t+\t}\n175\t+\tbase, root := a.apiBase()\n176\t+\tjwt, err := a.appsTransport(base)\n177\t+\tif err != nil {\n178\t+\t\treturn ScopedToken{}, err\n179\t+\t}\n180\t+\tpayload, err := json.Marshal(map[string]any{\n181\t+\t\t\"repositories\": names,\n182\t+\t\t\"permissions\":  map[string]string{\"contents\": \"read\"},\n183\t+\t})\n184\t+\tif err != nil {\n185\t+\t\treturn ScopedToken{}, err\n186\t+\t}\n187\t+\turl := fmt.Sprintf(\"%s/app/installations/%d/access_tokens\", root, id)\n188\t+\treq, err := http.NewRequestWithContext(ctx, http.MethodPost, url, bytes.NewReader(payload))\n189\t+\tif err != nil {\n190\t+\t\treturn ScopedToken{}, err\n191\t+\t}\n192\t+\treq.Header.Set(\"Accept\", \"application/vnd.github+json\")\n193\t+\treq.Header.Set(\"Content-Type\", \"application/json\")\n194\t+\tresp, err := newAPIClient(jwt).Do(req)\n195\t+\tif err != nil {\n196\t+\t\treturn ScopedToken{}, fmt.Errorf(\"github: mint scoped token: %w\", err)\n197\t+\t}\n198\t+\tdefer resp.Body.Close()\n199\t+\tbody, _ := io.ReadAll(io.LimitReader(resp.Body, 1<<20))\n200\t+\tswitch resp.StatusCode {\n201\t+\tcase http.StatusCreated:\n202\t+\tcase http.StatusUnprocessableEntity:\n203\t+\t\treturn ScopedToken{}, fmt.Errorf(\"%w: %s\", ErrNotInInstallation, errorMessage(body))\n204\t+\tdefault:\n205\t+\t\treturn ScopedToken{}, fmt.Errorf(\"github: mint scoped token: %w\", statusError(resp.StatusCode, body))\n206\t+\t}\n207\t+\tvar out struct {\n208\t+\t\tToken     string    `json:\"token\"`\n209\t+\t\tExpiresAt time.Time `json:\"expires_at\"`\n210\t+\t}\n211\t+\tif err := json.Unmarshal(body, &out); err != nil || out.Token == \"\" {\n212\t+\t\treturn ScopedToken{}, errors.New(\"github: mint scoped token: unexpected response\")\n213\t+\t}\n214\t+\treturn ScopedToken{Value: out.Token, ExpiresAt: out.ExpiresAt}, nil\n215\t+}\n216\t+\n217\t+// RevokeToken revokes an installation token. An already revoked or expired\n218\t+// token (401) counts as success.\n219\t+func (a *AppAuth) RevokeToken(ctx context.Context, tok string) error {\n220\t+\tbase, root := a.apiBase()\n221\t+\treq, err := http.NewRequestWithContext(ctx, http.MethodDelete, root+\"/installation/token\", nil)\n222\t+\tif err != nil {\n223\t+\t\treturn err\n224\t+\t}\n225\t+\treq.Header.Set(\"Accept\", \"application/vnd.github+json\")\n226\t+\treq.Header.Set(\"Authorization\", \"Bearer \"+tok)\n227\t+\tresp, err := newAPIClient(base).Do(req)\n228\t+\tif err != nil {\n229\t+\t\treturn fmt.Errorf(\"github: revoke token: %w\", err)\n230\t+\t}\n231\t+\tdefer resp.Body.Close()\n232\t+\tbody, _ := io.ReadAll(io.LimitReader(resp.Body, 1<<20))\n233\t+\tswitch resp.StatusCode {\n234\t+\tcase http.StatusNoContent, http.StatusUnauthorized:\n235\t+\t\treturn nil\n236\t+\t}\n237\t+\treturn fmt.Errorf(\"github: revoke token: %w\", statusError(resp.StatusCode, body))\n238\t+}\n239\tdiff --git a/internal/github/scoped_test.go b/internal/github/scoped_test.go\n240\tnew file mode 100644\n241\tindex 0000000..8fad867\n242\t--- /dev/null\n243\t+++ b/internal/github/scoped_test.go\n244\t@@ -0,0 +1,133 @@\n245\t+package github\n246\t+\n247\t+import (\n248\t+\t\"bytes\"\n249\t+\t\"context\"\n250\t+\t\"encoding/json\"\n251\t+\t\"errors\"\n252\t+\t\"fmt\"\n253\t+\t\"log/slog\"\n254\t+\t\"net/http\"\n255\t+\t\"net/http/httptest\"\n256\t+\t\"strings\"\n257\t+\t\"sync/atomic\"\n258\t+\t\"testing\"\n259\t+)\n260\t+\n261\t+const scopedSecretValue = \"scoped-value-for-tests\"\n262\t+\n263\t+func scopedApp(t *testing.T, h http.HandlerFunc) (*AppAuth, *atomic.Int32) {\n264\t+\tt.Helper()\n265\t+\tvar n atomic.Int32\n266\t+\tsrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n267\t+\t\tn.Add(1)\n268\t+\t\th(w, r)\n269\t+\t}))\n270\t+\tt.Cleanup(srv.Close)\n271\t+\ta := &AppAuth{AppID: 12, InstallationID: 34, PrivateKey: []byte(testKeyPEM(t))}\n272\t+\ta.configure(Repo{\"o\", \"r\"}, srv.URL)\n273\t+\treturn a, &n\n274\t+}\n275\t+\n276\t+func TestMintReadToken(t *testing.T) {\n277\t+\ttests := []struct {\n278\t+\t\tname     string\n279\t+\t\trepos    []Repo\n280\t+\t\thandler  http.HandlerFunc\n281\t+\t\twantErr  error\n282\t+\t\tanyErr   bool\n283\t+\t\trequests int32\n284\t+\t}{\n285\t+\t\t{name: \"created\", repos: []Repo{{\"o\", \"r\"}, {\"o\", \"side\"}}, requests: 1, handler: func(w http.ResponseWriter, r *http.Request) {\n286\t+\t\t\tif r.Method != http.MethodPost || r.URL.Path != \"/app/installations/34/access_tokens\" {\n287\t+\t\t\t\tt.Errorf(\"request = %s %s\", r.Method, r.URL.Path)\n288\t+\t\t\t}\n289\t+\t\t\tif strings.Count(r.Header.Get(\"Authorization\"), \".\") != 2 {\n290\t+\t\t\t\tt.Errorf(\"not a JWT: %q\", r.Header.Get(\"Authorization\"))\n291\t+\t\t\t}\n292\t+\t\t\tvar body struct {\n293\t+\t\t\t\tRepositories []string          `json:\"repositories\"`\n294\t+\t\t\t\tPermissions  map[string]string `json:\"permissions\"`\n295\t+\t\t\t}\n296\t+\t\t\tif err := json.NewDecoder(r.Body).Decode(&body); err != nil {\n297\t+\t\t\t\tt.Error(err)\n298\t+\t\t\t}\n299\t+\t\t\tif fmt.Sprint(body.Repositories) != \"[r side]\" || len(body.Permissions) != 1 || body.Permissions[\"contents\"] != \"read\" {\n300\t+\t\t\t\tt.Errorf(\"body = %+v\", body)\n301\t+\t\t\t}\n302\t+\t\t\tw.WriteHeader(http.StatusCreated)\n303\t+\t\t\tfmt.Fprintf(w, `{\"token\":%q,\"expires_at\":\"2030-01-01T00:00:00Z\"}`, scopedSecretValue)\n304\t+\t\t}},\n305\t+\t\t{name: \"422\", repos: []Repo{{\"o\", \"r\"}}, requests: 1, wantErr: ErrNotInInstallation, handler: func(w http.ResponseWriter, r *http.Request) {\n306\t+\t\t\tw.WriteHeader(http.StatusUnprocessableEntity)\n307\t+\t\t\tfmt.Fprint(w, `{\"message\":\"repo not accessible\"}`)\n308\t+\t\t}},\n309\t+\t\t{name: \"other owner\", repos: []Repo{{\"x\", \"r\"}}, requests: 0, wantErr: ErrNotInInstallation, handler: func(w http.ResponseWriter, r *http.Request) {}},\n310\t+\t\t{name: \"redirect\", repos: []Repo{{\"o\", \"r\"}}, requests: 1, anyErr: true, handler: func(w http.ResponseWriter, r *http.Request) {\n311\t+\t\t\thttp.Redirect(w, r, \"/elsewhere\", http.StatusFound)\n312\t+\t\t}},\n313\t+\t\t{name: \"500\", repos: []Repo{{\"o\", \"r\"}}, requests: 1, anyErr: true, handler: func(w http.ResponseWriter, r *http.Request) {\n314\t+\t\t\tw.WriteHeader(http.StatusInternalServerError)\n315\t+\t\t}},\n316\t+\t}\n317\t+\tfor _, tc := range tests {\n318\t+\t\tt.Run(tc.name, func(t *testing.T) {\n319\t+\t\t\ta, n := scopedApp(t, tc.handler)\n320\t+\t\t\ttok, err := a.MintReadToken(context.Background(), tc.repos)\n321\t+\t\t\tswitch {\n322\t+\t\t\tcase tc.wantErr != nil:\n323\t+\t\t\t\tif !errors.Is(err, tc.wantErr) {\n324\t+\t\t\t\t\tt.Errorf(\"err = %v, want %v\", err, tc.wantErr)\n325\t+\t\t\t\t}\n326\t+\t\t\tcase tc.anyErr:\n327\t+\t\t\t\tif err == nil {\n328\t+\t\t\t\t\tt.Error(\"want error\")\n329\t+\t\t\t\t}\n330\t+\t\t\tdefault:\n331\t+\t\t\t\tif err != nil || tok.Value != scopedSecretValue || tok.ExpiresAt.Year() != 2030 {\n332\t+\t\t\t\t\tt.Errorf(\"tok = %+v, %v\", tok, err)\n333\t+\t\t\t\t}\n334\t+\t\t\t}\n335\t+\t\t\tif got := n.Load(); got != tc.requests {\n336\t+\t\t\t\tt.Errorf(\"requests = %d, want %d\", got, tc.requests)\n337\t+\t\t\t}\n338\t+\t\t})\n339\t+\t}\n340\t+}\n341\t+\n342\t+func TestRevokeToken(t *testing.T) {\n343\t+\tfor code, wantErr := range map[int]bool{204: false, 401: false, 500: true} {\n344\t+\t\ta, _ := scopedApp(t, func(w http.ResponseWriter, r *http.Request) {\n345\t+\t\t\tif r.Method != http.MethodDelete || r.URL.Path != \"/installation/token\" {\n346\t+\t\t\t\tt.Errorf(\"request = %s %s\", r.Method, r.URL.Path)\n347\t+\t\t\t}\n348\t+\t\t\tif got := r.Header.Get(\"Authorization\"); got != \"Bearer \"+scopedSecretValue {\n349\t+\t\t\t\tt.Errorf(\"Authorization = %q\", got)\n350\t+\t\t\t}\n351\t+\t\t\tw.WriteHeader(code)\n352\t+\t\t})\n353\t+\t\tif err := a.RevokeToken(context.Background(), scopedSecretValue); (err != nil) != wantErr {\n354\t+\t\t\tt.Errorf(\"status %d: err = %v\", code, err)\n355\t+\t\t}\n356\t+\t}\n357\t+}\n358\t+\n359\t+func TestScopedMinterRefusesPAT(t *testing.T) {\n360\t+\tif _, err := ScopedMinter(NewTokenAuth(\"x\")); !errors.Is(err, ErrCannotScope) {\n361\t+\t\tt.Errorf(\"err = %v\", err)\n362\t+\t}\n363\t+\tapp := &AppAuth{AppID: 1}\n364\t+\tif got, err := ScopedMinter(app); err != nil || got != app {\n365\t+\t\tt.Errorf(\"got %v, %v\", got, err)\n366\t+\t}\n367\t+}\n368\t+\n369\t+func TestScopedTokenNotLogged(t *testing.T) {\n370\t+\ttok := ScopedToken{Value: scopedSecretValue}\n371\t+\tvar buf bytes.Buffer\n372\t+\tslog.New(slog.NewJSONHandler(&buf, nil)).Info(\"minted\", \"token\", tok)\n373\t+\tout := buf.String() + fmt.Sprintf(\"%v %s %+v %#v\", tok, tok, tok, tok)\n374\t+\tif strings.Contains(out, scopedSecretValue) {\n375\t+\t\tt.Errorf(\"value leaked: %s\", out)\n376\t+\t}\n377\t+}\n378\tdiff --git a/internal/jobpod/contract.go b/internal/jobpod/contract.go\n379\tnew file mode 100644\n380\tindex 0000000..d1cc872\n381\t--- /dev/null\n382\t+++ b/internal/jobpod/contract.go\n383\t@@ -0,0 +1,165 @@\n384\t+// Package jobpod is the single contract between the controller and a job pod\n385\t+// of the Kubernetes executor: paths, Secret items, the input manifest, the\n386\t+// result route and key helpers. The executor (#317) and the pod side (#316)\n387\t+// both import it and never each other. It imports only executor and gitref.\n388\t+package jobpod\n389\t+\n390\t+import (\n391\t+\t\"crypto/sha256\"\n392\t+\t\"encoding/hex\"\n393\t+\t\"strings\"\n394\t+\n395\t+\t\"github.com/albertcbrown/ard/internal/executor\"\n396\t+)\n397\t+\n398\t+// Containers.\n399\t+const (\n400\t+\tContainerPre   = \"pre\"\n401\t+\tContainerAgent = \"agent\"\n402\t+\tContainerPost  = \"post\"\n403\t+)\n404\t+\n405\t+// Users and groups.\n406\t+const (\n407\t+\tAgentUID   = 65532\n408\t+\tSidecarUID = 65533 // pre and post\n409\t+\tGID        = 65532 // fsGroup\n410\t+)\n411\t+\n412\t+// Volume mount paths.\n413\t+const (\n414\t+\tMountWork   = \"/work\"    // tree without .git: pre rw, agent rw or ro, post ro\n415\t+\tMountJob    = \"/job\"     // pre and agent\n416\t+\tMountOut    = \"/out\"     // agent rw, post ro\n417\t+\tMountCtl    = \"/ctl\"     // pre only: git dirs and pre's HOME\n418\t+\tMountBin    = \"/ard-bin\" // pre rw, agent ro\n419\t+\tMountTmp    = \"/tmp\"     // agent only\n420\t+\tAgentBin    = \"/ard-bin/ard\"\n421\t+\tJobHome     = \"/job/home\"\n422\t+\tJobRole     = \"/job/role\"\n423\t+\tJobSidecar  = \"/job/sidecar\"\n424\t+\tJobHistory  = \"/job/history\"\n425\t+\tAgentConfig = \"/job/home/.claude\"\n426\t+)\n427\t+\n428\t+// Volume names.\n429\t+const (\n430\t+\tVolWork = \"work\"\n431\t+\tVolJob  = \"job\"\n432\t+\tVolOut  = \"out\"\n433\t+\tVolCtl  = \"ctl\"\n434\t+\tVolBin  = \"ard-bin\"\n435\t+\tVolTmp  = \"tmp\"\n436\t+)\n437\t+\n438\t+// AgentPaths is the agent's view of the job, as executor.Paths.\n439\t+func AgentPaths() executor.Paths {\n440\t+\treturn executor.Paths{\n441\t+\t\tWork:      MountWork,\n442\t+\t\tRole:      JobRole,\n443\t+\t\tSidecar:   JobSidecar,\n444\t+\t\tConfigDir: AgentConfig,\n445\t+\t\tHistory:   JobHistory,\n446\t+\t}\n447\t+}\n448\t+\n449\t+// Agent environment.\n450\t+const (\n451\t+\tAgentHome   = JobHome\n452\t+\tAgentTmpdir = \"/tmp\"\n453\t+)\n454\t+\n455\t+// Per-job Secret items. The model credential is stored under its env name.\n456\t+const (\n457\t+\tItemManifest  = \"manifest.json\"\n458\t+\tItemGitAccess = \"token\"      // pre only\n459\t+\tItemResultKey = \"result-key\" // post only\n460\t+\tPreSecretDir  = \"/var/run/ard/pre\"\n461\t+\tPostSecretDir = \"/var/run/ard/post\"\n462\t+\tSecretMode    = 0o440\n463\t+)\n464\t+\n465\t+// ModelEnv lists the env names a model credential may have.\n466\t+var ModelEnv = []string{\"ANTHROPIC_API_KEY\", \"CLAUDE_CODE_OAUTH_TOKEN\"}\n467\t+\n468\t+// Result route served by the post container.\n469\t+const (\n470\t+\tResultPort     = 8080\n471\t+\tResultPortName = \"ard-result\"\n472\t+\tResultPath     = \"/v1/result\"\n473\t+\tRootWork       = \"work\"\n474\t+\tRootOut        = \"out\"\n475\t+\tStdoutName     = \"stdout\"\n476\t+\tDoneName       = \"done\" // marker in /out, never packed\n477\t+)\n478\t+\n479\t+// Pre exit codes: 3 means a retry cannot help, 1 is transient. A short reason\n480\t+// goes to /dev/termination-log.\n481\t+const (\n482\t+\tExitPermanent = 3\n483\t+\tExitTransient = 1\n484\t+)\n485\t+\n486\t+// Labels.\n487\t+const (\n488\t+\tlabelPrefix    = \"ard.albertcbrown/\"\n489\t+\tLabelPartOf    = \"app.kubernetes.io/part-of\"\n490\t+\tLabelComponent = \"app.kubernetes.io/component\"\n491\t+\tLabelInstance  = \"app.kubernetes.io/instance\"\n492\t+\tLabelRepo      = labelPrefix + \"repo\"\n493\t+\tLabelNetwork   = labelPrefix + \"network\"\n494\t+\tLabelJob       = labelPrefix + \"job\"\n495\t+\tLabelIssue     = labelPrefix + \"issue\"\n496\t+\tLabelStage     = labelPrefix + \"stage\"\n497\t+\tLabelRole      = labelPrefix + \"role\"\n498\t+\n499\t+\tComponentJob = \"ard-job\"\n500\t+)\n501\t+\n502\t+// Pod naming.\n503\t+const (\n504\t+\tpodPrefix = \"ard-job-\"\n505\t+\t// MaxJobID is the longest job id whose pod name fits 63 characters.\n506\t+\tMaxJobID = 63 - len(podPrefix)\n507\t+)\n508\t+\n509\t+// PodName is the pod and Secret name of a job. ULIDs are case-insensitive;\n510\t+// names are lowercase.\n511\t+func PodName(id string) string { return podPrefix + strings.ToLower(id) }\n512\t+\n513\t+// RepoLabel is a label value for owner/name: 16 hex of the sha256 of the\n514\t+// lowercased repo.\n515\t+func RepoLabel(repo string) string {\n516\t+\tsum := sha256.Sum256([]byte(strings.ToLower(repo)))\n517\t+\treturn hex.EncodeToString(sum[:8])\n518\t+}\n519\t+\n520\t+// LabelValue returns s as a valid label value of at most 63 characters. A\n521\t+// value that does not fit is cut and given a short hash of the whole.\n522\t+func LabelValue(s string) string {\n523\t+\tclean := func(in string) string {\n524\t+\t\tb := []byte(in)\n525\t+\t\tfor i, c := range b {\n526\t+\t\t\tswitch {\n527\t+\t\t\tcase c >= 'a' && c <= 'z', c >= 'A' && c <= 'Z', c >= '0' && c <= '9', c == '-', c == '_', c == '.':\n528\t+\t\t\tdefault:\n529\t+\t\t\t\tb[i] = '_'\n530\t+\t\t\t}\n531\t+\t\t}\n532\t+\t\treturn strings.Trim(string(b), \"-_.\")\n533\t+\t}\n534\t+\tv := clean(s)\n535\t+\tif v == s && len(v) <= 63 {\n536\t+\t\treturn v\n537\t+\t}\n538\t+\tsum := sha256.Sum256([]byte(s))\n539\t+\th := hex.EncodeToString(sum[:4])\n540\t+\tif len(v) > 63-9 {\n541\t+\t\tv = v[:63-9]\n542\t+\t}\n543\t+\tv = strings.Trim(v, \"-_.\")\n544\t+\tif v == \"\" {\n545\t+\t\treturn h\n546\t+\t}\n547\t+\treturn v + \"-\" + h\n548\t+}\n549\tdiff --git a/internal/jobpod/jobpod_test.go b/internal/jobpod/jobpod_test.go\n550\tnew file mode 100644\n551\tindex 0000000..5a671df\n552\t--- /dev/null\n553\t+++ b/internal/jobpod/jobpod_test.go\n554\t@@ -0,0 +1,160 @@\n555\t+package jobpod\n556\t+\n557\t+import (\n558\t+\t\"errors\"\n559\t+\t\"regexp\"\n560\t+\t\"strings\"\n561\t+\t\"testing\"\n562\t+\n563\t+\t\"github.com/albertcbrown/ard/internal/executor\"\n564\t+)\n565\t+\n566\t+var labelRE = regexp.MustCompile(`^([A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?)?$`)\n567\t+\n568\t+func TestPodName(t *testing.T) {\n569\t+\tid := strings.Repeat(\"A\", MaxJobID)\n570\t+\tn := PodName(id)\n571\t+\tif len(n) > 63 || n != strings.ToLower(n) {\n572\t+\t\tt.Errorf(\"PodName = %q\", n)\n573\t+\t}\n574\t+}\n575\t+\n576\t+func TestLabels(t *testing.T) {\n577\t+\tfor _, in := range []string{strings.Repeat(\"role-\", 20), \"a b/c\", \"--x--\", \"ok\", \"\"} {\n578\t+\t\tv := LabelValue(in)\n579\t+\t\tif len(v) > 63 || !labelRE.MatchString(v) {\n580\t+\t\t\tt.Er