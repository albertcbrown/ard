\treturn t, nil\n }\n \n+// installationID returns the installation id, discovering it when unknown.\n+func (a *AppAuth) installationID(ctx context.Context) (int64, error) {\n+\ta.mu.Lock()\n+\tid := a.instID\n+\ta.mu.Unlock()\n+\tif id != 0 {\n+\t\treturn id, nil\n+\t}\n+\tif _, err := a.installation(ctx); err != nil {\n+\t\treturn 0, err\n+\t}\n+\ta.mu.Lock()\n+\tdefer a.mu.Unlock()\n+\treturn a.instID, nil\n+}\n+\n func (a *AppAuth) discover(ctx context.Context, base http.RoundTripper) (int64, error) {\n \tif a.repo == (Repo{}) {\n \t\treturn 0, errors.New(\"github: cannot discover installation without a repo\")\ndiff --git a/internal/github/scoped.go b/internal/github/scoped.go\nnew file mode 100644\nindex 0000000..430669a\n--- /dev/null\n+++ b/internal/github/scoped.go\n@@ -0,0 +1,146 @@\n+package github\n+\n+import (\n+\t\"bytes\"\n+\t\"context\"\n+\t\"encoding/json\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"io\"\n+\t\"log/slog\"\n+\t\"net/http\"\n+\t\"strings\"\n+\t\"time\"\n+)\n+\n+// ErrCannotScope means the credentials cannot mint scoped tokens.\n+var ErrCannotScope = errors.New(\"github: a personal access token cannot be scoped down; the k8s executor needs GitHub App auth\")\n+\n+// ErrNotInInstallation means a requested repository is not covered by the\n+// App installation.\n+var ErrNotInInstallation = errors.New(\"github: repository is not in the app installation\")\n+\n+// ScopedToken is a short-lived installation token. Its value never reaches a\n+// log or an error message through fmt or slog.\n+type ScopedToken struct {\n+\tValue     string\n+\tExpiresAt time.Time\n+}\n+\n+const redactedToken = \"[token]\"\n+\n+// String hides the value.\n+func (ScopedToken) String() string { return redactedToken }\n+\n+// GoString hides the value for %#v.\n+func (ScopedToken) GoString() string { return redactedToken }\n+\n+// LogValue hides the value from slog.\n+func (ScopedToken) LogValue() slog.Value { return slog.StringValue(redactedToken) }\n+\n+// ScopedMinter returns a as an *AppAuth, or ErrCannotScope for any other kind.\n+func ScopedMinter(a Auth) (*AppAuth, error) {\n+\tif app, ok := a.(*AppAuth); ok && app != nil {\n+\t\treturn app, nil\n+\t}\n+\treturn nil, ErrCannotScope\n+}\n+\n+func (a *AppAuth) apiBase() (http.RoundTripper, string) {\n+\ta.mu.Lock()\n+\tdefer a.mu.Unlock()\n+\tbase := a.base\n+\tif base == nil {\n+\t\tbase = http.DefaultTransport\n+\t}\n+\tu := a.baseURL\n+\tif u == \"\" {\n+\t\tu = defaultBaseURL\n+\t}\n+\treturn base, strings.TrimRight(u, \"/\")\n+}\n+\n+// MintReadToken mints an installation token limited to contents:read on repos.\n+// Every repo must belong to the installation's owner; otherwise no request is made.\n+func (a *AppAuth) MintReadToken(ctx context.Context, repos []Repo) (ScopedToken, error) {\n+\tif len(repos) == 0 {\n+\t\treturn ScopedToken{}, errors.New(\"github: no repositories to scope the token to\")\n+\t}\n+\ta.mu.Lock()\n+\towner := a.repo.Owner\n+\ta.mu.Unlock()\n+\tnames := make([]string, 0, len(repos))\n+\tfor _, r := range repos {\n+\t\tif r.Name == \"\" || !strings.EqualFold(r.Owner, owner) {\n+\t\t\treturn ScopedToken{}, fmt.Errorf(\"%w: %s\", ErrNotInInstallation, r)\n+\t\t}\n+\t\tnames = append(names, r.Name)\n+\t}\n+\tid, err := a.installationID(ctx)\n+\tif err != nil {\n+\t\treturn ScopedToken{}, err\n+\t}\n+\tbase, root := a.apiBase()\n+\tjwt, err := a.appsTransport(base)\n+\tif err != nil {\n+\t\treturn ScopedToken{}, err\n+\t}\n+\tpayload, err := json.Marshal(map[string]any{\n+\t\t\"repositories\": names,\n+\t\t\"permissions\":  map[string]string{\"contents\": \"read\"},\n+\t})\n+\tif err != nil {\n+\t\treturn ScopedToken{}, err\n+\t}\n+\turl := fmt.Sprintf(\"%s/app/installations/%d/access_tokens\", root, id)\n+\treq, err := http.NewRequestWithContext(ctx, http.MethodPost, url, bytes.NewReader(payload))\n+\tif err != nil {\n+\t\treturn ScopedToken{}, err\n+\t}\n+\treq.Header.Set(\"Accept\", \"application/vnd.github+json\")\n+\treq.Header.Set(\"Content-Type\", \"application/json\")\n+\tresp, err := newAPIClient(jwt).Do(req)\n+\tif err != nil {\n+\t\treturn ScopedToken{}, fmt.Errorf(\"github: mint scoped token: %w\", err)\n+\t}\n+\tdefer resp.Body.Close()\n+\tbody, _ := io.ReadAll(io.LimitReader(resp.Body, 1<<20))\n+\tswitch resp.StatusCode {\n+\tcase http.StatusCreated:\n+\tcase http.StatusUnprocessableEntity:\n+\t\treturn ScopedToken{}, fmt.Errorf(\"%w: %s\", ErrNotInInstallation, errorMessage(body))\n+\tdefault:\n+\t\treturn ScopedToken{}, fmt.Errorf(\"github: mint scoped token: %w\", statusError(resp.StatusCode, body))\n+\t}\n+\tvar out struct {\n+\t\tToken     string    `json:\"token\"`\n+\t\tExpiresAt time.Time `json:\"expires_at\"`\n+\t}\n+\tif err := json.Unmarshal(body, &out); err != nil || out.Token == \"\" {\n+\t\treturn ScopedToken{}, errors.New(\"github: mint scoped token: unexpected response\")\n+\t}\n+\treturn ScopedToken{Value: out.Token, ExpiresAt: out.ExpiresAt}, nil\n+}\n+\n+// RevokeToken revokes an installation token. An already revoked or expired\n+// token (401) counts as success.\n+func (a *AppAuth) RevokeToken(ctx context.Context, tok string) error {\n+\tbase, root := a.apiBase()\n+\treq, err := http.NewRequestWithContext(ctx, http.MethodDelete, root+\"/installation/token\", nil)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\treq.Header.Set(\"Accept\", \"application/vnd.github+json\")\n+\treq.Header.Set(\"Authorization\", \"Bearer \"+tok)\n+\tresp, err := newAPIClient(base).Do(req)\n+\tif err != nil {\n+\t\treturn fmt.Errorf(\"github: revoke token: %w\", err)\n+\t}\n+\tdefer resp.Body.Close()\n+\tbody, _ := io.ReadAll(io.LimitReader(resp.Body, 1<<20))\n+\tswitch resp.StatusCode {\n+\tcase http.StatusNoContent, http.StatusUnauthorized:\n+\t\treturn nil\n+\t}\n+\treturn fmt.Errorf(\"github: revoke token: %w\", statusError(resp.StatusCode, body))\n+}\ndiff --git a/internal/github/scoped_test.go b/internal/github/scoped_test.go\nnew file mode 100644\nindex 0000000..8fad867\n--- /dev/null\n+++ b/internal/github/scoped_test.go\n@@ -0,0 +1,133 @@\n+package github\n+\n+import (\n+\t\"bytes\"\n+\t\"context\"\n+\t\"encoding/json\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"log/slog\"\n+\t\"net/http\"\n+\t\"net/http/httptest\"\n+\t\"strings\"\n+\t\"sync/atomic\"\n+\t\"testing\"\n+)\n+\n+const scopedSecretValue = \"scoped-value-for-tests\"\n+\n+func scopedApp(t *testing.T, h http.HandlerFunc) (*AppAuth, *atomic.Int32) {\n+\tt.Helper()\n+\tvar n atomic.Int32\n+\tsrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n+\t\tn.Add(1)\n+\t\th(w, r)\n+\t}))\n+\tt.Cleanup(srv.Close)\n+\ta := &AppAuth{AppID: 12, InstallationID: 34, PrivateKey: []byte(testKeyPEM(t))}\n+\ta.configure(Repo{\"o\", \"r\"}, srv.URL)\n+\treturn a, &n\n+}\n+\n+func TestMintReadToken(t *testing.T) {\n+\ttests := []struct {\n+\t\tname     string\n+\t\trepos    []Repo\n+\t\thandler  http.HandlerFunc\n+\t\twantErr  error\n+\t\tanyErr   bool\n+\t\trequests int32\n+\t}{\n+\t\t{name: \"created\", repos: []Repo{{\"o\", \"r\"}, {\"o\", \"side\"}}, requests: 1, handler: func(w http.ResponseWriter, r *http.Request) {\n+\t\t\tif r.Method != http.MethodPost || r.URL.Path != \"/app/installations/34/access_tokens\" {\n+\t\t\t\tt.Errorf(\"request = %s %s\", r.Method, r.URL.Path)\n+\t\t\t}\n+\t\t\tif strings.Count(r.Header.Get(\"Authorization\"), \".\") != 2 {\n+\t\t\t\tt.Errorf(\"not a JWT: %q\", r.Header.Get(\"Authorization\"))\n+\t\t\t}\n+\t\t\tvar body struct {\n+\t\t\t\tRepositories []string          `json:\"repositories\"`\n+\t\t\t\tPermissions  map[string]string `json:\"permissions\"`\n+\t\t\t}\n+\t\t\tif err := json.NewDecoder(r.Body).Decode(&body); err != nil {\n+\t\t\t\tt.Error(err)\n+\t\t\t}\n+\t\t\tif fmt.Sprint(body.Repositories) != \"[r side]\" || len(body.Permissions) != 1 || body.Permissions[\"contents\"] != \"read\" {\n+\t\t\t\tt.Errorf(\"body = %+v\", body)\n+\t\t\t}\n+\t\t\tw.WriteHeader(http.StatusCreated)\n+\t\t\tfmt.Fprintf(w, `{\"token\":%q,\"expires_at\":\"2030-01-01T00:00:00Z\"}`, scopedSecretValue)\n+\t\t}},\n+\t\t{name: \"422\", repos: []Repo{{\"o\", \"r\"}}, requests: 1, wantErr: ErrNotInInstallation, handler: func(w http.ResponseWriter, r *http.Request) {\n+\t\t\tw.WriteHeader(http.StatusUnprocessableEntity)\n+\t\t\tfmt.Fprint(w, `{\"message\":\"repo not accessible\"}`)\n+\t\t}},\n+\t\t{name: \"other owner\", repos: []Repo{{\"x\", \"r\"}}, requests: 0, wantErr: ErrNotInInstallation, handler: func(w http.ResponseWriter, r *http.Request) {}},\n+\t\t{name: \"redirect\", repos: []Repo{{\"o\", \"r\"}}, requests: 1, anyErr: true, handler: func(w http.ResponseWriter, r *http.Request) {\n+\t\t\thttp.Redirect(w, r, \"/elsewhere\", http.StatusFound)\n+\t\t}},\n+\t\t{name: \"500\", repos: []Repo{{\"o\", \"r\"}}, requests: 1, anyErr: true, handler: func(w http.ResponseWriter, r *http.Request) {\n+\t\t\tw.WriteHeader(http.StatusInternalServerError)\n+\t\t}},\n+\t}\n+\tfor _, tc := range tests {\n+\t\tt.Run(tc.name, func(t *testing.T) {\n+\t\t\ta, n := scopedApp(t, tc.handler)\n+\t\t\ttok, err := a.MintReadToken(context.Background(), tc.repos)\n+\t\t\tswitch {\n+\t\t\tcase tc.wantErr != nil:\n+\t\t\t\tif !errors.Is(err, tc.wantErr) {\n+\t\t\t\t\tt.Errorf(\"err = %v, want %v\", err, tc.wantErr)\n+\t\t\t\t}\n+\t\t\tcase tc.anyErr:\n+\t\t\t\tif err == nil {\n+\t\t\t\t\tt.Error(\"want error\")\n+\t\t\t\t}\n+\t\t\tdefault:\n+\t\t\t\tif err != nil || tok.Value != scopedSecretValue || tok.ExpiresAt.Year() != 2030 {\n+\t\t\t\t\tt.Errorf(\"tok = %+v, %v\", tok, err)\n+\t\t\t\t}\n+\t\t\t}\n+\t\t\tif got := n.Load(); got != tc.requests {\n+\t\t\t\tt.Errorf(\"requests = %d, want %d\", got, tc.requests)\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+func TestRevokeToken(t *testing.T) {\n+\tfor code, wantErr := range map[int]bool{204: false, 401: false, 500: true} {\n+\t\ta, _ := scopedApp(t, func(w http.ResponseWriter, r *http.Request) {\n+\t\t\tif r.Method != http.MethodDelete || r.URL.Path != \"/installation/token\" {\n+\t\t\t\tt.Errorf(\"request = %s %s\", r.Method, r.URL.Path)\n+\t\t\t}\n+\t\t\tif got := r.Header.Get(\"Authorization\"); got != \"Bearer \"+scopedSecretValue {\n+\t\t\t\tt.Errorf(\"Authorization = %q\", got)\n+\t\t\t}\n+\t\t\tw.WriteHeader(code)\n+\t\t})\n+\t\tif err := a.RevokeToken(context.Background(), scopedSecretValue); (err != nil) != wantErr {\n+\t\t\tt.Errorf(\"status %d: err = %v\", code, err)\n+\t\t}\n+\t}\n+}\n+\n+func TestScopedMinterRefusesPAT(t *testing.T) {\n+\tif _, err := ScopedMinter(NewTokenAuth(\"x\")); !errors.Is(err, ErrCannotScope) {\n+\t\tt.Errorf(\"err = %v\", err)\n+\t}\n+\tapp := &AppAuth{AppID: 1}\n+\tif got, err := ScopedMinter(app); err != nil || got != app {\n+\t\tt.Errorf(\"got %v, %v\", got, err)\n+\t}\n+}\n+\n+func TestScopedTokenNotLogged(t *testing.T) {\n+\ttok := ScopedToken{Value: scopedSecretValue}\n+\tvar buf bytes.Buffer\n+\tslog.New(slog.NewJSONHandler(&buf, nil)).Info(\"minted\", \"token\", tok)\n+\tout := buf.String() + fmt.Sprintf(\"%v %s %+v %#v\", tok, tok, tok, tok)\n+\tif strings.Contains(out, scopedSecretValue) {\n+\t\tt.Errorf(\"value leaked: %s\", out)\n+\t}\n+}\ndiff --git a/internal/jobpod/contract.go b/internal/jobpod/contract.go\nnew file mode 100644\nindex 0000000..d1cc872\n--- /dev/null\n+++ b/internal/jobpod/contract.go\n@@ -0,0 +1,165 @@\n+// Package jobpod is the single contract between the controller and a job pod\n+// of the Kubernetes executor: paths, Secret items, the input manifest, the\n+// result route and key helpers. The executor (#317) and the pod side (#316)\n+// both import it and never each other. It imports only executor and gitref.\n+package jobpod\n+\n+import (\n+\t\"crypto/sha256\"\n+\t\"encoding/hex\"\n+\t\"strings\"\n+\n+\t\"github.com/albertcbrown/ard/internal/executor\"\n+)\n+\n+// Containers.\n+const (\n+\tContainerPre   = \"pre\"\n+\tContainerAgent = \"agent\"\n+\tContainerPost  = \"post\"\n+)\n+\n+// Users and groups.\n+const (\n+\tAgentUID   = 65532\n+\tSidecarUID = 65533 // pre and post\n+\tGID        = 65532 // fsGroup\n+)\n+\n+// Volume mount paths.\n+const (\n+\tMountWork   = \"/work\"    // tree without .git: pre rw, agent rw or ro, post ro\n+\tMountJob    = \"/job\"     // pre and agent\n+\tMountOut    = \"/out\"     // agent rw, post ro\n+\tMountCtl    = \"/ctl\"     // pre only: git dirs and pre's HOME\n+\tMountBin    = \"/ard-bin\" // pre rw, agent ro\n+\tMountTmp    = \"/tmp\"     // agent only\n+\tAgentBin    = \"/ard-bin/ard\"\n+\tJobHome     = \"/job/home\"\n+\tJobRole     = \"/job/role\"\n+\tJobSidecar  = \"/job/sidecar\"\n+\tJobHistory  = \"/job/history\"\n+\tAgentConfig = \"/job/home/.claude\"\n+)\n+\n+// Volume names.\n+const (\n+\tVolWork = \"work\"\n+\tVolJob  = \"job\"\n+\tVolOut  = \"out\"\n+\tVolCtl  = \"ctl\"\n+\tVolBin  = \"ard-bin\"\n+\tVolTmp  = \"tmp\"\n+)\n+\n+// AgentPaths is the agent's view of the job, as executor.Paths.\n+func AgentPaths() executor.Paths {\n+\treturn executor.Paths{\n+\t\tWork:      MountWork,\n+\t\tRole:      JobRole,\n+\t\tSidecar:   JobSidecar,\n+\t\tConfigDir: AgentConfig,\n+\t\tHistory:   JobHistory,\n+\t}\n+}\n+\n+// Agent environment.\n+const (\n+\tAgentHome   = JobHome\n+\tAgentTmpdir = \"/tmp\"\n+)\n+\n+// Per-job Secret items. The model credential is stored under its env name.\n+const (\n+\tItemManifest  = \"manifest.json\"\n+\tItemGitAccess = \"token\"      // pre only\n+\tItemResultKey = \"result-key\" // post only\n+\tPreSecretDir  = \"/var/run/ard/pre\"\n+\tPostSecretDir = \"/var/run/ard/post\"\n+\tSecretMode    = 0o440\n+)\n+\n+// ModelEnv lists the env names a model credential may have.\n+var ModelEnv = []string{\"ANTHROPIC_API_KEY\", \"CLAUDE_CODE_OAUTH_TOKEN\"}\n+\n+// Result route served by the post container.\n+const (\n+\tResultPort     = 8080\n+\tResultPortName = \"ard-result\"\n+\tResultPath     = \"/v1/result\"\n+\tRootWork       = \"work\"\n+\tRootOut        = \"out\"\n+\tStdoutName     = \"stdout\"\n+\tDoneName       = \"done\" // marker in /out, never packed\n+)\n+\n+// Pre exit codes: 3 means a retry cannot help, 1 is transient. A short reason\n+// goes to /dev/termination-log.\n+const (\n+\tExitPermanent = 3\n+\tExitTransient = 1\n+)\n+\n+// Labels.\n+const (\n+\tlabelPrefix    = \"ard.albertcbrown/\"\n+\tLabelPartOf    = \"app.kubernetes.io/part-of\"\n+\tLabelComponent = \"app.kubernetes.io/component\"\n+\tLabelInstance  = \"app.kubernetes.io/instance\"\n+\tLabelRepo      = labelPrefix + \"repo\"\n+\tLabelNetwork   = labelPrefix + \"network\"\n+\tLabelJob       = labelPrefix + \"job\"\n+\tLabelIssue     = labelPrefix + \"issue\"\n+\tLabelStage     = labelPrefix + \"stage\"\n+\tLabelRole      = labelPrefix + \"role\"\n+\n+\tComponentJob = \"ard-job\"\n+)\n+\n+// Pod naming.\n+const (\n+\tpodPrefix = \"ard-job-\"\n+\t// MaxJobID is the longest job id whose pod name fits 63 characters.\n+\tMaxJobID = 63 - len(podPrefix)\n+)\n+\n+// PodName is the pod and Secret name of a job. ULIDs are case-insensitive;\n+// names are lowercase.\n+func PodName(id string) string { return podPrefix + strings.ToLower(id) }\n+\n+// RepoLabel is a label value for owner/name: 16 hex of the sha256 of the\n+// lowercased repo.\n+func RepoLabel(repo string) string {\n+\tsum := sha256.Sum256([]byte(strings.ToLower(repo)))\n+\treturn hex.EncodeToString(sum[:8])\n+}\n+\n+// LabelValue returns s as a valid label value of at most 63 characters. A\n+// value that does not fit is cut and given a short hash of the whole.\n+func LabelValue(s string) string {\n+\tclean := func(in string) string {\n+\t\tb := []byte(in)\n+\t\tfor i, c := range b {\n+\t\t\tswitch {\n+\t\t\tcase c >= 'a' && c <= 'z', c >= 'A' && c <= 'Z', c >= '0' && c <= '9', c == '-', c == '_', c == '.':\n+\t\t\tdefault:\n+\t\t\t\tb[i] = '_'\n+\t\t\t}\n+\t\t}\n+\t\treturn strings.Trim(string(b), \"-_.\")\n+\t}\n+\tv := clean(s)\n+\tif v == s && len(v) <= 63 {\n+\t\treturn v\n+\t}\n+\tsum := sha256.Sum256([]byte(s))\n+\th := hex.EncodeToString(sum[:4])\n+\tif len(v) > 63-9 {\n+\t\tv = v[:63-9]\n+\t}\n+\tv = strings.Trim(v, \"-_.\")\n+\tif v == \"\" {\n+\t\treturn h\n+\t}\n+\treturn v + \"-\" + h\n+}\ndiff --git a/internal/jobpod/jobpod_test.go b/internal/jobpod/jobpod_test.go\nnew file mode 100644\nindex 0000000..5a671df\n--- /dev/null\n+++ b/internal/jobpod/jobpod_test.go\n@@ -0,0 +1,160 @@\n+package jobpod\n+\n+import (\n+\t\"errors\"\n+\t\"regexp\"\n+\t\"strings\"\n+\t\"testing\"\n+\n+\t\"github.com/albertcbrown/ard/internal/executor\"\n+)\n+\n+var labelRE = regexp.MustCompile(`^([A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?)?$`)\n+\n+func TestPodName(t *testing.T) {\n+\tid := strings.Repeat(\"A\", MaxJobID)\n+\tn := PodName(id)\n+\tif len(n) > 63 || n != strings.ToLower(n) {\n+\t\tt.Errorf(\"PodName = %q\", n)\n+\t}\n+}\n+\n+func TestLabels(t *testing.T) {\n+\tfor _, in := range []string{strings.Repeat(\"role-\", 20), \"a b/c\", \"--x--\", \"ok\", \"\"} {\n+\t\tv := LabelValue(in)\n+\t\tif len(v) > 63 || !labelRE.MatchString(v) {\n+\t\t\tt.Errorf(\"LabelValue(%q) = %q\", in, v)\n+\t\t}\n+\t}\n+\tif LabelValue(\"ok\") != \"ok\" {\n+\t\tt.Error(\"valid value changed\")\n+\t}\n+\tif r := RepoLabel(\"Owner/Repo\"); len(r) != 16 || !labelRE.MatchString(r) || r != RepoLabel(\"owner/repo\") {\n+\t\tt.Errorf(\"RepoLabel = %q\", r)\n+\t}\n+}\n+\n+func TestItemsDistinct(t *testing.T) {\n+\tseen := map[string]bool{}\n+\tfor _, n := range append([]string{ItemManifest, ItemGitAccess, ItemResultKey}, ModelEnv...) {\n+\t\tif seen[n] {\n+\t\t\tt.Errorf(\"duplicate item %q\", n)\n+\t\t}\n+\t\tseen[n] = true\n+\t}\n+}\n+\n+const sha = \"0123456789abcdef0123456789abcdef01234567\"\n+\n+func good() Manifest {\n+\treturn Manifest{\n+\t\tV: ManifestVersion, Repo: \"o/r\", BaseSHA: sha, History: true,\n+\t\tRole:    Source{Repo: \"o/r\", SHA: sha, Path: \".ard/roles/x\"},\n+\t\tSidecar: &Source{Repo: \"o/side\", SHA: sha},\n+\t\tScrub:   []string{\"a/b\"},\n+\t\tInputs:  []executor.File{{Path: \".ard-input/1/issue.md\", Data: []byte(\"hi\")}},\n+\t}\n+}\n+\n+func TestManifestRoundTrip(t *testing.T) {\n+\tb, err := Encode(good())\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tm, err := Decode(b)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif m.Repo != \"o/r\" || m.Sidecar == nil || string(m.Inputs[0].Data) != \"hi\" || !m.History {\n+\t\tt.Errorf(\"m = %+v\", m)\n+\t}\n+}\n+\n+func TestManifestCap(t *testing.T) {\n+\tm := good()\n+\tm.Inputs = []executor.File{{Path: \"x\"}}\n+\tbase, err := Encode(m)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\t// Base64 makes the encoded size depend on the data, so search for the\n+\t// largest data length that fits, then check the next one does not.\n+\tfits := func(n int) error {\n+\t\tm.Inputs[0].Data = make([]byte, n)\n+\t\t_, err := Encode(m)\n+\t\treturn err\n+\t}\n+\tlo, hi := 0, MaxManifestBytes\n+\tfor lo < hi {\n+\t\tmid := (lo + hi + 1) / 2\n+\t\tif fits(mid) == nil {\n+\t\t\tlo = mid\n+\t\t} else {\n+\t\t\thi = mid - 1\n+\t\t}\n+\t}\n+\tif lo <= len(base) {\n+\t\tt.Fatal(\"search failed\")\n+\t}\n+\tif err := fits(lo); err != nil {\n+\t\tt.Errorf(\"boundary: %v\", err)\n+\t}\n+\tif err := fits(lo + 1); !errors.Is(err, ErrTooLarge) {\n+\t\tt.Errorf(\"cap+1: err = %v\", err)\n+\t}\n+\tif len(base) >= MaxManifestBytes {\n+\t\tt.Error(\"base too big\")\n+\t}\n+}\n+\n+func TestManifestRefusals(t *testing.T) {\n+\ttests := map[string]func(*Manifest){\n+\t\t\"bad sha\":       func(m *Manifest) { m.BaseSHA = \"main\" },\n+\t\t\"bad role sha\":  func(m *Manifest) { m.Role.SHA = \"abc\" },\n+\t\t\"bad sidecar\":   func(m *Manifest) { m.Sidecar.SHA = \"abc\" },\n+\t\t\"dotdot input\":  func(m *Manifest) { m.Inputs[0].Path = \"../x\" },\n+\t\t\"abs input\":     func(m *Manifest) { m.Inputs[0].Path = \"/x\" },\n+\t\t\"abs scrub\":     func(m *Manifest) { m.Scrub = []string{\"/etc/passwd\"} },\n+\t\t\"unclean scrub\": func(m *Manifest) { m.Scrub = []string{\"a/../b\"} },\n+\t\t\"unknown V\":     func(m *Manifest) { m.V = 2 },\n+\t\t\"bad repo\":      func(m *Manifest) { m.Repo = \"norepo\" },\n+\t\t\"role path\":     func(m *Manifest) { m.Role.Path = \"\" },\n+\t}\n+\tfor name, mut := range tests {\n+\t\tm := good()\n+\t\tmut(&m)\n+\t\tif _, err := Encode(m); err == nil {\n+\t\t\tt.Errorf(\"%s: Encode accepted\", name)\n+\t\t}\n+\t}\n+\tif _, err := Decode([]byte(`{\"V\":1,\"Bogus\":1}`)); err == nil {\n+\t\tt.Error(\"unknown field accepted\")\n+\t}\n+\tif _, err := Decode([]byte(`{\"V\":2}`)); err == nil {\n+\t\tt.Error(\"unknown V decoded\")\n+\t}\n+}\n+\n+func TestKeyMatches(t *testing.T) {\n+\tk1, err := NewKey()\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tk2, _ := NewKey()\n+\tif len(k1) != 43 || k1 == k2 {\n+\t\tt.Errorf(\"keys %q %q\", k1, k2)\n+\t}\n+\tif !KeyMatches(k1, k1) || KeyMatches(k1, k2) || KeyMatches(\"\", k1) || KeyMatches(k1, \"\") {\n+\t\tt.Error(\"KeyMatches wrong\")\n+\t}\n+}\n+\n+func TestSecretData(t *testing.T) {\n+\td, err := SecretData([]byte(\"m\"), \"t\", \"k\", \"CLAUDE_CODE_OAUTH_TOKEN\", \"v\")\n+\tif err != nil || string(d[\"CLAUDE_CODE_OAUTH_TOKEN\"]) != \"v\" || string(d[ItemManifest]) != \"m\" {\n+\t\tt.Errorf(\"d = %v, %v\", d, err)\n+\t}\n+\tif _, err := SecretData(nil, \"t\", \"k\", \"PATH\", \"v\"); err == nil {\n+\t\tt.Error(\"unknown model name accepted\")\n+\t}\n+}\ndiff --git a/internal/jobpod/manifest.go b/internal/jobpod/manifest.go\nnew file mode 100644\nindex 0000000..bb36452\n--- /dev/null\n+++ b/internal/jobpod/manifest.go\n@@ -0,0 +1,133 @@\n+package jobpod\n+\n+import (\n+\t\"bytes\"\n+\t\"encoding/json\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"path\"\n+\t\"strings\"\n+\n+\t\"github.com/albertcbrown/ard/internal/executor\"\n+\t\"github.com/albertcbrown/ard/internal/gitref\"\n+)\n+\n+// ManifestVersion is the only manifest version this package reads.\n+const ManifestVersion = 1\n+\n+// MaxManifestBytes caps the encoded manifest. The cap is on the JSON, because\n+// base64 grows inputs by a third and a Secret is limited to 1 MiB.\n+const MaxManifestBytes = 768 << 10\n+\n+// ErrTooLarge means the encoded manifest is over MaxManifestBytes.\n+var ErrTooLarge = errors.New(\"jobpod: manifest exceeds the size cap\")\n+\n+// Source names a tree at a commit.\n+type Source struct {\n+\tRepo string // owner/name\n+\tSHA  string // 40-hex\n+\tPath string // directory within the repo; unused for sidecars\n+}\n+\n+// Manifest tells the pre container what to fetch and place.\n+type Manifest struct {\n+\tV        int\n+\tRepo     string // owner/name\n+\tBaseSHA  string\n+\tHistory  bool\n+\tReadOnly bool\n+\tRole     Source  // role dir at the config commit\n+\tSidecar  *Source // pinned SHA\n+\tScrub    []string\n+\tInputs   []executor.File\n+}\n+\n+// Encode validates and encodes m, refusing more than MaxManifestBytes.\n+func Encode(m Manifest) ([]byte, error) {\n+\tif err := m.validate(); err != nil {\n+\t\treturn nil, err\n+\t}\n+\tb, err := json.Marshal(m)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tif len(b) > MaxManifestBytes {\n+\t\treturn nil, fmt.Errorf(\"%w: %d > %d bytes\", ErrTooLarge, len(b), MaxManifestBytes)\n+\t}\n+\treturn b, nil\n+}\n+\n+// Decode parses and validates a manifest. Unknown fields are refused.\n+func Decode(b []byte) (Manifest, error) {\n+\tvar m Manifest\n+\tif len(b) > MaxManifestBytes {\n+\t\treturn m, ErrTooLarge\n+\t}\n+\tdec := json.NewDecoder(bytes.NewReader(b))\n+\tdec.DisallowUnknownFields()\n+\tif err := dec.Decode(&m); err != nil {\n+\t\treturn Manifest{}, fmt.Errorf(\"jobpod: manifest: %w\", err)\n+\t}\n+\tif err := m.validate(); err != nil {\n+\t\treturn Manifest{}, err\n+\t}\n+\treturn m, nil\n+}\n+\n+func (m Manifest) validate() error {\n+\tif m.V != ManifestVersion {\n+\t\treturn fmt.Errorf(\"jobpod: manifest version %d, want %d\", m.V, ManifestVersion)\n+\t}\n+\tif !validRepo(m.Repo) {\n+\t\treturn fmt.Errorf(\"jobpod: bad repo %q\", m.Repo)\n+\t}\n+\tif !gitref.IsSHA(m.BaseSHA) {\n+\t\treturn errors.New(\"jobpod: base sha is not a 40-hex commit\")\n+\t}\n+\tif err := m.Role.validate(\"role\", true); err != nil {\n+\t\treturn err\n+\t}\n+\tif m.Sidecar != nil {\n+\t\tif err := m.Sidecar.validate(\"sidecar\", false); err != nil {\n+\t\t\treturn err\n+\t\t}\n+\t}\n+\tfor _, p := range m.Scrub {\n+\t\tif !cleanRel(p) {\n+\t\t\treturn fmt.Errorf(\"jobpod: scrub path %q is not a clean relative path\", p)\n+\t\t}\n+\t}\n+\tfor _, f := range m.Inputs {\n+\t\tif !cleanRel(f.Path) {\n+\t\t\treturn fmt.Errorf(\"jobpod: input path %q is not a clean relative path\", f.Path)\n+\t\t}\n+\t}\n+\treturn nil\n+}\n+\n+func (s Source) validate(what string, needPath bool) error {\n+\tif !validRepo(s.Repo) {\n+\t\treturn fmt.Errorf(\"jobpod: %s: bad repo %q\", what, s.Repo)\n+\t}\n+\tif !gitref.IsSHA(s.SHA) {\n+\t\treturn fmt.Errorf(\"jobpod: %s: sha is not a 40-hex commit\", what)\n+\t}\n+\tif needPath && !cleanRel(s.Path) {\n+\t\treturn fmt.Errorf(\"jobpod: %s: path %q is not a clean relative path\", what, s.Path)\n+\t}\n+\treturn nil\n+}\n+\n+func validRepo(r string) bool {\n+\to, n, ok := strings.Cut(r, \"/\")\n+\treturn ok && o != \"\" && n != \"\" && !strings.Contains(n, \"/\") &&\n+\t\t!strings.ContainsAny(r, \" \\t\\n\\\\:\") && o != \"..\" && n != \"..\" && o != \".\" && n != \".\"\n+}\n+\n+// cleanRel reports whether p is a non-empty, relative, already-clean path.\n+func cleanRel(p string) bool {\n+\tif p == \"\" || strings.HasPrefix(p, \"/\") || strings.Contains(p, \"\\\\\") || strings.ContainsRune(p, 0) {\n+\t\treturn false\n+\t}\n+\treturn path.Clean(p) == p && p != \".\" && p != \"..\" && !strings.HasPrefix(p, \"../\")\n+}\ndiff --git a/internal/jobpod/secret.go b/internal/jobpod/secret.go\nnew file mode 100644\nindex 0000000..5f50e92\n--- /dev/null\n+++ b/internal/jobpod/secret.go\n@@ -0,0 +1,39 @@\n+package jobpod\n+\n+import (\n+\t\"crypto/rand\"\n+\t\"crypto/sha256\"\n+\t\"crypto/subtle\"\n+\t\"encoding/base64\"\n+\t\"fmt\"\n+\t\"slices\"\n+)\n+\n+// NewKey returns a fresh 32-byte result key as raw base64url.\n+func NewKey() (string, error) {\n+\tb := make([]byte, 32)\n+\tif _, err := rand.Read(b); err != nil {\n+\t\treturn \"\", fmt.Errorf(\"jobpod: key: %w\", err)\n+\t}\n+\treturn base64.RawURLEncoding.EncodeToString(b), nil\n+}\n+\n+// SecretData builds the per-job Secret's items. modelName must be one of\n+// ModelEnv.\n+func SecretData(manifest []byte, gitToken, resultKey, modelName, modelValue string) (map[string][]byte, error) {\n+\tif !slices.Contains(ModelEnv, modelName) {\n+\t\treturn nil, fmt.Errorf(\"jobpod: %q is not an allowed model credential name\", modelName)\n+\t}\n+\treturn map[string][]byte{\n+\t\tItemManifest:  manifest,\n+\t\tItemGitAccess: []byte(gitToken),\n+\t\tItemResultKey: []byte(resultKey),\n+\t\tmodelName:     []byte(modelValue),\n+\t}, nil\n+}\n+\n+// KeyMatches compares keys in constant time, whatever their lengths.\n+func KeyMatches(got, want string) bool {\n+\ta, b := sha256.Sum256([]byte(got)), sha256.Sum256([]byte(want))\n+\treturn subtle.ConstantTimeCompare(a[:], b[:]) == 1\n+}\n","numLines":899,"startLine":1,"totalLines":899}},"tool_result_meta":[{"id":"toolu_01WXPbQ5z3Kh9LTcaqy5Q1PX","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
