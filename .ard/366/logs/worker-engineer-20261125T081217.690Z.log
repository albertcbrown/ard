, \"-q\", \"-b\", \"c2\", base)\n\tput(\"f.py\", lines(\"c2\", \"z\"))\n\trun(\"commit\", \"-q\", \"-m\", \"c2\")\n\ttree = run(\"write-tree\")\n\tcm := run(\"commit-tree\", tree, \"-p\", \"c1\", \"-p\", \"c2\", \"-m\", \"resolved\")\n\tif ok, err := g.MergeTreeEqual(ctx, dir, cm); err != nil || ok {\n\t\tt.Fatalf(\"conflict merge: %v %v\", ok, err)\n\t}\n\n\t// Not a merge, and a bad rev: errors.\n\tif _, err := g.MergeTreeEqual(ctx, dir, base); err == nil {\n\t\tt.Error(\"non-merge: want error\")\n\t}\n\tif _, err := g.MergeTreeEqual(ctx, dir, \"nope\"); err == nil {\n\t\tt.Error(\"bad rev: want error\")\n\t}\n\n\t// A git that rejects merge-tree --write-tree fails closed.\n\treal, err := exec.LookPath(\"git\")\n\tif err != nil {\n\t\tt.Skip(\"no git\")\n\t}\n\tstub := filepath.Join(t.TempDir(), \"git\")\n\tscript := \"#!/bin/sh\\nfor a in \\\"$@\\\"; do [ \\\"$a\\\" = merge-tree ] && exit 129; done\\nexec \" + real + \" \\\"$@\\\"\\n\"\n\tif err := os.WriteFile(stub, []byte(script), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif ok, err := New(stub).MergeTreeEqual(ctx, dir, clean); err == nil || ok {\n\t\tt.Fatalf(\"old git: %v %v, want error\", ok, err)\n\t}\n}\nEOF\nsed -n 3,16p internal/gitx/inspect_test.go"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":452,"cache_read_input_tokens":38281,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":452},"output_tokens":9,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c728f002-51cb-4e7c-ab13-963c0e6353ab","uuid":"73508cac-29df-475e-bfab-fa644617dd3f","timestamp":"2026-11-25T08:12:58.895Z","request_id":"req_011ChPJxGyqUUJQt3rdxQAgK"}
