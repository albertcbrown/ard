{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017babwY6VnFH8rAZhdVNr3j","type":"tool_result","content":"package worker\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/agentjob\"\n\t\"github.com/albertcbrown/ard/internal/closeout\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/executor\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/reviewfix\"\n)\n\nconst feedbackCap = 64 << 10\n\n// reviewFeedback builds review-feedback.md for a review fix round: the round,\n// the committed reviewer role files and the pull request comments of people.\n// It applies only when the issue's newest round is requested.\nfunc (l *Loop) reviewFeedback(ctx context.Context, role config.Role, n int, branch string) (executor.File, bool, error) {\n\td := l.d\n\trs, err := reviewfix.Rounds(ctx, d.Store, n)\n\tif err != nil {\n\t\treturn executor.File{}, false, fmt.Errorf(\"read review rounds: %w\", err)\n\t}\n\tif len(rs) == 0 || rs[len(rs)-1].Phase != reviewfix.PhaseRequested {\n\t\treturn executor.File{}, false, nil\n\t}\n\tr := rs[len(rs)-1]\n\tvar b strings.Builder\n\tb.WriteString(agentjob.UntrustedHeader)\n\tfmt.Fprintf(&b, \"Review round %d of %d; reviewers asking for changes: %s.\\n\", r.N, role.MaxReviewRounds, strings.Join(r.Roles, \", \"))\n\tfor _, rr := range r.Roles {\n\t\tdata, ok, err := d.Git.FileAt(ctx, d.RepoDir, localRef(branch), fmt.Sprintf(\".ard/%d/review-%s.md\", n, rr), closeout.MaxRoleFileBytes)\n\t\tif err != nil {\n\t\t\treturn executor.File{}, false, fmt.Errorf(\"read review-%s.md: %w\", rr, err)\n\t\t}\n\t\tif ok {\n\t\t\tfmt.Fprintf(&b, \"\\n### review-%s.md\\n\\n%s\\n\", rr, data)\n\t\t}\n\t}\n\tid, err := d.Reader.Identity(ctx)\n\tif err != nil {\n\t\treturn executor.File{}, false, fmt.Errorf(\"identity: %w\", err)\n\t}\n\tprs, err := d.Reader.ListPRs(ctx, github.ListPRsOpts{State: github.StateOpen, Head: branch})\n\tif err != nil {\n\t\treturn executor.File{}, false, fmt.Errorf(\"list PRs: %w\", err)\n\t}\n\tb.WriteString(\"\\n### Pull request comments\\n\")\n\tif len(prs) > 0 {\n\t\tpr := prs[0].Number\n\t\tcs, err := d.Reader.ListComments(ctx, pr, time.Time{})\n\t\tif err != nil {\n\t\t\treturn executor.File{}, false, fmt.Errorf(\"list comments: %w\", err)\n\t\t}\n\t\trcs, err := d.Reader.ListReviewComments(ctx, pr)\n\t\tif err != nil {\n\t\t\treturn executor.File{}, false, fmt.Errorf(\"list review comments: %w\", err)\n\t\t}\n\t\tfor _, c := range cs {\n\t\t\tif !strings.EqualFold(c.Author, id.Login) {\n\t\t\t\tfmt.Fprintf(&b, \"\\n#### %s at %s\\n\\n%s\\n\", c.Author, c.CreatedAt.Format(time.RFC3339), c.Body)\n\t\t\t}\n\t\t}\n\t\tfor _, c := range rcs {\n\t\t\tif !strings.EqualFold(c.Author, id.Login) {\n\t\t\t\tfmt.Fprintf(&b, \"\\n#### %s at %s, %s:%d\\n\\n%s\\n\", c.Author, c.CreatedAt.Format(time.RFC3339), c.Path, c.Line, c.Body)\n\t\t\t}\n\t\t}\n\t}\n\tout := b.String()\n\tif len(out) > feedbackCap {\n\t\tout = strings.ToValidUTF8(out[:feedbackCap], \"\") + \"\\n[truncated]\\n\"\n\t}\n\treturn executor.File{Path: agentjob.InputDir(n) + \"/review-feedback.md\", Data: []byte(out)}, true, nil\n}\npackage worker\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"fmt\"\n\t\"io\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n\t\"github.com/albertcbrown/ard/internal/redact\"\n)\n\nconst binarySniff = 8 << 10\n\n// facts gathers what Check needs for the step whose worktree is wt and whose\n// base commit is base. The worktree belongs to the agent, so nothing in it is\n// trusted: the changes come from a gitx.Snapshot (the controller's own\n// repository, a private index, no worktree config or attributes), and every\n// file is read through os.Root, so a symlink is never followed. The bytes read\n// here are copied into stage (a controller-private directory) and the code\n// lane commits the copies, so a process that survives the step cannot swap a\n// file between the scan and the commit; Check passes the lane only the files\n// it saw. A scanner error marks\n// the file ScanFailed (fail closed).\n//\n// The pattern scan keeps only findings on lines this step added (a new file\n// is all added), so a worker that edits a file which already holds a\n// credential-shaped fixture is not held for lines it did not write.\n//\n// prLines counts the changed lines of the whole PR: the diff against the\n// merge base of mainSHA and base, with the loop's and close-out's paths left\n// out.\nfunc (l *Loop) facts(ctx context.Context, issue int, wt, base, mainSHA, stage string) (changes []Change, prLines int, err error) {\n\tg := l.d.Git\n\tsnap, err := g.Snapshot(ctx, l.d.RepoDir, wt, base, gitx.SnapshotOptions{MaxFileBytes: MaxFileSize, MaxCandidates: MaxFiles})\n\tif err != nil {\n\t\treturn nil, 0, fmt.Errorf(\"snapshot: %w\", err)\n\t}\n\tdefer snap.Close()\n\tchs, err := snap.Changed(ctx)\n\tif err != nil {\n\t\treturn nil, 0, fmt.Errorf(\"list changes: %w\", err)\n\t}\n\tadded, err := snap.AddedLines(ctx)\n\tif err != nil {\n\t\treturn nil, 0, fmt.Errorf(\"list added lines: %w\", err)\n\t}\n\tprBase := base\n\tif mainSHA != \"\" && mainSHA != base {\n\t\tif mb, err := g.MergeBase(ctx, l.d.RepoDir, mainSHA, base); err == nil && mb != \"\" {\n\t\t\tprBase = mb\n\t\t}\n\t}\n\tprStat, err := snap.Numstat(ctx, prBase)\n\tif err != nil {\n\t\treturn nil, 0, fmt.Errorf(\"numstat of the PR: %w\", err)\n\t}\n\tstat := map[string]gitx.NumStat{}\n\tfor _, ns := range prStat {\n\t\tstat[ns.Path] = ns\n\t\tif !excluded(issue, ns.Path) && !strings.HasPrefix(ns.Path, \".ard/\") {\n\t\t\tprLines += ns.Added + ns.Deleted\n\t\t}\n\t}\n\troot, err := os.OpenRoot(wt)\n\tif err != nil {\n\t\treturn nil, 0, fmt.Errorf(\"open worktree: %w\", err)\n\t}\n\tdefer root.Close()\n\tsecrets := l.d.Secrets()\n\tfor _, ch := range chs {\n\t\tif excluded(issue, ch.Path) {\n\t\t\tcontinue\n\t\t}\n\t\tc := Change{Path: ch.Path, Deleted: ch.Deleted}\n\t\tif !ch.Deleted {\n\t\t\tl.fileFacts(ctx, root, &c, secrets, added[ch.Path], stage, len(changes))\n\t\t\tswitch ch.Mode {\n\t\t\tcase \"160000\":\n\t\t\t\tc.Kind = NestedRepo\n\t\t\tcase \"120000\":\n\t\t\t\tc.Kind = Symlink\n\t\t\t}\n\t\t\tif ns, ok := stat[ch.Path]; ok && ns.Binary {\n\t\t\t\tc.Binary = true\n\t\t\t}\n\t\t}\n\t\tchanges = append(changes, c)\n\t}\n\treturn changes, prLines, nil\n}\n\n// fileFacts fills the on-disk facts of one changed file. Only the added line ranges are pattern-scanned.\nfunc (l *Loop) fileFacts(ctx context.Context, root *os.Root, c *Change, secrets *redact.Secrets, added []gitx.LineRange, stage string, seq int) {\n\tfi, err := root.Lstat(c.Path)\n\tswitch {\n\tcase err != nil:\n\t\tc.Kind = Other\n\t\treturn\n\tcase fi.Mode()&fs.ModeSymlink != 0:\n\t\tc.Kind = Symlink\n\t\treturn\n\tcase !fi.Mode().IsRegular():\n\t\tc.Kind = Other\n\t\treturn\n\t}\n\tc.Kind, c.Size = Regular, fi.Size()\n\tif fi.Mode()&0o111 != 0 {\n\t\tc.Kind = Exec\n\t}\n\tif c.Size > MaxFileSize {\n\t\treturn\n\t}\n\tf, err := root.Open(c.Path)\n\tif err != nil {\n\t\tc.ScanFailed = true\n\t\treturn\n\t}\n\tdefer f.Close()\n\tdata, err := io.ReadAll(io.LimitReader(f, MaxFileSize+1))\n\tif err != nil || len(data) > MaxFileSize {\n\t\tc.ScanFailed = true\n\t\treturn\n\t}\n\tif bytes.IndexByte(data[:min(len(data), binarySniff)], 0) >= 0 {\n\t\tc.Binary = true\n\t\treturn\n\t}\n\t// Keep exactly the scanned bytes where the agent cannot reach them.\n\tcp := filepath.Join(stage, fmt.Sprintf(\"f%04d\", seq))\n\tif err := os.WriteFile(cp, data, 0o600); err != nil {\n\t\tc.ScanFailed = true\n\t\treturn\n\t}\n\tc.Copy = cp\n\tc.Known = secrets.Names(data)\n\tfound, err := l.d.Scanner.Scan(ctx, bytes.NewReader(data))\n\tif err != nil {\n\t\tc.ScanFailed = true\n\t}\n\tfor _, f := range found {\n\t\tif inRanges(f.Line, added) {\n\t\t\tc.Patterns = append(c.Patterns, f)\n\t\t}\n\t}\n}\n\nfunc inRanges(line int, rs []gitx.LineRange) bool {\n\tfor _, r := range rs {\n\t\tif line >= r.From && line <= r.To {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\nfunc (jb *job) exec(ctx context.Context) {\n\td := jb.l.d\n\tif _, err := d.Store.StartAttempt(ctx, jb.sj.ID); err != nil {\n\t\tjb.log.Error(\"worker.start_failed\", \"step\", \"start_attempt\", \"error\", err)\n\t\tjb.finish(ctx, step{}, nil, jb.cause(closeout.CauseNoProcess, \"could not start the job\", false))\n\t\treturn\n\t}\n\ttimeout := jb.role.Timeout\n\tif timeout <= 0 {\n\t\ttimeout = defaultTimeout\n\t}\n\tjb.deadline = d.Now().Add(timeout)\n\tif jb.reopenPR(ctx) {\n\t\treturn\n\t}\n\tref := jb.cfg.SHA\n\tif jb.exists {\n\t\tref = localRef(jb.branch)\n\t}\n\tcur, ok := jb.agentStep(ctx, jb.sj.ID, ref, nil)\n\tif !ok {\n\t\treturn\n\t}\n\t// An existing branch with no new code goes straight to the tests.\n\thead, _, done := jb.round(ctx, cur)\n\tif done {\n\t\treturn\n\t}\n\tres := closeout.WorkerResult{Tests: closeout.TestsNone}\n\tif jb.role.Tests != \"\" {\n\t\tvar done bool\n\t\tif res, done = jb.testLoop(ctx, head); done {\n\t\t\treturn\n\t\t}\n\t}\n\tif !jb.openPR(ctx, &res) {\n\t\treturn\n\t}\n\tjb.finish(ctx, jb.final, &res, closeout.Cause{})\n}\n\n// agentStep runs an agent (or fix) step on ref. ok is false when the job has\n// been finished or stopped.\nfunc (jb *job) agentStep(ctx context.Context, id, ref string, extra []executor.File) (step, bool) {\n\tn := jb.is.Number\n\tej := jb.execJob(id, ref, jb.stepTimeout())\n\tif !jb.role.Network {\n\t\tej.Network = executor.NetworkAdvisory\n\t}\n\tej.Inputs = append(append([]executor.File(nil), jb.inputs...), extra...)\n\tej.Scrub = []string{agent.RoleFilePath(n, stageWorker, jb.role.Name)}\n\tuntrusted := append([]string(nil), jb.untrusted...)\n\tfor _, f := range extra {\n\t\tuntrusted = append(untrusted, f.Path)\n\t}\n\t// B: max_budget_usd caps the whole job. Each step gets what is left.\n\tif budget := jb.budgetCap(); budget > 0 {\n\t\tleft := bud