nflict means upstream changed one of the request's paths since the\n \t// base the request was applied to. It is never retried or overwritten.\n \tErrConflict = errors.New(\"committer: upstream changed a requested path\")\ndiff --git a/internal/committer/merge.go b/internal/committer/merge.go\nnew file mode 100644\nindex 0000000..eb0a8c9\n--- /dev/null\n+++ b/internal/committer/merge.go\n@@ -0,0 +1,96 @@\n+package committer\n+\n+import (\n+\t\"context\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"os\"\n+\n+\t\"github.com/albertcbrown/ard/internal/effects\"\n+)\n+\n+// mergeRef is the private ref the lane fetches main into for a merge. It is\n+// not upstreamRef(\"main\"): nothing else writes it.\n+const mergeRef = \"refs/ard/merge/main\"\n+\n+// runMerge commits s as a two-parent merge of the branch tip and the tip of\n+// main. It does not run `git merge`: the tree is main's tree (s.mergeParent)\n+// with the snapshot's files written over it, so outside the declared paths the\n+// result is main byte for byte. The guard then holds the whole difference\n+// from main to the declared paths, each of which passed CheckCodePath.\n+//\n+// There is no retry. The branch must still be at s.base, main at\n+// s.mergeParent, and the push leases the branch tip; any movement is\n+// ErrConflict (or ErrMergeParent for main) and the caller starts a new round.\n+func (l *lane) runMerge(ctx context.Context, s snap) (Result, error) {\n+\tif err := os.MkdirAll(l.cfg.WorkDir, 0o755); err != nil {\n+\t\treturn Result{}, fmt.Errorf(\"mkdir workdir: %w\", err)\n+\t}\n+\ttip, err := l.fetch(ctx)\n+\tif err != nil {\n+\t\treturn Result{}, err\n+\t}\n+\tif tip != s.base {\n+\t\treturn Result{Attempts: 1}, fmt.Errorf(\"%w: the branch moved from %.12s to %.12s\", ErrConflict, s.base, tip)\n+\t}\n+\tmain := l.cfg.Branch\n+\tif main == \"\" {\n+\t\tmain = \"main\"\n+\t}\n+\tspec := \"+refs/heads/\" + main + \":\" + mergeRef\n+\tif err := l.g.FetchRef(ctx, l.cfg.RepoDir, l.cfg.RemoteURL, spec, l.cfg.Token); err != nil {\n+\t\treturn Result{Attempts: 1}, err\n+\t}\n+\tmainTip, err := l.g.RevParse(ctx, l.cfg.RepoDir, mergeRef)\n+\tif err != nil {\n+\t\treturn Result{Attempts: 1}, err\n+\t}\n+\tif mainTip != s.mergeParent {\n+\t\treturn Result{Attempts: 1}, fmt.Errorf(\"%w: %.12s is not the tip of %s (%.12s)\", ErrMergeParent, s.mergeParent, main, mainTip)\n+\t}\n+\tif err := l.g.WorktreeRemove(ctx, l.cfg.RepoDir, l.wt); err != nil {\n+\t\treturn Result{}, err\n+\t}\n+\tif err := l.g.WorktreeAdd(ctx, l.cfg.RepoDir, l.wt, mainTip); err != nil {\n+\t\treturn Result{}, err\n+\t}\n+\tdefer func() { _ = l.g.WorktreeRemove(context.WithoutCancel(ctx), l.cfg.RepoDir, l.wt) }()\n+\n+\tres := Result{Attempts: 1}\n+\tif err := l.apply(ctx, s); err != nil {\n+\t\treturn res, err\n+\t}\n+\t// HEAD is main's tip, so the staged diff is the diff against main.\n+\tchanges, err := l.g.StagedChanges(ctx, l.wt)\n+\tif err != nil {\n+\t\treturn res, err\n+\t}\n+\tif err := CheckStaged(s.declared, changes); err != nil {\n+\t\treturn res, err\n+\t}\n+\tif err := checkModes(s, changes); err != nil {\n+\t\treturn res, err\n+\t}\n+\tge := &GuardError{}\n+\tfor _, c := range changes { // belt and braces: every difference from main passes the code path guard\n+\t\tif err := CheckCodePath(s.issue, c.Path); err != nil {\n+\t\t\tge.add(c.Path, err.Error())\n+\t\t}\n+\t}\n+\tif len(ge.Paths) > 0 {\n+\t\treturn res, ge\n+\t}\n+\tcr, err := l.fx.Commit(ctx, effects.CommitOp{Dir: l.wt, Message: s.msg, Author: l.author, Parents: []string{tip, mainTip}})\n+\tif err != nil {\n+\t\treturn res, err\n+\t}\n+\terr = l.fx.Push(ctx, effects.PushOp{Dir: l.wt, Remote: l.cfg.RemoteURL, Ref: \"HEAD:refs/heads/\" + l.branch,\n+\t\tForceWithLease: tip, Token: l.cfg.Token})\n+\tswitch {\n+\tcase errors.Is(err, effects.ErrNonFastForward), errors.Is(err, effects.ErrStaleLease):\n+\t\treturn res, fmt.Errorf(\"%w: the branch moved during the merge: %v\", ErrConflict, err)\n+\tcase err != nil:\n+\t\treturn res, err\n+\t}\n+\treturn Result{SHA: cr.SHA, Synthetic: cr.Synthetic, Attempts: 1}, nil\n+}\ndiff --git a/internal/committer/merge_test.go b/internal/committer/merge_test.go\nnew file mode 100644\nindex 0000000..ed80198\n--- /dev/null\n+++ b/internal/committer/merge_test.go\n@@ -0,0 +1,174 @@\n+package committer\n+\n+import (\n+\t\"context\"\n+\t\"errors\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+\n+\t\"github.com/albertcbrown/ard/internal/gitx/gittest\"\n+)\n+\n+// mergeEnv has a PR branch with new.go cut from the seed, and main moved on\n+// by one commit (b.txt and a file under .ard/).\n+type mergeEnv struct {\n+\t*codeEnv\n+\tbranchTip string\n+\tmainTip   string\n+}\n+\n+func newMergeEnv(t *testing.T) *mergeEnv {\n+\tt.Helper()\n+\tc := newCodeEnv(t, nil)\n+\tr := c.req(CodeFile{Path: \"new.go\", Src: c.srcFile(t, \"new.go\", \"package x\\n\")})\n+\tr.Create = true\n+\tif _, err := c.b.CommitCode(context.Background(), brName, r); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tfor name, body := range map[string]string{\"b.txt\": \"b\\n\", \".ard/5/plan.md\": \"plan\\n\"} {\n+\t\tp := filepath.Join(c.clone, filepath.FromSlash(name))\n+\t\tif err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tif err := os.WriteFile(p, []byte(body), 0o644); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\tgittest.Run(t, c.clone, \"add\", \"-A\")\n+\tgittest.Run(t, c.clone, \"commit\", \"-q\", \"-m\", \"main moves\")\n+\tgittest.Run(t, c.clone, \"push\", \"-q\", \"origin\", \"main\")\n+\treturn &mergeEnv{codeEnv: c, branchTip: c.head(t, brName), mainTip: c.head(t, \"main\")}\n+}\n+\n+func (m *mergeEnv) req(files ...CodeFile) CodeRequest {\n+\tr := m.codeEnv.req(files...)\n+\tr.Base, r.MergeParent = m.branchTip, m.mainTip\n+\treturn r\n+}\n+\n+func (m *mergeEnv) own(t *testing.T) CodeFile {\n+\treturn CodeFile{Path: \"new.go\", Src: m.srcFile(t, \"new.go\", \"package x\\n\")}\n+}\n+\n+func TestCommitCodeMergeParent(t *testing.T) {\n+\tm := newMergeEnv(t)\n+\tres, err := m.b.CommitCode(context.Background(), brName, m.req(m.own(t)))\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif head := m.head(t, brName); res.SHA != head {\n+\t\tt.Fatalf(\"res %s head %s\", res.SHA, head)\n+\t}\n+\tps := strings.Fields(gittest.Run(t, m.bare, \"rev-list\", \"--parents\", \"-n1\", brName))\n+\tif len(ps) != 3 || ps[1] != m.branchTip || ps[2] != m.mainTip {\n+\t\tt.Fatalf(\"parents %v, want [%s %s]\", ps[1:], m.branchTip, m.mainTip)\n+\t}\n+\tif want := gittest.Run(t, m.bare, \"ls-tree\", \"-r\", m.mainTip); !strings.Contains(m.tree(t, brName), strings.Split(want, \"\\n\")[0]) {\n+\t\tt.Errorf(\"tree lacks main's files\")\n+\t}\n+\ttree := m.tree(t, brName)\n+\tfor _, f := range []string{\"\\tnew.go\", \"\\tb.txt\", \"\\t.ard/5/plan.md\"} {\n+\t\tif !strings.Contains(tree, f) {\n+\t\t\tt.Errorf(\"tree lacks %s:\\n%s\", f, tree)\n+\t\t}\n+\t}\n+}\n+\n+func TestCommitCodeMergeParentNotMainTip(t *testing.T) {\n+\tm := newMergeEnv(t)\n+\tr := m.req(m.own(t))\n+\tr.MergeParent = m.base // an older main commit\n+\tif _, err := m.b.CommitCode(context.Background(), brName, r); !errors.Is(err, ErrMergeParent) {\n+\t\tt.Fatalf(\"err = %v, want ErrMergeParent\", err)\n+\t}\n+\tif m.head(t, brName) != m.branchTip {\n+\t\tt.Fatal(\"branch moved\")\n+\t}\n+}\n+\n+func TestCommitCodeMergeParentInvalid(t *testing.T) {\n+\tm := newMergeEnv(t)\n+\tr := m.req(m.own(t))\n+\tr.MergeParent = \"main\"\n+\tif _, err := m.b.CommitCode(context.Background(), brName, r); !errors.Is(err, ErrInvalid) {\n+\t\tt.Fatalf(\"non-hex: %v\", err)\n+\t}\n+\tr = m.req(m.own(t))\n+\tr.Create = true\n+\tif _, err := m.b.CommitCode(context.Background(), brName, r); !errors.Is(err, ErrInvalid) {\n+\t\tt.Fatalf(\"with Create: %v\", err)\n+\t}\n+}\n+\n+// A path that differs from main and is not declared cannot appear: the result\n+// is main plus the declared files, and a declared path that main has changed\n+// is simply overwritten by the declared content. An undeclared difference is\n+// refused by the staged check, so the worker cannot revert main's change by\n+// omission or smuggle a path in.\n+func TestCommitCodeMergeProtectedRefused(t *testing.T) {\n+\tm := newMergeEnv(t)\n+\tfor _, p := range []string{\".github/workflows/x.yml\", \".ard/5/plan.md\", \".gitattributes\"} {\n+\t\tr := m.req(m.own(t), CodeFile{Path: p, Src: m.srcFile(t, \"evil\", \"x\\n\")})\n+\t\tif _, err := m.b.CommitCode(context.Background(), brName, r); err == nil {\n+\t\t\tt.Fatalf(\"%s: accepted\", p)\n+\t\t}\n+\t\tif m.head(t, brName) != m.branchTip {\n+\t\t\tt.Fatalf(\"%s: branch moved\", p)\n+\t\t}\n+\t}\n+\t// Deleting a protected path main has is refused too.\n+\tr := m.req(m.own(t), CodeFile{Path: \".ard/5/plan.md\", Delete: true})\n+\tif _, err := m.b.CommitCode(context.Background(), brName, r); err == nil {\n+\t\tt.Fatal(\"protected delete accepted\")\n+\t}\n+}\n+\n+func TestCommitCodeMergeBranchMovedNoRetry(t *testing.T) {\n+\tm := newMergeEnv(t)\n+\tr := m.req(m.own(t))\n+\tr.Base = m.base // the worker's view of the branch is stale\n+\tif _, err := m.b.CommitCode(context.Background(), brName, r); !errors.Is(err, ErrConflict) {\n+\t\tt.Fatalf(\"err = %v, want ErrConflict\", err)\n+\t}\n+\tif m.head(t, brName) != m.branchTip {\n+\t\tt.Fatal(\"branch moved\")\n+\t}\n+}\n+\n+func TestCommitCodeMergeSameTreeAsMain(t *testing.T) {\n+\tm := newMergeEnv(t)\n+\t// Declare new.go as deleted: the tree equals main's, still a commit.\n+\tres, err := m.b.CommitCode(context.Background(), brName, m.req(CodeFile{Path: \"new.go\", Delete: true}))\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif res.SHA != m.head(t, brName) || res.SHA == m.branchTip {\n+\t\tt.Fatalf(\"merge not pushed: %+v\", res)\n+\t}\n+}\n+\n+func TestCommitCodeMergeOverMaxFiles(t *testing.T) {\n+\tm := newMergeEnv(t)\n+\tvar fs []CodeFile\n+\tfor i := 0; i <= MaxFiles; i++ {\n+\t\tfs = append(fs, CodeFile{Path: \"f\" + strings.Repeat(\"x\", i%7) + string(rune('a'+i/26)) + string(rune('a'+i%26)) + \".txt\", Delete: true})\n+\t}\n+\tif _, err := m.b.CommitCode(context.Background(), brName, m.req(fs...)); !errors.Is(err, ErrInvalid) {\n+\t\tt.Fatalf(\"err = %v, want ErrInvalid\", err)\n+\t}\n+}\n+\n+func TestCommitCodeMergeMainMovedAfterFetch(t *testing.T) {\n+\tm := newMergeEnv(t)\n+\tif err := os.WriteFile(filepath.Join(m.clone, \"c.txt\"), []byte(\"c\\n\"), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tgittest.Run(t, m.clone, \"add\", \"-A\")\n+\tgittest.Run(t, m.clone, \"commit\", \"-q\", \"-m\", \"main moves again\")\n+\tgittest.Run(t, m.clone, \"push\", \"-q\", \"origin\", \"main\")\n+\tif _, err := m.b.CommitCode(context.Background(), brName, m.req(m.own(t))); !errors.Is(err, ErrMergeParent) {\n+\t\tt.Fatalf(\"err = %v, want ErrMergeParent\", err)\n+\t}\n+}\ndiff --git a/internal/gitx/merge.go b/internal/gitx/merge.go\nnew file mode 100644\nindex 0000000..1f84f1f\n--- /dev/null\n+++ b/internal/gitx/merge.go\n@@ -0,0 +1,69 @@\n+package gitx\n+\n+import (\n+\t\"context\"\n+\t\"fmt\"\n+\t\"strings\"\n+)\n+\n+// emptyTreeID returns the id of the empty tree, computed rather than\n+// hard-coded so it follows the repository's hash algorithm.\n+func (g *Git) emptyTreeID(ctx context.Context, dir string) (string, error) {\n+\tout, _, err := g.run(ctx, dir, nil, \"\", nil, \"hash-object\", \"-t\", \"tree\", \"--stdin\")\n+\tif err != nil {\n+\t\treturn \"\", fmt.Errorf(\"gitx: empty tree: %w\", err)\n+\t}\n+\treturn strings.TrimSpace(out), nil\n+}\n+\n+// hardenedMerge are the options every merge runs with: nothing in the\n+// repository's own configuration or attributes can change its result.\n+var hardenedMerge = []string{\n+\t\"-c\", \"rerere.enabled=false\", \"-c\", \"merge.renormalize=false\",\n+\t\"-c\", \"submodule.recurse=false\", \"-c\", \"core.autocrlf=false\",\n+\t\"-c\", \"commit.gpgsign=false\", \"-c\", \"core.hooksPath=/dev/null\",\n+}\n+\n+// MergeNoCommit merges ref into the worktree at dir without committing and\n+// returns the conflicted paths. A clean merge returns none. A failure that\n+// leaves no unmerged path is an error. The merge ignores every attribute file\n+// (GIT_ATTR_SOURCE is the empty tree), takes no -X options and runs no hooks.\n+func (g *Git) MergeNoCommit(ctx context.Context, dir, ref string) ([]string, error) {\n+\tempty, err := g.emptyTreeID(ctx, dir)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\targs := append(append([]string{}, hardenedMerge...),\n+\t\t\"merge\", \"--no-commit\", \"--no-ff\", \"--no-verify\", \"--no-edit\", \"-s\", \"ort\", ref)\n+\t_, _, mergeErr := g.run(ctx, dir, []string{\"GIT_ATTR_SOURCE=\" + empty,\n+\t\t\"GIT_AUTHOR_NAME=ard\", \"GIT_AUTHOR_EMAIL=ard@localhost\",\n+\t\t\"GIT_COMMITTER_NAME=ard\", \"GIT_COMMITTER_EMAIL=ard@localhost\"}, \"\", nil, args...)\n+\tif mergeErr == nil {\n+\t\treturn nil, nil\n+\t}\n+\tif !isExit(mergeErr, 1) {\n+\t\treturn nil, fmt.Errorf(\"gitx: merge %s: %w\", ref, mergeErr)\n+\t}\n+\tout, _, err := g.run(ctx, dir, nil, \"\", nil, \"diff\", \"--name-only\", \"-z\", \"--diff-filter=U\")\n+\tif err != nil {\n+\t\treturn nil, fmt.Errorf(\"gitx: list conflicts: %w\", err)\n+\t}\n+\tvar ps []string\n+\tfor _, p := range strings.Split(out, \"\\x00\") {\n+\t\tif p != \"\" {\n+\t\t\tps = append(ps, p)\n+\t\t}\n+\t}\n+\tif len(ps) == 0 {\n+\t\treturn nil, fmt.Errorf(\"gitx: merge %s: %w\", ref, mergeErr)\n+\t}\n+\treturn ps, nil\n+}\n+\n+// MergeAbort abandons a merge started by MergeNoCommit.\n+func (g *Git) MergeAbort(ctx context.Context, dir string) error {\n+\tif _, _, err := g.run(ctx, dir, nil, \"\", nil, \"merge\", \"--abort\"); err != nil {\n+\t\treturn fmt.Errorf(\"gitx: merge abort: %w\", err)\n+\t}\n+\treturn nil\n+}\ndiff --git a/internal/gitx/merge_test.go b/internal/gitx/merge_test.go\nnew file mode 100644\nindex 0000000..924ed1d\n--- /dev/null\n+++ b/internal/gitx/merge_test.go\n@@ -0,0 +1,101 @@\n+package gitx_test\n+\n+import (\n+\t\"context\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+\n+\t\"github.com/albertcbrown/ard/internal/gitx\"\n+\t\"github.com/albertcbrown/ard/internal/gitx/gittest\"\n+)\n+\n+func commitFile(t *testing.T, dir, name, content, msg string) {\n+\tt.Helper()\n+\tif err := os.WriteFile(filepath.Join(dir, name), []byte(content), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tgittest.Run(t, dir, \"add\", name)\n+\tgittest.Run(t, dir, \"commit\", \"-m\", msg)\n+}\n+\n+// mergeFixture returns a clone on branch \"side\" and the tip of \"other\", which\n+// edits the same file.\n+func mergeFixture(t *testing.T, sideContent, otherContent string) (clone, other string) {\n+\tt.Helper()\n+\t_, clone = gittest.NewRemote(t)\n+\tcommitFile(t, clone, \"a.txt\", \"one\\n\", \"base\")\n+\tgittest.Run(t, clone, \"checkout\", \"-q\", \"-b\", \"other\")\n+\tcommitFile(t, clone, \"a.txt\", otherContent, \"other\")\n+\tother = strings.TrimSpace(gittest.Run(t, clone, \"rev-parse\", \"HEAD\"))\n+\tgittest.Run(t, clone, \"checkout\", \"-q\", \"-b\", \"side\", \"main\")\n+\tgittest.Run(t, clone, \"reset\", \"-q\", \"--hard\", \"other~1\")\n+\tcommitFile(t, clone, \"a.txt\", sideContent, \"side\")\n+\treturn clone, other\n+}\n+\n+func TestMergeNoCommitConflict(t *testing.T) {\n+\tclone, other := mergeFixture(t, \"side\\n\", \"other\\n\")\n+\tgot, err := gitx.New(\"\").MergeNoCommit(context.Background(), clone, other)\n+\tif err != nil || len(got) != 1 || got[0] != \"a.txt\" {\n+\t\tt.Fatalf(\"MergeNoCommit = %v, %v; want [a.txt]\", got, err)\n+\t}\n+\tif err := gitx.New(\"\").MergeAbort(context.Background(), clone); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+}\n+\n+func TestMergeNoCommitClean(t *testing.T) {\n+\t_, clone := gittest.NewRemote(t)\n+\tcommitFile(t, clone, \"a.txt\", \"one\\n\", \"base\")\n+\tgittest.Run(t, clone, \"checkout\", \"-q\", \"-b\", \"other\")\n+\tcommitFile(t, clone, \"b.txt\", \"b\\n\", \"other\")\n+\tother := strings.TrimSpace(gittest.Run(t, clone, \"rev-parse\", \"HEAD\"))\n+\tgittest.Run(t, clone, \"checkout\", \"-q\", \"main\")\n+\tgot, err := gitx.New(\"\").MergeNoCommit(context.Background(), clone, other)\n+\tif err != nil || len(got) != 0 {\n+\t\tt.Fatalf(\"MergeNoCommit = %v, %v; want clean\", got, err)\n+\t}\n+}\n+\n+func TestMergeNoCommitOtherError(t *testing.T) {\n+\t_, clone := gittest.NewRemote(t)\n+\tif got, err := gitx.New(\"\").MergeNoCommit(context.Background(), clone, \"no-such-ref\"); err == nil {\n+\t\tt.Fatalf(\"MergeNoCommit(bad ref) = %v, nil; want error\", got)\n+\t}\n+}\n+\n+// A branch's .gitattributes must not change how the merge resolves.\n+func TestMergeIgnoresAttributes(t *testing.T) {\n+\tclone, other := mergeFixture(t, \"side\\n\", \"other\\n\")\n+\tcommitFile(t, clone, \".gitattributes\", \"a.txt merge=union\\n\", \"attrs\")\n+\tgot, err := gitx.New(\"\").MergeNoCommit(context.Background(), clone, other)\n+\tif err != nil || len(got) != 1 {\n+\t\tt.Fatalf(\"MergeNoCommit = %v, %v; want a conflict despite merge=union\", got, err)\n+\t}\n+}\n+\n+func TestCommitParents(t *testing.T) {\n+\t_, clone := gittest.NewRemote(t)\n+\tcommitFile(t, clone, \"a.txt\", \"one\\n\", \"base\")\n+\ttip := strings.TrimSpace(gittest.Run(t, clone, \"rev-parse\", \"HEAD\"))\n+\tgittest.Run(t, clone, \"checkout\", \"-q\", \"-b\", \"other\", \"HEAD~1\")\n+\tcommitFile(t, clone, \"b.txt\", \"b\\n\", \"other\")\n+\tother := strings.TrimSpace(gittest.Run(t, clone, \"rev-parse\", \"HEAD\"))\n+\tg := gitx.New(\"\")\n+\top := gitx.CommitOp{Dir: clone, Message: \"merge\\n\", Author: gitx.Identity{Name: \"n\", Email: \"n@example.com\"}, Parents: []string{tip, other}}\n+\t// The index equals HEAD's tree here only if we stage nothing new: a\n+\t// merge commit is still written.\n+\tsha, err := g.Commit(context.Background(), gitx.CommitOp{Dir: clone, Message: op.Message, Author: op.Author, Parents: op.Parents})\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tps, err := g.Parents(context.Background(), clone, sha)\n+\tif err != nil || len(ps) != 2 || ps[0] != tip || ps[1] != other {\n+\t\tt.Fatalf(\"parents = %v, %v; want [%s %s]\", ps, err, tip, other)\n+\t}\n+\tif head := strings.TrimSpace(gittest.Run(t, clone, \"rev-parse\", \"HEAD\")); head != sha {\n+\t\tt.Fatalf(\"HEAD = %s, want %s\", head, sha)\n+\t}\n+}\ndiff --git a/internal/gitx/write.go b/internal/gitx/write.go\nindex e0b7a74..7151ed0 100644\n--- a/internal/gitx/write.go\n+++ b/internal/gitx/write.go\n@@ -16,6 +16,10 @@ type CommitOp struct {\n \tDir     string   // worktree; callers stage first\n \tMessage string   // full message including trailers\n \tAuthor  Identity // used as author and committer; never global config\n+\t// Parents, when set, is the full parent list of the commit, first parent\n+\t// first; HEAD is not consulted and an index equal to HEAD is still\n+\t// committed (a merge whose tree equals a parent's is a real commit).\n+\tParents []string\n }\n \n // TokenFunc mints a push credential. It is called once per push.\n@@ -34,15 +38,20 @@ func (g *Git) Commit(ctx context.Context, op CommitOp) (string, error) {\n \tif op.Author.Name == \"\" || op.Author.Email == \"\" {\n \t\treturn \"\", fmt.Errorf(\"gitx: commit in %s: author name and email are required\", op.Dir)\n \t}\n-\tif _, _, err := g.run(ctx, op.Dir, nil, \"\", nil, \"diff\", \"--cached\", \"--quiet\"); err == nil {\n-\t\treturn \"\", ErrNothingToCommit\n-\t} else if !isExit(err, 1) {\n-\t\treturn \"\", fmt.Errorf(\"gitx: check index in %s: %w\", op.Dir, err)\n+\tif len(op.Parents) == 0 {\n+\t\tif _, _, err := g.run(ctx, op.Dir, nil, \"\", nil, \"diff\", \"--cached\", \"--quiet\"); err == nil {\n+\t\t\treturn \"\", ErrNothingToCommit\n+\t\t} else if !isExit(err, 1) {\n+\t\t\treturn \"\", fmt.Errorf(\"gitx: check index in %s: %w\", op.Dir, err)\n+\t\t}\n \t}\n \tenv := []string{\n \t\t\"GIT_AUTHOR_NAME=\" + op.Author.Name, \"GIT_AUTHOR_EMAIL=\" + op.Author.Email,\n \t\t\"GIT_COMMITTER_NAME=\" + op.Author.Name, \"GIT_COMMITTER_EMAIL=\" + op.Author.Email,\n \t}\n+\tif len(op.Parents) > 0 {\n+\t\tr