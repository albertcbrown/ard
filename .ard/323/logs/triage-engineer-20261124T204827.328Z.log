\t\treturn t.conflict(ctx, pr, issue, v.Roles)\ninternal/merger/merge.go:273:\t\t\"conflict\":       \"The branch conflicts with `main`. Resolve the conflict (or wait for review fix rounds, #41), then remove `ard:needs-human`.\",\ninternal/merger/merge.go:302:// conflict handles a PR that conflicts with main. With Deps.Rounds set and a\ninternal/merger/merge.go:303:// configured worker it asks for a conflict round (once per head, counted\ninternal/merger/merge.go:305:func (t *tick) conflict(ctx context.Context, pr github.PullRequest, issue int, roles []string) bool {\ninternal/merger/merge.go:308:\t\treturn t.needsHuman(ctx, pr, \"conflict\", \"\")\ninternal/merger/merge.go:312:\t\treturn t.needsHuman(ctx, pr, \"conflict\", \"\")\ninternal/merger/merge.go:316:\t\treturn t.needsHuman(ctx, pr, \"conflict\", \"\")\ninternal/merger/merge.go:320:\t\tt.fail(pr.Number, \"conflict_rounds\", err)\ninternal/merger/merge.go:327:\t\t\t\tt.log.Info(\"merge.conflict_round_pending\", \"pr\", pr.Number, \"issue\", issue, \"head\", pr.HeadSHA)\ninternal/merger/merge.go:335:\t\tt.log.Info(\"merge.would_request_conflict_round\", \"pr\", pr.Number, \"issue\", issue, \"head\", pr.HeadSHA)\ninternal/merger/merge.go:338:\tstarted, err := d.Rounds.RequestRound(ctx, reviewfix.Request{Issue: issue, PR: pr.Number, Head: pr.HeadSHA, Worker: worker, Reason: reviewfix.ReasonConflict, Roles: roles, Max: wr.MaxReviewRounds})\ninternal/merger/merge.go:340:\t\tt.fail(pr.Number, \"conflict_round\", err)\ninternal/merger/merge.go:344:\t\tt.log.Info(\"merge.conflict_round\", \"pr\", pr.Number, \"issue\", issue, \"head\", pr.HeadSHA)\ninternal/merger/merge.go:364:\tcase errors.Is(err, github.ErrConflict):\ninternal/merger/merge.go:365:\t\t// A moved head is a 409 too: only a computed conflict on an\ninternal/merger/merge.go:373:\t\t\tt.conflict(ctx, pr, issue, roles)\ninternal/merger/merge.go:396:\tcase errors.Is(err, github.ErrConflict):\ninternal/merger/loop.go:74:// Deps.Rounds keeps a conflict going