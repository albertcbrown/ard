odeMergeParentInvalid(t *testing.T) {\n515\t+\tm := newMergeEnv(t)\n516\t+\tr := m.req(m.own(t))\n517\t+\tr.MergeParent = \"main\"\n518\t+\tif _, err := m.b.CommitCode(context.Background(), brName, r); !errors.Is(err, ErrInvalid) {\n519\t+\t\tt.Fatalf(\"non-hex: %v\", err)\n520\t+\t}\n521\t+\tr = m.req(m.own(t))\n522\t+\tr.Create = true\n523\t+\tif _, err := m.b.CommitCode(context.Background(), brName, r); !errors.Is(err, ErrInvalid) {\n524\t+\t\tt.Fatalf(\"with Create: %v\", err)\n525\t+\t}\n526\t+}\n527\t+\n528\t+// A path that differs from main and is not declared cannot appear: the result\n529\t+// is main plus the declared files, and a declared path that main has changed\n530\t+// is simply overwritten by the declared content. An undeclared difference is\n531\t+// refused by the staged check, so the worker cannot revert main's change by\n532\t+// omission or smuggle a path in.\n533\t+func TestCommitCodeMergeProtectedRefused(t *testing.T) {\n534\t+\tm := newMergeEnv(t)\n535\t+\tfor _, p := range []string{\".github/workflows/x.yml\", \".ard/5/plan.md\", \".gitattributes\"} {\n536\t+\t\tr := m.req(m.own(t), CodeFile{Path: p, Src: m.srcFile(t, \"evil\", \"x\\n\")})\n537\t+\t\tif _, err := m.b.CommitCode(context.Background(), brName, r); err == nil {\n538\t+\t\t\tt.Fatalf(\"%s: accepted\", p)\n539\t+\t\t}\n540\t+\t\tif m.head(t, brName) != m.branchTip {\n541\t+\t\t\tt.Fatalf(\"%s: branch moved\", p)\n542\t+\t\t}\n543\t+\t}\n544\t+\t// Deleting a protected path main has is refused too.\n545\t+\tr := m.req(m.own(t), CodeFile{Path: \".ard/5/plan.md\", Delete: true})\n546\t+\tif _, err := m.b.CommitCode(context.Background(), brName, r); err == nil {\n547\t+\t\tt.Fatal(\"protected delete accepted\")\n548\t+\t}\n549\t+}\n550\t+\n551\t+func TestCommitCodeMergeBranchMovedNoRetry(t *testing.T) {\n552\t+\tm := newMergeEnv(t)\n553\t+\tr := m.req(m.own(t))\n554\t+\tr.Base = m.base // the worker's view of the branch is stale\n555\t+\tif _, err := m.b.CommitCode(context.Background(), brName, r); !errors.Is(err, ErrConflict) {\n556\t+\t\tt.Fatalf(\"err = %v, want ErrConflict\", err)\n557\t+\t}\n558\t+\tif m.head(t, brName) != m.branchTip {\n559\t+\t\tt.Fatal(\"branch moved\")\n560\t+\t}\n561\t+}\n562\t+\n563\t+func TestCommitCodeMergeSameTreeAsMain(t *testing.T) {\n564\t+\tm := newMergeEnv(t)\n565\t+\t// Declare new.go as deleted: the tree equals main's, still a commit.\n566\t+\tres, err := m.b.CommitCode(context.Background(), brName, m.req(CodeFile{Path: \"new.go\", Delete: true}))\n567\t+\tif err != nil {\n568\t+\t\tt.Fatal(err)\n569\t+\t}\n570\t+\tif res.SHA != m.head(t, brName) || res.SHA == m.branchTip {\n571\t+\t\tt.Fatalf(\"merge not pushed: %+v\", res)\n572\t+\t}\n573\t+}\n574\t+\n575\t+func TestCommitCodeMergeOverMaxFiles(t *testing.T) {\n576\t+\tm := newMergeEnv(t)\n577\t+\tvar fs []CodeFile\n578\t+\tfor i := 0; i <= MaxFiles; i++ {\n579\t+\t\tfs = append(fs, CodeFile{Path: \"f\" + strings.Repeat(\"x\", i%7) + string(rune('a'+i/26)) + string(rune('a'+i%26)) + \".txt\", Delete: true})\n580\t+\t}\n581\t+\tif _, err := m.b.CommitCode(context.Background(), brName, m.req(fs...)); !errors.Is(err, ErrInvalid) {\n582\t+\t\tt.Fatalf(\"err = %v, want ErrInvalid\", err)\n583\t+\t}\n584\t+}\n585\t+\n586\t+func TestCommitCodeMergeMainMovedAfterFetch(t *testing.T) {\n587\t+\tm := newMergeEnv(t)\n588\t+\tif err := os.WriteFile(filepath.Join(m.clone, \"c.txt\"), []byte(\"c\\n\"), 0o644); err != nil {\n589\t+\t\tt.Fatal(err)\n590\t+\t}\n591\t+\tgittest.Run(t, m.clone, \"add\", \"-A\")\n592\t+\tgittest.Run(t, m.clone, \"commit\", \"-q\", \"-m\", \"main moves again\")\n593\t+\tgittest.Run(t, m.clone, \"push\", \"-q\", \"origin\", \"main\")\n594\t+\tif _, err := m.b.CommitCode(context.Background(), brName, m.req(m.own(t))); !errors.Is(err, ErrMergeParent) {\n595\t+\t\tt.Fatalf(\"err = %v, want ErrMergeParent\", err)\n596\t+\t}\n597\t+}\n598\tdiff --git a/internal/gitx/merge.go b/internal/gitx/merge.go\n599\tnew file mode 100644\n600\tindex 0000000..1f84f1f\n601\t--- /dev/null\n602\t+++ b/internal/gitx/merge.go\n603\t@@ -0,0 +1,69 @@\n604\t+package gitx\n605\t+\n606\t+import (\n607\t+\t\"context\"\n608\t+\t\"fmt\"\n609\t+\t\"strings\"\n610\t+)\n611\t+\n612\t+// emptyTreeID returns the id of the empty tree, computed rather than\n613\t+// hard-coded so it follows the repository's hash algorithm.\n614\t+func (g *Git) emptyTreeID(ctx context.Context, dir string) (string, error) {\n615\t+\tout, _, err := g.run(ctx, dir, nil, \"\", nil, \"hash-object\", \"-t\", \"tree\", \"--stdin\")\n616\t+\tif err != nil {\n617\t+\t\treturn \"\", fmt.Errorf(\"gitx: empty tree: %w\", err)\n618\t+\t}\n619\t+\treturn strings.TrimSpace(out), nil\n620\t+}\n621\t+\n622\t+// hardenedMerge are the options every merge runs with: nothing in the\n623\t+// repository's own configuration or attributes can change its result.\n624\t+var hardenedMerge = []string{\n625\t+\t\"-c\", \"rerere.enabled=false\", \"-c\", \"merge.renormalize=false\",\n626\t+\t\"-c\", \"submodule.recurse=false\", \"-c\", \"core.autocrlf=false\",\n627\t+\t\"-c\", \"commit.gpgsign=false\", \"-c\", \"core.hooksPath=/dev/null\",\n628\t+}\n629\t+\n630\t+// MergeNoCommit merges ref into the worktree at dir without committing and\n631\t+// returns the conflicted paths. A clean merge returns none. A failure that\n632\t+// leaves no unmerged path is an error. The merge ignores every attribute file\n633\t+// (GIT_ATTR_SOURCE is the empty tree), takes no -X options and runs no hooks.\n634\t+func (g *Git) MergeNoCommit(ctx context.Context, dir, ref string) ([]string, error) {\n635\t+\tempty, err := g.emptyTreeID(ctx, dir)\n636\t+\tif err != nil {\n637\t+\t\treturn nil, err\n638\t+\t}\n639\t+\targs := append(append([]string{}, hardenedMerge...),\n640\t+\t\t\"merge\", \"--no-commit\", \"--no-ff\", \"--no-verify\", \"--no-edit\", \"-s\", \"ort\", ref)\n641\t+\t_, _, mergeErr := g.run(ctx, dir, []string{\"GIT_ATTR_SOURCE=\" + empty,\n642\t+\t\t\"GIT_AUTHOR_NAME=ard\", \"GIT_AUTHOR_EMAIL=ard@localhost\",\n643\t+\t\t\"GIT_COMMITTER_NAME=ard\", \"GIT_COMMITTER_EMAIL=ard@localhost\"}, \"\", nil, args...)\n644\t+\tif mergeErr == nil {\n645\t+\t\treturn nil, nil\n646\t+\t}\n647\t+\tif !isExit(mergeErr, 1) {\n648\t+\t\treturn nil, fmt.Errorf(\"gitx: merge %s: %w\", ref, mergeErr)\n649\t+\t}\n650\t+\tout, _, err := g.run(ctx, dir, nil, \"\", nil, \"diff\", \"--name-only\", \"-z\", \"--diff-filter=U\")\n651\t+\tif err != nil {\n652\t+\t\treturn nil, fmt.Errorf(\"gitx: list conflicts: %w\", err)\n653\t+\t}\n654\t+\tvar ps []string\n655\t+\tfor _, p := range strings.Split(out, \"\\x00\") {\n656\t+\t\tif p != \"\" {\n657\t+\t\t\tps = append(ps, p)\n658\t+\t\t}\n659\t+\t}\n660\t+\tif len(ps) == 0 {\n661\t+\t\treturn nil, fmt.Errorf(\"gitx: merge %s: %w\", ref, mergeErr)\n662\t+\t}\n663\t+\treturn ps, nil\n664\t+}\n665\t+\n666\t+// MergeAbort abandons a merge started by MergeNoCommit.\n667\t+func (g *Git) MergeAbort(ctx context.Context, dir string) error {\n668\t+\tif _, _, err := g.run(ctx, dir, nil, \"\", nil, \"merge\", \"--abort\"); err != nil {\n669\t+\t\treturn fmt.Errorf(\"gitx: merge abort: %w\", err)\n670\t+\t}\n671\t+\treturn nil\n672\t+}\n673\tdiff --git a/internal/gitx/merge_test.go b/internal/gitx/merge_test.go\n674\tnew file mode 100644\n675\tindex 0000000..924ed1d\n676\t--- /dev/null\n677\t+++ b/internal/gitx/merge_test.go\n678\t@@ -0,0 +1,101 @@\n679\t+package gitx_test\n680\t+\n681\t+import (\n682\t+\t\"context\"\n683\t+\t\"os\"\n684\t+\t\"path/filepath\"\n685\t+\t\"strings\"\n686\t+\t\"testing\"\n687\t+\n688\t+\t\"github.com/albertcbrown/ard/internal/gitx\"\n689\t+\t\"github.com/albertcbrown/ard/internal/gitx/gittest\"\n690\t+)\n691\t+\n692\t+func commitFile(t *testing.T, dir, name, content, msg string) {\n693\t+\tt.Helper()\n694\t+\tif err := os.WriteFile(filepath.Join(dir, name), []byte(content), 0o644); err != nil {\n695\t+\t\tt.Fatal(err)\n696\t+\t}\n697\t+\tgittest.Run(t, dir, \"add\", name)\n698\t+\tgittest.Run(t, dir, \"commit\", \"-m\", msg)\n699\t+}\n700\t+\n701\t+// mergeFixture returns a clone on branch \"side\" and the tip of \"other\", which\n702\t+// edits the same file.\n703\t+func mergeFixture(t *testing.T, sideContent, otherContent string) (clone, other string) {\n704\t+\tt.Helper()\n705\t+\t_, clone = gittest.NewRemote(t)\n706\t+\tcommitFile(t, clone, \"a.txt\", \"one\\n\", \"base\")\n707\t+\tgittest.Run(t, clone, \"checkout\", \"-q\", \"-b\", \"other\")\n708\t+\tcommitFile(t, clone, \"a.txt\", otherContent, \"other\")\n709\t+\tother = strings.TrimSpace(gittest.Run(t, clone, \"rev-parse\", \"HEAD\"))\n710\t+\tgittest.Run(t, clone, \"checkout\", \"-q\", \"-b\", \"side\", \"main\")\n711\t+\tgittest.Run(t, clone, \"reset\", \"-q\", \"--hard\", \"other~1\")\n712\t+\tcommitFile(t, clone, \"a.txt\", sideContent, \"side\")\n713\t+\treturn clone, other\n714\t+}\n715\t+\n716\t+func TestMergeNoCommitConflict(t *testing.T) {\n717\t+\tclone, other := mergeFixture(t, \"side\\n\", \"other\\n\")\n718\t+\tgot, err := gitx.New(\"\").MergeNoCommit(context.Background(), clone, other)\n719\t+\tif err != nil || len(got) != 1 || got[0] != \"a.txt\" {\n720\t+\t\tt.Fatalf(\"MergeNoCommit = %v, %v; want [a.txt]\", got, err)\n721\t+\t}\n722\t+\tif err := gitx.New(\"\").MergeAbort(context.Background(), clone); err != nil {\n723\t+\t\tt.Fatal(err)\n724\t+\t}\n725\t+}\n726\t+\n727\t+func TestMergeNoCommitClean(t *testing.T) {\n728\t+\t_, clone := gittest.NewRemote(t)\n729\t+\tcommitFile(t, clone, \"a.txt\", \"one\\n\", \"base\")\n730\t+\tgittest.Run(t, clone, \"checkout\", \"-q\", \"-b\", \"other\")\n731\t+\tcommitFile(t, clone, \"b.txt\", \"b\\n\", \"other\")\n732\t+\tother := strings.TrimSpace(gittest.Run(t, clone, \"rev-parse\", \"HEAD\"))\n733\t+\tgittest.Run(t, clone, \"checkout\", \"-q\", \"main\")\n734\t+\tgot, err := gitx.New(\"\").MergeNoCommit(context.Background(), clone, other)\n735\t+\tif err != nil || len(got) != 0 {\n736\t+\t\tt.Fatalf(\"MergeNoCommit = %v, %v; want clean\", got, err)\n737\t+\t}\n738\t+}\n