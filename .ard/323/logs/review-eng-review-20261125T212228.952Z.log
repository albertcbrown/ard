commit), records the\n+// conflicted paths and builds conflict.md. A clean merge leaves input nil.\n+// mainTip comes only from this fetch, never from a role file or conflict.md.\n+func (l *Loop) conflictInput(ctx context.Context, n int, branch string) (conflictRound, error) {\n+\td := l.d\n+\trs, err := reviewfix.Rounds(ctx, d.Store, n)\n+\tif err != nil {\n+\t\treturn conflictRound{}, fmt.Errorf(\"read review rounds: %w\", err)\n+\t}\n+\tif len(rs) == 0 || rs[len(rs)-1].Phase != reviewfix.PhaseRequested || rs[len(rs)-1].Reason != reviewfix.ReasonConflict {\n+\t\treturn conflictRound{}, nil\n+\t}\n+\tr := rs[len(rs)-1]\n+\tcr := conflictRound{applies: true}\n+\tif err := d.Git.FetchRef(ctx, d.RepoDir, d.RemoteURL, \"+refs/heads/main:\"+mainRef, d.Token); err != nil {\n+\t\treturn cr, fmt.Errorf(\"fetch main: %w\", err)\n+\t}\n+\tif cr.mainTip, err = d.Git.RevParse(ctx, d.RepoDir, mainRef); err != nil {\n+\t\treturn cr, err\n+\t}\n+\tscratch, err := os.MkdirTemp(\"\", \"ard-conflict-\")\n+\tif err != nil {\n+\t\treturn cr, err\n+\t}\n+\tdefer os.RemoveAll(scratch)\n+\twt := filepath.Join(scratch, \"wt\")\n+\tif err := d.Git.WorktreeAdd(ctx, d.RepoDir, wt, localRef(branch)); err != nil {\n+\t\treturn cr, fmt.Errorf(\"scratch worktree: %w\", err)\n+\t}\n+\tdefer func() { _ = d.Git.WorktreeRemove(context.WithoutCancel(ctx), d.RepoDir, wt) }()\n+\tpaths, err := d.Git.MergeNoCommit(ctx, wt, cr.mainTip)\n+\tif err != nil {\n+\t\treturn cr, fmt.Errorf(\"trial merge: %w\", err)\n+\t}\n+\tif len(paths) == 0 {\n+\t\treturn cr, nil // GitHub's view is stale or the conflict is gone: nothing to resolve\n+\t}\n+\tsort.Strings(paths)\n+\tcr.conflicted = map[string]bool{}\n+\tfor _, p := range paths {\n+\t\tcr.conflicted[p] = true\n+\t}\n+\tvar b strings.Builder\n+\tb.WriteString(agentjob.UntrustedHeader)\n+\tfmt.Fprintf(&b, \"Conflict round %d: the branch conflicts with main. The merge of main into the branch is already in your worktree, \"+\n+\t\t\"uncommitted, with conflict markers in the files below. Resolve each file, leave no markers and do not commit.\\n\\nConflicted paths (%d):\\n\", r.N, len(paths))\n+\tfor i, p := range paths {\n+\t\tif i == conflictPathCap {\n+\t\t\tfmt.Fprintf(&b, \"- … %d more\\n\", len(paths)-i)\n+\t\t\tbreak\n+\t\t}\n+\t\tfmt.Fprintf(&b, \"- %s\\n\", quoteName(p))\n+\t}\n+\tif mb, err := d.Git.MergeBase(ctx, d.RepoDir, cr.mainTip, localRef(branch)); err == nil && mb != \"\" {\n+\t\tours, e1 := d.Git.ChangedPaths(ctx, d.RepoDir, mb, localRef(branch))\n+\t\ttheirs, e2 := d.Git.ChangedPaths(ctx, d.RepoDir, mb, cr.mainTip)\n+\t\tif e1 == nil && e2 == nil {\n+\t\t\tfmt.Fprintf(&b, \"\\nSince the common ancestor the branch changed %d files and main changed %d files.\\n\", len(ours), len(theirs))\n+\t\t}\n+\t}\n+\tout := b.String()\n+\tif len(out) > feedbackCap {\n+\t\tout = strings.ToValidUTF8(out[:feedbackCap], \"\") + \"\\n[truncated]\\n\"\n+\t}\n+\tcr.input = &executor.File{Path: agentjob.InputDir(n) + \"/conflict.md\", Data: []byte(out)}\n+\treturn cr, nil\n+}\n+\n+// quoteName renders a path from git as one escaped, bounded token.\n+func quoteName(p string) string {\n+\tif len(p) > conflictNameCap {\n+\t\tp = strings.ToValidUTF8(p[:conflictNameCap], \"\") + \"…\"\n+\t}\n+\treturn strconv.Quote(p)\n+}\n+\n+// markersLeft reports the recorded conflicted paths that still hold a conflict\n+// marker line (at least seven <, = or > characters, or | for diff3). It reads\n+// them through os.Root, runs no git and never follows a symlink. Advisory: the\n+// committer's tree rule is the enforcement.\n+func markersLeft(root *os.Root, conflicted map[string]bool) []string {\n+\tvar hit []string\n+\tfor p := range conflicted {\n+\t\tfi, err := root.Lstat(p)\n+\t\tif err != nil || !fi.Mode().IsRegular() || fi.Size() > MaxFileSize {\n+\t\t\tcontinue\n+\t\t}\n+\t\tf, err := root.Open(p)\n+\t\tif err != nil {\n+\t\t\tcontinue\n+\t\t}\n+\t\tdata, err := io.ReadAll(io.LimitReader(f, MaxFileSize+1))\n+\t\tf.Close()\n+\t\tif err != nil {\n+\t\t\tcontinue\n+\t\t}\n+\t\tfor _, line := range strings.Split(string(data), \"\\n\") {\n+\t\t\tif hasMarker(line) {\n+\t\t\t\thit = append(hit, p)\n+\t\t\t\tbreak\n+\t\t\t}\n+\t\t}\n+\t}\n+\tsort.Strings(hit)\n+\treturn hit\n+}\n+\n+func hasMarker(line string) bool {\n+\tfor _, c := range []string{\"<\", \"=\", \">\", \"|\"} {\n+\t\tif strings.HasPrefix(line, strings.Repeat(c, 7)) {\n+\t\t\treturn true\n+\t\t}\n+\t}\n+\treturn false\n+}\n+\n+func quoteNames(ps []string) string {\n+\tif len(ps) > 5 {\n+\t\tps = append(ps[:5:5], \"…\")\n+\t}\n+\tq := make([]string, len(ps))\n+\tfor i, p := range ps {\n+\t\tq[i] = quoteName(p)\n+\t}\n+\treturn strings.Join(q, \", \")\n+}\n+\n+// markersLeft opens the agent's worktree as a root and scans the recorded\n+// conflicted paths.\n+func (jb *job) markersLeft(h executor.Handle) []string {\n+\troot, err := os.OpenRoot(h.Worktree)\n+\tif err != nil {\n+\t\treturn nil\n+\t}\n+\tdefer root.Close()\n+\treturn markersLeft(root, jb.conflicted)\n+}\ndiff --git a/internal/worker/conflict_round_test.go b/internal/worker/conflict_round_test.go\nnew file mode 100644\nindex 0000000..748d056\n--- /dev/null\n+++ b/internal/worker/conflict_round_test.go\n@@ -0,0 +1,192 @@\n+package worker\n+\n+import (\n+\t\"context\"\n+\t\"encoding/json\"\n+\t\"fmt\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+\n+\t\"github.com/albertcbrown/ard/internal/executor\"\n+\t\"github.com/albertcbrown/ard/internal/github\"\n+\t\"github.com/albertcbrown/ard/internal/gitx/gittest\"\n+\t\"github.com/albertcbrown/ard/internal/state\"\n+)\n+\n+// conflictSetup makes issue n's branch and main diverge: each path holds\n+// \"base\", the branch changes it to \"branch\" and main to \"main\" (or leaves it\n+// when mainSide is false, so the merge is clean). It returns the issue, the\n+// branch name and the tip of main on the remote.\n+func conflictSetup(t *testing.T, h *harness, paths []string, mainSide bool) (n int, branch, mainTip string) {\n+\tt.Helper()\n+\tn = h.issue(\"Say hello\")\n+\tbranch = BranchName(\"engineer\", n, \"Say hello\")\n+\twrite := func(content string) {\n+\t\tfor _, p := range paths {\n+\t\t\twriteFile(t, h.clone, p, content)\n+\t\t}\n+\t\tgittest.Run(t, h.clone, \"add\", \"-A\")\n+\t\tgittest.Run(t, h.clone, \"commit\", \"-q\", \"-m\", content)\n+\t}\n+\twrite(\"base\\n\")\n+\tgittest.Run(t, h.clone, \"push\", \"-q\", \"origin\", \"main\")\n+\tgittest.Run(t, h.clone, \"checkout\", \"-q\", \"-b\", \"tmp\")\n+\twrite(\"branch\\n\")\n+\tgittest.Run(t, h.clone, \"push\", \"-q\", \"origin\", \"HEAD:refs/heads/\"+branch)\n+\tgittest.Run(t, h.clone, \"update-ref\", localRef(branch), \"HEAD\")\n+\tgittest.Run(t, h.clone, \"checkout\", \"-q\", \"main\")\n+\tif mainSide {\n+\t\twrite(\"main\\n\")\n+\t} else {\n+\t\tgittest.Run(t, h.clone, \"commit\", \"-q\", \"--allow-empty\", \"-m\", \"unrelated\")\n+\t}\n+\tgittest.Run(t, h.clone, \"push\", \"-q\", \"origin\", \"main\")\n+\tmainTip = strings.TrimSpace(gittest.Run(t, h.clone, \"rev-parse\", \"HEAD\"))\n+\treturn n, branch, mainTip\n+}\n+\n+func requestConflictRound(t *testing.T, h *harness, n int) {\n+\tt.Helper()\n+\tpr := h.gh.SeedPR(github.PullRequest{State: github.StateOpen, Author: self, HeadRef: BranchName(\"engineer\", n, \"Say hello\"), HeadSHA: \"x\", BaseRef: \"main\"})\n+\tdata, _ := json.Marshal(map[string]any{\"round\": 1, \"phase\": \"requested\", \"reason\": \"conflict\", \"pr\": pr, \"head\": \"h\", \"worker\": \"engineer\", \"roles\": []string{\"eng-review\"}})\n+\tif err := h.store.AppendEvent(context.Background(), state.Event{Kind: state.EventReviewRound, Issue: n, Role: \"engineer\", Data: data}); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+}\n+\n+func TestConflictRoundInput(t *testing.T) {\n+\th := newHarness(t)\n+\tpaths := []string{\"a\\\"b\\nc.txt\"}\n+\tfor i := 0; i < conflictPathCap+5; i++ {\n+\t\tpaths = append(paths, fmt.Sprintf(\"f%03d.txt\", i))\n+\t}\n+\tn, branch, mainTip := conflictSetup(t, h, paths, true)\n+