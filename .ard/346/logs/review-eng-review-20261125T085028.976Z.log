\t\t}\n@@ -220,14 +220,14 @@ func TestResolveRepo(t *testing.T) {\n \t\t_, c := gittest.NewRemote(t)\n \t\tgittest.Run(t, c, \"remote\", \"set-url\", \"origin\", (&url.URL{Scheme: \"https\", User: url.UserPassword(\"x\", \"secret\"), Host: \"gitlab.com\", Path: \"/a/b.git\"}).String())\n \t\te, _ := env(c, false)\n-\t\t_, err := resolveRepo(ctx, e, c)\n+\t\t_, err := ResolveRepo(ctx, e, c)\n \t\tif err == nil || strings.Contains(err.Error(), \"secret\") {\n \t\t\tt.Errorf(\"err = %v, want an error without the token\", err)\n \t\t}\n \t})\n \tt.Run(\"no remote\", func(t *testing.T) {\n \t\te, _ := env(t.TempDir(), false)\n-\t\t_, err := resolveRepo(ctx, e, t.TempDir())\n+\t\t_, err := ResolveRepo(ctx, e, t.TempDir())\n \t\tif err == nil || !strings.Contains(err.Error(), \"--repo owner/repo is required\") {\n \t\t\tt.Errorf(\"err = %v\", err)\n \t\t}\ndiff --git a/internal/setupcmd/cmd.go b/internal/setupcmd/cmd.go\nnew file mode 100644\nindex 0000000..29876f1\n--- /dev/null\n+++ b/internal/setupcmd/cmd.go\n@@ -0,0 +1,102 @@\n+package setupcmd\n+\n+import (\n+\t\"context\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"os\"\n+\n+\t\"github.com/albertcbrown/ard/internal/cli\"\n+\t\"github.com/albertcbrown/ard/internal/config\"\n+\t\"github.com/albertcbrown/ard/internal/effects\"\n+\t\"github.com/albertcbrown/ard/internal/github\"\n+\t\"github.com/albertcbrown/ard/internal/gitx\"\n+\t\"github.com/albertcbrown/ard/internal/labels\"\n+\t\"github.com/albertcbrown/ard/internal/labels/labelsync\"\n+)\n+\n+// Command is the handler behind `ard setup`. The config is loaded and\n+// validated before any GitHub client exists.\n+func Command(ctx context.Context, e *cli.Env, o cli.SetupOpts) error {\n+\troot, err := config.RepoRoot(e.ConfigPath)\n+\tif err != nil {\n+\t\treturn fmt.Errorf(\"setup: %w\", err)\n+\t}\n+\tres, err := config.Load(root)\n+\tif err != nil {\n+\t\treturn fmt.Errorf(\"setup: %w\", err)\n+\t}\n+\twant, err := labels.Desired(labels.SpecFrom(res))\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\trepo, err := labelsync.ResolveRepo(ctx, e, root)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tauth, err := github.AuthFromEnv(os.Getenv, os.ReadFile)\n+\tif err != nil {\n+\t\treturn fmt.Errorf(\"setup: %w\", err)\n+\t}\n+\tdry := e.DryRun && !o.Check\n+\tfx, rd, err := effects.Open(ctx, effects.Options{\n+\t\tDryRun: dry,\n+\t\tGitHub: github.Config{Repo: repo, Auth: auth, Log: e.Log},\n+\t\tLog:    e.Log,\n+\t})\n+\tif err != nil {\n+\t\treturn fmt.Errorf(\"setup: %w\", err)\n+\t}\n+\td := Deps{\n+\t\tReader:  rd,\n+\t\tWriter:  fx,\n+\t\tDesired: want,\n+\t\t// Placeholder until the shared permission check (#302) lands: the\n+\t\t// repository must be readable with the configured credentials.\n+\t\tPermissions: func(ctx context.Context) Row {\n+\t\t\tif _, err := rd.ListLabels(ctx); err != nil {\n+\t\t\t\treturn Row{Status: StatusManual, Detail: \"check ARD_GITHUB_* credentials and that the App is installed on \" + repo.String()}\n+\t\t\t}\n+\t\t\treturn Row{Status: StatusOK, Detail: \"repository reachable\"}\n+\t\t},\n+\t\tLocalVsMain: func(ctx context.Context) (string, error) { return LocalVsMain(ctx, root) },\n+\t\tDryRun:      dry,\n+\t\tLog:         e.Log,\n+\t}\n+\treturn execute(ctx, e, d, o)\n+}\n+\n+// execute runs setup with the given dependencies and maps the report to\n+// the command's outcome: exit 2 on drift under --check, an error when\n+// manual steps are needed.\n+func execute(ctx context.Context, e *cli.Env, d Deps, o cli.SetupOpts) error {\n+\trep, err := Run(ctx, d, Opts{Check: o.Check}, e.Stdout)\n+\tPrint(e.Stdout, rep, d.DryRun)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tif o.Check && rep.HasDrift() {\n+\t\treturn &cli.ExitError{Code: 2, Err: errors.New(\"setup: drift\")}\n+\t}\n+\tif !rep.Green() {\n+\t\treturn errors.New(\"setup: manual steps needed\")\n+\t}\n+\treturn nil\n+}\n+\n+// LocalVsMain returns a warning when ./.ard/ in the worktree differs from\n+// origin/main, which is what ard serve reads. It never fails the run.\n+func LocalVsMain(ctx context.Context, root string) (string, error) {\n+\tg := gitx.New(\"\")\n+\tif _, err := g.RevParse(ctx, root, \"origin/main\"); err != nil {\n+\t\treturn \"origin/main not found; cannot compare ./.ard/ with what ard serve reads\", nil\n+\t}\n+\tch, err := g.ChangedSince(ctx, root, root, \"origin/main\", \".ard/\")\n+\tif err != nil {\n+\t\treturn \"\", err\n+\t}\n+\tif len(ch) > 0 {\n+\t\treturn \"./.ard/ differs from origin/main (ard serve reads origin/main)\", nil\n+\t}\n+\treturn \"\", nil\n+}\ndiff --git a/internal/setupcmd/cmd_test.go b/internal/setupcmd/cmd_test.go\nnew file mode 100644\nindex 0000000..afdbe09\n--- /dev/null\n+++ b/internal/setupcmd/cmd_test.go\n@@ -0,0 +1,89 @@\n+package setupcmd\n+\n+import (\n+\t\"bytes\"\n+\t\"context\"\n+\t\"errors\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+\n+\t\"github.com/albertcbrown/ard/internal/cli\"\n+\t\"github.com/albertcbrown/ard/internal/github/fake\"\n+\t\"github.com/albertcbrown/ard/internal/gitx/gittest\"\n+)\n+\n+func TestCommandBadConfigBeforeNetwork(t *testing.T) {\n+\troot := t.TempDir()\n+\tif err := os.MkdirAll(filepath.Join(root, \".ard\"), 0o755); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tcfg := filepath.Join(root, \".ard\", \"config.yaml\")\n+\tif err := os.WriteFile(cfg, []byte(\"executor: remote\\n\"), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\te := &cli.Env{Globals: cli.Globals{ConfigPath: cfg, Repo: \"o/r\"}, Log: quiet, Stdout: &bytes.Buffer{}, Stderr: &bytes.Buffer{}}\n+\tif err := Command(context.Background(), e, cli.SetupOpts{Check: true}); err == nil || !strings.HasPrefix(err.Error(), \"setup:\") {\n+\t\tt.Errorf(\"err = %v\", err)\n+\t}\n+}\n+\n+func TestCheckExitsTwoOnDrift(t *testing.T) {\n+\tf := fake.New()\n+\tvar out bytes.Buffer\n+\te := &cli.Env{Log: quiet, Stdout: &out, Stderr: &bytes.Buffer{}}\n+\terr := execute(context.Background(), e, deps(f), cli.SetupOpts{Check: true})\n+\tvar ee *cli.ExitError\n+\tif !errors.As(err, &ee) || ee.Code != 2 {\n+\t\tt.Fatalf(\"err = %v, want ExitError code 2\", err)\n+\t}\n+\tif got, _ := f.ListLabels(context.Background()); len(got) != 0 {\n+\t\tt.Errorf(\"check wrote labels: %v\", got)\n+\t}\n+\t// Applying fixes the drift; a second check is clean.\n+\tif err := execute(context.Background(), e, deps(f), cli.SetupOpts{}); err != nil {\n+\t\tt.Fatalf(\"apply: %v\", err)\n+\t}\n+\tif err := execute(context.Background(), e, deps(f), cli.SetupOpts{Check: true}); err != nil {\n+\t\tt.Errorf(\"check after apply: %v\", err)\n+\t}\n+}\n+\n+func TestExecuteManualStepsError(t *testing.T) {\n+\td := deps(fake.New())\n+\td.Permissions = func(context.Context) Row { return Row{Status: StatusManual, Detail: \"fix it\"} }\n+\te := &cli.Env{Log: quiet, Stdout: &bytes.Buffer{}, Stderr: &bytes.Buffer{}}\n+\terr := execute(context.Background(), e, d, cli.SetupOpts{})\n+\tif err == nil || !strings.Contains(err.Error(), \"manual steps needed\") {\n+\t\tt.Errorf(\"err = %v\", err)\n+\t}\n+}\n+\n+func TestLocalVsMain(t *testing.T) {\n+\tctx := context.Background()\n+\t_, clone := gittest.NewRemote(t)\n+\tt.Run(\"same\", func(t *testing.T) {\n+\t\tif w, err := LocalVsMain(ctx, clone); err != nil || w != \"\" {\n+\t\t\tt.Errorf(\"w=%q err=%v\", w, err)\n+\t\t}\n+\t})\n+\tt.Run(\"differing\", func(t *testing.T) {\n+\t\tif err := os.MkdirAll(filepath.Join(clone, \".ard\"), 0o755); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tif err := os.WriteFile(filepath.Join(clone, \".ard\", \"config.yaml\"), []byte(\"x: 1\\n\"), 0o644); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tif w, err := LocalVsMain(ctx, clone); err != nil || !strings.Contains(w, \"differs from origin/main\") {\n+\t\t\tt.Errorf(\"w=%q err=%v\", w, err)\n+\t\t}\n+\t})\n+\tt.Run(\"no origin/main\", func(t *testing.T) {\n+\t\tdir := t.TempDir()\n+\t\tgittest.Run(t, dir, \"init\", \"--initial-branch=main\")\n+\t\tif w, err := LocalVsMain(ctx, dir); err != nil || !strings.Contains(w, \"origin/main not found\") {\n+\t\t\tt.Errorf(\"w=%q err=%v\", w, err)\n+\t\t}\n+\t})\n+}\ndiff --git a/internal/setupcmd/report.go b/internal/setupcmd/report.go\nnew file mode 100644\nindex 0000000..a838de9\n--- /dev/null\n+++ b/internal/setupcmd/report.go\n@@ -0,0 +1,67 @@\n+// Package setupcmd implements `ard setup`: run every check, then apply the\n+// fixes only when the checks are green.\n+package setupcmd\n+\n+import (\n+\t\"fmt\"\n+\t\"io\"\n+)\n+\n+// Status is the state of one report row.\n+type Status string\n+\n+// The four row states.\n+const (\n+\tStatusOK      Status = \"ok\"\n+\tStatusChanged Status = \"changed\"\n+\tStatusDrift   Status = \"drift\"\n+\tStatusManual  Status = \"manual\"\n+)\n+\n+// Row is one line of the report. For a manual row Detail is the exact fix.\n+type Row struct {\n+\tName   string\n+\tStatus Status\n+\tDetail string\n+}\n+\n+// Report is the ordered list of rows.\n+type Report struct{ Rows []Row }\n+\n+// Green reports whether no row is drift or manual.\n+func (r Report) Green() bool {\n+\tfor _, x := range r.Rows {\n+\t\tif x.Status == StatusDrift || x.Status == StatusManual {\n+\t\t\treturn false\n+\t\t}\n+\t}\n+\treturn true\n+}\n+\n+// HasDrift reports whether any row is drift.\n+func (r Report) HasDrift() bool {\n+\tfor _, x := range r.Rows {\n+\t\tif x.Status == StatusDrift {\n+\t\t\treturn true\n+\t\t}\n+\t}\n+\treturn false\n+}\n+\n+// Print writes one line per row. A manual row reads \"manual: <fix>\".\n+func Print(w io.Writer, r Report, dryRun bool) {\n+\tif dryRun {\n+\t\tfmt.Fprintln(w, \"dry-run: nothing is written\")\n+\t}\n+\tfor _, x := range r.Rows {\n+\t\tif x.Status == StatusManual {\n+\t\t\tfmt.Fprintf(w, \"manual: %s: %s\\n\", x.Name, x.Detail)\n+\t\t\tcontinue\n+\t\t}\n+\t\tif x.Detail == \"\" {\n+\t\t\tfmt.Fprintf(w, \"%-8s%s\\n\", x.Status, x.Name)\n+\t\t\tcontinue\n+\t\t}\n+\t\tfmt.Fprintf(w, \"%-8s%s: %s\\n\", x.Status, x.Name, x.Detail)\n+\t}\n+}\ndiff --git a/internal/setupcmd/setup.go b/internal/setupcmd/setup.go\nnew file mode 100644\nindex 0000000..878e38d\n--- /dev/null\n+++ b/internal/setupcmd/setup.go\n@@ -0,0 +1,98 @@\n+package setupcmd\n+\n+import (\n+\t\"context\"\n+\t\"fmt\"\n+\t\"io\"\n+\t\"log/slog\"\n+\t\"sort\"\n+\t\"strings\"\n+\n+\t\"github.com/albertcbrown/ard/internal/labels\"\n+\t\"github.com/albertcbrown/ard/internal/labels/labelsync\"\n+)\n+\n+// Opts are the flags of `ard setup`.\n+type Opts struct{ Check bool }\n+\n+// Deps is what Run needs from the outside world.\n+type Deps struct {\n+\tReader      labelsync.Reader\n+\tWriter      labelsync.Writer // the effect layer: a dry-run writer writes nothing\n+\tDesired     []labels.Label\n+\tPermissions func(ctx context.Context) Row\n+\tLocalVsMain func(ctx context.Context) (warning string, err error)\n+\tDryRun      bool\n+\tLog         *slog.Logger\n+}\n+\n+const (\n+\tpermName  = \"permissions\"\n+\tlabelName = \"labels\"\n+)\n+\n+// Run executes the checks, then applies when the permission row is ok and\n+// Check is not set. The returned report holds the final rows.\n+func Run(ctx context.Context, d Deps, o Opts, out io.Writer) (Report, error) {\n+\tif d.LocalVsMain != nil {\n+\t\tw, err := d.LocalVsMain(ctx)\n+\t\tif err != nil {\n+\t\t\tw = \"could not compare ./.ard/ with origin/main\"\n+\t\t}\n+\t\tif w != \"\" {\n+\t\t\tfmt.Fprintf(out, \"warning: %s\\n\", w)\n+\t\t}\n+\t}\n+\tperm := Row{Name: permName, Status: StatusOK}\n+\tif d.Permissions != nil {\n+\t\tperm = d.Permissions(ctx)\n+\t\tperm.Name = permName\n+\t}\n+\trep := Report{Rows: []Row{perm}}\n+\tif perm.Status != StatusOK {\n+\t\t// Nothing else can be read reliably without access.\n+\t\treturn rep, nil\n+\t}\n+\thave, err := d.Reader.ListLabels(ctx)\n+\tif err != nil {\n+\t\treturn rep, fmt.Errorf(\"setup: list labels: %w\", err)\n+\t}\n+\tplan := labelsync.Diff(have, d.Desired)\n+\trow := Row{Name: labelName, Status: StatusOK}\n+\tif n, m := len(plan.Create), len(plan.Update); n+m > 0 {\n+\t\trow.Status = StatusDrift\n+\t\trow.Detail = fmt.Sprintf(\"%d to create, %d to update\", n, m)\n+\t}\n+\tif len(plan.Stale) > 0 {\n+\t\tsep := \"\"\n+\t\tif row.Detail != \"\" {\n+\t\t\tsep = \"; \"\n+\t\t}\n+\t\trow.Detail += sep + \"stale (not deleted): \" + strings.Join(plan.Stale, \", \")\n+\t}\n+\trep.Rows = append(rep.Rows, row)\n+\tif o.Check || row.Status != StatusDrift {\n+\t\treturn rep, nil\n+\t}\n+\n+\tsr, err := labelsync.Sync(ctx, d.Reader, d.Writer, d.Desired, d.Log)\n+\tif err != nil && sr.Failed == nil {\n+\t\treturn rep, err\n+\t}\n+\trow = Row{Name: labelName, Status: StatusChanged}\n+\tswitch {\n+\tcase len(sr.Failed) > 0:\n+\t\tvar names []string\n+\t\tfor n := range sr.Failed {\n+\t\t\tnames = append(names, n)\n+\t\t}\n+\t\tsort.Strings(names)\n+\t\trow = Row{Name: labelName, Status: StatusManual, Detail: \"create or update these labels by hand: \" + strings.Join(names, \", \")}\n+\tcase d.DryRun:\n+\t\trow.Detail = fmt.Sprintf(\"would create %d, would update %d\", len(sr.Create), len(sr.Update))\n+\tdefault:\n+\t\trow.Detail = fmt.Sprintf(\"created %d, updated %d\", len(sr.Create), len(sr.Update))\n+\t}\n+\trep.Rows[len(rep.Rows)-1] = row\n+\treturn rep, err\n+}\ndiff --git a/internal/setupcmd/setup_test.go b/internal/setupcmd/setup_test.go\nnew file mode 100644\nindex 0000000..cbb443f\n--- /dev/null\n+++ b/internal/setupcmd/setup_test.go\n@@ -0,0 +1,186 @@\n+package setupcmd\n+\n+import (\n+\t\"bytes\"\n+\t\"context\"\n+\t\"errors\"\n+\t\"io\"\n+\t\"log/slog\"\n+\t\"strings\"\n+\t\"testing\"\n+\n+\t\"github.com/albertcbrown/ard/internal/effects\"\n+\t\"github.com/albertcbrown/ard/internal/github\"\n+\t\"github.com/albertcbrown/ard/internal/github/fake\"\n+\t\"github.com/albertcbrown/ard/internal/labels\"\n+\t\"github.com/albertcbrown/ard/internal/labels/labelsync\"\n+)\n+\n+var quiet = slog.New(slog.NewTextHandler(io.Discard, nil))\n+\n+var want = []labels.Label{\n+\t{Name: \"ard:hold\", Color: \"f9a03f\", Description: \"d\"},\n+\t{Name: \"ard:keep\", Color: \"cfd3d7\", Description: \"k\"},\n+}\n+\n+func okPerm(context.Context) Row { return Row{Status: StatusOK, Detail: \"repository reachable\"} }\n+\n+func deps(f *fake.Fake) Deps {\n+\treturn Deps{Reader: f, Writer: effects.NewLive(f, nil, quiet), Desired: want, Permissions: okPerm, Log: quiet}\n+}\n+\n+func labelRow(t *testing.T, r Report) Row {\n+\tt.Helper()\n+\tfor _, x := range r.Rows {\n+\t\tif x.Name == labelName {\n+\t\t\treturn x\n+\t\t}\n+\t}\n+\tt.Fatalf(\"no labels row in %+v\", r.Rows)\n+\treturn Row{}\n+}\n+\n+func TestRunAppliesWhenGreen(t *testing.T) {\n+\tf := fake.New()\n+\trep, err := Run(context.Background(), deps(f), Opts{}, io.Discard)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif r := labelRow(t, rep); r.Status != StatusChanged || r.Detail != \"created 2, updated 0\" {\n+\t\tt.Errorf(\"row = %+v\", r)\n+\t}\n+\tif got, _ := f.ListLabels(context.Background()); len(got) != 2 {\n+\t\tt.Errorf(\"labels = %v\", got)\n+\t}\n+}\n+\n+func TestRunIdempotent(t *testing.T) {\n+\tf := fake.New()\n+\td := deps(f)\n+\tif _, err := Run(context.Background(), d, Opts{}, io.Discard); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tn := len(f.Writes())\n+\trep, err := Run(context.Background(), d, Opts{}, io.Discard)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif r := labelRow(t, rep); r.Status != StatusOK || len(f.Writes()) != n {\n+\t\tt.Errorf(\"row = %+v, writes %d -> %d\", r, n, len(f.Writes()))\n+\t}\n+}\n+\n+func TestRunCheckReportsDriftNoWrites(t *testing.T) {\n+\tf := fake.New()\n+\trep, err := Run(context.Background(), deps(f), Opts{Check: true}, io.Discard)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif !rep.HasDrift() || rep.Green() || len(f.Writes()) != 0 {\n+\t\tt.Errorf(\"rep = %+v writes = %d\", rep, len(f.Writes()))\n+\t}\n+\tif r := labelRow(t, rep); r.Detail != \"2 to create, 0 to update\" {\n+\t\tt.Errorf(\"detail = %q\", r.Detail)\n+\t}\n+}\n+\n+func TestRunPermissionFailureSkipsApply(t *testing.T) {\n+\tf := fake.New()\n+\td := deps(f)\n+\td.Permissions = fun