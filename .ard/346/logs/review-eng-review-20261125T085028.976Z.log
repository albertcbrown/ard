tDryRun:      dry,\n332\t+\t\tLog:         e.Log,\n333\t+\t}\n334\t+\treturn execute(ctx, e, d, o)\n335\t+}\n336\t+\n337\t+// execute runs setup with the given dependencies and maps the report to\n338\t+// the command's outcome: exit 2 on drift under --check, an error when\n339\t+// manual steps are needed.\n340\t+func execute(ctx context.Context, e *cli.Env, d Deps, o cli.SetupOpts) error {\n341\t+\trep, err := Run(ctx, d, Opts{Check: o.Check}, e.Stdout)\n342\t+\tPrint(e.Stdout, rep, d.DryRun)\n343\t+\tif err != nil {\n344\t+\t\treturn err\n345\t+\t}\n346\t+\tif o.Check && rep.HasDrift() {\n347\t+\t\treturn &cli.ExitError{Code: 2, Err: errors.New(\"setup: drift\")}\n348\t+\t}\n349\t+\tif !rep.Green() {\n350\t+\t\treturn errors.New(\"setup: manual steps needed\")\n351\t+\t}\n352\t+\treturn nil\n353\t+}\n354\t+\n355\t+// LocalVsMain returns a warning when ./.ard/ in the worktree differs from\n356\t+// origin/main, which is what ard serve reads. It never fails the run.\n357\t+func LocalVsMain(ctx context.Context, root string) (string, error) {\n358\t+\tg := gitx.New(\"\")\n359\t+\tif _, err := g.RevParse(ctx, root, \"origin/main\"); err != nil {\n360\t+\t\treturn \"origin/main not found; cannot compare ./.ard/ with what ard serve reads\", nil\n361\t+\t}\n362\t+\tch, err := g.ChangedSince(ctx, root, root, \"origin/main\", \".ard/\")\n363\t+\tif err != nil {\n364\t+\t\treturn \"\", err\n365\t+\t}\n366\t+\tif len(ch) > 0 {\n367\t+\t\treturn \"./.ard/ differs from origin/main (ard serve reads origin/main)\", nil\n368\t+\t}\n369\t+\treturn \"\", nil\n370\t+}\n371\tdiff --git a/internal/setupcmd/cmd_test.go b/internal/setupcmd/cmd_test.go\n372\tnew file mode 100644\n373\tindex 0000000..afdbe09\n374\t--- /dev/null\n375\t+++ b/internal/setupcmd/cmd_test.go\n376\t@@ -0,0 +1,89 @@\n377\t+package setupcmd\n378\t+\n379\t+import (\n380\t+\t\"bytes\"\n381\t+\t\"context\"\n382\t+\t\"errors\"\n383\t+\t\"os\"\n384\t+\t\"path/filepath\"\n385\t+\t\"strings\"\n386\t+\t\"testing\"\n387\t+\n388\t+\t\"github.com/albertcbrown/ard/internal/cli\"\n389\t+\t\"github.com/albertcbrown/ard/internal/github/fake\"\n390\t+\t\"github.com/albertcbrown/ard/internal/gitx/gittest\"\n391\t+)\n392\t+\n393\t+func TestCommandBadConfigBeforeNetwork(t *testing.T) {\n394\t+\troot := t.TempDir()\n395\t+\tif err := os.MkdirAll(filepath.Join(root, \".ard\"), 0o755); err != nil {\n396\t+\t\tt.Fatal(err)\n397\t+\t}\n398\t+\tcfg := filepath.Join(root, \".ard\", \"config.yaml\")\n399\t+\tif err := os.WriteFile(cfg, []byte(\"executor: remote\\n\"), 0o644); err != nil {\n400\t+\t\tt.Fatal(err)\n401\t+\t}\n402\t+\te := &cli.Env{Globals: cli.Globals{ConfigPath: cfg, Repo: \"o/r\"}, Log: quiet, Stdout: &bytes.Buffer{}, Stderr: &bytes.Buffer{}}\n403\t+\tif err := Command(context.Background(), e, cli.SetupOpts{Check: true}); err == nil || !strings.HasPrefix(err.Error(), \"setup:\") {\n404\t+\t\tt.Errorf(\"err = %v\", err)\n405\t+\t}\n406\t+}\n407\t+\n408\t+func TestCheckExitsTwoOnDrift(t *testing.T) {\n409\t+\tf := fake.New()\n410\t+\tvar out bytes.Buffer\n411\t+\te := &cli.Env{Log: quiet, Stdout: &out, Stderr: &bytes.Buffer{}}\n412\t+\terr := execute(context.Background(), e, deps(f), cli.SetupOpts{Check: true})\n413\t+\tvar ee *cli.ExitError\n414\t+\tif !errors.As(err, &ee) || ee.Code != 2 {\n415\t+\t\tt.Fatalf(\"err = %v, want ExitError code 2\", err)\n416\t+\t}\n417\t+\tif got, _ := f.ListLabels(context.Background()); len(got) != 0 {\n418\t+\t\tt.Errorf(\"check wrote labels: %v\", got)\n419\t+\t}\n420\t+\t// Applying fixes the drift; a second check is clean.\n421\t+\tif err := execute(context.Background(), e, deps(f), cli.SetupOpts{}); err != nil {\n422\t+\t\tt.Fatalf(\"apply: %v\", err)\n423\t+\t}\n424\t+\tif err := execute(context.Background(), e, deps(f), cli.SetupOpts{Check: true}); err != nil {\n425\t+\t\tt.Errorf(\"check after apply: %v\", err)\n426\t+\t}\n427\t+}\n428\t+\n429\t+func TestExecuteManualStepsError(t *testing.T) {\n430\t+\td := deps(fake.New())\n431\t+\td.Permissions = func(context.Context) Row { return Row{Status: StatusManual, Detail: \"fix it\"} }\n432\t+\te := &cli.Env{Log: quiet, Stdout: &bytes.Buffer{}, Stderr: &bytes.Buffer{}}\n433\t+\terr := execute(context.Background(), e, d, cli.SetupOpts{})\n434\t+\tif err == nil || !strings.Contains(err.Error(), \"manual steps needed\") {\n435\t+\t\tt.Errorf(\"err = %v\", err)\n436\t+\t}\n437\t+}\n438\t+\n439\t+func TestLocalVsMain(t *testing.T) {\n440\t+\tctx := context.Background()\n441\t+\t_, clone := gittest.NewRemote(t)\n442\t+\tt.Run(\"same\", func(t *testing.T) {\n443\t+\t\tif w, err := LocalVsMain(ctx, clone); err != nil || w != \"\" {\n444\t+\t\t\tt.Errorf(\"w=%q err=%v\", w, err)\n445\t+\t\t}\n446\t+\t})\n447\t+\tt.Run(\"differing\", func(t *testing.T) {\n448\t+\t\tif err := os.MkdirAll(filepath.Join(clone, \".ard\"), 0o755); err != nil {\n449\t+\t\t\tt.Fatal(err)\n450\t+\t\t}\n451\t+\t\tif err := os.WriteFile(filepath.Join(clone, \".ard\", \"config.yaml\"), []byte(\"x: 1\\n\"), 0o644); err != nil {\n452\t+\t\t\tt.Fatal(err)\n453\t+\t\t}\n454\t+\t\tif w, err := LocalVsMain(ctx, clone); err != nil || !strings.Contains(w, \"differs from origin/main\") {\n455\t+\t\t\tt.Errorf(\"w=%q err=%v\", w, err)\n456\t+\t\t}\n457\t+\t})\n458\t+\tt.Run(\"no origin/main\", func(t *testing.T) {\n459\t+\t\tdir := t.TempDir()\n460\t+\t\tgittest.Run(t, dir, \"init\", \"--initial-branch=main\")\n461\t+\t\tif w, err := LocalVsMain(ctx, dir); err != nil || !strings.Contains(w, \"origin/main not found\") {\n462\t+\t\t\tt.Errorf(\"w=%q err=%v\", w, err)\n463\t+\t\t}\n464\t+\t})\n465\t+}\n466\tdiff --git a/internal/setupcmd/report.go b/internal/setupcmd/report.go\n467\tnew file mode 100644\n468\tindex 0000000..a838de9\n469\t--- /dev/null\n470\t+++ b/internal/setupcmd/report.go\n471\t@@ -0,0 +1,67 @@\n472\t+// Package setupcmd implements `ard setup`: run every check, then apply the\n473\t+// fixes only when the checks are green.\n474\t+package setupcmd\n475\t+\n476\t+import (\n477\t+\t\"fmt\"\n478\t+\t\"io\"\n479\t+)\n480\t+\n481\t+// Status is the state of one report row.\n482\t+type Status string\n483\t+\n484\t+// The four row states.\n485\t+const (\n486\t+\tStatusOK      Status = \"ok\"\n487\t+\tStatusChanged Status = \"changed\"\n488\t+\tStatusDrift   Status = \"drift\"\n489\t+\tStatusManual  Status = \"manual\"\n490\t+)\n491\t+\n492\t+// Row is one line of the report. For a manual row Detail is the exact fix.\n493\t+type Row struct {\n494\t+\tName   string\n495\t+\tStatus Status\n496\t+\tDetail string\n497\t+}\n498\t+\n499\t+// Report is the ordered list of rows.\n500\t+type Report struct{ Rows []Row }\n501\t+\n502\t+// Green reports whether no row is drift or manual.\n503\t+func (r Report) Green() bool {\n504\t+\tfor _, x := range r.Rows {\n505\t+\t\tif x.Status == StatusDrift || x.Status == StatusManual {\n506\t+\t\t\treturn false\n507\t+\t\t}\n508\t+\t}\n509\t+\treturn true\n510\t+}\n511\t+\n512\t+// HasDrift reports whether any row is drift.\n513\t+func (r Report) HasDrift() bool {\n514\t+\tfor _, x := range r.Rows {\n515\t+\t\tif x.Status == StatusDrift {\n516\t+\t\t\treturn true\n517\t+\t\t}\n518\t+\t}\n519\t+\treturn false\n520\t+}\n521\t+\n522\t+// Print writes one line per row. A manual row reads \"manual: <fix>\".\n523\t+func Print(w io.Writer, r Report, dryRun bool) {\n524\t+\tif dryRun {\n525\t+\t\tfmt.Fprintln(w, \"dry-run: nothing is written\")\n526\t+\t}\n527\t+\tfor _, x := range r.Rows {\n528\t+\t\tif x.Status == StatusManual {\n529\t+\t\t\tfmt.Fprintf(w, \"manual: %s: %s\\n\", x.Name, x.Detail)\n530\t+\t\t\tcontinue\n531\t+\t\t}\n532\t+\t\tif x.Detail == \"\" {\n533\t+\t\t\tfmt.Fprintf(w, \"%-8s%s\\n\", x.Status, x.Name)\n534\t+\t\t\tcontinue\n535\t+\t\t}\n536\t+\t\tfmt.Fprintf(w, \"%-8s%s: %s\\n\", x.Status, x.Name, x.Detail)\n537\t+\t}\n538\t+}\n539\tdiff --git a/internal/setupcmd/setup.go b/internal/setupcmd/setup.go\n540\tnew file mode 100644\n541\tindex 0000000..878e38d\n542\t--- /dev/null\n543\t+++ b/internal/setupcmd/setup.go\n544\t@@ -0,0 +1,98 @@\n545\t+package setupcmd\n546\t+\n547\t+import (\n548\t+\t\"context\"\n549\t+\t\"fmt\"\n550\t+\t\"io\"\n551\t+\t\"log/slog\"\n552\t+\t\"sort\"\n553\t+\t\"strings\"\n554\t+\n555\t+\t\"github.com/albertcbrown/ard/internal/labels\"\n556\t+\t\"github.com/albertcbrown/ard/internal/labels/labelsync\"\n557\t+)\n558\t+\n559\t+// Opts are the flags of `ard setup`.\n560\t+type Opts struct{ Check bool }\n561\t+\n562\t+// Deps is what Run needs from the outside world.\n563\t+type Deps struct {\n564\t+\tReader      labelsync.Reader\n565\t+\tWriter      labelsync.Writer // the effect layer: a dry-run writer writes nothing\n566\t+\tDesired     []labels.Label\n567\t+\tPermissions func(ctx context.Context) Row\n568\t+\tLocalVsMain func(ctx context.Context) (warning string, err error)\n569\t+\tDryRun      bool\n570\t+\tLog         *slog.Logger\n571\t+}\n572\t+\n573\t+const (\n574\t+\tpermName  = \"permissions\"\n575\t+\tlabelName = \"labels\"\n576\t+)\n577\t+\n578\t+// Run executes the checks, then applies when the permission row is ok and\n579\t+// Check is not set. The returned report holds the final rows.\n580\t+func Run(ctx context.Context, d Deps, o Opts, out io.Writer) (Report, error) {\n581\t+\tif d.LocalVsMain != nil {\n582\t+\t\tw, err := d.LocalVsMain(ctx)\n583\t+\t\tif err != nil {\n584\t+\t\t\tw = \"could not compare ./.ard/ with origin/main\"\n585\t+\t\t}\n586\t+\t\tif w != \"\" {\n587\t+\t\t\tfmt.Fprintf(out, \"warning: %s\\n\", w)\n588\t+\t\t}\n589\t+\t}\n590\t+\tperm := Row{Name: permName, Status: StatusOK}\n591\t+\tif d.Permissions != nil {\n592\t+\t\tperm = d.Permissions(ctx)\n593\t+\t\tperm.Name = permName\n594\t+\t}\n595\t+\trep := Report{Rows: []Row{perm}}\n596\t+\tif perm.Status != StatusOK {\n597\t+\t\t// Nothing else can be read reliably without access.\n598\t+\t\treturn rep, nil\n599\t+\t}\n600\t+\thave, err := d.Reader.ListLabels(ctx)\n601\t+\tif err != nil {\n602\t+\t\treturn rep, fmt.Errorf(\"setup: list labels: %w\", err)\n603\t+\t}\n604\t+\tplan := labelsync.Diff(have, d.Desired)\n605\t+\trow := Row{Name: labelName, Status: StatusOK}\n606\t+\tif n, m := len(plan.Create), len(plan.Update); n+m > 0 {\n607\t+\t\trow.Status = StatusDrift\n608\t+\t\trow.Detail = fmt.Sprintf(\"%d to create, %d to update\", n, m)\n609\t+\t}\n610\t+\tif len(plan.Stale) > 0 {\n611\t+\t\tsep := \"\"\n612\t+\t\tif row.Detail != \"\" {\n613\t+\t\t\tsep = \"; \"\n614\t+\t\t}\n615\t+\t\trow.Detail += sep + \"stale (not deleted): \" + strings.Join(plan.Stale, \", \")\n616\t+\t}\n617\t+\trep.Rows = append(rep.Rows, row)\n618\t+\tif o.Check || row.Status != StatusDrift {\n619\t+\t\treturn rep, nil\n620\t+\t}\n621\t+\n622\t+\tsr, err := labelsync.Sync(ctx, d.Reader, d.Writer, d.Desired, d.Log)\n623\t+\tif err != nil && sr.Failed == nil {\n624\t+\t\treturn rep, err\n625\t+\t}\n626\t+\trow = Row{Name: labelName, Status: StatusChanged}\n627\t+\tswitch {\n628\t+\tcase len(sr.Failed) > 0:\n629\t+\t\tvar names []string\n630\t+\t\tfor n := range sr.Failed {\n631\t+\t\t\tnames = append(names, n)\n632\t+\t\t}\n633\t+\t\tsort.Strings(names)\n634\t+\t\trow = Row{Name: labelName, Status: StatusManual, Detail: \"create or update these labels by hand: \" + strings.Join(names, \", \")}\n635\t+\tcase d.DryRun:\n636\t+\t\trow.Detail = fmt.Sprintf(\"would create %d, would update %d\", len(sr.Create), len(sr.Update))\n637\t+\tdefault:\n638\t+\t\trow.Detail = fmt.Sprintf(\"created %d, updated %d\", len(sr.Create), len(sr.Update))\n639\t+\t}\n640\t+\trep.Rows[len(rep.Rows)-1] = row\n641\t+\treturn rep, err\n642\t+}\n643\tdiff --git a/internal/setupcmd/setup_test.go b/internal/setupcmd/setup_test.go\n644\tnew file mode 100644\n645\tindex 0000000..cbb443f\n646\t--- /dev/null\n647\t+++ b/internal/setupcmd/setup_test.go\n648\t@@ -0,0 +1,186 @@\n649\t+package setupcmd\n650\t+\n651\t+import (\n652\t+\t\"bytes\"\n653\t+\t\"context\"\n654\t+\t\"errors\"\n655\t+\t\"io\"\n656\t+\t\"log/slog\"\n657\t+\t\"strings\"\n658\t+\t\"testing\"\n659\t+\n660\t+\t\"github.co