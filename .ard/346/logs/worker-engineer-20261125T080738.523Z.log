hub.Label) error {\ninternal/effects/effects_test.go:201:\t\t{\"AddLabels\", func(d *DryRun) error { return d.AddLabels(ctx, 3, \"ard:x\", \"ard:y\") }, []string{\"ard:x\", \"ard:y\"}},\ninternal/effects/effects_test.go:202:\t\t{\"RemoveLabel\", func(d *DryRun) error { return d.RemoveLabel(ctx, 3, \"ard:x\") }, []string{`\"label\":\"ard:x\"`}},","is_error":false}]},"parent_tool_use_id":null,"session_id":"0c9d1529-0074-4082-8845-1530432d4a3e","uuid":"2828370c-7d59-4212-9db3-a73719ca7589","timestamp":"2026-11-25T08:07:45.167Z","tool_use_result":{"stdout":"// Report is the outcome of Sync.\ntype Report struct {\n\tPlan\n\tFailed map[string]error // label name -> error from the write\n}\n\n// Sync lists the repository's labels, diffs them against want and applies the\n// difference: creates first, then updates, each in name order. One failure\n// does not stop the rest; Sync returns the failures joined. A list error\n// returns before anything is written. Stale labels are logged, never deleted.\nfunc Sync(ctx context.Context, r Reader, w Writer, want []labels.Label, log *slog.Logger) (Report, error) {\n\tif log == nil {\n\t\tlog = slog.Default()\n\t}\n\thave, err := r.ListLabels(ctx)\n\tif err != nil {\n\t\treturn Report{}, fmt.Errorf(\"labels sync: list labels: %w\", err)\n\t}\n\trep := Report{Plan: Diff(have, want), Failed: map[string]error{}}\n\tvar errs []error\n\tfail := func(name string, err error) {\n\t\trep.Failed[name] = err\n\t\terrs = append(errs, fmt.Errorf(\"labels sync: %s: %w\", name, err))\n\t}\n\tfor _, l := range rep.Create {\n\t\tlog.InfoContext(ctx, \"label\", \"label\", l.Name, \"action\", \"create\")\n\t\tif err := w.CreateLabel(ctx, github.Label{Name: l.Name, Color: l.Color, Description: l.Description}); err != nil {\n\t\t\tfail(l.Name, err)\n\t\t}\n\t}\n\tfor _, u := range rep.Update {\n\t\tlog.InfoContext(ctx, \"label\", \"label\", u.Want.Name, \"action\", \"update\",\n\t\t\t\"old_color\", u.Have.Color, \"new_color\", u.Want.Color,\n\t\t\t\"old_desc\", u.Have.Description, \"new_desc\", u.Want.Description)\n\t\t// Keep the repo's own spelling of the name: no rename.\n\t\terr := w.UpdateLabel(ctx, u.Have.Name, github.Label{Name: u.Have.Name, Color: u.Want.Color, Description: u.Want.Description})\n\t\tif err != nil {\n\t\t\tfail(u.Want.Name, err)\n\t\t}\n\t}\n\tfor _, s := range rep.Stale {\n\t\tlog.WarnContext(ctx, \"stale label\", \"label\", s, \"hint\", \"not deleted; remove it by hand if unused\")\n\t}\n\tlog.InfoContext(ctx, \"labels sync\",\n\t\t\"created\", len(rep.Create), \"updated\", len(rep.Update), \"unchanged\", len(rep.Unchanged), \"stale\", len(rep.Stale), \"failed\", len(rep.Failed))\n\treturn rep, errors.Join(errs...)\n}\ntype Env struct {\n\tGlobals\n\tLog            *slog.Logger\n\tStdout, Stderr io.Writer\n}\n\n// Handlers holds one function per implemented command. A nil field makes\n// that command exit non-zero with an ErrNotImplemented message.\ntype Handlers struct {\n\tServe        func(ctx context.Context, e *Env, o ServeOpts) error       // #15\n\tConfigCheck  func(ctx context.Context, e *Env, o ConfigCheckOpts) error // #11\n\tLabelsSync   func(ctx context.Context, e *Env) error                    // #22\n\tRebuildState func(ctx context.Context, e *Env, scanner string) error    // #23\n\tInit         func(ctx context.Context, e *Env, o InitOpts) error        // #27\n}\n\n// ServeOpts is the parsed flag set of `ard serve`.\ntype ServeOpts struct {\n\t// Loops names the controller loops to run; empty means every loop (#187).\n\tLoops []string\n}\n\n// ConfigCheckOpts is the parsed flag set of `ard config check`.\ntype ConfigCheckOpts struct {\n\t// Ref is a commit to validate instead of the working tree; \"\" means the\n\t// working tree.\n\tRef string\n}\n\n// InitOpts is the parsed flag set of `ard init`.\ntype InitOpts struct {\n\tForce bool\n}\n\n// ErrNotImplemented is returned (wrapped) by stub commands whose handler\n// has not been wired yet.\n\troot.PersistentFlags().StringVar(&g.LogLevel, \"log-level\", \"info\",\n\t\t\"log level: debug, info, warn or error\")\n\n\troot.AddCommand(\n\t\tnewServe(app),\n\t\tnewConfig(app),\n\t\tnewLabels(app),\n\t\tnewRebuildState(app),\n\t\tnewInit(app),\n\t\tnewVersion(app),\n\t)\n\treturn root\n}\n\tif ok && info != nil && info.Main.Version != \"\" && info.Main.Version != \"(devel)\" {\n\t\treturn info.Main.Version\n\t}\n\treturn \"dev\"\n}\n\n// handlers wires one function per subcommand. Each new command adds one\n// line here; a nil field runs the command as a \"not implemented\" stub.\nfunc handlers() cli.Handlers {\n\treturn cli.Handlers{\n\t\tConfigCheck:  configcmd.Check,\n\t\tServe:        servecmd.Serve,\n\t\tLabelsSync:   labelsync.Command,\n\t\tRebuildState: servecmd.RebuildState,\n\t\tInit:         initcmd.Init,\n\t}\n}\ninternal/gitx/inspect.go:15:func (g *Git) LsRemote(ctx context.Context, dir, url, pattern string, token TokenFunc) (map[string]string, error) {\ninternal/gitx/inspect.go:55:func (g *Git) MergeBaseAll(ctx context.Context, repoDir, a, b string) ([]string, error) {\ninternal/gitx/inspect.go:65:func (g *Git) MergeBase(ctx context.Context, repoDir, a, b string) (string, error) {\ninternal/gitx/inspect.go:75:func (g *Git) IsAncestor(ctx context.Context, repoDir, a, b string) (bool, error) {\ninternal/gitx/inspect.go:87:func (g *Git) Parents(ctx context.Context, repoDir, rev string) ([]string, error) {\ninternal/gitx/inspect.go:102:func (g *Git) PatchID(ctx context.Context, repoDir, from, to, path string) (string, error) {\ninternal/gitx/local.go:26:func (g *Git) worktreeLock(ctx context.Context, repoDir string) (func(), error) {\ninternal/gitx/local.go:64:func (g *Git) Version(ctx context.Context) (major, minor int, err error) {\ninternal/gitx/local.go:82:func (g *Git) WorktreeAdd(ctx context.Context, repoDir, path, ref string) error {\ninternal/gitx/local.go:101:func (g *Git) WorktreeRemove(ctx context.Context, repoDir, path string) error {\ninternal/gitx/local.go:121:func (