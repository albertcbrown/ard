{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SXo2SPw9HmPKUExwgCd2RM","type":"tool_result","content":"package labelsync\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"sort\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/cli\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/effects\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n)\n\n// deps is what run needs from the outside world.\ntype deps struct {\n\tReader Reader\n\tWriter Writer\n}\n\n// Command is the handler behind `ard labels sync`.\nfunc Command(ctx context.Context, e *cli.Env) error {\n\treturn run(ctx, e, func(ctx context.Context, root string) (deps, error) {\n\t\trepo, err := resolveRepo(ctx, e, root)\n\t\tif err != nil {\n\t\t\treturn deps{}, err\n\t\t}\n\t\tauth, err := github.AuthFromEnv(os.Getenv, os.ReadFile)\n\t\tif err != nil {\n\t\t\treturn deps{}, fmt.Errorf(\"labels sync: %w\", err)\n\t\t}\n\t\tfx, rd, err := effects.Open(ctx, effects.Options{\n\t\t\tDryRun: e.DryRun,\n\t\t\tGitHub: github.Config{Repo: repo, Auth: auth, Log: e.Log},\n\t\t\tLog:    e.Log,\n\t\t})\n\t\tif err != nil {\n\t\t\treturn deps{}, fmt.Errorf(\"labels sync: %w\", err)\n\t\t}\n\t\treturn deps{Reader: rd, Writer: fx}, nil\n\t})\n}\n\n// run loads and validates the configuration before it builds any GitHub\n// client, so a bad config never reaches the network.\nfunc run(ctx context.Context, e *cli.Env, open func(ctx context.Context, root string) (deps, error)) error {\n\troot, err := config.RepoRoot(e.ConfigPath)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"labels sync: %w\", err)\n\t}\n\tres, err := config.Load(root)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"labels sync: %w\", err)\n\t}\n\twant, err := labels.Desired(labels.SpecFrom(res))\n\tif err != nil {\n\t\treturn err\n\t}\n\td, err := open(ctx, root)\n\tif err != nil {\n\t\treturn err\n\t}\n\trep, err := Sync(ctx, d.Reader, d.Writer, want, e.Log)\n\tif err != nil && rep.Failed == nil {\n\t\treturn err\n\t}\n\tPrint(e.Stdout, rep, e.DryRun)\n\treturn err\n}\n\n// resolveRepo takes --repo, or falls back to the origin remote of the\n// repository that holds the config. config.Resolved carries no owner/name.\nfunc resolveRepo(ctx context.Context, e *cli.Env, root string) (github.Repo, error) {\n\tif e.Repo != \"\" {\n\t\treturn github.ParseRepo(e.Repo)\n\t}\n\turl, err := gitx.New(\"\").RemoteURL(ctx, root, \"origin\")\n\tif err != nil {\n\t\treturn github.Repo{}, fmt.Errorf(\"labels sync: --repo owner/repo is required (no origin remote to fall back on: %w)\", err)\n\t}\n\trepo, err := github.RepoFromRemote(url)\n\tif err != nil {\n\t\t// Not wrapped: the remote URL may embed a token.\n\t\treturn github.Repo{}, fmt.Errorf(\"labels sync: --repo owner/repo is required (origin remote is not a github.com owner/repo URL)\")\n\t}\n\te.Log.Info(\"repo taken from the origin remote\", \"repo\", repo.String())\n\treturn repo, nil\n}\n\n// Print writes one line per change, stale label and failure, then a summary.\n// Unchanged labels get no line.\nfunc Print(w io.Writer, rep Report, dryRun bool) {\n\tcreate, update := \"create\", \"update\"\n\tif dryRun {\n\t\tcreate, update = \"would create\", \"would update\"\n\t}\n\tline := func(verb, rest string) {\n\t\tpad := 8 - len(verb)\n\t\tif pad < 1 {\n\t\t\tpad = 1\n\t\t}\n\t\tfmt.Fprintf(w, \"%s%s%s\\n\", verb, strings.Repeat(\" \", pad), rest)\n\t}\n\tfailedCreates := 0\n\tfor _, l := range rep.Create {\n\t\tline(create, l.Name)\n\t\tif _, bad := rep.Failed[l.Name]; bad {\n\t\t\tfailedCreates++\n\t\t}\n\t}\n\tfailedUpdates := 0\n\tfor _, u := range rep.Update {\n\t\tline(update, fmt.Sprintf(\"%s (%s)\", u.Want.Name, diffSummary(u)))\n\t\tif _, bad := rep.Failed[u.Want.Name]; bad {\n\t\t\tfailedUpdates++\n\t\t}\n\t}\n\tfor _, s := range rep.Stale {\n\t\tline(\"stale\", s)\n\t}\n\tnames := make([]string, 0, len(rep.Failed))\n\tfor n := range rep.Failed {\n\t\tnames = append(names, n)\n\t}\n\tsort.Strings(names)\n\tfor _, n := range names {\n\t\tline(\"failed\", fmt.Sprintf(\"%s: %v\", n, rep.Failed[n]))\n\t}\n\tcreated, updated := len(rep.Create)-failedCreates, len(rep.Update)-failedUpdates\n\tif dryRun {\n\t\tfmt.Fprintf(w, \"dry-run: would create %d, would update %d, unchanged %d, stale %d\\n\",\n\t\t\tlen(rep.Create), len(rep.Update), len(rep.Unchanged), len(rep.Stale))\n\t\treturn\n\t}\n\tfmt.Fprintf(w, \"created %d, updated %d, unchanged %d, stale %d\\n\", created, updated, len(rep.Unchanged), len(rep.Stale))\n}\n\nfunc diffSummary(u Update) string {\n\tvar parts []string\n\tif !strings.EqualFold(strings.TrimPrefix(u.Have.Color, \"#\"), u.Want.Color) {\n\t\tparts = append(parts, fmt.Sprintf(\"color %s -> %s\", u.Have.Color, u.Want.Color))\n\t}\n\tif u.Have.Description != u.Want.Description {\n\t\tparts = append(parts, \"description changed\")\n\t}\n\treturn strings.Join(parts, \", \")\n}\npackage cli\n\nimport (\n\t\"context\"\n\n\t\"github.com/spf13/cobra\"\n)\n\nfunc newInit(app *App) *cobra.Command {\n\tvar force bool\n\tcmd := &cobra.Command{\n\t\tUse:   \"init\",\n\t\tShort: \"Open a PR that adds the starter .ard/ directory\",\n\t\tArgs:  cobra.NoArgs,\n\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n\t\t\treturn app.run(cmd, func(ctx context.Context, e *Env) error {\n\t\t\t\tif app.Handlers.Init == nil {\n\t\t\t\t\treturn notImpl(cmd.CommandPath(), \"#27\")\n\t\t\t\t}\n\t\t\t\treturn app.Handlers.Init(ctx, e, InitOpts{Force: force})\n\t\t\t})\n\t\t},\n\t}\n\tcmd.Flags().BoolVar(&force, \"force\", false, \"propose starter files even where main has different contents (never deletes)\")\n\treturn cmd\n}\npackage cli\n\nimport (\n\t\"context\"\n\n\t\"github.com/spf13/cobra\"\n)\n\nfunc newLabels(app *App) *cobra.Command {\n\tlabels := &cobra.Command{\n\t\tUse:   \"labels\",\n\t\tShort: \"Manage the ard: label set on the repository\",\n\t\t// No RunE: bare `ard labels` prints the help listing sync.\n\t}\n\tlabels.AddCommand(&cobra.Command{\n\t\tUse:   \"sync\",\n\t\tShort: \"Create or update the ard: labels on the repository\",\n\t\tArgs:  cobra.NoArgs,\n\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n\t\t\treturn app.run(cmd, func(ctx context.Context, e *Env) error {\n\t\t\t\tif app.Handlers.LabelsSync == nil {\n\t\t\t\t\treturn notImpl(cmd.CommandPath(), \"#22\")\n\t\t\t\t}\n\t\t\t\treturn app.Handlers.LabelsSync(ctx, e)\n\t\t\t})\n\t\t},\n\t})\n\treturn labels\n}\n// Package labelsync makes a repository's ard: labels match the catalogue\n// built by package labels. It reads through a narrow Reader and writes only\n// through the effect layer, so --dry-run logs the plan and changes nothing.\n// It creates and updates labels and never deletes any.\npackage labelsync\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"sort\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n)\n\n// Reader lists the repository's labels. github.Reader satisfies it.\ntype Reader interface {\n\tListLabels(ctx context.Context) ([]github.Label, error)\n}\n\n// Writer creates and updates label definitions. effects.Effects satisfies it.\ntype Writer interface {\n\tCreateLabel(ctx context.Context, l github.Label) error\n\tUpdateLabel(ctx context.Context, name string, l github.Label) error\n}\n\n// Update is a label that exists but differs from the catalogue.\ntype Update struct {\n\tHave github.Label\n\tWant labels.Label\n}\n\n// Plan is the difference between the repository and the catalogue.\ntype Plan struct {\n\tCreate    []labels.Label\n\tUpdate    []Update\n\tUnchanged []string\n\tStale     []string // ard: labels on the repo that are not in the catalogue, sorted\n}\n\n// Diff compares have with want. GitHub matches label names\n// case-insensitively, so a name differing only in case is unchanged. Labels\n// without the ard: prefix are ignored.\nfunc Diff(have []github.Label, want []labels.Label) Plan {\n\tidx := make(map[string]github.Label, len(have))\n\tfor _, h := range have {\n\t\tidx[strings.ToLower(h.Name)] = h\n\t}\n\tvar p Plan\n\twanted := make(map[string]bool, len(want))\n\tfor _, w := range want {\n\t\tk := strings.ToLower(w.Name)\n\t\twanted[k] = true\n\t\th, ok := idx[k]\n\t\tswitch {\n\t\tcase !ok:\n\t\t\tp.Create = append(p.Create, w)\n\t\tcase !strings.EqualFold(strings.TrimPrefix(h.Color, \"#\"), strings.TrimPrefix(w.Color, \"#\")) ||\n\t\t\th.Description != w.Description:\n\t\t\tp.Update = append(p.Update, Update{Have: h, Want: w})\n\t\tdefault:\n\t\t\tp.Unchanged = append(p.Unchanged, w.Name)\n\t\t}\n\t}\n\tfor _, h := range have {\n\t\tk := strings.ToLower(h.Name)\n\t\tif strings.HasPrefix(k, labels.Prefix) && !wanted[k] {\n\t\t\tp.Stale = append(p.Stale, h.Name)\n\t\t}\n\t}\n\tsort.Slice(p.Create, func(i, j int) bool { return p.Create[i].Name < p.Create[j].Name })\n\tsort.Slice(p.Update, func(i, j int) bool { return p.Update[i].Want.Name < p.Update[j].Want.Name })\n\tsort.Strings(p.Unchanged)\n\tsort.Strings(p.Stale)\n\treturn p\n}\n\ninternal/cli/app.go:36:\tLabelsSync   func(ctx context.Context, e *Env) error                    // #22\ninternal/cli/app.go:38:\tInit         func(ctx context.Context, e *Env, o InitOpts) error        // #27\ninternal/cli/app.go:54:// InitOpts is the parsed flag set of `ard init`.\ninternal/cli/app.go:55:type InitOpts struct {\ninternal/cli/root.go:46:\t\tnewLabels(app),\ninternal/cli/root.go:48:\t\tnewInit(app),\ncmd/ard/main.go:47:\t\tLabelsSync:   labelsync.Command,\ncmd/ard/main.go:49:\t\tInit:         initcmd.Init,\n53:internal/labels/labelsync/  `ard labels sync`: diff catalogue vs repo, create/update via effects\ninternal/github/fake:\nfake.go\nfake_test.go\n\ninternal/gitx:\nexport_test.go\ngittest\ngitx.go\ngitx_test.go\ninspect.go\ninspect_test.go\nlocal.go\nreview.go\nreview_test.go\nshallow_test.go\nsnapshot.go\nversi