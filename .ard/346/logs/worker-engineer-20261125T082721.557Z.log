Opts{Check: true}); err == nil || !strings.HasPrefix(err.Error(), \"setup:\") {\n\t\tt.Errorf(\"err = %v\", err)\n\t}\n}\n\nfunc TestLocalVsMain(t *testing.T) {\n\tctx := context.Background()\n\t_, clone := gittest.NewRemote(t)\n\tt.Run(\"same\", func(t *testing.T) {\n\t\tif w, err := LocalVsMain(ctx, clone); err != nil || w != \"\" {\n\t\t\tt.Errorf(\"w=%q err=%v\", w, err)\n\t\t}\n\t})\n\tt.Run(\"differing\", func(t *testing.T) {\n\t\tif err := os.MkdirAll(filepath.Join(clone, \".ard\"), 0o755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := os.WriteFile(filepath.Join(clone, \".ard\", \"config.yaml\"), []byte(\"x: 1\\n\"), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif w, err := LocalVsMain(ctx, clone); err != nil || !strings.Contains(w, \"differs from origin/main\") {\n\t\t\tt.Errorf(\"w=%q err=%v\", w, err)\n\t\t}\n\t})\n\tt.Run(\"no origin/main\", func(t *testing.T) {\n\t\tdir := t.TempDir()\n\t\tgittest.Run(t, dir, \"init\", \"--initial-branch=main\")\n\t\tif w, err := LocalVsMain(ctx, dir); err != nil || !strings.Contains(w, \"origin/main not found\") {\n\t\t\tt.Errorf(\"w=%q err=%v\", w, err)\n\t\t}\n\t})\n}\npackage cli\n\nimport (\n\t\"context\"\n\n\t\"github.com/spf13/cobra\"\n)\n\nfunc newSetup(app *App) *cobra.Command {\n\tvar check bool\n\tcmd := &cobra.Command{\n\t\tUse:   \"setup\",\n\t\tShort: \"Check the repository setup, then apply the fixes (exit 2 on drift with --check)\",\n\t\tArgs:  cobra.NoArgs,\n\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n\t\t\treturn app.run(cmd, func(ctx context.Context, e *Env) error {\n\t\t\t\tif app.Handlers.Setup == nil {\n\t\t\t\t\treturn notImpl(cmd.CommandPath(), \"#346\")\n\t\t\t\t}\n\t\t\t\treturn app.Handlers.Setup(ctx, e, SetupOpts{Check: check})\n\t\t\t})\n\t\t},\n\t}\n\tcmd.Flags().BoolVar(&check, \"check\", false, \"report only; exit 2 when anything has drifted\")\n\treturn cmd\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"afb60b11-f9a8-4449-a318-1e116238b3f4","u