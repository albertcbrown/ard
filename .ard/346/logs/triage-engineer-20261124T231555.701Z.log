 func(ctx context.Context, e *Env) error) error {\n\te := a.env\n\te.Log = e.Log.With(\"cmd\", cmd.CommandPath())\n\tif err := h(cmd.Context(), e); err != nil {\n\t\tvar ee *ExitError\n\t\tif errors.As(err, &ee) {\n\t\t\treturn err\n\t\t}\n\t\treturn &ExitError{Code: 1, Err: err}\n\t}\n\treturn nil\n}\n\n// notImpl is the error a stub command returns when its handler is nil.\nfunc notImpl(cmdPath, issue string) error {\n\tif issue == \"\" {\n\t\treturn fmt.Errorf(\"%s: %w\", cmdPath, ErrNotImplemented)\n\t}\n\treturn fmt.Errorf(\"%s: %w (tracked in %s)\", cmdPath, ErrNotImplemented, issue)\n}\n43:\troot.AddCommand(\n48:\t\tnewInit(app),\ninternal/effects:\narchtest\ndryrun.go\neffects.go\neffects_test.go\nledger.go\nlive.go\nopen.go\n\ninternal/github:\nauth.go\nauth_test.go\nclient.go\nclienttest\nconvert.go\ndoc.go\nerrors.go\nfake\ngraphql.go\nhttp.go\nhttp_test.go\nintegration_test.go\nquery\nrepo.go\nrepo_test.go\ntestdata\ntransport.go\ntransport_test.go\ntypes.go\n\ninternal/initcmd:\nbody.go\ninitcmd.go\ninitcmd_test.go\nplan.go\n// Package labelsync makes a repository's ard: labels match the catalogue\n// built by package labels. It reads through a narrow Reader and writes only\n// through the effect layer, so --dry-run logs the plan and changes nothing.\n// It creates and updates labels and never deletes any.\npackage labelsync\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"sort\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n)\n\n// Reader lists the repository's labels. github.Reader satisfies it.\ntype Reader interface {\n\tListLabels(ctx context.Context) ([]github.Label, error)\n}\n\n// Writer creates and updates label definitions. effects.Effects satisfies it.\ntype Writer interface {\n\tCreateLabel(ctx context.Context, l github.Label) error\n\tUpdateLabel(ctx context.Context, name string, l github.Label) error\n}\n\n// Update is a label that exists but differs from the catalogue.\ntype Update struct {\n\tHave github.Label\n\tWant labels.Label\n}\n\n// Plan is the difference between the repository and the catalogue.\ntype Plan struct {\n\tCreate    []labels.Label\n\tUpdate    []Update\n\tUnchanged []string\n\tStale     []string // ard: labels on the repo that are not in the catalogue, sorted\n}\n\n// Diff compares have with want. GitHub matches label names\n// case-insensitively, so a name differing only in case is unchanged. Labels\n// without the ard: prefix are ignored.\nfunc Diff(have []github.Label, want []labels.Label) Plan {\n\tidx := make(map[string]github.Label, len(have))\n\tfor _, h := range have {\n\t\tidx[strings.ToLower(h.Name)] = h\n\t}\n\tvar p Plan\n\twanted := make(map[string]bool, len(want))\n\tfor _, w := range want {\n\t\tk := strings.ToLower(w.Name)\n\t\twanted[k] = true\n\t\th, ok := idx[k]\n\t\tswitch {\n\t\tcase !ok:\n\t\t\tp.Create = append(p.Create, w)\ninternal/effects/open.go:13:type Options struct {\ninternal/effects/open.go-14-\tDryRun     bool\ninternal/effects/open.go-15-\tGitHub     github.Config // passed to github.New\ninternal/effects/open.go-16-\tClient     github.Client // tests only: used instead of github.New when non-nil\ninternal/effects/open.go-17-\tGit        *gitx.Git     // nil = gitx.New(\"\")\ninternal/effects/open.go-18-\tLedgerPath string        // dry-run only; \"\" = no ledger file\ninternal/effects/open.go-19-\tRedact     func(string) string\ninternal/effects/open.go-20-\tLog        *slog.Logger\ninternal/effects/open.go-21-}\ninternal/effects/open.go-22-\ninternal/effects/open.go-23-// readOnly exposes only the Reader. Because the field is an interface of\ninternal/effects/open.go-24-// type github.Reader, a type assertion cannot recover the underlying Writer.\ninternal/effects/open.go-25-type readOnly struct{ github.Reader }\ninternal/effects/open.go-26-\ninternal/effects/open.go-27-// Open is the production factory and the only place the GitHub client is\nint