are: untrusted-input snapshot, admission re-check, agent command and executor job builders, handle save, shutdown-aware wait, post-once\n29\tdiff --git a/internal/tarball/doc.go b/internal/tarball/doc.go\n30\tnew file mode 100644\n31\tindex 0000000..890d496\n32\t--- /dev/null\n33\t+++ b/internal/tarball/doc.go\n34\t@@ -0,0 +1,23 @@\n35\t+// Package tarball packs directory trees into gzip-compressed tar streams and\n36\t+// unpacks them safely. It is a leaf package (standard library only).\n37\t+//\n38\t+// Threat model:\n39\t+//   - Nothing in an archive is trusted; the unpack side runs as the\n40\t+//     controller's uid and the archive comes from an agent's pod.\n41\t+//   - Every write goes through os.Root, so an escape fails even if a check\n42\t+//     here has a gap; explicit checks refuse hostile entries before that.\n43\t+//   - Only directories, regular files and symlinks are unpacked. Modes are\n44\t+//     normalised (no setuid, setgid or sticky bits), and sizes, counts, depth\n45\t+//     and compression ratio are capped by [Limits].\n46\t+//   - Symlink targets are not validated: they are never followed, and every\n47\t+//     reader of an unpacked tree must use Lstat or os.Root.\n48\t+//   - Pack stores symlinks as links and never reads through them.\n49\t+package tarball\n50\t+\n51\t+import \"errors\"\n52\t+\n53\t+// ErrUnsafe classifies an entry the unpacker refuses as hostile or unsupported.\n54\t+var ErrUnsafe = errors.New(\"tarball: unsafe entry\")\n55\t+\n56\t+// ErrLimit classifies an archive that exceeds a configured limit.\n57\t+var ErrLimit = errors.New(\"tarball: limit exceeded\")\n58\tdiff --git a/internal/tarball/errors.go b/internal/tarball/errors.go\n59\tnew file mode 100644\n60\tindex 0000000..fa16601\n61\t--- /dev/null\n62\t+++ b/internal/tarball/errors.go\n63\t@@ -0,0 +1,29 @@\n64\t+package tarball\n65\t+\n66\t+const maxEntryLen = 200\n67\t+\n68\t+// Error describes why an archive entry was refused. errors.Is(err, ErrUnsafe)\n69\t+// or errors.Is(err, ErrLimit) classifies it. Why is fixed text and Entry is\n70\t+// the cleaned entry name, truncated.\n71\t+type Error struct {\n72\t+\tEntry string\n73\t+\tWhy   string\n74\t+\tkind  error\n75\t+}\n76\t+\n77\t+func newError(kind error, entry, why string) *Error {\n78\t+\tif len(entry) > maxEntryLen {\n79\t+\t\tentry = entry[:maxEntryLen]\n80\t+\t}\n81\t+\treturn &Error{Entry: entry, Why: why, kind: kind}\n82\t+}\n83\t+\n84\t+func (e *Error) Error() string {\n85\t+\tif e.Entry == \"\" {\n86\t+\t\treturn \"tarball: \" + e.Why\n87\t+\t}\n88\t+\treturn \"tarball: \" + e.Why + \": \" + e.Entry\n89\t+}\n90\t+\n91\t+// Is reports whether target is the error's class (ErrUnsafe or ErrLimit).\n92\t+func (e *Error) Is(target error) bool { return e.kind != nil && target == e.kind }\n93\tdiff --git a/internal/tarball/pack.go b/internal/tarball/pack.go\n94\tnew file mode 100644\n95\tindex 0000000..5d6906d\n96\t--- /dev/null\n97\t+++ b/internal/tarball/pack.go\n98\t@@ -0,0 +1,192 @@\n99\t+package tarball\n100\t+\n101\t+import (\n102\t+\t\"archive/tar\"\n103\t+\t\"compress/gzip\"\n104\t+\t\"errors\"\n105\t+\t\"fmt\"\n106\t+\t\"io\"\n107\t+\t\"io/fs\"\n108\t+\t\"os\"\n109\t+\t\"path/filepath\"\n110\t+\t\"strings\"\n111\t+\t\"time\"\n112\t+)\n113\t+\n114\t+// Root is one tree to pack. Name is the archive's top-level directory (one\n115\t+// path segment) and Dir the absolute directory on disk. When Files is\n116\t+// non-empty only those regular files directly under Dir are packed; a listed\n117\t+// file that does not exist is left out.\n118\t+type Root struct {\n119\t+\tName  string\n120\t+\tDir   string\n121\t+\tFiles []string\n122\t+}\n123\t+\n124\t+// PackStats reports what Pack wrote. Skipped counts sockets, FIFOs and\n125\t+// devices that were left out.\n126\t+type PackStats struct {\n127\t+\tEntries int\n128\t+\tBytes   int64\n129\t+\tSkipped int\n130\t+}\n131\t+\n132\t+func validSegment(s string) bool {\n133\t+\treturn s != \"\" && s != \".\" && s != \"..\" && !strings.ContainsAny(s, \"/\\\\\\x00\") && !strings.EqualFold(s, \".git\")\n134\t+}\n135\t+\n136\t+func hasGit(rel string) bool {\n137\t+\tfor _, p := range strings.Split(filepath.ToSlash(rel), \"/\") {\n138\t+\t\tif strings.EqualFold(p, \".git\") {\n139\t+\t\t\treturn true\n140\t+\t\t}\n141\t+\t}\n142\t+\treturn false\n143\t+}\n144\t+\n145\t+func tarMode(m fs.FileMode) int64 {\n146\t+\tif m.IsDir() || m&0o111 != 0 {\n147\t+\t\treturn 0o755\n148\t+\t}\n149\t+\treturn 0o644\n150\t+}\n151\t+\n152\t+// Pack writes the roots as a gzip-compressed tar stream. Symlinks are stored\n153\t+// as links and never followed, entries with a .git path component are left\n154\t+// out, and special files are skipped and counted. The output is deterministic.\n155\t+func Pack(w io.Writer, roots []Root) (PackStats, error) {\n156\t+\tvar st PackStats\n157\t+\tfor _, r := range roots {\n158\t+\t\tif !validSegment(r.Name) {\n159\t+\t\t\treturn st, fmt.Errorf(\"tarball: invalid root name %q\", r.Name)\n160\t+\t\t}\n161\t+\t\tfor _, f := range r.Files {\n162\t+\t\t\tif !validSegment(f) {\n163\t+\t\t\t\treturn st, fmt.Errorf(\"tarball: invalid file name %q\", f)\n164\t+\t\t\t}\n165\t+\t\t}\n166\t+\t}\n167\t+\tgz := gzip.NewWriter(w)\n168\t+\ttw := tar.NewWriter(gz)\n169\t+\tfor _, r := range roots {\n170\t+\t\tif err := packRoot(tw, r, &st); err != nil {\n171\t+\t\t\treturn st, err\n172\t+\t\t}\n173\t+\t}\n174\t+\tif err := tw.Close(); err != nil {\n175\t+\t\treturn st, err\n176\t+\t}\n177\t+\tif err := gz.Close(); err != nil {\n178\t+\t\treturn st, err\n179\t+\t}\n180\t+\treturn st, nil\n181\t+}\n182\t+\n183\t+func packRoot(tw *tar.Writer, r Root, st *PackStats) error {\n184\t+\tinfo, err := os.Lstat(r.Dir)\n185\t+\tif err != nil {\n186\t+\t\treturn err\n187\t+\t}\n188\t+\tif !info.IsDir() {\n189\t+\t\treturn fmt.Errorf(\"tarball: root %q: not a directory\", r.Name)\n190\t+\t}\n191\t+\tif err := tw.WriteHeader(&tar.Header{Typeflag: tar.TypeDir, Name: r.Name + \"/\", Mode: 0o755, Format: tar.FormatPAX}); err != nil {\n192\t+\t\treturn err\n193\t+\t}\n194\t+\tst.Entries++\n195\t+\tif len(r.Files) > 0 {\n196\t+\t\tfor _, f := range r.Files {\n197\t+\t\t\tfi, err := os.Lstat(filepath.Join(r.Dir, f))\n198\t+\t\t\tif errors.Is(err, fs.ErrNotExist) {\n199\t+\t\t\t\tcontinue\n200\t+\t\t\t}\n201\t+\t\t\tif err != nil {\n202\t+\t\t\t\treturn err\n203\t+\t\t\t}\n204\t+\t\t\tif err := packEntry(tw, filepath.Join(r.Dir, f), r.Name+\"/\"+f, fi, st); err != nil {\n205\t+\t\t\t\treturn err\n206\t+\t\t\t}\n207\t+\t\t}\n208\t+\t\treturn nil\n209\t+\t}\n210\t+\treturn filepath.WalkDir(r.Dir, func(p string, d fs.DirEntry, err error) error {\n211\t+\t\tif err != nil {\n212\t+\t\t\treturn err\n213\t+\t\t}\n214\t+\t\trel, err := filepath.Rel(r.Dir, p)\n215\t+\t\tif err != nil {\n216\t+\t\t\treturn err\n217\t+\t\t}\n218\t+\t\tif rel == \".\" {\n219\t+\t\t\treturn nil\n220\t+\t\t}\n221\t+\t\tif hasGit(rel) {\n222\t+\t\t\tif d.IsDir() {\n223\t+\t\t\t\treturn filepath.SkipDir\n224\t+\t\t\t}\n225\t+\t\t\treturn nil\n226\t+\t\t}\n227\t+\t\tfi, err := d.Info()\n228\t+\t\tif err != nil {\n229\t+\t\t\treturn err\n230\t+\t\t}\n231\t+\t\treturn packEntry(tw, p, r.Name+\"/\"+filepath.ToSlash(rel), fi, st)\n232\t+\t})\n233\t+}\n234\t+\n235\t+func packEntry(tw *tar.Writer, path, name string, fi fs.FileInfo, st *PackStats) error {\n236\t+\th := &tar.Header{Name: name, Mode: tarMode(fi.Mode()), ModTime: time.Time{}, Format: tar.FormatPAX}\n237\t+\tswitch {\n238\t+\tcase fi.IsDir():\n239\t+\t\th.Typeflag = tar.TypeDir\n240\t+\t\th.Name += \"/\"\n241\t+\tcase fi.Mode()&fs.ModeSymlink != 0:\n242\t+\t\ttarget, err := os.Readlink(path)\n243\t+\t\tif err != nil {\n244\t+\t\t\treturn err\n245\t+\t\t}\n246\t+\t\th.Typeflag = tar.TypeSymlink\n247\t+\t\th.Linkname = target\n248\t+\t\th.Mode = 0o777\n249\t+\tcase fi.Mode().IsRegular():\n250\t+\t\treturn packFile(tw, path, h, fi, st)\n251\t+\tdefault:\n252\t+\t\tst.Skipped++\n253\t+\t\treturn nil\n254\t+\t}\n255\t+\tif err := tw.WriteHeader(h); err != nil {\n256\t+\t\treturn err\n257\t+\t}\n258\t+\tst.Entries++\n259\t+\treturn nil\n260\t+}\n261\t+\n262\t+func packFile(tw *tar.Writer, path string, h *tar.Header, fi fs.FileInfo, st *PackStats) error {\n263\t+\tf, err := os.Open(path)\n264\t+\tif err != nil {\n265\t+\t\treturn err\n266\t+\t}\n267\t+\tdefer f.Close()\n268\t+\tif cur, err := f.Stat(); err != nil || !cur.Mode().IsRegular() {\n269\t+\t\treturn fmt.Errorf(\"tarball: %s changed while packing\", h.Name)\n270\t+\t}\n271\t+\th.Typeflag = tar.TypeReg\n272\t+\th.Size = fi.Size()\n273\t+\tif err := tw.WriteHeader(h); err != nil {\n274\t+\t\treturn err\n275\t+\t}\n276\t+\tn, err := io.Copy(tw, io.LimitReader(f, h.Size))\n277\t+\tif err != nil {\n278\t+\t\treturn err\n279\t+\t}\n280\t+\tif n != h.Size {\n281\t+\t\treturn fmt.Errorf(\"tarball: %s changed size while packing\", h.Name)\n282\t+\t}\n283\t+\tvar extra [1]byte\n284\t+\tif m, _ := f.Read(extra[:]); m > 0 {\n285\t+\t\treturn fmt.Errorf(\"tarball: %s changed size while packing\", h.Name)\n286\t+\t}\n287\t+\tst.Entries++\n288\t+\tst.Bytes += n\n289\t+\treturn nil\n290\t+}\n291\tdiff --git a/internal/tarball/pack_test.go b/internal/tarball/pack_test.go\n292\tnew file mode 100644\n293\tindex 0000000..c0e30b7\n294\t--- /dev/null\n295\t+++ b/internal/tarball/pack_test.go\n296\t@@ -0,0 +1,174 @@\n297\t+package tarball\n298\t+\n299\t+import (\n300\t+\t\"archive/tar\"\n301\t+\t\"bytes\"\n302\t+\t\"compress/gzip\"\n303\t+\t\"io\"\n304\t+\t\"io/fs\"\n305\t+\t\"os\"\n306\t+\t\"path/filepath\"\n307\t+\t\"runtime\"\n308\t+\t\"strings\"\n309\t+\t\"syscall\"\n310\t+\t\"testing\"\n311\t+)\n312\t+\n313\t+func write(t *testing.T, p, body string, mode os.FileMode) {\n314\t+\tt.Helper()\n315\t+\tif err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {\n316\t+\t\tt.Fatal(err)\n317\t+\t}\n318\t+\tif err := os.WriteFile(p, []byte(body), mode); err != nil {\n319\t+\t\tt.Fatal(err)\n320\t+\t}\n321\t+\tos.Chmod(p, mode)\n322\t+}\n323\t+\n324\t+func listTar(t *testing.T, dat