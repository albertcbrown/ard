\twant error\n865\t+\t}\n866\t+\treturn map[string]c{\n867\t+\t\t\"dotdot\":              {ents: []ent{{name: \"../x\", body: \"x\"}}, want: ErrUnsafe},\n868\t+\t\t\"absolute\":            {ents: []ent{{name: \"/abs\", body: \"x\"}}, want: ErrUnsafe},\n869\t+\t\t\"embedded dotdot\":     {ents: []ent{{name: \"a/../../x\", body: \"x\"}}, want: ErrUnsafe},\n870\t+\t\t\"dot segment\":         {ents: []ent{{name: \"a/./b\", body: \"x\"}}, want: ErrUnsafe},\n871\t+\t\t\"empty segment\":       {ents: []ent{{name: \"a//b\", body: \"x\"}}, want: ErrUnsafe},\n872\t+\t\t\"symlink then file\":   {ents: []ent{{name: \"a\", typ: tar.TypeSymlink, link: \"..\"}, {name: \"a/f\", body: \"x\"}}, want: ErrUnsafe},\n873\t+\t\t\"file then symlink\":   {ents: []ent{{name: \"a/f\", body: \"x\"}, {name: \"a\", typ: tar.TypeSymlink, link: \"..\"}}, want: ErrUnsafe},\n874\t+\t\t\"hardlink\":            {ents: []ent{{name: \"h\", typ: tar.TypeLink, link: \"/etc/passwd\"}}, want: ErrUnsafe},\n875\t+\t\t\"char device\":         {ents: []ent{{name: \"c\", typ: tar.TypeChar}}, want: ErrUnsafe},\n876\t+\t\t\"block device\":        {ents: []ent{{name: \"b\", typ: tar.TypeBlock}}, want: ErrUnsafe},\n877\t+\t\t\"fifo\":                {ents: []ent{{name: \"p\", typ: tar.TypeFifo}}, want: ErrUnsafe},\n878\t+\t\t\"duplicate\":           {ents: []ent{{name: \"f\", body: \"1\"}, {name: \"f\", body: \"2\"}}, want: ErrUnsafe},\n879\t+\t\t\"dir then file\":       {ents: []ent{{name: \"d/\", typ: tar.TypeDir}, {name: \"d\", body: \"x\"}}, want: ErrUnsafe},\n880\t+\t\t\"case collision\":      {ents: []ent{{name: \"README\", body: \"1\"}, {name: \"readme\", body: \"2\"}}, want: ErrUnsafe},\n881\t+\t\t\"git config\":          {ents: []ent{{name: \".git/config\", body: \"x\"}}, want: ErrUnsafe},\n882\t+\t\t\"nested git\":          {ents: []ent{{name: \"sub/.git\", body: \"x\"}}, want: ErrUnsafe},\n883\t+\t\t\"upper git\":           {ents: []ent{{name: \"x/.GIT\", body: \"x\"}}, want: ErrUnsafe},\n884\t+\t\t\"too many entries\":    {ents: []ent{{name: \"a\", body: \"\"}, {name: \"b\"}, {name: \"c\"}}, lim: func(l *Limits) { l.MaxEntries = 2 }, want: ErrLimit},\n885\t+\t\t\"file over limit\":     {ents: []ent{{name: \"f\", body: strings.Repeat(\"x\", 2000)}}, want: ErrLimit},\n886\t+\t\t\"total over limit\":    {ents: []ent{{name: \"f\", body: strings.Repeat(\"x\", 900)}, {name: \"g\", body: strings.Repeat(\"y\", 900)}}, lim: func(l *Limits) { l.MaxBytes = 2048 }, want: ErrLimit},\n887\t+\t\t\"compressed over\":     {ents: []ent{{name: \"f\", body: \"x\"}}, lim: func(l *Limits) { l.MaxCompressed = 10 }, want: ErrLimit},\n888\t+\t\t\"path too long\":       {ents: []ent{{name: strings.Repeat(\"a\", 100), body: \"x\"}}, want: ErrLimit},\n889\t+\t\t\"too deep\":            {ents: []ent{{name: \"a/b/c/d/e/f\", body: \"x\"}}, want: ErrLimit},\n890\t+\t\t\"symlink dir overlap\": {ents: []ent{{name: \"a/b/c\", body: \"x\"}, {name: \"a/b\", typ: tar.TypeSymlink, link: \"/\"}}, want: ErrUnsafe},\n891\t+\t}\n892\t+}\n893\t+\n894\t+func TestUnpackRejects(t *testing.T) {\n895\t+\tfor name, c := range rejectCases() {\n896\t+\t\tt.Run(name, func(t *testing.T) {\n897\t+\t\t\tparent, dest, _ := setup(t)\n898\t+\t\t\tl := smallLimits()\n899\t+\t\t\tif c.lim != nil {\n900\t+\t\t\t\tc.lim(&l)\n901\t+\t\t\t}\n902\t+\t\t\t_, err := Unpack(bytes.NewReader(buildTar(t, c.ents)), dest, l)\n903\t+\t\t\tif !errors.Is(err, c.want) {\n904\t+\t\t\t\tt.Fatalf(\"err = %v, want %v\", err, c.want)\n905\t+\t\t\t}\n906\t+\t\t\tcheckContained(t, parent)\n907\t+\t\t})\n908\t+\t}\n909\t+}\n910\t+\n911\t+func TestCleanNameNUL(t *testing.T) {\n912\t+\t// archive/tar cuts ustar names at a NUL, so this guards the PAX path.\n913\t+\tif _, err := cleanName(\"a\\x00b\", smallLimits()); !errors.Is(err, ErrUnsafe) {\n914\t+\t\tt.Fatalf(\"err = %v, want ErrUnsafe\", err)\n915\t+\t}\n916\t+}\n917\t+\n918\t+func TestUnpackGzipBomb(t *testing.T) {\n919\t+\tparent, dest, _ := setup(t)\n920\t+\tl := DefaultLimits()\n921\t+\tl.Max