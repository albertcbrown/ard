es.Split(v, []byte(\".\")) {\n\t\tif len(seg) > 24 {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\n// numeric reports whether v is non-empty and all ASCII digits.\nfunc numeric(v []byte) bool {\n\tif len(v) == 0 {\n\t\treturn false\n\t}\n\tfor _, c := range v {\n\t\tif c < '0' || c > '9' {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\ndoc.go\nentropy.go\ngitleaks.go\ngitleaks_integration_test.go\ngitleaks_test.go\nhelpers_test.go\nhostpath.go\nhostpath_test.go\nmulti.go\npath.go\npath_test.go\nrace_off_test.go\nrace_on_test.go\nredact.go\nredact_test.go\nreplace.go\nrules.go\nscan.go\nscan_test.go\nsecrets.go\nsecrets_test.go\ntruncate.go\ntruncate_test.go\ninternal/redact/gitleaks_integration_test.go:16:func TestGitleaksReal(t *testing.T) {\ninternal/redact/gitleaks_test.go:44:func TestGitleaksHit(t *testing.T) {\ninternal/redact/gitleaks_test.go:56:func TestGitleaksClean(t *testing.T) {\ninternal/redact/gitleaks_test.go:64:func TestGitleaksMissingBinary(t *testing.T) {\ninternal/redact/gitleaks_test.go:71:func TestGitleaksErrorExit(t *testing.T) {\ninternal/redact/gitleaks_test.go:82:func TestGitleaksBadReport(t *testing.T) {\ninternal/redact/gitleaks_test.go:99:func TestGitleaksTimeoutAndCancel(t *testing.T) {\ninternal/redact/gitleaks_test.go:119:func TestGitleaksTimeoutChildHoldsPipe(t *testing.T) {\ninternal/redact/gitleaks_test.go:131:func TestGitleaksArgs(t *testing.T) {\ninternal/redact/gitleaks_test.go:160:func TestMulti(t *testing.T) {\ninternal/redact/gitleaks_test.go:177:func TestLogWithGitleaks(t *testing.T) {\ninternal/redact/helpers_test.go:34:\t\t\"generic-assignment\":  \"api_\" + \"key = \" + randStr(13, 32),\ninternal/redact/hostpath_test.go:22:func TestWithPathsValidation(t *testing.T) {\ninternal/redact/hostpath_test.go:65:func TestPathBoundary(t *testing.T) {\ninternal/redact/hostpath_test.go:91:func TestPathLongestFirst(t *testing.T) {\ninternal/redact/hostpath_test.go:114:func TestPathEscapedForms(t *testing.T) {\ninternal/redact