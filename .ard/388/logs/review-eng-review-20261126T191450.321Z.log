se environment variable\n38\t+// name: at least one underscore, no lower case, none of + / = . and at most 64\n39\t+// bytes.\n40\t+func envName(v []byte) bool {\n41\t+\treturn len(v) <= 64 && envNameRE.Match(v)\n42\t }\n43\t \n44\t var codeRefRE = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$`)\n45\tdiff --git a/internal/redact/scan_test.go b/internal/redact/scan_test.go\n46\tindex 490c9d9..872aa5a 100644\n47\t--- a/internal/redact/scan_test.go\n48\t+++ b/internal/redact/scan_test.go\n49\t@@ -111,6 +111,9 @@ func TestScannerGenericAssignmentFalsePositives(t *testing.T) {\n50\t \t\t\"TotalTokens: usage.TotalTokens,\",\n51\t \t\t`\"cache_read_input_tokens\": 1106888`,\n52\t \t\t`\"tokens\": 11068881106888123`,\n53\t+\t\t\"EnvAPI\" + \"Key = \\\"ANTHROPIC_\" + \"API_KEY\\\"\",\n54\t+\t\t\"token: CLAUDE_CODE_\" + \"OAUTH_TOKEN\",\n55\t+\t\t\"SECRET_NAME = \\\"GITHUB_APP_\" + \"PRIVATE_KEY\\\"\",\n56\t \t} {\n57\t \t\tif f := scanString(t, in); len(f) != 0 {\n58\t \t\t\tt.Errorf(\"%q: unexpected findings %v\", in, f)\n59\t@@ -191,3 +194,57 @@ func TestScannerAWSExample(t *testing.T) {\n60\t \t\t})\n61\t \t}\n62\t }\n63\t+\n64\t+// upperSnake returns a high-entropy upper-case string of n bytes with an\n65\t+// underscore after every seventh byte, starting with a letter.\n66\t+func upperSnake(seed uint64, n int) string {\n67\t+\tb := []byte(\"K\" + strings.ToUpper(randStr(seed, n-1)))\n68\t+\tfor i := 7; i < n-1; i += 8 {\n69\t+\t\tb[i] = '_'\n70\t+\t}\n71\t+\treturn string(b)\n72\t+}\n73\t+\n74\t+func TestScannerGenericAssignmentEnvNameBoundaries(t *testing.T) {\n75\t+\tlong := upperSnake(31, 64)\n76\t+\ttooLong := upperSnake(32, 65)\n77\t+\tnoUnderscore := strings.ReplaceAll(upperSnake(33, 32), \"_\", \"A\")\n78\t+\tmixed := upperSnake(34, 40)\n79\t+\tmixed = strings.ToLower(mixed[:10]) + mixed[10:]\n80\t+\tlower := strings.ToLower(upperSnake(35, 40))\n81\t+\tsnake := upperSnake(36, 40)\n82\t+\tfor _, tc := range []struct {\n83\t+\t\tname  str