\tdone <- err\n\t\t\tp.Send(tea.Quit())\n\t\tcase <-stopped:\n\t\t}\n\t}()\n\t_, uiErr := p.Run()\n\tclose(stopped)\n\tcancel()\n\terr := <-done\n\tif err == nil && uiErr != nil && ctx.Err() == nil {\n\t\terr = fmt.Errorf(\"ard serve: ui: %w\", uiErr)\n\t}\n\treturn err\n}\n","numLines":58,"startLine":1,"totalLines":58}},"tool_result_meta":[{"id":"toolu_01J7FgBzumMBdKPgRtTCLbgj","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
