{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QTzt3wj5zzRXf7DPFU5rQe","type":"tool_result","content":"140\t// returns ctx.Err() when the context ends first.\n141\tfunc (c *core) transientWait(ctx context.Context, branch string, n int, cause error) error {\n142\t\tc.log.InfoContext(ctx, \"committer.retry\", \"branch\", branch, \"reason\", \"transient\", \"retry\", n, \"err\", cause.Error())\n143\t\tt := time.NewTimer(c.transientBackoff(n))\n144\t\tdefer t.Stop()\n145\t\tselect {\n146\t\tcase <-t.C:\n147\t\t\treturn nil\n148\t\tcase <-ctx.Done():\n149\t\t\treturn ctx.Err()\n150\t\t}\n151\t}\n152\t\n153\t// exhausted wraps the last transient cause so callers can match ErrTransient.\n154\tfunc exhausted(cause error) error { return fmt.Errorf(\"%w: %w\", ErrTransient, cause) }\n155\t\n156\t// pushNew pushes a commit that creates branch (the lease expects it absent),\n157\t// retrying transient failures. The push may have landed before the failure,\n158\t// so each retry first fetches the branch: at (or past) sha it is a success;\n159\t// at another commit it is exists.\n160\tfunc (c *core) pushNew(ctx context.Context, branch, sha string, exists error, push func() error) error {\n161\t\tfor n := 1; ; n++ {\n162\t\t\terr := push()\n163\t\t\tswitch {\n164\t\t\tcase err == nil:\n165\t\t\t\treturn nil\n166\t\t\tcase errors.Is(err, effects.ErrNonFastForward), errors.Is(err, effects.ErrStaleLease):\n167\t\t\t\treturn fmt.Errorf(\"%w: %v\", exists, err)\n168\t\t\tcase !errors.Is(err, effects.ErrTransient):\n169\t\t\t\treturn err\n170\t\t\tcase n > maxTransient:\n171\t\t\t\treturn exhausted(err)\n172\t\t\t}\n173\t\t\tif werr := c.transientWait(ctx, branch, n, err); werr != nil {\n174\t\t\t\treturn werr\n175\t\t\t}\n176\t\t\tspec := \"+refs/heads/\" + branch + \":\" + upstreamRef(branch)\n177\t\t\tswitch ferr := c.g.FetchRef(ctx, c.cfg.RepoDir, c.cfg.RemoteURL, spec, c.cfg.Token); {\n178\t\t\tcase ferr == nil:\n179\t\t\t\ttip, rerr := c.g.RevParse(ctx, c.cfg.RepoDir, upstreamRef(branch))\n180\t\t\t\tif rerr != nil {\n181\t\t\t\t\treturn rerr\n182\t\t\t\t}\n183\t\t\t\tif ok, aerr := c.g.IsAncestor(ctx, c.cfg.RepoDir, sha, tip); aerr == nil && ok {\n184\t\t\t\t\treturn nil\n185\t\t\t\t}\n186\t\t\t\treturn fmt.Errorf(\"%w: %v\", exists, err)\n187\t\t\tcase errors.Is(ferr, gitx.ErrRefNotFound), errors.Is(ferr, effects.ErrTransient):\n188\t\t\t\t// Not landed, or unknown: push again.\n189\t\t\tdefault:\n190\t\t\t\treturn ferr\n191\t\t\t}\n192\t\t}\n193\t}\n194\t\n195\tfunc upstreamRef(branch string) string { return \"refs/ard/upstream/\" + branch }\n196\t\n197\t// lane serialises requests for one branch.\n198\ttype lane struct {\n199\t\t*core\n200\t\tbranch     string\n201\t\twt         string\n202\t\tpersistent bool // main: worktree lives as long as the lane\n203\t\tsem        chan struct{}\n204\t\tmu         sync.Mutex\n205\t\tclosed     bool\n206\t}\n207\t\n208\tfunc newLane(c *core, branch, wt string, persistent bool) *lane {\n209\t\treturn &lane{core: c, branch: branch, wt: wt, persistent: persistent, sem: make(chan struct{}, 1)}\n210\t}\n211\t\n212\tfunc (l *lane) isClosed() bool {\n213\t\tl.mu.Lock()\n214\t\tdefer l.mu.Unlock()\n215\t\treturn l.closed\n216\t}\n217\t\n218\t// commit validates, waits for the lane and runs the pipeline.\n219\tfunc (l *lane) commit(ctx context.Context, req Request) (res Result, err error) {\n220\t\tif l.isClosed() {\n221\t\t\treturn Result{}, ErrClosed\n222\t\t}\n223\t\tissue := req.Issue\n224\t\tdry := l.fx.DryRun()\n225\t\tswitch {\n226\t\tcase issue < 0 && dry:\n227\t\t\tissue = -issue\n228\t\tcase issue <= 0:\n229\t\t\treturn Result{}, fmt.Errorf(\"commit issue %d: %w: issue must be positive\", req.Issue, &GuardError{Paths: []string{\"\"}, Reasons: []string{\"non-positive issue\"}})\n230\t\t}\n231\t\tsnap, err := snapshot(req, issue)\n232\t\tif err != nil {\n233\t\t\treturn Result{}, fmt.Errorf(\"commit issue %d (%s:%s): %w\", req.Issue, req.Stage, req.Role, err)\n234\t\t}\n235\t\tmsg, err := Message(req.Stage, req.Role, issue, req.Summary, req.JobID, l.skipCI)\n236\t\tif err != nil {\n237\t\t\treturn Result{}, fmt.Errorf(\"commit issue %d (%s:%s): %w\", req.Issue, req.Stage, req.Role, err)\n238\t\t}\n239\t\tstart := time.Now()\n240\t\tdefer func() {\n241\t\t\tattrs := []any{\"issue\", req.Issue, \"stage\", req.Stage, \"role\", req.Role, \"branch\", l.branch, \"job\", req.JobID,\n242\t\t\t\t\"files\", len(snap.Files), \"duration\", time.Since(start).String()}\n243\t\t\tif err != nil {\n244\t\t\t\tl.log.WarnContext(ctx, \"committer.failed\", append(attrs, \"err\", err.Error())...)\n245\t\t\t\treturn\n246\t\t\t}\n247\t\t\tl.log.InfoContext(ctx, \"committer.commit\", append(attrs, \"sha\", res.SHA, \"noop\", res.NoOp, \"synthetic\", res.Synthetic, \"attempts\", res.Attempts)...)\n248\t\t}()\n249\t\tif req.Issue < 0 { // synthetic issue: validated, nothing touches git\n250\t\t\treturn Result{SHA: strings.Repeat(\"0\", 40), Synthetic: true}, nil\n251\t\t}\n252\t\n253\t\tselect {\n254\t\tcase l.sem <- struct{}{}:\n255\t\tcase <-ctx.Done():\n256\t\t\treturn Result{}, fmt.Errorf(\"commit issue %d: %w\", req.Issue, ctx.Err())\n257\t\t}\n258\t\tdefer func() { <-l.sem }()\n259\t\tif l.isClosed() {\n260\t\t\treturn Result{}, ErrClosed\n261\t\t}\n262\t\tres, err = l.run(ctx, snapOf(snap, msg))\n263\t\tif err != nil {\n264\t\t\terr = fmt.Errorf(\"commit issue %d (%s:%s): %w\", req.Issue, req.Stage, req.Role, err)\n265\t\t}\n266\t\treturn res, err\n267\t}\n268\t\n269\t// snapFile is one validated change, ready to apply.\n270\ttype snapFile struct {\n271\t\tpath string\n272\t\tdata []byte\n273\t\texec bool\n274\t\tdel  bool\n275\t\t// merge, when set, rewrites data against the contents at the head.\n276\t\tmerge func(cur []byte, exists bool, mine []byte) ([]byte, error)\n277\t}\n278\t\n279\t// snap is a validated request in the form the lane applies, whichever lane\n280\t// (.ard or worker code) produced it.\n281\ttype snap struct {\n282\t\tfiles    []snapFile\n283\t\tdeclared []string\n284\t\tmsg      string\n285\t\t// base, when set, is the commit the caller's content was derived from:\n286\t\t// the first attempt refuses to overwrite a declared path that changed\n287\t\t// between base and the fetched head.\n288\t\tbase string\n289\t}\n290\t\n291\tfunc (s snap) wantMode(path string) string {\n292\t\tfor _, f := range s.files {\n293\t\t\tif f.path == path {\n294\t\t\t\tif f.del {\n295\t\t\t\t\treturn \"000000\"\n296\t\t\t\t}\n297\t\t\t\treturn modeOf(f.exec)\n298\t\t\t}\n299\t\t}\n300\t\treturn \"\"\n301\t}\n302\t\n303\t// snapOf converts a validated .ard Request. Its files are never executable.\n304\tfunc snapOf(req Request, msg string) snap {\n305\t\ts := snap{msg: msg, declared: make([]string, len(req.Files))}\n306\t\tfor i, f := range req.Files {\n307\t\t\ts.declared[i] = f.Path\n308\t\t\ts.files = append(s.files, snapFile{path: f.Path, data: f.Data, del: f.Delete, merge: f.Merge})\n309\t\t}\n310\t\treturn s\n311\t}\n312\t\n313\tfunc (l *lane) run(ctx context.Context, s snap) (Result, error) {\n314\t\tif !l.persistent {\n315\t\t\tif err := l.addWorktree(ctx); err != nil {\n316\t\t\t\treturn Result{}, err\n317\t\t\t}\n318\t\t\tdefer func() { _ = l.g.WorktreeRemove(context.WithoutCancel(ctx), l.cfg.RepoDir, l.wt) }()\n319\t\t}\n320\t\tdeclared := s.declared\n321\t\n322\t\tvar base, prev, pending string\n323\t\trejections, transients := 0, 0\n324\t\tfor attempt := 1; ; attempt++ {\n325\t\t\tvar err error\n326\t\t\tif base, err = l.fetch(ctx); err != nil {\n327\t\t\t\tl.reset(ctx, prev)\n328\t\t\t\tif errors.Is(err, effects.ErrTransient) {\n329\t\t\t\t\tif transients >= maxTransient {\n330\t\t\t\t\t\treturn Result{Attempts: attempt - 1}, exhausted(err)\n331\t\t\t\t\t}\n332\t\t\t\t\ttransients++\n333\t\t\t\t\tif werr := l.transientWait(ctx, l.branch, transients, err); werr != nil {\n334\t\t\t\t\t\treturn Result{Attempts: attempt - 1}, werr\n335\t\t\t\t\t}\n336\t\t\t\t\tattempt--\n337\t\t\t\t\tcontinue\n338\t\t\t\t}\n339\t\t\t\treturn Result{Attempts: attempt - 1}, err\n340\t\t\t}\n341\t\t\tif pending != \"\" {\n342\t\t\t\t// An earlier push failed transiently and may have landed.\n343\t\t\t\tif ok, aerr := l.g.IsAncestor(ctx, l.cfg.RepoDir, pending, base); aerr == nil && ok {\n344\t\t\t\t\tl.reset(ctx, base)\n345\t\t\t\t\treturn Result{SHA: pending, Attempts: attempt - 1}, nil\n346\t\t\t\t}\n347\t\t\t\tpending = \"\"\n348\t\t\t}\n349\t\t\tfrom := prev\n350\t\t\tif attempt == 1 {\n351\t\t\t\tfrom = s.base\n352\t\t\t}\n353\t\t\tif from != \"\" {\n354\t\t\t\tchanged, err := l.g.ChangedPaths(ctx, l.wt, from, base, declared...)\n355\t\t\t\tif err != nil {\n356\t\t\t\t\tl.reset(ctx, base)\n357\t\t\t\t\treturn Result{Attempts: attempt - 1}, err\n358\t\t\t\t}\n359\t\t\t\tif len(changed) > 0 {\n360\t\t\t\t\tl.reset(ctx, base)\n361\t\t\t\t\treturn Result{Attempts: attempt - 1}, fmt.Errorf(\"%w: %s\", ErrConflict, strings.Join(changed, \", \"))\n362\t\t\t\t}\n363\t\t\t}\n364\t\t\tres, retry, err := l.attempt(ctx, s, base, false)\n365\t\t\tres.Attempts = attempt\n366\t\t\tif err == nil {\n367\t\t\t\tif res.NoOp || res.Synthetic {\n368\t\t\t\t\tl.reset(ctx, base)\n369\t\t\t\t}\n370\t\t\t\treturn res, nil\n371\t\t\t}\n372\t\t\tl.reset(ctx, base)\n373\t\t\tif errors.Is(err, effects.ErrTransient) {\n374\t\t\t\tif transients >= maxTransient {\n375\t\t\t\t\treturn res, exhausted(err)\n376\t\t\t\t}\n377\t\t\t\ttransients++\n378\t\t\t\tpending, prev = res.pushed, base\n379\t\t\t\tif werr := l.transientWait(ctx, l.branch, transients, err); werr != nil {\n380\t\t\t\t\treturn res, werr\n381\t\t\t\t}\n382\t\t\t\tcontinue\n383\t\t\t}\n384\t\t\trejections++\n385\t\t\tif !retry || rejections >= maxPushes {\n386\t\t\t\treturn res, err\n387\t\t\t}\n388\t\t\tl.log.DebugContext(ctx, \"committer.retry\", \"branch\", l.branch, \"attempt\", attempt, \"err\", err.Error())\n389\t\t\tprev = base\n390\t\t\tselect {\n391\t\t\tcase <-time.After(l.backoff(rejections)):\n392\t\t\tcase <-ctx.Done():\n393\t\t\t\treturn res, ctx.Err()\n394\t\t\t}\n395\t\t}\n396\t}\n397\t\n398\t// attempt applies the snapshot on base, commits and pushes. retry reports\n399\t// whether a failure is worth another fetch-and-apply round. With create, base\n400\t// is the commit a new branch is cut from: nothing staged is ErrInvalid (a\n401\t// branch with no commit cannot become a PR) and the push's lease expects the\n402\t// ref to be absent, so a branch that exists is ErrBranchExists, never retried.\n403\tfunc (l *lane) attempt(ctx context.Context, s snap, base string, create bool) (res Result, retry bool, err error) {\n404\t\tif err := l.g.ResetHard(ctx, l.wt, base); err != nil {\n405\t\t\treturn res, false, err\n406\t\t}\n407\t\tif err := l.g.CleanAll(ctx, l.wt); err != nil {\n408\t\t\treturn res, false, err\n409\t\t}\n410\t\tdeclared, msg := s.declared, s.msg\n411\t\tvar writes, deletes, execs []string\n412\t\tfor _, f := range s.files {\n413\t\t\tfull := filepath.Join(l.wt, filepath.FromSlash(f.path))\n414\t\t\t// Defence in depth behind CheckCodePath/CheckPath: never touch a\n415\t\t\t// path that resolves outside the worktree.\n416\t\t\tif rel, err := filepath.Rel(l.wt, full); err != nil || rel == \"..\" || strings.HasPrefix(rel, \"../\") {\n417\t\t\t\tge := &GuardError{}\n418\t\t\t\tge.add(f.path, \"escapes the worktree\")\n419\t\t\t\treturn res, false, ge\n420\t\t\t}\n421\t\t\tif err := checkParents(l.wt, f.path); err != nil {\n422\t\t\t\treturn res, false, err\n423\t\t\t}\n424\t\t\tif f.del {\n425\t\t\t\tif err := os.Remove(full); err != nil && !errors.Is(err, os.ErrNotExist) {\n426\t\t\t\t\treturn res, false, fmt.Errorf(\"remove %s: %w\", f.path, err)\n427\t\t\t\t}\n428\t\t\t\tdeletes = append(deletes, f.path)\n429\t\t\t\tcontinue\n430\t\t\t}\n431\t\t\tif err := os.MkdirAll(filepath.Dir(full), 0o755); err != nil {\n432\t\t\t\treturn res, false, fmt.Errorf(\"mkdir for %s: %w\", f.path, err)\n433\t\t\t}\n434\t\t\tdata := f.data\n435\t\t\tif f.merge != nil {\n436\t\t\t\tcur, rerr := os.ReadFile(full)\n437\t\t\t\tif rerr != nil && !errors.Is(rerr, os.ErrNotExist) {\n438\t\t\t\t\treturn res, false, fmt.Errorf(\"read %s: %w\", f.path, rerr)\n439\t\t\t\t}\n440\t\t\t\tmerged, merr := f.merge(cur, rerr == nil, f.data)\n441\t\t\t\tif merr != nil {\n442\t\t\t\t\treturn res, false, fmt.Errorf(\"%w: %s: %v\", ErrMerge, f.path, merr)\n443\t\t\t\t}\n444\t\t\t\tdata = merged\n445\t\t\t}\n446\t\t\tif err := os.WriteFile(full, data, 0o644); err != nil {\n447\t\t\t\treturn res, false, fmt.Errorf(\"write %s: %w\", f.path, err)\n448\t\t\t}\n449\t\t\t// WriteFile keeps the mode of an existing file, so set it explicitly.\n450\t\t\tif err := os.Chmod(full, fileMode(f.exec)); err != nil {\n451\t\t\t\treturn res, false, fmt.Errorf(\"chmod %s: %w\", f.path, err)\n452\t\t\t}\n453\t\t\twrites = append(writes, f.path)\n454\t\t\tif f.exec {\n455\t\t\t\texecs = append(execs, f.path)\n456\t\t\t}\n457\t\t}\n458\t\tif len(writes) > 0 {\n459\t\t\tif err := l.g.AddForce(ctx, l.wt, writes...); err != nil {\n460\t\t\t\treturn res, false, err\n461\t\t\t}\n462\t\t}\n463\t\tif len(deletes) > 0 {\n464\t\t\tif err := l.g.RmCached(ctx, l.wt, deletes...); err != nil {\n465\t\t\t\treturn res, false, err\n466\t\t\t}\n467\t\t}\n468\t\tif len(execs) > 0 {\n469\t\t\tif err := l.g.SetExec(ctx, l.wt, execs...); err != nil {\n470\t\t\t\treturn res, false, err\n471\t\t\t}\n472\t\t}\n473\t\tchanges, err := l.g.StagedChanges(ctx, l.wt)\n474\t\tif err != nil {\n475\t\t\treturn res, false, err\n476\t\t}\n477\t\tif err := CheckStaged(declared, changes); err != nil {\n478\t\t\treturn res, false, err\n479\t\t}\n480\t\tif err := checkModes(s, changes); err != nil {\n481\t\t\treturn res, false, err\n482\t\t}\n483\t\tnothing := func() (Result, bool, error) {\n484\t\t\tif create {\n485\t\t\t\treturn res, false, fmt.Errorf(\"%w: nothing to commit on a new branch\", ErrInvalid)\n486\t\t\t}\n487\t\t\treturn Result{SHA: base, NoOp: true}, false, nil\n488\t\t}\n489\t\tif len(changes) == 0 {\n490\t\t\treturn nothing()\n491\t\t}\n492\t\tcr, err := l.fx.Commit(ctx, effects.CommitOp{Dir: l.wt, Message: msg, Author: l.author})\n493\t\tif errors.Is(err, effects.ErrNothingToCommit) {\n494\t\t\treturn nothing()\n495\t\t}\n496\t\tif err != nil {\n497\t\t\treturn res, false, err\n498\t\t}\n499\t\tlease := base\n500\t\tif create {\n501\t\t\tlease = zeroSHA\n502\t\t}\n503\t\tpush := func() error {\n504\t\t\treturn l.fx.Push(ctx, effects.PushOp{Dir: l.wt, Remote: l.cfg.RemoteURL, Ref: \"HEAD:refs/heads/\" + l.branch,\n505\t\t\t\tForceWithLease: lease, Token: l.cfg.Token})\n506\t\t}\n507\t\tif create {\n508\t\t\tif err := l.pushNew(ctx, l.branch, cr.SHA, ErrBranchExists, push); err != nil {\n509\t\t\t\treturn res, false, err\n510\t\t\t}\n511\t\t\treturn Result{SHA: cr.SHA, Synthetic: cr.Synthetic}, false, nil\n512\t\t}\n513\t\tif err = push(); err != nil {\n514\t\t\tres.pushed = cr.SHA\n515\t\t\treturn res, errors.Is(err, effects.ErrNonFastForward) || errors.Is(err, effects.ErrStaleLease), err\n516\t\t}\n517\t\treturn Result{SHA: cr.SHA, Synthetic: cr.Synthetic}, false, nil\n518\t}\n519\t\n520\t// fetch updates the private upstream ref and returns its SHA.\n521\tfunc (l *lane) fetch(ctx context.Context) (string, error) {\n522\t\tspec := \"+refs/heads/\" + l.branch + \":\" + upstreamRef(l.branch)\n523\t\tif err := l.g.FetchRef(ctx, l.cfg.RepoDir, l.cfg.RemoteURL, spec, l.cfg.Token); err != nil {\n524\t\t\tif errors.Is(err, gitx.ErrRefNotFound) && !l.persistent {\n525\t\t\t\treturn \"\", fmt.Errorf(\"%w: %s\", ErrBranchGone, l.branch)\n526\t\t\t}\n527\t\t\treturn \"\", err\n528\t\t}\n529\t\treturn l.g.RevParse(ctx, l.cfg.RepoDir, upstreamRef(l.branch))\n530\t}\n531\t\n532\t// reset returns the worktree to base so the next request starts clean. It\n533\t// uses a fresh context because the request's may be cancelled.\n534\tfunc (l *lane) reset(ctx context.Context, base string) {\n535\t\tif base == \"\" {\n536\t\t\treturn\n537\t\t}\n538\t\trctx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 30*time.Second)\n539\t\tdefer cancel()"}]},"parent_tool_use_id":null,"session_id":"17b7a3de-5f21-40f0-b683-bd56dd09ed54","uuid":"391faecd-0f16-4ef0-9f34-d4b2587713d9","timestamp":"2026-11-25T15:35:30.944Z","tool_use_result":{"type":"text","file":{"filePath":"/work/internal/committer/committer.go","content":"// returns ctx.Err() when the context ends first.\nfunc (c *core) transientWait(ctx context.Context, branch string, n int, cause error) error {\n\tc.log.InfoContext(ctx, \"committer.retry\", \"branch\", branch, \"reason\", \"transient\", \"retry\", n, \"err\", cause.Error())\n\tt := time.NewTimer(c.transientBackoff(n))\n\tdefer t.Stop()\n\tselect {\n\tcase <-t.C:\n\t\treturn nil\n\tcase <-ctx.Done():\n\t\treturn ctx.Err()\n\t}\n}\n\n// exhausted wraps the last transient cause so callers can match ErrTransient.\nfunc exhausted(cause error) error { return fmt.Errorf(\"%w: %w\", ErrTransient, cause) }\n\n// pushNew pushes a commit that creates branch (the lease expects it absent),\n// retrying transient failures. The push may have landed before the failure,\n// so each retry first fetches the branch: at (or past) sha it is a success;\n// at another commit it is exists.\nfunc (c *core) pushNew(ctx context.Context, branch, sha string, exists error, push func() error) error {\n\tfor n := 1; ; n++ {\n\t\terr := push()\n\t\tswitch {\n\t\tcase err == nil:\n\t\t\treturn nil\n\t\tcase errors.Is(err, effects.ErrNonFastForward), errors.Is(err, effects.ErrStaleLease):\n\t\t\treturn fmt.Errorf(\"%w: %v\", exists, err)\n\t\tcase !errors.Is(err, effects.ErrTransient):\n\t\t\treturn err\n\t\tcase n > maxTransient:\n\t\t\treturn exhausted(err)\n\t\t}\n\t\tif werr := c.transientWait(ctx, branch, n, err); werr != nil {\n\t\t\treturn werr\n\t\t}\n\t\tspec := \"+refs/heads/\" + branch + \":\" + upstreamRef(branch)\n\t\tswitch ferr := c.g.FetchRef(ctx, c.cfg.RepoDir, c.cfg.RemoteURL, spec, c.cfg.Token); {\n\t\tcase ferr == nil:\n\t\t\ttip, rerr := c.g.RevParse(ctx, c.cfg.RepoDir, upstreamRef(branch))\n\t\t\tif rerr != nil {\n\t\t\t\treturn rerr\n\t\t\t}\n\t\t\tif ok, aerr := c.g.IsAncestor(ctx, c.cfg.RepoDir, sha, tip); aerr == nil && ok {\n\t\t\t\treturn nil\n\t\t\t}\n\t\t\treturn fmt.Errorf(\"%w: %v\", exists, err)\n\t\tcase errors.Is(ferr, gitx.ErrRefNotFound), errors.Is(ferr, effects.ErrTransient):\n\t\t\t// Not landed, or unknown: push again.\n\t\tdefault:\n\t\t\treturn ferr\n\t\t}\n\t}\n}\n\nfunc upstreamRef(branch string) string { return \"refs/ard/upstream/\" + branch }\n\n// lane serialises requests for one branch.\ntype lane struct {\n\t*core\n\tbranch     string\n\twt         string\n\tpersistent bool // main: worktree lives as long as the lane\n\tsem        chan struct{}\n\tmu         sync.Mutex\n\tclosed     bool\n}\n\nfunc newLane(c *core, branch, wt string, persistent bool) *lane {\n\treturn &lane{core: c, branch: branch, wt: wt, persistent: persistent, sem: make(chan struct{}, 1)}\n}\n\nfunc (l *lane) isClosed() bool {\n\tl.mu.Lock()\n\tdefer l.mu.Unlock()\n\treturn l.closed\n}\n\n// commit validates, waits for the lane and runs the pipeline.\nfunc (l *lane) commit(ctx context.Context, req Request) (res Result, err error) {\n\tif l.isClosed() {\n\t\treturn Result{}, ErrClosed\n\t}\n\tissue := req.Issue\n\tdry := l.fx.DryRun()\n\tswitch {\n\tcase issue < 0 && dry:\n\t\tissue = -issue\n\tcase issue <= 0:\n\t\treturn Result{}, fmt.Errorf(\"commit issue %d: %w: issue must be positive\", req.Issue, &GuardError{Paths: []string{\"\"}, Reasons: []string{\"non-positive issue\"}})\n\t}\n\tsnap, err := snapshot(req, issue)\n\tif err != nil {\n\t\treturn Result{}, fmt.Errorf(\"commit issue %d (%s:%s): %w\", req.Issue, req.Stage, req.Role, err)\n\t}\n\tmsg, err := Message(req.Stage, req.Role, issue, req.Summary, req.JobID, l.skipCI)\n\tif err != nil {\n\t\treturn Result{}, fmt.Errorf(\"commit issue %d (%s:%s): %w\", req.Issue, req.Stage, req.Role, err)\n\t}\n\tstart := time.Now()\n\tdefer func() {\n\t\tattrs := []any{\"issue\", req.Issue, \"stage\", req.Stage, \"role\", req.Role, \"branch\", l.branch, \"job\", req.JobID,\n\t\t\t\"files\", len(snap.Files), \"duration\", time.Since(start).String()}\n\t\tif err != nil {\n\t\t\tl.log.WarnContext(ctx, \"committer.failed\", append(attrs, \"err\", err.Error())...)\n\t\t\treturn\n\t\t}\n\t\tl.log.InfoContext(ctx, \"committer.commit\", append(attrs, \"sha\", res.SHA, \"noop\", res.NoOp, \"synthetic\", res.Synthetic, \"attempts\", res.Attempts)...)\n\t}()\n\tif req.Issue < 0 { // synthetic issue: validated, nothing touches git\n\t\treturn Result{SHA: strings.Repeat(\"0\", 40), Synthetic: true}, nil\n\t}\n\n\tselect {\n\tcase l.sem <- struct{}{}:\n\tcase <-ctx.Done():\n\t\treturn Result{}, fmt.Errorf(\"commit issue %d: %w\", req.Issue, ctx.Err())\n\t}\n\tdefer func() { <-l.sem }()\n\tif l.isClosed() {\n\t\treturn Result{}, ErrClosed\n\t}\n\tres, err = l.run(ctx, snapOf(snap, msg))\n\tif err != nil {\n\t\terr = fmt.Errorf(\"commit issue %d (%s:%s): %w\", req.Issue, req.Stage, req.Role, err)\n\t}\n\treturn res, err\n}\n\n// snapFile is one validated change, ready to apply.\ntype snapFile struct {\n\tpath string\n\tdata []byte\n\texec bool\n\tdel  bool\n\t// merge, when set, rewrites data against the contents at the head.\n\tmerge func(cur []byte, exists bool, mine []byte) ([]byte, error)\n}\n\n// snap is a validated request in the form the lane applies, whichever lane\n// (.ard or worker code) produced it.\ntype snap struct {\n\tfiles    []snapFile\n\tdeclared []string\n\tmsg      string\n\t// base, when set, is the commit the caller's content was derived from:\n\t// the first attempt refuses to overwrite a declared path that changed\n\t// between base and the fetched head.\n\tbase string\n}\n\nfunc (s snap) wantMode(path string) string {\n\tfor _, f := range s.files {\n\t\tif f.path == path {\n\t\t\tif f.del {\n\t\t\t\treturn \"000000\"\n\t\t\t}\n\t\t\treturn modeOf(f.exec)\n\t\t}\n\t}\n\treturn \"\"\n}\n\n// snapOf converts a validated .ard Request. Its files are never executable.\nfunc snapOf(req Request, msg string) snap {\n\ts := snap{msg: msg, declared: make([]string, len(req.Files))}\n\tfor i, f := range req.Files {\n\t\ts.declared[i] = f.Path\n\t\ts.files = append(s.files, snapFile{path: f.Path, data: f.Data, del: f.Delete, merge: f.Merge})\n\t}\n\treturn s\n}\n\nfunc (l *lane) run(ctx context.Context, s snap) (Result, error) {\n\tif !l.persistent {\n\t\tif err := l.addWorktree(ctx); err != nil {\n\t\t\treturn Result{}, err\n\t\t}\n\t\tdefer func() { _ = l.g.WorktreeRemove(context.WithoutCancel(ctx), l.cfg.RepoDir, l.wt) }()\n\t}\n\tdeclared := s.declared\n\n\tvar base, prev, pending string\n\trejections, transients := 0, 0\n\tfor attempt := 1; ; attempt++ {\n\t\tvar err error\n\t\tif base, err = l.fetch(ctx); err != nil {\n\t\t\tl.reset(ctx, prev)\n\t\t\tif errors.Is(err, effects.ErrTransient) {\n\t\t\t\tif transients >= maxTransient {\n\t\t\t\t\treturn Result{Attempts: attempt - 1}, exhausted(err)\n\t\t\t\t}\n\t\t\t\ttransients++\n\t\t\t\tif werr := l.transientWait(ctx, l.branch, transients, err); werr != nil {\n\t\t\t\t\treturn Result{Attempts: attempt - 1}, werr\n\t\t\t\t}\n\t\t\t\tattempt--\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\treturn Result{Attempts: attempt - 1}, err\n\t\t}\n\t\tif pending != \"\" {\n\t\t\t// An earlier push failed transiently and may have landed.\n\t\t\tif ok, aerr := l.g.IsAncestor(ctx, l.cfg.RepoDir, pending, base); aerr == nil && ok {\n\t\t\t\tl.reset(ctx, base)\n\t\t\t\treturn Result{SHA: pending, Attempts: attempt - 1}, nil\n\t\t\t}\n\t\t\tpending = \"\"\n\t\t}\n\t\tfrom := prev\n\t\tif attempt == 1 {\n\t\t\tfrom = s.base\n\t\t}\n\t\tif from != \"\" {\n\t\t\tchanged, err := l.g.ChangedPaths(ctx, l.wt, from, base, declared...)\n\t\t\tif err != nil {\n\t\t\t\tl.reset(ctx, base)\n\t\t\t\treturn Result{Attempts: attempt - 1}, err\n\t\t\t}\n\t\t\tif len(changed) > 0 {\n\t\t\t\tl.reset(ctx, base)\n\t\t\t\treturn Result{Attempts: attempt - 1}, fmt.Errorf(\"%w: %s\", ErrConflict, strings.Join(chang