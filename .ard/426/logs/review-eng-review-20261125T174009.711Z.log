 // whether a failure is worth another fetch-and-apply round. With create, base\n // is the commit a new branch is cut from: nothing staged is ErrInvalid (a\ndiff --git a/internal/committer/errors.go b/internal/committer/errors.go\nindex b1cbc55..66c2f5b 100644\n--- a/internal/committer/errors.go\n+++ b/internal/committer/errors.go\n@@ -24,6 +24,10 @@ var (\n \t// ErrTransient means a remote or network failure outlasted the retry\n \t// budget. It wraps the last cause too.\n \tErrTransient = errors.New(\"committer: transient remote failure persisted\")\n+\t// ErrProtected means a push was rejected by branch protection (GH006) and\n+\t// it was not a lost race: a branch lane, or main had not moved since the\n+\t// lease. It is never retried.\n+\tErrProtected = errors.New(\"committer: push rejected by branch protection\")\n \t// ErrClosed means Commit was called after Close.\n \tErrClosed = errors.New(\"committer: closed\")\n )\ndiff --git a/internal/committer/protected_test.go b/internal/committer/protected_test.go\nnew file mode 100644\nindex 0000000..bc79906\n--- /dev/null\n+++ b/internal/committer/protected_test.go\n@@ -0,0 +1,128 @@\n+package committer\n+\n+import (\n+\t\"context\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+\n+\t\"github.com/albertcbrown/ard/internal/effects\"\n+\t\"github.com/albertcbrown/ard/internal/gitx/gittest\"\n+)\n+\n+// gh006 fakes pushes: the first `moves` protected rejections also move main\n+// (a lost race), the next `still` rejections leave main alone, and `trans`\n+// transient failures come first. Afterwards pushes go through.\n+type gh006 struct {\n+\tEffects\n+\te      *env\n+\tt      *testing.T\n+\tmoves  int\n+\tstill  int\n+\ttrans  int\n+\tpushes int\n+}\n+\n+func (g *gh006) Push(ctx context.Context, op effects.PushOp) error {\n+\tg.pushes++\n+\tif g.trans > 0 {\n+\t\tg.trans--\n+\t\treturn fmt.Errorf(\"gitx: push: %w: remote: Internal Server Error\", effects.ErrTransient)\n