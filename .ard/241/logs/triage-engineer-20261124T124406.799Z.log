cost_tables(issue, dirty, gen, marked_at)\n\tSELECT issue, 1, 1, ? FROM jobs WHERE id = ? AND stage IN ('triage','worker','review')\n\tON CONFLICT(issue) DO UPDATE SET dirty = 1, gen = gen + 1, marked_at = excluded.marked_at, failures = 0`\n\n// DirtyCostTables returns up to limit issues whose table needs a write, oldest\n// mark first.\nfunc (s *Store) DirtyCostTables(ctx context.Context, limit int) ([]CostTable, error) {\n\trows, err := s.db.QueryContext(ctx, `SELECT issue, marked_at, failures, gen FROM cost_tables\n\t\tWHERE dirty = 1 ORDER BY marked_at, issue LIMIT ?`, limit)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"dirty cost tables: %w\", err)\n\t}\n\tdefer rows.Close()\n\tvar out []CostTable\n\tfor rows.Next() {\n\t\tvar c CostTable\n\t\tvar at int64\n\t\tif err := rows.Scan(&c.Issue, &at, &c.Failures, &c.Gen); err != nil {\n\t\t\treturn nil, fmt.Errorf(\"dirty cost tables: %w\", err)\n\t\t}\n\t\tc.MarkedAt = time.Unix(at, 0).UTC()\n\t\tout = append(out, c)\n\t}\n\treturn out, rows.Err()\n}\n\n// CostTableDone clears the flag only when it is still the generation the writer saw,\n// so a close-out that marks during a write is not lost.\nfunc (s *Store) CostTableDone(ctx context.Context, issue int, gen int64) error {\n\t_, err := s.db.ExecContext(ctx, `UPDATE cost_tables SET dirty = 0, written_at = ?, failures = 0\n\t\tWHERE issue = ? AND gen = ?`, s.now().Unix(), issue, gen)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"cost table done %d: %w\", issue, err)\n\t}\n\treturn nil\n}\n\n// CostTableFailed counts one failed write and returns the running count.\nfunc (s *Store) CostTableFailed(ctx context.Context, issue int) (int, error) {\n\tvar n int\n\terr := s.db.QueryRowContext(ctx, `UPDATE cost_tables SET failures = failures + 1 WHERE issue = ? RETURNING failures`, issue).Scan(&n)\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"cost table failed %d: %w\", issue, err)\n\t}\n\treturn n, nil\n}\n\n// ClosedJobsOf returns the non-scanner jobs of an issue whose close-out is\n// closed, oldest first. Each gets a row in the cost table.\nfunc (s *Store) ClosedJobsOf(ctx context.Context, issue int) ([]Job, error) {\n\trows, err := s.db.QueryContext(ctx, `SELECT `+jobCols+` FROM jobs\n\t\tWHERE issue = ? AND stage != 'scanner' AND closeout_phase = 'closed' ORDER BY created_at, id`, issue)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"closed jobs of %d: %w\", issue, err)\n\t}\n\tdefer rows.Close()\n\tvar out []Job\n\tfor rows.Next() {\n\t\tj, err := scanJob(rows)\n\t\tif err != nil {\n\t\t\treturn nil, fmt.Errorf(\"closed jobs of %d: %w\", issue, err)\n\t\t}\n\t\tout = append(out, j)\n\t}\n\treturn out, rows.Err()\n}\n15:type Tokens struct{ Input, Output, CacheWrite, CacheRead int64 }\n18:type StepUsage struct {\n25:type JobUsage struct {\n40:func ValidModel(s string) bool { return modelRE.MatchString(s) }\n46:func (s *Store) RecordStepUsage(ctx context.Context, jobID, step string, u StepUsage) (bool, error) {\n107:type usageRow struct {\n114:func (u *JobUsage) add(r usageRow, seen map[string]bool) {\n142:func (s *Store) JobUsage(ctx context.Context, jobID string) (JobUsage, error) {\n167:func (s *Store) IssueUsage(ctx context.Context, issue int) (map[string]JobUsage, error) {\n201:type Spend struct {\n208:type RoleKey struct{ Stage, Role string }\n212:func (s *Store) SpendSince(ctx context.Context, dayStart time.Time) (map[RoleKey]Spend, Spend, error) {\ninternal/costblock/costblock.go:75:func ValidRow(r Row) bool { return stageOK[r.Stage] && roleRE.MatchString(r.Role) }\ninternal/costblock/costblock.go:79:func num(n int64) string {\ninternal/costblock/costblock.go:102:func tokText(t Tokens) string {\ninternal/costblock/costblock.go:106:func validTokens(t *Tokens) bool {\ninternal/costblock/costblock.go:118:func validCost(c *float64) bool {\ninternal/costblock/costblock.go:123:func costText(c float64) string { return fmt.Sprintf(\"$%.2f\", c+0) }\ninternal/costblock/costblock.go:133:func (s *sums) add(r Row) {\ninternal/costblock/costblock.go:147:func (s sums) cells() (tok, cost string) {\ninternal/costblock/costblock.go:158:func rowLine(r Row) string {\ninternal/costblock/costblock.go:195:func foldLine(k int, s sums) string {\ninternal/costblock/costblock.go:200:func totalLine(s sums) string {\ninternal/costblock/costblock.go:210:func Render(rows []Row, maxBytes int) (block string, folded int, ok bool) {\ninternal/costblock/costblock.go:263:func Valid(inner string) bool {\ninternal/costblock/costblock.go:290:func Locate(body string) (sepStart, start, end int, ok bool) {\ninternal/costblock/costblock.go:310:func locateValid(body string) (sepStart, start, end int, ok bool) {\ninternal/costblock/costblock.go:320:func Region(body string) string {\ninternal/costblock/costblock.go:331:func Strip(body string) string {\ninternal/costblock/costblock.go:338:func Cut(body string) (rest, region string) {\ninternal/costblock/costblock.go:350:func Splice(body, block string) string {\ninternal/costblock/locks.go:19:func (l *Locks) Lock(n int) (unlock func()) {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01WM948ZCTWQB1YwK7q5YYr9","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
