and deterministic scanners (no model, no cost) are exempt. Running jobs are never killed for a cap. If today's spend cannot be read, the gate refuses (fails closed). Each cap is logged once a day as `budget.capped`. The `budget` loop posts one comment on the status issue per capped scope (the repo, or a role) per UTC day, and records a `budget_capped` event; that event also keeps a restart from posting the notice again (a crash between comment and event can repeat one notice). The comment holds only numbers, the day and config names, no agent text and no `@`; it says the dollar figure is an estimate on a subscription and how to raise the cap (edit `budget_usd_per_day` in `.ard/config.yaml` through a reviewed PR). Under `--dry-run` the comment goes to the ledger. `--loops budget` selects the notice loop; the gate is part of the pool and is always on.","is_error":false}]},"parent_tool_use_id":null,"session_id":"d12672c4-d664-4d87-be30-0dbe1fb67dc9","uuid":"73c53c87-4473-41de-a7c0-4679b6483fba","timestamp":"2026-11-24T12:44:21.503Z","tool_use_result":{"stdout":"\treturn fmt.Sprintf(\"Paused for usage limit until %s (%s); re-runs after the reset.\",\n\t\tc.ResetsAt.UTC().Format(\"2006-01-02 15:04 UTC\"), sanitize(who))\n}\n\n// RenderComment builds the close-out comment for a record. In dry-run, or\n// when nothing was committed, output paths are plain text with no link.\nfunc RenderComment(r Record, repo github.Repo, dryRun bool) string {\n\tj, p := r.Job, r.Plan\n\tvar b strings.Builder\n\tb.WriteString(marker(j.ID, j.Attempt) + \"\\n\")\n\tfmt.Fprintf(&b, \"**ard · %s:%s · %s**\\n\", j.Stage, j.Role, headerWord(p))\n\tif s := strings.TrimSpace(p.Summary); s != \"\" {\n\t\tb.WriteString(\"\\n\" + sanitize(cutSummary(s)) + \"\\n\")\n\t}\n\tif p.Reason != \"\" {\n\t\tb.WriteString(\"\\n\" + codeSpan(p.Reason, maxReasonRunes) + \"\\n\")\n\t}\n\tvar lines []string\n\tif len(p.Requests) > 0 {\n\t\tnames := make([]string, len(p.Requests))\n\t\tfor i, l := range p.Requests {