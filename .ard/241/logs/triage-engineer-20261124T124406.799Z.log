{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KxRcUGU6Ad39aMNu7UwqSG","type":"tool_result","content":"1\tpackage reaper\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"encoding/json\"\n6\t\t\"errors\"\n7\t\t\"fmt\"\n8\t\t\"log/slog\"\n9\t\t\"math\"\n10\t\t\"sort\"\n11\t\t\"strings\"\n12\t\t\"time\"\n13\t\n14\t\t\"github.com/albertcbrown/ard/internal/agent\"\n15\t\t\"github.com/albertcbrown/ard/internal/closeout\"\n16\t\t\"github.com/albertcbrown/ard/internal/executor\"\n17\t\t\"github.com/albertcbrown/ard/internal/limits\"\n18\t\t\"github.com/albertcbrown/ard/internal/state\"\n19\t)\n20\t\n21\t// Closer is *closeout.Closer.\n22\ttype Closer interface {\n23\t\tRun(ctx context.Context, j closeout.Job) (closeout.Outcome, error)\n24\t\tResumeJob(ctx context.Context, id string) (closeout.Outcome, error)\n25\t}\n26\t\n27\t// Cleaner is the executor call the Finisher needs.\n28\ttype Cleaner interface {\n29\t\tCleanup(ctx context.Context, h executor.Handle, o executor.CleanupOptions) error\n30\t}\n31\t\n32\t// FinishStore is the part of state.Store the Finisher uses.\n33\ttype FinishStore interface {\n34\t\tJob(ctx context.Context, id string) (state.Job, error)\n35\t\tEndAttempt(ctx context.Context, id string, n int, e state.AttemptEnd) error\n36\t\tMarkCleaned(ctx context.Context, id string) error\n37\t\tRecordStepUsage(ctx context.Context, jobID, step string, u state.StepUsage) (bool, error)\n38\t\tJobUsage(ctx context.Context, jobID string) (state.JobUsage, error)\n39\t}\n40\t\n41\t// Finisher ends a job whose process has stopped. The triage, worker and\n42\t// reviewer loops and the Reaper share one.\n43\ttype Finisher struct {\n44\t\tCloser  Closer\n45\t\tCleaner Cleaner\n46\t\tStore   FinishStore\n47\t\t// Start is when this serve process started: a job created before it\n48\t\t// belongs to a previous process (see CauseOf).\n49\t\tStart time.Time\n50\t\t// Classify is the hook for a cause CauseOf cannot see: serve sets it to\n51\t\t// UsageLimitClassifier. When it reports ok its cause replaces CauseOf's.\n52\t\t// nil means none. A usage-limit cause must have Retry false so it does not\n53\t\t// use up the one automatic retry.\n54\t\tClassify func(res agent.Result) (closeout.Cause, bool)\n55\t\t// Limits records a usage-limit stop so the pool starts no job into the\n56\t\t// limit. nil records nothing.\n57\t\tLimits LimitRecorder\n58\t\t// Readings records the usage windows of an agent step (never a test\n59\t\t// step). nil records nothing. The recorder decides which credentials count.\n60\t\tReadings ReadingRecorder\n61\t\tLog      *slog.Logger\n62\t}\n63\t\n64\tfunc (f *Finisher) log() *slog.Logger {\n65\t\tif f.Log != nil {\n66\t\t\treturn f.Log\n67\t\t}\n68\t\treturn slog.Default()\n69\t}\n70\t\n71\t// NewCause builds a Cause for sj: a transient kind hands off to one automatic\n72\t// retry unless sj is itself a retry.\n73\tfunc NewCause(sj state.Job, kind closeout.CauseKind, detail string, transient bool) closeout.Cause {\n74\t\treturn closeout.Cause{Kind: kind, Detail: detail, Transient: transient, Retry: transient && sj.RetryOf == \"\"}\n75\t}\n76\t\n77\t// CauseOf decides how a job whose process is no longer running ended. The\n78\t// first rule that matches wins:\n79\t//\n80\t//  1. The Reaper recorded a kill reason: that cause (heartbeat_quiet and\n81\t//     deadline are not transient; controller_restart is).\n82\t//  2. The executor timed the job out: deadline.\n83\t//  3. The process is gone: controller_restart (transient) when the job was\n84\t//     created before processStart, otherwise no_process. The latter covers a\n85\t//     process of this run that vanished, such as a container killed from\n86\t//     outside.\n87\t//  4. The agent reported a transient API error: rate_limit.\n88\t//  5. Otherwise the zero Cause: a normal close-out from the role file and the\n89\t//     exit code.\n90\t//\n91\t// Retry is set for a transient cause when sj is not itself a retry.\n92\tfunc CauseOf(sj state.Job, st executor.Status, res agent.Result, processStart time.Time) closeout.Cause {\n93\t\tswitch {\n94\t\tcase sj.KillReason != \"\":\n95\t\t\tkind := closeout.CauseKind(sj.KillReason)\n96\t\t\tswitch kind {\n97\t\t\tcase closeout.CauseQuiet:\n98\t\t\t\treturn NewCause(sj, kind, quietDetail(st), false)\n99\t\t\tcase closeout.CauseDeadline:\n100\t\t\t\treturn NewCause(sj, kind, \"ran past its deadline\", false)\n101\t\t\tcase closeout.CauseRestart:\n102\t\t\t\treturn NewCause(sj, kind, \"orphaned by a controller restart\", true)\n103\t\t\t}\n104\t\t\treturn NewCause(sj, kind, \"killed by the Reaper\", false)\n105\t\tcase st.State == executor.TimedOut:\n106\t\t\treturn NewCause(sj, closeout.CauseDeadline, \"ran past its deadline\", false)\n107\t\tcase st.State == executor.Gone:\n108\t\t\tif sj.CreatedAt.Before(processStart) {\n109\t\t\t\treturn NewCause(sj, closeout.CauseRestart, \"process gone after a controller restart\", true)\n110\t\t\t}\n111\t\t\treturn NewCause(sj, closeout.CauseNoProcess, \"process gone without a result\", false)\n112\t\tcase !res.OK && res.Transient():\n113\t\t\treturn NewCause(sj, closeout.CauseRateLimit, fmt.Sprintf(\"API status %d\", res.APIErrorStatus), true)\n114\t\t}\n115\t\treturn closeout.Cause{}\n116\t}\n117\t\n118\tfunc quietDetail(st executor.Status) string {\n119\t\tif st.LastOutput.IsZero() {\n120\t\t\treturn \"no output for 10 minutes\"\n121\t\t}\n122\t\treturn \"no output since \" + st.LastOutput.UTC().Format(\"15:04\") + \" UTC\"\n123\t}\n124\t\n125\t// CloseoutJob maps a state job and its executor handle to a close-out job.\n126\t// ExitCode is -1 when the process is gone, orphaned or never started.\n127\tfunc CloseoutJob(sj state.Job, h executor.Handle, st executor.Status, cause closeout.Cause, res agent.Result) closeout.Job {\n128\t\texit := st.ExitCode\n129\t\tswitch st.State {\n130\t\tcase executor.Gone, executor.Orphaned, executor.Prepared, \"\":\n131\t\t\texit = -1\n132\t\t}\n133\t\tj := closeout.Job{ID: sj.ID, Issue: sj.Issue, PR: sj.PR, Stage: sj.Stage, Role: sj.Role, Attempt: sj.Attempt,\n134\t\t\tStartedAt: sj.CreatedAt, Branch: sj.Branch, Worktree: h.Worktree, Home: h.Home, BaseSHA: h.BaseSHA, Scrubbed: h.Scrubbed, LogPath: h.LogPath, ExitCode: exit, Cause: cause}\n135\t\tif res.CostUSD != nil {\n136\t\t\tj.CostUSD = *res.CostUSD\n137\t\t}\n138\t\treturn j\n139\t}\n140\t\n141\t// Finish closes out a job whose process has stopped, then tidies up: it ends\n142\t// the attempt and calls Cleanup, keeping the worktree unless the outcome is\n143\t// done or changes (on removal it marks the job cleaned). It never releases the\n144\t// pool slot.\n145\t//\n146\t// Finish re-reads the job row and computes the cause itself. A caller's\n147\t// claim-time state.Job is stale: it has no kill reason. A Reaper kill also\n148\t// drops the executor's tracker, so the owner sees Gone; without the re-read a\n149\t// quiet-heartbeat kill would look like a transient restart and earn a free\n150\t// retry. override is for causes the loop knows and CauseOf cannot (for example\n151\t// clone_failed); a zero override means use Classify, then CauseOf.\n152\t//\n153\t// A Run error is returned as is and the close-out stays resumable. An error\n154\t// wrapping closeout.ErrBusy means someone else is closing the job.\n155\tfunc (f *Finisher) Finish(ctx context.Context, jobID string, h executor.Handle, st executor.Status, res agent.Result, override closeout.Cause) (closeout.Outcome, error) {\n156\t\treturn f.FinishWith(ctx, jobID, h, st, res, FinishOptions{Cause: override})\n157\t}\n158\t\n159\t// FinishOptions are the extras of FinishWith.\n160\ttype FinishOptions struct {\n161\t\t// Cause is Finish's override.\n162\t\tCause closeout.Cause\n163\t\t// Worker is the worker loop's result (PR, reviewers, tests, hold). A worker\n164\t\t// job that is closed out without it, and whose role file says done, needs a\n165\t\t// human.\n166\t\tWorker *closeout.WorkerResult\n167\t\t// ExtraLogs are further host logs to commit beside the handle's log: the\n168\t\t// earlier agent steps of a worker job.\n169\t\tExtraLogs []string\n170\t\t// Review is the reviewer loop's context (added lines, head moved). A\n171\t\t// review closed out without it posts every finding in the review body.\n172\t\tReview *closeout.ReviewContext\n173\t}\n174\t\n175\t// FinishWith is Finish with a worker result, extra logs and a review context. The worker loop\n176\t// calls SetBranch and SetPR on the job row first, then FinishWith with the\n177\t// handle of its final agent step.\n178\tfunc (f *Finisher) FinishWith(ctx context.Context, jobID string, h executor.Handle, st executor.Status, res agent.Result, o FinishOptions) (closeout.Outcome, error) {\n179\t\toverride := o.Cause\n180\t\tsj, err := f.Store.Job(ctx, jobID)\n181\t\tif err != nil {\n182\t\t\treturn \"\", fmt.Errorf(\"finish job %s: %w\", jobID, err)\n183\t\t}\n184\t\tif sj.Status != state.StatusRunning && (sj.CloseoutPhase == \"\" || sj.CloseoutPhase == string(closeout.PhaseClosed)) {\n185\t\t\treturn \"\", fmt.Errorf(\"finish job %s: %w\", jobID, state.ErrNotRunning)\n186\t\t}\n187\t\t// A test step (<id>t<k>) runs agent-written code, so its output is never\n188\t\t// trusted as the CLI's own: a printed usage-limit line there must not block\n189\t\t// the account. Only the job's own agent step and its fix steps count.\n190\t\tif h.JobID != \"\" && !agentStep(jobID, h.JobID) {\n191\t\t\tres.LimitHit = nil\n192\t\t}\n193\t\t// Readings come only from the job's own agent steps, for the same reason,\n194\t\t// and are kept even when the run has no result (a killed step).\n195\t\tif f.Readings != nil && len(res.Windows) > 0 && agentStep(jobID, h.JobID) {\n196\t\t\tf.Readings.Observe(ctx, res.Windows)\n197\t\t}\n198\t\tcause := override\n199\t\tif cause.Kind == \"\" && f.Classify != nil {\n200\t\t\tif c, ok := f.Classify(res); ok {\n201\t\t\t\tcause = c\n202\t\t\t}\n203\t\t}\n204\t\tif cause.Kind == \"\" {\n205\t\t\tcause = CauseOf(sj, st, res, f.Start)\n206\t\t}\n207\t\t// A usage-limit stop is recorded before anything else, so the pool blocks\n208\t\t// the account no later than the comment says. An error here is returned\n209\t\t// with nothing posted and the next tick retries: no job may start into a\n210\t\t// limit the book could not record (fail closed).\n211\t\tif cause.Kind == closeout.CauseUsageLimit && f.Limits != nil {\n212\t\t\tuntil, err := f.Limits.Exhaust(ctx, cause.Family, cause.ResetsAt)\n213\t\t\tif err != nil {\n214\t\t\t\treturn \"\", fmt.Errorf(\"finish job %s: record usage limit: %w\", jobID, err)\n215\t\t\t}\n216\t\t\tcause.ResetsAt = until\n217\t\t}\n218\t\t// Record the final step's usage, then read the job's totals (the sum of\n219\t\t// every step recorded so far). Close-out never fails over accounting: on an\n220\t\t// error the final step's own numbers stand in.\n221\t\tcost := res.CostUSD\n222\t\tvar totals state.JobUsage\n223\t\trecorded := true\n224\t\t// Only agent steps are recorded: the job's own id or <id>f<k> (a fix step).\n225\t\t// A test step (<id>t<k>) runs agent-written code, so its output is never\n226\t\t// parsed into usage.\n227\t\tif u, ok := StepUsageOf(res); ok && agentStep(jobID, h.JobID) {\n228\t\t\tif _, err := f.Store.RecordStepUsage(ctx, jobID, h.JobID, u); err != nil {\n229\t\t\t\tf.log().Warn(\"reaper.usage_record_failed\", \"job\", jobID, \"step\", h.JobID, \"error\", err)\n230\t\t\t\trecorded = false\n231\t\t\t}\n232\t\t}\n233\t\thaveTotals := false\n234\t\tif recorded {\n235\t\t\tif t, err := f.Store.JobUsage(ctx, jobID); err != nil {\n236\t\t\t\tf.log().Warn(\"reaper.usage_record_failed\", \"job\", jobID, \"error\", err)\n237\t\t\t} else {\n238\t\t\t\ttotals, haveTotals = t, true\n239\t\t\t\tcost = t.CostUSD\n240\t\t\t}\n241\t\t}\n242\t\tcj := CloseoutJob(sj, h, st, cause, res)\n243\t\tcj.CostUSD = 0\n244\t\tif cost != nil {\n245\t\t\tcj.CostUSD = *cost\n246\t\t}\n247\t\tif haveTotals {\n248\t\t\tcj.Usage = usageOf(totals)\n249\t\t} else if u, ok := StepUsageOf(res); ok {\n250\t\t\tcj.Usage = usageOf(state.JobUsage{Models: u.Models, Tokens: u.Tokens, CostUSD: u.CostUSD, Steps: 1})\n251\t\t}\n252\t\tcj.Worker, cj.ExtraLogs, cj.Review = o.Worker, o.ExtraLogs, o.Review\n253\t\t// End the attempt before close-out: a crash after it leaves a resumable\n254\t\t// close-out and an ended attempt, never the reverse.\n255\t\tif sj.Attempt > 0 {\n256\t\t\tend := state.AttemptEnd{Cause: string(cause.Kind), Transient: cause.Transient}\n257\t\t\tcode := cj.ExitCode\n258\t\t\tend.ExitCode = &code\n259\t\t\tend.CostUSD = cost\n260\t\t\tif err := f.Store.EndAttempt(ctx, jobID, sj.Attempt, end); err != nil && !errors.Is(err, state.ErrNotFound) {\n261\t\t\t\treturn \"\", fmt.Errorf(\"finish job %s: end attempt: %w\", jobID, err)\n262\t\t\t}\n263\t\t}\n264\t\tout, err := f.Closer.Run(ctx, cj)\n265\t\tif err != nil {\n266\t\t\treturn \"\", fmt.Errorf(\"finish job %s: %w\", jobID, err)\n267\t\t}\n268\t\tattrs := []any{\"job\", jobID, \"issue\", sj.Issue, \"stage\", sj.Stage, \"role\", sj.Role,\n269\t\t\t\"cause\", string(cause.Kind), \"outcome\", string(out), \"retry\", cause.Retry}\n270\t\tif cause.Kind == closeout.CauseUsageLimit {\n271\t\t\tattrs = append(attrs, \"family\", cause.Family, \"until\", cause.ResetsAt.UTC())\n272\t\t}\n273\t\tf.log().Info(\"reaper.finish\", append(attrs, usageAttrs(cj.Usage)...)...)\n274\t\tif res.OK && cause.Kind == \"\" && (out == closeout.OutcomeDone || out == closeout.OutcomeChanges) && f.Limits != nil {\n275\t\t\t// A job that ended well proves the account is usable: the no-reset\n276\t\t\t// backoff starts over. Best effort.\n277\t\t\tif err := f.Limits.Succeeded(ctx, limits.FamilyOf(res.Model)); err != nil {\n278\t\t\t\tf.log().Warn(\"reaper.limits_succeeded\", \"job\", jobID, \"error\", err)\n279\t\t\t}\n280\t\t}\n281\t\tf.Tidy(ctx, sj, h, out)\n282\t\treturn out, nil\n283\t}\n284\t\n285\t// usageAttrs are the job's totals for the reaper.finish event: tokens, cost\n286\t// and the number of agent steps summed.\n287\tfunc usageAttrs(u closeout.Usage) []any {\n288\t\tvar a []any\n289\t\tif t := u.Tokens; t != nil {\n290\t\t\ta = append(a, \"tokens_in\", t.Input, \"tokens_out\", t.Output, \"tokens_cache_write\", t.CacheWrite, \"tokens_cache_read\", t.CacheRead)\n291\t\t}\n292\t\tif u.CostUSD != nil {\n293\t\t\ta = append(a, \"cost_usd\", *u.CostUSD)\n294\t\t}\n295\t\tif u.Steps > 0 {\n296\t\t\ta = append(a, \"steps\", u.Steps)\n297\t\t}\n298\t\treturn a\n299\t}\n300\t\n301\t// usageOf maps a job's state totals to the close-out Usage.\n302\tfunc usageOf(u state.JobUsage) closeout.Usage {\n303\t\tout := closeout.Usage{Models: u.Models, CostUSD: u.CostUSD, Steps: u.Steps}\n304\t\tif t := u.Tokens; t != nil {\n305\t\t\tout.Tokens = &closeout.Tokens{Input: t.Input, Output: t.Output, CacheWrite: t.CacheWrite, CacheRead: t.CacheRead}\n306\t\t}\n307\t\treturn out\n308\t}\n309\t\n310\t// agentStep reports whether step is an agent or fix step of the job.\n311\tfunc agentStep(jobID, step string) bool {\n312\t\tif step == jobID {\n313\t\t\treturn true\n314\t\t}\n315\t\trest, ok := strings.CutPrefix(step, jobID+\"f\")\n316\t\tif !ok || rest == \"\" {\n317\t\t\treturn false\n318\t\t}\n319\t\tfor _, r := range rest {\n320\t\t\tif r < '0' || r > '9' {\n321\t\t\t\treturn false\n322\t\t\t}\n323\t\t}\n324\t\treturn true\n325\t}\n326\t\n327\t// StepUsageOf maps what one agent run reported to a state record. ok is false\n328\t// when the result reported nothing: no cost, no usage and no model. Models are\n329\t// the keys of res.ModelUsage plus res.Model, de-duplicated, sorted and limited\n330\t// to valid model ids.\n331\tfunc StepUsageOf(res agent.Result) (state.StepUsage, bool) {\n332\t\tvar u state.StepUsage\n333\t\tif res.CostUSD != nil {\n334\t\t\tif c := *res.CostUSD; !math.IsNaN(c) && !math.IsInf(c, 0) && c >= 0 {\n335\t\t\t\tu.CostUSD = &c\n336\t\t\t}\n337\t\t}\n338\t\tif res.Usage != nil {\n339\t\t\tu.Tokens = &state.Tokens{Input: res.Usage.Input, Output: res.Usage.Output, CacheWrite: res.Usage.CacheWrite, CacheRead: res.Usage.CacheRead}\n340\t\t}\n341\t\tseen := map[string]bool{}\n342\t\tadd := func(m string) {\n343\t\t\tif m != \"\" && !seen[m] && state.ValidModel(m) {\n344\t\t\t\tseen[m] = true\n345\t\t\t\tu.Models = append(u.Models, m)\n346\t\t\t}\n347\t\t}\n348\t\tfor m := range res.ModelUsage {\n349\t\t\tadd(m)\n350\t\t}\n351\t\tadd(res.Model)\n352\t\tsort.Strings(u.Models)\n353\t\tif u.CostUSD == nil && u.Tokens == nil && len(u.Models) == 0 {\n354\t\t\treturn state.StepUsage{}, false\n355\t\t}\n356\t\treturn u, true\n357\t}\n358\t\n359\t// Tidy removes the worktree of a closed-out job unless the outcome keeps it\n360\t// (failed, retry, usage-limit, needs-human), and marks the job cleaned when it did. It logs\n361\t// and ignores errors: close-out is already done and retention retries later.\n362\tfunc (f *Finisher) Tidy(ctx context.Context, sj state.Job, h executor.Handle, out closeout.Outcome) {\n363\t\tswitch out {\n364\t\tcase closeout.OutcomeFailed, closeout.OutcomeRetry, closeout.OutcomeLimited, closeout.OutcomeNeedsHuman:\n365\t\t\tif h.JobID != \"\" && f.Cleaner != nil {\n366\t\t\t\tif err := f.Cleaner.Cleanup(ctx, h, executor.CleanupOptions{KeepWorktree: true}); err != nil {\n367\t\t\t\t\tf.log().Warn(\"reaper.cleanup\", \"job\", sj.ID, \"error\", err)\n368\t\t\t\t}\n369\t\t\t}\n370\t\t\treturn\n371\t\t}\n372\t\tif h.JobID != \"\" && f.Cleaner != nil {\n373\t\t\tif err := f.Cleaner.Cleanup(ctx, h, executor.CleanupOptions{}); err != nil {\n374\t\t\t\tf.log().Warn(\"reaper.cleanup\", \"job\", sj.ID, \"error\", err)\n375\t\t\t\treturn\n376\t\t\t}\n377\t\t}\n378\t\tif err := f.Store.MarkCleaned(ctx, sj.ID); err != nil {\n379\t\t\tf.log().Warn(\"reaper.mark_cleaned\", \"job\", sj.ID, \"error\", err)\n380\t\t}\n381\t}\n382\t\n383\t// decodeHandle parses a stored executor handle. A missing or malformed handle\n384\t// counts as no handle.\n385\tfunc decodeHandle(raw json.RawMessage) (executor.Handle, bool) {\n386\t\tif len(raw) == 0 {\n387\t\t\treturn executor.Handle{}, false\n388\t\t}\n389\t\tvar h executor.Handle\n390\t\tif err := json.Unmarshal(raw, &h); err != nil || h.JobID == \"\" {\n391\t\t\treturn executor.Handle{}, false\n392\t\t}\n393\t\treturn h, true\n394\t}\n395\t"}]},"parent_tool_use_id":null,"session_id":"d12672c4-d664-4d87-be30-0dbe1fb67dc9","uuid":"8b686273-78db-4319-a9b6-56c100d0e4c6","timestamp":"2026-11-24T12:44:13.359Z","tool_use_result":{"type":"text","file":{"filePath":"/work/internal/reaper/finish.go","content":"package reaper\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"math\"\n\t\"sort\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/agent\"\n\t\"github.com/albertcbrown/ard/internal/closeout\"\n\t\"github.com/albertcbrown/ard/internal/executor\"\n\t\"github.com/albertcbrown/ard/internal/limits\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// Closer is *closeout.Closer.\ntype Closer interface {\n\tRun(ctx context.Context, j closeout.Job) (closeout.Outcome, error)\n\tResumeJob(ctx context.Context, id string) (closeout.Outcome, error)\n}\n\n// Cleaner is the executor call the Finisher needs.\ntype Cleaner interface {\n\tCleanup(ctx context.Context, h executor.Handle, o executor.CleanupOptions) error\n}\n\n// FinishStore is the part of state.Store the Finisher uses.\ntype FinishStore interface {\n\tJob(ctx context.Context, id string) (state.Job, error)\n\tEndAttempt(ctx context.Context, id string, n int, e state.AttemptEnd) error\n\tMarkCleaned(ctx context.Context, id string) error\n\tRecordStepUsage(ctx context.Context, jobID, step string, u state.StepUsage) (bool, error)\n\tJobUsage(ctx context.Context, jobID string) (state.JobUsage, error)\n}\n\n// Finisher ends a job whose process has stopped. The triage, worker and\n// reviewer loops and the Reaper share one.\ntype Finisher struct {\n\tCloser  Closer\n\tCleaner Cleaner\n\tStore   FinishStore\n\t// Start is when this serve process started: a job created before it\n\t// belongs to a previous process (see CauseOf).\n\tStart time.Time\n\t// Classify is the hook for a cause CauseOf cannot see: serve sets it to\n\t// UsageLimitClassifier. When it reports ok its cause replaces CauseOf's.\n\t// nil means none. A usage-limit cause must have Retry false so it does not\n\t// use up the one automatic retry.\n\tClassify func(res agent.Result) (closeout.Cause, bool)\n\t// Limits records a usage-limit stop so the pool starts no job into the\n\t// limit. nil records nothing.\n\tLimits LimitRecorder\n\t// Readings records the usage windows of an agent step (never a test\n\t// step). nil records nothing. The recorder decides which credentials count.\n\tReadings ReadingRecorder\n\tLog      *slog.Logger\n}\n\nfunc (f *Finisher) log() *slog.Logger {\n\tif f.Log != nil {\n\t\treturn f.Log\n\t}\n\treturn slog.Default()\n}\n\n// NewCause builds a Cause for sj: a transient kind hands off to one automatic\n// retry unless sj is itself a retry.\nfunc NewCause(sj state.Job, kind closeout.CauseKind, detail string, transient bool) closeout.Cause {\n\treturn closeout.Cause{Kind: kind, Detail: detail, Transient: transient, Retry: transient && sj.RetryOf == \"\"}\n}\n\n// CauseOf decides how a job whose process is no longer running ended. The\n// first rule that matches wins:\n//\n//  1. The Reaper recorded a kill reason: that cause (heartbeat_quiet and\n//     deadline are not transient; controller_restart is).\n//  2. The executor timed the job out: deadline.\n//  3. The process is gone: controller_restart (transient) when the job was\n//     created before processStart, otherwise no_process. The latter covers a\n//     process of this run that vanished, such as a container killed from\n//     outside.\n//  4. The agent reported a transient API error: rate_limit.\n//  5. Otherwise the zero Cause: a normal close-out from the role file and the\n//     exit code.\n//\n// Retry is set for a transient cause when sj is not itself a retry.\nfunc CauseOf(sj state.Job, st executor.Status, res agent.Result, processStart time.Time) closeout.Cause {\n\tswitch {\n\tcase sj.KillReason != \"\":\n\t\tkind := closeout.CauseKind(sj.KillReason)\n\t\tswitch kind {\n\t\tcase closeout.CauseQuiet:\n\t\t\treturn NewCause(sj, kind, quietDetail(st), false)\n\t\tcase closeout.CauseDeadline:\n\t\t\treturn NewCause(sj, kind, \"ran past its deadline\", false)\n\t\tcase closeout.CauseRestart:\n\t\t\treturn NewCause(sj, kind, \"orphaned by a controller restart\", true)\n\t\t}\n\t\treturn NewCause(sj, kind, \"killed by the Reaper\", false)\n\tcase st.State == executor.TimedOut:\n\t\treturn NewCause(sj, closeout.CauseDeadline, \"ran past its deadline\", false)\n\tcase st.State == executor.Gone:\n\t\tif sj.CreatedAt.Before(processStart) {\n\t\t\treturn NewCause(sj, closeout.CauseRestart, \"process gone after a controller restart\", true)\n\t\t}\n\t\treturn NewCause(sj, closeout.CauseNoProcess, \"process gone without a result\", false)\n\tcase !res.OK && res.Transient():\n\t\treturn NewCause(sj, closeout.CauseRateLimit, fmt.Sprintf(\"API status %d\", res.APIErrorStatus), true)\n\t}\n\treturn closeout.Cause{}\n}\n\nfunc quietDetail(st executor.Status) string {\n\tif st.LastOutput.IsZero() {\n\t\treturn \"no output for 10 minutes\"\n\t}\n\treturn \"no output since \" + st.LastOutput.UTC().Format(\"15:04\") + \" UTC\"\n}\n\n// CloseoutJob maps a state job and its executor handle to a close-out job.\n// ExitCode is -1 when the process is gone, orphaned or never started.\nfunc CloseoutJob(sj state.Job, h executor.Handle, st executor.Status, cause closeout.Cause, res agent.Result) closeout.Job {\n\texit := st.ExitCode\n\tswitch st.State {\n\tcase executor.Gone, executor.Orphaned, executor.Prepared, \"\":\n\t\texit = -1\n\t}\n\tj := closeout.Job{ID: sj.ID, Issue: sj.Issue, PR: sj.PR, Stage: sj.Stage, Role: sj.Role, Attempt: sj.Attempt,\n\t\tStartedAt: sj.CreatedAt, Branch: sj.Branch, Worktree: h.Worktree, Home: h.Home, BaseSHA: h.BaseSHA, Scrubbed: h.Scrubbed, LogPath: h.LogPath, ExitCode: exit, Cause: cause}\n\tif res.CostUSD != nil {\n\t\tj.CostUSD = *res.CostUSD\n\t}\n\treturn j\n}\n\n// Finish closes out a job whose process has stopped, then tidies up: it ends\n// the attempt and calls Cleanup, keeping the worktree unless the outcome is\n// done or changes (on removal it marks the job cleaned). It never releases the\n// pool slot.\n//\n// Finish re-reads the job row and computes the cause itself. A caller's\n// claim-time state.Job is stale: it has no kill reason. A Reaper kill also\n// drops the executor's tracker, so the owner sees Gone; without the re-read a\n// quiet-heartbeat kill would look like a transient restart and earn a free\n// retry. override is for causes the loop knows and CauseOf cannot (for example\n// clone_failed); a zero override means use Classify, then CauseOf.\n//\n// A Run error is returned as is and the close-out stays resumable. An error\n// wrapping closeout.ErrBusy means someone else is closing the job.\nfunc (f *Finisher) Finish(ctx context.Context, jobID string, h executor.Handle, st executor.Status, res agent.Result, override closeout.Cause) (closeout.Outcome, error) {\n\treturn f.FinishWith(ctx, jobID, h, st, res, FinishOptions{Cause: override})\n}\n\n// FinishOptions are the extras of FinishWith.\ntype FinishOptions struct {\n\t// Cause is Finish's override.\n\tCause closeout.Cause\n\t// Worker is the worker loop's result (PR, reviewers, tests, hold). A worker\n\t// job that is closed out without it, and whose role file says done, needs a\n\t// human.\n\tWorker *closeout.WorkerResult\n\t// ExtraLogs are further host logs to commit beside the handle's log: the\n\t// earlier agent steps of a worker job.\n\tExtraLogs []string\n\t// Review is the reviewer loop's context (added lines, head moved). A\n\t// review closed out without it posts every finding in the review body.\n\tReview *closeout.ReviewContext\n}\n\n// FinishWith is Finish with a worker result, extra logs and a review context. The worker loop\n// calls SetBranch and SetPR on the job row first, then FinishWith with the\n// handle of its final agent step.\nfunc (f *Finisher) FinishWith(ctx context.Context, jobID string, h executor.Handle, st executor.Status, res agent.Result, o FinishOptions) (closeout.Outcome, error) {\n\toverride := o.Cause\n\tsj, err := f.Store.Job(ctx, jobID)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"finish job %s: %w\", jobID, err)\n\t}\n\tif sj.Status != state.StatusRunning && (sj.CloseoutPhase == \"\" || sj.CloseoutPhase == string(closeout.PhaseClosed)) {\n\t\treturn \"\", fmt.Errorf(\"finish job %s: %w\", jobID, state.ErrNotRunning)\n\t}\n\t// A test step (<id>t<k>) runs agent-written code, so its output is never\n\t// trusted as the CLI's own: a printed usage-limit line there must not block\n\t// the account. Only the job's own agent step and its fix steps count.\n\tif h.JobID != \"\" && !agentStep(jobID, h.JobID) {\n\t\tres.LimitHit = nil\n\t}\n\t// Readings come only from the job's own agent steps, for the same reason,\n\t// and are kept even when the run has no result (a killed step).\n\tif f.Readings != nil && len(res.Windows) > 0 && agentStep(jobID, h.JobID) {\n\t\tf.Readings.Observe(ctx, res.Windows)\n\t}\n\tcause := override\n\tif cause.Kind == \"\" && f.Classify != nil {\n\t\tif c, ok := f.Classify(res); ok {\n\t\t\tcause = c\n\t\t}\n\t}\n\tif cause.Kind == \"\" {\n\t\tcause = CauseOf(sj, st, res, f.Start)\n\t}\n\t// A usage-limit stop is recorded before anything else, so the pool blocks\n\t// the account no later than the comment says. An error here is returned\n\t// with nothing posted and the next tick retries: no job may start into a\n\t// limit the book could not record (fail closed).\n\tif cause.Kind == closeout.CauseUsageLimit && f.Limits != nil {\n\t\tuntil, err := f.Limits.Exhaust(ctx, cause.Family, cause.ResetsAt)\n\t\tif err != nil {\n\t\t\treturn \"\", fmt.Errorf(\"finish job %s: record usage limit: %w\", jobID, err)\n\t\t}\n\t\tcause.ResetsAt = until\n\t}\n\t// Record the final step's usage, then read the job's totals (the sum of\n\t// every step recorded so far). Close-out never fails over accounting: on an\n\t// error the final step's own numbers stand in.\n\tcost := res.CostUSD\n\tvar totals state.JobUsage\n\trecorded := true\n\t// Only agent steps are recorded: the job's own id or <id>f<k> (a fix step).\n\t// A test step (<id>t<k>) runs agent-written code, so its output is never\n\t// parsed into usage.\n\tif u, ok := StepUsageOf(res); ok && agentStep(jobID, h.JobID) {\n\t\tif _, err := f.Store.RecordStepUsage(ctx, jobID, h.JobID, u); err != nil {\n\t\t\tf.log().Warn(\"reaper.usage_record_failed\", \"job\", jobID, \"step\", h.JobID, \"error\", err)\n\t\t\trecorded = false\n\t\t}\n\t}\n\thaveTotals := false\n\tif recorded {\n\t\tif t, err := f.Store.JobUsage(ctx, jobID); err != nil {\n\t\t\tf.log().Warn(\"reaper.usage_record_failed\", \"job\", jobID, \"error\", err)\n\t\t} else {\n\t\t\ttotals, haveTotals = t, true\n\t\t\tcost = t.CostUSD\n\t\t}\n\t}\n\tcj := CloseoutJob(sj, h, st, cause, res)\n\tcj.CostUSD = 0\n\tif cost != nil {\n\t\tcj.CostUSD = *cost\n\t}\n\tif haveTotals {\n\t\tcj.Usage = usageOf(totals)\n\t} else if u, ok := StepUsageOf(res); ok {\n\t\tcj.Usage = usageOf(state.JobUsage{Models: u.Models, Tokens: u.Tokens, CostUSD: u.CostUSD, Steps: 1})\n\t}\n\tcj.Worker, cj.ExtraLogs, cj.Review = o.Worker, o.ExtraLogs, o.Review\n\t// End the attempt before close-out: a crash after it leaves a resumable\n\t// close-out and an ended attempt, never the reverse.\n\tif sj.Attempt > 0 {\n\t\tend := state.AttemptEnd{Cause: string(cause.Kind), Transient: cause.Transient}\n\t\tcode := cj.ExitCode\n\t\tend.ExitCode = &code\n\t\tend.CostUSD = cost\n\t\tif err := f.Store.EndAttempt(ctx, jobID, sj.Attempt, end); err != nil && !errors.Is(err, state.ErrNotFound) {\n\t\t\treturn \"\", fmt.Errorf(\"finish job %s: end attempt: %w\", jobID, err)\n\t\t}\n\t}\n\tout, err := f.Closer.Run(ctx, cj)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"finish job %s: %w\", jobID, err)\n\t}\n\tattrs := []any{\"job\", jobID, \"issue\", sj.Issue, \"stage\", sj.Stage, \"role\", sj.Role,\n\t\t\"cause\", string(cause.Kind), \"outcome\", string(out), \"retry\", cause.Retry}\n\tif cause.Kind == closeout.CauseUsageLimit {\n\t\tattrs = append(attrs, \"family\", cause.Family, \"until\", cause.ResetsAt.UTC())\n\t}\n\tf.log().Info(\"reaper.finish\", append(attrs, usageAttrs(cj.Usage)...)...)\n\tif res.OK && cause.Kind == \"\" && (out == closeout.OutcomeDone || out == closeout.OutcomeChanges) && f.Limits != nil {\n\t\t// A job that ended well proves the account is usable: the no-reset\n\t\t// backoff starts over. Best effort.\n\t\tif err := f.Limits.Succeeded(ctx, limits.FamilyOf(res.Model)); err != nil {\n\t\t\tf.log().Warn(\"reaper.limits_succeeded\", \"job\", jobID, \"error\", err)\n\t\t}\n\t}\n\tf.Tidy(ctx, sj, h, out)\n\treturn out, nil\n}\n\n// usageAttrs are the job's totals for the reaper.finish event: tokens, cost\n// and the number of agent steps summed.\nfunc usageAttrs(u closeout.Usage) []any {\n\tvar a []any\n\tif t := u.Tokens; t != nil {\n\t\ta = append(a, \"tokens_in\", t.Input, \"tokens_out\", t.Output, \"tokens_cache_write\", t.CacheWrite, \"tokens_cache_read\", t.CacheRead)\n\t}\n\tif u.CostUSD != nil {\n\t\ta = append(a, \"cost_usd\", *u.CostUSD)\n\t}\n\tif u.Steps > 0 {\n\t\ta = append(a, \"steps\", u.Steps)\n\t}\n\treturn a\n}\n\n// usageOf maps a job's state totals to the close-out Usage.\nfunc usageOf(u state.JobUsage) closeout.Usage {\n\tout := closeout.Usage{Models: u.Models, CostUSD: u.CostUSD, Steps: u.Steps}\n\tif t := u.Tokens; t != nil {\n\t\tout.Tokens = &closeout.Tokens{Input: t.Input, Output: t.Output, CacheWrite: t.CacheWrite, CacheRead: t.CacheRead}\n\t}\n\treturn out\n}\n\n// agentStep reports whether step is an agent or fix step of the job.\nfunc agentStep(jobID, step string) bool {\n\tif step == jobID {\n\t\treturn true\n\t}\n\trest, ok := strings.CutPrefix(step, jobID+\"f\")\n\tif !ok || rest == \"\" {\n\t\treturn false\n\t}\n\tfor _, r := range rest {\n\t\tif r < '0' || r > '9' {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\n// StepUsageOf maps what one agent run reported to a state record. ok is false\n// when the result reported nothing: no cost, no usage and no model. Models are\n// the keys of res.ModelUsage plus res.Model, de-duplicated, sorted and limited\n// to valid model ids.\nfunc StepUsageOf(res agent.Result) (state.StepUsage, bool) {\n\tvar u state.StepUsage\n\tif res.CostUSD != nil {\n\t\tif c := *res.CostUSD; !math.IsNaN(c) && !math.IsInf(c, 0) && c >= 0 {\n\t\t\tu.CostUSD = &c\n\t\t}\n\t}\n\tif res.Usage != nil {\n\t\tu.Tokens = &state.Tokens{Input: res.Usage.Input, Output: res.Usage.Output, CacheWrite: res.Usage.CacheWrite, CacheRead: res.Usage.CacheRead}\n\t}\n\tseen := map[string]bool{}\n\tadd := func(m string) {\n\t\tif m != \"\" && !seen[m] && state.ValidModel(m) {\n\t\t\tseen[m] = true\n\t\t\tu.Models = append(u.Models, m)\n\t\t}\n\t}\n\tfor m := range res.ModelUsage {\n\t\tadd(m)\n\t}\n\tadd(res.Model)\n\tsort.Strings(u.Models)\n\tif u.CostUSD == nil && u.Tokens == nil && len(u.Models) == 0 {\n\t\treturn state.StepUsage{}, false\n\t}\n\treturn u, true\n}\n\n// Tidy removes the worktree of a closed-out job unless the outcome keeps it\n// (failed, retry, usage-limit, needs-human), and marks the job cleaned when it did. It logs\n// and ignores errors: close-out is already done and retention retries later.\nfunc (f *Finisher) Tidy(ctx context.Context, sj state.Job, h executor.Handle, out closeout.Outcome) {\n\tswitch out {\n\tcase closeout.OutcomeFailed, closeout.OutcomeRetry, closeout.OutcomeLimited, closeout.OutcomeNeedsHuman:\n\t\tif h.JobID != \"\" && f.Cleaner != nil {\n\t\t\tif err := f.Cleaner.Cleanup(ctx, h, executor.CleanupOptions{KeepWorktree: true}); err != nil {\n\t\t\t\tf.log().Warn(\"reaper.cleanup\", \"job\", sj.ID, \"error\", err)\n\t\t\t}\n\t\t}\n\t\treturn\n\t}\n\tif h.JobID != \"\" && f.Cleaner != nil {\n\t\tif err := f.Cleaner.Cleanup(ctx, h, executor.CleanupOptions{}); err != nil {\n\t\t\tf.log().Warn(\"reaper.cleanup\", \"job\", sj.ID, \"error\", err)\n\t\t\treturn\n\t\t}\n\t}\n\tif err := f.Store.MarkCleaned(ctx, sj.ID); err != nil {\n\t\tf.log().Warn(\"reaper.mark_cleaned\", \"job\", sj.ID, \"error\", err)\n\t}\n}\n\n// decodeHandle parses a stored executor handle. A missing or malformed handle\n// counts as no handle.\nfunc decodeHandle(raw json.RawMessage) (executor.Handle, bool) {\n\tif len(raw) == 0 {\n\t\treturn executor.Handle{}, false\n\t}\n\tvar h executor.Handle\n\tif err := json.Unmarshal(raw, &h); err != nil || h.JobID == \"\" {\n\t\treturn executor.Handle{}, false\n\t}\n\treturn h, true\n}\n","numLines":395,"startLine":1,"totalLines":395}},"tool_result_meta":[{"id":"toolu_01KxRcUGU6Ad39aMNu7UwqSG","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
