{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JndHnL7yaJp5M7MXBxMB5n","type":"tool_result","content":"// Package costblock is the ard-owned cost block in an issue body: a marked\n// Markdown table the controller writes from its own records. It renders the\n// table, parses it strictly, strips it (so admission and agents never see it)\n// and splices it back in. It is a leaf: stdlib only, pure apart from Locks.\n//\n// The security rule: only text that parses as exactly the table Render emits\n// is ever treated as ard's. Strip and Cut touch nothing else, so a fake or\n// edited block with prose in it stays visible to the admission hash and to\n// agents, and Splice never overwrites it.\npackage costblock\n\nimport (\n\t\"fmt\"\n\t\"math\"\n\t\"regexp\"\n\t\"strconv\"\n\t\"strings\"\n)\n\nconst (\n\tBegin = \"<!-- ard:cost:begin -->\"\n\tEnd   = \"<!-- ard:cost:end -->\"\n\t// MaxBlockBytes caps the whole block, markers included.\n\tMaxBlockBytes = 5000\n\t// MaxBodyRunes is GitHub's issue body limit.\n\tMaxBodyRunes = 65536\n)\n\n// Tokens are token counts by type.\ntype Tokens struct{ Input, Output, CacheWrite, CacheRead int64 }\n\n// Row is one closed job. Every field is validated by Render; an invalid\n// optional field renders as a dash, so a Row can carry no free text.\ntype Row struct {\n\tStage, Role string   // stage in {triage, worker, review}; role ^[a-z0-9][a-z0-9-]{0,30}$\n\tRun         int      // 1-based ordinal of this stage:role on the issue; \"#k\" shown when > 1\n\tTokens      *Tokens  // nil: dash\n\tCostUSD     *float64 // nil: dash, left out of Total\n\tModels      []string // empty: dash\n\tOutcome     string   // fixed vocabulary\n\tLink        string   // \"\" or a github.com issue/pull URL with an optional fragment\n\tPR          int      // > 0: \" · PR #n\"\n}\n\nconst (\n\tdash       = \"—\"\n\theaderLine = \"**Agent cost** · written by ard from its own records; do not edit: an edited block is kept as text, shown to agents and re-gates the issue. Cost is the agent CLI's list-price estimate, not a bill.\"\n\ttableHead  = \"| agent | tokens | cost | model | comments |\"\n\ttableSep   = \"| --- | --- | --- | --- | --- |\"\n\tmaxNum     = int64(9_999_949_999_999) // largest count num() renders as \"9999.9B\" or less\n\tmaxCost    = 1e9\n\tmaxModels  = 8\n)\n\nvar (\n\troleRE    = regexp.MustCompile(`^[a-z0-9][a-z0-9-]{0,30}$`)\n\tmodelRE   = regexp.MustCompile(`^[A-Za-z0-9._:\\[\\]/-]{1,100}$`)\n\toutcomeRE = regexp.MustCompile(`^(done|changes|stale|needs-human|retry|usage limit|failed: ([a-z_]{1,32}|exit [0-9]{1,3}|result))$`)\n\tlinkRE    = regexp.MustCompile(`^https://github\\.com/[A-Za-z0-9._-]{1,100}/[A-Za-z0-9._-]{1,100}/(issues|pull)/[0-9]{1,9}(#(issuecomment|pullrequestreview)-[0-9]{1,18})?$`)\n\n\tnumPat   = `(?:[0-9]{1,3}|[0-9]{1,4}(?:\\.[0-9])?[kMB])`\n\ttokPat   = `in ` + numPat + ` · out ` + numPat + ` · cache w ` + numPat + ` / r ` + numPat\n\tcostPat  = `\\$[0-9]{1,10}\\.[0-9]{2}`\n\tmodelPat = `[A-Za-z0-9._:\\[\\]/-]{1,100}(?:, [A-Za-z0-9._:\\[\\]/-]{1,100}){0,7}`\n\toutPat   = `(?:done|changes|stale|needs-human|retry|usage limit|failed: (?:[a-z_]{1,32}|exit [0-9]{1,3}|result))`\n\tlinkPat  = `https://github\\.com/[A-Za-z0-9._-]{1,100}/[A-Za-z0-9._-]{1,100}/(?:issues|pull)/[0-9]{1,9}(?:#(?:issuecomment|pullrequestreview)-[0-9]{1,18})?`\n\trowRE    = regexp.MustCompile(`^\\| (?:(?:triage|worker|review):[a-z0-9][a-z0-9-]{0,30}(?: #[0-9]{1,5})?) \\| (?:` + tokPat + `|—) \\| (?:` + costPat + `|—) \\| (?:` + modelPat + `|—) \\| (?:—|(?:\\[` + outPat + `\\]\\(` + linkPat + `\\)|` + outPat + `)(?: · PR #[0-9]{1,9})?) \\|$`)\n\tfoldRE   = regexp.MustCompile(`^\\| \\*earlier jobs \\([0-9]{1,6}\\)\\* \\| (?:` + tokPat + `|—) \\| (?:` + costPat + `|—) \\| — \\| — \\|$`)\n\ttotalRE  = regexp.MustCompile(`^\\| \\*\\*Total\\*\\* \\| \\*\\*(?:` + tokPat + `|—)\\*\\* \\| \\*\\*(?:` + costPat + `|—)\\*\\* \\| — \\| — \\|$`)\n\tstageOK  = map[string]bool{\"triage\": true, \"worker\": true, \"review\": true}\n)\n\n// ValidRow reports whether a row's stage and role are valid; Render drops a\n// row that is not. A caller logs such a row.\nfunc ValidRow(r Row) bool { return stageOK[r.Stage] && roleRE.MatchString(r.Role) }\n// sums accumulates the reported tokens and costs of rows.\ntype sums struct {\n\ttok  Tokens\n\thasT bool\n\tcost float64\n\thasC bool\n}\n\nfunc (s *sums) add(r Row) {\n\tif validTokens(r.Tokens) {\n\t\ts.hasT = true\n\t\ts.tok.Input += r.Tokens.Input\n\t\ts.tok.Output += r.Tokens.Output\n\t\ts.tok.CacheWrite += r.Tokens.CacheWrite\n\t\ts.tok.CacheRead += r.Tokens.CacheRead\n\t}\n\tif validCost(r.CostUSD) {\n\t\ts.hasC = true\n\t\ts.cost += *r.CostUSD\n\t}\n}\n\nfunc (s sums) cells() (tok, cost string) {\n\ttok, cost = dash, dash\n\tif s.hasT && validTokens(&s.tok) {\n\t\ttok = tokText(s.tok)\n\t}\n\tif s.hasC && s.cost < 9_999_999_999 {\n\t\tcost = costText(s.cost)\n\t}\n\treturn\n}\n\nfunc rowLine(r Row) string {\n\tagent := r.Stage + \":\" + r.Role\n\tif r.Run > 1 && r.Run <= 99999 {\n\t\tagent += \" #\" + strconv.Itoa(r.Run)\n\t}\n\ttok, cost := dash, dash\n\tif validTokens(r.Tokens) {\n\t\ttok = tokText(*r.Tokens)\n\t}\n\tif validCost(r.CostUSD) {\n\t\tcost = costText(*r.CostUSD)\n\t}\n\tvar models []string\n\tseen := map[string]bool{}\n\tfor _, m := range r.Models {\n\t\tif modelRE.MatchString(m) && !seen[m] && len(models) < maxModels {\n\t\t\tseen[m] = true\n\t\t\tmodels = append(models, m)\n\t\t}\n\t}\n\tmodel := dash\n\tif len(models) > 0 {\n\t\tmodel = strings.Join(models, \", \")\n\t}\n\tcomments := dash\n\tif outcomeRE.MatchString(r.Outcome) {\n\t\tcomments = r.Outcome\n\t\tif linkRE.MatchString(r.Link) {\n\t\t\tcomments = \"[\" + r.Outcome + \"](\" + r.Link + \")\"\n\t\t}\n\t\tif r.PR > 0 && r.PR <= 999999999 {\n\t\t\tcomments += \" · PR #\" + strconv.Itoa(r.PR)\n\t\t}\n\t}\n\treturn fmt.Sprintf(\"| %s | %s | %s | %s | %s |\", agent, tok, cost, model, comments)\n}\n\nfunc foldLine(k int, s sums) string {\n\ttok, cost := s.cells()\n\treturn fmt.Sprintf(\"| *earlier jobs (%d)* | %s | %s | %s | %s |\", k, tok, cost, dash, dash)\n}\n\nfunc totalLine(s sums) string {\npackage costs\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"log/slog\"\n\n\t\"github.com/albertcbrown/ard/internal/closeout\"\n\t\"github.com/albertcbrown/ard/internal/costblock\"\n)\n\n// rows builds the issue's table rows from state: one per closed job, oldest\n// first. A job whose close-out record cannot be read still gets a row (with no\n// outcome), so its usage is not lost.\nfunc (l *Loop) rows(ctx context.Context, n int, log *slog.Logger) ([]costblock.Row, error) {\n\tjobs, err := l.d.Store.ClosedJobsOf(ctx, n)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tusage, err := l.d.Store.IssueUsage(ctx, n)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\truns := map[string]int{}\n\tvar out []costblock.Row\n\tfor _, j := range jobs {\n\t\tkey := j.Stage + \":\" + j.Role\n\t\truns[key]++\n\t\tr := costblock.Row{Stage: j.Stage, Role: j.Role, Run: runs[key]}\n\t\tif !costblock.ValidRow(r) {\n\t\t\tlog.Warn(\"costs.row_dropped\", \"job\", j.ID, \"stage\", j.Stage)\n\t\t\tcontinue\n\t\t}\n\t\tif u, ok := usage[j.ID]; ok {\n\t\t\tr.Models, r.CostUSD = u.Models, u.CostUSD\n\t\t\tif t := u.Tokens; t != nil {\n\t\t\t\tr.Tokens = &costblock.Tokens{Input: t.Input, Output: t.Output, CacheWrite: t.CacheWrite, CacheRead: t.CacheRead}\n\t\t\t}\n\t\t}\n\t\tf, err := closeout.FactsOf(j)\n\t\tif err != nil {\n\t\t\tlog.Warn(\"costs.facts_unreadable\", \"job\", j.ID, \"error\", err)\n\t\t} else {\n\t\t\tr.Outcome = outcomeText(f)\n\t\t\tr.PR = f.PR\n\t\t\tr.Link = l.link(j.Stage, n, f)\n\t\t}\n\t\tout = append(out, r)\n\t}\n\treturn out, nil\n}\n\n// outcomeText maps a close-out outcome to the table's fixed vocabulary. It\n// never uses Plan.Reason, which can quote agent text.\nfunc outcomeText(f closeout.CostFacts) string {\n\tswitch f.Outcome {\n\tcase closeout.OutcomeDone, closeout.OutcomeChanges, closeout.OutcomeStale, closeout.OutcomeNeedsHuman, closeout.OutcomeRetry:\n\t\treturn string(f.Outcome)\n\tcase closeout.OutcomeLimited:\n\t\treturn \"usage limit\"\n\tcase closeout.OutcomeFailed:\n\t\tswitch {\n\t\tcase f.Cause != \"\":\n\t\t\treturn \"failed: \" + string(f.Cause)\n\t\tcase f.ExitCode >= 1 && f.ExitCode <= 999:\n\t\t\treturn fmt.Sprintf(\"failed: exit %d\", f.ExitCode)\n\t\t}\n\t\treturn \"failed: result\"\n\t}\n\treturn \"\"\n}\n\n// link is where the job's close-out landed, or \"\" when nothing reached GitHub.\nfunc (l *Loop) link(stage string, n int, f closeout.CostFacts) string {\n\tif f.Synthetic || n < 0 || l.d.Effects.DryRun() {\n\t\treturn \"\"\n\t}\n\tbase := \"https://github.com/\" + l.d.Repo.String()\n\tif stage != closeout.StageReview {\n\t\tif f.CommentID > 0 {\n\t\t\treturn fmt.Sprintf(\"%s/issues/%d#issuecomment-%d\", base, n, f.CommentID)\n\t\t}\n\t\treturn fmt.Sprintf(\"%s/issues/%d\", base, n)\n\t}\n\tif f.PR <= 0 {\n\t\treturn \"\"\n\t}\n\tpr := fmt.Sprintf(\"%s/pull/%d\", base, f.PR)\n\tswitch {\n\tcase f.CommentID > 0 && (f.ReviewMode == closeout.ReviewInline || f.ReviewMode == closeout.ReviewBody):\n\t\treturn fmt.Sprintf(\"%s#pullrequestreview-%d\", pr, f.CommentID)\n\tcase f.CommentID > 0 && f.ReviewMode == closeout.ReviewComment:\n\t\treturn fmt.Sprintf(\"%s#issuecomment-%d\", pr, f.CommentID)\n\t}\n\treturn pr // ReviewFound: the id may be a review or a comment\n}\npackage closeout\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"time\"\n)\n\n// usageSchema is the version of the tracking file format.\nconst usageSchema = 1\n\n// usageFile is .ard/<issue#>/costs/<job-id>.json. The controller writes it, one\n// per job, so each file has exactly one writer. It holds no free text: every\n// string is a job id, a stage or role from config, a fixed outcome or cause\n// word, a validated model id or an RFC 3339 time.\ntype usageFile struct {\n\tSchema    int         `json:\"schema\"`\n\tJob       string      `json:\"job\"`\n\tIssue     int         `json:\"issue\"`\n\tPR        int         `json:\"pr,omitempty\"`\n\tStage     string      `json:\"stage\"`\n\tRole      string      `json:\"role\"`\n\tAttempt   int         `json:\"attempt\"`\n\tOutcome   string      `json:\"outcome\"`\n\tCause     string      `json:\"cause,omitempty\"`\n\tModels    []string    `json:\"models\"`\n\tTokens    *usageToken `json:\"tokens\"`\n\tCostUSD   *float64    `json:\"cost_usd\"`\n\tSteps     int         `json:\"steps\"`\n\tStartedAt *string     `json:\"started_at\"`\n\tEndedAt   string      `json:\"ended_at\"`\n}\n\ntype usageToken struct {\n\tInput      int64 `json:\"input\"`\n\tOutput     int64 `json:\"output\"`\n\tCacheWrite int64 `json:\"cache_write\"`\n\tCacheRead  int64 `json:\"cache_read\"`\n}\n\n// usagePath is the repo path of a job's tracking file.\nfunc usagePath(n int, jobID string) string {\n\treturn fmt.Sprintf(\".ard/%d/costs/%s.json\", n, jobID)\n}\n\n// stageUsage stages the job's tracking file. It is controller-written and is\n// never checked against the agent allowlist (WritableFor): an agent write to\n// this path is denied like any other path outside the allowlist.\nfunc stageUsage(stage string, j Job, n int, plan Plan, now time.Time) (FileRef, error) {\n\tf := usageFile{Schema: usageSchema, Job: j.ID, Issue: n, PR: j.PR, Stage: j.Stage, Role: j.Role,\n\t\tAttempt: j.Attempt, Outcome: string(plan.Outcome), Cause: string(j.Cause.Kind),\n\t\tModels: j.Usage.Models, CostUSD: j.Usage.CostUSD, Steps: j.Usage.Steps,\n\t\tEndedAt: now.UTC().Format(time.RFC3339)}\n\tif f.Models == nil {\n\t\tf.Models = []string{}\n\t}\n\tif t := j.Usage.Tokens; t != nil {\n\t\tf.Tokens = &usageToken{t.Input, t.Output, t.CacheWrite, t.CacheRead}\n\t}\n\tif !j.StartedAt.IsZero() {\n\t\ts := j.StartedAt.UTC().Format(time.RFC3339)\n\t\tf.StartedAt = &s\n\t}\n\tb, err := json.MarshalIndent(f, \"\", \"  \")\n\tif err != nil {\n\t\treturn FileRef{}, fmt.Errorf(\"closeout job %s: usage file: %w\", j.ID, err)\n\t}\n\tref, err := stageFile(stage, usageP