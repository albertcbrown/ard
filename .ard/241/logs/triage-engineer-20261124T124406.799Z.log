{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Vz5Zw8PZUgTqS1aG4UeWVv","type":"tool_result","content":"package closeout\n\nimport (\n\t\"fmt\"\n\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// CostFacts is what the cost table shows of one closed job. It holds no agent\n// text: an outcome and cause word, an exit code, ids and a review mode.\ntype CostFacts struct {\n\tOutcome    Outcome\n\tCause      CauseKind\n\tExitCode   int\n\tPR         int   // the job's PR, or the one a worker opened; 0 when none\n\tCommentID  int64 // the posted comment or review; 0 when none\n\tReviewMode string\n\t// Synthetic is true for a dry-run close-out: nothing reached GitHub, so\n\t// there is nothing to link to.\n\tSynthetic bool\n}\n\n// FactsOf decodes the stored close-out record of a closed job. It is an error\n// for a job whose close-out is not closed.\nfunc FactsOf(sj state.Job) (CostFacts, error) {\n\trec, err := decode(sj)\n\tif err != nil {\n\t\treturn CostFacts{}, err\n\t}\n\tif rec.Phase != PhaseClosed {\n\t\treturn CostFacts{}, fmt.Errorf(\"closeout job %s: facts: phase %q is not closed\", sj.ID, rec.Phase)\n\t}\n\tf := CostFacts{Outcome: rec.Plan.Outcome, Cause: rec.Job.Cause.Kind, ExitCode: rec.Job.ExitCode,\n\t\tPR: rec.Job.PR, CommentID: rec.CommentID, ReviewMode: rec.ReviewMode, Synthetic: rec.Synthetic}\n\tif f.PR == 0 && rec.Job.Worker != nil {\n\t\tf.PR = rec.Job.Worker.PR\n\t}\n\tif f.PR == 0 {\n\t\tf.PR = sj.PR\n\t}\n\treturn f, nil\n}\n\tHome    string\n\tBaseSHA string // executor handle BaseSHA: what the worktree started from\n\tLogPath string // executor handle LogPath; \"\" when there is no log\n\t// Scrubbed is copied from the executor handle: the paths it removed from\n\t// the worktree before the agent ran. An unchanged role file is trusted\n\t// only if listed here.\n\tScrubbed []string\n\tExitCode int\n\tCostUSD  float64 // 0 when unknown\n\t// Cause, when Kind is set, says why the job ended without a usable result.\n\t// Close-out then skips the role file and the changed files and commits only\n\t// the log. The zero Cause decides from the role file and exit code.\n\tCause Cause\n\t// Worker is the worker loop's result: the PR, reviewers and test outcome.\n\t// nil for every other job; a done worker job without it needs a human.\n\tWorker *WorkerResult\n\t// ExtraLogs are further host logs to redact and commit beside LogPath: the\n\t// earlier agent steps of a worker job. A withheld one holds the job.\n\tExtraLogs []string\n\t// Review is the reviewer loop's context: the added lines for inline\n\t// placement and whether the PR head moved. nil for every other job, and\n\t// for a review closed out by the Reaper after a restart.\n\tReview *ReviewContext\n\t// Usage is the job's agent usage summed over its steps (from state). The\n\t// zero value renders as \"not reported\".\n\tUsage Usage\n\t// StartedAt is when the job was created; zero when unknown.\n\tStartedAt time.Time\n}\n\n// Tokens are token counts by type; it mirrors state.Tokens.\ntype Tokens struct{ Input, Output, CacheWrite, CacheRead int64 }\n\n// Usage is the job's agent usage summed over its steps (from state).\ntype Usage struct {\n\tModels  []string `json:\",omitempty\"`\n\tTokens  *Tokens  `json:\",omitempty\"`\n\tCostUSD *float64 `json:\",omitempty\"`\n\tSteps   int      `json:\",omitempty\"`\n}\n\n// CauseKind names why a job ended without a usable result.\ntype CauseKind string\n\n// Cause kinds. The reason in the comment is \"<kind>: <detail>\".\nconst (\n\tCauseQuiet     CauseKind = \"heartbeat_quiet\"    // no log output for 10 minutes\n\tCauseDeadline  CauseKind = \"deadline\"           // ran past its timeout\n\tCauseRestart   CauseKind = \"controller_restart\" // orphaned, gone or never started across a restart\n\tCauseNoProcess CauseKind = \"no_process\"         // never started, or its process vanished in this run\n\tCauseRateLimit CauseKind = \"rate_limit\"         // the agent reported a transient API error\n19:func marker(jobID string, attempt int) string {\n23:func markerFor(jobID string) string { return markerPrefix + jobID + \" \" }\n28:func Sanitize(s string) string { return sanitize(s) }\n31:func sanitize(s string) string {\n44:func isAlnum(r rune) bool {\n49:func codeSpan(s string, max int) string {\n58:func cutSummary(s string) string {\n70:func headerWord(p Plan) string {\n88:func fenceFor(s string) string {\n104:func evidenceLines(r Record) (before []string, tail string) {\n132:func limitLine(c Cause) string {\n146:func RenderComment(r Record, repo github.Repo, dryRun bool) string {\n194:func outputLine(r Record, repo github.Repo, dryRun bool) string {\n(eval):1: no matches found: --include=*.go","is_error":false}]},"parent_tool_use_id":null,"session_id":"d12672c4-d664-4d87-be30-0dbe1fb67dc9","uuid":"a21ab766-fec9-4236-affd-7126f2cd203c","timestamp":"2026-11-24T12:44:19.853Z","tool_use_result":{"stdout":"package closeout\n\nimport (\n\t\"fmt\"\n\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// CostFacts is what the cost table shows of one closed job. It holds no agent\n// text: an outcome and cause word, an exit code, ids and a review mode.\ntype CostFacts struct {\n\tOutcome    Outcome\n\tCause      CauseKind\n\tExitCode   int\n\tPR         int   // the job's PR, or the one a worker opened; 0 when none\n\tCommentID  int64 // the posted comment or review; 0 when none\n\tReviewMode string\n\t// Synthetic is true for a dry-run close-out: nothing reached GitHub, so\n\t// there is nothing to link to.\n\tSynthetic bool\n}\n\n// FactsOf decodes the stored close-out record of a closed job. It is an error\n// for a job whose close-out is not closed.\nfunc FactsOf(sj state.Job) (CostFacts, error) {\n\trec, err := decode(sj)\n\tif err != nil {\n\t\treturn CostFacts{}, err\n\t}\n\tif rec.Phase != PhaseClosed {\n\t\treturn CostFacts{}, fmt.Errorf(\"closeout job %s: facts: phase %q is not closed\", sj.ID, rec.Phase)\n\t}\n\tf := CostFacts{Outcome