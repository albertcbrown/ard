{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019u5zMVhUtFjWThZpnBwsgy","type":"tool_result","content":"package closeout\n\nimport (\n\t\"fmt\"\n\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// CostFacts is what the cost table shows of one closed job. It holds no agent\n// text: an outcome and cause word, an exit code, ids and a review mode.\ntype CostFacts struct {\n\tOutcome    Outcome\n\tCause      CauseKind\n\tExitCode   int\n\tPR         int   // the job's PR, or the one a worker opened; 0 when none\n\tCommentID  int64 // the posted comment or review; 0 when none\n\tReviewMode string\n\t// Synthetic is true for a dry-run close-out: nothing reached GitHub, so\n\t// there is nothing to link to.\n\tSynthetic bool\n\t// TokensUnreported: the job ended without reporting tokens.\n\tTokensUnreported bool\n}\n\n// FactsOf decodes the stored close-out record of a closed job. It is an error\n// for a job whose close-out is not closed.\nfunc FactsOf(sj state.Job) (CostFacts, error) {\n\trec, err := decode(sj)\n\tif err != nil {\n\t\treturn CostFacts{}, err\n\t}\n\tif rec.Phase != PhaseClosed {\n\t\treturn CostFacts{}, fmt.Errorf(\"closeout job %s: facts: phase %q is not closed\", sj.ID, rec.Phase)\n\t}\n\tf := CostFacts{Outcome: rec.Plan.Outcome, Cause: rec.Job.Cause.Kind, ExitCode: rec.Job.ExitCode,\n\t\tPR: rec.Job.PR, CommentID: rec.CommentID, ReviewMode: rec.ReviewMode, Synthetic: rec.Synthetic, TokensUnreported: rec.Job.TokensUnreported}\n\tif f.PR == 0 && rec.Job.Worker != nil {\n\t\tf.PR = rec.Job.Worker.PR\n\t}\n\tif f.PR == 0 {\n\t\tf.PR = sj.PR\n\t}\n\treturn f, nil\n}\npackage costs\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"log/slog\"\n\n\t\"github.com/albertcbrown/ard/internal/closeout\"\n\t\"github.com/albertcbrown/ard/internal/costblock\"\n)\n\n// rows builds the issue's table rows from state: one per closed job, oldest\n// first. A job whose close-out record cannot be read still gets a row (with no\n// outcome), so its usage is not lost.\nfunc (l *Loop) rows(ctx context.Context, n int, log *slog.Logger) ([]costblock.Row, error) {\n\tjobs, err := l.d.Store.ClosedJobsOf(ctx, n)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tusage, err := l.d.Store.IssueUsage(ctx, n)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\truns := map[string]int{}\n\tvar out []costblock.Row\n\tfor _, j := range jobs {\n\t\tkey := j.Stage + \":\" + j.Role\n\t\truns[key]++\n\t\tr := costblock.Row{Stage: j.Stage, Role: j.Role, Run: runs[key]}\n\t\tif !costblock.ValidRow(r) {\n\t\t\tlog.Warn(\"costs.row_dropped\", \"job\", j.ID, \"stage\", j.Stage)\n\t\t\tcontinue\n\t\t}\n\t\tif u, ok := usage[j.ID]; ok {\n\t\t\tr.Models, r.CostUSD = u.Models, u.CostUSD\n\t\t\tif t := u.Tokens; t != nil {\n\t\t\t\tr.Tokens = &costblock.Tokens{Input: t.Input, Output: t.Output, CacheWrite: t.CacheWrite, CacheRead: t.CacheRead}\n\t\t\t}\n\t\t}\n\t\tf, err := closeout.FactsOf(j)\n\t\tif err != nil {\n\t\t\tlog.Warn(\"costs.facts_unreadable\", \"job\", j.ID, \"error\", err)\n\t\t} else {\n\t\t\tr.Outcome = outcomeText(f)\n\t\t\tr.PR = f.PR\n\t\t\tr.Link = l.link(j.Stage, n, f)\n\t\t\tr.TokensUnreported = f.TokensUnreported\n\t\t}\n\t\tout = append(out, r)\n\t}\n\treturn out, nil\n}\n\n// outcomeText maps a close-out outcome to the table's fixed vocabulary. It\n// never uses Plan.Reason, which can quote agent text.\nfunc outcomeText(f closeout.CostFacts) string {\n\tswitch f.Outcome {\n\tcase closeout.OutcomeDone, closeout.OutcomeChanges, closeout.OutcomeStale, closeout.OutcomeNeedsHuman, closeout.OutcomeRetry:\n\t\treturn string(f.Outcome)\n\tcase closeout.OutcomeLimited:\n\t\treturn \"usage limit\"\n\tcase closeout.OutcomeFailed:\n\t\tswitch {\n\t\tcase f.Cause != \"\":\n\t\t\treturn \"failed: \" + string(f.Cause)\n\t\tcase f.ExitCode >= 1 && f.ExitCode <= 999:\n\t\t\treturn fmt.Sprintf(\"failed: exit %d\", f.ExitCode)\n\t\t}\n\t\treturn \"failed: result\"\n\t}\n\treturn \"\"\n}\n\n// link is where the job's close-out landed, or \"