  = `\\$[0-9]{1,10}\\.[0-9]{2}`\n\tmodelPat = `[A-Za-z0-9._:\\[\\]/-]{1,100}(?:, [A-Za-z0-9._:\\[\\]/-]{1,100}){0,7}`\n\toutPat   = `(?:done|changes|stale|needs-human|retry|usage limit|failed: (?:[a-z_]{1,32}|exit [0-9]{1,3}|result))`\n\tlinkPat  = `https://github\\.com/[A-Za-z0-9._-]{1,100}/[A-Za-z0-9._-]{1,100}/(?:issues|pull)/[0-9]{1,9}(?:#(?:issuecomment|pullrequestreview)-[0-9]{1,18})?`\n\trowRE    = regexp.MustCompile(`^\\| (?:(?:triage|worker|review):[a-z0-9][a-z0-9-]{0,30}(?: #[0-9]{1,5})?) \\| (?:` + tokPat + `|—) \\| (?:` + costPat + `|—) \\| (?:` + modelPat + `|—) \\| (?:—|(?:\\[` + outPat + `\\]\\(` + linkPat + `\\)|` + outPat + `)(?: · PR #[0-9]{1,9})?) \\|$`)\n\tfoldRE   = regexp.MustCompile(`^\\| \\*earlier jobs \\([0-9]{1,6}\\)\\* \\| (?:` + tokPat + `|—) \\| (?:` + costPat + `|—) \\| — \\| — \\|$`)\n\ttotalRE  = regexp.MustCompile(`^\\| \\*\\*Total\\*\\* \\| \\*\\*(?:` + tokPat + `|—)\\*\\* \\| \\*\\*(?:` + costPat + `|—)\\*\\* \\| — \\| — \\|$`)\n\tstageOK  = map[string]bool{\"triage\": true, \"worker\": true, \"review\": true}\n)\n\n// ValidRow reports whether a row's stage and role are valid; Render drops a\n// row that is not. A caller logs such a row.\nfunc ValidRow(r Row) bool { return stageOK[r.Stage] && roleRE.MatchString(r.Role) }\n\n// num formats a count: an integer below 1000, else one decimal (\".0\" dropped)\n// with k, M or B, promoting when rounding reaches 1000.\nfunc num(n int64) string {\n\tif n < 1000 {\n\t\treturn strconv.FormatInt(n, 10)\n\t}\n\tu := uint64(n)\n\tunits := []struct {\n\t\tdiv uint64 // one tenth of the unit\n\t\tsuf string\n\t}{{100, \"k\"}, {100000, \"M\"}, {100000000, \"B\"}}\n\tfor i, un := range units {\n\t\tt := (u + un.div/2) / un.div // tenths of the unit\n\t\tif t >= 10000 && i < len(units)-1 {\n\t\t\tcontinue\n\t\t}\n\t\ts := strconv.FormatUint(t/10, 10)\n\t\tif t%10 != 0 {\n\t\t\ts += \".\" + strconv.FormatUint(t%10, 10)\n\t\t}\n\t\treturn s + un.suf\n\t}\n\treturn \"\" // unreachable\n}\n\nfunc tokText(t Tokens) string {\n\treturn fmt.Sprintf(\"in %s · out %s · cache w %s / r %s\", num(t.Input), num(t.Output), num(t.CacheWrite), num(t.CacheRead))\n}\n\nfunc validTokens(t *Tokens) bool {\n\tif t == nil {\n\t\treturn false\n\t}\n\tfor _, v := range []int64{t.Input, t.Output, t.CacheWrite, t.CacheRead} {\n\t\tif v < 0 || v > maxNum {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc validCost(c *float64) bool {\n\treturn c != nil && !math.IsNaN(*c) && *c >= 0 && *c < maxCost\n}\n\n// costText formats a cost; c+0 turns -0 into 0.\nfunc costText(c float64) string { return fmt.Sprintf(\"$%.2f\", c+0) }\n\n// sums accumulates the reported tokens and costs of rows.\ntype sums struct {\n\ttok  Tokens\n\thasT bool\n\tcost float64\n\thasC bool\n}\n\nfunc (s *sums) add(r Row) {\n\tif validTokens(r.Tokens) {\n\t\ts.hasT = true\n\t\ts.tok.Input += r.Tokens.Input\n\t\ts.tok.Output += r.Tokens.Output\n\t\ts.tok.CacheWrite += r.Tokens.CacheWrite\n\t\ts.tok.CacheRead += r.Tokens.CacheRead\n\t}\n\tif validCost(r.CostUSD) {\n\t\ts.hasC = true\n\t\ts.cost += *r.CostUSD\n\t}\n}\n\nfunc (s sums) cells() (tok, cost string) {\n\ttok, cost = dash, dash\n\tif s.hasT && validTokens(&s.tok) {\n\t\ttok = tokText(s.tok)\n\t}\n\tif s.hasC && s.cost < 9_999_999_999 {\n\t\tcost = costText(s.cost)\n\t}\n\treturn\n}\n\nfunc rowLine(r Row) string {\n\tagent := r.Stage + \":\" + r.Role\n\tif r.Run > 1 && r.Run <= 99999 {\n\t\tagent += \" #\" + strconv.Itoa(r.Run)\n\t}\n\ttok, cost := dash, dash\n\tif validTokens(r.Tokens) {\n\t\ttok = tokText(*r.Tokens)\n\t}\n\tif validCost(r.CostUSD) {\n\t\tcost = costText(*r.CostUSD)\n\t}\n\tvar models []string\n\tseen := map[string]bool{}\n\tfor _, m := range r.Models {\n\t\tif modelRE.MatchString(m) && !seen[m] && len(models) < maxModels {\n\t\t\tseen[m] = true\n\t\t\tmodels = append(models, m)\n\t\t}\n\t}\n\tmodel := dash\n\tif len(models) > 0 {\n\t\tmodel = strings.Join(models, \", \")\n\t}\n\tcomments := dash\n\tif outcomeRE.MatchString(r.Outcome) {\n\t\tcomments = r.Outcome\n\t\tif linkRE.MatchString(r.Link) {\n\t\t\tcomments = \"[\" + r.Outcome + \"](\" + r.Link + \")\"\n\t\t}\n\t\tif r.PR > 0 && r.PR <= 999999999 {\n\t\t\tcomments += \" · PR #\" + strconv.Itoa(r.PR)\n\t\t}\n\t}\n\treturn fmt.Sprintf(\"| %s | %s | %s | %s | %s |\", agent, tok, cost, model, comments)\n}\n\nfunc foldLine(k int, s sums) string {\n\ttok, cost := s.cells()\n\treturn fmt.Sprintf(\"| *earlier jobs (%d)* | %s | %s | %s | %s |\", k, tok, cost, dash, dash)\n}\n\nfunc totalLine(s sums) string {\n\ttok, cost := s.cells()\n\treturn fmt.Sprintf(\"| **Total** | **%s** | **%s** | %s | %s |\", tok, cost, dash, dash)\n}\n\n// Render returns the whole block, markers included, at most maxBytes long. It\n// folds the oldest rows into one \"earlier jobs (k)\" row until it fits; Total\n// always covers every row. Rows with an invalid stage or role are dropped.\n// ok is false when no row is left or even the fully folded block does not fit.\n// Render never emits a block Valid rejects.\nfunc Render(rows []Row, maxBytes int) (block string, folded int, ok bool) {\n\tvar kept []Row\n\tfor _, r := range rows {\n\t\tif ValidRow(r) {\n\t\t\tkept = append(kept, r)\n\t\t}\n\t}\n\tif len(kept) == 0 {\n\t\treturn \"\", 0, false\n\t}\n\tlines := make([]string, len(kept))\n\tvar total sums\n\tfor i, r := range kept {\n\t\tlines[i] = rowLine(r)\n\t\ttotal.add(r)\n\t}\n\ttl := totalLine(total)\n\tpre := Begin + \"\\n\" + headerLine + \"\\n\\n\" + tableHead + \"\\n\" + tableSep + \"\\n\"\n\tpost := tl + \"\\n\" + End\n\tsize := len(pre) + len(post)\n\trest := 0\n\tfor _, l := range lines {\n\t\trest += len(l) + 1\n\t}\n\tvar fold sums\n\tfor k := 0; k <= len(kept); k++ {\n\t\tif k > 0 {\n\t\t\tfold.add(kept[k-1])\n\t\t\trest -= len(lines[k-1]) + 1\n\t\t}\n\t\tfl := 0\n\t\tif k > 0 {\n\t\t\tfl = len(foldLine(k, fold)) + 1\n\t\t}\n\t\tif size+fl+rest > maxBytes {\n\t\t\tcontinue\n\t\t}\n\t\tvar b strings.Builder\n\t\tb.WriteString(pre)\n\t\tif k > 0 {\n\t\t\tb.WriteString(foldLine(k, fold) + \"\\n\")\n\t\t}\n\t\tfor _, l := range lines[k:] {\n\t\t\tb.WriteString(l + \"\\n\")\n\t\t}\n\t\tb.WriteString(post)\n\t\treturn b.String(), k, true\n\t}\n\treturn \"\", 0, false\n}\n\n// Valid reports whether the text between the markers is exactly a table\n// Render could emit. LF or CRLF line ends are both accepted.\nfunc Valid(inner string) bool {\n\tif strings.Contains(inner, \"\\r\\n\") {\n\t\tinner = strings.ReplaceAll(inner, \"\\r\\n\", \"\\n\")\n\t}\n\tif strings.ContainsRune(inner, '\\r') || len(inner) < 2 || inner[0] != '\\n' || inner[len(inner)-1] != '\\n' {\n\t\treturn false\n\t}\n\tif len(inner)+len(Begin)+len(End) > MaxBlockBytes {\n\t\treturn false\n\t}\n\tls := strings.Split(inner[1:len(inner)-1], \"\\n\")\n\tif len(ls) < 6 || ls[0] != headerLine || ls[1] != \"\" || ls[2] != tableHead || ls[3] != tableSep || !totalRE.MatchString(ls[len(ls)-1]) {\n\t\treturn false\n\t}\n\tmid := ls[4 : len(ls)-1]\n\tfor i, l := range mid {\n\t\tif rowRE.MatchString(l) || (i == 0 && foldRE.MatchString(l)) {\n\t\t\tcontinue\n\t\t}\n\t\treturn false\n\t}\n\treturn true\n}\n\n// Locate finds the owned region: e is the last End and s the last Begin before\n// it. sepStart is the start of the \"\\n\\n\" or \"\\r\\n\\r\\n\" directly before s (s\n// itself when there is none). end is the index just past End.\nfunc Locate(body string) (sepStart, start, end int, ok bool) {\n\te := strings.LastIndex(body, End)\n\tif e < 0 {\n\t\treturn 0, 0, 0, false\n\t}\n\ts := strings.LastIndex(body[:e], Begin)\n\tif s < 0 {\n\t\treturn 0, 0, 0, false\n\t}\n\tsep := s\n\tswitch {\n\tcase strings.HasSuffix(body[:s], \"\\r\\n\\r\\n\"):\n\t\tsep = s - 4\n\tcase strings.HasSuffix(body[:s], \"\\n\\n\"):\n\t\tsep = s - 2\n\t}\n\treturn sep, s, e + len(End), true\n}\n\n// locateValid is Locate, only when the region parses as ard's own table.\nfunc locateValid(body string) (sepStart, start, end int, ok bool) {\n\tsepStart, start, end, ok = Locate(body)\n\tif !ok || !Valid(body[start+len(Begin):end-len(End)]) {\n\t\treturn 0, 0, 0, false\n\t}\n\treturn\n}\n\n// Region returns the located region (markers included) when it parses as\n// ard's table, else \"\".\nfunc Region(body string) string {\n\t_, s, e, ok := locateValid(body)\n\tif !ok {\n\t\treturn \"\"\n\t}\n\treturn body[s:e]\n}\n\n// Strip removes the located region and its separator, only when it is Valid.\n// Otherwise it returns body unchanged, so a body without ard's block hashes and\n// reads exactly as before.\nfunc Strip(body string) string {\n\trest, _ := Cut(body)\n\treturn rest\n}\n\n// Cut splits a valid region (with its separator) off body: rest is body without\n// it and region is the removed text, \"\" when there is none (rest is then body).\nfunc Cut(body string) (rest, region string) {\n\tsep, _, end, ok := locateValid(body)\n\tif !ok {\n\t\treturn body, \"\"\n\t}\n\treturn body[:sep] + body[end:], body[sep:end]\n}\n\n// Splice puts block in place of the region when that region is ard's own\n// (Valid). A located region that is not ard's table is human text: it is kept\n// and block is appended after it, so no human text is ever dropped. With no\n// region it returns body + \"\\n\\n\" + block (just block for an empty body).\nfunc Splice(body, block string) string {\n\tif _, s, e, ok := locateValid(body); ok {\n\t\treturn body[:s] + block + body[e:]\n\t}\n\tif body == \"\" {\n\t\treturn block\n\t}\n\treturn body + \"\\n\\n\" + block\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"2ace8dd2-933b-4fc0-ae77-c8187a5d1366","uuid":"0251fa70-7b09-411a-b455-a18334bc3c24","timestamp":"2026-11-24T19:05:10.487Z","tool_use_result":{"stdout":"package config\n\nimport (\n\t\"fmt\"\n\t\"regexp\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\n\t\"gopkg.in/yaml.v3\"\n)\n\n// Duration is a time.Duration that unmarshals from YAML strings such as\n// \"15m\", \"4h\", \"30d\" or \"1w\" (see ParseDuration) and marshals back to the\n// same compact form.\ntype Duration time.Duration\n\n// durationToken matches one number-plus-unit component of a duration.\nvar durationToken = regexp.MustCompile(`^([0-9]+(?:\\.[0-9]+)?)(ns|us|µs|ms|s|m|h|d|w)`)\n\n// ParseDuration parses time.ParseDuration syntax extended with d (24 h) and\n// w (7 d), including compound values (\"1h30m\", \"7d\"). It rejects empty\n// strings, bare numbers (\"30\"), negatives, zero, fractional d/w values and\n// anything under one second; every error names the offending string.\nfunc ParseDuration(s string) (time.Duration, error) {\n\tif s == \"\" {\n\t\treturn 0, fmt.Errorf(\"invalid duration %q: empty\", s)\n\t}\n\tif strings.HasPrefix(s, \"-\") {\n\t\treturn 0, fmt.Errorf(\"invalid duration %q: negative durations are not allowed\", s)\n\t}\n\trest := s\n\tvar total time.Duration\n\tfor rest != \"\" {\n\t\tm := durationToken.FindStringSubmatch(rest)\n\t\tif m == nil {\n\t\t\treturn 0, fmt.Errorf(\"invalid duration %q: expected a duration like %q, %q or %q\", s, \"30m\", \"4h\", \"7d\")\n\t\t}\n\t\tn, err := strconv.ParseFloat(m[1], 64)\n\t\tif err != nil {\n\t\t\treturn 0, fmt.Errorf(\"invalid duration %q: %v\", s, err)\n\t\t}\n\t\tvar unit time.Duration\n\t\tswitch m[2] {\n\t\tcase \"ns\":\n\t\t\tunit = time.Nanosecond\n\t\tcase \"us\", \"µs\":\n\t\t\tunit = time.Microsecond\n\t\tcase \"ms\":\n\t\t\tunit = time.Millisecond\n\t\tcase \"s\":\n\t\t\tunit = time.Second\n\t\tcase \"m\":\n\t\t\tunit = time.Minute\n\t\tcase \"h\":\n\t\t\tunit = time.Hour\n\t\tcase \"d\":\n\t\t\tif strings.Contains(m[1], \".\") {\n\t\t\t\treturn 0, fmt.Errorf(\"invalid duration %q: %q does not take a fractional value\", s, m[2])\n\t\t\t}\n\t\t\tunit = 24 * time.Hour\n\t\tcase \"w\":\n\t\t\tif strings.Contains(m[1], \".\") {\n\t\t\t\treturn 0, fmt.Errorf(\"invalid duration %q: %q does not take a fractional value\", s, m[2])\n\t\t\t}\n\t\t\tunit = 7 * 24 * time.Hour\n\t\t}\n\t\ttotal += time.Duration(n * float64(unit))\n\t\trest = rest[len(m[0]):]\n\t}\n\tif total == 0 {\n\t\treturn 0, fmt.Errorf(\"invalid duration %q: must be greater than zero\", s)\n\t}\n\tif total < time.Second {\n\t\treturn 0, fmt.Errorf(\"invalid duration %q: must be at least 1s\", s)\n\t}\n\treturn total, nil\n}\n\n// String renders d in the compact unit form accepted by ParseDuration.\nfunc (d Duration) String() string {\n\tt := time.Duration(d)\n\tswitch {\n\tcase t == 0:\n\t\treturn \"0s\"\n\tcase t%(7*24*time.Hour) == 0:\n\t\treturn fmt.Sprintf(\"%dw\", t/(7*24*time.Hour))\n\tcase t%(24*time.Hour) == 0:\n\t\treturn fmt.Sprintf(\"%dd\", t/(24*time.Hour))\n\tcase t%time.Hour == 0:\n\t\treturn fmt.Sprintf(\"%dh\", t/time.Hour)\n\tdefault:\n\t\th := t / time.Hour\n\t\trest := t % time.Hour\n\t\tif rest%time.Minute == 0 {\n\t\t\tif h > 0 {\n\t\t\t\treturn fmt.Sprintf(\"%dh%dm\", h, rest/time.Minute)\n\t\t\t}\n\t\t\treturn fmt.Sprintf(\"%dm\", rest/time.Minute)\n\t\t}\n\t\tif h > 0 {\n\t\t\treturn fmt.Sprintf(\"%dh%s\", h, rest.String())\n\t\t}\n\t\tif m := t / time.Minute; m > 0 {\n\t\t\treturn fmt.Sprintf(\"%dm%s\", m, (t % time.Minute).String())\n\t\t}\n\t\treturn t.String()\n\t}\n}\n\n// UnmarshalYAML accepts only scalar strings; numbers, booleans and\n// collections are rejected with a message naming what was found.\nfunc (d *Duration) UnmarshalYAML(value *yaml.Node) error {\n\tif value.Kind != yaml.ScalarNode {\n\t\treturn fmt.Errorf(\"expected a duration string like %q, got %s\", \"15m\", nodeKindName(value))\n\t}\n\tswitch value.Tag {\n\tcase \"!!null\":\n\t\t*d = 0\n\t\treturn nil\n\tcase \"!!str\":\n\t\tparsed, err := ParseDuration(value.Value)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\t*d = Duration(parsed)\n\t\treturn nil\n\tcase \"!!int\":\n\t\treturn fmt.Errorf(\"expected a duration string like %q, got integer %s\", \"15m\", value.Value)\n\tcase \"!!float\":\n\t\treturn fmt.Errorf(\"expected a duration string like %q, got float %s\", \"15m\", value.Value)\n\tcase \"!!bool\":\n\t\treturn fmt.Errorf(\"expected a duration string like %q, got boolean %s\", \"15m\", value.Value)\n\tdefault:\n\t\treturn fmt.Errorf(\"expected a duration string like %q, got a value of type %s\", \"15m\", value.Tag)\n\t}\n}\n\n// MarshalYAML renders d as its compact string form.\nfunc (d Duration) MarshalYAML() (any, error) { return d.String(), nil }\n\nfunc nodeKindName(n *yaml.Node) string {\n\tswitch n.Kind {\n\tcase yaml.MappingNode:\n\t\treturn \"a mapping\"\n\tcase yaml.SequenceNode:\n\t\treturn \"a sequence\"\n\tcase yaml.AliasNode:\n\t\treturn \"an alias\"\n\tdefault:\n\t\treturn fmt.Sprintf(\"tag %s\", n.Tag)\n\t}\n}\n(eval):1: no matches found: --include=*.go\n\t}\n\treturn out, nil\n}\n\n// Spend is money spent over a period: USD sums the priced steps; Unpriced\n// counts steps that reported no cost (they add nothing to USD).\ntype Spend struct {\n\tUSD      float64\n\tUnpriced int\n}\n\n// RoleKey names a role in spend totals. The stage is part of the key because\n// a role name can be shared by a triage role and a worker role.\ntype RoleKey struct{ Stage, Role string }\n\n// SpendSince sums step usage recorded at or after dayStart, per (stage, role)\n// and for the whole repo.\nfunc (s *Store) SpendSince(ctx context.Context, dayStart time.Time) (map[RoleKey]Spend, Spend, error) {\n\treturn s.spendBetween(ctx, dayStart, time.Time{})\n}\n\n// SpendBetween is SpendSince over the half-open window [from, to).\nfunc (s *Store) SpendBetween(ctx context.Context, from, to time.Time) (map[RoleKey]Spend, Spend, error) {\n\treturn s.spendBetween(ctx, from, to)\n}\n\n// spendBetween sums usage recorded in [dayStart, until); a zero until is open.\nfunc (s *Store) spendBetween(ctx context.Context, dayStart, until time.Time) (map[RoleKey]Spend, Spend, error) {\n\tupper := int64(math.MaxInt64)\n\tif !until.IsZero() {\n\t\tupper = until.Unix()\n\t}\n\trows, err := s.db.QueryContext(ctx, `SELECT j.stage, j.role, COALESCE(SUM(u.cost_usd), 0), COALESCE(SUM(u.cost_usd IS NULL), 0)\n\t\tFROM step_usage u JOIN jobs j ON j.id = u.job_id\n\t\tWHERE u.recorded_at >= ? AND u.recorded_at < ? GROUP BY j.stage, j.role`, dayStart.Unix(), upper)\n\tif err != nil {\n\t\treturn nil, Spend{}, fmt.Errorf(\"spend since %s: %w\", dayStart.UTC().Format(time.RFC3339), err)\n\t}\n\tdefer rows.Close()\n\tper := map[RoleKey]Spend{}\n\tvar repo Spend\n\tfor rows.Next() {\n\t\tvar k RoleKey\n\t\tvar sp Spend\n\t\tif err := rows.Scan(&k.Stage, &k.Role, &sp.USD, &sp.Unpriced); err != nil {\n\t\t\treturn nil, Spend{}, fmt.Errorf(\"spend since: %w\", err)\n\t\t}\n\t\tper[k] = sp\n\t\trepo.USD += sp.USD\n\t\trepo.Unpriced += sp.Unpriced\n\t}\n\tif err := rows.Err(); err != nil {\n\t\treturn nil, Spend{}, fmt.Errorf(\"spend since: %w\", err)\n\t}\n\treturn per, repo, nil\n}\n// Package costblock is the ard-owned cost block in an issue body: a marked\n// Markdown table the controller writes from its own records. It renders the\n// table, parses it strictly, strips it (so admission and agents never see it)\n// and splices it back in. It is a leaf: stdlib only, pure apart from Locks.\n//\n// The security rule: only text that parses as exactly the table Render emits\n// is ever treated as ard's. Strip and Cut touch nothing else, so a fake or\n// edited block with prose in it stays visible to the admission hash and to\n// agents, and Splice never overwrites it.\npackage costblock\n\nimport (\n\t\"fmt\"\n\t\"math\"\n\t\"regexp\"\n\t\"strconv\"\n\t\"strings\"\n)\n\nconst (\n\tBegin = \"<!-- ard:cost:begin -->\"\n\tEnd   = \"<!-- ard:cost:end -->\"\n\t// MaxBlockBytes caps the whole block, markers included.\n\tMaxBlockBytes = 5000\n\t// MaxBodyRunes is GitHub's issue body limit.\n\tMaxBodyRunes = 65536\n)\n\n// Tokens are token counts by type.\ntype Tokens struct{ Input, Output, CacheWrite, CacheRead int64 }\n\n// Row is one closed job. Every field is validated by Render; an invalid\n// optional field renders as a dash, so a Row can carry no free text.\ntype Row struct {\n\tStage, Role string   // stage in {triage, worker, review}; role ^[a-z0-9][a-z0-9-]{0,30}$\n\tRun         int      // 1-based ordinal of this stage:role on the issue; \"#k\" shown when > 1\n\tTokens      *Tokens  // nil: dash\n\tCostUSD     *float64 // nil: dash, left out of Total\n\tModels      []string // empty: dash\n\tOutcome     string   // fixed vocabulary\n\tLink        string   // \"\" or a github.com issue/pull URL with an optional fragment\n\tPR          int      // > 0: \" · PR #n\"\n}\n\nconst (\n\tdash       = \"—\"\n\theaderLine = \"**Agent cost** · written by ard from its own records; do not edit: an edited block is kept as text, shown to agents and re-gates the issue. Cost is the agent CLI's list-price estimate, not a bill.\"\n\ttableHead  = \"| agent | tokens | cost | model | comments |\"\n\ttableSep   = \"| --- | --- | --- | --- | --- |\"\n\tmaxNum     = int64(9_999_949_999_999) // largest count num() renders as \"9999.9B\" or less\n\tmaxCost    = 1e9\n\tmaxModels  = 8\n)\n\nvar (\n\troleRE    = regexp.MustCompile(`^[a-z0-9][a-z0-9-]{0,30}$`)\n\tmodelRE   = regexp.MustCompile(`^[A-Za-z0-9._:\\[\\]/-]{1,100}$`)\n\toutcomeRE = regexp.MustCompile(`^(done|changes|stale|needs-human|retry|usage limit|failed: ([a-z_]{1,32}|exit [0-9]{1,3}|result))$`)\n\tlinkRE    = regexp.MustCompile(`^https://github\\.com/[A-Za-z0-9._-]{1,100}/[A-Za-z0-9._-]{1,100}/(issues|pull)/[0-9]{1,9}(#(issuecomment|pullrequestreview)-[0-9]{1,18})?$`)\n\n\tnumPat   = `(?:[0-9]{1,3}|[0-9]{1,4}(?:\\.[0-9])?[kMB])`\n\ttokPat   = `in ` + numPat + ` · out ` + numPat + ` · cache w ` + numPat + ` / r ` + numPat\n\tcostPat  = `\\$[0-9]{1,10}\\.[0-9]{2}`\n\tmodelPat = `[A-Za-z0-9._:\\[\\]/-]{1,100}(?:, [A-Za-z0-9._:\\[\\]/-]{1,100}){0,7}`\n\toutPat   = `(?:done|changes|stale|needs-human|retry|usage limit|failed: (?:[a-z_]{1,32}|exit [0-9]{1,3}|result))`\n\tlinkPat  = `https://github\\.com/[A-Za-z0-9._-]{1,100}/[A-Za-z0-9._-]{1,100}/(?:issues|pull)/[0-9]{1,9}(?:#(?:issuecomment|pullrequestreview)-[0-9]{1,18})?`\n\trowRE    = regexp.MustCompile(`^\\| (?:(?:triage|worker|review):[a-z0-9][a-z0-9-]{0,30}(?: #[0-9]{1,5})?) \\| (?:` + tokPat + `|—) \\| (?:` + costPat + `|—) \\| (?:` + modelPat + `|—) \\| (?:—|(?:\\[` + outPat + `\\]\\(` + linkPat + `\\)|` + outPat + `)(?: · PR #[0-9]{1,9})?) \\|$`)\n\tfoldRE   = regexp.MustCompile(`^\\| \\*earlier jobs \\([0-9]{1,6}\\)\\* \\| (?:` + tokPat + `|—) \\| (?:` + costPat + `|—) \\| — \\| — \\|$`)\n\ttotalRE  = regexp.MustCompile(`^\\| \\*\\*Total\\*\\* \\| \\*\\*(?:` + tokPat + `|—)\\*\\* \\| \\*\\*(?:` + costPat + `|—)\\*\\* \\| — \\| — \\|$`)\n\tstageOK  = map[string]bool{\"triage\": true, \"worker\": true, \"review\": true}\n)\n\n// ValidRow reports whether a row's stage and role are valid; Render drops a\n// row that is not. A caller logs such a row.\nfunc ValidRow(r Row) bool { return stageOK[r.Stage] && roleRE.MatchString(r.Role) }\n\n// num formats a count: an integer below 1000, else one decimal (\".0\" dropped)\n// with k, M or B, promoting when rounding reaches 1000.\nfunc num(n int64) string {\n\tif n < 1000 {\n\t\treturn strconv.FormatInt(n, 10)\n\t}\n\tu := uint64(n)\n\tunits := []struct {\n\t\tdiv uint64 // one tenth of the unit\n\t\tsuf string\n\t}{{100, \"k\"}, {100000, \"M\"}, {100000000, \"B\"}}\n\tfor i, un := range units {\n\t\tt := (u + un.div/2) / un.div // tenths of the unit\n\t\tif t >= 10000 && i < len(units)-1 {\n\t\t\tcontinue\n\t\t}\n\t\ts := strconv.FormatUint(t/10, 10)\n\t\tif t%10 != 0 {\n\t\t\ts += \".\" + strconv.FormatUint(t%10, 10)\n\t\t}\n\t\treturn s + un.suf\n\t}\n\treturn \"\" // unreachable\n}\n\nfunc tokText(t Tokens) string {\n\treturn fmt.Sprintf(\"in %s · out %s · cache w %s / r %s\", num(t.Input), num(t.Output), num(t.CacheWrite), num(t.CacheRead))\n}\n\nfunc validTokens(t *Tokens) bool {\n\tif t == nil {\n\t\treturn false\n\t}\n\tfor _, v := range []int64{t.Input, t.Output, t.CacheWrite, t.CacheRead} {\n\t\tif v < 0 || v > maxNum {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc validCost(c *float64) bool {\n\treturn c != nil && !math.IsNaN(*c) && *c >= 0 && *c < maxCost\n}\n\n// costText formats a cost; c+0 turns -0 into 0.\nfunc costText(c float64) string { return fmt.Sprintf(\"$%.2f\", c+0) }\n\n// sums accumulates the reported tokens and costs of rows.\ntype sums struct {\n\ttok  Tokens\n\thasT bool\n\tcost float64\n\thasC bool\n}\n\nfunc (s *sums) add(r Row) {\n\tif validTokens(r.Tokens) {\n\t\ts.hasT = true\n\t\ts.tok.Input += r.Tokens.Input\n\t\ts.tok.Output += r.Tokens.Output\n\t\ts.tok.CacheWrite += r.Tokens.CacheWrite\n\t\ts.tok.CacheRead += r.Tokens.CacheRead\n\t}\n\tif validCost(r.CostUSD) {\n\t\ts.hasC = true\n\t\ts.cost += *r.CostUSD\n\t}\n}\n\nfunc (s sums) cells() (tok, cost string) {\n\ttok, cost = dash, dash\n\tif s.hasT && validTokens(&s.tok) {\n\t\ttok = tokText(s.tok)\n\t}\n\tif s.hasC && s.cost < 9_999_999_999 {\n\t\tcost = costText(s.cost)\n\t}\n\treturn\n}\n\nfunc rowLine(r Row) string {\n\tagent := r.Stage + \":\" + r.Role\n\tif r.Run > 1 && r.Run <= 99999 {\n\t\tagent += \" #\" + strconv.Itoa(r.Run)\n\t}\n\ttok, cost := dash, dash\n\tif validTokens(r.Tokens) {\n\t\ttok = tokText(*r.Tokens)\n\t}\n\tif validCost(r.CostUSD) {\n\t\tcost = costText(*r.CostUSD)\n\t}\n\tvar models []string\n\tseen := map[string]bool{}\n\tfor _, m := range r.Models {\n\t\tif modelRE.MatchString(m) && !seen[m] && len(models) < maxModels {\n\t\t\tseen[m] = true\n\t\t\tmodels = append(models, m)\n\t\t}\n\t}\n\tmodel := dash\n\tif len(models) > 0 {\n\t\tmodel = strings.Join(models, \", \")\n\t}\n\tcomments := dash\n\tif outcomeRE.MatchString(r.Outcome) {\n\t\tcomments = r.Outcome\n\t\tif linkRE.MatchString(r.Link) {\n\t\t\tcomments = \"[\" + r.Outcome + \"](\" + r.Link + \")\"\n\t\t}\n\t\tif r.PR > 0 && r.PR <= 999999999 {\n\t\t\tcomments += \" · PR #\" + strconv.Itoa(r.PR)\n\t\t}\n\t}\n\treturn fmt.Sprintf(\"| %s | %s | %s | %s | %s |\", agent, tok, cost, model, comments)\n}\n\nfunc foldLine(k int, s sums) string {\n\ttok, cost := s.cells()\n\treturn fmt.Sprintf(\"| *earlier jobs (%d)* | %s | %s | %s | %s |\", k, tok, cost, dash, dash)\n}\n\nfunc totalLine(s sums) string {\n\ttok, cost := s.cells()\n\treturn fmt.Sprintf(\"| **Total** | **%s** | **%s** | %s | %s |\", tok, cost, dash, dash)\n}\n\n// Render returns the whole block, markers included, at most maxBytes long. It\n// folds the oldest rows into one \"earlier jobs (k)\" row until it fits; Total\n// always covers every row. Rows with an invalid stage or role are dropped.\n// ok is false when no row is left or even the fully folded block does not fit.\n// Render never emits a block Valid rejects.\nfunc Render(rows []Row, maxBytes int) (block string, folded int, ok bool) {\n\tvar kept []Row\n\tfor _, r := range rows {\n\t\tif ValidRow(r) {\n\t\t\tkept = append(kept, r)\n\t\t}\n\t}\n\tif len(kept) == 0 {\n\t\treturn \"\", 0, false\n\t}\n\tlines := make([]string, len(kept))\n\tvar total sums\n\tfor i, r := range kept {\n\t\tlines[i] = rowLine(r)\n\t\ttotal.add(r)\n\t}\n\ttl := totalLine(total)\n\tpre := Begin + \"\\n\" + headerLine + \"\\n\\n\" + tableHead + \"\\n\" + tableSep + \"\\n\"\n\tpost := tl + \"\\n\" + End\n\tsize := len(pre) + len(post)\n\trest := 0\n\tfor _, l := range lines {\n\t\trest += len(l) + 1\n\t}\n\tvar fold sums\n\tfor k := 0; k <= len(kept); k++ {\n\t\tif k > 0 {\n\t\t\tfold.add(kept[k-1])\n\t\t\trest -= len(lines[k-1]) + 1\n\t\t}\n\t\tfl := 0\n\t\tif k > 0 {\n\t\t\tfl = len(foldLine(k, fold)) + 1\n\t\t}\n\t\tif size+fl+rest > maxBytes {\n\t\t\tcontinue\n\t\t}\n\t\tvar b strings.Builder\n\t\tb.WriteString(pre)\n\t\tif k > 0 {\n\t\t\tb.WriteString(foldLine(k, fold) + \"\\n\")\n\t\t}\n\t\tfor _, l := range lines[k:] {\n\t\t\tb.WriteString(l + \"\\n\")\n\t\t}\n\t\tb.WriteString(post)\n\t\treturn b.String(), k, true\n\t}\n\treturn \"\", 0, false\n}\n\n// Valid reports whether the text between the markers is exactly a table\n// Render could emit. LF or CRLF line ends are both accepted.\nfunc Valid(inner string) bool {\n\tif strings.Contains(inner, \"\\r\\n\") {\n\t\tinner = strings.ReplaceAll(inner, \"\\r\\n\", \"\\n\")\n\t}\n\tif strings.ContainsRune(inner, '\\r') || len(inner) < 2 || inner[0] != '\\n' || inner[len(inner)-1] != '\\n' {\n\t\treturn false\n\t}\n\tif len(inner)+len(Begin)+len(End) > MaxBlockBytes {\n\t\treturn false\n\t}\n\tls := strings.Split(inner[1:len(inner)-1], \"\\n\")\n\tif len(ls) < 6 || ls[0] != headerLine || ls[1] != \"\" || ls[2] != tableHead || ls[3] != tableSep || !totalRE.MatchString(ls[len(ls)-1]) {\n\t\treturn false\n\t}\n\tmid := ls[4 : len(ls)-1]\n\tfor i, l := range mid {\n\t\tif rowRE.MatchString(l) || (i == 0 && foldRE.MatchString(l)) {\n\t\t\tcontinue\n\t\t}\n\t\treturn false\n\t}\n\treturn true\n}\n\n// Locate finds the owned region: e is the last End and s the last Begin before\n// it. sepStart is the start of the \"\\n\\n\" or \"\\r\\n\\r\\n\" directly before s (s\n// itself when there is none). end is the index just past End.\nfunc Locate(body string) (sepStart, start, end int, ok bool) {\n\te := strings.LastIndex(body, End)\n\tif e < 0 {\n\t\treturn 0, 0, 0, false\n\t}\n\ts := strings.LastIndex(body[:e], Begin)\n\tif s < 0 {\n\t\treturn 0, 0, 0, false\n\t}\n\tsep := s\n\tswitch {\n\tcase strings.HasSuffix(body[:s], \"\\r\\n\\r\\n\"):\n\t\tsep = s - 4\n\tcase strings.HasSuffix(body[:s], \"\\n\\n\"):\n\t\tsep = s - 2\n\t}\n\treturn sep, s, e + len(End), true\n}\n\n// locateValid is Locate, only when the region parses as ard's own table.\nfunc locateValid(body string) (sepStart, start, end int, ok bool) {\n\tsepStart, start, end, ok = Locate(body)\n\tif !ok || !Valid(body[start+len(Begin):end-len(End)]) {\n\t\treturn 0, 0, 0, false\n\t}\n\treturn\n}\n\n// Region returns the located region (markers included) when it parses as\n// ard's table, else \"\".\nfunc Region(body string) string {\n\t_, s, e, ok := locateValid(body)\n\tif !ok {\n\t\treturn \"\"\n\t}\n\treturn body[s:e]\n}\n\n// Strip removes the located region and its separator, only when it is Valid.\n// Otherwise it returns body unchanged, so a body without a