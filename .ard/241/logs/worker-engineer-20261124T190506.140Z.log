{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X2NWqVKRqDdrGzzzUqD91M","type":"tool_result","content":"\t// Close-out then skips the role file and the changed files and commits only\n\t// the log. The zero Cause decides from the role file and exit code.\n\tCause Cause\n\t// Worker is the worker loop's result: the PR, reviewers and test outcome.\n\t// nil for every other job; a done worker job without it needs a human.\n\tWorker *WorkerResult\n\t// ExtraLogs are further host logs to redact and commit beside LogPath: the\n\t// earlier agent steps of a worker job. A withheld one holds the job.\n\tExtraLogs []string\n\t// Review is the reviewer loop's context: the added lines for inline\n\t// placement and whether the PR head moved. nil for every other job, and\n\t// for a review closed out by the Reaper after a restart.\n\tReview *ReviewContext\n\t// Usage is the job's agent usage summed over its steps (from state). The\n\t// zero value renders as \"not reported\".\n\tUsage Usage\n\t// StartedAt is when the job was created; zero when unknown.\n\tStartedAt time.Time\n}\n\n// Tokens are token counts by type; it mirrors state.Tokens.\ntype Tokens struct{ Input, Output, CacheWrite, CacheRead int64 }\n\n// Usage is the job's agent usage summed over its steps (from state).\ntype Usage struct {\n\tModels  []string `json:\",omitempty\"`\n\tTokens  *Tokens  `json:\",omitempty\"`\n\tCostUSD *float64 `json:\",omitempty\"`\n\tSteps   int      `json:\",omitempty\"`\n}\n\n// CauseKind names why a job ended without a usable result.\ntype CauseKind string\n\n// Cause kinds. The reason in the comment is \"<kind>: <detail>\".\nconst (\n\tCauseQuiet     CauseKind = \"heartbeat_quiet\"    // no log output for 10 minutes\n\tCauseDeadline  CauseKind = \"deadline\"           // ran past its timeout\n\tCauseRestart   CauseKind = \"controller_restart\" // orphaned, gone or never started across a restart\n\tCauseNoProcess CauseKind = \"no_process\"         // never started, or its process vanished in this run\n\tCauseRateLimit CauseKind = \"rate_limit\"         // the agent reported a transient API error\n\tfmt.Fprintf(&b, \"**ard · %s:%s · %s**\\n\", j.Stage, j.Role, headerWord(p))\n\tif s := strings.TrimSpace(p.Summary); s != \"\" {\n\t\tb.WriteString(\"\\n\" + sanitize(cutSummary(s)) + \"\\n\")\n\t}\n\tif p.Reason != \"\" {\n\t\tb.WriteString(\"\\n\" + codeSpan(p.Reason, maxReasonRunes) + \"\\n\")\n\t}\n\tvar lines []string\n\tif len(p.Requests) > 0 {\n\t\tnames := make([]string, len(p.Requests))\n\t\tfor i, l := range p.Requests {\n\t\t\tnames[i] = \"`\" + l.Name + \"`\"\n\t\t}\n\t\tlines = append(lines, \"Requested next: \"+strings.Join(names, \", \"))\n\t}\n\tif len(p.Deferred) > 0 {\n\t\tnames := make([]string, len(p.Deferred))\n\t\tfor i, d := range p.Deferred {\n\t\t\tnames[i] = \"`\" + d.String() + \"`\"\n\t\t}\n\t\tlines = append(lines, \"Deferred until the PR exists: \"+strings.Join(names, \", \"))\n\t}\n\tif len(p.Skipped) > 0 {\n\t\tparts := make([]string, len(p.Skipped))\n\t\tfor i, s := range p.Skipped {\n\t\t\tparts[i] = codeSpan(s.Entry, 60) + \" (\" + sanitize(s.Why) + \")\"\n\t\t}\n\t\tlines = append(lines, \"Skipped: \"+strings.Join(parts, \", \"))\n\t}\n\tlines = append(lines, workerLines(j)...)\n\tif out := outputLine(r, repo, dryRun); out != \"\" {\n\t\tlines = append(lines, out)\n\t}\n\textra, tail := evidenceLines(r)\n\tlines = append(lines, extra...)\n\tif len(lines) > 0 {\n\t\tb.WriteString(\"\\n\" + strings.Join(lines, \"\\n\") + \"\\n\")\n\t}\n\tif tail != \"\" {\n\t\tb.WriteString(\"\\n\" + tail + \"\\n\")\n\t}\n\t\tcause = CauseOf(sj, st, res, f.Start)\n\t}\n\t// A usage-limit stop is recorded before anything else, so the pool blocks\n\t// the account no later than the comment says. An error here is returned\n\t// with nothing posted and the next tick retries: no job may start into a\n\t// limit the book could not record (fail closed).\n\tif cause.Kind == closeout.CauseUsageLimit && f.Limits != nil {\n\t\tuntil, err := f.Limits.Exhaust(ctx, cause.Family, cause.ResetsAt)\n\t\tif err != nil {\n\t\t\treturn \"\", fmt.Errorf(\"finish job %s: record usage limit: %w\", jobID, err)\n\t\t}\n\t\tcause.ResetsAt = until\n\t}\n\t// Record the final step's usage, then read the job's totals (the sum of\n\t// every step recorded so far). Close-out never fails over accounting: on an\n\t// error the final step's own numbers stand in.\n\tcost := res.CostUSD\n\tvar totals state.JobUsage\n\trecorded := true\n\t// Only agent steps are recorded: the job's own id or <id>f<k> (a fix step).\n\t// A test step (<id>t<k>) runs agent-written code, so its output is never\n\t// parsed into usage.\n\tif u, ok := StepUsageOf(res); ok && agentStep(jobID, h.JobID) {\n\t\tif _, err := f.Store.RecordStepUsage(ctx, jobID, h.JobID, u); err != nil {\n\t\t\tf.log().Warn(\"reaper.usage_record_failed\", \"job\", jobID, \"step\", h.JobID, \"error\", err)\n\t\t\trecorded = false\n\t\t}\n\t}\n\thaveTotals := false\n\tif recorded {\n\t\tif t, err := f.Store.JobUsage(ctx, jobID); err != nil {\n\t\t\tf.log().Warn(\"reaper.usage_record_failed\", \"job\", jobID, \"error\", err)\n\t\t} else {\n\t\t\ttotals, haveTotals = t, true\n\t\t\tcost = t.CostUSD\n\t\t}\n\t}\n\tcj := CloseoutJob(sj, h, st, cause, res)\n\tcj.CostUSD = 0\n\tif cost != nil {\n\t\tcj.CostUSD = *cost\n\t}\n\tif haveTotals {\n\t\tcj.Usage = usageOf(totals)\n\t} else if u, ok := StepUsageOf(res); ok {\n\t\tcj.Usage = usageOf(state.JobUsage{Models: u.Models, Tokens: u.Tokens, CostUSD: u.CostUSD, Steps: 1})\n\t}\n\tcj.Worker, cj.ExtraLogs, cj.Review = o.Worker, o.ExtraLogs, o.Review\n\t// End the attempt before close-out: a crash after it leaves a resumable\n\t// close-out and an ended attempt, never the reverse.\n\tif sj.Attempt > 0 {\n\t\tend := state.AttemptEnd{Cause: string(cause.Kind), Transient: cause.Transient}\n\t\tcode := cj.ExitCode\n\t\tend.ExitCode = &code\n\t\tend.CostUSD = cost\n\t\tif err := f.Store.EndAttempt(ctx, jobID, sj.Attempt, end); err != nil && !errors.Is(err, state.ErrNotFound) {\n\t\tout.Tokens = &closeout.Tokens{Input: t.Input, Output: t.Output, CacheWrite: t.CacheWrite, CacheRead: t.CacheRead}\n\t}\n\treturn out\n}\n\n// agentStep reports whether step is an agent or fix step of the job.\nfunc agentStep(jobID, step string) bool {\n\tif step == jobID {\n\t\treturn true\n\t}\n\trest, ok := strings.CutPrefix(step, jobID+\"f\")\n\tif !ok || rest == \"\" {\n\t\treturn false\n\t}\n\tfor _, r := range rest {\n\t\tif r < '0' || r > '9' {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\n// StepUsageOf maps what one agent run reported to a state record. ok is false\n// when the result reported nothing: no cost, no usage and no model. Models are\n// the keys of res.ModelUsage plus res.Model, de-duplicated, sorted and limited\n// to valid model ids.\nfunc StepUsageOf(res agent.Result) (state.StepUsage, bool) {\n\tvar u state.StepUsage\n\tif res.CostUSD != nil {\n\t\tif c := *res.CostUSD; !math.IsNaN(c) && !math.IsInf(c, 0) && c >= 0 {\n\t\t\tu.CostUSD = &c\n\t\t}\n\t}\n\tif res.Usage != nil {\n\t\tu.Tokens = &state.Tokens{Input: res.Usage.Input, Output: res.Usage.Output, CacheWrite: res.Usage.CacheWrite, CacheRead: res.Usage.CacheRead}\n\t}\n\tseen := map[string]bool{}\n\tadd := func(m string) {\n\t\tif m != \"\" && !seen[m] && state.ValidModel(m) {\n\t\t\tseen[m] = true\n\t\t\tu.Models = append(u.Models, m)\n\t\t}\n\t}\n\tfor m := range res.ModelUsage {\n\t\tadd(m)\n\t}\n\tadd(res.Model)\n\tsort.Strings(u.Models)\n\tif u.CostUSD == nil && u.Tokens == nil && len(u.Models) == 0 {\n\t\treturn state.StepUsage{}, false\n\t}\n\treturn u, true\n}\n\n// Tidy removes the worktree of a closed-out job unless the outcome keeps it\n// (failed, retry, usage-limit, needs-human), and marks the job cleaned when it did. It logs\ninternal/config/raw.go:22:\tbudgetUSDPerDay        *float64\ninternal/config/raw.go:115:\t\tcase \"budget_usd_per_day\":\ninternal/config/raw.go:116:\t\t\terrs = append(errs, decodeValue(value, cfgPath, name, &raw.budgetUSDPerDay)...)\ninternal/config/render.go:28:\tBudgetUSDPerDay float64                `yaml:\"budget_usd_per_day\"`\ninternal/config/render.go:118:\tBudgetUSDPerDay float64 `yaml:\"budget_usd_per_day,omitempty\"`\ninternal/config/render.go:134:\t\tBudgetUSDPerDay: r.BudgetUSDPerDay,\ninternal/config/render.go:190:\t\t\tBudgetUSDPerDay: role.BudgetUSDPerDay,\ninternal/config/testdata/resolved.golden:6:budget_usd_per_day: 50\ninternal/config/types.go:164:\t// Resolved.MaxBudgetUSD and the daily cap to Resolved.BudgetUSDPerDay.\ninternal/config/types.go:166:\tBudgetUSDPerDay float64\ninternal/config/types.go:210:\tBudgetUSDPerDay float64 // whole-repo daily cap; default 50\ninternal/config/types.go:237:// RoleBudgetUSDPerDay is the role's own daily cap in USD. set is false when\ninternal/config/types.go:239:// only the repo-wide Resolved.BudgetUSDPerDay applies to it.\ninternal/config/types.go:240:func (r *Resolved) RoleBudgetUSDPerDay(role Role) (cap float64, set bool) {\ninternal/config/types.go:241:\tif role.BudgetUSDPerDay > 0 {\ninternal/config/types.go:242:\t\treturn role.BudgetUSDPerDay, true\ninternal/config/keys.go:11:\t\t\"budget_usd_per_day\", \"max_budget_usd\", \"global_max_open\", \"paused\",\ninternal/config/defaults.go:21:\tdefaultBudgetUSDPerDay = 50.0\ninternal/config/defaults.go:66:\t\tBudgetUSDPerDay: defaultBudgetUSDPerDay,\ninternal/config/defaults.go:121:\tif raw.budgetUSDPerDay != nil {\ninternal/config/defaults.go:122:\t\tres.BudgetUSDPerDay = *raw.budgetUSDPerDay\ninternal/config/defaults.go:124:\tif res.BudgetUSDPerDay <= 0 {\ninternal/config/defaults.go:125:\t\terrs = append(errs, &Error{File: cfgPath, Key: \"budget_usd_per_day\", Msg: fmt.Sprintf(\"must be greater than 0 (unlimited budgets are not allowed), got %g\", res.BudgetUSDPerDay)})\ninternal/config/load.go:72:\t\"max_budget_usd\": true, \"budget_usd_per_day\": true, \"network\": true,\ninternal/config/load.go:321:\t\tcase \"max_budget_usd\", \"budget_usd_per_day\":\ninternal/config/load.go:404:\t\trole.BudgetUSDPerDay = *ov.budgetPerDay\ninternal/budget/testdata/repo.golden:8:To raise the cap, change the repo-wide `budget_usd_per_day` in `.ard/config.yaml` through a reviewed pull request. The cap clears at 00:00 UTC.\ninternal/budget/testdata/unpriced.golden:8:To raise the cap, change `budget_usd_per_day` of role `rev` (or the repo-wide value) in `.ard/config.yaml` through a reviewed pull request. The cap clears at 00:00 UTC.\ninternal/budget/testdata/role.golden:8:To raise the cap, change `budget_usd_per_day` of role `eng` (or the repo-wide value) in `.ard/config.yaml` through a reviewed pull request. The cap clears at 00:00 UTC.\ninternal/budget/budget.go:4:// role's own cap (budget_usd_per_day on the role) or the repo cap. Steps that\ninternal/budget/budget.go:88:\tif cfg.BudgetUSDPerDay > 0 && repo.USD >= cfg.BudgetUSDPerDay {\ninternal/budget/budget.go:89:\t\treturn true, g.capped(dayStart, \"repo\", \"\", repo, cfg.BudgetUSDPerDay)\ninternal/budget/budget.go:91:\tif limit, set := cfg.RoleBudgetUSDPerDay(role); set {\ninternal/budget/budget.go:148:\tif cfg.BudgetUSDPerDay > 0 && repo.USD >= cfg.BudgetUSDPerDay {\ninternal/budget/budget.go:149:\t\tout = append(out, Cap{Scope: \"repo\", Spent: repo, Limit: cfg.BudgetUSDPerDay})\ninternal/budget/budget.go:160:\t\tif limit, set := cfg.RoleBudgetUSDPerDay(role); set {\ninternal/budget/notice.go:146:\twhere := \"the repo-wide `budget_usd_per_day`\"\ninternal/budget/notice.go:151:\t\twhere = fmt.Sprintf(\"`budget_usd_per_day` of role `%s` (or the repo-wide value)\", role)\ndocs/runbooks/onboard-repo.md:48:`max_pods`, `budget_usd_per_day` and `max_budget_usd` in `.ard/config.yaml` apply\ndocs/runbooks/onboard-repo.md:59:| `budget_usd_per_day` | 30 | 30 | 60 (the daily budget) |\ndocs/site/operations.md:45:When an agent reports its usage limit is exhausted, ard records it and stops starting jobs for that agent until the limit resets, instead of failing each job. `budget_usd_per_day` and `max_budget_usd` cap spending in dollars.\ndocs/site/operations/gate-2-runbook.md:202:- Cost per merged PR: median <$>, max <$>; proposed `max_budget_usd` <$>, `budget_usd_per_day` <$>\ndocs/site/configuration.md:15:| `budget_usd_per_day` | `50` | Daily dollar cap for the repository (UTC day) |\ndocs/site/configuration.md:76:`overrides` maps a role path (`scanners/cve`, `triage/lead`, `workers/engineer`, `reviewers/eng-review`) to a mapping of the keys below. A role may also set `agent`, `max_budget_usd` and `budget_usd_per_day` to override the global values. An unknown key is an error.\ndocs/proposal.md:417:**Limits and credentials are per `ard serve`.** `max_pods`, `budget_usd_per_day` and `max_budget_usd` apply to one process. ard does not coordinate across processes, so when a host or cluster runs more than one `ard serve`, the operator sets every serve's limits together so the total fits the host, the cluster and the model subscription. Each `ard serve` has its own GitHub credentials: a GitHub App installation, or a fine-grained PAT after #302. See [the onboarding runbook](runbooks/onboard-repo.md).\ndocs/proposal.md:440:budget_usd_per_day: 50       # whole repo, UTC day, blocks at spent >= cap; a role may set its own; provisional, recalibrated between Gate 1 and Gate 2\ndocs/proposal.md:472:**Models are tiered (decided, #8).** Opus 5.5 for the lead, architect and security review; Sonnet 5.5 for workers, triage engineer and most reviewers; Haiku 5.5 for lint and docs work. The `budget_usd_per_day: 50` and per-job `max_budget_usd` values are provisional and are recalibrated from measured cost per job and per merged PR between Gate 1 and Gate 2.\ndocs/proposal.md:501:- **Budgets.** Every job has a dollar cap (`max_budget_usd`) and a hard timeout; every role and the whole repo have a daily dollar cap. The caps are enforced at the pool's claim gate (`internal/budget`): a candidate is refused when `spent >= cap`, where spent is the cost recorded in `step_usage` since 00:00 UTC today. The caps reset at 00:00 UTC and survive a restart, because spend is read from the controller database. A role's own `budget_usd_per_day` caps that role (by stage and name) alone; a role without one is limited only by the repo cap. Steps that reported no cost count as $0, and the refusal reason shows how many there were. There is no exemption for reviewers, the caps apply to OAuth credentials too, and deterministic scanners (no model, no cost) are exempt. Running jobs are never killed for a cap. If today's spend cannot be read, the gate refuses (fails closed). Each cap is logged once a day as `budget.capped`. The `budget` loop posts one comment on the status issue per capped scope (the repo, or a role) per UTC day, and records a `budget_capped` event; that event also keeps a restart from posting the notice again (a crash between comment and event can repeat one notice). The comment holds only numbers, the day and config names, no agent text and no `@`; it says the dollar figure is an estimate on a subscription and how to raise the cap (edit `budget_usd_per_day` in `.ard/config.yaml` through a reviewed PR). Under `--dry-run` the comment goes to the ledger. `--loops budget` selects the notice loop; the gate is part of the pool and is always on.","is_error":false}]},"parent_tool_use_id":null,"session_id":"2ace8dd2-933b-4fc0-ae77-c8187a5d1366","uuid":"37cd078c-fc94-4ece-a986-a3216ff832c1","timestamp":"2026-11-24T19:05:15.180Z","tool_use_result":{"stdout":"\t// Close-out then skips the role file and the changed files and commits only\n\t// the log. The zero Cause decides from the role file and exit code.\n\tCause Cause\n\t// Worker is the worker loop's result: the PR, reviewers and test outcome.\n\t// nil for every other job; a done worker job without it needs a human.\n\tWorker *WorkerResult\n\t// ExtraLogs are further host logs to redact and commit beside LogPath: the\n\t// earlier agent steps of a worker job. A withheld one holds the job.\n\tExtraLogs []string\n\t// Review is the reviewer loop's context: the added lines for inline\n\t// placement and whether the PR head moved. nil for every other job, and\n\t// for a review closed out by the Reaper after a restart.\n\tReview *ReviewContext\n\t// Usage is the job's agent usage summed over its steps (from state). The\n\t// zero value renders as \"not reported\".\n\tUsage Usage\n\t// StartedAt is when the job was created; zero when unknown.\n\tStartedAt time.Time\n}\n\n// Tokens are token counts by type; it mirrors state.Tokens.\ntype Tokens struct{ Input, Output, CacheWrite, CacheRead int64 }\n\n// Usage is the job's agent usage summed over its steps (from state).\ntype Usage struct {\n\tModels  []string `json:\",omitempty\"`\n\tTokens  *Tokens  `json:\",omitempty\"`\n\tCostUSD *float64 `json:\",omitempty\"`\n\tSteps   int      `json:\",omitempty\"`\n}\n\n// CauseKind names why a job ended without a usable result.\ntype CauseKind string\n\n// Cause kinds. The reason in the comment is \"<kind>: <detail>\".\nconst (\n\tCauseQuiet     CauseKind = \"heartbeat_quiet\"    // no log output for 10 minutes\n\tCauseDeadline  CauseKind = \"deadline\"           // ran past its timeout\n\tCauseRestart   CauseKind = \"controller_restart\" // orphaned, gone or never started across a restart\n\tCauseNoProcess CauseKind = \"no_process\"         // never started, or its process vanished in this run\n\tCauseRateLimit CauseKind = \"rate_limit\"         // the agent reported a transient API error\n\tfmt.Fprintf(&b, \"**ard · %s:%s · %s**\\n\", j.Stage, j.Role, headerWord(p))\n\tif s := strings.TrimSpace(p.Summary); s != \"\" {\n\t\tb.WriteString(\"\\n\" + sanitize(cutSummary(s)) + \"\\n\")\n\t}\n\tif p.Reason != \"\" {\n\t\tb.WriteString(\"\\n\" + codeSpan(p.Reason, maxReasonRunes) + \"\\n\")\n\t}\n\tvar lines []string\n\tif len(p.Requests) > 0 {\n\t\tnames := make([]string, len(p.Requests))\n\t\tfor i, l := range p.Requests {\n\t\t\tnames[i] = \"`\" + l.Name + \"`\"\n\t\t}\n\t\tlines = append(lines, \"Requested next: \"+strings.Join(names, \", \"))\n\t}\n\tif len(p.Deferred) > 0 {\n\t\tnames := make([]string, len(p.Deferred))\n\t\tfor i, d := range p.Deferred {\n\t\t\tnames[i] = \"`\" + d.String() + \"`\"\n\t\t}\n\t\tlines = append(lines, \"Deferred until the PR exists: \"+strings.Join(names, \", \"))\n\t}\n\tif len(p.Skipped) > 0 {\n\t\tparts := make([]string, len(p.Skipped))\n\t\tfor i, s := range p.Skipped {\n\t\t\tparts[i] = codeSpan(s.Entry, 60) + \" (\" + sanitize(s.Why) + \")\"\n\t\t}\n\t\tlines = append(lines, \"Skipped: \"+strings.Join(parts, \", \"))\n\t}\n\tlines = append(lines, workerLines(j)...)\n\tif out := outputLine(r, repo, dryRun); out != \"\" {\n\t\tlines = append(lines, out)\n\t}\n\textra, tail := evidenceLines(r)\n\tlines = append(lines, extra...)\n\tif len(lines) > 0 {\n\t\tb.WriteString(\"\\n\" + strings.Join(lines, \"\\n\") + \"\\n\")\n\t}\n\tif tail != \"\" {\n\t\tb.WriteString(\"\\n\" + tail + \"\\n\")\n\t}\n\t\tcause = CauseOf(sj, st, res, f.Start)\n\t}\n\t// A usage-limit stop is recorded before anything else, so the pool blocks\n\t// the account no later than the comment says. An error here is returned\n\t// with nothing posted and the next tick retries: no job may start into a\n\t// limit the book could not record (fail closed).\n\tif cause.Kind == closeout.CauseUsageLimit && f.Limits != nil {\n\t\tuntil, err := f.Limits.Exhaust(ctx, cause.Family, cause.ResetsAt)\n\t\tif err != nil {\n\t\t\treturn \"\", fmt.Errorf(\"finish job %s: record usage limit: %w\", jobID, err)\n\t\t}\n\t\tcause.ResetsAt = until\n\t}\n\t// Record the final step's usage, then read the job's totals (the sum of\n\t// every step recorded so far). Close-out never fails over accounting: on an\n\t// error the final step's own numbers stand in.\n\tcost := res.CostUSD\n\tvar totals state.JobUsage\n\trecorded := true\n\t// Only agent steps are recorded: the job's own id or <id>f<k> (a fix step).\n\t// A test step (<id>t<k>) runs agent-written code, so its output is never\n\t// parsed into usage.\n\tif u, ok := StepUsageOf(res); ok && agentStep(jobID, h.JobID) {\n\t\tif _, err := f.Store.RecordStepUsage(ctx, jobID, h.JobID, u); err != nil {\n\t\t\tf.log().Warn(\"reaper.usage_record_failed\", \"job\", jobID, \"step\", h.JobID, \"error\", err)\n\t\t\trecorded = false\n\t\t}\n\t}\n\thaveTotals := false\n\tif recorded {\n\t\tif t, err := f.Store.JobUsage(ctx, jobID); err != nil {\n\t\t\tf.log().Warn(\"reaper.usage_record_failed\", \"job\", jobID, \"error\", err)\n\t\t} else {\n\t\t\ttotals, haveTotals = t, true\n\t\t\tcost = t.CostUSD\n\t\t}\n\t}\n\tcj := CloseoutJob(sj, h, st, cause, res)\n\tcj.CostUSD = 0\n\tif cost != nil {\n\t\tcj.CostUSD = *cost\n\t}\n\tif haveTotals {\n\t\tcj.Usage = usageOf(totals)\n\t} else if u, ok := StepUsageOf(res); ok {\n\t\tcj.Usage = usageOf(state.JobUsage{Models: u.Models, Tokens: u.Tokens, CostUSD: u.CostUSD, Steps: 1})\n\t}\n\tcj.Worker, cj.ExtraLogs, cj.Review = o.Worker, o.ExtraLogs, o.Review\n\t// End the attempt before close-out: a crash after it leaves a resumable\n\t// close-out and an ended attempt, never the reverse.\n\tif sj.Attempt > 0 {\n\t\tend := state.AttemptEnd{Cause: string(cause.Kind), Transient: cause.Transient}\n\t\tcode := cj.ExitCode\n\t\tend.ExitCode = &code\n\t\tend.CostUSD = cost\n\t\tif err := f.Store.EndAttempt(ctx, jobID, sj.Attempt, end); err != nil && !errors.Is(err, state.ErrNotFound) {\n\t\tout.Tokens = &closeout.Tokens{Input: t.Input, Output: t.Output, CacheWrite: t.CacheWrite, CacheRead: t.CacheRead}\n\t}\n\treturn out\n}\n\n// agentStep reports whether step is an agent or fix step of the job.\nfunc agentStep(jobID, step string) bool {\n\tif step == jobID {\n\t\treturn true\n\t}\n\trest, ok := strings.CutPrefix(step, jobID+\"f\")\n\tif !ok || rest == \"\" {\n\t\treturn false\n\t}\n\tfor _, r := range rest {\n\t\tif r < '0' || r > '9' {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\n// StepUsageOf maps what one agent run reported to a state record. ok is false\n// when the result reported nothing: no cost, no usage and no model. Models are\n// the keys of res.ModelUsage plus res.Model, de-duplicated, sorted and limited\n// to valid model ids.\nfunc StepUsageOf(res agent.Result) (state.StepUsage, bool) {\n\tvar u state.StepUsage\n\tif res.CostUSD != nil {\n\t\tif c := *res.CostUSD; !math.IsNaN(c) && !math.IsInf(c, 0) && c >= 0 {\n\t\t\tu.CostUSD = &c\n\t\t}\n\t}\n\tif res.Usage != nil {\n\t\tu.Tokens = &state.Tokens{Input: res.Usage.Input, Output: res.Usage.Output, CacheWrite: res.Usage.CacheWrite, CacheRead: res.Usage.CacheRead}\n\t}\n\tseen := map[string]bool{}\n\tadd := func(m string) {\n\t\tif m != \"\" && !seen[m] && state.ValidModel(m) {\n\t\t\tseen[m] = true\n\t\t\tu.Models = append(u.Models, m)\n\t\t}\n\t}\n\tfor m := range res.ModelUsage {\n\t\tadd(m)\n\t}\n\tadd(res.Model)\n\tsort.Strings(u.Models)\n\tif u.CostUSD == nil && u.Tokens == nil && len(u.Models) == 0 {\n\t\treturn state.StepUsage{}, false\n\t}\n\treturn u, true\n}\n\n// Tidy removes the worktree of a closed-out job unless the outcome keeps it\n// (failed, retry, usage-limit, needs-human), and marks the job cleaned when it did. It logs\ninternal/config/raw.go:22:\tbudgetUSDPerDay        *float64\ninternal/config/raw.go:115:\t\tcase \"budget_usd_per_day\":\ninternal/config/raw.go:116:\t\t\terrs = append(errs, decodeValue(value, cfgPath, name, &raw.budgetUSDPerDay)...)\ninternal/config/render.go:28:\tBudgetUSDPerDay float64                `yaml:\"budget_usd_per_day\"`\ninternal/config/render.go:118:\tBudgetUSDPerDay float64 `yaml:\"budget_usd_per_day,omitempty\"`\ninternal/config/render.go:134:\t\tBudgetUSDPerDay: r.BudgetUSDPerDay,\ninternal/config/render.go:190:\t\t\tBudgetUSDPerDay: role.BudgetUSDPerDay,\ninternal/config/testdata/resolved.golden:6:budget_usd_per_day: 50\ninternal/config/types.go:164:\t// Resolved.MaxBudgetUSD and the daily cap to Resolved.BudgetUSDPerDay.\ninternal/config/types.go:166:\t