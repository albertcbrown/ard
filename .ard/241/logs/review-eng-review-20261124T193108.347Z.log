und(), j); err == nil {\n+\t\tt.Fatal(\"expected the injected store failure\")\n+\t}\n+\te.fstore.failAt = 0\n+\tif _, err := c.ResumeJob(context.Background(), j.ID); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tcs, _ := e.gh.ListComments(context.Background(), 7, time.Time{})\n+\tn := 0\n+\tfor _, cm := range cs {\n+\t\tif strings.HasPrefix(cm.Body, markerFor(j.ID)) {\n+\t\t\tn++\n+\t\t\tif got := strings.Count(cm.Body, \"Tokens not reported\"); got != 1 {\n+\t\t\t\tt.Errorf(\"mark count = %d in\\n%s\", got, cm.Body)\n+\t\t\t}\n+\t\t}\n+\t}\n+\tif n != 1 {\n+\t\tt.Errorf(\"marker comments = %d, want 1\", n)\n+\t}\n+\tf, err := FactsOf(e.sjob(j.ID))\n+\tif err != nil || !f.TokensUnreported {\n+\t\tt.Errorf(\"facts = %+v, %v\", f, err)\n+\t}\n+\t// Without the flag the facts carry no mark.\n+\tj2 := e.causeJob(StageTriage, \"lead\", Cause{Kind: CauseNoProcess})\n+\tif _, err := New(e.deps(0)).Run(context.Background(), j2); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif f, err := FactsOf(e.sjob(j2.ID)); err != nil || f.TokensUnreported {\n+\t\tt.Errorf(\"facts = %+v, %v\", f, err)\n+\t}\n+}\ndiff --git a/internal/closeout/closeout.go b/internal/closeout/closeout.go\nindex 764834e..f6c84bd 100644\n--- a/internal/closeout/closeout.go\n+++ b/internal/closeout/closeout.go\n@@ -73,6 +73,10 @@ type Job struct {\n \t// Usage is the job's agent usage summed over its steps (from state). The\n \t// zero value renders as \"not reported\".\n \tUsage Usage\n+\t// TokensUnreported is set when the job's final agent step ended without\n+\t// reporting tokens: its token use is not counted, so the day's token count\n+\t// for the role is low. The close-out comment and cost-table row say so.\n+\tTokensUnreported bool `json:\",omitempty\"`\n \t// StartedAt is when the job was created; zero when unknown.\n \tStartedAt time.Time\n }\ndiff --git a/internal/closeout/comment.go b/internal/closeout/comment.go\nindex 0acfaf4..eaaf7b0 100644\n--- a/internal/closeout/comment.go\n+++ b/internal/closeout/comment.go\n@@ -177,6 +177,9 @@ func RenderComment(r Record, repo github.Repo, dryRun bool) string {\n \t\tlines = append(lines, \"Skipped: \"+strings.Join(parts, \", \"))\n \t}\n \tlines = append(lines, workerLines(j)...)\n+\tif j.TokensUnreported {\n+\t\tlines = append(lines, \"Tokens not reported: this job's token use is not counted, so the day's token count for this role is low.\")\n+\t}\n \tif out := outputLine(r, repo, dryRun); out != \"\" {\n \t\tlines = append(lines, out)\n \t}\ndiff --git a/internal/closeout/comment_test.go b/internal/closeout/comment_test.go\nindex d1ffdd3..9d4a764 100644\n--- a/internal/closeout/comment_test.go\n+++ b/internal/closeout/comment_test.go\n@@ -115,3 +115,17 @@ func TestSanitize(t *testing.T) {\n \t\t}\n \t}\n }\n+\n+func TestCommentTokensUnreported(t *testing.T) {\n+\trepo := github.Repo{Owner: \"o\", Name: \"r\"}\n+\tjob := Job{ID: \"01JTEST\", Issue: 7, Stage: StageTriage, Role: \"lead\", Attempt: 1}\n+\tr := Record{Job: job, Plan: Plan{Outcome: OutcomeDone, Summary: \"ok\"}}\n+\tif got := RenderComment(r, repo, false); strings.Contains(got, \"Tokens not reported\") {\n+\t\tt.Errorf(\"unmarked job has the line:\\n%s\", got)\n+\t}\n+\tr.Job.TokensUnreported = true\n+\tgot := RenderComment(r, repo, false)\n+\tif n := strings.Count(got, \"Tokens not reported\"); n != 1 {\n+\t\tt.Errorf(\"line appears %d times:\\n%s\", n, got)\n+\t}\n+}\ndiff --git a/internal/closeout/facts.go b/internal/closeout/facts.go\nindex ff251df..d13c447 100644\n--- a/internal/closeout/facts.go\n+++ b/internal/closeout/facts.go\n@@ -18,6 +18,8 @@ type CostFacts struct {\n \t// Synthetic is true for a dry-run close-out: nothing reached GitHub, so\n \t// there is nothing to link to.\n \tSynthetic bool\n+\t// TokensUnreported: the job ended without reporting tokens.\n+\tTokensUnreported bool\n }\n \n // FactsOf decodes the stored close-out record of a closed job. It is an error\n@@ -31,7 +33,7 @@ func FactsOf(sj state.Job) (CostFacts, error) {\n \t\tretur