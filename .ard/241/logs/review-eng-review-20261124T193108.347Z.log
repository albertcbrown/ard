n383\t+\tn, err := strconv.ParseInt(digits, 10, 64)\n384\t+\tif err != nil {\n385\t+\t\treturn 0, fmt.Errorf(\"invalid token count %q: too large\", s)\n386\t+\t}\n387\t+\tif len(frac) > 7 {\n388\t+\t\treturn 0, fmt.Errorf(\"invalid token count %q: too many decimals\", s)\n389\t+\t}\n390\t+\tdiv := int64(math.Pow10(len(frac)))\n391\t+\tif n > math.MaxInt64/mult {\n392\t+\t\treturn 0, fmt.Errorf(\"invalid token count %q: too large\", s)\n393\t+\t}\n394\t+\ttotal := n * mult\n395\t+\tif total%div != 0 {\n396\t+\t\treturn 0, fmt.Errorf(\"invalid token count %q: not a whole number of tokens\", s)\n397\t+\t}\n398\t+\treturn total / div, nil\n399\t+}\n400\t+\n401\t+// String renders t as a plain integer.\n402\t+func (t TokenCount) String() string { return strconv.FormatInt(int64(t), 10) }\n403\t+\n404\t+// UnmarshalYAML accepts a YAML integer or a string.\n405\t+func (t *TokenCount) UnmarshalYAML(value *yaml.Node) error {\n406\t+\tif value.Kind != yaml.ScalarNode {\n407\t+\t\treturn fmt.Errorf(\"expected a token count like %q, got %s\", \"40M\", nodeKindName(value))\n408\t+\t}\n409\t+\tswitch value.Tag {\n410\t+\tcase \"!!null\":\n411\t+\t\t*t = 0\n412\t+\t\treturn nil\n413\t+\tcase \"!!int\", \"!!str\":\n414\t+\t\tn, err := ParseTokenCount(value.Value)\n415\t+\t\tif err != nil {\n416\t+\t\t\treturn err\n417\t+\t\t}\n418\t+\t\t*t = TokenCount(n)\n419\t+\t\treturn nil\n420\t+\tdefault:\n421\t+\t\treturn fmt.Errorf(\"expected a token count like %q, got %q\", \"40M\", value.Value)\n422\t+\t}\n423\t+}\n424\t+\n425\t+// MarshalYAML renders t as an integer.\n426\t+func (t TokenCount) MarshalYAML() (any, error) { return int64(t), nil }\n427\tdiff --git a/internal/config/tokens_test.go b/internal/config/tokens_test.go\n428\tnew file mode 100644\n429\tindex 0000000..4744a76\n430\t--- /dev/null\n431\t+++ b/internal/config/tokens_test.go\n432\t@@ -0,0 +1,47 @@\n433\t+package config\n434\t+\n435\t+import (\n436\t+\t\"strings\"\n437\t+\t\"testing\"\n438\t+)\n439\t+\n440\t+func TestToke