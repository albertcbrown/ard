got %s\", ov.every)})\ndiff --git a/internal/config/raw.go b/internal/config/raw.go\nindex ae901f9..7bfa679 100644\n--- a/internal/config/raw.go\n+++ b/internal/config/raw.go\n@@ -20,6 +20,7 @@ type rawConfig struct {\n \tagent                  *string\n \trequireApproval        *bool\n \tbudgetUSDPerDay        *float64\n+\ttokensPerDay           *TokenCount\n \tmaxBudgetUSD           *float64\n \tglobalMaxOpen          *int\n \tpaused                 *bool\n@@ -114,6 +115,8 @@ func parseConfigDoc(doc *yaml.Node, cfgPath string) (rawConfig, Errors) {\n \t\t\terrs = append(errs, decodeValue(value, cfgPath, name, &raw.requireApproval)...)\n \t\tcase \"budget_usd_per_day\":\n \t\t\terrs = append(errs, decodeValue(value, cfgPath, name, &raw.budgetUSDPerDay)...)\n+\t\tcase \"tokens_per_day\":\n+\t\t\terrs = append(errs, decodeValue(value, cfgPath, name, &raw.tokensPerDay)...)\n \t\tcase \"max_budget_usd\":\n \t\t\terrs = append(errs, decodeValue(value, cfgPath, name, &raw.maxBudgetUSD)...)\n \t\tcase \"global_max_open\":\ndiff --git a/internal/config/render.go b/internal/config/render.go\nindex ddc44c2..27e4ca1 100644\n--- a/internal/config/render.go\n+++ b/internal/config/render.go\n@@ -26,6 +26,7 @@ type resolvedYAML struct {\n \tAgent           string                 `yaml:\"agent\"`\n \tRequireApproval bool                   `yaml:\"require_approval\"`\n \tBudgetUSDPerDay float64                `yaml:\"budget_usd_per_day\"`\n+\tTokensPerDay    int64                  `yaml:\"tokens_per_day,omitempty\"`\n \tMaxBudgetUSD    float64                `yaml:\"max_budget_usd\"`\n \tGlobalMaxOpen   int                    `yaml:\"global_max_open\"`\n \tPaused          bool                   `yaml:\"paused\"`\n@@ -116,6 +117,7 @@ type roleYAML struct {\n \n \tMaxBudgetUSD    float64 `yaml:\"max_budget_usd,omitempty\"`\n \tBudgetUSDPerDay float64 `yaml:\"budget_usd_per_day,omitempty\"`\n+\tTokensPerDay    int64   `yaml:\"tokens_per_day,omitempty\"`\n }\n \n type whenYAML struct {\n@@ -132,6 +134,7 @@ func (r *Resolved) render() resolvedYAML {\n \t\tAgent:           r.Agent,\n \t\tRequireApproval: r.RequireApproval,\n \t\tBudgetUSDPerDay: r.BudgetUSDPerDay,\n+\t\tTokensPerDay:    r.TokensPerDay,\n \t\tMaxBudgetUSD:    r.MaxBudgetUSD,\n \t\tGlobalMaxOpen:   r.GlobalMaxOpen,\n \t\tPaused:          r.Paused,\n@@ -188,6 +191,7 @@ func (r *Resolved) render() resolvedYAML {\n \t\t\tDiffMaxLines:    role.DiffMaxLines,\n \t\t\tMaxBudgetUSD:    role.MaxBudgetUSD,\n \t\t\tBudgetUSDPerDay: role.BudgetUSDPerDay,\n+\t\t\tTokensPerDay:    role.TokensPerDay,\n \t\t}\n \t\tif role.When != nil {\n \t\t\try.When = &whenYAML{Paths: role.When.Paths, Triage: role.When.Triage}\ndiff --git a/internal/config/tokens.go b/internal/config/tokens.go\nnew file mode 100644\nindex 0000000..63c7dec\n--- /dev/null\n+++ b/internal/config/tokens.go\n@@ -0,0 +1,86 @@\n+package config\n+\n+import (\n+\t\"fmt\"\n+\t\"math\"\n+\t\"regexp\"\n+\t\"strconv\"\n+\t\"strings\"\n+\n+\t\"gopkg.in/yaml.v3\"\n+)\n+\n+// TokenCount is a token amount that unmarshals from a plain integer or a\n+// string such as \"40M\", \"1.5M\" or \"500k\" (see ParseTokenCount).\n+type TokenCount int64\n+\n+var tokenCountRE = regexp.MustCompile(`^([0-9]+)(?:\\.([0-9]+))?([kKmM]?)$`)\n+\n+// ParseTokenCount parses a positive whole number of tokens: digits with an\n+// optional decimal part and an optional k (x1000) or m (x1,000,000) suffix,\n+// either case. It uses integer arithmetic, so \"1.5M\" is exactly 1500000.\n+// Every error names the offending string.\n+func ParseTokenCount(s string) (int64, error) {\n+\tm := tokenCountRE.FindStringSubmatch(s)\n+\tif m == nil {\n+\t\treturn 0, fmt.Errorf(\"invalid token count %q: expected a number like %q, %q or %q\", s, \"40M\", \"1.5M\", \"500k\")\n+\t}\n+\tintPart, frac, suffix := m[1], m[2], m[3]\n+\tvar mult int64 = 1\n+\tswitch strings.ToLower(suffix) {\n+\tcase \"k\":\n+\t\tmult = 1_000\n+\tcase \"m\":\n+\t\tmult = 1_000_000\n+\t}\n+\tif frac != \"\" && mult == 1 {\n+\t\treturn 0, fmt.Errorf(\"invalid token count %q: a fractional value needs a k or M suffix\", s)\n+\t}\n+\tdigits := strings.TrimLeft(intPart+frac, \"0\")\n+\tif digits == \"\" {\n+\t\treturn 0, fmt.Errorf(\"invalid token count %q: must be greater than zero\", s)\n+\t}\n+\tn, err := strconv.ParseInt(digits, 10, 64)\n+\tif err != nil {\n+\t\treturn 0, fmt.Errorf(\"invalid token count %q: too large\", s)\n+\t}\n+\tif len(frac) > 7 {\n+\t\treturn 0, fmt.Errorf(\"invalid token count %q: too many decimals\", s)\n+\t}\n+\tdiv := int64(math.Pow10(len(frac)))\n+\tif n > math.MaxInt64/mult {\n+\t\treturn 0, fmt.Errorf(\"invalid token count %q: too large\", s)\n+\t}\n+\ttotal := n * mult\n+\tif total%div != 0 {\n+\t\treturn 0, fmt.Errorf(\"invalid token count %q: not a whole number of tokens\", s)\n+\t}\n+\treturn total / div, nil\n+}\n+\n+// String renders t as a plain integer.\n+func (t TokenCount) String() string { return strconv.FormatInt(int64(t), 10) }\n+\n+// UnmarshalYAML accepts a YAML integer or a string.\n+func (t *TokenCount) UnmarshalYAML(value *yaml.Node) error {\n+\tif value.Kind != yaml.ScalarNode {\n+\t\treturn fmt.Errorf(\"expected a token count like %q, got %s\", \"40M\", nodeKindName(value))\n+\t}\n+\tswitch value.Tag {\n+\tcase \"!!null\":\n+\t\t*t = 0\n+\t\treturn nil\n+\tcase \"!!int\", \"!!str\":\n+\t\tn, err := ParseTokenCount(value.Value)\n+\t\tif err != nil {\n+\t\t\treturn err\n+\t\t}\n+\t\t*t = TokenCount(n)\n+\t\treturn nil\n+\tdefault:\n+\t\treturn fmt.Errorf(\"expected a token count like %q, got %q\", \"40M\", value.Value)\n+\t}\n+}\n+\n+// MarshalYAML renders t as an integer.\n+func (t TokenCount) MarshalYAML() (any, error) { return int64(t), nil }\ndiff --git a/internal/config/tokens_test.go b/internal/config/tokens_test.go\nnew file mode 100644\nindex 0000000..4744a76\n--- /dev/null\n+++ b/internal/config/tokens_test.go\n@@ -0,0 +1,47 @@\n+package config\n+\n+import (\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+func TestTokenCount(t *testing.T) {\n+\tok := map[string]int64{\"40M\": 40_000_000, \"1.5M\": 1_500_000, \"500k\": 500_000, \"500K\": 500_000, \"1234\": 1234, \"2.25k\": 2250}\n+\tfor in, want := range ok {\n+\t\tif got, err := ParseTokenCount(in); err != nil || got != want {\n+\t\t\tt.Errorf(\"%q = %d, %v; want %d\", in, got, err, want)\n+\t\t}\n+\t}\n+\tfor _, in := range []string{\"\", \"0\", \"-5\", \"abc\", \"5g\", \"1.5\", \"1e6\", \"0.0001k\", \"9999999999999999999M\", \"9999999999999M\"} {\n+\t\t_, err := ParseTokenCount(in)\n+\t\tif err == nil || !strings.Contains(err.Error(), \"token count\") {\n+\t\t\tt.Errorf(\"%q: err = %v\", in, err)\n+\t\t}\n+\t}\n+}\n+\n+func TestTokensPerDayConfig(t *testing.T) {\n+\tres := mustLoad(t, withConfig(t, \"tokens_per_day: 40M\\noverrides:\\n  workers/engineer: {tokens_per_day: 500k}\\n\"))\n+\teng, _ := res.Role(KindWorker, \"engineer\")\n+\tlead, _ := res.Role(KindTriage, \"lead\")\n+\tif c, set := res.RoleTokensPerDay(eng); !set || c != 500_000 {\n+\t\tt.Errorf(\"engineer = %d, %v\", c, set)\n+\t}\n+\tif c, set := res.RoleTokensPerDay(lead); !set || c != 40_000_000 {\n+\t\tt.Errorf(\"lead = %d, %v\", c, set)\n+\t}\n+\tplain := mustLoad(t, withConfig(t, \"agent: claude\\n\"))\n+\tpeng, _ := plain.Role(KindWorker, \"engineer\")\n+\tif c, set := plain.RoleTokensPerDay(peng); set || c != 0 {\n+\t\tt.Errorf(\"unset = %d, %v\", c, set)\n+\t}\n+\tif plain.render().TokensPerDay != 0 {\n+\t\tt.Error(\"unset key rendered\")\n+\t}\n+\tfor _, bad := range []string{\"0\", \"-3\", \"abc\"} {\n+\t\terrs := loadErrs(t, withConfig(t, \"overrides:\\n  workers/engineer: {tokens_per_day: \"+bad+\"}\\n\"))\n+\t\tif !strings.Contains(errs.Error(), \"tokens_per_day\") {\n+\t\t\tt.Errorf(\"%s: errs = %v\", bad, errs)\n+\t\t}\n+\t}\n+}\ndiff --git a/internal/config/types.go b/internal/config/types.go\nindex 7cc4952..5837f68 100644\n--- a/internal/config/types.go\n+++ b/internal/config/types.go\n@@ -164,6 +164,8 @@ type Role struct {\n \t// Resolved.MaxBudgetUSD and