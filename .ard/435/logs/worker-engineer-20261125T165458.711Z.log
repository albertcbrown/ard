.TokenFunc) error\n\tLsRemote(ctx context.Context, dir, url, pattern string, token gitx.TokenFunc) (map[string]string, error)\n\tSnapshot(ctx context.Context, repoDir, wt, base string, opts ...gitx.SnapshotOptions) (*gitx.Snapshot, error)\n\tMergeBase(ctx context.Context, repoDir, a, b string) (string, error)\n\tChangedPaths(ctx context.Context, dir, from, to string, paths ...string) ([]string, error)\n\tFileAt(ctx context.Context, dir, rev, path string, maxBytes int64) ([]byte, bool, error)\n}\n\n// Offerer is *pool.Pool.\ntype Offerer interface {\n\tOffer(loop string, ttl time.Duration, cands []pool.Candidate) []pool.Decision\n}\n\n// Deps are the loop's collaborators. Executor, Finisher and Parse must be the\n// ones the Reaper uses: the Reaper asks the same executor, and the Finisher\n// shares the one Closer.\ntype Deps struct {\n\tReader   Reader\n\tEffects  Effects\n\tStore    Store\n\tExecutor executor.Executor\n\tFinisher Finisher\n\tCode     CodeCommitter\n\tGit      Git\npackage worker\n\nimport (\n\t\"fmt\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/closeout\"\n\t\"github.com/albertcbrown/ard/internal/committer\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n)\n\nconst (\n\tmaxQuoteRunes     = 4000\n\tsummaryWithheld   = \"Summary withheld by the secret scan.\"\n\tsummaryNone       = \"The agent wrote no summary.\"\n\ttestsRanOutOfTime = \"ran out of time\"\n)\n\n// Title is the PR title: the first line of the code commit message.\nfunc Title(typ, issueTitle string, issue int, jobID string) (string, error) {\n\tmsg, err := committer.CodeMessage(typ, issueTitle, issue, \"\", jobID)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tfirst, _, _ := strings.Cut(msg, \"\\n\")\n\treturn first, nil\n}\n\n// QuoteSummary renders agent text for a PR body: closing references\n// neutralised (including the HTML-entity and backslash forms of \"#\"), ard\n// markers and @-mentions defused, cut to 4,000 runes and quoted. The text must\n// already be redacted.\nfunc QuoteSummary(s string) string {\n\ts = strings.TrimSpace(strings.ReplaceAll(s, \"\\r\", \"\"))\n\tif s == \"\" {\n\t\treturn \"> \" + summaryNone\n\t}\n\ts = closeout.Sanitize(committer.NeutraliseRefs(s))\n\tif r := []rune(s); len(r) > maxQuoteRunes {\n\t\ts = strings.TrimRight(string(r[:maxQuoteRunes]), \"\\n\") + \"\\n… (truncated; full text in the committed file)\"\n\t}\n\tlines := strings.Split(s, \"\\n\")\n\tfor i, l := range lines {\n\t\tlines[i] = strings.TrimRight(\"> \"+l, \" \")\n\t}\n\treturn strings.Join(lines, \"\\n\")\n}\n\n// BodyInfo is what the PR body is made of.\ntype BodyInfo struct {\n\tRepo    github.Repo\n\tIssue   int\n\tRole    string\n\tBranch  string\n\tJobID   string\n\tSummary string // redacted agent text; \"\" when withheld or absent\n\t// Withheld says the secret scan held the summary back.\n\tWithheld bool\n\tResult   closeout.WorkerResult\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_0149oQSLRw43NbvHaWe8DPYb","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
