eWorker, Role: \"engineer\", Issue: 7}\nplan_test.go:166:func TestPlansNotApplyingNextOnFailure(t *testing.T) {\nplan_test.go:168:\tp := failedPlan(j, \"role file missing\", false)\nplan_test.go:172:\tp = failedPlan(j, \"x\", true)\nplan_test.go:176:\tp = failedPlan(Job{Stage: StageReview, Role: \"r\", Issue: 7, PR: 9}, \"x\", false)\nplan_test.go:198:\tfor name, w := range map[string]*WorkerResult{\"with result\": {PR: 9, Tests: TestsPassed}, \"reaper, no result\": nil} {\nplan_test.go:200:\t\t\tj := Job{Stage: StageWorker, Role: \"engineer\", Issue: 7, Worker: w}\nplan_test.go:202:\t\t\tif p.Outcome != OutcomeNeedsNetwork || len(p.Network) != 1 || p.Worker != \"\" || len(p.Requests) != 0 || len(p.Deferred) != 0 {\nplan_test.go:213:\tdone := Job{Stage: StageWorker, Role: \"engineer\", Issue: 7, PR: 9, Worker: &WorkerResult{PR: 9, Tests: TestsPassed}}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01N2AdfdqJ1w8pqxcxDhLUx1","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
