{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MC1SCKURbocT9skmNgEwka","type":"tool_result","content":"// target returns the number labels for this job go on: the PR for a review,\n// the issue otherwise.\nfunc (j Job) target() int {\n\tif j.Stage == StageReview {\n\t\treturn j.PR\n\t}\n\treturn j.Issue\n}\n\n// Build maps a validated role file to a plan, with no files. It is pure.\nfunc Build(j Job, rf RoleFile, rs RoleSet) Plan {\n\tp := Plan{Status: rf.Status}\n\tn := j.target()\n\trun := Label{n, labels.Running(labels.Stage(j.Stage), j.Role)}\n\tswitch {\n\tcase rf.Status == StatusNeedsNetwork && j.Stage == StageWorker:\n\t\tp.Outcome = OutcomeNeedsNetwork\n\t\tp.Network = rf.Network\n\t\tp.Terminal = []Label{{n, labels.NeedsHuman}}\n\t\tp.Remove = []Label{run}\n\t\tif bounce, why := NetworkRound(j, rs); bounce {\n\t\t\tp.Bounced = true\n\t\t\tp.Terminal = nil\n\t\t\tp.Requests = []Label{{n, labels.Request(labels.StageTriage, \"engineer\")}}\n\t\t\tp.Remove = []Label{\n\t\t\t\t{n, labels.Done(labels.StageTriage, \"engineer\")},\n\t\t\t\t{n, labels.Request(labels.StageWorker, j.Role)},\n\t\t\t\trun,\n\t\t\t}\n\t\t} else {\n\t\t\tp.Reason = why\n\t\t}\n\tcase rf.Status != StatusDone:\n\t\tp.Outcome = OutcomeNeedsHuman\n\t\tp.Terminal = []Label{{n, labels.NeedsHuman}}\n\t\tp.Remove = []Label{run}\n\tcase j.Stage == StageReview && rf.Verdict == VerdictChanges:\n\t\tp.Outcome = OutcomeChanges\n\t\tp.Terminal = []Label{{n, labels.Changes(j.Role)}}\n\t\tp.Remove = []Label{{n, labels.Done(labels.Stage(j.Stage), j.Role)}, run}\n\tcase j.Stage == StageReview && rf.Verdict == VerdictApprove && (j.Review == nil || j.Review.HeadMoved):\n\t\t// An approve of a head that has since gained code is not a pass. With\n\t\t// no review context (a Reaper close-out after a restart) the head is\n\t\t// unknown, so it is treated as moved.\n\t\tp.Outcome = OutcomeStale\n\t\tp.Remove = []Label{run}\n\tcase j.Stage == StageWorker:\n\t\tp = buildWorker(j, rf, rs)\n\tdefault:\n\t\tp.Outcome = OutcomeDone\n\t\tp.Terminal = []Label{{n, labels.Done(labels.Stage(j.Stage), j.Role)}}\n\t\tif j.Stage == StageReview {\n\t\t\tp.Remove = append(p.Remove, Label{n, labels.Changes(j.Role)})\n\t\t}\n\t\tif j.Stage == StageTriage && j.Role == \"lead\" {\n\t\t\tp.Remove = append(p.Remove, Label{n, labels.Pending})\n\t\t}\n\t\tp.Remove = append(p.Remove, run)\n\t\tif j.Stage == StageTriage && j.Role == \"engineer\" {\n\t\t\tp.Inputs = rf.Inputs\n\t\t\tif j.Network != nil && j.Network.Round {\n\t\t\t\tp.Rearmed = true\n\t\t\t\tp.Rerun = j.Network.Done\n\t\t\t\tp.Requests = append(p.Requests, Label{n, labels.Pending})\n\t\t\t\tp.Clear = append(p.Clear, Label{n, labels.Done(labels.StageTriage, \"lead\")})\n\t\t\t}\n\t\t}\n\t\tif j.Stage == StageTriage && j.Role == \"lead\" && j.Network != nil {\n\t\t\tfor _, r := range j.Network.Rerun {\n\t\t\t\tif r == \"lead\" || !hasRole(rs, StageTriage, r) {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tp.Requests = append(p.Requests, Label{n, labels.Request(labels.StageTriage, r)})\n\t\t\t\tp.Clear = append(p.Clear, Label{n, labels.Done(labels.StageTriage, r)})\n\t\t\t}\n\t\t}\n\t\tnow, deferred, skipped := resolveNext(j, rf.Next, rs)\n\t\tp.Deferred, p.Skipped = deferred, skipped\n\t\tfor _, r := range now {\n\t\t\tnum := j.Issue\n\t\t\tif r.Stage == StageReview {\n\t\t\t\tnum = j.PR\n\t\t\t}\n\t\t\tp.Requests = append(p.Requests, Label{num, labels.Request(labels.Stage(r.Stage), r.Role)})\n\t\t}\n\t\tif rf.Worker != \"\" {\n\t\t\tif hasRole(rs, StageWorker, rf.Worker) {\n\t\t\t\tp.Worker = rf.Worker\n\t\t\t} else {\n\t\t\t\tp.Skipped = append(p.Skipped, Skip{\"worker:\" + clip(rf.Worker, 60), \"no such role\"})\n\t\t\t}\n\t\t}\n\t}\n\treturn p\n}\n\n// failedPlan is the plan for a job that did not produce a usable result.\nfunc failedPlan(j Job, reason string, logWithheld bool) Plan {\n\tn := j.target()\n\tp := Plan{Outcome: OutcomeFailed, Reason: reason, LogWithheld: logWithheld,\n\t\tTerminal: []Label{{n, labels.ExecutorFailed}},\n\t\tRemove:   []Label{{n, labels.Running(labels.Stage(j.Stage), j.Role)}}}\n\tif logWithheld {\n\t\tp.Terminal = append(p.Terminal, Label{n, labels.NeedsHuman})\n\t}\n\treturn p\n}\n\n// stalePRPlan is the plan for a review whose PR is gone (merged, closed, or its\n// branch deleted). It keeps the review so it is still posted best-effort, but\n// commits nothing and sets no label but removing :running.\nfunc stalePRPlan(p Plan, j Job, why string) Plan {\n\trp := *p.Review\n\trp.PRGone = why\n\treturn Plan{Outcome: OutcomeStale, Status: p.Status, Reason: \"pr gone: \" + why, Summary: p.Summary,\n\t\tReview: &rp, Tail: p.Tail, TailWithheld: p.TailWithheld, KeepUntil: p.KeepUntil,\n\t\tRemove: []Label{{j.target(), labels.Running(labels.Stage(j.Stage), j.Role)}}}\n}\n\n// retryPlan is the plan for a job that failed for a transient cause and hands\n// off to one automatic retry. It removes only :running and leaves the request\n// label alone: a human who removed it to cancel stays cancelled.\nfunc retryPlan(j Job, reason string) Plan {\n\tn := j.target()\n\tst := labels.Stage(j.Stage)\n\treturn Plan{Outcome: OutcomeRetry, Reason: reason,\n\t\tRemove: []Label{{n, labels.Running(st, j.Role)}}}\n}\n\n// limitedPlan is the plan for a job that stopped at a usage limit. It has\n// retryPlan's labels: it removes only :running, leaves the request label alone\n// and adds no terminal label. What differs is the state change (FailLimited)\n// and that it does not touch the automatic retry.\nfunc limitedPlan(j Job, reason string) Plan {\n\tp := retryPlan(j, reason)\n\tp.Outcome = OutcomeLimited\n\treturn p\n}\n\n// needsHumanPlan is the plan for a job held back by the secret scan.\nfunc needsHumanPlan(j Job, status, reason string) Plan {\n\tn := j.target()\n\treturn Plan{Outcome: OutcomeNeedsHuman, Status: status, Reason: reason, LogWithheld: false,\n\t\tTerminal: []Label{{n, labels.NeedsHuman}},\n\t\tRemove:   []Label{{n, labels.Running(labels.Stage(j.Stage), j.Role)}}}\n}\n\nfunc (j Job) validate() error {\n\tswitch j.Stage {\n\tcase StageTriage, StageWorker, StageReview:\n\tdefault:\n\t\treturn fmt.Errorf(\"closeout job %s: stage %q is not triage, worker or review\", j.ID, j.Stage)\n\t}\n\tif j.ID == \"\" || j.Role == \"\" || j.Issue == 0 {\n\t\treturn fmt.Errorf(\"closeout job %q: id, role and issue are required\", j.ID)\n\t}\n\tif j.Cause.Kind != \"\" {\n\t\t// A job that ended for a known cause commits only its log: it needs\n\t\t// neither a base commit nor a branch (an empty branch puts the log on\n\t\t// main under .ard/<issue#>/logs/).\n\t\treturn nil\nfunc (c *Closer) commit(ctx context.Context, rec *Record) error {\n\tp := &rec.Plan\n\tif len(p.Files) == 0 {\n\t\treturn nil\n\t}\n\tisReview := rec.Job.Stage == StageReview && p.Review != nil\n\tif isReview && rec.Job.PR > 0 && c.d.PR != nil {\n\t\tpr, err := c.d.PR(ctx, rec.Job.PR)\n\t\tswitch {\n\t\tcase err != nil:\n\t\t\tc.d.log().Warn(\"closeout: read PR before commit\", \"job\", rec.Job.ID, \"pr\", rec.Job.PR, \"error\", err)\n\t\tcase pr.Merged || pr.State != github.StateOpen:\n\t\t\twhy := \"closed\"\n\t\t\tif pr.Merged {\n\t\t\t\twhy = \"merged\"\n\t\t\t}\n\t\t\tc.prGone(rec, why, why)\n\t\t\treturn nil\n\t\t}\n\t}\n\treq := committer.Request{Issue: rec.Job.Issue, Stage: rec.Job.Stage, Role: rec.Job.Role,\n\t\tSummary: commitSummary(*p), JobID: rec.Job.ID}\n\tsec := sectionOf(c.d.Roles, rec.Job.Stage, rec.Job.Role)\n\tplanPath := fmt.Sprintf(\".ard/%d/plan.md\", rec.Job.Issue)\n\tfor _, f := range p.Files {\n\t\tcf := committer.File{Path: f.Path, Delete: f.Delete}\n\t\tif !f.Delete {\n\t\t\tcf.Src = f.Staged\n\t\t\tif sec != \"\" && f.Path == planPath && rec.Job.Branch == \"\" {\n\t\t\t\tcf.Merge = mergeOwnSection(sec)\n\t\t\t}\n\t\t}\n\t\treq.Files = append(req.Files, cf)\n\t}\n\tres, err := c.d.Committer.Commit(ctx, rec.Job.Branch, req)\n\tswitch {\n\tcase err == nil:\n\t\trec.SHA, rec.Synthetic = res.SHA, res.Synthetic\n\t\treturn nil\n\tcase errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded):\n\t\treturn err\n\t}\n\tc.d.log().Warn(\"closeout: commit failed\", \"job\", rec.Job.ID, \"error\", err)\n\tif p.Outcome == OutcomeRetry || p.Outcome == OutcomeLimited {\n\t\t// The log is evidence, not the result: a retry or a limit stop must\n\t\t// not turn into a failure because it could not be committed (a worker\n\t\t// that stopped before its first push has no branch to commit to).\n\t\tp.Files, p.LogPath = nil, \"\"\n\t\tp.Reason += \"; log not committed: \" + err.Error()\n\t\treturn nil\n\t}\n\ttail, tailWithheld, keep := p.Tail, p.TailWithheld, p.KeepUntil\n\tif isReview && errors.Is(err, committer.ErrBranchGone) {\n\t\tc.prGone(rec, \"branch gone\", \"branch_gone\")\n\t\treturn nil\n\t}\n\tif errors.Is(err, committer.ErrTransient) {\n\t\t// The remote was unavailable past the committer's retries: not a\n\t\t// failure that needs a human. The job hands off to the automatic\n\t\t// retry like any named transient cause.\n\t\trec.Job.Cause = Cause{Kind: CausePushTransient, Detail: \"remote unavailable after retries\", Transient: true, Retry: true}\n\t\t*p = retryPlan(rec.Job, \"push_transient: remote unavailable after retries\")\n\t\tp.Tail, p.TailWithheld, p.KeepUntil = tail, tailWithheld, keep\n\t\treturn nil\n\t}\n\tif errors.Is(err, committer.ErrMerge) {\n\t\treturn c.commitConflict(ctx, rec, err, tail, tailWithheld, keep)\n\t}\n\t*p = failedPlan(rec.Job, \"commit failed: \"+err.Error(), p.LogWithheld)\n\tp.Tail, p.TailWithheld, p.KeepUntil = tail, tailWithheld, keep\n\treturn nil\n}\n\n// prGone turns a review's plan into a stale one: its PR was merged or closed,\n// or its branch deleted, so there is nothing to commit to and nothing failed.\nfunc (c *Closer) prGone(rec *Record, why, state string) {\n\tc.d.log().Warn(\"review.pr_gone\", \"job\", rec.Job.ID, \"pr\", rec.Job.PR, \"issue\", rec.Job.Issue,\npackage closeout\n\nimport (\n\t\"fmt\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/labels\"\n)\n\n// TestResult is how a worker's test run ended.\ntype TestResult string\n\n// Test results.\nconst (\n\tTestsPassed TestResult = \"passed\"\n\tTestsFailed TestResult = \"failed\"\n\tTestsNone   TestResult = \"none\" // the role has no tests configured\n)\n\n// WorkerResult is what the worker loop knows that the role file cannot say:\n// the pull request, the reviewers to request on it and how the tests went. The\n// loop passes it through reaper.Finisher.FinishWith; it is persisted in the\n// close-out record.\ntype WorkerResult struct {\n\tPR    int\n\tPRURL string\n\t// Reviewers are the reviewer roles to request on the PR, de-duplicated and\n\t// already limited to roles that exist. Close-out adds the role file's own\n\t// review requests after them.\n\tReviewers []string\n\tTests     TestResult\n\tFixes     int    // fix attempts that ran\n\tTestNote  string // fixed, non-secret text, such as \"ran out of time\"\n\t// Hold, when set, turns the result into needs-human with this reason (a\n\t// diff guard rejection, for example). It never quotes file content.\n\tHold string\n\t// Large, when set, is the diff guard's fixed note on a PR over the role's\n\t// diff_warn_lines (\"Large change: N changed lines (warn at W)\"). The PR\n\t// still proceeds; the note goes into the PR body and the issue comment.\n\tLarge string\n\t// Fetched are the inputs the worker recorded under fetched: in its role\n\t// file. They come only from the parsed frontmatter, never from free text.\n\tFetched []Fetched\n\t// Pushed is set when this job pushed to the branch. A network bounce\n\t// applies only to a job that did not.\n\tPushed bool `json:\",omitempty\"`\n}\n\n// buildWorker maps a done worker role file and the loop's result to a plan.\nfunc buildWorker(j Job, rf RoleFile, rs RoleSet) Plan {\n\tw := j.Worker\n\tswitch {\n\tcase w == nil:\n\t\treturn needsHumanPlan(j, rf.Status, \"worker ended without the loop's result\")\n\tcase w.Hold != \"\":\n\t\treturn needsHumanPlan(j, rf.Status, w.Hold)\n\tcase j.PR <= 0:\n\t\treturn needsHumanPlan(j, rf.Status, \"worker finished without a pull request\")\n\t}\n\tn, pr := j.Issue, j.PR\n\trun := Label{n, labels.Running(labels.StageWorker, j.Role)}\n\tp := Plan{Status: rf.Status, Outcome: OutcomeDone}\n\tp.Terminal = []Label{{n, labels.Done(labels.StageWorker, j.Role)}}\n\tnow, deferred, skipped := resolveNext(j, rf.Next, rs)\n\tp.Deferred, p.Skipped = deferred, skipped\n\tif w.Tests == TestsFailed {\n\t\tp.Terminal = append(p.Terminal, Label{n, labels.TestsFailed}, Label{pr, labels.TestsFailed})\n\t\tfor _, r := range now {\n\t\t\tp.Skipped = append(p.Skipped, Skip{r.String(), \"tests failed\"})\n\t\t}\n\t} else {\n\t\tp.Remove = append(p.Remove, Label{n, labels.TestsFailed}, Label{pr, labels.TestsFailed})\n\t\tseen := map[string]bool{}\n\t\tadd := func(role string) {\n\t\t\tif seen[role] {\n\t\t\t\treturn\n\t\t\t}\n\t\t\tseen[role] = true\n\t\t\tp.Requests = append(p.Requests, Label{pr, labels.Request(labels.StageReview, role)})\n\t\t}\n66:\trolePath := agent.RoleFilePath(n, j.Stage, j.Role)\n70:\t\trf       RoleFile\n347:func readResult(j Job, rolePath string, log *slog.Logger) (RoleFile, string, error) {\n348:\tb, err := readRoleFile(filepath.Join(j.Worktree, filepath.FromSlash(rolePath)))\n351:\t\treturn RoleFile{}, \"role file missing\", nil\n353:\t\treturn RoleFile{}, \"malformed role file: \" + strings.TrimPrefix(err.Error(), ErrMalformed.Error()+\": \"), nil\n355:\t\treturn RoleFile{}, \"\", fmt.Errorf(\"closeout job %s: %w\", j.ID, err)\n362:\t\treturn RoleFile{}, \"malformed role file: \" + strings.TrimPrefix(err.Error(), ErrMalformed.Error()+\": \"), nil\n399:\tb, err := readRoleFile(full)","is_error":false}]},"parent_tool_use_id":null,"session_id":"0f53e436-51a7-4416-9cdc-1117f8238899","uuid":"f3a98982-93bf-4767-a439-a64bd87a12ee","timestamp":"2026-11-25T16:55:13.949Z","tool_use_result":{"stdout":"// target returns the number labels for this job go on: the PR for a review,\n// the issue otherwise.\nfunc (j Job) target() int {\n\tif j.Stage == StageReview {\n\t\treturn j.PR\n\t}\n\treturn j.Issue\n}\n\n// Build maps a validated role file to a plan, with no files. It is pure.\nfunc Build(j Job, rf RoleFile, rs RoleSet) Plan {\n\tp := Plan{Status: rf.Status}\n\tn := j.target()\n\trun := Label{n, labels.Running(labels.Stage(j.Stage), j.Role)}\n\tswitch {\n\tcase rf.Status == StatusNeedsNetwork && j.Stage == StageWorker:\n\t\tp.Outcome = OutcomeNeedsNetwork\n\t\tp.Network = rf.Network\n\t\tp.Terminal = []Label{{n, labels.NeedsHuman}}\n\t\tp.Remove = []Label{run}\n\t\tif bounce, why := NetworkRound(j, rs); bounce {\n\t\t\tp.Bounced = true\n\t\t\tp.Terminal = nil\n\t\t\tp.Requests = []Label{{n, labels.Request(labels.StageTriage, \"engineer\")}}\n\t\t\tp.Remove = []Label{\n\t\t\t\t{n, labels.Done(labels.StageTriage, \"engineer\")},\n\t\t\t\t{n, labels.Request(labels.StageWorker, j.Role)},\n\t\t\t\trun,\n\t\t\t}\n\t\t} else {\n\t\t\tp.Reason = why\n\t\t}\n\tcase rf.Status != StatusDone:\n\t\tp.Outcome = OutcomeNeedsHuman\n\t\tp.Terminal = []Label{{n, labels.NeedsHuman}}\n\t\tp.Remove = []Label{run}\n\tcase j.Stage == StageReview && rf.Verdict == VerdictChanges:\n\t\tp.Outcome = OutcomeChanges\n\t\tp.Terminal = []Label{{n, labels.Changes(j.Role)}}\n\t\tp.Remove = []Label{{n, labels.Done(labels.Stage(j.Stage), j.Role)}, run}\n\tcase j.Stage == StageReview && rf.Verdict == VerdictApprove && (j.Review == nil || j.Review.HeadMoved):\n\t\t// An approve of a head that has since gained code is not a pass. With\n\t\t// no review context (a Reaper close-out after a restart) the head is\n\t\t// unknown, so it is treated as moved.\n\t\tp.Outcome = OutcomeStale\n\t\tp.Remove = []Label{run}\n\tcase j.Stage == StageWorker:\n\t\tp = buildWorker(j, rf, rs)\n\tdefault:\n\t\tp.Outcome = OutcomeDone\n\t\tp.Terminal = []Label{{n, labels.Done(labels.Stage(j.Stage), j.Role)}}\n\t\tif j.Stage == StageReview {\n\t\t\tp.Remove = append(p.Remove, Label{n, labels.Changes(j.Role)})\n\t\t}\n\t\tif j.Stage == StageTriage && j.Role == \"lead\" {\n\t\t\tp.Remove = append(p.Remove, Label{n, labels.Pending})\n\t\t}\n\t\tp.Remove = append(p.Remove, run)\n\t\tif j.Stage == StageTriage && j.Role == \"engineer\" {\n\t\t\tp.Inputs = rf.Inputs\n\t\t\tif j.Network != nil && j.Network.Round {\n\t\t\t\tp.Rearmed = true\n\t\t\t\tp.Rerun = j.Network.Done\n\t\t\t\tp.Requests = append(p.Requests, Label{n, labels.Pending})\n\t\t\t\tp.Clear = append(p.Clear, Label{n, labels.Done(labels.StageTriage, \"lead\")})\n\t\t\t}\n\t\t}\n\t\tif j.Stage == StageTriage && j.Role == \"lead\" && j.Network != nil {\n\t\t\tfor _, r := range j.Network.Rerun {\n\t\t\t\tif r == \"lead\" || !hasRole(rs, StageTriage, r) {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tp.Requests = append(p.Requests, Label{n, labels.Request(labels.StageTriage, r)})\n\t\t\t\tp.Clear = append(p.Clear, Label{n, labels.Done(labels.StageTriage, r)})\n\t\t\t}\n\t\t}\n\t\tnow, deferred, skipped := resolveNext(j, rf.Next, rs)\n\t\tp.Deferred, p.Skipped = deferred, skipped\n\t\tfor _, r := range now {\n\t\t\tnum := j.Issue\n\t\t\tif r.Stage == StageReview {\n\t\t\t\tnum = j.PR\n\t\t\t}\n\t\t\tp.Requests = append(p.Requests, Label{num, labels.Request(labels.Stage(r.Stage), r.Role)})\n\t\t}\n\t\tif rf.Worker != \"\" {\n\t\t\tif hasRole(rs, StageWorker, rf.Worker) {\n\t\t\t\tp.Worker = rf.Worker\n\t\t\t} else {\n\t\t\t\tp.Skipped = append(p.Skipped, Skip{\"worker:\" + clip(rf.Worker, 60), \"no such role\"})\n\t\t\t}\n\t\t}\n\t}\n\treturn p\n}\n\n// failedPlan is the plan for a job that did not produce a usable result.\nfunc failedPlan(j Job, reason string, logWithheld bool) Plan {\n\tn := j.target()\n\tp := Plan{Outcome: OutcomeFailed, Reason: reason, LogWithheld: logWithheld,\n\t\tTerminal: []Label{{n, labels.ExecutorFailed}},\n\t\tRemove:   []Label{{n, labels.Running(labels.Stage(j.Stage), j.Role)}}}\n\tif logWithheld {\n\t\tp.Terminal = append(p.Terminal, Label{n, labels.NeedsHuman})\n\t}\n\treturn p\n}\n\n// stalePRPlan is the plan for a review whose PR is gone (merged, closed, or its\n// branch deleted). It keeps the review so it is still posted best-effort, but\n// commits nothing and sets no label but removing :running.\nfunc stalePRPlan(p Plan, j Job, why string) Plan {\n\trp := *p.Review\n\trp.PRGone = why\n\treturn Plan{Outcome: OutcomeStale, Status: p.Status, Reason: \"pr gone: \" + why, Summary: p.Summary,\n\t\tReview: &rp, Tail: p.Tail, TailWithheld: p.TailWithheld, KeepUntil: p.KeepUntil,\n\t\tRemove: []Label{{j.target(), labels.Running(labels.Stage(j.Stage), j.Role)}}}\n}\n\n// retryPlan is the plan for a job that failed for a transient cause and hands\n// off to one automatic retry. It removes only :running and leaves the request\n// label alone: a human who removed it to cancel stays cancelled.\nfunc retryPlan(j Job, reason string) Plan {\n\tn := j.target()\n\tst := labels.Stage(j.Stage)\n\treturn Plan{Outcome: OutcomeRetry, Reason: reason,\n\t\tRemove: []Label{{n, labels.Running(st, j.Role)}}}\n}\n\n// limitedPlan is the plan for a job that stopped at a usage limit. It has\n// retryPlan's labels: it removes only :running, leaves the request label alone\n// and adds no terminal label. What differs is the state change (FailLimited)\n// and that it does not touch the automatic retry.\nfunc limitedPlan(j Job, reason string) Plan {\n\tp := retryPlan(j, reason)\n\tp.Outcome = OutcomeLimited\n\treturn p\n}\n\n// needsHumanPlan is the plan for a job held back by the secret scan.\nfunc needsHumanPlan(j Job, status, reason string) Plan {\n\tn := j.target()\n\treturn Plan{Outcome: OutcomeNeedsHuman, Status: status, Reason: reason, LogWithheld: false,\n\t\tTerminal: []Label{{n, labels.NeedsHuman}},\n\t\tRemove:   []Label{{n, labels.Running(labels.Stage(j.Stage), j.Role)}}}\n}\n\nfunc (j Job) validate() error {\n\tswitch j.Stage {\n\tcase StageTriage, StageWorker, StageReview:\n\tdefault:\n\t\treturn fmt.Errorf(\"closeout job %s: stage %q is not triag