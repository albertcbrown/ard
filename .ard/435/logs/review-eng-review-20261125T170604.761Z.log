, &cleaned, &cost, &created, &updated, &ended,\n200:-\t\t&branch, &retryOf, &autoRetry, &killReason, &limitStop, &afterLimit); err != nil {\n201:+\t\t&branch, &retryOf, &autoRetry, &killReason, &limitStop, &afterLimit, &pending); err != nil {\n202: \t\treturn Job{}, err\n203: \t}\n204: \tj.PR = int(pr.Int64)\n205:@@ -101,6 +117,9 @@ func scanJob(r scanner) (Job, error) {\n206: \t}\n207: \tj.Branch, j.RetryOf, j.KillReason, j.AutoRetry = branch.String, retryOf.String, killReason.String, autoRetry != 0\n208: \tj.LimitStop, j.AfterLimit = limitStop != 0, afterLimit.String\n209:+\tif pending.Valid {\n210:+\t\tj.PendingPR = json.RawMessage(pending.String)\n211:+\t}\n212: \tj.CreatedAt = time.Unix(created, 0).UTC()\n213: \tj.UpdatedAt = time.Unix(updated, 0).UTC()\n214: \treturn j, nil\n215:@@ -309,6 +328,43 @@ func (s *Store) SetPR(ctx context.Context, id string, pr int) error {\n216: \treturn s.updateRunning(ctx, \"set pr\", id, `pr = ?`, pr)\n217: }\n218: \n219:+// SetPendingPR records, on a running worker job, that its branch is pushed and\n220:+// only the pull request is missing. A job that is not running, or does not\n221:+// exist, is ErrNotFound.\n222:+func (s *Store) SetPendingPR(ctx context.Context, id string, p PendingPR) error {\n223:+\tif p.Branch == \"\" || p.Head == \"\" {\n224:+\t\treturn fmt.Errorf(\"set pending pr %s: branch and head are required\", id)\n225:+\t}\n226:+\tb, err := json.Marshal(p)\n227:+\tif err != nil {\n228:+\t\treturn fmt.Errorf(\"set pending pr %s: %w\", id, err)\n229:+\t}\n230:+\treturn s.updateRunning(ctx, \"set pending pr\", id, `pending_pr = ?`, string(b))\n231:+}\n232:+\n233:+// LatestPendingPR returns the newest worker job of the issue and role other\n234:+// than except (the caller's own job) and its recorded pending PR. ok is false\n235:+// when that job has none: a newer job supersedes an older record.\n236:+func (s *Store) LatestPendingPR(ctx context.Context, issue int, role, except string) (Job, PendingPR, bool, error) {\n