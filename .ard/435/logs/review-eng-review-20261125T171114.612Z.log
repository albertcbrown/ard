615\t+\t\treturn ctx.Err()\n616\t+\tcase <-t.C:\n617\t+\t\treturn nil\n618\t+\t}\n619\t+}\n620\t+\n621\t+// createWithRetry opens the PR, retrying a transient failure with backoff.\n622\t+// Before each retry it looks for a PR on the head, in case the failed create\n623\t+// reached GitHub. Under dry-run it never retries and never sleeps.\n624\t+func (jb *job) createWithRetry(ctx context.Context, in github.NewPR) (github.PullRequest, error) {\n625\t+\td := jb.l.d\n626\t+\tpr, err := d.Effects.CreatePR(ctx, in)\n627\t+\tfor i := 0; err != nil && github.IsTransient(err) && i < len(prBackoff); i++ {\n628\t+\t\tjb.log.Warn(\"worker.pr_retry\", \"attempt\", i+1, \"wait\", prBackoff[i].String(), \"error\", err)\n629\t+\t\tif d.Effects.DryRun() {\n630\t+\t\t\treturn pr, err\n631\t+\t\t}\n632\t+\t\tif serr := jb.sleep(ctx, prBackoff[i]); serr != nil {\n633\t+\t\t\treturn pr, serr\n634\t+\t\t}\n635\t+\t\tif prs, lerr := d.Reader.ListPRs(ctx, github.ListPRsOpts{State: github.StateOpen, Head: in.Head}); lerr == nil && len(prs) > 0 {\n636\t+\t\t\treturn prs[0], nil\n637\t+\t\t}\n638\t+\t\tpr, err = d.Effects.CreatePR(ctx, in)\n639\t+\t}\n640\t+\treturn pr, err\n641\t+}\n642\t+\n643\t+// failCreate ends the job after the PR could not be opened with the branch\n644\t+// pushed at head: it records what is needed to open the PR later and finishes\n645\t+// with the pr_create_failed cause.\n646\t+func (jb *job) failCreate(ctx context.Context, head, title, body string, res *closeout.WorkerResult) {\n647\t+\trb, _ := json.Marshal(res)\n648\t+\tpp := state.PendingPR{Branch: jb.branch, Head: head, Title: title, Body: body, Summary: jb.summary, Result: rb}\n649\t+\tif jb.summary == \"\" && jb.reopened != nil {\n650\t+\t\tpp.Summary = jb.reopened.Summary\n651\t+\t}\n652\t+\tif err := jb.l.d.Store.SetPendingPR(ctx, jb.sj.ID, pp); err != nil {\n653\t+\t\tjb.log.Error(\"worker.pending_pr_failed\", \"error\", err)\n654\t+\t}\n655\t+\tdetail := fmt.Sprintf(\"pushed branch %s at %s; only the pull request is missing\", jb.branch, shortSHA(head))\n656\t+\tjb.finish(ctx, jb.final, nil, jb.cause(closeout.CausePRCreateFailed, detail, false))\n657\t+}\n658\t+\n659\t+func shortSHA(s string) string {\n660\t+\tif len(s) > 12 {\n661\t+\t\treturn s[:12]\n662\t+\t}\n663\t+\treturn s\n664\t+}\n665\t+\n666\t+// reopenPR opens the PR of an earlier job whose branch was pushed but whose PR\n667\t+// could not be created, from that job's record: no agent step and no tests.\n668\t+// It reports true when it has finished the job. It reports false, and changes\n669\t+// nothing, when there is no record, the branch moved, a PR exists or a lookup\n670\t+// fails: the full run then proceeds as usual.\n671\t+func (jb *job) reopenPR(ctx context.Context) bool {\n672\t+\td := jb.l.d\n673\t+\tif !jb.exists || d.Effects.DryRun() {\n674\t+\t\treturn false\n675\t+\t}\n676\t+\t_, rec, ok, err := d.Store.LatestPendingPR(ctx, jb.is.Number, jb.role.Name, jb.sj.ID)\n677\t+\tif err != nil {\n678\t+\t\tjb.log.Warn(\"worker.reopen_lookup_failed\", \"error\", err)\n679\t+\t\treturn false\n680\t+\t}\n681\t+\tif !ok || rec.Branch != jb.branch {\n682\t+\t\treturn false\n683\t+\t}\n684\t+\tif !jb.tipIsRecorded(ctx, rec.Head) {\n685\t+\t\tjb.log.Info(\"worker.reopen_skipped\", \"reason\", \"branch moved\")\n686\t+\t\treturn false\n687\t+\t}\n688\t+\tprs, err := d.Reader.ListPRs(ctx, github.ListPRsOpts{State: github.StateOpen, Head: jb.branch})\n689\t+\tif err != nil || len(prs) > 0 {\n690\t+\t\tjb.log.Info(\"worker.reopen_skipped\", \"reason\", \"pr exists or lookup failed\", \"error\", err)\n691\t+\t\treturn false\n692\t+\t}\n693\t+\tvar res closeout.WorkerResult\n694\t+\tif err := json.Unmarshal(rec.Result, &res); err != nil {\n695\t+\t\tjb.log.Warn(\"worker.reopen_skipped\", \"reason\", \"bad record\", \"error\", err)\n696\t+\t\treturn false\n697\t+\t}\n698\t+\tjb.pushed, jb.head, jb.branch = true, rec.Head, rec.Branch\n699\t+\tjb.reopened = &rec\n700\t+\tpr, err := jb.createWithRetry(ctx, github.