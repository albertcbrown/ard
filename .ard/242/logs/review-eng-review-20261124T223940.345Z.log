@ -40,6 +46,7 @@ type Effects interface {\n // issue is known. Now nil means time.Now; Log nil means slog.Default.\n type Deps struct {\n \tGate        Capper\n+\tTokens      TokenCapper // nil: no token notices\n \tStore       EventStore\n \tEffects     Effects\n \tStatusIssue func() int\n@@ -91,7 +98,17 @@ func (l *Loop) Tick(ctx context.Context, _ controller.Env) error {\n \tif err != nil {\n \t\treturn fmt.Errorf(\"budget: read spend: %w\", err)\n \t}\n-\tif len(caps) == 0 {\n+\tvar tcaps []TokenCap\n+\tif l.d.Tokens != nil {\n+\t\tvar tday time.Time\n+\t\tif tcaps, tday, err = l.d.Tokens.TokenCapped(ctx); err != nil {\n+\t\t\treturn fmt.Errorf(\"budget: read tokens: %w\", err)\n+\t\t}\n+\t\tif !tday.Equal(dayStart) {\n+\t\t\ttcaps = nil\n+\t\t}\n+\t}\n+\tif len(caps) == 0 && len(tcaps) == 0 {\n \t\treturn nil\n \t}\n \tday := dayStart.Format(\"2006-01-02\")\n@@ -126,6 +143,23 @@ func (l *Loop) Tick(ctx context.Context, _ controller.Env) error {\n \t\t\tl.d.Log.Error(\"budget.notice_unrecorded\", \"scope\", c.Scope, \"stage\", c.Stage, \"role\", c.Role, \"error\", err)\n \t\t}\n \t}\n+\tfor _, c := range tcaps {\n+\t\tif done[noticeKey{\"tokens\", c.Stage, c.Role, day}] {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif _, err := l.d.Effects.CreateComment(ctx, issue, RenderTokens(c, day)); err != nil {\n+\t\t\tl.d.Log.Error(\"budget.notice_failed\", \"scope\", \"tokens\", \"stage\", c.Stage, \"role\", c.Role, \"error\", err)\n+\t\t\tcontinue\n+\t\t}\n+\t\tdata, _ := json.Marshal(map[string]any{\n+\t\t\t\"scope\": \"tokens\", \"stage\": c.Stage, \"role\": c.Role, \"day\": day,\n+\t\t\t\"used\": c.Used, \"cap\": c.Cap, \"worst\": c.Worst,\n+\t\t})\n+\t\tev := state.Event{At: l.d.Now(), Kind: state.EventBudgetCapped, Stage: c.Stage, Role: c.Role, Data: data}\n+\t\tif err := l.d.Store.AppendEvent(ctx, ev); err != nil {\n+\t\t\tl.d.Log.Error(\"budget.notice_unrecorded\", \"scope\", \"tokens\", \"stage\", c.Stage, \"role\", c.Role, \"error\", err)\n+\t\t}\n+\t}\n \treturn nil\n }\n \n@@ -161,3 +195,16 @@ func Render(c Cap, day string) string {\n \tfmt.Fprintf(&b, \"To raise the cap, change %s in `.ard/config.yaml` through a reviewed pull request. The cap clears at 00:00 UTC.\\n\", where)\n \treturn b.String()\n }\n+\n+// RenderTokens is the comment for a blocked token cap on the UTC day. It holds\n+// only numbers, the day and config names; no agent text and no \"@\".\n+func RenderTokens(c TokenCap, day string) string {\n+\tstage, role := safe(c.Stage), safe(c.Role)\n+\tvar b strings.Builder\n+\tfmt.Fprintf(&b, \"<!-- ard:budget cap=tokens role=%s/%s day=%s -->\\n\", stage, role, day)\n+\tb.WriteString(\"**ard · daily token budget reached**\\n\\n\")\n+\tfmt.Fprintf(&b, \"The daily token budget of %s role `%s` blocks new jobs for %s (UTC): %d of %d tokens used, largest recorded job %d tokens.\", stage, role, day, c.Used, c.Cap, c.Worst)\n+\tb.WriteString(\"\\n\\nNo new jobs of this role start under this cap; running jobs finish.\\n\\n\")\n+\tfmt.Fprintf(&b, \"To raise the cap, change `tokens_per_day` of role `%s` (or the repo-wide value) in `.ard/config.yaml` through a reviewed pull request. The cap clears at 00:00 UTC.\\n\", role)\n+\treturn b.String()\n+}\ndiff --git a/internal/budget/tokens.go b/internal/budget/tokens.go\nnew file mode 100644\nindex 0000000..65946ce\n--- /dev/null\n+++ b/internal/budget/tokens.go\n@@ -0,0 +1,147 @@\n+package budget\n+\n+import (\n+\t\"context\"\n+\t\"fmt\"\n+\t\"time\"\n+\n+\t\"github.com/albertcbrown/ard/internal/config\"\n+\t\"github.com/albertcbrown/ard/internal/state\"\n+)\n+\n+// TokenReader reads recorded token usage; *state.Store satisfies it.\n+type TokenReader interface {\n+\tRoleTokens(ctx context.Context, dayStart time.Time) (map[state.RoleKey]int64, error)\n+\tRoleWorstTokens(ctx context.Context, k state.RoleKey) (int64, error)\n+}\n+\n+// SetTokenReader wires the token check. Without a reader no token cap is\n+// checked. Call it before the gate is used.\n+func (g *Gate) SetTokenReader(r TokenReader) { g.tokens = r }\n+\n+// tokenBlocked is the claim rule: with U tokens used today, cap C and worst\n+// case W (the role's largest recorded job total), refuse when U >= C or\n+// C-U < min(W, C). Running jobs reserve nothing.\n+func tokenBlocked(used, limit, worst int64) bool {\n+\treturn used >= limit || limit-used < min(worst, limit)\n+}\n+\n+// tokenFigures reads U and W for one role.\n+func (g *Gate) tokenFigures(ctx context.Context, dayStart time.Time, k state.RoleKey) (used, worst int64, err error) {\n+\tper, err := g.tokens.RoleTokens(ctx, dayStart)\n+\tif err != nil {\n+\t\treturn 0, 0, err\n+\t}\n+\tworst, err = g.tokens.RoleWorstTokens(ctx, k)\n+\tif err != nil {\n+\t\treturn 0, 0, err\n+\t}\n+\treturn per[k], worst, nil\n+}\n+\n+// tokenDenied applies the token rule to one candidate role.\n+func (g *Gate) tokenDenied(ctx context.Context, cfg *config.Resolved, role config.Role, stage string, dayStart time.Time) (bool, string) {\n+\tif g.tokens == nil {\n+\t\treturn false, \"\"\n+\t}\n+\tlimit, set := cfg.RoleTokensPerDay(role)\n+\tif !set {\n+\t\treturn false, \"\"\n+\t}\n+\tused, worst, err := g.tokenFigures(ctx, dayStart, state.RoleKey{Stage: stage, Role: role.Name})\n+\tif err != nil {\n+\t\tg.log.Warn(\"budget.read_failed\", \"cap\", \"tokens\", \"role\", stage+\"/\"+role.Name, \"error\", err)\n+\t\treturn true, \"budget state unreadable\"\n+\t}\n+\tif !tokenBlocked(used, limit, worst) {\n+\t\treturn false, \"\"\n+\t}\n+\tg.mu.Lock()\n+\tif !g.day.Equal(dayStart) {\n+\t\tg.day, g.logged = dayStart, map[string]bool{}\n+\t}\n+\tkey := \"tokens|\" + stage + \"/\" + role.Name\n+\tfirst := !g.logged[key]\n+\tg.logged[key] = true\n+\tg.mu.Unlock()\n+\tif first {\n+\t\tg.log.Warn(\"budget.blocked\", \"cap\", \"tokens\", \"role\", stage+\"/\"+role.Name, \"used\", used, \"limit\", limit, \"worst\", worst)\n+\t}\n+\treturn true, fmt.Sprintf(\"role daily token budget reached: %d of %d tokens used today (UTC), worst job %d\", used, limit, worst)\n+}\n+\n+// TokenCap is one role's token cap and today's figures.\n+type TokenCap struct {\n+\tStage, Role      string\n+\tUsed, Cap, Worst int64\n+}\n+\n+// Blocked reports whether the claim rule refuses the role now.\n+func (c TokenCap) Blocked() bool { return tokenBlocked(c.Used, c.Cap, c.Worst) }\n+\n+// TokenReport returns every role with a token cap, blocked or not, in config\n+// order, and the UTC day start. It logs nothing.\n+func (g *Gate) TokenReport(ctx context.Context) ([]TokenCap, time.Time, error) {\n+\tdayStart := utcDayStart(g.now())\n+\tcfg := g.cfg()\n+\tif cfg == nil || g.tokens == nil {\n+\t\treturn nil, dayStart, nil\n+\t}\n+\tvar out []TokenCap\n+\tvar per map[state.RoleKey]int64\n+\tfor _, role := range cfg.Roles {\n+\t\tif role.Kind == config.KindScanner && role.ScanPath != \"\" {\n+\t\t\tcontinue\n+\t\t}\n+\t\tstage, ok := stageOf(role.Kind)\n+\t\tif !ok {\n+\t\t\tcontinue\n+\t\t}\n+\t\tlimit, set := cfg.RoleTokensPerDay(role)\n+\t\tif !set {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif per == nil {\n+\t\t\tvar err error\n+\t\t\tif per, err = g.tokens.RoleTokens(ctx, dayStart); err != nil {\n+\t\t\t\treturn nil, dayStart, err\n+\t\t\t}\n+\t\t}\n+\t\tk := state.RoleKey{Stage: stage, Role: role.Name}\n+\t\tworst, err := g.tokens.RoleWorstTokens(ctx, k)\n+\t\tif err != nil {\n+\t\t\treturn nil, dayStart, err\n+\t\t}\n+\t\tout = append(out, TokenCap{Stage: stage, Role: role.Name, Used: per[k], Cap: limit, Worst: worst})\n+\t}\n+\treturn out, dayStart, nil\n+}\n+\n+// TokenCapped returns only the blocked token caps. It logs nothing.\n+func (g *Gate) TokenCapped(ctx context.Context) ([]TokenCap, time.Time, error) {\n+\tall, day, err := g.TokenReport(ctx)\n+\tif err != nil {\n+\t\treturn nil, day, err\n+\t}\n+\tvar out []TokenCap\n+\tfor _, c := range all {\n+\t\tif c.Blocked() {\n+\t\t\tout = append(out, c)\n+\t\t}\n+\t}\n+\treturn out, day, nil\n+}\n+\n+func stageOf(k config.Kind) (string, bool) {\n+\tswitch k {\n+\tcase config.KindScanner:\n+\t\treturn \"scanner\", true\n+\tcase config.KindTriage:\n+\t\treturn \"triage\", true\n+\tcase config.KindWorker:\n+\t\treturn \"worker\", true\n+\tcase config.KindReviewer:\n+\t\treturn \"review\", true\n+\t}\n+\treturn \"\", false\n+}\ndiff --git a/internal/budget/tokens_test.go b/internal/budget/tokens_test.go\nnew file mode 100644\nindex 0000000..bea1edd\n--- /dev/null\n+++ b/internal/budget/tokens_test.go\n@@ -0,0 +1,261 @@\n+package budget\n+\n+import (\n+\t\"bytes\"\n+\t\"context\"\n+\t\"errors\"\n+\t\"log/slog\"\n+\t\"strings\"\n+\t\"testing\"\n+\t\"time\"\n+\n+\t\"github.com/albertcbrown/ard/internal/config\"\n+\t\"github.com/albertcbrown/ard/internal/controller\"\n+\t\"github.com/albertcbrown/ard/internal/pool\"\n+\t\"github.com/albertcbrown/ard/internal/state\"\n+)\n+\n+type fakeTokens struct {\n+\tbyDay    map[time.Time]map[state.RoleKey]int64\n+\tworst    map[state.RoleKey]int64\n+\terr      error\n+\tworstErr error\n+}\n+\n+func (f *fakeTokens) RoleTokens(_ context.Context, d time.Time) (map[state.RoleKey]int64, error) {\n+\treturn f.byDay[d], f.err\n+}\n+func (f *fakeTokens) RoleWorstTokens(_ context.Context, k state.RoleKey) (int64, error) {\n+\treturn f.worst[k], f.worstErr\n+}\n+\n+var (\n+\tday4   = time.Date(2026, 3, 4, 0, 0, 0, 0, time.UTC)\n+\tday5   = day4.AddDate(0, 0, 1)\n+\tengKey = state.RoleKey{Stage: \"worker\", Role: \"eng\"}\n+\trevKey = state.RoleKey{Stage: \"review\", Role: \"rev\"}\n+)\n+\n+func tokCfg() *config.Resolved {\n+\treturn &config.Resolved{Roles: []config.Role{\n+\t\t{Kind: config.KindWorker, Name: \"eng\", TokensPerDay: 100},\n+\t\t{Kind: config.KindReviewer, Name: \"rev\", TokensPerDay: 100},\n+\t\t{Kind: config.KindWorker, Name: \"free\"},\n+\t\t{Kind: config.KindScanner, Name: \"det\", ScanPath: \"x\"},\n+\t}}\n+}\n+\n+func tokGate(cfg func() *config.Resolved, sp SpendReader, tr *fakeTokens) (*Gate, *bytes.Buffer, *time.Time) {\n+\tnow := time.Date(2026, 3, 4, 23, 59, 59, 0, time.UTC)\n+\tvar buf bytes.Buffer\n+\tg := New(sp, cfg, func() time.Time { return now }, slog.New(slog.NewTextHandler(&buf, nil)))\n+\tg.SetTokenReader(tr)\n+\treturn g, &buf, &now\n+}\n+\n+func TestTokenRule(t *testing.T) {\n+\tfor _, c := range []struct {\n+\t\tu, cp, w int64\n+\t\tblock    bool\n+\t}{\n+\t\t{0, 100, 50, false}, {50, 100, 50, false}, {51, 100, 50, true},\n+\t\t{100, 100, 0, true}, {0, 100, 500, false}, {1, 100, 500, true},\n+\t\t{99, 100, 0, false}, {101, 100, 0, true},\n+\t} {\n+\t\tif got := tokenBlocked(c.u, c.cp, c.w); got != c.block {\n+\t\t\tt.Errorf(\"U=%d C=%d W=%d: got %v\", c.u, c.cp, c.w, got)\n+\t\t}\n+\t}\n+}\n+\n+func TestTokenBlocksOnlyThatRole(t *testing.T) {\n+\ttr := &fakeTokens{byDay: map[time.Time]map[state.RoleKey]int64{day4: {engKey: 60, revKey: 10}}, worst: map[state.RoleKey]int64{engKey: 50, revKey: 50}}\n+\tg, buf, _ := tokGate(tokCfg, &fakeReader{}, tr)\n+\tif d, why := g.Denied(cand(pool.ClassWorker, \"eng\")); !d || !strings.Contains(why, \"token\") {\n+\t\tt.Errorf(\"eng: %v %q\", d, why)\n+\t}\n+\tif d, _ := g.Denied(cand(pool.ClassReview, \"rev\")); d {\n+\t\tt.Error(\"rev must run\")\n+\t}\n+\tif d, _ := g.Denied(cand(pool.ClassWorker, \"free\")); d {\n+\t\tt.Error(\"uncapped role must run\")\n+\t}\n+\tg.Denied(cand(pool.ClassWorker, \"eng\"))\n+\tif n := strings.Count(buf.String(), \"budget.blocked\"); n != 1 {\n+\t\tt.Errorf(\"budget.blocked logged %d times\", n)\n+\t}\n+}\n+\n+func TestKimiTokenCapNoDollar(t *testing.T) {\n+\tcfg := func() *config.Resolved {\n+\t\treturn &config.Resolved{Roles: []config.Role{{Kind: config.KindWorker, Name: \"eng\", TokensPerDay: 100}}}\n+\t}\n+\ttr := &fakeTokens{byDay: map[time.Time]map[state.RoleKey]int64{day4: {engKey: 100}}}\n+\tg, _, _ := tokGate(cfg, &fakeReader{}, tr)\n+\tif d, _ := g.Denied(cand(pool.ClassWorker, \"eng\")); !d {\n+\t\tt.Error(\"token cap alone must refuse\")\n+\t}\n+}\n+\n+func TestRepoTokenDefault(t *testing.T) {\n+\tcfg := func() *config.Resolved {\n+\t\treturn &config.Resolved{TokensPerDay: 100, Roles: []config.Role{{Kind: config.KindWorker, Name: \"eng\"}}}\n+\t}\n+\ttr := &fakeTokens{byDay: map[time.Time]map[state.RoleKey]int64{day4: {engKey: 100}}}\n+\tg, _, _ := tokGate(cfg, &fakeReader{}, tr)\n+\tif d, _ := g.Denied(cand(pool.ClassWorker, \"eng\")); !d {\n+\t\tt.Error(\"repo default must apply\")\n+\t}\n+}\n+\n+func TestBothCaps(t *testing.T) {\n+\tcfg := func() *config.Resolved {\n+\t\treturn &config.Resolved{Roles: []config.Role{{Kind: config.KindWorker, Name: \"eng\", TokensPerDay: 100, BudgetUSDPerDay: 10}}}\n+\t}\n+\tfor _, c := range []struct {\n+\t\tusd  float64\n+\t\ttok  int64\n+\t\tdeny bool\n+\t}{{10, 0, true}, {0, 100, true}, {0, 0, false}} {\n+\t\tr := &fakeReader{per: map[state.RoleKey]state.Spend{engKey: {USD: c.usd}}}\n+\t\ttr := &fakeTokens{byDay: map[time.Time]map[state.RoleKey]int64{day4: {engKey: c.tok}}}\n+\t\tg, _, _ := tokGate(cfg, r, tr)\n+\t\tif d, _ := g.Denied(cand(pool.ClassWorker, \"eng\")); d != c.deny {\n+\t\t\tt.Errorf(\"usd=%v tok=%d: denied=%v\", c.usd, c.tok, d)\n+\t\t}\n+\t}\n+}\n+\n+func TestScannerExempt(t *testing.T) {\n+\ttr := &fakeTokens{err: errors.New(\"boom\")}\n+\tg, _, _ := tokGate(tokCfg, &fakeReader{}, tr)\n+\tif d, _ := g.Denied(cand(pool.ClassScanner, \"det\")); d {\n+\t\tt.Error(\"deterministic scanner must pass\")\n+\t}\n+}\n+\n+func TestTokenReadFailsClosed(t *testing.T) {\n+\tfor name, tr := range map[string]*fakeTokens{\n+\t\t\"usage\": {err: errors.New(\"boom\")},\n+\t\t\"worst\": {worstErr: errors.New(\"boom\")},\n+\t} {\n+\t\tg, buf, _ := tokGate(tokCfg, &fakeReader{}, tr)\n+\t\td, why := g.Denied(cand(pool.ClassWorker, \"eng\"))\n+\t\tif !d || !strings.Contains(why, \"budget state unreadable\") {\n+\t\t\tt.Errorf(\"%s:","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/ard-home/.claude/projects/-Users-al--ard-work-albertcbrown-ard-01M87VDYCSESJ1JCQNBYQP0S9F/2b1a70b3-7bed-4c55-980b-19d56a799374/tool-results/bi2da78p7.txt","persistedOutputSize":31774},"tool_result_meta"