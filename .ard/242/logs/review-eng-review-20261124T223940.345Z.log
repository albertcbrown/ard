.Event{At: l.d.Now(), Kind: state.EventBudgetCapped, Stage: c.Stage, Role: c.Role, Data: data}\n+\t\tif err := l.d.Store.AppendEvent(ctx, ev); err != nil {\n+\t\t\tl.d.Log.Error(\"budget.notice_unrecorded\", \"scope\", \"tokens\", \"stage\", c.Stage, \"role\", c.Role, \"error\", err)\n+\t\t}\n+\t}\n \treturn nil\n }\n \n@@ -161,3 +195,16 @@ func Render(c Cap, day string) string {\n \tfmt.Fprintf(&b, \"To raise the cap, change %s in `.ard/config.yaml` through a reviewed pull request. The cap clears at 00:00 UTC.\\n\", where)\n \treturn b.String()\n }\n+\n+// RenderTokens is the comment for a blocked token cap on the UTC day. It holds\n+// only numbers, the day and config names; no agent text and no \"@\".\n+func RenderTokens(c TokenCap, day string) string {\n+\tstage, role := safe(c.Stage), safe(c.Role)\n+\tvar b strings.Builder\n+\tfmt.Fprintf(&b, \"<!-- ard:budget cap=tokens role=%s/%s day=%s -->\\n\", stage, role, day)\n+\tb.WriteString(\"**ard · daily token budget reached**\\n\\n\")\n+\tfmt.Fprintf(&b, \"The daily token budget of %s role `%s` blocks new jobs for %s (UTC): %d of %d tokens used, largest recorded job %d tokens.\", stage, role, day, c.Used, c.Cap, c.Worst)\n+\tb.WriteString(\"\\n\\nNo new jobs of this role start under this cap; running jobs finish.\\n\\n\")\n+\tfmt.Fprintf(&b, \"To raise the cap, change `tokens_per_day` of role `%s` (or the repo-wide value) in `.ard/config.yaml` through a reviewed pull request. The cap clears at 00:00 UTC.\\n\", role)\n+\treturn b.String()\n+}\ndiff --git a/internal/budget/tokens.go b/internal/budget/tokens.go\nnew file mode 100644\nindex 0000000..65946ce\n--- /dev/null\n+++ b/internal/budget/tokens.go\n@@ -0,0 +1,147 @@\n+package budget\n+\n+import (\n+\t\"context\"\n+\t\"fmt\"\n+\t\"time\"\n+\n+\t\"github.com/albertcbrown/ard/internal/config\"\n+\t\"github.com/albertcbrown/ard/internal/state\"\n+)\n+\n+// TokenReader reads recorded token usage; *state.Store satisfies it.\n+type TokenReader interface {\n+\tRoleTokens(ctx context.Context, dayStart time.Time) (map[state.RoleKey]int64, error)\n+\tRoleWorstTokens(ctx context.Context, k state.RoleKey) (int64, error)\n+}\n+\n+// SetTokenReader wires the token check. Without a reader no token cap is\n+// checked. Call it before the gate is used.\n+func (g *Gate) SetTokenReader(r TokenReader) { g.tokens = r }\n+\n+// tokenBlocked is the claim rule: with U tokens used today, cap C and worst\n+// case W (the role's largest recorded job total), refuse when U >= C or\n+// C-U < min(W, C). Running jobs reserve nothing.\n+func tokenBlocked(used, limit, worst int64) bool {\n+\treturn used >= limit || limit-used < min(worst, limit)\n+}\n+\n+// tokenFigures reads U and W for one role.\n+func (g *Gate) tokenFigures(ctx context.Context, dayStart time.Time, k state.RoleKey) (used, worst int64, err error) {\n+\tper, err := g.tokens.RoleTokens(ctx, dayStart)\n+\tif err != nil {\n+\t\treturn 0, 0, err\n+\t}\n+\tworst, err = g.tokens.RoleWorstTokens(ctx, k)\n+\tif err != nil {\n+\t\treturn 0, 0, err\n+\t}\n+\treturn per[k], worst, nil\n+}\n+\n+// tokenDenied applies the token rule to one candidate role.\n+func (g *Gate) tokenDenied(ctx context.Context, cfg *config.Resolved, role config.Role, stage string, dayStart time.Time) (bool, string) {\n+\tif g.tokens == nil {\n+\t\treturn false, \"\"\n+\t}\n+\tlimit, set := cfg.RoleTokensPerDay(role)\n+\tif !set {\n+\t\treturn false, \"\"\n+\t}\n+\tused, worst, err := g.tokenFigures(ctx, dayStart, state.RoleKey{Stage: stage, Role: role.Name})\n+\tif err != nil {\n+\t\tg.log.Warn(\"budget.read_failed\", \"cap\", \"tokens\", \"role\", stage+\"/\"+role.Name, \"error\", err)\n+\t\treturn true, \"budget state unreadable\"\n+\t}\n+\tif !tokenBlocked(used, limit, worst) {\n+\t\treturn false, \"\"\n+\t}\n+\tg.mu.Lock()\n+\tif !g.day.Equal(dayStart) {\n+\t\tg.day, g.logged = dayStart, map[string]bool{}\n+\t}\n+\tkey := \"tokens|\" + stage + \"/\" + role.Name\n+\tfirst := !g.logged[key]\n+\tg.logged[key] = true\n+\tg.mu.Unlock()\n+\tif first {\n+\t\tg.log.Warn(\"budget.blocked\", \"cap\", \"tokens\", \"role\", stage+\"/\"+role.Name, \"used\", used, \"limit\", limit, \"worst\", worst)\n+\t}\n+\treturn true, fmt.Sprintf(\"role daily token budget reached: %d of %d tokens used today (UTC), worst job %d\", used, limit, worst)\n+}\n+\n+// TokenCap is one role's token cap and today's figures.\n+type TokenCap struct {\n+\tStage, Role      string\n+\tUsed, Cap, Worst int64\n+}\n+\n+// Blocked reports whether the claim rule refuses the role now.\n+func (c TokenCap) Blocked() bool { return tokenBlocked(c.Used, c.Cap, c.Worst) }\n+\n+// TokenReport returns every role with a token cap, blocked or not, in config\n+// order, and the UTC day start. It logs nothing.\n+func (g *Gate) TokenReport(ctx context.Context) ([]TokenCap, time.Time, error) {\n+\tdayStart := utcDayStart(g.now())\n+\tcfg := g.cfg()\n+\tif cfg == nil || g.tokens == nil {\n+\t\treturn nil, dayStart, nil\n+\t}\n+\tvar out []TokenCap\n+\tvar per map[state.RoleKey]int64\n+\tfor _, role := range cfg.Roles {\n+\t\tif role.Kind == config.KindScanner && role.ScanPath != \"\" {\n+\t\t\tcontinue\n+\t\t}\n+\t\tstage, ok := stageOf(role.Kind)\n+\t\tif !ok {\n+\t\t\tcontinue\n+\t\t}\n+\t\tlimit, set := cfg.RoleTokensPerDay(role)\n+\t\tif !set {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif per == nil {\n+\t\t\tvar err error\n+\t\t\tif per, err = g.tokens.RoleTokens(ctx, dayStart); err != nil {\n+\t\t\t\treturn nil, dayStart, err\n+\t\t\t}\n+\t\t}\n+\t\tk := state.RoleKey{Stage: stage, Role: role.Name}\n+\t\tworst, err := g.tokens.RoleWorstTokens(ctx, k)\n+\t\tif err != nil {\n+\t\t\treturn nil, dayStart, err\n+\t\t}\n+\t\tout = append(out, TokenCap{Stage: stage, Role: role.Name, Used: per[k], Cap: limit, Worst: worst})\n+\t}\n+\treturn out, dayStart, nil\n+}\n+\n+// TokenCapped returns only the blocked token caps. It logs nothing.\n+func (g *Gate) TokenCapped(ctx context.Context) ([]TokenCap, time.Time, error) {\n+\tall, day, err := g.TokenReport(ctx)\n+\tif err != nil {\n+\t\treturn nil, day, err\n+\t}\n+\tvar out []TokenCap\n+\tfor _, c := range all {\n+\t\tif c.Blocked() {\n+\t\t\tout = append(out, c)\n+\t\t}\n+\t}\n+\treturn out, day, nil\n+}\n+\n+func stageOf(k config.Kind) (string, bool) {\n+\tswitch k {\n+\tcase config.KindScanner:\n+\t\treturn \"scanner\", true\n+\tcase config.KindTriage:\n+\t\treturn \"triage\", true\n+\tcase config.KindWorker:\n+\t\treturn \"worker\", true\n+\tcase config.KindReviewer:\n+\t\treturn \"review\", true\n+\t}\n+\treturn \"\", false\n+}\ndiff --git a/internal/budget/tokens_test.go b/internal/budget/tokens_test.go\ncosts\nlogs\nplan.md\ntriage-engineer.md\ntriage-lead.md\nworker-engineer.md\n# Plan for #242\n\n## Implementation\n\n### Steps\n1. `internal/budget/tokens.go` (new). Define `type TokenReader interface { RoleTokens(ctx, dayStart time.Time) (map[state.RoleKey]int64, error); RoleWorstTokens(ctx, k state.RoleKey) (int64, error) }` (both exist in `internal/state/usage.go`; `*state.Store` satisfies it). Add `func (g *Gate) SetTokenReader(r TokenReader)` (keeps `New`'s signature, so existing callers and tests compile). Add the pure rule `func tokenBlocked(used, cap, worst int64) bool { return used >= cap || cap-used < min(worst, cap) }` (U, C, W as in the issue). Add `func (g *Gate) tokenDenied(ctx, cfg, role, stage, dayStart) (bool, string)`: no cap from `cfg.RoleTokensPerDay(role)` means allow; read `RoleTokens` and `RoleWorstTokens`; any read error logs WARN `budget.read_failed` and returns refuse with `budget state unreadable`. Running jobs reserve nothing: only recorded usage counts. On a block, log `budget.blocked` once per cap and UTC day (reuse the `mu`/`logged` map with a `tokens|` key prefix) with role, used, cap, worst, and return a reason that holds numbers only.\n2. `internal/budget/budget.go`: in `Denied`, after the existing scanner and no-role early returns (deterministic scanners with `ScanPath` stay exempt), run the dollar checks, then the token check. A refusal from either refuses the job. Reuse the one `dayStart`. If no token reader is set, skip the token check (a nil reader means no token caps are wired, not a failure). Update the package doc comment.\n3. `internal/budget/tokens.go`: `type TokenCap struct { Stage, Role string; Used, Cap, Worst int64 }` and `func (g *Gate) TokenReport(ctx) ([]TokenCap, time.Time, error)`, returning every role with a token cap and its used, cap and worst figures, blocked or not, in config order, for #58 and a future `ard status`. Add `func (g *Gate) TokenCapped(ctx)` returning only the blocked ones (same rule as `tokenBlocked`). It logs nothing.\n4. `internal/budget/notice.go`: make the `Capper` interface also return token caps, or add a second `TokenCapper` interface. `Deps` gets it; a nil value means no token notices. In `Tick`, for each blocked token cap, dedupe using the `budget_capped` event with `scope: \"tokens\"`, `stage`, `role` and `day` (the existing `noticeKey`), then call `CreateComment` with the new `RenderTokens(c TokenCap, day string)`. Keep `Render` and its `<!-- ard:budget scope=... -->` marker as they are. The token marker is exactly `<!-- ard:budget cap=tokens role=<kind>/<name> day=<YYYY-MM-DD> -->`; build `<kind>/<name>` from `safe()` values. The body holds only numbers, the day and config names, with no agent text and no `@`. The event data holds used, cap and worst. Check that the early return on `len(caps)==0` does not skip token caps.\n5. `internal/servecmd/budget.go`: in `budgetGate()`, call `w.bgt.SetTokenReader(w.Store)` and pass the gate to the loop for token caps. `internal/servecmd/serve.go:300` already passes `w.budgetGate().Denied` to the pool, so no pool change is needed and the verdict stays `DeniedBudget` (`internal/pool/pool.go:26`). Fix the comments there (\"daily dollar cap\") to say \"dollar or token cap\".\n6. `docs/proposal.md`: Guardrails \"Budgets\" bullet (about line 518): replace \"nothing is enforced yet\" with the rule (refuse when `U >= C` or `C - U < min(W, C)`; W is the role's largest reported job total; running jobs reserve nothing; scanners exempt; unreadable state refuses with `budget state unreadable`; once-a-day notice with its marker). Configuration (line 452): drop \"recorded only, not enforced yet\". Executors and the Reaper: add that the claim gate checks tokens as well as dollars, and that a running job is never killed for a token cap. There is a docs drift test in `make test`; check what it covers and keep the wording consistent.\n\n### Test plan\nCommand: `make test` (or `go test ./internal/budget/... ./internal/servecmd/... ./internal/pool/...` while iterating). Use a fake clock and a fake token reader in `internal/budget/budget_test.go` and a new `internal/budget/tokens_test.go`.\n- `TestTokenRule` (table, `tokens_test.go`): (U=0,C=100,W=50) allow; (U=50,C=100,W=50) allow, since C-U equals W; (U=51,C=100,W=50) block; (U=100,C=100,W=0) block; (W=500,C=100,U=0) allow, since min(W,C)=C and C-U=C; (W=500,C=100,U=1) block; W=0 (no history) blocks only at U>=C.\n- `TestTokenBlocksOnlyThatRole`: two roles; the one below its worst case is refused, the other is allowed.\n- `TestKimiTokenCapNoDollar`: a role with `tokens_per_day` and no dollar cap, with zero spend and unpriced steps, is refused by tokens alone.\n- `TestBothCaps`: dollar failing with tokens ok, tokens failing with dollar ok, and both ok; the first two are refused and the last is allowed.\n- `TestScannerExempt`: a deterministic scanner (`ScanPath`) is never checked, even with the repo cap set and the reader returning errors.\n- `TestTokenReadFailsClosed`: reader error means refused, reason contains `budget state unreadable`, log has WARN `budget.read_failed`; also for the worst-tokens call failing.\n- `TestTokenResetAtMidnightUTC`: used tokens at 23:59:59 block, and at 00:00:00 the next day they allow (the fake clock moves the day; the reader returns data per `dayStart`).\n- `TestBlockedLoggedOncePerDay`: `budget.blocked` once per cap per day.\n- `TestTokenReport` and `TestTokenCapped`: figures and order.\n- `notice_test.go`: `TestTokenNoticeOncePerDay` (two ticks make one comment; the next day makes a second), `TestTokenNoticeMarker` (exact marker string, no `@`, unsafe names become `?`), `TestTokenNoticeRestart` (an existing `budget_capped` event stops a repeat), and a dollar notice that still renders as before.\n- Edge cases: no token cap set; the repo-wide `tokens_per_day` default applies to roles without their own; a nil token reader; a dry run (ledger only).\n\n### Risk\nMedium. This is the claim path for every job, and the fail-closed branch (a read failure refuses all capped roles) can stall the pool if the store is unhealthy; the issue asks a human to review the rule table and that branch. No change touches `merge.protected_paths`, the database schema or the public CLI. `docs/proposal.md` is not protected. The gate is called from the pool's scheduling pass, and `Denied` already takes a mutex only for the log map, so keep the new reads outside that lock. Token reads add two queries per candidate; keep them cheap (consider reading `RoleWorstTokens` only when a cap is set, as planned).\n\n### Size\nM to L (about 300 lines changed, tests included). Files: `internal/budget/tokens.go` (new), `internal/budget/tokens_test.go` (new), `internal/budget/budget.go`, `internal/budget/budget_test.go`, `internal/budget/notice.go`, `internal/budget/notice_test.go`, `internal/servecmd/budget.go`, `internal/pool/pool.go` (comments only), `docs/proposal.md`.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01LkL3jhneh9ZTHaNP58d4wW","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
