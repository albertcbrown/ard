cks new jobs for %s (UTC): %d of %d tokens used, largest recorded job %d tokens.\", stage, role, day, c.Used, c.Cap, c.Worst)\n\tb.WriteString(\"\\\\n\\\\nNo new jobs of this role start under this cap; running jobs finish.\\\\n\\\\n\")\n\tfmt.Fprintf(&b, \"To raise the cap, change `tokens_per_day` of role `%s` (or the repo-wide value) in `.ard/config.yaml` through a reviewed pull request. The cap clears at 00:00 UTC.\\\\n\", role)\n\treturn b.String()\n}\n'''\nopen(p,'w').write(s)\np='../servecmd/budget.go'\ns=open(p).read()\ns=s.replace(\"w.Log)\\n\t}\",\"w.Log)\\n\t\tw.bgt.SetTokenReader(w.Store)\\n\t}\")\ns=s.replace(\"Gate: w.budgetGate(), Store\",\"Gate: w.budgetGate(), Tokens: w.budgetGate(), Store\")\nopen(p,'w').write(s)\nEOF\ngofmt -l . ../servecmd; go build ./... ; grep -n \"dollar\" ../pool/pool.go ../servecmd/*.go | grep -v _test; sed -n 1,60p budget_test.go; grep -n \"^func\" notice_test.go"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7187,"cache_read_input_tokens":15609,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7187},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9855999e-70a3-42e7-926d-e47c97789325","uuid":"704d2654-4cbf-43f3-a9ce-481fc0db58b9","timestamp":"2026-11-24T22:20:43.742Z","request_id":"req_011ChNXmtDc6s8ENK9kQd3vQ"}
