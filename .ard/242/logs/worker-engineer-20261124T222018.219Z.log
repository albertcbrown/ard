{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XFNJGxadvCkzqNzfWw79kV","type":"tool_result","content":"     168 budget.go\n     137 budget_test.go\n     163 notice.go\n     227 notice_test.go\n     695 total\n// Package budget enforces the daily dollar caps at the pool's claim gate.\n//\n// The day is the UTC day. A candidate is refused when spent >= cap, for its\n// role's own cap (budget_usd_per_day on the role) or the repo cap. Steps that\n// reported no cost count as $0 and their number is shown. Reviewers get no\n// exemption; deterministic scanners cost nothing and are exempt. A job that\n// already holds a slot is never touched: the gate only sees new candidates.\n// A state read failure denies (fails closed).\npackage budget\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/pool\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// SpendReader reads today's spend; *state.Store satisfies it.\ntype SpendReader interface {\n\tSpendSince(ctx context.Context, dayStart time.Time) (map[state.RoleKey]state.Spend, state.Spend, error)\n}\n\n// Gate is the pool's Options.Budget hook.\ntype Gate struct {\n\tstore SpendReader\n\tcfg   func() *config.Resolved\n\tnow   func() time.Time\n\tlog   *slog.Logger\n\n\tmu     sync.Mutex\n\tday    time.Time       // UTC day start the logged map belongs to\n\tlogged map[string]bool // caps already logged on day\n}\n\n// New builds a Gate. cfg returns the latest config (nil: nothing is capped);\n// now nil means time.Now; log nil means slog.Default.\nfunc New(store SpendReader, cfg func() *config.Resolved, now func() time.Time, log *slog.Logger) *Gate {\n\tif now == nil {\n\t\tnow = time.Now\n\t}\n\tif log == nil {\n\t\tlog = slog.Default()\n\t}\n\treturn &Gate{store: store, cfg: cfg, now: now, log: log, logged: map[string]bool{}}\n}\n\nfunc kindOf(c pool.Class) (config.Kind, string, bool) {\n\tswitch c {\n\tcase pool.ClassScanner:\n\t\treturn config.KindScanner, c.String(), true\n\tcase pool.ClassTriage:\n\t\treturn config.KindTriage, c.String(), true\n\tcase pool.ClassWorker:\n\t\treturn config.KindWorker, c.String(), true\n\tcase pool.ClassReview:\n\t\treturn config.KindReviewer, c.String(), true\n\t}\n\treturn \"\", \"\", false\n}\n\n// Denied reports whether a cap forbids starting c, and why.\nfunc (g *Gate) Denied(c pool.Candidate) (bool, string) {\n\tkind, stage, ok := kindOf(c.Class)\n\tif !ok {\n\t\treturn false, \"\"\n\t}\n\tcfg := g.cfg()\n\tif cfg == nil {\n\t\treturn false, \"\"\n\t}\n\trole, ok := cfg.Role(kind, c.Role)\n\tif !ok || (kind == config.KindScanner && role.ScanPath != \"\") {\n\t\treturn false, \"\"\n\t}\n\tdayStart := utcDayStart(g.now())\n\tctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)\n\tdefer cancel()\n\tper, repo, err := g.store.SpendSince(ctx, dayStart)\n\tif err != nil {\n\t\tg.log.Error(\"budget.read_failed\", \"error\", err)\n\t\treturn true, \"budget: spend unreadable, failing closed\"\n\t}\n\tif cfg.BudgetUSDPerDay > 0 && repo.USD >= cfg.BudgetUSDPerDay {\n\t\treturn true, g.capped(dayStart, \"repo\", \"\", repo, cfg.BudgetUSDPerDay)\n\t}\n\tif limit, set := cfg.RoleBudgetUSDPerDay(role); set {\n\t\tsp := per[state.RoleKey{Stage: stage, Role: c.Role}]\n\t\tif sp.USD >= limit {\n\t\t\treturn true, g.capped(dayStart, \"role\", stage+\"/\"+c.Role, sp, limit)\n\t\t}\n\t}\n\treturn false, \"\"\n}\n\n// capped builds the reason and logs budget.capped once per cap and UTC day.\nfunc (g *Gate) capped(dayStart time.Time, scope, role string, sp state.Spend, limit float64) string {\n\treason := fmt.Sprintf(\"%s daily budget reached: $%.2f of $%.2f spent today (UTC)\", scope, sp.USD, limit)\n\tif sp.Unpriced > 0 {\n\t\treason += fmt.Sprintf(\", %d unpriced steps counted as $0\", sp.Unpriced)\n\t}\n\tg.mu.Lock()\n\tif !g.day.Equal(dayStart) {\n\t\tg.day, g.logged = dayStart, map[string]bool{}\n\t}\n\tkey := scope + \"|\" + role\n\tfirst := !g.logged[key]\n\tg.logged[key] = true\n\tg.mu.Unlock()\n\tif first {\n\t\tg.log.Warn(\"budget.capped\", \"scope\", scope, \"role\", role, \"spent_usd\", sp.USD, \"cap_usd\", limit, \"unpriced\", sp.Unpriced)\n\t}\n\treturn reason\n}\n\n// utcDayStart is 00:00 UTC of t's UTC day: the one day rule of the gate and\n// the notice loop.\nfunc utcDayStart(t time.Time) time.Time {\n\tt = t.UTC()\n\treturn time.Date(t.Year(), t.Month(), t.Day(), 0, 0, 0, 0, time.UTC)\n}\n\n// Cap is one reached cap. Scope is \"repo\" or \"role\"; Stage and Role are empty\n// for the repo cap.\ntype Cap struct {\n\tScope, Stage, Role string\n\tSpent              state.Spend\n\tLimit              float64\n}\n\n// Capped returns every cap reached today (repo first, then roles in config\n// order) and the UTC day start. It applies the rules of Denied, logs nothing.\nfunc (g *Gate) Capped(ctx context.Context) ([]Cap, time.Time, error) {\n\tdayStart := utcDayStart(g.now())\n\tcfg := g.cfg()\n\tif cfg == nil {\n\t\treturn nil, dayStart, nil\n\t}\n\tper, repo, err := g.store.SpendSince(ctx, dayStart)\n\tif err != nil {\n\t\treturn nil, dayStart, err\n\t}\n\tvar out []Cap\n\tif cfg.BudgetUSDPerDay > 0 && repo.USD >= cfg.BudgetUSDPerDay {\n\t\tout = append(out, Cap{Scope: \"repo\", Spent: repo, Limit: cfg.BudgetUSDPerDay})\n\t}\n\tstages := map[config.Kind]string{config.KindScanner: \"scanner\", config.KindTriage: \"triage\", config.KindWorker: \"worker\", config.KindReviewer: \"review\"}\n\tfor _, role := range cfg.Roles {\n\t\tif role.Kind == config.KindScanner && role.ScanPath != \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tstage, ok := stages[role.Kind]\n\t\tif !ok {\n\t\t\tcontinue\n\t\t}\n\t\tif limit, set := cfg.RoleBudgetUSDPerDay(role); set {\n\t\t\tsp := per[state.RoleKey{Stage: stage, Role: role.Name}]\n\t\t\tif sp.USD >= limit {\n\t\t\t\tout = append(out, Cap{Scope: \"role\", Stage: stage, Role: role.Name, Spent: sp, Limit: limit})\n\t\t\t}\n\t\t}\n\t}\n\treturn out, dayStart, nil\n}\npackage budget\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"regexp\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// Name is the notice loop's name, as --loops spells it.\nconst Name = \"budget\"\n\n// Capper lists the caps reached today; *Gate satisfies it.\ntype Capper interface {\n\tCapped(ctx context.Context) ([]Cap, time.Time, error)\n}\n\n// EventStore is the part of *state.Store the loop uses.\ntype EventStore interface {\n\tAppendEvent(ctx context.Context, e state.Event) error\n\tEvents(ctx context.Context, f state.EventFilter) ([]state.Event, error)\n}\n\n// Effects is the part of effects.Effects the loop uses.\ntype Effects interface {\n\tCreateComment(ctx context.Context, n int, body string) (github.Comment, error)\n\tDryRun() bool\n}\n\n// Deps are the loop's collaborators. StatusIssue returns 0 until the status\n// issue is known. Now nil means time.Now; Log nil means slog.Default.\ntype Deps struct {\n\tGate        Capper\n\tStore       EventStore\n\tEffects     Effects\n\tStatusIssue func() int\n\tLog         *slog.Logger\n\tNow         func() time.Time\n}\n\n// Loop posts one status-issue comment per reached cap and UTC day. A\n// budget_capped event written after the comment is the record for #58 and the\n// marker that keeps a restart from posting the notice again.\ntype Loop struct {\n\td  Deps\n\tmu sync.Mutex\n}\n\n// NewLoop builds the notice loop.\nfunc NewLoop(d Deps) *Loop {\n\tif d.Now == nil {\n\t\td.Now = time.Now\n\t}\n\tif d.Log == nil {\n\t\td.Log = slog.Default()\n\t}\n\treturn &Loop{d: d}\n}\n\n// Name implements controller.Loop.\nfunc (*Loop) Name() string { return Name }\n\n// Interval implements controller.Loop.\nfunc (*Loop) Interval(*config.Resolved) time.Duration { return time.Minute }\n\n// Claims is false: the notice is bookkeeping about work already done.\nfunc (*Loop) Claims() bool { return false }\n\nvar _ controller.Loop = (*Loop)(nil)\n\ntype noticeKey struct{ scope, stage, role, day string }\n\n// Tick posts the notices that are due.\nfunc (l *Loop) Tick(ctx context.Context, _ controller.Env) error {\n\tl.mu.Lock()\n\tdefer l.mu.Unlock()\n\tissue := l.d.StatusIssue()\n\tif issue == 0 {\n\t\treturn nil\n\t}\n\tcaps, dayStart, err := l.d.Gate.Capped(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"budget: read spend: %w\", err)\n\t}\n\tif len(caps) == 0 {\n\t\treturn nil\n\t}\n\tday := dayStart.Format(\"2006-01-02\")\n\tevs, err := l.d.Store.Events(ctx, state.EventFilter{Kind: state.EventBudgetCapped, Since: dayStart})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"budget: read events: %w\", err)\n\t}\n\tdone := map[noticeKey]bool{}\n\tfor _, e := range evs {\n\t\tvar d struct {\n\t\t\tScope string `json:\"scope\"`\n\t\t\tDay   string `json:\"day\"`\n\t\t}\n\t\tif json.Unmarshal(e.Data, &d) == nil {\n\t\t\tdone[noticeKey{d.Scope, e.Stage, e.Role, d.Day}] = true\n\t\t}\n\t}\n\tfor _, c := range caps {\n\t\tif done[noticeKey{c.Scope, c.Stage, c.Role, day}] {\n\t\t\tcontinue\n\t\t}\n\t\tif _, err := l.d.Effects.CreateComment(ctx, issue, Render(c, day)); err != nil {\n\t\t\tl.d.Log.Error(\"budget.notice_failed\", \"scope\", c.Scope, \"stage\", c.Stage, \"role\", c.Role, \"error\", err)\n\t\t\tcontinue\n\t\t}\n\t\tdata, _ := json.Marshal(map[string]any{\n\t\t\t\"scope\": c.Scope, \"stage\": c.Stage, \"role\": c.Role, \"day\": day,\n\t\t\t\"spent_usd\": c.Spent.USD, \"cap_usd\": c.Limit, \"unpriced\": c.Spent.Unpriced,\n\t\t})\n\t\tev := state.Event{At: l.d.Now(), Kind: state.EventBudgetCapped, Stage: c.Stage, Role: c.Role, Data: data}\n\t\tif err := l.d.Store.AppendEvent(ctx, ev); err != nil {\n\t\t\tl.d.Log.Error(\"budget.notice_unrecorded\", \"scope\", c.Scope, \"stage\", c.Stage, \"role\", c.Role, \"error\", err)\n\t\t}\n\t}\n\treturn nil\n}\n\nvar safeName = regexp.MustCompile(`^[a-z0-9._/-]+$`)\n\nfunc safe(s string) string {\n\tif safeName.MatchString(s) {\n\t\treturn s\n\t}\n\treturn \"?\"\n}\n\n// Render is the comment for c on the UTC day (2006-01-02). It holds only\n// numbers, the day and config names; no agent text and no \"@\".\nfunc Render(c Cap, day string) string {\n\tvar b strings.Builder\n\twhat := \"The repo's daily budget\"\n\twhere := \"the repo-wide `budget_usd_per_day`\"\n\tscope := \"repo\"\n\tif c.Scope == \"role\" {\n\t\tstage, role := safe(c.Stage), safe(c.Role)\n\t\twhat = fmt.Sprintf(\"The daily budget of %s role `%s`\", stage, role)\n\t\twhere = fmt.Sprintf(\"`budget_usd_per_day` of role `%s` (or the repo-wide value)\", role)\n\t\tscope = \"role \" + stage + \"/\" + role\n\t}\n\tfmt.Fprintf(&b, \"<!-- ard:budget scope=%s day=%s -->\\n\", strings.ReplaceAll(scope, \" \", \"-\"), day)\n\tfmt.Fprintf(&b, \"**ard · daily budget reached**\\n\\n\")\n\tfmt.Fprintf(&b, \"%s is reached for %s (UTC): $%.2f of $%.2f spent.\", what, day, c.Spent.USD, c.Limit)\n\tif c.Spent.Unpriced > 0 {\n\t\tfmt.Fprintf(&b, \" %d steps reported no cost and count as $0.\", c.Spent.Unpriced)\n\t}\n\tb.WriteString(\"\\n\\nNo new jobs start under this cap; running jobs finish. On a subscription the dollar figure is an estimate.\\n\\n\")\n\tfmt.Fprintf(&b, \"To raise the cap, change %s in `.ard/config.yaml` through a reviewed pull request. The cap clears at 00:00 UTC.\\n\", where)\n\treturn b.String()\n}\npackage servecmd\n\nimport (\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/budget\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n)\n\n// budgetGate returns the one daily-budget gate of this process, built on first\n// use from the store and the latest loaded config.\nfunc (w *wiring) budgetGate() *budget.Gate {\n\tw.initMu.Lock()\n\tdefer w.initMu.Unlock()\n\tif w.bgt == nil {\n\t\tnow := w.budgetNow\n\t\tif now == nil {\n\t\t\tnow = time.Now\n\t\t}\n\t\tw.bgt = budget.New(w.Store, func() *config.Resolved { return w.cfg.Load() }, now, w.Log)\n\t}\n\treturn w.bgt\n}\n\n// budgetLoop is the notice loop: one status-issue comment per capped scope and\n// UTC day. It shares the gate, so its caps match what the pool enforces.\nfunc budgetLoop(w *wiring) controller.Loop {\n\treturn budget.NewLoop(budget.Deps{\n\t\tGate: w.budgetGate(), Store: w.Store, Effects: w.Effects,\n\t\tStatusIssue: func() int { return int(w.statusIssue.Load()) },\n\t\tLog:         w.Log, Now: w.budgetNow,\n\t})\n}\n208:type RoleKey struct{ Stage, Role string }\n209-\n210-// SpendSince sums step usage recorded at or after dayStart, per (stage, role)\n211-// and for the whole repo.\n212-func (s *Store) SpendSince(ctx context.Context, dayStart time.Time) (map[RoleKey]Spend, Spend, error) {\n213-\treturn s.spendBetween(ctx, dayStart, time.Time{})\n214-}\n215-\n216-// SpendBetween is SpendSince over the half-open window [from, to).\n217-func (s *Store) SpendBetween(ctx context.Context, from, to time.Time) (map[RoleKey]Spend, Spend, error) {\n218-\treturn s.spendBetween(ctx, from, to)\n219-}\n220-\n--\n260:func (s *Store) RoleTokens(ctx context.Context, dayStart time.Time) (map[RoleKey]int64, error) {\n261-\trows, err := s.db.QueryContext(ctx, `SELECT j.stage, j.role, COALESCE(SUM(`+countedSQL+`), 0)\n262-\t\tFROM step_usage u JOIN jobs j ON j.id = u.job_id\n263-\t\tWHERE u.recorded_at >= ? GROUP BY j.stage, j.role`, dayStart.Unix())\n264-\tif err != nil {\n265-\t\treturn nil, fmt.Errorf(\"role tokens since %s: %w\", dayStart.UTC().Format(time.RFC3339), err)\n266-\t}\n267-\tdefer rows.Close()\n268-\tout := map[RoleKey]int64{}\n269-\tfor rows.Next() {\n270-\t\tvar k RoleKey\n271-\t\tvar n int64\n272-\t\tif err := rows.Scan(&k.Stage, &k.Role, &n); err != nil {\n--\n285:func (s *Store) RoleWorstTokens(ctx context.Context, k RoleKey) (int64, error) {\n286-\tvar n int64\n287-\terr := s.db.QueryRowContext(ctx, `SELECT COALESCE(MAX(t), 0) FROM (\n288-\t\tSELECT SUM(`+countedSQL+`) AS t FROM step_usage u JOIN jobs j ON j.id = u.job_id\n289-\t\tWHERE j.stage = ? AND j.role = ? AND u.tokens_in IS NOT NULL GROUP BY u.job_id)`, k.Stage, k.Role).Scan(&n)\n290-\tif err != nil {\n291-\t\treturn 0, fmt.Errorf(\"role worst tokens %s:%s: %w\", k.Stage, k.Role, err)\n292-\t}\n293-\treturn n, nil\n294-}\n--\n../config/types.go-248-}\n../config/types.go-249-\n../config/types.go:250:// RoleTokensPerDay is the role's daily token cap: its own value, else the\n../config/types.go-251-// repo-wide Resolved.TokensPerDay. set is false when neither is set (no cap).\n../config/types.go:252:func (r *Resolved) RoleTokensPerDay(role Role) (cap int64, set bool) {\n../config/types.go-253-\tif role.TokensPerDay > 0 {\n../config/types.go-254-\t\treturn role.TokensPerDay, true\n../config/types.go-255-\t}\n../config/types.go-256-\tif r.TokensPerDay > 0 {\n../config/types.go-257-\t\treturn r.TokensPerDay, true\n../config/types.go-258-\t}\n../config/types.go-259-\treturn 0, false\n../config/types.go-260-}\n../config/types.go-261-\n../config/types.go-262-// HostUntrusted returns the roles that read untrusted input and have no\n../config/types.go-263-// Dockerfile, so the local executor runs them as a host subprocess under the\n../config/types.go-264-// controller's uid. Canonical order (kind, then name). It returns nothing\n../config/types.go-265-// when Executor is \"k8s\", where host mode does not exist.\n../config/types.go-266-func (r *Resolved) HostUntrusted() []Role { return r.HostUntrustedWith(false) }\n../config/types.go-267-","is_error":false}]},"parent_tool_use_id":null,"session_id":"9855999e-70a3-42e7-926d-e47c97789325","uuid":"29f9da27-7e8e-4ecc-bd27-dfedc5e72eec","timestamp":"2026-11-24T22:20:22.673Z","tool_use_result":{"stdout":"     168 budget.go\n     137 budget_test.go\n     163 notice.go\n     227 notice_test.go\n     695 total\n// Package budget enforces the daily dollar caps at the pool's claim gate.\n//\n// The day is the UTC day. A candidate is refused when spent >= cap, for its\n// role's own cap (budget_usd_per_day on the role) or the repo cap. Steps that\n// reported no cost count as $0 and their number is shown. Reviewers get no\n// exemption; deterministic scanners cost nothing and are exempt. A job that\n// already holds a slot is never touched: the gate only sees new candidates.\n// A state read failure denies (fails closed).\npackage budget\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/pool\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// SpendReader reads today's spend; *state.Store satisfies it.\ntype SpendReader interface {\n\tSpendSince(ctx context.Context, dayStart time.Time) (map[state.RoleKey]state.Spend, state.Spend, error)\n}\n\n// Gate is the pool's Options.Budget hook.\ntype Gate struct {\n\tstore SpendReader\n\tcfg   func() *config.Resolved\n\tnow   func() time.Time\n\tlog   *slog.Logger\n\n\tmu     sync.Mutex\n\tday    time.Time       // UTC day start the logged map belongs to\n\tlogged map[string]bool // caps already logged on day\n}\n\n// New builds a Gate. cfg returns the latest config (nil: nothing is capped);\n// now nil means time.Now; log nil means slog.Default.\nfunc New(store SpendReader, cfg func() *config.Resolved, now func() time.Time, log *slog.Logger) *Gate {\n\tif now == nil {\n\t\tnow = time.Now\n\t}\n\tif log == nil {\n\t\tlog = slog.Default()\n\t}\n\treturn &Gate{store: store, cfg: cfg, now: now, log: log, logged: map[string]bool{}}\n}\n\nfunc kindOf(c pool.Class) (config.Kind, string, bool) {\n\tswitch c {\n\tcase pool.ClassScanner:\n\t\treturn config.KindScanner, c.String(), true\n\tcase pool.ClassTriage:\n\t\treturn config.KindTriage, c.String(), true\n\tcase pool.ClassWorker:\n\t\treturn config.KindWorker, c.String(), true\n\tcase pool.ClassReview:\n\t\treturn config.KindReviewer, c.String(), true\n\t}\n\treturn \"\", \"\", false\n}\n\n// Denied reports whether a cap forbids starting c, and why.\nfunc (g *Gate) Denied(c pool.Candidate) (bool, string) {\n\tkind, stage, ok := kindOf(c.Class)\n\tif !ok {\n\t\treturn false, \"\"\n\t}\n\tcfg := g.cfg()\n\tif cfg == nil {\n\t\treturn false, \"\"\n\t}\n\trole, ok := cfg.Role(kind, c.Role)\n\tif !ok || (kind == config.KindScanner && role.ScanPath != \"\") {\n\t\treturn false, \"\"\n\t}\n\tdayStart := utcDayStart(g.now())\n\tctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)\n\tdefer cancel()\n\tper, repo, err := g.store.SpendSince(ctx, dayStart)\n\tif err != nil {\n\t\tg.log.Error(\"budget.read_failed\", \"error\", err)\n\t\treturn true, \"budget: spend unreadable, failing closed\"\n\t}\n\tif cfg.BudgetUSDPerDay > 0 && repo.USD >= cfg.BudgetUSDPerDay {\n\t\treturn true, g.capped(dayStart, \"repo\", \"\", repo, cfg.BudgetUSDPerDay)\n\t}\n\tif limit, set := cfg.RoleBudgetUSDPerDay(role); set {\n\t\tsp := per[state.RoleKey{Stage: stage, Role: c.Role}]\n\t\tif sp.USD >= limit {\n\t\t\treturn true, g.capped(dayStart, \"role\", stage+\"/\"+c.Role, sp, limit)\n\t\t}\n\t}\n\treturn false, \"\"\n}\n\n// capped builds the reason and logs budget.capped once per cap and UTC day.\nfunc (g *Gate) capped(dayStart time.Time, scope, role string, sp state.Spend, limit float64) string {\n\treason := fmt.Sprintf(\"%s daily budget reached: $%.2f of $%.2f spent today (UTC)\", scope, sp.USD, limit)\n\tif sp.Unpriced > 0 {\n\t\treason += fmt.Sprintf(\", %d unpriced steps counted as $0\", sp.Unpriced)\n\t}\n\tg.mu.Lock()\n\tif !g.day.Equal(dayStart) {\n\t\tg.day, g.logged = dayStart, map[string]bool{}\n\t}\n\tkey := scope + \"|\" + role\n\tfirst := !g.logged[key]\n\tg.logged[key] = true\n\tg.mu.Unlock()\n\tif first {\n\t\tg.log.Warn(\"budget.capped\", \"scope\", scope, \"role\", role, \"spent_usd\", sp.USD, \"cap_usd\", limit, \"unpriced\", sp.Unpriced)\n\t}\n\treturn reason\n}\n\n// utcDayStart is 00:00 UTC of t's UTC day: the one day rule of the gate and\n// the notice loop.\nfunc utcDayStart(t time.Time) time.Time {\n\tt = t.UTC()\n\treturn time.Date(t.Year(), t.Month(), t.Day(), 0, 0, 0, 0, time.UTC)\n}\n\n// Cap is one reached cap. Scope is \"repo\" or \"role\"; Stage and Role are empty\n// for the repo cap.\ntype Cap struct {\n\tScope, Stage, Role string\n\tSpent              state.Spend\n\tLimit              float64\n}\n\n// Capped returns every cap reached today (repo first, then roles in config\n// order) and the UTC day start. It applies the rules of Denied, logs nothing.\nfunc (g *Gate) Capped(ctx context.Context) ([]Cap, time.Time, error) {\n\tdayStart := utcDayStart(g.now())\n\tcfg := g.cfg()\n\tif cfg == nil {\n\t\treturn nil, dayStart, nil\n\t}\n\tper, repo, err := g.store.SpendSince(ctx, dayStart)\n\tif err != nil {\n\t\treturn nil, dayStart, err\n\t}\n\tvar out []Cap\n\tif cfg.BudgetUSDPerDay > 0 && repo.USD >= cfg.BudgetUSDPerDay {\n\t\tout = append(out, Cap{Scope: \"repo\", Spent: repo, Limit: cfg.BudgetUSDPerDay})\n\t}\n\tstages := map[config.Kind]string{config.KindScanner: \"scanner\", config.KindTriage: \"triage\", config.KindWorker: \"worker\", config.KindReviewer: \"review\"}\n\tfor _, role := range cfg.Roles {\n\t\tif role.Kind == config.KindScanner && role.ScanPath != \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tstage, ok := stages[role.Kind]\n\t\tif !ok {\n\t\t\tcontinue\n\t\t}\n\t\tif limit, set := cfg.RoleBudgetUSDPerDay(role); set {\n\t\t\tsp := per[state.RoleKey{Stage: stage, Role: role.Name}]\n\t\t\tif sp.USD >= limit {\n\t\t\t\tout = append(out, Cap{Scope: \"role\", Stage: stage, Role: role.Name, Spent: sp, Limit: limit})\n\t\t\t}\n\t\t}\n\t}\n\treturn out, dayStart, nil\n}\npackage budget\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"regexp\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// Name is the notice loop's name, as --loops spells it.\nconst Name = \"budget\"\n\n// Capper lists the caps reached today; *Gate satisfies it.\ntype Capper interface {\n\tCapped(ctx context.Context) ([]Cap, time.Time, error)\n}\n\n// EventStore is the part of *state.Store the loop uses.\ntype EventStore interface {\n\tAppendEvent(ctx context.Context, e state.Event) error\n\tEvents(ctx context.Context, f state.EventFilter) ([]state.Event, error)\n}\n\n// Effects is the part of effects.Effects the loop uses.\ntype Effects interface {\n\tCreateComment(ctx context.Context, n int, body string) (github.Comment, error)\n\tDryRun() bool\n}\n\n// Deps are the loop's collaborators. StatusIssue returns 0 until the status\n// issue is known. Now nil means time.Now; Log nil means slog.Default.\ntype Deps struct {\n\tGate        Capper\n\tStore       EventStore\n\tEffects     Effects\n\tStatusIssue func() int\n\tLog         *slog.Logger\n\tNow         func() time.Time\n}\n\n// Loop posts one status-issue comment per reached cap and UTC day. A\n// budget_capped event written after the comment is the record for #58 and the\n// marker that keeps a restart from posting the notice again.\ntype Loop struct {\n\td  Deps\n\tmu sync.Mutex\n}\n\n// NewLoop builds the notice loop.\nfunc NewLoop(d Deps) *Loop {\n\tif d.Now == nil {\n\t\td.Now = time.Now\n\t}\n\tif d.Log == nil {\n\t\td.Log = slog.Default()\n\t}\n\treturn &Loop{d: d}\n}\n\n// Name implements controller.Loop.\nfunc (*Loop) Name() string { return Name }\n\n// Interval implements controller.Loop.\nfunc (*Loop) Interval(*config.Resolved) time.Duration { return time.Minute }\n\n// Claims is false: the notice is bookkeeping about work already done.\nfunc (*Loop) Claims() bool { return false }\n\nvar _ controller.Loop = (*Loop)(nil)\n\ntype noticeKey struct{ scope, stage, role, day string }\n\n// Tick posts the notices that are due.\nfunc (l *Loop) Tick(ctx context.Context, _ controller.Env) error {\n\tl.mu.Lock()\n\tdefer l.mu.Unlock()\n\tissue := l.d.StatusIssue()\n\tif issue == 0 {\n\t\treturn nil\n\t}\n\tcaps, dayStart, err := l.d.Gate.Capped(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"budget: read spend: %w\", err)\n\t}\n\tif len(caps) == 0 {\n\t\treturn nil\n\t}\n\tday := dayStart.Format(\"2006-01-02\")\n\tevs, err := l.d.Store.Events(ctx, state.EventFilter{Kind: state.EventBudgetCapped, Since: dayStart})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"budget: read events: %w\", err)\n\t}\n\tdone := map[noticeKey]bool{}\n\tfor _, e := range evs {\n\t\tvar d struct {\n\t\t\tScope string `json:\"scope\"`\n\t\t\tDay   string `json:\"day\"`\n\t\t}\n\t\tif json.Unmarshal(e.Data, &d) == nil {\n\t\t\tdone[noticeKey{d.Scope, e.Stage, e.Role, d.Day}] = true\n\t\t}\n\t}\n\tfor _, c := range caps {\n\t\tif done[noticeKey{c.Scope, c.Stage, c.Role, day}] {\n\t\t\tcontinue\n\t\t}\n\t\tif _, err := l.d.Effects.CreateComment(ctx, issue, Render(c, day)); err != nil {\n\t\t\tl.d.Log.Error(\"budget.notice_failed\", \"scope\", c.Scope, \"stage\", c.Stage, \"role\", c.Role, \"error\", err)\n\t\t\tcontinue\n\t\t}\n\t\tdata, _ := json.Marshal(map[string]any{\n\t\t\t\"scope\": c.Scope, \"stage\": c.Stage, \"role\": c.Role, \"day\": day,\n\t\t\t\"spent_usd\": c.Spent.USD, \"cap_usd\": c.Limit, \"unpriced\": c.Spent.Unpriced,\n\t\t})\n\t\tev := state.Event{At: l.d.Now(), Kind: state.EventBudgetCapped, Stage: c.Stage, Role: c.Role, Data: data}\n\t\tif err := l.d.Store.AppendEvent(ctx, ev); err != nil {\n\t\t\tl.d.Log.Error(\"budget.notice_unrecorded\", \"scope\", c.Scope, \"stage\", c.Stage, \"role\", c.Role, \"error\", err)\n\t\t}\n\t}\n\treturn nil\n}\n\nvar safeName = regexp.MustCompile(`^[a-z0-9._/-]+$`)\n\nfunc safe(s string) string {\n\tif safeName.MatchString(s) {\n\t\treturn s\n\t}\n\treturn \"?\"\n}\n\n// Render is the comment for c on the UTC day (2006-01-02). It holds only\n// numbers, the day and config names; no agent text and no \"@\".\nfunc Render(c Cap, day string) string {\n\tvar b strings.Builder\n\twhat := \"The repo's daily budget\"\n\twhere := \"the repo-wide `budget_usd_per_day`\"\n\tscope := \"repo\"\n\tif c.Scope == \"role\" {\n\t\tstage, role := safe(c.Stage), safe(c.Role)\n\t\twhat = fmt.Sprintf(\"The daily budget of %s role `%s`\", stage, role)\n\t\twhere = fmt.Sprintf(\"`budget_usd_per_day` of role `%s` (or the repo-wide value)\", role)\n\t\tscope = \"role \" + stage + \"/\" + role\n\t}\n\tfmt.Fprintf(&b, \"<!-- ard:budget scope=%s day=%s -->\\n\", strings.ReplaceAll(scope, \" \", \"-\"), day)\n\tfmt.Fprintf(&b, \"**ard · daily budget reached**\\n\\n\")\n\tfmt.Fprintf(&b, \"%s is reached for %s (UTC): $%.2f of $%.2f spent.\", what, day, c.Spent.USD, c.Limit)\n\tif c.Spent.Unpriced > 0 {\n\t\tfmt.Fprintf(&b, \" %d steps reported no cost and count as $0.\", c.Spent.Unpriced)\n\t}\n\tb.WriteString(\"\\n\\nNo new jobs start under this cap; running jobs finish. On a subscription the dollar figure is an estimate.\\n\\n\")\n\tfmt.Fprintf(&b, \"To raise the cap, change %s in `.ard/config.yaml` through a reviewed pull request. The cap clears at 00:00 UTC.\\n\", where)\n\treturn b.String()\n}\npackage servecmd\n\nimport (\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/budget\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n)\n\n// budgetGate returns the one daily-budget gate of this process, built on first\n// use from the store and the latest loaded config.\nfunc (w *wiring) budgetGate() *budget.Gate {\n\tw.initMu.Lock()\n\tdefer w.initMu.Unlock()\n\tif w.bgt == nil {\n\t\tnow := w.budgetNow\n\t\tif now == nil {\n\t\t\tnow = time.Now\n\t\t}\n\t\tw.bgt = budget.New(w.Store, func() *config.Resolved { return w.cfg.Load() }, now, w.Log)\n\t}\n\treturn w.bgt\n}\n\n// budgetLoop is the notice loop: one status-issue comment per capped scope and\n// UTC day. It shares the gate, so its caps matc