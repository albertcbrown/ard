{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QbS72y3YoTpo6EgcP6tJeV","type":"tool_result","content":"\t}\n\treturn out, nil\n}\n\n// Spend is money spent over a period: USD sums the priced steps; Unpriced\n// counts steps that reported no cost (they add nothing to USD).\ntype Spend struct {\n\tUSD      float64\n\tUnpriced int\n}\n\n// RoleKey names a role in spend totals. The stage is part of the key because\n// a role name can be shared by a triage role and a worker role.\ntype RoleKey struct{ Stage, Role string }\n\n// SpendSince sums step usage recorded at or after dayStart, per (stage, role)\n// and for the whole repo.\nfunc (s *Store) SpendSince(ctx context.Context, dayStart time.Time) (map[RoleKey]Spend, Spend, error) {\n\treturn s.spendBetween(ctx, dayStart, time.Time{})\n}\n\n// SpendBetween is SpendSince over the half-open window [from, to).\nfunc (s *Store) SpendBetween(ctx context.Context, from, to time.Time) (map[RoleKey]Spend, Spend, error) {\n\treturn s.spendBetween(ctx, from, to)\n}\n\n// spendBetween sums usage recorded in [dayStart, until); a zero until is open.\nfunc (s *Store) spendBetween(ctx context.Context, dayStart, until time.Time) (map[RoleKey]Spend, Spend, error) {\n\tupper := int64(math.MaxInt64)\n\tif !until.IsZero() {\n\t\tupper = until.Unix()\n\t}\n\trows, err := s.db.QueryContext(ctx, `SELECT j.stage, j.role, COALESCE(SUM(u.cost_usd), 0), COALESCE(SUM(u.cost_usd IS NULL), 0)\n\t\tFROM step_usage u JOIN jobs j ON j.id = u.job_id\n\t\tWHERE u.recorded_at >= ? AND u.recorded_at < ? GROUP BY j.stage, j.role`, dayStart.Unix(), upper)\n\tif err != nil {\n\t\treturn nil, Spend{}, fmt.Errorf(\"spend since %s: %w\", dayStart.UTC().Format(time.RFC3339), err)\n\t}\n\tdefer rows.Close()\n\tper := map[RoleKey]Spend{}\n\tvar repo Spend\n\tfor rows.Next() {\n\t\tvar k RoleKey\n\t\tvar sp Spend\n\t\tif err := rows.Scan(&k.Stage, &k.Role, &sp.USD, &sp.Unpriced); err != nil {\n\t\t\treturn nil, Spend{}, fmt.Errorf(\"spend since: %w\", err)\n\t\t}\n\t\tper[k] = sp\n\t\trepo.USD += sp.USD\n\t\trepo.Unpriced += sp.Unpriced\n\t}\n\tif err := rows.Err(); err != nil {\n\t\treturn nil, Spend{}, fmt.Errorf(\"spend since: %w\", err)\n\t}\n\treturn per, repo, nil\n}\n\n// Counted is the tokens that count toward a role's token cap: input, output\n// and cache write. Cache reads are excluded.\nfunc (t Tokens) Counted() int64 { return t.Input + t.Output + t.CacheWrite }\n\nconst countedSQL = `COALESCE(u.tokens_in, 0) + COALESCE(u.tokens_out, 0) + COALESCE(u.tokens_cache_write, 0)`\n\n// RoleTokens sums the counted tokens of step usage recorded at or after\n// dayStart, per (stage, role). A step that reported no tokens adds nothing.\nfunc (s *Store) RoleTokens(ctx context.Context, dayStart time.Time) (map[RoleKey]int64, error) {\n\trows, err := s.db.QueryContext(ctx, `SELECT j.stage, j.role, COALESCE(SUM(`+countedSQL+`), 0)\n\t\tFROM step_usage u JOIN jobs j ON j.id = u.job_id\n\t\tWHERE u.recorded_at >= ? GROUP BY j.stage, j.role`, dayStart.Unix())\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"role tokens since %s: %w\", dayStart.UTC().Format(time.RFC3339), err)\n\t}\n\tdefer rows.Close()\n\tout := map[RoleKey]int64{}\n\tfor rows.Next() {\n\t\tvar k RoleKey\n\t\tvar n int64\n\t\tif err := rows.Scan(&k.Stage, &k.Role, &n); err != nil {\n\t\t\treturn nil, fmt.Errorf(\"role tokens: %w\", err)\n\t\t}\n\t\tout[k] = n\n\t}\n\tif err := rows.Err(); err != nil {\n\t\treturn nil, fmt.Errorf(\"role tokens: %w\", err)\n\t}\n\treturn out, nil\n}\n\n// RoleWorstTokens is the largest counted-token total of one job of the role,\n// over all history and from reported usage only; 0 when there is none.\nfunc (s *Store) RoleWorstTokens(ctx context.Context, k RoleKey) (int64, error) {\n\tvar n int64\n\terr := s.db.QueryRowContext(ctx, `SELECT COALESCE(MAX(t), 0) FROM (\n\t\tSELECT SUM(`+countedSQL+`) AS t FROM step_usage u JOIN jobs j ON j.id = u.job_id\n\t\tWHERE j.stage = ? AND j.role = ? AND u.tokens_in IS NOT NULL GROUP BY u.job_id)`, k.Stage, k.Role).Scan(&n)\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"role worst tokens %s:%s: %w\", k.Stage, k.Role, err)\n\t}\n\treturn n, nil\n}\npackage servecmd\n\nimport (\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/budget\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n)\n\n// budgetGate returns the one daily-budget gate of this process, built on first\n// use from the store and the latest loaded config.\nfunc (w *wiring) budgetGate() *budget.Gate {\n\tw.initMu.Lock()\n\tdefer w.initMu.Unlock()\n\tif w.bgt == nil {\n\t\tnow := w.budgetNow\n\t\tif now == nil {\n\t\t\tnow = time.Now\n\t\t}\n\t\tw.bgt = budget.New(w.Store, func() *config.Resolved { return w.cfg.Load() }, now, w.Log)\n\t}\n\treturn w.bgt\n}\n\n// budgetLoop is the notice loop: one status-issue comment per capped scope and\n// UTC day. It shares the gate, so its caps match what the pool enforces.\nfunc budgetLoop(w *wiring) controller.Loop {\n\treturn budget.NewLoop(budget.Deps{\n\t\tGate: w.budgetGate(), Store: w.Store, Effects: w.Effects,\n\t\tStatusIssue: func() int { return int(w.statusIssue.Load()) },\n\t\tLog:         w.Log, Now: w.budgetNow,\n\t})\n}\n5:## Summary\n22:## Architecture\n44:## Stack\n48:## Label state machine\n95:## The .ard/ contract\n157:## Open issues\n171:## Scanners\n245:## Triage loop\n286:## Executors and the Reaper\n332:## Worker loop\n352:## Reviewer loop\n385:## Merger loop\n410:## PR watch loop\n424:## Configuration\n496:## Guardrails\n523:## Gaps in the original sketch\n543:## Delivery\n555:## Rollout\n584:## Open questions\n452:#tokens_per_day: 40M        # optional per-role daily token default (40M, 1.5M, 500k or a plain integer); a role may set its own; unset = no token cap; recorded only, not enforced yet\n518:- **Budgets.** Every job has a dollar cap (`max_budget_usd`) and a hard timeout; every role and the whole repo have a daily dollar cap. The caps are enforced at the pool's claim gate (`internal/budget`): a candidate is refused when `spent >= cap`, where spent is the cost recorded in `step_usage` since 00:00 UTC today. The caps reset at 00:00 UTC and survive a restart, because spend is read from the controller database. A role's own `budget_usd_per_day` caps that role (by stage and name) alone; a role without one is limited only by the repo cap. Steps that reported no cost count as $0, and the refusal reason shows how many there were. There is no exemption for reviewers, the caps apply to OAuth credentials too, and deterministic scanners (no model, no cost) are exempt. Tokens are also recorded per role (`tokens_per_day`, optionally per role; unset means no token cap; nothing is enforced yet). Counted tokens are input + output + cache write; cache reads are excluded. A job that dies without reporting tokens is not counted: its close-out comment and cost-table row say \"tokens not reported\", and a role can overshoot its token cap by such runs. Running jobs are never killed for a cap. If today's spend cannot be read, the gate refuses (fails closed). Each cap is logged once a day as `budget.capped`. The `budget` loop posts one comment on the status issue per capped scope (the repo, or a role) per UTC day, and records a `budget_capped` event; that event also keeps a restart from posting the notice again (a crash between comment and event can repeat one notice). The comment holds only numbers, the day and config names, no agent text and no `@`; it says the dollar figure is an estimate on a subscription and how to raise the cap (edit `budget_usd_per_day` in `.ard/config.yaml` through a reviewed PR). Under `--dry-run` the comment goes to the ledger. `--loops budget` selects the notice loop; the gate is part of the pool and is always on.\ninternal/pool/pool.go:26:\tDeniedBudget            // a daily dollar cap (its role's or the repo's) is reached\ninternal/pool/pool.go:65:\t// Budget reports whether a daily dollar cap forbids starting c, with the\ninternal/pool/pool.go:68:\tBudget func(c Candidate) (denied bool, reason string)\ninternal/pool/pool.go:95:\t\tbudget:      o.Budget,\ninternal/pool/pool.go:189:\t\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedBudget, why","is_error":false}]},"parent_tool_use_id":null,"session_id":"2168eb67-7a3e-48bf-9b05-6a957a8a97c0","uuid":"fd456046-20ce-4275-8413-efc20f13cabe","timestamp":"2026-11-24T22:01:34.898Z","tool_use_result":{"stdout":"\t}\n\treturn out, nil\n}\n\n// Spend is money spent over a period: USD sums the priced steps; Unpriced\n// counts steps that reported no cost (they add nothing to USD).\ntype Spend struct {\n\tUSD      float64\n\tUnpriced int\n}\n\n// RoleKey names a role in spend totals. The stage is part of the key because\n// a role name can be shared by a triage role and a worker role.\ntype RoleKey struct{ Stage, Role string }\n\n// SpendSince sums step usage recorded at or after dayStart, per (stage, role)\n// and for the whole repo.\nfunc (s *Store) SpendSince(ctx context.Context, dayStart time.Time) (map[RoleKey]Spend, Spend, error) {\n\treturn s.spendBetween(ctx, dayStart, time.Time{})\n}\n\n// SpendBetween is SpendSince over the half-open window [from, to).\nfunc (s *Store) SpendBetween(ctx context.Context, from, to time.Time) (map[RoleKey]Spend, Spend, error) {\n\treturn s.spendBetween(ctx, from, to)\n}\n\n// spendBetween sums usage recorded in [dayStart, until); a zero until is open.\nfunc (s *Store) spendBetween(ctx context.Context, dayStart, until time.Time) (map[RoleKey]Spend, Spend, error) {\n\tupper := int64(math.MaxInt64)\n\tif !until.IsZero() {\n\t\tupper = until.Unix()\n\t}\n\trows, err := s.db.QueryContext(ctx, `SELECT j.stage, j.role, COALESCE(SUM(u.cost_usd), 0), COALESCE(SUM(u.cost_usd IS NULL), 0)\n\t\tFROM step_usage u JOIN jobs j ON j.id = u.job_id\n\t\tWHERE u.recorded_at >= ? AND u.recorded_at < ? GROUP BY j.stage, j.role`, dayStart.Unix(), upper)\n\tif err != nil {\n\t\treturn nil, Spend{}, fmt.Errorf(\"spend since %s: %w\", dayStart.UTC().Format(time.RFC3339), err)\n\t}\n\tdefer rows.Close()\n\tper := map[RoleKey]Spend{}\n\tvar repo Spend\n\tfor rows.Next() {\n\t\tvar k RoleKey\n\t\tvar sp Spend\n\t\tif err := rows.Scan(&k.Stage, &k.Role, &sp.USD, &sp.Unpriced); err != nil {\n\t\t\treturn nil, Spend{}, fmt.Errorf(\"spend since: %w\", err)\n\t\t}\n\t\tper[k] = sp\n\t\trepo.USD += sp.USD\n\t\trepo.Unpriced += sp.Unpriced\n\t}\n\tif err := rows.Err(); err != nil {\n\t\treturn nil, Spend{}, fmt.Errorf(\"spend since: %w\", err)\n\t}\n\treturn per, repo, nil\n}\n\n// Counted is the tokens that count toward a role's token cap: input, output\n// and cache write. Cache reads are excluded.\nfunc (t Tokens) Counted() int64 { return t.Input + t.Output + t.CacheWrite }\n\nconst countedSQL = `COALESCE(u.tokens_in, 0) + COALESCE(u.tokens_out, 0) + COALESCE(u.tokens_cache_write, 0)`\n\n// RoleTokens sums the counted tokens of step usage recorded at or after\n// dayStart, per (stage, role). A step that reported no tokens adds nothing.\nfunc (s *Store) RoleTokens(ctx context.Context, dayStart time.Time) (map[RoleKey]int64, error) {\n\trows, err := s.db.QueryContext(ctx, `SELECT j.stage, j.role, COALESCE(SUM(`+countedSQL+`), 0)\n\t\tFROM step_usage u JOIN jobs j ON j.id = u.job_id\n\t\tWHERE u.recorded_at >= ? GROUP BY j.stage, j.role`, dayStart.Unix())\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"role tokens since %s: %w\", dayStart.UTC().Format(time.RFC3339), err)\n\t}\n\tdefer rows.Close()\n\tout := map[RoleKey]int64{}\n\tfor rows.Next() {\n\t\tvar k RoleKey\n\t\tvar n int64\n\t\tif err := rows.Scan(&k.Stage, &k.Role, &n); err != nil {\n\t\t\treturn nil, fmt.Errorf(\"role tokens: %w\", err)\n\t\t}\n\t\tout[k] = n\n\t}\n\tif err := rows.Err(); err != nil {\n\t\treturn nil, fmt.Errorf(\"role tokens: %w\", err)\n\t}\n\treturn out, nil\n}\n\n// RoleWorstTokens is the largest counted-token total of one job of the role,\n// over all history and from reported usage only; 0 when there is none.\nfunc (s *Store) RoleWorstTokens(ctx context.Context, k RoleKey) (int64, error) {\n\tvar n int64\n\terr := s.db.QueryRowContext(ctx, `SELECT COALESCE(MAX(t), 0) FROM (\n\t\tSELECT SUM(`+countedSQL+`) AS t FROM step_usage u JOIN jobs j ON j.id = u.job_id\n\t\tWHERE j.stage = ? AND j.role = ? AND u.tokens_in IS NOT NULL GROUP BY u.job_id)`, k.Stage, k.Role).Scan(&n)\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"role worst tokens %s:%s: %w\", k.Stage, k.Role, err)\n\t}\n\treturn n, nil\n}\npackage servecmd\n\nimport (\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/budget\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n)\n\n// budgetGate returns the one daily-budget gate of this process, built on first\n// use from the store and the latest loaded config.\nfunc (w *wiring) budgetGate() *budget.Gate {\n\tw.initMu.Lock()\n\tdefer w.initMu.Unlock()\n\tif w.bgt == nil {\n\t\tnow := w.budgetNow\n\t\tif now == nil {\n\t\t\tnow = time.Now\n\t\t}\n\t\tw.bgt = budget.New(w.Store, func() *config.Resolved { return w.cfg.Load() }, now, w.Log)\n\t}\n\treturn w.bgt\n}\n\n// budgetLoop is the notice loop: one status-issue comment per capped scope and\n// UTC day. It shares the gate, so its caps match what the pool enforces.\nfunc budgetLoop(w *wiring) controller.Loop {\n\treturn budget.NewLoop(budget.Deps{\n\t\tGate: w.budgetGate(), Store: w.Store, Effects: w.Effects,\n\t\tStatusIssue: func() int { return int(w.statusIssue.Load()) },\n\t\tLog:         w.Log, Now: w.budgetNow,\n\t})\n}\n5:## Summary\n22:## Architecture\n44:## Stack\n48:## Label state machine\n95:## The .ard/ contract\n157:## Open issues\n171:## Scanners\n245:## Triage loop\n286:## Executors and the Reaper\n332:## Worker loop\n352:## Reviewer loop\n385:## Merger loop\n410:## PR watch loop\n424:## Configuration\n496:## Guardrails\n523:## Gaps in the original sketch\n543:## Delivery\n555:## Rollout\n584:## Open questions\n452:#tokens_per_day: 40M        # optional per-role daily token default (40M, 1.5M, 500k or a plain integer); a role may set its own; unset = no token cap; recorded only, not enforced yet\n518:- **Budgets.** Every job has a dollar cap (`max_budget_usd`) and a hard timeout; every role and the whole repo have a daily dollar cap. The caps are enforced at the pool's claim gate (`internal/budget`): a candidate is refused when `spent >= cap`, where spent is the cost recorded in `step_usage` since 00:00 UTC today. The caps reset at 00:00 UTC and survive a restart, because spend is read from the controller database. A role's own `budget_usd_per_day` caps that role (by stage and name) alone; a role without one is limited only by the repo cap. Steps that reported no cost count as $0, and the refusal reason shows how many there were. There is no exemption for reviewers, the caps apply to OAuth credentials too, and deterministic scanners (no model, no cost) are exempt. Tokens are also recorded per role (`tokens_per_day`, optionally per role; unset means no token cap; nothing is enforced yet). Counted tokens are input + output + cache write; cache reads are excluded. A job that dies without reporting tokens is not counted: its close-out comment and cost-table row say \"tokens not reported\", and a role can overshoot its token cap by such runs. Running jobs are never killed for a cap. If today's spend cannot be read, the gate refuses (fails closed). Each cap is logged once a day as `budget.capped`. The `budget` loop posts one comment on the status issue per capped scope (the repo, or a role) per UTC day, and records a `budget_capped` event; that event also keeps a restart from posting the notice again (a crash between comment and event can repeat one notice). The comment holds only numbers, the day and config names, no agent text and no `@`; it says the dollar figure is an estimate on a subscription and how to raise the cap (edit `budget_usd_per_day` in `.ard/config.yaml` through a reviewed PR). Under `--dry-run` the comment goes to the ledger. `--loops budget` selects the notice loop; the gate is part of the pool and is always on.\ninternal/pool/pool.go:26:\tDeniedBudget            // a daily dollar cap (its role's or the repo's) is reached\ninternal/pool/pool.go:65:\t// Budget reports whether a daily dollar cap forbids starting c, with the\ninternal/pool/pool.go:68:\tBudget func(c Candidate) (denied bool, reason string)\ninternal/pool/pool.go:95:\t\tbudget:      o.Budget,\ninternal/pool/pool.go:189:\t\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedBudget, why","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01QbS72y3YoTpo6EgcP6tJeV","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
