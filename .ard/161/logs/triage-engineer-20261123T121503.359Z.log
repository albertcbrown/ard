{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XXYNhsWYZ7nsRHMW9GhQrb","type":"tool_result","content":"1\tpackage controller\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"log/slog\"\n8\t\t\"runtime/debug\"\n9\t\t\"time\"\n10\t\n11\t\t\"github.com/albertcbrown/ard/internal/config\"\n12\t\t\"github.com/albertcbrown/ard/internal/github\"\n13\t)\n14\t\n15\tconst (\n16\t\tbackoffAfter = 3 // consecutive errors before backoff starts\n17\t\tbackoffCap   = 15 * time.Minute\n18\t\n19\t\t// configTimeout bounds one config load, which fetches from the remote.\n20\t\tconfigTimeout = 2 * time.Minute\n21\t)\n22\t\n23\t// runner drives one Loop. Ticks of one loop never overlap and a slow tick\n24\t// never queues a second one; different loops run concurrently.\n25\ttype runner struct {\n26\t\tc    *Controller\n27\t\tloop Loop\n28\t\tlog  *slog.Logger\n29\t\n30\t\tcfg       *config.Resolved // last good config; nil until one has loaded\n31\t\tcfgBroken bool             // last reload failed\n32\t\tpaused    PauseState       // last pause state, for transition logs\n33\t\tclamped   bool\n34\t\tn         int // tick counter\n35\t\terrs      int // consecutive tick errors\n36\t}\n37\t\n38\t// jitter maps r in [0,1) to a factor in [0.9, 1.1).\n39\tfunc jitter(r float64) float64 { return 0.9 + 0.2*r }\n40\t\n41\t// interval returns the loop's interval clamped to MinInterval.\n42\tfunc (r *runner) interval() time.Duration {\n43\t\tif r.cfg == nil { // no config yet: retry at the floor\n44\t\t\treturn MinInterval\n45\t\t}\n46\t\td := r.loop.Interval(r.cfg)\n47\t\tif d < MinInterval {\n48\t\t\tif !r.clamped {\n49\t\t\t\tr.clamped = true\n50\t\t\t\tr.log.Warn(\"loop.interval_clamped\", \"requested\", d.String(), \"using\", MinInterval.String())\n51\t\t\t}\n52\t\t\treturn MinInterval\n53\t\t}\n54\t\treturn d\n55\t}\n56\t\n57\t// run is the loop goroutine. It returns when stopping is closed.\n58\tfunc (r *runner) run(workCtx context.Context, stopping <-chan struct{}) {\n59\t\twait := time.Duration(r.c.rand() * 0.1 * float64(r.interval()))\n60\t\tfor {\n61\t\t\tt := time.NewTimer(wait)\n62\t\t\tselect {\n63\t\t\tcase <-stopping:\n64\t\t\t\tt.Stop()\n65\t\t\t\treturn\n66\t\t\tcase <-t.C:\n67\t\t\t}\n68\t\t\tselect { // a tick must not start once shutdown has begun\n69\t\t\tcase <-stopping:\n70\t\t\t\treturn\n71\t\t\tdefault:\n72\t\t\t}\n73\t\t\twait = r.tick(workCtx, stopping)\n74\t\t}\n75\t}\n76\t\n77\t// tick runs one poll and returns how long to wait before the next one.\n78\tfunc (r *runner) tick(workCtx context.Context, stopping <-chan struct{}) time.Duration {\n79\t\tr.n++\n80\t\tlog := r.log.With(\"tick\", r.n)\n81\t\tr.reload(workCtx, log)\n82\t\n83\t\tif r.cfg == nil { // never loaded: nothing can run, and claiming loops are paused\n84\t\t\tif r.loop.Claims() {\n85\t\t\t\tr.transition(log, PauseState{Paused: true, Reason: ReasonConfigInvalid})\n86\t\t\t}\n87\t\t\treturn r.nextWait(nil)\n88\t\t}\n89\t\n90\t\tif r.loop.Claims() {\n91\t\t\tst := r.c.deps.Pause.Check(workCtx, r.cfg)\n92\t\t\tif r.cfgBroken {\n93\t\t\t\tst = PauseState{Paused: true, Reason: ReasonConfigInvalid}\n94\t\t\t}\n95\t\t\tr.transition(log, st)\n96\t\t\tif st.Paused {\n97\t\t\t\treturn r.nextWait(nil)\n98\t\t\t}\n99\t\t}\n100\t\n101\t\tinterval := r.interval()\n102\t\ttimeout := interval\n103\t\tif tt, ok := r.loop.(TickTimeouter); ok {\n104\t\t\tif d := tt.TickTimeout(r.cfg); d > 0 {\n105\t\t\t\ttimeout = max(d, time.Second)\n106\t\t\t}\n107\t\t}\n108\t\tctx, cancel := context.WithTimeout(workCtx, timeout)\n109\t\tdefer cancel()\n110\t\n111\t\tr.c.setActive(r.loop.Name(), true)\n112\t\tstart := time.Now()\n113\t\terr := r.safeTick(ctx, Env{Log: log, Cfg: r.cfg, Inflight: r.c.inflight, Stopping: stopping})\n114\t\tr.c.setActive(r.loop.Name(), false)\n115\t\tlog.Debug(\"loop.tick\", \"duration\", time.Since(start).String())\n116\t\n117\t\tif err != nil {\n118\t\t\tr.errs++\n119\t\t\tlog.Error(\"loop.error\", \"error\", err, \"consecutive\", r.errs)\n120\t\t} else {\n121\t\t\tr.errs = 0\n122\t\t}\n123\t\treturn r.nextWait(err)\n124\t}\n125\t\n126\t// reload refreshes the config snapshot, keeping the last good one on error.\n127\tfunc (r *runner) reload(ctx context.Context, log *slog.Logger) {\n128\t\tctx, cancel := context.WithTimeout(ctx, configTimeout)\n129\t\tdefer cancel()\n130\t\tcfg, err := r.c.deps.Config(ctx)\n131\t\tswitch {\n132\t\tcase err != nil:\n133\t\t\tif !r.cfgBroken {\n134\t\t\t\tlog.Error(\"config.reload_failed\", \"error\", err)\n135\t\t\t}\n136\t\t\tr.cfgBroken = true\n137\t\tdefault:\n138\t\t\tif r.cfgBroken {\n139\t\t\t\tlog.Info(\"config.reloaded\")\n140\t\t\t}\n141\t\t\tr.cfgBroken = false\n142\t\t\tr.cfg = cfg\n143\t\t}\n144\t}\n145\t\n146\t// transition logs pause state changes, once per change rather than per tick.\n147\tfunc (r *runner) transition(log *slog.Logger, st PauseState) {\n148\t\tswitch {\n149\t\tcase st.Paused && (!r.paused.Paused || r.paused.Reason != st.Reason):\n150\t\t\tlog.Info(\"loop.paused\", \"reason\", string(st.Reason))\n151\t\tcase !st.Paused && r.paused.Paused:\n152\t\t\tlog.Info(\"loop.resumed\")\n153\t\t}\n154\t\tr.paused = st\n155\t}\n156\t\n157\t// safeTick turns a panic into an error carrying the stack.\n158\tfunc (r *runner) safeTick(ctx context.Context, env Env) (err error) {\n159\t\tdefer func() {\n160\t\t\tif p := recover(); p != nil {\n161\t\t\t\terr = fmt.Errorf(\"panic in %s tick: %v\\n%s\", r.loop.Name(), p, debug.Stack())\n162\t\t\t}\n163\t\t}()\n164\t\treturn r.loop.Tick(ctx, env)\n165\t}\n166\t\n167\t// nextWait is the interval with jitter, or the backed-off interval after\n168\t// backoffAfter consecutive errors, or at least until a rate limit resets.\n169\tfunc (r *runner) nextWait(err error) time.Duration {\n170\t\tinterval := r.interval()\n171\t\tbase := interval\n172\t\tif r.errs >= backoffAfter {\n173\t\t\tlimit := max(interval, backoffCap)\n174\t\t\tbase = interval\n175\t\t\tfor i := 0; i < r.errs-backoffAfter+1 && base < limit; i++ {\n176\t\t\t\tbase = min(base*2, limit)\n177\t\t\t}\n178\t\t}\n179\t\twait := time.Duration(float64(base) * jitter(r.c.rand()))\n180\t\tvar rl *github.RateLimitError\n181\t\tif errors.As(err, &rl) && !rl.ResetAt.IsZero() {\n182\t\t\twait = max(wait, time.Until(rl.ResetAt))\n183\t\t}\n184\t\treturn wait\n185\t}\n186\t"}]},"parent_tool_use_id":null,"session_id":"a29f340e-479a-455e-a288-951a76dc3dfc","uuid":"405af3ea-c70d-49cf-a534-85354d9eb923","timestamp":"2026-11-23T12:15:14.775Z","tool_use_result":{"type":"text","file":{"filePath":"/work/internal/controller/scheduler.go","content":"package controller\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"runtime/debug\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n)\n\nconst (\n\tbackoffAfter = 3 // consecutive errors before backoff starts\n\tbackoffCap   = 15 * time.Minute\n\n\t// configTimeout bounds one config load, which fetches from the remote.\n\tconfigTimeout = 2 * time.Minute\n)\n\n// runner drives one Loop. Ticks of one loop never overlap and a slow tick\n// never queues a second one; different loops run concurrently.\ntype runner struct {\n\tc    *Controller\n\tloop Loop\n\tlog  *slog.Logger\n\n\tcfg       *config.Resolved // last good config; nil until one has loaded\n\tcfgBroken bool             // last reload failed\n\tpaused    PauseState       // last pause state, for transition logs\n\tclamped   bool\n\tn         int // tick counter\n\terrs      int // consecutive tick errors\n}\n\n// jitter maps r in [0,1) to a factor in [0.9, 1.1).\nfunc jitter(r float64) float64 { return 0.9 + 0.2*r }\n\n// interval returns the loop's interval clamped to MinInterval.\nfunc (r *runner) interval() time.Duration {\n\tif r.cfg == nil { // no config yet: retry at the floor\n\t\treturn MinInterval\n\t}\n\td := r.loop.Interval(r.cfg)\n\tif d < MinInterval {\n\t\tif !r.clamped {\n\t\t\tr.clamped = true\n\t\t\tr.log.Warn(\"loop.interval_clamped\", \"requested\", d.String(), \"using\", MinInterval.String())\n\t\t}\n\t\treturn MinInterval\n\t}\n\treturn d\n}\n\n// run is the loop goroutine. It returns when stopping is closed.\nfunc (r *runner) run(workCtx context.Context, stopping <-chan struct{}) {\n\twait := time.Duration(r.c.rand() * 0.1 * float64(r.interval()))\n\tfor {\n\t\tt := time.NewTimer(wait)\n\t\tselect {\n\t\tcase <-stopping:\n\t\t\tt.Stop()\n\t\t\treturn\n\t\tcase <-t.C:\n\t\t}\n\t\tselect { // a tick must not start once shutdown has begun\n\t\tcase <-stopping:\n\t\t\treturn\n\t\tdefault:\n\t\t}\n\t\twait = r.tick(workCtx, stopping)\n\t}\n}\n\n// tick runs one poll and returns how long to wait before the next one.\nfunc (r *runner) tick(workCtx context.Context, stopping <-chan struct{}) time.Duration {\n\tr.n++\n\tlog := r.log.With(\"tick\", r.n)\n\tr.reload(workCtx, log)\n\n\tif r.cfg == nil { // never loaded: nothing can run, and claiming loops are paused\n\t\tif r.loop.Claims() {\n\t\t\tr.transition(log, PauseState{Paused: true, Reason: ReasonConfigInvalid})\n\t\t}\n\t\treturn r.nextWait(nil)\n\t}\n\n\tif r.loop.Claims() {\n\t\tst := r.c.deps.Pause.Check(workCtx, r.cfg)\n\t\tif r.cfgBroken {\n\t\t\tst = PauseState{Paused: true, Reason: ReasonConfigInvalid}\n\t\t}\n\t\tr.transition(log, st)\n\t\tif st.Paused {\n\t\t\treturn r.nextWait(nil)\n\t\t}\n\t}\n\n\tinterval := r.interval()\n\ttimeout := interval\n\tif tt, ok := r.loop.(TickTimeouter); ok {\n\t\tif d := tt.TickTimeout(r.cfg); d > 0 {\n\t\t\ttimeout = max(d, time.Second)\n\t\t}\n\t}\n\tctx, cancel := context.WithTimeout(workCtx, timeout)\n\tdefer cancel()\n\n\tr.c.setActive(r.loop.Name(), true)\n\tstart := time.Now()\n\terr := r.safeTick(ctx, Env{Log: log, Cfg: r.cfg, Inflight: r.c.inflight, Stopping: stopping})\n\tr.c.setActive(r.loop.Name(), false)\n\tlog.Debug(\"loop.tick\", \"duration\", time.Since(start).String())\n\n\tif err != nil {\n\t\tr.errs++\n\t\tlog.Error(\"loop.error\", \"error\", err, \"consecutive\", r.errs)\n\t} else {\n\t\tr.errs = 0\n\t}\n\treturn r.nextWait(err)\n}\n\n// reload refreshes the config snapshot, keeping the last good one on error.\nfunc (r *runner) reload(ctx context.Context, log *slog.Logger) {\n\tctx, cancel := context.WithTimeout(ctx, configTimeout)\n\tdefer cancel()\n\tcfg, err := r.c.deps.Config(ctx)\n\tswitch {\n\tcase err != nil:\n\t\tif !r.cfgBroken {\n\t\t\tlog.Error(\"config.reload_failed\", \"error\", err)\n\t\t}\n\t\tr.cfgBroken = true\n\tdefault:\n\t\tif r.cfgBroken {\n\t\t\tlog.Info(\"config.reloaded\")\n\t\t}\n\t\tr.cfgBroken = false\n\t\tr.cfg = cfg\n\t}\n}\n\n// transition logs pause state changes, once per change rather than per tick.\nfunc (r *runner) transition(log *slog.Logger, st PauseState) {\n\tswitch {\n\tcase st.Paused && (!r.paused.Paused || r.paused.Reason != st.Reason):\n\t\tlog.Info(\"loop.paused\", \"reason\", string(st.Reason))\n\tcase !st.Paused && r.paused.Paused:\n\t\tlog.Info(\"loop.resumed\")\n\t}\n\tr.paused = st\n}\n\n// safeTick turns a panic into an error carrying the stack.\nfunc (r *runner) safeTick(ctx context.Context, env Env) (err error) {\n\tdefer func() {\n\t\tif p := recover(); p != nil {\n\t\t\terr = fmt.Errorf(\"panic in %s tick: %v\\n%s\", r.loop.Name(), p, debug.Stack())\n\t\t}\n\t}()\n\treturn r.loop.Tick(ctx, env)\n}\n\n// nextWait is the interval with jitter, or the backed-off interval after\n// backoffAfter consecutive errors, or at least until a rate limit resets.\nfunc (r *runner) nextWait(err error) time.Duration {\n\tinterval := r.interval()\n\tbase := interval\n\tif r.errs >= backoffAfter {\n\t\tlimit := max(interval, backoffCap)\n\t\tbase = interval\n\t\tfor i := 0; i < r.errs-backoffAfter+1 && base < limit; i++ {\n\t\t\tbase = min(base*2, limit)\n\t\t}\n\t}\n\twait := time.Duration(float64(base) * jitter(r.c.rand()))\n\tvar rl *github.RateLimitError\n\tif errors.As(err, &rl) && !rl.ResetAt.IsZero() {\n\t\twait = max(wait, time.Until(rl.ResetAt))\n\t}\n\treturn wait\n}\n","numLines":186,"startLine":1,"totalLines":186}},"tool_result_meta":[{"id":"toolu_01XXYNhsWYZ7nsRHMW9GhQrb","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
