cli.Env, build builder) error {\n \t\t\t}},\n \t\t},\n \t\tForce: forceOnSecondSignal(ctx),\n+\t\tWake:  wakeSignals(ctx),\n \t}, registerLoops(w)...)\n \tif err != nil {\n \t\treturn fmt.Errorf(\"ard serve: %w\", err)\ndiff --git a/internal/servecmd/wake_other.go b/internal/servecmd/wake_other.go\nnew file mode 100644\nindex 0000000..bf30a60\n--- /dev/null\n+++ b/internal/servecmd/wake_other.go\n@@ -0,0 +1,8 @@\n+//go:build !unix\n+\n+package servecmd\n+\n+import \"context\"\n+\n+// wakeSignals is not supported off Unix.\n+func wakeSignals(context.Context) <-chan struct{} { return nil }\ndiff --git a/internal/servecmd/wake_unix.go b/internal/servecmd/wake_unix.go\nnew file mode 100644\nindex 0000000..8d66ad0\n--- /dev/null\n+++ b/internal/servecmd/wake_unix.go\n@@ -0,0 +1,32 @@\n+//go:build unix\n+\n+package servecmd\n+\n+import (\n+\t\"context\"\n+\t\"os\"\n+\t\"os/signal\"\n+\t\"syscall\"\n+)\n+\n+// wakeSignals delivers one value per SIGUSR1 until ctx is done.\n+func wakeSignals(ctx context.Context) <-chan struct{} {\n+\tsig := make(chan os.Signal, 1)\n+\tsignal.Notify(sig, syscall.SIGUSR1)\n+\tout := make(chan struct{}, 1)\n+\tgo func() {\n+\t\tdefer signal.Stop(sig)\n+\t\tfor {\n+\t\t\tselect {\n+\t\t\tcase <-ctx.Done():\n+\t\t\t\treturn\n+\t\t\tcase <-sig:\n+\t\t\t\tselect {\n+\t\t\t\tcase out <- struct{}{}:\n+\t\t\t\tdefault:\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\t}()\n+\treturn out\n+}\ndiff --git a/internal/servecmd/wake_unix_test.go b/internal/servecmd/wake_unix_test.go\nnew file mode 100644\nindex 0000000..17ed255\n--- /dev/null\n+++ b/internal/servecmd/wake_unix_test.go\n@@ -0,0 +1,25 @@\n+//go:build unix\n+\n+package servecmd\n+\n+import (\n+\t\"context\"\n+\t\"os\"\n+\t\"syscall\"\n+\t\"testing\"\n+\t\"time\"\n+)\n+\n+func TestWakeSignals(t *testing.T) {\n+\tctx, cancel := context.WithCancel(context.Background())\n+\tch := wakeSignals(ctx)\n+\tif err := syscall.Kill(os.Getpid(), syscall.SIGUSR1); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tselect {\n+\tcase 