dRand(0.5), Wake: wake}, l))\n\t\ttime.Sleep(time.Second) // first tick is running\n\t\tfor range 3 {\n\t\t\twake <- struct{}{}\n\t\t}\n\t\ttime.Sleep(10 * time.Minute)\n\t\t_ = stop()\n\t\tif l.maxCur != 1 {\n\t\t\tt.Errorf(\"max concurrent ticks = %d\", l.maxCur)\n\t\t}\n\t\tif got := l.ticks(); got != 2 {\n\t\t\tt.Errorf(\"ticks = %d, want 2\", got)\n\t\t}\n\t})\n}\n\nfunc TestWakeAfterStopIgnored(t *testing.T) {\n\tsynctest.Test(t, func(t *testing.T) {\n\t\tlog, _ := newLog()\n\t\twake := make(chan struct{}, 1)\n\t\tl := &testLoop{name: \"a\", claims: true}\n\t\tstop := start(t, mustNew(t, Deps{Log: log, Rand: fixedRand(0.5), Wake: wake}, l))\n\t\ttime.Sleep(time.Second)\n\t\tbefore := l.ticks()\n\t\terr := stop()\n\t\twake <- struct{}{}\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\ttime.Sleep(time.Second)\n\t\tif l.ticks() != before {\n\t\t\tt.Errorf(\"tick started after stop\")\n\t\t}\n\t})\n}\nE\ncat > internal/servecmd/wake_unix_test.go <<'E'\n//go:build unix\n\npackage servecmd\n\nimport (\n\t\"context\"\n\t\"os\"\n\t\"syscall\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc TestWakeSignals(t *testing.T) {\n\tctx, cancel := context.WithCancel(context.Background())\n\tch := wakeSignals(ctx)\n\tif err := syscall.Kill(os.Getpid(), syscall.SIGUSR1); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tselect {\n\tcase <-ch:\n\tcase <-time.After(5 * time.Second):\n\t\tt.Fatal(\"no wake after SIGUSR1\")\n\t}\n\tcancel()\n}\nE\npython3 - <<'E'\np='docs/runbooks/gate-2.md'\ns=open(p).read()\na=s.index(\"interval (triage 15 min, workers and reviewers 5 min). Until\")\nb=s.index(\"`ard:approved` counts as soon\")\ns=s[:a]+\"\"\"interval (triage 15 min, workers and reviewers 5 min). To act now, send\n`SIGUSR1` to `serve` (`kill -USR1 <pid of ard serve>`): every loop runs one tick\nimmediately, still behind the kill switch and the job pool, and logs\n`controller.wake`. No restart is needed.\n\"\"\"+s[b:]\nopen(p,'w').write(s)\np='docs/TODO.md'\ns=open(p).read().replace(\"- #161 Wake the loops without restarting ard serve\\n\",\"\")\nopen(p,'w').write(s)\np='docs/proposal.md'\ns=open(p).read()\nk=\"The delay is at most one loop interval plus 10% jitter; a tick already running may finish its claims.\"\nassert k in s\ns=s.replace(k,k+\" `SIGUSR1` (Unix only) makes every loop run one tick now, logged as `controller.wake`; the tick still passes the kill switch and the job pool, and wakes that arrive while a tick runs coalesce into one extra tick.\",1)\nopen(p,'w').write(s)\nE\ngofmt -l internal; go vet ./internal/controller ./internal/servecmd && go test ./internal/controller ./internal/servecmd 2>&1 | tail -15; git status --porcelain"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":318,"cache_read_input_tokens":27976,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":318},"output_tokens":20,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0b568cb7-6c40-4f66-b76d-4b3bb13d5c28","uuid":"ac364b5d-da1d-453c-b996-fd8e5d68d663","timestamp":"2026-11-23T12:55:42.770Z","request_id":"req_011ChKttk4r8q5ruUfwFKna2"}
