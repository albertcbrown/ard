}\n  workers/engineer: { model: claude-sonnet-5-5, timeout: 60m, tests: make test }\n  reviewers/eng-review: { model: claude-sonnet-5-5 }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01EW72pbie967mWG6apsEtdw","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
