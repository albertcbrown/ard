oop)(nil)\n\t_ controller.TickTimeouter = (*Loop)(nil)\n)\n\n// NewLoop returns the scanners loop over p.\nfunc NewLoop(p *Pipeline, builtins ...Builtin) *Loop { return &Loop{p: p, builtins: builtins} }\n\nfunc (l *Loop) Name() string                            { return \"scanners\" }\nfunc (l *Loop) Claims() bool                            { return true }\nfunc (l *Loop) Interval(*config.Resolved) time.Duration { return PollInterval }\n\n// TickTimeout bounds a tick by the longest scan timeout plus slack, so a long\n// scan is not cancelled at the poll interval.\nfunc (l *Loop) TickTimeout(cfg *config.Resolved) time.Duration {\n\tvar longest time.Duration\n\tfor _, r := range cfg.RolesOf(config.KindScanner) {\n\t\tif r.ScanPath != \"\" {\n\t\t\tlongest = max(longest, r.Timeout)\n\t\t}\n\t}\n\tif longest == 0 {\n\t\treturn 0\n\t}\n\treturn longest + tickSlack\n}\n\nfunc (l *Loop) builtinNamed(name string) bool {\n\tfor _, b := range l.builtins {\n\t\tif b.Name() == name {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\ntype dueScanner struct {\n\tdue     time.Time // zero when it never ran\n\trole    config.Role\n\tbuiltin Builtin\n}\n\nfunc (d dueScanner) name() string {\n\tif d.builtin != nil {\n\t\treturn d.builtin.Name()\n\t}\n\treturn d.role.Name\n}\n\n// Tick runs due scanners, most overdue first, and stops after the first one\n// that did anything but get denied a pool slot. A scanner denied a slot stays\n// the most overdue; without the walk it would starve the built-ins and every\n// other scanner.\nfunc (l *Loop) Tick(ctx context.Context, env controller.Env) error {\n\tcfg := env.Cfg\n\tnow := l.p.now()\n\tvar due []dueScanner\n\tconsider := func(c dueScanner, every time.Duration) error {\n\t\tstore, err := l.p.Stores(ctx, c.name())\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"scanner %s: open state: %w\", c.name(), err)\n\t\t}\n\t\tlast, err := store.LastRun(ctx)\n\t\tswitch {\n\t\tcase errors.Is(err, scannerdb.ErrNotFound):\n\t\tcase err != nil:\n\t\t\treturn fmt.Errorf(\"scanner %s: last run: %w\", c.name(), err)\n\t\tdefault:\n\t\t\tc.due = last.StartedAt.Add(every)\n\t\t\tif c.due.After(now) {\n\t\t\t\treturn nil\n\t\t\t}\n\t\t}\n\t\tdue = append(due, c)\n\t\treturn nil\n\t}\n\tvar errs []error\n\tfor _, r := range cfg.RolesOf(config.KindScanner) {\n\t\tswitch {\n\t\tcase r.ScanPath == \"\":\n\t\t\tenv.Log.Debug(\"scanner.skip\", \"scanner\", r.Name, \"reason\", \"LLM scanner (phase 2)\")\n\t\t\tcontinue\n\t\tcase l.builtinNamed(r.Name):\n\t\t\tenv.Log.Warn(\"scanner.skip\", \"scanner\", r.Name, \"reason\", \"name collides with a built-in scanner\")\n\t\t\tcontinue\n\t\t}\n\t\tif err := consider(dueScanner{role: r}, r.Every); err != nil {\n\t\t\terrs = append(errs, err)\n\t\t}\n\t}\n\tfor _, b := range l.builtins {\n\t\tif err := consider(dueScanner{builtin: b}, b.Every()); err != nil {\n\t\t\terrs = append(errs, err)\n\t\t}\n\t}\n\tsort.SliceStable(due, func(i, j int) bool { return due[i].due.Before(due[j].due) })\n\tfor _, d := range due {\n\t\toutcome, err := l.run(ctx, env, cfg, d, now)\n\t\tif err != nil {\n\t\t\terrs = append(errs, err)\n\t\t}\n\t\tif outcome != OutcomeNoSlot {\n\t\t\tbreak\n\t\t}\n\t}\n\treturn errors.Join(errs...)\n}\n\nfunc (l *Loop) run(ctx context.Context, env controller.Env, cfg *config.Resolved, d dueScanner, now time.Time) (string, error) {\n\tif d.builtin != nil {\n\t\treturn OutcomeOK, l.runBuiltin(ctx, env, d.builtin)\n\t}\n\tp := *l.p // per-tick copy so the run logs under the loop's tick tag\n\tp.Log = env.Log\n\tsince := d.due\n\tif since.IsZero() {\n\t\tsince = now\n\t}\n\tres, err := p.Run(ctx, cfg, d.role, since)\n\treturn res.Outcome, err\n}\n\nfunc (l *Loop) runBuiltin(ctx context.Context, env controller.Env, b Builtin) error {\n\tstore, err := l.p.Stores(ctx, b.Name())\n\tif err != nil {\n\t\treturn err\n\t}\n\tstart := l.p.now()\n\trerr := b.Run(ctx)\n\toutcome := OutcomeOK\n\tif rerr != nil {\n\t\toutcome = OutcomeError\n\t}\n\tif _, err := store.RecordRun(context.WithoutCancel(ctx), scannerdb.Run{StartedAt: start, FinishedAt: l.p.now(), Outcome: outcome}); err != nil {\n\t\tenv.Log.Error(\"scanner.record_run_failed\", \"scanner\", b.Name(), \"error\", err)\n\t}\n\tif rerr != nil {\n\t\treturn fmt.Errorf(\"built-in scanner %s: %w\", b.Name(), rerr)\n\t}\n\treturn nil\n}\npackage scanner\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/committer\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/state/scannerdb\"\n)\n\n// Store is one scanner's database. *scannerdb.DB satisfies it.\ntype Store interface {\n\tFindings(ctx context.Context) ([]scannerdb.Finding, error)\n\tSuppressions(ctx context.Context) ([]scannerdb.Suppression, error)\n\tApply(ctx context.Context, b scannerdb.Batch) error\n\tReplace(ctx context.Context, f []scannerdb.Finding, s []scannerdb.Suppression) error\n\tRecordRun(ctx context.Context, r scannerdb.Run) (int64, error)\n\tLastRun(ctx context.Context) (scannerdb.Run, error) // scannerdb.ErrNotFound when none\n}\n\n// Stores opens a scanner's Store by name.\ntype Stores func(ctx context.Context, name string) (Store, error)\n\n// RegistryStores adapts a scannerdb.Registry.\nfunc RegistryStores(r *scannerdb.Registry) Stores {\n\treturn func(ctx context.Context, name string) (Store, error) {\n\t\tdb, err := r.Get(ctx, name)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\treturn db, nil\n\t}\n}\n\nfunc loadSnapshot(ctx context.Context, s Store) (Snapshot, error) {\n\trows, err := s.Findings(ctx)\n\tif err != nil {\n\t\treturn Snapshot{}, err\n\t}\n\tsups, err := s.Suppressions(ctx)\n\tif err != nil {\n\t\treturn Snapshot{}, err\n\t}\n\treturn NewSnapshot(rows, sups), nil\n}\n\n// Reader is the GitHub read side the pipeline needs. github.Reader satisfies\n// it.\ntype Reader interface {\n\tListIssues(ctx context.Context, o github.ListIssuesOpts) ([]github.Issue, error)\n\tGetIssue(ctx context.Context, n int) (github.Issue, error)\n}\n\n// Effects is the effect layer the pipeline writes through. effects.Effects\n// satisfies it, so --dry-run logs instead of acting.\ntype Effects interface {\n\tCreateIssue(ctx context.Context, in github.NewIssue) (github.Issue, error)\n\tUpdateIssue(ctx context.Context, n int, u github.IssueUpdate) error\n\tUpdateIssueBody(ctx context.Context, n int, body string) error\n\tCreateComment(ctx context.Context, n int, body string) (github.Comment, error)\n\tDryRun() bool\n}\n\n// Committer commits files to main. *committer.Committer satisfies it.\ntype Committer interface {\n\tCommit(ctx context.Context, req committer.Request) (committer.Result, error)\n}\n\n// Engine runs a scanner and returns its findings. cfg is the tick's config:\n// the scan runs at cfg.SHA with the role directory under cfg.Repo. since is\n// when the run became due, for the pool's oldest-first ranking.\ntype Engine interface {\n\tScan(ctx context.Context, cfg *config.Resolved, role config.Role, since time.Time) (ScanResult, error)\n}\n\n// ScanResult is one scan: the commit scanned and its findings.\ntype ScanResult struct {\n\tSHA      string\n\tFindings []Finding\n}\n\n// ErrNoSlot means the pool denied the run a job slot. The run is not\n// recorded: it stays due and is offered again on the next tick.\nvar ErrNoSlot = errors.New(\"scanner: no job slot\")\n\n// ScanError is a scan that did not produce findings: a non-zero exit, a\n// timeout, a vanished process or invalid output. Its stdout is discarded.\ntype ScanError struct {\n\tSHA      string\n\tExit     int\n\tTimedOut bool\n\tDecode   DecodeErrors\n\tErr      error\n}\n\nfunc (e *ScanError) Error() string {\n\tswitch {\n\tcase e.TimedOut:\n\t\treturn \"scan timed out\"\n\tcase len(e.Decode) > 0:\n\t\treturn e.Decode.Error()\n\tcase e.Err != nil:\n\t\treturn fmt.Sprintf(\"scan failed: %v\", e.Err)\n\t}\n\treturn fmt.Sprintf(\"scan exited with status %d\", e.Exit)\n}\n\nfunc (e *ScanError) Unwrap() error { return e.Err }\n\n// Run outcomes, recorded in the scanner's runs table.\nconst (\n\tOutcomeOK           = \"ok\"\n\tOutcomeBackpressure = \"dropped_backpressure\"\n\tOutcomeGlobalCap    = \"dropped_global_cap\"\n\tOutcomeScanFailed   = \"scan_failed\"\n\tOutcomeTimeout      = \"timeout\"\n\tOutcomeError        = \"error\"\n\t// OutcomeNoSlot, OutcomePaused and OutcomeSkipped are reported but never recorded.\n\tOutcomeNoSlot  = \"dropped_no_slot\"\n\tOutcomePaused  = \"paused\"\n\tOutcomeSkipped = \"skipped\"\n)\n\nfunc hasLabel(lbls []string, want string) bool {\n\tfor _, l := range lbls {\n\t\tif strings.EqualFold(l, want) {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n43:\t// GuardScanners overrides the pre-filing guard's passes. Tests only. nil\n47:\t// to turn the guard off.\n70:\t// GuardRule and GuardField are the first guard hit's rule and field, or\n71:\t// \"scan-error\" and \"\" when a guard pass failed.\n76:func routeLabel(r config.Route) (label string, ok bool) {\n88:// guardPasses returns the guard's base and optional scanners.\n89:func (p *Pipeline) guardPasses(cfg *config.Resolved) (base, optional redact.Scanner) {\n99:func (p *Pipeline) secrets() *redact.Secrets {\n106:// passFailure logs a failed guard pass. Only redact errors, which carry no\n108:func passFailure(log *slog.Logger, pass string, err error, extra ...any) {\n114:\tlog.Warn(\"scanner.guard_failed\", args...)\n117:func (p *Pipeline) now() time.Time {\n124:func (p *Pipeline) log() *slog.Logger {\n132:func (p *Pipeline) openIssues(ctx context.Context, name string) ([]github.Issue, error) {\n150:func (p *Pipeline) Run(ctx context.Context, cfg *config.Resolved, role config.Role, due time.Time) (RunResult, error) {\n237:\t\t// Before any counting: an adopted synthetic issue counts towards max_open.\n263:\tcase openCount >= role.MaxOpen:\n264:\t\tlog.Info(\"scanner.dropped\", \"reason\", \"max_open\", \"open\", openCou