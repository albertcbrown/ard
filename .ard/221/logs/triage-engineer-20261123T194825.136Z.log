qualFold(is.Author, author) && strings.Contains(is.Body, StatusMarker)\n}\n\n// EnsureStatusIssue returns the number of the pinned status issue, creating\n// and pinning it when none exists. author is the login ard acts as. The number\n// cached under StatusIssueKey is tried first and adopted if that issue is\n// still our open status issue; otherwise (or when it cannot be read) search is\n// the fallback, then create. Search is eventually consistent, so the cache is\n// what stops a quick restart creating a second issue; the lowest-number rule\n// only covers a crash between create and remember, or a lost cache. cache may\n// be nil. Under dry-run the effect layer returns a negative synthetic number,\n// which is returned as is and never cached. A pin failure is a warning.\nfunc EnsureStatusIssue(ctx context.Context, gh StatusReader, fx StatusEffects, cache StatusCache, author string, log *slog.Logger) (int, error) {\n\tif log == nil {\n\t\tlog = slog.Default()\n\t}\n\tprev := 0\n\tif cache != nil {\n\t\tprev = cachedStatusNumber(ctx, cache, log)\n\t}\n\tif prev > 0 {\n\t\tn, ok := adoptCached(ctx, gh, prev, author, log)\n\t\tif ok {\n\t\t\treturn n, nil\n\t\t}\n\t}\n\tq := fmt.Sprintf(`is:issue is:open in:title \"%s\"`, StatusTitle)\n\tfound, err := gh.SearchIssues(ctx, q, github.SearchOpts{Sort: \"created\", Order: \"asc\"})\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"find status issue: %w\", err)\n\t}\n\tvar nums []int\n\tfor _, is := range found {\n\t\tif ownStatusIssue(is, author) {\n\t\t\tnums = append(nums, is.Number)\n\t\t}\n\t}\n\tsort.Ints(nums)\n\tswitch {\n\tcase len(nums) == 1:\n\t\tremember(ctx, cache, nums[0], prev, log)\n\t\treturn nums[0], nil\n\tcase len(nums) > 1:\n\t\tlog.Warn(\"status.duplicate\", \"using\", nums[0], \"all\", nums)\n\t\tremember(ctx, cache, nums[0], prev, log)\n\t\treturn nums[0], nil\n\t}\n\tis, err := fx.CreateIssue(ctx, github.NewIssue{Title: StatusTitle, Body: statusBody})\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"create status issue: %w\", err)\n\t}\n\t// Before pinning, to keep the window where a crash loses the number short.\n\tremember(ctx, cache, is.Number, prev, log)\n\tif err := fx.PinIssue(ctx, is.Number); err != nil {\n\t\tlog.Warn(\"status.pin_failed\", \"issue\", is.Number, \"error\", err,\n\t\t\t\"hint\", \"pin the status issue manually\")\n\t}\n\tlog.Info(\"status.created\", \"issue\", is.Number)\n\treturn is.Number, nil\n}\n\n// cachedStatusNumber returns the cached issue number, or 0 when none is usable.\nfunc cachedStatusNumber(ctx context.Context, cache StatusCache, log *slog.Logger) int {\n\tv, err := cache.Meta(ctx, StatusIssueKey)\n\tif errors.Is(err, state.ErrNotFound) {\n\t\treturn 0\n\t}\n\tif err != nil {\n\t\tlog.Warn(\"status.cache_read_failed\", \"error\", err)\n\t\treturn 0\n\t}\n\tn, err := strconv.Atoi(v)\n\tif err != nil || n <= 0 {\n\t\tlog.Warn(\"status.cache_invalid\", \"value\", v)\n\t\treturn 0\n\t}\n\treturn n\n}\n\n// adoptCached reads the cached issue and reports whether it is still ours. Any\n// failure to adopt falls back to search; a read error other than not-found\n// does too, since starting over beats aborting.\nfunc adoptCached(ctx context.Context, gh StatusReader, n int, author string, log *slog.Logger) (int, bool) {\n\tis, err := gh.GetIssue(ctx, n)\n\tswitch {\n\tcase errors.Is(err, github.ErrNotFound):\n\t\tlog.Info(\"status.cache_stale\", \"issue\", n, \"reason\", \"not_found\")\n\t\treturn 0, false\n\tcase err != nil:\n\t\tlog.Warn(\"status.cache_unreadable\", \"issue\", n, \"error\", err)\n\t\treturn 0, false\n\t}\n\tif is.Number == n && ownStatusIssue(is, author) {\n\t\treturn n, true\n\t}\n\treason := \"foreign\"\n\tif is.State == github.StateClosed {\n\t\treason = \"closed\"\n\t}\n\tlog.Info(\"status.cache_stale\", \"issue\", n, \"reason\", reason)\n\treturn 0, false\n}\n\n// remember caches n unless there is no cache, n is a dry-run synthetic number\n// or the cache already holds it. A write failure is a warning: the issue exists.\nfunc remember(ctx context.Context, cache StatusCache, n, prev int, log *slog.Logger) {\n\tif cache == nil || n <= 0 || n == prev {\n\t\treturn\n\t}\n\tif err := cache.SetMeta(ctx, StatusIssueKey, strconv.Itoa(n)); err != nil {\n\t\tlog.Warn(\"status.cache_write_failed\", \"issue\", n, \"error\", err)\n\t}\n}\n85:Four more labels sit outside the grammar: `ard:approved` (human go-ahead before a worker starts; counts only when a triage-or-higher collaborator added it after triage finished), `ard:tests:failed` (worker could not get tests green; set by worker close-out on the issue and the PR, cleared by a green run), `ard:keep` (hold failed-job resources past 24 h) and `ard:pause` (on the pinned status issue, stops all new claims). `ard labels sync` creates and updates the full set from the resolved config, idempotently, and never deletes a label: stale `ard:` labels are only reported. In `label` mode a custom `intake.label` is part of the catalogue: sync creates it with a description saying it admits the issue to triage, and switching back to the default leaves the old custom label reported as stale, never deleted. `ard labels sync` and `ard config check` reject an intake label that is one of ard's own label names, naming `intake.label`; `ard serve` logs `config.intake_invalid` once per distinct value. `--repo owner/name` names the repository; when omitted, it is read from the `origin` remote. Role names are at most 31 characters and scanner names at most 38, because GitHub caps a label at 50 characters. Worker role names may not contain an all-digit segment (`eng-12`), so branch names stay unambiguous.\n192:**Each scanner has its own state, and GitHub is the truth.** Every scanner keeps a separate SQLite file, `~/.ard/state/<owner>/<repo>/<scanner>.db`: fingerprint to issue, first and last seen, suppressions, last run. Scanners never share or lock each other's state, and one can be reset without touching the rest. The controller keeps its own jobs, attempts, events and a small key/value table (for example the status issue number) in `_controller.db` in the same directory, and dry-run uses `~/.ard/state-dryrun/<owner>/<repo>/`. Owner and repo are lowercased (GitHub names are case-insensitive) and nested, so distinct repos never share a directory (`a-b/c` and `a/b-c` would collide as `a-b-c`); `ard serve` and `ard rebuild-state` refuse to start while a pre-#82 flat `<owner>-<repo>` state directory exists under `state/` or `state-dryrun/`, and ard does not migrate it (decided, #82). Every issue body carries hidden markers, so `ard rebuild-state <scanner>` restores a database from GitHub after a lost disk or a host move. The body holds a header `<!-- ard:scanner=<name> group=<enc> -->` and a checklist between `<!-- ard:findings -->` and `<!-- /ard:findings -->`, one line per finding: `- [ ] <title> <!-- ard:fp=<enc> sev=<severity> [reg=<old issue>] -->`. `<enc>` percent-encodes every byte outside `[A-Za-z0-9._:/@+=,~-]`, so the proposal's example fingerprint stays readable and nothing can close the comment. A ticked box means the finding is gone. Per-finding details sit in a second span, `<!-- ard:details -->`, cut to 2,000 characters each and trimmed from the end to keep the body under 60,000; `issue.md` holds them untruncated. The controller reads and rewrites only the two spans, so text a human or triage adds elsewhere survives. A human who deletes a marker line makes that finding look new, which is accepted because GitHub is the truth.\n432:**Where `ard serve` reads config (decided, #87).** After each fetch into its own clone (`~/.ard/repos/<owner>/<repo>.git`, see Local-executor details) `ard serve` resolves `origin/main` to a SHA and reads `config.yaml` and the role directories from that commit, not from the working tree. It exports them into a snapshot at `~/.ard/config/<owner>/<repo>/<sha>/`, kept 24 hours after a newer SHA replaces it, because roles run from a host path: a role directory, its `Dockerfile` and the scan worktree must all describe the one commit the tick's jobs use. Editing the host's working tree therefore changes nothing on a running controller, with one exception: a local `paused: true` is honoured (see the kill switch), and only that key is read locally. A merged change applies on the next tick without a pull. Symlinks and submodules under the role directories are rejected, and a config that cannot be fetched or does not validate counts as paused. If `origin/main` cannot be loaded at startup, `ard serve` starts paused instead of exiting, posts the load error to the status issue once per distinct error, and retries every tick; no loop runs until a config has loaded. `ard config check` validates the working tree, for authoring; `ard config check --ref <ref>` validates a commit of the local checkout (for example `--ref origin/main` after `git fetch`) without fetching.\n438:- **Identity: a GitHub App, not a PAT.** Installation tokens expire hourly and are scoped to contents, issues and pull requests (read and write), plus checks (read and write) and commit statuses (read). The merger reads check runs (checks: read), commit statuses (commit statuses: read) and the branch rules (metadata). The merger needs read to see required checks; the owner kept write so ard can later publish its own check runs, but nothing in Phase 1 writes checks. Leaving out the `workflows` permission makes GitHub itself reject any push that edits `.github/workflows/`, a second backstop behind a guard that already refuses all of `.github/`, and it also keeps the bot from editing the bot-commit audit. The scratch-repo run (#85) confirmed that GitHub rejects such a push (\"refusing to allow a GitHub App to create or update workflow ... without `workflows` permission\"), and that these work with exactly this permission set: label writes, PR create, review and mark-ready, pinning the status issue, and timeline and collaborator-permission reads. A personal token (`ARD_GITHUB_TOKEN`) is accepted only for local `--dry-run` development, and the client is then made read-only so no write can reach GitHub.\n449:- **Committed output is redacted.** Close-out strips known secret values, and replaces the controller host's paths (see \"All agent output is committed too\") with placeholders, in each log and every `.ard/<issue#>/` file it commits, and runs a secret scan before anything is committed or posted. A hit on a log keeps that log host-local and adds `ard:needs-human`; a hit on a role file or `plan.md` commits only the clean log and adds `ard:needs-human`. Comments never quote text the scan flagged (and the same scan runs on worker code before it is pushed, see above, and the worker's PR body and code commit message get the same secret and host-path replacement; the config-load error posted to the status issue gets the host-path replacement too), never forge an `ard:` marker and never `@`-mention anyone. The scan fails closed: if it cannot run, nothing is committed. An optional second pass runs a pinned gitleaks binary (`redact.gitleaks`, see \"All agent output is committed too\"); it is off by default, fails closed, and a hit is handled like an internal hit. Once a log's redacted copy is committed, close-out deletes the raw host log; if redaction failed or the scan flagged it, the raw log is kept (and the keep logged) for a human to inspect.\n450:- **Budgets.** Every job has a dollar cap (`max_budget_usd`) and a hard timeout; every role and the whole repo have a daily dollar cap. The caps are enforced at the pool's claim gate (`internal/budget`): a candidate is refused when `spent >= cap`, where spent is the cost recorded in `step_usage` since 00:00 UTC today. The caps reset at 00:00 UTC and survive a restart, because spend is read from the controller database. A role's own `budget_usd_per_day` caps that role (by stage and name) alone; a role without one is limited only by the repo cap. Steps that reported no cost count as $0, and the refusal reason shows how many there were. There is no exemption for reviewers, the caps apply to OAuth credentials too, and deterministic scanners (no model, no cost) are exempt. Running jobs are never killed for a cap. If today's spend cannot be read, the gate refuses (fails closed). Each cap is logged once a day as `budget.capped`. `--loops` accepts `budget` as a name, but the gate is part of the pool and is always on. Posting the cap on the status issue is not part of this change.\n452:- **Kill switch.** Four sources stop new claims, scanner runs (filing and autoclose), stale closes and merges: a local pause file `~/.ard/pause/<owner>/<repo>` outside the repository (the path is lowercased; `ard serve` creates the directory, so `touch` pauses and `rm` resumes), `paused: true` in the `config.yaml` in the host's working tree, `ard:pause` on the pinned status issue, and `paused: true` in the config on `origin/main`. They are checked cheapest first, before every claiming tick. The delay is at most one loop interval plus 10% jitter; a tick already running may finish its claims. `SIGUSR1` (Unix only) makes every loop run one tick now, logged as `controller.wake`; the tick still passes the kill switch and the job pool, and wakes that arrive while a tick runs coalesce into one extra tick. The gate answers one controller-wide question and has no per-kind checks, so every loop that writes (scanner filing and autoclose, stale closes, merges, claims), except the Reaper, the cost-table writer and in-flight close-outs, must report `Claims() == true` and is skipped while paused. Running jobs, in-flight close-outs, the Reaper and the `costs` loop continue: the table is bookkeeping about work already done, not new work. The check fails closed: an unreadable status issue, a failed fetch of `origin/main`, or a config that fails to load counts as paused. The pause file pauses when anything exists at the path (a file, a directory or a symlink; content is ignored), and a path that cannot be examined, for example because `pause/<owner>` is a regular file, also counts as paused. The local working-tree `config.yaml` is read only for its `paused` key; a missing, unreadable or invalid file does not pause by itself, but a readable one that says `paused: true` does. The pause file and the local `paused` are the kill switches that nothing pushed to GitHub can lift. Config and role directories otherwise come from `origin/main` at the same SHA the tick's jobs use (see Configuration). `ard serve` remembers the status issue number in `_controller.db` (`meta` key `status_issue`). At startup it reads that issue directly and adopts it if it is still open, titled `ard status`, carries the `<!-- ard:status -->` marker and has the App as author; otherwise it searches by those same tests, and creates and pins the issue if none matches. Search is eventually consistent, so the remembered number is what stops a quick restart from creating a second issue; if two still match, the lowest number wins. A cached issue that cannot be read for a reason other than not-found falls back to search rather than aborting startup. A dry-run never stores its synthetic (negative) number; a real number found by search is stored only in the separate dry-run database. A second `ard serve` on the same repo exits with an error: the leader lock is an `flock` on `~/.ard/locks/<owner>/<repo>.lock` (local filesystem only), shared by live and dry-run.\n453:- **Observability.** Every claim, close-out and failure is an event in local state. A daily digest on the pinned status issue shows queue depth by label, jobs run, failures and spend. Each issue's body also carries a per-job cost table (agent, tokens by type, cost, model, outcome and a link to the job's comment, PR) with a Total row, written by the `costs` loop. The repository may be public, so the spend it shows is public too; the table holds no agent text or host paths.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01LzUESpZU9BX9TmGB86hdDR","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
