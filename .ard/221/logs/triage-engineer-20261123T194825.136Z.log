tem) []Finding {\n730:func (e *execution) file(op GroupOp) {\n746:func (e *execution) sortedItems(items []Item) []Item {\n755:func (e *execution) join(op GroupOp) bool {\n813:func (p *Pipeline) groupSize(r config.Role) int { return max(r.GroupSize, 1) }\n815:func linesOf(items []Item) []Line {\n824:func (e *execution) create(op GroupOp) {\n857:// which the committer's guard rejects, and a join to a real issue would be\n860:func (e *execution) issueMD(n int, title string, p Parsed, add []Finding, prevBody string) {\n877:func (e *execution) touchSeen(plan Plan) {\n908:func (p *Pipeline) adoptLedger(ctx context.Context, store Store, snap *Snapshot, role config.Role, now time.Time, sha string) error {\n948:func fitItems(prevBody string, existing []Line, scanner, group string, items []Item) int {\npackage controller\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// Status issue identity. The marker, not the title, is what makes an issue\n// ours; the author check stops a stranger's look-alike being adopted.\nconst (\n\tStatusTitle  = \"ard status\"\n\tStatusMarker = \"<!-- ard:status -->\"\n)\n\n// StatusIssueKey is the meta key that remembers the status issue number.\nconst StatusIssueKey = \"status_issue\"\n\n// StatusReader is what the lookup reads: the cached issue directly, else search.\ntype StatusReader interface {\n\tGetIssue(ctx context.Context, n int) (github.Issue, error)\n\tSearchIssues(ctx context.Context, q string, o github.SearchOpts) ([]github.Issue, error)\n}\n\n// StatusCache remembers the status issue number across restarts. *state.Store\n// satisfies it. Meta returns an error wrapping state.ErrNotFound when unset.\ntype StatusCache interface {\n\tMeta(ctx context.Context, key string) (string, error)\n\tSetMeta(ctx context.Context, key, value string) error\n}\n\nvar _ StatusCache = (*state.Store)(nil)\n\n// StatusEffects is the write side, satisfied by effects.Effects.\ntype StatusEffects interface {\n\tCreateIssue(ctx context.Context, in github.NewIssue) (github.Issue, error)\n\tPinIssue(ctx context.Context, n int) error\n}\n\nconst statusBody = StatusMarker + \"\\n\\nManaged by ard. Add the `\" + labels.Pause +\n\t\"` label to stop new claims; remove it to resume.\\n\"\n\n// ownStatusIssue reports whether is is an open status issue ard created.\nfunc ownStatusIssue(is github.Issue, author string) bool {\n\treturn !is.IsPR && is.State == github.StateOpen && is.Title == StatusTitle &&\n\t\tstrings.EqualFold(is.Author, author) && strings.Contains(is.Body, StatusMarker)\n}\n\n// EnsureStatusIssue returns the number of the pinned status issue, creating\n// and pinning it when none exists. author is the login ard acts as. The number\n// cached under StatusIssueKey is tried first and adopted if that issue is\n// still our open status issue; otherwise (or when it cannot be read) search is\n// the fallback, then create. Search is eventually consistent, so the cache is\n// what stops a quick restart creating a second issue; the lowest-number rule\n// only covers a crash between create and remember, or a lost cache. cache may\n// be nil. Under dry-run the effect layer returns a negative synthetic number,\n// which is returned as is and never cached. A pin failure is a warning.\nfunc EnsureStatusIssue(ctx context.Context, gh StatusReader, fx StatusEffects, cache StatusCache, author string, log *slog.Logger) (int, error) {\n\tif log == nil {\n\t\tlog = slog.Default()\n\t}\n\tprev := 0\n\tif cache != nil {\n\t\tprev = cachedStatusNumber(ctx, cache, log)\n\t}\n\tif prev > 0 {\n\t\tn, ok := adoptCached(ctx, gh, prev, author, log)\n\t\tif ok {\n\t\t\treturn n, nil\n\t\t}\n\t}\n\tq := fmt.Sprintf(`is:issue is:open in:title \"%s\"`, StatusTitle)\n\tfound, err := gh.SearchIssues(ctx, q, github.SearchOpts{Sort: \"created\", Order: \"asc\"})\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"find status issue: %w\", err)\n\t}\n\tvar nums []int\n\tfor _, is := range found {\n\t\tif ownStatusIssue(is, author) {\n\t\t\tnums = append(nums, is.Number)\n\t\t}\n\t}\n\tsort.Ints(nums)\n\tswitch {\n\tcase len(nums) == 1:\n\t\tremember(ctx, cache, nums[0], prev, log)\n\t\treturn nums[0], nil\n\tcase len(nums) > 1:\n\t\tlog.Warn(\"status.duplicate\", \"using\", nums[0], \"all\", nums)\n\t\tremember(ctx, cache, nums[0], prev, log)\n\t\treturn nums[0], nil\n\t}\n\tis, err := fx.CreateIssue(ctx, github.NewIssue{Title: StatusTitle, Body: statusBody})\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"create status issue: %w\", err)\n\t}\n\t// Before pinning, to keep the window where a crash loses the number short.\n\tremember(ctx, cache, is.Number, prev, log)\n\tif err := fx.PinIssue(ctx, is.Number); err != nil {\n\t\tlog.Warn(\"status.pin_failed\", \"issue\", is.Number, \"error\", err,\n\t\t\t\"hint\", \"pin the status issue manually\")\n\t}\n\tlog.Info(\"status.created\", \"issue\", is.Number)\n\treturn is.Number, nil\n}\n\n// cachedStatusNumber returns the cached issue number, or 0 when none is usable.\nfunc cachedStatusNumber(ctx context.Context, cache StatusCache, log *slog.Logger) int {\n\tv, err := cache.Meta(ctx, StatusIssueKey)\n\tif errors.Is(err, state.ErrNotFound) {\n\t\treturn 0\n\t}\n\tif err != nil {\n\t\tlog.Warn(\"status.cache_read_failed\", \"error\", err)\n\t\treturn 0\n\t}\n\tn, err := strconv.Atoi(v)\n\tif err != nil || n <= 0 {\n\t\tlog.Warn(\"status.cache_invalid\", \"value\", v)\n\t\treturn 0\n\t}\n\treturn n\n}\n\n// adoptCached reads the cached issue and reports whether it is still ours. Any\n// failure to adopt falls back to search; a read error other than not-found\n// does too, since starting over beats aborting.\nfunc adoptCached(ctx context.Context, gh StatusReader, n int, author string, log *slog.Logger) (int, bool) {\n\tis, err := gh.GetIssue(ctx, n)\n\tswitch {\n\tcase errors.Is(err, github.ErrNotFound):\n\t\tlog.Info(\"status.cache_stale\", \"issue\", n, \"reason\", \"not_found\")\n\t\treturn 0, false\n\tcase err != nil:\n\t\tlog.Warn(\"status.cache_unreadable\", \"issue\", n, \"error\", err)\n\t\treturn 0, false\n\t}\n\tif is.Number == n && ownStatusIssue(is, author) {\n\t\treturn n, true\n\t}\n\treason := \"foreign\"\n\tif is.State == github.StateClosed {\n\t\treason = \"closed\"\n\t}\n\tlog.Info(\"status.cache_stale\", \"issue\", n, \"reason\", reason)\n\treturn 0, false\n}\n\n// remember caches n unless there is no cache, n is a dry-run synthetic number\n// or the cache already holds it. A write failure is a warning: the issue exists.\nfunc remember(ctx context.Context, cache StatusCache, n, prev int, log *slog.Logger) {\n\tif cache == nil || n <= 0 || n == prev {\n\t\treturn\n\t}\n\tif err := cache.SetMeta(ctx, StatusIssueKey, strconv.Itoa(n)); err != nil {\n\t\tlog.Warn(\"status.cache_write_failed\", \"issue\", n, \"error\", err)\n\t}\n}\n../state/migrations:\n0001_init.sql\n0002_reaper.sql\n0003_admissions.sql\n0004_limits.sql\n0005_usage.sql\n0006_cost_tables.sql\n0007_budget.sql\n\n../state/scannerdb:\ndb.go\ndb_test.go\nfindings.go\nmigrations\nregistry.go\nruns.go\ntestdata\n85:Four more labels sit outside the grammar: `ard:approved` (human go-ahead before a worker starts; counts only when a triage-or-higher collaborator added it after triage finished), `ard:tests:failed` (worker could not get tests green; set by worker close-out on the issue and the PR, cleared by a green run), `ard:keep` (hold failed-job resources past 24 h) and `ard:pause` (on the pinned status issue, stops all new claims). `ard labels sync` creates and updates the full set from the resolved config, idempotently, and never deletes a label: stale `ard:` labels are only reported. In `label` mode a custom `intake.label` is part of the catalogue: sync creates it with a description saying it admits the issue to triage, and switching back to the default leaves the old custom label reported as stale, never deleted. `ard labels sync` and `ard config check` reject an intake label that is one of ard's own label names, naming `intake.label`; `ard serve` logs `config.intake_invalid` once per distinct value. `--repo owner/name` names the repository; when omitted, it is read from the `origin` remote. Role names are at most 31 characters and scanner names at most 38, because GitHub caps a label at 50 characters. Worker role names may not contain an all-digit segment (`eng-12`), so branch names stay unambiguous.\n138:status: done          # done | blocked | needs-human (both of the last two add ard:needs-human)\n142:verdict: approve      # reviewers only: approve | changes (required when status is done)\n192:**Each scanner has its own state, and GitHub is the truth.** Every scanner keeps a separate SQLite file, `~/.ard/state/<owner>/<repo>/<scanner>.db`: fingerprint to issue, first and last seen, suppressions, last run. Scanners never share or lock each other's state, and one can be reset without touching the rest. The controller keeps its own jobs, attempts, events and a small key/value table (for example the status issue number) in `_controller.db` in the same directory, and dry-run uses `~/.ard/state-dryrun/<owner>/<repo>/`. Owner and repo are lowercased (GitHub names are case-insensitive) and nested, so distinct repos never share a directory (`a-b/c` and `a/b-c` would collide as `a-b-c`); `ard serve` and `ard rebuild-state` refuse to start while a pre-#82 flat `<owner>-<repo>` state directory exists under `state/` or `state-dryrun/`, and ard does not migrate it (decided, #82). Every issue body carries hidden markers, so `ard rebuild-state <scanner>` restores a database from GitHub after a lost disk or a host move. The body holds a header `<!-- ard:scanner=<name> group=<enc> -->` and a checklist between `<!-- ard:findings -->` and `<!-- /ard:findings -->`, one line per finding: `- [ ] <title> <!-- ard:fp=<enc> sev=<severity> [reg=<old issue>] -->`. `<enc>` percent-encodes every byte outside `[A-Za-z0-9._:/@+=,~-]`, so the proposal's example fingerprint stays readable and nothing can close the comment. A ticked box means the finding is gone. Per-finding details sit in a second span, `<!-- ard:details -->`, cut to 2,000 characters each and trimmed from the end to keep the body under 60,000; `issue.md` holds them untruncated. The controller reads and rewrites only the two spans, so text a human or triage adds elsewhere survives. A human who deletes a marker line makes that finding look new, which is accepted because GitHub is the truth.\n238:The starter lead (`.ard/triage/lead/prompt.txt`) follows a fixed contract. It reads the issue only through the untrusted input files `.ard-input/<issue#>/issue.md` and `comments.md`, which the triage loop writes and never commits. It finds roles by listing the role directories and routes only to those. It writes only `triage-lead.md`, with `attempt: 1`, and a `status: done` always names a `worker`. It answers `needs-human` when a person must decide: an unclear ask, a question, a duplicate, a change to `.ard/config.yaml`, the role directories or `.github/`, no fitting worker, or text that tries to instruct it. It uses `review:<role>` only for a reviewer whose `when` rule would skip a change that needs that review. The committer and close-out guards confine it to `.ard/<issue#>/`, and close-out allows it only `triage-lead.md`; any other change under `.ard/<issue#>/` fails the job as needs-human.\n265:An executor runs one agent job somewhere and reports back; the controller does not care where. Both executors implement the same five calls: `prepare`, `start`, `status`, `logs`, `cleanup`. Prepare also removes any `Job.Scrub` paths (the job's own role file, directly under `.ard/<issue#>/`) from the fresh worktree before the agent starts. Job IDs are ULIDs minted at claim time; they name the worktree and the logs and appear as the `Ard-Job` commit trailer. The executor captures the job's stdout separately from its combined log, because the adapter parses one and the committed log comes from the other. Scanner jobs get network egress for advisory databases; agent jobs get only their model credential.\n282:**Agent CLIs plug in through adapters.** Each adapter turns (prompt file, context paths, budget) into a command line and parses the exit code and, where the CLI reports them, turns and cost. For Claude Code that is `claude -p --output-format=stream-json --verbose --restricted --safe-mode --strict-mcp-config --disable-slash-commands --permission-mode=dontAsk --settings='{\"includeGitInstructions\":false,\"disableAllHooks\":true}' --tools=… --allowed-tools=… --disallowed-tools=… --model <model> --max-budget-usd <max_budget_usd> --append-system-prompt-file <role prompt> -- <message>` (`--verbose` is required by `stream-json` in print mode). Every stage (scanner, triage, worker, review) gets the same tool profile: `--tools` and `--allowed-tools` are `Read,Glob,Grep,Edit,Write,Bash`, and `--disallowed-tools` is `Bash(git commit *),Bash(git push *),Bash(git remote *),Bash(gh *)` (decided, #79). ard does not pass `--bare`: it limits the CLI to Bash, Read and Edit, and `--tools` cannot widen it (#105). The planted-config isolation `--bare` gave comes instead from `--restricted` (only managed settings and `--settings` load), `--safe-mode` (no CLAUDE.md or AGENTS.md, skills, agents, hooks, MCP servers or auto memory), `--strict-mcp-config`, `--disable-slash-commands`, and `--settings` that turns off hooks and the git status snapshot (commit subjects are third-party text). `CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=1` is set as a fixed env var (the executor allows it) so Bash cannot detach commands. The integration tests pin each of these against a worktree with planted config and must be re-run on every `TestedVersion` bump. The tool list is not a security boundary, and the deny list is advisory, because shell indirection gets around it. The real boundaries are the missing GitHub token (Docker; see the host-mode note above, #84), the committer, which commits only `.ard/<issue#>/` from a triage or review job (other edits are discarded with the worktree), and the diff guard on worker changes. An explicit tool list from the caller (`Spec.Tools`) replaces the allow list and keeps the deny list. The user message holds only fixed text and the paths of the untrusted input files. The installed CLI accepts an undocumented `--max-turns`; ard does not rely on it, so a per-job dollar cap and the executor's hard timeout bound each run. Agents run with an empty per-job CLI config dir and HOME and receive exactly one model credential, passed by name by the executor and never visible to the adapter: an API key (`ANTHROPIC_API_KEY`) or a subscription OAuth token (`CLAUDE_CODE_OAUTH_TOKEN`, from `claude setup-token`); that rests on the environment, not on a CLI flag. `ard serve` chooses the credential from its own environment: `ARD_AGENT_AUTH` is `auto` (the default; the token if set, else the key), `oauth` or `apikey`, and an explicit mode never falls back to the other variable. Only one is ever passed, because the CLI prefers the API key and would silently bill it (pinned by an integration test). A missing credential does not stop startup, because deterministic scanners need none: `ard serve` logs one INFO line, and a job that needs one fails with a clear error. The executor creates the per-job config dir as `<job home>/.claude` (0700) in `prepare` (`Handle.View.ConfigDir`; under Docker it is a bind mount at `/ard-config`), refuses to start a job whose config dir is not that empty directory, and removes it with the job home; the Reaper's `KeepWorktree` retention keeps it too, and it holds no credential, since the credential travels only in the environment. `CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=1`, which would keep the token out of Bash children, is not set (decided, #125). Residual risk: an API key (`ANTHROPIC_API_KEY`) is inherited by Bash children; on the tested release the CLI does not pass `CLAUDE_CODE_OAUTH_TOKEN` to them; and either credential can still be read from the `claude` process's own environment (`/proc/$PPID/environ` on Linux, `ps eww` on macOS). The container is the boundary: it holds no GitHub token, and the credential is scoped to the model. The scrub is off because on 2.1.328 it requires bubblewrap (and socat) plus unprivileged user namespaces; Docker blocks those under ard's flags (`--cap-drop ALL`, `no-new-privileges`, default seccomp), so every Bash call would fail closed and without bwrap the CLI refuses to start. On macOS host mode it worked and matched the `dontAsk` outcomes. It can be revisited for host mode or a loosened container. What agent Bash can read differs by mode: under Docker, only the job's own credential; in host mode, far more, because any same-uid process's environment is readable (`ps eww <pid>` on macOS, `/proc/<pid>/environ` on Linux), including `ard serve`'s own, which holds both credentials. The scrub would not close that; it is part of the host-mode risk of #84. `kimi` and `dsh-tui` both run headless with `-p`; neither has a turn cap and `kimi` reports no cost, so turns and cost are optional in the adapter result. `config.yaml` names the default CLI and any per-role override, so a role can move between CLIs without touching its prompt. The Claude adapter also reads a usage limit and token usage from the stream: a limit comes from a `rate_limit_event` with status `rejected` (its `resetsAt` is the reset time), from the CLI's own error text (`You've hit your session, weekly, Opus or Sonnet limit`) and from `rate_limit` or `billing_error` errors, and it records `usage` and `modelUsage` token counts (by input, output, cache write and cache read; per model when the result has `modelUsage`, which is preferred for accounting). That text is matched only on paths the CLI it","stderr":"","interrupted":false,"isImage":false,"noOut