.StatusIssue = func() int { return -1 }\n229\t+\tbuf := capture(h)\n230\t+\th.eng.failNext(&ScanError{Exit: 1})\n231\t+\th.mustRun()\n232\t+\tif !strings.Contains(buf.String(), \"scanner.streak_notice\") {\n233\t+\t\tt.Errorf(\"notice not logged: %s\", buf)\n234\t+\t}\n235\t+\tif v, err := h.db.Meta(h.ctx, streakKey); err == nil && v != \"\" {\n236\t+\t\tt.Errorf(\"state written in dry-run: %q\", v)\n237\t+\t}\n238\t+}\n239\t+\n240\t+func TestStreakNoStatusIssue(t *testing.T) {\n241\t+\th := newHarness(t, nil)\n242\t+\th.eng.failNext(&ScanError{Exit: 1})\n243\t+\th.mustRun() // StatusIssue nil\n244\t+\tn := 0\n245\t+\th.p.StatusIssue = func() int { return n }\n246\t+\th.eng.failNext(&ScanError{Exit: 1})\n247\t+\th.mustRun() // still unknown\n248\t+\tif v, err := h.db.Meta(h.ctx, streakKey); err == nil && v != \"\" {\n249\t+\t\tt.Fatalf(\"state touched: %q\", v)\n250\t+\t}\n251\t+\tn = withStatus(t, h)\n252\t+\th.p.StatusIssue = func() int { return n }\n253\t+\th.eng.failNext(&ScanError{Exit: 1})\n254\t+\th.mustRun()\n255\t+\tif got := comments(t, h, n); len(got) != 1 {\n256\t+\t\tt.Fatalf(\"comments = %q\", got)\n257\t+\t}\n258\t+}\n259\t+\n260\t+type failingComments struct {\n261\t+\tEffects\n262\t+\tfail bool\n263\t+}\n264\t+\n265\t+func (f *failingComments) CreateComment(ctx context.Context, n int, body string) (github.Comment, error) {\n266\t+\tif f.fail {\n267\t+\t\treturn github.Comment{}, errors.New(\"github down\")\n268\t+\t}\n269\t+\treturn f.Effects.CreateComment(ctx, n, body)\n270\t+}\n271\t+\n272\t+func TestStreakPostFailure(t *testing.T) {\n273\t+\th := newHarness(t, nil)\n274\t+\tn := withStatus(t, h)\n275\t+\tfc := &failingComments{Effects: h.fx, fail: true}\n276\t+\th.p.Effects = fc\n277\t+\th.eng.failNext(&ScanError{Exit: 1})\n278\t+\tres, err := h.run()\n279\t+\tif err != nil || res.Outcome != OutcomeScanFailed {\n280\t+\t\tt.Fatalf(\"res = %+v, err = %v\", res, err)\n281\t+\t}\n282\t+\tif v, err := h.db.Meta(h.ctx, streakKey); err == nil && v != \