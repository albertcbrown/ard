+\n336\t+// streakKey is the scanner meta key holding the reason class of the open\n337\t+// failure streak that has been posted. Absent or empty = no open streak.\n338\t+const streakKey = \"failure_streak\"\n339\t+\n340\t+const maxClassLen = 64\n341\t+\n342\t+// classOf maps a recorded run to its streak effect. failing starts or\n343\t+// continues a streak with the given class; ok ends one; neither = neutral.\n344\t+// The class is a rule name or a fixed word, never finding text.\n345\t+func classOf(res RunResult) (class string, failing, ok bool) {\n346\t+\tswitch res.Outcome {\n347\t+\tcase OutcomeBackpressure:\n348\t+\t\treturn \"max_open\", true, false\n349\t+\tcase OutcomeScanFailed:\n350\t+\t\tif res.GuardRule != \"\" {\n351\t+\t\t\treturn sanitiseClass(res.GuardRule), true, false\n352\t+\t\t}\n353\t+\t\treturn \"scan_failed\", true, false\n354\t+\tcase OutcomeTimeout:\n355\t+\t\treturn \"scan_failed\", true, false\n356\t+\tcase OutcomeOK:\n357\t+\t\treturn \"\", false, true\n358\t+\t}\n359\t+\treturn \"\", false, false\n360\t+}\n361\t+\n362\t+// sanitiseClass keeps [A-Za-z0-9._:-], at most 64 characters.\n363\t+func sanitiseClass(s string) string {\n364\t+\tvar b strings.Builder\n365\t+\tfor _, r := range s {\n366\t+\t\tif b.Len() >= maxClassLen {\n367\t+\t\t\tbreak\n368\t+\t\t}\n369\t+\t\tswitch {\n370\t+\t\tcase r >= 'a' && r <= 'z', r >= 'A' && r <= 'Z', r >= '0' && r <= '9', r == '.', r == '_', r == ':', r == '-':\n371\t+\t\t\tb.WriteRune(r)\n372\t+\t\t}\n373\t+\t}\n374\t+\tif b.Len() == 0 {\n375\t+\t\treturn \"scan_failed\"\n376\t+\t}\n377\t+\treturn b.String()\n378\t+}\n379\t+\n380\t+func streakNotice(scanner, class string) string {\n381\t+\treturn fmt.Sprintf(\"Scanner `%s` is failing: `%s`. Its runs are not completing normally; see the controller log. One notice is posted per failure streak.\", scanner, class)\n382\t+}\n383\t+\n384\t+func streakRecovery(scanner string) string {\n385\t+\treturn fmt.Sprintf(\"Scanner `%s` recovered: its last run completed normally.\", scanner)\n386\t+}\n387\t+\n388\t+// noteRun posts one notice when a scanner's failure streak starts and one when\n389\t+// it ends. Errors are logged, never returned: a notice must not change the\n390\t+// run's result.\n391\t+func (p *Pipeline) noteRun(ctx context.Context, store Store, role config.Role, res RunResult) {\n392\t+\tlog := p.Log\n393\t+\tif log == nil {\n394\t+\t\treturn\n395\t+\t}\n396\t+\tlog = log.With(\"scanner\", role.Name)\n397\t+\tclass, failing, ok := classOf(res)\n398\t+\tif !failing && !ok {\n399\t+\t\treturn\n400\t+\t}\n401\t+\tctx = context.WithoutCancel(ctx)\n402\t+\topen, err := store.Meta(ctx, streakKey)\n403\t+\tif err != nil && !errors.Is(err, scannerdb.ErrNotFound) {\n404\t+\t\tlog.Error(\"scanner.streak_read_failed\", \"error\", err)\n405\t+\t\treturn\n406\t+\t}\n407\t+\tif failing && open != \"\" || ok && open == \"\" {\n408\t+\t\treturn\n409\t+\t}\n410\t+\tvar n int\n411\t+\tif p.StatusIssue != nil {\n412\t+\t\tn = p.StatusIssue()\n413\t+\t}\n414\t+\tif n == 0 {\n415\t+\t\tlog.Info(\"scanner.streak_unposted\", \"reason\", \"no status issue\", \"class\", class)\n416\t+\t\treturn\n417\t+\t}\n418\t+\tbody, next := streakRecovery(role.Name), \"\"\n419\t+\tif failing {\n420\t+\t\tbody, next = streakNotice(role.Name, class), class\n421\t+\t}\n422\t+\tif _, err := p.Effects.CreateComment(ctx, n, body); err != nil {\n423\t+\t\tlog.Error(\"scanner.streak_post_failed\", \"error\", err)\n424\t+\t\treturn\n425\t+\t}\n426\t+\tif p.Effects.DryRun() {\n427\t+\t\tlog.Info(\"scanner.streak_notice\", \"class\", class, \"recovered\", ok)\n428\t+\t\treturn // a dry run never claims a streak it did not post\n429\t+\t}\n430\t+\tif err := store.SetMeta(ctx, streakKey, next); err != nil {\n431\t+\t\tlog.Error(\"scanner.streak_state_failed\", \"error\", err)\n432\t+\t}\n433\t+}\n434\tdiff --git a/internal/scanner/streak_test.go b/internal/scanner/streak_test.go\n435\tnew file mode 100644\n436\tindex 0000000..9d481ea\n437\t--- /dev/null\n43