ScanError{Exit: 1})\n230\t+\th.mustRun()\n231\t+\tif !strings.Contains(buf.String(), \"scanner.streak_notice\") {\n232\t+\t\tt.Errorf(\"notice not logged: %s\", buf)\n233\t+\t}\n234\t+\tif v, err := h.db.Meta(h.ctx, streakKey); err == nil && v != \"\" {\n235\t+\t\tt.Errorf(\"state written in dry-run: %q\", v)\n236\t+\t}\n237\t+}\n238\t+\n239\t+func TestStreakNoStatusIssue(t *testing.T) {\n240\t+\th := newHarness(t, nil)\n241\t+\th.eng.failNext(&ScanError{Exit: 1})\n242\t+\th.mustRun() // StatusIssue nil\n243\t+\tn := 0\n244\t+\th.p.StatusIssue = func() int { return n }\n245\t+\th.eng.failNext(&ScanError{Exit: 1})\n246\t+\th.mustRun() // still unknown\n247\t+\tif v, err := h.db.Meta(h.ctx, streakKey); err == nil && v != \"\" {\n248\t+\t\tt.Fatalf(\"state touched: %q\", v)\n249\t+\t}\n250\t+\tn = withStatus(t, h)\n251\t+\th.p.StatusIssue = func() int { return n }\n252\t+\th.eng.failNext(&ScanError{Exit: 1})\n253\t+\th.mustRun()\n254\t+\tif got := comments(t, h, n); len(got) != 1 {\n255\t+\t\tt.Fatalf(\"comments = %q\", got)\n256\t+\t}\n257\t+}\n258\t+\n259\t+type failingComments struct {\n260\t+\tEffects\n261\t+\tfail bool\n262\t+}\n263\t+\n264\t+func (f *failingComments) CreateComment(ctx context.Context, n int, body string) (github.Comment, error) {\n265\t+\tif f.fail {\n266\t+\t\treturn github.Comment{}, errors.New(\"github down\")\n267\t+\t}\n268\t+\treturn f.Effects.CreateComment(ctx, n, body)\n269\t+}\n270\t+\n271\t+func TestStreakPostFailure(t *testing.T) {\n272\t+\th := newHarness(t, nil)\n273\t+\tn := withStatus(t, h)\n274\t+\tfc := &failingComments{Effects: h.fx, fail: true}\n275\t+\th.p.Effects = fc\n276\t+\th.eng.failNext(&ScanError{Exit: 1})\n277\t+\tres, err := h.run()\n278\t+\tif err != nil || res.Outcome != OutcomeScanFailed {\n279\t+\t\tt.Fatalf(\"res = %+v, err = %v\", res, err)\n280\t+\t}\n281\t+\tif v, err := h.db.Meta(h.ctx, streakKey); err == nil && v != \"\" {\n282\t+\t\tt.Fatalf(\"state set after failed post: %q\", v)\n283\t+\t}\n284\t+\tfc.fai