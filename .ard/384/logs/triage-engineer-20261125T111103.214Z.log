{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013dwXhySbAoAU8iN6PNAo9A","type":"tool_result","content":"1\tpackage closeout\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"time\"\n6\t\n7\t\t\"github.com/albertcbrown/ard/internal/labels\"\n8\t)\n9\t\n10\t// Outcome is what close-out decided about a job.\n11\ttype Outcome string\n12\t\n13\tconst (\n14\t\tOutcomeDone       Outcome = \"done\"\n15\t\tOutcomeChanges    Outcome = \"changes\"\n16\t\tOutcomeNeedsHuman Outcome = \"needs-human\"\n17\t\tOutcomeFailed     Outcome = \"failed\"\n18\t\t// OutcomeStale is a review whose verdict was approve but whose PR gained\n19\t\t// code after the reviewed commit. The review is posted, no pass label is\n20\t\t// set and the request label stays, so the review runs again. It is also a\n21\t\t// review whose PR was merged or closed, or whose branch was deleted, before\n22\t\t// close-out: nothing is committed, no failure is recorded, and the request\n23\t\t// label comes off with :running (ReviewPlan.PRGone says why).\n24\t\tOutcomeStale Outcome = \"stale\"\n25\t\t// OutcomeRetry is a failure with a named transient cause. The job hands\n26\t\t// off to one automatic retry: it gets no ard:executor:failed and keeps its\n27\t\t// request label, so the next claim runs it again as a new job.\n28\t\tOutcomeRetry Outcome = \"retry\"\n29\t\t// OutcomeLimited is a stop at a subscription usage limit. Its labels are\n30\t\t// those of OutcomeRetry: no ard:executor:failed, the request label stays,\n31\t\t// and the issue is claimed again once the pool's pause for the limit ends.\n32\t\t// It neither uses up nor grants the automatic retry.\n33\t\tOutcomeLimited Outcome = \"usage-limit\"\n34\t)\n35\t\n36\t// Label is a label name with the issue or PR number it goes on.\n37\ttype Label struct {\n38\t\tNumber int\n39\t\tName   string\n40\t}\n41\t\n42\t// FileRef is one file of the commit set. Staged is the host path of the\n43\t// cleaned bytes; Resume reads only that, never the worktree.\n44\ttype FileRef struct {\n45\t\tPath   string // repo-relative, slash form: .ard/<n>/<stage>-<role>.md\n46\t\tStaged string\n47\t\tDelete bool\n48\t}\n49\t\n50\t// Plan is everything close-out will do, decided before any side effect.\n51\ttype Plan struct {\n52\t\tOutcome     Outcome\n53\t\tStatus      string // raw status of the role file, for the comment header\n54\t\tReason      string // failure or withhold reason; never secret text\n55\t\tRequests    []Label\n56\t\tTerminal    []Label // added in order\n57\t\tRemove      []Label // removed in order; Running is last\n58\t\tDeferred    []NextReq\n59\t\tWorker      string // the lead's validated worker choice, for the Phase 1 gate\n60\t\tSkipped     []Skip\n61\t\tFiles       []FileRef\n62\t\tLogWithheld bool\n63\t\tLogPath     string // committed log path when it is in Files\n64\t\t// ExtraLogPaths are the committed paths of Job.ExtraLogs, in order.\n65\t\tExtraLogPaths []string\n66\t\tSummary       string // redacted role file summary, for the comment\n67\t\t// Review is set for a review that reached a verdict: close-out posts one\n68\t\t// PR review instead of a plain comment.\n69\t\tReview   *ReviewPlan\n70\t\tRolePath string // committed role file path, \"\" when none\n71\t\n72\t\t// Tail is the last lines of the redacted log, for a failed or retry\n73\t\t// comment. It is \"\" when there is no log, when the log was withheld, or\n74\t\t// when the tail did not pass a second redaction (TailWithheld).\n75\t\tTail         string\n76\t\tTailWithheld bool\n77\t\t// KeepUntil is when the resources of a failed or retry job may be removed\n78\t\t// (zero on records from before the Reaper: close-out then uses 24 h).\n79\t\tKeepUntil time.Time\n80\t}\n81\t\n82\t// target returns the number labels for this job go on: the PR for a review,\n83\t// the issue otherwise.\n84\tfunc (j Job) target() int {\n85\t\tif j.Stage == StageReview {\n86\t\t\treturn j.PR\n87\t\t}\n88\t\treturn j.Issue\n89\t}\n90\t\n91\t// Build maps a validated role file to a plan, with no files. It is pure.\n92\tfunc Build(j Job, rf RoleFile, rs RoleSet) Plan {\n93\t\tp := Plan{Status: rf.Status}\n94\t\tn := j.target()\n95\t\trun := Label{n, labels.Running(labels.Stage(j.Stage), j.Role)}\n96\t\tswitch {\n97\t\tcase rf.Status != StatusDone:\n98\t\t\tp.Outcome = OutcomeNeedsHuman\n99\t\t\tp.Terminal = []Label{{n, labels.NeedsHuman}}\n100\t\t\tp.Remove = []Label{run}\n101\t\tcase j.Stage == StageReview && rf.Verdict == VerdictChanges:\n102\t\t\tp.Outcome = OutcomeChanges\n103\t\t\tp.Terminal = []Label{{n, labels.Changes(j.Role)}}\n104\t\t\tp.Remove = []Label{{n, labels.Done(labels.Stage(j.Stage), j.Role)}, run}\n105\t\tcase j.Stage == StageReview && rf.Verdict == VerdictApprove && (j.Review == nil || j.Review.HeadMoved):\n106\t\t\t// An approve of a head that has since gained code is not a pass. With\n107\t\t\t// no review context (a Reaper close-out after a restart) the head is\n108\t\t\t// unknown, so it is treated as moved.\n109\t\t\tp.Outcome = OutcomeStale\n110\t\t\tp.Remove = []Label{run}\n111\t\tcase j.Stage == StageWorker:\n112\t\t\tp = buildWorker(j, rf, rs)\n113\t\tdefault:\n114\t\t\tp.Outcome = OutcomeDone\n115\t\t\tp.Terminal = []Label{{n, labels.Done(labels.Stage(j.Stage), j.Role)}}\n116\t\t\tif j.Stage == StageReview {\n117\t\t\t\tp.Remove = append(p.Remove, Label{n, labels.Changes(j.Role)})\n118\t\t\t}\n119\t\t\tif j.Stage == StageTriage && j.Role == \"lead\" {\n120\t\t\t\tp.Remove = append(p.Remove, Label{n, labels.Pending})\n121\t\t\t}\n122\t\t\tp.Remove = append(p.Remove, run)\n123\t\t\tnow, deferred, skipped := resolveNext(j, rf.Next, rs)\n124\t\t\tp.Deferred, p.Skipped = deferred, skipped\n125\t\t\tfor _, r := range now {\n126\t\t\t\tnum := j.Issue\n127\t\t\t\tif r.Stage == StageReview {\n128\t\t\t\t\tnum = j.PR\n129\t\t\t\t}\n130\t\t\t\tp.Requests = append(p.Requests, Label{num, labels.Request(labels.Stage(r.Stage), r.Role)})\n131\t\t\t}\n132\t\t\tif rf.Worker != \"\" {\n133\t\t\t\tif hasRole(rs, StageWorker, rf.Worker) {\n134\t\t\t\t\tp.Worker = rf.Worker\n135\t\t\t\t} else {\n136\t\t\t\t\tp.Skipped = append(p.Skipped, Skip{\"worker:\" + clip(rf.Worker, 60), \"no such role\"})\n137\t\t\t\t}\n138\t\t\t}\n139\t\t}\n140\t\treturn p\n141\t}\n142\t\n143\t// failedPlan is the plan for a job that did not produce a usable result.\n144\tfunc failedPlan(j Job, reason string, logWithheld bool) Plan {\n145\t\tn := j.target()\n146\t\tp := Plan{Outcome: OutcomeFailed, Reason: reason, LogWithheld: logWithheld,\n147\t\t\tTerminal: []Label{{n, labels.ExecutorFailed}},\n148\t\t\tRemove:   []Label{{n, labels.Running(labels.Stage(j.Stage), j.Role)}}}\n149\t\tif logWithheld {\n150\t\t\tp.Terminal = append(p.Terminal, Label{n, labels.NeedsHuman})\n151\t\t}\n152\t\treturn p\n153\t}\n154\t\n155\t// stalePRPlan is the plan for a review whose PR is gone (merged, closed, or its\n156\t// branch deleted). It keeps the review so it is still posted best-effort, but\n157\t// commits nothing and sets no label but removing :running.\n158\tfunc stalePRPlan(p Plan, j Job, why string) Plan {\n159\t\trp := *p.Review\n160\t\trp.PRGone = why\n161\t\treturn Plan{Outcome: OutcomeStale, Status: p.Status, Reason: \"pr gone: \" + why, Summary: p.Summary,\n162\t\t\tReview: &rp, Tail: p.Tail, TailWithheld: p.TailWithheld, KeepUntil: p.KeepUntil,\n163\t\t\tRemove: []Label{{j.target(), labels.Running(labels.Stage(j.Stage), j.Role)}}}\n164\t}\n165\t\n166\t// retryPlan is the plan for a job that failed for a transient cause and hands\n167\t// off to one automatic retry. It removes only :running and leaves the request\n168\t// label alone: a human who removed it to cancel stays cancelled.\n169\tfunc retryPlan(j Job, reason string) Plan {\n170\t\tn := j.target()\n171\t\tst := labels.Stage(j.Stage)\n172\t\treturn Plan{Outcome: OutcomeRetry, Reason: reason,\n173\t\t\tRemove: []Label{{n, labels.Running(st, j.Role)}}}\n174\t}\n175\t\n176\t// limitedPlan is the plan for a job that stopped at a usage limit. It has\n177\t// retryPlan's labels: it removes only :running, leaves the request label alone\n178\t// and adds no terminal label. What differs is the state change (FailLimited)\n179\t// and that it does not touch the automatic retry.\n180\tfunc limitedPlan(j Job, reason string) Plan {\n181\t\tp := retryPlan(j, reason)\n182\t\tp.Outcome = OutcomeLimited\n183\t\treturn p\n184\t}\n185\t\n186\t// needsHumanPlan is the plan for a job held back by the secret scan.\n187\tfunc needsHumanPlan(j Job, status, reason string) Plan {\n188\t\tn := j.target()\n189\t\treturn Plan{Outcome: OutcomeNeedsHuman, Status: status, Reason: reason, LogWithheld: false,\n190\t\t\tTerminal: []Label{{n, labels.NeedsHuman}},\n191\t\t\tRemove:   []Label{{n, labels.Running(labels.Stage(j.Stage), j.Role)}}}\n192\t}\n193\t\n194\tfunc (j Job) validate() error {\n195\t\tswitch j.Stage {\n196\t\tcase StageTriage, StageWorker, StageReview:\n197\t\tdefault:\n198\t\t\treturn fmt.Errorf(\"closeout job %s: stage %q is not triage, worker or review\", j.ID, j.Stage)\n199\t\t}\n200\t\tif j.ID == \"\" || j.Role == \"\" || j.Issue == 0 {\n201\t\t\treturn fmt.Errorf(\"closeout job %q: id, role and issue are required\", j.ID)\n202\t\t}\n203\t\tif j.Cause.Kind != \"\" {\n204\t\t\t// A job that ended for a known cause commits only its log: it needs\n205\t\t\t// neither a base commit nor a branch (an empty branch puts the log on\n206\t\t\t// main under .ard/<issue#>/logs/).\n207\t\t\treturn nil\n208\t\t}\n209\t\tif j.ExitCode == 0 && j.BaseSHA == \"\" {\n210\t\t\treturn fmt.Errorf(\"closeout job %s: BaseSHA is required to find the changed files\", j.ID)\n211\t\t}\n212\t\tif j.Stage == StageReview && j.PR == 0 {\n213\t\t\treturn fmt.Errorf(\"closeout job %s: a review needs a PR\", j.ID)\n214\t\t}\n215\t\t// A worker that stops before its first push has no branch: its role file\n216\t\t// and log go to main, as triage's do.\n217\t\tif j.Stage == StageReview && j.Branch == \"\" {\n218\t\t\treturn fmt.Errorf(\"closeout job %s: a review job needs a branch\", j.ID)\n219\t\t}\n220\t\treturn nil\n221\t}\n222\t"}]},"parent_tool_use_id":null,"session_id":"6fb74eff-9d1e-4e23-8bf6-a73511888174","uuid":"be590344-3b9f-4d26-ad09-98fc9b8efb45","timestamp":"2026-11-25T11:11:11.718Z","tool_use_result":{"type":"text","file":{"filePath":"/work/internal/closeout/plan.go","content":"package closeout\n\nimport (\n\t\"fmt\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/labels\"\n)\n\n// Outcome is what close-out decided about a job.\ntype Outcome string\n\nconst (\n\tOutcomeDone       Outcome = \"done\"\n\tOutcomeChanges    Outcome = \"changes\"\n\tOutcomeNeedsHuman Outcome = \"needs-human\"\n\tOutcomeFailed     Outcome = \"failed\"\n\t// OutcomeStale is a review whose verdict was approve but whose PR gained\n\t// code after the reviewed commit. The review is posted, no pass label is\n\t// set and the request label stays, so the review runs again. It is also a\n\t// review whose PR was merged or closed, or whose branch was deleted, before\n\t// close-out: nothing is committed, no failure is recorded, and the request\n\t// label comes off with :running (ReviewPlan.PRGone says why).\n\tOutcomeStale Outcome = \"stale\"\n\t// OutcomeRetry is a failure with a named transient cause. The job hands\n\t// off to one automatic retry: it gets no ard:executor:failed and keeps its\n\t// request label, so the next claim runs it again as a new job.\n\tOutcomeRetry Outcome = \"retry\"\n\t// OutcomeLimited is a stop at a subscription usage limit. Its labels are\n\t// those of OutcomeRetry: no ard:executor:failed, the request label stays,\n\t// and the issue is claimed again once the pool's pause for the limit ends.\n\t// It neither uses up nor grants the automatic retry.\n\tOutcomeLimited Outcome = \"usage-limit\"\n)\n\n// Label is a label name with the issue or PR number it goes on.\ntype Label struct {\n\tNumber int\n\tName   string\n}\n\n// FileRef is one file of the commit set. Staged is the host path of the\n// cleaned bytes; Resume reads only that, never the worktree.\ntype FileRef struct {\n\tPath   string // repo-relative, slash form: .ard/<n>/<stage>-<role>.md\n\tStaged string\n\tDelete bool\n}\n\n// Plan is everything close-out will do, decided before any side effect.\ntype Plan struct {\n\tOutcome     Outcome\n\tStatus      string // raw status of the role file, for the comment header\n\tReason      string // failure or withhold reason; never secret text\n\tRequests    []Label\n\tTerminal    []Label // added in order\n\tRemove      []Label // removed in order; Running is last\n\tDeferred    []NextReq\n\tWorker      string // the lead's validated worker choice, for the Phase 1 gate\n\tSkipped     []Skip\n\tFiles       []FileRef\n\tLogWithheld bool\n\tLogPath     string // committed log path when it is in Files\n\t// ExtraLogPaths are the committed paths of Job.ExtraLogs, in order.\n\tExtraLogPaths []string\n\tSummary       string // redacted role file summary, for the comment\n\t// Review is set for a review that reached a verdict: close-out posts one\n\t// PR review instead of a plain comment.\n\tReview   *ReviewPlan\n\tRolePath string // committed role file path, \"\" when none\n\n\t// Tail is the last lines of the redacted log, for a failed or retry\n\t// comment. It is \"\" when there is no log, when the log was withheld, or\n\t// when the tail did not pass a second redaction (TailWithheld).\n\tTail         string\n\tTailWithheld bool\n\t// KeepUntil is when the resources of a failed or retry job may be removed\n\t// (zero on records from before the Reaper: close-out then uses 24 h).\n\tKeepUntil time.Time\n}\n\n// target returns the number labels for this job go on: the PR for a review,\n// the issue otherwise.\nfunc (j Job) target() int {\n\tif j.Stage == StageReview {\n\t\treturn j.PR\n\t}\n\treturn j.Issue\n}\n\n// Build maps a validated role file to a plan, with no files. It is pure.\nfunc Build(j Job, rf RoleFile, rs RoleSet) Plan {\n\tp := Plan{Status: rf.Status}\n\tn := j.target()\n\trun := Label{n, labels.Running(labels.Stage(j.Stage), j.Role)}\n\tswitch {\n\tcase rf.Status != StatusDone:\n\t\tp.Outcome = OutcomeNeedsHuman\n\t\tp.Terminal = []Label{{n, labels.NeedsHuman}}\n\t\tp.Remove = []Label{run}\n\tcase j.Stage == StageReview && rf.Verdict == VerdictChanges:\n\t\tp.Outcome = OutcomeChanges\n\t\tp.Terminal = []Label{{n, labels.Changes(j.Role)}}\n\t\tp.Remove = []Label{{n, labels.Done(labels.Stage(j.Stage), j.Role)}, run}\n\tcase j.Stage == StageReview && rf.Verdict == VerdictApprove && (j.Review == nil || j.Review.HeadMoved):\n\t\t// An approve of a head that has since gained code is not a pass. With\n\t\t// no review context (a Reaper close-out after a restart) the head is\n\t\t// unknown, so it is treated as moved.\n\t\tp.Outcome = OutcomeStale\n\t\tp.Remove = []Label{run}\n\tcase j.Stage == StageWorker:\n\t\tp = buildWorker(j, rf, rs)\n\tdefault:\n\t\tp.Outcome = OutcomeDone\n\t\tp.Terminal = []Label{{n, labels.Done(labels.Stage(j.Stage), j.Role)}}\n\t\tif j.Stage == StageReview {\n\t\t\tp.Remove = append(p.Remove, Label{n, labels.Changes(j.Role)})\n\t\t}\n\t\tif j.Stage == StageTriage && j.Role == \"lead\" {\n\t\t\tp.Remove = append(p.Remove, Label{n, labels.Pending})\n\t\t}\n\t\tp.Remove = append(p.Remove, run)\n\t\tnow, deferred, skipped := resolveNext(j, rf.Next, rs)\n\t\tp.Deferred, p.Skipped = deferred, skipped\n\t\tfor _, r := range now {\n\t\t\tnum := j.Issue\n\t\t\tif r.Stage == StageReview {\n\t\t\t\tnum = j.PR\n\t\t\t}\n\t\t\tp.Requests = append(p.Requests, Label{num, labels.Request(labels.Stage(r.Stage), r.Role)})\n\t\t}\n\t\tif rf.Worker != \"\" {\n\t\t\tif hasRole(rs, StageWorker, rf.Worker) {\n\t\t\t\tp.Worker = rf.Worker\n\t\t\t} else {\n\t\t\t\tp.Skipped = append(p.Skipped, Skip{\"worker:\" + clip(rf.Worker, 60), \"no such role\"})\n\t\t\t}\n\t\t}\n\t}\n\treturn p\n}\n\n// failedPlan is the plan for a job that did not produce a usable result.\nfunc failedPlan(j Job, reason string, logWithheld bool) Plan {\n\tn := j.target()\n\tp := Plan{Outcome: OutcomeFailed, Reason: reason, LogWithheld: logWithheld,\n\t\tTerminal: []Label{{n, labels.ExecutorFailed}},\n\t\tRemove:   []Label{{n, labels.Running(labels.Stage(j.Stage), j.Role)}}}\n\tif logWithheld {\n\t\tp.Terminal = append(p.Terminal, Label{n, labels.NeedsHuman})\n\t}\n\treturn p\n}\n\n// stalePRPlan is the plan for a review whose PR is gone (merged, closed, or its\n// branch deleted). It keeps the review so it is still posted best-effort, but\n// commits nothing and sets no label but removing :running.\nfunc stalePRPlan(p Plan, j Job, why string) Plan {\n\trp := *p.Review\n\trp.PRGone = why\n\treturn Plan{Outcome: OutcomeStale, Status: p.Status, Reason: \"pr gone: \" + why, Summary: p.Summary,\n\t\tReview: &rp, Tail: p.Tail, TailWithheld: p.TailWithheld, KeepUntil: p.KeepUntil,\n\t\tRemove: []Label{{j.target(), labels.Running(labels.Stage(j.Stage), j.Role)}}}\n}\n\n// retryPlan is the plan for a job that failed for a transient cause and hands\n// off to one automatic retry. It removes only :running and leaves the request\n// label alone: a human who removed it to cancel stays cancelled.\nfunc retryPlan(j Job, reason string) Plan {\n\tn := j.target()\n\tst := labels.Stage(j.Stage)\n\treturn Plan{Outcome: OutcomeRetry, Reason: reason,\n\t\tRemove: []Label{{n, labels.Running(st, j.Role)}}}\n}\n\n// limitedPlan is the plan for a job that stopped at a usage limit. It has\n// retryPlan's labels: it removes only :running, leaves the request label alone\n// and adds no terminal label. What differs is the state change (FailLimited)\n// and that it does not touch the automatic retry.\nfunc limitedPlan(j Job, reason string) Plan {\n\tp := retryPlan(j, reason)\n\tp.Outcome = OutcomeLimited\n\treturn p\n}\n\n// needsHumanPlan is the plan for a job held back by the secret scan.\nfunc needsHumanPlan(j Job, status, reason string) Plan {\n\tn := j.target()\n\treturn Plan{Outcome: OutcomeNeedsHuman, Status: status, Reason: reason, LogWithheld: false,\n\t\tTerminal: []Label{{n, labels.NeedsHuman}},\n\t\tRemove:   []Label{{n, labels.Running(labels.Stage(j.Stage), j.Role)}}}\n}\n\nfunc (j Job) validate() error {\n\tswitch j.Stage {\n\tcase StageTriage, StageWorker, StageReview:\n\tdefault:\n\t\treturn fmt.Errorf(\"closeout job %s: stage %q is not triage, worker or review\", j.ID, j.Stage)\n\t}\n\tif j.ID == \"\" || j.Role == \"\" || j.Issue == 0 {\n\t\treturn fmt.Errorf(\"closeout job %q: id, role and issue are required\", j.ID)\n\t}\n\tif j.Cause.Kind != \"\" {\n\t\t// A job that ended for a known cause commits only its log: it needs\n\t\t// neither a base commit nor a branch (an empty branch puts the log on\n\t\t// main under .ard/<issue#>/logs/).\n\t\treturn nil\n\t}\n\tif j.ExitCode == 0 && j.BaseSHA == \"\" {\n\t\treturn fmt.Errorf(\"closeout job %s: BaseSHA is required to find the changed files\", j.ID)\n\t}\n\tif j.Stage == StageReview && j.PR == 0 {\n\t\treturn fmt.Errorf(\"closeout job %s: a review needs a PR\", j.ID)\n\t}\n\t// A worker that stops before its first push has no branch: its role file\n\t// and log go to main, as triage's do.\n\tif j.Stage == StageReview && j.Branch == \"\" {\n\t\treturn fmt.Errorf(\"closeout job %s: a review job needs a branch\", j.ID)\n\t}\n\treturn nil\n}\n","numLines":222,"startLine":1,"totalLines":222}},"tool_result_meta":[{"id":"toolu_013dwXhySbAoAU8iN6PNAo9A","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
