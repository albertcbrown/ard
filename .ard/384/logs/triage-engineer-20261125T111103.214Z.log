eadable after redaction\")\n\tdefault:\n\t\tplan = Build(j, rf, d.Roles)\n\t\tif j.Stage == StageReview && (plan.Outcome == OutcomeDone || plan.Outcome == OutcomeChanges || plan.Outcome == OutcomeStale) {\n\t\t\tfindings, _, _ = aidAdjust(j.Review, rf.Verdict, findings)\n\t\t\tplan.Review = reviewPlan(j, rf.Verdict, downgraded, findings)\n\t\t\tplan.Review.AidNote = aidNote\n\t\t}\n\t\tif logWithheld {\n\t\t\tplan = needsHumanPlan(j, rf.Status, \"\")\n\t\t}\n\t\tplan.Summary = summary\n\t\tif roleSeen {\n\t\t\tplan.RolePath = rolePath\n\t\t}\n\t}\n\tif logWithheld {\n\t\tplan.LogWithheld = true\n\t\tif plan.Reason != \"\" {\n\t\t\tplan.Reason += \"; \"\n\t\t}\n\t\tplan.Reason += \"log withheld: \" + logReason\n\t}\n\tif logRef != nil {\n\t\tplan.LogPath = logRef.Path\n\t}\n\tif plan.Outcome == OutcomeFailed || plan.Outcome == OutcomeRetry || plan.Outcome == OutcomeLimited {\n\t\t// The evidence stays for 24 h; the comment says until when and shows\n\t\t// the log tail (already redacted, re-scanned and capped).\n\t\tplan.KeepUntil = d.now().Add(failedKeep)\n\t\tif j.LogPath != \"\" {\n\t\t\tplan.Tail, plan.TailWithheld = tail, tail == \"\"\n\t\t}\n\t}\n\t// 5. The controller's own usage record, for every outcome. It bypasses\n\t// checkWrites: no role may write this path.\n\turef, err := stageUsage(stage, j, n, plan, d.now())\n\tif err != nil {\n\t\treturn Record{}, err\n\t}\n\tfiles = append(files, uref)\n\tsort.SliceStable(files, func(a, b int) bool { return files[a].Path < files[b].Path })\n\tplan.Files = files\n\tplan.ExtraLogPaths = extraPaths\n\treturn Record{Version: recordVersion, Phase: PhasePrepared, Job: j, Plan: plan}, nil\n}\n\nfunc verdictWord(err error) string {\n\tif err != nil {\n\t\treturn \"could not run on\"\n\t}\n\treturn \"flagged\"\n}\n\nfunc ruleList(fs []redact.Finding) string {\n\tseen := map[string]bool{}\n\tvar ids []string\n\tfor _, f := range fs {\n\t\tif !seen[f.Rule] {\n\t\t\tseen[f.Rule] = true\n\t\t\tids = append(ids, f.Rule)\n\t\t}\