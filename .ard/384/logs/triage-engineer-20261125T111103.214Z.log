{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NvUb7qFx4h9hsTdA4hN3QS","type":"tool_result","content":"1\tpackage closeout\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"strings\"\n6\t\n7\t\t\"github.com/albertcbrown/ard/internal/github\"\n8\t\t\"github.com/albertcbrown/ard/internal/labels\"\n9\t)\n10\t\n11\tconst (\n12\t\tmaxSummaryRunes = 4000\n13\t\tmaxReasonRunes  = 300\n14\t\tmarkerPrefix    = \"<!-- ard:closeout job=\"\n15\t)\n16\t\n17\t// marker is the hidden first line of the close-out comment. Resume looks for\n18\t// it so a replay never posts a second comment.\n19\tfunc marker(jobID string, attempt int) string {\n20\t\treturn fmt.Sprintf(\"%s%s attempt=%d -->\", markerPrefix, jobID, attempt)\n21\t}\n22\t\n23\tfunc markerFor(jobID string) string { return markerPrefix + jobID + \" \" }\n24\t\n25\t// Sanitize makes agent text safe to post: it cannot forge an ard marker\n26\t// (<!-- ard:closeout, ard:status, ard:fp) and cannot ping anyone. The worker\n27\t// loop uses it for the PR body.\n28\tfunc Sanitize(s string) string { return sanitize(s) }\n29\t\n30\t// sanitize is Sanitize.\n31\tfunc sanitize(s string) string {\n32\t\ts = strings.ReplaceAll(s, \"<!--\", \"&lt;!--\")\n33\t\tvar b strings.Builder\n34\t\trs := []rune(s)\n35\t\tfor i, r := range rs {\n36\t\t\tb.WriteRune(r)\n37\t\t\tif r == '@' && i+1 < len(rs) && isAlnum(rs[i+1]) {\n38\t\t\t\tb.WriteRune('\u200b')\n39\t\t\t}\n40\t\t}\n41\t\treturn b.String()\n42\t}\n43\t\n44\tfunc isAlnum(r rune) bool {\n45\t\treturn r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || r >= '0' && r <= '9'\n46\t}\n47\t\n48\t// codeSpan renders s on one line inside backticks, cut to max runes.\n49\tfunc codeSpan(s string, max int) string {\n50\t\ts = strings.Join(strings.Fields(strings.ReplaceAll(s, \"`\", \"'\")), \" \")\n51\t\tif r := []rune(s); len(r) > max {\n52\t\t\ts = string(r[:max-1]) + \"…\"\n53\t\t}\n54\t\treturn \"`\" + sanitize(s) + \"`\"\n55\t}\n56\t\n57\t// cutSummary cuts s to maxSummaryRunes at a line end.\n58\tfunc cutSummary(s string) string {\n59\t\tr := []rune(s)\n60\t\tif len(r) <= maxSummaryRunes {\n61\t\t\treturn s\n62\t\t}\n63\t\tcut := string(r[:maxSummaryRunes])\n64\t\tif i := strings.LastIndex(cut, \"\\n\"); i > 0 {\n65\t\t\tcut = cut[:i]\n66\t\t}\n67\t\treturn strings.TrimRight(cut, \"\\n\") + \"\\n… (truncated; full text in the committed file)\"\n68\t}\n69\t\n70\tfunc headerWord(p Plan) string {\n71\t\tswitch p.Outcome {\n72\t\tcase OutcomeNeedsHuman:\n73\t\t\tif p.Status == StatusBlocked {\n74\t\t\t\treturn \"blocked\"\n75\t\t\t}\n76\t\t\treturn \"needs-human\"\n77\t\tcase OutcomeRetry:\n78\t\t\treturn \"retrying\"\n79\t\tcase OutcomeLimited:\n80\t\t\treturn \"usage limit\"\n81\t\tdefault:\n82\t\t\treturn string(p.Outcome)\n83\t\t}\n84\t}\n85\t\n86\t// fenceFor returns a code fence one backtick longer than the longest backtick\n87\t// run in s, and at least three, so s cannot close it.\n88\tfunc fenceFor(s string) string {\n89\t\tlongest, run := 0, 0\n90\t\tfor _, r := range s {\n91\t\t\tif r == '`' {\n92\t\t\t\trun++\n93\t\t\t\tlongest = max(longest, run)\n94\t\t\t} else {\n95\t\t\t\trun = 0\n96\t\t\t}\n97\t\t}\n98\t\treturn strings.Repeat(\"`\", max(3, longest+1))\n99\t}\n100\t\n101\t// evidenceLines are the extra lines of a failed or retry comment: what will\n102\t// happen next, the log tail and how long the evidence is kept. Host paths are\n103\t// never printed; they would reveal the user's home directory.\n104\tfunc evidenceLines(r Record) (before []string, tail string) {\n105\t\tp := r.Plan\n106\t\tif p.Outcome != OutcomeFailed && p.Outcome != OutcomeRetry && p.Outcome != OutcomeLimited {\n107\t\t\treturn nil, \"\"\n108\t\t}\n109\t\tif p.Outcome == OutcomeRetry {\n110\t\t\tbefore = append(before, \"Retrying once as a new job.\")\n111\t\t}\n112\t\tif p.Outcome == OutcomeLimited {\n113\t\t\tbefore = append(before, limitLine(r.Job.Cause))\n114\t\t}\n115\t\tswitch {\n116\t\tcase p.Tail != \"\":\n117\t\t\ts := sanitize(p.Tail)\n118\t\t\tf := fenceFor(s)\n119\t\t\ttail = \"Last 50 log lines:\\n\" + f + \"\\n\" + s + \"\\n\" + f\n120\t\tcase p.TailWithheld:\n121\t\t\ttail = \"Log tail withheld.\"\n122\t\t}\n123\t\tif !p.KeepUntil.IsZero() {\n124\t\t\tbefore = append(before, fmt.Sprintf(\"Kept until %s (worktree and host files of job `%s`); add `%s` to hold them longer.\",\n125\t\t\t\tp.KeepUntil.UTC().Format(\"2006-01-02 15:04 UTC\"), r.Job.ID, labels.Keep))\n126\t\t}\n127\t\treturn before, tail\n128\t}\n129\t\n130\t// limitLine says when a usage-limit stop re-runs. The family is a fixed word\n131\t// (opus, sonnet) or \"account\"; nothing the CLI printed is echoed.\n132\tfunc limitLine(c Cause) string {\n133\t\twho := \"account\"\n134\t\tif c.Family != \"\" {\n135\t\t\twho = c.Family\n136\t\t}\n137\t\tif c.ResetsAt.IsZero() {\n138\t\t\treturn \"Paused for usage limit; re-runs after the reset (\" + sanitize(who) + \").\"\n139\t\t}\n140\t\treturn fmt.Sprintf(\"Paused for usage limit until %s (%s); re-runs after the reset.\",\n141\t\t\tc.ResetsAt.UTC().Format(\"2006-01-02 15:04 UTC\"), sanitize(who))\n142\t}\n143\t\n144\t// RenderComment builds the close-out comment for a record. In dry-run, or\n145\t// when nothing was committed, output paths are plain text with no link.\n146\tfunc RenderComment(r Record, repo github.Repo, dryRun bool) string {\n147\t\tj, p := r.Job, r.Plan\n148\t\tvar b strings.Builder\n149\t\tb.WriteString(marker(j.ID, j.Attempt) + \"\\n\")\n150\t\tfmt.Fprintf(&b, \"**ard · %s:%s · %s**\\n\", j.Stage, j.Role, headerWord(p))\n151\t\tif s := strings.TrimSpace(p.Summary); s != \"\" {\n152\t\t\tb.WriteString(\"\\n\" + sanitize(cutSummary(s)) + \"\\n\")\n153\t\t}\n154\t\tif p.Reason != \"\" {\n155\t\t\tb.WriteString(\"\\n\" + codeSpan(p.Reason, maxReasonRunes) + \"\\n\")\n156\t\t}\n157\t\tvar lines []string\n158\t\tif len(p.Requests) > 0 {\n159\t\t\tnames := make([]string, len(p.Requests))\n160\t\t\tfor i, l := range p.Requests {\n161\t\t\t\tnames[i] = \"`\" + l.Name + \"`\"\n162\t\t\t}\n163\t\t\tlines = append(lines, \"Requested next: \"+strings.Join(names, \", \"))\n164\t\t}\n165\t\tif len(p.Deferred) > 0 {\n166\t\t\tnames := make([]string, len(p.Deferred))\n167\t\t\tfor i, d := range p.Deferred {\n168\t\t\t\tnames[i] = \"`\" + d.String() + \"`\"\n169\t\t\t}\n170\t\t\tlines = append(lines, \"Deferred until the PR exists: \"+strings.Join(names, \", \"))\n171\t\t}\n172\t\tif len(p.Skipped) > 0 {\n173\t\t\tparts := make([]string, len(p.Skipped))\n174\t\t\tfor i, s := range p.Skipped {\n175\t\t\t\tparts[i] = codeSpan(s.Entry, 60) + \" (\" + sanitize(s.Why) + \")\"\n176\t\t\t}\n177\t\t\tlines = append(lines, \"Skipped: \"+strings.Join(parts, \", \"))\n178\t\t}\n179\t\tlines = append(lines, workerLines(j)...)\n180\t\tif j.TokensUnreported {\n181\t\t\tlines = append(lines, \"Tokens not reported: this job's token use is not counted, so the day's token count for this role is low.\")\n182\t\t}\n183\t\tif out := outputLine(r, repo, dryRun); out != \"\" {\n184\t\t\tlines = append(lines, out)\n185\t\t}\n186\t\textra, tail := evidenceLines(r)\n187\t\tlines = append(lines, extra...)\n188\t\tif len(lines) > 0 {\n189\t\t\tb.WriteString(\"\\n\" + strings.Join(lines, \"\\n\") + \"\\n\")\n190\t\t}\n191\t\tif tail != \"\" {\n192\t\t\tb.WriteString(\"\\n\" + tail + \"\\n\")\n193\t\t}\n194\t\treturn b.String()\n195\t}\n196\t\n197\tfunc outputLine(r Record, repo github.Repo, dryRun bool) string {\n198\t\tj, p := r.Job, r.Plan\n199\t\tlink := func(path string) string {\n200\t\t\tif dryRun || r.SHA == \"\" {\n201\t\t\t\treturn path\n202\t\t\t}\n203\t\t\treturn fmt.Sprintf(\"[%s](https://github.com/%s/%s/blob/%s/%s)\", path, repo.Owner, repo.Name, r.SHA, path)\n204\t\t}\n205\t\tvar parts []string\n206\t\tif p.RolePath != \"\" {\n207\t\t\tparts = append(parts, link(p.RolePath))\n208\t\t}\n209\t\tswitch {\n210\t\tcase p.LogPath != \"\":\n211\t\t\tparts = append(parts, \"log \"+link(p.LogPath))\n212\t\tcase p.LogWithheld:\n213\t\t\tparts = append(parts, \"log withheld (secret scan)\")\n214\t\t}\n215\t\tfor _, e := range p.ExtraLogPaths {\n216\t\t\tparts = append(parts, \"log \"+link(e))\n217\t\t}\n218\t\tif len(parts) == 0 {\n219\t\t\treturn \"\"\n220\t\t}\n221\t\tparts = append(parts, fmt.Sprintf(\"job `%s`\", j.ID), fmt.Sprintf(\"attempt %d\", j.Attempt))\n222\t\treturn \"Output: \" + strings.Join(parts, \" · \")\n223\t}\n224\t"}]},"parent_tool_use_id":null,"session_id":"6fb74eff-9d1e-4e23-8bf6-a73511888174","uuid":"1b226dde-734e-434f-afc1-f6bab9db65fd","timestamp":"2026-11-25T11:11:14.575Z","tool_use_result":{"type":"text","file":{"filePath":"/work/internal/closeout/comment.go","content":"package closeout\n\nimport (\n\t\"fmt\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n)\n\nconst (\n\tmaxSummaryRunes = 4000\n\tmaxReasonRunes  = 300\n\tmarkerPrefix    = \"<!-- ard:closeout job=\"\n)\n\n// marker is the hidden first line of the close-out comment. Resume looks for\n// it so a replay never posts a second comment.\nfunc marker(jobID string, attempt int) string {\n\treturn fmt.Sprintf(\"%s%s attempt=%d -->\", markerPrefix, jobID, attempt)\n}\n\nfunc markerFor(jobID string) string { return markerPrefix + jobID + \" \" }\n\n// Sanitize makes agent text safe to post: it cannot forge an ard marker\n// (<!-- ard:closeout, ard:status, ard:fp) and cannot ping anyone. The worker\n// loop uses it for the PR body.\nfunc Sanitize(s string) string { return sanitize(s) }\n\n// sanitize is Sanitize.\nfunc sanitize(s string) string {\n\ts = strings.ReplaceAll(s, \"<!--\", \"&lt;!--\")\n\tvar b strings.Builder\n\trs := []rune(s)\n\tfor i, r := range rs {\n\t\tb.WriteRune(r)\n\t\tif r == '@' && i+1 < len(rs) && isAlnum(rs[i+1]) {\n\t\t\tb.WriteRune('\u200b')\n\t\t}\n\t}\n\treturn b.String()\n}\n\nfunc isAlnum(r rune) bool {\n\treturn r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || r >= '0' && r <= '9'\n}\n\n// codeSpan renders s on one line inside backticks, cut to max runes.\nfunc codeSpan(s string, max int) string {\n\ts = strings.Join(strings.Fields(strings.ReplaceAll(s, \"`\", \"'\")), \" \")\n\tif r := []rune(s); len(r) > max {\n\t\ts = string(r[:max-1]) + \"…\"\n\t}\n\treturn \"`\" + sanitize(s) + \"`\"\n}\n\n// cutSummary cuts s to maxSummaryRunes at a line end.\nfunc cutSummary(s string) string {\n\tr := []rune(s)\n\tif len(r) <= maxSummaryRunes {\n\t\treturn s\n\t}\n\tcut := string(r[:maxSummaryRunes])\n\tif i := strings.LastIndex(cut, \"\\n\"); i > 0 {\n\t\tcut = cut[:i]\n\t}\n\treturn strings.TrimRight(cut, \"\\n\") + \"\\n… (truncated; full text in the committed file)\"\n}\n\nfunc headerWord(p Plan) string {\n\tswitch p.Outcome {\n\tcase OutcomeNeedsHuman:\n\t\tif p.Status == StatusBlocked {\n\t\t\treturn \"blocked\"\n\t\t}\n\t\treturn \"needs-human\"\n\tcase OutcomeRetry:\n\t\treturn \"retrying\"\n\tcase OutcomeLimited:\n\t\treturn \"usage limit\"\n\tdefault:\n\t\treturn string(p.Outcome)\n\t}\n}\n\n// fenceFor returns a code fence one backtick longer than the longest backtick\n// run in s, and at least three, so s cannot close it.\nfunc fenceFor(s string) string {\n\tlongest, run := 0, 0\n\tfor _, r := range s {\n\t\tif r == '`' {\n\t\t\trun++\n\t\t\tlongest = max(longest, run)\n\t\t} else {\n\t\t\trun = 0\n\t\t}\n\t}\n\treturn strings.Repeat(\"`\", max(3, longest+1))\n}\n\n// evidenceLines are the extra lines of a failed or retry comment: what will\n// happen next, the log tail and how long the evidence is kept. Host paths are\n// never printed; they would reveal the user's home directory.\nfunc evidenceLines(r Record) (before []string, tail string) {\n\tp := r.Plan\n\tif p.Outcome != OutcomeFailed && p.Outcome != OutcomeRetry && p.Outcome != OutcomeLimited {\n\t\treturn nil, \"\"\n\t}\n\tif p.Outcome == OutcomeRetry {\n\t\tbefore = append(before, \"Retrying once as a new job.\")\n\t}\n\tif p.Outcome == OutcomeLimited {\n\t\tbefore = append(before, limitLine(r.Job.Cause))\n\t}\n\tswitch {\n\tcase p.Tail != \"\":\n\t\ts := sanitize(p.Tail)\n\t\tf := fenceFor(s)\n\t\ttail = \"Last 50 log lines:\\n\" + f + \"\\n\" + s + \"\\n\" + f\n\tcase p.TailWithheld:\n\t\ttail = \"Log tail withheld.\"\n\t}\n\tif !p.KeepUntil.IsZero() {\n\t\tbefore = append(before, fmt.Sprintf(\"Kept until %s (worktree and host files of job `%s`); add `%s` to hold them longer.\",\n\t\t\tp.KeepUntil.UTC().Format(\"2006-01-02 15:04 UTC\"), r.Job.ID, labels.Keep))\n\t}\n\treturn before, tail\n}\n\n// limitLine says when a usage-limit stop re-runs. The family is a fixed word\n// (opus, sonnet) or \"account\"; nothing the CLI printed is echoed.\nfunc limitLine(c Cause) string {\n\twho := \"account\"\n\tif c.Family != \"\" {\n\t\twho = c.Family\n\t}\n\tif c.ResetsAt.IsZero() {\n\t\treturn \"Paused for usage limit; re-runs after the reset (\" + sanitize(who) + \").\"\n\t}\n\treturn fmt.Sprintf(\"Paused for usage limit until %s (%s); re-runs after the reset.\",\n\t\tc.ResetsAt.UTC().Format(\"2006-01-02 15:04 UTC\"), sanitize(who))\n}\n\n// RenderComment builds the close-out comment for a record. In dry-run, or\n// when nothing was committed, output paths are plain text with no link.\nfunc RenderComment(r Record, repo github.Repo, dryRun bool) string {\n\tj, p := r.Job, r.Plan\n\tvar b strings.Builder\n\tb.WriteString(marker(j.ID, j.Attempt) + \"\\n\")\n\tfmt.Fprintf(&b, \"**ard · %s:%s · %s**\\n\", j.Stage, j.Role, headerWord(p))\n\tif s := strings.TrimSpace(p.Summary); s != \"\" {\n\t\tb.WriteString(\"\\n\" + sanitize(cutSummary(s)) + \"\\n\")\n\t}\n\tif p.Reason != \"\" {\n\t\tb.WriteString(\"\\n\" + codeSpan(p.Reason, maxReasonRunes) + \"\\n\")\n\t}\n\tvar lines []string\n\tif len(p.Requests) > 0 {\n\t\tnames := make([]string, len(p.Requests))\n\t\tfor i, l := range p.Requests {\n\t\t\tnames[i] = \"`\" + l.Name + \"`\"\n\t\t}\n\t\tlines = append(lines, \"Requested next: \"+strings.Join(names, \", \"))\n\t}\n\tif len(p.Deferred) > 0 {\n\t\tnames := make([]string, len(p.Deferred))\n\t\tfor i, d := range p.Deferred {\n\t\t\tnames[i] = \"`\" + d.String() + \"`\"\n\t\t}\n\t\tlines = append(lines, \"Deferred until the PR exists: \"+strings.Join(names, \", \"))\n\t}\n\tif len(p.Skipped) > 0 {\n\t\tparts := make([]string, len(p.Skipped))\n\t\tfor i, s := range p.Skipped {\n\t\t\tparts[i] = codeSpan(s.Entry, 60) + \" (\" + sanitize(s.Why) + \")\"\n\t\t}\n\t\tlines = append(lines, \"Skipped: \"+strings.Join(parts, \", \"))\n\t}\n\tlines = append(lines, workerLines(j)...)\n\tif j.TokensUnreported {\n\t\tlines = append(lines, \"Tokens not reported: this job's token use is not counted, so the day's token count for this role is low.\")\n\t}\n\tif out := outputLine(r, repo, dryRun); out != \"\" {\n\t\tlines = append(lines, out)\n\t}\n\textra, tail := evidenceLines(r)\n\tlines = append(lines, extra...)\n\tif len(lines) > 0 {\n\t\tb.WriteString(\"\\n\" + strings.Join(lines, \"\\n\") + \"\\n\")\n\t}\n\tif tail != \"\" {\n\t\tb.WriteString(\"\\n\" + tail + \"\\n\")\n\t}\n\treturn b.String()\n}\n\nfunc outputLine(r Record, repo github.Repo, dryRun bool) string {\n\tj, p := r.Job, r.Plan\n\tlink := func(path string) string {\n\t\tif dryRun || r.SHA == \"\" {\n\t\t\treturn path\n\t\t}\n\t\treturn fmt.Sprintf(\"[%s](https://github.com/%s/%s/blob/%s/%s)\", path, repo.Owner, repo.Name, r.SHA, path)\n\t}\n\tvar parts []string\n\tif p.RolePath != \"\" {\n\t\tparts = append(parts, link(p.RolePath))\n\t}\n\tswitch {\n\tcase p.LogPath != \"\":\n\t\tparts = append(parts, \"log \"+link(p.LogPath))\n\tcase p.LogWithheld:\n\t\tparts = append(parts, \"log withheld (secret scan)\")\n\t}\n\tfor _, e := range p.ExtraLogPaths {\n\t\tparts = append(parts, \"log \"+link(e))\n\t}\n\tif len(parts) == 0 {\n\t\treturn \"\"\n\t}\n\tparts = append(parts, fmt.Sprintf(\"job `%s`\", j.ID), fmt.Sprintf(\"attempt %d\", j.Attempt))\n\treturn \"Output: \" + strings.Join(parts, \" · \")\n}\n","numLines":224,"startLine":1,"totalLines":224}},"tool_result_meta":[{"id":"toolu_01NvUb7qFx4h9hsTdA4hN3QS","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
