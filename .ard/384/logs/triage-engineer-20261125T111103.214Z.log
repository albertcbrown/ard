{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LFbTTPhgCypyYpkvcDUz8R","type":"tool_result","content":"1\tpackage closeout\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"net/url\"\n9\t\t\"os\"\n10\t\t\"strings\"\n11\t\t\"time\"\n12\t\t\"unicode/utf8\"\n13\t\n14\t\t\"gopkg.in/yaml.v3\"\n15\t)\n16\t\n17\t// Stage words of the jobs close-out handles.\n18\tconst (\n19\t\tStageTriage = \"triage\"\n20\t\tStageWorker = \"worker\"\n21\t\tStageReview = \"review\"\n22\t)\n23\t\n24\t// Role file statuses and reviewer verdicts.\n25\tconst (\n26\t\tStatusDone       = \"done\"\n27\t\tStatusBlocked    = \"blocked\"\n28\t\tStatusNeedsHuman = \"needs-human\"\n29\t\tVerdictApprove   = \"approve\"\n30\t\tVerdictChanges   = \"changes\"\n31\t)\n32\t\n33\t// Finding severities, most serious first.\n34\tconst (\n35\t\tSeverityCritical = \"critical\"\n36\t\tSeverityHigh     = \"high\"\n37\t\tSeverityMedium   = \"medium\"\n38\t\tSeverityLow      = \"low\"\n39\t\tSeverityInfo     = \"info\"\n40\t)\n41\t\n42\t// MaxFindings bounds the findings of one review; MaxFindingPath bounds a\n43\t// finding's file path in bytes.\n44\tconst (\n45\t\tMaxFindings    = 50\n46\t\tMaxFindingPath = 300\n47\t)\n48\t\n49\t// MaxFetched bounds the fetched inputs of one worker role file; MaxFetchedURL\n50\t// bounds a fetched URL in bytes.\n51\tconst (\n52\t\tMaxFetched    = 50\n53\t\tMaxFetchedURL = 2000\n54\t)\n55\t\n56\t// MaxRoleFileBytes bounds a role file.\n57\tconst MaxRoleFileBytes = 256 << 10\n58\t\n59\tvar (\n60\t\t// ErrMissing means the role file does not exist.\n61\t\tErrMissing = errors.New(\"closeout: role file missing\")\n62\t\t// ErrMalformed means the role file exists but breaks the contract. It is\n63\t\t// always wrapped with the reason.\n64\t\tErrMalformed = errors.New(\"closeout: malformed role file\")\n65\t)\n66\t\n67\t// RoleFile is the parsed .ard/<issue#>/<stage>-<role>.md.\n68\ttype RoleFile struct {\n69\t\tRole, Status, Verdict, Worker string\n70\t\tAttempt                       int\n71\t\tNext                          []string // raw entries; see next.go\n72\t\tSummary                       string\n73\t\t// Findings are a review's findings, in file order. Only a review may have\n74\t\t// them (check).\n75\t\tFindings []Finding\n76\t\t// Fetched are the network inputs a worker records, in file order. Only a\n77\t\t// worker may have them (check).\n78\t\tFetched []Fetched\n79\t}\n80\t\n81\t// Fetched is one input a worker fetched from the network.\n82\ttype Fetched struct {\n83\t\tURL        string // https only\n84\t\tDate       string // YYYY-MM-DD\n85\t\tStatus     int    // HTTP status, 100..599\n86\t\tSHA256     string // 64 lowercase hex\n87\t\tVerifiedBy string // an https URL, or \"none\"\n88\t\tPath       string // repo-relative landing path\n89\t}\n90\t\n91\t// Finding is one point a reviewer raised.\n92\ttype Finding struct {\n93\t\tFile     string // repo-relative slash path\n94\t\tLine     int    // 1-based; 0 means the whole file\n95\t\tSeverity string\n96\t\tBlocking bool\n97\t\tMessage  string // untrusted agent text\n98\t}\n99\t\n100\t// HasBlocking reports whether any finding blocks.\n101\tfunc HasBlocking(fs []Finding) bool {\n102\t\tfor _, f := range fs {\n103\t\t\tif f.Blocking {\n104\t\t\t\treturn true\n105\t\t\t}\n106\t\t}\n107\t\treturn false\n108\t}\n109\t\n110\t// DowngradeVerdict makes an approve that carries a blocking finding a\n111\t// changes verdict, and reports whether it did. A reviewer that blocks and\n112\t// approves in one breath is read conservatively; the job still succeeds.\n113\tfunc (rf *RoleFile) DowngradeVerdict() bool {\n114\t\tif rf.Verdict == VerdictApprove && HasBlocking(rf.Findings) {\n115\t\t\trf.Verdict = VerdictChanges\n116\t\t\treturn true\n117\t\t}\n118\t\treturn false\n119\t}\n120\t\n121\ttype rawFinding struct {\n122\t\tFile     *string `yaml:\"file\"`\n123\t\tLine     *int    `yaml:\"line\"`\n124\t\tSeverity *string `yaml:\"severity\"`\n125\t\tBlocking *bool   `yaml:\"blocking\"`\n126\t\tMessage  *string `yaml:\"message\"`\n127\t}\n128\t\n129\ttype rawFetched struct {\n130\t\tURL        *string `yaml:\"url\"`\n131\t\tDate       *string `yaml:\"date\"`\n132\t\tStatus     *int    `yaml:\"status\"`\n133\t\tSHA256     *string `yaml:\"sha256\"`\n134\t\tVerifiedBy *string `yaml:\"verified_by\"`\n135\t\tPath       *string `yaml:\"path\"`\n136\t}\n137\t\n138\ttype rawFront struct {\n139\t\tRole    *string   `yaml:\"role\"`\n140\t\tStatus  *string   `yaml:\"status\"`\n141\t\tAttempt *int      `yaml:\"attempt\"`\n142\t\tNext    *[]string `yaml:\"next\"`\n143\t\tVerdict *string   `yaml:\"verdict\"`\n144\t\tWorker  *string   `yaml:\"worker\"`\n145\t\n146\t\tFindings *[]rawFinding `yaml:\"findings\"`\n147\t\tFetched  *[]rawFetched `yaml:\"fetched\"`\n148\t}\n149\t\n150\tfunc malformed(format string, a ...any) error {\n151\t\treturn fmt.Errorf(\"%w: %s\", ErrMalformed, fmt.Sprintf(format, a...))\n152\t}\n153\t\n154\t// Parse reads a role file: a first line of exactly \"---\", YAML, a line of\n155\t// exactly \"---\", then the summary. It checks the syntax and the field\n156\t// types; Check validates the fields against the job.\n157\tfunc Parse(b []byte) (RoleFile, error) {\n158\t\tif len(b) > MaxRoleFileBytes {\n159\t\t\treturn RoleFile{}, malformed(\"file is %d bytes, max %d\", len(b), MaxRoleFileBytes)\n160\t\t}\n161\t\tif !utf8.Valid(b) || bytes.IndexByte(b, 0) >= 0 {\n162\t\t\treturn RoleFile{}, malformed(\"not valid UTF-8 text\")\n163\t\t}\n164\t\tb = bytes.TrimPrefix(b, []byte(\"\\xef\\xbb\\xbf\"))\n165\t\tlines := strings.SplitAfter(string(b), \"\\n\")\n166\t\tfence := func(l string) bool { return strings.TrimSuffix(strings.TrimSuffix(l, \"\\n\"), \"\\r\") == \"---\" }\n167\t\tif len(lines) == 0 || !fence(lines[0]) {\n168\t\t\treturn RoleFile{}, malformed(\"no opening --- line\")\n169\t\t}\n170\t\tend := -1\n171\t\tfor i := 1; i < len(lines); i++ {\n172\t\t\tif fence(lines[i]) {\n173\t\t\t\tend = i\n174\t\t\t\tbreak\n175\t\t\t}\n176\t\t}\n177\t\tif end < 0 {\n178\t\t\treturn RoleFile{}, malformed(\"no closing --- line\")\n179\t\t}\n180\t\tfront := strings.Join(lines[1:end], \"\")\n181\t\tsummary := strings.TrimSpace(strings.Join(lines[end+1:], \"\"))\n182\t\n183\t\tvar raw rawFront\n184\t\tdec := yaml.NewDecoder(strings.NewReader(front))\n185\t\tdec.KnownFields(true)\n186\t\tif err := dec.Decode(&raw); err != nil {\n187\t\t\tif errors.Is(err, io.EOF) {\n188\t\t\t\treturn RoleFile{}, malformed(\"empty frontmatter\")\n189\t\t\t}\n190\t\t\treturn RoleFile{}, malformed(\"frontmatter: %v\", err)\n191\t\t}\n192\t\tif err := checkTypes(front); err != nil {\n193\t\t\treturn RoleFile{}, err\n194\t\t}\n195\t\tvar extra rawFront\n196\t\tif err := dec.Decode(&extra); !errors.Is(err, io.EOF) {\n197\t\t\treturn RoleFile{}, malformed(\"frontmatter holds more than one document\")\n198\t\t}\n199\t\trf := RoleFile{Summary: summary}\n200\t\tvar err error\n201\t\tswitch {\n202\t\tcase raw.Role == nil:\n203\t\t\treturn RoleFile{}, malformed(\"missing role\")\n204\t\tcase raw.Status == nil:\n205\t\t\treturn RoleFile{}, malformed(\"missing status\")\n206\t\tcase raw.Attempt == nil:\n207\t\t\treturn RoleFile{}, malformed(\"missing attempt\")\n208\t\t}\n209\t\trf.Role, rf.Status, rf.Attempt = *raw.Role, *raw.Status, *raw.Attempt\n210\t\tif raw.Verdict != nil {\n211\t\t\trf.Verdict = *raw.Verdict\n212\t\t}\n213\t\tif raw.Worker != nil {\n214\t\t\trf.Worker = *raw.Worker\n215\t\t}\n216\t\tif raw.Next != nil {\n217\t\t\trf.Next = *raw.Next\n218\t\t}\n219\t\tif raw.Findings != nil {\n220\t\t\tif rf.Findings, err = findingsOf(*raw.Findings); err != nil {\n221\t\t\t\treturn RoleFile{}, err\n222\t\t\t}\n223\t\t}\n224\t\tif raw.Fetched != nil {\n225\t\t\tif rf.Fetched, err = fetchedOf(*raw.Fetched); err != nil {\n226\t\t\t\treturn RoleFile{}, err\n227\t\t\t}\n228\t\t}\n229\t\tswitch rf.Status {\n230\t\tcase StatusDone, StatusBlocked, StatusNeedsHuman:\n231\t\tdefault:\n232\t\t\treturn RoleFile{}, malformed(\"status %q is not done, blocked or needs-human\", clip(rf.Status, 40))\n233\t\t}\n234\t\tif rf.Attempt < 1 {\n235\t\t\treturn RoleFile{}, malformed(\"attempt %d is below 1\", rf.Attempt)\n236\t\t}\n237\t\tif rf.Verdict != \"\" && rf.Verdict != VerdictApprove && rf.Verdict != VerdictChanges {\n238\t\t\treturn RoleFile{}, malformed(\"verdict %q is not approve or changes\", clip(rf.Verdict, 40))\n239\t\t}\n240\t\tif rf.Summary == \"\" {\n241\t\t\treturn RoleFile{}, malformed(\"empty summary\")\n242\t\t}\n243\t\treturn rf, nil\n244\t}\n245\t\n246\t// check applies the rules that depend on the job: the role name and where a\n247\t// verdict or worker field may appear.\n248\tfunc (rf RoleFile) check(j Job) error {\n249\t\tif rf.Role != j.Role {\n250\t\t\treturn malformed(\"role %q does not match job role %q\", clip(rf.Role, 40), j.Role)\n251\t\t}\n252\t\tif rf.Verdict != \"\" && j.Stage != StageReview {\n253\t\t\treturn malformed(\"verdict is allowed only on a review\")\n254\t\t}\n255\t\tif j.Stage == StageReview && rf.Status == StatusDone && rf.Verdict == \"\" {\n256\t\t\treturn malformed(\"a done review needs verdict: approve or changes\")\n257\t\t}\n258\t\tif len(rf.Findings) > 0 && j.Stage != StageReview {\n259\t\t\treturn malformed(\"findings are allowed only on a review\")\n260\t\t}\n261\t\tif len(rf.Fetched) > 0 && j.Stage != StageWorker {\n262\t\t\treturn malformed(\"fetched is allowed only on a worker\")\n263\t\t}\n264\t\tif rf.Worker != \"\" && !(j.Stage == StageTriage && j.Role == \"lead\") {\n265\t\t\treturn malformed(\"worker is allowed only for triage:lead\")\n266\t\t}\n267\t\treturn nil\n268\t}\n269\t\n270\t// findingsOf validates the findings of a review.\n271\tfunc findingsOf(raw []rawFinding) ([]Finding, error) {\n272\t\tif len(raw) > MaxFindings {\n273\t\t\treturn nil, malformed(\"%d findings, max %d\", len(raw), MaxFindings)\n274\t\t}\n275\t\tout := make([]Finding, 0, len(raw))\n276\t\tfor i, r := range raw {\n277\t\t\tswitch {\n278\t\t\tcase r.File == nil:\n279\t\t\t\treturn nil, malformed(\"finding %d: missing file\", i+1)\n280\t\t\tcase r.Severity == nil:\n281\t\t\t\treturn nil, malformed(\"finding %d: missing severity\", i+1)\n282\t\t\tcase r.Message == nil:\n283\t\t\t\treturn nil, malformed(\"finding %d: missing message\", i+1)\n284\t\t\t}\n285\t\t\tf := Finding{File: *r.File, Severity: *r.Severity, Message: strings.TrimSpace(*r.Message)}\n286\t\t\tif err := checkFindingPath(f.File); err != nil {\n287\t\t\t\treturn nil, malformed(\"finding %d: file %v\", i+1, err)\n288\t\t\t}\n289\t\t\tswitch f.Severity {\n290\t\t\tcase SeverityCritical, SeverityHigh, SeverityMedium, SeverityLow, SeverityInfo:\n291\t\t\tdefault:\n292\t\t\t\treturn nil, malformed(\"finding %d: severity %q is not critical, high, medium, low or info\", i+1, clip(f.Severity, 40))\n293\t\t\t}\n294\t\t\tif f.Message == \"\" {\n295\t\t\t\treturn nil, malformed(\"finding %d: empty message\", i+1)\n296\t\t\t}\n297\t\t\tif r.Line != nil {\n298\t\t\t\tif *r.Line < 1 {\n299\t\t\t\t\treturn nil, malformed(\"finding %d: line %d is below 1\", i+1, *r.Line)\n300\t\t\t\t}\n301\t\t\t\tf.Line = *r.Line\n302\t\t\t}\n303\t\t\tf.Blocking = r.Blocking != nil && *r.Blocking\n304\t\t\tout = append(out, f)\n305\t\t}\n306\t\treturn out, nil\n307\t}\n308\t\n309\t// fetchedOf validates the fetched inputs of a worker.\n310\tfunc fetchedOf(raw []rawFetched) ([]Fetched, error) {\n311\t\tif len(raw) > MaxFetched {\n312\t\t\treturn nil, malformed(\"%d fetched entries, max %d\", len(raw), MaxFetched)\n313\t\t}\n314\t\tout := make([]Fetched, 0, len(raw))\n315\t\tfor i, r := range raw {\n316\t\t\tn := i + 1\n317\t\t\tswitch {\n318\t\t\tcase r.URL == nil:\n319\t\t\t\treturn nil, malformed(\"fetched %d: missing url\", n)\n320\t\t\tcase r.Date == nil:\n321\t\t\t\treturn nil, malformed(\"fetched %d: missing date\", n)\n322\t\t\tcase r.Status == nil:\n323\t\t\t\treturn nil, malformed(\"fetched %d: missing status\", n)\n324\t\t\tcase r.SHA256 == nil:\n325\t\t\t\treturn nil, malformed(\"fetched %d: missing sha256\", n)\n326\t\t\tcase r.VerifiedBy == nil:\n327\t\t\t\treturn nil, malformed(\"fetched %d: missing verified_by\", n)\n328\t\t\tcase r.Path == nil:\n329\t\t\t\treturn nil, malformed(\"fetched %d: missing path\", n)\n330\t\t\t}\n331\t\t\tf := Fetched{URL: *r.URL, Date: *r.Date, Status: *r.Status, SHA256: *r.SHA256, VerifiedBy: *r.VerifiedBy, Path: *r.Path}\n332\t\t\tif err := checkHTTPS(f.URL); err != nil {\n333\t\t\t\treturn nil, malformed(\"fetched %d: url %v\", n, err)\n334\t\t\t}\n335\t\t\tif _, err := time.Parse(\"2006-01-02\", f.Date); err != nil {\n336\t\t\t\treturn nil, malformed(\"fetched %d: date %q is not YYYY-MM-DD\", n, clip(f.Date, 40))\n337\t\t\t}\n338\t\t\tif f.Status < 100 || f.Status > 599 {\n339\t\t\t\treturn nil, malformed(\"fetched %d: status %d is not 100..599\", n, f.Status)\n340\t\t\t}\n341\t\t\tif !isSHA256(f.SHA256) {\n342\t\t\t\treturn nil, malformed(\"fetched %d: sha256 is not 64 lowercase hex characters\", n)\n343\t\t\t}\n344\t\t\tif f.VerifiedBy != \"none\" {\n345\t\t\t\tif err := checkHTTPS(f.VerifiedBy); err != nil {\n346\t\t\t\t\treturn nil, malformed(\"fetched %d: verified_by %v\", n, err)\n347\t\t\t\t}\n348\t\t\t}\n349\t\t\tif err := checkFindingPath(f.Path); err != nil {\n350\t\t\t\treturn nil, malformed(\"fetched %d: path %v\", n, err)\n351\t\t\t}\n352\t\t\tfor _, c := range f.Path {\n353\t\t\t\tif c < ' ' || c == 0x7f || c == '`' || c == '<' || c == '>' {\n354\t\t\t\t\treturn nil, malformed(\"fetched %d: path has a control or forbidden character\", n)\n355\t\t\t\t}\n356\t\t\t}\n357\t\t\tout = append(out, f)\n358\t\t}\n359\t\treturn out, nil\n360\t}\n361\t\n362\tfunc isSHA256(s string) bool {\n363\t\tif len(s) != 64 {\n364\t\t\treturn false\n365\t\t}\n366\t\tfor _, c := range s {\n367\t\t\tif !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {\n368\t\t\t\treturn false\n369\t\t\t}\n370\t\t}\n371\t\treturn true\n372\t}\n373\t\n374\t// checkHTTPS accepts a plain https URL with a host and no userinfo, and no\n375\t// character that could break out of a markdown code span.\n376\tfunc checkHTTPS(s string) error {\n377\t\tif s == \"\" {\n378\t\t\treturn errors.New(\"is empty\")\n379\t\t}\n380\t\tif len(s) > MaxFetchedURL {\n381\t\t\treturn fmt.Errorf(\"is %d bytes, max %d\", len(s), MaxFetchedURL)\n382\t\t}\n383\t\tfor _, c := range s {\n384\t\t\tif c <= ' ' || c == 0x7f || c == '`' || c == '<' || c == '>' || c == '\\\\' {\n385\t\t\t\treturn errors.New(\"has a space, control or forbidden character\")\n386\t\t\t}\n387\t\t}\n388\t\tu, err := url.Parse(s)\n389\t\tif err != nil || u.Scheme != \"https\" {\n390\t\t\treturn errors.New(\"is not an https URL\")\n391\t\t}\n392\t\tif u.Host == \"\" || u.Hostname() == \"\" {\n393\t\t\treturn errors.New(\"has no host\")\n394\t\t}\n395\t\tif u.User != nil {\n396\t\t\treturn errors.New(\"has userinfo\")\n397\t\t}\n398\t\treturn nil\n399\t}\n400\t\n401\t// checkFindingPath accepts only a clean repo-relative slash path.\n402\tfunc checkFindingPath(p string) error {\n403\t\tswitch {\n404\t\tcase p == \"\":\n405\t\t\treturn errors.New(\"is empty\")\n406\t\tcase len(p) > MaxFindingPath:\n407\t\t\treturn fmt.Errorf(\"is %d bytes, max %d\", len(p), MaxFindingPath)\n408\t\tcase strings.ContainsAny(p, \"\\\\\\x00\"):\n409\t\t\treturn errors.New(\"has a backslash or NUL\")\n410\t\tcase strings.HasPrefix(p, \"/\"):\n411\t\t\treturn errors.New(\"is absolute\")\n412\t\t}\n413\t\tfor _, seg := range strings.Split(p, \"/\") {\n414\t\t\tif seg == \"\" || seg == \".\" || seg == \"..\" {\n415\t\t\t\treturn errors.New(\"is not a clean relative path\")\n416\t\t\t}\n417\t\t}\n418\t\treturn nil\n419\t}\n420\t\n421\t// readRoleFile reads path without following a symlink.\n422\tfunc readRoleFile(path string) ([]byte, error) {\n423\t\tfi, err := os.Lstat(path)\n424\t\tif errors.Is(err, os.ErrNotExist) {\n425\t\t\treturn nil, ErrMissing\n426\t\t}\n427\t\tif err != nil {\n428\t\t\treturn nil, fmt.Errorf(\"stat role file: %w\", err)\n429\t\t}\n430\t\tif !fi.Mode().IsRegular() {\n431\t\t\treturn nil, malformed(\"not a regular file\")\n432\t\t}\n433\t\tif fi.Size() > MaxRoleFileBytes {\n434\t\t\treturn nil, malformed(\"file is %d bytes, max %d\", fi.Size(), MaxRoleFileBytes)\n435\t\t}\n436\t\tb, err := os.ReadFile(path)\n437\t\tif errors.Is(err, os.ErrNotExist) {\n438\t\t\treturn nil, ErrMissing\n439\t\t}\n440\t\tif err != nil {\n441\t\t\treturn nil, fmt.Errorf(\"read role file: %w\", err)\n442\t\t}\n443\t\treturn b, nil\n444\t}\n445\t\n446\t// clip shortens untrusted text for a reason string.\n447\tfunc clip(s string, n int) string {\n448\t\tr := []rune(s)\n449\t\tif len(r) > n {\n450\t\t\treturn string(r[:n]) + \"...\"\n451\t\t}\n452\t\treturn s\n453\t}\n454\t\n455\t// findingsTypes checks the scalar tags of a findings sequence.\n456\tfunc findingsTypes(v *yaml.Node) bool {\n457\t\tif v.Kind != yaml.SequenceNode {\n458\t\t\treturn false\n459\t\t}\n460\t\tfor _, e := range v.Content {\n461\t\t\tif e.Kind != yaml.MappingNode {\n462\t\t\t\treturn false\n463\t\t\t}\n464\t\t\tfor i := 0; i+1 < len(e.Content); i += 2 {\n465\t\t\t\tval := e.Content[i+1]\n466\t\t\t\tif val.Kind != yaml.ScalarNode {\n467\t\t\t\t\treturn false\n468\t\t\t\t}\n469\t\t\t\tswitch e.Content[i].Value {\n470\t\t\t\tcase \"file\", \"severity\", \"message\":\n471\t\t\t\t\tif val.Tag != \"!!str\" {\n472\t\t\t\t\t\treturn false\n473\t\t\t\t\t}\n474\t\t\t\tcase \"line\":\n475\t\t\t\t\tif val.Tag != \"!!int\" {\n476\t\t\t\t\t\treturn false\n477\t\t\t\t\t}\n478\t\t\t\tcase \"blocking\":\n479\t\t\t\t\tif val.Tag != \"!!bool\" {\n480\t\t\t\t\t\treturn false\n481\t\t\t\t\t}\n482\t\t\t\t}\n483\t\t\t}\n484\t\t}\n485\t\treturn true\n486\t}\n487\t\n488\t// fetchedTypes checks the scalar tags of a fetched sequence.\n489\tfunc fetchedTypes(v *yaml.Node) bool {\n490\t\tif v.Kind != yaml.SequenceNode {\n491\t\t\treturn false\n492\t\t}\n493\t\tfor _, e := range v.Content {\n494\t\t\tif e.Kind != yaml.MappingNode {\n495\t\t\t\treturn false\n496\t\t\t}\n497\t\t\tfor i := 0; i+1 < len(e.Content); i += 2 {\n498\t\t\t\tval := e.Content[i+1]\n499\t\t\t\tif val.Kind != yaml.ScalarNode {\n500\t\t\t\t\treturn false\n501\t\t\t\t}\n502\t\t\t\tswitch e.Content[i].Value {\n503\t\t\t\tcase \"url\", \"sha256\", \"verified_by\", \"path\":\n504\t\t\t\t\tif val.Tag != \"!!str\" {\n505\t\t\t\t\t\treturn false\n506\t\t\t\t\t}\n507\t\t\t\tcase \"date\":\n508\t\t\t\t\tif val.Tag != \"!!str\" && val.Tag != \"!!timestamp\" {\n509\t\t\t\t\t\treturn false\n510\t\t\t\t\t}\n511\t\t\t\tcase \"status\":\n512\t\t\t\t\tif val.Tag != \"!!int\" {\n513\t\t\t\t\t\treturn false\n514\t\t\t\t\t}\n515\t\t\t\t}\n516\t\t\t}\n517\t\t}\n518\t\treturn true\n519\t}\n520\t\n521\t// checkTypes rejects scalars yaml.v3 would coerce: role, status, verdict and\n522\t// worker must be strings, attempt an integer, next a list of strings.\n523\tfunc checkTypes(front string) error {\n524\t\tvar doc yaml.Node\n525\t\tif err := yaml.Unmarshal([]byte(front), &doc); err != nil || len(doc.Content) == 0 {\n526\t\t\treturn malformed(\"frontmatter: unreadable\")\n527\t\t}\n528\t\tm := doc.Content[0]\n529\t\tif m.Kind != yaml.MappingNode {\n530\t\t\treturn malformed(\"frontmatter is not a mapping\")\n531\t\t}\n532\t\tfor i := 0; i+1 < len(m.Content); i += 2 {\n533\t\t\tkey, v := m.Content[i].Value, m.Content[i+1]\n534\t\t\tok := true\n535\t\t\tswitch key {\n536\t\t\tcase \"role\", \"status\", \"verdict\", \"worker\":\n537\t\t\t\tok = v.Kind == yaml.ScalarNode && v.Tag == \"!!str\"\n538\t\t\tcase \"attempt\":\n539\t\t\t\tok = v.Kind == yaml.ScalarNode && v.Tag == \"!!int\"\n540\t\t\tcase \"findings\":\n541\t\t\t\tok = findingsTypes(v)\n542\t\t\tcase \"fetched\":\n543\t\t\t\tok = fetchedTypes(v)\n544\t\t\tcase \"next\":\n545\t\t\t\tok = v.Kind == yaml.SequenceNode\n546\t\t\t\tfor _, e := range v.Content {\n547\t\t\t\t\tif e.Kind != yaml.ScalarNode || e.Tag != \"!!str\" {\n548\t\t\t\t\t\tok = false\n549\t\t\t\t\t}\n550\t\t\t\t}\n551\t\t\t}\n552\t\t\tif !ok {\n553\t\t\t\treturn malformed(\"field %s: wrong type\", key)\n554\t\t\t}\n555\t\t}\n556\t\treturn nil\n557\t}\n558\t"}]},"parent_tool_use_id":null,"session_id":"6fb74eff-9d1e-4e23-8bf6-a73511888174","uuid":"0574b521-7366-4328-94d7-73960e4f8c5e","timestamp":"2026-11-25T11:11:11.591Z","tool_use_result":{"type":"text","file":{"filePath":"/work/internal/closeout/rolefile.go","content":"package closeout\n\nimport (\n\t\"bytes\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/url\"\n\t\"os\"\n\t\"strings\"\n\t\"time\"\n\t\"unicode/utf8\"\n\n\t\"gopkg.in/yaml.v3\"\n)\n\n// Stage words of the jobs close-out handles.\nconst (\n\tStageTriage = \"triage\"\n\tStageWorker = \"worker\"\n\tStageReview = \"review\"\n)\n\n// Role file statuses and reviewer verdicts.\nconst (\n\tStatusDone       = \"done\"\n\tStatusBlocked    = \"blocked\"\n\tStatusNeedsHuman = \"needs-human\"\n\tVerdictApprove   = \"approve\"\n\tVerdictChanges   = \"changes\"\n)\n\n// Finding severities, most serious first.\nconst (\n\tSeverityCritical = \"critical\"\n\tSeverityHigh     = \"high\"\n\tSeverityMedium   = \"medium\"\n\tSeverityLow      = \"low\"\n\tSeverityInfo     = \"info\"\n)\n\n// MaxFindings bounds the findings of one review; MaxFindingPath bounds a\n// finding's file path in bytes.\nconst (\n\tMaxFindings    = 50\n\tMaxFindingPath = 300\n)\n\n// MaxFetched bounds the fetched inputs of one worker role file; MaxFetchedURL\n// bounds a fetched URL in bytes.\nconst (\n\tMaxFetched    = 50\n\tMaxFetchedURL = 2000\n)\n\n// MaxRoleFileBytes bounds a role file.\nconst MaxRoleFileBytes = 256 << 10\n\nvar (\n\t// ErrMissing means the role file does not exist.\n\tErrMissing = errors.New(\"closeout: role file missing\")\n\t// ErrMalformed means the role file exists but breaks the contract. It is\n\t// always wrapped with the reason.\n\tErrMalformed = errors.New(\"closeout: malformed role file\")\n)\n\n// RoleFile is the parsed .ard/<issue#>/<stage>-<role>.md.\ntype RoleFile struct {\n\tRole, Status, Verdict, Worker string\n\tAttempt                       int\n\tNext                          []string // raw entries; see next.go\n\tSummary                       string\n\t// Findings are a review's findings, in file order. Only a review may have\n\t// them (check).\n\tFindings []Finding\n\t// Fetched are the network inputs a worker records, in file order. Only a\n\t// worker may have them (check).\n\tFetched []Fetched\n}\n\n// Fetched is one input a worker fetched from the network.\ntype Fetched struct {\n\tURL        string // https only\n\tDate       string // YYYY-MM-DD\n\tStatus     int    // HTTP status, 100..599\n\tSHA256     string // 64 lowercase hex\n\tVerifiedBy string // an https URL, or \"none\"\n\tPath       string // repo-relative landing path\n}\n\n// Finding is one point a reviewer raised.\ntype Finding struct {\n\tFile     string // repo-relative slash path\n\tLine     int    // 1-based; 0 means the whole file\n\tSeverity string\n\tBlocking bool\n\tMessage  string // untrusted agent text\n}\n\n// HasBlocking reports whether any finding blocks.\nfunc HasBlocking(fs []Finding) bool {\n\tfor _, f := range fs {\n\t\tif f.Blocking {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// DowngradeVerdict makes an approve that carries a blocking finding a\n// changes verdict, and reports whether it did. A reviewer that blocks and\n// approves in one breath is read conservatively; the job still succeeds.\nfunc (rf *RoleFile) DowngradeVerdict() bool {\n\tif rf.Verdict == VerdictApprove && HasBlocking(rf.Findings) {\n\t\trf.Verdict = VerdictChanges\n\t\treturn true\n\t}\n\treturn false\n}\n\ntype rawFinding struct {\n\tFile     *string `yaml:\"file\"`\n\tLine     *int    `yaml:\"line\"`\n\tSeverity *string `yaml:\"severity\"`\n\tBlocking *bool   `yaml:\"blocking\"`\n\tMessage  *string `yaml:\"message\"`\n}\n\ntype rawFetched struct {\n\tURL        *string `yaml:\"url\"`\n\tDate       *string `yaml:\"date\"`\n\tStatus     *int    `yaml:\"status\"`\n\tSHA256     *string `yaml:\"sha256\"`\n\tVerifiedBy *string `yaml:\"verified_by\"`\n\tPath       *string `yaml:\"path\"`\n}\n\ntype rawFront struct {\n\tRole    *string   `yaml:\"role\"`\n\tStatus  *string   `yaml:\"status\"`\n\tAttempt *int      `yaml:\"attempt\"`\n\tNext    *[]string `yaml:\"next\"`\n\tVerdict *string   `yaml:\"verdict\"`\n\tWorker  *string   `yaml:\"worker\"`\n\n\tFindings *[]rawFinding `yaml:\"findings\"`\n\tFetched  *[]rawFetched `yaml:\"fetched\"`\n}\n\nfunc malformed(format string, a ...any) error {\n\treturn fmt.Errorf(\"%w: %s\", ErrMalformed, fmt.Sprintf(format, a...))\n}\n\n// Parse reads a role file: a first line of exactly \"---\", YAML, a line of\n// exactly \"---\", then the summary. It checks the syntax and the field\n// types; Check validates the fields against the job.\nfunc Parse(b []byte) (RoleFile, error) {\n\tif len(b) > MaxRoleFileBytes {\n\t\treturn RoleFile{}, malformed(\"file is %d bytes, max %d\", len(b), MaxRoleFileBytes)\n\t}\n\tif !utf8.Valid(b) || bytes.IndexByte(b, 0) >= 0 {\n\t\treturn RoleFile{}, malformed(\"not valid UTF-8 text\")\n\t}\n\tb = bytes.TrimPrefix(b, []byte(\"\\xef\\xbb\\xbf\"))\n\tlines := strings.SplitAfter(string(b), \"\\n\")\n\tfence := func(l string) bool { return strings.TrimSuffix(strings.TrimSuffix(l, \"\\n\"), \"\\r\") == \"---\" }\n\tif len(lines) == 0 || !fence(lines[0]) {\n\t\treturn RoleFile{}, malformed(\"no opening --- line\")\n\t}\n\tend := -1\n\tfor i := 1; i < len(lines); i++ {\n\t\tif fence(lines[i]) {\n\t\t\tend = i\n\t\t\tbreak\n\t\t}\n\t}\n\tif end < 0 {\n\t\treturn RoleFile{}, malformed(\"no closing --- line\")\n\t}\n\tfront := strings.Join(lines[1:end], \"\")\n\tsummary := strings.TrimSpace(strings.Join(lines[end+1:], \"\"))\n\n\tvar raw rawFront\n\tdec := yaml.NewDecoder(strings.NewReader(front))\n\tdec.KnownFields(true)\n\tif err := dec.Decode(&raw); err != nil {\n\t\tif errors.Is(err, io.EOF) {\n\t\t\treturn RoleFile{}, malformed(\"empty frontmatter\")\n\t\t}\n\t\treturn RoleFile{}, malformed(\"frontmatter: %v\", err)\n\t}\n\tif err := checkTypes(front); err != nil {\n\t\treturn RoleFile{}, err\n\t}\n\tvar extra rawFront\n\tif err := dec.Decode(&extra); !errors.Is(err, io.EOF) {\n\t\treturn RoleFile{}, malformed(\"frontmatter holds more than one document\")\n\t}\n\trf := RoleFile{Summary: summary}\n\tvar err error\n\tswitch {\n\tcase raw.Role == nil:\n\t\treturn RoleFile{}, malformed(\"missing role\")\n\tcase raw.Status == nil:\n\t\treturn RoleFile{}, malformed(\"missing status\")\n\tcase raw.Attempt == nil:\n\t\treturn RoleFile{}, malformed(\"missing attempt\")\n\t}\n\trf.Role, rf.Status, rf.Attempt = *raw.Role, *raw.Status, *raw.Attempt\n\tif raw.Verdict != nil {\n\t\trf.Verdict = *raw.Verdict\n\t}\n\tif raw.Worker != nil {\n\t\trf.Worker = *raw.Worker\n\t}\n\tif raw.Next != nil {\n\t\trf.Next = *raw.Next\n\t}\n\tif raw.Findings != nil {\n\t\tif rf.Findings, err = findingsOf(*raw.Findings); err != nil {\n\t\t\treturn RoleFile{}, err\n\t\t}\n\t}\n\tif raw.Fetched != nil {\n\t\tif rf.Fetched, err = fetchedOf(*raw.Fetched); err != nil {\n\t\t\treturn RoleFile{}, err\n\t\t}\n\t}\n\tswitch rf.Status {\n\tcase StatusDone, StatusBlocked, StatusNeedsHuman:\n\tdefault:\n\t\treturn RoleFile{}, malformed(\"status %q is not done, blocked or needs-human\", clip(rf.Status, 40))\n\t}\n\tif rf.Attempt < 1 {\n\t\treturn RoleFile{}, malformed(\"attempt %d is below 1\", rf.Attempt)\n\t}\n\tif rf.Verdict != \"\" && rf.Verdict != VerdictApprove && rf.Verdict != VerdictChanges {\n\t\treturn RoleFile{}, malformed(\"verdict %q is not approve or changes\", clip(rf.Verdict, 40))\n\t}\n\tif rf.Summary == \"\" {\n\t\treturn RoleFile{}, malformed(\"empty summary\")\n\t}\n\treturn rf, nil\n}\n\n// check applies the rules that depend on the job: the role name and where a\n// verdict or worker field may appear.\nfunc (rf RoleFile) check(j Job) error {\n\tif rf.Role != j.Role {\n\t\treturn malformed(\"role %q does not match job role %q\", clip(rf.Role, 40), j.Role)\n\t}\n\tif rf.Verdict != \"\" && j.Stage != StageReview {\n\t\treturn malformed(\"verdict is allowed only on a review\")\n\t}\n\tif j.Stage == StageReview && rf.Status == StatusDone && rf.Verdict == \"\" {\n\t\treturn malformed(\"a done review needs verdict: approve or changes\")\n\t}\n\tif len(rf.Findings) > 0 && j.Stage != StageReview {\n\t\treturn malformed(\"findings are allowed only on a review\")\n\t}\n\tif len(rf.Fetched) > 0 && j.Stage != StageWorker {\n\t\treturn malformed(\"fetched is allowed only on a worker\")\n\t}\n\tif rf.Worker != \"\" && !(j.Stage == StageTriage && j.Role == \"lead\") {\n\t\treturn malformed(\"worker is allowed only for triage:lead\")\n\t}\n\treturn nil\n}\n\n// findingsOf validates the findings of a review.\nfunc findingsOf(raw []rawFinding) ([]Finding, error) {\n\tif len(raw) > MaxFindings {\n\t\treturn nil, malformed(\"%d findings, max %d\", len(raw), MaxFindings)\n\t}\n\tout := make([]Finding, 0, len(raw))\n\tfor i, r := range raw {\n\t\tswitch {\n\t\tcase r.File == nil:\n\t\t\treturn nil, malformed(\"finding %d: missing file\", i+1)\n\t\tcase r.Severity == nil:\n\t\t\treturn nil, malformed(\"finding %d: missing severity\", i+1)\n\t\tcase r.Message == nil:\n\t\t\treturn nil, malformed(\"finding %d: missing message\", i+1)\n\t\t}\n\t\tf := Finding{File: *r.File, Severity: *r.Severity, Message: strings.TrimSpace(*r.Message)}\n\t\tif err := checkFindingPath(f.File); err != nil {\n\t\t\treturn nil, malformed(\"finding %d: file %v\", i+1, err)\n\t\t}\n\t\tswitch f.Severity {\n\t\tcase SeverityCritical, SeverityHigh, SeverityMedium, SeverityLow, SeverityInfo:\n\t\tdefault:\n\t\t\treturn nil, malformed(\"finding %d: severity %q is not critical, high, medium, low or info\", i+1, clip(f.Severity, 40))\n\t\t}\n\t\tif f.Message == \"\" {\n\t\t\treturn nil, malformed(\"finding %d: empty message\", i+1)\n\t\t}\n\t\tif r.Line != nil {\n\t\t\tif *r.Line < 1 {\n\t\t\t\treturn nil, malformed(\"finding %d: line %d is below 1\", i+1, *r.Line)\n\t\t\t}\n\t\t\tf.Line = *r.Line\n\t\t}\n\t\tf.Blocking = r.Blocking != nil && *r.Blocking\n\t\tout = append(out, f)\n\t}\n\treturn out, nil\n}\n\n// fetchedOf validates the fetched inputs of a worker.\nfunc fetchedOf(raw []rawFetched) ([]Fetched, error) {\n\tif len(raw) > MaxFetched {\n\t\treturn nil, malformed(\"%d fetched entries, max %d\", len(raw), MaxFetched)\n\t}\n\tout := make([]Fetched, 0, len(raw))\n\tfor i, r := range raw {\n\t\tn := i + 1\n\t\tswitch {\n\t\tcase r.URL == nil:\n\t\t\treturn nil, malformed(\"fetched %d: missing url\", n)\n\t\tcase r.Date == nil:\n\t\t\treturn nil, malformed(\"fetched %d: missing date\", n)\n\t\tcase r.Status == nil:\n\t\t\treturn nil, malformed(\"fetched %d: missing status\", n)\n\t\tcase r.SHA256 == nil:\n\t\t\treturn nil, malformed(\"fetched %d: missing sha256\", n)\n\t\tcase r.VerifiedBy == nil:\n\t\t\treturn nil, malformed(\"fetched %d: missing verified_by\", n)\n\t\tcase r.Path == nil:\n\t\t\treturn nil, malformed(\"fetched %d: missing path\", n)\n\t\t}\n\t\tf := Fetched{URL: *r.URL, Date: *r.Date, Status: *r.Status, SHA256: *r.SHA256, VerifiedBy: *r.VerifiedBy, Path: *r.Path}\n\t\tif err := checkHTTPS(f.URL); err != nil {\n\t\t\treturn nil, malformed(\"fetched %d: url %v\", n, err)\n\t\t}\n\t\tif _, err := time.Parse(\"2006-01-02\", f.Date); err != nil {\n\t\t\treturn nil, malformed(\"fetched %d: date %q is not YYYY-MM-DD\", n, clip(f.Date, 40))\n\t\t}\n\t\tif f.Status < 100 || f.Status > 599 {\n\t\t\treturn nil, malformed(\"fetched %d: status %d is not 100..599\", n, f.Status)\n\t\t}\n\t\tif !isSHA256(f.SHA256) {\n\t\t\treturn nil, malformed(\"fetched %d: sha256 is not 64 lowercase hex characters\", n)\n\t\t}\n\t\tif f.VerifiedBy != \"none\" {\n\t\t\tif err := checkHTTPS(f.VerifiedBy); err != nil {\n\t\t\t\treturn nil, malformed(\"fetched %d: verified_by %v\", n, err)\n\t\t\t}\n\t\t}\n\t\tif err := checkFindingPath(f.Path); err != nil {\n\t\t\treturn nil, malformed(\"fetched %d: path %v\", n, err)\n\t\t}\n\t\tfor _, c := range f.Path {\n\t\t\tif c < ' ' || c == 0x7f || c == '`' || c == '<' || c == '>' {\n\t\t\t\treturn nil, malformed(\"fetched %d: path has a control or forbidden character\", n)\n\t\t\t}\n\t\t}\n\t\tout = append(out, f)\n\t}\n\treturn out, nil\n}\n\nfunc isSHA256(s string) bool {\n\tif len(s) != 64 {\n\t\treturn false\n\t}\n\tfor _, c := range s {\n\t\tif !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\n// checkHTTPS accepts a plain https URL with a host and no userinfo, and no\n// character that could break out of a markdown code span.\nfunc checkHTTPS(s string) error {\n\tif s == \"\" {\n\t\treturn errors.New(\"is empty\")\n\t}\n\tif len(s) > MaxFetchedURL {\n\t\treturn fmt.Errorf(\"is %d bytes, max %d\", len(s), MaxFetchedURL)\n\t}\n\tfor _, c := range s {\n\t\tif c <= ' ' || c == 0x7f || c == '`' || c == '<' || c == '>' || c == '\\\\' {\n\t\t\treturn errors.New(\"has a space, control or forbidden character\")\n\t\t}\n\t}\n\tu, err := url.Parse(s)\n\tif err != nil || u.Scheme != \"https\" {\n\t\treturn errors.New(\"is not an https URL\")\n\t}\n\tif u.Host == \"\" || u.Hostname() == \"\" {\n\t\treturn errors.New(\"has no host\")\n\t}\n\tif u.User != nil {\n\t\treturn errors.New(\"has userinfo\")\n\t}\n\treturn nil\n}\n\n// checkFindingPath accepts only a clean repo-relative slash path.\nfunc checkFindingPath(p string) error {\n\tswitch {\n\tcase p == \"\":\n\t\treturn errors.New(\"is empty\")\n\tcase len(p) > MaxFindingPath:\n\t\treturn fmt.Errorf(\"is %d bytes, max %d\", len(p), MaxFindingPath)\n\tcase strings.ContainsAny(p, \"\\\\\\x00\"):\n\t\treturn errors.New(\"has a backslash or NUL\")\n\tcase strings.HasPrefix(p, \"/\"):\n\t\treturn errors.New(\"is absolute\")\n\t}\n\tfor _, seg := range strings.Split(p, \"/\") {\n\t\tif seg == \"\" || seg == \".\" || seg == \"..\" {\n\t\t\treturn errors.New(\"is not a clean relative path\")\n\t\t}\n\t}\n\treturn nil\n}\n\n// readRoleFile reads path without following a symlink.\nfunc readRoleFile(path string) ([]byte, error) {\n\tfi, err := os.Lstat(path)\n\tif errors.Is(err, os.ErrNotExist) {\n\t\treturn nil, ErrMissing\n\t}\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"stat role file: %w\", err)\n\t}\n\tif !fi.Mode().IsRegular() {\n\t\treturn nil, malformed(\"not a regular file\")\n\t}\n\tif fi.Size() > MaxRoleFileBytes {\n\t\treturn nil, malformed(\"file is %d bytes, max %d\", fi.Size(), MaxRoleFileBytes)\n\t}\n\tb, err := os.ReadFile(path)\n\tif errors.Is(err, os.ErrNotExist) {\n\t\treturn nil, ErrMissing\n\t}\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"read role file: %w\", err)\n\t}\n\treturn b, nil\n}\n\n// clip shortens untrusted text for a reason string.\nfunc clip(s string, n int) string {\n\tr := []rune(s)\n\tif len(r) > n {\n\t\treturn string(r[:n]) + \"...\"\n\t}\n\treturn s\n}\n\n// findingsTypes checks the scalar tags of a findings sequence.\nfunc findingsTypes(v *yaml.Node) bool {\n\tif v.Kind != yaml.SequenceNode {\n\t\treturn false\n\t}\n\tfor _, e := range v.Content {\n\t\tif e.Kind != yaml.MappingNode {\n\t\t\treturn false\n\t\t}\n\t\tfor i := 0; i+1 < len(e.Content); i += 2 {\n\t\t\tval := e.Content[i+1]\n\t\t\tif val.Kind != yaml.ScalarNode {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tswitch e.Content[i].Value {\n\t\t\tcase \"file\", \"severity\", \"message\":\n\t\t\t\tif val.Tag != \"!!str\" {\n\t\t\t\t\treturn false\n\t\t\t\t}\n\t\t\tcase \"line\":\n\t\t\t\tif val.Tag != \"!!int\" {\n\t\t\t\t\treturn false\n\t\t\t\t}\n\t\t\tcase \"blocking\":\n\t\t\t\tif val.Tag != \"!!bool\" {\n\t\t\t\t\treturn false\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn true\n}\n\n// fetchedTypes checks the scalar tags of a fetched sequence.\nfunc fetchedTypes(v *yaml.Node) bool {\n\tif v.Kind != yaml.SequenceNode {\n\t\treturn false\n\t}\n\tfor _, e := range v.Content {\n\t\tif e.Kind != yaml.MappingNode {\n\t\t\treturn false\n\t\t}\n\t\tfor i := 0; i+1 < len(e.Content); i += 2 {\n\t\t\tval := e.Content[i+1]\n\t\t\tif val.Kind != yaml.ScalarNode {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tswitch e.Content[i].Value {\n\t\t\tcase \"url\", \"sha256\", \"verified_by\", \"path\":\n\t\t\t\tif val.Tag != \"!!str\" {\n\t\t\t\t\treturn false\n\t\t\t\t}\n\t\t\tcase \"date\":\n\t\t\t\tif val.Tag != \"!!str\" && val.Tag != \"!!timestamp\" {\n\t\t\t\t\treturn false\n\t\t\t\t}\n\t\t\tcase \"status\":\n\t\t\t\tif val.Tag != \"!!int\" {\n\t\t\t\t\treturn false\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn true\n}\n\n// checkTypes rejects scalars yaml.v3 would coerce: role, status, verdict and\n// worker must be strings, attempt an integer, next a list of strings.\nfunc checkTypes(front string) error {\n\tvar doc yaml.Node\n\tif err := yaml.Unmarshal([]byte(front), &doc); err != nil || len(doc.Content) == 0 {\n\t\treturn malformed(\"frontmatter: unreadable\")\n\t}\n\tm := doc.Content[0]\n\tif m.Kind != yaml.MappingNode {\n\t\treturn malformed(\"frontmatter is not a mapping\")\n\t}\n\tfor i := 0; i+1 < len(m.Content); i += 2 {\n\t\tkey, v := m.Content[i].Value, m.Content[i+1]\n\t\tok := true\n\t\tswitch key {\n\t\tcase \"role\", \"status\", \"verdict\", \"worker\":\n\t\t\tok = v.Kind == yaml.ScalarNode && v.Tag == \"!!str\"\n\t\tcase \"attempt\":\n\t\t\tok = v.Kind == yaml.ScalarNode && v.Tag == \"!!int\"\n\t\tcase \"findings\":\n\t\t\tok = findingsTypes(v)\n\t\tcase \"fetched\":\n\t\t\tok = fetchedTypes(v)\n\t\tcase \"next\":\n\t\t\tok = v.Kind == yaml.SequenceNode\n\t\t\tfor _, e := range v.Content {\n\t\t\t\tif e.Kind != yaml.ScalarNode || e.Tag != \"!!str\" {\n\t\t\t\t\tok = false\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif !ok {\n\t\t\treturn malformed(\"field %s: wrong type\", key)\n\t\t}\n\t}\n\treturn nil\n}\n","numLines":558,"startLine":1,"totalLines":558}},"tool_result_meta":[{"id":"toolu_01LFbTTPhgCypyYpkvcDUz8R","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
