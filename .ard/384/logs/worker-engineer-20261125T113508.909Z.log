ost\", \"needs-network\", \"network:\\n\" + entry(\"a\", \"https:///x\", \"b\"), \"host\"},\n\t\t{\"backtick\", \"needs-network\", \"network:\\n\" + entry(\"a\", `\"https://example.com/a`+\"`\"+`b\"`, \"b\"), \"forbidden\"},\n\t\t{\"url 300\", \"needs-network\", \"network:\\n\" + entry(\"a\", \"https://example.com/\"+pad(300-20), \"b\"), \"\"},\n\t\t{\"url 301\", \"needs-network\", \"network:\\n\" + entry(\"a\", \"https://example.com/\"+pad(301-20), \"b\"), \"max 300\"},\n\t\t{\"what 200\", \"needs-network\", \"network:\\n\" + entry(pad(200), \"https://example.com/a\", \"b\"), \"\"},\n\t\t{\"what 201\", \"needs-network\", \"network:\\n\" + entry(pad(201), \"https://example.com/a\", \"b\"), \"what is over\"},\n\t\t{\"why 200 multibyte\", \"needs-network\", \"network:\\n\" + entry(strings.Repeat(\"é\", 200), \"https://example.com/a\", \"b\"), \"\"},\n\t\t{\"verify 201\", \"needs-network\", \"network:\\n\" + ok + \"    verify: \" + pad(201) + \"\\n\", \"verify is over\"},\n\t\t{\"multi-line\", \"needs-network\", \"network:\\n  - what: |\\n      a\\n      b\\n    url: https://example.com/a\\n    why: c\\n\", \"one line\"},\n\t\t{\"missing what\", \"needs-network\", \"network:\\n  - url: https://example.com/a\\n    why: c\\n\", \"missing what\"},\n\t\t{\"empty why\", \"needs-network\", \"network:\\n\" + entry(\"a\", \"https://example.com/a\", `\"\"`), \"empty why\"},\n\t\t{\"unknown key\", \"needs-network\", \"network:\\n\" + ok + \"    extra: 1\\n\", \"frontmatter\"},\n\t\t{\"non-string\", \"needs-network\", \"network:\\n\" + entry(\"5\", \"https://example.com/a\", \"b\"), \"wrong type\"},\n\t\t{\"second entry bad\", \"needs-network\", \"network:\\n\" + ok + entry(\"a\", \"http://x.com\", \"b\"), \"network 2\"},\n\t}\n\tfor _, c := range tests {\n\t\tt.Run(c.name, func(t *testing.T) {\n\t\t\trf, err := Parse(doc(c.status, c.list))\n\t\t\tif c.bad == \"\" {\n\t\t\t\tif err != nil || rf.Status != StatusNeedsNetwork || len(rf.Network) == 0 {\n\t\t\t\t\tt.Fatalf(\"got %+v %