n, f.name)\n\t\t\t}\n\t\t\tif utf8.RuneCountInString(f.val) > MaxNetworkText {\n\t\t\t\treturn nil, malformed(\"network %d: %s is over %d characters\", n, f.name, MaxNetworkText)\n\t\t\t}\n\t\t\tfor _, c := range f.val {\n\t\t\t\tif c < ' ' || c == 0x7f || c == 0x85 || c == 0x2028 || c == 0x2029 {\n\t\t\t\t\treturn nil, malformed(\"network %d: %s is not one line of text\", n, f.name)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tout = append(out, v)\n\t}\n\treturn out, nil\n}\n\nfunc isSHA256''')\nr('''// checkTypes rejects''','''// networkTypes checks the scalar tags of a network sequence.\nfunc networkTypes(v *yaml.Node) bool {\n\tif v.Kind != yaml.SequenceNode {\n\t\treturn false\n\t}\n\tfor _, e := range v.Content {\n\t\tif e.Kind != yaml.MappingNode {\n\t\t\treturn false\n\t\t}\n\t\tfor i := 0; i+1 < len(e.Content); i += 2 {\n\t\t\tval := e.Content[i+1]\n\t\t\tif val.Kind != yaml.ScalarNode || val.Tag != \"!!str\" {\n\t\t\t\treturn false\n\t\t\t}\n\t\t}\n\t}\n\treturn true\n}\n\n// checkTypes rejects''')\nr('''\t\tcase \"next\":\n\t\t\tok = v.Kind''','''\t\tcase \"network\":\n\t\t\tok = networkTypes(v)\n\t\tcase \"next\":\n\t\t\tok = v.Kind''')\nopen(p,'w').write(s)\nEOF\ngofmt -w rolefile.go\nsed -n 140,175p prepare.go; sed -n 225,260p prepare.go; grep -n \"OutcomeNeedsHuman\" *.go ../costs/rows.go ../reaper/*.go | grep -v _test"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":176,"cache_read_input_tokens":24195,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":176},"output_tokens":33,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3a5d70df-8962-4f03-b6fe-f2bd674bf92a","uuid":"2c600c5f-b484-4a27-8fbd-de11b531bb33","timestamp":"2026-11-25T11:35:27.431Z","request_id":"req_011ChPaPY1uzePTSrptMQT9r"}
