_test.go\n256\t+++ b/internal/closeout/prepare_test.go\n257\t@@ -366,3 +366,44 @@ func TestPrepareWorkerIgnoresTriageFileOfSameRole(t *testing.T) {\n258\t \t\t})\n259\t \t}\n260\t }\n261\t+\n262\t+func TestPrepareNeedsNetwork(t *testing.T) {\n263\t+\tdoc := func(what string) string {\n264\t+\t\treturn \"---\\nrole: engineer\\nstatus: needs-network\\nattempt: 1\\nnetwork:\\n  - what: \" + what +\n265\t+\t\t\t\"\\n    url: https://example.com/spec.json\\n    why: need it\\n---\\nCould not fetch.\\n\"\n266\t+\t}\n267\t+\ttests := []struct {\n268\t+\t\tname    string\n269\t+\t\twhat    string\n270\t+\t\toutcome Outcome\n271\t+\t\treason  string\n272\t+\t}{\n273\t+\t\t{\"valid list carried\", \"the spec\", OutcomeNeedsNetwork, \"\"},\n274\t+\t\t{\"list damaged by redaction\", secretValue, OutcomeNeedsHuman, \"network list unreadable after redaction\"},\n275\t+\t}\n276\t+\tfor _, c := range tests {\n277\t+\t\tt.Run(c.name, func(t *testing.T) {\n278\t+\t\t\te := newEnv(t)\n279\t+\t\t\tj := e.claim(StageWorker, \"engineer\")\n280\t+\t\t\tj.PR, j.Worker = 0, &WorkerResult{Tests: TestsNone}\n281\t+\t\t\te.write(\".ard/7/worker-engineer.md\", doc(c.what))\n282\t+\t\t\trec, err := Prepare(context.Background(), j, e.d)\n283\t+\t\t\tif err != nil {\n284\t+\t\t\t\tt.Fatal(err)\n285\t+\t\t\t}\n286\t+\t\t\tp := rec.Plan\n287\t+\t\t\tif p.Outcome != c.outcome || !strings.Contains(p.Reason, c.reason) {\n288\t+\t\t\t\tt.Fatalf(\"outcome %q reason %q\", p.Outcome, p.Reason)\n289\t+\t\t\t}\n290\t+\t\t\tif c.outcome == OutcomeNeedsNetwork && (len(p.Network) != 1 || p.Network[0].What != c.what) {\n291\t+\t\t\t\tt.Errorf(\"network: %+v\", p.Network)\n292\t+\t\t\t}\n293\t+\t\t\tif c.outcome == OutcomeNeedsHuman && len(p.Network) != 0 {\n294\t+\t\t\t\tt.Errorf(\"network kept: %+v\", p.Network)\n295\t+\t\t\t}\n296\t+\t\t\tif got := lbls(p.Terminal); len(got) != 1 || got[0] != \"7:ard:needs-human\" {\n297\t+\t\t\t\tt.Errorf(\"terminal %v\", got)\n298\t+\t\t\t}\n299\t+\t\t})\n300\t+\t}\n301\t+}\