f text\", n, f.name)\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\t\tout = append(out, v)\n+\t}\n+\treturn out, nil\n+}\n+\n func isSHA256(s string) bool {\n \tif len(s) != 64 {\n \t\treturn false\n@@ -518,6 +603,25 @@ func fetchedTypes(v *yaml.Node) bool {\n \treturn true\n }\n \n+// networkTypes checks the scalar tags of a network sequence.\n+func networkTypes(v *yaml.Node) bool {\n+\tif v.Kind != yaml.SequenceNode {\n+\t\treturn false\n+\t}\n+\tfor _, e := range v.Content {\n+\t\tif e.Kind != yaml.MappingNode {\n+\t\t\treturn false\n+\t\t}\n+\t\tfor i := 0; i+1 < len(e.Content); i += 2 {\n+\t\t\tval := e.Content[i+1]\n+\t\t\tif val.Kind != yaml.ScalarNode || val.Tag != \"!!str\" {\n+\t\t\t\treturn false\n+\t\t\t}\n+\t\t}\n+\t}\n+\treturn true\n+}\n+\n // checkTypes rejects scalars yaml.v3 would coerce: role, status, verdict and\n // worker must be strings, attempt an integer, next a list of strings.\n func checkTypes(front string) error {\n@@ -541,6 +645,8 @@ func checkTypes(front string) error {\n \t\t\tok = findingsTypes(v)\n \t\tcase \"fetched\":\n \t\t\tok = fetchedTypes(v)\n+\t\tcase \"network\":\n+\t\t\tok = networkTypes(v)\n \t\tcase \"next\":\n \t\t\tok = v.Kind == yaml.SequenceNode\n \t\t\tfor _, e := range v.Content {\ndiff --git a/internal/closeout/rolefile_test.go b/internal/closeout/rolefile_test.go\nindex 9b6bf6a..f9a9d64 100644\n--- a/internal/closeout/rolefile_test.go\n+++ b/internal/closeout/rolefile_test.go\n@@ -234,3 +234,71 @@ func TestCheckFetchedStage(t *testing.T) {\n \t\t}\n \t}\n }\n+\n+func TestParseNetwork(t *testing.T) {\n+\tdoc := func(status, list string) []byte {\n+\t\treturn []byte(\"---\\nrole: engineer\\nstatus: \" + status + \"\\nattempt: 1\\n\" + list + \"---\\nx\\n\")\n+\t}\n+\tentry := func(what, url, why string) string {\n+\t\treturn \"  - what: \" + what + \"\\n    url: \" + url + \"\\n    why: \" + why + \"\\n\"\n+\t}\n+\tok := entry(\"spec\", \"https://example.com/a\", \"need\")\n+\tpad := func(n int) string { return strings.Repeat(\