config/types.go                 |   3 +\n internal/controller/approvals.go         | 170 +++++++++++++++++++++++++++++++\n internal/controller/approvals_test.go    | 151 +++++++++++++++++++++++++++\n internal/controller/controller.go        |  84 +++++++++++++++\n internal/controller/wake_test.go         | 111 ++++++++++++++++++++\n internal/servecmd/loops_test.go          |   2 +-\n internal/servecmd/reaping.go             |   1 +\n internal/servecmd/rebuild_test.go        |   2 +-\n internal/servecmd/serve.go               |  10 +-\n internal/servecmd/wake.go                |  10 ++\n internal/servecmd/wake_test.go           |   9 ++\n 22 files changed, 772 insertions(+), 9 deletions(-)\n\ndiff --git a/docs/proposal.md b/docs/proposal.md\nindex abfbd0f..dcae720 100644\n--- a/docs/proposal.md\n+++ b/docs/proposal.md\n@@ -307,7 +307,7 @@ Local-executor details: the role directory (and its `Dockerfile`) is mounted fro\n \n A worker job is several executor jobs (`<id>`, `<id>t1`, `<id>f1`, ...) under one state job and one slot; the Reaper watches whichever step is stored on the job, so its heartbeat and deadline rules apply to tests too.\n \n-**One pool of job slots, drained from the end.** At most `max_pods` jobs (default 3) run at once, shared by every loop. When a slot frees, the controller fills it in this order: reviewers, then workers, then triage, then scanners. Within a class, the priority labels `ard:p0`..`ard:p3` order candidates (unlabelled = P2, several = the highest), then oldest first. Priority never crosses classes: a P3 review still starts before a P0 triage job, and at most a P0 waits for work already finishing. A relabel takes effect on the next poll. Triage and workers also run one extra search per role per tick for `ard:p0`/`ard:p1`, so a P0 beyond the oldest 50 for its role is still found. Reviewers rank by the higher of the PR's and its linked issue's label; they search only PRs, so a P0 label that is only on the issue is ranked but not searched for beyond the oldest 50 (a gap we accept). A grant does not clear the `pool.starved` warning; it re-arms when the class has no wait over the threshold, and the warning names the key and priority of the oldest waiter. In dry-run the `would_claim` lines carry `priority` and come out in rank order. Finishing work in flight beats starting new work, so a busy day grows the scanner backlog, not the pile of half-done PRs. The merger and the Reaper are controller code and take no slot. Slots are granted when a loop polls and nothing is queued: a loop that found work waiting within the last two of its intervals has that demand reserved ahead of lower classes, so a freed slot would otherwise sit idle until that loop's next poll. To avoid that, a released slot (or a raised `max_pods`) wakes the loops with live demand for one tick, after a short debounce (default 2s) so a burst of releases makes one wake; those loops offer as usual, so class order and reservations still decide, and a paused controller ignores the wake. The merger, prwatch and scanners are never woken this way. A scanner run that gets no slot is skipped, not queued. The pool also starts no agent job for an exhausted account or model family until its reset: a job that stops at a subscription usage limit records the limit (in the controller database, so a restart keeps it), and the pool answers `limited` to any candidate whose role runs on that account or family (a whole-account session or weekly limit blocks every role; an Opus or Sonnet limit blocks only roles on that family, and a role with no model, which runs the CLI default, is blocked by any limit). A limited candidate takes no slot and reserves no demand, so lower classes are not held back. The block ends at the reset time the CLI reported; when it reported none the first pause is 30 minutes and each further stop with no reset doubles it up to 4 hours, starting over once a job succeeds; a reset time further away than 8 days is clamped. Running jobs are never killed for a limit. Deterministic scanners and the merger use no model and are unaffected. A daily dollar cap works the same way at the same gate: the pool answers `budget` to a candidate whose role cap or the repo cap is reached, and that candidate takes no slot and reserves no demand. A job that already holds a slot keeps it and finishes.\n+**One pool of job slots, drained from the end.** At most `max_pods` jobs (default 3) run at once, shared by every loop. When a slot frees, the controller fills it in this order: reviewers, then workers, then triage, then scanners. Within a class, the priority labels `ard:p0`..`ard:p3` order candidates (unlabelled = P2, several = the highest), then oldest first. Priority never crosses classes: a P3 review still starts before a P0 triage job, and at most a P0 waits for work already finishing. A relabel takes effect on the next poll. Triage and workers also run one extra search per role per tick for `ard:p0`/`ard:p1`, so a P0 beyond the oldest 50 for its role is still found. Reviewers rank by the higher of the PR's and its linked issue's label; they search only PRs, so a P0 label that is only on the issue is ranked but not searched for beyond the oldest 50 (a gap we accept). A grant does not clear the `pool.starved` warning; it re-arms when the class has no wait over the threshold, and the warning names the key and priority of the oldest waiter. In dry-run the `would_claim` lines carry `priority` and come out in rank order. Finishing work in flight beats starting new work, so a busy day grows the scanner backlog, not the pile of half-done PRs. The merger and the Reaper are controller code and take no slot. Slots are granted when a loop polls and nothing is queued: a loop that found work waiting within the last two of its intervals has that demand reserved ahead of lower classes, so a freed slot would otherwise sit idle until that loop's next poll. To avoid that, a released slot (or a raised `max_pods`) wakes the loops with live demand for one tick, after a short debounce (default 2s) so a burst of releases makes one wake; those loops offer as usual, so class order and reservations still decide, and a paused controller ignores the wake. The merger, prwatch and scanners are never woken this way. Hand-offs wake the next loop too (#406): after its label effects succeed, a close-out wakes the loops that now have work (`ard:worker:<role>` wakes workers; `ard:review:<role>` reviewers; `ard:triage:<role>`, `ard:pending` and a triage `:done` label triage, whose fan-in gate adds the worker label; a review `:done` the merger; a review `:changes` reviewfix and workers), through the same debounced per-loop wake, logged as `controller.wake reason=closeout`. A failed, retried, stale or needs-human close-out wakes nothing, and dry-run wakes nothing. A human approval comes from GitHub, so ard polls for it: the approval watch is a controller loop that takes no slot and runs no agent. Every `intervals.approvals` (default and minimum 1m) it makes three searches (`ard:approved`, `ard:needs-human`, `ard:executor:failed` on open items). An approved item with no worker label wakes triage (`reason=approval`); an item that was blocked on the previous poll and no longer is wakes the loops that own it (`reason=unblocked`; the watch keeps the blocked set in memory, so a removal during a restart is left to the loops' own intervals). The woken loop does the real check: the triage gate still requires the approval to come from an allowed actor after triage finished, so a rejected approval starts no worker. A paused controller skips the watch and runs nothing on a wake. The full triage poll keeps its own interval. A scanner run that gets no slot is skipped, not queued. The pool also starts no agent job for an exhausted account or model family until its reset: a job that stops at a subscription usage limit records the limit (in the controller database, so a restart keeps it), and the pool answers `limited` to any candidate whose role runs on that account or family (a whole-account session or weekly limit blocks every role; an Opus or Sonnet limit blocks only roles on that family, and a role with no model, which runs the CLI default, is blocked by any limit). A limited candidate takes no slot and reserves no demand, so lower classes are not held back. The block ends at the reset time the CLI reported; when it reported none the first pause is 30 minutes and each further stop with no reset doubles it up to 4 hours, starting over once a job succeeds; a reset time further away than 8 days is clamped. Running jobs are never killed for a limit. Deterministic scanners and the merger use no model and are unaffected. A daily dollar cap works the same way at the same gate: the pool answers `budget` to a candidate whose role cap or the repo cap is reached, and that candidate takes no slot and reserves no demand. A job that already holds a slot keeps it and finishes.\n \n |  | Local executor | Kubernetes executor |\n | --- | --- | --- |\n@@ -471,7 +471,7 @@ budget_usd_per_day: 50       # whole repo, UTC day, blocks at spent >= cap; a ro\n max_budget_usd: 5            # per job; provisional, same recalibration\n global_max_open: 30          # open scanner issues across all scanners\n paused: false\n-intervals: { scanners: 4h, triage: 15m, workers: 5m, reviewers: 5m, merger: 5m, prwatch: 5m }\n+intervals: { scanners: 4h, triage: 15m, workers: 5m, reviewers: 5m, merger: 5m, prwatch: 5m, approvals: 1m }\n pr_watch: { pending_timeout: 2h }   # at least intervals.prwatch, at most 7d\n intake: { mode: label }     # mode: all | label; label (label mode only) defaults to ard:pending, must start with ard: and must not be one of ard's own labels\n merge:                       # defaults written by `ard init`; the list is the only source (no floor in code)\ndiff --git a/docs/site/configuration.md b/docs/site/configuration.md\nindex d742a31..b14978b 100644\n--- a/docs/site/configuration.md\n+++ b/docs/site/configuration.md\n@@ -28,6 +28,7 @@ Durations are Go-style strings such as `30m` or `4h`; `d` is not accepted, so wr\n | `intervals.reviewers` | `5m` | Reviewer loop poll |\n | `intervals.merger` | `5m` | Merger loop poll |\n | `intervals.prwatch` | `5m` | PR watch loop poll (minimum `1m`): checks ard's open pull requests for human merges, closes without merge, long-pending checks and red drafts |\n+| `intervals.approvals` | `1m` | Approval watch poll (minimum `1m`): one cheap search for a human adding `ard:approved` or removing `ard:needs-human` or `ard:executor:failed`; a hit wakes the loop that owns the item, so the triage interval can stay long |\n | `pr_watch.pending_timeout` | `2h` | How long a required check may stay pending before the PR watch flags it (at least the interval, at most `7d`) |\n \n The Reaper runs every minute and is not configurable.\ndiff --git a/internal/closeout/closeout.go b/internal/closeout/closeout.go\nindex bfe9ccd..91cb78f 100644\n--- a/internal/closeout/closeout.go\n+++ b/internal/closeout/closeout.go\n@@ -330,6 +330,9 @@ type Deps struct {\n \tStagingDir string\n \tLog        *slog.Logger\n \tNow        func() time.Time\n+\t// Wake, when non-nil, is called once after a job is closed, with the\n+\t// loops that have new work (see WakeTargets). It must not block.\n+\tWake func(reason string, loops ...string)\n }\n \n func (d Deps) log() *slog.Logger {\n@@ -547,6 +550,7 @@ func (c *Closer) advance(ctx context.Context, rec Record) (Outcome, error) {\n \tif err := c.save(ctx, rec); err != nil {\n \t\treturn \"\", err\n \t}\n+\tc.wake(rec)\n \tif err := os.RemoveAll(filepath.Join(c.d.StagingDir, rec.Job.ID)); err != nil {\n \t\tc.d.log().Warn(\"closeout: remove staging\", \"job\", rec.Job.ID, \"error\", err)\n \t}\ndiff --git a/internal/closeout/wake.go b/internal/closeout/wake.go\nnew file mode 100644\nindex 0000000..07679e2\n--- /dev/null\n+++ b/internal/closeout/wake.go\n@@ -0,0 +1,77 @@\n+package closeout\n+\n+import (\n+\t\"slices\"\n+\n+\t\"github.com/albertcbrown/ard/internal/labels\"\n+)\n+\n+// WakeReason is the reason close-out passes to Deps.Wake.\n+const WakeReason = \"closeout\"\n+\n+// WakeTargets names the controller loops that have work after a plan's label\n+// effects: the next stage the plan requested or unblocked. It is pure.\n+//\n+//\tard:worker:<role>            -> workers\n+//\tard:review:<role>            -> reviewers\n+//\tard:review:<role>:done       -> merger (the PR may now be ready)\n+//\tard:review:<role>:changes    -> reviewfix and workers (a review round)\n+//\tard:triage:<role>, :done, ard:pending -> triage (a request, or the fan-in gate)\n+//\n+// Only a plan that finished with outcome done or changes hands off; failed,\n+// retry, stale, usage-limit and needs-human plans return nil.\n+func WakeTargets(p Plan) []string {\n+\tif p.Outcome != OutcomeDone && p.Outcome != OutcomeChanges {\n+\t\treturn nil\n+\t}\n+\tvar out []string\n+\tadd := func(n ...string) {\n+\t\tfor _, x := range n {\n+\t\t\tif !slices.Contains(out, x) {\n+\t\t\t\tout = append(out, x)\n+\t\t\t}\n+\t\t}\n+\t}\n+\tfor _, l := range slices.Concat(p.Requests, p.Terminal) {\n+\t\tif l.Name == labels.Pending {\n+\t\t\tadd(\"triage\")\n+\t\t\tcontinue\n+\t\t}\n+\t\tparsed, ok := labels.Parse(l.Name)\n+\t\tif !ok || parsed.Kind != labels.KindRole {\n+\t\t\tcontinue\n+\t\t}\n+\t\tswitch parsed.Stage {\n+\t\tcase labels.StageTriage:\n+\t\t\tif parsed.State == labels.StateRequest || parsed.State == labels.StateDone {\n+\t\t\t\tadd(\"triage\")\n+\t\t\t}\n+\t\tcase labels.StageWorker:\n+\t\t\tif parsed.State == labels.StateRequest {\n+\t\t\t\tadd(\"workers\")\n+\t\t\t}\n+\t\tcase labels.StageReview:\n+\t\t\tswitch parsed.State {\n+\t\t\tcase labels.StateRequest:\n+\t\t\t\tadd(\"reviewers\")\n+\t\t\tcase labels.StateDone:\n+\t\t\t\tadd(\"merger\")\n+\t\t\tcase labels.StateChanges:\n+\t\t\t\tadd(\"reviewfix\", \"workers\")\n+\t\t\t}\n+\t\t}\n+\t}\n+\treturn out\n+}\n+\n+// wake tells the controller which loops to run now. It runs after every label\n+// effect succeeded and never in dry-run (nothing was written, so nothing\n+// changed for the next stage to see).\n+func (c *Closer) wake(rec Record) {\n+\tif c.d.Wake == nil || c.d.Effects.DryRun() {\n+\t\treturn\n+\t}\n+\tif names := WakeTargets(rec.Plan); len(names) > 0 {\n+\t\tc.d.Wake(WakeReason, names...)\n+\t}\n+}\ndiff --git a/internal/closeout/wake_test.go b/internal/closeout/wake_test.go\nnew file mode 100644\nindex 0000000..cd5caba\n--- /dev/null\n+++ b/internal/closeout/wake_test.go\n@@ -0,0 +1,120 @@\n+package closeout\n+\n+import (\n+\t\"context\"\n+\t\"reflect\"\n+\t\"sync\"\n+\t\"testing\"\n+)\n+\n+func TestWakeTargets(t *testing.T) {\n+\tl := func(n string) Label { return Label{1, n} }\n+\ttests := []struct {\n+\t\tname string\n+\t\tp    Plan\n+\t\twant []string\n+\t}{\n+\t\t{\"worker requested\", Plan{Outcome: OutcomeDone, Terminal: []Label{l(\"ard:triage:lead:done\"), l(\"ard:worker:engineer\")}}, []string{\"triage\", \"workers\"}},\n+\t\t{\"worker done requests reviewers\", Plan{Outcome: OutcomeDone, Requests: []Label{l(\"ard:review:a\"), l(\"ard:review:b\")}, Terminal: []Label{l(\"ard:worker:engineer:done\")}}, []string{\"reviewers\"}},\n+\t\t{\"lead requests triage\", Plan{Outcome: OutcomeDone, Requests: []Label{l(\"ard:triage:architect\")}, Terminal: []Label{l(\"ard:triage:lead:done\")}}, []string{\"triage\"}},\n+\t\t{\"pending\", Plan{Outcome: OutcomeDone, Terminal: []Label{l(\"ard:pending\")}}, []string{\"triage\"}},\n+\t\t{\"engineer done, fan-in\", Plan{Outcome: OutcomeDone, Terminal: []Label{l(\"ard:triage:engineer:done\")}}, []string{\"triage\"}},\n+\t\t{\"review passed\", Plan{Outcome: OutcomeDone, Terminal: []Label{l(\"ard:review:a:done\")}}, []string{\"merger\"}},\n+\t\t{\"review changes\", Plan{Outcome: OutcomeChanges, Terminal: []Label{l(\"ard:review:a:changes\")}}, []string{\"reviewfix\", \"workers\"}},\n+\t\t{\"worker done, nothing next\", Plan{Outcome: OutcomeDone, Terminal: []Label{l(\"ard:worker:engineer:done\")}}, nil},\n+\t\t{\"needs human\", Plan{Outcome: OutcomeNeedsHuman, Terminal: []Label{l(\"ard:needs-human\")}}, nil},\n+\t\t{\"failed\", Plan{Outcome: OutcomeFailed, Terminal: []Label{l(\"ard:executor:failed\")}}, nil},\n+\t\t{\"retry keeps request\", Plan{Outcome: OutcomeRetry, Requests: []Label{l(\"ard:worker:engineer\")}}, nil},\n+\t\t{\"stale\", Plan{Outcome: OutcomeStale}, nil},\n+\t}\n+\tfor _, tc := range tests {\n+\t\tt.Run(tc.name, func(t *testing.T) {\n+\t\t\tif got := WakeTargets(tc.p); !reflect.DeepEqual(got, tc.want) {\n+\t\t\t\tt.Errorf(\"WakeTargets = %v, want %v\", got, tc.want)\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+type wakeLog struct {\n+\tmu    sync.Mutex\n+\tcalls [][]string\n+}\n+\n+func (w *wakeLog) wake(reason string, loops ...string) {\n+\tw.mu.Lock()\n+\tdefer w.mu.Unlock()\n+\tw.calls = append(w.calls, append([]string{reason}, loops...))\n+}\n+\n+func TestCloseoutWakesNextLoops(t *testing.T) {\n+\te := newEnv(t)\n+\tj := e.lead()\n+\tvar w wakeLog\n+\te.d.Wake = w.wake\n+\tif _, err := New(e.d).Run(context.Background(), j); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\twant := [][]string{{\"closeout\", \"triage\"}}\n+\tif !reflect.DeepEqual(w.calls, want) {\n+\t\tt.Errorf(\"wakes = %v, want %v\", w.calls, want)\n+\t}\n+\t// A second Run of the closed job wakes nothing more.\n+\tif _, err := New(e.d).Run(context.Background(), j); err != nil || len(w.calls) != 1 {\n+\t\tt.Errorf(\"rerun: %v, wakes %v\", err, w.calls)\n+\t}\n+}\n+\n+func TestCloseoutReviewChangesWakes(t *testing.T) {\n+\te := newEnv(t)\n+\te.write(\".ard/7/review-eng-review.md\", roleFile(\"eng-review\", \"done\", \"verdict: changes\"))\n+\tj := e.claim(StageReview, \"eng-review\")\n+\tvar w wakeLog\n+\te.d.Wake = w.wake\n+\tif _, err := New(e.d).Run(context.Background(), j); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif want := [][]string{{\"closeout\", \"reviewfix\", \"workers\"}}; !reflect.DeepEqual(w.calls, want) {\n+\t\tt.Errorf(\"wakes = %v, want %v\", w.calls, want)\n+\t}\n+}\n+\n+func TestCloseoutNoWakeWhenEffectFailsThenOnResume(t *testing.T) {\n+\te := newEnv(t)\n+\tj := e.lead()\n+\tvar w wakeLog\n+\td := e.deps(2)\n+\td.Wake = w.wake\n+\tif _, err := New(d).Run(context.Background(), j); err == nil {\n+\t\tt.Fatal(\"want an error\")\n+\t}\n+\tif len(w.calls) != 0 {\n+\t\tt.Fatalf(\"woke after a failed effect: %v\", w.calls)\n+\t}\n+\td = e.deps(0)\n+\td.Wake = w.wake\n+\tif _, err := New(d).Run(context.Background(), j); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif len(w.calls) != 1 {\n+\t\tt.Errorf(\"wakes after resume = %v, want one\", w.calls)\n+\t}\n+}\n+\n+type dryEffects struct{ Effects }\n+\n+func (dryEffects) DryRun() bool { return true }\n+\n+func TestCloseoutDryRunNoWake(t *testing.T) {\n+\te := newEnv(t)\n+\tj := e.lead()\n+\tvar w wakeLog\n+\te.d.Wake = w.wake\n+\te.d.Effects = dryEffects{e.d.Effects}\n+\tif _, err := New(e.d).Run(context.Background(), j); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif len(w.calls) != 0 {\n+\t\tt.Errorf(\"dry-run woke %v\", w.calls)\n+\t}\n+}\ndiff --git a/internal/config/defaults.go b/internal/config/defaults.go\nindex 43e0dce..2bc5016 100644\n--- a/internal/config/defaults.go\n+++ b/internal/config/defaults.go\n@@ -29,6 +29,7 @@ const (\n \tdefaultIntervalReviewers = Duration(5 * time.Minute)\n \tdefaultIntervalMerger    = Duration(5 * time.Minute)\n \tdefaultIntervalPRWatch   = Duration(5 * time.Minute)\n+\tdefaultIntervalApprovals = Duration(1 * time.Minute)\n \n \tdefaultPRWatchPendingTimeout = Duration(2 * time.Hour)\n \tmaxPRWatchPendingTimeout     = Duration(7 * 24 * time.Hour)\n@@ -73,6 +74,7 @@ func newResolved(repoRoot string) *Resolved {\n \t\t\tReviewers: defaultIntervalReviewers,\n \t\t\tMerger:    defaultIntervalMerger,\n \t\t\tPRWatch:   defaultIntervalPRWatch,\n+\t\t\tApprovals: defaultIntervalApprovals,\n \t\t},\n \t\tPRWatch: PRWatch{PendingTimeout: defaultPRWatchPendingTimeout},\n \t\tIntake:  Intake{Mode: defaultIntakeMode},\n@@ -153,6 +155,7 @@ func applyGlobals(res *Resolved, raw rawConfig, cfgPath string) Errors {\n \tres.Intervals.Reviewers = intervalOr(raw.intervals.reviewers, res.Intervals.Reviewers)\n \tres.Intervals.Merger = intervalOr(raw.intervals.merger, res.Intervals.Merger)\n \tres.Intervals.PRWatch = intervalOr(raw.intervals.prwatch, res.Intervals.PRWatch)\n+\tres.Intervals.Approvals = intervalOr(raw.intervals.approvals, res.Intervals.Approvals)\n \tfor _, iv := range []struct {\n \t\tkey string\n \t\td   Duration\n@@ -163,6 +166,7 @@ func applyGlobals(res *Resolved, raw rawConfig, cfgPath string) Errors {\n \t\t{\"intervals.reviewers\", res.Intervals.Reviewers},\n \t\t{\"intervals.merger\", res.Intervals.Merger},\n \t\t{\"intervals.prwatch\", res.Intervals.PRWatch},\n+\t\t{\"intervals.approvals\", res.Intervals.Approvals},\n \t} {\n \t\tif iv.d < minLoopInterval {\n \t\t\terrs = append(errs, &Error{File: cfgPath, Key: iv.key, Msg: fmt.Sprintf(\"must be at least 1m (the Reaper alone runs every minute), got %s\", iv.d)})\ndiff --git a/internal/config/keys.go b/internal/config/keys.go\nindex b3d3faa..48e0a16 100644\n--- a/internal/config/keys.go\n+++ b/internal/config/keys.go\n@@ -10,7 +10,7 @@ func Keys() []string {\n \t\t\"max_pods\", \"executor\", \"agent\", \"require_approval\",\n \t\t\"budget_usd_per_day\", \"tokens_per_day\", \"max_budget_usd\", \"global_max_open\", \"paused\",\n \t\t\"intervals.scanners\", \"intervals.triage\", \"intervals.workers\",\n-\t\t\"intervals.reviewers\", \"intervals.merger\", \"intervals.prwatch\",\n+\t\t\"intervals.reviewers\", \"intervals.merger\", \"intervals.prwatch\", \"intervals.approvals\",\n \t\t\"pr_watch.pending_timeout\", \"roles_repo\",\n \t\t\"intake.mode\", \"intake.label\",\n \t\t\"merge.protected_paths\",\ndiff --git a/internal/config/load_test.go b/internal/config/load_test.go\nindex 207e87d..d26b728 100644\n--- a/internal/config/load_test.go\n+++ b/internal/config/load_test.go\n@@ -86,6 +86,7 @@ func TestLoadDefaults(t *testing.T) {\n \t\tReviewers: Duration(5 * time.Minute),\n \t\tMerger:    Duration(5 * time.Minute),\n \t\tPRWatch:   Duration(5 * time.Minute),\n+\t\tApprovals: Duration(time.Minute),\n \t}\n \tif res.Intervals != wantIntervals {\n \t\tt.Errorf(\"Intervals = %+v, want %+v\", res.Intervals, wantIntervals)\n@@ -706,6 +707,11 @@ func TestLoadErrors(t *testing.T) {\n \t\t\tyaml: \"intervals: {scannerz: 4h}\\n\",\n \t\t\twant: []wantErr{{\".ard/config.yaml\", \"intervals.scannerz\", \"unknown key\"}},\n \t\t},\n+\t\t{\n+\t\t\tname: \"approvals interval below minimum\",\n+\t\t\tyaml: \"intervals: {approvals: 30s}\\n\",\n+\t\t\twant: []wantErr{{\".ard/config.yaml\", \"intervals.approvals\", \"must be at least 1m\"}},\n+\t\t},\n \t\t{\n \t\t\tname: \"prwatch interval below minimum\",\n \t\t\tyaml: \"intervals: {prwatch: 30s}\\n\",\ndiff --git a/internal/config/raw.go b/internal/config/raw.go\nindex 7bfa679..b74ead7 100644\n--- a/internal/config/raw.go\n+++ b/internal/config/raw.go\n@@ -42,7 +42,7 @@ type rawConfig struct {\n // rawIntervals keeps every interval optional so defaults can tell \"unset\"\n // apart from an explicit value.\n type rawIntervals struct {\n-\tscanners, triage, workers, reviewers, merger, prwatch *Duration\n+\tscanners, triage, workers, reviewers, merger, prwatch, approvals *Duration\n }\n \n // rawIntake keeps both keys optional so defaults can tell \"unset\" apart\n@@ -186,12 +186,13 @@ func (ri *rawIntervals) parse(n *yaml.Node, file, prefix string) Errors {\n \tset(\"reviewers\", &ri.reviewers)\n \tset(\"merger\", &ri.merger)\n \tset(\"prwatch\", &ri.prwatch)\n+\tset(\"approvals\", &ri.approvals)\n \tfor i := 0; i < len(n.Content); i += 2 {\n \t\tname := n.Content[i].Value\n \t\tswitch name {\n-\t\tcase \"scanners\", \"triage\", \"workers\", \"reviewers\", \"merger\", \"prwatch\":\n+\t\tcase \"scanners\", \"triage\", \"workers\", \"reviewers\", \"merger\", \"prwatch\", \"approvals\":\n \t\tdefault:\n-\t\t\terrs = append(errs, &Error{File: file, Key: prefix + \".\" + name, Msg: \"unknown key (want one of scanners, triage, workers, reviewers, merger, prwatch)\"})\n+\t\t\terrs = append(errs, &Error{File: file, Key: prefix + \".\" + name, Msg: \"unknown key (want one of scanners, triage, workers, reviewers, merger, prwatch, approvals)\"})\n \t\t}\n \t}\n \treturn errs\ndiff --git a/internal/config/render.go b/internal/config/render.go\nindex 23c3432..daa7994 100644\n--- a/internal/config/render.go\n+++ b/internal/config/render.go\n@@ -48,6 +48,7 @@ type intervalsYAML struct {\n \tReviewers Duration `yaml:\"reviewers\"`\n \tMerger    Duration `yaml:\"merger\"`\n \tPRWatch   Duration `yaml:\"prwatch\"`\n+\tApprovals Duration `yaml:\"approvals\"`\n }\n \n type intakeYAML struct {\n@@ -146,6 +147,7 @@ func (r *Resolved) render() resolvedYAML {\n \t\t\tReviewers: r.Intervals.Reviewers,\n \t\t\tMerger:    r.Intervals.Merger,\n \t\t\tPRWatch:   r.Intervals.PRWatch,\n+\t\t\tApprovals: r.Intervals.Approvals,\n \t\t},\n \t\tIntake:         intakeYAML{Mode: r.Intake.Mode, Label: r.Intake.Label},\n \t\tProtectedPaths: r.ProtectedPaths,\ndiff --git a/internal/config/testdata/resolved.golden b/internal/config/testdata/resolved.golden\nindex 8fb163f..59883cb 100644\n--- a/internal/config/testdata/resolved.golden\n+++ b/internal/config/testdata/resolved.golden\n@@ -14,6 +14,7 @@ intervals:\n   reviewers: 5m\n   merger: 5m\n   prwatch: 10m\n+  approvals: 1m\n intake:\n   mode: label\n protected_paths:\ndiff --git a/internal/config/types.go b/internal/config/types.go\nindex 3e3ff2d..613a948 100644\n--- a/internal/config/types.go\n+++ b/internal/config/types.go\n@@ -45,6 +45,9 @@ type Intervals struct {\n \tReviewers Duration // default 5m\n \tMerger    Duration // default 5m\n \tPRWatch   Duration // default 5m\n+\t// Approvals is the approval watch poll: one cheap search that wakes the\n+\t// loop owning an approved or unblocked item (#406); default 1m.\n+\tApprovals Duration\n }\n \n // PRWatch configures the PR watch loop (#267).\ndiff --git a/internal/controller/approvals.go b/internal/controller/approvals.go\nnew file mode 100644\nindex 0000000..cb9eee9\n--- /dev/null\n+++ b/internal/controller/approvals.go\n@@ -0,0 +1,170 @@\n+package controller\n+\n+import (\n+\t\"context\"\n+\t\"fmt\"\n+\t\"slices\"\n+\t\"sync\"\n+\t\"time\"\n+\n+\t\"github.com/albertcbrown/ard/internal/config\"\n+\t\"github.com/albertcbrown/ard/internal/github\"\n+\t\"github.com/albertcbrown/ard/internal/labels\"\n+)\n+\n+// ApprovalsName is the name of the approval watch loop.\n+const ApprovalsName = \"approvals\"\n+\n+// Wake reasons logged as controller.wake reason=....\n+const (\n+\tWakeCloseout  = \"closeout\"\n+\tWakeApproval  = \"approval\"\n+\tWakeUnblocked = \"unblocked\"\n+)\n+\n+// ApprovalWatch is the controller's cheap poll for human hand-offs (#406): a\n+// person adding ard:approved, or removing ard:needs-human or\n+// ard:executor:failed. It runs no agent, takes no slot and only reads from\n+// GitHub; a hit wakes the loop that owns the item, and that loop's own gate\n+// does the real check (who approved, and after triage finished).\n+type ApprovalWatch struct {\n+\t// Search is github.Reader.SearchIssues.\n+\tSearch func(ctx context.Context, q string, o github.SearchOpts) ([]github.Issue, error)\n+\t// Wake is Controller.WakeLoops. A nil Wake makes the watch do nothing.\n+\tWake func(reason string, names ...string)\n+\t// Paused, when non-nil and true, skips the poll (the kill switch).\n+\tPaused func(ctx context.Context) bool\n+\n+\tmu      sync.Mutex\n+\tstarted bool\n+\twoken   map[int]time.Time // approved items already woken for, by UpdatedAt\n+\tblocked map[int][]string  // items seen blocked -> loops that own them\n+}\n+\n+// Name implements Loop.\n+func (*ApprovalWatch) Name() string { return ApprovalsName }\n+\n+// Claims is false: the watch only reads, and checks the kill switch itself.\n+func (*ApprovalWatch) Claims() bool { return false }\n+\n+// Interval implements Loop.\n+func (*ApprovalWatch) Interval(cfg *config.Resolved) time.Duration {\n+\treturn time.Duration(cfg.Intervals.Approvals)\n+}\n+\n+// Tick implements Loop.\n+func (w *ApprovalWatch) Tick(ctx context.Context, env Env) error {\n+\tif w.Search == nil || w.Wake == nil {\n+\t\treturn nil\n+\t}\n+\tif w.Paused != nil && w.Paused(ctx) {\n+\t\treturn nil\n+\t}\n+\tw.mu.Lock()\n+\tdefer w.mu.Unlock()\n+\tif w.woken == nil {\n+\t\tw.woken, w.blocked = map[int]time.Time{}, map[int][]string{}\n+\t}\n+\topts := github.SearchOpts{Sort: \"updated\", Order: \"desc\", Max: 100}\n+\n+\tapproved, err := w.Search(ctx, `is:open label:\"`+labels.Approved+`\"`, opts)\n+\tif err != nil {\n+\t\treturn fmt.Errorf(\"approval watch: search approved: %w\", err)\n+\t}\n+\tvar hit bool\n+\tseen := map[int]bool{}\n+\tfor _, it := range approved {\n+\t\tseen[it.Number] = true\n+\t\tif it.IsPR || hasStage(it.Labels, labels.StageWorker) {\n+\t\t\tcontinue // the worker label is already there\n+\t\t}\n+\t\tif t, ok := w.woken[it.Number]; ok && t.Equal(it.UpdatedAt) {\n+\t\t\tcontinue\n+\t\t}\n+\t\tw.woken[it.Number] = it.UpdatedAt\n+\t\thit = true\n+\t}\n+\tfor n := range w.woken {\n+\t\tif !seen[n] {\n+\t\t\tdelete(w.woken, n)\n+\t\t}\n+\t}\n+\tif hit {\n+\t\tw.Wake(WakeApproval, \"triage\")\n+\t}\n+\n+\tblocked := map[int][]string{}\n+\tfor _, l := range []string{labels.NeedsHuman, labels.ExecutorFailed} {\n+\t\thits, err := w.Search(ctx, `is:open label:\"`+l+`\"`, opts)\n+\t\tif err != nil {\n+\t\t\treturn fmt.Errorf(\"approval watch: search %s: %w\", l, err)\n+\t\t}\n+\t\tfor _, it := range hits {\n+\t\t\tblocked[it.Number] = owners(it)\n+\t\t}\n+\t}\n+\t// A label removal cannot be searched for, so an item seen blocked that\n+\t// no longer is has been unblocked (or closed; a spare wake is harmless).\n+\t// After a restart the first poll has nothing to compare with; the loops'\n+\t// own ticks cover that gap.\n+\tvar wake []string\n+\tif w.started {\n+\t\tfor n, own := range w.blocked {\n+\t\t\tif _, still := blocked[n]; !still {\n+\t\t\t\twake = append(wake, own...)\n+\t\t\t}\n+\t\t}\n+\t}\n+\tw.blocked, w.started = blocked, true\n+\tif len(wake) > 0 {\n+\t\tw.Wake(WakeUnblocked, wake...)\n+\t}\n+\treturn nil\n+}\n+\n+func hasStage(ls []string, s labels.Stage) bool {\n+\tfor _, l := range ls {\n+\t\tif p, ok := labels.Parse(l); ok && p.Kind == labels.KindRole && p.Stage == s {\n+\t\t\treturn true\n+\t\t}\n+\t}\n+\treturn false\n+}\n+\n+// owners names the loops that act on an item, from its labels.\n+func owners(it github.Issue) []string {\n+\tvar out []string\n+\tadd := func(n string) {\n+\t\tif !slices.Contains(out, n) {\n+\t\t\tout = append(out, n)\n+\t\t}\n+\t}\n+\tfor _, l := range it.Labels {\n+\t\tif l == labels.Pending {\n+\t\t\tadd(\"triage\")\n+\t\t}\n+\t\tp, ok := labels.Parse(l)\n+\t\tif !ok || p.Kind != labels.KindRole {\n+\t\t\tcontinue\n+\t\t}\n+\t\tswitch p.Stage {\n+\t\tcase labels.StageTriage:\n+\t\t\tadd(\"triage\")\n+\t\tcase labels.StageWorker:\n+\t\t\tadd(\"workers\")\n+\t\tcase labels.StageReview:\n+\t\t\tadd(\"reviewers\")\n+\t\t\tif p.State == labels.StateChanges {\n+\t\t\t\tadd(\"reviewfix\")\n+\t\t\t}\n+\t\t}\n+\t}\n+\tif len(out) == 0 {\n+\t\tif it.IsPR {\n+\t\t\tadd(\"reviewers\")\n+\t\t} else {\n+\t\t\tadd(\"triage\")\n+\t\t}\n+\t}\n+\treturn out\n+}\ndiff --git a/internal/controller/approvals_test.go b/internal/controller/approvals_test.go\nnew file mode 100644\nindex 0000000..ac58339\n--- /dev/null\n+++ b/internal/controller/approvals_test.go\n@@ -0,0 +1,151 @@\n+package controller\n+\n+import (\n+\t\"context\"\n+\t\"errors\"\n+\t\"reflect\"\n+\t\"sync\"\n+\t\"testing\"\n+\t\"time\"\n+\n+\t\"github.com/albertcbrown/ard/internal/config\"\n+\t\"github.com/albertcbrown/ard/internal/github\"\n+)\n+\n+type wakeRec struct {\n+\tmu   sync.Mutex\n+\tgot  []string\n+\tcall int\n+}\n+\n+func (w *wakeRec) wake(reason string, names ...string) {\n+\tw.mu.Lock()\n+\tdefer w.mu.Unlock()\n+\tw.got = append(w.got, reason+\":\"+join(names))\n+\tw.call++\n+}\n+\n+func join(ns []string) string {\n+\ts := \"\"\n+\tfor i, n := range ns {\n+\t\tif i > 0 {\n+\t\t\ts += \",\"\n+\t\t}\n+\t\ts += n\n+\t}\n+\treturn s\n+}\n+\n+// fakeSearch answers by label named in the query.\n+type fakeSearch struct {\n+\tapproved, needsHuman, failed []github.Issue\n+\terr                          error\n+\tqueries                      []string\n+}\n+\n+func (f *fakeSearch) search(_ context.Context, q string, _ github.SearchOpts) ([]github.Issue, error) {\n+\tf.queries = append(f.queries, q)\n+\tif f.err != nil {\n+\t\treturn nil, f.err\n+\t}\n+\tswitch q {\n+\tcase `is:open label:\"ard:approved\"`:\n+\t\treturn f.approved, nil\n+\tcase `is:open label:\"ard:needs-human\"`:\n+\t\treturn f.needsHuman, nil\n+\tcase `is:open label:\"ard:executor:failed\"`:\n+\t\treturn f.failed, nil\n+\t}\n+\treturn nil, errors.New(\"unexpected query \" + q)\n+}\n+\n+func watchTick(t *testing.T, w *ApprovalWatch) error {\n+\tt.Helper()\n+\tlog, _ := newLog()\n+\treturn w.Tick(context.Background(), Env{Log: log, Cfg: &config.Resolved{}})\n+}\n+\n+func TestApprovalWatchApprovedWakesTriageOnce(t *testing.T) {\n+\tfs := &fakeSearch{approved: []github.Issue{\n+\t\t{Number: 1, Labels: []string{\"ard:approved\", \"ard:triage:engineer:done\"}, UpdatedAt: time.Unix(10, 0)},\n+\t\t{Number: 2, Labels: []string{\"ard:approved\", \"ard:worker:engineer\"}}, // already has a worker label\n+\t}}\n+\trec := &wakeRec{}\n+\tw := &ApprovalWatch{Search: fs.search, Wake: rec.wake}\n+\tfor range 2 { // second poll: same item, same UpdatedAt: no second wake\n+\t\tif err := watchTick(t, w); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\tif want := []string{\"approval:triage\"}; !reflect.DeepEqual(rec.got, want) {\n+\t\tt.Errorf(\"wakes = %v, want %v\", rec.got, want)\n+\t}\n+\tfs.approved[0].UpdatedAt = time.Unix(20, 0) // re-approved\n+\t_ = watchTick(t, w)\n+\tif rec.call != 2 {\n+\t\tt.Errorf(\"wakes = %v, want a second after the update\", rec.got)\n+\t}\n+}\n+\n+func TestApprovalWatchNoHitNoWake(t *testing.T) {\n+\trec := &wakeRec{}\n+\tw := &ApprovalWatch{Search: (&fakeSearch{}).search, Wake: rec.wake}\n+\t_ = watchTick(t, w)\n+\t_ = watchTick(t, w)\n+\tif rec.call != 0 {\n+\t\tt.Errorf(\"wakes = %v\", rec.got)\n+\t}\n+}\n+\n+func TestApprovalWatchUnblockedWakesOwner(t *testing.T) {\n+\tfs := &fakeSearch{\n+\t\tneedsHuman: []github.Issue{{Number: 5, Labels: []string{\"ard:needs-human\", \"ard:worker:engineer:running\"}}},\n+\t\tfailed:     []github.Issue{{Number: 6, IsPR: true, Labels: []string{\"ard:executor:failed\", \"ard:review:sec:changes\"}}},\n+\t}\n+\trec := &wakeRec{}\n+\tw := &ApprovalWatch{Search: fs.search, Wake: rec.wake}\n+\t_ = watchTick(t, w) // first poll: baseline only\n+\tif rec.call != 0 {\n+\t\tt.Fatalf(\"baseline woke: %v\", rec.got)\n+\t}\n+\tfs.needsHuman, fs.failed = nil, nil\n+\t_ = watchTick(t, w)\n+\tif len(rec.got) != 1 || rec.got[0] != \"unblocked:workers,reviewers,reviewfix\" && rec.got[0] != \"unblocked:reviewers,reviewfix,workers\" {\n+\t\tt.Errorf(\"wakes = %v\", rec.got)\n+\t}\n+\t_ = watchTick(t, w)\n+\tif rec.call != 1 {\n+\t\tt.Errorf(\"repeat wake: %v\", rec.got)\n+\t}\n+}\n+\n+func TestApprovalWatchPausedDoesNothing(t *testing.T) {\n+\tfs := &fakeSearch{approved: []github.Issue{{Number: 1, Labels: []string{\"ard:approved\"}}}}\n+\trec := &wakeRec{}\n+\tw := &ApprovalWatch{Search: fs.search, Wake: rec.wake, Paused: func(context.Context) bool { return true }}\n+\t_ = watchTick(t, w)\n+\tif rec.call != 0 || len(fs.queries) != 0 {\n+\t\tt.Errorf(\"paused watch searched %v and woke %v\", fs.queries, rec.got)\n+\t}\n+}\n+\n+func TestApprovalWatchSearchErrorThenRecovers(t *testing.T) {\n+\tfs := &fakeSearch{err: errors.New(\"boom\"), approved: []github.Issue{{Number: 1, Labels: []string{\"ard:approved\"}}}}\n+\trec := &wakeRec{}\n+\tw := &ApprovalWatch{Search: fs.search, Wake: rec.wake}\n+\tif err := watchTick(t, w); err == nil {\n+\t\tt.Fatal(\"want the search error\")\n+\t}\n+\tfs.err = nil\n+\tif err := watchTick(t, w); err != nil || rec.call != 1 {\n+\t\tt.Errorf(\"err %v wakes %v\", err, rec.got)\n+\t}\n+}\n+\n+func TestApprovalWatchLoopContract(t *testing.T) {\n+\tw := &ApprovalWatch{}\n+\tcfg := &config.Resolved{Intervals: config.Intervals{Approvals: config.Duration(time.Minute)}}\n+\tif w.Name() != \"approvals\" || w.Claims() || w.Interval(cfg) != time.Minute {\n+\t\tt.Error(\"loop contract\")\n+\t}\n+}\ndiff --git a/internal/controller/controller.go b/internal/controller/controller.go\nindex d01414e..d0729cb 100644\n--- a/internal/controller/controller.go\n+++ b/internal/controller/controller.go\n@@ -6,6 +6,7 @@ import (\n \t\"fmt\"\n \t\"log/slog\"\n \t\"math/rand/v2\"\n+\t\"slices\"\n \t\"sort\"\n \t\"strings\"\n \t\"sync\"\n@@ -68,6 +69,12 @@ type Controller struct {\n \n \tmu     sync.Mutex\n \tactive map[string]bool\n+\n+\t// runners, wakePending and wakeTimer implement WakeLoops; all guarded by mu.\n+\trunners     map[string]*runner\n+\twakeStopped bool\n+\twakePending map[string]map[string]bool // reason -> loop names\n+\twakeTimer   *time.Timer\n }\n \n // New validates deps and loop names. It returns an error for a nil Log,\n@@ -166,6 +173,12 @@ func (c *Controller) Run(ctx context.Context) error {\n \t\t\tr.run(workCtx, stopping)\n \t\t}()\n \t}\n+\tc.mu.Lock()\n+\tc.runners = make(map[string]*runner, len(runners))\n+\tfor _, r := range runners {\n+\t\tc.runners[r.loop.Name()] = r\n+\t}\n+\tc.mu.Unlock()\n \tlog.Info(\"controller.start\", \"loops\", names)\n \tif c.deps.Wake != nil {\n \t\twg.Add(1)\n@@ -206,6 +219,12 @@ func (c *Controller) Run(ctx context.Context) error {\n \t<-ctx.Done()\n \tlog.Info(\"controller.stopping\")\n \tclose(stopping)\n+\tc.mu.Lock()\n+\tc.wakeStopped = true\n+\tif c.wakeTimer != nil {\n+\t\tc.wakeTimer.Stop()\n+\t}\n+\tc.mu.Unlock()\n \n \tgrace := c.deps.Grace\n \tif grace == 0 {\n@@ -296,3 +315,68 @@ func (c *Controller) wakeOnFreed(freed <-chan struct{}, runners []*runner, stopp\n \t\t}\n \t}\n }\n+\n+// WakeLoops asks the named loops to run one tick soon, for a hand-off (a\n+// close-out that requested the next stage, an approval, an unblock). Calls\n+// within the debounce window merge into one wake per loop, a loop that is\n+// mid-tick runs once more after it finishes, unknown names and calls before\n+// Run or after shutdown are ignored. A woken loop still goes through the\n+// kill switch and the pool like a scheduled tick, so a wake while paused\n+// starts nothing. It is safe to call from any goroutine.\n+func (c *Controller) WakeLoops(reason string, names ...string) {\n+\tc.mu.Lock()\n+\tdefer c.mu.Unlock()\n+\tif c.wakeStopped || c.runners == nil {\n+\t\treturn\n+\t}\n+\tfor _, n := range names {\n+\t\tif _, ok := c.runners[n]; !ok {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif c.wakePending == nil {\n+\t\t\tc.wakePending = map[string]map[string]bool{}\n+\t\t}\n+\t\tif c.wakePending[reason] == nil {\n+\t\t\tc.wakePending[reason] = map[string]bool{}\n+\t\t}\n+\t\tc.wakePending[reason][n] = true\n+\t}\n+\tif len(c.wakePending) == 0 || c.wakeTimer != nil {\n+\t\treturn\n+\t}\n+\twindow := c.deps.FreedDebounce\n+\tif window <= 0 {\n+\t\twindow = DefaultFreedDebounce\n+\t}\n+\tc.wakeTimer = time.AfterFunc(window, c.flushWakes)\n+}\n+\n+// flushWakes wakes every loop collected by WakeLoops, one log line per reason.\n+func (c *Controller) flushWakes() {\n+\tc.mu.Lock()\n+\tdefer c.mu.Unlock()\n+\tpending := c.wakePending\n+\tc.wakePending, c.wakeTimer = nil, nil\n+\tif c.wakeStopped {\n+\t\treturn\n+\t}\n+\treasons := make([]string, 0, len(pending))\n+\tfor reason := range pending {\n+\t\treasons = append(reasons, reason)\n+\t}\n+\tslices.Sort(reasons)\n+\tfor _, reason := range reasons {\n+\t\tvar woken []string\n+\t\tfor n := range pending[reason] {\n+\t\t\twoken = append(woken, n)\n+\t\t}\n+\t\tslices.Sort(woken)\n+\t\tfor _, n := range woken {\n+\t\t\tselect {\n+\t\t\tcase c.runners[n].wake <- struct{}{}:\n+\t\t\tdefault: // one already pending\n+\t\t\t}\n+\t\t}\n+\t\tc.deps.Log.Info(\"controller.wake\", \"reason\", reason, \"loops\", woken)\n+\t}\n+}\ndiff --git a/internal/controller/wake_test.go b/internal/controller/wake_test.go\nnew file mode 100644\nindex 0000000..13b0965\n--- /dev/null\n+++ b/internal/controller/wake_test.go\n@@ -0,0 +1,111 @@\n+package controller\n+\n+import (\n+\t\"context\"\n+\t\"log/slog\"\n+\t\"testing\"\n+\t\"testing/synctest\"\n+\t\"time\"\n+\n+\t\"github.com/albertcbrown/ard/internal/config\"\n+)\n+\n+func wakeController(t *testing.T, pause Pauser, ls ...Loop) (*Controller, func() error, *logBuf) {\n+\tlog, buf := newLog()\n+\td := Deps{Log: log, Rand: fixedRand(0.5)}\n+\tif pause != nil {\n+\t\td.Pause = pause\n+\t}\n+\tc := mustNew(t, d, ls...)\n+\treturn c, start(t, c), buf\n+}\n+\n+func TestWakeLoopsWakesOnlyNamed(t *testing.T) {\n+\tsynctest.Test(t, func(t *testing.T) {\n+\t\ta := &testLoop{name: \"a\", claims: true}\n+\t\tb := &testLoop{name: \"b\", claims: true}\n+\t\tc, stop, buf := wakeController(t, nil, a, b)\n+\t\ttime.Sleep(iv / 2)\n+\t\tc.WakeLoops(WakeCloseout, \"a\", \"nope\")\n+\t\ttime.Sleep(DefaultFreedDebounce + time.Second)\n+\t\tif a.ticks() != 2 || b.ticks() != 1 {\n+\t\t\tt.Errorf(\"ticks a=%d b=%d, want 2 and 1\", a.ticks(), b.ticks())\n+\t\t}\n+\t\t_ = stop()\n+\t\tif buf.count(\"reason=closeout\") != 1 || buf.count(\"loops=[a]\") != 1 {\n+\t\t\tt.Errorf(\"log:\\n%s\", buf.String())\n+\t\t}\n+\t})\n+}\n+\n+func TestWakeLoopsBurstCoalesces(t *testing.T) {\n+\tsynctest.Test(t, func(t *testing.T) {\n+\t\ta := &testLoop{name: \"a\", claims: true}\n+\t\tc, stop, buf := wakeController(t, nil, a)\n+\t\ttime.Sleep(iv / 2)\n+\t\tfor range 10 {\n+\t\t\tc.WakeLoops(WakeCloseout, \"a\")\n+\t\t\ttime.Sleep(100 * time.Millisecond)\n+\t\t}\n+\t\ttime.Sleep(DefaultFreedDebounce + time.Second)\n+\t\tif a.ticks() != 2 {\n+\t\t\tt.Errorf(\"ticks = %d, want 2\", a.ticks())\n+\t\t}\n+\t\t_ = stop()\n+\t\tif buf.count(\"reason=closeout\") != 1 {\n+\t\t\tt.Errorf(\"want one wake line:\\n%s\", buf.String())\n+\t\t}\n+\t})\n+}\n+\n+func TestWakeLoopsDuringTickRunsOneMore(t *testing.T) {\n+\tsynctest.Test(t, func(t *testing.T) {\n+\t\ta := &testLoop{name: \"a\", tick: func(context.Context, Env) error {\n+\t\t\ttime.Sleep(time.Minute)\n+\t\t\treturn nil\n+\t\t}, interval: func(*config.Resolved) time.Duration { return time.Hour }}\n+\t\tc, stop, _ := wakeController(t, nil, a)\n+\t\ttime.Sleep(time.Second)\n+\t\tfor range 3 {\n+\t\t\tc.WakeLoops(WakeApproval, \"a\")\n+\t\t\ttime.Sleep(3 * time.Second)\n+\t\t}\n+\t\ttime.Sleep(10 * time.Minute)\n+\t\t_ = stop()\n+\t\tif a.maxCur != 1 || a.ticks() != 2 {\n+\t\t\tt.Errorf(\"max concurrent %d, ticks %d; want 1 and 2\", a.maxCur, a.ticks())\n+\t\t}\n+\t})\n+}\n+\n+func TestWakeLoopsWhilePausedRunsNoTick(t *testing.T) {\n+\tsynctest.Test(t, func(t *testing.T) {\n+\t\ta := &testLoop{name: \"a\", claims: true}\n+\t\tpaused := pauseFunc(func() PauseState { return PauseState{Paused: true, Reason: ReasonConfigInvalid} })\n+\t\tc, stop, _ := wakeController(t, paused, a)\n+\t\ttime.Sleep(iv / 2)\n+\t\tc.WakeLoops(WakeCloseout, \"a\")\n+\t\ttime.Sleep(DefaultFreedDebounce + time.Second)\n+\t\t_ = stop()\n+\t\tif a.ticks() != 0 {\n+\t\t\tt.Errorf(\"ticks = %d, want 0\", a.ticks())\n+\t\t}\n+\t})\n+}\n+\n+func TestWakeLoopsBeforeRunAndAfterShutdown(t *testing.T) {\n+\tsynctest.Test(t, func(t *testing.T) {\n+\t\ta := &testLoop{name: \"a\", claims: true}\n+\t\tc, stop, _ := wakeController(t, nil, a)\n+\t\ttime.Sleep(iv / 2)\n+\t\tc.WakeLoops(WakeCloseout, \"a\") // pending when shutdown starts\n+\t\t_ = stop()\n+\t\tc.WakeLoops(WakeCloseout, \"a\")\n+\t\ttime.Sleep(time.Minute)\n+\t\tif a.ticks() != 1 {\n+\t\t\tt.Errorf(\"ticks = %d, want 1\", a.ticks())\n+\t\t}\n+\t\tfresh := mustNew(t, Deps{Log: slog.Default()}, a)\n+\t\tfresh.WakeLoops(WakeCloseout, \"a\") // not running yet: ignored, no panic\n+\t})\n+}\ndiff --git a/internal/servecmd/loops_test.go b/internal/servecmd/loops_test.go\nindex 51ae856..99c66a0 100644\n--- a/internal/servecmd/loops_test.go\n+++ b/inte