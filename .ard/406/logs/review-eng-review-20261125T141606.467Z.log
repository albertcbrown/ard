.Name() != \"triage\" || loops[3].Name() != \"workers\" || loops[4].Name() != \"reviewers\" || loops[5].Name() != \"reviewfix\" || loops[6].Name() != \"merger\" || loops[7].Name() != \"prwatch\" || loops[8].Name() != \"janitor\" || loops[9].Name() != \"reaper\" || loops[10].Name() != \"costs\" || loops[11].Name() != \"budget\" || loops[12].Name() != \"digest\" || loops[13].Name() != \"approvals\" || loops[13].Claims() ||\n \t\t!loops[0].Claims() || !loops[1].Claims() || !loops[2].Claims() || !loops[3].Claims() || !loops[4].Claims() || !loops[5].Claims() || !loops[6].Claims() || !loops[7].Claims() || !loops[8].Claims() || loops[9].Claims() || loops[10].Claims() {\n \t\tt.Fatalf(\"loops = %v: the scanners, stale, triage, workers, reviewers and merger loops must exist and be skipped while paused, and the Reaper and the costs loop must keep running\", loops)\n \t}\ndiff --git a/internal/servecmd/serve.go b/internal/servecmd/serve.go\nindex 0a7200c..e9e5bb3 100644\n--- a/internal/servecmd/serve.go\n+++ b/internal/servecmd/serve.go\n@@ -89,7 +89,7 @@ func loopNames(loops []controller.Loop) []string {\n // knownLoops are the names registerLoops' loops report (Loop.Name), in the\n // order they register. \"budget\" selects the status-issue notice loop; the\n // claim gate itself is built into the pool whatever --loops says.\n-var knownLoops = []string{\"scanners\", stale.Name, \"triage\", \"workers\", \"reviewers\", \"reviewfix\", \"merger\", prwatch.Name, janitor.Name, \"reaper\", \"budget\", digest.Name}\n+var knownLoops = []string{\"scanners\", stale.Name, \"triage\", \"workers\", \"reviewers\", \"reviewfix\", \"merger\", prwatch.Name, janitor.Name, \"reaper\", \"budget\", digest.Name, controller.ApprovalsName}\n \n // selectLoops keeps the loops named in want, in registration order; an empty\n // want keeps every loop. A name that is not a known loop is a usage error\n@@ -336,6 +336,7 @@ func serveLoops(ctx context.Context, e *cli.Env, build builder, wantLoops []stri\n \tif err != nil {\n \t\treturn fmt.Errorf(\"ard serve: %w\", err)\n \t}\n+\tw.ctl.Store(cc)\n \tstartSHA := \"\"\n \tif cfg != nil {\n \t\tstartSHA = cfg.SHA\n@@ -370,6 +371,10 @@ type wiring struct {\n \tbodyLocks costblock.Locks\n \tpool      atomic.Pointer[pool.Pool]\n \n+\t// ctl is the controller, set once it is built (after the loops and the\n+\t// Closer); close-out and the approval watch wake loops through it.\n+\tctl atomic.Pointer[controller.Controller]\n+\n \tstatusIssue atomic.Int64 // the status issue number; 0 until the startup hook has run\n \n \t// StateDir is the per-repo state directory; close-out stages files under it.\n@@ -503,6 +508,9 @@ var registerLoops = func(w *wiring) []controller.Loop {\n \t\tRepo: w.Repo, Locks: &w.bodyLocks, Log: w.Log}))\n \tloops = append(loops, budgetLoop(w))\n \tloops = append(loops, digestLoop(w))\n+\tloops = append(loops, &controller.ApprovalWatch{Search: func(ctx context.Context, q string, o github.SearchOpts) ([]github.Issue, error) {\n+\t\treturn w.Reader.SearchIssues(ctx, q, o)\n+\t}, Wake: w.wakeLoops, Paused: w.Paused})\n \treturn loops\n }\n \ndiff --git a/internal/servecmd/wake.go b/internal/servecmd/wake.go\nnew file mode 100644\nindex 0000000..a754942\n--- /dev/null\n+++ b/internal/servecmd/wake.go\n@@ -0,0 +1,10 @@\n+package servecmd\n+\n+// wakeLoops asks the running controller to tick the named loops soon. The\n+// controller is built after the loops and the Closer, so it is bound late;\n+// before that (and in tests without one) a wake does nothing.\n+func (w *wiring) wakeLoops(reason string, names ...string) {\n+\tif c := w.ctl.Load(); c != nil {\n+\t\tc.WakeLoops(reason, names...)\n+\t}\n+}\ndiff --git a/internal/servecmd/wake_test.go b/internal/servecmd/wake_test.go\nnew file mode 100644\nindex 0000000..4da65bc\n--- /dev/null\n+++ b/internal/servecmd/wake_test.go\n@@ -0,0 +1,9 @@\n+package servecmd\n+\n+import \"testing\"\n+\n+// Before the controller is bound, a wake is a no-op rather than a panic