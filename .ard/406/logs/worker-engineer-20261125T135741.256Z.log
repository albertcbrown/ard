FailLimited)\n// and that it does not touch the automatic retry.\nfunc limitedPlan(j Job, reason string) Plan {\n\tp := retryPlan(j, reason)\n\tp.Outcome = OutcomeLimited\n\treturn p\n}\n\n// needsHumanPlan is the plan for a job held back by the secret scan.\nfunc needsHumanPlan(j Job, status, reason string) Plan {\n\tn := j.target()\n\treturn Plan{Outcome: OutcomeNeedsHuman, Status: status, Reason: reason, LogWithheld: false,\n\t\tTerminal: []Label{{n, labels.NeedsHuman}},\n\t\tRemove:   []Label{{n, labels.Running(labels.Stage(j.Stage), j.Role)}}}\n}\n\nfunc (j Job) validate() error {\n\tswitch j.Stage {\n\tcase StageTriage, StageWorker, StageReview:\n\tdefault:\n\t\treturn fmt.Errorf(\"closeout job %s: stage %q is not triage, worker or review\", j.ID, j.Stage)\n\t}\n\tif j.ID == \"\" || j.Role == \"\" || j.Issue == 0 {\n\t\treturn fmt.Errorf(\"closeout job %q: id, role and issue are required\", j.ID)\n\t}\n\tif j.Cause.Kind != \"\" {\n\t\t// A job that ended for a known cause commits only its log: it needs\n\t\t// neither a base commit nor a branch (an empty branch puts the log on\n\t\t// main under .ard/<issue#>/logs/).\n\t\treturn nil\n\t}\n\tif j.ExitCode == 0 && j.BaseSHA == \"\" {\n\t\treturn fmt.Errorf(\"closeout job %s: BaseSHA is required to find the changed files\", j.ID)\n\t}\n\tif j.Stage == StageReview && j.PR == 0 {\n\t\treturn fmt.Errorf(\"closeout job %s: a review needs a PR\", j.ID)\n\t}\n\t// A worker that stops before its first push has no branch: its role file\n\t// and log go to main, as triage's do.\n\tif j.Stage == StageReview && j.Branch == \"\" {\n\t\treturn fmt.Errorf(\"closeout job %s: a review job needs a branch\", j.ID)\n\t}\n\treturn nil\n}\n139:\tPhaseClosed    Phase = \"closed\"\n161:\tDryRun() bool\n211:\t\tif rec.Phase != PhaseClosed || rec.Plan.Outcome != OutcomeDone {\n241:\t\tif rec.Job.Role != \"lead\" || rec.Phase != PhaseClosed || rec.Plan.Outcome != OutcomeDone {\n270:\t\tif rec.Phase != PhaseClosed || p.Outcome != OutcomeDone || p.Review == nil || p.Review.HeadMoved || p.Review.CommitSHA == \"\" {\n298:\t\tif rec.Phase != PhaseClosed || p.Outcome != OutcomeChanges || p.Review == nil {\n308:type Deps struct {\n361:func (c *Closer) acquire(id string) bool {\n374:func (c *Closer) release(id string) {\n381:func (c *Closer) checkDeps() error {\n382:\tif c.d.Comments == nil && !c.d.Effects.DryRun() {\n390:func (c *Closer) Run(ctx context.Context, j Job) (Outcome, error) {\n431:func (c *Closer) ResumeJob(ctx context.Context, id string) (Outcome, error) {\n444:\tif sj.CloseoutPhase == \"\" || sj.CloseoutPhase == string(PhaseClosed) || len(sj.CloseoutPlan) == 0 {\n456:func (c *Closer) Resume(ctx context.Context) error {\n494:func (c *Closer) save(ctx context.Context, rec Record) error {\n505:func (c *Closer) fail(rec Record, err error) error {\n512:func (c *Closer) advance(ctx context.Context, rec Record) (Outcome, error) {\n513:\tif rec.Phase == PhaseClosed {\n543:\tif err := c.finish(ctx, rec); err != nil {\n546:\trec.Phase = PhaseClosed\n553:\tif rec.Synthetic || c.d.Effects.DryRun() {\n563:func (c *Closer) commit(ctx context.Context, rec *Record) error {\n629:func (c *Closer) prGone(rec *Record, why, state string) {\n638:func (c *Closer) commitConflict(ctx context.Context, rec *Record, cause error, tail string, tailWithheld bool, keep time.Time) error {\n682:func (c *Closer) request(ctx context.Context, rec Record) error {\n686:func (c *Closer) addGrouped(ctx context.Context, ls []Label) error {\n704:func (c *Closer) comment(ctx context.Context, rec *Record) error {\n721:\tcm, err := c.d.Effects.CreateComment(ctx, n, RenderComment(*rec, c.d.Repo, c.d.Effects.DryRun()))\n735:func (c *Closer) postReview(ctx context.Context, rec *Record) error {\n760:\tdry := c.d.Effects.DryRun()\n798:func (c *Closer) postFailed(rec *Record, err error) error {\n808:func (c *Closer) finish(ctx context.Context, rec Record) error {\n848:func (c *Closer) dropRawLog(rec Record) {\n887:\t\tif rec.Phase == PhaseClosed && rec.Plan.Outcome == OutcomeDone {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01CyNZtKR2FHmZsUb6Ank1Jz","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
