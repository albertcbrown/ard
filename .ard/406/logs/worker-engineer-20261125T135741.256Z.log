nd(loops, stale.New(w.Reader, w.Effects, nil))\n490:\t\tloops = append(loops, l)\n493:\t\tloops = append(loops, l)\n496:\t\tloops = append(loops, l)\n498:\tloops = append(loops, reviewfixLoop(w), mergerLoop(w), prwatchLoop(w), janitorLoop(w))\n500:\t\tloops = append(loops, l)\n502:\tloops = append(loops, costs.New(costs.Deps{Store: w.Store, Reader: w.Reader, Effects: w.Effects,\n504:\tloops = append(loops, budgetLoop(w))\n505:\tloops = append(loops, digestLoop(w))\n506:\treturn loops\n61-\tif w.Reader != nil {\n62-\t\tgetPR = w.Reader.GetPR\n63-\t}\n64:\tw.cl = closeout.New(closeout.Deps{\n65-\t\tEffects: w.Effects, Comments: w.Reader, Committer: closeoutCommitter{w}, Store: w.Store,\n66-\t\tRoles: cfgRoles{w},\n67-\t\t// The job's model credentials are in the controller's environment.\n68-\t\t// Host paths are replaced by placeholders in the same pass.\n69-\t\tNewRedactor: closeout.JobRedactor(os.Environ, w.hostPaths(), w.gitleaksOptions),\n70-\t\t// Job worktrees belong to the agent: git runs in the controller's own\n71-\t\t// clone (w.Root) and never trusts a worktree's .git, index or config.\n72-\t\tChanged: func(ctx context.Context, worktree, base string, paths ...string) ([]gitx.PathChange, error) {\n73-\t\t\treturn gitx.New(\"\").ChangedSince(ctx, w.Root, worktree, base, paths...)\n74-\t\t},\n75-\t\tBaseFile: func(ctx context.Context, _, rev, path string, maxBytes int64) ([]byte, bool, error) {\n76-\t\t\treturn gitx.New(\"\").FileAt(ctx, w.Root, rev, path, maxBytes)\n77-\t\t},\n78-\t\tPR:         getPR,\n79-\t\tRepo:       w.Repo,\n80-\t\tStagingDir: staging,\n81-\t\tLog:        w.Log,\n82-\t})\n83-\treturn w.cl\n84-}\n85-\n86-// reaperParts builds, once, the Finisher and Reaper that every loop shares.\n87-func (w *wiring) reaperParts() (*reaper.Finisher, *reaper.Reaper, error) {\n88-\tw.initMu.Lock()\n89-\tif w.fin != nil {\n90-\t\tdefer w.initMu.Unlock()\n91-\t\treturn w.fin, w.rp, nil\n92-\t}\n93-\tw.initMu.Unlock()\n94-\tex, err := w.newExecutor()\npackage controller\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"runtime/debug\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n)\n\nconst (\n\tbackoffAfter = 3 // consecutive errors before backoff starts\n\tbackoffCap   = 15 * time.Minute\n\n\t// configTimeout bounds one config load, which fetches from the remote.\n\tconfigTimeout = 2 * time.Minute\n)\n\n// runner drives one Loop. Ticks of one loop never overlap and a slow tick\n// never queues a second one; different loops run concurrently.\ntype runner struct {\n\tc    *Controller\n\tloop Loop\n\tlog  *slog.Logger\n\n\tcfg       *config.Resolved // last good config; nil until one has loaded\n\tcfgBroken bool             // last reload failed\n\tpaused    PauseState       // last pause state, for transition logs\n\tclamped   bool\n\tn         int // tick counter\n\terrs      int // consecutive tick errors\n\twake      chan struct{}\n}\n\n// jitter maps r in [0,1) to a factor in [0.9, 1.1).\nfunc jitter(r float64) float64 { return 0.9 + 0.2*r }\n\n// interval returns the loop's interval clamped to MinInterval.\nfunc (r *runner) interval() time.Duration {\n\tif r.cfg == nil { // no config yet: retry at the floor\n\t\treturn MinInterval\n\t}\n\td := r.loop.Interval(r.cfg)\n\tif d < MinInterval {\n\t\tif !r.clamped {\n\t\t\tr.clamped = true\n\t\t\tr.log.Warn(\"loop.interval_clamped\", \"requested\", d.String(), \"using\", MinInterval.String())\n\t\t}\n\t\treturn MinInterval\n\t}\n\treturn d\n}\n\n// run is the loop goroutine. It returns when stopping is closed.\nfunc (r *runner) run(workCtx context.Context, stopping <-chan struct{}) {\n\twait := time.Duration(r.c.rand() * 0.1 * float64(r.interval()))","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01A3V6VDjtBYXtYtMgvkzdd8","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
