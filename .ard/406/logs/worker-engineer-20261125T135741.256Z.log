{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0121zkNgTmPt6Ekg8dkn3WhW","type":"tool_result","content":"// ard:review:<role> labels to the PR itself. Only closed, done triage\n// close-outs count.\nfunc Deferred(ctx context.Context, s interface {\n\tCloseoutsOf(ctx context.Context, issue int, stage string) ([]state.Job, error)\n}, issue int) ([]NextReq, error) {\n\tjobs, err := s.CloseoutsOf(ctx, issue, StageTriage)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"deferred reviewers of issue %d: %w\", issue, err)\n\t}\n\tseen := map[NextReq]bool{}\n\tvar out []NextReq\n\tfor _, sj := range jobs {\n\t\trec, err := decode(sj)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tif rec.Phase != PhaseClosed || rec.Plan.Outcome != OutcomeDone {\n\t\t\tcontinue\n\t\t}\n\t\tfor _, r := range rec.Plan.Deferred {\n\t\t\tif !seen[r] {\n\t\t\t\tseen[r] = true\n\t\t\t\tout = append(out, r)\n\t\t\t}\n\t\t}\n\t}\n\treturn out, nil\n}\n\n// LeadWorker returns the validated worker choice of the newest closed, done\n// triage:lead close-out of issue, and that job's id. ok is false when there is\n// none. worker is \"\" when that lead named no valid worker. The triage fan-in\n// gate reads the choice here, not from the committed role file, which a later\n// triage agent could rewrite.\nfunc LeadWorker(ctx context.Context, s interface {\n\tCloseoutsOf(ctx context.Context, issue int, stage string) ([]state.Job, error)\n}, issue int) (worker, jobID string, ok bool, err error) {\n\tjobs, err := s.CloseoutsOf(ctx, issue, StageTriage)\n\tif err != nil {\n\t\treturn \"\", \"\", false, fmt.Errorf(\"lead worker of issue %d: %w\", issue, err)\n\t}\n\tfor _, sj := range jobs {\n\t\trec, err := decode(sj)\n\t\tif err != nil {\n\t\t\treturn \"\", \"\", false, fmt.Errorf(\"lead worker of issue %d: %w\", issue, err)\n\t\t}\n\t\tif rec.Job.Role != \"lead\" || rec.Phase != PhaseClosed || rec.Plan.Outcome != OutcomeDone {\n\t\t\tcontinue\n\t\t}\n\t\tworker, jobID, ok = rec.Plan.Worker, rec.Job.ID, true\n\t}\n\treturn worker, jobID, ok, nil\n}\n\n// ReviewPassed returns the commit the newest closed review close-out of role\n// on PR pr approved, ok only when that close-out finished with outcome done,\n// carries a review plan and the head had not moved during the review. The\n// merger trusts this record, not the :done label, which a person with triage\n// access can add.\nfunc ReviewPassed(ctx context.Context, s interface {\n\tCloseoutsOf(ctx context.Context, issue int, stage string) ([]state.Job, error)\n}, issue, pr int, role string) (sha string, ok bool, err error) {\n\tjobs, err := s.CloseoutsOf(ctx, issue, StageReview)\n\tif err != nil {\n\t\treturn \"\", false, fmt.Errorf(\"review of issue %d: %w\", issue, err)\n\t}\n\tfor i := len(jobs) - 1; i >= 0; i-- {\n\t\trec, err := decode(jobs[i])\n\t\tif err != nil {\n\t\t\treturn \"\", false, fmt.Errorf(\"review of issue %d: %w\", issue, err)\n\t\t}\n\t\tif rec.Job.Role != role || rec.Job.PR != pr {\n\t\t\tcontinue\n\t\t}\n\t\tp := rec.Plan\n\t\tif rec.Phase != PhaseClosed || p.Outcome != OutcomeDone || p.Review == nil || p.Review.HeadMoved || p.Review.CommitSHA == \"\" {\n\t\t\treturn \"\", false, nil\n\t\t}\n\t\treturn p.Review.CommitSHA, true, nil\n\t}\n\treturn \"\", false, nil\n}\n\n// ReviewChanged returns the commit the newest closed review close-out of role\n// on PR pr asked changes for, ok only when that close-out finished with\n// outcome changes and carries a review plan. A :changes label alone does not\n// count: a person with triage access can add it.\nfunc ReviewChanged(ctx context.Context, s interface {\n\tCloseoutsOf(ctx context.Context, issue int, stage string) ([]state.Job, error)\n}, issue, pr int, role string) (sha string, ok bool, err error) {\n\tjobs, err := s.CloseoutsOf(ctx, issue, StageReview)\n\tif err != nil {\n\t\treturn \"\", false, fmt.Errorf(\"review of issue %d: %w\", issue, err)\n\t}\n\tfor i := len(jobs) - 1; i >= 0; i-- {\n\t\trec, err := decode(jobs[i])\n\t\tif err != nil {\n\t\t\treturn \"\", false, fmt.Errorf(\"review of issue %d: %w\", issue, err)\n\t\t}\n\t\tif rec.Job.Role != role || rec.Job.PR != pr {\n\t\t\tcontinue\n\t\t}\n\t\tp := rec.Plan\n\t\tif rec.Phase != PhaseClosed || p.Outcome != OutcomeChanges || p.Review == nil {\n\t\t\treturn \"\", false, nil\n\t\t}\n\t\treturn p.Review.CommitSHA, true, nil\n\t}\n\treturn \"\", false, nil\n}\n\n// Deps are the collaborators of a Closer. Prepare needs Roles, NewRedactor,\n// Changed, BaseFile and StagingDir; the rest are for Closer.\ntype Deps struct {\n\tEffects   Effects\n\tComments  Comments\n\tCommitter Committer\n\tStore     Store\n\tRoles     RoleSet\n\t// NewRedactor builds the redactor for a job, with the executor's secret\n\t// values (rebuilt, never persisted). Resume does not call it: it uses\n\t// only already-redacted staged bytes.\n\tNewRedactor func(Job) (Redactor, error)\n\t// Changed lists paths under a pathspec changed since a base commit\n\t// (gitx.Git.ChangedSince).\n\tChanged func(ctx context.Context, worktree, base string, paths ...string) ([]gitx.PathChange, error)\n\t// BaseFile reads one file at a commit (gitx.Git.FileAt): ok is false when\n\t// the path does not exist there. Prepare uses it to compare plan.md with\n\t// its base.\n\tBaseFile func(ctx context.Context, worktree, rev, path string, maxBytes int64) (data []byte, ok bool, err error)\n\t// PR reads a pull request (github.Reader.GetPR). Optional: a review's\n\t// close-out uses it to notice a PR merged or closed mid-review. nil skips\n\t// the check.\n\tPR         func(ctx context.Context, n int) (github.PullRequest, error)\n\tRepo       github.Repo\n\tStagingDir string\n\tLog        *slog.Logger\n\tNow        func() time.Time\n}\n\nfunc (d Deps) log() *slog.Logger {\n\tif d.Log != nil {\n\t\treturn d.Log\n\t}\n\treturn slog.Default()\n}\n\nfunc (d Deps) now() time.Time {\n\tif d.Now != nil {\n\t\treturn d.Now()\n\t}\n\treturn time.Now()\n}\n\n// Closer executes close-out plans.\ntype Closer struct {\n\td    Deps\n\tmu   sync.Mutex\n\tbusy map[string]bool // jobs with an advance in flight\n}\n\n// New returns a Closer.\nfunc New(d Deps) *Closer { return &Closer{d: d, busy: map[string]bool{}} }\n\n// acquire marks a job busy; it reports false when another Run or Resume\n// already holds it. Without it a concurrent list-then-create would double-post.\nfunc (c *Closer) fail(rec Record, err error) error {\n\terr = fmt.Errorf(\"closeout job %s phase %s: %w\", rec.Job.ID, rec.Phase, err)\n\tc.d.log().Error(\"closeout failed\", \"job\", rec.Job.ID, \"issue\", rec.Job.Issue, \"phase\", rec.Phase, \"error\", err)\n\treturn err\n}\n\n// advance runs the steps after rec.Phase.\nfunc (c *Closer) advance(ctx context.Context, rec Record) (Outcome, error) {\n\tif rec.Phase == PhaseClosed {\n\t\treturn rec.Plan.Outcome, nil\n\t}\n\tif rec.Phase == PhasePrepared {\n\t\tif err := c.commit(ctx, &rec); err != nil {\n\t\t\treturn \"\", c.fail(rec, err)\n\t\t}\n\t\trec.Phase = PhaseCommitted\n\t\tif err := c.save(ctx, rec); err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t}\n\tif rec.Phase == PhaseCommitted {\n\t\tif err := c.request(ctx, rec); err != nil {\n\t\t\treturn \"\", c.fail(rec, err)\n\t\t}\n\t\trec.Phase = PhaseRequested\n\t\tif err := c.save(ctx, rec); err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t}\n\tif rec.Phase == PhaseRequested {\n\t\tif err := c.comment(ctx, &rec); err != nil {\n\t\t\treturn \"\", c.fail(rec, err)\n\t\t}\n\t\trec.Phase = PhaseCommented\n\t\tif err := c.save(ctx, rec); err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t}\n\tif err := c.finish(ctx, rec); err != nil {\n\t\treturn \"\", c.fail(rec, err)\n\t}\n\trec.Phase = PhaseClosed\n\tif err := c.save(ctx, rec); err != nil {\n\t\treturn \"\", err\n\t}\n\tif err := os.RemoveAll(filepath.Join(c.d.StagingDir, rec.Job.ID)); err != nil {\n\t\tc.d.log().Warn(\"closeout: remove staging\", \"job\", rec.Job.ID, \"error\", err)\n\t}\n\tif rec.Synthetic || c.d.Effects.DryRun() {\n\t\tc.d.log().Info(\"closeout: raw log kept (dry-run)\", \"job\", rec.Job.ID)\n\t} else {\n\t\tc.dropRawLog(rec)\n\t}\n\treturn rec.Plan.Outcome, nil\n}\n\n// commit hands the staged files to the committer. A permanent error (the\n// committer already retried) turns the job into a failure with no files.\nfunc (c *Closer) postReview(ctx context.Context, rec *Record) error {\n\tj, rp := rec.Job, rec.Plan.Review\n\tn := j.target()\n\tif n > 0 && c.d.Comments != nil {\n\t\trs, err := c.d.Comments.ListReviews(ctx, n)\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"list reviews on #%d: %w\", n, err)\n\t\t}\n\t\tfor _, r := range rs {\n\t\t\tif strings.HasPrefix(r.Body, markerFor(j.ID)) {\n\t\t\t\trec.CommentID, rec.ReviewMode = r.ID, ReviewFound\n\t\t\t\treturn nil\n\t\t\t}\n\t\t}\n\t\tcs, err := c.d.Comments.ListComments(ctx, n, time.Time{})\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"list comments on #%d: %w\", n, err)\n\t\t}\n\t\tfor _, cm := range cs {\n\t\t\tif strings.HasPrefix(cm.Body, markerFor(j.ID)) {\n\t\t\t\trec.CommentID, rec.ReviewMode = cm.ID, ReviewFound\n\t\t\t\treturn nil\n\t\t\t}\n\t\t}\n\t}\n\tdry := c.d.Effects.DryRun()\n\trejected := func(err error) bool {\n\t\tvar he *github.HTTPError\n\t\treturn errors.As(err, &he) && he.Status == 422\n\t}\n\tinline := inlineComments(rp)\n\tif len(inline) > 0 {\n\t\trid, err := c.d.Effects.CreateReview(ctx, n, github.ReviewInput{CommitSHA: rp.CommitSHA,\n\t\t\tBody: RenderReview(*rec, c.d.Repo, dry, false), Comments: inline})\n\t\tif err == nil {\n\t\t\trec.CommentID, rec.ReviewMode = rid, ReviewInline\n\t\t\treturn nil\n\t\t}\n\t\tif !rejected(err) {\n\t\t\treturn c.postFailed(rec, fmt.Errorf(\"review on #%d: %w\", n, err))\n\t\t}\n\t\tc.d.log().Warn(\"closeout.review_inline_rejected\", \"job\", j.ID, \"pr\", n, \"error\", err)\n\t}\n\tbody := RenderReview(*rec, c.d.Repo, dry, len(inline) > 0)\n\trid, err := c.d.Effects.CreateReview(ctx, n, github.ReviewInput{CommitSHA: rp.CommitSHA, Body: body})\n\tif err == nil {\n\t\trec.CommentID, rec.ReviewMode = rid, ReviewBody\n\t\treturn nil\n\t}\n\tif !rejected(err) {\n\t\treturn c.postFailed(rec, fmt.Errorf(\"review on #%d: %w\", n, err))\n\t}\n\tc.d.log().Warn(\"closeout.review_rejected\", \"job\", j.ID, \"pr\", n, \"error\", err)\n\tcm, err := c.d.Effects.CreateComment(ctx, n, body)\n\tif err != nil {\n\t\treturn c.postFailed(rec, fmt.Errorf(\"comment on #%d: %w\", n, err))\n\t}\n\trec.CommentID, rec.ReviewMode = cm.ID, ReviewComment\n\treturn nil\n}\n\n// postFailed passes a review-post error on, except for a stale review of a\n// gone PR: posting there is best-effort, so the error is logged and dropped.\nfunc (c *Closer) postFailed(rec *Record, err error) error {\n\tif rp := rec.Plan.Review; rp != nil && rp.PRGone != \"\" {\n\t\tc.d.log().Warn(\"closeout: review not posted on gone PR\", \"job\", rec.Job.ID, \"pr\", rec.Job.PR, \"error\", err)\npackage closeout\n\nimport (\n\t\"fmt\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/labels\"\n)\n\n// TestResult is how a worker's test run ended.\ntype TestResult string\n\n// Test results.\nconst (\n\tTestsPassed TestResult = \"passed\"\n\tTestsFailed TestResult = \"failed\"\n\tTestsNone   TestResult = \"none\" // the role has no tests configured\n)\n\n// WorkerResult is what the worker loop knows that the role file cannot say:\n// the pull request, the reviewers to request on it and how the tests went. The\n// loop passes it through reaper.Finisher.FinishWith; it is persisted in the\n// close-out record.\ntype WorkerResult struct {\n\tPR    int\n\tPRURL string\n\t// Reviewers are the reviewer roles to request on the PR, de-duplicated and\n\t// already limited to roles that exist. Close-out adds the role file's own\n\t// review requests after them.\n\tReviewers []string\n\tTests     TestResult\n\tFixes     int    // fix attempts that ran\n\tTestNote  string // fixed, non-secret text, such as \"ran out of time\"\n\t// Hold, when set, turns the result into needs-human with this reason (a\n\t// diff guard rejection, for example). It never quotes file content.\n\tHold string\n\t// Large, when set, is the diff guard's fixed note on a PR over the role's\n\t// diff_warn_lines (\"Large change: N changed lines (warn at W)\"). The PR\n\t// still proceeds; the note goes into the PR body and the issue comment.\n\tLarge string\n\t// Fetched are the inputs the worker recorded under fetched: in its role\n\t// file. They come only from the parsed frontmatter, never from free text.\n\tFetched []Fetched\n}\n\n// buildWorker maps a done worker role file and the loop's result to a plan.\nfunc buildWorker(j Job, rf RoleFile, rs RoleSet) Plan {\n\tw := j.Worker\n\tswitch {\n\tcase w == nil:\n\t\treturn needsHumanPlan(j, rf.Status, \"worker ended without the loop's result\")\n\tcase w.Hold != \"\":\n\t\treturn needsHumanPlan(j, rf.Status, w.Hold)\n\tcase j.PR <= 0:\n\t\treturn needsHumanPlan(j, rf.Status, \"worker finished without a pull request\")\n\t}\n\tn, pr := j.Issue, j.PR\n\trun := Label{n, labels.Running(labels.StageWorker, j.Role)}\n\tp := Plan{Status: rf.Status, Outcome: OutcomeDone}\n\tp.Terminal = []Label{{n, labels.Done(labels.StageWorker, j.Role)}}\n\tnow, deferred, skipped := resolveNext(j, rf.Next, rs)\n\tp.Deferred, p.Skipped = deferred, skipped\n\tif w.Tests == TestsFailed {\n\t\tp.Terminal = append(p.Terminal, Label{n, labels.TestsFailed}, Label{pr, labels.TestsFailed})\n\t\tfor _, r := range now {\n\t\t\tp.Skipped = append(p.Skipped, Skip{r.String(), \"tests failed\"})\n\t\t}\n\t} else {\n\t\tp.Remove = append(p.Remove, Label{n, labels.TestsFailed}, Label{pr, labels.TestsFailed})\n\t\tseen := map[string]bool{}\n\t\tadd := func(role string) {\n\t\t\tif seen[role] {\n\t\t\t\treturn\n\t\t\t}\n\t\t\tseen[role] = true\n\t\t\tp.Requests = append(p.Requests, Label{pr, labels.Request(labels.StageReview, role)})\n\t\t}\n\t\tfor _, r := range w.Reviewers {\n\t\t\tif hasRole(rs, StageReview, r) {\n\t\t\t\tadd(r)\n\t\t\t} else {\n\t\t\t\tp.Skipped = append(p.Skipped, Skip{\"review:\" + clip(r, 60), \"no such role\"})\n\t\t\t}\n\t\t}\n\t\tfor _, r := range now {\n\t\t\tadd(r.Role)\n\t\t}\n\t}\n\tp.Remove = append(p.Remove, run)\n\tif rf.Worker != \"\" {\n\t\tp.Skipped = append(p.Skipped, Skip{\"worker:\" + clip(rf.Worker, 60), \"wrong stage\"})\n\t}\n\treturn p\n}\n\n// workerLines are the PR and Tests lines of a worker's close-out comment.\nfunc workerLines(j Job) []string {\n\tw := j.Worker\n\tif w == nil || w.Hold != \"\" {\n\t\treturn nil\n\t}\n\tvar out []string\n\tif j.PR > 0 {\n\t\tif strings.HasPrefix(w.PRURL, \"https://github.com/\") && !strings.ContainsAny(w.PRURL, \" ()[]<>\\n\") {\n\t\t\tout = append(out, fmt.Sprintf(\"PR: [#%d](%s)\", j.PR, w.PRURL))\n\t\t} else {\n\t\t\tout = append(out, fmt.Sprintf(\"PR: #%d\", j.PR))\n\t\t}\n\t}\n\tfixes := \"\"\n\tswitch w.Fixes {\n\tcase 0:\n\tcase 1:\n\t\tfixes = \" after 1 fix attempt\"\n\tdefault:\n\t\tfixes = fmt.Sprintf(\" after %d fix attempts\", w.Fixes)\n\t}\n\tswitch w.Tests {\n\tcase TestsPassed:\n\t\tout = append(out, \"Tests: passed\"+fixes)\n\tcase TestsFailed:\n\t\tline := \"Tests: failed\" + fixes\n\t\tif w.TestNote != \"\" {\n\t\t\tline += \" · \" + sanitize(w.TestNote)\n\t\t}\n\t\tout = append(out, line)\n\tcase TestsNone:\n\t\tout = append(out, \"Tests: not configured\")\n\t}\n\tif w.Large != \"\" {\n\t\tout = append(out, sanitize(w.Large))\n\t}\n\treturn out\n}\nreview.go:51:// added to fs unless the agent already reported that line, and an approve\ncloseout.go:316:\t// only already-redacted staged bytes.\ncloseout.go:360:// already holds it. Without it a concurrent list-then-create would double-post.\ncloseout.go:388:// Run closes out j. If the job already has a record it resumes that one and\ncloseout.go:468:\t\t// already finished, and overwrite its closed record with a stale one.\ncloseout.go:562:// committer already retried) turns the job into a failure with no files.","is_error":false}]},"parent_tool_use_id":null,"session_id":"c9504e90-0a46-4f9b-9664-2e88cac7e920","uuid":"71c66984-ce32-46da-841d-f93327486b43","timestamp":"2026-11-25T13:57:55.122Z","tool_use_result":{"stdout":"// ard:review:<role> labels to the PR itself. Only closed, done triage\n// close-outs count.\nfunc Deferred(ctx context.Context, s interface {\n\tCloseoutsOf(ctx context.Context, issue int, stage string) ([]state.Job, error)\n}, issue int) ([]NextReq, error) {\n\tjobs, err := s.CloseoutsOf(ctx, issue, StageTriage)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"deferred reviewers of issue %d: %w\", issue, err)\n\t}\n\tseen := map[NextReq]bool{}\n\tvar out []NextReq\n\tfor _, sj := range jobs {\n\t\trec, err := decode(sj)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tif rec.Phase != PhaseClosed || rec.Plan.Outcome != OutcomeDone {\n\t\t\tcontinue\n\t\t}\n\t\tfor _, r := range rec.Plan.Deferred {\n\t\t\tif !seen[r] {\n\t\t\t\tseen[r] = true\n\t\t\t\tout = append(out, r)\n\t\t\t}\n\t\t}\n\t}\n\treturn out, nil\n}\n\n// LeadWorker returns the validated worker choice of the newest closed, done\n// triage:lead close-out of issue, and that job's id. ok is false when there is\n// none. worker is \"\" when that lead named no valid worker. The triage fan-in\n// gate reads the choice here, not from the committed role file, which a later\n// triage agent could rewrite.\nfunc LeadWorker(ctx context.Context, s interface {\n\tCloseoutsOf(ctx context.Context, issue int, stage string) ([]state.Job, error)\n}, issue int) (worker, jobID string, ok bool, err error) {\n\tjobs, err := s.CloseoutsOf(ctx, issue, StageTriage)\n\tif err != nil {\n\t\treturn \"\", \"\", false, fmt.Errorf(\"lead worker of issue %d: %w\", issue, err)\n\t}\n\tfor _, sj := range jobs {\n\t\trec, err := decode(sj)\n\t\tif err != nil {\n\t\t\treturn \"\", \"\", false, fmt.Errorf(\"lead worker of issue %d: %w\", issue, err)\n\t\t}\n\t\tif rec.Job.Role != \"lead\" || rec.Phase != PhaseClosed || rec.Plan.Outcome != OutcomeDone {\n\t\t\tcontinue\n\t\t}\n\t\tworker, jobID, ok = rec.Plan.Worker, rec.Job.ID, true\n\t}\n\treturn worker, jobID, ok, nil\n}\n\n// ReviewPassed returns the commit the newest closed review close-out of role\n// on PR pr approved, ok only when that close-out finished with outcome done,\n// carries a review plan and the head had not moved during the review. The\n// merger trusts this record, not the :done label, which a person with triage\n// access can add.\nfunc ReviewPassed(ctx context.Context, s interface {\n\tCloseoutsOf(ctx context.Context, issue int, stage string) ([]state.Job, error)\n}, issue, pr int, role string) (sha string, ok bool, err error) {\n\tjobs, err := s.CloseoutsOf(ctx, issue, StageReview)\n\tif err != nil {\n\t\treturn \"\", false, fmt.Errorf(\"review of issue %d: %w\", issue, err)\n\t}\n\tfor i := len(jobs) - 1; i >= 0; i-- {\n\t\trec, err := decode(jobs[i])\n\t\tif err != nil {\n\t\t\treturn \"\", false, fmt.Errorf(\"review of issue %d: %w\", issue, err)\n\t\t}\n\t\tif rec.Job.Role != role || rec.Job.PR != pr {\n\t\t\tcontinue\n\t\t}\n\t\tp := rec.Plan\n\t\tif rec.Phase != PhaseClosed || p.Outcome != OutcomeDone || p.Review == nil || p.Review.HeadMoved || p.Review.CommitSHA == \"\" {\n\t\t\treturn \"\", false, nil\n\t\t}\n\t\treturn p.Review.CommitSHA, true, nil\n\t}\n\treturn \"\", false, nil\n}\n\n// ReviewChanged returns the commit the newest closed review close-out of role\n// on PR pr asked changes for, ok only when that close-out finished with\n// outcome changes and carries a review plan. A :changes label alone does not\n// count: a person with triage access can add it.\nfunc ReviewChanged(ctx context.Context, s interface {\n\tCloseoutsOf(ctx context.Context, issue int, stage string) ([]state.Job, error)\n}, issue, pr int, role string) (sha string, ok bool, err error) {\n\tjobs, err := s.CloseoutsOf(ctx, issue, StageReview)\n\tif err != nil {\n\t\treturn \"\", false, fmt.Errorf(\"review of issue %d: %w\", issue, err)\n\t}\n\tfor i := len(jobs) - 1; i >= 0; i-- {\n\t\trec, err := decode(jobs[i])\n\t\tif err != nil {\n\t\t\treturn \"\", false, fmt.Errorf(\"review of issue %d: %w\", issue, err)\n\t\t}\n\t\tif rec.Job.Role != role || rec.Job.PR != pr {\n\t\t\tcontinue\n\t\t}\n\t\tp := rec.Plan\n\t\tif rec.Phase != PhaseClosed || p.Outcome != OutcomeChanges || p.Review == nil {\n\t\t\treturn \"\", false, nil\n\t\t}\n\t\treturn p.Review.CommitSHA, true, nil\n\t}\n\treturn \"\", false, nil\n}\n\n// Deps are the collaborators of a Closer. Prepare needs Roles, NewRedactor,\n// Changed, BaseFile and StagingDir; the rest are for Closer.\ntype Deps struct {\n\tEffects   Effects\n\tComments  Comments\n\tCommitter Committer\n\tStore     Store\n\tRoles     RoleSet\n\t// NewRedactor builds the redactor for a job, with the executor's secret\n\t// values (rebuilt, never persisted). Resume does not call it: it uses\n\t// only already-redacted staged bytes.\n\tNewRedactor func(Job) (Redactor, error)\n\t// Changed lists paths under a pathspec changed since a base commit\n\t// (gitx.Git.ChangedSince).\n\tChanged func(ctx context.Context, worktree, base string, paths ...string) ([]gitx.PathChange, error)\n\t// BaseFile reads one file at a commit (gitx.Git.FileAt): ok is false when\n\t// the path does not exist there. Prepare uses it to compare plan.md with\n\t// its base.\n\tBaseFile func(ctx context.Context, worktree, rev, path string, maxBytes int64) (data []byte, ok bool, err error)\n\t// PR reads a pull request (github.Reader.GetPR). Optional: a review's\n\t// close-out uses it to notice a PR merged or closed mid-review. nil skips\n\t// the check.\n\tPR         func(ctx context.Context, n int) (github.PullRequest, error)\n\tRepo       github.Repo\n\tStagingDir string\n\tLog        *slog.Logger\n\tNow        func() time.Time\n}\n\nfunc (d Deps) log() *slog.Logger {\n\tif d.Log != nil {\n\t\treturn d.Log\n\t}\n\treturn slog.Default()\n}\n\nfunc (d Deps) now() time.Time {\n\tif d.Now != nil {\n\t\treturn d.Now()\n\t}\n\treturn time.Now()\n}\n\n// Closer exe