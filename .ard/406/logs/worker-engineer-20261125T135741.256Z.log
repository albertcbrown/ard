\t\tcontinue\n\t\t}\n\t\twant := map[string]bool{}\n\t\tfor _, n := range loops {\n\t\t\twant[n] = true\n\t\t}\n\t\tvar woken []string\n\t\tfor _, r := range runners {\n\t\t\tif !want[r.loop.Name()] {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\twoken = append(woken, r.loop.Name())\n\t\t\tselect {\n\t\t\tcase r.wake <- struct{}{}:\n\t\t\tdefault: // one already pending\n\t\t\t}\n\t\t}\n\t\tif len(woken) > 0 {\n\t\t\tc.deps.Log.Info(\"controller.wake\", \"reason\", \"slot_freed\", \"loops\", woken)\n\t\t}\n\t}\n}\nconfig/defaults.go:31:\tdefaultIntervalPRWatch   = Duration(5 * time.Minute)\nconfig/defaults.go:33:\tdefaultPRWatchPendingTimeout = Duration(2 * time.Hour)\nconfig/defaults.go:34:\tmaxPRWatchPendingTimeout     = Duration(7 * 24 * time.Hour)\nconfig/defaults.go:75:\t\t\tPRWatch:   defaultIntervalPRWatch,\nconfig/defaults.go:77:\t\tPRWatch: PRWatch{PendingTimeout: defaultPRWatchPendingTimeout},\nconfig/defaults.go:155:\tres.Intervals.PRWatch = intervalOr(raw.intervals.prwatch, res.Intervals.PRWatch)\nconfig/defaults.go:165:\t\t{\"intervals.prwatch\", res.Intervals.PRWatch},\nconfig/defaults.go:172:\tif raw.prWatchPendingTimeout != nil {\nconfig/defaults.go:173:\t\tres.PRWatch.PendingTimeout = *raw.prWatchPendingTimeout\nconfig/defaults.go:175:\tif pt := res.PRWatch.PendingTimeout; pt < res.Intervals.PRWatch || pt > maxPRWatchPendingTimeout {\nconfig/defaults.go:176:\t\terrs = append(errs, &Error{File: cfgPath, Key: \"pr_watch.pending_timeout\", Msg: fmt.Sprintf(\"must be at least intervals.prwatch (%s) and at most 7d, got %s\", res.Intervals.PRWatch, pt)})\nconfig/keys.go:13:\t\t\"intervals.reviewers\", \"intervals.merger\", \"intervals.prwatch\",\nconfig/raw.go:32:\tprWatchPendingTimeout  *Duration // pr_watch.pending_timeout\nconfig/raw.go:45:\tscanners, triage, workers, reviewers, merger, prwatch *Duration\nconfig/raw.go:135:\t\t\terrs = append(errs, raw.parsePRWatch(value, cfgPath)...)\nconfig/raw.go:188:\tset(\"prwatch\", &ri.prwatch)\nconfig/raw.go:192:\t\tcase \