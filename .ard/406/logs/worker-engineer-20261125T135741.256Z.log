{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SZnLrnfNaALd1U6eYbVx3t","type":"tool_result","content":"\twait := time.Duration(r.c.rand() * 0.1 * float64(r.interval()))\n\tfor {\n\t\tt := time.NewTimer(wait)\n\t\tselect {\n\t\tcase <-stopping:\n\t\t\tt.Stop()\n\t\t\treturn\n\t\tcase <-t.C:\n\t\tcase <-r.wake:\n\t\t\tt.Stop()\n\t\t}\n\t\tselect { // a tick must not start once shutdown has begun\n\t\tcase <-stopping:\n\t\t\treturn\n\t\tdefault:\n\t\t}\n\t\twait = r.tick(workCtx, stopping)\n\t}\n}\n\n// tick runs one poll and returns how long to wait before the next one.\nfunc (r *runner) tick(workCtx context.Context, stopping <-chan struct{}) time.Duration {\n\tr.n++\n\tlog := r.log.With(\"tick\", r.n)\n\tr.reload(workCtx, log)\n\n\tif r.cfg == nil { // never loaded: nothing can run, and claiming loops are paused\n\t\tif r.loop.Claims() {\n\t\t\tr.transition(log, PauseState{Paused: true, Reason: ReasonConfigInvalid})\n\t\t}\n\t\treturn r.nextWait(nil)\n\t}\n\n\tif r.loop.Claims() {\n\t\tst := r.c.deps.Pause.Check(workCtx, r.cfg)\n\t\tif r.cfgBroken {\n\t\t\tst = PauseState{Paused: true, Reason: ReasonConfigInvalid}\n\t\t}\n\t\tr.transition(log, st)\n\t\tif st.Paused {\n\t\t\treturn r.nextWait(nil)\n\t\t}\n\t}\n\n\tinterval := r.interval()\n\ttimeout := interval\n\tif tt, ok := r.loop.(TickTimeouter); ok {\n\t\tif d := tt.TickTimeout(r.cfg); d > 0 {\n\t\t\ttimeout = max(d, time.Second)\n\t\t}\n\t}\n\tctx, cancel := context.WithTimeout(workCtx, timeout)\n\tdefer cancel()\n\n\tr.c.setActive(r.loop.Name(), true)\n\tstart := time.Now()\n\terr := r.safeTick(ctx, Env{Log: log, Cfg: r.cfg, Inflight: r.c.inflight, Stopping: stopping})\n\tr.c.setActive(r.loop.Name(), false)\n\tlog.Debug(\"loop.tick\", \"duration\", time.Since(start).String())\n\n\tif err != nil {\n\t\tr.errs++\n\t\tlog.Error(\"loop.error\", \"error\", err, \"consecutive\", r.errs)\n\t} else {\n\t\tr.errs = 0\n\t}\n\treturn r.nextWait(err)\n}\n\n// reload refreshes the config snapshot, keeping the last good one on error.\nfunc (r *runner) reload(ctx context.Context, log *slog.Logger) {\n\tctx, cancel := context.WithTimeout(ctx, configTimeout)\n\tdefer cancel()\n\tcfg, err := r.c.deps.Config(ctx)\n\tswitch {\n\tcase err != nil:\n\t\tif !r.cfgBroken {\n\t\t\tlog.Error(\"config.reload_failed\", \"error\", err)\n\t\t}\n\t\tr.cfgBroken = true\n\tdefault:\n\t\tif r.cfgBroken {\n\t\t\tlog.Info(\"config.reloaded\")\n\t\t}\n\t\tr.cfgBroken = false\n\t\tr.cfg = cfg\n\t}\n}\n\n// transition logs pause state changes, once per change rather than per tick.\nfunc (r *runner) transition(log *slog.Logger, st PauseState) {\n\tswitch {\n\tcase st.Paused && (!r.paused.Paused || r.paused.Reason != st.Reason):\n\t\tlog.Info(\"loop.paused\", \"reason\", string(st.Reason))\n\tcase !st.Paused && r.paused.Paused:\n\t\tlog.Info(\"loop.resumed\")\n\t}\n\tr.paused = st\n}\n\n// safeTick turns a panic into an error carrying the stack.\nfunc (r *runner) safeTick(ctx context.Context, env Env) (err error) {\n\tdefer func() {\n\t\tif p := recover(); p != nil {\n\t\t\terr = fmt.Errorf(\"panic in %s tick: %v\\n%s\", r.loop.Name(), p, debug.Stack())\n\t\t}\n\t}()\n\treturn r.loop.Tick(ctx, env)\n}\n\n// nextWait is the interval with jitter, or the backed-off interval after\n// backoffAfter consecutive errors, or at least until a rate limit resets.\nfunc (r *runner) nextWait(err error) time.Duration {\n\tinterval := r.interval()\n\tbase := interval\n\tif r.errs >= backoffAfter {\n\t\tlimit := max(interval, backoffCap)\n\t\tbase = interval\n\t\tfor i := 0; i < r.errs-backoffAfter+1 && base < limit; i++ {\n\t\t\tbase = min(base*2, limit)\n\t\t}\n\t}\n\twait := time.Duration(float64(base) * jitter(r.c.rand()))\n\tvar rl *github.RateLimitError\n\tif errors.As(err, &rl) && !rl.ResetAt.IsZero() {\n\t\twait = max(wait, time.Until(rl.ResetAt))\n\t}\n\treturn wait\n}\n\t\t}\n\t\tif out, err := dockerProbe(ctx); err != nil {\n\t\t\treturn fmt.Errorf(\"ard serve: %s is set but Docker is not available: %w: %s\", EnvAgentImage, err, strings.TrimSpace(string(out)))\n\t\t}\n\t\tlog.Info(\"serve.agent_image\", \"image\", agentImage)\n\t}\n\n\tw := &wiring{\n\t\tAgentImage: agentImage, Log: log, Reader: d.Reader, Effects: d.Effects, Store: store, MaxPods: config.DefaultMaxPods,\n\t\tRepo: repo, Root: clone, Home: home, RemoteURL: d.RemoteURL, Token: d.Token, Scanners: scanners, Model: d.Model,\n\t\tStateDir: stateDir, Started: time.Now(),\n\t}\n\tdefer w.closeAll()\n\tpaths, perr := newPathRedactor(w.hostPaths())\n\tif perr != nil {\n\t\tlog.Error(\"serve.config_error_paths\", \"error\", perr)\n\t}\n\tloader := &cfgLoader{paths: paths, src: src, fx: d.Effects, log: log, stderr: e.Stderr, agentImage: agentImage != \"\", issue: func() int { return int(w.statusIssue.Load()) }}\n\n\t// An origin/main whose config cannot be loaded does not abort startup:\n\t// serve starts paused, tells the status issue, and retries every tick.\n\tloadCtx, cancelLoad := context.WithTimeout(ctx, 2*time.Minute)\n\tcfg, cfgErr := loader.Load(loadCtx)\n\tcancelLoad()\n\tif cfgErr != nil {\n\t\tlog.Error(\"serve.config_unavailable\", \"error\", cfgErr, \"hint\", \"starting paused; will retry every tick\")\n\t} else {\n\t\tw.MaxPods = cfg.MaxPods\n\t\tw.cfg.Store(cfg)\n\t}\n\t// A scan can outlast a pause, so the scanners re-check after it. The\n\t// check fails closed, like the gate's own.\n\tw.Paused = func(ctx context.Context) bool {\n\t\tc, err := loader.Load(ctx)\n\t\tif err != nil {\n\t\t\treturn true\n\t\t}\n\t\treturn gate.Check(ctx, c).Paused\n\t}\n\n\tselected, err := selectLoops(registerLoops(w), wantLoops)\n\tif err != nil {\n\t\treturn err\n\t}\n\tlog.Info(\"serve.loops\", \"selected\", loopNames(selected))\n\tcc, err := controller.New(controller.Deps{\n\t\tLog: log,\n\t\tConfig: func(ctx context.Context) (*config.Resolved, error) {\n\t\t\tc, err := loader.Load(ctx)\n\t\t\tif err != nil {\n\t\t\t\treturn nil, err\n\t\t\t}\n\t\t\tw.cfg.Store(c)\n\t\t\tif p := w.pool.Load(); p