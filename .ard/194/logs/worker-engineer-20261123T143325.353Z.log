{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012xH4UZSrtEfsMxqP1EHCT8","type":"tool_result","content":"      57 branch.go\n     165 candidates.go\n     115 candidates_test.go\n      50 doc.go\n     341 harness_test.go\n      26 input.go\n     232 loop.go\n     225 run.go\n     248 run_test.go\n      68 unit_test.go\n    1527 total\npackage reviewer\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/agent\"\n\t\"github.com/albertcbrown/ard/internal/agentjob\"\n\t\"github.com/albertcbrown/ard/internal/closeout\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n\t\"github.com/albertcbrown/ard/internal/executor\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n\t\"github.com/albertcbrown/ard/internal/intake\"\n\t\"github.com/albertcbrown/ard/internal/modelauth\"\n\t\"github.com/albertcbrown/ard/internal/pool\"\n\t\"github.com/albertcbrown/ard/internal/reaper\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\nconst (\n\tdefaultInterval = 5 * time.Minute\n\tdefaultPoll     = 2 * time.Second\n\tstageReview     = \"review\"\n)\n\n// Reader is the part of github.Reader the loop uses.\ntype Reader interface {\n\tIdentity(ctx context.Context) (github.Identity, error)\n\tGetIssue(ctx context.Context, n int) (github.Issue, error)\n\tGetPR(ctx context.Context, n int) (github.PullRequest, error)\n\tSearchIssues(ctx context.Context, q string, o github.SearchOpts) ([]github.Issue, error)\n\tListComments(ctx context.Context, n int, since time.Time) ([]github.Comment, error)\n}\n\n// Effects is the part of effects.Effects the loop uses.\ntype Effects interface {\n\tAddLabels(ctx context.Context, n int, labels ...string) error\n\tRemoveLabel(ctx context.Context, n int, label string) error\n\tCreateComment(ctx context.Context, n int, body string) (github.Comment, error)\n\tDryRun() bool\n}\n\n// Store is the part of *state.Store the loop uses.\ntype Store interface {\n\tCreateJob(ctx context.Context, n state.NewJob) (state.Job, error)\n\tSetHandle(ctx context.Context, id string, h json.RawMessage) error\n\tStartAttempt(ctx context.Context, id string) (int, error)\n\tFail(ctx context.Context, id, reason string, keepUntil time.Time) error\n\tRunningJobs(ctx context.Context) ([]state.Job, error)\n\tAdmission(ctx context.Context, issue int) (state.Admission, error)\n\tSetAdmission(ctx context.Context, a state.Admission) error\n}\n\n// Finisher is *reaper.Finisher: the one way a started job ends.\ntype Finisher interface {\n\tFinishWith(ctx context.Context, jobID string, h executor.Handle, st executor.Status, res agent.Result, o reaper.FinishOptions) (closeout.Outcome, error)\n}\n\n// Git is the read side of *gitx.Git, run against the controller's clone only.\n// It has no Commit or Push: only internal/effects may call those.\ntype Git interface {\n\tFetchRef(ctx context.Context, repoDir, url, refspec string, token gitx.TokenFunc) error\n\tRevParse(ctx context.Context, dir, ref string) (string, error)\n\tMergeBase(ctx context.Context, repoDir, a, b string) (string, error)\n\tDiff(ctx context.Context, repoDir, from, to string, maxBytes int64, exclude ...string) ([]byte, bool, error)\n\tAddedLinesBetween(ctx context.Context, repoDir, from, to string, exclude ...string) (map[string][]gitx.LineRange, error)\n\tCodeChanged(ctx context.Context, repoDir, from, to string, exclude ...string) ([]string, error)\n}\n\n// Offerer is *pool.Pool.\ntype Offerer interface {\n\tOffer(loop string, ttl time.Duration, cands []pool.Candidate) []pool.Decision\n}\n\n// Deps are the loop's collaborators. Executor, Finisher and Parse must be the\n// ones the Reaper uses: the Reaper asks the same executor, and the Finisher\n// shares the one Closer.\ntype Deps struct {\n\tReader   Reader\n\tEffects  Effects\n\tStore    Store\n\tExecutor executor.Executor\n\tFinisher Finisher\n\tGit      Git\n\tPool     func() Offerer // called at tick time: the pool does not exist when loops are built\n\tAgents   *agent.Registry\n\tParse    reaper.ParseFunc\n\tModel    modelauth.Credential // zero = none set\n\n\tRepo      github.Repo\n\tRepoDir   string // absolute path of the controller's clone\n\tRemoteURL string\n\tToken     gitx.TokenFunc\n\tPoll      time.Duration // Status poll interval; default 2s\n\tNow       func() time.Time\n\tLog       *slog.Logger\n}\n\n// Loop is the reviewer loop. It implements controller.Loop.\ntype Loop struct {\n\td Deps\n\n\tmu     sync.Mutex\n\tnoCred bool\n}\n\nvar _ controller.Loop = (*Loop)(nil)\n\n// New returns the loop with defaults applied.\nfunc New(d Deps) *Loop {\n\tif d.Poll <= 0 {\n\t\td.Poll = defaultPoll\n\t}\n\tif d.Now == nil {\n\t\td.Now = time.Now\n\t}\n\tif d.Log == nil {\n\t\td.Log = slog.Default()\n\t}\n\treturn &Loop{d: d}\n}\n\n// Name implements controller.Loop.\nfunc (*Loop) Name() string { return \"reviewers\" }\n\n// Interval implements controller.Loop.\nfunc (*Loop) Interval(c *config.Resolved) time.Duration {\n\tif c == nil || c.Intervals.Reviewers <= 0 {\n\t\treturn defaultInterval\n\t}\n\treturn time.Duration(c.Intervals.Reviewers)\n}\n\n// TickTimeout implements controller.TickTimeouter. A tick never waits for a\n// job.\nfunc (*Loop) TickTimeout(*config.Resolved) time.Duration { return 5 * time.Minute }\n\n// Claims implements controller.Loop: the loop is skipped while paused.\nfunc (*Loop) Claims() bool { return true }\n\nfunc (l *Loop) offer(cfg *config.Resolved, cands []pool.Candidate) []pool.Decision {\n\treturn l.d.Pool().Offer(l.Name(), 2*l.Interval(cfg), cands)\n}\n\n// Tick implements controller.Loop. Errors for one PR are logged and joined, so\n// one bad PR never stops the others.\nfunc (l *Loop) Tick(ctx context.Context, env controller.Env) error {\n\tcfg := env.Cfg\n\tlog := env.Log\n\tif log == nil {\n\t\tlog = l.d.Log\n\t}\n\tif cfg == nil || cfg.SHA == \"\" || len(cfg.RolesOf(config.KindReviewer)) == 0 {\n\t\tl.offer(cfg, nil)\n\t\treturn nil\n\t}\n\tdry := l.d.Effects.DryRun()\n\tif _, err := l.d.Model.Require(); err != nil && !dry {\n\t\tl.mu.Lock()\n\t\tfirst := !l.noCred\n\t\tl.noCred = true\n\t\tl.mu.Unlock()\n\t\tif first {\n\t\t\tlog.Warn(\"review.no_model_credential\", \"hint\", \"agent jobs will not be claimed until one is set\")\n\t\t}\n\t\tl.offer(cfg, nil)\n\t\treturn nil\n\t}\n\tid, err := l.d.Reader.Identity(ctx)\n\tif err != nil {\n\t\tl.offer(cfg, nil)\n\t\treturn fmt.Errorf(\"review: identify github user: %w\", err)\n\t}\n\tt := &tick{l: l, cfg: cfg, log: log, self: id.Login, dry: dry}\n\tcands, errs := t.candidates(ctx)\n\n\tif dry {\n\t\tfor _, c := range cands {\n\t\t\tlog.Info(\"review.would_claim\", \"pr\", c.pr.Number, \"issue\", c.issue.Number, \"role\", c.role.Name)\n\t\t}\n\t\tl.offer(cfg, nil)\n\t\treturn errors.Join(errs...)\n\t}\n\n\tpcs := make([]pool.Candidate, len(cands))\n\tfor i, c := range cands {\n\t\tpcs[i] = pool.Candidate{Class: pool.ClassReview, Role: c.role.Name, Number: c.pr.Number, Since: c.since}\n\t}\n\tdecs := l.offer(cfg, pcs)\n\tstopped := false\n\tfor i, d := range decs {\n\t\tif d.Verdict != pool.Granted || d.Slot == nil {\n\t\t\tcontinue\n\t\t}\n\t\tif stopped {\n\t\t\td.Slot.Release()\n\t\t\tcontinue\n\t\t}\n\t\tc := cands[i]\n\t\tname := fmt.Sprintf(\"review:%s:%d\", c.role.Name, c.pr.Number)\n\t\tslot := d.Slot\n\t\tif err := env.Inflight.Go(name, func(wctx context.Context) { l.run(wctx, env, cfg, c, slot) }); err != nil {\n\t\t\tslot.Release()\n\t\t\tstopped = true\n\t\t\terrs = append(errs, fmt.Errorf(\"review: %w\", err))\n\t\t}\n\t}\n\treturn errors.Join(errs...)\n}\n\n// tick holds what one Tick passes between its steps.\ntype tick struct {\n\tl    *Loop\n\tcfg  *config.Resolved\n\tlog  *slog.Logger\n\tself string\n\tdry  bool\n}\n\n// recheck is the admission re-check a human-filed issue goes through.\nfunc (t *tick) recheck() agentjob.Recheck {\n\td := t.l.d\n\treturn agentjob.Recheck{Stage: \"review\", Stopped: \"reviewing\", Label: intake.Label(t.cfg.Intake),\n\t\tSelf: t.self, Dry: t.dry, Log: t.log, Store: d.Store, Reader: d.Reader, Effects: d.Effects}\n}\npackage reviewer\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/agent\"\n\t\"github.com/albertcbrown/ard/internal/agentjob\"\n\t\"github.com/albertcbrown/ard/internal/closeout\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n\t\"github.com/albertcbrown/ard/internal/executor\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n\t\"github.com/albertcbrown/ard/internal/pool\"\n\t\"github.com/albertcbrown/ard/internal/reaper\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// pinned is what the pin step learns about the PR's head.\ntype pinned struct {\n\ttip, base string\n\tpatch     []byte\n\ttruncated bool\n\tadded     map[string][]gitx.LineRange\n}\n\n// pin fetches the PR's head branch into the controller's clone and requires\n// the tip to be the head GitHub reported. Nothing is claimed yet.\nfunc (l *Loop) pin(ctx context.Context, cfg *config.Resolved, c candidate) (p pinned, step string, err error) {\n\td := l.d\n\tspec := \"+refs/heads/\" + c.pr.HeadRef + \":\" + localRef(c.pr.Number)\n\tif err := d.Git.FetchRef(ctx, d.RepoDir, d.RemoteURL, spec, d.Token); err != nil {\n\t\treturn p, \"fetch\", err\n\t}\n\tif p.tip, err = d.Git.RevParse(ctx, d.RepoDir, localRef(c.pr.Number)); err != nil {\n\t\treturn p, \"rev_parse\", err\n\t}\n\tif p.tip != c.pr.HeadSHA {\n\t\treturn p, \"head_moved\", fmt.Errorf(\"branch is at %.12s, the PR head was %.12s\", p.tip, c.pr.HeadSHA)\n\t}\n\tif p.base, err = d.Git.MergeBase(ctx, d.RepoDir, cfg.SHA, p.tip); err != nil {\n\t\treturn p, \"merge_base\", err\n\t}\n\tif p.patch, p.truncated, err = d.Git.Diff(ctx, d.RepoDir, p.base, p.tip, maxDiffBytes, issueDir(c.issue.Number)); err != nil {\n\t\treturn p, \"diff\", err\n\t}\n\tif p.added, err = d.Git.AddedLinesBetween(ctx, d.RepoDir, p.base, p.tip, issueDir(c.issue.Number)); err != nil {\n\t\treturn p, \"added_lines\", err\n\t}\n\treturn p, \"\", nil\n}\n\n// run claims one granted candidate and watches the job to the end, following\n// the contract in package reaper. It runs in an Inflight goroutine and holds\n// the pool slot until FinishWith has returned.\nfunc (l *Loop) run(ctx context.Context, env controller.Env, cfg *config.Resolved, c candidate, slot *pool.Slot) {\n\tdefer slot.Release()\n\td := l.d\n\tn, pr, role := c.issue.Number, c.pr.Number, c.role\n\tlog := d.Log\n\tif env.Log != nil {\n\t\tlog = env.Log\n\t}\n\tlog = log.With(\"pr\", pr, \"issue\", n, \"role\", role.Name)\n\n\t// 1. The pin and the inputs. Nothing is claimed yet.\n\tp, step, err := l.pin(ctx, cfg, c)\n\tif err != nil {\n\t\tif step == \"head_moved\" {\n\t\t\tlog.Info(\"review.head_moved\", \"detail\", err.Error())\n\t\t} else {\n\t\t\tlog.Error(\"review.claim_failed\", \"step\", step, \"error\", err)\n\t\t}\n\t\treturn\n\t}\n\tcomments, err := d.Reader.ListComments(ctx, n, time.Time{})\n\tif err != nil {\n\t\tlog.Error(\"review.claim_failed\", \"step\", \"list_comments\", \"error\", err)\n\t\treturn\n\t}\n\tdir := agentjob.InputDir(n)\n\tinputs := []executor.File{\n\t\t{Path: dir + \"/diff.patch\", Data: diffInput(pr, c.pr.HeadRef, p.base, p.tip, p.patch, p.truncated)},\n\t\t{Path: dir + \"/issue.md\", Data: agentjob.Snapshot(c.issue)},\n\t\t{Path: dir + \"/comments.md\", Data: agentjob.Comments(comments)},\n\t}\n\t// The committed .ard/<n> holds the plan and the earlier role files and logs.\n\tuntrusted := []string{dir + \"/diff.patch\", dir + \"/issue.md\", dir + \"/comments.md\", fmt.Sprintf(\".ard/%d\", n)}\n\n\t// 2. The claim record.\n\tdata, _ := json.Marshal(map[string]string{\"head\": p.tip, \"base\": p.base})\n\tsj, err := d.Store.CreateJob(ctx, state.NewJob{Stage: stageReview, Role: role.Name, Issue: n, PR: pr, Branch: c.pr.HeadRef, Data: data})\n\tif err != nil {\n\t\tif errors.Is(err, state.ErrConflict) {\n\t\t\treturn\n\t\t}\n\t\tlog.Error(\"review.claim_failed\", \"step\", \"create_job\", \"error\", err)\n\t\treturn\n\t}\n\tslot.SetJobID(sj.ID)\n\tlog = log.With(\"job\", sj.ID)\n\n\t// 3. The running label, on the PR. If it fails nothing has started.\n\trunning := labels.Running(labels.StageReview, role.Name)\n\tif err := d.Effects.AddLabels(ctx, pr, running); err != nil {\n\t\tbg := context.WithoutCancel(ctx)\n\t\tif rerr := d.Effects.RemoveLabel(bg, pr, running); rerr != nil {\n\t\t\tlog.Warn(\"review.unlabel_failed\", \"error\", rerr)\n\t\t}\n\t\tlog.Error(\"review.claim_failed\", \"step\", \"add_running_label\", \"error\", err)\n\t\tif ferr := d.Store.Fail(bg, sj.ID, \"claim: add running label failed\", d.Now()); ferr != nil {\n\t\t\tlog.Error(\"review.fail_record_failed\", \"error\", ferr)\n\t\t}\n\t\treturn\n\t}\n\tlog.Info(\"review.claim\", \"head\", p.tip)\n\n\trc := &closeout.ReviewContext{MergeBase: p.base, Added: p.added}\n\tfinish := func(h executor.Handle, st executor.Status, res agent.Result, cause closeout.Cause) {\n\t\tout, err := d.Finisher.FinishWith(ctx, sj.ID, h, st, res, reaper.FinishOptions{Cause: cause, Review: rc})\n\t\tif err != nil {\n\t\t\t// ErrBusy or any other error leaves a resumable close-out for the Reaper.\n\t\t\tlog.Error(\"review.closeout_failed\", \"error\", err)\n\t\t\treturn\n\t\t}\n\t\tlog.Info(\"review.closeout\", \"outcome\", string(out))\n\t}\n\tcause := func(kind closeout.CauseKind, detail string, retry bool) closeout.Cause {\n\t\treturn reaper.NewCause(sj, kind, detail, retry)\n\t}\n\n\t// 4. Start. Exactly one attempt.\n\tif _, err := d.Store.StartAttempt(ctx, sj.ID); err != nil {\n\t\tlog.Error(\"review.start_failed\", \"step\", \"start_attempt\", \"error\", err)\n\t\tfinish(executor.Handle{}, executor.Status{}, agent.Result{}, cause(closeout.CauseNoProcess, \"could not start the job\", false))\n\t\treturn\n\t}\n\tej := agentjob.ExecJob(cfg, role, executor.Job{\n\t\tID: sj.ID, Repo: d.Repo.String(), Issue: n, Stage: stageReview, Role: role.Name,\n\t\tRepoDir: d.RepoDir, Ref: p.tip, Inputs: inputs,\n\t\tScrub: []string{agent.RoleFilePath(n, stageReview, role.Name)},\n\t})\n\th, err := d.Executor.Prepare(ctx, ej)\n\tif err != nil {\n\t\tlog.Error(\"review.prepare_failed\", \"error\", err)\n\t\tif errors.Is(err, executor.ErrClone) {\n\t\t\tfinish(executor.Handle{}, executor.Status{}, agent.Result{}, cause(closeout.CauseCloneFail, \"could not clone the repository\", true))\n\t\t} else {\n\t\t\tfinish(executor.Handle{}, executor.Status{}, agent.Result{}, cause(closeout.CauseNoProcess, \"could not prepare the job\", false))\n\t\t}\n\t\treturn\n\t}\n\tagentjob.SaveHandle(ctx, d.Store, log, sj.ID, h)\n\tcmd, err := agentjob.AgentCommand(d.Agents, cfg, role, agent.StageReview, n, 0, untrusted, h, d.Model)\n\tif err != nil {\n\t\tlog.Error(\"review.command_failed\", \"error\", err)\n\t\tfinish(h, executor.Status{}, agent.Result{}, cause(closeout.CauseNoProcess, \"could not start the agent\", false))\n\t\treturn\n\t}\n\tif h, err = d.Executor.Start(ctx, h, cmd); err != nil {\n\t\tlog.Error(\"review.start_failed\", \"step\", \"start\", \"error\", err)\n\t\tfinish(h, executor.Status{}, agent.Result{}, cause(closeout.CauseNoProcess, \"could not start the agent\", false))\n\t\treturn\n\t}\n\tagentjob.SaveHandle(ctx, d.Store, log, sj.ID, h)\n\n\t// 5. Wait. Shutdown leaves the agent running: after a restart pool\n\t// adoption and the Reaper own the job.\n\tst, err := agentjob.Wait(ctx, d.Executor, h, d.Poll, env.Stopping)\n\tif err != nil {\n\t\tlog.Warn(\"review.watch_ended\", \"error\", err)\n\t\treturn\n\t}\n\tvar res agent.Result\n\tif d.Parse != nil {\n\t\tvar perr error\n\t\tif res, perr = d.Parse(ctx, cfg, sj, h, st.ExitCode); perr != nil {\n\t\t\tlog.Warn(\"review.parse_failed\", \"error