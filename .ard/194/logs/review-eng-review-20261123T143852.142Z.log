er})\n471\t+\th.claim(issue, reviewer, tipSHA)\n472\t+\th.mustTick()\n473\t+\tif h.draft(pr) {\n474\t+\t\tt.Fatal(\"missed mark was not caught\")\n475\t+\t}\n476\t+}\n477\t+\n478\t+func TestMarkReadyFailureIsRetried(t *testing.T) {\n479\t+\th := newHarness(t)\n480\t+\tpr, issue := readyScenario(h, []string{reviewer})\n481\t+\th.claim(issue, reviewer, tipSHA)\n482\t+\th.gh.FailNext(\"MarkReady\", errBoom)\n483\t+\tout, err := h.readyTick()\n484\t+\tif err != nil {\n485\t+\t\tt.Fatalf(\"tick failed: %v\", err)\n486\t+\t}\n487\t+\tif !strings.Contains(out, \"review.mark_ready_failed\") || !h.draft(pr) {\n488\t+\t\tt.Fatalf(\"log: %s\", out)\n489\t+\t}\n490\t+\th.mustTick()\n491\t+\tif h.draft(pr) {\n492\t+\t\tt.Fatal(\"not retried\")\n493\t+\t}\n494\t+}\n495\tdiff --git a/internal/reviewer/run.go b/internal/reviewer/run.go\n496\tindex f92abb4..ede0c2b 100644\n497\t--- a/internal/reviewer/run.go\n498\t+++ b/internal/reviewer/run.go\n499\t@@ -185,6 +185,9 @@ func (l *Loop) run(ctx context.Context, env controller.Env, cfg *config.Resolved\n500\t \t}\n501\t \trc.HeadMoved = l.headMoved(ctx, log, c, n, p.tip)\n502\t \tfinish(h, st, res, closeout.Cause{})\n503\t+\t// Errors are logged inside maybeReady: close-out is never failed by it.\n504\t+\tt := &tick{l: l, cfg: cfg, log: log, self: c.pr.Author, dry: d.Effects.DryRun()}\n505\t+\tt.maybeReady(ctx, pr)\n506\t }\n507\t \n508\t // issueDir is the only part of .ard/ the reviewer's diff and head check leave\n509\tdiff --git a/internal/worker/run.go b/internal/worker/run.go\n510\tindex bddd2f6..23849e3 100644\n511\t--- a/internal/worker/run.go\n512\t+++ b/internal/worker/run.go\n513\t@@ -711,7 +711,7 @@ func (jb *job) reviewers(ctx context.Context) []string {\n514\t }\n515\t \n516\t // openPR creates or updates the draft PR and records it. The PR stays a draft:\n517\t-// marking it ready is the merger's. It reports false after finishing the job.\n518\t+// the reviewer loop marks it ready once every requested review passes. It r