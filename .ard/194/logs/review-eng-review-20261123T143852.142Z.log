; err != nil {\n+\t\t\t\tt.log.Warn(\"review.ready_check_failed\", \"pr\", prNumber, \"step\", \"fetch\", \"error\", err)\n+\t\t\t\treturn\n+\t\t\t}\n+\t\t\tfetched = true\n+\t\t}\n+\t\tchanged, err := d.Git.CodeChanged(ctx, d.RepoDir, head, pr.HeadSHA, issueDir(issue))\n+\t\tif err != nil {\n+\t\t\tt.log.Warn(\"review.ready_check_failed\", \"pr\", prNumber, \"step\", \"diff\", \"error\", err)\n+\t\t\treturn\n+\t\t}\n+\t\tif len(changed) > 0 {\n+\t\t\tt.log.Debug(\"review.ready_head_moved\", \"pr\", prNumber, \"role\", role)\n+\t\t\treturn\n+\t\t}\n+\t}\n+\tif err := d.Effects.MarkReady(ctx, prNumber); err != nil {\n+\t\tt.log.Warn(\"review.mark_ready_failed\", \"pr\", prNumber, \"issue\", issue, \"error\", err)\n+\t\treturn\n+\t}\n+\tif t.dry {\n+\t\tt.log.Info(\"review.would_mark_ready\", \"pr\", prNumber, \"issue\", issue, \"head\", pr.HeadSHA)\n+\t\treturn\n+\t}\n+\tt.log.Info(\"review.marked_ready\", \"pr\", prNumber, \"issue\", issue, \"head\", pr.HeadSHA)\n+}\n+\n+// reviewedHeads returns, per role, the head recorded by its newest claim.\n+func (t *tick) reviewedHeads(ctx context.Context, issue int, roles []string) (map[string]string, error) {\n+\tevs, err := t.l.d.Store.Events(ctx, state.EventFilter{Kind: state.EventClaim})\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\twant := map[string]bool{}\n+\tfor _, r := range roles {\n+\t\twant[r] = true\n+\t}\n+\tout := map[string]string{}\n+\tfor _, e := range evs { // ascending: later claims overwrite\n+\t\tif e.Issue != issue || e.Stage != stageReview || !want[e.Role] {\n+\t\t\tcontinue\n+\t\t}\n+\t\tvar data struct {\n+\t\t\tHead string `json:\"head\"`\n+\t\t}\n+\t\tif json.Unmarshal(e.Data, &data) == nil && data.Head != \"\" {\n+\t\t\tout[e.Role] = data.Head\n+\t\t}\n+\t}\n+\treturn out, nil\n+}\ndiff --git a/internal/reviewer/ready_test.go b/internal/reviewer/ready_test.go\nnew file mode 100644\nindex 0000000..c9bfa01\n--- /dev/null\n+++ b/internal/reviewer/ready_test.go\n@@ -0,0 +1,210 @@\n+package reviewer\n+\n+import (\n+\t\"bytes\"\n+\t\"context\"\n+\t\"encoding/json\"\n+\t\"log/slog\"\n+\t\"strings\"\n+\t\"sync\"\n+\t\"testing\"\n+\n+\t\"github.com/albertcbrown/ard/internal/controller\"\n+\t\"github.com/albertcbrown/ard/internal/github\"\n+\t\"github.com/albertcbrown/ard/internal/labels\"\n+\t\"github.com/albertcbrown/ard/internal/state\"\n+)\n+\n+type syncBuf struct {\n+\tmu sync.Mutex\n+\tb  bytes.Buffer\n+}\n+\n+func (s *syncBuf) Write(p []byte) (int, error) {\n+\ts.mu.Lock()\n+\tdefer s.mu.Unlock()\n+\treturn s.b.Write(p)\n+}\n+\n+func (s *syncBuf) String() string {\n+\ts.mu.Lock()\n+\tdefer s.mu.Unlock()\n+\treturn s.b.String()\n+}\n+\n+func (h *harness) readyTick() (string, error) {\n+\th.t.Helper()\n+\tbuf := &syncBuf{}\n+\tlog := slog.New(slog.NewTextHandler(buf, &slog.HandlerOptions{Level: slog.LevelDebug}))\n+\tin := controller.NewInflight(context.Background(), quiet)\n+\terr := h.loop.Tick(context.Background(), controller.Env{Log: log, Cfg: h.cfg, Inflight: in, Stopping: h.stop})\n+\t<-in.Wait()\n+\treturn buf.String(), err\n+}\n+\n+func (h *harness) claim(issue int, role, head string) {\n+\th.t.Helper()\n+\tdata, _ := json.Marshal(map[string]string{\"head\": head})\n+\tif err := h.store.AppendEvent(context.Background(), state.Event{Kind: state.EventClaim, Issue: issue, Stage: stageReview, Role: role, Data: data}); err != nil {\n+\t\th.t.Fatal(err)\n+\t}\n+}\n+\n+func doneLabels(roles ...string) []string {\n+\tvar out []string\n+\tfor _, r := range roles {\n+\t\tout = append(out, labels.Request(labels.StageReview, r), labels.Done(labels.StageReview, r))\n+\t}\n+\treturn out\n+}\n+\n+func (h *harness) draft(n int) bool {\n+\th.t.Helper()\n+\tpr, err := h.gh.GetPR(context.Background(), n)\n+\tif err != nil {\n+\t\th.t.Fatal(err)\n+\t}\n+\treturn pr.Draft\n+}\n+\n+func (h *harness) marks() int {\n+\tn := 0\n+\tfor _, c := range h.gh.Writes() {\n+\t\tif c.Method == \"MarkReady\" {\n+\t\t\tn++\n+\t\t}\n+\t}\n+\treturn n\n+}\n+\n+func readyScenario(h *harness, roles []string, mut ...func(*github.PullRequest)) (int, int) {\n+\treturn h.scenario(func(s *scenario) {\n+\t\ts.pr.Labels = doneLabels(roles...)\n+\t\tfor _, m := range mut {\n+\t\t\tm(&s.pr)\n+\t\t}\n+\t})\n+}\n+\n+func TestMarksReadyWhenLastReviewDone(t *testing.T) {\n+\th := newHarness(t)\n+\tpr, issue := readyScenario(h, []string{reviewer, \"sec-review\"})\n+\th.claim(issue, reviewer, tipSHA)\n+\th.claim(issue, \"sec-review\", tipSHA)\n+\tout, err := h.readyTick()\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif h.draft(pr) || h.marks() != 1 {\n+\t\tt.Fatalf(\"draft=%v marks=%d\", h.draft(pr), h.marks())\n+\t}\n+\tif !strings.Contains(out, \"review.marked_ready\") || !strings.Contains(out, \"head=\"+tipSHA) {\n+\t\tt.Errorf(\"log: %s\", out)\n+\t}\n+\t// Never marks twice.\n+\th.mustTick()\n+\tif h.marks() != 1 {\n+\t\tt.Errorf(\"marks = %d\", h.marks())\n+\t}\n+}\n+\n+func TestNoMarkWhileBlocked(t *testing.T) {\n+\tcases := map[string]func(*github.PullRequest){\n+\t\t\"changes\": func(p *github.PullRequest) { p.Labels = append(p.Labels, labels.Changes(reviewer)) },\n+\t\t\"running\": func(p *github.PullRequest) { p.Labels = append(p.Labels, labels.Running(labels.StageReview, reviewer)) },\n+\t\t\"unfinished\": func(p *github.PullRequest) {\n+\t\t\tp.Labels = append(p.Labels, labels.Request(labels.StageReview, \"sec-review\"))\n+\t\t},\n+\t\t\"executor\":     func(p *github.PullRequest) { p.Labels = append(p.Labels, labels.ExecutorFailed) },\n+\t\t\"needs-human\":  func(p *github.PullRequest) { p.Labels = append(p.Labels, labels.NeedsHuman) },\n+\t\t\"hold\":         func(p *github.PullRequest) { p.Labels = append(p.Labels, labels.Hold) },\n+\t\t\"tests-failed\": func(p *github.PullRequest) { p.Labels = append(p.Labels, labels.TestsFailed) },\n+\t\t\"no-request\":   func(p *github.PullRequest) { p.Labels = nil },\n+\t\t\"closed\":       func(p *github.PullRequest) { p.State = github.StateClosed },\n+\t\t\"human\":        func(p *github.PullRequest) { p.Author = \"someone\" },\n+\t\t\"base\":         func(p *github.PullRequest) { p.BaseRef = \"dev\" },\n+\t\t\"branch\":       func(p *github.PullRequest) { p.HeadRef = \"feature/x\" },\n+\t\t\"ready\":        func(p *github.PullRequest) { p.Draft = false },\n+\t}\n+\tfor name, mut := range cases {\n+\t\tt.Run(name, func(t *testing.T) {\n+\t\t\th := newHarness(t)\n+\t\t\tpr, issue := readyScenario(h, []string{reviewer}, mut)\n+\t\t\th.claim(issue, reviewer, tipSHA)\n+\t\t\th.claim(issue, \"sec-review\", tipSHA)\n+\t\t\th.mustTick()\n+\t\t\tif h.marks() != 0 {\n+\t\t\t\tt.Fatalf(\"marked PR %d\", pr)\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+func TestNoMarkWhenHeadMoved(t *testing.T) {\n+\tconst old = \"3333333333333333333333333333333333333333\"\n+\tfor name, tc := range map[string]struct {\n+\t\tchanged []string\n+\t\terr     error\n+\t\tclaim   string\n+\t\twant    int\n+\t}{\n+\t\t\"code changed\": {changed: []string{\"a.go\"}, claim: old, want: 0},\n+\t\t\"ard only\":     {claim: old, want: 1},\n+\t\t\"git error\":    {err: errBoom, claim: old, want: 0},\n+\t\t\"no claim\":     {claim: \"\", want: 0},\n+\t} {\n+\t\tt.Run(name, func(t *testing.T) {\n+\t\t\th := newHarness(t)\n+\t\t\th.git.changed, h.git.changedErr = tc.changed, tc.err\n+\t\t\t_, issue := readyScenario(h, []string{reviewer})\n+\t\t\tif tc.claim != \"\" {\n+\t\t\t\th.claim(issue, reviewer, tc.claim)\n+\t\t\t}\n+\t\t\th.mustTick()\n+\t\t\tif h.marks() != tc.want {\n+\t\t\t\tt.Fatalf(\"marks = %d, want %d\", h.marks(), tc.want)\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+func TestDryRunOnlyLedger(t *testing.T) {\n+\th := newHarness(t, dryRun)\n+\tpr, issue := readyScenario(h, []string{reviewer})\n+\th.claim(issue, reviewer, tipSHA)\n+\th.mustTick()\n+\tif !h.draft(pr) || h.marks() != 0 {\n+\t\tt.Fatal(\"dry run changed the PR\")\n+\t}\n+\tif l := readLedger(t, h.ledger); strings.Count(l, \"MarkReady\") != 1 {\n+\t\tt.Errorf(\"ledger: %q\", l)\n+\t}\n+}\n+\n+func TestSweepWorksWithoutCredential(t *testing.T) {\n+\th := newHarness(t, noCred)\n+\tpr, issue := readyScenario(h, []string{reviewer})\n+\th.claim(issue, reviewer, tipSHA)\n+\th.mustTick()\n+\tif h.draft(pr) {\n+\t\tt.Fatal(\"missed mark was not caught\")\n+\t}\n+}\n+\n+func TestMarkReadyFailureIsRetried(t *testing.T) {\n+\th := newHarness(t)\n+\tpr, issue := readyScenario(h, []string{reviewer})\n+\th.claim(issue, reviewer, tipSHA)\n+\th.gh.FailNext(\"MarkReady\", errBoom)\n+\tout, err := h.readyTick()\n+\tif err != nil {\n+\t\tt.Fatalf(\"tick failed: %v\", err)\n+\t}\n+\tif !strings.Contains(out, \"review.mark_ready_failed\") || !h.draft(pr) {\n+\t\tt.Fatalf(\"log: %s\", out)\n+\t}\n+\th.mustTick()\n+\tif h.draft(pr) {\n+\t\tt.Fatal(\"not retried\")\n+\t}\n+}\ndiff --git a/internal/reviewer/run.go b/internal/reviewer/run.go\nindex f92abb4..ede0c2b 100644\n--- a/internal/reviewer/run.go\n+++ b/internal/reviewer/run.go\n@@ -185,6 +185,9 @@ func (l *Loop) run(ctx context.Context, env controller.Env, cfg *config.Resolved\n \t}\n \trc.HeadMoved = l.headMoved(ctx, log, c, n, p.tip)\n \tfinish(h, st, res, closeout.Cause{})\n+\t// Errors are logged inside maybeReady: close-out is never failed by it.\n+\tt := &tick{l: l, cfg: cfg, log: log, self: c.pr.Author, dry: d.Effects.DryRun()}\n+\tt.maybeReady(ctx, pr)\n }\n \n // issueDir is the only part of .ard/ the reviewer's diff and head check leave\ndiff --git a/internal/worker/run.go b/internal/worker/run.go\nindex bddd2f6..23849e3 100644\n--- a/internal/worker/run.go\n+++ b/internal/worker/run.go\n@@ -711,7 +711,7 @@ func (jb *job) reviewers(ctx context.Context) []string {\n }\n \n // openPR creates or updates the draft PR and records it. The PR stays a draft:\n-// marking it ready is the merger's. It reports false after finishing the job.\n+// the reviewer loop marks it ready once every requested review passes. It reports false after finishing the job.\n func (jb *job) openPR(ctx context.Context, res *closeout.WorkerResult) bool {\n \td := jb.l.d\n \tn := jb.is.Number\n","numLines":5