archOpts{Sort: \"created\", Order: \"asc\", Max: 50})\n162\t+\t\tif err != nil {\n163\t+\t\t\tt.log.Warn(\"review.ready_sweep_failed\", \"role\", role.Name, \"error\", err)\n164\t+\t\t\tcontinue\n165\t+\t\t}\n166\t+\t\tfor _, hit := range hits {\n167\t+\t\t\tif seen[hit.Number] {\n168\t+\t\t\t\tcontinue\n169\t+\t\t\t}\n170\t+\t\t\tseen[hit.Number] = true\n171\t+\t\t\tt.maybeReady(ctx, hit.Number)\n172\t+\t\t}\n173\t+\t}\n174\t+}\n175\t+\n176\t+// maybeReady marks PR prNumber ready for review when every requested review\n177\t+// is done at the PR's current head and nothing blocks it. It never converts a\n178\t+// ready PR back to draft and never merges.\n179\t+func (t *tick) maybeReady(ctx context.Context, prNumber int) {\n180\t+\td := t.l.d\n181\t+\tpr, err := d.Reader.GetPR(ctx, prNumber)\n182\t+\tif err != nil {\n183\t+\t\tt.log.Warn(\"review.ready_check_failed\", \"pr\", prNumber, \"step\", \"get_pr\", \"error\", err)\n184\t+\t\treturn\n185\t+\t}\n186\t+\tif pr.State != github.StateOpen || pr.Merged || !pr.Draft || !strings.EqualFold(pr.Author, t.self) || pr.BaseRef != \"main\" {\n187\t+\t\treturn\n188\t+\t}\n189\t+\t_, issue, ok := parseWorkerBranch(pr.HeadRef)\n190\t+\tif !ok {\n191\t+\t\treturn\n192\t+\t}\n193\t+\tif hasAny(pr.Labels, []string{labels.NeedsHuman, labels.Hold, labels.TestsFailed, labels.ExecutorFailed}) {\n194\t+\t\treturn\n195\t+\t}\n196\t+\tvar requested []string\n197\t+\tfor _, role := range t.cfg.RolesOf(config.KindReviewer) {\n198\t+\t\tif !hasLabel(pr.Labels, labels.Request(labels.StageReview, role.Name)) {\n199\t+\t\t\tcontinue\n200\t+\t\t}\n201\t+\t\tif !hasLabel(pr.Labels, labels.Done(labels.StageReview, role.Name)) ||\n202\t+\t\t\thasLabel(pr.Labels, labels.Changes(role.Name)) ||\n203\t+\t\t\thasLabel(pr.Labels, labels.Running(labels.StageReview, role.Name)) {\n204\t+\t\t\treturn\n205\t+\t\t}\n206\t+\t\trequested = append(requested, role.Name)\n207\t+\t}\n208\t+\tif len(requested) == 0 {\n209\t+\t\treturn\n210\t+\t}\n211\t+\treviewed, err := t.reviewedHeads(ctx, issue, requested)\n212\t+\tif err != nil {\n213\t+\t\tt.log.Warn(\"review.ready_check_failed\", \"pr\", prNumber, \"step\", \"events\", \"error\", err)\n214\t+\t\treturn\n215\t+\t}\n216\t+\tvar fetched bool\n217\t+\tfor _, role := range requested {\n218\t+\t\thead := reviewed[role]\n219\t+\t\tif head == \"\" {\n220\t+\t\t\tt.log.Debug(\"review.ready_head_unknown\", \"pr\", prNumber, \"role\", role)\n221\t+\t\t\treturn\n222\t+\t\t}\n223\t+\t\tif head == pr.HeadSHA {\n224\t+\t\t\tcontinue\n225\t+\t\t}\n226\t+\t\tif !fetched {\n227\t+\t\t\tspec := \"+refs/heads/\" + pr.HeadRef + \":\" + localRef(pr.Number)\n228\t+\t\t\tif err := d.Git.FetchRef(ctx, d.RepoDir, d.RemoteURL, spec, d.Token); err != nil {\n229\t+\t\t\t\tt.log.Warn(\"review.ready_check_failed\", \"pr\", prNumber, \"step\", \"fetch\", \"error\", err)\n230\t+\t\t\t\treturn\n231\t+\t\t\t}\n232\t+\t\t\tfetched = true\n233\t+\t\t}\n234\t+\t\tchanged, err := d.Git.CodeChanged(ctx, d.RepoDir, head, pr.HeadSHA, issueDir(issue))\n235\t+\t\tif err != nil {\n236\t+\t\t\tt.log.Warn(\"review.ready_check_failed\", \"pr\", prNumber, \"step\", \"diff\", \"error\", err)\n237\t+\t\t\treturn\n238\t+\t\t}\n239\t+\t\tif len(changed) > 0 {\n240\t+\t\t\tt.log.Debug(\"review.ready_head_moved\", \"pr\", prNumber, \"role\", role)\n241\t+\t\t\treturn\n242\t+\t\t}\n243\t+\t}\n244\t+\tif err := d.Effects.MarkReady(ctx, prNumber); err != nil {\n245\t+\t\tt.log.Warn(\"review.mark_ready_failed\", \"pr\", prNumber, \"issue\", issue, \"error\", err)\n246\t+\t\treturn\n247\t+\t}\n248\t+\tif t.dry {\n249\t+\t\tt.log.Info(\"review.would_mark_ready\", \"pr\", prNumber, \"issue\", issue, \"head\", pr.HeadSHA)\n250\t+\t\treturn\n251\t+\t}\n252\t+\tt.log.Info(\"review.marked_ready\", \"pr\", prNumber, \"issue\", issue, \"head\", pr.HeadSHA)\n253\t+}\n254\t+\n255\t+// reviewedHeads returns, per role, the head recorded by its newest claim.\n256\t+func (t *tick) reviewedHeads(ctx context.Context, issue int, roles []string) (map[string]string, error) {\n257\t+\tevs, err := t.l.d.Store.Events(ctx, state.EventFilter{Kind: state.EventClaim})\n258\t+\tif err != nil {\n259\t+\t\treturn nil, err\n260\t+\t}\n261\t+\twant := map[string]bool{}\n262\t+\tfor _, r := range roles {\n263\t+\t\twant[r] = true\n264\t+\t}\n265\t+\tout := map[string]string{}\n266\t+\tfor _, e := range evs { // ascending: later claims overwrite\n267\t+\t\tif e.Issue != issue || e.Stage != stageReview || !want[e.Role] {\n268\t+\t\t\tcontinue\n269\t+\t\t}\n270\t+\t\tvar data struct {\n271\t+\t\t\tHead string `json:\"head\"`\n272\t+\t\t}\n273\t+\t\tif json.Unmarshal(e.Data, &data) == nil && data.Head != \"\" {\n274\t+\t\t\tout[e.Role] = data.Head\n275\t+\t\t}\n276\t+\t}\n277\t+\treturn out, nil\n278\t+}\n279\tdiff --git a/internal/reviewer/ready_test.go b/internal/reviewer/ready_test.go\n280\tnew file mode 100644\n281\tindex 0000000..c9bfa01\n282\t--- /dev/null\n283\t+++ b/internal/reviewer/ready_test.go\n284\t@@ -0,0 +1,210 @@\n285\t+package reviewer\n286\t+\n287\t+import (\n288\t+\t\"bytes\"\n289\t+\t\"context\"\n290\t+\t\"encoding/json\"\n291\t+\t\"log/slog\"\n292\t+\t\"strings\"\n293\t+\t\"sync\"\n294\t+\t\"testing\"\n295\t+\n296\t+\t\"github.com/albertcbrown/ard/internal/controller\"\n297\t+\t\"github.com/albertcbrown/ard/internal/github\"\n298\t+\t\"github.com/albertcbrown/ard/internal/labels\"\n299\t+\t\"github.com/albertcbrown/ard/internal/state\"\n300\t+)\n301\t+\n302\t+type syncBuf struct {\n303\t+\tmu sync.Mutex\n304\t+\tb  bytes.Buffer\n305\t+}\n306\t+\n307\t+func (s *syncBuf) Write(p []byte) (int, error) {\n308\t+\ts.mu.Lock()\n309\t+\tdefer s.mu.Unlock()\n310\t+\treturn s.b.Write(p)\n311\t+}\n312\t+\n313\t+func (s *syncBuf) String() string {\n314\t+\ts.mu.Lock()\n315\t+\tdefer s.mu.Unlock()\n316\t+\treturn s.b.String()\n317\t+}\n318\t+\n319\t+func (h *harness) readyTick() (string, error) {\n320\t+\th.t.Helper()\n321\t+\tbuf := &syncBuf{}\n322\t+\tlog := slog.New(slog.NewTextHandler(buf, &slog.HandlerOptions{Level: slog.LevelDebug}))\n323\t+\tin := controller.NewInflight(context.Background(), quiet)\n324\t+\terr := h.loop.Tick(context.Background(), controller.Env{Log: log, Cfg: h.cfg, Inflight: in, Stopping: h.stop})\n325\t+\t<-in.Wait()\n326\t+\treturn buf.String(), err\n327\t+}\n328\t+\n329\t+func (h *harness) claim(issue int, role, head string) {\n330\t+\th.t.Helper()\n331\t+\tdata, _ := json.Marshal(map[string]string{\"head\": head})\n332\t+\tif err := h.store.AppendEvent(context.Background(), state.Event{Kind: state.EventClaim, Issue: issue, Stage: stageReview, Role: role, Data: data}); err != nil {\n333\t+\t\th.t.Fatal(err)\n334\t+\t}\n335\t+}\n336\t+\n337\t+func doneLabels(roles ...string) []string {\n338\t+\tvar out []string\n339\t+\tfor _, r := range roles {\n340\t+\t\tout = append(out, labels.Request(labels.StageReview, r), labels.Done(labels.StageReview, r))\n341\t+\t}\n342\t+\treturn out\n343\t+}\n344\t+\n345\t+func (h *harness) draft(n int) bool {\n346\t+\th.t.Helper()\n347\t+\tpr, err := h.gh.GetPR(context.Background(), n)\n348\t+\tif err != nil {\n349\t+\t\th.t.Fatal(err)\n350\t+\t}\n351\t+\treturn pr.Draft\n352\t+}\n353\t+\n354\t+func (h *harness) marks() int {\n355\t+\tn := 0\n356\t+\tfor _, c := range h.gh.Writes() {\n357\t+\t\tif c.Method == \"MarkReady\" {\n358\t+\t\t\tn++\n359\t+\t\t}\n360\t+\t}\n361\t+\treturn n\n362\t+}\n363\t+\n364\t+func readyScenario(h *harness, roles []string, mut ...func(*github.PullRequest)) (int, int) {\n365\t+\treturn h.scenario(func(s *scenario) {\n366\t+\t\ts.pr.Labels = doneLabels(roles...)\n367\t+\t\tfor _, m := range mut {\n368\t+\t\t\tm(&s.pr)\n369\t+\t\t}\n370\t+\t})\n371\t+}\n372\t+\n373\t+func TestMarksReadyWhenLastReviewDone(t *testing.T) {\n374\t+\th := newHarness(t)\n375\t+\tpr, issue := readyScenario(h, []string{reviewer, \"sec-review\"})\n376\t+\th.claim(issue, reviewer, tipSHA)\n377\t+\th.claim(issue, \"sec-review\", tipSHA)\n378\t+\tout, err := h.readyTick()\n379\t+\tif err != nil {\n380\t+\t\tt.Fatal(err)\n