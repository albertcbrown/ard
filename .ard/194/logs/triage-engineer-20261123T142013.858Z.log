error {\n\tunlock, err := f.begin(\"MarkReady\", n)\n\tdefer unlock()\n\tif err != nil {\n\t\treturn err\n\t}\n\tit, err := f.s.get(n)\n\tif err != nil || !it.isPR {\n\t\treturn fmt.Errorf(\"github: mark ready %d: %w\", n, github.ErrNotFound)\n\t}\n\tit.draft = false\n\tif it.mergeSt == \"draft\" {\n\t\tit.mergeSt = \"clean\"\n\t}\n\tit.issue.UpdatedAt = f.s.now()\n\treturn nil\n}\n\n27:func TestTickDryRunLogsAndClaimsNothing(t *testing.T) {\n39:func TestTickWithoutCredentialClaimsNothing(t *testing.T) {\n48:func TestPinFailuresClaimNothing(t *testing.T) {\n75:func TestClaimAndRun(t *testing.T) {\n154:func TestHeadMovedDuringReview(t *testing.T) {\n57:func (f *fakeEx) Prune(context.Context, time.Duration) error { return nil }\n59:func (f *fakeEx) nPrepared() int {\n65:func (f *fakeEx) Prepare(_ context.Context, j executor.Job) (executor.Handle, error) {\n76:func (f *fakeEx) Start(_ context.Context, h executor.Handle, c executor.Command) (executor.Handle, error) {\n86:func (f *fakeEx) Status(context.Context, executor.Handle) (executor.Status, error) {\n100:func (f *fakeEx) Logs(context.Context, executor.Handle, executor.LogsOptions) (io.ReadCloser, error) {\n104:func (f *fakeEx) Cleanup(context.Context, executor.Handle, executor.CleanupOptions) error { return nil }\n118:func (f *fakeFin) FinishWith(_ context.Context, id string, h executor.Handle, _ executor.Status, _ agent.Result, o reaper.FinishOptions) (closeout.Outcome, error) {\n125:func (f *fakeFin) got() []finishCall {\n149:func (g *fakeGit) FetchRef(_ context.Context, _, _, spec string, _ gitx.TokenFunc) error {\n156:func (g *fakeGit) RevParse(context.Context, string, string) (string, error) {\n167:func (g *fakeGit) MergeBase(context.Context, string, string, string) (string, error) {\n171:func (g *fakeGit) Diff(_ context.Context, _, from, to string, max int64, ex ...string) ([]byte, bool, error) {\n178:func (g *fakeGit) AddedLinesBetween(context.Context, string, string, string, ...string) (map[string][]gitx.Li