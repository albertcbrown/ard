\tlow := strings.ToLower(msg)\n\t\tif strings.Contains(low, \"gh auth login\") || strings.Contains(low, \"not logged in\") || strings.Contains(low, \"authentication\") {\n\t\t\terr = ErrGHUnavailable\n\t\t} else {\n\t\t\tif len(msg) > 300 {\n\t\t\t\tmsg = msg[:300]\n\t\t\t}\n\t\t\terr = fmt.Errorf(\"gh issue edit: %w: %s\", err, msg)\n\t\t}\n\t\treturn l.done(ctx, \"ApproveIssue\", n, err, \"repo\", repo)\n\t}\n\treturn l.done(ctx, \"ApproveIssue\", n, nil, \"repo\", repo)\n}\n\n// ApproveIssue records the call and runs nothing.\nfunc (d *DryRun) ApproveIssue(ctx context.Context, repo string, n int) error {\n\t_, err := d.emit(ctx, \"ApproveIssue\", repo, map[string]any{\"issue\": n, \"label\": labels.Approved}, false, nil)\n\treturn err\n}\npackage servecmd\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/effects\"\n\t\"github.com/albertcbrown/ard/internal/ui\"\n)\n\n// approveTimeout bounds one gh call so a hung gh cannot freeze the UI.\nconst approveTimeout = 30 * time.Second\n\n// approveFn returns the UI's approve action. It runs the operator's own gh\n// through the effect layer (dry-run records it instead). On success it wakes\n// the triage loop so the gate runs now. When gh is missing or logged out it\n// opens the issue page instead. The returned string is the status line.\nfunc approveFn(fx effects.Effects, wake func(reason string, names ...string), repo string, open func(string) error) func(n int) (string, error) {\n\treturn func(n int) (string, error) {\n\t\tctx, cancel := context.WithTimeout(context.Background(), approveTimeout)\n\t\tdefer cancel()\n\t\terr := fx.ApproveIssue(ctx, repo, n)\n\t\tswitch {\n\t\tcase err == nil:\n\t\t\twake(\"ui-approve\", \"triage\")\n\t\t\tif fx.DryRun() {\n\t\t\t\treturn fmt.Sprintf(\"dry-run: would approve #%d\", n), nil\n\t\t\t}\n\t\t\treturn fmt.Sprintf(\"approved #%d\", n), nil\n\t\tcase errors.Is(err, effects.ErrGHUnavailable):\n\t\t\turl := ui.IssueURL(repo, n)\n\t\t\tif open != nil {\n\t\t\t\t_ = open(url)\n\t\t\t}\n\t\t\treturn fmt.Sprintf(\"gh unavailable; add ard:approved at %s\", url), nil\n\t\tdefault:\n\t\t\treturn \"\", err\n\t\t}\n\t}\n}\ndiff --git a/internal/triage/fanin.go b/internal/triage/fanin.go\nindex 14449d2..ba6570e 100644\n--- a/internal/triage/fanin.go\n+++ b/internal/triage/fanin.go\n@@ -213,11 +213,13 @@ func (t *tick) gateIssue(ctx context.Context, n int, busy bool) error {\n \tis, err := l.d.Reader.GetIssue(ctx, n)\n \tif err != nil {\n \t\tif errors.Is(err, github.ErrNotFound) {\n+\t\t\tl.d.Approvals.Remove(n)\n \t\t\treturn nil\n \t\t}\n \t\treturn fmt.Errorf(\"triage gate issue %d: re-read: %w\", n, err)\n \t}\n-\tif is.State != github.StateOpen || is.IsPR {\n+\tif is.State != github.StateOpen || is.IsPR || hasLabel(is.Labels, labels.NeedsHuman) {\n+\t\tl.d.Approvals.Remove(n)\n \t\treturn nil\n \t}\n \tworker, jobID, ok, err := closeout.LeadWorker(ctx, l.d.Store, n)\n@@ -378,6 +380,7 @@ func (t *tick) approved(ctx context.Context, is github.Issue, jobID, worker stri\n \tl := t.l\n \tn := is.Number\n \tif !hasLabel(is.Labels, labels.Approved) {\n+\t\tt.queueApproval(is, worker)\n \t\treturn false, t.askApproval(ctx, n, jobID, worker, rounds)\n \t}\n \ttl, err := l.d.Reader.ListTimeline(ctx, n)\n@@ -431,8 +434,10 @@ func (t *tick) approved(ctx context.Context, is github.Issue, jobID, worker stri\n \t}\n \tif !ev.CreatedAt.After(doneAt) {\n \t\tt.log.Info(\"triage.approval_stale\", \"issue\", n)\n+\t\tt.queueApproval(is, worker)\n \t\treturn false, t.askApproval(ctx, n, jobID, worker, rounds)\n \t}\n+\tl.d.Approvals.Remove(n)\n \treturn true, nil\n }\n \n@@ -446,6 +451,12 @@ func (t *tick) gateEvent(ctx context.Context, issue int, verdict, reason, worker\n \t}\n }\n \n+// queueApproval lists the issue for the command center's approve key.\n+func (t *tick) queueApproval(is github.Issue, worker string) {\n+\tt.l.d.Approvals.Add(QueueItem{Issue: is.Number, Title: is.Title, Role: worker,\n+\t\tP