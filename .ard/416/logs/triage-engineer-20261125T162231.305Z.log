{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H9XMGJmYgSw9FNkpWghbWJ","type":"tool_result","content":"<persisted-output>\nOutput too large (29.7KB). Full output saved to: /ard-home/.claude/projects/-Users-al--ard-work-albertcbrown-ard-01M89R82A6X5GHPRQTY7CB016P/02cba2b4-b686-4402-acbd-010d3b1f1098/tool-results/b4saskrb5.txt\n\nPreview (first 2KB):\n// Package snapshot builds the in-process Snapshot behind the `ard serve`\n// command center (and a later `ard top`): pool, running jobs, kill switches,\n// usage limits, today's issues and spend, and recent log events.\n//\n// Taking a snapshot is cheap and local. It reads memory (pool, limits book,\n// controller) and the SQLite state only; it makes no GitHub call and the\n// package must not import internal/github (an import test enforces it).\npackage snapshot\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"math\"\n\t\"sort\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/budget\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n\t\"github.com/albertcbrown/ard/internal/limits\"\n\t\"github.com/albertcbrown/ard/internal/pool\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// Waiting reasons.\nconst (\n\tReasonSlot    = \"slot\"    // ready, waiting for a free slot\n\tReasonLimited = \"limited\" // account or model family is out of quota\n\tReasonBudget  = \"budget\"  // a daily cap is reached\n)\n\n// Snapshot is a point-in-time view. Errors holds one line per source that\n// failed; the other fields are still filled.\ntype Snapshot struct {\n\tTakenAt time.Time\n\tDayFrom time.Time // 00:00 UTC of TakenAt's day\n\tPool    PoolView\n\tRunning []RunningJob\n\tPause   []PauseView\n\tTicks   []TickView\n\tLimits  LimitsView\n\tIssues  []IssueView\n\tSpend   SpendView\n\tEvents  []Event\n\tErrors  []string\n}\n\n// PoolView is the slot pool.\ntype PoolView struct {\n\tUsed, Max int\n\tWaiting   []Waiting\n}\n\n// Waiting is demand or refused candidates of one role with the reason.\ntype Waiting struct {\n\tClass  string\n\tRole   string\n\tReason string // ReasonSlot, ReasonLimited or ReasonBudget\n\tCount  int\n\tOldest time.Duration // slot waits only\n}\n\n// RunningJob is one job holding a slot.\ntype RunningJob struct {\n\tJobID   string\n\tIssue   int // 0 for a scanner run\n\tPR      int\n\tStage   string\n\tRole    string\n\tModel   string        // from the role config; \"\" is the agent's default\n...\n</persisted-output>","is_error":false}]},"parent_tool_use_id":null,"session_id":"abae8df7-dbbd-4242-ac3a-c6bb6614ddfc","uuid":"0efc9096-a45d-4fc4-b261-13ecd27d5154","timestamp":"2026-11-25T16:22:40.908Z","tool_use_result":{"stdout":"// Package snapshot builds the in-process Snapshot behind the `ard serve`\n// command center (and a later `ard top`): pool, running jobs, kill switches,\n// usage limits, today's issues and spend, and recent log events.\n//\n// Taking a snapshot is cheap and local. It reads memory (pool, limits book,\n// controller) and the SQLite state only; it makes no GitHub call and the\n// package must not import internal/github (an import test enforces it).\npackage snapshot\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"math\"\n\t\"sort\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/budget\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n\t\"github.com/albertcbrown/ard/internal/limits\"\n\t\"github.com/albertcbrown/ard/internal/pool\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// Waiting reasons.\nconst (\n\tReasonSlot    = \"slot\"    // ready, waiting for a free slot\n\tReasonLimited = \"limited\" // account or model family is out of quota\n\tReasonBudget  = \"budget\"  // a daily cap is reached\n)\n\n// Snapshot is a point-in-time view. Errors holds one line per source that\n// failed; the other fields are still filled.\ntype Snapshot struct {\n\tTakenAt time.Time\n\tDayFrom time.Time // 00:00 UTC of TakenAt's day\n\tPool    PoolView\n\tRunning []RunningJob\n\tPause   []PauseView\n\tTicks   []TickView\n\tLimits  LimitsView\n\tIssues  []IssueView\n\tSpend   SpendView\n\tEvents  []Event\n\tErrors  []string\n}\n\n// PoolView is the slot pool.\ntype PoolView struct {\n\tUsed, Max int\n\tWaiting   []Waiting\n}\n\n// Waiting is demand or refused candidates of one role with the reason.\ntype Waiting struct {\n\tClass  string\n\tRole   string\n\tReason string // ReasonSlot, ReasonLimited or ReasonBudget\n\tCount  int\n\tOldest time.Duration // slot waits only\n}\n\n// RunningJob is one job holding a slot.\ntype RunningJob struct {\n\tJobID   string\n\tIssue   int // 0 for a scanner run\n\tPR      int\n\tStage   string\n\tRole    string\n\tModel   string        // from the role config; \"\" is the agent's default\n\tElapsed time.Duration // since the job was created\n\tTimeout time.Duration // from the role config; 0 when unknown\n\t// FinishedCostUSD is the cost of finished steps only; nil when no finished\n\t// step reported a cost. The running step contributes nothing.\n\tFinishedCostUSD *float64\n}\n\n// PauseView is one active kill switch for one claiming loop.\ntype PauseView struct {\n\tLoop   string\n\tReason controller.Reason\n\tErr    string\n}\n\n// TickView is the last tick of a loop.\ntype TickView struct {\n\tLoop       string\n\tCount      int\n\tStart, End time.Time\n\tErr        string\n}\n\n// LimitsView holds the usage-limit readings and active blocks.\ntype LimitsView struct {\n\tWindows []WindowView\n\tBlocks  []BlockView\n}\n\n// WindowView is the latest reading of one subscription window.\ntype WindowView struct {\n\tWindow      string\n\tUtilization float64 // normalised to 0..1\n\tStatus      string\n\tResetsAt    time.Time\n\tAge         time.Duration // now minus when it was observed\n}\n\n// BlockView is an active exhaustion block for a model family (\"\" = unknown).\ntype BlockView struct {\n\tFamily string\n\tUntil  time.Time\n}\n\n// IssueView is an issue with ard activity today.\ntype IssueView struct {\n\tIssue   int\n\tState   string // \"<stage>:<role> running\" or \"<stage>:<role> done|failed\" of the latest job\n\tJobs    int\n\tCostUSD *float64 // total of all recorded steps; nil when none priced\n}\n\n// SpendView is today's spend against the daily caps.\ntype SpendView struct {\n\tRepoUSD   float64\n\tRepoCap   float64 // 0 when no config\n\tUnpriced  int\n\tRoles     []RoleSpend\n\tCappedNow []budget.Cap\n}\n\n// RoleSpend is one role's spend today.\ntype RoleSpend struct {\n\tStage, Role string\n\tUSD         float64\n}\n\n// PoolSource is the slot pool; *pool.Pool satisfies it.\ntype PoolSource interface {\n\tStats() pool.Stats\ninternal/servecmd/serve.go:99:var knownLoops = []string{\"scanners\", stale.Name, \"triage\", \"workers\", \"reviewers\", \"reviewfix\", \"merger\", prwatch.Name, janitor.Name, \"reaper\", \"budget\", digest.Name, controller.ApprovalsName}\ninternal/servecmd/serve.go:395:\t\treturn runWithUI(ctx, cc.Run, w.snap.Take, repo.String(), logPath, os.Stdin, e.Stdout)\ninternal/servecmd/serve.go:741:\t}, Wake: w.wakeLoops, Paused: w.Paused})\n27:    T -->|\"ard:triage:ROLE:done\"| G{\"All triage done<br/>and ard:approved?\"}\n82:| `ard:needs-approval` | Merger | PR touches a protected path; merges after a write-access human approves its head with a GitHub review |\n85:Eight more labels sit outside the grammar: `ard:p0`, `ard:p1`, `ard:p2` and `ard:p3` (priority, set by humans only; ard never sets one: unlabelled counts as P2, several count as the highest; see the job-pool paragraph), `ard:approved` (human go-ahead before a worker starts; counts only when a triage-or-higher collaborator added it after triage finished), `ard:tests:failed` (worker could not get tests green; set by worker close-out on the issue and the PR, cleared by a green run), `ard:keep` (hold failed-job resources past 24 h) and `ard:pause` (on the pinned status issue, stops all new claims). `ard labels sync` creates and updates the full set from the resolved config, idempotently, and never deletes a label: stale `ard:` labels are only reported. In `label` mode a custom `intake.label` is part of the catalogue: sync creates it with a description saying it admits the issue to triage, and switching back to the default leaves the old custom label reported as stale, never deleted. `ard labels sync` and `ard config check` reject an intake label that is one of ard's own label names, naming `intake.label`; `ard serve` logs `config.intake_invalid` once per distinct value. `--repo owner/name` names the repository; when omitted, it is read from the `origin` remote. Role names are at most 31 characters and scanner names at most 38, because GitHub caps a label at 50 characters. Worker role names may not contain an all-digit segment (`eng-12`), so branch names stay unambiguous.\n119:**Repo context docs.** `.ard/PRODUCT.md`, `.ard/VISION.md` and `.ard/TECH_STACK.md` give agents the background a repository's code does not state. They are human-owned: no agent writes them, the worker guard rejects any change under `.ard/`, and `ard init` proposes them only as templates. Each is optional. A file that is missing, or that still holds only the template (headings and comments), counts as absent and is not shown to agents. Precedence, highest first: the role's own prompt and `.ard/config.yaml`, then the issue and its plan, then these docs; they inform a decision and never override the issue's ask. A reviewer reads them from the pull request's head, so a PR that edits one is judged against its own edit, and because the three files are protected paths that edit waits for a human approval. When a doc conflicts with the issue or with another doc, the agent does not pick a side: it reports the conflict in its role file and answers `needs-human`. Treat their content as facts about the project, not as instructions that change an agent's rules. Each template carries a size guidance of about 150 lines and a `Last reviewed: YYYY-MM-DD` line for the human to keep current.\n136:**Network round re-run (#386).** A round is open while the newest bounced worker has no triage engineer `done` after it (job ID order). `Prepare` persists the round in the job record (`NetworkState.Round`, `Done`, `Rerun`), so `Build` stays pure and Resume replays the same plan. The engineer's first `done` in a round consumes it: its close-out clears `ard:triage:lead:done` (`Plan.Clear`, removed in the request phase before the requests are added, 404 counting as success) and adds `ard:pending`, so the lead runs first, and persists the other triage roles that had finished `done` (`Plan.Rerun`). The lead's close-out in that round re-requests those roles and clears their `:done` (roles no longer configured are skipped), so all finish before the gate. A human re-request of the engineer sees no open round and does not re-arm again. The engineer may declare `inputs:` (`path`, `provider` `human` or `worker`, optional https `url`), parsed from the redacted role file and stored in the plan. The gate checks each path (plain characters, clean and relative, not under `.ard/`, `.github/` or `.git`), reads main once per tick at one SHA through `ls-tree` (no content, regular blobs only, size capped, cached per SHA) and holds with a \"waiting for inputs\" comment listing each missing path and the capture-note format until every human-provided input exists. A `worker` input with a `network: false` worker role, a bad path or an oversized file ends `needs-human`. A network round always requires a fresh approval, even with `require_approval: false` and even when the engineer removed every network need: the \"ready for approval\" marker gains a `round=<n>`, and an earlier approval is stale because the engineer's new `:done` follows it. An approval given while inputs are missing still counts once they land. Label state machine: the engineer's `done` close-out removes `ard:triage:lead:done` and adds `ard:pending` before its own `:done`; the lead's close-out removes `:done` from each re-opened role and requests it again; the gate does not run while the lead's `:done` is absent. The gate records one `wait` gate event when it starts waiting for inputs and one `inputs-ready` event when they land; the daily status-issue digest shows a *Waiting for inputs* count of open issues whose newest gate event is the wait.\n153:verdict: approve      # reviewers only: approve | changes (required when status is done)\n287:Before it asks for approval or starts a worker, the gate checks that `.ard/<n>/plan.md` exists on `main`. If it does not, the gate posts one comment, adds `ard:needs-human` and records a `gate` event with reason `no-plan`; a check that fails to run is retried on the next tick. Removing a role's request label by hand does not count as that role finishing. With `require_approval: true` (the Phase 1 default) the gate posts one \"ready for approval\" comment per lead job and waits. `ard:approved` is honoured only when its latest `labeled` event (reset by an `unlabeled`) is by a collaborator with triage permission or higher, is not the App, and comes after the last triage `:done` label of the issue. An approval given earlier is left in place and ignored: the gate waits for a fresh one and does not escalate. An approval from anyone else adds `ard:needs-human` with a comment that does not name the actor. A human who adds `ard:worker:<role>` directly bypasses the gate and has approved by doing so. The gate does not enforce that `triage:engineer` ran: the lead routes and the gate applies its routing. In `--dry-run` the gate logs `triage.would_gate` and writes nothing; otherwise each action records a `gate` event.\n312:**One pool of job slots, drained from the end.** At most `max_pods` jobs (default 3) run at once, shared by every loop. When a slot frees, the controller fills it in this order: reviewers, then workers, then triage, then scanners. Within a class, the priority labels `ard:p0`..`ard:p3` order candidates (unlabelled = P2, several = the highest), then oldest first. Priority never crosses classes: a P3 review still starts before a P0 triage job, and at most a P0 waits for work already finishing. A relabel takes effect on the next poll. Triage and workers also run one extra search per role per tick for `ard:p0`/`ard:p1`, so a P0 beyond the oldest 50 for its role is still found. Reviewers rank by the higher of the PR's and its linked issue's label; they search only PRs, so a P0 label that is only on the issue is ranked but not searched for beyond the oldest 50 (a gap we accept). A grant does not clear the `pool.starved` warning; it re-arms when the class has no wait over the threshold, and the warning names the key and priority of the oldest waiter. In dry-run the `would_claim` lines carry `priority` and come out in rank order. Finishing work in flight beats starting new work, so a busy day grows the scanner backlog, not the pile of half-done PRs. The merger and the Reaper are controller code and take no slot. Slots are granted when a loop polls and nothing is queued: a loop that found work waiting within the last two of its intervals has that demand reserved ahead of lower classes, so a freed slot would otherwise sit idle until that loop's next poll. To avoid that, a released slot (or a raised `max_pods`) wakes the loops with live demand for one tick, after a short debounce (default 2s) so a burst of releases makes one wake; those loops offer as usual, so class order and reservations still decide, and a paused controller ignores the wake. The merger, prwatch and scanners are never woken this way. Hand-offs wake the next loop too (#406): after its label effects succeed, a close-out wakes the loops that now have work (`ard:worker:<role>` wakes workers; `ard:review:<role>` reviewers; `ard:triage:<role>`, `ard:pending` and a triage `:done` label triage, whose fan-in gate adds the worker label; a review `:done` the merger; a review `:changes` reviewfix and workers), through the same debounced per-loop wake, logged as `controller.wake reason=closeout`. A failed, retried, stale or needs-human close-out wakes nothing, and dry-run wakes nothing. A human approval comes from GitHub, so ard polls for it: the approval watch is a controller loop that takes no slot and runs no agent. Every `intervals.approvals` (default and minimum 1m) it makes three searches (`ard:approved`, `ard:needs-human`, `ard:executor:failed` on open items). An approved item with no worker label wakes triage (`reason=approval`); an item that was blocked on the previous poll and no longer is wakes the loops that own it (`reason=unblocked`; the watch keeps the blocked set in memory, so a removal during a restart is left to the loops' own intervals). The woken loop does the real check: the triage gate still requires the approval to come from an allowed actor after triage finished, so a rejected approval starts no worker. A paused controller skips the watch and runs nothing on a wake. The full triage poll keeps its own interval. A scanner run that gets no slot is skipped, not queued. The pool also starts no agent job for an exhausted account or model family until its reset: a job that stops at a subscription usage limit records the limit (in the controller database, so a restart keeps it), and the pool answers `limited` to any candidate whose role runs on that account or family (a whole-account session or weekly limit blocks every role; an Opus or Sonnet limit blocks only roles on that family, and a role with no model, which runs the CLI default, is blocked by any limit). A limited candidate takes no slot and reserves no demand, so lower classes are not held back. The block ends at the reset time the CLI reported; when it reported none the first pause is 30 minutes and each further stop with no reset doubles it up to 4 hours, starting over once a job succeeds; a reset time further away than 8 days is clamped. Running jobs are never killed for a limit. Deterministic scanners and the merger use no model and are unaffected. A daily dollar cap works the same way at the same gate: the pool answers `budget` to a candidate whose role cap or the repo cap is reached, and that candidate takes no slot and reserves no demand. A job that already holds a slot keeps it and finishes.\n356:1. **Poll and claim** `ard:worker:<role>` (added by the triage fan-in gate; the worker never adds or removes it) like triage, also skipping `ard:needs-human`, `ard:hold`, `ard:executor:failed` and an issue that has a running triage job or any running worker job. Workers rank second for job slots, after reviewers. Before claiming, the loop re-checks `ard:approved` when `require_approval` is on (no label change when it is missing), and the admission: an App-authored issue passes, a human-filed one passes only when its stored body hash still matches, and a changed title or body is re-gated exactly as triage does (one comment, `ard:needs-human`).\n368:**Review feedback loops back here.** The `reviewfix` loop (#41) starts a round when every requested reviewer has finished and at least one ended `ard:review:<role>:changes`, backed by that role's close-out record (a label alone does not count). It records a `review_round` event in `_controller.db` (counted when requested, ordered by event ID, local to that database) and removes `ard:worker:<role>:done` from the issue, so the worker loop claims it again. The worker fixes on the same branch and reads `review-feedback.md`. When the fix lands with code changes, every requested reviewer runs again at the new head (their `:done` and `:changes` labels come off), because merge-gating approvals must cover the merged head. A round that changes no code, or one that would pass `max_review_rounds` (default 3), posts one comment and adds `ard:needs-human` on the issue; it is not repeated on the same head after a person removes the label. Removing `ard:needs-human` and pushing a new head caps again at once and never reruns reviewers; to continue, raise max_review_rounds, or fix the PR and remove the ard:review:<role>:changes labels so reviewers rerun. The merger can request a conflict round through the same round API (`reviewfix.RequestRound` with reason `conflict`): a computed conflict at a head with no round yet records a `requested` event and the worker merges `main` into the branch. A conflict round lands when the branch head is a merge commit that includes the round's head (a merge-only resolution changes no code against it, so the no-code check does not apply); otherwise it caps. Conflict and review rounds share `max_review_rounds`, and each event records its reason. This request path is off until part B of #255: the merger's `Rounds` dependency stays unset in `servecmd`, so a conflict, like a red required check, still goes to `ard:needs-human`.\n378:3. **Run the aid, then the agent.** After the pin, a role with an executable `aid` in its directory (reviewers only, like a scanner's `scan`; #205) has it run by the controller as its own executor job at the pinned head, before the agent, so the findings of its deterministic tools do not depend on the host or on the agent choosing to run them. The tool finds; the agent explains, ranks and confirms. The aid job is read-only, has no `Env` and no `Fixed` entries (no model credential, no GitHub token), runs with `--network none` under Docker (a role `Dockerfile` or `ARD_AGENT_IMAGE`; known CVEs stay with the `cve` scanner, so the aid never queries vulnerability databases), and has its own timeout of 5 minutes (shorter if the role's is), counted inside the review job's timeout: the agent gets what is left, at least one minute. Its inputs are `.ard-input/<issue#>/changed.txt` (one path per line, `.ard/<issue#>/` left out) and `diff.patch`. Its output is JSONL on stdout, one object per result with exactly `tool`, `rule`, `file`, `line`, `severity` (`critical`, `high`, `medium`, `low`, `info`) and `message`, capped at 256 KiB (more is a failure). ard validates it: a line that is not JSON, has an unknown key, a bad tool, rule, severity or line, or a path that is absolute, has `..` or is not in `changed.txt` is dropped and counted; a message is redacted, cut at 1 KiB and secret-scanned like a log, and a line that still trips the scanner is dropped. Matched text is never kept: the aid must print rule ids and positions only. The result is written to `.ard-input/<issue#>/aid.jsonl` and is the first of the agent's untrusted inputs; the starter prompt reads it first and runs the tools itself only when the file is absent. **Failure:** a failed, timed-out or invalid aid (any dropped line counts as invalid) never stops the review. The input says the aid failed and why, and close-out turns an `approve` into `changes` with a note. **Blocking:** a `gitleaks` result on a line the PR added becomes a blocking `high` finding with a `[secret]` message that ard adds to the review in code (carrying the rule id only); the agent cannot drop it, and an `approve` becomes `changes`. gosec and semgrep results stay advisory. Both rules apply only to roles that have an `aid`. **Host mode:** with no role `Dockerfile` and no `ARD_AGENT_IMAGE`, the aid runs on the host, as ard-owned code that reads but never executes PR code; its environment holds no credential, but nothing enforces its network, and it runs as the controller's uid without a sandbox: the residual risk of #84 applies to it too. The starter `security-review/aid` pins gosec, gitleaks and semgrep (vendored local rules, `--metrics=off`, `--disable-nosem`) in the role's `Dockerfile`, built on the default ard-agent image (k8s role images stay with #245). Then **run the agent** with `.ard/reviewers/<role>/prompt.txt` and these untrusted inputs: `.ard-input/<issue#>/diff.patch` (the controller's diff from the merge base with `main` to the pinned head, `--stat` then the patch, taken with `--text`, `--no-textconv` and attributes read from the empty tree so a `.gitattributes` entry cannot hide a change, with this issue's `.ard/<issue#>/` left out and cut at 1 MiB), `.ard-input/<issue#>/issue.md` and `comments.md` (written by the loop, never committed), the committed `.ard/<issue#>/` (plan, triage and worker role files and logs) and the sidecar (security policy, license allowlist). The loop runs every git command against the controller clone, never in the reviewer's worktree (the agent itself may run read-only git there). In a later round it also gets `.ard-input/<issue#>/previous-review.md`, its own earlier report, read from the pinned head, and says which findings are resolved.\n379:4. **The agent writes `review-<role>.md`** with `verdict: approve | changes` and `findings:` (`file`, `line`, `severity`, `blocking`, `message`; see the .ard/ contract). It may write nothing else under `.ard/<issue#>/`, and code edits are never collected. An `approve` that carries a blocking finding is treated as `changes` (the job succeeds and the comment says so).\n381:6. **A moved head is not a pass.** Just before close-out the loop compares the branch with the pinned commit. If it gained code outside `.ard/<issue#>/` meanwhile, a `changes` verdict is still posted and labelled (it is the conservative one), but an `approve` is posted without `:done`: the request label stays and the review runs again on the new head. The reviewed commit is recorded in the close-out record so the merger (#46) re-verifies, with `prgate.Covers` against the reviewed head recorded by the review's claim, that no code of the PR changed since before merging: a small window remains between the head check and close-out adding `:done`. A review closed out by the Reaper after a restart has no head information, so an approve is treated as stale.\n390:**The starter license reviewer (`reviewers/license-review`, #44).** `.ard/reviewers/license-review/prompt.txt` checks that every dependency a PR adds or upgrades has a license on the owners' allowlist. The allowlist is one SPDX id per line (`#` comments; `A OR B` passes when any operand is listed, `A AND B` only when all are, `A WITH E` only when listed verbatim; no per-package exceptions). It is read from the sidecar's `licenses/allowlist.txt` when the role has a sidecar and that file exists, else from `allowlist.txt` in the role directory (`$ARD_ROLE_DIR`, read from the config snapshot on `main`, under a protected path). An allowlist found in the PR, the diff, the issue or `.ard/<issue#>/` is ignored, and an unreadable or empty one ends `needs-human`. For Go it runs `go-licenses check` and `go-licenses report` when the tool is on the host `PATH` (optional; it never installs tools), else falls back to `go mod download -json` and the module's LICENSE files; for npm it reads the lockfile `license` field. A license outside the allowlist, or one that cannot be determined, is a blocking `high` finding on the manifest line that adds it (verdict `changes`, so the merger never merges while the label stands); a license that changed but is still allowed is `info`; other ecosystems are `info` and unchecked; no dependency change approves with \"No dependency changes to review\". The starter override is Sonnet 5.5 with `when.paths` listing the manifests and lockfiles above. It ships no Dockerfile, so it runs as a host subprocess with the #84 warning until #55.\n392:**The starter PM reviewer (`reviewers/product-manager-review`, #45).** `.ard/reviewers/product-manager-review/prompt.txt` checks the change against the acceptance criteria. They come from `plan.md`'s `## Requirements` (`### Acceptance criteria`, numbered AC1, AC2), else the issue body; comments never add, relax or remove one, and a plan that contradicts the issue is `needs-human`. Each criterion is marked met, not met or cannot verify, and the change is checked against the out of scope list. A criterion not met is a blocking `high` finding (`critical` when it breaks existing behaviour); cannot verify and out-of-scope work are non-blocking `medium`. With no criteria it approves and says so. It uses read-only Bash only. The starter `when` is `triage: [product-manager]`; a repo adds UI paths under `when.paths`.\n422:- the diff touches no protected path; the list comes only from `merge.protected_paths`, with no floor in code (decided, #3), so a human who empties the list removes the gate. `ard init` proposes the defaults `.github/`, `.ard/config.yaml`, the four role trees (`.ard/scanners/`, `.ard/triage/`, `.ard/workers/`, `.ard/reviewers/`), the three repo context docs (`.ard/PRODUCT.md`, `.ard/VISION.md`, `.ard/TECH_STACK.md`, named one by one, with no `.ard/*.md` glob), `**/CODEOWNERS`, and the agent instructions a PR could plant to steer later agents: `CLAUDE.md`, `**/CLAUDE.md`, `AGENTS.md`, `**/AGENTS.md`, `.claude/` and `.mcp.json`, and the linter config a PR could weaken, `**/.golangci.yml`, `**/.golangci.yaml`, `**/.golangci.toml` and `**/.golangci.json` (20 entries; `**/X` already matches a root `X`, the bare entries are kept for clarity). An entry ending in `/` is a directory prefix; any other entry is a doublestar glob. Matching is case-insensitive on the repo-relative path (macOS file systems are, so `Claude.md` and `.Claude/x` are protected). A prefix matches on a directory boundary (`.github/` matches `.github` and `.github/x`, never `.githubx`). A glob follows doublestar: `*` stays within one path segment and `**` crosses them, so a bare `CODEOWNERS` would match only the root file. Quote globs that start with `*` in YAML. The merger checks both names of a renamed file; a malformed path counts as protected. A PR that touches one gets `ard:needs-approval` and merges on the next poll once a person with write access approves the current head with a GitHub review (below).\n424:A protected path needs a GitHub review in state `APPROVED`, from a user who is not an App and has write, maintain or admin permission, that stands at a commit the current head still covers (the same rule as for reviews). A later `CHANGES_REQUESTED` or `DISMISSED` review by the same person voids it, a plain comment does not. A triage user cannot push or merge on GitHub, so their approval does not authorise a change to `.github/`, config or agent instructions. The label is not the approval: `ard:needs-approval` is informational, the merger adds it and posts one comment per head, and removing it changes nothing.\n472:require_approval: true       # human adds ard:approved before a worker starts\n478:intervals: { scanners: 4h, triage: 15m, workers: 5m, reviewers: 5m, merger: 5m, prwatch: 5m, approvals: 1m }\n538:- **Merges are gated.** The merger lands a PR only when every review passed and required checks (read from the branch rules API) are green on an up-to-date branch; protected paths wait for a write-access human approval. The App bypasses `main`'s ruleset (its direct `.ard/` commits need it), so the merger's own check that required checks are green is what gates a merge, backed by the bot-commit audit.\ninternal/labels/labels.go:48:\tApproved       = \"ard:approved\"\n\tfor _, x := range s.Limits.Windows {\n\t\tadd(fmt.Sprintf(\"%s %3.0f%% %s resets %s\", Clean(x.Window), x.Utilization*100, Clean(x.Status), x.ResetsAt.UTC().Format(\"15:04Z\")))\n\t}\n\n\tvar tail []string\n\tif w >= largeWidth && h >= largeHeight {\n\t\ttail = append(tail, headStyle.Render(\"Next tick\"))\n\t\tfor _, t := range s.Ticks {\n\t\t\tl := fmt.Sprintf(\"%-10s ticks %d last %s\", Clean(t.Loop), t.Count, t.End.UTC().Format(\"15:04:05Z\"))\n\t\t\tif t.Err != \"\" {\n\t\t\t\tl += \" err: \" + Clean(t.Err)\n\t\t\t}\n\t\t\ttail = append(tail, Trunc(l, w))\n\t\t}\n\t\ttail = append(tail, headStyle.Render(\"Recent events\"))\n\t\tev := s.Events\n\t\tif len(ev) > 8 {\n\t\t\tev = ev[len(ev)-8:]\n\t\t}\n\t\tfor _, e := range ev {\n\t\t\ttail = append(tail, Trunc(fmt.Sprintf(\"%s %s %s %s\", e.Time.UTC().Format(\"15:04:05\"), e.Level, Clean(e.Msg), Clean(e.Attrs)), w))\n\t\t}\n\t}\n\n\tif m.help {\n\t\tlines = append(lines, headStyle.Render(\"Help\"),\n\t\t\t\"?  toggle help\", \"j/k, arrows  select issue\", \"o  open selected issue in the browser\", \"q  quit (asks first)\", \"ctrl+c  stop now\")\n\t}\n\n\troom := h - len(lines) - len(tail) - 2 // issues heading and footer\n\tif room < 1 {\n\t\troom = 1\n\t}\n\tpages := (len(s.Issues) + room - 1) / room\n\tif pages < 1 {\n\t\tpages = 1\n\t}\n\tpage := m.selected / room\n\ttitle := \"Issues\"\n\tif pages > 1 {\n\t\ttitle = fmt.Sprintf(\"Issues (page %d/%d)\", page+1, pages)\n\t}\n\tsection(title)\n\tif len(s.Issues) == 0 {\n\t\tlines = append(lines, dimStyle.Render(\"none today\"))\n\t}\n\tfor i := page * room; i < len(s.Issues) && i < (page+1)*room; i++ {\n\t\tx := s.Issues[i]\n\t\tl := Trunc(fmt.Sprintf(\"#%-5d %s  jobs %d  %s\", x.Issue, Clean(x.State), x.Jobs, usd(x.CostUSD)), w)\n\t\tif i == m.selected {\n\t\t\tl = selStyle.Render(l)\n\t\t}\n\t\tlines = append(lines, l)\n\t}\n\tlines = append(lines, tail...)\n\n\tfooter := \"? help  j/k select  o open  q quit\"\n\tif m.confirmQuit {\n\t\tfooter = \"quit? y/n\"\n\t}\n\tif len(lines) > h-1 {\n\t\tlines = lines[:h-1]\n\t}\n\tfor len(lines) < h-1 {\n\t\tlines = append(lines, \"\")\n\t}\n\tlines = append(","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/ard-home/.claude/projects/-Users-al--ard-work-albertcbrown-ard-01M89R82A6X5GHPRQTY7CB016P/02cba2b4-b686-4402-acbd-010d3b1f1098/tool-results/b4saskrb5.txt","persistedOutputSize":30407},"tool_result_meta":[{"id":"toolu_01H9XMGJmYgSw9FNkpWghbWJ","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
