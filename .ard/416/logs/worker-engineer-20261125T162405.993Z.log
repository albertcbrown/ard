ynthetic results (negative numbers, see IsSynthetic). Open is the factory;\n// it is the only place that builds the GitHub client and it hands everyone\n// else a read-only view.\npackage effects\n\nimport (\n\t\"context\"\n\t\"errors\"\n\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n)\n\n// CommitOp and PushOp are gitx's types. PushOp.ForceWithLease is the expected\n// remote SHA (#17 calls it ExpectSHA).\ntype (\n\tCommitOp = gitx.CommitOp\n\tPushOp   = gitx.PushOp\n)\n\n// Sentinels re-exported so callers need not import gitx.\nvar (\n\t// ErrNothingToCommit is returned by Commit, live and dry-run alike, when\n\t// the index is unchanged. Callers treat it as a no-op.\n\tErrNothingToCommit = gitx.ErrNothingToCommit\n\tErrNonFastForward  = gitx.ErrNonFastForward\n\tErrStaleLease      = gitx.ErrStaleLease\n\tErrTransient       = gitx.ErrTransient\n)\n\n// ErrSyntheticTarget is returned by Live when asked to act on a dry-run\n// (negative or zero) issue or PR number.\nvar ErrSyntheticTarget = errors.New(\"effects: synthetic dry-run number used on a live target\")\n\n// IsSynthetic reports whether n is a dry-run number.\nfunc IsSynthetic(n int) bool { return n < 0 }\n\n// CommitResult is the outcome of Commit. Synthetic is true in dry-run, where\n// SHA is a stable hash and no commit exists.\ntype CommitResult struct {\n\tSHA       string\n\tSynthetic bool\n}\n\n// Effects is every side effect the controller can cause.\ntype Effects interface {\n\tgithub.Writer\n\t// UpdateIssueBody replaces an issue body (UpdateIssue with only Body set).\n\tUpdateIssueBody(ctx context.Context, n int, body string) error\n\t// Commit commits what is already staged in op.Dir. It returns\n\t// ErrNothingToCommit when nothing is staged.\n\tCommit(ctx context.Context, op CommitOp) (CommitResult, error)\n\tPush(ctx context.Context, op PushOp) error\n\t// DryRun reports whether effects are only logged.\n\tDryRun() bool\n}\n\nfunc isNothing(err error) bool { return errors.Is(err, ErrNothingToCommit) }\npackage effects\n\nimport (\n\t\"context\"\n\t\"crypto/sha1\" //nolint:gosec // identifier hash, not security\n\t\"encoding/hex\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"sort\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/github\"\n)\n\n// DryRunOptions configures NewDryRun.\ntype DryRunOptions struct {\n\tLog        *slog.Logger\n\tLedgerPath string                                                  // \"\" = in-memory counter, no ledger file\n\tRedact     func(string) string                                     // nil = identity; #21 plugs in later\n\tStaged     func(ctx context.Context, dir string) ([]string, error) // usually (*gitx.Git).StagedPaths; nil = skip\n}\n\n// DryRun logs and records effects without performing any. It holds no writer.\ntype DryRun struct {\n\tlog    *slog.Logger\n\tredact func(string) string\n\tstaged func(ctx context.Context, dir string) ([]string, error)\n\n\tmu     sync.Mutex\n\tnext   int // next synthetic number, always negative\n\tledger ledgerFile\n\tpath   string // ledger file, \"\" when in memory\n\tbroken error  // set when the ledger could not be repaired; fails every later effect\n}\n\nvar _ Effects = (*DryRun)(nil)\n\n// NewDryRun builds a DryRun, recovering the synthetic counter from the ledger.\nfunc NewDryRun(o DryRunOptions) (*DryRun, error) {\n\td := &DryRun{log: o.Log, redact: o.Redact, staged: o.Staged, next: -1}\n\tif d.log == nil {\n\t\td.log = slog.Default()\n\t}\n\tif d.redact == nil {\n\t\td.redact = func(s string) string { return s }\n\t}\n\tif o.LedgerPath != \"\" {\n\t\tf, next, err := openLedger(o.LedgerPath)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\td.ledger, d.next, d.path = f, next, o.LedgerPath\n\t}\n\treturn d, nil\n}\n\n// Close releases the ledger file.\nfunc (d *DryRun) Close() error {\n\tif d.ledger == nil {\n\t\treturn nil\n\t}\n\treturn d.ledger.Close()\n}\n\nfunc (d *DryRun) DryRun() bool { return true }\n\n// emit logs and records one effect. If alloc, it assigns the next synthetic\n// number and passes it to result.\nfunc (d *DryRun) emit(ctx context.Context, op, target string, payload map[string]any, alloc bool, result func(n int) map[string]any) (int, error) {\n\tif err := ctx.Err(); err != nil {\n\t\treturn 0, fmt.Errorf(\"effects: %s: %w\", op, err)\n\t}\n\td.mu.Lock()\n\tdefer d.mu.Unlock()\n\tif d.broken != nil {\n\t\treturn 0, fmt.Errorf(\"effects: %s: %w\", op, d.broken)\n\t}\n\tn := 0\n\tif alloc {\n\t\tn = d.next\n\t\td.next-- // never reissue a number, even if the append below fails\n\t}\n\tvar res map[string]any\n\tif result != nil {\n\t\tres = result(n)\n\t}\n\tif d.ledger != nil {\n\t\tr := record{TS: time.Now().UTC(), Op: op, Target: target, Payload: payload, Result: res}\n\t\terr, broken := appendRecord(d.ledger, r)\n\t\tif broken != nil {\n\t\t\td.broken = broken\n\t\t}\n\t\tif err != nil {\n\t\t\treturn 0, fmt.Errorf(\"effects: %s: %w\", op, err)\n\t\t}\n\t}\n\td.log.InfoContext(ctx, \"effect\", \"op\", op, \"dry_run\", true, \"target\", target, \"payload\", payload, \"result\", res)\n\treturn n, nil\n}\n\nfunc (d *DryRun) r(s string) string { return d.redact(s) }\n\nfunc (d *DryRun) CreateIssue(ctx context.Context, in github.NewIssue) (github.Issue, error) {\n\tp := map[string]any{\"title\": d.r(in.Title), \"body\": d.r(in.Body), \"labels\": in.Labels}\n\tvar url string\n\tn, err := d.emit(ctx, \"CreateIssue\", \"\", p, true, func(n int) map[string]any {\n\t\turl = fmt.Sprintf(\"dry-run://issue/%d\", n)\n\t\treturn map[string]any{\"number\": n, \"url\": url}\n\t})\n\tif err != nil {\n\t\treturn github.Issue{}, err\n\t}\n\treturn github.Issue{Number: n, Title: in.Title, Body: in.Body, Labels: in.Labels, State: github.StateOpen, URL: url}, nil\n}\n\nfunc (d *DryRun) UpdateIssue(ctx context.Context, n int, u github.IssueUpdate) error {\n\tp := map[string]any{}\n\tif u.Title != nil {\n\t\tp[\"title\"] = d.r(*u.Title)\n\t}\n\tif u.Bod