{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019amVj9hpgRKkH6qjxMo6sE","type":"tool_result","content":"package ui\n\nimport (\n\t\"fmt\"\n\t\"strings\"\n\t\"time\"\n\n\t\"charm.land/lipgloss/v2\"\n)\n\nconst (\n\tminWidth, minHeight     = 20, 8\n\tlargeWidth, largeHeight = 100, 40\n)\n\nvar (\n\ttitleStyle = lipgloss.NewStyle().Bold(true)\n\theadStyle  = lipgloss.NewStyle().Bold(true).Underline(true)\n\tselStyle   = lipgloss.NewStyle().Reverse(true)\n\twarnStyle  = lipgloss.NewStyle().Bold(true)\n\tdimStyle   = lipgloss.NewStyle().Faint(true)\n)\n\nfunc dur(d time.Duration) string {\n\td = d.Round(time.Second)\n\tif d < 0 {\n\t\td = 0\n\t}\n\tif d >= time.Hour {\n\t\treturn fmt.Sprintf(\"%dh%02dm\", int(d.Hours()), int(d.Minutes())%60)\n\t}\n\treturn fmt.Sprintf(\"%dm%02ds\", int(d.Minutes()), int(d.Seconds())%60)\n}\n\nfunc usd(p *float64) string {\n\tif p == nil {\n\t\treturn \"-\"\n\t}\n\treturn fmt.Sprintf(\"$%.2f\", *p)\n}\n\n// Render draws the model into a string of height lines, each at most width\n// cells wide. It is pure: the clock comes from the snapshot. Every string that\n// came from outside the process goes through Clean or Trunc.\nfunc Render(m Model) string {\n\tw, h := m.width, m.height\n\tif w < minWidth || h < minHeight {\n\t\treturn \"terminal too small\"\n\t}\n\ts := m.snap\n\tvar lines []string\n\tadd := func(l string) { lines = append(lines, Trunc(l, w)) }\n\tsection := func(t string) { lines = append(lines, headStyle.Render(Trunc(t, w))) }\n\n\tadd(titleStyle.Render(\"ard serve\") + \"  \" + Clean(m.Repo))\n\thdr := fmt.Sprintf(\"%s  pool %d/%d  spend $%.2f\", s.TakenAt.UTC().Format(\"2006-01-02 15:04:05Z\"), s.Pool.Used, s.Pool.Max, s.Spend.RepoUSD)\n\tif s.Spend.RepoCap > 0 {\n\t\thdr += fmt.Sprintf(\" of $%.2f\", s.Spend.RepoCap)\n\t}\n\tadd(hdr)\n\tif m.LogPath != \"\" {\n\t\tadd(dimStyle.Render(\"logs: \" + Clean(m.LogPath)))\n\t}\n\n\tsection(\"Needs you\")\n\tneed := 0\n\tfor _, p := range s.Pause {\n\t\tneed++\n\t\tadd(warnStyle.Render(\"paused\") + fmt.Sprintf(\" %s: %s %s\", Clean(p.Loop), Clean(string(p.Reason)), Clean(p.Err)))\n\t}\n\tfor _, c := range s.Spend.CappedNow {\n\t\tneed++\n\t\tadd(warnStyle.Render(\"capped\") + fmt.Sprintf(\" %v\", c))\n\t}\n\tfor _, b := range s.Limits.Blocks {\n\t\tneed++\n\t\tfam := Clean(b.Family)\n\t\tif fam == \"\" {\n\t\t\tfam = \"unknown\"\n\t\t}\n\t\tadd(warnStyle.Render(\"limit\") + fmt.Sprintf(\" %s until %s\", fam, b.Until.UTC().Format(\"15:04Z\")))\n\t}\n\tfor _, e := range s.Errors {\n\t\tneed++\n\t\tadd(warnStyle.Render(\"error\") + \" \" + Clean(e))\n\t}\n\tif need == 0 {\n\t\tadd(dimStyle.Render(\"nothing\"))\n\t}\n\n\tsection(fmt.Sprintf(\"Running (%d)\", len(s.Running)))\n\tfor _, r := range s.Running {\n\t\tref := \"scan\"\n\t\tif r.Issue > 0 {\n\t\t\tref = fmt.Sprintf(\"#%d\", r.Issue)\n\t\t}\n\t\tt := dur(r.Elapsed)\n\t\tif r.Timeout > 0 {\n\t\t\tt += \"/\" + dur(r.Timeout)\n\t\t}\n\t\tadd(fmt.Sprintf(\"%-6s %s:%s %s %s\", ref, Clean(r.Stage), Clean(r.Role), t, usd(r.FinishedCostUSD)))\n\t}\n\n\tsection(\"Waiting\")\n\tif len(s.Pool.Waiting) == 0 {\n\t\tadd(dimStyle.Render(\"nothing\"))\n\t}\n\tfor _, x := range s.Pool.Waiting {\n\t\tl := fmt.Sprintf(\"%s:%s %d %s\", Clean(x.Class), Clean(x.Role), x.Count, Clean(x.Reason))\n\t\tif x.Oldest > 0 {\n\t\t\tl += \" oldest \" + dur(x.Oldest)\n\t\t}\n\t\tadd(l)\n\t}\n\n\tsection(\"Limits\")\n\tif len(s.Limits.Windows) == 0 {\n\t\tadd(dimStyle.Render(\"no readings\"))\n\t}\n\tfor _, x := range s.Limits.Windows {\n\t\tadd(fmt.Sprintf(\"%s %3.0f%% %s resets %s\", Clean(x.Window), x.Utilization*100, Clean(x.Status), x.ResetsAt.UTC().Format(\"15:04Z\")))\n\t}\n\n\tvar tail []string\n\tif w >= largeWidth && h >= largeHeight {\n\t\ttail = append(tail, headStyle.Render(\"Next tick\"))\n\t\tfor _, t := range s.Ticks {\n\t\t\tl := fmt.Sprintf(\"%-10s ticks %d last %s\", Clean(t.Loop), t.Count, t.End.UTC().Format(\"15:04:05Z\"))\n\t\t\tif t.Err != \"\" {\n\t\t\t\tl += \" err: \" + Clean(t.Err)\n\t\t\t}\n\t\t\ttail = append(tail, Trunc(l, w))\n\t\t}\n\t\ttail = append(tail, headStyle.Render(\"Recent events\"))\n\t\tev := s.Events\n\t\tif len(ev) > 8 {\n\t\t\tev = ev[len(ev)-8:]\n\t\t}\n\t\tfor _, e := range ev {\n\t\t\ttail = append(tail, Trunc(fmt.Sprintf(\"%s %s %s %s\", e.Time.UTC().Format(\"15:04:05\"), e.Level, Clean(e.Msg), Clean(e.Attrs)), w))\n\t\t}\n\t}\n\n\tif m.help {\n\t\tlines = append(lines, headStyle.Render(\"Help\"),\n\t\t\t\"?  toggle help\", \"j/k, arrows  select issue\", \"o  open selected issue in the browser\", \"q  quit (asks first)\", \"ctrl+c  stop now\")\n\t}\n\n\troom := h - len(lines) - len(tail) - 2 // issues heading and footer\n\tif room < 1 {\n\t\troom = 1\n\t}\n\tpages := (len(s.Issues) + room - 1) / room\n\tif pages < 1 {\n\t\tpages = 1\n\t}\n\tpage := m.selected / room\n\ttitle := \"Issues\"\n\tif pages > 1 {\n\t\ttitle = fmt.Sprintf(\"Issues (page %d/%d)\", page+1, pages)\n\t}\n\tsection(title)\n\tif len(s.Issues) == 0 {\n\t\tlines = append(lines, dimStyle.Render(\"none today\"))\n\t}\n\tfor i := page * room; i < len(s.Issues) && i < (page+1)*room; i++ {\n\t\tx := s.Issues[i]\n\t\tl := Trunc(fmt.Sprintf(\"#%-5d %s  jobs %d  %s\", x.Issue, Clean(x.State), x.Jobs, usd(x.CostUSD)), w)\n\t\tif i == m.selected {\n\t\t\tl = selStyle.Render(l)\n\t\t}\n\t\tlines = append(lines, l)\n\t}\n\tlines = append(lines, tail...)\n\n\tfooter := \"? help  j/k select  o open  q quit\"\n\tif m.confirmQuit {\n\t\tfooter = \"quit? y/n\"\n\t}\n\tif len(lines) > h-1 {\n\t\tlines = lines[:h-1]\n\t}\n\tfor len(lines) < h-1 {\n\t\tlines = append(lines, \"\")\n\t}\n\tlines = append(lines, dimStyle.Render(Trunc(footer, w)))\n\treturn strings.Join(lines, \"\\n\")\n}\n// Package snapshot builds the in-process Snapshot behind the `ard serve`\n// command center (and a later `ard top`): pool, running jobs, kill switches,\n// usage limits, today's issues and spend, and recent log events.\n//\n// Taking a snapshot is cheap and local. It reads memory (pool, limits book,\n// controller) and the SQLite state only; it makes no GitHub call and the\n// package must not import internal/github (an import test enforces it).\npackage snapshot\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"math\"\n\t\"sort\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/budget\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n\t\"github.com/albertcbrown/ard/internal/limits\"\n\t\"github.com/albertcbrown/ard/internal/pool\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// Waiting reasons.\nconst (\n\tReasonSlot    = \"slot\"    // ready, waiting for a free slot\n\tReasonLimited = \"limited\" // account or model family is out of quota\n\tReasonBudget  = \"budget\"  // a daily cap is reached\n)\n\n// Snapshot is a point-in-time view. Errors holds one line per source that\n// failed; the other fields are still filled.\ntype Snapshot struct {\n\tTakenAt time.Time\n\tDayFrom time.Time // 00:00 UTC of TakenAt's day\n\tPool    PoolView\n\tRunning []RunningJob\n\tPause   []PauseView\n\tTicks   []TickView\n\tLimits  LimitsView\n\tIssues  []IssueView\n\tSpend   SpendView\n\tEvents  []Event\n\tErrors  []string\n}\n\n// PoolView is the slot pool.\ntype PoolView struct {\n\tUsed, Max int\n\tWaiting   []Waiting\n}\n\n// Waiting is demand or refused candidates of one role with the reason.\ntype Waiting struct {\n\tClass  string\n\tRole   string\n\tReason string // ReasonSlot, ReasonLimited or ReasonBudget\n\tCount  int\n\tOldest time.Duration // slot waits only\n}\n\n// RunningJob is one job holding a slot.\ntype RunningJob struct {\n\tJobID   string\n\tIssue   int // 0 for a scanner run\n\tPR      int\n\tStage   string\n\tRole    string\n\tModel   string        // from the role config; \"\" is the agent's default\n\tElapsed time.Duration // since the job was created\n\tTimeout time.Duration // from the role config; 0 when unknown\n\t// FinishedCostUSD is the cost of finished steps only; nil when no finished\n\t// step reported a cost. The running step contributes nothing.\n\tFinishedCostUSD *float64\n}\n\n// PauseView is one active kill switch for one claiming loop.\ntype PauseView struct {\n\tLoop   string\n\tReason controller.Reason\n\tErr    string\n}\n\n// TickView is the last tick of a loop.\ntype TickView struct {\n\tLoop       string\n\tCount      int\n\tStart, End time.Time\n\tErr        string\n}\n\n// LimitsView holds the usage-limit readings and active blocks.\ntype LimitsView struct {\n\tWindows []WindowView\n\tBlocks  []BlockView\n}\n\n// WindowView is the latest reading of one subscription window.\ntype WindowView struct {\n\tWindow      string\n\tUtilization float64 // normalised to 0..1\n\tStatus      string\n\tResetsAt    time.Time\n\tAge         time.Duration // now minus when it was observed\n}\n\n// BlockView is an active exhaustion block for a model family (\"\" = unknown).\ntype BlockView struct {\n\tFamily string\n\tUntil  time.Time\n}\n\n// IssueView is an issue with ard activity today.\ntype IssueView struct {\n\tIssue   int\n\tState   string // \"<stage>:<role> running\" or \"<stage>:<role> done|failed\" of the latest job\n\tJobs    int\n\tCostUSD *float64 // total of all recorded steps; nil when none priced\npackage servecmd\n\nimport (\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n\t\"github.com/albertcbrown/ard/internal/snapshot\"\n)\n\n// snapshotEvents is how many recent log records the command center keeps.\nconst snapshotEvents = 200\n\n// newSnapshotTaker builds the command center's Snapshot source. The pool and\n// the limits book exist only after the startup hooks, so they are looked up\n// at Take time; a Take before that sees them as absent. It makes no GitHub\n// call: the kill-switch state comes from the controller's last tick.\nfunc (w *wiring) newSnapshotTaker(c *controller.Controller, events *snapshot.Ring) *snapshot.Taker {\n\treturn snapshot.New(snapshot.Sources{\n\t\tPool: func() snapshot.PoolSource {\n\t\t\tif p := w.pool.Load(); p != nil {\n\t\t\t\treturn p\n\t\t\t}\n\t\t\treturn nil\n\t\t},\n\t\tLimits: func() snapshot.LimitSource {\n\t\t\tw.initMu.Lock()\n\t\t\tdefer w.initMu.Unlock()\n\t\t\tif w.lim != nil {\n\t\t\t\treturn w.lim\n\t\t\t}\n\t\t\treturn nil\n\t\t},\n\t\tState:   w.Store,\n\t\tControl: c,\n\t\tCaps:    w.budgetGate(),\n\t\tConfig:  func() *config.Resolved { return w.cfg.Load() },\n\t\tRing:    events,\n\t})\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"d67cc239-f6be-49dc-a02c-1346253e1fa2","uuid":"a4014036-2d30-4d76-8f1c-8f0f48bad7fb","timestamp":"2026-11-25T16:24:11.788Z","tool_use_result":{"stdout":"package ui\n\nimport (\n\t\"fmt\"\n\t\"strings\"\n\t\"time\"\n\n\t\"charm.land/lipgloss/v2\"\n)\n\nconst (\n\tminWidth, minHeight     = 20, 8\n\tlargeWidth, largeHeight = 100, 40\n)\n\nvar (\n\ttitleStyle = lipgloss.NewStyle().Bold(true)\n\theadStyle  = lipgloss.NewStyle().Bold(true).Underline(true)\n\tselStyle   = lipgloss.NewStyle().Reverse(true)\n\twarnStyle  = lipgloss.NewStyle().Bold(true)\n\tdimStyle   = lipgloss.NewStyle().Faint(true)\n)\n\nfunc dur(d time.Duration) string {\n\td = d.Round(time.Second)\n\tif d < 0 {\n\t\td = 0\n\t}\n\tif d >= time.Hour {\n\t\treturn fmt.Sprintf(\"%dh%02dm\", int(d.Hours()), int(d.Minutes())%60)\n\t}\n\treturn fmt.Sprintf(\"%dm%02ds\", int(d.Minutes()), int(d.Seconds())%60)\n}\n\nfunc usd(p *float64) string {\n\tif p == nil {\n\t\treturn \"-\"\n\t}\n\treturn fmt.Sprintf(\"$%.2f\", *p)\n}\n\n// Render draws the model into a string of height lines, each at most width\n// cells wide. It is pure: the clock comes from the snapshot. Every string that\n// came from outside the process goes through Clean or Trunc.\nfunc Render(m Model) string {\n\tw, h := m.width, m.height\n\tif w < minWidth || h < minHeight {\n\t\treturn \"terminal too small\"\n\t}\n\ts := m.snap\n\tvar lines []string\n\tadd := func(l string) { l