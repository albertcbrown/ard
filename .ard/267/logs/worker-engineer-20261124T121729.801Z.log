{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FS5e6kk2Vfz3Ug9Nr7SMut","type":"tool_result","content":"config/defaults.go\n            agent: kimi\n            timeout: 30m\n          - name: license-review\n            kind: reviewer\n            dir: .ard/reviewers/license-review\n            prompt: .ard/reviewers/license-review/prompt.txt\n            agent: kimi\n            timeout: 30m\n            when:\n              paths:\n                - go.mod\n          - name: security-review\n            kind: reviewer\n            dir: .ard/reviewers/security-review\n            prompt: .ard/reviewers/security-review/prompt.txt\n            agent: kimi\n            timeout: 30m\nFAIL\nFAIL\tgithub.com/albertcbrown/ard/internal/config\t0.312s\nFAIL\n13:// Duration is a time.Duration that unmarshals from YAML strings such as\n14:// \"15m\", \"4h\", \"30d\" or \"1w\" (see ParseDuration) and marshals back to the\n16:type Duration time.Duration\n21:// ParseDuration parses time.ParseDuration syntax extended with d (24 h) and\n25:func ParseDuration(s string) (time.Duration, error) {\n33:\tvar total time.Duration\n43:\t\tvar unit time.Duration\n68:\t\ttotal += time.Duration(n * float64(unit))\n80:// String renders d in the compact unit form accepted by ParseDuration.\n81:func (d Duration) String() string {\n\t\tReviewers: Duration(5 * time.Minute),\n\t\tMerger:    Duration(5 * time.Minute),\n\t}\n\tif res.Intervals != wantIntervals {\n\t\tt.Errorf(\"Intervals = %+v, want %+v\", res.Intervals, wantIntervals)\n\t}\n\tif res.Intake != (Intake{Mode: IntakeLabel}) {\n\t\tt.Errorf(\"Intake = %+v, want label mode with no label override\", res.Intake)\n\t}\n\tif res.Stale.InactiveFor != Duration(30*24*time.Hour) || res.Stale.SuppressFor != Duration(90*24*time.Hour) {\n\t\tt.Errorf(\"Stale = %+v\", res.Stale)\n\t}\n\tif len(res.Sidecars) != 0 || len(res.ProtectedPaths) != 0 {\n\t\tt.Errorf(\"Sidecars = %v, ProtectedPaths = %v\", res.Sidecars, res.ProtectedPaths)\n\t}\n\n\t\t},\n\t\t{\n\t\t\tname: \"unknown interval key\",\n\t\t\tyaml: \"intervals: {scannerz: 4h}\\n\",\n\t\t\twant: []wantErr{{\".ard/config.yaml\", \"intervals.scannerz\", \"unknown key\"}},\n\t\t},\n\t\t{\n\t\t\tname: \"bad stale duration\",\n\t\t\tyaml: \"stale: {inactive_for: 2x}\\n\",\n\t\t\twant: []wantErr{{\".ard/config.yaml\", \"stale.inactive_for\", `invalid duration \"2x\"`}},\n\t\t},\n\t\t{\n\t\t\tname: \"unknown redact key\",\n\t\t\tyaml: \"redact: {trufflehog: {}}\\n\",\n\t\t\twant: []wantErr{{\".ard/config.yaml\", \"redact.trufflehog\", \"unknown key\"}},\n\t\t},\npackage config\n\nimport (\n\t\"bytes\"\n\t\"flag\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"testing\"\n)\n\nvar updateGolden = flag.Bool(\"update\", false, \"rewrite golden files\")\n\nfunc TestRenderGolden(t *testing.T) {\n\tfsys := withConfig(t, `\nagent: kimi\nintervals: {scanners: 6h}\nmerge: {protected_paths: [infra/]}\nsidecars:\n  vpe-specs: {repo: acme/specs, ref: v1}\noverrides:\n  scanners/cve: {every: 12h, max_open: 10, group_size: 1}\n  triage/lead: {sidecar: vpe-specs, after: [architect]}\n  workers/engineer: {reviewers: [security-review], diff_warn_lines: 800}\n  reviewers/license-review: {when: {paths: [go.mod]}}\n`)\n\tres := mustLoad(t, fsys)\n\n\tgolden := filepath.Join(\"testdata\", \"resolved.golden\")\n\tif *updateGolden {\n\t\tvar buf bytes.Buffer\n\t\tif err := res.WriteYAML(&buf); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := os.MkdirAll(filepath.Dir(golden), 0o755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := os.WriteFile(golden, buf.Bytes(), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\twant, err := os.ReadFile(golden)\n\tif err != nil {\n\t\tt.Fatalf(\"read golden (run with -update to create): %v\", err)\n\t}\n\tvar got bytes.Buffer\n\tif err := res.WriteYAML(&got); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif got.String() != string(want) {\n\t\tt.Errorf(\"rendered config differs from golden %s:\\n%s\", golden, got.String())\n\t