{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NuYTmUoMrzortWPAHSeSTZ","type":"tool_result","content":"\tDryRun() bool\n}\n\n// Deps are the loop's collaborators. StatusIssue returns 0 until the status\n// issue is known. Now nil means time.Now; Log nil means slog.Default.\ntype Deps struct {\n\tGate        Capper\n\tStore       EventStore\n\tEffects     Effects\n\tStatusIssue func() int\n\tLog         *slog.Logger\n\tNow         func() time.Time\n}\n\n// Loop posts one status-issue comment per reached cap and UTC day. A\n// budget_capped event written after the comment is the record for #58 and the\n// marker that keeps a restart from posting the notice again.\ntype Loop struct {\n\td  Deps\n\tmu sync.Mutex\n}\n\n// NewLoop builds the notice loop.\nfunc NewLoop(d Deps) *Loop {\n\tif d.Now == nil {\n\t\td.Now = time.Now\n\t}\n\tif d.Log == nil {\n\t\td.Log = slog.Default()\n\t}\n\treturn &Loop{d: d}\n}\n\n// Name implements controller.Loop.\nfunc (*Loop) Name() string { return Name }\n\n// Interval implements controller.Loop.\nfunc (*Loop) Interval(*config.Resolved) time.Duration { return time.Minute }\n\n// Claims is false: the notice is bookkeeping about work already done.\nfunc (*Loop) Claims() bool { return false }\n\nvar _ controller.Loop = (*Loop)(nil)\n\ntype noticeKey struct{ scope, stage, role, day string }\n\n// Tick posts the notices that are due.\nfunc (l *Loop) Tick(ctx context.Context, _ controller.Env) error {\n\tl.mu.Lock()\n\tdefer l.mu.Unlock()\n\tissue := l.d.StatusIssue()\n\tif issue == 0 {\n\t\treturn nil\n\t}\n\tcaps, dayStart, err := l.d.Gate.Capped(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"budget: read spend: %w\", err)\n\t}\n\tif len(caps) == 0 {\n\t\treturn nil\n\t}\n\tday := dayStart.Format(\"2006-01-02\")\n\tevs, err := l.d.Store.Events(ctx, state.EventFilter{Kind: state.EventBudgetCapped, Since: dayStart})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"budget: read events: %w\", err)\n\t}\n\tdone := map[noticeKey]bool{}\n\tfor _, e := range evs {\n\t\tvar d struct {\n\t\t\tScope string `json:\"scope\"`\n\t\t\tDay   string `json:\"day\"`\n\t\t}\n\t\tif json.Unmarshal(e.Data, &d) == nil {\n\t\t\tdone[noticeKey{d.Scope, e.Stage, e.Role, d.Day}] = true\n\t\t}\n\t}\n\tfor _, c := range caps {\n\t\tif done[noticeKey{c.Scope, c.Stage, c.Role, day}] {\n\t\t\tcontinue\n\t\t}\n\t\tif _, err := l.d.Effects.CreateComment(ctx, issue, Render(c, day)); err != nil {\n\t\t\tl.d.Log.Error(\"budget.notice_failed\", \"scope\", c.Scope, \"stage\", c.Stage, \"role\", c.Role, \"error\", err)\n\t\t\tcontinue\n\t\t}\n\t\tdata, _ := json.Marshal(map[string]any{\n\t\t\t\"scope\": c.Scope, \"stage\": c.Stage, \"role\": c.Role, \"day\": day,\n\t\t\t\"spent_usd\": c.Spent.USD, \"cap_usd\": c.Limit, \"unpriced\": c.Spent.Unpriced,\n\t\t})\n\t\tev := state.Event{At: l.d.Now(), Kind: state.EventBudgetCapped, Stage: c.Stage, Role: c.Role, Data: data}\n\t\tif err := l.d.Store.AppendEvent(ctx, ev); err != nil {\n\t\t\tl.d.Log.Error(\"budget.notice_unrecorded\", \"scope\", c.Scope, \"stage\", c.Stage, \"role\", c.Role, \"error\", err)\n\t\t}\n\t}\n\treturn nil\n}\nservecmd/budget.go:31:\t\tStatusIssue: func() int { return int(w.statusIssue.Load()) },\nservecmd/scanners.go:37:\t\tStatusIssue: func() int { return int(w.statusIssue.Load()) },\nservecmd/serve.go:286:\t\t\t\tn, err := controller.EnsureStatusIssue(ctx, d.Reader, d.Effects, store, id.Login, log)\nservecmd/serve.go:290:\t\t\t\tgate.SetStatusIssue(n)\nvar registerLoops = func(w *wiring) []controller.Loop {\n\tvar loops []controller.Loop\n\tif l := scannerLoop(w); l != nil {\n\t\tloops = append(loops, l)\n\t}\n\tloops = append(loops, stale.New(w.Reader, w.Effects, nil))\n\tif l := triageLoop(w); l != nil {\n\t\tloops = append(loops, l)\n\t}\n\tif l := workerLoop(w); l != nil {\n\t\tloops = append(loops, l)\n\t}\n\tif l := reviewerLoop(w); l != nil {\n\t\tloops = append(loops, l)\n\t}\n\tloops = append(loops, reviewfixLoop(w), mergerLoop(w), janitorLoop(w))\n\tif l := reaperLoop(w); l != nil {\n\t\tloops = append(loops, l)\n\t}\n\tloops = append(loops, costs.New(costs.Deps{Store: w.Store, Reader: w.Reader, Effects: w.Effects,\n\t\tRepo: w.Repo, Locks: &w.bodyLocks, Log: w.Log}))\n\tloops = append(loops, budgetLoop(w))\n\treturn loops\n}\n\n// resolveRepo parses --repo, or falls back to the origin remote of root.\n// Errors never include the remote URL, which may embed a token.\nfunc resolveRepo(ctx context.Context, flag, root string) (github.Repo, error) {\n\tif flag != \"\" {\n\t\tr, err := github.ParseRepo(flag)\n\t\tif err != nil {\n\t\t\treturn github.Repo{}, fmt.Errorf(\"ard serve: %w\", err)\n\t\t}\n\t\treturn r, nil\n\t}\n\turl, err := gitx.New(\"\").RemoteURL(ctx, root, \"origin\")\n\terr := serveLoops(context.Background(), &cli.Env{}, nil, []string{\"nope\"})\n\tvar ee *cli.ExitError\n\tif !errors.As(err, &ee) || ee.Code != 2 || built {\n\t\tt.Fatalf(\"err = %v, built = %v; want ExitError 2 before building\", err, built)\n\t}\n}\n\n// The loop names registerLoops' constructors report are the known names.\nfunc TestKnownLoopsMatchLoopNames(t *testing.T) {\n\twant := []string{\"scanners\", \"stale\", \"triage\", \"workers\", \"reviewers\", \"reviewfix\", \"merger\", \"janitor\", \"reaper\", \"budget\"}\n\tif !reflect.DeepEqual(knownLoops, want) {\n\t\tt.Errorf(\"knownLoops = %v, want %v\", knownLoops, want)\n\t}\n}\n\thome, _ := os.UserHomeDir()\n\tw := &wiring{\n\t\tLog: slog.New(slog.NewTextHandler(io.Discard, nil)), Repo: github.Repo{Owner: \"o\", Name: \"r\"},\n\t\tRoot: t.TempDir(), Home: home, Scanners: scannerdb.NewRegistry(t.TempDir(), scannerdb.Options{}),\n\t}\n\tdefer w.Scanners.Close()\n\tloops := registerLoops(w)\n\tif len(loops) != 11 || loops[0].Name() != \"scanners\" || loops[1].Name() != \"stale\" || loops[2].Name() != \"triage\" || loops[3].Name() != \"workers\" || loops[4].Name() != \"reviewers\" || loops[5].Name() != \"reviewfix\" || loops[6].Name() != \"merger\" || loops[7].Name()