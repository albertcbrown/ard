{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013ucNsSRT13VzjhtocaEdAo","type":"tool_result","content":"package controller\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// Status issue identity. The marker, not the title, is what makes an issue\n// ours; the author check stops a stranger's look-alike being adopted.\nconst (\n\tStatusTitle  = \"ard status\"\n\tStatusMarker = \"<!-- ard:status -->\"\n)\n\n// StatusIssueKey is the meta key that remembers the status issue number.\nconst StatusIssueKey = \"status_issue\"\n\n// StatusReader is what the lookup reads: the cached issue directly, else search.\ntype StatusReader interface {\n\tGetIssue(ctx context.Context, n int) (github.Issue, error)\n\tSearchIssues(ctx context.Context, q string, o github.SearchOpts) ([]github.Issue, error)\n}\n\n// StatusCache remembers the status issue number across restarts. *state.Store\n// satisfies it. Meta returns an error wrapping state.ErrNotFound when unset.\ntype StatusCache interface {\n\tMeta(ctx context.Context, key string) (string, error)\n\tSetMeta(ctx context.Context, key, value string) error\n}\n\nvar _ StatusCache = (*state.Store)(nil)\n\n// StatusEffects is the write side, satisfied by effects.Effects.\ntype StatusEffects interface {\n\tCreateIssue(ctx context.Context, in github.NewIssue) (github.Issue, error)\n\tPinIssue(ctx context.Context, n int) error\n}\n\nconst statusBody = StatusMarker + \"\\n\\nManaged by ard. Add the `\" + labels.Pause +\n\t\"` label to stop new claims; remove it to resume.\\n\"\n\n// ownStatusIssue reports whether is is an open status issue ard created.\nfunc ownStatusIssue(is github.Issue, author string) bool {\n\treturn !is.IsPR && is.State == github.StateOpen && is.Title == StatusTitle &&\n\t\tstrings.EqualFold(is.Author, author) && strings.Contains(is.Body, StatusMarker)\n}\n\n// EnsureStatusIssue returns the number of the pinned status issue, creating\n// and pinning it when none exists. author is the login ard acts as. The number\n// cached under StatusIssueKey is tried first and adopted if that issue is\n// still our open status issue; otherwise (or when it cannot be read) search is\nmerger/harness_test.go\npackage merger\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"log/slog\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/closeout\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n\t\"github.com/albertcbrown/ard/internal/effects\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/github/fake\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n\t\"github.com/albertcbrown/ard/internal/gitx/gittest\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\nconst (\n\tself     = \"ard[bot]\"\n\treviewer = \"eng-review\"\n)\n\nvar quiet = slog.New(slog.NewTextHandler(io.Discard, nil))\n\ntype syncBuf struct {\n\tmu sync.Mutex\n\tb  bytes.Buffer\n}\n\nfunc (s *syncBuf) Write(p []byte) (int, error) {\n\ts.mu.Lock()\n\tdefer s.mu.Unlock()\n\treturn s.b.Write(p)\n}\n\nfunc (s *syncBuf) String() string {\n\ts.mu.Lock()\n\tdefer s.mu.Unlock()\n\treturn s.b.String()\n}\n\n// harness wires the loop to the GitHub fake, a real bare remote with a clone\n// as the controller's repository, and an in-memory-ish state store.\ntype harness struct {\n\tt      *testing.T\n\tgh     *fake.Fake\n\tfx     effects.Effects\n\tstore  *state.Store\n\tloop   *Loop\n\tcfg    *config.Resolved\n\tbare   string\n\tclone  string\n\tnow    time.Time\n\tstop   chan struct{}\n\tledger string\n\tlogs   *syncBuf\n}\n\ntype option func(*harness)\n\nfunc dryRun(h *harness) { h.ledger = filepath.Join(h.t.TempDir(), \"effects.jsonl\") }\n\nfunc newHarness(t *testing.T, opts ...option) *harness {\n\tt.Helper()\n\th := &harness{t: t, stop: make(chan struct{}), now: t0, logs: &syncBuf{},\n\t\tgh: fake.New(fake.WithIdentity(github.Identity{Login: self, ID: 7, Kind: github.AuthApp}))}\n\th.bare, h.clone = gittest.NewRemote(t)\n\th.cfg = &config.Resolved{Repo: t.TempDir(), SHA: \"abc123\",\n\t\tProtectedPaths: []string{\".github/\", \".claude/\", \".ard/config.yaml\"},\n\t\tRoles:          []config.Role{{Kind: config.KindReviewer, Name: reviewer}}}\n\tfor _, o := range opts {\n\t\to(h)\n\t}\n\tst, err := state.Open(context.Background(), t.TempDir(), state.Options{})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Cleanup(func() { st.Close() })\n\th.store = st\n\tif h.ledger != \"\" {\n\t\td, err := effects.NewDryRun(effects.DryRunOptions{Log: quiet, LedgerPath: h.ledger})\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tt.Cleanup(func() { d.Close() })\n\t\th.fx = d\n\t} else {\n\t\th.fx = effects.NewLive(h.gh, gitx.New(\"\"), quiet)\n\t}\n\th.loop = New(Deps{Reader: h.gh, Effects: h.fx, Store: st, Git: gitx.New(\"\"), RepoDir: h.clone, RemoteURL: h.bare,\n\t\tNow: func() time.Time { return h.now }, Log: quiet})\n\treturn h\n}\n\n// git runs git in the clone.\nfunc (h *harness) git(args ...string) string {\n\th.t.Helper()\n\treturn strings.TrimSpace(gittest.Run(h.t, h.clone, args...))\n}\n\n// commit writes path on branch (created from main when it does not exist),\n// commits and pushes it, and returns the new tip.\nfunc (h *harness) commit(branch, path, body string) string {\n\th.t.Helper()\n\tif strings.TrimSpace(gittest.Run(h.t, h.clone, \"branch\", \"--list\", branch)) == \"\" {\n\t\th.git(\"checkout\", \"-q\", \"-b\", branch, \"origin/main\")\n\t} else {\n\t\th.git(\"checkout\", \"-q\", branch)\n\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"38b45f0e-1977-46fe-92b9-