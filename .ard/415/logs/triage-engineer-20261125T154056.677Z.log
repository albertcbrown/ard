e.go:31:\tReasonPauseFile Reason = \"pause-file\"\ninternal/controller/pause.go:32:\t// ReasonPauseFileUnreadable: the pause file path cannot be examined.\ninternal/controller/pause.go:33:\tReasonPauseFileUnreadable Reason = \"pause-file-unreadable\"\ninternal/controller/pause.go:38:// PauseState is the result of a kill-switch check.\ninternal/controller/pause.go:39:type PauseState struct {\ninternal/controller/pause.go:40:\tPaused bool\ninternal/controller/pause.go:42:\tErr    error // set for ReasonUnreadable and ReasonPauseFileUnreadable\ninternal/controller/pause.go:45:// Pauser decides whether claiming loops may tick.\ninternal/controller/pause.go:46:type Pauser interface {\ninternal/controller/pause.go:47:\tCheck(ctx context.Context, cfg *config.Resolved) PauseState\ninternal/controller/pause.go:55:// PauseGate checks the four kill-switch sources, cheapest first: the local\ninternal/controller/pause.go:60:type PauseGate struct {\ninternal/controller/pause.go:74:// PauseFilePath returns <home>/.ard/pause/<owner>/<repo>, lowercased (see\ninternal/controller/pause.go:76:func PauseFilePath(home, owner, repo string) (string, error) {\ninternal/controller/pause.go:84:// SetPauseFile sets the local pause file; \"\" disables the check.\ninternal/controller/pause.go:85:func (g *PauseGate) SetPauseFile(path string) {\ninternal/controller/pause.go:95:func (g *PauseGate) SetLocalConfig(root string) {\ninternal/controller/pause.go:102:// NewPauseGate builds a gate with no status issue; until SetStatusIssue is\ninternal/controller/pause.go:104:func NewPauseGate(gh IssueGetter, log *slog.Logger) *PauseGate {\ninternal/controller/pause.go:108:\treturn &PauseGate{gh: gh, log: log}\ninternal/controller/pause.go:113:func (g *PauseGate) SetStatusIssue(n int) {\ninternal/controller/pause.go:120:// Check implements Pauser. It makes no cache: one GetIssue per call.\ninternal/controller/pause.go:121:func (g *PauseGate) Check(ctx context.Context, cfg *config.Resolved) PauseState {\nin