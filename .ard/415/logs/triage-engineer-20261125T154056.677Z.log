ilization float64 // normalised to 0..1\n\tStatus      string\n\tResetsAt    time.Time\n\tAge         time.Duration // now minus when it was observed\n}\n\n// BlockView is an active exhaustion block for a model family (\"\" = unknown).\ntype BlockView struct {\n\tFamily string\n\tUntil  time.Time\n}\n\n// IssueView is an issue with ard activity today.\ntype IssueView struct {\n\tIssue   int\n\tState   string // \"<stage>:<role> running\" or \"<stage>:<role> done|failed\" of the latest job\n\tJobs    int\n\tCostUSD *float64 // total of all recorded steps; nil when none priced\n}\n\n// SpendView is today's spend against the daily caps.\ntype SpendView struct {\n\tRepoUSD   float64\n\tRepoCap   float64 // 0 when no config\n\tUnpriced  int\n\tRoles     []RoleSpend\n\tCappedNow []budget.Cap\n}\n\n// RoleSpend is one role's spend today.\ntype RoleSpend struct {\n\tStage, Role string\n\tUSD         float64\n}\n\n// PoolSource is the slot pool; *pool.Pool satisfies it.\ntype PoolSource interface {\n\tStats() pool.Stats\n\tHeldSlots() []pool.HeldInfo\n}\n\n// LimitSource is the limits book; *limits.Book satisfies it.\ntype LimitSource interface {\n\tReadings() []limits.Reading\n\tUntil(family string) time.Time\n}\n\n// StateSource is the state store; *state.Store satisfies it.\ninternal/controller/approvals.go:18:// Wake reasons logged as controller.wake reason=....\ninternal/controller/approvals.go:20:\tWakeCloseout  = \"closeout\"\ninternal/controller/approvals.go:21:\tWakeApproval  = \"approval\"\ninternal/controller/approvals.go:22:\tWakeUnblocked = \"unblocked\"\ninternal/controller/approvals.go:33:\t// Wake is Controller.WakeLoops. A nil Wake makes the watch do nothing.\ninternal/controller/approvals.go:34:\tWake func(reason string, names ...string)\ninternal/controller/approvals.go:57:\tif w.Search == nil || w.Wake == nil {\ninternal/controller/approvals.go:93:\t\tw.Wake(WakeApproval, \"triage\")\ninternal/controller/approvals.go:120:\t\tw.Wake(WakeUnblocked, wake...)