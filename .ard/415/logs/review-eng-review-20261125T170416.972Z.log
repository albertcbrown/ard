use=%d confirm=%v\", f.pause, m.confirmUnpause)\n594\t+\t}\n595\t+\tf.err = errors.New(\"disk full\")\n596\t+\tm = press(m, \"p\")\n597\t+\tif !strings.Contains(m.toast, \"pause failed\") {\n598\t+\t\tt.Errorf(\"toast %q\", m.toast)\n599\t+\t}\n600\t+}\n601\t+\n602\t+func TestUnpauseAsksToConfirm(t *testing.T) {\n603\t+\tf := &fakeCtl{}\n604\t+\tfile := snapshot.PauseView{Loop: \"w\", Reason: controller.ReasonPauseFile}\n605\t+\tm, _ := ctlModel(f, file)\n606\t+\tm = press(m, \"p\")\n607\t+\tif !m.confirmUnpause || f.pause != 0 || !strings.Contains(Render(m), \"unpause?\") || !strings.Contains(Render(m), \"PAUSED (file)\") {\n608\t+\t\tt.Fatalf(\"confirm=%v pause=%d\", m.confirmUnpause, f.pause)\n609\t+\t}\n610\t+\tm = press(m, \"n\")\n611\t+\tif f.unpause != 0 || m.confirmUnpause {\n612\t+\t\tt.Fatal(\"n must cancel\")\n613\t+\t}\n614\t+\tm = press(press(m, \"p\"), \"y\")\n615\t+\tif f.unpause != 1 {\n616\t+\t\tt.Fatalf(\"unpause=%d\", f.unpause)\n617\t+\t}\n618\t+}\n619\t+\n620\t+func TestPauseKeyLeavesOtherSources(t *testing.T) {\n621\t+\tfor r, want := range map[controller.Reason]string{controller.ReasonLabel: \"label\", controller.ReasonConfig: \"paused: false on main\"} {\n622\t+\t\tf := &fakeCtl{}\n623\t+\t\tm, _ := ctlModel(f, snapshot.PauseView{Loop: \"w\", Reason: r})\n624\t+\t\tm = press(m, \"p\")\n625\t+\t\tif f.pause+f.unpause != 0 || m.confirmUnpause || !strings.Contains(m.toast, want) {\n626\t+\t\t\tt.Errorf(\"%s: pause=%d unpause=%d toast=%q\", r, f.pause, f.unpause, m.toast)\n627\t+\t\t}\n628\t+\t}\n629\t+}\n630\t+\n631\t+func TestSlotKeysToastAndExpiry(t *testing.T) {\n632\t+\tf := &fakeCtl{}\n633\t+\tm, now := ctlModel(f)\n634\t+\tm = press(m, \"+\")\n635\t+\tif f.up != 1 || !strings.Contains(Render(m), \"max_pods 4 (config 3)\") {\n636\t+\t\tt.Fatalf(\"up=%d\", f.up)\n637\t+\t}\n638\t+\tm = press(m, \"-\")\n639\t+\tif f.down != 1 || m.toast != \"max_pods 2\" {\n640\t+\t\tt.Fatalf(\"down=%d toast=%q\", f.down, m.toast)\n641\t+\t}\n642\t+\t*now = now.Add(ToastFor)\n643\t+\tnm, _ := m.Update(tickMsg{})\n644\t+\tif nm.(Model).toast != \"\" {\n645\t+\t\tt.Error(\"toast should expire\")\n646\t+\t}\n647\t+}\n648\t+\n649\t+func TestNilControlsInert(t *testing.T) {\n650\t+\tm := model(100, 30, snapshot.Snapshot{})\n651\t+\tfor _, k := range []string{\"p\", \"+\", \"-\"} {\n652\t+\t\tm = press(m, k)\n653\t+\t}\n654\t+\tif m.toast != \"\" || m.confirmUnpause {\n655\t+\t\tt.Error(\"keys must be inert without controls\")\n656\t+\t}\n657\t+}\n658\t+\n659\t+func TestHeaderOverrideDrainingAndHelp(t *testing.T) {\n660\t+\ts := snapshot.Snapshot{Pool: snapshot.PoolView{Used: 3, Max: 2, ConfigMax: 3, Override: true}}\n661\t+\tm := model(120, 40, s)\n662\t+\tm.help = true\n663\t+\tout := Render(m)\n664\t+\tfor _, want := range []string{\"max_pods 2 (config 3)\", \"draining\", \"dry-run: the pause file and slot override still apply locally\"} {\n665\t+\t\tif !strings.Contains(out, want) {\n666\t+\t\t\tt.Errorf(\"missing %q\", want)\n667\t+\t\t}\n668\t+\t}\n669\t+}\n670\tdiff --git a/internal/ui/keys.go b/internal/ui/keys.go\n671\tindex 04fa87f..a8076d9 100644\n672\t--- a/internal/ui/keys.go\n673\t+++ b/internal/ui/keys.go\n674\t@@ -6,6 +6,8 @@ import (\n675\t \t\"runtime\"\n676\t \n677\t \ttea \"charm.land/bubbletea/v2\"\n678\t+\n679\t+\t\"github.com/albertcbrown/ard/internal/controller\"\n680\t )\n681\t \n682\t // IssueURL is the browser URL of issue n; it is built from the integer only.\n683\t@@ -39,7 +41,24 @@ func (m Model) handleKey(k tea.KeyPressMsg) (Model, tea.Cmd) {\n684\t \t\tm.confirmQuit = false\n685\t \t\treturn m, nil\n686\t \t}\n687\t+\tif m.confirmUnpause {\n688\t+\t\tm.confirmUnpause = false\n689\t+\t\tif key == \"y\" || key == \"enter\" {\n690\t+\t\t\tif err := m.ctl.Unpause(); err != nil {\n691\t+\t\t\t\tm.setToast(\"unpause failed: \" + err.Error())\n692\t+\t\t\t} else {\n693\t+\t\t\t\tm.setToast(\"unpaused\")\n694\t+\t\t\t}\n695\t+\t\t}\n696\t+\t\treturn m, nil\n697\t+\t}\n698\t \tswitch key {\n699\t+\tcase