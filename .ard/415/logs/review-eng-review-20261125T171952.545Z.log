x_pods 2\", f.err }\n583\t+\n584\t+func pressKey(m Model, s string) Model {\n585\t+\tr := []rune(s)\n586\t+\tvar k tea.KeyPressMsg\n587\t+\tif s == \"enter\" {\n588\t+\t\tk = tea.KeyPressMsg{Code: tea.KeyEnter}\n589\t+\t} else {\n590\t+\t\tk = tea.KeyPressMsg{Code: r[0], Text: s}\n591\t+\t}\n592\t+\tnm, _ := m.handleKey(k)\n593\t+\treturn nm\n594\t+}\n595\t+\n596\t+func ctlModel(f *fakeCtl, pause ...snapshot.PauseView) (Model, *time.Time) {\n597\t+\tnow := time.Date(2026, 11, 25, 12, 0, 0, 0, time.UTC)\n598\t+\tm := model(100, 30, snapshot.Snapshot{TakenAt: now, Pause: pause}).WithControls(f)\n599\t+\tm.now = func() time.Time { return now }\n600\t+\treturn m, &now\n601\t+}\n602\t+\n603\t+func TestPauseKeyWritesAtOnce(t *testing.T) {\n604\t+\tf := &fakeCtl{}\n605\t+\tm, _ := ctlModel(f)\n606\t+\tm = pressKey(m, \"p\")\n607\t+\tif f.pause != 1 || m.confirmUnpause {\n608\t+\t\tt.Fatalf(\"pause=%d confirm=%v\", f.pause, m.confirmUnpause)\n609\t+\t}\n610\t+\tf.err = errors.New(\"disk full\")\n611\t+\tm = pressKey(m, \"p\")\n612\t+\tif !strings.Contains(m.toast, \"pause failed\") {\n613\t+\t\tt.Errorf(\"toast %q\", m.toast)\n614\t+\t}\n615\t+}\n616\t+\n617\t+func TestUnpauseAsksToConfirm(t *testing.T) {\n618\t+\tf := &fakeCtl{}\n619\t+\tfile := snapshot.PauseView{Loop: \"w\", Reason: controller.ReasonPauseFile}\n620\t+\tm, _ := ctlModel(f, file)\n621\t+\tm = pressKey(m, \"p\")\n622\t+\tif !m.confirmUnpause || f.pause != 0 || !strings.Contains(Render(m), \"unpause?\") || !strings.Contains(Render(m), \"PAUSED (file)\") {\n623\t+\t\tt.Fatalf(\"confirm=%v pause=%d\", m.confirmUnpause, f.pause)\n624\t+\t}\n625\t+\tm = pressKey(m, \"n\")\n626\t+\tif f.unpause != 0 || m.confirmUnpause {\n627\t+\t\tt.Fatal(\"n must cancel\")\n628\t+\t}\n629\t+\tm = pressKey(pressKey(m, \"p\"), \"y\")\n630\t+\tif f.unpause != 1 {\n631\t+\t\tt.Fatalf(\"unpause=%d\", f.unpause)\n632\t+\t}\n633\t+}\n634\t+\n635\t+func TestPauseKeyLeavesOtherSources(t *testing.T) {\n636\t+\tfor r, want := range map[controller.Reason]string{controller.ReasonLabel: \"label\", controller.ReasonConfig: \"paused: false on main\"} {\n637\t+\t\tf := &fakeCtl{}\n638\t+\t\tm, _ := ctlModel(f, snapshot.PauseView{Loop: \"w\", Reason: r})\n639\t+\t\tm = pressKey(m, \"p\")\n640\t+\t\tif f.pause+f.unpause != 0 || m.confirmUnpause || !strings.Contains(m.toast, want) {\n641\t+\t\t\tt.Errorf(\"%s: pause=%d unpause=%d toast=%q\", r, f.pause, f.unpause, m.toast)\n642\t+\t\t}\n643\t+\t}\n644\t+}\n645\t+\n646\t+func TestSlotKeysToastAndExpiry(t *testing.T) {\n647\t+\tf := &fakeCtl{}\n648\t+\tm, now := ctlModel(f)\n649\t+\tm = pressKey(m, \"+\")\n650\t+\tif f.up != 1 || !strings.Contains(Render(m), \"max_pods 4 (config 3)\") {\n651\t+\t\tt.Fatalf(\"up=%d\", f.up)\n652\t+\t}\n653\t+\tm = pressKey(m, \"-\")\n654\t+\tif f.down != 1 || m.toast != \"max_pods 2\" {\n655\t+\t\tt.Fatalf(\"down=%d toast=%q\", f.down, m.toast)\n656\t+\t}\n657\t+\t*now = now.Add(ToastFor)\n658\t+\tnm, _ := m.Update(tickMsg{})\n659\t+\tif nm.(Model).toast != \"\" {\n660\t+\t\tt.Error(\"toast should expire\")\n661\t+\t}\n662\t+}\n663\t+\n664\t+func TestNilControlsInert(t *testing.T) {\n665\t+\tm := model(100, 30, snapshot.Snapshot{})\n666\t+\tfor _, k := range []string{\"p\", \"+\", \"-\"} {\n667\t+\t\tm = pressKey(m, k)\n668\t+\t}\n669\t+\tif m.toast != \"\" || m.confirmUnpause {\n670\t+\t\tt.Error(\"keys must be inert without controls\")\n671\t+\t}\n672\t+}\n673\t+\n674\t+func TestHeaderOverrideDrainingAndHelp(t *testing.T) {\n675\t+\ts := snapshot.Snapshot{Pool: snapshot.PoolView{Used: 3, Max: 2, ConfigMax: 3, Override: true}}\n676\t+\tm := model(120, 40, s)\n677\t+\tm.help = true\n678\t+\tout := Render(m)\n679\t+\tfor _, want := range []string{\"max_pods 2 (config 3)\", \"draining\", \"dry-run: the pause file and slot override still apply locally\"} {\n680\t+\t\tif !strings.Contains(out, want) {\n681\t+\t\t\tt.Errorf(\"missing %q\", want)\n682\t+\t\t}\n683\t+\t}\n684\t+}\n685\tdiff --git a/internal/ui/keys.go b/internal/ui/keys.go\n686\tindex 0eca0fe..2382f3c 100644\n687\t--- a/internal/ui/keys.go\n688\t+++ b/internal/ui/keys.go\n689\t@@ -6,6 +6,8 @@ import (\n690\t \t\"runtime\"\n691\t \n692\t \ttea \"charm.land/bubbletea/v2\"\n693\t+\n694\t+\t\"github.com/albertcbrown/ard/internal/controller\"\n695\t )\n696\t \n697\t // IssueURL is the browser URL of issue n; it is built from the integer only.\n698\t@@ -39,6 +41,17 @@ func (m Model) handleKey(k tea.KeyPressMsg) (Model, tea.Cmd) {\n699\t \t\tm.confirmQuit = false\n700\t \t\treturn m, nil\n701\t \t}\n702\t+\tif m.confirmUnpause {\n703\t+\t\tm.confirmUnpause = false\n704\t+\t\tif key == \"y\" || key == \"enter\" {\n705\t+\t\t\tif err := m.ctl.Unpause(); err != nil {\n706\t+\t\t\t\tm.setToast(\"unpause failed: \" + err.Error())\n707\t+\t\t\t} else {\n708\t+\t\t\t\tm.setToast(\"unpaused\")\n709\t+\t\t\t}\n710\t+\t\t}\n711\t+\t\treturn m, nil\n712\t+\t}\n713\t \tif it := m.confirmApprove; it != nil {\n714\t \t\tm.confirmApprove = nil\n715\t \t\tif key != \"y\" || m.approve == nil {\n716\t@@ -52,6 +65,12 @@ func (m Model) handleKey(k tea.KeyPressMsg) (Model, tea.Cmd) {\n717\t \t\t}\n718\t \t}\n719\t \tswitch key {\n720\t+\tcase \"p\":\n721\t+\t\tm.pauseKey()\n722\t+\tcase \"+\", \"=\":\n723\t+\t\tm.slotKey(func() (string, error) { return m.ctl.SlotUp() })\n724\t+\tcase \"-\", \"_\":\n725\t+\t\tm.slotKey(func() (string, error) { return m.ctl.SlotDown() })\n726\t \tcase \"a\":\n727\t \t\tif m.approve != nil && m.selected >= 0 && m.selected < len(m.snap.Issues) {\n728\t \t\t\tn := m.snap.Issues[m.selected].Issue\n729\t@@ -96,3 +115,56 @@ func (m *Model) move(d int) {\n730\t \t\tm.selected = n - 1\n731\t \t}\n732\t }\n733\t+\n734\t+// liftHint says how to lift a pause the UI does not own.\n735\t+func liftHint(r controller.Reason) string {\n736\t+\tswitch r {\n737\t+\tcase controller.ReasonLabel:\n738\t+\t\treturn \"paused by the ard:pause label: remove it from the status issue\"\n739\t+\tcase controller.ReasonConfig:\n740\t+\t\treturn \"paused b