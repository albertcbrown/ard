ion(\"Waiting\")\n\tif len(s.Pool.Waiting) == 0 {\n\t\tadd(dimStyle.Render(\"nothing\"))\n\t}\n\tfor _, x := range s.Pool.Waiting {\n\t\tl := fmt.Sprintf(\"%s:%s %d %s\", Clean(x.Class), Clean(x.Role), x.Count, Clean(x.Reason))\n\t\tif x.Oldest > 0 {\n\t\t\tl += \" oldest \" + dur(x.Oldest)\n\t\t}\n\t\tadd(l)\n\t}\n\n\tsection(\"Limits\")\n\tif len(s.Limits.Windows) == 0 {\n\t\tadd(dimStyle.Render(\"no readings\"))\n\t}\n\tfor _, x := range s.Limits.Windows {\n\t\tadd(fmt.Sprintf(\"%s %3.0f%% %s resets %s\", Clean(x.Window), x.Utilization*100, Clean(x.Status), x.ResetsAt.UTC().Format(\"15:04Z\")))\n\t}\n\n\tvar tail []string\n\tif w >= largeWidth && h >= largeHeight {\n\t\ttail = append(tail, headStyle.Render(\"Next tick\"))\n\t\tfor _, t := range s.Ticks {\n\t\t\tl := fmt.Sprintf(\"%-10s ticks %d last %s\", Clean(t.Loop), t.Count, t.End.UTC().Format(\"15:04:05Z\"))\n\t\t\tif t.Err != \"\" {\n\t\t\t\tl += \" err: \" + Clean(t.Err)\n\t\t\t}\n\t\t\ttail = append(tail, Trunc(l, w))\n\t\t}\n\t\ttail = append(tail, headStyle.Render(\"Recent events\"))\n\t\tev := s.Events\n\t\tif len(ev) > 8 {\n\t\t\tev = ev[len(ev)-8:]\n\t\t}\n\t\tfor _, e := range ev {\n\t\t\ttail = append(tail, Trunc(fmt.Sprintf(\"%s %s %s %s\", e.Time.UTC().Format(\"15:04:05\"), e.Level, Clean(e.Msg), Clean(e.Attrs)), w))\n\t\t}\n\t}\n\n\tif m.help {\n\t\tlines = append(lines, headStyle.Render(\"Help\"),\n\t\t\t\"?  toggle help\", \"j/k, arrows  select issue\", \"o  open selected issue in the browser\", \"q  quit (asks first)\", \"ctrl+c  stop now\")\n\t}\n\n\troom := h - len(lines) - len(tail) - 2 // issues heading and footer\n\tif room < 1 {\n\t\troom = 1\n\t}\n\tpages := (len(s.Issues) + room - 1) / room\n\tif pages < 1 {\n\t\tpages = 1\n\t}\n\tpage := m.selected / room\n\ttitle := \"Issues\"\n\tif pages > 1 {\n\t\ttitle = fmt.Sprintf(\"Issues (page %d/%d)\", page+1, pages)\n\t}\n\tsection(title)\n\tif len(s.Issues) == 0 {\n\t\tlines = append(lines, dimStyle.Render(\"none today\"))\n\t}\n\tfor i := page * room; i < len(s.Issues) && i < (page+1)*room; i++ {\n\t\tx := s.Issues[i]\n\t\tl := Trunc(fmt.Sprintf(\"#%-5d %s  jobs %d  %s\", x.Issue, Clean(x.State), x.Jobs, usd(x.CostUSD)), w)\n\t\tif i == m.selected {\n\t\t\tl = selStyle.Render(l)\n\t\t}\n\t\tlines = append(lines, l)\n\t}\n\tlines = append(lines, tail...)\n\n\tfooter := \"? help  j/k select  o open  q quit\"\n\tif m.confirmQuit {\n\t\tfooter = \"quit? y/n\"\n\t}\n\tif len(lines) > h-1 {\n\t\tlines = lines[:h-1]\n\t}\n\tfor len(lines) < h-1 {\n\t\tlines = append(lines, \"\")\n\t}\n\tlines = append(lines, dimStyle.Render(Trunc(footer, w)))\n\treturn strings.Join(lines, \"\\n\")\n}\n38:\tPool    PoolView\n39-\tRunning []RunningJob\n40-\tPause   []PauseView\n41-\tTicks   []TickView\n42-\tLimits  LimitsView\n43-\tIssues  []IssueView\n44-\tSpend   SpendView\n45-\tEvents  []Event\n46-\tErrors  []string\n47-}\n48-\n49:// PoolView is the slot pool.\n50:type PoolView struct {\n51-\tUsed, Max int\n52-\tWaiting   []Waiting\n53-}\n54-\n55-// Waiting is demand or refused candidates of one role with the reason.\n56-type Waiting struct {\n57-\tClass  string\n58-\tRole   string\n59-\tReason string // ReasonSlot, ReasonLimited or ReasonBudget\n60-\tCount  int\n61-\tOldest time.Duration // slot waits only\n62-}\n--\n276:func poolView(st pool.Stats) PoolView {\n277:\tv := PoolView{Used: st.Held, Max: st.Max}\n278-\tfor _, w := range st.WaitingRoles {\n279-\t\tv.Waiting = append(v.Waiting, Waiting{Class: w.Class.String(), Role: w.Role, Reason: ReasonSlot, Count: w.Count, Oldest: w.Oldest})\n280-\t}\n281-\tfor c, rs := range st.RefusedBy {\n282-\t\tfor _, r := range rs {\n283-\t\t\treason := ReasonLimited\n284-\t\t\tif r.Reason == pool.DeniedBudget {\n285-\t\t\t\treason = ReasonBudget\n286-\t\t\t}\n287-\t\t\tv.Waiting = append(v.Waiting, Waiting{Class: c.String(), Role: r.Role, Reason: reason, Count: r.Count})\n288-\t\t}\n289-\t}\nui/ui_test.go:69:\tm := New(\"o/r\", \"/home/u/.ard/logs/o/r/serve.log\", nil, nil)\nui/ui_te