ontroller.ReasonPauseFile}\n\tm, _ := ctlModel(f, file)\n\tm = press(m, \"p\")\n\tif !m.confirmUnpause || f.pause != 0 || !strings.Contains(Render(m), \"unpause?\") || !strings.Contains(Render(m), \"PAUSED (file)\") {\n\t\tt.Fatalf(\"confirm=%v pause=%d\", m.confirmUnpause, f.pause)\n\t}\n\tm = press(m, \"n\")\n\tif f.unpause != 0 || m.confirmUnpause {\n\t\tt.Fatal(\"n must cancel\")\n\t}\n\tm = press(press(m, \"p\"), \"y\")\n\tif f.unpause != 1 {\n\t\tt.Fatalf(\"unpause=%d\", f.unpause)\n\t}\n}\n\nfunc TestPauseKeyLeavesOtherSources(t *testing.T) {\n\tfor r, want := range map[controller.Reason]string{controller.ReasonLabel: \"label\", controller.ReasonConfig: \"paused: false on main\"} {\n\t\tf := &fakeCtl{}\n\t\tm, _ := ctlModel(f, snapshot.PauseView{Loop: \"w\", Reason: r})\n\t\tm = press(m, \"p\")\n\t\tif f.pause+f.unpause != 0 || m.confirmUnpause || !strings.Contains(m.toast, want) {\n\t\t\tt.Errorf(\"%s: pause=%d unpause=%d toast=%q\", r, f.pause, f.unpause, m.toast)\n\t\t}\n\t}\n}\n\nfunc TestSlotKeysToastAndExpiry(t *testing.T) {\n\tf := &fakeCtl{}\n\tm, now := ctlModel(f)\n\tm = press(m, \"+\")\n\tif f.up != 1 || !strings.Contains(Render(m), \"max_pods 4 (config 3)\") {\n\t\tt.Fatalf(\"up=%d\", f.up)\n\t}\n\tm = press(m, \"-\")\n\tif f.down != 1 || m.toast != \"max_pods 2\" {\n\t\tt.Fatalf(\"down=%d toast=%q\", f.down, m.toast)\n\t}\n\t*now = now.Add(ToastFor)\n\tnm, _ := m.Update(tickMsg{})\n\tif nm.(Model).toast != \"\" {\n\t\tt.Error(\"toast should expire\")\n\t}\n}\n\nfunc TestNilControlsInert(t *testing.T) {\n\tm := model(100, 30, snapshot.Snapshot{})\n\tfor _, k := range []string{\"p\", \"+\", \"-\"} {\n\t\tm = press(m, k)\n\t}\n\tif m.toast != \"\" || m.confirmUnpause {\n\t\tt.Error(\"keys must be inert without controls\")\n\t}\n}\n\nfunc TestHeaderOverrideDrainingAndHelp(t *testing.T) {\n\ts := snapshot.Snapshot{Pool: snapshot.PoolView{Used: 3, Max: 2, ConfigMax: 3, Override: true}}\n\tm := model(120, 40, s)\n\tm.help = true\n\tout := Render(m)\n\tfor _, want := range []string{\"max_pods 2 (config 3)\", \"draining\", \"dry-run: the pause file and slot override still apply locally\"} {\n\t\tif !strings.Contains(out, want) {\n\t\t\tt.Errorf(\"missing %q\", want)\n\t\t}\n\t}\n}\nEOF\ncat > servecmd/slots_test.go <<'EOF'\npackage servecmd\n\nimport (\n\t\"bytes\"\n\t\"log/slog\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\nfunc newSlots() (*slotOverride, *bytes.Buffer) {\n\tvar buf bytes.Buffer\n\treturn &slotOverride{log: slog.New(slog.NewTextHandler(&buf, nil))}, &buf\n}\n\nfunc TestOverrideClampsToBounds(t *testing.T) {\n\tfor _, c := range []struct{ cfg, want int }{{3, 6}, {10, 16}, {1, 2}} {\n\t\ts, _ := newSlots()\n\t\tif got := s.Set(100, c.cfg); got != c.want {\n\t\t\tt.Errorf(\"cfg %d: max %d, want %d\", c.cfg, got, c.want)\n\t\t}\n\t\tif _, ch := s.Step(1, c.cfg); ch {\n\t\t\tt.Errorf(\"cfg %d: step at upper bound changed\", c.cfg)\n\t\t}\n\t}\n\ts, _ := newSlots()\n\tif got := s.Set(-5, 3); got != 1 {\n\t\tt.Errorf(\"min: %d\", got)\n\t}\n\tif _, ch := s.Step(-1, 3); ch {\n\t\tt.Error(\"step at 1 changed\")\n\t}\n\tif n, ch := s.Step(1, 3); n != 2 || !ch {\n\t\tt.Errorf(\"step up: %d %v\", n, ch)\n\t}\n}\n\nfunc TestOverrideSurvivesReloadUntilConfigChanges(t *testing.T) {\n\ts, buf := newSlots()\n\ts.Set(5, 3)\n\tfor i := 0; i < 3; i++ {\n\t\tif got := s.Effective(3); got != 5 {\n\t\t\tt.Fatalf(\"reload %d: %d\", i, got)\n\t\t}\n\t}\n\tif n, on := s.Active(3); n != 5 || !on {\n\t\tt.Fatalf(\"active %d %v\", n, on)\n\t}\n\tif got := s.Effective(4); got != 4 {\n\t\tt.Fatalf(\"changed config: %d\", got)\n\t}\n\tif !strings.Contains(buf.String(), \"reason=config_changed\") || !strings.Contains(buf.String(), \"pool.max_override\") {\n\t\tt.Errorf(\"log: %s\", buf.String())\n\t}\n\tif got := s.Effective(4); got != 4 {\n\t\tt.Errorf(\"after clear: %d\", got)\n\t}\n\tif _, on := s.Active(4); on {\n\t\tt.Error(\"override still active\")\n\t}\n}\n\nfunc TestOverrideNeverTouchesConfigFile(t *testing.T) {\n\tdir := t.TempDir()\n\tp := filepath.Join(dir, \"config.yaml\")\n\tif err := os.WriteFile(p, []byte(\"max_pods: 3\\n\"), 0o600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tbefore, _ := os.Stat(p)\n\ts, _ := newSlots()\n\ts.Set(5, 3)\n\ts.Effective(3)\n\ts.Effective(4)\n\tafter, _ := os.Stat(p)\n\tb, _ := os.ReadFile(p)\n\tif string(b) != \"max_pods: 3\\n\" || !after.ModTime().Equal(before.ModTime()) {\n\t\tt.Error(\"config file changed\")\n\t}\n}\nEOF\ncat > servecmd/controls_test.go <<'EOF'\npackage servecmd\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"testing\"\n)\n\nfunc TestPauseUnpauseFile(t *testing.T) {\n\tp := filepath.Join(t.TempDir(), \"pause\", \"o\", \"r\")\n\tc := &controls{w: &wiring{}, pausePath: p}\n\tfor i := 0; i < 2; i++ { // idempotent\n\t\tif err := c.Pause(); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tif _, err := os.Lstat(p); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := c.Unpause(); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err := os.Lstat(p); !os.IsNotExist(err) {\n\t\tt.Fatalf(\"pause file remains: %v\", err)\n\t}\n\tif err := c.Unpause(); err != nil {\n\t\tt.Errorf(\"unpause without file: %v\", err)\n\t}\n}\n\nfunc TestUnpauseRefusesDirectory(t *testing.T) {\n\tp := filepath.Join(t.TempDir(), \"pause\")\n\tif err := os.MkdirAll(filepath.Join(p, \"x\"), 0o700); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tc := &controls{w: &wiring{}, pausePath: p}\n\tif err := c.Unpause(); err == nil {\n\t\tt.Fatal(\"want error\")\n\t}\n\tif _, err := os.Stat(filepath.Join(p, \"x\")); err != nil {\n\t\tt.Error(\"directory was touched\")\n\t}\n}\n\nfunc TestSlotKeyBeforePool(t *testing.T) {\n\tc := &controls{w: &wiring{}}\n\tif msg, err := c.step(1); err != nil || msg != \"pool not ready\" {\n\t\tt.Errorf(\"%q %v\", msg, err)\n\t}\n}\nEOF\ngofmt -l ui servecmd snapshot; go test ./ui -update >/dev/null; git status --short; go test -race ./ui ./servecmd ./snapshot ./pool 2>&1 | tail -20"},"caller":{"type":"direct"}}],"container":null,"stop_r