ERSION}/jq-linux-${TARGETARCH}\"; \\\n    echo \"${jq_sha}  /out/jq\" | sha256sum -c -; \\\n    curl -fsSL -o /out/tini \"https://github.com/krallin/tini/releases/download/${TINI_VERSION}/tini-static-${TARGETARCH}\"; \\\n    echo \"${tini_sha}  /out/tini\" | sha256sum -c -; \\\n    chmod 0755 /out/osv-scanner /out/jq /out/tini\n\n# The final image keeps the Go toolchain (govulncheck loads packages with it);\n# git and ca-certificates are already in the golang image.\nFROM ${GO_IMAGE}\nARG VERSION=dev\nARG REVISION=unknown\nCOPY --from=build /out/ard /usr/local/bin/ard\nCOPY --from=build /out/govulncheck /usr/local/bin/govulncheck\nCOPY --from=tools /out/osv-scanner /usr/local/bin/osv-scanner\nCOPY --from=tools /out/jq /usr/local/bin/jq\nCOPY --from=tools /out/tini /usr/local/bin/tini\n# HOME is the pod's PVC (~/.ard state, the repo clone, Go caches). TMPDIR is\n# exec-capable for the cve scan's toolchain downloads. GOTOOLCHAIN=local: the\n# scan switches toolchains itself.\nENV HOME=/home/ard \\\n14:command -v jq >/dev/null 2>&1 || { echo \"ERROR: jq is required\" >&2; exit 2; }\n42:idx=\"$work/oci/blobs/$(jq -r '.manifests[0].digest | sub(\":\"; \"/\")' \"$work/oci/index.json\")\"\n43:platforms=\"$(jq -r '[.manifests[] | select(.platform.os != \"unknown\") | .platform.os + \"/\" + .platform.architecture] | sort | join(\",\")' \"$idx\")\"\n62:  [ \"$(run --entrypoint jq \"$tag\" --version)\" = \"jq-1.8.2\" ] || { echo \"jq: $(run --entrypoint jq \"$tag\" --version)\" >&2; return 1; }\n81:  if [ ! -s \"$scan_out\" ] || jq -e -s 'all(.[]; type == \"object\" and has(\"fingerprint\"))' \"$scan_out\" >/dev/null 2>&1; then\n96:   && jq -e -s 'length >= 1 and all(.[]; type == \"object\" and (.fingerprint | startswith(\"osv:\")))\n2:osv.dev and vuln.go.dev for the cve scan), never other namespaces, private or CGNAT ranges, or link-local metadata. */ -}}\ndocs/proposal.md:221:**The cve scanner** (`scanners/cve`, a `sh` script plus one `jq` program, no build step) merges osv-scanner (all ecosystems) and govulncheck (Go reachability). Its fingerprint is `osv:<advisory>:<man\ndocs/proposal.md:431:  scanners/cve:             { every: 6h, max_open: 10, group_size: 1, autoclose: true }\ndocs/proposal.md:450:**`ard init` proposes the starter `.ard/` as a PR (decided, #27).** It builds `config.yaml` and the starter roles in memory (today `scanners/cve`, `scanners/docs`, `scanners/error-codes`, `scanners/l","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_014rUdkvSdBVH2uvbjXFi5tR","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
