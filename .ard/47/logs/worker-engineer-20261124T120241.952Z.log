2>\"$work/lts.err\"; then\n  if [ ! -s \"$lts_out\" ] || jq -e -s 'all(.[]; type == \"object\" and has(\"fingerprint\"))' \"$lts_out\" >/dev/null 2>&1; then\n    pass \"lts scan runs in the image as a host subprocess\"\n  else\n    fail \"lts scan runs in the image as a host subprocess\" \"stdout is not finding JSON lines: $(head -c 300 \"$lts_out\")\"\n  fi\nelse\n  fail \"lts scan runs in the image as a host subprocess\" \"exit $?: $(tail -5 \"$work/lts.err\")\"\nfi\n\n# The same run on a fixture with a known-vulnerable''',1)\nopen(p,'w').write(s)\np='deploy/charts/ard-serve/templates/networkpolicy.yaml'; s=open(p).read()\ns=s.replace('vuln.go.dev for the cve scan)','vuln.go.dev for the cve scan, endoflife.date for the lts scan)',1)\nopen(p,'w').write(s)\np='Makefile'; s=open(p).read()\ns=s.replace('clean cve-fixtures','clean cve-fixtures lts-fixtures',1)\ns=s.replace('# Regenerates the real lint scanner','''# Regenerates the real lts API fixtures in the pinned lts image (see\n# internal/roles/testdata/lts/regen.sh). Needs Docker and network; not part of `make test`.\nlts-fixtures:\n\tdocker build -t ard-lts-fixtures internal/roles/scanners/lts\n\tdocker run --rm --user \"$$(id -u):$$(id -g)\" -e HOME=/tmp \\\\\n\t  -v \"$$PWD/internal/roles:/roles\" -w /roles ard-lts-fixtures sh testdata/lts/regen.sh\n\n# Regenerates the real lint scanner''',1)\nopen(p,'w').write(s)\np='docs/proposal.md'; s=open(p).read()\ns=s.replace('| lts | endoflife.date + manifests: go.mod, package.json, Dockerfile `FROM`, Helm charts | 7 d | 1 per component |','| lts | endoflife.date v1 API + manifests: go.mod, package.json, Dockerfile `FROM`, Helm `values.yaml` images | 7 d | 1 per component (product and cycle) |')\ns=s.replace('  scanners/cve:             { every: 6h, max_open: 10, group_size: 1, autoclose: true }\\n','  scanners/cve:             { every: 6h, max_open: 10, group_size: 1, autoclose: true }\\n  scanners/lts:             { every: 7d, max_open: 5, group_size: 1, autoclose: true }\\n',1)\ns=s.replace('(today `scanners/cve`, `scanners/docs`','(today `scanners/cve`, `scanners/lts`, `scanners/docs`',1)\ns=s.replace('and the cve, docs, error-codes, lint, lead','and the cve, lts, docs, error-codes, lint, lead',1)\npara='''**The lts scanner** (`scanners/lts`, a `sh` script plus two `jq` programs and `yq` for Helm, no build step) flags components at or near end of life using the endoflife.date v1 API (`/api/v1/products/<slug>`, one request per referenced product). A component is a product plus a release cycle; its fingerprint is `eol:<product>:<cycle>` (for example `eol:nodejs:18`), one finding lists every referencing file, and `group` is the product. The human-owned `products.json` maps Docker image names and a few npm packages to endoflife.date slugs (the Alpine image maps to `alpine-linux`); names not in it are skipped with a stderr line. Cycles match generically: a codename's first word (`bookworm`, `jammy`), else the longest dotted prefix of the version. It reads the `toolchain` line (else the `go` directive) of `go.mod`, `engines.node` and table npm dependencies of `package.json` (lowest lower bound of the range), Dockerfile `FROM` lines (global `ARG` substitution, registry and digest stripped, `Dockerfile`, `Dockerfile.*`, `*.Dockerfile`, `Containerfile`), and `repository`/`tag` or `image: name:tag` in the `values.yaml` beside each `Chart.yaml`. Severity: `high` at or past end of life, `medium` within 90 days, `low` within 180 days, otherwise no finding. A component referenced only by floors (a `go` directive, `engines.node`, an npm range) is capped at `medium`. Titles carry the date (`Go 1.21: end of life 2024-08-13`), never \"approaching\" or \"past\", because rerate changes only severity. The scan fails closed with nothing on stdout, because an absent finding closes its issue: any API failure (including a 404 for a mapped product, which means `products.json` is stale), a non-JSON response, a `package.json` or `values.yaml` that cannot be parsed. A missing tool exits 2 (`yq` only when a `Chart.yaml` exists). Paths with a `.git`, `vendor`, `node_modules` or `testdata` segment are skipped. Manifest text reaches the issue body only as cleaned text in code spans (control characters and backticks removed, 200 characters, at most 50 references); repo text never reaches a URL.\n\n'''\ni=s.index('**The trufflehog scanner**')\ns=s[:i]+para+s[i:]\nopen(p,'w').write(s)\nEOF\ngrep -n \"scanners/cve\" CLAUDE.md | cut -c1-200; git diff --stat"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8093,"cache_read_input_tokens":76920,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8093},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"df64a9c0-ea4b-43ef-9ca6-e1675383808b","uuid":"7f49a35b-ded4-4c94-96c8-95da9ddf89d9","timestamp":"2026-11-24T12:11:20.335Z","request_id":"req_011ChMjJq8TCcuvmYzmu1sBd"}
