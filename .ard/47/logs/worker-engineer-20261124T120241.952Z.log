-e HOME=/tmp \\\n\t  -v \"$$PWD/internal/roles:/roles\" -w /roles ard-cve-fixtures sh testdata/cve/regen.sh\n\n# Regenerates the real lint scanner fixtures in the pinned image (see\n# internal/roles/testdata/lint/regen.sh). Needs Docker; not part of `make test`.\nlint-scanner-fixtures:\n\tdocker build -t ard-lint-fixtures internal/roles/scanners/lint\n\tdocker run --rm --user \"$$(id -u):$$(id -g)\" -e HOME=/tmp \\\n\t  -v \"$$PWD/internal/roles:/roles\" -w /roles ard-lint-fixtures sh testdata/lint/regen.sh\n\nclean:\n\trm -rf bin\n","structuredPatch":[{"oldStart":33,"oldLines":6,"newStart":33,"newLines":13,"lines":["   docker run --rm --user \"$$(id -u):$$(id -g)\" -e HOME=/tmp \\","     -v \"$$PWD/internal/roles:/roles\" -w /roles ard-cve-fixtures sh testdata/cve/regen.sh"," ","+# Regenerates the real lts API fixtures inside the pinned lts image (see","+# internal/roles/testdata/lts/regen.sh). Needs Docker and network; not part of `make test`.","+lts-fixtures:","+  docker build -t ard-lts-fixtures internal/roles/scanners/lts","+  docker run --rm --user \"$$(id -u):$$(id -g)\" -e HOME=/tmp \\","+    -v \"$$PWD/internal/roles:/roles\" -w /roles ard-lts-fixtures sh testdata/lts/regen.sh","+"," # Regenerates the real lint scanner fixtures in the pinned image (see"," # internal/roles/testdata/lint/regen.sh). Needs Docker; not part of `make test`."," lint-scanner-fixtures:"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_013pg55FRU5XmHnbFba73ZJi","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
