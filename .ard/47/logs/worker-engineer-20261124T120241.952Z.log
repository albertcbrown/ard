s in this image, cwd a read-only worktree, HOME writable.\n78\tscan_out=\"$work/scan.out\"\n79\tif run --tmpfs /home/ard:uid=65532,gid=65532,exec --tmpfs /var/tmp:uid=65532,gid=65532,exec \\\n80\t     -v \"$ROOT:/repo:ro\" -w /repo --entrypoint /repo/.ard/scanners/cve/scan \"$tag\" >\"$scan_out\" 2>\"$work/scan.err\"; then\n81\t  if [ ! -s \"$scan_out\" ] || jq -e -s 'all(.[]; type == \"object\" and has(\"fingerprint\"))' \"$scan_out\" >/dev/null 2>&1; then\n82\t    pass \"cve scan runs in the image as a host subprocess\"\n83\t  else\n84\t    fail \"cve scan runs in the image as a host subprocess\" \"stdout is not finding JSON lines: $(head -c 300 \"$scan_out\")\"\n85\t  fi\n86\telse\n87\t  fail \"cve scan runs in the image as a host subprocess\" \"exit $?: $(tail -5 \"$work/scan.err\")\"\n88\tfi\n89\t\n90\t# The same run on a fixture with a known-vulnerable dependency must report it: empty output cannot pass.\n91\tfixture=\"$ROOT/deploy/testdata/cve-fixture\""}]},"parent_tool_use_id":null,"session_id":"df64a9c0-ea4b-43ef-9ca6-e1675383808b","uuid":"53bc8be3-c93f-4468-8fba-dd1fb60d2b9c","timestamp":"2026-11-24T12:11:54.552Z","tool_use_result":{"type":"text","file":{"filePath":"/work/deploy/test-image.sh","content":"else fail \"ard version prints the stamped version\" \"got '$out', want 'ard $version'\"; fi\n\ntools_ok() {\n  run --entrypoint go \"$tag\" version | grep -q '^go version go1\\.27\\.4 ' || { echo \"go: $(run --entrypoint go \"$tag\" version)\" >&2; return 1; }\n  run --entrypoint govulncheck \"$tag\" -version 2>&1 | grep -q 'govulncheck@v1\\.10\\.0' || { echo \"govulncheck: $(run --entrypoint govulncheck \"$tag\" -version 2>&1 | head -3)\" >&2; return 1; }\n  run --entrypoint osv-scanner \"$tag\" --version 2>&1 | grep -q 'osv-scanner version: 2\\.7\\.1' || { echo \"osv-scanner: $(run --entrypoint osv-scanner \"$tag\" --version 2>&1 | head -2)\" >&2; return 1; }\n  [ \"$(run --entrypoint jq \"$tag\" --version)\" = \"jq-1.8.2\" ] || { echo \"jq: $(run --ent