err := os.WriteFile(filepath.Join(repo, p), []byte(c), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tscan, _ := filepath.Abs(filepath.Join(\"scanners\", \"lts\", \"scan\"))\n\tcmd := exec.Command(scan)\n\tcmd.Dir = repo\n\tvar so, se bytes.Buffer\n\tcmd.Stdout, cmd.Stderr = &so, &se\n\tif err := cmd.Run(); err != nil {\n\t\tt.Fatalf(\"%v\\n%s\", err, se.String())\n\t}\n\tgot := map[string]string{}\n\tfor _, f := range decode(t, so.Bytes()) {\n\t\tgot[f.Fingerprint] = f.Severity\n\t}\n\tif got[\"eol:go:1.20\"] != \"high\" || got[\"eol:nodejs:16\"] != \"high\" {\n\t\tt.Errorf(\"got %v\", got)\n\t}\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2212,"cache_read_input_tokens":97793,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2212},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"df64a9c0-ea4b-43ef-9ca6-e1675383808b","uuid":"da2bd9d7-7f3c-4ed8-ba08-870102850c19","timestamp":"2026-11-24T12:12:17.280Z","request_id":"req_011ChMjPVvwAU3q9AkBYxdHk"}
