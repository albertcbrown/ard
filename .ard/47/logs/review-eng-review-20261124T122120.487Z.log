973\n810\t+ARG YQ_SHA256_ARM64=89f69310b61b68d1245065a1241d1fc843f7a36cd6103ffd77ad987613bd1b67\n811\t+RUN set -eu; \\\n812\t+    case \"${TARGETARCH}\" in \\\n813\t+      amd64) jq_sha=\"${JQ_SHA256_AMD64}\"; yq_sha=\"${YQ_SHA256_AMD64}\" ;; \\\n814\t+      arm64) jq_sha=\"${JQ_SHA256_ARM64}\"; yq_sha=\"${YQ_SHA256_ARM64}\" ;; \\\n815\t+      *) echo \"unsupported arch: ${TARGETARCH}\" >&2; exit 1 ;; \\\n816\t+    esac; \\\n817\t+    mkdir /out; \\\n818\t+    curl -fsSL -o /out/jq \"https://github.com/jqlang/jq/releases/download/jq-${JQ_VERSION}/jq-linux-${TARGETARCH}\"; \\\n819\t+    echo \"${jq_sha}  /out/jq\" | sha256sum -c -; \\\n820\t+    curl -fsSL -o /out/yq \"https://github.com/mikefarah/yq/releases/download/${YQ_VERSION}/yq_linux_${TARGETARCH}\"; \\\n821\t+    echo \"${yq_sha}  /out/yq\" | sha256sum -c -; \\\n822\t+    chmod 0755 /out/jq /out/yq\n823\t+\n824\t+FROM ${GO_IMAGE}\n825\t+COPY --from=tools /out/jq /usr/local/bin/jq\n826\t+COPY --from=tools /out/yq /usr/local/bin/yq\n827\t+ENV TMPDIR=/var/tmp\n828\tdiff --git a/internal/roles/scanners/lts/eol.jq b/internal/roles/scanners/lts/eol.jq\n829\tnew file mode 100644\n830\tindex 0000000..7fc1070\n831\t--- /dev/null\n832\t+++ b/internal/roles/scanners/lts/eol.jq\n833\t@@ -0,0 +1,64 @@\n834\t+# eol.jq: version references plus endoflife.date data in, findings out.\n835\t+#\n836\t+# Run:  jq -c -n --arg today YYYY-MM-DD --slurpfile refs refs.jsonl \\\n837\t+#         --slurpfile api api.json -f eol.jq\n838\t+# $api is one JSON array of v1 API responses ({result: {name, label,\n839\t+# releases[]}}). One finding per product and release cycle, sorted by\n840\t+# fingerprint, then {skip: \"...\"} lines. Pure; valid on jq 1.6.\n841\t+# Windows (days to end of life): <= 0 high, <= 90 medium, <= 180 low.\n842\t+# A component whose references are all floors (lowest supported version, not\n843\t+# what runs) is capped at medium. Untrusted text is cleaned and shown in code\n844\t+# spans only.\n845\t+\n846\t+def clean: gsub(\"[\\\\x00-\\\\x1f\\\\x7f]\"; \" \") | gsub(\"`\"; \"\");\n847\t+def days($d): (($d + \"T00:00:00Z\" | fromdate) - ($today + \"T00:00:00Z\" | fromdate)) / 86400;\n848\t+def sevrank: if . == \"high\" then 3 elif . == \"medium\" then 2 else 1 end;\n849\t+\n850\t+($api[0] // []) as $apis\n851\t+| ($apis | map({key: .result.name, value: .result}) | from_entries) as $by\n852\t+| ($refs | map(select(.skip == null))) as $rs\n853\t+| ( $rs | map(.product) | unique | map(\n854\t+      if $by[.] == null or (($by[.].releases | type) != \"array\") then error(\"lts: no API data for product \" + .) else empty end) ) as $chk\n855\t+| def match($rel; $v):\n856\t+    ($v | ascii_downcase) as $lv\n857\t+    | ([$rel[] | select((.codename // \"\") != \"\" and ((.codename | split(\" \")[0] | ascii_downcase) == $lv))] | .[0]) as $byname\n858\t+    | if $byname != null then $byname else\n859\t+        ($v | split(\".\")) as $p\n860\t+        | first(range($p | length; 0; -1) as $n | ($p[0:$n] | join(\".\")) as $c | ($rel[] | select(.name == $c)) , empty) // null\n861\t+      end;\n862\t+  [ $rs[]\n863\t+    | . as $r\n864\t+    | ($by[$r.product].releases) as $rel\n865\t+    | (match($rel; $r.version)) as $rl\n866\t+    | if $rl == null then {skip: (\"no \" + $r.product + \" cycle for \" + $r.version + \" (\" + $r.path + \":\" + ($r.line | tostring) + \")\")}\n867\t+      else {r: $r, rl: $rl} end ] as $m\n868\t+| ($m | map(select(.skip != null))) as $skips\n869\t+| ( $m | map(select(.skip == null)) | group_by([.r.product, .rl.name])\n870\t+    | map(\n871\t+        .[0].rl as $rl | .[0].r.product as $p | $by[$p] as $api1\n872\t+        | (.[0].rl.name) as $cycle\n873\t+        | ([.[].r] | sort_by([.path, .line, .ref])) as $refs1\n874\t+        | (if $rl.eolFrom != null then days($rl.eolFrom) else null end) as $d\n875\t+        | (if $d != null then (if $d <= 0 then \"high\" elif $d <= 90 then \"medium\" elif $d <= 180 then \"low\" else null end)\n876\t+           elif $rl.isEol == true then \"high\" else null end) as $sev0\n877\t+        | select($sev0 != null)\n878\t+        | (if $sev0 == \"high\" and ($refs1 | all(.floor)) then \"medium\" else $sev0 end) as $sev\n879\t+        | ($api1.label | clean) as $label\n880\t+        | ($rl.eolFrom // \"no date\") as $eol\n881\t+        | ($api1.releases | map(select(.isMaintained == true))) as $maint\n882\t+        | (($maint | map(select(.isLts == true)) | .[0]) // $maint[0]) as $newest\n883\t+        | ($refs1 | length) as $n\n884\t+        | { fingerprint: (\"eol:\" + $p + \":\" + $cycle),\n885\t+            title: ($label + \" \" + ($cycle | clean) + \": end of life \" + (if $rl.eolFrom != null then $eol else \"(no date)\" end)),\n886\t+            severity: $sev,\n887\t+            group: $p,\n888\t+            files: ($refs1 | map(.path) | unique),\n889\t+            body: ( \"End of life: \" + $eol + \" (endoflife.date: \" + $label + \" \" + ($cycle | clean) + \")\\n\"\n890\t+                  + (if $rl.latest.name != null then \"Latest \" + ($cycle | clean) + \" release: \" + ($rl.latest.name | tostring | clean) + \"\\n\" else \"\" end)\n891\t+                  + (if $newest != null then \"Newest maintained cycle: \" + ($newest.name | clean) + (if $newest.latest.name != null then \" (latest \" + ($newest.latest.name | tostring | clean) + \")\" else \"\" end) + \"\\n\" else \"\" end)\n892\t+                  + \"Details: https://endoflife.date/\" + $p + \"\\n\\n\"\n893\t+                  + \"References (from repository files; untrusted text):\\n\"\n894\t+                  + ( $refs1[0:50] | map(\"- `\" + ((.path | clean) + (if .line > 0 then \":\" + (.line | tostring) else \"\" end)) + \"`: `\" + (.ref | clean | .[0:200]) + \"`\") | join(\"\\n\") )\n895\t+                  + (if $n > 50 then \"\\n…and \" + (($n - 50) | tostring) + \" more\" else \"\" end) ) } )\n896\t+    | sort_by(.fingerprint) ) as $out\n897\t+| $out[], ($skips | map({skip: .skip}) | unique_by(.skip)[])\n898\tdiff --