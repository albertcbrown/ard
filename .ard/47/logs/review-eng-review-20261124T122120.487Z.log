h: ${TARGETARCH}\" >&2; exit 1 ;; \\\n     esac; \\\n     mkdir /out; \\\n@@ -60,9 +65,11 @@ RUN set -eu; \\\n     echo \"${osv_sha}  /out/osv-scanner\" | sha256sum -c -; \\\n     curl -fsSL -o /out/jq \"https://github.com/jqlang/jq/releases/download/jq-${JQ_VERSION}/jq-linux-${TARGETARCH}\"; \\\n     echo \"${jq_sha}  /out/jq\" | sha256sum -c -; \\\n+    curl -fsSL -o /out/yq \"https://github.com/mikefarah/yq/releases/download/${YQ_VERSION}/yq_linux_${TARGETARCH}\"; \\\n+    echo \"${yq_sha}  /out/yq\" | sha256sum -c -; \\\n     curl -fsSL -o /out/tini \"https://github.com/krallin/tini/releases/download/${TINI_VERSION}/tini-static-${TARGETARCH}\"; \\\n     echo \"${tini_sha}  /out/tini\" | sha256sum -c -; \\\n-    chmod 0755 /out/osv-scanner /out/jq /out/tini\n+    chmod 0755 /out/osv-scanner /out/jq /out/yq /out/tini\n \n # The final image keeps the Go toolchain (govulncheck loads packages with it);\n # git and ca-certificates are already in the golang image.\n@@ -73,6 +80,7 @@ COPY --from=build /out/ard /usr/local/bin/ard\n COPY --from=build /out/govulncheck /usr/local/bin/govulncheck\n COPY --from=tools /out/osv-scanner /usr/local/bin/osv-scanner\n COPY --from=tools /out/jq /usr/local/bin/jq\n+COPY --from=tools /out/yq /usr/local/bin/yq\n COPY --from=tools /out/tini /usr/local/bin/tini\n # HOME is the pod's PVC (~/.ard state, the repo clone, Go caches). TMPDIR is\n # exec-capable for the cve scan's toolchain downloads. GOTOOLCHAIN=local: the\ndiff --git a/Makefile b/Makefile\nindex 7c4f294..23953ac 100644\n--- a/Makefile\n+++ b/Makefile\n@@ -1,7 +1,7 @@\n VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)\n LDFLAGS := -s -w -X main.version=$(VERSION)\n \n-.PHONY: build test lint fmt clean cve-fixtures lint-scanner-fixtures chart-test image-test\n+.PHONY: build test lint fmt clean cve-fixtures lts-fixtures lint-scanner-fixtures chart-test image-test\n \n build:\n \tCGO_ENABLED=0 go build -ldflags \"$(LDFLAGS)\" -o bin/ard ./cmd/ard\n@@ -33,6 +33,13 @@ cve-fixtures:\n \tdocker run --rm --user \"$$(id -u):$$(id -g)\" -e HOME=/tmp \\\n \t  -v \"$$PWD/internal/roles:/roles\" -w /roles ard-cve-fixtures sh testdata/cve/regen.sh\n \n+# Regenerates the real lts API fixtures inside the pinned lts image (see\n+# internal/roles/testdata/lts/regen.sh). Needs Docker and network; not part of `make test`.\n+lts-fixtures:\n+\tdocker build -t ard-lts-fixtures internal/roles/scanners/lts\n+\tdocker run --rm --user \"$$(id -u):$$(id -g)\" -e HOME=/tmp \\\n+\t  -v \"$$PWD/internal/roles:/roles\" -w /roles ard-lts-fixtures sh testdata/lts/regen.sh\n+\n # Regenerates the real lint scanner fixtures in the pinned image (see\n # internal/roles/testdata/lint/regen.sh). Needs Docker; not part of `make test`.\n lint-scanner-fixtures:\ndiff --git a/deploy/charts/ard-serve/templates/networkpolicy.yaml b/deploy/charts/ard-serve/templates/networkpolicy.yaml\nindex a173b57..b4301af 100644\n--- a/deploy/charts/ard-serve/templates/networkpolicy.yaml\n+++ b/deploy/charts/ard-serve/templates/networkpolicy.yaml\n@@ -1,5 +1,5 @@\n {{- /* No ingress. Egress to cluster DNS and the public internet only (GitHub, the Go module proxy and checksum DB,\n-osv.dev and vuln.go.dev for the cve scan), never other namespaces, private or CGNAT ranges, or link-local metadata. */ -}}\n+osv.dev and vuln.go.dev for the cve scan, endoflife.date for the lts scan), never other namespaces, private or CGNAT ranges, or link-local metadata. */ -}}\n apiVersion: networking.k8s.io/v1\n kind: NetworkPolicy\n metadata:\ndiff --git a/deploy/test-image.sh b/deploy/test-image.sh\nindex add2d68..93db699 100755\n--- a/deploy/test-image.sh\n+++ b/deploy/test-image.sh\n@@ -60,6 +60,7 @@ tools_ok() {\n   run --entrypoint govulncheck \"$tag\" -version 2>&1 | grep -q 'govulncheck@v1\\.10\\.0' || { echo \"govulncheck: $(run --entrypoint govulncheck \"$tag\" -version 2>&1 | head -3)\" >&2; return 1; }\n   run --entrypoint osv-scanner \"$tag\" --version 2>&1 | grep -q 'osv-scanner version: 2\\.7\\.1' || { echo \"osv-scanner: $(run --entrypoint osv-scanner \"$tag\" --version 2>&1 | head -2)\" >&2; return 1; }\n   [ \"$(run --entrypoint jq \"$tag\" --version)\" = \"jq-1.8.2\" ] || { echo \"jq: $(run --entrypoint jq \"$tag\" --version)\" >&2; return 1; }\n+  run --entrypoint yq \"$tag\" --version | grep -q 'version v4\\.54\\.3$' || { echo \"yq: $(run --entrypoint yq \"$tag\" --version)\" >&2; return 1; }\n   run --entrypoint git \"$tag\" --version | grep -q '^git version ' || return 1\n   [ \"$(run --entrypoint sh \"$tag\" -c 'command -v ard')\" = \"/usr/local/bin/ard\" ] || return 1\n }\n@@ -87,6 +88,19 @@ else\n   fail \"cve scan runs in the image as a host subprocess\" \"exit $?: $(tail -5 \"$work/scan.err\")\"\n fi\n \n+# The lts role the same way. It needs network (endoflife.date); empty output and finding lines both pass.\n+lts_out=\"$work/lts.out\"\n+if run --tmpfs /home/ard:uid=65532,gid=65532,exec --tmpfs /var/tmp:uid=65532,gid=65532,exec \\\n+     -v \"$ROOT:/repo:ro\" -w /repo --entrypoint /repo/internal/roles/scanners/lts/scan \"$tag\" >\"$lts_out\" 2>\"$work/lts.err\"; then\n+  if [ ! -s \"$lts_out\" ] || jq -e -s 'all(.[]; type == \"object\" and has(\"fingerprint\"))' \"$lts_out\" >/dev/null 2>&1; then\n+    pass \"lts scan runs in the image as a host subprocess\"\n+  else\n+    fail \"lts scan runs in the image as a host subprocess\" \"stdout is not finding JSON lines: $(head -c 300 \"$lts_out\")\"\n+  fi\n+else\n+  fail \"lts scan runs in the image as a host subprocess\" \"exit $?: $(tail -5 \"$work/lts.err\")\"\n+fi\n+\n # The same run on a fixture with a known-vulnerable dependency must report it: empty output cannot pass.\n fixture=\"$ROOT/deploy/testdata/cve-fixture\"\n fx_out=\"$work/fixture.out\"\ndiff --git a/docs/proposal.md b/docs/proposal.md\nindex 78b9881..1e7cde9 100644\n--- a/docs/proposal.md\n+++ b/docs/proposal.md\n@@ -208,7 +208,7 @@ A scanner is a directory, `.ard/scanners/<name>/`, holding either an executable\n | Scanner | Engine | Every | Group size | Auto-close |\n | --- | --- | --- | --- | --- |\n | cve | osv-scanner and govulncheck (trivy and the Dependabot alerts API later) | 6 h | 1 | yes |\n-| lts | endoflife.date + manifests: go.mod, package.json, Dockerfile `FROM`, Helm charts | 7 d | 1 per component | yes |\n+| lts | endoflife.date v1 API + manifests: go.mod, package.json, Dockerfile `FROM`, Helm `values.yaml` images | 7 d | 1 per component (product and cycle) | yes |\n | lint | golangci-lint per Go module (the repo's config, or the role's `golangci.yml`), plus `//nolint` directives, minus the role directory's `baseline` | 24 h | 20 per rule and directory | yes |\n | error-codes | pattern match over source, registry and docs files (`sh` + `jq`) | 24 h | 20 | yes |\n | trufflehog | leaked-credential scan of the current commit (`sh` + `jq` + TruffleHog) | 24 h | 1 | yes |\n@@ -226,6 +226,8 @@ A scanner is a directory, `.ard/scanners/<name>/`, holding either an executable\n \n **The missing-tests scanner** (`scanners/missing-tests`, a `sh` script plus a stdlib-only Go helper) runs each Go module's own tests with `go test -coverpkg=./...` and files one finding per exported function or method that no test calls by name or that the tests never run; the group is the package, and the fingerprint does not depend on the file or line. Because it runs the repository's tests it needs the executor's container and egress to the module proxy. If a module's tests fail to build or fail, the scan fails and files nothing, so autoclose never acts on partial coverage. A human-owned `ignore` file next to `scan` skips symbols or packages, and a `no-coverage` file there skips the test run and reports only the static rule. It ships in the starter tree but is not enabled on ard's own `.ard/`.\n \n+**The lts scanner** (`scanners/lts`, a `sh` script plus two `jq` programs and `yq` for Helm, no build step) flags components at or near end of life using the endoflife.date v1 API (`/api/v1/products/<slug>`, one request per referenced product). A component is a product plus a release cycle. Its fingerprint is `eol:<product>:<cycle>` (for example `eol:nodejs:18`), one finding lists every referencing file, and `group` is the product. The human-owned `products.json` maps Docker image names and a few npm packages to endoflife.date slugs (the Alpine image maps to `alpine-linux`); names not in it are skipped with a stderr line. Cycles match generically: a codename's first word (`bookworm`, `jammy`), else the longest dotted prefix of the version. It reads the `toolchain` line (else the `go` directive) of `go.mod`; `engines.node` and table npm dependencies of `package.json` (lowest lower bound of the range); Dockerfile `FROM` lines (`Dockerfile`, `Dockerfile.*`, `*.Dockerfile`, `Containerfile`; global `ARG` substitution, registry and digest stripped); and `repository`/`tag` or `image: name:tag` in the `values.yaml` beside each `Chart.yaml`. Severity is `high` at or past end of life, `medium` within 90 days, `low` within 180 days, otherwise no finding. A component referenced only by floors (a `go` directive, `engines.node`, an npm range) is capped at `medium`. Titles carry the date (`Go 1.21: end of life 2024-08-13`), never \"approaching\" or \"past\", because rerate changes only severity. The scan fails closed with nothing on stdout, because an absent finding closes its issue: any API failure (including a 404 for a mapped product, which means `products.json` is stale), a non-JSON response, and a `package.json` or `values.yaml` that cannot be parsed. A missing tool exits 2 (`yq` only when a `Chart.yaml` exists). Paths with a `.git`, `vendor`, `node_modules` or `testdata` segment are skipped. Manifest text reaches the issue body only as cleaned text in code spans (control characters and backticks removed, 200 characters, at most 50 references), and repo text never reaches a URL.\n+\n **The trufflehog scanner** (`scanners/trufflehog`, a `sh` script plus one `jq` program) runs `trufflehog filesystem . --json --no-update --no-color --no-verification --no-ignore-tag --fail-on-scan-errors --concurrency=2` on the current commit. It never verifies a credential against a provider. Only the detector name, file, line and a hash of the secret leave the scan: `Raw`, `RawV2`, `Redacted`, `SecretParts`, `ExtraData` and `StructuredData` stay in pipes inside `scan`. The fingerprint is `trufflehog:` plus the first 16 hex digits of SHA-256 over `ard-trufflehog-v1`, a NUL byte and the base64 of the secret (an unsalted hash, so one value gives one issue wherever it appears). The scan fails closed: a non-zero trufflehog exit, a missing `finished scanning` summary, zero chunks on a non-empty tree, or a result count that differs from the summary produces no findings, so nothing is autoclosed on a partial run. `exclude-paths` (regexes; `.git` is always excluded) and `allow` (one fingerprint per line) are human-owned; a bad `allow` entry fails the run. Findings use `route: needs-human`, severity high, and carry a runbook that says to rotate the credential first. `commit` is the scanned SHA, recorded in `.ard/<n>/issue.md`; only HEAD is scanned, and a history scanner is a follow-up (#224). The forbidden flags (`--since-commit`, `--max-depth`, `--detector-timeout`, `--archive-timeout`, `--filter-unverified`, `--filter-entropy`, `--results`) are never passed, because a partial or load-dependent result would autoclose live findings. Caveats: (1) a secret gone from HEAD is not revoked; autoclose closes the issue as completed, so the issue body tells the human to rotate first. (2) The fingerprint hash is unsalted, an offline oracle for a low-entropy value that is already in the repo at HEAD; accepted. (3) Issues on a public repo show `file:line`. (4) At `max_open` the scanner is skipped, so new leaks go unseen until a human resolves one; scanner failure streaks are posted on the status issue (#221). (5) Any future change that commits scanner logs must exclude this scanner. (6) On a public repo with GitHub secret scanning off, this scanner is the only detection channel, and it cannot stop a push. TruffleHog is AGPL-3.0: it is installed by the role's Dockerfile (or a host install) and is not in the published `ard` image or the root `Dockerfile`. Host and Docker integration tests (`go test -tags integration -run Trufflehog ./internal/roles/`, with `ARD_TRUFFLEHOG_BIN` at the Dockerfile's pinned version) prove the role against a real binary and image.\n \n **The docs scanner** (`scanners/docs`, a `sh` script plus one stdlib-only Go program, `docscan.go`, built at scan time with the job's own Go) lists undocumented exported Go identifiers. It reports, per package directory: a missing package comment; an exported function, a method on an exported receiver type (pointer, value or generic) and an exported type with no doc comment (the spec's doc, its trailing comment or the enclosing declaration's doc all count); and an exported const or var with no comment, one finding per parenthesised block that has no block comment. Struct fields, interface methods, methods on unexported types and comment wording are not checked. Every exported identifier counts, `internal/` included, and files for every platform count (build constraints are not evaluated). It skips `testdata/`, `vendor/`, `node_modules/` and dot or underscore directories, files whose names start with `_` or `.`, symlinks, `*_test.go`, `//go:build ignore` files, generated files and `package main`. The fingerprint is `docs:undoc:<dir>:<symbol>` or `docs:pkg:<dir>`; the file and line are left out, so moving a declaration within its package keeps its issue. Severity is `low` and the group is the package directory. It only parses files: it never runs repository code and needs no network. It fails closed: a parse error, unreadable file, invalid path or more than 10,000 findings fails the run with nothing filed. A human-owned `exclude` file in the role directory skips package directories (`dir/` is a directory and everything below it, anything else a glob matched against the package directory); an entry makes its findings vanish, so autoclose closes their issues. Go only for now.\n@@ -429,6 +431,7 @@ sidecars:\n \n overrides:                   # only what differs from convention\n   scanners/cve:             { every: 6h, max_open: 10, group_size: 1, autoclose: true }\n+  scanners/lts:             { every: 7d, max_open: 5, group_size: 1, autoclose: true }\n   scanners/docs:            { every: 3d, max_open: 3, group_size: 10, autoclose: true }\n   scanners/error-codes:     { every: 24h, group_size: 20, autoclose: true }\n   scanners/missing-tests:   { every: 24h, max_open: 5, group_size: 10, autoclose: true }\n@@ -447,7 +450,7 @@ overrides:                   # only what differs from convention\n \n Scanners also take `route` (`pending`, `none` or `needs-human`). Anything unset takes its default: intake in `label` mode with `ard:pending`, scanners every 4 h with `max_open` 5 and `group_size` 10, triage every 15 min, a 30-minute job timeout, `make test`, 2 test-fix attempts, 3 review rounds and worker diff thresholds of 1,000 lines (warn) and 2,000 lines (hold). Durations accept `m`, `h` and `d`. A sidecar `repo` must be `owner/name` and its `ref` a valid git ref name (no `:`, leading `-`, `..` or spaces; an abbreviated SHA is rejected, use all 40 characters); `ard config check` reports the file and key. A worker's `timeout` and `max_budget_usd` cover the whole job (every step), and `tests: \"\"` disables its test step. Per-role keys are `every`, `max_open`, `group_size`, `autoclose`, `timeout`, `agent`, `model`, `max_budget_usd`, `budget_usd_per_day` (that role's own daily cap in USD; unset or 0 means only the repo cap applies), `sidecar`, `after`, `plan_section`, `tests`, `max_test_fixes`, `max_review_rounds`, `diff_warn_lines` and `diff_max_lines` (worker roles; positive integers, warn no more than max; above warn the PR proceeds with a note, above max it is held), `reviewers` and `when` (`paths`, or `triage` roles that ran; at least one is required). `ard config check` warns when every reviewer has a `when:` rule, because a PR matching none gets no review and stays a draft. `plan_section` is for triage roles: the `## <heading>` of `plan.md` the role owns (one line, no leading `#`, unique across triage roles). The starter roles default to Requirements (product-manager), Design (architect), UX (designer), Docs (documentation-planner) and Implementation (engineer), and a value in `config.yaml` overrides that; a triage role with none may write only its own role file. There are no per-role config files: `ard init` writes a role's starting overrides into `config.yaml` for the roles it ships. Once a second repo adopts ard, role directories can move to a shared roles repo pinned by ref, like a sidecar; a repo's own directory of the same name wins. `after` names triage roles, with no self-reference and no cycles.\n \n-**`ard init` proposes the starter `.ard/` as a PR (decided, #27).** It builds `config.yaml` and the starter roles in memory (today `scanners/cve`, `scanners/docs`, `scanners/error-codes`, `scanners/lint`, `scanners/missing-tests`, `scanners/trufflehog`, `triage/lead`, `triage/engineer`, `workers/engineer`, `reviewers/eng-review`, `reviewers/license-review`, `reviewers/product-manager-review` and `reviewers/security-review`; `intake: {mode: label}`, the protected-path defaults above, and the cve, docs, error-codes, lint, lead, engineer, worker, eng-review, security-review, license-review and product-manager-review overrides), compares them with `main`, commits them on a new branch `ard-init` cut from `main` through the effect layer and a narrow committer lane, pushes it and opens a PR. It writes nothing to the local working tree or to `main`, and `scan` is committed `100755`. Files that already exist on `main` with different contents are a conflict naming the paths; `--force` proposes overwriting them, and init never deletes anything. It refuses while `ard-init` exists on the remote, whatever its PR's state, so it never force-pushes over or stacks commits on a human's edits: merge or close the PR, delete the branch and rerun. If `main` already has every starter file it prints `nothing to propose`. It syncs the label catalogue first (like `ard labels sync`), so a failure leaves nothing pushed. With `--dry-run` the commit, push and PR are logged to the ledger instead of acting. A missing repo, credentials or `main` branch exits 1 with nothing written, and `ARD_GITHUB_TOKEN` auth is refused outside `--dry-run`. The PR body carries the one step the App cannot do: copy `.github/workflows/bot-commits.yml` and set the repository variable `ARD_BOT_LOGIN` (optionally `ARD_BOT_CHECK_SINCE`). When the lint scanner is among the files, it also says the scanner fails until `.ard/scanners/lint/baseline` is committed. It also says to merge with **Squash and merge** or **Create a merge commit**, never a fast-forward from the command line, which would put the bot's commit on main's first-parent history. **Rebase and merge** is also safe: the scratch-repo run (#85) showed GitHub records the merging human as committer of a rebase-merged commit (the bot stays the author), and the bot-commit check keys on committer, so it does not flag it. The body still names only the two merges above.\n+**`ard init` proposes the starter `.ard/` as a PR (decided, #27).** It builds `config.yaml` and the starter roles in memory (today `scanners/cve`, `scanners/lts`, `scanners/docs`, `scanners/error-codes`, `scanners/lint`, `scanners/missing-tests`, `scanners/trufflehog`, `triage/lead`, `triage/engineer`, `workers/engineer`, `reviewers/eng-review`, `reviewers/license-review`, `reviewers/product-manager-review` and `reviewers/security-review`; `intake: {mode: label}`, the protected-path defaults above, and the cve, lts, docs, error-codes, lint, lead, engineer, worker, eng-review, security-review, license-review and product-manager-review overrides), compares them with `main`, commits them on a new branch `ard-init` cut from `main` through the effect layer and a narrow committer lane, pushes it and opens a PR. It writes nothing to the local working tree or to `main`, and `scan` is committed `100755`. Files that already exist on `main` with different contents are a conflict naming the paths; `--force` proposes overwriting them, and init never deletes anything. It refuses while `ard-init` exists on the remote, whatever its PR's state, so it never force-pushes over or stacks commits on a human's edits: merge or close the PR, delete the branch and rerun. If `main` already has every starter file it prints `nothing to propose`. It syncs the label catalogue first (like `ard labels sync`), so a failure leaves nothing pushed. With `--dry-run` the commit, push and PR are logged to the ledger instead of acting. A missing repo, credentials or `main` branch exits 1 with nothing written, and `ARD_GITHUB_TOKEN` auth is refused outside `--dry-run`. The PR body carries the one step the App cannot do: copy `.github/workflows/bot-commits.yml` and set the repository variable `ARD_BOT_LOGIN` (optionally `ARD_BOT_CHECK_SINCE`). When the lint scanner is among the files, it also says the scanner fails until `.ard/scanners/lint/baseline` is committed. It also says to merge with **Squash and merge** or **Create a merge commit**, never a fast-forward from the command line, which would put the bot's commit on main's first-parent history. **Rebase and merge** is also safe: the scratch-repo run (#85) showed GitHub records the merging human as committer of a rebase-merged commit (the bot stays the author), and the bot-commit check keys on committer, so it does not flag it. The body still names only the two merges above.\n \n **Where `ard serve` reads config (decided, #87).** After each fetch into its own clone (`~/.ard/repos/<owner>/<repo>.git`, see Local-executor details) `ard serve` resolves `origin/main` to a SHA and reads `config.yaml` and the role directories from that commit, not from the working tree. It exports them into a snapshot at `~/.ard/config/<owner>/<repo>/<sha>/`, kept 24 hours after a newer SHA replaces it, because roles run from a host path: a role directory, its `Dockerfile` and the scan worktree must all describe the one commit the tick's jobs use. Editing the host's working tree therefore changes nothing on a running controller, with one exception: a local `paused: true` is honoured (see the kill switch), and only that key is read locally. A merged change applies on the next tick without a pull. Symlinks and submodules under the role directories are rejected, and a config that cannot be fetched or does not validate counts as paused. If `origin/main` cannot be loaded at startup, `ard serve` starts paused instead of exiting, posts the load error to the status issue once per distinct error, and retries every tick; no loop runs until a config has loaded. `ard config check` validates the working tree, for authoring; `ard config check --ref <ref>` validates a commit of the local checkout (for example `--ref origin/main` after `git fetch`) without fetching.\n \ndiff --git a/internal/initcmd/initcmd_test.go b/internal/initcmd/initcmd_test.go\nindex e8c3372..e6226d3 100644\n--- a/internal/initcmd/initcmd_test.go\n+++ b/internal/initcmd/initcmd_test.go\n@@ -143,7 +143,7 @@ func snapshot(t *testing.T, dir string) map[string]string {\n \treturn m\n }\n \n-var starterTree = []string{\".ard/config.yaml\", \".ard/reviewers/eng-review/prompt.txt\", \".ard/reviewers/license-review/allowlist.txt\", \".ard/reviewers/license-review/prompt.txt\", \".ard/reviewers/product-manager-review/prompt.txt\", \".ard/reviewers/security-review/prompt.txt\", \".ard/scanners/cve/Dockerfile\", \".ard/scanners/cve/merge.jq\", \".ard/scanners/cve/scan\", \".ard/scanners/docs/Dockerfile\", \".ard/scanners/docs/docscan.go\", \".ard/scanners/docs/scan\", \".ard/scanners/error-codes/Dockerfile\", \".ard/scanners/error-codes/errcodes.jq\", \".ard/scanners/error-codes/scan\", \".ard/scanners/lint/Dockerfile\", \".ard/scanners/lint/normalize.jq\", \".ard/scanners/lint/scan\", \".ard/scanners/missing-tests/Dockerfile\", \".ard/scanners/missing-tests/missingtests.go\", \".ard/scanners/missing-tests/scan\", \".ard/scanners/trufflehog/Dockerfile\", \".ard/scanners/trufflehog/exclude-paths\", \".ard/scanners/trufflehog/findings.jq\", \".ard/scanners/trufflehog/scan\", \".ard/triage/architect/prompt.txt\", \".ard/triage/designer/prompt.txt\", \".ard/triage/documentation-planner/prompt.txt\", \".ard/triage/engineer/prompt.txt\", \".ard/triage/lead/prompt.txt\", \".ard/triage/product-manager/prompt.txt\", \".ard/workers/engineer/prompt.txt\"}\n+var starterTree = []string{\".ard/config.yaml\", \".ard/reviewers/eng-review/prompt.txt\", \".ard/reviewers/license-review/allowlist.txt\", \".ard/reviewers/license-review/prompt.txt\", \".ard/reviewers/product-manager-review/prompt.txt\", \".ard/reviewers/security-review/prompt.txt\", \".ard/scanners/cve/Dockerfile\", \".ard/scanners/cve/merge.jq\", \".ard/scanners/cve/scan\", \".ard/scanners/docs/Dockerfile\", \".ard/scanners/docs/docscan.go\", \".ard/scanners/docs/scan\", \".ard/scanners/error-codes/Dockerfile\", \".ard/scanners/error-codes/errcodes.jq\", \".ard/scanners/error-codes/scan\", \".ard/scanners/lint/Dockerfile\", \".ard/scanners/lint/normalize.jq\", \".ard/scanners/lint/scan\", \".ard/scanners/lts/Dockerfile\", \".ard/scanners/lts/eol.jq\", \".ard/scanners/lts/products.json\", \".ard/scanners/lts/refs.jq\", \".ard/scanners/lts/scan\", \".ard/scanners/missing-tests/Dockerfile\", \".ard/scanners/missing-tests/missingtests.go\", \".ard/scanners/missing-tests/scan\", \".ard/scanners/trufflehog/Dockerfile\", \".ard/scanners/trufflehog/exclude-paths\", \".ard/scanners/trufflehog/findings.jq\", \".ard/scanners/trufflehog/scan\", \".ard/triage/architect/prompt.txt\", \".ard/triage/designer/prompt.txt\", \".ard/triage/documentation-planner/prompt.txt\", \".ard/triage/engineer/prompt.txt\", \".ard/triage/lead/prompt.txt\", \".ard/triage/product-manager/prompt.txt\", \".ard/workers/engineer/prompt.txt\"}\n \n func TestInitOpensPR(t *testing.T) {\n \th := newHarness(t)\ndiff --git a/internal/roles/config.yaml b/internal/roles/config.yaml\nindex 46a8a1c..6a43b61 100644\n--- a/internal/roles/config.yaml\n+++ b/internal/roles/config.yaml\n@@ -33,6 +33,7 @@ merge:\n \n overrides:\n   scanners/cve: { every: 6h, max_open: 10, group_size: 1, autoclose: true }\n+  scanners/lts: { every: 7d, max_open: 5, group_size: 1, autoclose: true }\n   scanners/docs: { every: 3d, max_open: 3, group_size: 10, autoclose: true }\n   scanners/error-codes: { every: 24h, group_size: 20, autoclose: true }\n   scanners/missing-tests: { every: 24h, max_open: 5, group_size: 10, autoclose: true }\ndiff --git a/internal/roles/lts_integration_test.go b/internal/roles/lts_integration_test.go\nnew file mode 100644\nindex 0000000..6609789\n--- /dev/null\n+++ b/internal/roles/lts_integration_test.go\n@@ -0,0 +1,71 @@\n+//go:build integration\n+\n+package roles\n+\n+import (\n+\t\"bytes\"\n+\t\"encoding/json\"\n+\t\"net/http\"\n+\t\"os\"\n+\t\"os/exec\"\n+\t\"path/filepath\"\n+\t\"testing\"\n+\t\"time\"\n+)\n+\n+// TestIntegrationLtsProductsExist fetches every slug in products.json from\n+// the live API: a stale table makes the scan fail closed.\n+func TestIntegrationLtsProductsExist(t *testing.T) {\n+\tb, err := FS.ReadFile(\"scanners/lts/products.json\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tvar tables map[string]map[string]string\n+\tif err := json.Unmarshal(b, &tables); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tclient := &http.Client{Timeout: 30 * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}\n+\tfor _, m := range tables {\n+\t\tfor _, slug := range m {\n+\t\t\tresp, err := client.Get(\"https://endoflife.date/api/v1/products/\" + slug)\n+\t\t\tif err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t\tvar body struct {\n+\t\t\t\tResult struct{ Releases []json.RawMessage }\n+\t\t\t}\n+\t\t\tderr := json.NewDecoder(resp.Body).Decode(&body)\n+\t\t\tresp.Body.Close()\n+\t\t\tif resp.StatusCode != 200 || derr != nil || len(body.Result.Releases) == 0 {\n+\t\t\t\tt.Errorf(\"%s: status %d, %d releases, decode %v\", slug, resp.StatusCode, len(body.Result.Releases), derr)\n+\t\t\t}\n+\t\t}\n+\t}\n+}\n+\n+// TestIntegrationLtsRealAPI runs the real scan against the live API. Go 1.20\n+// and Node.js 16 are end of life for good.\n+func TestIntegrationLtsRealAPI(t *testing.T) {\n+\tneedTools(t, \"jq\", \"curl\")\n+\trepo := t.TempDir()\n+\tfor p, c := range map[string]string{\"Dockerfile\": \"FROM node:16\\n\", \"go.mod\": \"module x\\n\\ngo 1.20\\ntoolchain go1.20.1\\n\"} {\n+\t\tif err := os.WriteFile(filepath.Join(repo, p), []byte(c), 0o644); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\tscan, _ := filepath.Abs(filepath.Join(\"scanners\", \"lts\", \"scan\"))\n+\tcmd := exec.Command(scan)\n+\tcmd.Dir = repo\n+\tvar so, se bytes.Buffer\n+\tcmd.Stdout, cmd.Stderr = &so, &se\n+\tif err := cmd.Run(); err != nil {\n+\t\tt.Fatalf(\"%v\\n%s\", err, se.String())\n+\t}\n+\tgot := map[string]string{}\n+\tfor _, f := range decode(t, so.Bytes()) {\n+\t\tgot[f.Fingerprint] = f.Severity\n+\t}\n+\tif got[\"eol:go:1.20\"] != \"high\" || got[\"eol:nodejs:16\"] != \"high\" {\n+\t\tt.Errorf(\"got %v\", got)\n+\t}\n+}\ndiff --git a/internal/roles/lts_test.go b/internal/roles/lts_test.go\nnew file mode 100644\nindex 0000000..83f4983\n--- /dev/null\n+++ b/internal/roles/lts_test.go\n@@ -0,0 +1,354 @@\n+package roles\n+\n+import (\n+\t\"bytes\"\n+\t\"encoding/json\"\n+\t\"os\"\n+\t\"os/exec\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+// jqRun runs one of the lts jq programs with the given args and returns the\n+// output lines and any error.\n+func ltsJQ(t *testing.T, prog string, args ...string) ([]string, error) {\n+\tt.Helper()\n+\tfull := append([]string{\"-c\", \"-n\"}, args...)\n+\tfull = append(full, \"-f\", filepath.Join(\"scanners\", \"lts\", prog))\n+\tvar so, se bytes.Buffer\n+\tcmd := exec.Command(\"jq\", full...)\n+\tcmd.Stdout, cmd.Stderr = &so, &se\n+\terr := cmd.Run()\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\ts := strings.TrimSpace(so.String())\n+\tif s == \"\" {\n+\t\treturn nil, nil\n+\t}\n+\treturn strings.Split(s, \"\\n\"), nil\n+}\n+\n+func writeTemp(t *testing.T, name, content string) string {\n+\tt.Helper()\n+\tp := filepath.Join(t.TempDir(), name)\n+\tif err := os.WriteFile(p, []byte(content), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\treturn p\n+}\n+\n+func TestLtsRefsGolden(t *testing.T) {\n+\tneedTools(t, \"jq\")\n+\tproducts := filepath.Join(\"scanners\", \"lts\", \"products.json\")\n+\tcases := []struct {\n+\t\tname string\n+\t\tin   string\n+\t\twant []string\n+\t}{\n+\t\t{\"go directive is a floor\", `{\"kind\":\"gomod\",\"path\":\"go.mod\",\"text\":\"module x\\n\\ngo 1.21\\n\"}`,\n+\t\t\t[]string{`{\"product\":\"go\",\"version\":\"1.21\",\"path\":\"go.mod\",\"line\":3,\"ref\":\"go 1.21\",\"floor\":true}`}},\n+\t\t{\"toolchain wins\", `{\"kind\":\"gomod\",\"path\":\"go.mod\",\"text\":\"go 1.21\\ntoolchain go1.21.5\\n\"}`,\n+\t\t\t[]string{`{\"product\":\"go\",\"version\":\"1.21.5\",\"path\":\"go.mod\",\"line\":2,\"ref\":\"toolchain go1.21.5\",\"floor\":false}`}},\n+\t\t{\"engines lowest bound\", `{\"kind\":\"packagejson\",\"path\":\"package.json\",\"text\":\"{\\\"engines\\\":{\\\"node\\\":\\\">=16.0.0 <21\\\"}}\"}`,\n+\t\t\t[]string{`{\"product\":\"nodejs\",\"version\":\"16.0.0\",\"path\":\"package.json\",\"line\":1,\"ref\":\"engines.node >=16.0.0 <21\",\"floor\":true}`}},\n+\t\t{\"engines or-range\", `{\"kind\":\"packagejson\",\"path\":\"package.json\",\"text\":\"{\\\"engines\\\":{\\\"node\\\":\\\"^20 || ^18\\\"}}\"}`,\n+\t\t\t[]string{`{\"product\":\"nodejs\",\"version\":\"18\",\"path\":\"package.json\",\"line\":1,\"ref\":\"engines.node ^20 || ^18\",\"floor\":true}`}},\n+\t\t{\"engines star skipped\", `{\"kind\":\"packagejson\",\"path\":\"package.json\",\"text\":\"{\\\"engines\\\":{\\\"node\\\":\\\"*\\\"}}\"}`,\n+\t\t\t[]string{`{\"skip\":\"engines.node range not understood in package.json\"}`}},\n+\t\t{\"npm table only\", `{\"kind\":\"packagejson\",\"path\":\"package.json\",\"text\":\"{\\\"dependencies\\\":{\\\"vue\\\":\\\"^2.6\\\",\\\"left-pad\\\":\\\"1.0.0\\\"}}\"}`,\n+\t\t\t[]string{`{\"product\":\"vue\",\"version\":\"2.6\",\"path\":\"package.json\",\"line\":1,\"ref\":\"vue ^2.6\",\"floor\":true}`}},\n+\t\t{\"dockerfile matrix\", `{\"kind\":\"dockerfile\",\"path\":\"Dockerfile\",\"text\":\"ARG GO_IMAGE=golang:1.21\\nFROM ${GO_IMAGE} AS build\\nFROM --platform=$BUILDPLATFORM node:18-alpine\\nFROM build\\nFROM scratch\\nFROM docker.io/library/python:3.8@sha256:abc\\nfrom ubuntu:jammy\\nFROM node:latest\\nFROM ${UNSET}\\nFROM ghcr.io/x/y:1\\n\"}`,\n+\t\t\t[]string{\n+\t\t\t\t`{\"product\":\"go\",\"version\":\"1.21\",\"path\":\"Dockerfile\",\"line\":2,\"ref\":\"FROM ${GO_IMAGE} AS build\",\"floor\":false}`,\n+\t\t\t\t`{\"product\":\"nodejs\",\"version\":\"18\",\"path\":\"Dockerfile\",\"line\":3,\"ref\":\"FROM --platform=$BUILDPLATFORM node:18-alpine\",\"floor\":false}`,\n+\t\t\t\t`{\"product\":\"python\",\"version\":\"3.8\",\"path\":\"Dockerfile\",\"line\":6,\"ref\":\"FROM docker.io/library/python:3.8@sha256:abc\",\"floor\":false}`,\n+\t\t\t\t`{\"product\":\"ubuntu\",\"version\":\"jammy\",\"path\":\"Dockerfile\",\"line\":7,\"ref\":\"from ubuntu:jammy\",\"floor\":false}`,\n+\t\t\t\t`{\"skip\":\"unmapped image ghcr.io/x/y (Dockerfile)\"}`,\n+\t\t\t\t`{\"skip\":\"unpinned tag for node (Dockerfile:8)\"}`,\n+\t\t\t\t`{\"skip\":\"unresolved image \\\"${UNSET}\\\" (Dockerfile:9)\"}`,\n+\t\t\t}},\n+\t\t{\"helm\", `{\"kind\":\"helmvalues\",\"path\":\"c/values.yaml\",\"json\":{\"image\":{\"repository\":\"redis\",\"tag\":\"7.0.5\"},\"sub\":{\"image\":\"nginx:1.25\",\"db\":{\"image\":{\"repository\":\"postgres\",\"tag\":12}},\"x\":{\"repository\":\"quay.io/a/b\",\"tag\":\"1\"}}}}`,\n+\t\t\t[]string{\n+\t\t\t\t`{\"product\":\"nginx\",\"version\":\"1.25\",\"path\":\"c/values.yaml\",\"line\":0,\"ref\":\"image nginx:1.25\",\"floor\":false}`,\n+\t\t\t\t`{\"product\":\"postgresql\",\"version\":\"12\",\"path\":\"c/values.yaml\",\"line\":0,\"ref\":\"repository postgres tag 12\",\"floor\":false}`,\n+\t\t\t\t`{\"product\":\"redis\",\"version\":\"7.0.5\",\"path\":\"c/values.yaml\",\"line\":0,\"ref\":\"repository redis tag 7.0.5\",\"floor\":false}`,\n+\t\t\t\t`{\"skip\":\"unmapped image quay.io/a/b (c/values.yaml)\"}`,\n+\t\t\t}},\n+\t}\n+\tfor _, c := range cases {\n+\t\tt.Run(c.name, func(t *testing.T) {\n+\t\t\tin := writeTemp(t, \"in.jsonl\", c.in+\"\\n\")\n+\t\t\tgot, err := ltsJQ(t, \"refs.jq\", \"--slurpfile\", \"in\", in, \"--slurpfile\", \"map\", products)\n+\t\t\tif err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t\tif strings.Join(got, \"\\n\") != strings.Join(c.want, \"\\n\") {\n+\t\t\t\tt.Errorf(\"got:\\n%s\\nwant:\\n%s\", strings.Join(got, \"\\n\"), strings.Join(c.want, \"\\n\"))\n+\t\t\t}\n+\t\t})\n+\t}\n+\tt.Run(\"unparseable package.json fails\", func(t *testing.T) {\n+\t\tin := writeTemp(t, \"in.jsonl\", `{\"kind\":\"packagejson\",\"path\":\"package.json\",\"text\":\"{nope\"}`+\"\\n\")\n+\t\tif _, err := ltsJQ(t, \"refs.jq\", \"--slurpfile\", \"in\", in, \"--slurpfile\", \"map\", products); err == nil {\n+\t\t\tt.Fatal(\"want error\")\n+\t\t}\n+\t})\n+}\n+\n+// apiFile builds the one-array API input from the captured fixtures.\n+func ltsAPI(t *testing.T, products ...string) string {\n+\tt.Helper()\n+\tvar parts []json.RawMessage\n+\tfor _, p := range products {\n+\t\tb, err := os.ReadFile(filepath.Join(\"testdata\", \"lts\", \"api\", p+\".json\"))\n+\t\tif err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tparts = append(parts, b)\n+\t}\n+\tb, _ := json.Marshal(parts)\n+\treturn writeTemp(t, \"api.json\", string(b))\n+}\n+\n+const ltsSynthetic = `{\"result\":{\"name\":\"syn\",\"label\":\"Syn\",\"releases\":[\n+{\"name\":\"1\",\"codename\":null,\"isLts\":false,\"isEol\":true,\"eolFrom\":null,\"isMaintained\":false,\"latest\":{\"name\":\"1.9\"}},\n+{\"name\":\"2\",\"codename\":null,\"isLts\":false,\"isEol\":false,\"eolFrom\":\"2026-02-23\",\"isMaintained\":true,\"latest\":{\"name\":\"2.9\"}},\n+{\"name\":\"3\",\"codename\":null,\"isLts\":false,\"isEol\":false,\"eolFrom\":\"2026-05-24\",\"isMaintained\":true,\"latest\":{\"name\":\"3.9\"}},\n+{\"name\":\"4\",\"codename\":null,\"isLts\":false,\"isEol\":false,\"eolFrom\":\"2026-05-25\",\"isMaintained\":true,\"latest\":{\"name\":\"4.9\"}},\n+{\"name\":\"5\",\"codename\":null,\"isLts\":false,\"isEol\":false,\"eolFrom\":null,\"isMaintained\":true,\"latest\":{\"name\":\"5.9\"}}]}}`\n+\n+func TestLtsEolGolden(t *testing.T) {\n+\tneedTools(t, \"jq\")\n+\tref := func(product, version, path string, line int, text string, floor bool) string {\n+\t\tb, _ := json.Marshal(map[string]any{\"product\": product, \"version\": version, \"path\": path, \"line\": line, \"ref\": text, \"floor\": floor})\n+\t\treturn string(b)\n+\t}\n+\t// today is 2026-02-23: cycle 2 is due today (high), 3 in exactly 90 days\n+\t// (medium), 4 in 91 days (low), 1 has isEol with no date (high).\n+\tsyn := writeTemp(t, \"syn.json\", \"[\"+ltsSynthetic+\"]\")\n+\tcases := []struct {\n+\t\tname   string\n+\t\tapi    string\n+\t\ttoday  string\n+\t\trefs   []string\n+\t\twant   map[string]string // fingerprint -> severity\n+\t\tskips  int\n+\t\terrors bool\n+\t}{\n+\t\t{\"past eol is high\", ltsAPI(t, \"go\"), \"2026-11-24\", []string{ref(\"go\", \"1.20.3\", \"Dockerfile\", 1, \"FROM golang:1.20.3\", false)}, map[string]string{\"eol:go:1.20\": \"high\"}, 0, false},\n+\t\t{\"supported is nothing\", ltsAPI(t, \"go\"), \"2026-11-24\", []string{ref(\"go\", \"1.27.4\", \"Dockerfile\", 1, \"FROM golang:1.27\", false)}, map[string]string{}, 0, false},\n+\t\t{\"floor only is capped\", ltsAPI(t, \"go\"), \"2026-11-24\", []string{ref(\"go\", \"1.20\", \"go.mod\", 3, \"go 1.20\", true)}, map[string]string{\"eol:go:1.20\": \"medium\"}, 0, false},\n+\t\t{\"floor plus runtime is not capped\", ltsAPI(t, \"go\"), \"2026-11-24\", []string{ref(\"go\", \"1.20\", \"go.mod\", 3, \"go 1.20\", true), ref(\"go\", \"1.20\", \"Dockerfile\", 1, \"FROM golang:1.20\", false)}, map[string]string{\"eol:go:1.20\": \"high\"}, 0, false},\n+\t\t{\"two cycles two findings\", ltsAPI(t, \"go\"), \"2026-11-24\", []string{ref(\"go\", \"1.20\", \"a/Dockerfile\", 1, \"FROM golang:1.20\", false), ref(\"go\", \"1.19\", \"b/Dockerfile\", 1, \"FROM golang:1.19\", false)}, map[string]string{\"eol:go:1.19\": \"high\", \"eol:go:1.20\": \"high\"}, 0, false},\n+\t\t{\"codename\", ltsAPI(t, \"ubuntu\"), \"2030-01-01\", []string{ref(\"ubuntu\", \"jammy\", \"Dockerfile\", 1, \"FROM ubuntu:jammy\", false)}, map[string]string{\"eol:ubuntu:22.04\": \"high\"}, 0, false},\n+\t\t{\"no cycle skips\", ltsAPI(t, \"go\"), \"2026-11-24\", []string{ref(\"go\", \"9.9\", \"Dockerfile\", 1, \"FROM golang:9.9\", false)}, map[string]string{}, 1, false},\n+\t\t{\"missing api product\", ltsAPI(t, \"go\"), \"2026-11-24\", []string{ref(\"nodejs\", \"18\", \"Dockerfile\", 1, \"FROM node:18\", false)}, nil, 0, true},\n+\t\t{\"isEol without date\", syn, \"2026-02-23\", []string{ref(\"syn\", \"1\", \"Dockerfile\", 1, \"x\", false)}, map[string]string{\"eol:syn:1\": \"high\"}, 0, false},\n+\t\t{\"due today\", syn, \"2026-02-23\", []string{ref(\"syn\", \"2\", \"Dockerfile\", 1, \"x\", false)}, map[string]string{\"eol:syn:2\": \"high\"}, 0, false},\n+\t\t{\"90 day boundary\", syn, \"2026-02-23\", []string{ref(\"syn\", \"3\", \"Dockerfile\", 1, \"x\", false)}, map[string]string{\"eol:syn:3\": \"medium\"}, 0, false},\n+\t\t{\"91 days is low\", syn, \"2026-02-23\", []string{ref(\"syn\", \"4\", \"Dockerfile\", 1, \"x\", false)}, map[string]string{\"eol:syn:4\": \"low\"}, 0, false},\n+\t\t{\"180 day boundary\", syn, \"2025-11-25\", []string{ref(\"syn\", \"3\", \"Dockerfile\", 1, \"x\", false)}, map[string]string{\"eol:syn:3\": \"low\"}, 0, false},\n+\t\t{\"beyond 180 days\", syn, \"2025-11-24\", []string{ref(\"syn\", \"3\", \"Dockerfile\", 1, \"x\", false)}, map[string]string{}, 0, false},\n+\t\t{\"no date not eol\", syn, \"2026-02-23\", []string{ref(\"syn\", \"5\", \"Dockerfile\", 1, \"x\", false)}, map[string]string{}, 0, false},\n+\t}\n+\tfor _, c := range cases {\n+\t\tt.Run(c.name, func(t *testing.T) {\n+\t\t\trefs := writeTemp(t, \"refs.jsonl\", strings.Join(c.refs, \"\\n\")+\"\\n\")\n+\t\t\tgot, err := ltsJQ(t, \"eol.jq\", \"--arg\", \"today\", c.today, \"--slurpfile\", \"refs\", refs, \"--slurpfile\", \"api\", c.api)\n+\t\t\tif c.errors {\n+\t\t\t\tif err == nil {\n+\t\t\t\t\tt.Fatal(\"want error\")\n+\t\t\t\t}\n+\t\t\t\treturn\n+\t\t\t}\n+\t\t\tif err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t\tfound, skips := map[string]string{}, 0\n+\t\t\tfor _, l := range got {\n+\t\t\t\tvar f struct{ Fingerprint, Severity, Group, Skip string }\n+\t\t\t\tif err := json.Unmarshal([]byte(l), &f); err != nil {\n+\t\t\t\t\tt.Fatal(err)\n+\t\t\t\t}\n+\t\t\t\tif f.Skip != \"\" {\n+\t\t\t\t\tskips++\n+\t\t\t\t} else {\n+\t\t\t\t\tfound[f.Fingerprint] = f.Severity\n+\t\t\t\t}\n+\t\t\t}\n+\t\t\tif len(found) != len(c.want) || skips != c.skips {\n+\t\t\t\tt.Fatalf(\"got %v (%d skips), want %v (%d skips)\", found, skips, c.want, c.skips)\n+\t\t\t}\n+\t\t\tfor k, v := range c.want {\n+\t\t\t\tif found[k] != v {\n+\t\t\t\t\tt.Errorf(\"%s: severity %q, want %q\", k, found[k], v)\n+\t\t\t\t}\n+\t\t\t}\n+\t\t})\n+\t}\n+\n+\tt.Run(\"one finding lists all files, title and shape\", func(t *testing.T) {\n+\t\trefs := writeTemp(t, \"refs.jsonl\", ref(\"go\", \"1.20\", \"b/go.mod\", 3, \"go 1.20\", true)+\"\\n\"+ref(\"go\", \"1.20.1\", \"a/Dockerfile\", 1, \"FROM golang:1.20.1\", false)+\"\\n\")\n+\t\tgot, err := ltsJQ(t, \"eol.jq\", \"--arg\", \"today\", \"2026-11-24\", \"--slurpfile\", \"refs\", refs, \"--slurpfile\", \"api\", ltsAPI(t, \"go\"))\n+\t\tif err != nil || len(got) != 1 {\n+\t\t\tt.Fatalf(\"%v %v\", got, err)\n+\t\t}\n+\t\tif !strings.HasPrefix(got[0], `{\"fingerprint\":\"eol:go:1.20\",\"title\":\"Go 1.20: end of life 2024-02-06\",\"severity\":\"high\",\"group\":\"go\",\"files\":[\"a/Dockerfile\",\"b/go.mod\"],\"body\":\"`) {\n+\t\t\tt.Errorf(\"unexpected: %s\", got[0])\n+\t\t}\n+\t\tf := decode(t, []byte(got[0]))\n+\t\tif !strings.Contains(f[0].Body, \"- `a/Dockerfile:1`: `FROM golang:1.20.1`\\n- `b/go.mod:3`: `go 1.20`\") {\n+\t\t\tt.Errorf(\"body: %s\", f[0].Body)\n+\t\t}\n+\t})\n+\tt.Run(\"hostile text is inert and refs are truncated\", func(t *testing.T) {\n+\t\tvar refs []string\n+\t\trefs = append(refs, ref(\"go\", \"1.20\", \"Dockerfile\", 1, \"FROM `x`\\n@evil <!-- \"+strings.Repeat(\"a\", 300), false))\n+\t\tfor i := 2; i <= 52; i++ {\n+\t\t\trefs = append(refs, ref(\"go\", \"1.20\", \"f\"+string(rune('a'+i%26))+strings.Repeat(\"z\", i)+\"/Dockerfile\", 1, \"FROM golang:1.20\", false))\n+\t\t}\n+\t\tin := writeTemp(t, \"refs.jsonl\", strings.Join(refs, \"\\n\")+\"\\n\")\n+\t\tgot, err := ltsJQ(t, \"eol.jq\", \"--arg\", \"today\", \"2026-11-24\", \"--slurpfile\", \"refs\", in, \"--slurpfile\", \"api\", ltsAPI(t, \"go\"))\n+\t\tif err != nil || len(got) != 1 {\n+\t\t\tt.Fatalf(\"%v %v\", got, err)\n+\t\t}\n+\t\tbody := decode(t, []byte(got[0]))[0].Body\n+\t\tif !strings.Contains(body, \"…and 2 more\") || strings.Count(body, \"\\n- `\") != 50 {\n+\t\t\tt.Errorf(\"not truncated: %d refs\", strings.Count(body, \"\\n- `\"))\n+\t\t}\n+\t\tif !strings.Contains(body, \"- `Dockerfile:1`: `FROM x @evil <!-- aaa\") || strings.Contains(body, strings.Repeat(\"a\", 201)) {\n+\t\t\tt.Errorf(\"hostile ref not neutralised: %.300s\", body)\n+\t\t}\n+\t})\n+}\n+\n+// ltsEnv is a hermetic scan environment: a fake curl serving the captured API\n+// fixtures, plus jq (and optionally yq) and the system's basic tools.\n+type ltsEnv struct {\n+\tbin, repo string\n+}\n+\n+func newLtsEnv(t *testing.T, withYq bool) *ltsEnv {\n+\tt.Helper()\n+\te := &ltsEnv{bin: t.TempDir(), repo: t.TempDir()}\n+\ttools := []string{\"jq\"}\n+\tif withYq {\n+\t\ttools = append(tools, \"yq\")\n+\t}\n+\tfor _, n := range tools {\n+\t\tp, err := exec.LookPath(n)\n+\t\tif err != nil {\n+\t\t\tt.Skipf(\"%s not available\", n)\n+\t\t}\n+\t\tif err := os.Symlink(p, filepath.Join(e.bin, n)); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\tapi, _ := filepath.Abs(filepath.Join(\"testdata\", \"lts\", \"api\"))\n+\tcurl := `#!/bin/sh\n+prev= out= url=\n+for a; do\n+  [ \"$prev\" = -o ] && out=$a\n+  prev=$a url=$a\n+done\n+[ -z \"${CURL_FAIL:-}\" ] || exit 7\n+p=${url##*/}\n+if [ \"$p\" = \"${CURL_404:-}\" ] || [ ! -f \"` + api + `/$p.json\" ]; then printf 404; exit 0; fi\n+cp \"` + api + `/$p.json\" \"$out\"\n+printf 200\n+`\n+\tif err := os.WriteFile(filepath.Join(e.bin, \"curl\"), []byte(curl), 0o755); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\treturn e\n+}\n+\n+func (e *ltsEnv) run(t *testing.T, files map[string]string, extra ...string) (string, string, int) {\n+\tt.Helper()\n+\tfor p, c := range files {\n+\t\tfull := filepath.Join(e.repo, p)\n+\t\tif err := os.MkdirAll(filepath.Dir(full), 0o755); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tif err := os.WriteFile(full, []byte(c), 0o644); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\tscan, _ := filepath.Abs(filepath.Join(\"scanners\", \"lts\", \"scan\"))\n+\tcmd := exec.Command(scan)\n+\tcmd.Dir = e.repo\n+\tcmd.Env = append([]string{\"PATH=\" + e.bin + \":/usr/bin:/bin\", \"HOME=/nonexistent\", \"TMPDIR=\" + t.TempDir(), \"LTS_TODAY=2026-11-24\"}, extra...)\n+\tvar so, se bytes.Buffer\n+\tcmd.Stdout, cmd.Stderr = &so, &se\n+\tcode := 0\n+\tif err := cmd.Run(); err != nil {\n+\t\tee, ok := err.(*exec.ExitError)\n+\t\tif !ok {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tcode = ee.ExitCode()\n+\t}\n+\treturn so.String(), se.String(), code\n+}\n+\n+func TestLtsScanHermetic(t *testing.T) {\n+\tneedTools(t, \"jq\")\n+\tt.Run(\"empty repo\", func(t *testing.T) {\n+\t\tout, _, code := newLtsEnv(t, false).run(t, nil)\n+\t\tif code != 0 || out != \"\" {\n+\t\t\tt.Errorf(\"code %d out %q\", code, out)\n+\t\t}\n+\t})\n+\tt.Run(\"mixed repo\", func(t *testing.T) {\n+\t\tout, _, code := newLtsEnv(t, false).run(t, map[string]string{\n+\t\t\t\"go.mod\":                        \"module x\\n\\ngo 1.20\\n\",\n+\t\t\t\"svc/Dockerfile\":                \"FROM node:16-alpine\\nFROM debian:bookworm\\n\",\n+\t\t\t\"testdata/old/Dockerfile\":       \"FROM python:2.7\\n\",\n+\t\t\t\"web/node_modules/x/Dockerfile\": \"FROM python:2.7\\n\",\n+\t\t})\n+\t\tif code != 0 {\n+\t\t\tt.Fatalf(\"code %d\", code)\n+\t\t}\n+\t\tgot := map[string]string{}\n+\t\tfor _, f := range decode(t, []byte(out)) {\n+\t\t\tgot[f.Fingerprint] = f.Severity\n+\t\t}\n+\t\twant := map[string]string{\"eol:go:1.20\": \"medium\", \"eol:nodejs:16\": \"high\"}\n+\t\tif len(got) != 2 || got[\"eol:go:1.20\"] != want[\"eol:go:1.20\"] || got[\"eol:nodejs:16\"] != want[\"eol:nodejs:16\"] {\n+\t\t\tt.Errorf(\"got %v, want %v\", got, want)\n+\t\t}\n+\t})\n+\tt.Run(\"helm values\", func(t *testing.T) {\n+\t\tout, _, code := newLtsEnv(t, true).run(t, map[string]string{\n+\t\t\t\"chart/Chart.yaml\":  \"name: c\\nversion: 1.0.0\\n\",\n+\t\t\t\"chart/values.yaml\": \"image:\\n  repository: redis\\n  tag: \\\"5.0.14\\\"\\n\",\n+\t\t})\n+\t\tfs := decode(t, []byte(out))\n+\t\tif code != 0 || len(fs) != 1 || fs[0].Fingerprint != \"eol:redis:5.0\" {\n+\t\t\tt.Errorf(\"code %d out %q\", code, out)\n+\t\t}\n+\t})\n+\tfailures := []struct {\n+\t\tname  string\n+\t\tfiles map[string]string\n+\t\textra []string\n+\t\tyq    bool\n+\t\tcode  int\n+\t}{\n+\t\t{\"mapped product 404\", map[string]string{\"Dockerfile\": \"FROM node:16\\n\"}, []string{\"CURL_404=nodejs\"}, false, 1},\n+\t\t{\"curl error\", map[string]string{\"Dockerfile\": \"FROM node:16\\n\"}, []string{\"CURL_FAIL=1\"}, false, 1},\n+\t\t{\"bad package.json\", map[string]string{\"package.json\": \"{nope\", \"Dockerfile\": \"FROM node:16\\n\"}, nil, false, 1},\n+\t\t{\"bad LTS_TODAY\", nil, []string{\"LTS_TODAY=tomorrow\"}, false, 1},\n+\t\t{\"Chart.yaml without yq\", map[string]string{\"c/Chart.yaml\": \"name: c\\n\"}, nil, false, 2},\n+\t}\n+\tfor _, c := range failures {\n+\t\tt.Run(c.name, func(t *testing.T) {\n+\t\t\tout, _, code := newLtsEnv(t, c.yq).run(t, c.files, c.extra...)\n+\t\t\tif code != c.code || out != \"\" {\n+\t\t\t\tt.Errorf(\"code %d (want %d), stdout %q\", code, c.code, out)\n+\t\t\t}\n+\t\t})\n+\t}\n+}\ndiff --git a/internal/roles/roles.go b/internal/roles/roles.go\nindex 3626f8a..b5167b8 100644\n--- a/internal/roles/roles.go\n+++ b/internal/roles/roles.go\n@@ -7,11 +7,11 @@ package roles\n import \"embed\"\n \n // FS is the starter .ard/ tree `ard init` proposes: config.yaml plus the role\n-// directories (scanners/cve, scanners/docs, scanners/error-codes, scanners/lint, scanners/missing-tests, scanners/trufflehog, triage/lead, triage/engineer, triage/product-manager, triage/architect, triage/designer, triage/documentation-planner, workers/engineer, reviewers/eng-review, reviewers/license-review, reviewers/product-manager-review and reviewers/security-review); paths are relative to .ard/.\n+// directories (scanners/cve, scanners/lts, scanners/docs, scanners/error-codes, scanners/lint, scanners/missing-tests, scanners/trufflehog, triage/lead, triage/engineer, triage/product-manager, triage/architect, triage/designer, triage/documentation-planner, workers/engineer, reviewers/eng-review, reviewers/license-review, reviewers/product-manager-review and reviewers/security-review); paths are relative to .ard/.\n //\n // scanners/missing-tests is left out until its scan driver exists; re-add it when wiring it in.\n //\n-//go:embed config.yaml reviewers scanners/cve scanners/docs scanners/error-codes scanners/lint scanners/missing-tests scanners/trufflehog triage workers\n+//go:embed config.yaml reviewers scanners/cve scanners/docs scanners/error-codes scanners/lint scanners/lts scanners/missing-tests scanners/trufflehog triage workers\n var FS embed.FS\n \n // ExecutableNames lists base names that must be written 0755.","numLines":681,"startLine":1,"totalLines":1174,"truncatedByTokenCap":true}},"tool_result_meta":[{"id":"toolu_01FkvJEHp7gRYKAFeaQGVaWC","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
