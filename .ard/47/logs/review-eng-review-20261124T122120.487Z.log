s/lint/normalize.jq\", \"scanners/lint/scan\", \"scanners/lts/Dockerfile\", \"scanners/lts/eol.jq\", \"scanners/lts/products.json\", \"scanners/lts/refs.jq\", \"scanners/lts/scan\", \"scanners/missing-tests/Dockerfile\", \"scanners/missing-tests/missingtests.go\", \"scanners/missing-tests/scan\", \"scanners/trufflehog/Dockerfile\", \"scanners/trufflehog/exclude-paths\", \"scanners/trufflehog/findings.jq\", \"scanners/trufflehog/scan\", \"triage/architect/prompt.txt\", \"triage/designer/prompt.txt\", \"triage/documentation-planner/prompt.txt\", \"triage/engineer/prompt.txt\", \"triage/lead/prompt.txt\", \"triage/product-manager/prompt.txt\", \"workers/engineer/prompt.txt\"}\n \tif strings.Join(got, \",\") != strings.Join(want, \",\") {\n \t\tt.Fatalf(\"embedded files = %v, want %v\", got, want)\n \t}\n@@ -43,7 +46,7 @@ func TestFSContents(t *testing.T) {\n // embed.FS reports 0444 for everything, so the exec bit must be checked on disk\n // to catch a mode lost in git.\n func TestScanIsExecutableOnDisk(t *testing.T) {\n-\tfor _, p := range []string{\"scanners/cve/scan\", \"scanners/docs/scan\", \"scanners/error-codes/scan\", \"scanners/lint/scan\", \"scanners/missing-tests/scan\", \"scanners/trufflehog/scan\"} {\n+\tfor _, p := range []string{\"scanners/cve/scan\", \"scanners/docs/scan\", \"scanners/error-codes/scan\", \"scanners/lint/scan\", \"scanners/lts/scan\", \"scanners/missing-tests/scan\", \"scanners/trufflehog/scan\"} {\n \t\tfi, err := os.Stat(p)\n \t\tif err != nil {\n \t\t\tt.Fatal(err)\n@@ -238,3 +241,64 @@ func TestEmbeddedMissingTestsRoleLoadsAsScanner(t *testing.T) {\n \t}\n \tt.Fatal(\"no scanner role missing-tests\")\n }\n+\n+func TestEmbeddedLtsRoleLoadsAsScanner(t *testing.T) {\n+\tres, err := config.LoadFS(starterFS(t, true), \"/repo\")\n+\tif err != nil {\n+\t\tt.Fatalf(\"LoadFS: %v\", err)\n+\t}\n+\tfor _, r := range res.Roles {\n+\t\tif r.Kind != config.KindScanner || r.Name != \"lts\" {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif r.ScanPath != \".ard/scanners/lts/scan\" || !r.Autoclose || r.Every != 7*24*time.Hour || r.MaxOpen != 5 || r.GroupSize != 1 {\n+\t\t\tt.Errorf(\"unexpected role: %+v\", r)\n+\t\t}\n+\t\tif r.Dockerfile != \".ard/scanners/lts/Dockerfile\" {\n+\t\t\tt.Errorf(\"Dockerfile = %q\", r.Dockerfile)\n+\t\t}\n+\t\tif !slices.Equal(r.Extra, []string{\"eol.jq\", \"products.json\", \"refs.jq\"}) {\n+\t\t\tt.Errorf(\"Extra = %v\", r.Extra)\n+\t\t}\n+\t\treturn\n+\t}\n+\tt.Fatal(\"no scanner role lts\")\n+}\n+\n+func TestLtsProductsJSON(t *testing.T) {\n+\tb, err := FS.ReadFile(\"scanners/lts/products.json\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tvar top map[string]map[string]string\n+\tif err := json.Unmarshal(b, &top); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif len(top) != 2 || top[\"images\"] == nil || top[\"npm\"] == nil {\n+\t\tt.Fatalf(\"want exactly the keys images and npm, got %v\", top)\n+\t}\n+\tslug := regexp.MustCompile(`^[a-z0-9][a-z0-9.-]{0,63}$`)\n+\tfor table, m := range top {\n+\t\tfor name, s := range m {\n+\t\t\tif !slug.MatchString(s) {\n+\t\t\t\tt.Errorf(\"%s[%q]: bad slug %q\", table, name, s)\n+\t\t\t}\n+\t\t}\n+\t}\n+\t// encoding/json keeps the last of a duplicated key: count the raw keys.\n+\tfor table, m := range top {\n+\t\tvar raw map[string]json.RawMessage\n+\t\t_ = json.Unmarshal(b, &raw)\n+\t\tdec := json.NewDecoder(bytes.NewReader(raw[table]))\n+\t\tn := 0\n+\t\tdec.Token()\n+\t\tfor dec.More() {\n+\t\t\tdec.Token()\n+\t\t\tdec.Token()\n+\t\t\tn++\n+\t\t}\n+\t\tif n != len(m) {\n+\t\t\tt.Errorf(\"%s: duplicate keys (%d entries, %d unique)\", table, n, len(m))\n+\t\t}\n+\t}\n+}\ndiff --git a/internal/roles/scanners/lts/Dockerfile b/internal/roles/scanners/lts/Dockerfile\nnew file mode 100644\nindex 0000000..5347392\n--- /dev/null\n+++ b/internal/roles/scanners/lts/Dockerfile\n@@ -0,0 +1,40 @@\n+# Pinned tool image for the lts scanner. Versions verified 2026-11-23:\n+#   jq 1.8.2 (same checksums as scanners/cve), yq v4.54.3 (mikefarah/yq,\n+#   published 2026-11-09). The yq checksums come from the release's own\n+#   checksums file; see internal/roles/testdata/lts/CAPTURE.md.\n+# The base image is the same pinned golang image as scanners/cve/Dockerfile, so\n+# layers are shared and curl, ca-certificates and sh are already there. It is\n+# pinned by multi-arch index digest; Docker ignores the tag when a digest is\n+# present; it is there for readers.\n+#\n+# The image does NOT copy `scan`: the executor mounts this role directory\n+# read-only, so the mounted script is always the one that runs.\n+# Run:  docker run --rm -v \"$PWD\":/repo:ro -v <role dir>:/role:ro -w /repo IMAGE /role/scan\n+\n+ARG GO_IMAGE=golang:1.27.4-trixie@sha256:f18c3d73a184fb0582828510722e723b63a93f7188d11dd223d9be6f6880e65d\n+\n+FROM ${GO_IMAGE} AS tools\n+ARG TARGETARCH\n+ARG JQ_VERSION=1.8.2\n+ARG JQ_SHA256_AMD64=b1c22172dd303f3be49e935aa56aa48a8b7a46e0bc838b4997d3bb451495870f\n+ARG JQ_SHA256_ARM64=8b85c817833814ddca00a144c33705546355afccf0cf39b188f3cdb48b852309\n+ARG YQ_VERSION=v4.54.3\n+ARG YQ_SHA256_AMD64=129534601871538efe0ba4c5e62a34fb1d5f469bcb975c4fddeb467d82974973\n+ARG YQ_SHA256_ARM64=89f69310b61b68d1245065a1241d1fc843f7a36cd6103ffd77ad987613bd1b67\n+RUN set -eu; \\\n+    case \"${TARGETARCH}\" in \\\n+      amd64) jq_sha=\"${JQ_SHA256_AMD64}\"; yq_sha=\"${YQ_SHA256_AMD64}\" ;; \\\n+      arm64) jq_sha=\"${JQ_SHA256_ARM64}\"; yq_sha=\"${YQ_SHA256_ARM64}\" ;; \\\n+      *) echo \"unsupported arch: ${TARGETARCH}\" >&2; exit 1 ;; \\\n+    esac; \\\n+    mkdir /out; \\\n+    curl -fsSL -o /out/jq \"https://github.com/jqlang/jq/releases/download/jq-${JQ_VERSION}/jq-linux-${TARGETARCH}\"; \\\n+    echo \"${jq_sha}  /out/jq\" | sha256sum -c -; \\\n+    curl -fsSL -o /out/yq \"https://github.com/mikefarah/yq/releases/download/${YQ_VERSION}/yq_linux_${TARGETARCH}\"; \\\n+    echo \"${yq_sha}  /out/yq\" | sha256sum -c -; \\\n+    chmod 0755 /out/jq /out/yq\n+\n+FROM ${GO_IMAGE}\n+COPY --from=tools /out/jq /usr/local/bin/jq\n+COPY --from=tools /out/yq /usr/local/bin/yq\n+ENV TMPDIR=/var/tmp\ndiff --git a/internal/roles/scanners/lts/eol.jq b/internal/roles/scanners/lts/eol.jq\nnew file mode 100644\nindex 0000000..7fc1070\n--- /dev/null\n+++ b/internal/roles/scanners/lts/eol.jq\n@@ -0,0 +1,64 @@\n+# eol.jq: version references plus endoflife.date data in, findings out.\n+#\n+# Run:  jq -c -n --arg today YYYY-MM-DD --slurpfile refs refs.jsonl \\\n+#         --slurpfile api api.json -f eol.jq\n+# $api is one JSON array of v1 API responses ({result: {name, label,\n+# releases[]}}). One finding per product and release cycle, sorted by\n+# fingerprint, then {skip: \"...\"} lines. Pure; valid on jq 1.6.\n+# Windows (days to end of life): <= 0 high, <= 90 medium, <= 180 low.\n+# A component whose references are all floors (lowest supported version, not\n+# what runs) is capped at medium. Untrusted text is cleaned and shown in code\n+# spans only.\n+\n+def clean: gsub(\"[\\\\x00-\\\\x1f\\\\x7f]\"; \" \") | gsub(\"`\"; \"\");\n+def days($d): (($d + \"T00:00:00Z\" | fromdate) - ($today + \"T00:00:00Z\" | fromdate)) / 86400;\n+def sevrank: if . == \"high\" then 3 elif . == \"medium\" then 2 else 1 end;\n+\n+($api[0] // []) as $apis\n+| ($apis | map({key: .result.name, value: .result}) | from_entries) as $by\n+| ($refs | map(select(.skip == null))) as $rs\n+| ( $rs | map(.product) | unique | map(\n+      if $by[.] == null or (($by[.].releases | type) != \"array\") then error(\"lts: no API data for product \" + .) else empty end) ) as $chk\n+| def match($rel; $v):\n+    ($v | ascii_downcase) as $lv\n+    | ([$rel[] | select((.codename // \"\") != \"\" and ((.codename | split(\" \")[0] | ascii_downcase) == $lv))] | .[0]) as $byname\n+    | if $byname != null then $byname else\n+        ($v | split(\".\")) as $p\n+        | first(range($p | length; 0; -1) as $n | ($p[0:$n] | join(\".\")) as $c | ($rel[] | select(.name == $c)) , empty) // null\n+      end;\n+  [ $rs[]\n+    | . as $r\n+    | ($by[$r.product].releases) as $rel\n+    | (match($rel; $r.version)) as $rl\n+    | if $rl == null then {skip: (\"no \" + $r.product + \" cycle for \" + $r.version + \" (\" + $r.path + \":\" + ($r.line | tostring) + \")\")}\n+      else {r: $r, rl: $rl} end ] as $m\n+| ($m | map(select(.skip != null))) as $skips\n+| ( $m | map(select(.skip == null)) | group_by([.r.product, .rl.name])\n+    | map(\n+        .[0].rl as $rl | .[0].r.product as $p | $by[$p] as $api1\n+        | (.[0].rl.name) as $cycle\n+        | ([.[].r] | sort_by([.path, .line, .ref])) as $refs1\n+        | (if $rl.eolFrom != null then days($rl.eolFrom) else null end) as $d\n+        | (if $d != null then (if $d <= 0 then \"high\" elif $d <= 90 then \"medium\" elif $d <= 180 then \"low\" else null end)\n+           elif $rl.isEol == true then \"high\" else null end) as $sev0\n+        | select($sev0 != null)\n+        | (if $sev0 == \"high\" and ($refs1 | all(.floor)) then \"medium\" else $sev0 end) as $sev\n+        | ($api1.label | clean) as $label\n+        | ($rl.eolFrom // \"no date\") as $eol\n+        | ($api1.releases | map(select(.isMaintained == true))) as $maint\n+        | (($maint | map(select(.isLts == true)) | .[0]) // $maint[0]) as $newest\n+        | ($refs1 | length) as $n\n+        | { fingerprint: (\"eol:\" + $p + \":\" + $cycle),\n+            title: ($label + \" \" + ($cycle | clean) + \": end of life \" + (if $rl.eolFrom != null then $eol else \"(no date)\" end)),\n+            severity: $sev,\n+            group: $p,\n+            files: ($refs1 | map(.path) | unique),\n+            body: ( \"End of life: \" + $eol + \" (endoflife.date: \" + $label + \" \" + ($cycle | clean) + \")\\n\"\n+                  + (if $rl.latest.name != null then \"Latest \" + ($cycle | clean) + \" release: \" + ($rl.latest.name | tostring | clean) + \"\\n\" else \"\" end)\n+                  + (if $newest != null then \"Newest maintained cycle: \" + ($newest.name | clean) + (if $newest.latest.name != null then \" (latest \" + ($newest.latest.name | tostring | clean) + \")\" else \"\" end) + \"\\n\" else \"\" end)\n+                  + \"Details: https://endoflife.date/\" + $p + \"\\n\\n\"\n+                  + \"References (from repository files; untrusted text):\\n\"\n+                  + ( $refs1[0:50] | map(\"- `\" + ((.path | clean) + (if .line > 0 then \":\" + (.line | tostring) else \"\" end)) + \"`: `\" + (.ref | clean | .[0:200]) + \"`\") | join(\"\\n\") )\n+                  + (if $n > 50 then \"\\n…and \" + (($n - 50) | tostring) + \" more\" else \"\" end) ) } )\n+    | sort_by(.fingerprint) ) as $out\n+| $out[], ($skips | map({skip: .skip}) | unique_by(.skip)[])\ndiff --git a/internal/roles/scanners/lts/products.json b/internal/roles/scanners/lts/products.json\nnew file mode 100644\nindex 0000000..8cd858d\n--- /dev/null\n+++ b/internal/roles/scanners/lts/products.json\n@@ -0,0 +1,25 @@\n+{\n+  \"images\": {\n+    \"golang\": \"go\",\n+    \"node\": \"nodejs\",\n+    \"python\": \"python\",\n+    \"alpine\": \"alpine-linux\",\n+    \"debian\": \"debian\",\n+    \"ubuntu\": \"ubuntu\",\n+    \"postgres\": \"postgresql\",\n+    \"redis\": \"redis\",\n+    \"nginx\": \"nginx\",\n+    \"mysql\": \"mysql\",\n+    \"mariadb\": \"mariadb\",\n+    \"ruby\": \"ruby\",\n+    \"php\": \"php\",\n+    \"eclipse-temurin\": \"eclipse-temurin\"\n+  },\n+  \"npm\": {\n+    \"@angular/core\": \"angular\",\n+    \"vue\": \"vue\",\n+    \"next\": \"nextjs\",\n+    \"nuxt\": \"nuxt\",\n+    \"electron\": \"electron\"\n+  }\n+}\ndiff --git a/internal/roles/scanners/lts/refs.jq b/internal/roles/scanners/lts/refs.jq\nnew file mode 100644\nindex 0000000..61f7f23\n--- /dev/null\n+++ b/internal/roles/scanners/lts/refs.jq\n@@ -0,0 +1,102 @@\n+# refs.jq: manifest records in, version references out.\n+#\n+# Run:  jq -c -n --slurpfile in inputs.jsonl --slurpfile map products.json -f refs.jq\n+# Input records: {kind: gomod|packagejson|dockerfile, path, text} or\n+# {kind: helmvalues, path, json}. Output lines: {produ