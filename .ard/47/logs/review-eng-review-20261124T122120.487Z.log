# Lowest lower bound of an npm-style range, or null.\n949\t+  def lowest:\n950\t+    [ split(\"||\")[] | split(\" \")[] | select(length > 0)\n951\t+      | select(startswith(\"<\") | not)\n952\t+      | sub(\"^[=>~^v]+\"; \"\") | select(test(\"^[0-9]\")) | lead ]\n953\t+    | if length == 0 then null else min_by(vkey) end;\n954\t+  def lineof($text; $needle):\n955\t+    ($text | lines | map(select(.s | contains($needle))) | .[0].n) // 1;\n956\t+  def image_ref($image; $tag; $path; $line; $ref):\n957\t+    ($image | sub(\"@sha256:.*$\"; \"\") | sub(\"^(index\\\\.)?docker\\\\.io/\"; \"\") | sub(\"^library/\"; \"\")) as $name\n958\t+    | if $m.images[$name] == null then {skip: (\"unmapped image \" + $name + \" (\" + $path + \")\")}\n959\t+      elif $tag == null or $tag == \"\" or $tag == \"latest\" or $tag == \"lts\" then\n960\t+        {skip: (\"unpinned tag for \" + $name + \" (\" + $path + \":\" + ($line | tostring) + \")\")}\n961\t+      else\n962\t+        (($tag | tostring) | (try lead catch null) // (split(\"-\")[0] | ascii_downcase)) as $v\n963\t+        | {product: $m.images[$name], version: $v, path: $path, line: $line, ref: $ref, floor: false}\n964\t+      end;\n965\t+  def split_image:\n966\t+    sub(\"@sha256:.*$\"; \"\")\n967\t+    | (capture(\"^(?<i>[^:]*(:[0-9]+/[^:]*)?):(?<t>[^:/]+)$\") // {i: ., t: null});\n968\t+\n969\t+  [ $in[]\n970\t+    | .path as $path\n971\t+    | if .kind == \"gomod\" then\n972\t+        (.text | lines) as $ls\n973\t+        | ($ls | map(select(.s | test(\"^toolchain[ \\t]+go[0-9]\")))) as $tc\n974\t+        | if ($tc | length) > 0 then\n975\t+            $tc[0] | {product: \"go\", version: (.s | sub(\"^toolchain[ \\t]+go\"; \"\") | lead), path: $path, line: .n,\n976\t+                      ref: .s, floor: false}\n977\t+          else\n978\t+            ($ls | map(select(.s | test(\"^go[ \\t]+[0-9]\"))))[0]\n979\t+            | select(. != null)\n980\t+            | {product: \"go\", version: (.s | sub(\"^go[ \\t]+\"; \"\") | lead), path: $path, line: .n, ref: .s, floor: true}\n981\t+          end\n982\t+      elif .kind == \"packagejson\" then\n983\t+        .text as $text\n984\t+        | (try ($text | fromjson) catch error(\"lts: cannot parse \" + $path)) as $j\n985\t+        | if ($j | type) != \"object\" then empty else\n986\t+            ( ($j.engines.node? // null) as $r\n987\t+              | if ($r | isstr) then\n988\t+                  ($r | lowest) as $v\n989\t+                  | if $v == null then {skip: (\"engines.node range not understood in \" + $path)}\n990\t+                    else {product: \"nodejs\", version: $v, path: $path, line: lineof($text; \"\\\"node\\\"\"),\n991\t+                          ref: (\"engines.node \" + $r), floor: true} end\n992\t+                else empty end),\n993\t+            ( [\"dependencies\", \"devDependencies\"][] as $sec\n994\t+              | ($j[$sec] // {}) | if type == \"object\" then to_entries[] else empty end\n995\t+              | select($m.npm[.key] != null and (.value | isstr))\n996\t+              | .key as $k | .value as $r\n997\t+              | ($r | lowest) as $v\n998\t+              | if $v == null then {skip: (\"npm range for \" + $k + \" not understood in \" + $path)}\n999\t+                else {product: $m.npm[$k], version: $v, path: $path, line: lineof($text; \"\\\"\" + $k + \"\\\"\"),\n1000\t+                      ref: ($k + \" \" + $r), floor: true} end )\n1001\t+          end\n1002\t+      elif .kind == \"dockerfile\" then\n1003\t+        (.text | lines) as $ls\n1004\t+        | ($ls | map(select(.s | test(\"^\\\\s*from\\\\s\"; \"i\"))) | .[0].n // 1000000000) as $first\n1005\t+        | (reduce ($ls[] | select(.n < $first and (.s | test(\"^\\\\s*arg\\\\s+[A-Za-z_][A-Za-z0-9_]*=\"; \"i\")))) as $l ({};\n1006\t+              ($l.s | sub(\"^\\\\s*[Aa][Rr][Gg]\\\\s+\"; \"\") | capture(\"^(?<k>[A-Za-z_][A-Za-z0-9_]*)=(?<v>.*)$\")) as $kv\n1007\t+              | .[$kv.k] = ($kv.v | sub(\"\\\\s+$\"; \"\") | sub(\"^\\\"(?<x>.*)\\\"$\"; .x) | sub(\"^'(?<x>.*)'$\"; .x)))) as $args\n1008\t+        | reduce ($ls[] | select(.s | test(\"^\\\\s*from\\\\s\"; \"i\"))) as $l ({stages: [], out: []};\n1009\t+            ($l.s | split(\" \") | map(select(length > 0))) as $t\n1010\t+            | ($t[1:] | map(select(startswith(\"--\") | not))) as $rest\n1011\t+            | ($rest[0] // \"\") as $raw\n1012\t+            | (reduce ($args | keys[]) as $k ($raw;\n1013\t+                gsub(\"\\\\$\\\\{\" + $k + \"(:-[^}]*)?\\\\}\"; $args[$k])\n1014\t+                | gsub(\"\\\\$\" + $k + \"(?![A-Za-z0-9_])\"; $args[$k]))\n1015\t+              | gsub(\"\\\\$\\\\{[A-Za-z_][A-Za-z0-9_]*:-(?<d>[^}]*)\\\\}\"; .d)) as $img\n1016\t+            | (if ($rest[1] // \"\" | ascii_downcase) == \"as\" then ($rest[2] // \"\" | ascii_downcase) else null end) as $stage\n1017\t+            | .out += [ if $img == \"\" or ($img | contains(\"$\")) then\n1018\t+                          {skip: (\"unresolved image \\\"\" + $raw + \"\\\" (\" + $path + \":\" + ($l.n | tostring) + \")\")}\n1019\t+                        elif $img == \"scratch\" or (.stages | index($img | ascii_downcase)) != null then empty\n1020\t+                        else\n1021\t+                          ($img | split_image) as $si\n1022\t+                          | image_ref($si.i; $si.t; $path; $l.n; ($l.s | sub(\"^\\\\s+\"; \"\") | sub(\"\\\\s+$\"; \"\")))\n1023\t+                        end ]\n1024\t+            | if $stage != null then .stages += [$stage] else . end)\n1025\t+        | .out[]\n1026\t+      elif .kind == \"helmvalues\" then\n1027\t+        ( .json | [.. | objects] | .[]\n1028\t+          | (select((.repository | isstr) and ((.tag | type) == \"string\" or (.tag | type) == \"number\"))\n1029\t+              | image_ref(.repository; (.tag | tostring); $path; 0; \"repository \" + .repository + \" tag \" + (.tag | tostring))),\n1030\t+            ( to_entries[] | select(.key == \"image\" and (.value | isstr) and (.value | contains(\":\")))\n1031\t+              | .value as $v | ($v | split_image) as $si\n1032\t+              | image_ref($si.i; $si.t; $path; 0; \"image \" + $v) ) )\n1033\t+      else empty end ]\n1034\t+| ( map(select(.skip == null)) | unique_by([.product, .version, .path, .line, .ref]) | sort_by([.product, .version, .path, .line]) ) as $refs\n1035\t+| ( map(select(.skip != null)) | unique_by(.skip) ) as $skips\n1036\t+| ($refs[], $skips[])\n1037\tdiff --git a/internal/roles/scanners/lts/scan b/internal/roles/scanners/lts/scan\n1038\tnew file mode 100755\n1039\tindex 0000000..8d3e724\n1040\t--- /dev/null\n1041\t+++ b/internal/roles/scanners/lts/scan\n1042\t@@ -0,0 +1,106 @@\n1043\t+#!/bin/sh\n1044\t+# lts scanner: components at or near end of life, as ard findings.\n1045\t+#\n1046\t+# Contract (see docs/proposal.md, Scanners):\n1047\t+#   - cwd is a read-only worktree of origin/main. This script finds its siblings\n1048\t+#     (refs.jq, eol.jq, products.json) from its own path, never from cwd.\n1049\t+#   - Prints findings as JSON lines on stdout, and only as its very last action:\n1050\t+#     any failure exits non-zero with nothing on stdout, and the controller\n1051\t+#     discards the run. It never prints partial results. This matters because\n1052\t+#     a finding that is absent closes its issue.\n1053\t+#   - Writes nothing outside a mktemp dir that is removed on exit. HOME may be\n1054\t+#     unwritable. It holds no GitHub token and needs none.\n1055\t+#   - stderr is the job log: tool versions, one line per skipped reference,\n1056\t+#     final count.\n1057\t+#\n1058\t+# Tools (pinned in ./Dockerfile): jq, curl, and yq only when a Chart.yaml\n1059\t+# exists. Network: https://endoflife.date/api/v1/products/<slug>, slugs from\n1060\t+# products.json only. Exit codes: 0 success, 1 failure, 2 a required tool is\n1061\t+# missing. LTS_TODAY=YYYY-MM-DD overrides today's date (for tests).\n1062\t+set -eu\n1063\t+\n1064\t+dir=$(CDPATH= cd -- \"$(dirname -- \"$0\")\" && pwd)\n1065\t+\n1066\t+die() { echo \"lts: $*\" >&2; exit 1; }\n1067\t+need() { command -v \"$1\" >/dev/null 2>&1 || { echo \"lts: $1 not found\" >&2; exit 2; }; }\n1068\t+\n1069\t+tmp=$(mktemp -d \"${TMPDIR:-/tmp}/ard-lts.XXXXXX\")\n1070\t+cleanup() { rm -rf \"$tmp\"; }\n1071\t+trap cleanup EXIT\n1072\t+trap 'exit 130' INT\n1073\t+trap 'exit 143' TERM\n1074\t+\n1075\t+today=${LTS_TODAY:-}\n1076\t+if [ -z \"$today\" ]; then today=$(date -u +%Y-%m-%d); fi\n1077\t+case $today in\n1078\t+  [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;\n1079\t+  *) die \"LTS_TODAY must be YYYY-MM-DD\" ;;\n1080\t+esac\n1081\t+\n1082\t+# 1. Manifests. Symlinks are not followed.\n1083\t+find . \\( -name .git -o -name vendor -o -name node_modules -o -name testdata \\) -prune \\\n1084\t+  -o -type f \\( -name go.mod -o -name package.json -o -name 'Dockerfile' -o -name 'Dockerfile.*' \\\n1085\t+  -o -name '*.Dockerfile' -o -name Containerfile -o -name Chart.yaml \\) -print > \"$tmp/files.raw\" \\\n1086\t+  || die \"find failed\"\n1087\t+LC_ALL=C sort \"$tmp/files.raw\" > \"$tmp/files.txt\"\n1088\t+\n1089\t+need jq\n1090\t+need curl\n1091\t+if grep -q '/Chart\\.yaml$' \"$tmp/files.txt\"; then need yq; fi\n1092\t+echo \"lts: $(jq --version 2>&1 | head -n 1)\" >&2\n1093\t+\n1094\t+# 2. inputs.jsonl, one record per manifest.\n1095\t+: > \"$tmp/inputs.jsonl\"\n1096\t+while IFS= read -r f; do\n1097\t+  p=${f#./}\n1098\t+  base=${p##*/}\n1099\t+  case $base in\n1100\t+    go.mod) kind=gomod ;;\n1101\t+    package.json) kind=packagejson ;;\n1102\t+    Chart.yaml)\n1103\t+      vals=$(dirname -- \"$p\")/values.yaml\n1104\t+      if [ -f \"$vals\" ]; then\n1105\t+        yq -o=json '.' \"$vals\" > \"$tmp/values.json\" 2>\"$tmp/yq.err\" || die \"cannot parse $vals: $(head -n 1 \"$tmp/yq.err\")\"\n1106\t+        jq -c -n --arg path \"$vals\" --slurpfile j \"$tmp/values.json\" \\\n1107\t+          '{kind: \"helmvalues\", path: $path, json: $j[0]}' >> \"$tmp/inputs.jsonl\" || die \"cannot read $vals\"\n1108\t+      fi\n1109\t+      continue ;;\n1110\t+    *) kind=dockerfile ;;\n1111\t+  esac\n1112\t+  jq -c -R -s --arg kind \"$kind\" --arg path \"$p\" '{kind: $kind, path: $path, text: .}' \"$p\" \\\n1113\t+    >> \"$tmp/inputs.jsonl\" || die \"cannot read $p\"\n1114\t+done < \"$tmp/files.txt\"\n1115\t+\n1116\t+# 3. References.\n1117\t+jq -c -n --slurpfile in \"$tmp/inputs.jsonl\" --slurpfile map \"$dir/products.json\" \\\n1118\t+  -f \"$dir/refs.jq\" > \"$tmp/refs.jsonl\" || die \"cannot extract references\"\n1119\t+\n1120\t+# 4. One API request per distinct product.\n1121\t+mkdir \"$tmp/api\"\n1122\t+jq -r 'select(.product != null) | .product' \"$tmp/refs.jsonl\" | LC_ALL=C sort -u > \"$tmp/products.txt\"\n1123\t+while IFS= read -r prod; do\n1124\t+  case $prod in\n1125\t+    \"\"|-*|.*|*[!a-z0-9.-]*) die \"invalid product slug \\\"$prod\\\"\" ;;\n1126\t+  esac\n1127\t+  [ ${#prod} -le 64 ] || die \"invalid product slug \\\"$prod\\\"\"\n1128\t+  code=$(curl --proto =https --tlsv1.2 -sS --max-time 30 --retry 2 --max-filesize 10M \\\n1129\t+    -A ard-lts-scanner -o \"$tmp/api/$prod.json\" -w '%{http_code}' \\\n1130\t+    \"https://endoflife.date/api/v1/products/$prod\") || die \"request for $prod failed\"\n1131\t+  [ \"$code\" = 200 ] || die \"endoflife.date answered $code for $prod (is products.json stale?)\"\n1132\t+done < \"$tmp/products.txt\"\n1133\t+\n1134\t+# 5. Findings.\n1135\t+if [ -s \"$tmp/products.txt\" ]; then\n1136\t+  jq -s '.' \"$tmp/api\"/*.json > \"$tmp/api.json\" || die \"an API response is not JSON\"\n1137\t+else\n1138\t+  echo '[]' > \"$tmp/api.json\"\n1139\t+fi\n1140\t+jq -c -n --arg today \"$today\" --slurpfile refs \"$tmp/refs.jsonl\" --slurpfile api \"$tmp/api.json\" \\\n1141\t+  -f \"$dir/eol.jq\" > \"$tmp/eol.jsonl\" || die \"cannot evaluate end of life data\"\n1142\t+\n1143\t+jq -r 'select(.skip != null) | \"lts: \" + .skip' \"$tmp/eol.jsonl\" >&2 || die \"split failed\"\n1144\t+jq -r 'select(.skip != null) | \"lts: \" + .skip' \"$tmp/refs.jsonl\" >&2 || die \"split failed\"\n1145\t+jq -c 'select(.fingerprint != null)' \"$tmp/eol.jsonl\" > \"$tmp/out.jsonl\" || die \"split failed\"\n1146\t+\n1147\t+echo \"lts: $(wc -l < \"$tmp/out.jsonl\" | tr -d ' ') finding(s)\" >&2\n1148\t+cat \"$tmp/out.jsonl\"\n1149\tdiff --git a/internal/roles/testdata/lts/regen.sh b/internal/roles/testdata/lts/regen.sh\n1150\tnew file mode 100644\n1151\tindex 0000000..a64620d\n1152\t--- /dev/null\n1153\t+++ b/internal/roles/testdata/lts/regen.sh\n1154\t@@ -0,0 +1,19 @@\n1155\t+#!/bin/sh\n1156\t+# Regenerates the real endoflife.date fixtures in api/ (go, nodejs, python,\n1157\t+# debian, ubuntu, alpine-linux, redis, nginx, angular). Run it inside the pinned\n1158\t+# lts image:\n1159\t+#\n1160\t+#   make lts-fixtures        # from the repo root; needs Docker and network\n1161\t+#\n1162\t+# Each response is stored as `jq .` output with no other change. The hand-written\n1163\t+# api/synthetic.json is not used (lts_test.go embeds its synthetic product) and\n1164\t+# is never touched. Review every diff by hand: the golden tests in lts_test.go\n1165\t+# use these files, and a changed capture can change their results.\n1166\t+set -eu\n1167\t+\n1168\t+here=$(CDPATH= cd -- \"$(dirname -- \"$0\")\" && pwd)\n1169\t+for p in go nodejs python debian ubuntu alpine-linux redis nginx angular; do\n1170\t+  curl --proto =https --tlsv1.2 -sS --max-time 30 --retry 2 -f -A ard-lts-scanner \\\n1171\t+    \"https://endoflife.date/api/v1/products/$p\" | jq . > \"$here/api/$p.json.new\"\n1172\t+  mv \"$here/api/$p.json.new\" \"$here/api/$p.json\"\n1173\t+done\n1174\t"}]},"parent_tool_use_id":null,"session_id":"0b6d0ee8-726d-4863-b8ba-febe7d964556","uuid":"8d28870d-b0a3-4b84-88bd-2848a0adc1b5","timestamp":"2026-11-24T12:21:24.796Z","tool_use_result":{"type":"text","file":{"filePath":"/work/.ard-input/47/diff.patch","content":"diff --git a/internal/roles/roles_test.go b/internal/roles/roles_test.go\nindex c9a60f9..061fc53 100644\n--- a/internal/role