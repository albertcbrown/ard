 holding either an executable\n \n **The pre-filing guard cannot be turned off.** After every scan and before the diff, in dry-run too and even with zero findings, the controller scans the title, fingerprint, group, files and body of every finding with the builtin pattern scanner and the controller's known secret values, plus gitleaks when `redact.gitleaks.enabled`. A hit, a builtin-pass failure or an invalid line changes nothing: no issue is filed, joined, edited, ticked or closed, no finding row is written from the run's findings (reconcile and the dry-run ledger adoption, which read GitHub and the ledger, still run before the scan), and the run is recorded as `scan_failed`. When gitleaks is enabled but cannot run, nothing is filed, joined or edited, but autoclose of already-filed issues still proceeds (an issue is ticked only when it closes) unless `redact.gitleaks.block_autoclose_when_missing: true`; the run is still `scan_failed`. Logs name only the rule and the field of a hit (known values by env var name); a pass failure also logs its error. A shutdown during the guard records no run.\n \n+**LLM scanners (`prompt.txt`) file under extra rules.** `autoclose: true` on one is a config error: an LLM scanner never closes an issue for absence. `every` defaults to at least 24h and a value below 24h is an error; `max_budget_usd`, when set, must be above 0. An LLM fingerprint is `rule:path` or `rule:path:symbol` (rule `[a-z0-9][a-z0-9-]{0,63}`, a clean relative path without `..` that is also listed in the finding's `files` and exists, symbol `[A-Za-z_][A-Za-z0-9_./-]{0,127}`); a bad fingerprint is reported by finding index only, never by content. Before grouping, a finding whose title is a near-duplicate of an open issue's title or checklist line, or of a more severe finding in the same run, is skipped without a ledger row, so it is offered again next run. Titles are lowercased, reduced to `[a-z0-9]` tokens, minus one-character tokens and a short stop list; they match when the token sets are equal, or when both have at least three tokens and their Jaccard similarity is at least 0.8. An issue filed by a scanner whose route is not `pending` ends with a footer explaining that a human adds `ard:pending` to send it to triage or closes it as not planned to dismiss it. The stale closer also considers an open issue whose only `ard:` label is its scanner label (route `none`). The engine that runs `prompt.txt` scanners is not wired in yet.\n+\n **Route.** The scanner key `route` decides where its issues go: `pending` (default for executable scanners) files with `ard:pending`, so they enter triage; `none` (default for LLM scanners) files with the scanner label only, and a human adds `ard:pending` to send one issue to triage; `needs-human` files with `ard:needs-human` and no `ard:pending`, so no agent triages them. LLM scanners may not use `pending`. Changing `route` affects only new issues. A human promotes one issue by removing `ard:needs-human` and/or adding `ard:pending`; after that ard never joins findings onto it.\n \n **Each run, in order:**\ndiff --git a/internal/config/load.go b/internal/config/load.go\nindex 0e9306c..0a10eb2 100644\n--- a/internal/config/load.go\n+++ b/internal/config/load.go\n@@ -82,6 +82,9 @@ var kindOverrideKeys = map[Kind]map[string]bool{\n // applyOverrides merges the global role defaults and each overrides entry\n // into the discovered roles, and cross-references role names and sidecar\n // keys against what actually exists.\n+// minLLMScannerEvery is the shortest interval for an LLM scanner.\n+const minLLMScannerEvery = 24 * time.Hour\n+\n func applyOverrides(res *Resolved, raw rawConfig, discovered []Role, cfgPath string) Errors {\n \tvar errs Errors\n \n@@ -123,6 +126,18 @@ func applyOverrides(res *Resolved, raw rawConfig, discovered []Role, cfgPath str\n \t\tapplyOverride(res, &roles[idx], ov, keyRef, cfgPath, triageNames, reviewerNames, &errs)\n \t}\n \n+\t// An LLM scanner spends money on every run, so its budget and interval\n+\t// must be set explicitly.\n+\tfor i := range roles {\n+\t\tif !roles[i].LLMScanner() {\n+\t\t\tcontinue\n+\t\t}\n+\t\tkeyRef := overrideKeyRef(\"scanners/\" + roles[i].Name)\n+\t\tif roles[i].Every < minLLMScannerEvery {\n+\t\t\terrs = append(errs, &Error{File: cfgPath, Key: keyRef + \".every\", Msg: \"an LLM scanner needs every of at least 24h (each run spends money)\"})\n+\t\t}\n+\t}\n+\n \t// Each plan.md section has one owner.\n \towner := map[string]string{}\n \tfor _, r := range roles {\n@@ -178,6 +193,9 @@ func applyRoleDefaults(res *Resolved, role *Role) {\n \tswitch role.Kind {\n \tcase KindScanner:\n \t\trole.Every = time.Duration(res.Intervals.Scanners)\n+\t\tif role.LLMScanner() && role.Every < minLLMScannerEvery {\n+\t\t\trole.Every = minLLMScannerEvery\n+\t\t}\n \t\trole.MaxOpen = defaultScannerMaxOpen\n \t\trole.GroupSize = defaultScannerGroupSize\n \t\trole.Autoclose = role.ScanPath != \"\"\n@@ -374,6 +392,9 @@ func applyOverride(res *Resolved, role *Role, ov rawOverride, keyRef, cfgPath st\n \t\trole.Timeout = time.Duration(*ov.timeout)\n \t}\n \tif ov.maxBudgetUSD != nil {\n+\t\tif *ov.maxBudgetUSD <= 0 && role.LLMScanner() {\n+\t\t\t*errs = append(*errs, &Error{File: cfgPath, Key: keyRef + \".max_budget_usd\", Msg: \"an LLM scanner needs max_budget_usd greater than 0\"})\n+\t\t}\n \t\trole.MaxBudgetUSD = *ov.maxBudgetUSD\n \t}\n \tif ov.budgetPerDay != nil {\n@@ -392,6 +413,9 @@ func applyOverride(res *Resolved, role *Role, ov rawOverride, keyRef, cfgPath st\n \t\trole.GroupSize = *ov.groupSize\n \t}\n \tif ov.autoclose != nil {\n+\t\tif *ov.autoclose && role.LLMScanner() {\n+\t\t\t*errs = append(*errs, &Error{File: cfgPath, Key: keyRef + \".autoclose\", Msg: \"an LLM scanner never closes an issue for absence; autoclose is valid only for a scanner with a scan executable\"})\n+\t\t}\n \t\trole.Autoclose = *ov.autoclose\n \t}\n \tif ov.route != nil {\ndiff --git a/internal/config/load_test.go b/internal/config/load_test.go\nindex dee3fa9..52f9922 100644\n--- a/internal/config/load_test.go\n+++ b/internal/config/load_test.go\n@@ -283,9 +283,9 @@ overrides:\n \t}\n \n \tlint, _ := res.Role(KindScanner, \"lint\")\n-\t// every inherits intervals.scanners; timeout, model and budgets come from the override.\n-\tif lint.Every != 6*time.Hour {\n-\t\tt.Errorf(\"lint every = %s, want 6h inherited from intervals.scanners\", lint.Every)\n+\t// every is raised to the 24h LLM scanner floor; timeout, model and budgets come from the override.\n+\tif lint.Every != 24*time.Hour {\n+\t\tt.Errorf(\"lint every = %s, want the 24h LLM scanner floor\", lint.Every)\n \t}\n \tif lint.Timeout != time.Hour || lint.Model != \"claude-opus-5-5\" || lint.MaxBudgetUSD != 2 || lint.BudgetUSDPerDay != 7 {\n \t\tt.Errorf(\"lint override = timeout %s model %q max_budget %g budget/day %g\",\n@@ -905,3 +905,41 @@ func TestLoadWhenEmptyRejected(t *testing.T) {\n \t\tt.Errorf(\"when: null = %+v, want nil\", r.When)\n \t}\n }\n+\n+func TestLLMScannerRules(t *testing.T) {\n+\tres := mustLoad(t, baseFS())\n+\tlint, _ := res.Role(KindScanner, \"lint\")\n+\tcve, _ := res.Role(KindScanner, \"cve\")\n+\tlead, _ := res.Role(KindTriage, \"lead\")\n+\tif !lint.LLMScanner() || cve.LLMScanner() || lead.LLMScanner() {\n+\t\tt.Errorf(\"LLMScanner: lint %v cve %v lead %v\", lint.LLMScanner(), cve.LLMScanner(), lead.LLMScanner())\n+\t}\n+\tif lint.Autoclose {\n+\t\tt.Error(\"LLM scanner autoclose defaults to true, want false\")\n+\t}\n+\n+\tok := []string{\n+\t\t\"overrides: {scanners/lint: {autoclose: false}}\\n\",\n+\t\t\"overrides: {scanners/cve: {autoclose: true}}\\n\",\n+\t\t\"overrides: {scanners/lint: {max_budget_usd: 2, every: 72h}}\\n\",\n+\t\t\"overrides: {scanners/lint: {every: 24h}}\\n\",\n+\t}\n+\tfor _, y := range ok {\n+\t\tmustLoad(t, withConfig(t, y))\n+\t}\n+\tbad := []struct{ name, yaml, key, msg string }{\n+\t\t{\"autoclose\", \"overrides: {scanners/lint: {autoclose: true}}\\n\", `overrides[\"scanners/lint\"].autoclose`, \"never closes an issue for absence\"},\n+\t\t{\"every\", \"overrides: {scanners/lint: {every: 12h}}\\n\", `overrides[\"scanners/lint\"].every`, \"at least 24h\"},\n+\t\t{\"budget\", \"overrides: {scanners/lint: {max_budget_usd: 0}}\\n\", `overrides[\"scanners/lint\"].max_budget_usd`, \"greater than 0\"},\n+\t}\n+\tfor _, tt := range bad {\n+\t\tt.Run(tt.name, func(t *testing.T) {\n+\t\t\tfor _, e := range loadErrs(t, withConfig(t, tt.yaml)) {\n+\t\t\t\tif e.Key == tt.key && strings.Contains(e.Msg, tt.msg) {\n+\t\t\t\t\treturn\n+\t\t\t\t}\n+\t\t\t}\n+\t\t\tt.Errorf(\"no error on %s containing %q\", tt.key, tt.msg)\n+\t\t})\n+\t}\n+}\ndiff --git a/internal/config/testdata/resolved.golden b/internal/config/testdata/resolved.golden\nindex e128a56..99a920e 100644\n--- a/internal/config/testdata/resolved.golden\n+++ b/internal/config/testdata/resolved.golden\n@@ -49,7 +49,7 @@ roles:\n     prompt: .ard/scanners/lint/prompt.txt\n     agent: kimi\n     timeout: 30m\n-    every: 6h\n+    every: 1d\n     max_open: 5\n     group_size: 10\n     route: none\ndiff --git a/internal/config/types.go b/internal/config/types.go\nindex ffc7f10..486cfbc 100644\n--- a/internal/config/types.go\n+++ b/internal/config/types.go\n@@ -161,7 +161,11 @@ type Role struct {\n // bodies, comments, PR text, diffs): every triage, worker and reviewer role,\n // and an LLM scanner. Only a deterministic scanner (an executable `scan`)\n // does not. A scanner without ScanPath counts as LLM, so the check fails closed.\n-func (r Role) ReadsUntrusted() bool { return r.Kind != KindScanner || r.ScanPath == \"\" }\n+func (r Role) ReadsUntrusted() bool { return r.Kind != KindScanner || r.LLMScanner() }\n+\n+// LLMScanner reports whether the role is a scanner run by an agent from\n+// prompt.txt rather than by a scan executable.\n+func (r Role) LLMScanner() bool { return r.Kind == KindScanner && r.ScanPath == \"\" }\n \n // Resolved is the fully merged configuration: built-in defaults, then the\n // global config, then per-role overrides.\ndiff --git a/internal/scanner/footer_test.go b/internal/scanner/footer_test.go\nnew file mode 100644\nindex 0000000..8e90ff0\n--- /dev/null\n+++ b/internal/scanner/footer_test.go\n@@ -0,0 +1,33 @@\n+package scanner\n+\n+import (\n+\t\"strings\"\n+\t\"testing\"\n+\n+\t\"github.com/albertcbrown/ard/internal/config\"\n+)\n+\n+func TestCreateBodyFooter(t *testing.T) {\n+\tparsed := Parsed{Scanner: \"arch\", HasSpan: true, Lines: []Line{lineFor(Item{F: finding(\"r:a.go\", \"t one two\", SevLow, \"\")})}}\n+\tfs := []Finding{finding(\"r:a.go\", \"t one two\", SevLow, \"\")}\n+\tfor _, tt := range []struct {\n+\t\troute config.Route\n+\t\twant  bool\n+\t}{{config.RoutePending, false}, {config.RouteNone, true}, {config.RouteNeedsHuman, true}, {config.Route(\"odd\"), true}} {\n+\t\tbody := createBody(config.Role{Route: tt.route}, parsed, fs)\n+\t\tif got := strings.Contains(body, llmFooter); got != tt.want {\n+\t\t\tt.Errorf(\"route %q: footer = %v, want %v\", tt.route, got, tt.want)\n+\t\t}\n+\t\tif tt.want && !strings.HasSuffix(body, llmFooter+\"\\n\") {\n+\t\t\tt.Errorf(\"route %q: footer is not last\", tt.route)\n+\t\t}\n+\t}\n+\t// A join re-renders with the existing body and must keep one footer.\n+\tbody := createBody(config.Role{Route: config.RouteNone}, parsed, fs)\n+\tp2 := parsed\n+\tp2.Lines = append(append([]Line(nil), parsed.Lines...), lineFor(Item{F: finding(\"r:b.go\", \"u three four\", SevLow, \"\")}))\n+\tjoined := RenderBody(body, p2, []Finding{finding(\"r:b.go\", \"u three four\", SevLow, \"\")})\n+\tif n := strings.Count(joined, llmFooter); n != 1 {\n+\t\tt.Errorf(\"footer count after join = %d\", n)\n+\t}\n+}\ndiff --git a/internal/scanner/llm.go b/internal/scanner/llm.go\nnew file mode 100644\nindex 0000000..27f7852\n--- /dev/null\n+++ b/internal/scanner/llm.go\n@@ -0,0 +1,100 @@\n+package scanner\n+\n+import (\n+\t\"fmt\"\n+\t\"path\"\n+\t\"regexp\"\n+\t\"strings\"\n+)\n+\n+var (\n+\tllmRuleRe   = regexp.MustCompile(`^[a-z0-9][a-z0-9-]{0,63}$`)\n+\tllmPathRe   = regexp.MustCompile(`^[A-Za-z0-9._/@+-]+$`)\n+\tllmSymbolRe = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_./-]{0,127}$`)\n+)\n+\n+// ParseLLMFingerprint splits an LLM scanner fingerprint, \"rule:path\" or\n+// \"rule:path:symbol\", and reports whether it is well formed. The path must\n+// be a clean, relative, repo-style path without \"..\" segments.\n+func ParseLLMFingerprint(fp string) (rule, p, symbol string, ok bool) {\n+\tif len(fp) > MaxFingerprint {\n+\t\treturn \"\", \"\", \"\", false\n+\t}\n+\tparts := strings.Split(fp, \":\")\n+\tif len(parts) < 2 || len(parts) > 3 {\n+\t\treturn \"\", \"\", \"\", false\n+\t}\n+\trule, p = parts[0], parts[1]\n+\tif len(parts) == 3 {\n+\t\tsymbol = parts[2]\n+\t\tif !llmSymbolRe.MatchString(symbol) {\n+\t\t\treturn \"\", \"\", \"\", false\n+\t\t}\n+\t}\n+\tif !llmRuleRe.MatchString(rule) || !llmPathRe.MatchString(p) {\n+\t\treturn \"\", \"\", \"\", false\n+\t}\n+\tif p == \".\" || strings.HasPrefix(p, \"/\") || path.Clean(p) != p {\n+\t\treturn \"\", \"\", \"\", false\n+\t}\n+\tfor _, seg := range strings.Split(p, \"/\") {\n+\t\tif seg == \"..\" {\n+\t\t\treturn \"\", \"\", \"\", false\n+\t\t}\n+\t}\n+\treturn rule, p, symbol, true\n+}\n+\n+// CheckLLMFingerprints validates every finding's fingerprint against the LLM\n+// grammar, requires its path to be listed in the finding's Files and, via\n+// exists, to be present in the repository. A nil exists treats every path as\n+// present. Errors carry the 1-based finding index and fixed text only, never\n+// the fingerprint or any finding text; at most 20 are returned.\n+func CheckLLMFingerprints(fs []Finding, exists func(path string) bool) DecodeErrors {\n+\tvar errs DecodeErrors\n+\tfail := func(i int, msg string) {\n+\t\tif len(errs) < maxErrorLines {\n+\t\t\terrs = append(errs, DecodeError{Line: i + 1, Msg: msg})\n+\t\t}\n+\t}\n+\tfor i, f := range fs {\n+\t\t_, p, _, ok := ParseLLMFingerprint(f.Fingerprint)\n+\t\tif !ok {\n+\t\t\tfail(i, \"fingerprint is not rule:path[:symbol]\")\n+\t\t\tcontinue\n+\t\t}\n+\t\tlisted := false\n+\t\tfor _, file := range f.Files {\n+\t\t\tif file == p {\n+\t\t\t\tlisted = true\n+\t\t\t\tbreak\n+\t\t\t}\n+\t\t}\n+\t\tif !listed {\n+\t\t\tfail(i, \"fingerprint path is not in files\")\n+\t\t\tcontinue\n+\t\t}\n+\t\tif exists != nil && !exists(p) {\n+\t\t\tfail(i, \"fingerprint path does not exist\")\n+\t\t}\n+\t}\n+\treturn errs\n+}\n+\n+// LLMGrammarLines summarises errors as \"invalid findings at lines 3, 7 (and\n+// N more)\", for logs. It contains line numbers only.\n+func LLMGrammarLines(errs DecodeErrors) string {\n+\tconst show = 5\n+\tvar nums []string\n+\tfor i, e := range errs {\n+\t\tif i == show {\n+\t\t\tbreak\n+\t\t}\n+\t\tnums = append(nums, fmt.Sprint(e.Line))\n+\t}\n+\ts := \"invalid findings at lines \" + strings.Join(nums, \", \")\n+\tif len(errs) > show {\n+\t\ts += fmt.Sprintf(\" (and %d more)\", len(errs)-show)\n+\t}\n+\treturn s\n+}\ndiff --git a/internal/scanner/llm_test.go b/internal/scanner/llm_test.go\nnew file mode 100644\nindex 0000000..048c7f4\n--- /dev/null\n+++ b/internal/scanner/llm_test.go\n@@ -0,0 +1,59 @@\n+package scanner\n+\n+import (\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+func TestParseLLMFingerprint(t *testing.T) {\n+\tlong := \"r:\" + strings.Repeat(\"a\", 600)\n+\tgood := []string{\"adr-0007:internal/foo/bar.go:Server.Start\", \"invariant-3:internal/committer\", \"r:a.go\"}\n+\tfor _, fp := range good {\n+\t\tif _, _, _, ok := ParseLLMFingerprint(fp); !ok {\n+\t\t\tt.Errorf(\"%q rejected\", fp)\n+\t\t}\n+\t}\n+\tbad := []string{\"a b:x.go\", \"Rule:x.go\", \"r:../x\", \"r:/x\", \"r:a/../b\", \"r:.\", \"r:a//b\", \"r:x.go:1abc\", \"r::x\", \"r:x.go:\", \":x.go\",\n+\t\t\"r:x.go:a:b\", \"r:x y.go\", \"r\", long, \"\"}\n+\tfor _, fp := range bad {\n+\t\tif _, _, _, ok := ParseLLMFingerprint(fp); ok {\n+\t\t\tt.Errorf(\"%q accepted\", fp)\n+\t\t}\n+\t}\n+\tr, p, s, _ := ParseLLMFingerprint(\"adr-1:a/b.go:T.m\")\n+\tif r != \"adr-1\" || p != \"a/b.go\" || s != \"T.m\" {\n+\t\tt.Errorf(\"parts = %q %q %q\", r, p, s)\n+\t}\n+}\n+\n+func TestCheckLLMFingerprints(t *testing.T) {\n+\tsecret := \"Secret Fingerprint\"\n+\tfs := []Finding{\n+\t\t{Fingerprint: \"r:a.go\", Files: []string{\"a.go\"}},\n+\t\t{Fingerprint: secret, Files: []string{\"a.go\"}},\n+\t\t{Fingerprint: \"r:b.go\", Files: []string{\"a.go\"}},\n+\t\t{Fingerprint: \"r:gone.go\", Files: []string{\"gone.go\"}},\n+\t}\n+\terrs := CheckLLMFingerprints(fs, func(p string) bool { return p != \"gone.go\" })\n+\tif len(errs) != 3 || errs[0].Line != 2 || errs[1].Line != 3 || errs[2].Line != 4 {\n+\t\tt.Fatalf(\"errs = %v\", errs)\n+\t}\n+\tfor _, e := range errs {\n+\t\tif strings.Contains(e.Msg, \"Secret\") || strings.Contains(e.Msg, \".go\") {\n+\t\t\tt.Errorf(\"msg leaks content: %q\", e.Msg)\n+\t\t}\n+\t}\n+\tif len(CheckLLMFingerprints(fs[:1], nil)) != 0 {\n+\t\tt.Error(\"nil exists must treat paths as present\")\n+\t}\n+\tmany := make([]Finding, 30)\n+\tif n := len(CheckLLMFingerprints(many, nil)); n != 20 {\n+\t\tt.Errorf(\"errors = %d, want 20\", n)\n+\t}\n+\tif got := LLMGrammarLines(DecodeErrors{{Line: 3}, {Line: 7}}); got != \"invalid findings at lines 3, 7\" {\n+\t\tt.Errorf(\"got %q\", got)\n+\t}\n+\tif got := LLMGrammarLines(CheckLLMFingerprints(many, nil)); got != \"invalid findings at lines 1, 2, 3, 4, 5 (and 15 more)\" {\n+\t\tt.Errorf(\"got %q\", got)\n+\t}\n+}\ndiff --git a/internal/scanner/neardup.go b/internal/scanner/neardup.go\nnew file mode 100644\nindex 0000000..ea0becb\n--- /dev/null\n+++ b/internal/scanner/neardup.go\n@@ -0,0 +1,106 @@\n+package scanner\n+\n+import (\n+\t\"sort\"\n+\t\"strings\"\n+)\n+\n+// NearDupThreshold is the Jaccard similarity at which two titles with at\n+// least three tokens each are near-duplicates.\n+const NearDupThreshold = 0.8\n+\n+// TitledIssue is an open issue with every title it carries (its own and its\n+// checklist lines').\n+type TitledIssue struct {\n+\tNumber int\n+\tTitles []string\n+}\n+\n+// NearDup records a skipped finding and the open issue (or, when Issue is 0,\n+// an earlier finding of the same run) it duplicates.\n+type NearDup struct {\n+\tFingerprint string\n+\tIssue       int\n+}\n+\n+var nearDupStop = map[string]bool{\"a\": true, \"an\": true, \"and\": true, \"for\": true, \"in\": true, \"is\": true, \"of\": true, \"on\": true, \"the\": true, \"to\": true, \"with\": true}\n+\n+func titleTokens(s string) map[string]bool {\n+\tb := []rune(strings.ToLower(s))\n+\tfor i, r := range b {\n+\t\tif (r < 'a' || r > 'z') && (r < '0' || r > '9') {\n+\t\t\tb[i] = ' '\n+\t\t}\n+\t}\n+\tset := map[string]bool{}\n+\tfor _, w := range strings.Fields(string(b)) {\n+\t\tif len(w) > 1 && !nearDupStop[w] {\n+\t\t\tset[w] = true\n+\t\t}\n+\t}\n+\treturn set\n+}\n+\n+// SimilarTitles reports whether two titles are near-duplicates: equal\n+// non-empty token sets, or, when both have at least three tokens, a Jaccard\n+// similarity of NearDupThreshold or more.\n+func SimilarTitles(a, b string) bool {\n+\tx, y := titleTokens(a), titleTokens(b)\n+\tif len(x) == 0 || len(y) == 0 {\n+\t\treturn false\n+\t}\n+\tinter := 0\n+\tfor w := range x {\n+\t\tif y[w] {\n+\t\t\tinter++\n+\t\t}\n+\t}\n+\tif inter == len(x) && inter == len(y) {\n+\t\treturn true\n+\t}\n+\tif len(x) < 3 || len(y) < 3 {\n+\t\treturn false\n+\t}\n+\tunion := len(x) + len(y) - inter\n+\treturn float64(inter)/float64(union) >= NearDupThreshold\n+}\n+\n+// SkipNearDuplicates drops items whose title is similar to an open issue's or\n+// to an earlier, more severe kept item of the same run. Items are compared in\n+// severity order. Skipped items are not recorded anywhere, so the next run\n+// offers them again.\n+func SkipNearDuplicates(items []Item, open []TitledIssue) (kept []Item, dups []NearDup) {\n+\tsorted := append([]Item(nil), items...)\n+\tsort.SliceStable(sorted, func(i, j int) bool { return lessItem(sorted[i], sorted[j]) })\n+\tfor _, it := range sorted {\n+\t\tissue, found := -1, false\n+\t\tfor _, o := range open {\n+\t\t\tif o.Number <= 0 {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tfor _, t := range o.Titles {\n+\t\t\t\tif SimilarTitles(it.F.Title, t) {\n+\t\t\t\t\tissue, found = o.Number, true\n+\t\t\t\t\tbreak\n+\t\t\t\t}\n+\t\t\t}\n+\t\t\tif found {\n+\t\t\t\tbreak\n+\t\t\t}\n+\t\t}\n+\t\tif !found {\n+\t\t\tfor _, k := range kept {\n+\t\t\t\tif SimilarTitles(it.F.Title, k.F.Title) {\n+\t\t\t\t\tissue, found = 0, true\n+\t\t\t\t\tbreak\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\t\tif found {\n+\t\t\tdups = append(dups, NearDup{Fingerprint: it.F.Fingerprint, Issue: issue})\n+\t\t\tcontinue\n+\t\t}\n+\t\tkept = append(kept, it)\n+\t}\n+\treturn kept, dups\n+}\ndiff --git a/internal/scanner/neardup_test.go b/internal/scanner/neardup_test.go\nnew file mode 100644\nindex 0000000..158e2ab\n--- /dev/null\n+++ b/internal/scanner/neardup_test.go\n@@ -0,0 +1,52 @@\n+package scanner\n+\n+import \"testing\"\n+\n+func TestSimilarTitles(t *testing.T) {\n+\ttests := []struct {\n+\t\ta, b string\n+\t\twant bool\n+\t}{\n+\t\t{\"Missing label\", \"missing LABEL!\", true},\n+\t\t{\"missing label\", \"missing labels\", false},\n+\t\t{\"fix cache\", \"fix cache bug\", false}, // 2 vs 3 tokens, not equal\n+\t\t{\"cache bug\", \"cache bug\", true},\n+\t\t{\"a b c d e\", \"a b c d e\", false}, // one-character tokens drop out: empty\n+\t\t{\"The cache of the bug\", \"cache bug\", true},\n+\t\t{\"alpha beta gamma delta epsilon\", \"alpha beta gamma delta zeta\", false}, // 4/6\n+\t\t{\"alpha beta gamma delta\", \"alpha beta gamma delta epsilon\", true},       // 4/5 = 0.8\n+\t\t{\"\", \"\", false},\n+\t\t{\"alpha beta gamma delta\", \"alpha beta gamma\", false},\n+\t}\n+\tfor _, tt := range tests {\n+\t\tif got := SimilarTitles(tt.a, tt.b); got != tt.want {\n+\t\t\tt.Errorf(\"SimilarTitles(%q, %q) = %v, want %v\", tt.a, tt.b, got, tt.want)\n+\t\t}\n+\t}\n+}\n+\n+func TestSkipNearDuplicates(t *testing.T) {\n+\titems := []Item{\n+\t\t{F: Finding{Fingerprint: \"low\"