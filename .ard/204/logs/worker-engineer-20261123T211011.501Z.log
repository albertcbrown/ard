ngerprints(fs []Finding, exists func(path string) bool) DecodeErrors {\n\tvar errs DecodeErrors\n\tfail := func(i int, msg string) {\n\t\tif len(errs) < maxErrorLines {\n\t\t\terrs = append(errs, DecodeError{Line: i + 1, Msg: msg})\n\t\t}\n\t}\n\tfor i, f := range fs {\n\t\t_, p, _, ok := ParseLLMFingerprint(f.Fingerprint)\n\t\tif !ok {\n\t\t\tfail(i, \"fingerprint is not rule:path[:symbol]\")\n\t\t\tcontinue\n\t\t}\n\t\tlisted := false\n\t\tfor _, file := range f.Files {\n\t\t\tif file == p {\n\t\t\t\tlisted = true\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif !listed {\n\t\t\tfail(i, \"fingerprint path is not in files\")\n\t\t\tcontinue\n\t\t}\n\t\tif exists != nil && !exists(p) {\n\t\t\tfail(i, \"fingerprint path does not exist\")\n\t\t}\n\t}\n\treturn errs\n}\n\n// LLMGrammarLines summarises errors as \"invalid findings at lines 3, 7 (and\n// N more)\", for logs. It contains line numbers only.\nfunc LLMGrammarLines(errs DecodeErrors) string {\n\tconst show = 5\n\tvar nums []string\n\tfor i, e := range errs {\n\t\tif i == show {\n\t\t\tbreak\n\t\t}\n\t\tnums = append(nums, fmt.Sprint(e.Line))\n\t}\n\ts := \"invalid findings at lines \" + strings.Join(nums, \", \")\n\tif len(errs) > show {\n\t\ts += fmt.Sprintf(\" (and %d more)\", len(errs)-show)\n\t}\n\treturn s\n}\nE\ncat > internal/scanner/neardup.go <<'E'\npackage scanner\n\nimport (\n\t\"sort\"\n\t\"strings\"\n)\n\n// NearDupThreshold is the Jaccard similarity at which two titles with at\n// least three tokens each are near-duplicates.\nconst NearDupThreshold = 0.8\n\n// TitledIssue is an open issue with every title it carries (its own and its\n// checklist lines').\ntype TitledIssue struct {\n\tNumber int\n\tTitles []string\n}\n\n// NearDup records a skipped finding and the open issue (or, when Issue is 0,\n// an earlier finding of the same run) it duplicates.\ntype NearDup struct {\n\tFingerprint string\n\tIssue       int\n}\n\nvar nearDupStop = map[string]bool{\"a\": true, \"an\": true, \"and\": true, \"for\": true, \"in\": true, \"is\": true, \"of\": true, \"on\": true, \"the\": true, \"to\": true, \"with\": true}\n\nfunc titleTokens(s string) map[string]bool {\n\tb := []rune(strings.ToLower(s))\n\tfor i, r := range b {\n\t\tif (r < 'a' || r > 'z') && (r < '0' || r > '9') {\n\t\t\tb[i] = ' '\n\t\t}\n\t}\n\tset := map[string]bool{}\n\tfor _, w := range strings.Fields(string(b)) {\n\t\tif len(w) > 1 && !nearDupStop[w] {\n\t\t\tset[w] = true\n\t\t}\n\t}\n\treturn set\n}\n\n// SimilarTitles reports whether two titles are near-duplicates: equal\n// non-empty token sets, or, when both have at least three tokens, a Jaccard\n// similarity of NearDupThreshold or more.\nfunc SimilarTitles(a, b string) bool {\n\tx, y := titleTokens(a), titleTokens(b)\n\tif len(x) == 0 || len(y) == 0 {\n\t\treturn false\n\t}\n\tinter := 0\n\tfor w := range x {\n\t\tif y[w] {\n\t\t\tinter++\n\t\t}\n\t}\n\tif inter == len(x) && inter == len(y) {\n\t\treturn true\n\t}\n\tif len(x) < 3 || len(y) < 3 {\n\t\treturn false\n\t}\n\tunion := len(x) + len(y) - inter\n\treturn float64(inter)/float64(union) >= NearDupThreshold\n}\n\n// SkipNearDuplicates drops items whose title is similar to an open issue's or\n// to an earlier, more severe kept item of the same run. Items are compared in\n// severity order. Skipped items are not recorded anywhere, so the next run\n// offers them again.\nfunc SkipNearDuplicates(items []Item, open []TitledIssue) (kept []Item, dups []NearDup) {\n\tsorted := append([]Item(nil), items...)\n\tsort.SliceStable(sorted, func(i, j int) bool { return lessItem(sorted[i], sorted[j]) })\n\tfor _, it := range sorted {\n\t\tissue, found := -1, false\n\t\tfor _, o := range open {\n\t\t\tif o.Number <= 0 {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tfor _, t := range o.Titles {\n\t\t\t\tif SimilarTitles(it.F.Title, t) {\n\t\t\t\t\tissue, found = o.Number, true\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t\tif found {\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif !found {\n\t\t\tfor _, k := range kept {\n\t\t\t\tif SimilarTitles(it.F.Title, k.F.Title) {\n\t\t\t\t\tissue, found = 0, true\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif found {\n\t\t\tdups = append(dups, NearDup{Fingerprint: it.F.Fingerprint, Issue: issue})\n\t\t\tcontinue\n\t\t}\n\t\tkept = append(kept, it)\n\t}\n\treturn kept, dups\n}\nE\ngo build ./internal/scanner"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1713,"cache_read_input_tokens":37968,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1713},"output_tokens":20,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a2a8bf32-d6e4-436f-a631-72cb4dc75f8f","uuid":"be6fa981-ddc4-4e7a-bf64-190f25c1a3ef","timestamp":"2026-11-23T21:14:53.392Z","request_id":"req_011ChLYxJwYCtVDDejB2H7f7"}
