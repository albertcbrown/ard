{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01A4UxNirNL2rcs3GvbnVRNE","type":"tool_result","content":"package scanner\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"io\"\n\t\"path\"\n\t\"strings\"\n\t\"unicode\"\n\t\"unicode/utf8\"\n)\n\n// Severity of a finding.\ntype Severity string\n\n// The five severities, highest first.\nconst (\n\tSevCritical Severity = \"critical\"\n\tSevHigh     Severity = \"high\"\n\tSevMedium   Severity = \"medium\"\n\tSevLow      Severity = \"low\"\n\tSevInfo     Severity = \"info\"\n)\n\n// Rank orders severities: critical is 5, info is 1, an unknown value is 0.\nfunc (s Severity) Rank() int {\n\tswitch s {\n\tcase SevCritical:\n\t\treturn 5\n\tcase SevHigh:\n\t\treturn 4\n\tcase SevMedium:\n\t\treturn 3\n\tcase SevLow:\n\t\treturn 2\n\tcase SevInfo:\n\t\treturn 1\n\t}\n\treturn 0\n}\n\n// Valid reports whether s is one of the five severities.\nfunc (s Severity) Valid() bool { return s.Rank() > 0 }\n\n// Limits on scanner output. Any violation fails the whole run.\nconst (\n\tMaxLineBytes   = 1 << 20  // one JSONL line\n\tMaxStreamBytes = 16 << 20 // the whole stdout\n\tMaxFindings    = 10000\n\tMaxBodyBytes   = 64 << 10\n\tMaxFingerprint = 512 // bytes\n\tMaxTitleRunes  = 200\n\tMaxGroupBytes  = 256\n\tMaxFiles       = 1000\n\tmaxPathBytes   = 4096\n\tmaxErrorLines  = 20\n)\n\n// Finding is one line of scanner output.\ntype Finding struct {\n\tFingerprint string   `json:\"fingerprint\"` // required; stable across runs\n\tTitle       string   `json:\"title\"`       // required; one line\n\tSeverity    Severity `json:\"severity\"`    // required\n\tGroup       string   `json:\"group\"`       // optional; \"\" = one issue per finding\n\tFiles       []string `json:\"files\"`       // optional; repo-relative\n\tBody        string   `json:\"body\"`        // optional markdown\n}\n\n// GroupOp is one filing action: append Items to issue Join, or, when Join is\n// 0, create an issue for them in Group.\ntype GroupOp struct {\n\tJoin  int\n\tGroup string\n\tItems []Item\n}\n\ntype unit struct {\n\tgroup string\n\titems []Item\n\tbest  int\n}\n\nfunc lessItem(a, b Item) bool {\n\tif ra, rb := a.F.Severity.Rank(), b.F.Severity.Rank(); ra != rb {\n\t\treturn ra > rb\n\t}\n\treturn a.F.Fingerprint < b.F.Fingerprint\n}\n\n// PlanGroups decides where items go, most severe first so a tight budget\n// files what matters. An empty group always gets its own issue. Otherwise, per\n// group key, new findings fill joinable issues of that group (lowest number\n// first; checked lines count against groupSize, so a checklist cannot grow\n// without bound) and the rest are chunked into new issues of at most\n// groupSize. A regression never joins: it files a new issue, which may also\n// hold new findings of the same group. budget bounds the number of new\n// issues; joins are free. It returns the ops and the number of items left\n// unfiled for lack of budget, which the next run offers again.\nfunc PlanGroups(items []Item, joinable []Joinable, groupSize, budget int) (ops []GroupOp, overBudget int) {\n\tif groupSize < 1 {\n\t\tgroupSize = 1\n\t}\n\tbyGroup := map[string][]Item{}\n\tvar units []unit\n\tfor _, it := range items {\n\t\tif it.F.Group == \"\" {\n\t\t\tunits = append(units, unit{items: []Item{it}, best: it.F.Severity.Rank()})\n\t\t\tcontinue\n\t\t}\ninternal/scanner/group.go:8:type Item struct {\ninternal/scanner/group.go-9-\tF            Finding\ninternal/scanner/group.go-10-\tRegressionOf int\ninternal/scanner/group.go-11-}\ninternal/scanner/group.go-12-\ninternal/scanner/group.go-13-// Joinable is an open, unclaimed issue a new finding may join.\ninternal/scanner/group.go-14-type Joinable struct {\ninternal/scanner/group.go-15-\tNumber int\ninternal/scanner/group.go-16-\tGroup  string\ninternal/scanner/group.go-17-\tLines  int // checklist lines already on it, checked ones included\ninternal/scanner/group.go-18-}\ninternal/scanner/group.go-19-\ninternal/scanner/group.go-20-// GroupOp is