son":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2646,"cache_read_input_tokens":34401,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2646},"output_tokens":28,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a2a8bf32-d6e4-436f-a631-72cb4dc75f8f","uuid":"683604e7-35f2-4f68-a66a-7147464c8d37","timestamp":"2026-11-23T21:14:37.774Z","request_id":"req_011ChLYwqP6DhEKhUXeTbHXA"}
