s it for 90 days.\"\n+\n+// createBody renders the body of a new issue, with the footer unless the\n+// scanner routes to ard:pending.\n+func createBody(role config.Role, parsed Parsed, fs []Finding) string {\n+\tbody := RenderBody(\"\", parsed, fs)\n+\tif role.Route != config.RoutePending {\n+\t\tbody = strings.TrimRight(body, \"\\n\") + \"\\n\\n\" + llmFooter + \"\\n\"\n+\t}\n+\treturn body\n+}\n+\n // create files a new issue for op.Items.\n func (e *execution) create(op GroupOp) {\n \tif e.budget <= 0 {\n@@ -834,7 +866,7 @@ func (e *execution) create(op GroupOp) {\n \t}\n \tparsed := Parsed{Scanner: e.role.Name, Group: op.Group, HasSpan: true, Lines: linesOf(op.Items)}\n \ttitle := IssueTitle(e.role.Name, op.Group, e.p.groupSize(e.role), op.Items)\n-\tbody := RenderBody(\"\", parsed, findingsOf(op.Items))\n+\tbody := createBody(e.role, parsed, findingsOf(op.Items))\n \tis, err := e.p.Effects.CreateIssue(e.ctx, github.NewIssue{Title: title, Body: body, Labels: e.roleLabels()})\n \tif err != nil {\n \t\te.fail(fmt.Errorf(\"create issue %q: %w\", title, err))\ndiff --git a/internal/scanner/reconcile.go b/internal/scanner/reconcile.go\nindex 804257e..dcc3601 100644\n--- a/internal/scanner/reconcile.go\n+++ b/internal/scanner/reconcile.go\n@@ -11,6 +11,7 @@ import (\n // IssueView is an open scanner issue as reconcile and grouping see it.\n type IssueView struct {\n \tNumber    int\n+\tTitle     string\n \tLabels    []string\n \tCreatedAt time.Time\n \tBody      string\ndiff --git a/internal/scanner/stale/decide.go b/internal/scanner/stale/decide.go\nindex d459e08..4357736 100644\n--- a/internal/scanner/stale/decide.go\n+++ b/internal/scanner/stale/decide.go\n@@ -48,6 +48,28 @@ func scannerOf(is github.Issue, scanners map[string]bool) (string, bool) {\n \treturn \"\", false\n }\n \n+// staleCandidate reports whether the issue is in a state the closer may\n+// consider: it carries ard:pending, or (a scanner with route none) its only\n+// ard: label is the ard:scanner: