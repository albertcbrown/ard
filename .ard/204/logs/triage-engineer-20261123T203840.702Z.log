dapter, engine, serve wiring, CLAUDE.md) stay human-led and are not planned here; CLAUDE.md is a protected path.\n- The pipeline still skips LLM scanners until PR 4, so the new pipeline behaviour can only be tested through helpers and execution-level tests.\n- The new spend-floor config error rejects LLM scanner fixtures that exist today; the worker must update them.\nEOF"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1251,"cache_read_input_tokens":54768,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1251},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9621e3c5-8282-4caf-bb41-8cef9d87c9df","uuid":"cc47ed22-8cb5-4cf6-9a49-e79445012eaf","timestamp":"2026-11-23T20:39:46.399Z","request_id":"req_011ChLWEk3VFVo1emSsonCEu"}
