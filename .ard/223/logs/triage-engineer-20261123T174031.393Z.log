{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014GgCRErabguR3cEJAgfVcj","type":"tool_result","content":"1\tpackage triage\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"encoding/json\"\n6\t\t\"errors\"\n7\t\t\"fmt\"\n8\t\t\"sort\"\n9\t\t\"strings\"\n10\t\t\"time\"\n11\t\n12\t\t\"github.com/albertcbrown/ard/internal/agentjob\"\n13\t\t\"github.com/albertcbrown/ard/internal/closeout\"\n14\t\t\"github.com/albertcbrown/ard/internal/config\"\n15\t\t\"github.com/albertcbrown/ard/internal/github\"\n16\t\t\"github.com/albertcbrown/ard/internal/github/query\"\n17\t\t\"github.com/albertcbrown/ard/internal/intake\"\n18\t\t\"github.com/albertcbrown/ard/internal/labels\"\n19\t\t\"github.com/albertcbrown/ard/internal/state\"\n20\t)\n21\t\n22\ttype fanInVerdict int\n23\t\n24\tconst (\n25\t\tfSkip  fanInVerdict = iota // not the gate's business (yet)\n26\t\tfWait                      // triage not finished\n27\t\tfHuman                     // put it to a human: comment + ard:needs-human\n28\t\tfReady                     // triage finished; caller checks the body hash, then approval\n29\t)\n30\t\n31\tfunc (v fanInVerdict) String() string { return [...]string{\"skip\", \"wait\", \"human\", \"ready\"}[v] }\n32\t\n33\t// Reasons. Fixed text: never issue text.\n34\tconst (\n35\t\trLeadNotDone    = \"lead-not-done\"\n36\t\trGuarded        = \"guarded\"\n37\t\trWorkerStarted  = \"worker-started\"\n38\t\trLeadRequested  = \"lead-requested\"\n39\t\trTriageRunning  = \"triage-running\"\n40\t\trWaiting        = \"waiting\"\n41\t\trUnknownRole    = \"unknown-role\"\n42\t\trNoWorker       = \"no-worker\"\n43\t\trWorkerGone     = \"worker-gone\"\n44\t\trReady          = \"ready\"\n45\t\trBodyChanged    = \"body-changed\"\n46\t\trApprovalNeeded = \"approval-needed\"\n47\t\trApprovalBad    = \"approval-refused\"\n48\t\trStart          = \"start\"\n49\t)\n50\t\n51\ttype fanInInput struct {\n52\t\tLabels  []string        // the fresh re-read\n53\t\tTriage  map[string]bool // configured triage role names\n54\t\tWorkers map[string]bool // configured worker role names\n55\t\tBusy    bool            // a triage job of this issue is running in state\n56\t\tWorker  string          // the lead's validated choice from LeadWorker; \"\" = none or no record\n57\t}\n58\t\n59\ttype fanInResult struct {\n60\t\tVerdict fanInVerdict\n61\t\tReason  string\n62\t\tRole    string // the triage role a wait or unknown-role names\n63\t\tWorker  string // fReady and worker-gone only\n64\t}\n65\t\n66\t// decideFanIn is the gate. Pure; the first matching check wins.\n67\tfunc decideFanIn(in fanInInput) fanInResult {\n68\t\tif !hasLabel(in.Labels, labels.Done(labels.StageTriage, leadRole)) {\n69\t\t\treturn fanInResult{Verdict: fSkip, Reason: rLeadNotDone}\n70\t\t}\n71\t\tif hasAny(in.Labels, []string{labels.NeedsHuman, labels.Hold, labels.ExecutorFailed}) {\n72\t\t\treturn fanInResult{Verdict: fSkip, Reason: rGuarded}\n73\t\t}\n74\t\tvar requested []string\n75\t\trunning := in.Busy\n76\t\tfor _, l := range in.Labels {\n77\t\t\tp, ok := labels.Parse(l)\n78\t\t\tif !ok || p.Kind != labels.KindRole {\n79\t\t\t\tcontinue\n80\t\t\t}\n81\t\t\tswitch {\n82\t\t\tcase p.Stage == labels.StageWorker:\n83\t\t\t\t// A worker already gated, started by a human, or in a fix round.\n84\t\t\t\treturn fanInResult{Verdict: fSkip, Reason: rWorkerStarted}\n85\t\t\tcase p.Stage == labels.StageTriage && p.State == labels.StateRequest:\n86\t\t\t\trequested = append(requested, p.Role)\n87\t\t\tcase p.Stage == labels.StageTriage && p.State == labels.StateRunning:\n88\t\t\t\trunning = true\n89\t\t\t}\n90\t\t}\n91\t\tif hasLabel(in.Labels, labels.Pending) {\n92\t\t\treturn fanInResult{Verdict: fSkip, Reason: rLeadRequested}\n93\t\t}\n94\t\tif running {\n95\t\t\treturn fanInResult{Verdict: fWait, Reason: rTriageRunning}\n96\t\t}\n97\t\tsort.Strings(requested)\n98\t\twait := \"\"\n99\t\tfor _, r := range requested {\n100\t\t\tif !in.Triage[r] {\n101\t\t\t\treturn fanInResult{Verdict: fHuman, Reason: rUnknownRole, Role: r}\n102\t\t\t}\n103\t\t\tif wait == \"\" && !hasLabel(in.Labels, labels.Done(labels.StageTriage, r)) {\n104\t\t\t\twait = r\n105\t\t\t}\n106\t\t}\n107\t\tif wait != \"\" {\n108\t\t\treturn fanInResult{Verdict: fWait, Reason: rWaiting, Role: wait}\n109\t\t}\n110\t\tif in.Worker == \"\" {\n111\t\t\treturn fanInResult{Verdict: fHuman, Reason: rNoWorker}\n112\t\t}\n113\t\tif !in.Workers[in.Worker] {\n114\t\t\treturn fanInResult{Verdict: fHuman, Reason: rWorkerGone, Worker: in.Worker}\n115\t\t}\n116\t\treturn fanInResult{Verdict: fReady, Reason: rReady, Worker: in.Worker}\n117\t}\n118\t\n119\t// approvalEvent returns the labeled event behind the current ard:approved: the\n120\t// latest \"labeled\" for it, reset by a later \"unlabeled\". Pure.\n121\tfunc approvalEvent(tl []github.TimelineEvent) (github.TimelineEvent, bool) {\n122\t\tvar ev github.TimelineEvent\n123\t\tfound := false\n124\t\tfor _, e := range tl {\n125\t\t\tif !strings.EqualFold(e.Label, labels.Approved) {\n126\t\t\t\tcontinue\n127\t\t\t}\n128\t\t\tswitch e.Event {\n129\t\t\tcase \"labeled\":\n130\t\t\t\tev, found = e, true\n131\t\t\tcase \"unlabeled\":\n132\t\t\t\tev, found = github.TimelineEvent{}, false\n133\t\t\t}\n134\t\t}\n135\t\treturn ev, found\n136\t}\n137\t\n138\t// lastTriageDone returns when the latest ard:triage:<role>:done label was\n139\t// added. ok is false when the timeline shows none.\n140\tfunc lastTriageDone(tl []github.TimelineEvent) (time.Time, bool) {\n141\t\tvar at time.Time\n142\t\tok := false\n143\t\tfor _, e := range tl {\n144\t\t\tif e.Event != \"labeled\" {\n145\t\t\t\tcontinue\n146\t\t\t}\n147\t\t\tp, valid := labels.Parse(e.Label)\n148\t\t\tif !valid || p.Kind != labels.KindRole || p.Stage != labels.StageTriage || p.State != labels.StateDone {\n149\t\t\t\tcontinue\n150\t\t\t}\n151\t\t\tif !ok || e.CreatedAt.After(at) {\n152\t\t\t\tat, ok = e.CreatedAt, true\n153\t\t\t}\n154\t\t}\n155\t\treturn at, ok\n156\t}\n157\t\n158\tfunc names(rs []config.Role) map[string]bool {\n159\t\tm := make(map[string]bool, len(rs))\n160\t\tfor _, r := range rs {\n161\t\t\tm[r.Name] = true\n162\t\t}\n163\t\treturn m\n164\t}\n165\t\n166\t// fanIn is the fan-in gate step of a tick. One search per tick finds issues\n167\t// whose lead is done and that no worker has been requested for; each hit is\n168\t// re-read and decided. Errors for one issue are joined, never stop the rest.\n169\tfunc (t *tick) fanIn(ctx context.Context) []error {\n170\t\tl := t.l\n171\t\trunning, err := l.d.Store.RunningJobs(ctx)\n172\t\tif err != nil {\n173\t\t\treturn []error{fmt.Errorf(\"triage gate: list running jobs: %w\", err)}\n174\t\t}\n175\t\tbusy := map[int]bool{}\n176\t\tfor _, j := range running {\n177\t\t\tif j.Stage == stageTriage {\n178\t\t\t\tbusy[j.Issue] = true\n179\t\t\t}\n180\t\t}\n181\t\tstates := []string{labels.Pending}\n182\t\tfor _, w := range t.cfg.RolesOf(config.KindWorker) {\n183\t\t\tstates = append(states, labels.Request(labels.StageWorker, w.Name))\n184\t\t}\n185\t\t// Gated issues keep ard:triage:lead:done until they close, so the worker\n186\t\t// request labels are excluded or they would fill the window and starve new ones.\n187\t\tq, err := query.RoleQuery{\n188\t\t\tType: query.TypeIssue, Request: labels.Done(labels.StageTriage, leadRole), States: states,\n189\t\t\tGuards: []string{labels.ExecutorFailed, labels.NeedsHuman, labels.Hold},\n190\t\t}.Build()\n191\t\tif err != nil {\n192\t\t\treturn []error{fmt.Errorf(\"triage gate: %w\", err)}\n193\t\t}\n194\t\thits, err := l.d.Reader.SearchIssues(ctx, q, github.SearchOpts{Sort: \"updated\", Order: \"desc\", Max: 100})\n195\t\tif err != nil {\n196\t\t\treturn []error{fmt.Errorf(\"triage gate: search: %w\", err)}\n197\t\t}\n198\t\tsort.SliceStable(hits, func(i, j int) bool { return hits[i].Number < hits[j].Number })\n199\t\tvar errs []error\n200\t\tfor _, hit := range hits {\n201\t\t\tif err := t.gateIssue(ctx, hit.Number, busy[hit.Number]); err != nil {\n202\t\t\t\terrs = append(errs, err)\n203\t\t\t}\n204\t\t}\n205\t\treturn errs\n206\t}\n207\t\n208\t// gateIssue re-reads issue n (search is eventually consistent) and acts on the\n209\t// gate's verdict.\n210\tfunc (t *tick) gateIssue(ctx context.Context, n int, busy bool) error {\n211\t\tl := t.l\n212\t\tis, err := l.d.Reader.GetIssue(ctx, n)\n213\t\tif err != nil {\n214\t\t\tif errors.Is(err, github.ErrNotFound) {\n215\t\t\t\treturn nil\n216\t\t\t}\n217\t\t\treturn fmt.Errorf(\"triage gate issue %d: re-read: %w\", n, err)\n218\t\t}\n219\t\tif is.State != github.StateOpen || is.IsPR {\n220\t\t\treturn nil\n221\t\t}\n222\t\tworker, jobID, ok, err := closeout.LeadWorker(ctx, l.d.Store, n)\n223\t\tif err != nil {\n224\t\t\treturn fmt.Errorf(\"triage gate: %w\", err)\n225\t\t}\n226\t\tif !ok && hasLabel(is.Labels, labels.Done(labels.StageTriage, leadRole)) {\n227\t\t\tt.log.Warn(\"triage.gate_no_record\", \"issue\", n, \"hint\", \"no closed lead close-out in local state\")\n228\t\t}\n229\t\t// Close-out applies the lead's requests before :done, in one AddLabels\n230\t\t// call, so when :done is visible every request is visible too.\n231\t\tres := decideFanIn(fanInInput{\n232\t\t\tLabels: is.Labels, Triage: names(t.cfg.RolesOf(config.KindTriage)), Workers: names(t.cfg.RolesOf(config.KindWorker)),\n233\t\t\tBusy: busy, Worker: worker,\n234\t\t})\n235\t\tswitch res.Verdict {\n236\t\tcase fSkip:\n237\t\t\treturn nil\n238\t\tcase fWait:\n239\t\t\tt.log.Debug(\"triage.gate_wait\", \"issue\", n, \"reason\", res.Reason, \"role\", res.Role)\n240\t\t\treturn nil\n241\t\t}\n242\t\tif jobID == \"\" {\n243\t\t\tjobID = \"none\"\n244\t\t}\n245\t\tif t.dry {\n246\t\t\tt.log.Info(\"triage.would_gate\", \"issue\", n, \"verdict\", res.Verdict.String(), \"reason\", res.Reason, \"worker\", res.Worker)\n247\t\t\treturn nil\n248\t\t}\n249\t\tif res.Verdict == fHuman {\n250\t\t\treturn t.gateHuman(ctx, n, jobID, res)\n251\t\t}\n252\t\treturn t.gateReady(ctx, is, jobID, res.Worker)\n253\t}\n254\t\n255\tconst needsHumanHead = \"**ard · triage · needs a human**\\n\\n\"\n256\t\n257\t// gateHuman posts one comment, adds ard:needs-human, records the event.\n258\tfunc (t *tick) gateHuman(ctx context.Context, n int, jobID string, res fanInResult) error {\n259\t\toptions := \"A maintainer can add `ard:worker:<role>` and remove `ard:needs-human` to start a worker, re-run triage, or close the issue if no change is needed.\"\n260\t\tvar marker, text string\n261\t\tswitch res.Reason {\n262\t\tcase rNoWorker:\n263\t\t\tmarker = fmt.Sprintf(\"<!-- %striage gate=no-worker job=%s -->\", labels.Prefix, jobID)\n264\t\t\ttext = \"Triage finished but the lead named no worker role, so ard will not start one. \" + options\n265\t\tcase rWorkerGone:\n266\t\t\tmarker = fmt.Sprintf(\"<!-- %striage gate=worker-gone worker=%s -->\", labels.Prefix, res.Worker)\n267\t\t\ttext = fmt.Sprintf(\"The lead chose the `%s` worker, but no such worker role exists now. %s\", res.Worker, options)\n268\t\tdefault: // rUnknownRole\n269\t\t\tmarker = fmt.Sprintf(\"<!-- %striage gate=unknown-role role=%s -->\", labels.Prefix, res.Role)\n270\t\t\ttext = fmt.Sprintf(\"`ard:triage:%s` is requested but there is no `.ard/triage/%s/` role, so triage can never finish. A maintainer can remove the label and `%s`.\",\n271\t\t\t\tres.Role, res.Role, labels.NeedsHuman)\n272\t\t}\n273\t\tif err := t.postOnce(ctx, n, marker, needsHumanHead+text); err != nil {\n274\t\t\treturn err\n275\t\t}\n276\t\tif err := t.l.d.Effects.AddLabels(ctx, n, labels.NeedsHuman); err != nil {\n277\t\t\treturn fmt.Errorf(\"triage gate issue %d: add %s: %w\", n, labels.NeedsHuman, err)\n278\t\t}\n279\t\tt.gateEvent(ctx, n, \"human\", res.Reason, res.Worker)\n280\t\tt.log.Info(\"triage.gate\", \"issue\", n, \"verdict\", \"human\", \"reason\", res.Reason)\n281\t\treturn nil\n282\t}\n283\t\n284\t// gateReady runs the checks that need a read of the issue's history, then\n285\t// starts the worker.\n286\tfunc (t *tick) gateReady(ctx context.Context, is github.Issue, jobID, worker string) error {\n287\t\tl := t.l\n288\t\tn := is.Number\n289\t\tif !strings.EqualFold(is.Author, t.self) {\n290\t\t\tstored, err := l.d.Store.Admission(ctx, n)\n291\t\t\tif err != nil {\n292\t\t\t\tif errors.Is(err, state.ErrNotFound) {\n293\t\t\t\t\tt.log.Info(\"triage.not_admitted\", \"issue\", n, \"role\", leadRole)\n294\t\t\t\t\treturn nil\n295\t\t\t\t}\n296\t\t\t\treturn fmt.Errorf(\"triage gate issue %d: read admission: %w\", n, err)\n297\t\t\t}\n298\t\t\tif hash := agentjob.BodyHash(is); stored.BodyHash != hash {\n299\t\t\t\treturn t.regateAfterTriage(ctx, is, hash, worker)\n300\t\t\t}\n301\t\t}\n302\t\tif t.cfg.RequireApproval {\n303\t\t\tok, err := t.approved(ctx, is, jobID, worker)\n304\t\t\tif err != nil || !ok {\n305\t\t\t\treturn err\n306\t\t\t}\n307\t\t}\n308\t\tif err := l.d.Effects.AddLabels(ctx, n, labels.Request(labels.StageWorker, worker)); err != nil {\n309\t\t\treturn fmt.Errorf(\"triage gate issue %d: add worker label: %w\", n, err)\n310\t\t}\n311\t\tt.gateEvent(ctx, n, \"start\", rStart, worker)\n312\t\tt.log.Info(\"triage.gate\", \"issue\", n, \"verdict\", \"start\", \"worker\", worker)\n313\t\treturn nil\n314\t}\n315\t\n316\t// regateAfterTriage mirrors regate for an issue edited after triage finished.\n317\t// It does not offer re-admission: a lead with :done is never re-claimed.\n318\tfunc (t *tick) regateAfterTriage(ctx context.Context, is github.Issue, hash, worker string) error {\n319\t\tn := is.Number\n320\t\tif err := t.markRegated(ctx, is, hash); err != nil {"}]},"parent_tool_use_id":null,"session_id":"16ee025c-fa9f-459a-ab5e-88271e950e26","uuid":"918e1c7f-ec23-472e-b277-53c521af7a1c","timestamp":"2026-11-23T17:40:41.378Z","tool_use_result":{"type":"text","file":{"filePath":"/work/internal/triage/fanin.go","content":"package triage\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"sort\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/agentjob\"\n\t\"github.com/albertcbrown/ard/internal/closeout\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/github/query\"\n\t\"github.com/albertcbrown/ard/internal/intake\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\ntype fanInVerdict int\n\nconst (\n\tfSkip  fanInVerdict = iota // not the gate's business (yet)\n\tfWait                      // triage not finished\n\tfHuman                     // put it to a human: comment + ard:needs-human\n\tfReady                     // triage finished; caller checks the body hash, then approval\n)\n\nfunc (v fanInVerdict) String() string { return [...]string{\"skip\", \"wait\", \"human\", \"ready\"}[v] }\n\n// Reasons. Fixed text: never issue text.\nconst (\n\trLeadNotDone    = \"lead-not-done\"\n\trGuarded        = \"guarded\"\n\trWorkerStarted  = \"worker-started\"\n\trLeadRequested  = \"lead-requested\"\n\trTriageRunning  = \"triage-running\"\n\trWaiting        = \"waiting\"\n\trUnknownRole    = \"unknown-role\"\n\trNoWorker       = \"no-worker\"\n\trWorkerGone     = \"worker-gone\"\n\trReady          = \"ready\"\n\trBodyChanged    = \"body-changed\"\n\trApprovalNeeded = \"approval-needed\"\n\trApprovalBad    = \"approval-refused\"\n\trStart          = \"start\"\n)\n\ntype fanInInput struct {\n\tLabels  []string        // the fresh re-read\n\tTriage  map[string]bool // configured triage role names\n\tWorkers map[string]bool // configured worker role names\n\tBusy    bool            // a triage job of this issue is running in state\n\tWorker  string          // the lead's validated choice from LeadWorker; \"\" = none or no record\n}\n\ntype fanInResult struct {\n\tVerdict fanInVerdict\n\tReason  string\n\tRole    string // the triage role a wait or unknown-role names\n\tWorker  string // fReady and worker-gone only\n}\n\n// decideFanIn is the gate. Pure; the first matching check wins.\nfunc decideFanIn(in fanInInput) fanInResult {\n\tif !hasLabel(in.Labels, labels.Done(labels.StageTriage, leadRole)) {\n\t\treturn fanInResult{Verdict: fSkip, Reason: rLeadNotDone}\n\t}\n\tif hasAny(in.Labels, []string{labels.NeedsHuman, labels.Hold, labels.ExecutorFailed}) {\n\t\treturn fanInResult{Verdict: fSkip, Reason: rGuarded}\n\t}\n\tvar requested []string\n\trunning := in.Busy\n\tfor _, l := range in.Labels {\n\t\tp, ok := labels.Parse(l)\n\t\tif !ok || p.Kind != labels.KindRole {\n\t\t\tcontinue\n\t\t}\n\t\tswitch {\n\t\tcase p.Stage == labels.StageWorker:\n\t\t\t// A worker already gated, started by a human, or in a fix round.\n\t\t\treturn fanInResult{Verdict: fSkip, Reason: rWorkerStarted}\n\t\tcase p.Stage == labels.StageTriage && p.State == labels.StateRequest:\n\t\t\trequested = append(requested, p.Role)\n\t\tcase p.Stage == labels.StageTriage && p.State == labels.StateRunning:\n\t\t\trunning = true\n\t\t}\n\t}\n\tif hasLabel(in.Labels, labels.Pending) {\n\t\treturn fanInResult{Verdict: fSkip, Reason: rLeadRequested}\n\t}\n\tif running {\n\t\treturn fanInResult{Verdict: fWait, Reason: rTriageRunning}\n\t}\n\tsort.Strings(requested)\n\twait := \"\"\n\tfor _, r := range requested {\n\t\tif !in.Triage[r] {\n\t\t\treturn fanInResult{Verdict: fHuman, Reason: rUnknownRole, Role: r}\n\t\t}\n\t\tif wait == \"\" && !hasLabel(in.Labels, labels.Done(labels.StageTriage, r)) {\n\t\t\twait = r\n\t\t}\n\t}\n\tif wait != \"\" {\n\t\treturn fanInResult{Verdict: fWait, Reason: rWaiting, Role: wait}\n\t}\n\tif in.Worker == \"\" {\n\t\treturn fanInResult{Verdict: fHuman, Reason: rNoWorker}\n\t}\n\tif !in.Workers[in.Worker] {\n\t\treturn fanInResult{Verdict: fHuman, Reason: rWorkerGone, Worker: in.Worker}\n\t}\n\treturn fanInResult{Verdict: fReady, Reason: rReady, Worker: in.Worker}\n}\n\n// approvalEvent returns the labeled event behind the current ard:approved: the\n// latest \"labeled\" for it, reset by a later \"unlabeled\". Pure.\nfunc approvalEvent(tl []github.TimelineEvent) (github.TimelineEvent, bool) {\n\tvar ev github.TimelineEvent\n\tfound := false\n\tfor _, e := range tl {\n\t\tif !strings.EqualFold(e.Label, labels.Approved) {\n\t\t\tcontinue\n\t\t}\n\t\tswitch e.Event {\n\t\tcase \"labeled\":\n\t\t\tev, found = e, true\n\t\tcase \"unlabeled\":\n\t\t\tev, found = github.TimelineEvent{}, false\n\t\t}\n\t}\n\treturn ev, found\n}\n\n// lastTriageDone returns when the latest ard:triage:<role>:done label was\n// added. ok is false when the timeline shows none.\nfunc lastTriageDone(tl []github.TimelineEvent) (time.Time, bool) {\n\tvar at time.Time\n\tok := false\n\tfor _, e := range tl {\n\t\tif e.Event != \"labeled\" {\n\t\t\tcontinue\n\t\t}\n\t\tp, valid := labels.Parse(e.Label)\n\t\tif !valid || p.Kind != labels.KindRole || p.Stage != labels.StageTriage || p.State != labels.StateDone {\n\t\t\tcontinue\n\t\t}\n\t\tif !ok || e.CreatedAt.After(at) {\n\t\t\tat, ok = e.CreatedAt, true\n\t\t}\n\t}\n\treturn at, ok\n}\n\nfunc names(rs []config.Role) map[string]bool {\n\tm := make(map[string]bool, len(rs))\n\tfor _, r := range rs {\n\t\tm[r.Name] = true\n\t}\n\treturn m\n}\n\n// fanIn is the fan-in gate step of a tick. One search per tick finds issues\n// whose lead is done and that no worker has been requested for; each hit is\n// re-read and decided. Errors for one issue are joined, never stop the rest.\nfunc (t *tick) fanIn(ctx context.Context) []error {\n\tl := t.l\n\trunning, err := l.d.Store.RunningJobs(ctx)\n\tif err != nil {\n\t\treturn []error{fmt.Errorf(\"triage gate: list running jobs: %w\", err)}\n\t}\n\tbusy := map[int]bool{}\n\tfor _, j := range running {\n\t\tif j.Stage == stageTriage {\n\t\t\tbusy[j.Issue] = true\n\t\t}\n\t}\n\tstates := []string{labels.Pending}\n\tfor _, w := range t.cfg.RolesOf(config.KindWorker) {\n\t\tstates = append(states, labels.Request(labels.StageWorker, w.Name))\n\t}\n\t// Gated issues keep ard:triage:lead:done until they close, so the worker\n\t// request labels are excluded or they would fill the wind