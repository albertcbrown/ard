{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F1kEVi1tkKoZEqsjbMU6Ca","type":"tool_result","content":"1\tpackage triage\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"encoding/json\"\n6\t\t\"errors\"\n7\t\t\"strings\"\n8\t\t\"testing\"\n9\t\t\"time\"\n10\t\n11\t\t\"github.com/albertcbrown/ard/internal/agentjob\"\n12\t\t\"github.com/albertcbrown/ard/internal/closeout\"\n13\t\t\"github.com/albertcbrown/ard/internal/config\"\n14\t\t\"github.com/albertcbrown/ard/internal/costblock\"\n15\t\t\"github.com/albertcbrown/ard/internal/github\"\n16\t\t\"github.com/albertcbrown/ard/internal/labels\"\n17\t\t\"github.com/albertcbrown/ard/internal/state\"\n18\t)\n19\t\n20\tfunc TestDecideFanIn(t *testing.T) {\n21\t\ttriage := map[string]bool{\"lead\": true, \"architect\": true, \"engineer\": true}\n22\t\tworkers := map[string]bool{\"engineer\": true}\n23\t\tdone := labels.Done(labels.StageTriage, \"lead\")\n24\t\ttests := []struct {\n25\t\t\tname   string\n26\t\t\tlabels []string\n27\t\t\tbusy   bool\n28\t\t\tworker string\n29\t\t\twant   fanInVerdict\n30\t\t\treason string\n31\t\t\trole   string\n32\t\t}{\n33\t\t\t{\"lead not done\", []string{\"ard:triage:architect:done\"}, false, \"engineer\", fSkip, rLeadNotDone, \"\"},\n34\t\t\t{\"needs-human\", []string{done, labels.NeedsHuman}, false, \"engineer\", fSkip, rGuarded, \"\"},\n35\t\t\t{\"hold\", []string{done, labels.Hold}, false, \"engineer\", fSkip, rGuarded, \"\"},\n36\t\t\t{\"executor failed\", []string{done, labels.ExecutorFailed}, false, \"engineer\", fSkip, rGuarded, \"\"},\n37\t\t\t{\"worker requested\", []string{done, \"ard:worker:engineer\"}, false, \"engineer\", fSkip, rWorkerStarted, \"\"},\n38\t\t\t{\"worker running\", []string{done, \"ard:worker:engineer:running\"}, false, \"engineer\", fSkip, rWorkerStarted, \"\"},\n39\t\t\t{\"fix round, worker done only\", []string{done, \"ard:worker:engineer:done\"}, false, \"engineer\", fSkip, rWorkerStarted, \"\"},\n40\t\t\t{\"lead re-requested\", []string{done, labels.Pending}, false, \"engineer\", fSkip, rLeadRequested, \"\"},\n41\t\t\t{\"busy\", []string{done}, true, \"engineer\", fWait, rTriageRunning, \"\"},\n42\t\t\t{\"triage label running\", []string{done, \"ard:triage:architect\", \"ard:triage:architect:running\"}, false, \"engineer\", fWait, rTriageRunning, \"\"},\n43\t\t\t{\"requested role not done\", []string{done, \"ard:triage:architect\"}, false, \"engineer\", fWait, rWaiting, \"architect\"},\n44\t\t\t{\"mixed case request\", []string{done, \"ARD:Triage:Architect\"}, false, \"engineer\", fWait, rWaiting, \"architect\"},\n45\t\t\t{\"requested role done\", []string{done, \"ard:triage:architect\", \"ard:triage:architect:done\"}, false, \"engineer\", fReady, rReady, \"\"},\n46\t\t\t{\"unknown role\", []string{done, \"ard:triage:ghost\"}, false, \"engineer\", fHuman, rUnknownRole, \"ghost\"},\n47\t\t\t{\"unknown wins over waiting\", []string{done, \"ard:triage:architect\", \"ard:triage:ghost\"}, false, \"engineer\", fHuman, rUnknownRole, \"ghost\"},\n48\t\t\t{\"no worker\", []string{done}, false, \"\", fHuman, rNoWorker, \"\"},\n49\t\t\t{\"worker gone\", []string{done}, false, \"docs\", fHuman, rWorkerGone, \"\"},\n50\t\t\t{\"lead only, valid worker\", []string{done}, false, \"engineer\", fReady, rReady, \"\"},\n51\t\t}\n52\t\tfor _, tc := range tests {\n53\t\t\tt.Run(tc.name, func(t *testing.T) {\n54\t\t\t\tgot := decideFanIn(fanInInput{Labels: tc.labels, Triage: triage, Workers: workers, Busy: tc.busy, Worker: tc.worker})\n55\t\t\t\tif got.Verdict != tc.want || got.Reason != tc.reason || got.Role != tc.role {\n56\t\t\t\t\tt.Errorf(\"got %+v, want %v %s %s\", got, tc.want, tc.reason, tc.role)\n57\t\t\t\t}\n58\t\t\t\tif got.Verdict == fReady && got.Worker != tc.worker {\n59\t\t\t\t\tt.Errorf(\"worker = %q\", got.Worker)\n60\t\t\t\t}\n61\t\t\t})\n62\t\t}\n63\t}\n64\t\n65\tfunc TestApprovalEvent(t *testing.T) {\n66\t\tev := func(kind, label, actor string, min int) github.TimelineEvent {\n67\t\t\treturn github.TimelineEvent{Event: kind, Label: label, Actor: actor, CreatedAt: t0.Add(time.Duration(min) * time.Minute)}\n68\t\t}\n69\t\ttests := []struct {\n70\t\t\tname  string\n71\t\t\ttl    []github.TimelineEvent\n72\t\t\tactor string\n73\t\t\tok    bool\n74\t\t}{\n75\t\t\t{\"none\", nil, \"\", false},\n76\t\t\t{\"one labeled\", []github.TimelineEvent{ev(\"labeled\", labels.Approved, \"a\", 1)}, \"a\", true},\n77\t\t\t{\"labeled then unlabeled\", []github.TimelineEvent{ev(\"labeled\", labels.Approved, \"a\", 1), ev(\"unlabeled\", labels.Approved, \"a\", 2)}, \"\", false},\n78\t\t\t{\"relabeled takes the latest\", []github.TimelineEvent{ev(\"labeled\", labels.Approved, \"a\", 1), ev(\"unlabeled\", labels.Approved, \"a\", 2), ev(\"labeled\", labels.Approved, \"b\", 3)}, \"b\", true},\n79\t\t\t{\"other labels ignored\", []github.TimelineEvent{ev(\"labeled\", labels.Approved, \"a\", 1), ev(\"labeled\", labels.Hold, \"b\", 2), ev(\"unlabeled\", labels.Hold, \"b\", 3)}, \"a\", true},\n80\t\t}\n81\t\tfor _, tc := range tests {\n82\t\t\tt.Run(tc.name, func(t *testing.T) {\n83\t\t\t\tgot, ok := approvalEvent(tc.tl)\n84\t\t\t\tif ok != tc.ok || got.Actor != tc.actor {\n85\t\t\t\t\tt.Errorf(\"got %q %v\", got.Actor, ok)\n86\t\t\t\t}\n87\t\t\t})\n88\t\t}\n89\t}\n90\t\n91\tfunc TestLastTriageDone(t *testing.T) {\n92\t\ttl := []github.TimelineEvent{\n93\t\t\t{Event: \"labeled\", Label: \"ard:triage:lead:done\", CreatedAt: t0.Add(time.Minute)},\n94\t\t\t{Event: \"labeled\", Label: \"ard:triage:engineer:done\", CreatedAt: t0.Add(3 * time.Minute)},\n95\t\t\t{Event: \"labeled\", Label: \"ard:worker:engineer:done\", CreatedAt: t0.Add(9 * time.Minute)},\n96\t\t\t{Event: \"unlabeled\", Label: \"ard:triage:architect:done\", CreatedAt: t0.Add(7 * time.Minute)},\n97\t\t}\n98\t\tif at, ok := lastTriageDone(tl); !ok || !at.Equal(t0.Add(3*time.Minute)) {\n99\t\t\tt.Errorf(\"got %v %v\", at, ok)\n100\t\t}\n101\t\tif _, ok := lastTriageDone(nil); ok {\n102\t\t\tt.Error(\"empty timeline has no done\")\n103\t\t}\n104\t}\n105\t\n106\t// gateHarness is a harness with a worker role engineer, an engineer triage role\n107\t// and require_approval as given.\n108\tfunc gateHarness(t *testing.T, approval bool, opts ...option) *harness {\n109\t\tt.Helper()\n110\t\th := newHarness(t, opts...)\n111\t\th.cfg.RequireApproval = approval\n112\t\th.cfg.Roles = append(h.cfg.Roles,\n113\t\t\tconfig.Role{Kind: config.KindWorker, Name: \"engineer\", Dir: \".ard/workers/engineer\", Agent: \"claude\", Timeout: time.Minute},\n114\t\t\tconfig.Role{Kind: config.KindTriage, Name: \"engineer\", Dir: \".ard/triage/engineer\", Agent: \"claude\", Timeout: time.Minute})\n115\t\treturn h\n116\t}\n117\t\n118\tvar (\n119\t\tleadDone = labels.Done(labels.StageTriage, \"lead\")\n120\t\ttDone    = t0.Add(time.Hour) // when the last triage :done was added\n121\t)\n122\t\n123\t// seedLead records the lead's closed close-out with the given worker.\n124\tfunc (h *harness) seedLead(n int, worker string) string {\n125\t\th.t.Helper()\n126\t\tctx := context.Background()\n127\t\tj, err := h.store.CreateJob(ctx, state.NewJob{Stage: \"triage\", Role: \"lead\", Issue: n})\n128\t\tif err != nil {\n129\t\t\th.t.Fatal(err)\n130\t\t}\n131\t\trec, _ := json.Marshal(closeout.Record{Version: 1, Phase: closeout.PhaseClosed,\n132\t\t\tJob:  closeout.Job{ID: j.ID, Issue: n, Stage: \"triage\", Role: \"lead\"},\n133\t\t\tPlan: closeout.Plan{Outcome: closeout.OutcomeDone, Worker: worker}})\n134\t\tif err := h.store.SetCloseout(ctx, j.ID, \"closed\", rec); err != nil {\n135\t\t\th.t.Fatal(err)\n136\t\t}\n137\t\tif err := h.store.Complete(ctx, j.ID, nil); err != nil {\n138\t\t\th.t.Fatal(err)\n139\t\t}\n140\t\treturn j.ID\n141\t}\n142\t\n143\t// ready seeds an App-authored issue whose triage is finished, with the lead's\n144\t// close-out naming engineer.\n145\tfunc (h *harness) ready(extra ...string) int {\n146\t\th.t.Helper()\n147\t\tn := h.gh.SeedIssue(github.Issue{Title: \"t\", Body: \"b\", Author: self, Labels: append([]string{leadDone}, extra...), CreatedAt: t0, UpdatedAt: t0})\n148\t\th.gh.SeedTimeline(n, github.TimelineEvent{Event: \"labeled\", Label: leadDone, Actor: self, CreatedAt: tDone})\n149\t\th.seedLead(n, \"engineer\")\n150\t\treturn n\n151\t}\n152\t\n153\tfunc (h *harness) events(kind string) []state.Event {\n154\t\th.t.Helper()\n155\t\tes, err := h.store.Events(context.Background(), state.EventFilter{Kind: kind})\n156\t\tif err != nil {\n157\t\t\th.t.Fatal(err)\n158\t\t}\n159\t\treturn es\n160\t}\n161\t\n162\tfunc (h *harness) writes() int { return len(h.gh.Writes()) }\n163\t\n164\tfunc commentsWith(h *harness, n int, sub string) int {\n165\t\tc := 0\n166\t\tfor _, cm := range h.comments(n) {\n167\t\t\tif strings.Contains(cm.Body, sub) {\n168\t\t\t\tc++\n169\t\t\t}\n170\t\t}\n171\t\treturn c\n172\t}\n173\t\n174\tfunc TestGateStartsWorker(t *testing.T) {\n175\t\th := gateHarness(t, false)\n176\t\tn := h.ready(\"ard:triage:engineer\", \"ard:triage:engineer:done\")\n177\t\th.mustTick()\n178\t\tif !h.has(n, \"ard:worker:engineer\") {\n179\t\t\tt.Fatalf(\"worker not requested: %v\", h.issue(n).Labels)\n180\t\t}\n181\t\tif es := h.events(state.EventGate); len(es) != 1 || !strings.Contains(string(es[0].Data), `\"verdict\":\"start\"`) {\n182\t\t\tt.Errorf(\"events = %+v\", es)\n183\t\t}\n184\t\tw := h.writes()\n185\t\th.mustTick()\n186\t\tif h.writes() != w {\n187\t\t\tt.Errorf(\"second tick wrote: %v\", h.gh.Writes()[w:])\n188\t\t}\n189\t}\n190\t\n191\tfunc TestGateWaits(t *testing.T) {\n192\t\ttests := []struct {\n193\t\t\tname  string\n194\t\t\textra []string\n195\t\t\tsetup func(*harness, int)\n196\t\t}{\n197\t\t\t{\"engineer requested, not done\", []string{\"ard:triage:engineer\"}, nil},\n198\t\t\t{\"triage running label\", []string{\"ard:triage:engineer:running\"}, nil},\n199\t\t\t{\"triage job running in state\", nil, func(h *harness, n int) {\n200\t\t\t\tif _, err := h.store.CreateJob(context.Background(), state.NewJob{Stage: \"triage\", Role: \"engineer\", Issue: n}); err != nil {\n201\t\t\t\t\tt.Fatal(err)\n202\t\t\t\t}\n203\t\t\t}},\n204\t\t}\n205\t\tfor _, tc := range tests {\n206\t\t\tt.Run(tc.name, func(t *testing.T) {\n207\t\t\t\th := gateHarness(t, false)\n208\t\t\t\tn := h.ready(tc.extra...)\n209\t\t\t\tif tc.setup != nil {\n210\t\t\t\t\ttc.setup(h, n)\n211\t\t\t\t}\n212\t\t\t\th.mustTick()\n213\t\t\t\t// A triage claim of a requested role may write; the gate must not.\n214\t\t\t\tif h.has(n, \"ard:worker:engineer\") || h.has(n, labels.NeedsHuman) || len(h.comments(n)) != 0 {\n215\t\t\t\t\tt.Errorf(\"gate acted: %v\", h.gh.Writes())\n216\t\t\t\t}\n217\t\t\t})\n218\t\t}\n219\t}\n220\t\n221\tfunc TestGateApproval(t *testing.T) {\n222\t\t// The approved label is seeded with the issue, with a timeline event at a\n223\t\t// chosen time.\n224\t\tseeded := func(h *harness, actor, role string, at time.Time) int {\n225\t\t\tn := h.ready(labels.Approved)\n226\t\t\th.labelledBy(n, labels.Approved, actor, role, at)\n227\t\t\treturn n\n228\t\t}\n229\t\tafter := tDone.Add(time.Minute)\n230\t\n231\t\tt.Run(\"no approval posts one comment and waits\", func(t *testing.T) {\n232\t\t\th := gateHarness(t, true)\n233\t\t\tn := h.ready()\n234\t\t\th.mustTick()\n235\t\t\th.mustTick()\n236\t\t\tif h.has(n, \"ard:worker:engineer\") || commentsWith(h, n, \"ready for approval\") != 1 {\n237\t\t\t\tt.Errorf(\"labels %v, comments %d\", h.issue(n).Labels, commentsWith(h, n, \"ready for approval\"))\n238\t\t\t}\n239\t\t\tif len(h.events(state.EventGate)) != 0 {\n240\t\t\t\tt.Error(\"waiting recorded an event\")\n241\t\t\t}\n242\t\t})\n243\t\tt.Run(\"approved by a triage collaborator after triage\", func(t *testing.T) {\n244\t\t\th := gateHarness(t, true)\n245\t\t\tn := seeded(h, \"maint\", \"triage\", after)\n246\t\t\th.mustTick()\n247\t\t\tif !h.has(n, \"ard:worker:engineer\") {\n248\t\t\t\tt.Errorf(\"labels %v\", h.issue(n).Labels)\n249\t\t\t}\n250\t\t})\n251\t\tt.Run(\"approval before the last triage done is stale: wait, no escalation\", func(t *testing.T) {\n252\t\t\th := gateHarness(t, true)\n253\t\t\tn := seeded(h, \"maint\", \"triage\", tDone.Add(-time.Minute))\n254\t\t\th.mustTick()\n255\t\t\th.mustTick()\n256\t\t\tif h.has(n, \"ard:worker:engineer\") || h.has(n, labels.NeedsHuman) || !h.has(n, labels.Approved) {\n257\t\t\t\tt.Errorf(\"labels %v\", h.issue(n).Labels)\n258\t\t\t}\n259\t\t\tif c := commentsWith(h, n, \"ready for approval\"); c != 1 {\n260\t\t\t\tt.Errorf(\"ready comments = %d\", c)\n261\t\t\t}\n262\t\t})\n263\t\tt.Run(\"a newer done label missing from the timeline waits\", func(t *testing.T) {\n264\t\t\th := gateHarness(t, true)\n265\t\t\t// Two :done labels on the issue, only the older one in the timeline.\n266\t\t\tn := h.ready(labels.Approved, \"ard:triage:engineer:done\")\n267\t\t\th.labelledBy(n, labels.Approved, \"maint\", \"triage\", after)\n268\t\t\th.mustTick()\n269\t\t\tif h.has(n, \"ard:worker:engineer\") {\n270\t\t\t\tt.Error(\"started\")\n271\t\t\t}\n272\t\t})\n273\t\tt.Run(\"approval at the same instant as triage done is stale\", func(t *testing.T) {\n274\t\t\th := gateHarness(t, true)\n275\t\t\tn := seeded(h, \"maint\", \"triage\", tDone)\n276\t\t\th.mustTick()\n277\t\t\tif h.has(n, \"ard:worker:engineer\") {\n278\t\t\t\tt.Error(\"started\")\n279\t\t\t}\n280\t\t})\n281\t\tt.Run(\"a read-only approver is refused, login not named\", func(t *testing.T) {\n282\t\t\th := gateHarness(t, true)\n283\t\t\tn := seeded(h, \"rando\", \"read\", after)\n284\t\t\th.mustTick()\n285\t\t\th.mustTick()\n286\t\t\tif !h.has(n, labels.NeedsHuman) || h.has(n, \"ard:worker:engineer\") {\n287\t\t\t\tt.Errorf(\"labels %v\", h.issue(n).Labels)\n288\t\t\t}\n289\t\t\tif commentsWith(h, n, \"was not added by a maintainer\") != 1 || commentsWith(h, n, \"rando\") != 0 {\n290\t\t\t\tt.Errorf(\"comments = %+v\", h.comments(n))"}]},"parent_tool_use_id":null,"session_id":"16ee025c-fa9f-459a-ab5e-88271e950e26","uuid":"853db9cf-e417-4588-9c83-a9795f5262ff","timestamp":"2026-11-23T17:40:38.499Z","tool_use_result":{"type":"text","file":{"filePath":"/work/internal/triage/fanin_test.go","content":"package triage\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/agentjob\"\n\t\"github.com/albertcbrown/ard/internal/closeout\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/costblock\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\nfunc TestDecideFanIn(t *testing.T) {\n\ttriage := map[string]bool{\"lead\": true, \"architect\": true, \"engineer\": true}\n\tworkers := map[string]bool{\"engineer\": true}\n\tdone := labels.Done(labels.StageTriage, \"lead\")\n\ttests := []struct {\n\t\tname   string\n\t\tlabels []string\n\t\tbusy   bool\n\t\tworker string\n\t\twant   fanInVerdict\n\t\treason string\n\t\trole   string\n\t}{\n\t\t{\"lead not done\", []string{\"ard:triage:architect:done\"}, false, \"engineer\", fSkip, rLeadNotDone, \"\"},\n\t\t{\"needs-human\", []string{done, labels.NeedsHuman}, false, \"engineer\", fSkip, rGuarded, \"\"},\n\t\t{\"hold\", []string{done, labels.Hold}, false, \"engineer\", fSkip, rGuarded, \"\"},\n\t\t{\"executor failed\", []string{done, labels.ExecutorFailed}, false, \"engineer\", fSkip, rGuarded, \"\"},\n\t\t{\"worker requested\", []string{done, \"ard:worker:engineer\"}, false, \"engineer\", fSkip, rWorkerStarted, \"\"},\n\t\t{\"worker running\", []string{done, \"ard:worker:engineer:running\"}, false, \"engineer\", fSkip, rWorkerStarted, \"\"},\n\t\t{\"fix round, worker done only\", []string{done, \"ard:worker:engineer:done\"}, false, \"engineer\", fSkip, rWorkerStarted, \"\"},\n\t\t{\"lead re-requested\", []string{done, labels.Pending}, false, \"engineer\", fSkip, rLeadRequested, \"\"},\n\t\t{\"busy\", []string{done}, true, \"engineer\", fWait, rTriageRunning, \"\"},\n\t\t{\"triage label running\", []string{done, \"ard:triage:architect\", \"ard:triage:architect:running\"}, false, \"engineer\", fWait, rTriageRunning, \"\"},\n\t\t{\"requested role not done\", []string{done, \"ard:triage:architect\"}, false, \"engineer\", fWait, rWaiting, \"architect\"},\n\t\t{\"mixed case request\", []string{done, \"ARD:Triage:Architect\"}, false, \"engineer\", fWait, rWaiting, \"architect\"},\n\t\t{\"requested role done\", []string{done, \"ard:triage:architect\", \"ard:triage:architect:done\"}, false, \"engineer\", fReady, rReady, \"\"},\n\t\t{\"unknown role\", []string{done, \"ard:triage:ghost\"}, false, \"engineer\", fHuman, rUnknownRole, \"ghost\"},\n\t\t{\"unknown wins over waiting\", []string{done, \"ard:triage:architect\", \"ard:triage:ghost\"}, false, \"engineer\", fHuman, rUnknownRole, \"ghost\"},\n\t\t{\"no worker\", []string{done}, false, \"\", fHuman, rNoWorker, \"\"},\n\t\t{\"worker gone\", []string{done}, false, \"docs\", fHuman, rWorkerGone, \"\"},\n\t\t{\"lead only, valid worker\", []string{done}, false, \"engineer\", fReady, rReady, \"\"},\n\t}\n\tfor _, tc := range tests {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tgot := decideFanIn(fanInInput{Labels: tc.labels, Triage: triage, Workers: workers, Busy: tc.busy, Worker: tc.worker})\n\t\t\tif got.Verdict != tc.want || got.Reason != tc.reason || got.Role != tc.role {\n\t\t\t\tt.Errorf(\"got %+v, want %v %s %s\", got, tc.want, tc.reason, tc.role)\n\t\t\t}\n\t\t\tif got.Verdict == fReady && got.Worker != tc.worker {\n\t\t\t\tt.Errorf(\"worker = %q\", got.Worker)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestApprovalEvent(t *testing.T) {\n\tev := func(kind, label, actor string, min int) github.TimelineEvent {\n\t\treturn github.TimelineEvent{Event: kind, Label: label, Actor: actor, CreatedAt: t0.Add(time.Duration(min) * time.Minute)}\n\t}\n\ttests := []struct {\n\t\tname  string\n\t\ttl    []github.TimelineEvent\n\t\tactor string\n\t\tok    bool\n\t}{\n\t\t{\"none\", nil, \"\", false},\n\t\t{\"one labeled\", []github.TimelineEvent{ev(\"labeled\", labels.Approved, \"a\", 1)}, \"a\", true},\n\t\t{\"labeled then unlabeled\", []github.TimelineEvent{ev(\"labeled\", labels.Approved, \"a\", 1), ev(\"unlabeled\", labels.Approved, \"a\", 2)}, \"\", false},\n\t\t{\"relabeled takes the latest\", []github.TimelineEvent{ev(\"labeled\", labels.Approved, \"a\", 1), ev(\"unlabeled\", labels.Approved, \"a\", 2), ev(\"labeled\", labels.Approved, \"b\", 3)}, \"b\", true},\n\t\t{\"other labels ignored\", []github.TimelineEvent{ev(\"labeled\", labels.Approved, \"a\", 1), ev(\"labeled\", labels.Hold, \"b\", 2), ev(\"unlabeled\", labels.Hold, \"b\", 3)}, \"a\", true},\n\t}\n\tfor _, tc := range tests {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tgot, ok := approvalEvent(tc.tl)\n\t\t\tif ok != tc.ok || got.Actor != tc.actor {\n\t\t\t\tt.Errorf(\"got %q %v\", got.Actor, ok)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestLastTriageDone(t *testing.T) {\n\ttl := []github.TimelineEvent{\n\t\t{Event: \"labeled\", Label: \"ard:triage:lead:done\", CreatedAt: t0.Add(time.Minute)},\n\t\t{Event: \"labeled\", Label: \"ard:triage:engineer:done\", CreatedAt: t0.Add(3 * time.Minute)},\n\t\t{Event: \"labeled\", Label: \"ard:worker:engineer:done\", CreatedAt: t0.Add(9 * time.Minute)},\n\t\t{Event: \"unlabeled\", Label: \"ard:triage:architect:done\", CreatedAt: t0.Add(7 * time.Minute)},\n\t}\n\tif at, ok := lastTriageDone(tl); !ok || !at.Equal(t0.Add(3*time.Minute)) {\n\t\tt.Errorf(\"got %v %v\", at, ok)\n\t}\n\tif _, ok := lastTriageDone(nil); ok {\n\t\tt.Error(\"empty timeline has no done\")\n\t}\n}\n\n// gateHarness is a harness with a worker role engineer, an engineer triage role\n// and require_approval as given.\nfunc gateHarness(t *testing.T, approval bool, opts ...option) *harness {\n\tt.Helper()\n\th := newHarness(t, opts...)\n\th.cfg.RequireApproval = approval\n\th.cfg.Roles = append(h.cfg.Roles,\n\t\tconfig.Role{Kind: config.KindWorker, Name: \"engineer\", Dir: \".ard/workers/engineer\", Agent: \"claude\", Timeout: time.Minute},\n\t\tconfig.Role{Kind: config.KindTriage, Name: \"engineer\", Dir: \".ard/triage/engineer\", Agent: \"claude\", Timeout: time.Minute})\n\treturn h\n}\n\nvar (\n\tleadDone = labels.Done(labels.StageTriage, \"lead\")\n\ttDone    = t0.Add(time.Hour) // when the last triage :done was added\n)\n\n// seedLead records the lead's closed close-out with the given worker.\nfunc (h *harness) seedLead(n int, worker string) string {\n\th.t.Helper()\n\tctx := context.Background()\n\tj, err := h.store.CreateJob(ctx, state.NewJob{Stage: \"triage\", Role: \"lead\", Issue: n})\n\tif err != nil {\n\t\th.t.Fatal(err)\n\t}\n\trec, _ := json.Marshal(closeout.Record{Version: 1, Phase: closeout.PhaseClosed,\n\t\tJob:  closeout.Job{ID: j.ID, Issue: n, Stage: \"triage\", Role: \"lead\"},\n\t\tPlan: closeout.Plan{Outcome: closeout.OutcomeDone, Worker: worker}})\n\tif err := h.store.SetCloseout(ctx, j.ID, \"closed\", rec); err != nil {\n\t\th.t.Fatal(err)\n\t}\n\tif err := h.store.Complete(ctx, j.ID, nil); err != nil {\n\t\th.t.Fatal(err)\n\t}\n\treturn j.ID\n}\n\n// ready seeds an App-authored issue whose triage is finished, with the lead's\n// close-out naming engineer.\nfunc (h *harness) ready(extra ...string) int {\n\th.t.Helper()\n\tn := h.gh.SeedIssue(github.Issue{Title: \"t\", Body: \"b\", Author: self, Labels: append([]string{leadDone}, extra...), CreatedAt: t0, UpdatedAt: t0})\n\th.gh.SeedTimeline(n, github.TimelineEvent{Event: \"labeled\", Label: leadDone, Actor: self, CreatedAt: tDone})\n\th.seedLead(n, \"engineer\")\n\treturn n\n}\n\nfunc (h *harness) events(kind string) []state.Event {\n\th.t.Helper()\n\tes, err := h.store.Events(context.Background(), state.EventFilter{Kind: kind})\n\tif err != nil {\n\t\th.t.Fatal(err)\n\t}\n\treturn es\n}\n\nfunc (h *harness) writes() int { return len(h.gh.Writes()) }\n\nfunc commentsWith(h *harness, n int, sub string) int {\n\tc := 0\n\tfor _, cm := range h.comments(n) {\n\t\tif strings.Contains(cm.Body, sub) {\n\t\t\tc++\n\t\t}\n\t}\n\treturn c\n}\n\nfunc TestGateStartsWorker(t *testing.T) {\n\th := gateHarness(t, false)\n\tn := h.ready(\"ard:triage:engineer\", \"ard:triage:engineer:done\")\n\th.mustTick()\n\tif !h.has(n, \"ard:worker:engineer\") {\n\t\tt.Fatalf(\"worker not requested: %v\", h.issue(n).Labels)\n\t}\n\tif es := h.events(state.EventGate); len(es) != 1 || !strings.Contains(string(es[0].Data), `\"verdict\":\"start\"`) {\n\t\tt.Errorf(\"events = %+v\", es)\n\t}\n\tw := h.writes()\n\th.mustTick()\n\tif h.writes() != w {\n\t\tt.Errorf(\"second tick wrote: %v\", h.gh.Writes()[w:])\n\t}\n}\n\nfunc TestGateWaits(t *testing.T) {\n\ttests := []struct {\n\t\tname  string\n\t\textra []string\n\t\tsetup func(*harness, int)\n\t}{\n\t\t{\"engineer requested, not done\", []string{\"ard:triage:engineer\"}, nil},\n\t\t{\"triage running label\", []string{\"ard:triage:engineer:running\"}, nil},\n\t\t{\"triage job running in state\", nil, func(h *harness, n int) {\n\t\t\tif _, err := h.store.CreateJob(context.Background(), state.NewJob{Stage: \"triage\", Role: \"engineer\", Issue: n}); err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t}},\n\t}\n\tfor _, tc := range tests {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\th := gateHarness(t, false)\n\t\t\tn := h.ready(tc.extra...)\n\t\t\tif tc.setup != nil {\n\t\t\t\ttc.setup(h, n)\n\t\t\t}\n\t\t\th.mustTick()\n\t\t\t// A triage claim of a requested role may write; the gate must not.\n\t\t\tif h.has(n, \"ard:worker:engineer\") || h.has(n, labels.NeedsHuman) || len(h.comments(n)) != 0 {\n\t\t\t\tt.Errorf(\"gate acted: %v\", h.gh.Writes())\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestGateApproval(t *testing.T) {\n\t// The approved label is seeded with the issue, with a timeline event at a\n\t// chosen time.\n\tseeded := func(h *harness, actor, role string, at time.Time) int {\n\t\tn := h.ready(labels.Approved)\n\t\th.labelledBy(n, labels.Approved, actor, role, at)\n\t\treturn n\n\t}\n\tafter := tDone.Add(time.Minute)\n\n\tt.Run(\"no approval posts one comment and waits\", func(t *testing.T) {\n\t\th := gateHarness(t, true)\n\t\tn := h.ready()\n\t\th.mustTick()\n\t\th.mustTick()\n\t\tif h.has(n, \"ard:worker:engineer\") || commentsWith(h, n, \"ready for approval\") != 1 {\n\t\t\tt.Errorf(\"labels %v, comments %d\", h.issue(n).Labels, commentsWith(h, n, \"ready for approval\"))\n\t\t}\n\t\tif len(h.events(state.EventGate)) != 0 {\n\t\t\tt.Error(\"waiting recorded an event\")\n\t\t}\n\t})\n\tt.Run(\"approved by a triage collaborator after triage\", func(t *testing.T) {\n\t\th := gateHarness(t, true)\n\t\tn := seeded(h, \"maint\", \"triage\", after)\n\t\th.mustTick()\n\t\tif !h.has(n, \"ard:worker:engineer\") {\n\t\t\tt.Errorf(\"labels %v\", h.issue(n).Labels)\n\t\t}\n\t})\n\tt.Run(\"approval before the last triage done is stale: wait, no escalation\", func(t *testing.T) {\n\t\th := gateHarness(t, true)\n\t\tn := seeded(h, \"maint\", \"triage\", tDone.Add(-time.Minute))\n\t\th.mustTick()\n\t\th.mustTick()\n\t\tif h.has(n, \"ard:worker:engineer\") || h.has(n, labels.NeedsHuman) || !h.has(n, labels.Approved) {\n\t\t\tt.Errorf(\"labels %v\", h.issue(n).Labels)\n\t\t}\n\t\tif c := commentsWith(h, n, \"ready for approval\"); c != 1 {\n\t\t\tt.Errorf(\"ready comments = %d\", c)\n\t\t}\n\t})\n\tt.Run(\"a newer done label missing from the timeline waits\", func(t *testing.T) {\n\t\th := gateHarness(t, true)\n\t\t// Two :done labels on the issue, only the older one in the timeline.\n\t\tn := h.ready(labels.Approved, \"ard:triage:engineer:done\")\n\t\th.labelledBy(n, labels.Approved, \"maint\", \"triage\", after)\n\t\th.mustTick()\n\t\tif h.has(n, \"ard:worker:engineer\") {\n\t\t\tt.Error(\"started\")\n\t\t}\n\t})\n\tt.Run(\"approval at the same instant as triage done is stale\", func(t *testing.T) {\n\t\th := gateHarness(t, true)\n\t\tn := seeded(h, \"maint\", \"triage\", tDone)\n\t\th.mustTick()\n\t\tif h.has(n, \"ard:worker:engineer\") {\n\t\t\tt.Error(\"started\")\n\t\t}\n\t})\n\tt.Run(\"a read-only approver is refused, login not named\", func(t *testing.T) {\n\t\th := gateHarness(t, true)\n\t\tn := seeded(h, \"rando\", \"read\", after)\n\t\th.mustTick()\n\t\th.mustTick()\n\t\tif !h.has(n, labels.NeedsHuman) || h.has(n, \"ard:worker:engineer\") {\n\t\t\tt.Errorf(\"labels %v\", h.issue(n).Labels)\n\t\t}\n\t\tif commentsWith(h, n, \"was not added by a maintainer\") != 1 || commentsWith(h, n, \"rando\") != 0 {\n\t\t\tt.Errorf(\"comments = %+v\", h.comments(n))","numLines":290,"startLine":1,"totalLines":484}},"tool_result_meta":[{"id":"toolu_01F1kEVi1tkKoZEqsjbMU6Ca","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
