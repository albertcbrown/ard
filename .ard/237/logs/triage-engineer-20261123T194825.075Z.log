ontext, issue int) ([]state.Job, error)\n\tIssueUsage(ctx context.Context, issue int) (map[string]state.JobUsage, error)\n}\n\n// Reader reads an issue (github.Reader).\ntype Reader interface {\n\tGetIssue(ctx context.Context, n int) (github.Issue, error)\n}\n\n// Effects is the subset of effects.Effects the loop uses: its only write.\ntype Effects interface {\n\tUpdateIssueBody(ctx context.Context, n int, body string) error\n\tDryRun() bool\n}\n\n// Deps are the loop's dependencies.\ntype Deps struct {\n\tStore   Store\n\tReader  Reader\n\tEffects Effects\n\tRepo    github.Repo\n\t// Locks is shared with the scanner pipeline: one body writer per issue.\n\tLocks *costblock.Locks\n\tLog   *slog.Logger\n\tNow   func() time.Time\n}\n\n// Loop implements controller.Loop.\ntype Loop struct{ d Deps }\n\n// New returns the costs loop.\nfunc New(d Deps) *Loop { return &Loop{d: d} }\n\n// Name implements controller.Loop.\nfunc (*Loop) Name() string { return \"costs\" }\n\n// Interval implements controller.Loop.\nfunc (*Loop) Interval(*config.Resolved) time.Duration { return Interval }\n\ninternal/controller/loop.go:21:type Loop interface {\ninternal/controller/loop.go-22-\t// Name is unique across loops: \"scanners\", \"triage\", \"workers\",\ninternal/controller/loop.go-23-\t// \"reviewers\", \"merger\", \"reaper\", ...\ninternal/controller/loop.go-24-\tName() string\ninternal/controller/loop.go-25-\t// Interval is read before every wait, so reloaded config applies.\ninternal/controller/loop.go-26-\tInterval(cfg *config.Resolved) time.Duration\ninternal/controller/loop.go-27-\t// Claims reports whether the loop starts work or writes to GitHub (claims,\ninternal/controller/loop.go-28-\t// scanner filing and autoclose, stale closes, merges); such loops are\ninternal/controller/loop.go-29-\t// skipped while the controller is paused. The Reaper and the costs loop (bookkeeping about work already done) return false.\ninternal/controller/loop.go-30-\tClaims() bool\ninternal/contro