l. No concurrency primitives beyond the existing `initMu` and the gate's own mutex for the logged-once map.\n\n### Size\nL (about 600 lines, as the issue says). Files: `internal/state/migrations/0007_budget.sql`, `internal/state/testdata/schema.golden`, `internal/state/usage.go`, `internal/state/usage_test.go`, `internal/config/types.go` (or `budget.go`), its test, `internal/pool/pool.go`, `internal/pool/pool_test.go`, `internal/budget/budget.go`, `internal/budget/budget_test.go`, `internal/servecmd/adopt.go`, `internal/servecmd/reaping.go` or `budget.go`, `internal/servecmd/serve.go`, `internal/servecmd/budget_test.go`, `CLAUDE.md`, `docs/proposal.md`.\npackage servecmd\n\nimport (\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/budget\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n)\n\n// budgetGate returns the one daily-budget gate of this process, built on first\n// use from the store and the latest loaded config.\nfunc (w *wiring) budgetGate() *budget.Gate {\n\tw.initMu.Lock()\n\tdefer w.initMu.Unlock()\n\tif w.bgt == nil {\n\t\tnow := w.budgetNow\n\t\tif now == nil {\n\t\t\tnow = time.Now\n\t\t}\n\t\tw.bgt = budget.New(w.Store, func() *config.Resolved { return w.cfg.Load() }, now, w.Log)\n\t}\n\treturn w.bgt\n}\n     119 internal/budget/budget.go\n     160 internal/state/events.go\n     279 total\n24:type SpendReader interface {\n29:type Gate struct {\n42:func New(store SpendReader, cfg func() *config.Resolved, now func() time.Time, log *slog.Logger) *Gate {\n52:func kindOf(c pool.Class) (config.Kind, string, bool) {\n67:func (g *Gate) Denied(c pool.Candidate) (bool, string) {\n102:func (g *Gate) capped(dayStart time.Time, scope, role string, sp state.Spend, limit float64) string {\n13:// Event kinds.\n15:\tEventClaim    = \"claim\"\n16:\tEventCloseout = \"closeout\"\n17:\tEventFailure  = \"failure\"\n18:\tEventRetry    = \"retry\"\n19:\t// EventUsageLimit: a job stopped at a usage limit. It is not a failure.\n20:\tEventUsageLimit = \"usage_limit\"\n21:\t// EventKill: the Reaper is about to kill a running job; data has the reason.\n22:\tEventKill      = \"kill\"\n23:\tEventTickError = \"tick_error\"\n24:\t// EventHostUntrusted: a host-mode job of a role that reads untrusted\n26:\tEventHostUntrusted = \"host_untrusted\"\n27:\t// EventGate: the triage fan-in gate acted; data has verdict, reason and worker.\n28:\tEventGate = \"gate\"\n29:\t// EventMerge: the merger squash-merged a PR; data has pr, head and merge_sha.\n30:\tEventMerge = \"merge\"\n31:\t// EventReviewRound: a review fix round changed phase; data has round, phase, reason, pr, head, worker and roles.\n32:\tEventReviewRound = \"review_round\"\n35:// Event is one row of the append-only event log. Data holds structured fields\n37:type Event struct {\n40:\tKind  string\n48:// EventFilter selects events; zero values are unbounded.\n49:type EventFilter struct {\n51:\tKind         string\n61:func insertEvent(ctx context.Context, x execer, e Event) error {\n63:\t\treturn fmt.Errorf(\"event %s: data is not valid JSON\", e.Kind)\n84:\t\tVALUES(?,?,?,?,?,?,?)`, e.At.Unix(), e.Kind, job, issue, stage, role, data); err != nil {\n85:\t\treturn fmt.Errorf(\"append event %s: %w\", e.Kind, err)\n90:// AppendEvent appends e; a zero At means now.\n91:func (s *Store) AppendEvent(ctx context.Context, e Event) error {\n92:\tif e.Kind == \"\" {\n98:\treturn insertEvent(ctx, s.db, e)\n101:// Events returns matching events in ascending id order.\n102:func (s *Store) Events(ctx context.Context, f EventFilter) ([]Event, error) {\n113:\tif f.Kind != \"\" {\n115:\t\targs = append(args, f.Kind)\n139:\tvar out []Event\n141:\t\tvar e Event\n145:\t\tif err := rows.Scan(&e.ID, &ts, &e.Kind, &job, &issue, &stage, &role, &data); err != nil {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01LiRYjsWt8WyfbNkmEczsAk","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
