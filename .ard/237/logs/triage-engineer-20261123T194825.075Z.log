{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YV5GKxsdAwKboP3fFow6DN","type":"tool_result","content":"// Package effects is the only place that writes to GitHub or git. Effects\n// embeds github.Writer unchanged, so the method set covers every GitHub write\n// by construction: if the Writer grows a method, both implementations stop\n// compiling until they handle it.\n//\n// Live forwards to the real client and to gitx. DryRun holds no writer at\n// all: it logs the full payload, appends it to a JSONL ledger and returns\n// synthetic results (negative numbers, see IsSynthetic). Open is the factory;\n// it is the only place that builds the GitHub client and it hands everyone\n// else a read-only view.\npackage effects\n\nimport (\n\t\"context\"\n\t\"errors\"\n\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n)\n\n// CommitOp and PushOp are gitx's types. PushOp.ForceWithLease is the expected\n// remote SHA (#17 calls it ExpectSHA).\ntype (\n\tCommitOp = gitx.CommitOp\n\tPushOp   = gitx.PushOp\n)\n\n// Sentinels re-exported so callers need not import gitx.\nvar (\n\t// ErrNothingToCommit is returned by Commit, live and dry-run alike, when\n\t// the index is unchanged. Callers treat it as a no-op.\n\tErrNothingToCommit = gitx.ErrNothingToCommit\n\tErrNonFastForward  = gitx.ErrNonFastForward\n\tErrStaleLease      = gitx.ErrStaleLease\n)\n\n// ErrSyntheticTarget is returned by Live when asked to act on a dry-run\n// (negative or zero) issue or PR number.\nvar ErrSyntheticTarget = errors.New(\"effects: synthetic dry-run number used on a live target\")\n\n// IsSynthetic reports whether n is a dry-run number.\nfunc IsSynthetic(n int) bool { return n < 0 }\n\n// CommitResult is the outcome of Commit. Synthetic is true in dry-run, where\n// SHA is a stable hash and no commit exists.\ntype CommitResult struct {\n\tSHA       string\n\tSynthetic bool\n}\n\n// Effects is every side effect the controller can cause.\ntype Effects interface {\n\tgithub.Writer\n\t// UpdateIssueBody replaces an issue body (UpdateIssue with only Body set).\n\tUpdateIssueBody(ctx context.Context, n int, body string) error\n\t// Commit commits what is already staged in op.Dir. It returns\n\t// ErrNothingToCommit when nothing is staged.\n\tCommit(ctx context.Context, op CommitOp) (CommitResult, error)\n\tPush(ctx context.Context, op PushOp) error\n\t// DryRun reports whether effects are only logged.\n\tDryRun() bool\n}\n\nfunc isNothing(err error) bool { return errors.Is(err, ErrNothingToCommit) }\n\t\tpanic(\"pool used before pool-adopt\")\n\t}\n\treturn p\n}\n\n// registerLoops returns the loops to run: the scanners loop (#23), the stale\n// closer (#25), the triage loop (#29), the worker loop (#33), the reviewer loop\n// (#35) and the Reaper (#37) and the costs loop (#172) so far. Loops that run jobs build their executor\n// with w.newExecutor(), end jobs through w.finisher() and share w.closer(). The\n// merger loop adds one constructor call here. It is a variable so tests can observe wiring.\nvar registerLoops = func(w *wiring) []controller.Loop {\n\tvar loops []controller.Loop\n\tif l := scannerLoop(w); l != nil {\n\t\tloops = append(loops, l)\n\t}\n\tloops = append(loops, stale.New(w.Reader, w.Effects, nil))\n\tif l := triageLoop(w); l != nil {\n\t\tloops = append(loops, l)\n\t}\n\tif l := workerLoop(w); l != nil {\n\t\tloops = append(loops, l)\n\t}\n\tif l := reviewerLoop(w); l != nil {\n\t\tloops = append(loops, l)\n\t}\n\tloops = append(loops, reviewfixLoop(w), mergerLoop(w), janitorLoop(w))\n\tif l := reaperLoop(w); l != nil {\n\t\tloops = append(loops, l)\n\t}\n\tloops = append(loops, costs.New(costs.Deps{Store: w.Store, Reader: w.Reader, Effects: w.Effects,\n\t\tRepo: w.Repo, Locks: &w.bodyLocks, Log: w.Log}))\n\treturn loops\n}\n\n// resolveRepo parses --repo, or falls back to the origin remote of root.\n// Errors never include the remote URL, which may embed a token.\nfunc resolveRepo(ctx context.Context, flag, root string) (github.Repo, error) {\n\tif flag != \"\" {\n\t\tr, err := github.ParseRepo(flag)\n\t\tif err != nil {\n\t\t\treturn github.Repo{}, fmt.Errorf(\"ard serve: %w\", err)\n\t\t}\n\t\treturn r, nil\n\t}\n\turl, err := gitx.New(\"\").RemoteURL(ctx, root, \"origin\")\n\tif err != nil {\n\t\treturn github.Repo{}, errors.New(\"ard serve: --repo owner/repo is required (no origin remote to fall back on)\")\n\t}\n\tr, err := github.RepoFromRemote(url)\n\tif err != nil {\n\t\treturn github.Repo{}, errors.New(\"ard serve: --repo owner/repo is required (origin remote is not a github.com owner/repo URL)\")\n// Package janitor prunes the .ard/<issue#>/ directories of issues closed\n// long ago (#61). Git history keeps the audit trail. It is a plain controller\n// loop: no slot, executor or worktree. Every deletion goes through the main\n// committer, whose path guard confines a request to its own issue's\n// directory, so .ard/config.yaml and the role directories can never be hit.\npackage janitor\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strconv\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/committer\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n)\n\nconst (\n\tName = \"janitor\"\n\t// Retention is how long an issue must have been closed before its\n\t// directory is pruned.\n\tRetention = 90 * 24 * time.Hour\n\t// Interval is how often the loop wakes; Period is how often it works.\n\tInterval = 24 * time.Hour\n\tPeriod   = 30 * 24 * time.Hour\n)\n\n// Reader is the read side, satisfied by github.Reader.\ntype Reader interface {\n\tSearchIssues(ctx context.Context, q string, o github.SearchOpts) ([]github.Issue, error)\n\tGetIssue(ctx context.Context, n int) (github.Issue, error)\n}\n\n// Committer commits to main, satisfied by the shared main committer.\ntype Committer interface {\n\tCommit(ctx context.Context, req committer.Request) (committer.Result, error)\n}\n\n// Tree lists every file path under .ard/ at the latest main.\ntype Tree func(ctx context.Context) ([]string, error)\n\n// Janitor is the pruning loop.\ntype Janitor struct {\n\tgh   Reader\n\tcm   Committer\n\ttree Tree\n\tnow  func() time.Time\n\n\tmu      sync.Mutex\n\tlastRun time.Time\n}\n\nvar _ controller.Loop = (*Janitor)(nil)\n\n// New returns a Janitor; a nil now means time.Now.\nfunc New(gh Reader, cm Committer, tree Tree, now func() time.Time) *Janitor {\n\tif now == nil {\n\t\tnow = time.Now\n\t}\n\treturn &Janitor{gh: gh, cm: cm, tree: tree, now: now}\n}\n\nfunc (j *Janitor) Name() string                            { return Name }\nfunc (j *Janitor) Interval(*config.Resolved) time.Duration { return Interval }\n\n// Claims is true so that pause stops pruning.\nfunc (j *Janitor) Claims() bool { return true }\n\nvar issueDirRe = regexp.MustCompile(`^\\.ard/([1-9][0-9]*)/`)\n\n// Tick runs a pass when Period has passed since the last completed one. The\n// pass is idempotent, so losing lastRun on a restart costs one extra scan.\nfunc (j *Janitor) Tick(ctx context.Context, env controller.Env) error {\n\tnow := j.now()\n\tj.mu.Lock()\n\tlast := j.lastRun\n\tj.mu.Unlock()\n\tif !last.IsZero() && now.Sub(last) < Period {\n\t\treturn nil\n\t}\n\tif err := j.pass(ctx, env.Log, now); err != nil {\n\t\treturn err\n17:// Status issue identity. The marker, not the title, is what makes an issue\n20:\tStatusTitle  = \"ard status\"\n21:\tStatusMarker = \"<!-- ard:status -->\"\n24:// StatusIssueKey is the meta key that remembers the status issue number.\n25:const StatusIssueKey = \"status_issue\"\n27:// StatusReader is what the lookup reads: the cached issue directly, else search.\n28:type StatusReader interface {\n33:// StatusCache remembers the status issue number across restarts. *state.Store\n35:type StatusCache interface {\n40:var _ StatusCache = (*state.Store)(nil)\n42:// StatusEffects is the write side, satisfied by effects.Effects.\n43:type StatusEffects interface {\n48:const statusBody = StatusMarker + \"\\n\\nManaged by ard. Add the `\" + labels.Pause +\n51:// ownStatusIssue reports whether is is an open status issue ard created.\n52:func ownStatusIssue(is github.Issue, author string) bool {\npackage servecmd\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\n\t\"github.com/albertcbrown/ard/internal/controller\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n\t\"github.com/albertcbrown/ard/internal/janitor\"\n)\n\n// janitorRef is where the janitor keeps its own fetch of main in the\n// controller clone, apart from the committer lane's ref.\nconst janitorRef = \"refs/ard/janitor/main\"\n\n// janitorLoop builds the janitor loop (#61). It lists .ard/ on a fresh fetch\n// of main and deletes only through the shared main committer.\nfunc janitorLoop(w *wiring) controller.Loop {\n\tg := gitx.New(\"\")\n\ttree := func(ctx context.Context) ([]string, error) {\n\t\tif err := g.FetchRef(ctx, w.Root, w.RemoteURL, \"+refs/heads/main:\"+janitorRef, w.Token); err != nil {\n\t\t\treturn nil, fmt.Errorf(\"fetch main: %w\", err)\n\t\t}\n\t\tsha, err := g.RevParse(ctx, w.Root, janitorRef)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\treturn g.ListTree(ctx, w.Root, sha, \".ard\")\n\t}\n\treturn janitor.New(w.Reader, w.mainCommitter(), tree, nil)\n}\n(eval):1: no matches found: --include=*","is_error":false}]},"parent_tool_use_id":null,"session_id":"a519cdfb-4f9e-4975-bd59-0d679a067fca","uuid":"e5c293df-968a-43dc-923a-98b14b513300","timestamp":"2026-11-23T19:48:42.363Z","tool_use_result":{"stdout":"// Package effects is the only place that writes to GitHub or git. Effects\n// embeds github.Writer unchanged, so the method set covers every GitHub write\n// by construction: if the Writer grows a method, both implementations stop\n// compiling until they handle 