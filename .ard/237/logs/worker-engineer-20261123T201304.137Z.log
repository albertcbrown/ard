{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Goi9PYZZReqomPNCuTL3xo","type":"tool_result","content":"\tfor _, l := range loops {\n\t\tnames = append(names, l.Name())\n\t}\n\treturn names\n}\n\n// knownLoops are the names registerLoops' loops report (Loop.Name), in the\n// order they register. \"budget\" is the claim gate: it is built into the pool\n// whatever --loops says, so naming it selects no loop of its own.\nvar knownLoops = []string{\"scanners\", stale.Name, \"triage\", \"workers\", \"reviewers\", \"reviewfix\", \"merger\", janitor.Name, \"reaper\", \"budget\"}\n\n// selectLoops keeps the loops named in want, in registration order; an empty\n// want keeps every loop. A name that is not a known loop is a usage error\n\t\tpanic(\"pool used before pool-adopt\")\n\t}\n\treturn p\n}\n\n// registerLoops returns the loops to run: the scanners loop (#23), the stale\n// closer (#25), the triage loop (#29), the worker loop (#33), the reviewer loop\n// (#35) and the Reaper (#37) and the costs loop (#172) so far. Loops that run jobs build their executor\n// with w.newExecutor(), end jobs through w.finisher() and share w.closer(). The\n// merger loop adds one constructor call here. It is a variable so tests can observe wiring.\nvar registerLoops = func(w *wiring) []controller.Loop {\n\tvar loops []controller.Loop\n\tif l := scannerLoop(w); l != nil {\n\t\tloops = append(loops, l)\n\t}\n\tloops = append(loops, stale.New(w.Reader, w.Effects, nil))\n\tif l := triageLoop(w); l != nil {\n\t\tloops = append(loops, l)\n\t}\n\tif l := workerLoop(w); l != nil {\n\t\tloops = append(loops, l)\n\t}\n\tif l := reviewerLoop(w); l != nil {\n\t\tloops = append(loops, l)\n\t}\n\tloops = append(loops, reviewfixLoop(w), mergerLoop(w), janitorLoop(w))\n\tif l := reaperLoop(w); l != nil {\n\t\tloops = append(loops, l)\n\t}\n\tloops = append(loops, costs.New(costs.Deps{Store: w.Store, Reader: w.Reader, Effects: w.Effects,\n\t\tRepo: w.Repo, Locks: &w.bodyLocks, Log: w.Log}))\n\treturn loops\n}\n\n// resolveRepo parses --repo, or falls back to the origin remote of root.\n// Errors never include the remote URL, which may embed a token.\nfunc resolveRepo(ctx context.Context, flag, root string) (github.Repo, error) {\n\tif flag != \"\" {\n\t\tr, err := github.ParseRepo(flag)\n\t\tif err != nil {\n\t\t\treturn github.Repo{}, fmt.Errorf(\"ard serve: %w\", err)\n\t\t}\n\t\treturn r, nil\n\t}\n\turl, err := gitx.New(\"\").RemoteURL(ctx, root, \"origin\")\n\tif err != nil {\n\t}\n\treturn nil\n}\n\n// AppendEvent appends e; a zero At means now.\nfunc (s *Store) AppendEvent(ctx context.Context, e Event) error {\n\tif e.Kind == \"\" {\n\t\treturn fmt.Errorf(\"append event: empty kind\")\n\t}\n\tif e.At.IsZero() {\n\t\te.At = s.now()\n\t}\n\treturn insertEvent(ctx, s.db, e)\n}\n\n// Events returns matching events in ascending id order.\nfunc (s *Store) Events(ctx context.Context, f EventFilter) ([]Event, error) {\n\tq := `SELECT id, ts, kind, job_id, issue, stage, role, data FROM events WHERE 1=1`\n\tvar args []any\n\tif !f.Since.IsZero() {\n\t\tq += ` AND ts >= ?`\n\t\targs = append(args, f.Since.Unix())\n\t}\n\tif !f.Until.IsZero() {\n\t\tq += ` AND ts <= ?`\n\t\targs = append(args, f.Until.Unix())\n\t}\n\tif f.Kind != \"\" {\n\t\tq += ` AND kind = ?`\n\t\targs = append(args, f.Kind)\n\t}\n\tif f.Issue != 0 {\n\t\tq += ` AND issue = ?`\n\t\targs = append(args, f.Issue)\n\t}\n\tif f.Stage != \"\" {\n\t\tq += ` AND stage = ?`\n\t\targs = append(args, f.Stage)\n\t}\n\tif f.Role != \"\" {\n\t\tq += ` AND role = ?`\n\t\targs = append(args, f.Role)\n\t}\n\tq += ` ORDER BY id`\n\tif f.Limit > 0 {\n\t\tq += ` LIMIT ?`\n\t\targs = append(args, f.Limit)\n\t}\n\trows, err := s.db.QueryContext(ctx, q, args...)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"query events: %w\", err)\ninternal/effects/dryrun.go:165:func (d *DryRun) CreateComment(ctx context.Context, n int, body string) (github.Comment, error) {\ninternal/effects/dryrun.go:166:\tid, err := d.emit(ctx, \"CreateComment\", num(n), map[string]any{\"body\": d.r(body)}, true, func(id int) map[string]any {\ninternal/effects/effects_test.go:59:func (c failClient) CreateComment(context.Context, int, string) (github.Comment, error) {\ninternal/effects/effects_test.go:60:\tc.fail(\"CreateComment\")\ninternal/effects/effects_test.go:183:\t\t{\"CreateComment\", func(d *DryRun) error {\ninternal/effects/dryrun.go:17:// DryRunOptions configures NewDryRun.\ninternal/effects/dryrun.go:18:type DryRunOptions struct {\ninternal/effects/dryrun.go:25:// DryRun logs and records effects without performing any. It holds no writer.\ninternal/effects/dryrun.go:26:type DryRun struct {\ninternal/effects/dryrun.go:38:var _ Effects = (*DryRun)(nil)\ninternal/servecmd/limits_test.go:17:\t\"github.com/albertcbrown/ard/internal/reaper\"\ninternal/servecmd/limits_test.go:106:\t\t\tcause, ok := reaper.UsageLimitClassifier(agent.AuthOAuthToken)(res)\ninternal/servecmd/limits_test.go:137:func TestReaperPartsWireLimits(t *testing.T) {\ninternal/servecmd/loops_test.go:38:\t\t{\"soak set, in registration order\", []string{\"reaper\", \"scanners\", \"stale\"}, []string{\"scanners\", \"stale\", \"reaper\"}},\ninternal/servecmd/loops_test.go:65:\tfor _, s := range []string{`\"scaners\"`, \"scanners, stale, triage, workers, reviewers, reviewfix, merger, janitor, reaper\"} {\ninternal/servecmd/loops_test.go:84:\twant := []string{\"scanners\", \"stale\", \"triage\", \"workers\", \"reviewers\", \"reviewfix\", \"merger\", \"janitor\", \"reaper\", \"budget\"}\ninternal/servecmd/reaping_test.go:55:// scanners and the Reaper must share them.\ninternal/servecmd/reaping_test.go:76:\t_, r, _ := w.reaperParts()\ninternal/servecmd/reaping_test.go:77:\tif f1 != f2 || r == nil || r.Name() != \"reaper\" || r.Claims() {\ninternal/servecmd/reaping_test.go:78:\t\tt.Errorf(\"finisher %p %p reaper %v\", f1, f2, r)\n186:2. **Backpressure, in code, before the scanner starts.** The controller counts open issues with `ard:scanner:<name>`; at or above `max_open` it skips the run and logs it, autoclose scanners included (`none` and `needs-human` issues count too, and are never stale-closed, so a non-autoclose scanner with those routes stops once its issues fill `max_open` until a human closes or promotes some): a scanner at its cap does not run with a zero filing budget, so it cannot autoclose its own fixed issues until a human or the stale closer frees a slot. A global cap across all scanners (`global_max_open`) stops a bad day from burying the queue. A skipped run is not queued: it counts as a run, and the next scheduled run checks again.\n189:5. **Group.** Findings that share a `group` key join one issue, up to `group_size` (N), as a checklist with one line per finding (ticked lines count towards N). An empty `group` means one issue per finding. New findings join an open group issue of the same group that has room and is not yet claimed, meaning it carries no `ard:` label besides `ard:scanner:<name>` and the route's label (none under `route: none`); otherwise they start a new one. A regression never joins: it always opens a new issue, which may also hold new findings of the same group. The number of new issues per run is `min(max_open - open, global_max_open - global open)`; joins are free. Findings over that budget are filed most severe first, and the rest stay unrecorded so the next run offers them again.\n269:Local-executor details: the role directory (and its `Dockerfile`) is mounted from the config snapshot at the job's SHA, not from the working tree. The job worktree is always detached at a SHA resolved from the job's ref (the executor never checks out a branch; the committer owns branch worktrees). The controller's clone is a bare repository ard owns at `~/.ard/repos/<owner>/<repo>.git` (lowercased), with no remote, no stored credential and auto-gc off (`gc.auto=0`, `maintenance.auto=false`). `ard serve` creates it on first start and seeds it with one fetch of `main` (up to 30 min; if that fails, serve starts paused and the next start retries), and later starts reuse it. Config loads and committer lanes fetch into it, and every committer and executor worktree is cut from it (lanes under `~/.ard/work/<owner>/<repo>/lanes/`). `ard serve` never writes to the operator's checkout: it reads it only for the `origin` fallback of `--repo` and the local `paused` key. To rebuild a damaged clone, stop serve, `rm -rf` it and restart. Upgrading from a version that used the checkout: ard deletes its old lane and job worktree directories without running git there, so the old `refs/ard/*` refs and the dangling worktree registrations stay in the checkout until you remove them (`git for-each-ref --format='delete %(refname)' refs/ard/ | git update-ref --stdin; git worktree prune`). Every `git worktree add`, `remove` and `prune` on the controller's clone, by the executor and the committer's lanes alike, takes one in-process lock keyed by the clone's common git directory, because git's worktree bookkeeping is not safe under concurrent admin commands; fetches, commits and pushes do not take it. Each such command also has a 30 s deadline, and cleanup runs even when the job's context is cancelled, so one hung git cannot stall every lane. Do not run `git worktree prune` (or add/remove) in `~/.ard/repos/<owner>/<repo>.git` by hand while `ard serve` runs: the lock is per process and cannot cover a human's git. The operator's own checkout is free to use. The host keeps two files per job: `<base>.log` (stdout and stderr combined, the heartbeat source and the committed log) and `<base>.stdout` (stdout only, parsed by the adapter). A read-only job (`ReadOnly`, used by scanners) gets the worktree mounted `:ro` under Docker, or `chmod -R a-w` on the host. The heartbeat is the log file's mtime while the PID is alive; liveness alone is not a beat. Phase 0 local jobs do not survive a controller restart: the pipes belong to the controller, so after a restart the job reports `orphaned` (PID alive, start time verified) or `gone`, and the Reaper kills and fails it. The executor is not an effect: it never calls GitHub or commits, so jobs run normally under `--dry-run`. Sidecar auth: the sidecar fetch runs in the controller with the GitHub App installation token in a host-scoped `http.<url>.extraheader` passed through git's environment, never argv; the job receives plain files and no credential, and the cache stores no remote and no token. The App must be installed on the sidecar repo with contents:read. Host-mode jobs can reach `~/.ard/sidecars`, but it holds no credential. Host-mode jobs run as the controller's uid: they can read the GitHub App key and `~/.config/gh` by absolute path, write the controller's clone, and undo `chmod a-w`. Host mode is allowed for every role ([#84](https://github.com/albertcbrown/ard/issues/84)), but a role that reads untrusted input (every triage, worker and reviewer role, and an LLM scanner) warns loudly when it has no `Dockerfile`; deterministic scanners are exempt, and nothing warns under `executor: k8s`, where every job runs in a container. `ard config check` and the first successful config load of `ard serve` (and any role a later config adds) log one `executor.host_untrusted` WARN per such role and also write it to stderr, so it survives `--log-level`. The local executor logs the WARN again for every host-mode job of such a role and appends a `host_untrusted` row to the `events` table. Each warning lists what the job can reach, including `~/.ard` (state, config snapshots, the pause file, other jobs' worktrees and logs). The owner accepts this risk while ard runs only on owner-controlled repos, and revisits it when moving to the spark cluster, where every job runs in a container once the k8s executor (#54) lands. Until then the Gate 1 dry-run soak on spark (see Rollout and Delivery) runs `ard serve` with the local executor in a pod, and the deterministic cve scanner runs there as a host subprocess of the controller container: its role directory has no `Dockerfile`, and the `ard` image carries its pinned tools. Only deterministic scanners run in that pod: it starts `ard serve --loops scanners,stale,reaper` ([#187](https://github.com/albertcbrown/ard/issues/187)), so the triage, worker and reviewer loops never run there, even though `.ard/config.yaml` on `main` has agent roles. `--loops` takes a comma-separated list of loop names (scanners, stale, triage, workers, reviewers, reviewfix, merger, janitor, reaper, budget), defaults to every loop, and rejects an unknown name with exit 2. `ard serve` and `ard config check` refuse to run on git older than 2.47.0, because the committer's fetches fail on older versions.\n273:**One pool of job slots, drained from the end.** At most `max_pods` jobs (default 3) run at once, shared by every loop. When a slot frees, the controller fills it in this order: reviewers, then workers, then triage, then scanners, oldest first within each. Finishing work in flight beats starting new work, so a busy day grows the scanner backlog, not the pile of half-done PRs. The merger and the Reaper are controller code and take no slot. Slots are granted when a loop polls and nothing is queued: a loop that found work waiting within the last two of its intervals has that demand reserved ahead of lower classes, so a freed slot can sit idle until that loop's next poll. A scanner run that gets no slot is skipped, not queued. The pool also starts no agent job for an exhausted account or model family until its reset: a job that stops at a subscription usage limit records the limit (in the controller database, so a restart keeps it), and the pool answers `limited` to any candidate whose role runs on that account or family (a whole-account session or weekly limit blocks every role; an Opus or Sonnet limit blocks only roles on that family, and a role with no model, which runs the CLI default, is blocked by any limit). A limited candidate takes no slot and reserves no demand, so lower classes are not held back. The block ends at the reset time the CLI reported; when it reported none the first pause is 30 minutes and each further stop with no reset doubles it up to 4 hours, starting over once a job succeeds; a reset time further away than 8 days is clamped. Running jobs are never killed for a limit. Deterministic scanners and the merger use no model and are unaffected. A daily dollar cap works the same way at the same gate: the pool answers `budget` to a candidate whose role cap or the repo cap is reached, and that candidate takes no slot and reserves no demand. A job that already holds a slot keeps it and finishes.\n284:**Agent CLIs plug in through adapters.** Each adapter turns (prompt file, context paths, budget) into a command line and parses the exit code and, where the CLI reports them, turns and cost. For Claude Code that is `claude -p --output-format=stream-json --verbose --restricted --safe-mode --strict-mcp-config --disable-slash-commands --permission-mode=dontAsk --settings='{\"includeGitInstructions\":false,\"disableAllHooks\":true}' --tools=… --allowed-tools=… --disallowed-tools=… --model <model> --max-budget-usd <max_budget_usd> --append-system-prompt-file <role prompt> -- <message>` (`--verbose` is required by `stream-json` in print mode). Every stage (scanner, triage, worker, review) gets the same tool profile: `--tools` and `--allowed-tools` are `Read,Glob,Grep,Edit,Write,Bash`, and `--disallowed-tools` is `Bash(git commit *),Bash(git push *),Bash(git remote *),Bash(gh *)` (decided, #79). ard does not pass `--bare`: it limits the CLI to Bash, Read and Edit, and `--tools` cannot widen it (#105). The planted-config isolation `--bare` gave comes instead from `--restricted` (only managed settings and `--settings` load), `--safe-mode` (no CLAUDE.md or AGENTS.md, skills, agents, hooks, MCP servers or auto memory), `--strict-mcp-config`, `--disable-slash-commands`, and `--settings` that turns off hooks and the git status snapshot (commit subjects are third-party text). `CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=1` is set as a fixed env var (the executor allows it) so Bash cannot detach commands. The integration tests pin each of these against a worktree with planted config and must be re-run on every `TestedVersion` bump. The tool list is not a security boundary, and the deny list is advisory, because shell indirection gets around it. The real boundaries are the missing GitHub token (Docker; see the host-mode note above, #84), the committer, which commits only `.ard/<issue#>/` from a triage or review job (other edits are discarded with the worktree), and the diff guard on worker changes. An explicit tool list from the caller (`Spec.Tools`) replaces the allow list and keeps the deny list. The user message holds only fixed text and the paths of the untrusted input files. The installed CLI accepts an undocumented `--max-turns`; ard does not rely on it, so a per-job dollar cap and the executor's hard timeout bound each run. Agents run with an empty per-job CLI config dir and HOME and receive exactly one model credential, passed by name by the executor and never visible to the adapter: an API key (`ANTHROPIC_API_KEY`) or a subscription OAuth token (`CLAUDE_CODE_OAUTH_TOKEN`, from `claude setup-token`); that rests on the environment, not on a CLI flag. `ard serve` chooses the credential from its own environment: `ARD_AGENT_AUTH` is `auto` (the default; the token if set, else the key), `oauth` or `apikey`, and an explicit mode never falls back to the other variable. Only one is ever passed, because the CLI prefers the API key and would silently bill it (pinned by an integration test). A missing credential does not stop startup, because deterministic scanners need none: `ard serve` logs one INFO line, and a job that needs one fails with a clear error. The executor creates the per-job config dir as `<job home>/.claude` (0700) in `prepare` (`Handle.View.ConfigDir`; under Docker it is a bind mount at `/ard-config`), refuses to start a job whose config dir is not that empty directory, and removes it with the job home; the Reaper's `KeepWorktree` retention keeps it too, and it holds no credential, since the credential travels only in the environment. `CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=1`, which would keep the token out of Bash children, is not set (decided, #125). Residual risk: an API key (`ANTHROPIC_API_KEY`) is inherited by Bash children; on the tested release the CLI does not pass `CLAUDE_CODE_OAUTH_TOKEN` to them; and either credential can still be read from the `claude` process's own environment (`/proc/$PPID/environ` on Linux, `ps eww` on macOS). The container is the boundary: it holds no GitHub token, and the credential is scoped to the model. The scrub is off because on 2.1.328 it requires bubblewrap (and socat) plus unprivileged user namespaces; Docker blocks those under ard's flags (`--cap-drop ALL`, `no-new-privileges`, default seccomp), so every Bash call would fail closed and without bwrap the CLI refuses to start. On macOS host mode it worked and matched the `dontAsk` outcomes. It can be revisited for host mode or a loosened container. What agent Bash can read differs by mode: under Docker, only the job's own credential; in host mode, far more, because any same-uid process's environment is readable (`ps eww <pid>` on macOS, `/proc/<pid>/environ` on Linux), including `ard serve`'s own, which holds both credentials. The scrub would not close that; it is part of the host-mode risk of #84. `kimi` and `dsh-tui` both run headless with `-p`; neither has a turn cap and `kimi` reports no cost, so turns and cost are optional in the adapter result. `config.yaml` names the default CLI and any per-role override, so a role can move between CLIs without touching its prompt. The Claude adapter also reads a usage limit and token usage from the stream: a limit comes from a `rate_limit_event` with status `rejected` (its `resetsAt` is the reset time), from the CLI's own error text (`You've hit your session, weekly, Opus or Sonnet limit`) and from `rate_limit` or `billing_error` errors, and it records `usage` and `modelUsage` token counts (by input, output, cache write and cache read; per model when the result has `modelUsage`, which is preferred for accounting). That text is matched only on paths the CLI itself writes (an assistant message carrying an `error`, or an errored result with HTTP 429 or `api_error`), never in agent output, because an agent can be made to print the phrase. Only the job's own agent step and its fix steps are read for a limit: a worker's test step runs agent-written code, so its output is never classified (a printed limit line there cannot block the account). With an API key a 429 stays a transient `rate_limit` retry; only subscription (OAuth) runs have usage limits. The adapter also reads `rate_limit_info.unifiedWindows` from every `rate_limit_event` into `Result.Windows` (one reading per window type, the last winning, also when the run ends with no result). The controller records the readings for OAuth steps only, from the job's own agent and fix steps and never from a test step, including killed steps with no result; it logs them as `limits.reading`. A recording error is logged as `limits.observe_failed` and never fails the job. Nothing is gated on the readings yet (#63). The committed fixtures are scrubbed real captures where a human has made them (`testdata/CAPTURE.md`) and clearly named `synthetic_*` files elsewhere.\n311:3. **Steps.** One worker job is one state row, one pool slot and one attempt, but it runs several executor jobs, each in a fresh worktree detached at a SHA: the agent step (`<job id>`) at the branch head, or `origin/main` for a new branch; a test step (`<job id>t<k>`) and a fix step (`<job id>f<k>`) at the SHA the last push made. The branch itself belongs to the committer. Each step's handle is saved before it starts, so the Reaper's heartbeat and deadline rules apply to tests too. `timeout` covers the whole job: each step gets the time that is left, and with under two minutes left the loop stops and reports the tests as failed (\"ran out of time\"). `max_budget_usd` likewise caps the whole job: each agent step gets the cap minus the cost of the earlier steps (a step that reports no cost is assumed free and logged), and when nothing is left the job fails with `job budget exhausted`.\n404:budget_usd_per_day: 50       # whole repo, UTC day, blocks at spent >= cap; a role may set its own; provisional, recalibrated between Gate 1 and Gate 2\n405:max_budget_usd: 5            # per job; provisional, same recalibration\n430:**Models are tiered (decided, #8).** Opus 5.5 for the lead, architect and security review; Sonnet 5.5 for workers, triage engineer and most reviewers; Haiku 5.5 for lint and docs work. The `budget_usd_per_day: 50` and per-job `max_budget_usd` values are provisional and are recalibrated from measured cost per job and per merged PR between Gate 1 and Gate 2.\n432:Scanners also take `route` (`pending`, `none` or `needs-human`). Anything unset takes its default: intake in `label` mode with `ard:pending`, scanners every 4 h with `max_open` 5 and `group_size` 10, triage every 15 min, a 30-minute job timeout, `make test`, 2 test-fix attempts, 3 review rounds and worker diff thresholds of 1,000 lines (warn) and 2,000 lines (hold). Durations accept `m`, `h` and `d`. A sidecar `repo` must be `owner/name` and its `ref` a valid git ref name (no `:`, leading `-`, `..` or spaces; an abbreviated SHA is rejected, use all 40 characters); `ard config check` reports the file and key. A worker's `timeout` and `max_budget_usd` cover the whole job (every step), and `tests: \"\"` disables its test step. Per-role keys are `every`, `max_open`, `group_size`, `autoclose`, `timeout`, `agent`, `model`, `max_budget_usd`, `budget_usd_per_day` (that role's own daily cap in USD; unset or 0 means only the repo cap applies), `sidecar`, `after`, `plan_section`, `tests`, `max_test_fixes`, `max_review_rounds`, `diff_warn_lines` and `diff_max_lines` (worker roles; positive integers, warn no more than max; above warn the PR proceeds with a note, above max it is held), `reviewers` and `when` (`paths`, or `triage` roles that ran; at least one is required). `ard config check` warns when every reviewer has a `when:` rule, because a PR matching none gets no review and stays a draft. `plan_section` is for triage roles: the `## <heading>` of `plan.md` the role owns (one line, no leading `#`, unique across triage roles). The starter roles default to Requirements (product-manager), Design (architect), UX (designer), Docs (documentation-planner) and Implementation (engineer), and a value in `config.yaml` overrides that; a triage role with none may write only its own role file. There are no per-role config files: `ard init` writes a role's starting overrides into `config.yaml` for the roles it ships. Once a second repo adopts ard, role directories can move to a shared roles repo pinned by ref, like a sidecar; a repo's own directory of the same name wins. `after` names triage roles, with no self-reference and no cycles.\n447:- **Planted repo config does not steer agents.** A branch can carry CLAUDE.md, AGENTS.md, `.claude/` settings, hooks, skills, agents or a `.mcp.json`. The Claude adapter's flags stop all of them loading (see Executors). Residual risk: auth isolation comes from the empty per-job config dir and HOME, not a flag (the CLI reads no Keychain entry but the one keyed to the per-job dir); a host-mode job on macOS still runs as the operator's uid, so agent Bash could call `security` against the operator's login Keychain, including Claude's own entry, which is within the host-mode risk of #84 (a Dockerfile role or a dedicated macOS user for `ard serve` closes it); the subscription token is a one-year, model-only credential, rotated by running `claude setup-token` again and restarting `ard serve`; `--max-budget-usd` and `total_cost_usd` are estimates on a subscription; part of the block (AGENTS.md, and CLAUDE.md under `--restricted`) is observed behaviour that holds only on the tested CLI version and is re-checked by the integration tests; built-in plugins and the host's managed settings still apply; system reminders and fixed CLI prompt text are back; isolation of settings `env` is not pinned by a test, since no Bash call is scripted; Bash can still read anything the process can (host mode, #84); and an agent can rewrite CLAUDE.md or `.claude/` in its worktree, which later runs ignore but a worker PR could carry into the target repo (the `ard init` protected-path defaults cover `CLAUDE.md`, `AGENTS.md`, `.claude/` and `.mcp.json`, so such a PR needs a human).\n454:- **Budgets.** Every job has a dollar cap (`max_budget_usd`) and a hard timeout; every role and the whole repo have a daily dollar cap. The caps are enforced at the pool's claim gate (`internal/budget`): a candidate is refused when `spent >= cap`, where spent is the cost recorded in `step_usage` since 00:00 UTC today. The caps reset at 00:00 UTC and survive a restart, because spend is read from the controller database. A role's own `budget_usd_per_day` caps that role (by stage and name) alone; a role without one is limited only by the repo cap. Steps that reported no cost count as $0, and the refusal reason shows how many there were. There is no exemption for reviewers, the caps apply to OAuth credentials too, and deterministic scanners (no model, no cost) are exempt. Running jobs are never killed for a cap. If today's spend cannot be read, the gate refuses (fails closed). Each cap is logged once a day as `budget.capped`. `--loops` accepts `budget` as a name, but the gate is part of the pool and is always on. Posting the cap on the status issue is not part of this change.\n497:    P2 -->|\"Gate 3: 50% merged with no human code edits\"| P3[\"Phase 3: Scale<br/>k8s executor<br/>second repo<br/>shared roles repo<br/>budgets and digest\"]\n514:| Cost per merged PR | measured in Phase 1 from the Total row of the issue's cost table; daily budget set from it |\n--\ninternal/config/types.go:205:// RoleBudgetUSDPerDay is the role's own daily cap in USD. set is false when\ninternal/config/types.go-206-// the role has no override (an override of 0 or less counts as unset); then\ninternal/config/types.go-207-// only the repo-wide Resolved.BudgetUSDPerDay applies to it.\ninternal/config/types.go:208:func (r *Resolved) RoleBudgetUSDPerDay(role Role) (cap float64, set bool) {\ninternal/config/types.go-209-\tif role.BudgetUSDPerDay > 0 {\ninternal/config/types.go-210-\t\treturn role.BudgetUSDPerDay, true\ninternal/config/types.go-211-\t}\ninternal/config/types.go-212-\treturn 0, false\ninternal/config/types.go-213-}\ninternal/config/types.go-214-\ninternal/config/types.go-215-// HostUntrusted returns the roles that read untrusted input and have no\ninternal/config/types.go-216-// Dockerfile, so the local executor runs them as a host subprocess under the\ninternal/config/types.go-217-// controller's uid. Canonical order (kind, then name). It returns nothing\ninternal/config/types.go-218-// when Executor is \"k8s\", where host mode does not exist.\ninternal/config/types.go-219-func (r *Resolved) HostUntrusted() []Role {\ninternal/config/types.go-220-\tif r.Executor == \"k8s\" {","is_error":false}]},"parent_tool_use_id":null,"session_id":"8e94895a-9c89-43aa-8887-d0c651a574b4","uuid":"a1eee1a7-ebf5-41e4-a6dc-b665c0962d01","timestamp":"2026-11-23T20:13:11.407Z","tool_use_result":{"stdout":"\tfor _, l := range loops {\n\t\tnames = append(names, l.Name())\n\t}\n\treturn names\n}\n\n// knownLoops are the names registerLoops' loops report (Loop.Name), in the\n// order they register. \"budget\" is the claim gate: it is built into the pool\n// whatever --loops says, so naming it selects no loop of its own.\nvar knownLoops = []string{\"scanners\", stale.Name, \"triage\", \"workers\", \"reviewers\", \"reviewfix\", \"merger\", janitor.Name, \"reaper\", \"budget\"}\n\n// selectLoops keeps the loops named in want, in registration order; an empty\n// want keeps every loop. A name that is not a known loop is a usage error\n\t\tpanic(\"pool used before pool-adopt\")\n\t}\n\treturn p\n}\n\n// registerLoops returns the loops to run: the scanners loop (#23), the stale\n// closer (#25), the triage loop (#29), the worker loop (#33), the reviewer loop\n// (#35) and the Reaper (#37) and the costs loop (#172) so far. Loops that run jobs build their executor\n// with w.newExecutor(), end jobs through w.finisher() and share w.closer(). The\n// merger loop adds one constructor call here. It is a variable so tests can observe wiring.\nvar registerLoops = func(w *wiring) []controller.Loop {\n\tvar loops []controller.Loop\n\tif l := scannerLoop(w); l != nil {\n\t\tloops = append(loops, l)\n\t}\n\tloops = append(loops, stale.New(w.Reader, w.Effects, nil))\n\tif l := triageLoop(w); l != nil {\n\t\tloops = append(loops, l)\n\t}\n\tif l := workerLoop(w); l != nil {\n\t\tloops = append(loops, l)\n\t}\n\tif l := reviewerLoop(w); l != nil {\n\t\tloops = append(loops, l)\n\t}\n\tloops = append(loops, reviewfixLoop(w), mergerLoop(w), janitorLoop(w))\n\tif l := reaperLoop(w); l != nil {\n\t\tloops = append(loops, l)\n\t}\n\tloops = append(loops, costs.New(costs.Deps{Store: w.Store, Reader: w.Reader, Effects: w.Effects,\n\t\tRepo: w.Repo, Locks: &w.bodyLocks, Log: w.Log}))\n\treturn loops\n}\n\n// resolveRepo parses --repo, or falls back to the origin remote of root.\n// Errors never include the remote URL, which may embed a token.\nfunc resolveRepo(ctx context.Context, flag, root string) (github.Repo, error) {\n\tif flag != \"\" {\n\t\tr, err := github.ParseRepo(flag)\n\t\tif err != nil {\n\t\t\treturn github.Repo{}, fmt.Errorf(\"ard serve: %w\", err)\n\t\t}\n\t\treturn r, nil\n\t}\n\turl, err := gitx.New(\"\").RemoteURL(ctx, root, \"origin\")\n\tif err != nil {\n\t}\n\treturn nil\n}\n\n// AppendEvent appends e; a zero At means now.\nfunc (s *Store) AppendEvent(ctx context.Context, e Event) error {\n\tif e.Kind == \"\" {\n\t\treturn fmt.Errorf(\"append event: empty kind\")\n\t}\n\tif e.At.IsZero() {\n\t\te.At = s.now()\n\t}\n\treturn insertEvent(ctx, s.db, e)\n}\n\n// Events returns matching events in ascending id order.\nfunc (s *Store) Events(ctx context.Context, f EventFilter) ([]Event, error) {\n\tq := `SELECT id, ts, kind, job_id, issue, stage, role, data FROM events WHERE 1=1`\n\tvar args []any\n\tif !f.Since.IsZero() {\n\t\tq += ` AND ts >= ?`\n\t\targs = append(args, f.Since.Unix())\n\t}\n\tif !f.Until.IsZero() {\n\t\tq += ` AND ts <= ?`\n\t\targs = append(args, f.Until.Unix())\n\t}\n\tif f.Kind != \"\" {\n\t\tq += ` AND kind = ?`\n\t\targs = append(args, f.Kind)\n\t}\n\tif f.Issue != 0 {\n\t\tq += ` AND issue = ?`\n\t\targs = append(args, f.Issue)\n\t}\n\tif f.Stage != \"\" {\n\t\tq += ` AND stage = ?`\n\t\targs = append(args, f.Stage)\n\t}\n\tif f.Role != \"\" {\n\t\tq += ` AND role = ?`\n\t\targs = append(args, f.Role)\n\t}\n\tq += ` ORDER BY id`\n\tif f.Limit > 0 {\n\t\tq += ` LIMIT ?`\n\t\targs = append(args, f.Limit)\n\t}\n\trows, err := s.db.QueryContext(ctx, q, args...)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"query events: %w\", err)\ninternal/effects/dryrun.go:165:func (d *DryRun) CreateComment(ctx context.Context, n int, body string) (github.Comment, error) {\ninternal/effects/dryrun.go:166:\tid, err := d.emit(ctx, \"CreateComment\", num(n), map[string]any{\"body\": d.r(body)}, true, func(id int) map[string]any {\ninternal/effects/effects_test.go:59:func (c failClient) CreateComment(context.Context, int, string) (github.Comment, error) {\ninternal/effects/effects_test.go:60:\tc.fail(\"CreateComment\")\ninternal/effects/effects_test.go:183:\t\t{\"CreateComment\", func(d *DryRun) error {\ninternal/effects/dryrun.go:17:// DryRunOptions configures NewDryRun.\ninternal/effects/dryrun.go:18:type DryRunOptions struct {\ninternal/effects/dryrun.go:25:// DryRun logs and records effects without performing any. It holds no writer.\ninternal/effects/dryrun.go:26:type DryRun struct {\ninternal/effects/dryrun.go:38:var _ Effects = (*DryRun)(nil)\ninternal/servecmd/limits_test.go:17:\t\"github.com/albertcbrown/ard/internal/reaper\"\ninternal/servecmd/limits_test.go:106:\t\t\tcause, ok := reaper.UsageLimitClassifier(agent.AuthOAuthToken)(res)\ninternal/servecmd/limits_test.go:137:func TestReaperPartsWireLimits(t *testing.T) {\ninternal/servecmd/loops_test.go:38:\t\t{\"soak set, in registration order\", []string{\"reaper\", \"scanners\", \"stale\"}, []string{\"scanners\", \"stale\", \"reaper\"}},\ninternal/servecmd/loops_test.go:65:\tfor _, s := range []string{`\"scaners\"`, \"scanners, stale, triage, workers, reviewers, reviewfix, merger, janitor, reaper\"} {\ninternal/servecmd/loops_test.go:84:\twant := []string{\"scanners\", \"stale\", \"triage\", \"workers\", \"reviewers\", \"reviewfix\", \"merger\", \"janitor\", \"reaper\", \"budget\"}\ninternal/servecmd/reaping_test.go:55:// scanners and the Reaper must share them.\ninternal/servecmd/reaping_test.go:76:\t_, r, _ := w.reaperParts()\ninternal/servecmd/reaping_test.go:77:\tif f1 != f2 || r == nil || r.Name() != \"reaper\" || r.Claims() {\ninternal/servecmd/reaping_test.go:78:\t\tt.Errorf(\"finisher %p %p reaper %v\", f1, f2, r)\n186:2. **Backpressure, in code, before the scanner starts.** The controller counts open issues with `ard:scanner:<name>`; at or above `max_open` it skips the run and logs it, autoclose scanners included (`none` and `needs-human` issues count too, and are never stale-closed, so a non-autoclose scanner with those routes stops once its issues fill `max_open` until a human closes or promotes some): a scanner at its cap does not run with a zero filing budget, so it cannot autoclose its own fixed issues until a human or the stale closer frees a slot. A global cap across all scanners (`global_max_open`) stops a bad day from burying the queue. A skipped run is not queued: it counts as a run, and the next scheduled run checks again.\n189:5. **Group.** Findings that share a `group` key join one issue, up to `group_size` (N), as a checklist with one line per finding (ticked lines count towards N). An empty `group` means one issue per finding. New findings join an open group issue of the same group that has room and is not yet claimed, meaning it carries no `ard:` label besides `ard:scanner:<name>` and the route's label (none under `route: none`); otherwise they start a new one. A regression never joins: it always opens a new issue, which may also hold new findings of the same group. The number of new issues per run is `min(max_open - open, global_max_open - global open)`; joins are free. Findings over that budget are filed most severe first, and the rest stay unrecorded so the next run offers them again.\n269:Local-executor details: the role directory (and its `Dockerfile`) is mounted from the config snapshot at the job's SHA, not from the working tree. The job worktree is always detached at a SHA resolved from the job's ref (the executor never checks out a branch; the committer owns branch worktrees). The controller's clone is a bare repository ard owns at `~/.ard/repos/<owner>/<repo>.git` (lowercased), with no remote, no stored credential and auto-gc off (`gc.auto=0`, `maintenance.auto=false`). `ard serve` creates it on first start and seeds it with one fetch of `main` (up to 30 min; if that fails, serve starts paused and the next start retries), and later starts reuse it. Config loads and committer lanes fetch into it, and every committer and executor worktree is cut from it (lanes under `~/.ard/work/<owner>/<repo>/lanes/`). `ard serve` never writes to the operator's checkout: it reads it only for the `origin` fallback of `--repo` and the local `paused` key. To rebuild a damaged clone, stop serve, `rm -rf` it and restart. Upgrading from a version that used the checkout: ard deletes its old lane and job worktree directories without running git there, so the old `refs/ard/*` refs and the dangling worktree registrations stay in the checkout until you remove them (`git for-each-ref --format='delete %(refname)' refs/ard/ | git update-ref --stdin; git worktree prune`). Every `git worktree add`, `remove` and `prune` on the controller's clone, by the executor and the committer's lanes alike, takes one in-process lock keyed by the clone's common git directory, because git's worktree bookkeeping is not safe under concurrent admin commands; fetches, commits and pushes do not take it. Each such command also has a 30 s deadline, and cleanup runs even when the job's context is cancelled, so one hung git cannot stall every lane. Do not run `git worktree prune` (or add/remove) in `~/.ard/repos/<owner>/<repo>.git` by hand while `ard serve` runs: the lock is per process and cannot cover a human's git. The operator's own checkout is free to use. The host keeps two files per job: `<base>.log` (stdout and stderr combined, the heartbeat source and the committed log) and `<base>.stdout` (stdout only, parsed by the adapter). A read-only job (`ReadOnly`, used by scanners) gets the worktree mounted `:ro` under Docker, or `chmod -R a-w` on the host. The heartbeat is the log file's mtime while the PID is alive; liveness alone is not a beat. Phase 0 local jobs do not survive a controller restart: the pipes belong to the controller, so after a restart the job reports `orphaned` (PID alive, start time verified) or `gone`, and the Reaper kills and fails it. The executor is not an effect: it never calls GitHub or commits, so jobs run normally under `--dry-run`. Sidecar auth: the sidecar fetch runs in the controller with the GitHub App installation token in a host-scoped `http.<url>.extraheader` passed through git's environment, never argv; the job receives plain files and no credential, and the cache stores no remote and no token. The App must be installed on the sidecar repo with contents:read. Host-mode jobs can reach `~/.ard/sidecars`, but it holds no credential. Host-mode jobs run as the controller's uid: they can read the GitHub App key and `~/.config/gh` by absolute path, write the controller's clone, and undo `chmod a-w`. Host mode is allowed for every role ([#84](https://github.com/albertcbrown/ard/issues/84)), but a role that reads untrusted input (every triage, worker and reviewer role, and an LLM scanner) warns loudly when it has no `Dockerfile`; deterministic scanners are exempt, and nothing warns under `executor: k8s`, where every job runs in a container. `ard config check` and the first successful config load of `ard serve` (and any role a later config adds) log one `executor.host_untrusted` WARN per such role and also write it to stderr, so it survives `--log-level`. The local executor logs the WARN again for every host-mode job of such a role and appends a `host_untrusted` row to the `events` table. Each warning lists what the job can reach, including `~/.ard` (state, config snapshots, the pause file, other jobs' worktrees and logs). The owner accepts this risk while ard runs only on owner-controlled repos, and revisits it when moving to the spark cluster, where every job runs in a container once the k8s executor (#54) lands. Until then the Gate 1 dry-run soak on spark (see Rollout and Delivery) runs `ard serve` with the local executor in a pod, and the deterministic cve scanner runs there as a host subprocess of the controller container: its role directory has no `Dockerfile`, and the `ard` image carries its pinned tools. Only deterministic scanners run in that pod: it starts `ard serve --loops scanners,stale,reaper` ([#187](https://github.com/albertcbrown/ard/issues/187)), so the triage, worker and reviewer loops never run there, even though `.ard/config.yaml` on `main` has agent roles. `--loops` takes a comma-separated list of loop names (scanners, stale, triage, workers, reviewers, reviewfix, merger, janitor, reaper, budget), defaults to every loop, and rejects an unknown name with exit 2. `ard serve` and `ard config check` refuse to run on git older than 2.47.0, because the committer's fetches fail on older versions.\n273:**One pool of job slots, drained from the end.** At most `max_pods` jobs (default 3) run at once, shared by every loop. When a slot frees, the controller fills it in this order: reviewers, then workers, then triage, then scanners, oldest first within each. Finishing work in flight beats starting new work, so a busy day grows the scanner backlog, not the pile of half-done PRs. The merger and the Reaper are controller code and take no slot. Slots are granted when a loop polls and nothing is queued: a loop that found work waiting within the last two of its intervals has that demand reserved ahead of lower classes, so a freed slot can sit idle until that loop's next poll. A scanner run that gets no slot is skipped, not queued. The pool also starts no agent job for an exhausted account or model family until its reset: a job that stops at a subscription usage limit records the limit (in the controller database, so a restart keeps it), and the pool answers `limited` to any candidate whose role runs on that account or family (a whole-account session or weekly limit blocks every role; an Opus or Sonnet limit blocks only roles on that family, and a role with no model, which runs the CLI default, is blocked by any limit). A limited candidate takes no slot and reserves no demand, so lower classes are not held back. The block ends at the reset time the CLI reported; when it reported none the first pause is 30 minutes and each further stop with no reset doubles it up to 4 hours, starting over once a job succeeds; a reset time further away than 8 days is clamped. Running jobs are never killed for a limit. Deterministic scanners and the merger use no model and are unaffected. A daily dollar cap works the same way at the same gate: the pool answers `budget` to a candidate whose role cap or the repo cap is reached, and that candidate takes no slot and reserves no demand. A job that already holds a slot keeps it and finishes.\n284:**Agent CLIs plug in through adapters.** Each adapter turns (prompt file, context paths, budget) into a command line and parses the exit code and, where the CLI reports them, turns and cost. For Claude Code that is `claude -p --output-format=stream-json --verbose --restricted --safe-mode --strict-mcp-config --disable-slash-commands --permission-mode=dontAsk --settings='{\"includeGitInstructions\":false,\"disableAllHooks\":true}' --tools=… --allowed-tools=… --disallowed-tools=… --model <model> --max-budget-usd <max_budget_usd> --append-system-prompt-file <role prompt> -- <message>` (`--verbose` is required by `stream-json` in print mode). Every stage (scanner, triage, worker, review) gets the same tool profile: `--tools` and `--allowed-tools` are `Read,Glob,Grep,Edit,Write,Bash`, and `--disallowed-tools` is `Bash(git commit *),Bash(git push *),Bash(git remote *),Bash(gh *)` (decided, #79). ard does not pass `--bare`: it limits the CLI to Bash, Read and Edit, and `--tools` cannot widen it (#105). The planted-config isolation `--bare` gave comes instead from `--restricted` (only managed settings and `--settings` load), `--safe-mode` (no CLAUDE.md or AGENTS.md, skills, agents, hooks, MCP servers or auto memory), `--strict-mcp-config`, `--disable-slash-commands`, and `--settings` that turns off hooks and the git status snapshot (commit subjects are third-party text). `CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=1` is set as a fixed env var (the executor allows it) so Bash cannot detach commands. The integration tests pin each of these against a worktree with planted config and must be re-run on every `TestedVersion` bump. The tool list is not a security boundary, and the deny list is advisory, because shell indirection gets around it. The real boundaries are the missing GitHub token (Docker; see the host-mode note above, #84), the committer, which commits only `.ard/<issue#>/` from a triage or review job (other edits are discarded with the worktree), and the diff guard on worker changes. An explicit tool list from the caller (`Spec.Tools`) replaces the allow list and keeps the deny list. The user message holds only fixed text and the paths of the untrusted input files. The installed CLI accepts an undocumented `--max-turns`; ard does not rely on it, so a per-job dollar cap and the executor's hard timeout bound each run. Agents run with an empty per-job CLI config dir and HOME and receive exactly one model credential, passed by name by the executor and never visible to the adapter: an API key (`ANTHROPIC_API_KEY`) or a subscription OAuth token (`CLAUDE_CODE_OAUTH_TOKEN`, from `claude setup-token`); that rests on the environment, not on a CLI flag. `ard serve` chooses the credential from its own environment: `ARD_AGENT_AUTH` is `auto` (the default; the token if set, else the key), `oauth` or `apikey`, and an explicit mode never falls back to the other variable. Only one is ever passed, because the CLI prefers the API key and would silently bill it (pinned by an integration test). A missing credential does not stop startup, because deterministic scanners need none: `ard serve` logs one INFO line, and a job that needs one fails with a clear error. The executor creates the per-job config dir as `<job home>/.claude` (0700) in `prepare` (`Handle.View.ConfigDir`; under Docker it is a bind mount at `/ard-config`), refuses to start a job whose config dir is not that empty directory, and removes it with the job home; the Reaper's `KeepWorktree` retention keeps it too, and it holds no credential, since the credential travels only in the environment. `CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=1`, which would keep the token out of Bash children, is not set (decided, #125). Residual risk: an API key (`ANTHROPIC_API_KEY`) is inherited by Bash children; on the tested release the CLI does not pass `CLAUDE_CODE_OAUTH_TOKEN` to them; and either credential can still be read from the `claude` process's own environment (`/proc/$PPID/environ` on Linux, `ps eww` on macOS). The container is the boundary: it holds no GitHub token, and the credential is scoped to the model. The scrub is off because on 2.1.328 it requires bubblewrap (and socat) plus unprivileged user namespaces; Docker blocks those under ard's flags (`--cap-drop ALL`, `no-new-privileges`, default seccomp), so every Bash call would fail closed and without bwrap the CLI refuses to start. On macOS host mode it worked and matched the `dontAsk` outcomes. It can be revisited for host mode or a loosened container. What agent Bash can read differs by mode: under Docker, only the job's own credential; in host mode, far more, because any same-uid process's environment is readable (`ps eww <pid>` on macOS, `/proc/<pid>/environ` on Linux), including `ard serve`'s own, which holds both credentials. The scrub would not close that; it is part of the host-mode risk of #84. `kimi` and `dsh-tui` both run headless with `-p`; neither has a turn cap and `kimi` reports no cost, so turns and cost are optional in the adapter result. `config.yaml` names the default CLI and any per-role override, so a role can move between CLIs without touching its prompt. The Claude adapter also reads a usage limit and token usage from the stream: a limit comes from a `rate_limit_event` with status `rejected` (its `resetsAt` is the reset time), from the CLI's own error text (`You've hit your session, weekly, Opus or Sonnet limit`) and from `rate_limit` or `billing_error` errors, and it records `usage` and `modelUsage` token counts (by input, output, cache write and cache read; per model when the result has `modelUsage`, which is preferred for accounting). That text is matched only on paths the CLI itself writes (an assistant message carrying an `error`, or an errored result with HTTP 429 or `api_error`), never in agent output, because an agent can be made to print the phrase. Only the job's own agent step and its fix steps are read for a limit: a worker's test step runs agent-written code, so its output is never classified (a printed limit line there cannot block the account). With an API key a 429 stays a transient `rate_limit` retry; only subscription (OAuth) runs have usage limits. The adapter also reads `rate_limit_info.unifiedWindows` from every `rate_limit_event` into `Result.Windows` (one reading per window type, the last winning, also when the run ends with no result). The controller records the readings for OAuth steps only, from the job's own agent and fix steps and never from a test step, including killed steps with no result; it logs them as `limits.reading`. A recording error is logged as `limits.observe_failed` and never fails the job. Nothing is gated on the readings yet (#63). The committed fixtures are scrubbed real captures where a human has made them (`testdata/CAPTURE.md`) and clearly named `synthetic_*` files elsewhere.\n311:3. **Steps.** One worker job is one state row, one pool slot and one attempt, but it runs several executor jobs, each in a fresh worktree detached at a SHA: the agent step (`<job id>`) at the branch head, or `origin/main` for a new branch; a test step (`<job id>t<k>`) and a fix step (`<job id>f<k>`) at the SHA the last push made. The branch itself belongs to the committer. Each step's handle is saved before it starts, so the Reaper's heartbeat and deadline rules apply to tests too. `timeout` covers the whole job: each step gets the time that is left, and with under two minutes left the loop stops and reports the tests as failed (\"ran out of time\"). `max_budget_usd` likewise caps the whole job: each agent step gets the cap minus the cost of the earlier steps (a step that reports no cost is assumed free and logged), and when nothing is left the job fails with `job budget exhausted`.\n404:budget_usd_per_day: 50       # whole repo, UTC day, blocks at spent >= cap; a role may set its own; provisional, recalibrated between Gate 1 and Gate 2\n405:max_budget_usd: 5            # per job; provisional, same recalibration\n430:**Models are tiered (decided, #8).** Opus 5.5 for the lead, architect and security review; Sonnet 5.5 for workers, triage engineer and most reviewers; Haiku 5.5 for lint and docs work. The `budget_usd_per_day: 50` and per-job `max_budget_usd` values are provisional and are recalibrated from measured cost per job and per merged PR between Gate 1 and Gate 2.\n432:Scanners also take `route` (`pending`, `none` or `needs-human`). Anything unset takes its default: intake in `label` mode with `ard:pending`, scanners every 4 h with `max_open` 5 and `group_size` 10, triage every 15 min, a 30-minute job timeout, `make test`, 2 test-fix attempts, 3 review rounds and worker diff thresholds of 1,000 lines (warn) and 2,000 lines (hold). Durations accept `m`, `h` and `d`. A sidecar `repo` must be `owner/name` and its `ref` a valid git ref name (no `:`, leading `-`, `..` or spaces; an abbreviated SHA is rejected, use all 40 characters); `ard config check` reports the file and key. A worker's `timeout` and `max_budget_usd` cover the whole job (every step), and `tests: \"\"` disables its test step. Per-role keys are `every`, `max_open`, `group_size`, `autoclose`, `timeout`, `agent`, `model`, `max_budget_usd`, `budget_usd_per_day` (that role's own daily cap in USD; unset or 0 means only the repo cap applies), `sidecar`, `after`, `plan_section`, `tests`, `max_test_fixes`, `max_review_rounds`, `diff_warn_lines` and `diff_max_lines` (worker roles; positive integers, warn no more than max; above warn the PR proceeds with a note, above max it is held), `reviewers` and `when` (`paths`, or `triage` roles that ran; at least one is required). `ard config check` warns when every reviewer has a `when:` rule, because a PR matching none gets no review and stays a draft. `plan_section` is for triage roles: the `## <heading>` of `plan.md` the role owns (one line, no leading `#`, unique across triage roles). The starter roles default to Requirements (product-manager), Design (architect), UX (designer), Docs (documentation-planner) and Implementation (engineer), and a value in `config.yaml` overrides that; a triage role with none may write only its own role file. There are no per-role config files: `ard init` writes a role's starting overrides into `config.yaml` for the roles it ships. Once a second repo adopts ard, role directories can move to a shared roles repo pinned by ref, like a sidecar; a repo's own directory of the same name wins. `after` names triage roles, with no self-reference and no cycles.\n447:- **Planted repo config does not steer agents.** A branch can carry CLAUDE.md, AGENTS.md, `.claude/` settings, hooks, skills, agents or a `.mcp.json`. The Claude adapter's flags stop all of them loading (see Executors). Residual risk: auth isolation comes from the empty per-job config dir and HOME, not a flag (the CLI reads no Keychain entry but the one keyed to the per-job dir); a host-mode job on macOS still runs as the operator's uid, so agent Bash could call `security` against the operator's login Keychain, including Claude's own entry, which is within the host-mode risk of #84 (a Dockerfile role or a dedicated macOS user for `ard serve` closes it); the subscription token is a one-year, model-only credential, rotated by running `claude setup-token` again and restarting `ard serve`; `--max-budget-usd` and `total_cost_usd` are estimates on a subscription; part of the block (AGENTS.md, and CLAUDE.md under `--restricted`) is observed behaviour that holds only on the tested CLI version and is re-checked by the integration tests; built-in plugins and the host's managed settings still apply; system reminders and fixed CLI prompt text are back; isolation of settings `env` is not pinned by a test, since no Bash call is scripted; Bash can still read anything the process can (host mode, #84); and an agent can rewrite CLAUDE.md or `.claude/` in its worktree, which later runs ignore but a worker PR could carry into the target repo (the `ard init` protected-path defaults cover `CLAUDE.md`, `AGENTS.md`, `.claude/` and `.mcp.json`, so such a PR needs a human).\n454:- **Budgets.** Every job has a dollar cap (`max_budget_usd`) and a hard timeout; every role and the whole repo have a daily dollar cap. The caps are enforced at the pool's claim gate (`internal/budget`): a candidate is refused when `spent >= cap`, where spent is the cost recorded in `step_usage` since 00:00 UTC today. The caps reset at 00:00 UTC and survive a restart, because spend is read from the controller database. A role's own `budget_usd_per_day` caps that role (by stage and name) alone; a role without one is limited only by the repo cap. Steps that reported no cost count as $0, and the refusal reason shows how many there were. There is no exemption for reviewers, the caps apply to OAuth credentials too, and deterministic scanners (no model, no cost) are exempt. Running jobs are never killed for a cap. If today's spend cannot be read, the gate refuses (fails closed). Each cap is logged once a day as `budget.capped`. `--loops` accepts `budget` as a name, but the gate is part of the pool and is always on. Posting the cap on the status issue is not part of this change.\n497:    P2 -->|\"Gate 3: 50% merged with no human code edits\"| P3[\"Phase 3: Scale<br/>k8s executor<br/>second repo<br/>shared roles repo<br/>budgets and digest\"]\n514:| Cost per merged PR | measured in Phase 1 from the Total row of the issue's cost table; daily budget set from it |\n--\ninternal/config/types.go:205:// RoleBudgetUSDPerDay is the role's own daily cap in USD. set is false when\ninternal/config/types.go-206-// the role has no override (an override of 0 or less counts as unset); then\ninternal/config/types.go-207-// only the repo-wide Resolved.BudgetUSDPerDay applies to it.\ninternal/config/types.go:208:func (r *Resolved) RoleBudgetUSDPerDay(role Role) (cap float64, set bool) {\ninternal/config/types.go-209-\tif role.BudgetUSDPerDay > 0 {\ninternal/config/types.go-210-\t\treturn role.BudgetUSDPerDay, true\ninternal/config/types.go-211-\t}\ninternal/config/types.go-212-\treturn 0, false\ninternal/config/types.go-213-}\ninternal/config/types.go-214-\ninternal/config/types.go-215-// HostUntrusted returns the roles that read untrusted input and have no\ninternal/config/types.go-216-// Dockerfile, so the local executor runs them as a host subprocess under the\ninternal/config/types.go-217-// controller's uid. Canonical order (kind, then name). It returns nothing\ninternal/config/types.go-218-// when Executor is \"k8s\", where host mode does not exist.\ninternal/config/types.go-219-func (r *Resolved) HostUntrusted() []Role {\ninternal/config/types.go-220-\tif r.Executor == \"k8s\" {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Goi9PYZZReqomPNCuTL3xo","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
