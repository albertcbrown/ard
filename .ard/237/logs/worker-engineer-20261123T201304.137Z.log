{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011ChLUHYjTCwx9kKGzMBytP","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GFa7j2WQxiCgj2SgZ2UNKn","name":"Bash","input":{"command":"cat > internal/budget/notice.go <<'E'\npackage budget\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"regexp\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// Name is the notice loop's name, as --loops spells it.\nconst Name = \"budget\"\n\n// Capper lists the caps reached today; *Gate satisfies it.\ntype Capper interface {\n\tCapped(ctx context.Context) ([]Cap, time.Time, error)\n}\n\n// EventStore is the part of *state.Store the loop uses.\ntype EventStore interface {\n\tAppendEvent(ctx context.Context, e state.Event) error\n\tEvents(ctx context.Context, f state.EventFilter) ([]state.Event, error)\n}\n\n// Effects is the part of effects.Effects the loop uses.\ntype Effects interface {\n\tCreateComment(ctx context.Context, n int, body string) (github.Comment, error)\n\tDryRun() bool\n}\n\n// Deps are the loop's collaborators. StatusIssue returns 0 until the status\n// issue is known. Now nil means time.Now; Log nil means slog.Default.\ntype Deps struct {\n\tGate        Capper\n\tStore       EventStore\n\tEffects     Effects\n\tStatusIssue func() int\n\tLog         *slog.Logger\n\tNow         func() time.Time\n}\n\n// Loop posts one status-issue comment per reached cap and UTC day. A\n// budget_capped event written after the comment is the record for #58 and the\n// marker that keeps a restart from posting the notice again.\ntype Loop struct {\n\td  Deps\n\tmu sync.Mutex\n}\n\n// NewLoop builds the notice loop.\nfunc NewLoop(d Deps) *Loop {\n\tif d.Now == nil {\n\t\td.Now = time.Now\n\t}\n\tif d.Log == nil {\n\t\td.Log = slog.Default()\n\t}\n\treturn &Loop{d: d}\n}\n\n// Name implements controller.Loop.\nfunc (*Loop) Name() string { return Name }\n\n// Interval implements controller.Loop.\nfunc (*Loop) Interval(*config.Resolved) time.Duration { return time.Minute }\n\n// Claims is false: the notice is bookkeeping about work already done.\nfunc (*Loop) Claims() bool { return false }\n\nvar _ controller.Loop = (*Loop)(nil)\n\ntype noticeKey struct{ scope, stage, role, day string }\n\n// Tick posts the notices that are due.\nfunc (l *Loop) Tick(ctx context.Context, _ controller.Env) error {\n\tl.mu.Lock()\n\tdefer l.mu.Unlock()\n\tissue := l.d.StatusIssue()\n\tif issue == 0 {\n\t\treturn nil\n\t}\n\tcaps, dayStart, err := l.d.Gate.Capped(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"budget: read spend: %w\", err)\n\t}\n\tif len(caps) == 0 {\n\t\treturn nil\n\t}\n\tday := dayStart.Format(\"2006-01-02\")\n\tevs, err := l.d.Store.Events(ctx, state.EventFilter{Kind: state.EventBudgetCapped, Since: dayStart})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"budget: read events: %w\", err)\n\t}\n\tdone := map[noticeKey]bool{}\n\tfor _, e := range evs {\n\t\tvar d struct {\n\t\t\tScope string `json:\"scope\"`\n\t\t\tDay   string `json:\"day\"`\n\t\t}\n\t\tif json.Unmarshal(e.Data, &d) == nil {\n\t\t\tdone[noticeKey{d.Scope, e.Stage, e.Role, d.Day}] = true\n\t\t}\n\t}\n\tfor _, c := range caps {\n\t\tif done[noticeKey{c.Scope, c.Stage, c.Role, day}] {\n\t\t\tcontinue\n\t\t}\n\t\tif _, err := l.d.Effects.CreateComment(ctx, issue, Render(c, day)); err != nil {\n\t\t\tl.d.Log.Error(\"budget.notice_failed\", \"scope\", c.Scope, \"stage\", c.Stage, \"role\", c.Role, \"error\", err)\n\t\t\tcontinue\n\t\t}\n\t\tdata, _ := json.Marshal(map[string]any{\n\t\t\t\"scope\": c.Scope, \"stage\": c.Stage, \"role\": c.Role, \"day\": day,\n\t\t\t\"spent_usd\": c.Spent.USD, \"cap_usd\": c.Limit, \"unpriced\": c.Spent.Unpriced,\n\t\t})\n\t\tev := state.Event{At: l.d.Now(), Kind: state.EventBudgetCapped, Stage: c.Stage, Role: c.Role, Data: data}\n\t\tif err := l.d.Store.AppendEvent(ctx, ev); err != nil {\n\t\t\tl.d.Log.Error(\"budget.notice_unrecorded\", \"scope\", c.Scope, \"stage\", c.Stage, \"role\", c.Role, \"error\", err)\n\t\t}\n\t}\n\treturn nil\n}\n\nvar safeName = regexp.MustCompile(`^[a-z0-9._/-]+$`)\n\nfunc safe(s string) string {\n\tif safeName.MatchString(s) {\n\t\treturn s\n\t}\n\treturn \"?\"\n}\n\n// Render is the comment for c on the UTC day (2006-01-02). It holds only\n// numbers, the day and config names; no agent text and no \"@\".\nfunc Render(c Cap, day string) string {\n\tvar b strings.Builder\n\twhat := \"The repo's daily budget\"\n\twhere := \"the repo-wide `budget_usd_per_day`\"\n\tscope := \"repo\"\n\tif c.Scope == \"role\" {\n\t\tstage, role := safe(c.Stage), safe(c.Role)\n\t\twhat = fmt.Sprintf(\"The daily budget of %s role `%s`\", stage, role)\n\t\twhere = fmt.Sprintf(\"`budget_usd_per_day` of role `%s` (or the repo-wide value)\", role)\n\t\tscope = \"role \" + stage + \"/\" + role\n\t}\n\tfmt.Fprintf(&b, \"<!-- ard:budget scope=%s day=%s -->\\n\", strings.ReplaceAll(scope, \" \", \"-\"), day)\n\tfmt.Fprintf(&b, \"**ard · daily budget reached**\\n\\n\")\n\tfmt.Fprintf(&b, \"%s is reached for %s (UTC): $%.2f of $%.2f spent.\", what, day, c.Spent.USD, c.Limit)\n\tif c.Spent.Unpriced > 0 {\n\t\tfmt.Fprintf(&b, \" %d steps reported no cost and count as $0.\", c.Spent.Unpriced)\n\t}\n\tb.WriteString(\"\\n\\nNo new jobs start under this cap; running jobs finish. On a subscription the dollar figure is an estimate.\\n\\n\")\n\tfmt.Fprintf(&b, \"To raise the cap, change %s in `.ard/config.yaml` through a reviewed pull request. The cap clears at 00:00 UTC.\\n\", where)\n\treturn b.String()\n}\nE\ncat > internal/budget/notice_test.go <<'E'\npackage budget\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"flag\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/controller\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\nvar update = flag.Bool(\"update\", false, \"rewrite golden files\")\n\ntype fakeCapper struct {\n\tcaps []Cap\n\tnow  *time.Time\n}\n\nfunc (f *fakeCapper) Capped(context.Context) ([]Cap, time.Time, error) {\n\treturn f.caps, utcDayStart(*f.now), nil\n}\n\ntype fakeFx struct {\n\tbodies []string\n\tnums   []int\n\terr    error\n\tdry    bool\n}\n\nfunc (f *fakeFx) CreateComment(_ context.Context, n int, body string) (github.Comment, error) {\n\tif f.err != nil {\n\t\treturn github.Comment{}, f.err\n\t}\n\tf.bodies = append(f.bodies, body)\n\tf.nums = append(f.nums, n)\n\treturn github.Comment{}, nil\n}\nfunc (f *fakeFx) DryRun() bool { return f.dry }\n\ntype noticeEnv struct {\n\tdir    string\n\tnow    time.Time\n\tcapper *fakeCapper\n\tfx     *fakeFx\n\tissue  int\n\tst     *state.Store\n}\n\nfunc newNoticeEnv(t *testing.T, caps ...Cap) *noticeEnv {\n\tt.Helper()\n\te := &noticeEnv{dir: t.TempDir(), now: time.Date(2026, 3, 4, 10, 0, 0, 0, time.UTC), fx: &fakeFx{}, issue: 7}\n\te.capper = &fakeCapper{caps: caps, now: &e.now}\n\tst, err := state.Open(context.Background(), e.dir, state.Options{Now: func() time.Time { return e.now }})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Cleanup(func() { st.Close() })\n\te.st = st\n\treturn e\n}\n\nfunc (e *noticeEnv) loop() *Loop {\n\treturn NewLoop(Deps{Gate: e.capper, Store: e.st, Effects: e.fx, StatusIssue: func() int { return e.issue }, Now: func() time.Time { return e.now }})\n}\n\nfunc (e *noticeEnv) tick(t *testing.T, l *Loop) {\n\tt.Helper()\n\tif err := l.Tick(context.Background(), controller.Env{}); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n\nvar (\n\trepoCap = Cap{Scope: \"repo\", Spent: state.Spend{USD: 50.5}, Limit: 50}\n\tengCap  = Cap{Scope: \"role\", Stage: \"worker\", Role: \"eng\", Spent: state.Spend{USD: 10}, Limit: 10}\n\trevCap  = Cap{Scope: \"role\", Stage: \"review\", Role: \"rev\", Spent: state.Spend{USD: 6, Unpriced: 3}, Limit: 5}\n)\n\nfunc TestNoticeOncePerScopePerDay(t *testing.T) {\n\te := newNoticeEnv(t, repoCap)\n\tl := e.loop()\n\te.tick(t, l)\n\te.tick(t, l)\n\tif len(e.fx.bodies) != 1 || e.fx.nums[0] != 7 {\n\t\tt.Fatalf(\"comments %v\", e.fx.nums)\n\t}\n\tevs, _ := e.st.Events(context.Background(), state.EventFilter{Kind: state.EventBudgetCapped})\n\tif len(evs) != 1 {\n\t\tt.Fatalf(\"events %d\", len(evs))\n\t}\n}\n\nfunc TestNoticeAcrossRestart(t *testing.T) {\n\te := newNoticeEnv(t, repoCap)\n\te.tick(t, e.loop())\n\te.tick(t, e.loop())\n\tif len(e.fx.bodies) != 1 {\n\t\tt.Fatalf(\"comments %d\", len(e.fx.bodies))\n\t}\n}\n\nfunc TestNoticeNextUTCDay(t *testing.T) {\n\te := newNoticeEnv(t, repoCap)\n\te.now = time.Date(2026, 3, 4, 23, 59, 0, 0, time.UTC)\n\tl := e.loop()\n\te.tick(t, l)\n\te.now = e.now.Add(2 * time.Minute)\n\te.tick(t, l)\n\tif len(e.fx.bodies) != 2 || !strings.Contains(e.fx.bodies[1], \"2026-03-05\") {\n\t\tt.Fatalf(\"bodies %q\", e.fx.bodies)\n\t}\n}\n\nfunc TestNoticeScopesIndependent(t *testing.T) {\n\te := newNoticeEnv(t, repoCap, engCap, revCap)\n\tl := e.loop()\n\te.tick(t, l)\n\te.tick(t, l)\n\tif len(e.fx.bodies) != 3 {\n\t\tt.Fatalf(\"comments %d\", len(e.fx.bodies))\n\t}\n}\n\nfunc TestNoticeNoStatusIssue(t *testing.T) {\n\te := newNoticeEnv(t, repoCap)\n\te.issue = 0\n\tl := e.loop()\n\te.tick(t, l)\n\tevs, _ := e.st.Events(context.Background(), state.EventFilter{Kind: state.EventBudgetCapped})\n\tif len(e.fx.bodies) != 0 || len(evs) != 0 {\n\t\tt.Fatal(\"posted before the status issue existed\")\n\t}\n\te.issue = 9\n\te.tick(t, l)\n\tif len(e.fx.bodies) != 1 || e.fx.nums[0] != 9 {\n\t\tt.Fatalf(\"comments %v\", e.fx.nums)\n\t}\n}\n\nfunc TestNoticeCommentFails(t *testing.T) {\n\te := newNoticeEnv(t, repoCap)\n\tl := e.loop()\n\te.fx.err = errors.New(\"boom\")\n\te.tick(t, l)\n\tevs, _ := e.st.Events(context.Background(), state.EventFilter{Kind: state.EventBudgetCapped})\n\tif len(evs) != 0 {\n\t\tt.Fatal(\"event wri