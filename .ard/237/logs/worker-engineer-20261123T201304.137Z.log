{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GZcqNPeCW2LpszVV1ucYRN","type":"tool_result","content":"// Package budget enforces the daily dollar caps at the pool's claim gate.\n//\n// The day is the UTC day. A candidate is refused when spent >= cap, for its\n// role's own cap (budget_usd_per_day on the role) or the repo cap. Steps that\n// reported no cost count as $0 and their number is shown. Reviewers get no\n// exemption; deterministic scanners cost nothing and are exempt. A job that\n// already holds a slot is never touched: the gate only sees new candidates.\n// A state read failure denies (fails closed).\npackage budget\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/pool\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// SpendReader reads today's spend; *state.Store satisfies it.\ntype SpendReader interface {\n\tSpendSince(ctx context.Context, dayStart time.Time) (map[state.RoleKey]state.Spend, state.Spend, error)\n}\n\n// Gate is the pool's Options.Budget hook.\ntype Gate struct {\n\tstore SpendReader\n\tcfg   func() *config.Resolved\n\tnow   func() time.Time\n\tlog   *slog.Logger\n\n\tmu     sync.Mutex\n\tday    time.Time       // UTC day start the logged map belongs to\n\tlogged map[string]bool // caps already logged on day\n}\n\n// New builds a Gate. cfg returns the latest config (nil: nothing is capped);\n// now nil means time.Now; log nil means slog.Default.\nfunc New(store SpendReader, cfg func() *config.Resolved, now func() time.Time, log *slog.Logger) *Gate {\n\tif now == nil {\n\t\tnow = time.Now\n\t}\n\tif log == nil {\n\t\tlog = slog.Default()\n\t}\n\treturn &Gate{store: store, cfg: cfg, now: now, log: log, logged: map[string]bool{}}\n}\n\nfunc kindOf(c pool.Class) (config.Kind, string, bool) {\n\tswitch c {\n\tcase pool.ClassScanner:\n\t\treturn config.KindScanner, c.String(), true\n\tcase pool.ClassTriage:\n\t\treturn config.KindTriage, c.String(), true\n\tcase pool.ClassWorker:\n\t\treturn config.KindWorker, c.String(), true\n\tcase pool.ClassReview:\n\t\treturn config.KindReviewer, c.String(), true\n\t}\n\treturn \"\", \"\", false\n}\n\n// Denied reports whether a cap forbids starting c, and why.\nfunc (g *Gate) Denied(c pool.Candidate) (bool, string) {\n\tkind, stage, ok := kindOf(c.Class)\n\tif !ok {\n\t\treturn false, \"\"\n\t}\n\tcfg := g.cfg()\n\tif cfg == nil {\n\t\treturn false, \"\"\n\t}\n\trole, ok := cfg.Role(kind, c.Role)\n\tif !ok || (kind == config.KindScanner && role.ScanPath != \"\") {\n\t\treturn false, \"\"\n\t}\n\tnow := g.now().UTC()\n\tdayStart := time.Date(now.Year(), now.Month(), now.Day(), 0, 0, 0, 0, time.UTC)\n\tctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)\n\tdefer cancel()\n\tper, repo, err := g.store.SpendSince(ctx, dayStart)\n\tif err != nil {\n\t\tg.log.Error(\"budget.read_failed\", \"error\", err)\n\t\treturn true, \"budget: spend unreadable, failing closed\"\n\t}\n\tif cfg.BudgetUSDPerDay > 0 && repo.USD >= cfg.BudgetUSDPerDay {\n\t\treturn true, g.capped(dayStart, \"repo\", \"\", repo, cfg.BudgetUSDPerDay)\n\t}\n\tif limit, set := cfg.RoleBudgetUSDPerDay(role); set {\n\t\tsp := per[state.RoleKey{Stage: stage, Role: c.Role}]\n\t\tif sp.USD >= limit {\n\t\t\treturn true, g.capped(dayStart, \"role\", stage+\"/\"+c.Role, sp, limit)\n\t\t}\n\t}\n\treturn false, \"\"\n}\n\n// capped builds the reason and logs budget.capped once per cap and UTC day.\nfunc (g *Gate) capped(dayStart time.Time, scope, role string, sp state.Spend, limit float64) string {\n\treason := fmt.Sprintf(\"%s daily budget reached: $%.2f of $%.2f spent today (UTC)\", scope, sp.USD, limit)\n\tif sp.Unpriced > 0 {\n\t\treason += fmt.Sprintf(\", %d unpriced steps counted as $0\", sp.Unpriced)\n\t}\n\tg.mu.Lock()\n\tif !g.day.Equal(dayStart) {\n\t\tg.day, g.logged = dayStart, map[string]bool{}\n\t}\n\tkey := scope + \"|\" + role\n\tfirst := !g.logged[key]\n\tg.logged[key] = true\n\tg.mu.Unlock()\n\tif first {\n\t\tg.log.Warn(\"budget.capped\", \"scope\", scope, \"role\", role, \"spent_usd\", sp.USD, \"cap_usd\", limit, \"unpriced\", sp.Unpriced)\n\t}\n\treturn reason\n}\npackage state\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/state/sqlitex\"\n)\n\n// Event kinds.\nconst (\n\tEventClaim    = \"claim\"\n\tEventCloseout = \"closeout\"\n\tEventFailure  = \"failure\"\n\tEventRetry    = \"retry\"\n\t// EventUsageLimit: a job stopped at a usage limit. It is not a failure.\n\tEventUsageLimit = \"usage_limit\"\n\t// EventKill: the Reaper is about to kill a running job; data has the reason.\n\tEventKill      = \"kill\"\n\tEventTickError = \"tick_error\"\n\t// EventHostUntrusted: a host-mode job of a role that reads untrusted\n\t// input started. Stage, role, job and issue are in their columns.\n\tEventHostUntrusted = \"host_untrusted\"\n\t// EventGate: the triage fan-in gate acted; data has verdict, reason and worker.\n\tEventGate = \"gate\"\n\t// EventMerge: the merger squash-merged a PR; data has pr, head and merge_sha.\n\tEventMerge = \"merge\"\n\t// EventReviewRound: a review fix round changed phase; data has round, phase, reason, pr, head, worker and roles.\n\tEventReviewRound = \"review_round\"\n\t// EventReviewRerequest: the merger removed a stale :done review label so the\n\t// review re-runs; data has pr, head and reviewed. Stage is review and role\n\t// is the reviewer role. One per head: it stops the merger from looping.\n\tEventReviewRerequest = \"review_rerequest\"\n)\n\n// Event is one row of the append-only event log. Data holds structured fields\n// only: never log text, issue bodies or secrets.\ntype Event struct {\n\tID    int64\n\tAt    time.Time\n\tKind  string\n\tJobID string\n\tIssue int\n\tStage string\n\tRole  string\n\tData  json.RawMessage\n}\n\n// EventFilter selects events; zero values are unbounded.\ntype EventFilter struct {\n\tSince, Until time.Time\n\tKind         string\n\tIssue        int    // 0 = any\n\tStage, Role  string // \"\" = any\n\tLimit        int\n}\n\ntype execer interface {\n\tExecContext(ctx context.Context, q string, args ...any) (sql.Result, error)\n}\n\nfunc insertEvent(ctx context.Context, x execer, e Event) error {\n\tif len(e.Data) > 0 && !json.Valid(e.Data) {\n\t\treturn fmt.Errorf(\"event %s: data is not valid JSON\", e.Kind)\n\t}\n\tvar data any\n\tif len(e.Data) > 0 {\n\t\tdata = string(e.Data)\n\t}\n\tvar job, stage, role any\n\tif e.JobID != \"\" {\n\t\tjob = e.JobID\n\t}\n\tif e.Stage != \"\" {\n\t\tstage = e.Stage\n\t}\n\tif e.Role != \"\" {\ninternal/budget:\nbudget.go\nbudget_test.go\n\ninternal/servecmd:\nadopt.go\nadopt_test.go\nbudget.go\nbudget_test.go\ncfgloader.go\ncfgloader_test.go\nclone.go\nclone_test.go\ncommitters.go\njanitor.go\nlimits_test.go\nloops_test.go\nmerger.go\nobserve.go\nobserve_test.go\nreaping.go\nreaping_test.go\nrebuild.go\nrebuild_test.go\nreviewer.go\nreviewer_e2e_test.go\nreviewfix.go\nreviewfix_e2e_test.go\nscanners.go\nscanners_test.go\nserve.go\nserve_test.go\ntriage.go\ntriage_e2e_test.go\ntriage_test.go\nwake_other.go\nwake_unix.go\nwake_unix_test.go\nworker.go\nworker_e2e_test.go\npackage servecmd\n\nimport (\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/budget\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n)\n\n// budgetGate returns the one daily-budget gate of this process, built on first\n// use from the store and the latest loaded config.\nfunc (w *wiring) budgetGate() *budget.Gate {\n\tw.initMu.Lock()\n\tdefer w.initMu.Unlock()\n\tif w.bgt == nil {\n\t\tnow := w.budgetNow\n\t\tif now == nil {\n\t\t\tnow = time.Now\n\t\t}\n\t\tw.bgt = budget.New(w.Store, func() *config.Resolved { return w.cfg.Load() }, now, w.Log)\n\t}\n\treturn w.bgt\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"8e94895a-9c89-43aa-8887-d0c651a574b4","uuid":"1