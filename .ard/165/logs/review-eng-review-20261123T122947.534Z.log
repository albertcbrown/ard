they can read the GitHub App key and `~/.config/gh` by absolute path, write the controller's clone, and undo `chmod a-w`. Host mode is allowed for every role ([#84](https://github.com/albertcbrown/ard/issues/84)), but a role that reads untrusted input (every triage, worker and reviewer role, and an LLM scanner) warns loudly when it has no `Dockerfile`; deterministic scanners are exempt, and nothing warns under `executor: k8s`, where every job runs in a container. `ard config check` and the first successful config load of `ard serve` (and any role a later config adds) log one `executor.host_untrusted` WARN per such role and also write it to stderr, so it survives `--log-level`. The local executor logs the WARN again for every host-mode job of such a role and appends a `host_untrusted` row to the `events` table. Each warning lists what the job can reach, including `~/.ard` (state, config snapshots, the pause file, other jobs' worktrees and logs). The owner accepts this risk while ard runs only on owner-controlled repos, and revisits it when moving to the spark cluster, where every job runs in a container once the k8s executor (#54) lands. Until then the Gate 1 dry-run soak on spark (see Rollout and Delivery) runs `ard serve` with the local executor in a pod, and the deterministic cve scanner runs there as a host subprocess of the controller container: its role directory has no `Dockerfile`, and the `ard` image carries its pinned tools. Only deterministic scanners run in that pod. `ard serve` and `ard config check` refuse to run on git older than 2.47.0, because the committer's fetches fail on older versions.\n \n A worker job is several executor jobs (`<id>`, `<id>t1`, `<id>f1`, ...) under one state job and one slot; the Reaper watches whichever step is stored on the job, so its heartbeat and deadline rules apply to tests too.\n \ndiff --git a/internal/configcmd/config.go b/internal/configcmd/config.go\nindex cc32225..7d6c12f 100644\n--- a/internal/configcmd/config.go\n+++ b/internal/configcmd/config.go\n@@ -17,12 +17,18 @@ import (\n \t\"github.com/albertcbrown/ard/internal/labels\"\n )\n \n+// gitBin is the git binary the version check runs; empty means \"git\". Tests override it.\n+var gitBin = \"\"\n+\n // Check is the handler behind `ard config check`. It prints the resolved\n // configuration to stdout even when validation fails; the load error (all\n // collected errors, one per line) is returned so the CLI layer prints it\n // to stderr and exits non-zero. With o.Ref set it validates that commit\n // instead of the working tree; it does not fetch, so authoring stays offline.\n func Check(ctx context.Context, e *cli.Env, o cli.ConfigCheckOpts) error {\n+\tif err := gitx.New(gitBin).CheckVersion(ctx); err != nil {\n+\t\treturn fmt.Errorf(\"ard config check: %w\", err)\n+\t}\n \troot, err := config.RepoRoot(e.ConfigPath)\n \tif err != nil {\n \t\treturn fmt.Errorf(\"ard config check: %w\", err)\ndiff --git a/internal/configcmd/config_test.go b/internal/configcmd/config_test.go\nindex ac2d4bd..cc8c575 100644\n--- a/internal/configcmd/config_test.go\n+++ b/internal/configcmd/config_test.go\n@@ -323,3 +323,20 @@ func TestCheckIntakeLabel(t *testing.T) {\n \t\t}\n \t})\n }\n+\n+func TestCheckRefusesOldGit(t *testing.T) {\n+\tshim := filepath.Join(t.TempDir(), \"git\")\n+\tif err := os.WriteFile(shim, []byte(\"#!/bin/sh\\necho 'git version 2.39.5'\\n\"), 0o755); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tgitBin = shim\n+\tt.Cleanup(func() { gitBin = \"\" })\n+\te, stdout, _ := testEnv(t, t.TempDir())\n+\terr := Check(context.Background(), e, cli.ConfigCheckOpts{})\n+\tif err == nil || !strings.Contains(err.Error(), \"ard config check:\") || !strings.Contains(err.Error(), \"2.39.5\") {\n+\t\tt.Fatalf(\"err = %v\", err)\n+\t}\n+\tif stdout.Len() != 0 {\n+\t\tt.Errorf(\"stdout = %q\", stdout.String())\n+\t}\n+}\ndiff --git a/internal/gitx/version.go b/internal/gitx/version.go\nnew file mode 100644\nindex 0000000..c17dbb1\n--- /dev/null\n+++ b/internal/gitx/version.go\n@@ -0,0 +1,74 @@\n+package gitx\n+\n+import (\n+\t\"context\"\n+\t\"fmt\"\n+\t\"regexp\"\n+\t\"strconv\"\n+)\n+\n+// Version is a git release number.\n+type Version struct{ Major, Minor, Patch int }\n+\n+// MinVersion is the oldest git the committer's fetches work on. git 2.39.5\n+// fails with \"did not send all necessary objects\" (#163); 2.47.3 passes. The\n+// exact boundary is unverified, so this is a conservative choice.\n+var MinVersion = Version{2, 47, 0}\n+\n+func (v Version) String() string { return fmt.Sprintf(\"%d.%d.%d\", v.Major, v.Minor, v.Patch) }\n+\n+// Less reports whether v is older than o.\n+func (v Version) Less(o Version) bool {\n+\tif v.Major != o.Major {\n+\t\treturn v.Major < o.Major\n+\t}\n+\tif v.Minor != o.Minor {\n+\t\treturn v.Minor < o.Minor\n+\t}\n+\treturn v.Patch < o.Patch\n+}\n+\n+var fullVersionRe = regexp.MustCompile(`^git version (\\d+)\\.(\\d+)(?:\\.(\\d+))?`)\n+\n+// ParseVersion parses the output of `git --version`, tolerating a missing\n+// patch number and vendor suffixes.\n+func ParseVersion(s string) (Version, error) {\n+\tm := fullVersionRe.FindStringSubmatch(s)\n+\tif m == nil {\n+\t\treturn Version{}, fmt.Errorf(\"gitx: cannot parse git version from %q\", s)\n+\t}\n+\tvar n [3]int\n+\tfor i := range n {\n+\t\tif m[i+1] == \"\" {\n+\t\t\tcontinue\n+\t\t}\n+\t\tv, err := strconv.Atoi(m[i+1])\n+\t\tif err != nil {\n+\t\t\treturn Version{}, fmt.Errorf(\"gitx: cannot parse git version from %q\", s)\n+\t\t}\n+\t\tn[i] = v\n+\t}\n+\treturn Version{n[0], n[1], n[2]}, nil\n+}\n+\n+// FullVersion runs `git --version` and returns the full number.\n+func (g *Git) FullVersion(ctx context.Context) (Version, error) {\n+\tout, _, err := g.run(ctx, \"\", nil, \"\", nil, \"--version\")\n+\tif err != nil {\n+\t\treturn Version{}, err\n+\t}\n+\treturn ParseVersion(out)\n+}\n+\n+// CheckVersion returns an error when git is missing, unparseable or older\n+// than MinVersion.\n+func (g *Git) CheckVersion(ctx context.Context) error {\n+\tv, err := g.FullVersion(ctx)\n+\tif err != nil {\n+\t\treturn fmt.Errorf(\"check git version: %w\", err)\n+\t}\n+\tif v.Less(MinVersion) {\n+\t\treturn fmt.Errorf(\"git %s is too old: ard needs git %s or newer (the committer's fetches fail on older versions)\", v, MinVersion)\n+\t}\n+\treturn nil\n+}\ndiff --git a/internal/gitx/version_test.go b/internal/gitx/version_test.go\nnew file mode 100644\nindex 0000000..6861107\n--- /dev/null\n+++ b/internal/gitx/version_test.go\n@@ -0,0 +1,80 @@\n+package gitx\n+\n+import (\n+\t\"context\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+func TestParseVersion(t *testing.T) {\n+\tok := map[string]Version{\n+\t\t\"git version 2.39.5\\n\":               {2, 39, 5},\n+\t\t\"git version 2.50.1 (Apple Git-155)\": {2, 50, 1},\n+\t\t\"git version 2.47\":                   {2, 47, 0},\n+\t\t\"git version 2.48.0.rc1\":             {2, 48, 0},\n+\t\t\"git version 2.51.0.windows.1\":       {2, 51, 0},\n+\t}\n+\tfor in, want := range ok {\n+\t\tgot, err := ParseVersion(in)\n+\t\tif err != nil || got != want {\n+\t\t\tt.Errorf(\"ParseVersion(%q) = %v, %v; want %v\", in, got, err, want)\n+\t\t}\n+\t}\n+\tfor _, in := range []string{\"\", \"garbage\", \"git version x.y\"} {\n+\t\tif _, err := ParseVersion(in); err == nil {\n+\t\t\tt.Errorf(\"ParseVersion(%q): want error\", in)\n+\t\t}\n+\t}\n+}\n+\n+func TestVersionLess(t *testing.T) {\n+\tcases := []struct {\n+\t\ta, b Version\n+\t\twant bool\n+\t}{\n+\t\t{Version{1, 9, 9}, Version{2, 0, 0}, true},\n+\t\t{Version{2, 39, 5}, Version{2, 47, 0}, true},\n+\t\t{Version{2, 46, 9}, Version{2, 47, 0}, true},\n+\t\t{Version{2, 47, 0}, Version{2, 47, 0}, false},\n+\t\t{Version{2, 47, 1}, Version{2, 47, 0}, false},\n+\t\t{Version{3, 0, 0}, Version{2, 99, 99}, false},\n+\t}\n+\tfor _, c := range cases {\n+\t\tif got := c.a.Less(c.b); got != c.want {\n+\t\t\tt.Errorf(\"%v.Less(%v) = %v\", c.a, c.b, got)\n+\t\t}\n+\t}\n+}\n+\n+func shim(t *testing.T, out string) string {\n+\tt.Helper()\n+\tp := filepath.Join(t.TempDir(), \"git\")\n+\tif err := os.WriteFile(p, []byte(\"#!/bin/sh\\necho '\"+out+\"'\\n\"), 0o755); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\treturn p\n+}\n+\n+func TestCheckVersion(t *testing.T) {\n+\tctx := context.Background()\n+\terr := New(shim(t, \"git version 2.39.5\")).CheckVersion(ctx)\n+\tif err == nil || !strings.Contains(err.Error(), \"2.39.5\") || !strings.Contains(err.Error(), \"2.47.0\") {\n+\t\tt.Errorf(\"old git: got %v\", err)\n+\t}\n+\tif err := New(shim(t, \"git version 2.46.9\")).CheckVersion(ctx); err == nil {\n+\t\tt.Error(\"2.46.9 should be rejected\")\n+\t}\n+\tfor _, v := range []string{\"2.47.0\", \"2.56.1\"} {\n+\t\tif err := New(shim(t, \"git version \"+v)).CheckVersion(ctx); err != nil {\n+\t\t\tt.Errorf(\"%s: %v\", v, err)\n+\t\t}\n+\t}\n+\tif err := New(shim(t, \"junk\")).CheckVersion(ctx); err == nil {\n+\t\tt.Error(\"junk: want error\")\n+\t}\n+\tif err := New(filepath.Join(t.TempDir(), \"nope\")).CheckVersion(ctx); err == nil {\n+\t\tt.Error(\"missing binary: want error\")\n+\t}\n+}\ndiff --git a/internal/servecmd/serve.go b/internal/servecmd/serve.go\nindex 290bf99..8b63626 100644\n--- a/internal/servecmd/serve.go\n+++ b/internal/servecmd/serve.go\n@@ -56,6 +56,9 @@ type deps struct {\n // builder constructs deps for repo. stateDir is where a dry-run ledger goes.\n type builder func(ctx context.Context, e *cli.Env, repo github.Repo, stateDir string) (deps, error)\n \n+// gitBin is the git binary the version check runs; empty means \"git\". Tests override it.\n+var gitBin = \"\"\n+\n // Serve is the handler behind `ard serve`.\n func Serve(ctx context.Context, e *cli.Env) error { return serve(ctx, e, buildDeps) }\n \n@@ -72,6 +75,9 @@ func serve(ctx context.Context, e *cli.Env, build builder) error {\n \tif err != nil {\n \t\treturn err\n \t}\n+\tif err := gitx.New(gitBin).CheckVersion(ctx); err != nil {\n+\t\treturn &cli.ExitError{Code: 1, Err: fmt.Errorf(\"ar