{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011ChLMGWcMSaDxfNsQMkuMj","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_017QWh4kfMcRVYfV6dK6rvRK","name":"Bash","input":{"command":"mkdir internal/budget && cat > internal/budget/budget.go <<'EOF'\n// Package budget enforces the daily dollar caps at the pool's claim gate.\n//\n// The day is the UTC day. A candidate is refused when spent >= cap, for its\n// role's own cap (budget_usd_per_day on the role) or the repo cap. Steps that\n// reported no cost count as $0 and their number is shown. Reviewers get no\n// exemption; deterministic scanners cost nothing and are exempt. A job that\n// already holds a slot is never touched: the gate only sees new candidates.\n// A state read failure denies (fails closed).\npackage budget\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/pool\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// SpendReader reads today's spend; *state.Store satisfies it.\ntype SpendReader interface {\n\tSpendSince(ctx context.Context, dayStart time.Time) (map[state.RoleKey]state.Spend, state.Spend, error)\n}\n\n// Gate is the pool's Options.Budget hook.\ntype Gate struct {\n\tstore SpendReader\n\tcfg   func() *config.Resolved\n\tnow   func() time.Time\n\tlog   *slog.Logger\n\n\tmu     sync.Mutex\n\tday    time.Time       // UTC day start the logged map belongs to\n\tlogged map[string]bool // caps already logged on day\n}\n\n// New builds a Gate. cfg returns the latest config (nil: nothing is capped);\n// now nil means time.Now; log nil means slog.Default.\nfunc New(store SpendReader, cfg func() *config.Resolved, now func() time.Time, log *slog.Logger) *Gate {\n\tif now == nil {\n\t\tnow = time.Now\n\t}\n\tif log == nil {\n\t\tlog = slog.Default()\n\t}\n\treturn &Gate{store: store, cfg: cfg, now: now, log: log, logged: map[string]bool{}}\n}\n\nfunc kindOf(c pool.Class) (config.Kind, string, bool) {\n\tswitch c {\n\tcase pool.ClassScanner:\n\t\treturn config.KindScanner, c.String(), true\n\tcase pool.ClassTriage:\n\t\treturn config.KindTriage, c.String(), true\n\tcase pool.ClassWorker:\n\t\treturn config.KindWorker, c.String(), true\n\tcase pool.ClassReview:\n\t\treturn config.KindReviewer, c.String(), true\n\t}\n\treturn \"\", \"\", false\n}\n\n// Denied reports whether a cap forbids starting c, and why.\nfunc (g *Gate) Denied(c pool.Candidate) (bool, string) {\n\tkind, stage, ok := kindOf(c.Class)\n\tif !ok {\n\t\treturn false, \"\"\n\t}\n\tcfg := g.cfg()\n\tif cfg == nil {\n\t\treturn false, \"\"\n\t}\n\trole, ok := cfg.Role(kind, c.Role)\n\tif !ok || (kind == config.KindScanner && role.ScanPath != \"\") {\n\t\treturn false, \"\"\n\t}\n\tnow := g.now().UTC()\n\tdayStart := time.Date(now.Year(), now.Month(), now.Day(), 0, 0, 0, 0, time.UTC)\n\tctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)\n\tdefer cancel()\n\tper, repo, err := g.store.SpendSince(ctx, dayStart)\n\tif err != nil {\n\t\tg.log.Error(\"budget.read_failed\", \"error\", err)\n\t\treturn true, \"budget: spend unreadable, failing closed\"\n\t}\n\tif cfg.BudgetUSDPerDay > 0 && repo.USD >= cfg.BudgetUSDPerDay {\n\t\treturn true, g.capped(dayStart, \"repo\", \"\", repo, cfg.BudgetUSDPerDay)\n\t}\n\tif limit, set := cfg.RoleBudgetUSDPerDay(role); set {\n\t\tsp := per[state.RoleKey{Stage: stage, Role: c.Role}]\n\t\tif sp.USD >= limit {\n\t\t\treturn true, g.capped(dayStart, \"role\", stage+\"/\"+c.Role, sp, limit)\n\t\t}\n\t}\n\treturn false, \"\"\n}\n\n// capped builds the reason and logs budget.capped once per cap and UTC day.\nfunc (g *Gate) capped(dayStart time.Time, scope, role string, sp state.Spend, limit float64) string {\n\treason := fmt.Sprintf(\"%s daily budget reached: $%.2f of $%.2f spent today (UTC)\", scope, sp.USD, limit)\n\tif sp.Unpriced > 0 {\n\t\treason += fmt.Sprintf(\", %d unpriced steps counted as $0\", sp.Unpriced)\n\t}\n\tg.mu.Lock()\n\tif !g.day.Equal(dayStart) {\n\t\tg.day, g.logged = dayStart, map[string]bool{}\n\t}\n\tkey := scope + \"|\" + role\n\tfirst := !g.logged[key]\n\tg.logged[key] = true\n\tg.mu.Unlock()\n\tif first {\n\t\tg.log.Warn(\"budget.capped\", \"scope\", scope, \"role\", role, \"spent_usd\", sp.USD, \"cap_usd\", limit, \"unpriced\", sp.Unpriced)\n\t}\n\treturn reason\n}\nEOF\npython3 - <<'EOF'\nimport re\np='internal/servecmd/adopt.go'\ns=open(p).read()\ns=s.replace('''// account or model family is out of quota from starting.\nfunc adoptPool(ctx context.Context, l jobLister, maxPods int, log *slog.Logger, limited func(pool.Candidate) time.Time) (''','''// account or model family is out of quota from starting. budget, when\n// non-nil, is the pool's Options.Budget: it refuses candidates at a daily cap.\nfunc adoptPool(ctx context.Context, l jobLister, maxPods int, log *slog.Logger, limited func(pool.Candidate) time.Time, budget func(pool.Candidate) (bool, string)) (''')\ns=s.replace('Log: log, Limited: limited}','Log: log, Limited: limited, Budget: budget}')\nopen(p,'w').write(s)\np='internal/servecmd/serve.go'\ns=open(p).read()\ns=s.replace('w.MaxPods, log, w.limitedFor)','w.MaxPods, log, w.limitedFor, w.budgetGate().Denied)')\ns=s.replace('\"merger\", \"reaper\"}','\"merger\", \"reaper\", \"budget\"}',1)\ns=s.replace('''// order they register.''','''// order they register. \"budget\" is the claim gate: it is built into the pool\n// whatever --loops says, so naming it selects no loop of its own.''')\ns=s.replace('\tlim    *limits.Book\\n','\tlim    *limits.Book\\n\tbgt    *budget.Gate\\n')\ns=s.replace('import (','import (\\n\t\"github.com/albertcbrown/ard/internal/budget\"',1)\nopen(p,'w').write(s)\np='internal/servecmd/adopt_test.go'\ns=open(p).read()\ns=s.replace('nil)\\n','nil, nil)\\n') if False else s\ns=s.replace('slog.New(slog.NewTextHandler(io.Discard, nil)), nil)','slog.New(slog.NewTextHandler(io.Discard, nil)), nil, nil)')\ns=s.replace('2, nil, nil); err == nil','2, nil, nil, nil); err == nil')\ns=s.replace('adoptPool(context.Background(), r, 2, log, nil)','adoptPool(context.Background(), r, 2, log, nil, nil)')\ns=s.replace('return until })','return until }, nil)')\nopen(p,'w').write(s)\np='internal/servecmd/loops_test.go'\ns=open(p).read()\ns=s.replace('\"merger\", \"reaper\"}','\"merger\", \"reaper\", \"budget\"}')\nopen(p,'w').write(s)\nEOF\ncat > internal/servecmd/budget.go <<'EOF'\npackage servecmd\n\nimport (\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/budget\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n)\n\n// budgetGate returns the one daily-budget gate of this process, built on first\n// use from the store and the latest loaded config.\nfunc (w *wiring) budgetGate() *budget.Gate {\n\tw.initMu.Lock()\n\tdefer w.initMu.Unlock()\n\tif w.bgt == nil {\n\t\tw.bgt = budget.New(w.Store, func() *config.Resolved { return w.cfg.Load() }, time.Now, w.Log)\n\t}\n\treturn w.bgt\n}\nEOF\ngofmt -w internal/servecmd/serve.go; go build ./... && go vet ./internal/servecmd ./internal/budget 2>&1 | head; sed -n 1,12p internal/servecmd/serve.go"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":376,"cache_read_input_tokens":35298,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":376},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8d23dce7-d7be-43a4-888a-f4c7b737fbff","uuid":"a2725e0e-6440-4bcf-ab0c-0ea79fd8de51","timestamp":"2026-11-23T18:41:40.789Z","request_id":"req_011ChLMGWTw9k4PXTsxNaxtw"}
