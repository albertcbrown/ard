{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PrXd4mR8sgzAZwuqEYpcQg","type":"tool_result","content":"package state\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"fmt\"\n\t\"math\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strings\"\n)\n\n// Tokens are token counts by type.\ntype Tokens struct{ Input, Output, CacheWrite, CacheRead int64 }\n\n// StepUsage is what one agent run reported.\ntype StepUsage struct {\n\tModels  []string // validated model ids; nil when none\n\tTokens  *Tokens  // nil: not reported\n\tCostUSD *float64 // nil: not reported\n}\n\n// JobUsage is a job's usage summed over its steps.\ntype JobUsage struct {\n\tModels  []string // union, sorted\n\tTokens  *Tokens  // nil when no step reported tokens\n\tCostUSD *float64 // nil when no step reported a cost\n\tSteps   int\n}\n\nvar (\n\tstepRE  = regexp.MustCompile(`^[0-9A-Za-z]{1,64}$`)\n\tmodelRE = regexp.MustCompile(`^[A-Za-z0-9._:\\[\\]/-]{1,100}$`)\n)\n\nconst maxModels = 8\n\n// ValidModel reports whether s may be stored as a model id.\nfunc ValidModel(s string) bool { return modelRE.MatchString(s) }\n\n// RecordStepUsage stores one step once: a second call for the same job and step\n// is a no-op that returns recorded=false. In the same transaction it sets\n// jobs.cost_usd to the sum of the job's step costs (NULL when none), so a\n// failed, retried or usage-limited job keeps its cost.\nfunc (s *Store) RecordStepUsage(ctx context.Context, jobID, step string, u StepUsage) (bool, error) {\n\tif !stepRE.MatchString(step) {\n\t\treturn false, fmt.Errorf(\"record step usage %s: invalid step %q\", jobID, step)\n\t}\n\tif t := u.Tokens; t != nil && (t.Input < 0 || t.Output < 0 || t.CacheWrite < 0 || t.CacheRead < 0) {\n\t\treturn false, fmt.Errorf(\"record step usage %s: negative token count\", jobID)\n\t}\n\tif c := u.CostUSD; c != nil && (math.IsNaN(*c) || math.IsInf(*c, 0) || *c < 0) {\n\t\treturn false, fmt.Errorf(\"record step usage %s: invalid cost\", jobID)\n\t}\n\tseen := map[string]bool{}\n\tvar models []string\n\tfor _, m := range u.Models {\n\t\tif !modelRE.MatchString(m) || seen[m] {\n\t\t\tcontinue\n\t\t}\n\t\tseen[m] = true\n\t\tmodels = append(models, m)\n\t}\n\tsort.Strings(models)\n\tif len(models) > maxModels {\n\t\tmodels = models[:maxModels]\n\t}\n\tvar mv, ti, to, tw, tr, cv any\n\tif len(models) > 0 {\n\t\tmv = strings.Join(models, \",\")\n\t}\n\tif t := u.Tokens; t != nil {\n\t\tti, to, tw, tr = t.Input, t.Output, t.CacheWrite, t.CacheRead\n\t}\n\tif u.CostUSD != nil {\n\t\tcv = *u.CostUSD\n\t}\n\ttx, err := s.db.BeginTx(ctx, nil)\n\tif err != nil {\n\t\treturn false, fmt.Errorf(\"record step usage %s: begin: %w\", jobID, err)\n0001_init.sql\n0002_reaper.sql\n0003_admissions.sql\n0004_limits.sql\n0005_usage.sql\n0006_cost_tables.sql\npackage pool\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"io\"\n\t\"log/slog\"\n\t\"sort\"\n\t\"sync\"\n\t\"time\"\n)\n\n// Verdict is the pool's answer for one candidate.\ntype Verdict int\n\n// Verdicts. Anything other than Granted means the loop touches no label and\n// writes no state; the candidate is offered again next tick.\nconst (\n\tGranted         Verdict = iota\n\tDeniedFull              // no slot was free for it, and no other loop reserved one\n\tDeniedOutranked         // higher-ranked live demand from another loop reserved the free slots\n\tDeniedIssueBusy         // triage only: a triage job on the same issue is held or granted earlier in the batch\n\tDeniedDuplicate         // same key already held, or earlier in this batch\n\tDeniedInvalid           // malformed candidate (caller bug)\n\tDeniedLimited           // its account or model family is out of quota until a reset time\n)\n\nvar verdictNames = [...]string{\"granted\", \"full\", \"outranked\", \"issue-busy\", \"duplicate\", \"invalid\", \"limited\"}\n\n// String returns the verdict's log name.\nfunc (v Verdict) String() string {\n\tif v >= 0 && int(v) < len(verdictNames) {\n\t\treturn verdictNames[v]\n\t}\n\treturn fmt.Sprintf(\"verdict(%d)\", int(v))\n}\n\n// Decision is the result for one offered candidate.\ntype Decision struct {\n\tCandidate Candidate\n\tVerdict   Verdict\n\tSlot      *Slot  // non-nil if and only if Verdict == Granted\n\tReason    string // human-readable, for logs and the status issue\n}\n\n// Held is a job already running when the pool is built (restart recovery).\ntype Held struct {\n\tCandidate Candidate\n\tJobID     string\n}\n\n// Options configures New.\ntype Options struct {\n\tMax         int              // cfg.MaxPods; values < 1 are treated as 1\n\tNow         func() time.Time // nil means time.Now\n\tLog         *slog.Logger     // nil means discard\n\tHeld        []Held           // running jobs from state; held even if they exceed Max\n\tStarveAfter time.Duration    // 0 means 24h\n\t// Limited reports when a candidate may next start because its account or\n\t// model family is out of quota: zero or a past time means it may start\n\t// now. nil disables the check. A limited candidate takes no slot and\n\t// reserves no demand: it does not hold lower classes back.\n\tLimited func(c Candidate) time.Time\n}\n\n// Pool is the in-memory slot arbiter. One mutex guards all state; there are\n// no goroutines or timers, and demand expiry is evaluated lazily.\ntype Pool struct {\n\tmu          sync.Mutex\n\tmax         int\n\tnow         func() time.Time\n\tlog         *slog.Logger\n\tstarveAfter time.Duration\n\tlimited     func(c Candidate) time.Time\n\theld        map[string]*Slot\n\tdemand      map[string]*loopDemand\n\tfirstDenied map[string]time.Time\n\tstarved     map[Class]bool\n}\n\n25:\tDeniedLimited           // its account or model family is out of quota until a reset time\n28:var verdictNames = [...]string{\"granted\", \"full\", \"outranked\", \"issue-busy\", \"duplicate\", \"invalid\", \"limited\"}\n59:\t// Limited reports when a candidate may next start because its account or\n61:\t// now. nil disables the check. A limited candidate takes no slot and\n63:\tLimited func(c Candidate) time.Time\n74:\tlimited     func(c Candidate) time.Time\n88:\t\tlimited:     o.Limited,\n173:\t\tif p.limited != nil {\n174:\t\t\tif until := p.limited(c); now.Before(until) {\n175:\t\t\t\tdecisions[i].Verdict = DeniedLimited\n\tfor _, j := range jobs {\n\t\tif j.Stage == \"scanner\" {\n\t\t\tcontinue // phase 0 jobs do not survive a restart; failStaleScannerJobs retires them\n\t\t}\n\t\tclass, err := pool.ParseClass(j.Stage)\n\t\tif err != nil {\n\t\t\treturn nil, fmt.Errorf(\"adopt job %s: %w\", j.ID, err)\n\t\t}\n\t\tn := 0\n\t\tswitch class {\n\t\tcase pool.ClassReview:\n\t\t\tn = j.PR\n\t\tcase pool.ClassTriage, pool.ClassWorker:\n\t\t\tn = j.Issue\n\t\t}\n\t\tif class != pool.ClassScanner && n == 0 {\n\t\t\treturn nil, fmt.Errorf(\"adopt job %s: %s job has no issue or PR number\", j.ID, j.Stage)\n\t\t}\n\t\tout = append(out, pool.Held{\n\t\t\tCandidate: pool.Candidate{Class: class, Role: j.Role, Number: n, Since: j.CreatedAt},\n\t\t\tJobID:     j.ID,\n\t\t})\n\t}\n\treturn out, nil\n}\n\n// adoptPool builds the slot pool holding every job already running. limited,\n// when non-nil, is the pool's Options.Limited: it keeps candidates whose\n// account or model family is out of quota from starting.\nfunc adoptPool(ctx context.Context, l jobLister, maxPods int, log *slog.Logger, limited func(pool.Candidate) time.Time) (*pool.Pool, error) {\n\theld, err := heldJobs(ctx, l)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tlog.Info(\"pool.adopt\", \"held\", len(held), \"max\", maxPods)\n\treturn pool.New(pool.Options{Max: maxPods, Held: held, Log: log, Limited: limited}), nil\n}\n\n// scannerJobStore is what retiring stale scanner jobs needs; *state.Store\n// satisfies it.\ntype scannerJobStore interface {\n\tRunningJobs(ctx context.Context) ([]state.Job, error)\n\tFail(ctx context.Context, id, reason string, keepUntil time.Time) error\n}\n\n// workspaceCleaner is the executor call used to remove a dead job's workspace.\ntype workspaceCleaner interface {\n\tCleanup(ctx context.Context, h executor.Handle, o executor.CleanupOptions) error\n}\n\n// failStaleScannerJobs retires scanner jobs still marked running at startup.\n// A phase 0 scan does not survive a restart, and a scanner job adopted as a\n// held slot would make every later Offer for its key a duplicate, so the\n// scanner would silently never run again. Each job's workspace is cleaned up\n// on a best-effort basis, the job is failed, and it is not held. ex may be nil.\nfunc failStaleScannerJobs(ctx context.Context, jobs scannerJobStore, ex workspaceCleaner, log *slog.Logger) error {\n\trunning, err := jobs.RunningJobs(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"list running scanner jobs: %w\", err)\n\t}\n\tvar errs []error\n\tfor _, j := range running {\n\t\tif j.Stage != \"scanner\" {\n\t\t\tcontinue\n\t\t}\n\t\tif ex != nil && len(j.Handle) > 0 {\n\t\t\tvar h executor.Handle\n\t\t\tif err := json.Unmarshal(j.Handle, &h); err != nil {\n\t\t\t\tlog.Warn(\"scanner.stale_job_handle\", \"job\", j.ID, \"error\", err)\n\t\t\t} else if err := ex.Cleanup(ctx, h, executor.CleanupOptions{}); err != nil {\n\t\t\t\tlog.Warn(\"scanner.stale_job_cleanup\", \"job\", j.ID, \"error\", err)\n\t\t\t}\n\t\t}\n\t\tif err := jobs.Fail(ctx, j.ID, \"controller restarted\", time.Time{}); err != nil {\n\t\t\terrs = append(errs, fmt.Errorf(\"fail stale scanner job %s: %w\", j.ID, err))\n\t\t\tcontinue\n\t\t}\n\t\tlog.Info(\"scanner.stale_job_failed\", \"job\", j.ID, \"scanner\", j.Role)\n\t}\n\treturn errors.Join(errs...)\n}\n84:// knownLoops are the names registerLoops' loops report (Loop.Name), in the\n85-// order they register.\n86:var knownLoops = []string{\"scanners\", stale.Name, \"triage\", \"workers\", \"reviewers\", \"reviewfix\", \"merger\", \"reaper\"}\n87-\n88-// selectLoops keeps the loops named in want, in registration order; an empty\n89-// want keeps every loop. A name that is not a known loop is a usage error\n90-// (exit 