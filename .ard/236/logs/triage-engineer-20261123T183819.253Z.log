n\t\tif p.held[k] != nil {\n\t\t\tp.log.Warn(\"pool.adopt_duplicate\", \"key\", k, \"job_id\", h.JobID)\n\t\t\tcontinue\n\t\t}\n\t\tp.held[k] = &Slot{pool: p, cand: h.Candidate, jobID: h.JobID, grantedAt: p.now(), adopted: true}\n\t}\n\tif len(p.held) > p.max {\n\t\tp.log.Warn(\"pool.adopt_over_max\", \"held\", len(p.held), \"max\", p.max)\n\t}\n\treturn p\n}\n\n// SetMax changes the cap. It never revokes held slots; n < 1 is treated as 1.\nfunc (p *Pool) SetMax(n int) {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\tp.max = max(1, n)\n}\n\n// Lookup returns the held slot for key, for close-out and the Reaper after a restart.\nfunc (p *Pool) Lookup(key string) (*Slot, bool) {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\ts, ok := p.held[key]\n\treturn s, ok\n}\n\ntype item struct {\n\tcand Candidate\n\tidx  int // index into decisions; -1 for foreign demand\n}\n\n// Offer ranks cands against held slots and other loops' live demand and\n// returns one Decision per candidate, in input order. It replaces loop's\n// demand entry, which expires ttl after this call (ttl <= 0 records none).\n// Loops must call Offer once per tick even with no candidates, so stale\n\t\tcase pool.ClassReview:\n\t\t\tn = j.PR\n\t\tcase pool.ClassTriage, pool.ClassWorker:\n\t\t\tn = j.Issue\n\t\t}\n\t\tif class != pool.ClassScanner && n == 0 {\n\t\t\treturn nil, fmt.Errorf(\"adopt job %s: %s job has no issue or PR number\", j.ID, j.Stage)\n\t\t}\n\t\tout = append(out, pool.Held{\n\t\t\tCandidate: pool.Candidate{Class: class, Role: j.Role, Number: n, Since: j.CreatedAt},\n\t\t\tJobID:     j.ID,\n\t\t})\n\t}\n\treturn out, nil\n}\n\n// adoptPool builds the slot pool holding every job already running. limited,\n// when non-nil, is the pool's Options.Limited: it keeps candidates whose\n// account or model family is out of quota from starting.\nfunc adoptPool(ctx context.Context, l jobLister, maxPods int, log *slog.Logger, limited func(pool.Candidate) time.Time) (*pool.Pool, error) {\n\theld, err := heldJobs(ctx, l)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tlog.Info(\"pool.adopt\", \"held\", len(held), \"max\", maxPods)\n\treturn pool.New(pool.Options{Max: maxPods, Held: held, Log: log, Limited: limited}), nil\n}\n\n// scannerJobStore is what retiring stale scanner jobs needs; *state.Store\n// satisfies it.\ntype scannerJobStore interface {\n\n// limitsBook returns the one limits book of this process, opened on first use.\n// An open error is a real store read failure (a corrupt value only logs), so\n// it is returned and not cached.\nfunc (w *wiring) limitsBook(ctx context.Context) (*limits.Book, error) {\n\tw.initMu.Lock()\n\tdefer w.initMu.Unlock()\n\tif w.lim != nil {\n\t\treturn w.lim, nil\n\t}\n\tb, err := limits.Open(ctx, w.Store, time.Now, w.Log)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"serve: %w\", err)\n\t}\n\tw.lim = b\n\treturn b, nil\n}\n\n// limitedFor is the pool's Options.Limited: when a candidate may next start\n// given the usage limits recorded so far. Deterministic scanners use no model\n// and are never limited. A role missing from the config is never offered, so\n// it is not limited either.\nfunc (w *wiring) limitedFor(c pool.Candidate) time.Time {\n\tvar kind config.Kind\n\tswitch c.Class {\n\tcase pool.ClassScanner:\n\t\tkind = config.KindScanner\n\tcase pool.ClassTriage:\n\t\tkind = config.KindTriage\n\tcase pool.ClassWorker:\n\t\tkind = config.KindWorker\n\tcase pool.ClassReview:\n\t\tkind = config.KindReviewer\n\tdefault:\n\t\treturn time.Time{}\n\t}\n\tcfg := w.cfg.Load()\n\tif cfg == nil {\n\t\treturn time.Time{}\n\t}\n\trole, ok := cfg.Role(kind, c.Role)\n\tif !ok || (kind == config.KindScanner && role.ScanPath != \"\") {\n\t\treturn time.Time{}\n\t}\n\tw.initMu.Lock()\n\tbook := w.lim\n\tw.initMu.Unlock()\n\tif book == nil {\n\t\treturn time.Time{}\n\t}\n\treturn book.Until(limits.FamilyOf(role.Model))\n}\n\n// finisher returns the shared Finisher the loops call when a job's process\n// has stopped (see package reaper for the contract).\nfunc (w *wiring) finisher() (*reaper.Finisher, error) {\n\tf, _, err := w.reaperParts()\n\treturn f, err\n}\n\n// reaperLoop returns the Reaper loop, or nil when the executor cannot be built.\n(eval):1: no matches found: --include=*.go\n84:\t\ttokens_cache_write, tokens_cache_read, cost_usd, recorded_at) VALUES(?,?,?,?,?,?,?,?,?)\n\t\tmv = strings.Join(models, \",\")\n\t}\n\tif t := u.Tokens; t != nil {\n\t\tti, to, tw, tr = t.Input, t.Output, t.CacheWrite, t.CacheRead\n\t}\n\tif u.CostUSD != nil {\n\t\tcv = *u.CostUSD\n\t}\n\ttx, err := s.db.BeginTx(ctx, nil)\n\tif err != nil {\n\t\treturn false, fmt.Errorf(\"record step usage %s: begin: %w\", jobID, err)\n\t}\n\tdefer tx.Rollback() //nolint:errcheck\n\tres, err := tx.ExecContext(ctx, `INSERT INTO step_usage(job_id, step, models, tokens_in, tokens_out,\n\t\ttokens_cache_write, tokens_cache_read, cost_usd, recorded_at) VALUES(?,?,?,?,?,?,?,?,?)\n\t\tON CONFLICT(job_id, step) DO NOTHING`, jobID, step, mv, ti, to, tw, tr, cv, s.now().Unix())\n\tif err != nil {\n\t\treturn false, fmt.Errorf(\"record step usage %s: %w\", jobID, err)\n\t}\n\tn, err := res.RowsAffected()\n\tif err != nil {\n\t\treturn false, fmt.Errorf(\"record step usage %s: %w\", jobID, err)\n\t}\n\tif n == 0 {\n\t\treturn false, nil\n\t}\n\tif _, err := tx.ExecContext(ctx, `UPDATE jobs SET cost_usd = (SELECT SUM(cost_usd) FROM step_usage WHERE job_id = ?) WHERE id = ?`, jobID, jobID); err != nil {\n\t\treturn false, fmt.Errorf(\"record step usage %s: job cost: %w\", jobID, err)\n\t}\n\tif err := tx.Commit(); err != nil {\n\t\treturn false, fmt.Errorf(\"record step usage %s: commit: %w\", jobID, err)\n180:2. **Backpressure, in code, before the scanner starts.** The controller counts open issues with `ard:scanner:<name>`; at or above `max_open` it skips the run and logs it, autoclose scanners included: a scanner at its cap does not run with a zero filing budget, so it cannot autoclose its own fixed issues until a human or the stale closer frees a slot. A global cap across all scanners (`global_max_open`) stops a bad day from burying the queue. A skipped run is not queued: it counts as a run, and the next scheduled run checks again.\n183:5. **Group.** Findings that share a `group` key join one issue, up to `group_size` (N), as a checklist with one line per finding (ticked lines count towards N). An empty `group` means one issue per finding. New findings join an open group issue of the same group that has room and is not yet claimed, meaning it carries no `ard:` label besides `ard:scanner:<name>` and `ard:pending`; otherwise they start a new one. A regression never joins: it always opens a new issue, which may also hold new findings of the same group. The number of new issues per run is `min(max_open - open, global_max_open - global open)`; joins are free. Findings over that budget are filed most severe first, and the rest stay unrecorded so the next run offers them again.\n278:**Agent CLIs plug in through adapters.** Each adapter turns (prompt file, context paths, budget) into a command line and parses the exit code and, where the CLI reports them, turns and cost. For Claude Code that is `claude -p --output-format=stream-json --verbose --restricted --safe-mode --strict-mcp-config --disable-slash-commands --permission-mode=dontAsk --settings='{\"includeGitInstructions\":false,\"disableAllHooks\":true}' --tools=… --allowed-tools=… --disallowed-tools=… --model <model> --max-budget-usd <max_budget_usd> --append-system-prompt-file <role prompt> -- <message>` (`--verbose` is required by `stream-json` in print mode). Every stage (scanner, triage, worker, review) gets the same tool profile: `--tools` and `--allowed-tools` are `Read,Glob,Grep,Edit,Write,Bash`, and `--disallowed-tools` is `Bash(git commit *),Bash(git push *),Bash(git remote *),Bash(gh *)` (decided, #79). ard does not pass `--bare`: it limits the CLI to Bash, Read and Edit, and `--tools` cannot widen it (#105). The planted-config isolation `--bare` gave comes instead from `--restricted` (only managed settings and `--settings` load), `--safe-mode` (no CLAUDE.md or AGENTS.md, skills, agents, hooks, MCP servers or auto memory), `--strict-mcp-config`, `--disable-slash-commands`, and `--settings` that turns off hooks and the git status snapshot (commit subjects are third-party text). `CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=1` is set as a fixed env var (the executor allows it) so Bash cannot detach commands. The integration tests pin each of these against a worktree with planted config and must be re-run on every `TestedVersion` bump. The tool list is not a security boundary, and the deny list is advisory, because shell indirection gets around it. The real boundaries are the missing GitHub token (Docker; see the host-mode note above, #84), the committer, which commits only `.ard/<issue#>/` from a triage or review job (other edits are discarded with the worktree), and the diff guard on worker changes. An explicit tool list from the caller (`Spec.Tools`) replaces the allow list and keeps the deny list. The user message holds only fixed text and the paths of the untrusted input files. The installed CLI accepts an undocumented `--max-turns`; ard does not rely on it, so a per-job dollar cap and the executor's hard timeout bound each run. Agents run with an empty per-job CLI config dir and HOME and receive exactly one model credential, passed by name by the executor and never visible to the adapter: an API key (`ANTHROPIC_API_KEY`) or a subscription OAuth token (`CLAUDE_CODE_OAUTH_TOKEN`, from `claude setup-token`); that rests on the environment, not on a CLI flag. `ard serve` chooses the credential from its own environment: `ARD_AGENT_AUTH` is `auto` (the default; the token if set, else the key), `oauth` or `apikey`, and an explicit mode never falls back to the other variable. Only one is ever passed, because the CLI prefers the API key and would silently bill it (pinned by an integration test). A missing credential does not stop startup, because deterministic scanners need none: `ard serve` logs one INFO line, and a job that needs one fails with a clear error. The executor creates the per-job config dir as `<job home>/.claude` (0700) in `prepare` (`Handle.View.ConfigDir`; under Docker it is a bind mount at `/ard-config`), refuses to start a job whose config dir is not that empty directory, and removes it with the job home; the Reaper's `KeepWorktree` retention keeps it too, and it holds no credential, since the credential travels only in the environment. `CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=1`, which would keep the token out of Bash children, is not set (decided, #125). Residual risk: an API key (`ANTHROPIC_API_KEY`) is inherited by Bash children; on the tested release the CLI does not pass `CLAUDE_CODE_OAUTH_TOKEN` to them; and either credential can still be read from the `claude` process's own environment (`/proc/$PPID/environ` on Linux, `ps eww` on macOS). The container is the boundary: it holds no GitHub token, and the credential is scoped to the model. The scrub is off because on 2.1.328 it requires bubblewrap (and socat) plus unprivileged user namespaces; Docker blocks those under ard's flags (`--cap-drop ALL`, `no-new-privileges`, default seccomp), so every Bash call would fail closed and without bwrap the CLI refuses to start. On macOS host mode it worked and matched the `dontAsk` outcomes. It can be revisited for host mode or a loosened container. What agent Bash can read differs by mode: under Docker, only the job's own credential; in host mode, far more, because any same-uid process's environment is readable (`ps eww <pid>` on macOS, `/proc/<pid>/environ` on Linux), including `ard serve`'s own, which holds both credentials. The scrub would not close that; it is part of the host-mode risk of #84. `kimi` and `dsh-tui` both run headless with `-p`; neither has a turn cap and `kimi` reports no cost, so turns and cost are optional in the adapter result. `config.yaml` names the default CLI and any per-role override, so a role can move between CLIs without touching its prompt. The Claude adapter also reads a usage limit and token usage from the stream: a limit comes from a `rate_limit_event` with status `rejected` (its `resetsAt` is the reset time), from the CLI's own error text (`You've hit your session, weekly, Opus or Sonnet limit`) and from `rate_limit` or `billing_error` errors, and it records `usage` and `modelUsage` token counts (by input, output, cache write and cache read; per model when the result has `modelUsage`, which is preferred for accounting). That text is matched only on paths the CLI itself writes (an assistant message carrying an `error`, or an errored result with HTTP 429 or `api_error`), never in agent output, because an agent can be made to print the phrase. Only the job's own agent step and its fix steps are read for a limit: a worker's test step runs agent-written code, so its output is never classified (a printed limit line there cannot block the account). With an API key a 429 stays a transient `rate_limit` retry; only subscription (OAuth) runs have usage limits. The committed fixtures are scrubbed real captures where a human has made them (`testdata/CAPTURE.md`) and clearly named `synthetic_*` files elsewhere.\n305:3. **Steps.** One worker job is one state row, one pool slot and one attempt, but it runs several executor jobs, each in a fresh worktree detached at a SHA: the agent step (`<job id>`) at the branch head, or `origin/main` for a new branch; a test step (`<job id>t<k>`) and a fix step (`<job id>f<k>`) at the SHA the last push made. The branch itself belongs to the committer. Each step's handle is saved before it starts, so the Reaper's heartbeat and deadline rules apply to tests too. `timeout` covers the whole job: each step gets the time that is left, and with under two minutes left the loop stops and reports the tests as failed (\"ran out of time\"). `max_budget_usd` likewise caps the whole job: each agent step gets the cap minus the cost of the earlier steps (a step that reports no cost is assumed free and logged), and when nothing is left the job fails with `job budget exhausted`.\n394:budget_usd_per_day: 50       # whole repo; provisional, recalibrated between Gate 1 and Gate 2\n395:max_budget_usd: 5            # per job; provisional, same recalibration\n420:**Models are tiered (decided, #8).** Opus 5.5 for the lead, architect and security review; Sonnet 5.5 for workers, triage engineer and most reviewers; Haiku 5.5 for lint and docs work. The `budget_usd_per_day: 50` and per-job `max_budget_usd` values are provisional and are recalibrated from measured cost per job and per merged PR between Gate 1 and Gate 2.\n422:Anything unset takes its default: intake in `label` mode with `ard:pending`, scanners every 4 h with `max_open` 5 and `group_size` 10, triage every 15 min, a 30-minute job timeout, `make test`, 2 test-fix attempts and 3 review rounds. Durations accept `m`, `h` and `d`. A sidecar `repo` must be `owner/name` and its `ref` a valid git ref name (no `:`, leading `-`, `..` or spaces; an abbreviated SHA is rejected, use all 40 characters); `ard config check` reports the file and key. A worker's `timeout` and `max_budget_usd` cover the whole job (every step), and `tests: \"\"` disables its test step. Per-role keys are `every`, `max_open`, `group_size`, `autoclose`, `timeout`, `agent`, `model`, `max_budget_usd`, `budget_usd_per_day`, `sidecar`, `after`, `plan_section`, `tests`, `reviewers` and `when` (`paths`, or `triage` roles that ran; at least one is required). `ard config check` warns when every reviewer has a `when:` rule, because a PR matching none gets no review and stays a draft. `plan_section` is for triage roles: the `## <heading>` of `plan.md` the role owns (one line, no leading `#`, unique across triage roles). The starter roles default to Requirements (product-manager), Design (architect), UX (designer), Docs (documentation-planner) and Implementation (engineer), and a value in `config.yaml` overrides that; a triage role with none may write only its own role file. There are no per-role config files: `ard init` writes a role's starting overrides into `config.yaml` for the roles it ships. Once a second repo adopts ard, role directories can move to a shared roles repo pinned by ref, like a sidecar; a repo's own directory of the same name wins. `after` names triage roles, with no self-reference and no cycles.\n437:- **Planted repo config does not steer agents.** A branch can carry CLAUDE.md, AGENTS.md, `.claude/` settings, hooks, skills, agents or a `.mcp.json`. The Claude adapter's flags stop all of them loading (see Executors). Residual risk: auth isolation comes from the empty per-job config dir and HOME, not a flag (the CLI reads no Keychain entry but the one keyed to the per-job dir); a host-mode job on macOS still runs as the operator's uid, so agent Bash could call `security` against the operator's login Keychain, including Claude's own entry, which is within the host-mode risk of #84 (a Dockerfile role or a dedicated macOS user for `ard serve` closes it); the subscription token is a one-year, model-only credential, rotated by running `claude setup-token` again and restarting `ard serve`; `--max-budget-usd` and `total_cost_usd` are estimates on a subscription; part of the block (AGENTS.md, and CLAUDE.md under `--restricted`) is observed behaviour that holds only on the tested CLI version and is re-checked by the integration tests; built-in plugins and the host's managed settings still apply; system reminders and fixed CLI prompt text are back; isolation of settings `env` is not pinned by a test, since no Bash call is scripted; Bash can still read anything the process can (host mode, #84); and an agent can rewrite CLAUDE.md or `.claude/` in its worktree, which later runs ignore but a worker PR could carry into the target repo (the `ard init` protected-path defaults cover `CLAUDE.md`, `AGENTS.md`, `.claude/` and `.mcp.json`, so such a PR needs a human).\n444:- **Budgets.** Every job has a dollar cap (`max_budget_usd`) and a hard timeout; every role and the whole repo have a daily dollar cap. At the cap the controller stops claiming and posts once on the status issue.\n487:    P2 -->|\"Gate 3: 50% merged with no human code edits\"| P3[\"Phase 3: Scale<br/>k8s executor<br/>second repo<br/>shared roles repo<br/>budgets and digest\"]\n504:| Cost per merged PR | measured in Phase 1 from the Total row of the issue's cost table; daily budget set from it |\n37:\tNow func() time.Time // nil => time.Now; stored as UTC seconds\n57:\tnow := o.Now\n59:\t\tnow = time.Now","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01PekwDHhb8QUe92nLAupRdt","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
