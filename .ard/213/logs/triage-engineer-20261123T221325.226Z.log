{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FKkvASBn2w9iYGQUKbncY4","type":"tool_result","content":"//go:build ignore\n\n// missingtests lists Go functions that the module's tests do not run, or that\n// no test calls by name, as ard scanner findings (JSON lines on stdout).\n//\n// It is built by the missing-tests scan driver (added in a later change). It\n// carries the ignore build tag, so go vet ./... and go build ./... skip it.\n// It reads `go list -json` output and a coverage profile that the driver\n// produced; it never runs repository code, and uses only the standard\n// library. It fails closed: on any error it prints \"missing-tests: <what>\" to\n// stderr, nothing on stdout, and exits 1.\npackage main\n\nimport (\n\t\"bufio\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"flag\"\n\t\"fmt\"\n\t\"go/ast\"\n\t\"go/parser\"\n\t\"go/token\"\n\t\"io\"\n\t\"os\"\n\t\"path\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n)\n\nconst (\n\tmaxFindings    = 10000\n\tmaxFingerprint = 512\n\tmaxTitleRunes  = 200\n\tmaxGroupBytes  = 256\n\tmaxBodyRunes   = 1900\n)\n\n// implicitMethods are called implicitly by the standard library, so a test\n// need not name them: a covered one is never reported.\nvar implicitMethods = map[string]bool{\n\t\"Error\": true, \"Unwrap\": true, \"Is\": true, \"As\": true, \"String\": true,\n\t\"GoString\": true, \"Format\": true, \"MarshalJSON\": true, \"UnmarshalJSON\": true,\n\t\"MarshalText\": true, \"UnmarshalText\": true, \"MarshalYAML\": true,\n\t\"UnmarshalYAML\": true, \"MarshalBinary\": true, \"UnmarshalBinary\": true,\n\t\"LogValue\": true, \"ServeHTTP\": true,\n}\n\n// listedPackage is the subset of `go list -json` that the helper reads.\ntype listedPackage struct {\n\tImportPath, Name, Dir              string\n\tGoFiles, TestGoFiles, XTestGoFiles []string\n}\n\n// block is one coverage block of the profile.\ntype block struct {\n\tStartLine, StartCol, EndLine, EndCol, NumStmt int\n\tCovered                                       bool\n}\n\ntype funcInfo struct {\n\tPkg        *listedPackage\n\tFile       string // repo-relative slash path\n\tLine       int\n\tSymbol     string // \"F\" or \"T.M\"\n\tMethod     string // \"M\" for methods, \"\" for functions\n\tExported   bool\n\tStart, End token.Position\n\tHasStmts   bool\n}\n\n// finding matches scanner.Finding's JSON shape; field order is the schema order.\ntype finding struct {\n\tFingerprint string   `json:\"fingerprint\"`\n\tTitle       string   `json:\"title\"`\n\tSeverity    string   `json:\"severity\"`\n\tGroup       string   `json:\"group\"`\n\tFiles       []string `json:\"files\"`\n\tBody        string   `json:\"body\"`\n}\n\ntype testRefs struct {\n\tinternal  map[string]map[string]bool // import path -> idents in its TestGoFiles\n\tqualified map[string]map[string]bool // import path -> names used as X.Name, X being that package's import name\n\tselectors map[string]bool            // every Sel.Name in any test file\n}\n118:\tfs := flag.NewFlagSet(\"missingtests\", flag.ContinueOnError)\ncve\ndocs\nlts\nmissing-tests\n\ninternal/roles/testdata/cve:\nboth_tools\ncve_only\nempty\nexcluded_manifests\ngv_only\nhostile_name\nnested_module\nnot_called\nosv_only\nregen.sh\nscoped_npm\nseverity_fallbacks\nsymbol_called\ntoolchain_switch\ntwo_ghsa\nuntrusted_summary\n\ninternal/roles/testdata/cve/both_tools:\ngv.jsonl\nosv.json\nwant.jsonl\n\ninternal/roles/testdata/cve/cve_only:\ngv.jsonl\n5:func mtModule(t *testing.T, files map[string]string) string {\n21:func mtCases(t *testing.T) []string {\n39:func TestMissingTestsHelper(t *testing.T) {\n65:func TestMissingTestsHelperOutputDecodes(t *testing.T) {\n87:func TestMissingTestsFingerprintStable(t *testing.T) {\n130:func TestMissingTestsHelperLimits(t *testing.T) {\n173:func TestMissingTestsHelperErrors(t *testing.T) {\n215:func TestMissingTestsHelperVets(t *testing.T) {\ncosts\nlogs\ntriage-engineer.md\ntriage-lead.md\n//go:build integration\n\npackage roles\n\nimport (\n\t\"fmt\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"testing\"\n\t\"time\"\n)\n\n// TestDocsIntegrationDocker runs the real docs role in its real image under the\n// executor's container flags (noexec /tmp, read-only worktree) with no network,\n// over the funcs_methods fixture. Needs Docker and the pinned base image.\nfunc TestDocsIntegrationDocker(t *testing.T) {\n\tif _, err := exec.LookPath(\"docker\"); err != nil {\n\t\tt.Skip(\"docker not on PATH\")\n\t}\n\tif _, _, code := dockerOut(t, 30*time.Second, \"info\"); code != 0 {\n\t\tt.Skip(\"docker daemon not available\")\n\t}\n\ttag := fmt.Sprintf(\"ard-docs-it:%d\", time.Now().UnixNano())\n\tif _, se, code := dockerOut(t, 15*time.Minute, \"build\", \"-q\", \"-t\", tag, \"scanners/docs\"); code != 0 {\n\t\tt.Fatalf(\"docker build: %s\", se)\n\t}\n\tt.Cleanup(func() { dockerOut(t, time.Minute, \"image\", \"rm\", tag) })\n\troleDir, err := filepath.Abs(\"scanners/docs\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\trepo, err := filepath.Abs(\"testdata/docs/funcs_methods/src\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\targs := scanRunArgs(tag, repo, roleDir, \"TMPDIR=/var/tmp\")\n\targs = append([]string{args[0], \"--network\", \"none\"}, args[1:]...)\n\tout, se, code := dockerOut(t, 10*time.Minute, args...)\n\tif code != 0 {\n\t\tt.Fatalf(\"exit %d\\n%s\", code, se)\n\t}\n\tif want := readFile(t, \"testdata/docs/funcs_methods/want.jsonl\"); out != want {\n\t\tt.Errorf(\"stdout differs from want.jsonl:\\n got: %s\\nwant: %s\", out, want)\n\t}\n}\n24:func goEnv() []string {\n28:// buildDocscan builds scanners/docs/docscan.go once, from a temp dir so the\n29:// repo's go.mod is not consulted, and vets it (go vet ./... skips ignore-tagged\n30:// files).\n31:func buildDocscan(t *testing.T) string {\n62:func runDocscan(t *testing.T, args ...string) (stdout, stderr string, code int) {\n77:func fixtureArgs(c string) []string {\n85:func fileEx