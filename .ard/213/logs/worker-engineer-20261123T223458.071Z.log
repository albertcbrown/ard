c TestMissingTestsScanFailures(t *testing.T) {\n\tscript := mtScript(t)\n\tt.Run(\"failing test\", func(t *testing.T) {\n\t\trepo := mtModule(t, map[string]string{\n\t\t\t\"p/p.go\":      \"package p\\n\\nfunc F() int { return 1 }\\n\",\n\t\t\t\"p/p_test.go\": \"package p\\n\\nimport \\\"testing\\\"\\n\\nfunc TestF(t *testing.T) { t.Fatal(\\\"boom\\\") }\\n\",\n\t\t})\n\t\tout, se, code := runDocsScript(t, script, repo)\n\t\tif code != 1 || out != \"\" || !strings.Contains(se, \"go test failed in .\") {\n\t\t\tt.Fatalf(\"exit %d, stdout %q, stderr %s\", code, out, se)\n\t\t}\n\t})\n\tt.Run(\"build error\", func(t *testing.T) {\n\t\trepo := mtModule(t, map[string]string{\"p/p.go\": \"package p\\n\\nfunc F() int { return \\\"x\\\" }\\n\"})\n\t\tout, se, code := runDocsScript(t, script, repo)\n\t\tif code != 1 || out != \"\" {\n\t\t\tt.Fatalf(\"exit %d, stdout %q, stderr %s\", code, out, se)\n\t\t}\n\t})\n\tt.Run(\"no go\", func(t *testing.T) {\n\t\tsh, err := exec.LookPath(\"sh\")\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tcmd := exec.Command(sh, script)\n\t\tcmd.Dir = t.TempDir()\n\t\tcmd.Env = []string{\"PATH=\" + t.TempDir()}\n\t\tvar se bytes.Buffer\n\t\tcmd.Stderr = &se\n\t\terr = cmd.Run()\n\t\tee, ok := err.(*exec.ExitError)\n\t\tif !ok || ee.ExitCode() != 2 || !strings.Contains(se.String(), \"go not found\") {\n\t\t\tt.Fatalf(\"err %v, stderr %s\", err, se.String())\n\t\t}\n\t})\n\tt.Run(\"no modules\", func(t *testing.T) {\n\t\tout, se, code := runDocsScript(t, script, t.TempDir())\n\t\tif code != 0 || out != \"\" {\n\t\t\tt.Fatalf(\"exit %d, stdout %q, stderr %s\", code, out, se)\n\t\t}\n\t})\n}\n\nfunc TestMissingTestsScanNestedModule(t *testing.T) {\n\trepo := mtModule(t, map[string]string{\n\t\t\"a.go\": \"package mt\\n\\nfunc Root() int { return 1 }\\n\",\n\t\t\"sub/go.mod\": \"module example.com/sub\\n\\ngo 1.22\\n\",\n\t\t\"sub/s.go\":   \"package sub\\n\\nfunc Nested() int { return 1 }\\n\",\n\t})\n\tout, se, code := runDocsScript(t, mtScript(t), repo)\n\tif code != 0 {\n\t\tt.Fatalf(\"exit %d: %s\", code, se)\n\t}\n\tfound, err := scanner.DecodeFindings(strings.NewReader(out))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfiles := map[string]bool{}\n\tfor _, f := range found {\n\t\tfiles[f.Files[0]] = true\n\t}\n\tif !files[\"a.go\"] || !files[\"sub/s.go\"] {\n\t\tt.Errorf(\"files %v, want a.go and sub/s.go\\n%s\", files, out)\n\t}\n}\nEOF\ncat > missing_tests_integration_test.go <<'EOF'\n//go:build integration\n\npackage roles\n\nimport (\n\t\"fmt\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\n// TestMissingTestsIntegrationDocker runs the real missing-tests role in its\n// real image under the executor's container flags (noexec /tmp, read-only\n// worktree) over the basic fixture. Needs Docker and the pinned base image.\nfunc TestMissingTestsIntegrationDocker(t *testing.T) {\n\tif _, err := exec.LookPath(\"docker\"); err != nil {\n\t\tt.Skip(\"docker not on PATH\")\n\t}\n\tif _, _, code := dockerOut(t, 30*time.Second, \"info\"); code != 0 {\n\t\tt.Skip(\"docker daemon not available\")\n\t}\n\ttag := fmt.Sprintf(\"ard-missing-tests-it:%d\", time.Now().UnixNano())\n\tif _, se, code := dockerOut(t, 15*time.Minute, \"build\", \"-q\", \"-t\", tag, \"scanners/missing-tests\"); code != 0 {\n\t\tt.Fatalf(\"docker build: %s\", se)\n\t}\n\tt.Cleanup(func() { dockerOut(t, time.Minute, \"image\", \"rm\", tag) })\n\troleDir, err := filepath.Abs(\"scanners/missing-tests\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\trepo, err := filepath.Abs(\"testdata/missing-tests/basic\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\targs := scanRunArgs(tag, repo, roleDir, \"TMPDIR=/var/tmp\")\n\targs = append([]string{args[0], \"--network\", \"none\"}, args[1:]...)\n\tout, se, code := dockerOut(t, 10*time.Minute, args...)\n\tif code != 0 {\n\t\tt.Fatalf(\"exit %d\\n%s\", code, se)\n\t}\n\t// The fixture's want.jsonl records the version as go1.test.\n\tvar ver string\n\tfor _, l := range strings.Split(se, \"\\n\") {\n\t\tif v, ok := strings.CutPrefix(l, \"missing-tests: go1\"); ok && !strings.Contains(l, \"module\") {\n\t\t\tver = \"go1\" + v\n\t\t\tbreak\n\t\t}\n\t}\n\twant := strings.ReplaceAll(readFile(t, \"testdata/missing-tests/basic/want.jsonl\"), \"go1.test\", ver)\n\tif out != want {\n\t\tt.Errorf(\"stdout differs from want.jsonl:\\n got: %s\\nwant: %s\", out, want)\n\t}\n}\nEOF\ngofmt -l . ; gofmt -w missing_tests_test.go; cd ../..; go vet -tags integration ./internal/roles && go test ./internal/roles ./internal/initcmd 2>&1 | tail -40"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4772,"cache_read_input_tokens":27760,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4772},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c566320b-09c8-4476-8bc3-25d5a8790bc1","uuid":"de90b5c9-cb67-4b91-ac8a-c7569696a616","timestamp":"2026-11-23T22:35:54.680Z","request_id":"req_011ChLf823X7PcXLvTT9WtaG"}
