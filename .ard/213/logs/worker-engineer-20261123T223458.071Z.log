ake it removable first.\ncleanup() { chmod -R u+w \"$tmp\" 2>/dev/null || true; rm -rf \"$tmp\"; }\ntrap cleanup EXIT\ntrap 'exit 130' INT\ntrap 'exit 143' TERM\n\n# Keep Go's caches off an unwritable HOME and out of the worktree.\nfor v in GOCACHE GOMODCACHE GOPATH; do\n  eval \"cur=\\${$v:-}\"\n  if [ -z \"$cur\" ] || [ ! -w \"$cur\" ]; then\n    eval \"$v=\\$tmp/$v; export $v\"\n  fi\ndone\nGOWORK=off GOTOOLCHAIN=local GOFLAGS=-mod=readonly CGO_ENABLED=0\nexport GOWORK GOTOOLCHAIN GOFLAGS CGO_ENABLED\n\n# Build from the temp dir so the target repo's go.mod is never consulted.\ngover=$(cd -- \"$tmp\" && go env GOVERSION) || die \"go env failed\"\necho \"missing-tests: $gover\" >&2\n(cd -- \"$tmp\" && go build -o \"$tmp/missingtests\" \"$dir/missingtests.go\") || die \"cannot build missingtests\"\n\nroot=$(pwd)\nfind . \\( -name .git -o -name vendor -o -name node_modules -o -name testdata \\) -prune \\\n  -o -name go.mod -type f -print > \"$tmp/mods.raw\" || die \"find failed\"\nLC_ALL=C sort \"$tmp/mods.raw\" > \"$tmp/mods.txt\"\n\nif [ ! -s \"$tmp/mods.txt\" ]; then\n  echo \"missing-tests: no Go modules\" >&2\n  : > \"$tmp/all.jsonl\"\nfi\n\nn=0\nwhile IFS= read -r manifest; do\n  n=$((n + 1))\n  mdir=$(dirname -- \"$manifest\")\n  case $mdir in\n    .) prefix=. ;;\n    ./*) prefix=${mdir#./} ;;\n    *) prefix=$mdir ;;\n  esac\n  module=$(cd -- \"$root/$mdir\" && go list -m 2>\"$tmp/err.txt\") || die \"go list -m failed in $prefix: $(cat \"$tmp/err.txt\")\"\n  echo \"missing-tests: module $module ($prefix)\" >&2\n  (cd -- \"$root/$mdir\" && go list -json ./... > \"$tmp/pkgs-$n.json\" 2>\"$tmp/err.txt\") || die \"go list failed in $prefix: $(cat \"$tmp/err.txt\")\"\n  if [ -e \"$dir/no-coverage\" ]; then\n    cover=\"-no-coverage\"\n    set -- -no-coverage\n  else\n    (cd -- \"$root/$mdir\" && go test -count=1 -covermode=set -coverpkg=./... \"-coverprofile=$tmp/cover-$n.out\" ./... >&2) \\\n      || die \"go test failed in $prefix\"\n    set -- -profile \"$tmp/cover-$n.out\"\n  fi\n  if [ -e \"$dir/ignore\" ]; then\n    set -- \"$@\" -ignore \"$dir/ignore\"\n  fi\n  \"$tmp/missingtests\" -module \"$module\" -prefix \"$prefix\" -packages \"$tmp/pkgs-$n.json\" -go \"$gover\" \"$@\" > \"$tmp/out-$n.jsonl\" \\\n    || die \"missingtests failed in $prefix\"\ndone < \"$tmp/mods.txt\"\n\n: > \"$tmp/all.jsonl\"\ni=1\nwhile [ \"$i\" -le \"$n\" ]; do\n  cat \"$tmp/out-$i.jsonl\" >> \"$tmp/all.jsonl\"\n  i=$((i + 1))\ndone\n\necho \"missing-tests: $(wc -l < \"$tmp/all.jsonl\" | tr -d ' ') finding(s)\" >&2\ncat \"$tmp/all.jsonl\"\nEOF\nchmod 755 scanners/missing-tests/scan\nsed -i '' '/^    cover=\"-no-coverage\"$/d' scanners/missing-tests/scan\nsed -i '' '/^if \\[ ! -s \"\\$tmp\\/mods.txt\" \\]/,/^fi$/c\\\n[ -s \"$tmp/mods.txt\" ] || echo \"missing-tests: no Go modules\" >&2\n' scanners/missing-tests/scan\ncat > scanners/missing-tests/Dockerfile <<'EOF'\n# Pinned image for the missing-tests scanner: just the Go toolchain, which builds\n# the stdlib-only missingtests.go at scan time and runs the repository's own\n# tests with coverage. The base image (golang:1.27.4-trixie) is the same as the\n# docs scanner's, pinned by multi-arch index digest, verified 2026-11-23 with:\n#   docker buildx imagetools inspect golang:1.27.4-trixie\n# Docker ignores the tag when a digest is present; it is there for readers.\n#\n# The scan runs the repository's tests, so the job needs egress to the module\n# proxy when the repository has dependencies.\n#\n# The image does NOT copy `scan` or `missingtests.go`: the executor mounts this\n# role directory read-only, so the mounted files are always the ones that run.\n# Run:  docker run --rm -v \"$PWD\":/repo:ro -v <role dir>:/role:ro -w /repo IMAGE /role/scan\n\nFROM golang:1.27.4-trixie@sha256:f18c3d73a184fb0582828510722e723b63a93f7188d11dd223d9be6f6880e65d\n# The executor's /tmp is a noexec tmpfs and go build executes from its temp dir,\n# so TMPDIR is /var/tmp: exec-capable and writable by any --user.\nENV 