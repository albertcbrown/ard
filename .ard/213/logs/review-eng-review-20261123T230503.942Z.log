estScanIsExecutableOnDisk(t *testing.T) {\n-\tfor _, p := range []string{\"scanners/cve/scan\", \"scanners/docs/scan\", \"scanners/error-codes/scan\", \"scanners/lint/scan\", \"scanners/trufflehog/scan\"} {\n+\tfor _, p := range []string{\"scanners/cve/scan\", \"scanners/docs/scan\", \"scanners/error-codes/scan\", \"scanners/lint/scan\", \"scanners/missing-tests/scan\", \"scanners/trufflehog/scan\"} {\n \t\tfi, err := os.Stat(p)\n \t\tif err != nil {\n \t\t\tt.Fatal(err)\n@@ -218,3 +218,23 @@ func TestEmbeddedTrufflehogRoleLoadsAsScanner(t *testing.T) {\n \t}\n \tt.Fatal(\"no scanner role trufflehog\")\n }\n+\n+func TestEmbeddedMissingTestsRoleLoadsAsScanner(t *testing.T) {\n+\tres, err := config.LoadFS(starterFS(t, true), \"/repo\")\n+\tif err != nil {\n+\t\tt.Fatalf(\"LoadFS: %v\", err)\n+\t}\n+\tfor _, r := range res.Roles {\n+\t\tif r.Kind != config.KindScanner || r.Name != \"missing-tests\" {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif r.ScanPath != \".ard/scanners/missing-tests/scan\" || !r.Autoclose || r.Every != 24*time.Hour || r.GroupSize != 10 || r.MaxOpen != 5 {\n+\t\t\tt.Errorf(\"unexpected role: %+v\", r)\n+\t\t}\n+\t\tif r.Dockerfile != \".ard/scanners/missing-tests/Dockerfile\" {\n+\t\t\tt.Errorf(\"Dockerfile = %q\", r.Dockerfile)\n+\t\t}\n+\t\treturn\n+\t}\n+\tt.Fatal(\"no scanner role missing-tests\")\n+}\ndiff --git a/internal/roles/scanners/missing-tests/Dockerfile b/internal/roles/scanners/missing-tests/Dockerfile\nnew file mode 100644\nindex 0000000..a75b717\n--- /dev/null\n+++ b/internal/roles/scanners/missing-tests/Dockerfile\n@@ -0,0 +1,19 @@\n+# Pinned image for the missing-tests scanner: just the Go toolchain, which builds\n+# the stdlib-only missingtests.go at scan time and runs the repository's own\n+# tests with coverage. The base image (golang:1.27.4-trixie) is the same as the\n+# docs scanner's, pinned by multi-arch index digest, verified 2026-11-23 with:\n+#   docker buildx imagetools inspect golang:1.27.4-trixie\n+# Docker ignores the tag when a digest is present; it is there for readers.\n+#\n+# The scan runs the repository's tests, so the job needs egress to the module\n+# proxy when the repository has dependencies.\n+#\n+# The image does NOT copy `scan` or `missingtests.go`: the executor mounts this\n+# role directory read-only, so the mounted files are always the ones that run.\n+# Run:  docker run --rm -v \"$PWD\":/repo:ro -v <role dir>:/role:ro -w /repo IMAGE /role/scan\n+\n+FROM golang:1.27.4-trixie@sha256:f18c3d73a184fb0582828510722e723b63a93f7188d11dd223d9be6f6880e65d\n+# The executor's /tmp is a noexec tmpfs and go build executes from its temp dir,\n+# so TMPDIR is /var/tmp: exec-capable and writable by any --user.\n+ENV GOTOOLCHAIN=local\n+ENV TMPDIR=/var/tmp\ndiff --git a/internal/roles/scanners/missing-tests/scan b/internal/roles/scanners/missing-tests/scan\nnew file mode 100755\nindex 0000000..26e75e6\n--- /dev/null\n+++ b/internal/roles/scanners/missing-tests/scan\n@@ -0,0 +1,98 @@\n+#!/bin/sh\n+# missing-tests scanner: exported Go functions and methods that no test calls\n+# or runs, as ard findings.\n+#\n+# Contract (see docs/proposal.md, Scanners):\n+#   - cwd is a read-only worktree of origin/main. This script finds its siblings\n+#     (missingtests.go, ignore, no-coverage) from its own path, never from cwd\n+#     or /role.\n+#   - Prints findings as JSON lines on stdout, and only as its very last action:\n+#     any failure exits non-zero with nothing on stdout, and the controller\n+#     discards the run. It never prints partial results.\n+#   - Writes nothing outside a mktemp dir that is removed on exit. HOME may be\n+#     unwritable. It holds no GitHub token and needs none.\n+#   - stderr is the job log: the Go version, one line per module and the final\n+#     count.\n+#\n+# This scan RUNS THE REPOSITORY'S OWN TESTS (go test with coverage), so it must\n+# only run in the executor's container. A module whose tests fail to build or\n+# fail has no trustworthy coverage, so the scan fails rather than report\n+# partial data (autoclose would close issues on it).\n+# Exit codes: 0 success, 1 failure, 2 go is missing.\n+#\n+# Opt-outs, both human-owned files next to this script:\n+#   ignore       symbols or packages to skip (see missingtests.go)\n+#   no-coverage  skip running tests; report only the static rule\n+set -eu\n+\n+dir=$(CDPATH= cd -- \"$(dirname -- \"$0\")\" && pwd)\n+\n+die() { echo \"missing-tests: $*\" >&2; exit 1; }\n+need() { command -v \"$1\" >/dev/null 2>&1 || { echo \"missing-tests: $1 not found\" >&2; exit 2; }; }\n+\n+need go\n+\n+tmp=$(mktemp -d \"${TMPDIR:-/tmp}/ard-missing-tests.XXXXXX\")\n+# Go's module cache is read-only on disk; make it removable first.\n+cleanup() { chmod -R u+w \"$tmp\" 2>/dev/null || true; rm -rf \"$tmp\"; }\n+trap cleanup EXIT\n+trap 'exit 130' INT\n+trap 'exit 143' TERM\n+\n+# Keep Go's caches off an unwritable HOME and out of the worktree.\n+for v in GOCACHE GOMODCACHE GOPATH; do\n+  eval \"cur=\\${$v:-}\"\n+  if [ -z \"$cur\" ] || [ ! -w \"$cur\" ]; then\n+    eval \"$v=\\$tmp/$v; export $v\"\n+  fi\n+done\n+GOWORK=off GOTOOLCHAIN=local GOFLAGS=-mod=readonly CGO_ENABLED=0\n+export GOWORK GOTOOLCHAIN GOFLAGS CGO_ENABLED\n+\n+# Build from the temp dir so the target repo's go.mod is never consulted.\n+gover=$(cd -- \"$tmp\" && go env GOVERSION) || die \"go env failed\"\n+echo \"missing-tests: $gover\" >&2\n+(cd -- \"$tmp\" && go build -o \"$tmp/missingtests\" \"$dir/missingtests.go\") || die \"cannot build missingtests\"\n+\n+root=$(pwd)\n+find . \\( -name .git -o -name vendor -o -name node_modules -o -name testdata \\) -prune \\\n+  -o -name go.mod -type f -print > \"$tmp/mods.raw\" || die \"find failed\"\n+LC_ALL=C sort \"$tmp/mods.raw\" > \"$tmp/mods.txt\"\n+\n+[ -s \"$tmp/mods.txt\" ] || echo \"missing-tests: no Go modules\" >&2\n+\n+n=0\n+while IFS= read -r manifest; do\n+  n=$((n + 1))\n+  mdir=$(dirname -- \"$manifest\")\n+  case $mdir in\n+    .) prefix=. ;;\n+    ./*) prefix=${mdir#./} ;;\n+    *) prefix=$mdir ;;\n+  esac\n+  module=$(cd -- \"$root/$mdir\" && go list -m 2>\"$tmp/err.txt\") || die \"go list -m failed in $prefix: $(cat \"$tmp/err.txt\")\"\n+  echo \"missing-tests: module $module ($prefix)\" >&2\n+  (cd -- \"$root/$mdir\" && go list -json ./... > \"$tmp/pkgs-$n.json\" 2>\"$tmp/err.txt\") || die \"go list failed in $prefix: $(cat \"$tmp/err.txt\")\"\n+  if [ -e \"$dir/no-coverage\" ]; then\n+    set -- -no-coverage\n+  else\n+    (cd -- \"$root/$mdir\" && go test -count=1 -covermode=set -coverpkg=./... \"-coverprofile=$tmp/cover-$n.out\" ./... >&2) \\\n+      || die \"go test failed in $prefix\"\n+    set -- -profile \"$tmp/cover-$n.out\"\n+  fi\n+  if [ -e \"$dir/ignore\" ]; then\n+    set -- \"$@\" -ignore \"$dir/ignore\"\n+  fi\n+  \"$tmp/missingtests\" -module \"$module\" -prefix \"$prefix\" -packages \"$tmp/pkgs-$n.json\" -go \"$gover\" \"$@\" > \"$tmp/out-$n.jsonl\" \\\n+    || die \"missingtests failed in $prefix\"\n+done < \"$tmp/mods.txt\"\n+\n+: > \"$tmp/all.jsonl\"\n+i=1\n+while [ \"$i\" -le \"$n\" ]; do\n+  cat \"$tmp/out-$i.jsonl\" >> \"$tmp/all.jsonl\"\n+  i=$((i + 1))\n+done\n+\n+echo \"missing-tests: $(wc -l < \"$tmp/all.jsonl\" | tr -d ' ') finding(s)\" >&2\n+cat \"$tmp/all.jsonl\"\n","numLines":480,"startLine":1,"totalLines":480}},"tool_result_meta":[{"id":"toolu_01L8JuRFYFEYnpPHPeiE9C8t","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
