/scan\", \"scanners/missing-tests/scan\", \"scanners/trufflehog/scan\"} {\n324\t \t\tfi, err := os.Stat(p)\n325\t \t\tif err != nil {\n326\t \t\t\tt.Fatal(err)\n327\t@@ -218,3 +218,23 @@ func TestEmbeddedTrufflehogRoleLoadsAsScanner(t *testing.T) {\n328\t \t}\n329\t \tt.Fatal(\"no scanner role trufflehog\")\n330\t }\n331\t+\n332\t+func TestEmbeddedMissingTestsRoleLoadsAsScanner(t *testing.T) {\n333\t+\tres, err := config.LoadFS(starterFS(t, true), \"/repo\")\n334\t+\tif err != nil {\n335\t+\t\tt.Fatalf(\"LoadFS: %v\", err)\n336\t+\t}\n337\t+\tfor _, r := range res.Roles {\n338\t+\t\tif r.Kind != config.KindScanner || r.Name != \"missing-tests\" {\n339\t+\t\t\tcontinue\n340\t+\t\t}\n341\t+\t\tif r.ScanPath != \".ard/scanners/missing-tests/scan\" || !r.Autoclose || r.Every != 24*time.Hour || r.GroupSize != 10 || r.MaxOpen != 5 {\n342\t+\t\t\tt.Errorf(\"unexpected role: %+v\", r)\n343\t+\t\t}\n344\t+\t\tif r.Dockerfile != \".ard/scanners/missing-tests/Dockerfile\" {\n345\t+\t\t\tt.Errorf(\"Dockerfile = %q\", r.Dockerfile)\n346\t+\t\t}\n347\t+\t\treturn\n348\t+\t}\n349\t+\tt.Fatal(\"no scanner role missing-tests\")\n350\t+}\n351\tdiff --git a/internal/roles/scanners/missing-tests/Dockerfile b/internal/roles/scanners/missing-tests/Dockerfile\n352\tnew file mode 100644\n353\tindex 0000000..a75b717\n354\t--- /dev/null\n355\t+++ b/internal/roles/scanners/missing-tests/Dockerfile\n356\t@@ -0,0 +1,19 @@\n357\t+# Pinned image for the missing-tests scanner: just the Go toolchain, which builds\n358\t+# the stdlib-only missingtests.go at scan time and runs the repository's own\n359\t+# tests with coverage. The base image (golang:1.27.4-trixie) is the same as the\n360\t+# docs scanner's, pinned by multi-arch index digest, verified 2026-11-23 with:\n361\t+#   docker buildx imagetools inspect golang:1.27.4-trixie\n362\t+# Docker ignores the tag when a digest is present; it is there for readers.\n363\t+#\n364\t+# The scan runs the repository's tests, so the job needs egress to the module\n365\t+# proxy when the repository has dependencies.\n366\t+#\n367\t+# The image does NOT copy `scan` or `missingtests.go`: the executor mounts this\n368\t+# role directory read-only, so the mounted files are always the ones that run.\n369\t+# Run:  docker run --rm -v \"$PWD\":/repo:ro -v <role dir>:/role:ro -w /repo IMAGE /role/scan\n370\t+\n371\t+FROM golang:1.27.4-trixie@sha256:f18c3d73a184fb0582828510722e723b63a93f7188d11dd223d9be6f6880e65d\n372\t+# The executor's /tmp is a noexec tmpfs and go build executes from its temp dir,\n373\t+# so TMPDIR is /var/tmp: exec-capable and writable by any --user.\n374\t+ENV GOTOOLCHAIN=local\n375\t+ENV TMPDIR=/var/tmp\n376\tdiff --git a/internal/roles/scanners/missing-tests/scan b/internal/roles/scanners/missing-tests/scan\n377\tnew file mode 100755\n378\tindex 0000000..26e75e6\n379\t--- /dev/null\n380\t+++ b/internal/roles/scanners/missing-tests/scan\n381\t@@ -0,0 +1,98 @@\n382\t+#!/bin/sh\n383\t+# missing-tests scanner: exported Go functions and methods that no test calls\n384\t+# or runs, as ard findings.\n385\t+#\n386\t+# Contract (see docs/proposal.md, Scanners):\n387\t+#   - cwd is a read-only worktree of origin/main. This script finds its siblings\n388\t+#     (missingtests.go, ignore, no-coverage) from its own path, never from cwd\n389\t+#     or /role.\n390\t+#   - Prints findings as JSON lines on stdout, and only as its very last action:\n391\t+#     any failure exits non-zero with nothing on stdout, and the controller\n392\t+#     discards the run. It never prints partial results.\n393\t+#   - Writes nothing outside a mktemp dir that is removed on exit. HOME may be\n394\t+#     unwritable. It holds no GitHub token and needs none.\n395\t+#   - stderr is the job log: the Go version, one line per module and the final\n396\t+#     count.\n397\t+#\n398\t+# This scan RUNS THE REPOSITORY'S OWN TESTS (go test with coverage), so it must\n399\t+# only run in the executor's container. A module whose tests fail to build or\n400\t+# fail has no trustworthy coverage, so the scan fails rather than report\n401\t+# partial data (autoclose would close issues on it).\n402\t+# Exit codes: 0 success, 1 failure, 2 go is missing.\n403\t+#\n404\t+# Opt-outs, both human-owned files next to this script:\n405\t+#   ignore       symbols or packages to skip (see missingtests.go)\n406\t+#   no-coverage  skip running tests; report only the static rule\n407\t+set -eu\n408\t+\n409\t+dir=$(CDPATH= cd -- \"$(dirname -- \"$0\")\" && pwd)\n410\t+\n411\t+die() { echo \"missing-tests: $*\" >&2; exit 1; }\n412\t+need() { command -v \"$1\" >/dev/null 2>&1 || { echo \"missing-tests: $1 not found\" >&2; exit 2; }; }\n413\t+\n414\t+need go\n415\t+\n416\t+tmp=$(mktemp -d \"${TMPDIR:-/tmp}/ard-missing-tests.XXXXXX\")\n417\t+# Go's module cache is read-only on disk; make it removable first.\n418\t+cleanup() { chmod -R u+w \"$tmp\" 2>/dev/null || true; rm -rf \"$tmp\"; }\n419\t+trap cleanup EXIT\n420\t+trap 'exit 130' INT\n421\t+trap 'exit 143' TERM\n422\t+\n423\t+# Keep Go's caches off an unwritable HOME and out of the worktree.\n424\t+for v in GOCACHE GOMODCACHE GOPATH; do\n425\t+  eval \"cur=\\${$v:-}\"\n426\t+  if [ -z \"$cur\" ] || [ ! -w \"$cur\" ]; then\n427\t+    eval \"$v=\\$tmp/$v; export $v\"\n428\t+  fi\n429\t+done\n430\t+GOWORK=off GOTOOLCHAIN=local GOFLAGS=-mod=readonly CGO_ENABLED=0\n431\t+export GOWORK GOTOOLCHAIN GOFLAGS CGO_ENABLED\n432\t+\n433\t+# Build from the temp dir so the target repo's go.mod is never consulted.\n434\t+gover=$(cd -- \"$tmp\" && go env GOVERSION) || die \"go env failed\"\n435\t+echo \"missing-tests: $gover\" >&2\n436\t+(cd -- \"$tmp\" && go build -o \"$tmp/missingtests\" \"$dir/missingtests.go\") || die \"cannot build missingtests\"\n437\t+\n438\t+root=$(pwd)\n439\t+find . \\( -name .git -o -name vendor -o -name node_modules -o -name testdata \\) -prune \\\n440\t+  -o -name go.mod -type f -print > \"$tmp/mods.raw\" || die \"find failed\"\n441\t+LC_ALL=C sort \"$tmp/mods.raw\" > \"$tmp/mods.txt\"\n442\t+\n443\t+[ -s \"$tmp/mods.txt\" ] || echo \"missing-tests: no Go modules\" >&2\n444\t+\n445\t+n=0\n446\t+while IFS= read -r manifest; do\n447\t+  n=$((n + 1))\n448\t+  mdir=$(dirname -- \"$manifest\")\n449\t+  case $mdir in\n450\t+    .) prefix=. ;;\n451\t+    ./*) prefix=${mdir#./} ;;\n452\t+    *) prefix=$mdir ;;\n453\t+  esac\n454\t+  module=$(cd -- \"$root/$mdir\" && go list -m 2>\"$tmp/err.txt\") || die \"go list -m failed in $prefix: $(cat \"$tmp/err.txt\")\"\n455\t+  echo \"missing-tests: module $module ($prefix)\" >&2\n456\t+  (cd -- \"$root/$mdir\" && go list -json ./... > \"$tmp/pkgs-$n.json\" 2>\"$tmp/err.txt\") || die \"go list failed in $prefix: $(cat \"$tmp/err.txt\")\"\n457\t+  if [ -e \"$dir/no-coverage\" ]; then\n458\t+    set -- -no-coverage\n459\t+  else\n460\t+    (cd -- \"$root/$mdir\" && go test -count=1 -covermode=set -coverpkg=./... \"-coverprofile=$tmp/cover-$n.out\" ./... >&2) \\\n461\t+      || die \"go test failed in $prefix\"\n462\t+    set -- -profile \"$tmp/cover-$n.out\"\n463\t+  fi\n464\t+  if [ -e \"$dir/ignore\" ]; then\n465\t+    set -- \"$@\" -ignore \"$dir/ignore\"\n466\t+  fi\n467\t+  \"$tmp/missingtests\" -module \"$module\" -prefix \"$prefix\" -packages \"$tmp/pkgs-$n.json\" -go \"$gover\" \"$@\" > \"$tmp/out-$n.jsonl\" \\\n468\t+    || die \"missingtests failed in $prefix\"\n469\t+done < \"$tmp/mods.txt\"\n470\t+\n471\t+: > \"$tmp/all.jsonl\"\n472\t+i=1\n473\t+while [ \"$i\" -le \"$n\" ]; do\n474\t+  cat \"$tmp/out-$i.jsonl\" >> \"$tmp/all.jsonl\"\n475\t+  i=$((i + 1))\n476\t+done\n477\t+\n478\t+echo \"missing-tests: $(wc -l < \"$tmp/all.jsonl\" | tr -d ' ') finding(s)\" >&2\n479\t+cat \"$tmp/all.jsonl\"\n480\t"}]},"parent_tool_use_id":null,"session_id":"656d00f3-f9d2-4222-8618-194c05eb4f68","uuid":"078fdb4c-55b5-4735-af0a-684296110e01","timestamp":"2026-11-23T23:05:06.618Z","tool_use_result":{"type":"text","file":{"filePath":"/work/.ard-input/213/diff.patch","content":"UNTRUSTED INPUT: the change und