{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019SvgJ8bJynQhA3AHhoWSDU","type":"tool_result","content":"// Tokens mints and revokes the read token the pre container clones with.\ntype Tokens interface {\n\tMintReadToken(ctx context.Context, repos []github.Repo) (github.ScopedToken, error)\n\tRevokeToken(ctx context.Context, token string) error\n}\n\n// Options configures an Executor.\ntype Options struct {\n\tClient                 api.Client\n\tTokens                 Tokens\n\tWS                     *workspace.Workspace\n\tNamespace              string\n\tInstance               string // app.kubernetes.io/instance label value\n\tRepo                   string // owner/name this executor serves; Sweep selects on it\n\tAgentImage, PodImage   string\n\tGitBase                string // default https://github.com\n\tResources              Resources\n\tLimits                 tarball.Limits\n\tPreBudget, ResultGrace time.Duration // defaults 5m and 2m\n\tPolicy                 executor.EnvPolicy\n\tConfigDirEnv           string // env name whose Fixed value must be the pod config dir\n\tHTTP                   *http.Client\n\tNow                    func() time.Time\n\tLog                    *slog.Logger\n\n\t// Poll is the watcher interval (default 2s); PendingTimeout is how long a\n\t// pod may stay unscheduled (default 5m). Tests shorten both.\n\tPoll, PendingTimeout time.Duration\n}\n\ntype liveJob struct {\n\tmanifest []byte\n\trepo     string // owner/name of the job's repository\n\tstarted  bool\n\tuid      string\n\tkey      string // result key, in memory only\n\tstop     context.CancelFunc\n\twg       sync.WaitGroup // the watcher and the log follower\n\t// agentEnded is set once the agent container is seen terminated or the\n\t// job is finished; the log follower drains once more after it.\n\tagentEnded atomic.Bool\n\ttoken      string\n\ttokenGone  bool\n}\n\n// Executor implements executor.Executor on Kubernetes.\ntype Executor struct {\n\to    Options\n\tmu   sync.Mutex\n\tlive map[string]*liveJob\n}\n\nvar _ executor.Executor = (*Executor)(nil)\n\n// New validates o and applies defaults.\nfunc New(o Options) (*Executor, error) {\n\tswitch {\n\tcase o.Client == nil, o.Tokens == nil, o.WS == nil:\n\t\treturn nil, errors.New(\"kube: Client, Tokens and WS are required\")\n\tcase o.Namespace == \"\", o.Repo == \"\", o.AgentImage == \"\", o.PodImage == \"\", o.Instance == \"\":\n\t\treturn nil, errors.New(\"kube: Namespace, Repo, Instance, AgentImage and PodImage are required\")\n\t}\n\tif o.GitBase == \"\" {\n\t\to.GitBase = \"https://github.com\"\n\t}\n\tif o.PreBudget <= 0 {\n\t\to.PreBudget = 5 * time.Minute\n\t}\n\tif o.ResultGrace <= 0 {\n\t\to.ResultGrace = 2 * time.Minute\n\t}\n\tif o.Poll <= 0 {\n\t\to.Poll = 2 * time.Second\n\t}\n\tif o.PendingTimeout <= 0 {\n\t\to.PendingTimeout = 5 * time.Minute\n\t}\n\tif o.Limits == (tarball.Limits{}) {\n\t\to.Limits = tarball.DefaultLimits()\n\t}\n\tif o.Resources.Work == 0 {\n\t\to.Resources = DefaultResources()\n\t}\n\tif o.HTTP == nil {\n\t\to.HTTP = &http.Client{Timeout: 10 * time.Minute}\n\t}\n\tif o.Now == nil {\n\t\to.Now = time.Now\n\t}\n\tif o.Log == nil {\n\t\to.Log = slog.Default()\n\t}\n\treturn &Executor{o: o, live: map[string]*liveJob{}}, nil\n}\n\nfunc (e *Executor) get(id string) *liveJob {\n\te.mu.Lock()\n\tdefer e.mu.Unlock()\n\treturn e.live[id]\n}\n\n// Prepare lays out the worktree and encodes the manifest. It starts nothing.\nfunc (e *Executor) Prepare(ctx context.Context, j executor.Job) (executor.Handle, error) {\n\tif len(j.ID) > jobpod.MaxJobID {\n\t\treturn executor.Handle{}, fmt.Errorf(\"%w: id %q is too long for a pod name\", executor.ErrInvalidJob, j.ID)\n\t\t\tout = append(out, lj.token)\n\t\t}\n\t}\n\treturn out\n}\n\n// Sweep deletes this repo's job pods and Secrets whose job keep rejects. It\n// touches only objects labelled for Options.Repo.\nfunc (e *Executor) Sweep(ctx context.Context, keep func(id string) bool) error {\n\tsel := jobpod.LabelPartOf + \"=ard,\" + jobpod.LabelComponent + \"=\" + jobpod.ComponentJob +\n\t\t\",\" + jobpod.LabelInstance + \"=\" + jobpod.LabelValue(e.o.Instance) + \",\" + jobpod.LabelRepo + \"=\" + jobpod.RepoLabel(e.o.Repo)\n\tpods, err := e.o.Client.ListPods(ctx, e.o.Namespace, sel)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"sweep: %w\", err)\n\t}\n\tvar errs []error\n\tfor _, p := range pods {\n\t\tif keep(p.Meta.Labels[jobpod.LabelJob]) {\n\t\t\tcontinue\n\t\t}\n\t\terrs = append(errs, e.o.Client.DeletePod(ctx, e.o.Namespace, p.Meta.Name, 30),\n\t\t\te.o.Client.DeleteSecret(ctx, e.o.Namespace, p.Meta.Name))\n\t}\n\treturn errors.Join(errs...)\n}\ninternal/executor/kube/api/rest.go:31:// RESTOptions configures InCluster. Zero values select the in-cluster\ninternal/executor/kube/api/rest.go:47:// InCluster returns a Client that talks to the API server with the pod's\ninternal/executor/kube/api/rest.go:50:func InCluster(o RESTOptions) (Client, error) {\ninternal/executor/kube/helpers_test.go:80:func (g *gitStub) WorktreePrune(context.Context, string) error { g.pruned++; return nil }\n172:\t// End says why a Gone job ended without an exit code from the agent.\n174:\tEnd End\n177:// End is the reason a job is Gone with no agent exit.\n178:type End string\n181:\tEndEvicted     End = \"evicted\"      // pod evicted, deleted, never scheduled or image not pulled\n182:\tEndCloneFailed End = \"clone_failed\" // the pre step could not fetch inputs (transient)\n183:\tEndPrepFailed  End = \"prep_failed\"  // the pre step failed permanently\n184:\tEndNoResult    End = \"no_result\"    // the agent ended but its result never arrived\n185:\tEndBadResult   End = \"bad_result\"   // the result archive was unsafe or over a limit\n//     process of this run that vanished, such as a container killed from\n//     outside.\n//  4. The agent reported a transient API error: rate_limit.\n//  5. Otherwise the zero Cause: a normal close-out from the role file and the\n//     exit code.\n//\n// Retry is set for a transient cause when sj is not itself a retry.\nfunc CauseOf(sj state.Job, st executor.Status, res agent.Result, processStart time.Time) closeout.Cause {\n\tswitch {\n\tcase sj.KillReason != \"\":\n\t\tkind := closeout.CauseKind(sj.KillReason)\n\t\tswitch kind {\n\t\tcase closeout.CauseQuiet:\n\t\t\treturn NewCause(sj, kind, quietDetail(st), false)\n\t\tcase closeout.CauseDeadline:\n\t\t\treturn NewCause(sj, kind, \"ran past its deadline\", false)\n\t\tcase closeout.CauseRestart:\n\t\t\treturn NewCause(sj, kind, \"orphaned by a controller restart\", true)\n\t\t}\n\t\treturn NewCause(sj, kind, \"killed by the Reaper\", false)\n\tcase st.State == executor.TimedOut:\n\t\treturn NewCause(sj, closeout.CauseDeadline, \"ran past its deadline\", false)\n\tcase st.State == executor.Gone:\n\t\tif sj.CreatedAt.Before(processStart) {\n\t\t\treturn NewCause(sj, closeout.CauseRestart, \"process gone after a controller restart\", true)\n\t\t}\n101:\tCauseQuiet     CauseKind = \"heartbeat_quiet\"    // no log output for 10 minutes\n102:\tCauseDeadline  CauseKind = \"deadline\"           // ran past its timeout\n103:\tCauseRestart   CauseKind = \"controller_restart\" // orphaned, gone or never started across a restart\n104:\tCauseNoProcess CauseKind = \"no_process\"         // never started, or its process vanished in this run\n105:\tCauseRateLimit CauseKind = \"rate_limit\"         // the agent reported a transient API error\n106:\tCauseCloneFail CauseKind = \"clone_failed\"       // a loop's Prepare failed at git or clone\n110:\tCauseUsageLimit CauseKind = \"usage_limit\"\nTODO.md\nlayout.md\nproposal.md\nrunbooks\nsite\n303:\t\t\t\tif ex, err := w.newExecutor(); err == nil {\n433:// newExecutor builds the local executor every loop uses; its host-mode hook\n441:func (w *wiring) newExecutor() (*local.Local, error) {\n481:// with w.newExecutor(), end jobs through w.finisher() and share w.closer(). The\n550:\tauth, err := github.AuthFromEnv(os