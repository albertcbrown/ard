running job is\n+// left to the Reaper's normal Orphaned path.\n+func sweepOrphans(ctx context.Context, ex any, store jobLister, log *slog.Logger) error {\n+\tsw, ok := ex.(sweeper)\n+\tif !ok {\n+\t\treturn nil\n+\t}\n+\tjobs, err := store.RunningJobs(ctx)\n+\tif err != nil {\n+\t\treturn fmt.Errorf(\"sweep orphans: %w\", err)\n+\t}\n+\tids := make([]string, 0, len(jobs))\n+\tfor _, j := range jobs {\n+\t\tids = append(ids, j.ID)\n+\t\tif len(j.Handle) > 0 {\n+\t\t\tvar h executor.Handle\n+\t\t\tif json.Unmarshal(j.Handle, &h) == nil && h.JobID != \"\" {\n+\t\t\t\tids = append(ids, h.JobID)\n+\t\t\t}\n+\t\t}\n+\t}\n+\tkeep := func(id string) bool {\n+\t\tfor _, j := range ids {\n+\t\t\tif id == j || agentStepID(j, id) {\n+\t\t\t\treturn true\n+\t\t\t}\n+\t\t}\n+\t\treturn false\n+\t}\n+\tif err := sw.Sweep(ctx, keep); err != nil {\n+\t\tlog.Warn(\"serve.sweep_failed\", \"error\", err)\n+\t}\n+\treturn nil\n+}\n+\n+// agentStepID reports whether step is a fix step id of job (job + \"f\" + digits).\n+func agentStepID(job, step string) bool {\n+\trest := strings.TrimPrefix(step, job+\"f\")\n+\tif rest == \"\" || rest == step {\n+\t\treturn false\n+\t}\n+\tfor _, r := range rest {\n+\t\tif r < '0' || r > '9' {\n+\t\t\treturn false\n+\t\t}\n+\t}\n+\treturn true\n+}\ndiff --git a/internal/servecmd/k8s_test.go b/internal/servecmd/k8s_test.go\nnew file mode 100644\nindex 0000000..fc984f2\n--- /dev/null\n+++ b/internal/servecmd/k8s_test.go\n@@ -0,0 +1,197 @@\n+package servecmd\n+\n+import (\n+\t\"context\"\n+\t\"errors\"\n+\t\"strings\"\n+\t\"testing\"\n+\n+\t\"github.com/albertcbrown/ard/internal/cli\"\n+\t\"github.com/albertcbrown/ard/internal/config\"\n+\t\"github.com/albertcbrown/ard/internal/executor\"\n+\t\"github.com/albertcbrown/ard/internal/executor/kube\"\n+\t\"github.com/albertcbrown/ard/internal/executor/kube/api\"\n+\tkfake \"github.com/albertcbrown/ard/internal/executor/kube/api/fake\"\n+\t\"github.com/albertcbrown/ard/internal/executor/local\"\n+\t\"github.co