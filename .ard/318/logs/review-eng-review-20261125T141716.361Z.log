51,6 +257,13 @@ func serveLoops(ctx context.Context, e *cli.Env, build builder, wantLoops []stri\n \t} else {\n \t\tw.MaxPods = cfg.MaxPods\n \t\tw.cfg.Store(cfg)\n+\t\t// A k8s serve that cannot build its executor (a PAT cannot mint\n+\t\t// scoped tokens, a missing flag) must not start.\n+\t\tif cfg.Executor == \"k8s\" {\n+\t\t\tif _, err := w.newExecutor(); err != nil {\n+\t\t\t\treturn &cli.ExitError{Code: 1, Err: fmt.Errorf(\"ard serve: %w\", err)}\n+\t\t\t}\n+\t\t}\n \t}\n \t// A scan can outlast a pause, so the scanners re-check after it. The\n \t// check fails closed, like the gate's own.\n@@ -274,6 +287,9 @@ func serveLoops(ctx context.Context, e *cli.Env, build builder, wantLoops []stri\n \t\t\tif err != nil {\n \t\t\t\treturn nil, err\n \t\t\t}\n+\t\t\tif err := w.checkExecutor(c); err != nil {\n+\t\t\t\treturn nil, err\n+\t\t\t}\n \t\t\tw.cfg.Store(c)\n \t\t\tif p := w.pool.Load(); p != nil {\n \t\t\t\tp.SetMax(c.MaxPods) // a reload may change max_pods\n@@ -302,6 +318,9 @@ func serveLoops(ctx context.Context, e *cli.Env, build builder, wantLoops []stri\n \t\t\t\tvar cl workspaceCleaner\n \t\t\t\tif ex, err := w.newExecutor(); err == nil {\n \t\t\t\t\tcl = ex\n+\t\t\t\t\tif err := sweepOrphans(ctx, ex, store, log); err != nil {\n+\t\t\t\t\t\treturn err\n+\t\t\t\t\t}\n \t\t\t\t}\n \t\t\t\tif err := failStaleScannerJobs(ctx, store, cl, log); err != nil {\n \t\t\t\t\treturn err\n@@ -386,11 +405,21 @@ type wiring struct {\n \tmc     *lazyCommitter\n \tbr     *lazyBranches\n \tcl     *closeout.Closer\n-\texec   *local.Local\n-\tfin    *reaper.Finisher\n-\trp     *reaper.Reaper\n-\tlim    *limits.Book\n-\tbgt    *budget.Gate\n+\texec   jobExecutor\n+\t// mode is the executor chosen at the first build (\"local\" or \"k8s\"); it\n+\t// is fixed for the life of the process.\n+\tmode string\n+\t// K8s are the cluster settings (--k8s-*); Auth mints the pods' read tokens.","numLines":886,"startLine":1,"totalLines":1213,"truncatedByTokenCap":true}},"tool_result_meta"