etes this repo's job pods and Secrets that no running job\n483\t+// owns, when the executor has Sweep (Kubernetes). A pod of a running job is\n484\t+// left to the Reaper's normal Orphaned path.\n485\t+func sweepOrphans(ctx context.Context, ex any, store jobLister, log *slog.Logger) error {\n486\t+\tsw, ok := ex.(sweeper)\n487\t+\tif !ok {\n488\t+\t\treturn nil\n489\t+\t}\n490\t+\tjobs, err := store.RunningJobs(ctx)\n491\t+\tif err != nil {\n492\t+\t\treturn fmt.Errorf(\"sweep orphans: %w\", err)\n493\t+\t}\n494\t+\tids := make([]string, 0, len(jobs))\n495\t+\tfor _, j := range jobs {\n496\t+\t\tids = append(ids, j.ID)\n497\t+\t\tif len(j.Handle) > 0 {\n498\t+\t\t\tvar h executor.Handle\n499\t+\t\t\tif json.Unmarshal(j.Handle, &h) == nil && h.JobID != \"\" {\n500\t+\t\t\t\tids = append(ids, h.JobID)\n501\t+\t\t\t}\n502\t+\t\t}\n503\t+\t}\n504\t+\tkeep := func(id string) bool {\n505\t+\t\tfor _, j := range ids {\n506\t+\t\t\tif id == j || agentStepID(j, id) {\n507\t+\t\t\t\treturn true\n508\t+\t\t\t}\n509\t+\t\t}\n510\t+\t\treturn false\n511\t+\t}\n512\t+\tif err := sw.Sweep(ctx, keep); err != nil {\n513\t+\t\tlog.Warn(\"serve.sweep_failed\", \"error\", err)\n514\t+\t}\n515\t+\treturn nil\n516\t+}\n517\t+\n518\t+// agentStepID reports whether step is a fix step id of job (job + \"f\" + digits).\n519\t+func agentStepID(job, step string) bool {\n520\t+\trest := strings.TrimPrefix(step, job+\"f\")\n521\t+\tif rest == \"\" || rest == step {\n522\t+\t\treturn false\n523\t+\t}\n524\t+\tfor _, r := range rest {\n525\t+\t\tif r < '0' || r > '9' {\n526\t+\t\t\treturn false\n527\t+\t\t}\n528\t+\t}\n529\t+\treturn true\n530\t+}\n531\tdiff --git a/internal/servecmd/k8s_test.go b/internal/servecmd/k8s_test.go\n532\tnew file mode 100644\n533\tindex 0000000..fc984f2\n534\t--- /dev/null\n535\t+++ b/internal/servecmd/k8s_test.go\n536\t@@ -0,0 +1,197 @@\n537\t+package servecmd\n538\t+\n539\t+import (\n540\t+\t\"context\"\n541\t+\t\"errors\"\n542\t+\t\"strings\"\n543\t+\t\"testing\"\n544\t+\n545\t+\t\"github.com/albertcbrown/ard/internal/cli\"\n546\t+\t\"github.com/albertcbrown/ard/internal/config\"\n547\t+\t\"github.com/albertcbrown/ard/internal/executor\"\n548\t+\t\"github.com/albertcbrown/ard/internal/executor/kube\"\n549\t+\t\"github.com/albertcbrown/ard/internal/executor/kube/api\"\n550\t+\tkfake \"github.com/albertcbrown/ard/internal/executor/kube/api/fake\"\n551\t+\t\"github.com/albertcbrown/ard/internal/executor/local\"\n552\t+\t\"github.com/albertcbrown/ard/internal/github\"\n553\t+\tghfake \"github.com/albertcbrown/ard/internal/github/fake\"\n554\t+\t\"github.com/albertcbrown/ard/internal/jobpod\"\n555\t+\t\"github.com/albertcbrown/ard/internal/state\"\n556\t+)\n557\t+\n558\t+func k8sOpts() cli.K8sOpts {\n559\t+\treturn cli.K8sOpts{Namespace: \"jobs\", Instance: \"ard\", AgentImage: \"agent@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\", PodImage: \"pod@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}\n560\t+}\n561\t+\n562\t+func k8sWiring(t *testing.T, k cli.K8sOpts, auth github.Auth) (*wiring, *kfake.Fake) {\n563\t+\tt.Helper()\n564\t+\tw := newTestWiring(t)\n565\t+\tf := kfake.New()\n566\t+\tw.K8s, w.Auth = k, auth\n567\t+\tw.newKube = func() (api.Client, error) { return f, nil }\n568\t+\treturn w, f\n569\t+}\n570\t+\n571\t+func TestNewExecutorMode(t *testing.T) {\n572\t+\tapp := &github.AppAuth{}\n573\t+\tt.Run(\"local\", func(t *testing.T) {\n574\t+\t\tw := newTestWiring(t)\n575\t+\t\tw.cfg.Store(&config.Resolved{Executor: \"local\"})\n576\t+\t\tex, err := w.newExecutor()\n577\t+\t\tif _, ok := ex.(*local.Local); err != nil || !ok {\n578\t+\t\t\tt.Fatalf(\"got %T, %v\", ex, err)\n579\t+\t\t}\n580\t+\t})\n581\t+\tt.Run(\"k8s\", func(t *testing.T) {\n582\t+\t\tw, _ := k8sWiring(t, k8sOpts(), app)\n583\t+\t\tw.cfg.Store(&config.Resolved{Executor: \"k8s\"})\n584\t+\t\tex, err := w.newExecutor()\n585\t+\t\tif _, ok := ex.(*kube.Executor); err != nil || !ok {\n586\t+\t\t\tt.Fatalf(\"got %T, %v\", ex, err)\n587\t+\t\t}\n588\t+\t})\n589\t+\tt.Run(\"no config with cluster flags is unknown, then resolves\", func(t *testing.T) {\n590\t+\t\tw, _ := k8sWiring(t, k8sOpts(), app)\n591\t+\t\tif _, err := w.newExecutor(); !errors.Is(err, errModeUnknown) {\n592\t+\t\t\tt.Fatalf(\"err = %v\", err)\n593\t+\t\t}\n594\t+\t\tw.cfg.Store(&config.Resolved{Executor: \"k8s\"})\n595\t+\t\tif _, err := w.newExecutor(); err != nil {\n596\t+\t\t\tt.Fatal(err)\n597\t+\t\t}\n598\t+\t})\n599\t+\tt.Run(\"no config without flags is local\", func(t *testing.T) {\n600\t+\t\tw := newTestWiring(t)\n601\t+\t\tex, err := w.newExecutor()\n602\t+\t\tif _, ok := ex.(*local.Local); err != nil || !ok {\n603\t+\t\t\tt.Fatalf(\"got %T, %v\", ex, err)\n604\t+\t\t}\n605\t+\t})\n606\t+\tt.Run(\"missing namespace names the flag\", func(t *testing.T) {\n607\t+\t\tk := k8sOpts()\n608\t+\t\tk.Namespace = \"\"\n609\t+\t\tw, _ := k8sWiring(t, k, app)\n610\t+\t\tw.cfg.Store(&config.Resolved{Executor: \"k8s\"})\n611\t+\t\tif _, err := w.newExecutor(); err == nil || !strings.Contains(err.Error(), \"--k8s-namespace\") {\n612\t+\t\t\tt.Fatalf(\"err = %v\", err)\n613\t+\t\t}\n614\t+\t})\n615\t+\tt.Run(\"PAT is refused\", func(t *testing.T) {\n616\t+\t\tw, _ := k8sWiring(t, k8sOpts(), github.NewTokenAuth(\"x\"))\n617\t+\t\tw.cfg.Store(&config.Resolved{Executor: \"k8s\"})\n618\t+\t\tif _, err := w.newExecutor(); !errors.Is(err, github.ErrCannotScope) {\n619\t+\t\t\tt.Fatalf(\"err = %v\", err)\n620\t+\t\t}\n621\t+\t})\n622\t+}\n623\t+\n624\t+func TestExecutorDrift(t *testing.T) {\n625\t+\tw := newTestWiring(t)\n626\t+\tw.cfg.Store(&config.Resolved{Executor: \"local\"})\n627\t+\tif _, err := w.newExecutor(); err != nil {\n628\t+\t\tt.Fatal(err)\n629\t+\t}\n630\t+\tif err := w.checkExecutor(&config.Resolved{Executor: \"local\"}); err != nil {\n631\t+\t\tt.Fatal(err)\n632\t+\t}\n633\t+\terr := w.checkExecutor(&config.Resolved{Executor: \"k8s\"})\n634\t+\tif err == nil || !strings.Contains(err.Error(), \"executor changed from local to k8s; restart ard serve\") {\n635\t+\t\tt.Fatalf(\"err = %v\", err)\n636\t+\t}\n637\t+}\n638\t+\n639\t+func TestLateK8sConfigWithPATPauses(t *testing.T) {\n640\t+\tw, _ := k8sWiring(t, k8sOpts(), github.NewTokenAuth(\"x\"))\n641\t+\tif err := w.checkExecutor(&config.Resolved{Executor: \"k8s\"}); !errors.Is(err, github.ErrCannotScope) {\n642\t+\t\tt.Fatalf(\"err = %v\", err)\n643\t+\t}\n644\t+}\n645\t+\n646\t+func TestParseResources(t *testing.T) {\n647\t+\tr, err := parseResources(\"cpu=2,memory=4Gi,memory-limit=8Gi,ephemeral-storage=10Gi\")\n648\t+\tif err != nil || r.Agent.Requests[\"cpu\"] != \"2\" || r.Agent.Requests[\"memory\"] != \"4Gi\" ||\n649\t+\t\tr.Agent.Limits[\"memory\"] != \"8Gi\" || r.Agent.Limits[\"ephemeral-storage\"] != \"10Gi\" {\n650\t+\t\tt.Fatalf(\"%+v, %v\", r.Agent, err)\n651\t+\t}\n652\t+\tfor _, bad := range []string{\"cpu\", \"gpu=1\", \"cpu=\"} {\n653\t+\t\tif _, err := parseResources(bad); err == nil {\n654\t+\t\t\tt.Errorf(\"%q accepted\", bad)\n655\t+\t\t}\n656\t+\t}\n657\t+}\n658\t+\n659\t+func jobPod(name, repo, job string) *api.Pod {\n660\t+\treturn &api.Pod{Meta: api.ObjectMeta{Name: name, Labels: map[string]string{\n661\t+\t\tjobpod.LabelPartOf: \"ard\", jobpod.LabelComponent: jobpod.ComponentJob,\n662\t+\t\tjobpod.LabelInstance: jobpod.LabelValue(\"ard\"), jobpod.LabelRepo: jobpod.RepoLabel(repo), jobpod.LabelJob: job,\n663\t+\t}}}\n664\t+}\n665\t+\n666\t+func TestSweepOrphans(t *testing.T) {\n667\t+\tw, f := k8sWiring(t, k8sOpts(), &github.AppAuth{})\n668\t+\tw.cfg.Store(&config.Resolved{Executor: \"k8s\"})\n669\t+\tex, err := w.newExecutor()\n670\t+\tif err != nil {\n671\t+\t\tt.Fatal(err)\n672\t+\t}\n673\t+\tctx := context.Background()\n674\t+\tj, err := w.Store.CreateJob(ctx, state.NewJob{Stage: \"triage\", Role: \"lead\", Issue: 1})\n675\t+\tif err != nil {\n676\t+\t\tt.Fatal(err)\n677\t+\t}\n678\t+\tfor _, p := range []*api.Pod{jobPod(\"p-run\", \"o/r\", j.ID), jobPod(\"p-fix\", \"o/r\", j.ID+\"f1\"),\n679\t+\t\tjobPod(\"p-gone\", \"o/r\", \"GONE\"), jobPod(\"p-other\", \"x/y\", \"GONE\")} {\n680\t+\t\tif _, err := f.CreatePod(ctx, \"jobs\", p); err != nil {\n681\t+\t\t\tt.Fatal(err)\n682\t+\t\t}\n683\t+\t}\n684\t+\tif err := sweepOrphans(ctx, ex, w.Store, w.Log); err != nil {\n685\t+\t\tt.Fatal(err)\n686\t+\t}\n687\t+\tleft, _ := f.ListPods(ctx, \"jobs\", \"\")\n688\t+\tgot := map[string]bool{}\n689\t+\tfor _, p := range left {\n690\t+\t\tgot[p.Meta.Name] = true\n691\t+\t}\n692\t+\tif !got[\"p-run\"] || !got[\"p-fix\"] || !got[\"p-other\"] || got[\"p-gone\"] {\n693\t+\t\tt.Errorf(\"pods left: %v\", got)\n694\t+\t}\n695\t+\tvar _ executor.Executor = ex\n696\t+}\n697\t+\n698\t+func TestEnvironIncludesTokens(t *testing.T) {\n699\t+\tw := newTestWiring(t)\n700\t+\tw.exec = secretExec{}\n701\t+\tfound := false\n702\t+\tfor _, kv := range w.environ() {\n703\t+\t\tif strings.HasPrefix(kv, \"ARD_K8S_TOKEN_0=tok-value\") {\n704\t+\t\t\tfound = true\n705\t+\t\t}\n706\t+\t}\n707\t+\tif !found {\n708\t+\t\tt.Error(\"token missing from environ\")\n709\t+\t}\n710\t+}\n711\t+\n712\t+type secretExec struct{ jobExecutor }\n713\t+\n714\t+func (secretExec) Secrets() []string { return []string{\"tok-value\"} }\n715\t+\n716\t+func TestK8sRefusesPAT(t *testing.T) {\n717\t+\tfor _, dry := range []bool{false, true} {\n718\t+\t\tt.Setenv(\"HOME\", t.TempDir())\n719\t+\t\tcfg, _ := repoWithRemote(t, \"executor: k8s\\n\")\n720\t+\t\tgh := ghfake.New(ghfake.WithIdentity(github.Identity{Login: \"ard[bot]\", Kind: github.AuthToken}))\n721\t+\t\tb := fakeBuilder(gh, dry)\n722\t+\t\tpat := func(ctx context.Context, e *cli.Env, r github.Repo, s string) (deps, error) {\n723\t+\t\t\td, err := b(ctx, e, r, s)\n724\t+\t\t\td.Auth = github.NewTokenAuth(\"x\")\n725\t+\t\t\treturn d, err\n726\t+\t\t}\n727\t+\t\terr := serveLoops(context.Background(), env(t, \"o/r\", cfg, dry), pat, nil, k8sOpts())\n728\t+\t\tvar ee *cli.ExitError\n729\t+\t\tif !errors.As(err, &ee) || ee.Code != 1 || !errors.Is(err,