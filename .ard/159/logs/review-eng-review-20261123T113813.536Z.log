failed` on the issue and the PR and request no reviewers; a green run removes it. A worker that ends without the loop's result (for example one the Reaper closes out), or whose role file says `needs-human`, never becomes `:done` without a PR.\ndiff --git a/internal/committer/code.go b/internal/committer/code.go\nindex 7ab8d8d..4ec8829 100644\n--- a/internal/committer/code.go\n+++ b/internal/committer/code.go\n@@ -26,7 +26,7 @@ type CodeRequest struct {\n \tIssue  int        // > 0 (dry-run: < 0 allowed, synthetic result, as Request)\n \tRole   string     // ^[a-z0-9][a-z0-9-]*$\n \tJobID  string     // required: the Ard-Job trailer\n-\tType   string     // ^[a-z]{1,16}$, e.g. feat, fix, chore\n+\tType   string     // ^[a-z]{1,16}$, e.g. feat, fix; empty means no prefix\n \tTitle  string     // untrusted issue title\n \tBody   string     // untrusted summary, already redacted by the caller\n \tBase   string     // 40-hex SHA the job's worktree started from\n@@ -51,7 +51,7 @@ var (\n \n // CodeMessage builds:\n //\n-//\t<type>: <title> (#<issue>)\n+//\t[<type>: ]<title> (#<issue>)\n //\n //\t<body>\n //\n@@ -69,7 +69,7 @@ var (\n // No [skip ci]: PR-branch commits always run CI.\n func CodeMessage(typ, title string, issue int, body, jobID string) (string, error) {\n \tswitch {\n-\tcase !typeRe.MatchString(typ):\n+\tcase typ != \"\" && !typeRe.MatchString(typ):\n \t\treturn \"\", fmt.Errorf(\"%w: bad type %q\", ErrInvalid, typ)\n \tcase !jobRe.MatchString(jobID):\n \t\treturn \"\", fmt.Errorf(\"%w: bad or missing job id\", ErrInvalid)\n@@ -83,7 +83,10 @@ func CodeMessage(typ, title string, issue int, body, jobID string) (string, erro\n \tif t == \"\" {\n \t\treturn \"\", fmt.Errorf(\"%w: empty title\", ErrInvalid)\n \t}\n-\tprefix, suffix := typ+\": \", fmt.Sprintf(\" (#%d)\", issue)\n+\tprefix, suffix := \"\", fmt.Sprintf(\" (#%d)\", issue)\n+\tif typ != \"\" {\n+\t\tprefix = typ + \": \"\n+\t}\n \tif avail := maxSummaryRunes - utf8.RuneCountInString(prefix+suffix); utf8.RuneCountInString(t) > avail {\n \t\tt = strings.TrimSpace(string([]rune(t)[:avail-1])) + \"…\"\n \t}\ndiff --git a/internal/committer/code_test.go b/internal/committer/code_test.go\nindex 733b824..0b9df9a 100644\n--- a/internal/committer/code_test.go\n+++ b/internal/committer/code_test.go\n@@ -69,6 +69,17 @@ func TestCodeMessage(t *testing.T) {\n \t\t\t}\n \t\t}},\n \t\t{name: \"empty title\", typ: \"fix\", title: \" \\n \", job: \"j1\", invalid: true},\n+\t\t{name: \"no type\", typ: \"\", title: \"t\", job: \"j1\", check: func(t *testing.T, m string) {\n+\t\t\tif m != \"t (#12)\\n\\nArd-Job: j1\" {\n+\t\t\t\tt.Errorf(\"got %q\", m)\n+\t\t\t}\n+\t\t}},\n+\t\t{name: \"no type long\", typ: \"\", title: long, job: \"j1\", check: func(t *testing.T, m string) {\n+\t\t\tfirst, _, _ := strings.Cut(m, \"\\n\")\n+\t\t\tif !strings.HasSuffix(first, \"… (#12)\") || utf8.RuneCountInString(first) != 72 {\n+\t\t\t\tt.Errorf(\"first line %q (%d)\", first, utf8.RuneCountInString(first))\n+\t\t\t}\n+\t\t}},\n \t\t{name: \"bad type\", typ: \"Fix!\", title: \"t\", job: \"j1\", invalid: true},\n \t\t{name: \"no job\", typ: \"fix\", title: \"t\", invalid: true},\n \t}\ndiff --git a/internal/worker/type.go b/internal/worker/type.go\nindex 1a076da..45b6149 100644\n--- a/internal/worker/type.go\n+++ b/internal/worker/type.go\n@@ -4,7 +4,8 @@ import \"strings\"\n \n // CommitType maps an issue's type:* label to a conventional-commit type:\n // type:feature is feat, type:bug is fix, and docs, chore, refactor and test\n-// keep their names. Any other label, or none, is chore.\n+// keep their names. Any other label, or none, is \"\": the caller then leaves\n+// the prefix out rather than guessing one.\n func CommitType(labels []string) string {\n \tfor _, l := range labels {\n \t\tswitch strings.ToLower(l) {\n@@ -22,5 +23,5 @@ func CommitType(labels []string) string {\n \t\t\treturn \"test\"\n \t\t}\n \t}\n-\treturn \"chore\"\n+\treturn \"\"\n }\ndiff --git a/internal/worker/unit_test.go b/internal/worker/unit_test.go\nindex 0d83115..f210002 100644\n--- a/internal/worker/unit_test.go\n+++ b/internal/worker/unit_test.go\n@@ -42,7 +42,8 @@ func TestCommitType(t *testing.T) {\n \t\tlabels []string\n \t\twant   string\n \t}{\n-\t\t{nil, \"chore\"},\n+\t\t{nil, \"\"},\n+\t\t{[]string{\"area:x\"}, \"\"},\n \t\t{[]string{\"type:feature\"}, \"feat\"},\n \t\t{[]string{\"area:x\", \"type:bug\"}, \"fix\"},\n \t\t{[]string{\"type:docs\"}, \"docs\"},\n@@ -50,7 +51,7 @@ func TestCommitType(t *testing.T) {\n \t\t{[]string{\"type:refactor\"}, \"refactor\"},\n \t\t{[]string{\"type:test\"}, \"test\"},\n \t\t{[]string{\"TYPE:Bug\"}, \"fix\"},\n-\t\t{[]string{\"type:decision\"}, \"chore\"},\n+\t\t{[]string{\"type:decision\"}, \"\"},\n \t} {\n \t\tif got := CommitType(tc.labels); got != tc.want {\n \t\t\tt.Errorf(\"CommitType(%v) = %q, want %q\", tc.labels, got, tc.want)\n@@ -186,6 +187,9 @@ Opened by ard from issue #7. The summary below was written by an agent and is un\n \tif got, _ := Title(\"fix\", \"Crash (on) start\", 7, \"J1\"); got != \"fix: Crash (on) start (#7)\" {\n \t\tt.Errorf(\"title = %q\", got)\n \t}\n+\tif got, _ := Title(\"\", \"Crash on start\", 7, \"J1\"); got != \"Crash on start (#7)\" {\n+\t\tt.Errorf(\"unprefixed title = %q\", got)\n+\t}\n \tif got, _ := Title(\"fix\", \"Fixes #5 now\", 7, \"J1\"); strings.Contains(got, \"#5\") {\n \t\tt.Errorf(\"title keeps a closing ref: %q\", got)\n \t}\n","numLines":147,"startLine":1,"totalLines":147}},"tool_result_meta":[{"id":"toolu_01DqXWGYVPEVy8TLScsz1BNx","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
