{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FnfjmMwaSXz16ibtau6r6a","type":"tool_result","content":"1\tpackage closeout\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"os\"\n9\t\t\"strings\"\n10\t\t\"unicode/utf8\"\n11\t\n12\t\t\"gopkg.in/yaml.v3\"\n13\t)\n14\t\n15\t// Stage words of the jobs close-out handles.\n16\tconst (\n17\t\tStageTriage = \"triage\"\n18\t\tStageWorker = \"worker\"\n19\t\tStageReview = \"review\"\n20\t)\n21\t\n22\t// Role file statuses and reviewer verdicts.\n23\tconst (\n24\t\tStatusDone       = \"done\"\n25\t\tStatusBlocked    = \"blocked\"\n26\t\tStatusNeedsHuman = \"needs-human\"\n27\t\tVerdictApprove   = \"approve\"\n28\t\tVerdictChanges   = \"changes\"\n29\t)\n30\t\n31\t// Finding severities, most serious first.\n32\tconst (\n33\t\tSeverityCritical = \"critical\"\n34\t\tSeverityHigh     = \"high\"\n35\t\tSeverityMedium   = \"medium\"\n36\t\tSeverityLow      = \"low\"\n37\t\tSeverityInfo     = \"info\"\n38\t)\n39\t\n40\t// MaxFindings bounds the findings of one review; MaxFindingPath bounds a\n41\t// finding's file path in bytes.\n42\tconst (\n43\t\tMaxFindings    = 50\n44\t\tMaxFindingPath = 300\n45\t)\n46\t\n47\t// MaxRoleFileBytes bounds a role file.\n48\tconst MaxRoleFileBytes = 256 << 10\n49\t\n50\tvar (\n51\t\t// ErrMissing means the role file does not exist.\n52\t\tErrMissing = errors.New(\"closeout: role file missing\")\n53\t\t// ErrMalformed means the role file exists but breaks the contract. It is\n54\t\t// always wrapped with the reason.\n55\t\tErrMalformed = errors.New(\"closeout: malformed role file\")\n56\t)\n57\t\n58\t// RoleFile is the parsed .ard/<issue#>/<stage>-<role>.md.\n59\ttype RoleFile struct {\n60\t\tRole, Status, Verdict, Worker string\n61\t\tAttempt                       int\n62\t\tNext                          []string // raw entries; see next.go\n63\t\tSummary                       string\n64\t\t// Findings are a review's findings, in file order. Only a review may have\n65\t\t// them (check).\n66\t\tFindings []Finding\n67\t}\n68\t\n69\t// Finding is one point a reviewer raised.\n70\ttype Finding struct {\n71\t\tFile     string // repo-relative slash path\n72\t\tLine     int    // 1-based; 0 means the whole file\n73\t\tSeverity string\n74\t\tBlocking bool\n75\t\tMessage  string // untrusted agent text\n76\t}\n77\t\n78\t// HasBlocking reports whether any finding blocks.\n79\tfunc HasBlocking(fs []Finding) bool {\n80\t\tfor _, f := range fs {\n81\t\t\tif f.Blocking {\n82\t\t\t\treturn true\n83\t\t\t}\n84\t\t}\n85\t\treturn false\n86\t}\n87\t\n88\t// DowngradeVerdict makes an approve that carries a blocking finding a\n89\t// changes verdict, and reports whether it did. A reviewer that blocks and\n90\t// approves in one breath is read conservatively; the job still succeeds.\n91\tfunc (rf *RoleFile) DowngradeVerdict() bool {\n92\t\tif rf.Verdict == VerdictApprove && HasBlocking(rf.Findings) {\n93\t\t\trf.Verdict = VerdictChanges\n94\t\t\treturn true\n95\t\t}\n96\t\treturn false\n97\t}\n98\t\n99\ttype rawFinding struct {\n100\t\tFile     *string `yaml:\"file\"`\n101\t\tLine     *int    `yaml:\"line\"`\n102\t\tSeverity *string `yaml:\"severity\"`\n103\t\tBlocking *bool   `yaml:\"blocking\"`\n104\t\tMessage  *string `yaml:\"message\"`\n105\t}\n106\t\n107\ttype rawFront struct {\n108\t\tRole    *string   `yaml:\"role\"`\n109\t\tStatus  *string   `yaml:\"status\"`\n110\t\tAttempt *int      `yaml:\"attempt\"`\n111\t\tNext    *[]string `yaml:\"next\"`\n112\t\tVerdict *string   `yaml:\"verdict\"`\n113\t\tWorker  *string   `yaml:\"worker\"`\n114\t\n115\t\tFindings *[]rawFinding `yaml:\"findings\"`\n116\t}\n117\t\n118\tfunc malformed(format string, a ...any) error {\n119\t\treturn fmt.Errorf(\"%w: %s\", ErrMalformed, fmt.Sprintf(format, a...))\n120\t}\n121\t\n122\t// Parse reads a role file: a first line of exactly \"---\", YAML, a line of\n123\t// exactly \"---\", then the summary. It checks the syntax and the field\n124\t// types; Check validates the fields against the job.\n125\tfunc Parse(b []byte) (RoleFile, error) {\n126\t\tif len(b) > MaxRoleFileBytes {\n127\t\t\treturn RoleFile{}, malformed(\"file is %d bytes, max %d\", len(b), MaxRoleFileBytes)\n128\t\t}\n129\t\tif !utf8.Valid(b) || bytes.IndexByte(b, 0) >= 0 {\n130\t\t\treturn RoleFile{}, malformed(\"not valid UTF-8 text\")\n131\t\t}\n132\t\tb = bytes.TrimPrefix(b, []byte(\"\\xef\\xbb\\xbf\"))\n133\t\tlines := strings.SplitAfter(string(b), \"\\n\")\n134\t\tfence := func(l string) bool { return strings.TrimSuffix(strings.TrimSuffix(l, \"\\n\"), \"\\r\") == \"---\" }\n135\t\tif len(lines) == 0 || !fence(lines[0]) {\n136\t\t\treturn RoleFile{}, malformed(\"no opening --- line\")\n137\t\t}\n138\t\tend := -1\n139\t\tfor i := 1; i < len(lines); i++ {\n140\t\t\tif fence(lines[i]) {\n141\t\t\t\tend = i\n142\t\t\t\tbreak\n143\t\t\t}\n144\t\t}\n145\t\tif end < 0 {\n146\t\t\treturn RoleFile{}, malformed(\"no closing --- line\")\n147\t\t}\n148\t\tfront := strings.Join(lines[1:end], \"\")\n149\t\tsummary := strings.TrimSpace(strings.Join(lines[end+1:], \"\"))\n150\t\n151\t\tvar raw rawFront\n152\t\tdec := yaml.NewDecoder(strings.NewReader(front))\n153\t\tdec.KnownFields(true)\n154\t\tif err := dec.Decode(&raw); err != nil {\n155\t\t\tif errors.Is(err, io.EOF) {\n156\t\t\t\treturn RoleFile{}, malformed(\"empty frontmatter\")\n157\t\t\t}\n158\t\t\treturn RoleFile{}, malformed(\"frontmatter: %v\", err)\n159\t\t}\n160\t\tif err := checkTypes(front); err != nil {\n161\t\t\treturn RoleFile{}, err\n162\t\t}\n163\t\tvar extra rawFront\n164\t\tif err := dec.Decode(&extra); !errors.Is(err, io.EOF) {\n165\t\t\treturn RoleFile{}, malformed(\"frontmatter holds more than one document\")\n166\t\t}\n167\t\trf := RoleFile{Summary: summary}\n168\t\tvar err error\n169\t\tswitch {\n170\t\tcase raw.Role == nil:\n171\t\t\treturn RoleFile{}, malformed(\"missing role\")\n172\t\tcase raw.Status == nil:\n173\t\t\treturn RoleFile{}, malformed(\"missing status\")\n174\t\tcase raw.Attempt == nil:\n175\t\t\treturn RoleFile{}, malformed(\"missing attempt\")\n176\t\t}\n177\t\trf.Role, rf.Status, rf.Attempt = *raw.Role, *raw.Status, *raw.Attempt\n178\t\tif raw.Verdict != nil {\n179\t\t\trf.Verdict = *raw.Verdict\n180\t\t}\n181\t\tif raw.Worker != nil {\n182\t\t\trf.Worker = *raw.Worker\n183\t\t}\n184\t\tif raw.Next != nil {\n185\t\t\trf.Next = *raw.Next\n186\t\t}\n187\t\tif raw.Findings != nil {\n188\t\t\tif rf.Findings, err = findingsOf(*raw.Findings); err != nil {\n189\t\t\t\treturn RoleFile{}, err\n190\t\t\t}\n191\t\t}\n192\t\tswitch rf.Status {\n193\t\tcase StatusDone, StatusBlocked, StatusNeedsHuman:\n194\t\tdefault:\n195\t\t\treturn RoleFile{}, malformed(\"status %q is not done, blocked or needs-human\", clip(rf.Status, 40))\n196\t\t}\n197\t\tif rf.Attempt < 1 {\n198\t\t\treturn RoleFile{}, malformed(\"attempt %d is below 1\", rf.Attempt)\n199\t\t}\n200\t\tif rf.Verdict != \"\" && rf.Verdict != VerdictApprove && rf.Verdict != VerdictChanges {\n201\t\t\treturn RoleFile{}, malformed(\"verdict %q is not approve or changes\", clip(rf.Verdict, 40))\n202\t\t}\n203\t\tif rf.Summary == \"\" {\n204\t\t\treturn RoleFile{}, malformed(\"empty summary\")\n205\t\t}\n206\t\treturn rf, nil\n207\t}\n208\t\n209\t// check applies the rules that depend on the job: the role name and where a\n210\t// verdict or worker field may appear.\n211\tfunc (rf RoleFile) check(j Job) error {\n212\t\tif rf.Role != j.Role {\n213\t\t\treturn malformed(\"role %q does not match job role %q\", clip(rf.Role, 40), j.Role)\n214\t\t}\n215\t\tif rf.Verdict != \"\" && j.Stage != StageReview {\n216\t\t\treturn malformed(\"verdict is allowed only on a review\")\n217\t\t}\n218\t\tif j.Stage == StageReview && rf.Status == StatusDone && rf.Verdict == \"\" {\n219\t\t\treturn malformed(\"a done review needs verdict: approve or changes\")\n220\t\t}\n221\t\tif len(rf.Findings) > 0 && j.Stage != StageReview {\n222\t\t\treturn malformed(\"findings are allowed only on a review\")\n223\t\t}\n224\t\tif rf.Worker != \"\" && !(j.Stage == StageTriage && j.Role == \"lead\") {\n225\t\t\treturn malformed(\"worker is allowed only for triage:lead\")\n226\t\t}\n227\t\treturn nil\n228\t}\n229\t\n230\t// findingsOf validates the findings of a review.\n231\tfunc findingsOf(raw []rawFinding) ([]Finding, error) {\n232\t\tif len(raw) > MaxFindings {\n233\t\t\treturn nil, malformed(\"%d findings, max %d\", len(raw), MaxFindings)\n234\t\t}\n235\t\tout := make([]Finding, 0, len(raw))\n236\t\tfor i, r := range raw {\n237\t\t\tswitch {\n238\t\t\tcase r.File == nil:\n239\t\t\t\treturn nil, malformed(\"finding %d: missing file\", i+1)\n240\t\t\tcase r.Severity == nil:\n241\t\t\t\treturn nil, malformed(\"finding %d: missing severity\", i+1)\n242\t\t\tcase r.Message == nil:\n243\t\t\t\treturn nil, malformed(\"finding %d: missing message\", i+1)\n244\t\t\t}\n245\t\t\tf := Finding{File: *r.File, Severity: *r.Severity, Message: strings.TrimSpace(*r.Message)}\n246\t\t\tif err := checkFindingPath(f.File); err != nil {\n247\t\t\t\treturn nil, malformed(\"finding %d: file %v\", i+1, err)\n248\t\t\t}\n249\t\t\tswitch f.Severity {\n250\t\t\tcase SeverityCritical, SeverityHigh, SeverityMedium, SeverityLow, SeverityInfo:\n251\t\t\tdefault:\n252\t\t\t\treturn nil, malformed(\"finding %d: severity %q is not critical, high, medium, low or info\", i+1, clip(f.Severity, 40))\n253\t\t\t}\n254\t\t\tif f.Message == \"\" {\n255\t\t\t\treturn nil, malformed(\"finding %d: empty message\", i+1)\n256\t\t\t}\n257\t\t\tif r.Line != nil {\n258\t\t\t\tif *r.Line < 1 {\n259\t\t\t\t\treturn nil, malformed(\"finding %d: line %d is below 1\", i+1, *r.Line)\n260\t\t\t\t}\n261\t\t\t\tf.Line = *r.Line\n262\t\t\t}\n263\t\t\tf.Blocking = r.Blocking != nil && *r.Blocking\n264\t\t\tout = append(out, f)\n265\t\t}\n266\t\treturn out, nil\n267\t}\n268\t\n269\t// checkFindingPath accepts only a clean repo-relative slash path.\n270\tfunc checkFindingPath(p string) error {\n271\t\tswitch {\n272\t\tcase p == \"\":\n273\t\t\treturn errors.New(\"is empty\")\n274\t\tcase len(p) > MaxFindingPath:\n275\t\t\treturn fmt.Errorf(\"is %d bytes, max %d\", len(p), MaxFindingPath)\n276\t\tcase strings.ContainsAny(p, \"\\\\\\x00\"):\n277\t\t\treturn errors.New(\"has a backslash or NUL\")\n278\t\tcase strings.HasPrefix(p, \"/\"):\n279\t\t\treturn errors.New(\"is absolute\")\n280\t\t}\n281\t\tfor _, seg := range strings.Split(p, \"/\") {\n282\t\t\tif seg == \"\" || seg == \".\" || seg == \"..\" {\n283\t\t\t\treturn errors.New(\"is not a clean relative path\")\n284\t\t\t}\n285\t\t}\n286\t\treturn nil\n287\t}\n288\t\n289\t// readRoleFile reads path without following a symlink.\n290\tfunc readRoleFile(path string) ([]byte, error) {\n291\t\tfi, err := os.Lstat(path)\n292\t\tif errors.Is(err, os.ErrNotExist) {\n293\t\t\treturn nil, ErrMissing\n294\t\t}\n295\t\tif err != nil {\n296\t\t\treturn nil, fmt.Errorf(\"stat role file: %w\", err)\n297\t\t}\n298\t\tif !fi.Mode().IsRegular() {\n299\t\t\treturn nil, malformed(\"not a regular file\")\n300\t\t}\n301\t\tif fi.Size() > MaxRoleFileBytes {\n302\t\t\treturn nil, malformed(\"file is %d bytes, max %d\", fi.Size(), MaxRoleFileBytes)\n303\t\t}\n304\t\tb, err := os.ReadFile(path)\n305\t\tif errors.Is(err, os.ErrNotExist) {\n306\t\t\treturn nil, ErrMissing\n307\t\t}\n308\t\tif err != nil {\n309\t\t\treturn nil, fmt.Errorf(\"read role file: %w\", err)\n310\t\t}\n311\t\treturn b, nil\n312\t}\n313\t\n314\t// clip shortens untrusted text for a reason string.\n315\tfunc clip(s string, n int) string {\n316\t\tr := []rune(s)\n317\t\tif len(r) > n {\n318\t\t\treturn string(r[:n]) + \"...\"\n319\t\t}\n320\t\treturn s\n321\t}\n322\t\n323\t// findingsTypes checks the scalar tags of a findings sequence.\n324\tfunc findingsTypes(v *yaml.Node) bool {\n325\t\tif v.Kind != yaml.SequenceNode {\n326\t\t\treturn false\n327\t\t}\n328\t\tfor _, e := range v.Content {\n329\t\t\tif e.Kind != yaml.MappingNode {\n330\t\t\t\treturn false\n331\t\t\t}\n332\t\t\tfor i := 0; i+1 < len(e.Content); i += 2 {\n333\t\t\t\tval := e.Content[i+1]\n334\t\t\t\tif val.Kind != yaml.ScalarNode {\n335\t\t\t\t\treturn false\n336\t\t\t\t}\n337\t\t\t\tswitch e.Content[i].Value {\n338\t\t\t\tcase \"file\", \"severity\", \"message\":\n339\t\t\t\t\tif val.Tag != \"!!str\" {\n340\t\t\t\t\t\treturn false\n341\t\t\t\t\t}\n342\t\t\t\tcase \"line\":\n343\t\t\t\t\tif val.Tag != \"!!int\" {\n344\t\t\t\t\t\treturn false\n345\t\t\t\t\t}\n346\t\t\t\tcase \"blocking\":\n347\t\t\t\t\tif val.Tag != \"!!bool\" {\n348\t\t\t\t\t\treturn false\n349\t\t\t\t\t}\n350\t\t\t\t}\n351\t\t\t}\n352\t\t}\n353\t\treturn true\n354\t}\n355\t\n356\t// checkTypes rejects scalars yaml.v3 would coerce: role, status, verdict and\n357\t// worker must be strings, attempt an integer, next a list of strings.\n358\tfunc checkTypes(front string) error {\n359\t\tvar doc yaml.Node\n360\t\tif err := yaml.Unmarshal([]byte(front), &doc); err != nil || len(doc.Content) == 0 {\n361\t\t\treturn malformed(\"frontmatter: unreadable\")\n362\t\t}\n363\t\tm := doc.Content[0]\n364\t\tif m.Kind != yaml.MappingNode {\n365\t\t\treturn malformed(\"frontmatter is not a mapping\")\n366\t\t}\n367\t\tfor i := 0; i+1 < len(m.Content); i += 2 {\n368\t\t\tkey, v := m.Content[i].Value, m.Content[i+1]\n369\t\t\tok := true\n370\t\t\tswitch key {\n371\t\t\tcase \"role\", \"status\", \"verdict\", \"worker\":\n372\t\t\t\tok = v.Kind == yaml.ScalarNode && v.Tag == \"!!str\"\n373\t\t\tcase \"attempt\":\n374\t\t\t\tok = v.Kind == yaml.ScalarNode && v.Tag == \"!!int\"\n375\t\t\tcase \"findings\":\n376\t\t\t\tok = findingsTypes(v)\n377\t\t\tcase \"next\":\n378\t\t\t\tok = v.Kind == yaml.SequenceNode\n379\t\t\t\tfor _, e := range v.Content {\n380\t\t\t\t\tif e.Kind != yaml.ScalarNode || e.Tag != \"!!str\" {\n381\t\t\t\t\t\tok = false\n382\t\t\t\t\t}\n383\t\t\t\t}\n384\t\t\t}\n385\t\t\tif !ok {\n386\t\t\t\treturn malformed(\"field %s: wrong type\", key)\n387\t\t\t}\n388\t\t}\n389\t\treturn nil\n390\t}\n391\t"}]},"parent_tool_use_id":null,"session_id":"fe75d909-a730-40c7-a147-43d1c2a12ca1","uuid":"e1841c64-97b0-4517-b573-772dd535f1d9","timestamp":"2026-11-24T19:18:25.301Z","tool_use_result":{"type":"text","file":{"filePath":"/work/internal/closeout/rolefile.go","content":"package closeout\n\nimport (\n\t\"bytes\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"strings\"\n\t\"unicode/utf8\"\n\n\t\"gopkg.in/yaml.v3\"\n)\n\n// Stage words of the jobs close-out handles.\nconst (\n\tStageTriage = \"triage\"\n\tStageWorker = \"worker\"\n\tStageReview = \"review\"\n)\n\n// Role file statuses and reviewer verdicts.\nconst (\n\tStatusDone       = \"done\"\n\tStatusBlocked    = \"blocked\"\n\tStatusNeedsHuman = \"needs-human\"\n\tVerdictApprove   = \"approve\"\n\tVerdictChanges   = \"changes\"\n)\n\n// Finding severities, most serious first.\nconst (\n\tSeverityCritical = \"critical\"\n\tSeverityHigh     = \"high\"\n\tSeverityMedium   = \"medium\"\n\tSeverityLow      = \"low\"\n\tSeverityInfo     = \"info\"\n)\n\n// MaxFindings bounds the findings of one review; MaxFindingPath bounds a\n// finding's file path in bytes.\nconst (\n\tMaxFindings    = 50\n\tMaxFindingPath = 300\n)\n\n// MaxRoleFileBytes bounds a role file.\nconst MaxRoleFileBytes = 256 << 10\n\nvar (\n\t// ErrMissing means the role file does not exist.\n\tErrMissing = errors.New(\"closeout: role file missing\")\n\t// ErrMalformed means the role file exists but breaks the contract. It is\n\t// always wrapped with the reason.\n\tErrMalformed = errors.New(\"closeout: malformed role file\")\n)\n\n// RoleFile is the parsed .ard/<issue#>/<stage>-<role>.md.\ntype RoleFile struct {\n\tRole, Status, Verdict, Worker string\n\tAttempt                       int\n\tNext                          []string // raw entries; see next.go\n\tSummary                       string\n\t// Findings are a review's findings, in file order. Only a review may have\n\t// them (check).\n\tFindings []Finding\n}\n\n// Finding is one point a reviewer raised.\ntype Finding struct {\n\tFile     string // repo-relative slash path\n\tLine     int    // 1-based; 0 means the whole file\n\tSeverity string\n\tBlocking bool\n\tMessage  string // untrusted agent text\n}\n\n// HasBlocking reports whether any finding blocks.\nfunc HasBlocking(fs []Finding) bool {\n\tfor _, f := range fs {\n\t\tif f.Blocking {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// DowngradeVerdict makes an approve that carries a blocking finding a\n// changes verdict, and reports whether it did. A reviewer that blocks and\n// approves in one breath is read conservatively; the job still succeeds.\nfunc (rf *RoleFile) DowngradeVerdict() bool {\n\tif rf.Verdict == VerdictApprove && HasBlocking(rf.Findings) {\n\t\trf.Verdict = VerdictChanges\n\t\treturn true\n\t}\n\treturn false\n}\n\ntype rawFinding struct {\n\tFile     *string `yaml:\"file\"`\n\tLine     *int    `yaml:\"line\"`\n\tSeverity *string `yaml:\"severity\"`\n\tBlocking *bool   `yaml:\"blocking\"`\n\tMessage  *string `yaml:\"message\"`\n}\n\ntype rawFront struct {\n\tRole    *string   `yaml:\"role\"`\n\tStatus  *string   `yaml:\"status\"`\n\tAttempt *int      `yaml:\"attempt\"`\n\tNext    *[]string `yaml:\"next\"`\n\tVerdict *string   `yaml:\"verdict\"`\n\tWorker  *string   `yaml:\"worker\"`\n\n\tFindings *[]rawFinding `yaml:\"findings\"`\n}\n\nfunc malformed(format string, a ...any) error {\n\treturn fmt.Errorf(\"%w: %s\", ErrMalformed, fmt.Sprintf(format, a...))\n}\n\n// Parse reads a role file: a first line of exactly \"---\", YAML, a line of\n// exactly \"---\", then the summary. It checks the syntax and the field\n// types; Check validates the fields against the job.\nfunc Parse(b []byte) (RoleFile, error) {\n\tif len(b) > MaxRoleFileBytes {\n\t\treturn RoleFile{}, malformed(\"file is %d bytes, max %d\", len(b), MaxRoleFileBytes)\n\t}\n\tif !utf8.Valid(b) || bytes.IndexByte(b, 0) >= 0 {\n\t\treturn RoleFile{}, malformed(\"not valid UTF-8 text\")\n\t}\n\tb = bytes.TrimPrefix(b, []byte(\"\\xef\\xbb\\xbf\"))\n\tlines := strings.SplitAfter(string(b), \"\\n\")\n\tfence := func(l string) bool { return strings.TrimSuffix(strings.TrimSuffix(l, \"\\n\"), \"\\r\") == \"---\" }\n\tif len(lines) == 0 || !fence(lines[0]) {\n\t\treturn RoleFile{}, malformed(\"no opening --- line\")\n\t}\n\tend := -1\n\tfor i := 1; i < len(lines); i++ {\n\t\tif fence(lines[i]) {\n\t\t\tend = i\n\t\t\tbreak\n\t\t}\n\t}\n\tif end < 0 {\n\t\treturn RoleFile{}, malformed(\"no closing --- line\")\n\t}\n\tfront := strings.Join(lines[1:end], \"\")\n\tsummary := strings.TrimSpace(strings.Join(lines[end+1:], \"\"))\n\n\tvar raw rawFront\n\tdec := yaml.NewDecoder(strings.NewReader(front))\n\tdec.KnownFields(true)\n\tif err := dec.Decode(&raw); err != nil {\n\t\tif errors.Is(err, io.EOF) {\n\t\t\treturn RoleFile{}, malformed(\"empty frontmatter\")\n\t\t}\n\t\treturn RoleFile{}, malformed(\"frontmatter: %v\", err)\n\t}\n\tif err := checkTypes(front); err != nil {\n\t\treturn RoleFile{}, err\n\t}\n\tvar extra rawFront\n\tif err := dec.Decode(&extra); !errors.Is(err, io.EOF) {\n\t\treturn RoleFile{}, malformed(\"frontmatter holds more than one document\")\n\t}\n\trf := RoleFile{Summary: summary}\n\tvar err error\n\tswitch {\n\tcase raw.Role == nil:\n\t\treturn RoleFile{}, malformed(\"missing role\")\n\tcase raw.Status == nil:\n\t\treturn RoleFile{}, malformed(\"missing status\")\n\tcase raw.Attempt == nil:\n\t\treturn RoleFile{}, malformed(\"missing attempt\")\n\t}\n\trf.Role, rf.Status, rf.Attempt = *raw.Role, *raw.Status, *raw.Attempt\n\tif raw.Verdict != nil {\n\t\trf.Verdict = *raw.Verdict\n\t}\n\tif raw.Worker != nil {\n\t\trf.Worker = *raw.Worker\n\t}\n\tif raw.Next != nil {\n\t\trf.Next = *raw.Next\n\t}\n\tif raw.Findings != nil {\n\t\tif rf.Findings, err = findingsOf(*raw.Findings); err != nil {\n\t\t\treturn RoleFile{}, err\n\t\t}\n\t}\n\tswitch rf.Status {\n\tcase StatusDone, StatusBlocked, StatusNeedsHuman:\n\tdefault:\n\t\treturn RoleFile{}, malformed(\"status %q is not done, blocked or needs-human\", clip(rf.Status, 40))\n\t}\n\tif rf.Attempt < 1 {\n\t\treturn RoleFile{}, malformed(\"attempt %d is below 1\", rf.Attempt)\n\t}\n\tif rf.Verdict != \"\" && rf.Verdict != VerdictApprove && rf.Verdict != VerdictChanges {\n\t\treturn RoleFile{}, malformed(\"verdict %q is not approve or changes\", clip(rf.Verdict, 40))\n\t}\n\tif rf.Summary == \"\" {\n\t\treturn RoleFile{}, malformed(\"empty summary\")\n\t}\n\treturn rf, nil\n}\n\n// check applies the rules that depend on the job: the role name and where a\n// verdict or worker field may appear.\nfunc (rf RoleFile) check(j Job) error {\n\tif rf.Role != j.Role {\n\t\treturn malformed(\"role %q does not match job role %q\", clip(rf.Role, 40), j.Role)\n\t}\n\tif rf.Verdict != \"\" && j.Stage != StageReview {\n\t\treturn malformed(\"verdict is allowed only on a review\")\n\t}\n\tif j.Stage == StageReview && rf.Status == StatusDone && rf.Verdict == \"\" {\n\t\treturn malformed(\"a done review needs verdict: approve or changes\")\n\t}\n\tif len(rf.Findings) > 0 && j.Stage != StageReview {\n\t\treturn malformed(\"findings are allowed only on a review\")\n\t}\n\tif rf.Worker != \"\" && !(j.Stage == StageTriage && j.Role == \"lead\") {\n\t\treturn malformed(\"worker is allowed only for triage:lead\")\n\t}\n\treturn nil\n}\n\n// findingsOf validates the findings of a review.\nfunc findingsOf(raw []rawFinding) ([]Finding, error) {\n\tif len(raw) > MaxFindings {\n\t\treturn nil, malformed(\"%d findings, max %d\", len(raw), MaxFindings)\n\t}\n\tout := make([]Finding, 0, len(raw))\n\tfor i, r := range raw {\n\t\tswitch {\n\t\tcase r.File == nil:\n\t\t\treturn nil, malformed(\"finding %d: missing file\", i+1)\n\t\tcase r.Severity == nil:\n\t\t\treturn nil, malformed(\"finding %d: missing severity\", i+1)\n\t\tcase r.Message == nil:\n\t\t\treturn nil, malformed(\"finding %d: missing message\", i+1)\n\t\t}\n\t\tf := Finding{File: *r.File, Severity: *r.Severity, Message: strings.TrimSpace(*r.Message)}\n\t\tif err := checkFindingPath(f.File); err != nil {\n\t\t\treturn nil, malformed(\"finding %d: file %v\", i+1, err)\n\t\t}\n\t\tswitch f.Severity {\n\t\tcase SeverityCritical, SeverityHigh, SeverityMedium, SeverityLow, SeverityInfo:\n\t\tdefault:\n\t\t\treturn nil, malformed(\"finding %d: severity %q is not critical, high, medium, low or info\", i+1, clip(f.Severity, 40))\n\t\t}\n\t\tif f.Message == \"\" {\n\t\t\treturn nil, malformed(\"finding %d: empty message\", i+1)\n\t\t}\n\t\tif r.Line != nil {\n\t\t\tif *r.Line < 1 {\n\t\t\t\treturn nil, malformed(\"finding %d: line %d is below 1\", i+1, *r.Line)\n\t\t\t}\n\t\t\tf.Line = *r.Line\n\t\t}\n\t\tf.Blocking = r.Blocking != nil && *r.Blocking\n\t\tout = append(out, f)\n\t}\n\treturn out, nil\n}\n\n// checkFindingPath accepts only a clean repo-relative slash path.\nfunc checkFindingPath(p string) error {\n\tswitch {\n\tcase p == \"\":\n\t\treturn errors.New(\"is empty\")\n\tcase len(p) > MaxFindingPath:\n\t\treturn fmt.Errorf(\"is %d bytes, max %d\", len(p), MaxFindingPath)\n\tcase strings.ContainsAny(p, \"\\\\\\x00\"):\n\t\treturn errors.New(\"has a backslash or NUL\")\n\tcase strings.HasPrefix(p, \"/\"):\n\t\treturn errors.New(\"is absolute\")\n\t}\n\tfor _, seg := range strings.Split(p, \"/\") {\n\t\tif seg == \"\" || seg == \".\" || seg == \"..\" {\n\t\t\treturn errors.New(\"is not a clean relative path\")\n\t\t}\n\t}\n\treturn nil\n}\n\n// readRoleFile reads path without following a symlink.\nfunc readRoleFile(path string) ([]byte, error) {\n\tfi, err := os.Lstat(path)\n\tif errors.Is(err, os.ErrNotExist) {\n\t\treturn nil, ErrMissing\n\t}\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"stat role file: %w\", err)\n\t}\n\tif !fi.Mode().IsRegular() {\n\t\treturn nil, malformed(\"not a regular file\")\n\t}\n\tif fi.Size() > MaxRoleFileBytes {\n\t\treturn nil, malformed(\"file is %d bytes, max %d\", fi.Size(), MaxRoleFileBytes)\n\t}\n\tb, err := os.ReadFile(path)\n\tif errors.Is(err, os.ErrNotExist) {\n\t\treturn nil, ErrMissing\n\t}\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"read role file: %w\", err)\n\t}\n\treturn b, nil\n}\n\n// clip shortens untrusted text for a reason string.\nfunc clip(s string, n int) string {\n\tr := []rune(s)\n\tif len(r) > n {\n\t\treturn string(r[:n]) + \"...\"\n\t}\n\treturn s\n}\n\n// findingsTypes checks the scalar tags of a findings sequence.\nfunc findingsTypes(v *yaml.Node) bool {\n\tif v.Kind != yaml.SequenceNode {\n\t\treturn false\n\t}\n\tfor _, e := range v.Content {\n\t\tif e.Kind != yaml.MappingNode {\n\t\t\treturn false\n\t\t}\n\t\tfor i := 0; i+1 < len(e.Content); i += 2 {\n\t\t\tval := e.Content[i+1]\n\t\t\tif val.Kind != yaml.ScalarNode {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tswitch e.Content[i].Value {\n\t\t\tcase \"file\", \"severity\", \"message\":\n\t\t\t\tif val.Tag != \"!!str\" {\n\t\t\t\t\treturn false\n\t\t\t\t}\n\t\t\tcase \"line\":\n\t\t\t\tif val.Tag != \"!!int\" {\n\t\t\t\t\treturn false\n\t\t\t\t}\n\t\t\tcase \"blocking\":\n\t\t\t\tif val.Tag != \"!!bool\" {\n\t\t\t\t\treturn false\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn true\n}\n\n// checkTypes rejects scalars yaml.v3 would coerce: role, status, verdict and\n// worker must be strings, attempt an integer, next a list of strings.\nfunc checkTypes(front string) error {\n\tvar doc yaml.Node\n\tif err := yaml.Unmarshal([]byte(front), &doc); err != nil || len(doc.Content) == 0 {\n\t\treturn malformed(\"frontmatter: unreadable\")\n\t}\n\tm := doc.Content[0]\n\tif m.Kind != yaml.MappingNode {\n\t\treturn malformed(\"frontmatter is not a mapping\")\n\t}\n\tfor i := 0; i+1 < len(m.Content); i += 2 {\n\t\tkey, v := m.Content[i].Value, m.Content[i+1]\n\t\tok := true\n\t\tswitch key {\n\t\tcase \"role\", \"status\", \"verdict\", \"worker\":\n\t\t\tok = v.Kind == yaml.ScalarNode && v.Tag == \"!!str\"\n\t\tcase \"attempt\":\n\t\t\tok = v.Kind == yaml.ScalarNode && v.Tag == \"!!int\"\n\t\tcase \"findings\":\n\t\t\tok = findingsTypes(v)\n\t\tcase \"next\":\n\t\t\tok = v.Kind == yaml.SequenceNode\n\t\t\tfor _, e := range v.Content {\n\t\t\t\tif e.Kind != yaml.ScalarNode || e.Tag != \"!!str\" {\n\t\t\t\t\tok = false\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif !ok {\n\t\t\treturn malformed(\"field %s: wrong type\", key)\n\t\t}\n\t}\n\treturn nil\n}\n","numLines":391,"startLine":1,"totalLines":391}},"tool_result_meta":[{"id":"toolu_01FnfjmMwaSXz16ibtau6r6a","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
