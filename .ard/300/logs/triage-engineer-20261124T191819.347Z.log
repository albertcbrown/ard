dable bool      // the redacted role file no longer parses\ninternal/closeout/prepare.go:155:\t\t\t\tif crf, perr := Parse(res.Clean); perr == nil {\ninternal/closeout/prepare.go:156:\t\t\t\t\tsummary, findings = crf.Summary, crf.Findings\ninternal/closeout/prepare.go:232:\t\tplan = needsHumanPlan(j, rf.Status, \"findings unreadable after redaction\")\ninternal/closeout/prepare.go:241:\t\tplan.Summary = summary\ninternal/closeout/prepare.go:258:\t\t// the log tail (already redacted, re-scanned and capped).\ninternal/closeout/prepare.go:284:func ruleList(fs []redact.Finding) string {\ninternal/closeout/prepare.go:309:\trf, err := Parse(b)\ninternal/closeout/prepare.go:399:// prepareLog redacts the host log. It returns nil (and a reason) when the log\ninternal/closeout/prepare.go:401:// of the redacted log, or \"\" when it is withheld or fails a second scan.\ninternal/closeout/prepare.go:403:\tcp, err := redact.CommitPath(issue, j.LogPath)\ninternal/closeout/prepare.go:407:\tdst := filepath.Join(stage, \".redacted.log\")\ninternal/closeout/prepare.go:412:\t\treturn nil, \"\", \"redaction could not complete\", nil\ninternal/closeout/prepare.go:429:// cleanTail cuts the last lines of an already redacted log and scans the cut\ninternal/closeout/prepare.go:475:// cleanReason redacts a reason that may quote the agent's text.\ninternal/roles/worker_engineer_test.go:22:\t\tWorker: &closeout.WorkerResult{PR: 12, Tests: closeout.TestsPassed}}\ninternal/closeout/prepare_allow_test.go:177:\t\t\t\tj.PR, j.Worker = 5, &WorkerResult{PR: 5, Tests: TestsNone}\ninternal/closeout/closer_test.go:123:\tj.Worker = &WorkerResult{PR: e.pr, Tests: TestsPassed}\ninternal/closeout/prepare_test.go:309:\t\t\t\tj.PR, j.Worker = 5, &WorkerResult{PR: 5, Tests: TestsNone}\ninternal/closeout/prepare_test.go:353:\t\t\tj.PR, j.Worker = 5, &WorkerResult{PR: 5, Tests: TestsNone}\ninternal/closeout/plan_test.go:40:\t\tWorker: &WorkerResult{PR: 9, Tests: TestsPassed}}\ninternal/closeout/worker_test.go:34:\t\t{\"hold\", with(&WorkerResult{Hold: \"diff guard: x\"}, 9), done, OutcomeNeedsHuman, []string{\"7:ard:needs-human\"}, []string{\"7:ard:worker:engineer:running\"}, nil, 0, \"diff guard: x\"},\ninternal/closeout/worker_test.go:35:\t\t{\"no PR\", with(&WorkerResult{Tests: TestsPassed}, 0), done, OutcomeNeedsHuman, []string{\"7:ard:needs-human\"}, []string{\"7:ard:worker:engineer:running\"}, nil, 0, \"without a pull request\"},\ninternal/closeout/worker_test.go:36:\t\t{\"needs-human status\", with(&WorkerResult{Tests: TestsPassed}, 9), RoleFile{Status: \"needs-human\"}, OutcomeNeedsHuman, []string{\"7:ard:needs-human\"}, []string{\"7:ard:worker:engineer:running\"}, nil, 0, \"\"},\ninternal/closeout/worker_test.go:37:\t\t{\"tests passed: reviewers then next, no duplicates\", with(&WorkerResult{Tests: TestsPassed, Reviewers: []string{\"eng-review\", \"security-review\", \"ghost\"}}, 9), done,\nc332d77 feat: Default ard-agent image and role image builds, part 55b: d… (#351)\n626b2bf feat: Install ard with Homebrew, part A: GoReleaser config and r… (#306) (#341)\neb6d533 ard(triage:lead): #299 Adds one fixed line to every triage job's user message that lists each… [skip ci]\ndocs/proposal.md:160:**One committer for main.** Close-outs never push. They hand a file set to the controller's committer, which keeps its own clean worktree of `main`, commits as `ard[bot]` with `ard(<stage>:<role>): #<issue> <summary> [skip ci]`, re-applies its snapshot on the fetched head, pushes with a lease, and retries up to 3 times (re-applying the whole-file snapshot is the rebase; if upstream changed one of its paths the request fails with a conflict instead of overwriting). A replay of an unchanged tree is a no-op that returns the upstream head. It refuses any change outside the `.ard/<issue#>/` directories. Worker code takes a separate lane: `Branches.CommitCode` commits only paths `committer.CheckCodePath` accepts (nothing under `.ard/`, `.ard-input/` or `.github/`, no `.git` or secret-shaped names), only to `worker/` branches, creating a branch with a push whose lease expects it to be absent and refusing to overwrite a path that changed on the branch since the job started. The one other lane is `ard init --pr`'s (local mode writes only the working tree, #303): it commits only `.ard/config.yaml`, `.ard/ard-init.lock` and files under the four role trees, only to the new branch `ard-init` cut from `main`, with a push whose lease expects the ref to be absent, so it creates the branch and never updates an existing one, and opens a PR; a human merges it with a squash or merge commit, so the bot-commit check never sees a bot commit outside `.ard/<issue#>/` on main's first-parent history. Because the bot must bypass branch protection on `main`, a detective check audits it: the workflow `.github/workflows/bot-commits.yml` walks the first-parent history of `main` (the last 500 commits, or everything after the repository variable `ARD_BOT_CHECK_SINCE`) and fails the run, listing the commits and paths in the job summary, when a commit made by the bot changes anything but regular files under a single `.ard/<issue#>/` directory. Bot commits are identified by **committer** (the App's noreply email or login), not author, because a squash merge of a bot PR has the bot as author. If the 500-commit window is full and its oldest commit is the bot's, the check fails closed until `ARD_BOT_CHECK_SINCE` is set, so a bad commit cannot be flushed out of view. It runs hourly as well as on push, because `[skip ci]` suppresses the push trigger. It fails closed when the `ARD_BOT_LOGIN` repository variable is unset. It reads both variables from repository settings and lives in `.github/workflows/`, which the App cannot write. Alerting is the failed run only; it does not open issues or pause ard.\ndocs/proposal.md:234:**The trufflehog-history scanner** (`scanners/trufflehog-history`) runs `trufflehog git file://$ARD_HISTORY --bare` with the same flags plus no `--since-commit`, `--max-depth` or `--branch`, over every fetched ref, with the same hash salt, so a value has the same fingerprint as at HEAD. A scanner role asks for history by holding an empty file named `history` in its directory (`Role.ReadsHistory`; there is no config key, so an override cannot grant it). The executor then sets `Job.History` (scanner stage only) and mounts the controller's bare clone read-only at `/history` in Docker (host mode uses the clone path) and sets `ARD_HISTORY`. The mount includes unmerged PR branches. Commit, author and timestamp are dropped; only the detector, file, line and hash leave the scan. It never autocloses, because history does not go away. A Kubernetes executor must provide a read-only copy at the same place.\ndocs/proposal.md:279:**Sidecar repos are context, read-only.** A role's sidecar (for example `vpe-specs`) is cloned by the executor, not the loop: the loop passes the role's resolved sidecar (repo and ref) on the job. The executor keeps one shallow (depth 1) bare object cache per sidecar repo at `~/.ard/sidecars/<controlled-owner>/<controlled-repo>/<sidecar-owner>/<sidecar-repo>.git`, shared by every job of that controlled repo, and exports the commit into the job home as `<job home>/sidecar` (plain files: no `.git`, `chmod -R a-w` in both modes, and a `:ro` mount under Docker). The job sees it at `$ARD_SIDECAR`. `ref` is a branch, tag or full 40-character SHA (an abbreviated SHA is a config error). A SHA already in the cache needs no network; a branch or tag is re-fetched (depth 1) for every job. Whatever the ref, `Prepare` resolves it to a full commit SHA and records it on the job's handle (and in the `executor.sidecar_ready` log), so a job is reproducible. Symlinks and submodules in the sidecar are rejected and the tree is capped at 64 MiB, like config snapshots. A fetch failure (network, auth, a stale lock, which the executor clears by rebuilding the cache once) is the transient `clone_failed`; a ref or SHA that does not exist, or a repo the App cannot read, is a permanent failure that names the sidecar. A role that wants a spec changed says so in `plan.md`; editing the sidecar is out of scope for v1.\ndocs/proposal.md:326:2. **Branch** `worker/<role>-<issue#>-<slug>` from `origin/main`. The slug is the issue title lowercased, every run of other characters turned into one `-`, at most 40 ASCII characters, `issue` when nothing is left. The title can change between rounds, so the loop looks the branch up with `git ls-remote` on `worker/<role>-<issue#>-*`: one match is reused (and fetched), none is created on the first push, and more than one (only a human can make the second) posts once and adds `ard:needs-human` without claiming. Worker role names may not contain an all-digit segment (`eng-12`), so `worker/<role>-<issue#>-` names exactly one role and issue.\ndocs/proposal.md:419:**Shared roles.** `roles_repo: {repo: <owner>/<name>, ref: <ref>}` in `.ard/config.yaml` loads role directories from another repository, so several repositories can reuse one role set. It is pinned like a sidecar: `ref` defaults to the shared repository's default branch (its remote HEAD, so `master` works too) and may be a branch, a tag or a full commit SHA. The controller fetches the ref shallowly, merges the shared repository's `.ard/scanners`, `triage`, `workers` and `reviewers` directories into the config snapshot, and a directory of the same kind and name in this repository wins whole, never file by file. `overrides` apply to shared roles too. `ard serve` re-reads the key with the rest of the config. If the shared repository cannot be fetched, or a shared role is invalid, the config fails to load and the controller counts as paused. Trust: the key lives in `.ard/config.yaml`, a protected path, but a branch or tag in the shared repository can change the prompts agents run without a PR here, so pin a full commit SHA.\ndocs/proposal.md:482:**Where `ard serve` reads config (decided, #87).** After each fetch into its own clone (`~/.ard/repos/<owner>/<repo>.git`, see Local-executor details) `ard serve` resolves `origin/main` to a SHA and reads `config.yaml` and the role directories from that commit, not from the working tree. It exports them into a snapshot at `~/.ard/config/<owner>/<repo>/<sha>/`, kept 24 hours after a newer SHA replaces it, because roles run from a host path: a role directory, its `Dockerfile` and the scan worktree must all describe the one commit the tick's jobs use. Editing the host's working tree therefore changes nothing on a running controller, with one exception: a local `paused: true` is honoured (see the kill switch), and only that key is read locally. A merged change applies on the next tick without a pull. Symlinks and submodules under the role directories are rejected, and a config that cannot be fetched or does not validate counts as paused. If `origin/main` cannot be loaded at startup, `ard serve` starts paused instead of exiting, posts the load error to the status issue once per distinct error, and retries every tick; no loop runs until a config has loaded. `ard config check` validates the working tree, for authoring; `ard config check --ref <ref>` validates a commit of the local checkout (for example `--ref origin/main` after `git fetch`) without fetching.\ninternal/servecmd/serve.go:350:\t// RemoteURL is where main is fetched from and pushed to.\ninternal/reviewer/branch.go:14:// localRef is where a PR's head branch is fetched to in the controller's\ninternal/reviewer/ready.go:68:\tvar fetched bool\ninternal/reviewer/ready.go:78:\t\tif !fetched {","is_error":false}]},"parent_tool_use_id":null,"session_id":"fe75d909-a730-40c7-a147-43d1c2a12ca1","uuid":"73e3fd77-edf7-42ba-b7a8-296a8f473a23","timestamp":"2026-11-24T19:18:31.094Z","tool_use_result":{"stdout":"internal/worker/loop.go:24:\t\"github.com/albertcbrown/ard/internal/redact\"\ninternal/worker/loop.go:119:\tSecrets func() *redact.Secrets\ninternal/worker/loop.go:120:\tScanner redact.Scanner 