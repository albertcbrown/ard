   e(map[string]string{\"path\": \"a/../b\"}, \"\"),\n405\t+\t\t\"path backslash\":  e(map[string]string{\"path\": `\"a\\\\b\"`}, \"\"),\n406\t+\t\t\"path empty\":      e(map[string]string{\"path\": `\"\"`}, \"\"),\n407\t+\t\t\"path backtick\":   e(map[string]string{\"path\": \"\\\"a`b\\\"\"}, \"\"),\n408\t+\t\t\"path newline\":    e(map[string]string{\"path\": `\"a\\nb\"`}, \"\"),\n409\t+\t\t\"path angle\":      e(map[string]string{\"path\": `\"a<b>\"`}, \"\"),\n410\t+\t\t\"unknown key\":     e(o, \"\") + \"    extra: x\\n\",\n411\t+\t\t\"not a list\":      \"  url: https://example.com/a\\n\",\n412\t+\t\t\"entry not a map\": \"  - just text\\n\",\n413\t+\t}\n414\t+\tfor name, ent := range bad {\n415\t+\t\t_, err := Parse(fetchedDoc(ent))\n416\t+\t\tif !errors.Is(err, ErrMalformed) {\n417\t+\t\t\tt.Errorf(\"%s: err = %v, want ErrMalformed\", name, err)\n418\t+\t\t}\n419\t+\t}\n420\t+\tif _, err := Parse(fetchedDoc(e(o, \"\") + e(map[string]string{\"status\": \"99\"}, \"\"))); err == nil || !strings.Contains(err.Error(), \"fetched 2\") {\n421\t+\t\tt.Errorf(\"message must name the entry: %v\", err)\n422\t+\t}\n423\t+}\n424\t+\n425\t+func TestCheckFetchedStage(t *testing.T) {\n426\t+\trf := RoleFile{Role: \"r\", Fetched: []Fetched{{}}}\n427\t+\tfor stage, ok := range map[string]bool{StageWorker: true, StageReview: false, StageTriage: false} {\n428\t+\t\terr := rf.check(Job{Role: \"r\", Stage: stage})\n429\t+\t\tif stage == StageReview && err != nil && !errors.Is(err, ErrMalformed) {\n430\t+\t\t\tt.Errorf(\"%s: %v\", stage, err)\n431\t+\t\t}\n432\t+\t\tif ok && err != nil {\n433\t+\t\t\tt.Errorf(\"%s: %v\", stage, err)\n434\t+\t\t}\n435\t+\t\tif !ok && !errors.Is(err, ErrMalformed) {\n436\t+\t\t\tt.Errorf(\"%s: err = %v, want malformed\", stage, err)\n437\t+\t\t}\n438\t+\t}\n439\t+}\n440\tdiff --git a/internal/closeout/worker.go b/internal/closeout/worker.go\n441\tindex 893a2ba..a5bd26e 100644\n442\t--- a/internal/closeout/worker.go\n443\t+++ b/internal/closeout/worker