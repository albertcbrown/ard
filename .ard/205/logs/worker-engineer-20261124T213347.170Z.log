RemoteURL, spec, d.Token); err != nil {\n\t\treturn p, \"fetch\", err\n\t}\n\tif p.tip, err = d.Git.RevParse(ctx, d.RepoDir, localRef(c.pr.Number)); err != nil {\n\t\treturn p, \"rev_parse\", err\n\t}\n\tif p.tip != c.pr.HeadSHA {\n\t\treturn p, \"head_moved\", fmt.Errorf(\"branch is at %.12s, the PR head was %.12s\", p.tip, c.pr.HeadSHA)\n\t}\n\tif p.base, err = d.Git.MergeBase(ctx, d.RepoDir, cfg.SHA, p.tip); err != nil {\n\t\treturn p, \"merge_base\", err\n\t}\n\tif p.patch, p.truncated, err = d.Git.Diff(ctx, d.RepoDir, p.base, p.tip, maxDiffBytes, issueDir(c.issue.Number)); err != nil {\n\t\treturn p, \"diff\", err\n\t}\n\tif p.added, err = d.Git.AddedLinesBetween(ctx, d.RepoDir, p.base, p.tip, issueDir(c.issue.Number)); err != nil {\n\t\treturn p, \"added_lines\", err\n\t}\n\treturn p, \"\", nil\n}\n\n// run claims one granted candidate and watches the job to the end, following\n// the contract in package reaper. It runs in an Inflight goroutine and holds\n// the pool slot until FinishWith has returned.\nfunc (l *Loop) run(ctx context.Context, env controller.Env, cfg *config.Resolved, c candidate, slot *pool.Slot) {\n\tdefer slot.Release()\n\td := l.d\n\tn, pr, role := c.issue.Number, c.pr.Number, c.role\n\tlog := d.Log\n\tif env.Log != nil {\n\t\tlog = env.Log\n\t}\n\tlog = log.With(\"pr\", pr, \"issue\", n, \"role\", role.Name)\n\n\t// 1. The pin and the inputs. Nothing is claimed yet.\n\tp, step, err := l.pin(ctx, cfg, c)\n\tif err != nil {\n\t\tif step == \"head_moved\" {\n\t\t\tlog.Info(\"review.head_moved\", \"detail\", err.Error())\n\t\t} else {\n\t\t\tlog.Error(\"review.claim_failed\", \"step\", step, \"error\", err)\n\t\t}\n\t\treturn\n\t}\n\tcomments, err := d.Reader.ListComments(ctx, n, time.Time{})\n\tif err != nil {\n\t\tlog.Error(\"review.claim_failed\", \"step\", \"list_comments\", \"error\", err)\n\t\treturn\n\t}\n\tdir := agentjob.InputDir(n)\n\tinputs := []executor.File{\n\t\t{Path: dir + \"/diff.patch\", Data: diffInput(pr, c.pr.HeadRef, p.base, p.tip, p.patch, p.truncated)},\n\t\t{Path: dir + \"/issue.md\", Data: agentjob.Snapshot(c.issue)},\n\t\t{Path: dir + \"/comments.md\", Data: agentjob.Comments(comments)},\n\t}\n\t// The committed .ard/<n> holds the plan and the earlier role files and logs.\n\tuntrusted := []string{dir + \"/diff.patch\", dir + \"/issue.md\", dir + \"/comments.md\", fmt.Sprintf(\".ard/%d\", n)}\n\t// A later round also gets the role's report from the round before, read at\n\t// the pinned head, which holds that review's close-out commit.\n\tif b, ok, err := d.Git.FileAt(ctx, d.RepoDir, p.tip, fmt.Sprintf(\".ard/%d/review-%s.md\", n, role.Name), closeout.MaxRoleFileBytes); err != nil {\n\t\tlog.Warn(\"review.previous_review_failed\", \"error\", err)\n\t} else if ok {\n\t\tpath := dir + \"/previous-review.md\"\n\t\tprev := string(b)\n\t\tif len(prev) > 64<<10 {\n\t\t\tprev = strings.ToValidUTF8(prev[:64<<10], \"\") + \"\\n[truncated]\\n\"\n\t\t}\n\t\tbody := agentjob.UntrustedHeader + \"Your report from the previous review round on this pull request:\\n\\n\" + prev\n\t\tinputs = append(inputs, executor.File{Path: path, Data: []byte(body)})\n\t\tuntrusted = append(untrusted, path)\n\t}\n\n\t// 2. The claim record.\n\tdata, _ := json.Marshal(map[string]string{\"head\": p.tip, \"base\": p.base})\n\tsj, err := d.Store.CreateJob(ctx, state.NewJob{Stage: stageReview, Role: role.Name, Issue: n, PR: pr, Branch: c.pr.HeadRef, Data: data})\n\tif err != nil {\n\t\tif errors.Is(err, state.ErrConflict) {\n\t\t\treturn\n\t\t}\n\t\tlog.Error(\"review.claim_failed\", \"step\", \"create_job\", \"error\", err)\n\t\treturn\n\t}\n\tslot.SetJobID(sj.ID)\n\tlog = log.With(\"job\", sj.ID)\n\n\t// 3. The running label, on the PR. If it fails nothing has started.\n\trunning := labels.Running(labels.StageReview, role.Name)\n\tif err := d.Effects.AddLabels(ctx, pr, running); err != nil {\n\t\tbg := context.WithoutCancel(ctx)\n\t\tif rerr := d.Effects.RemoveLabel(bg, pr, running); rerr != nil {\n\t\t\tlog.Warn(\"review.unlabel_failed\", \"error\", rerr)\n\t\t}\n\t\tlog.Error(\"review.claim_failed\", \"step\", \"add_running_label\", \"error\", err)\n\t\tif ferr := d.Store.Fail(bg, sj.ID, \"claim: add running label failed\", d.Now()); ferr != nil {\n\t\t\tlog.Error(\"review.fail_record_failed\", \"error\", ferr)\n\t\t}\n\t\treturn\n\t}\n\tlog.Info(\"review.claim\", \"head\", p.tip)\n\n\trc := &closeout.ReviewContext{MergeBase: p.base, Added: p.added}\n\tfinish := func(h executor.Handle, st executor.Status, res agent.Result, cause closeout.Cause) {\n\t\tout, err := d.Finisher.FinishWith(ctx, sj.ID, h, st, res, reaper.FinishOptions{Cause: cause, Review: rc})\n\t\tif err != nil {\n\t\t\t// ErrBusy or any other error leaves a resumable close-out for the Reaper.\n\t\t\tlog.Error(\"review.closeout_failed\", \"error\", err)\n\t\t\treturn\n\t\t}\n\t\tlog.Info(\"review.closeout\", \"outcome\", string(out))\n\t}\n\tcause := func(kind closeout.CauseKind, detail string, retry bool) closeout.Cause {\n\t\treturn reaper.NewCause(sj, kind, detail, retry)\n\t}\n\n\t// 4. Start. Exactly one attempt.\n\tif _, err := d.Store.StartAttempt(ctx, sj.ID); err != nil {\n\t\tlog.Error(\"review.start_failed\", \"step\", \"start_attempt\", \"error\", err)\n\t\tfinish(executor.Handle{}, executor.Status{}, agent.Result{}, cause(closeout.CauseNoProcess, \"could not start the job\", false))\n\t\treturn\n\t}\n\tej := agentjob.ExecJob(cfg, role, executor.Job{\n\t\tID: sj.ID, Repo: d.Repo.String(), Issue: n, Stage: stageReview, Role: role.Name,\n\t\tRepoDir: d.RepoDir, Ref: p.tip, Inputs: inputs,\n\t\tScrub: []string{agent.RoleFilePath(n, stageReview, role.Name)},\n\t})\n\th, err := d.Executor.Prepare(ctx, ej)\n\tif err != nil {\n\t\tlog.Error(\"review.prepare_failed\", \"error\", err)\n\t\tif errors.Is(err, executor.ErrClone) {\n\t\t\tfinish(executor.Handle{}, executor.Status{}, agent.Result{}, cause(closeout.CauseCloneFail, \"could not clone the repository\", true))\n\t\t} else {\n\t\t\tfinish(executor.Handle{}, executor.Status{}, agent.Result{}, cause(closeout.CauseNoProcess, \"could not prepare the job\", false))\n\t\t}\n\t\treturn\n\t}\n\tagentjob.SaveHandle(ctx, d.Store, log, sj.ID, h)\n\tcmd, err := agentjob.AgentCommand(d.Agents, cfg, role, agent.StageReview, n, 0, untrusted, h, d.Model)\n\tif err != nil {\n\t\tlog.Error(\"review.command_failed\", \"error\", err)\n\t\tfinish(h, executor.Status{}, agent.Result{}, cause(closeout.CauseNoProcess, \"could not start the agent\", false))\n\t\treturn\n\t}\n\tif h, err = d.Executor.Start(ctx, h, cmd); err != nil {\n\t\tlog.Error(\"review.start_failed\", \"step\", \"start\", \"error\", err)\n\t\tfinish(h, executor.Status{}, agent.Result{}, cause(closeout.CauseNoProcess, \"could not start the agent\", false))\n\t\treturn\n\t}\n\tagentjob.SaveHandle(ctx, d.Store, log, sj.ID, h)\n\n\t// 5. Wait. Shutdown leaves the agent running: after a restart pool\n\t// adoption and the Reaper own the job.\n\tst, err := agentjob.Wait(ctx, d.Executor, h, d.Poll, env.Stopping)\n\tif err != nil {\n\t\tlog.Warn(\"review.watch_ended\", \"error\", err)\n\t\treturn\n\t}\n\tvar res agent.Result\n\tif d.Parse != nil {\n\t\tvar perr error\n\t\tif res, perr = d.Parse(ctx, cfg, sj, h, st.ExitCode); perr != nil {\n\t\t\tlog.Warn(\"review.parse_failed\", \"error\", perr)\n\t\t}\n\t}\n\trc.HeadMoved = l.headMoved(ctx, log, c, n, p.tip)\n\tfinish(h, st, res, closeout.Cause{})\n\t// Errors are logged inside maybeReady: close-out is never failed by it.\n\tt := &tick{l: l, cfg: cfg, log: log, self: c.pr.Author, dry: d.Effects.DryRun()}\n\tt.maybeReady(ctx, pr)\n}\n\n// issueDir is the only part of .ard/ the reviewer's diff and head check leave\n// out: close-out commits land there. Edits to .ard/config.yaml, role\n// directories or another issue's directory stay visible.\nfunc issueDir(n int) string { return fmt.Sprintf(\".ard/%d/\", n) }\n\n// headMoved reports whether the PR's branch gained code (anything outside\n// .ard/) since the commit the review pinned. Commits that only add .ard/ files\n// (another reviewer's close-out) do not count. When the branch cannot be read\n// the answer is yes: the review then runs again rather than pass a head it\n// may not cover.\nfunc (l *Loop) headMoved(ctx context.Context, log *slog.Logger, c candidate, n int, tip string) bool {\n\td := l.d\n\tspec := \"+refs/heads/\" + c.pr.HeadRef + \":\" + localRef(c.pr.Number)\n\tif err := d.Git.FetchRef(ctx, d.RepoDir, d.RemoteURL, spec, d.Token); err != nil {\n\t\tlog.Warn(\"review.head_check_failed\", \"step\", \"fetch\", \"error\", err)\n\t\treturn true\n\t}\n\tnow, err := d.Git.RevParse(ctx, d.RepoDir, localRef(c.pr.Number))\n\tif err != nil {\n\t\tlog.Warn(\"review.head_check_failed\", \"step\", \"rev_parse\", \"error\", err)\n\t\treturn true\n\t}\n\tif now == tip {\n\t\treturn false\n\t}\n\tchanged, err := d.Git.CodeChanged(ctx, d.RepoDir, tip, now, issueDir(n))\n\tif err != nil {\n\t\tlog.Warn(\"review.head_check_failed\", \"step\", \"diff\", \"error\", err)\n\t\treturn true\n\t}\n\tif len(changed) > 0 {\n\t\tlog.Warn(\"review.head_moved_during_review\", \"from\", tip, \"to\", now, \"files\", len(changed))\n\t\treturn true\n\t}\n\treturn false\n}\npackage closeout\n\nimport (\n\t\"fmt\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n)\n\nconst (\n\tmaxInlineRunes   = 2000\n\tmaxBulletRunes   = 300\n\tmaxReviewRunes   = 60000\n\treviewFooterRoom = 2000 // runes kept free for the closing lines\n)\n\n// Review modes: how the review reached GitHub.\nconst (\n\tReviewInline  = \"inline\"  // one PR review with inline comments\n\tReviewBody    = \"body\"    // a PR review with every finding in its body\n\tReviewComment = \"comment\" // a plain PR comment (GitHub took no review)\n\tReviewFound   = \"found\"   // an earlier post was found; nothing was posted\n)\n\n// ReviewContext is what the reviewer loop knows that the role file cannot say.\n// Added is used by Prepare only and is not persisted: the plan keeps the\n// decided placement.\ntype ReviewContext struct {\n\t// MergeBase is the commit the diff was taken against.\n\tMergeBase string\n\t// Added is, per path, the head-side line ranges the PR added.\n\tAdded map[string][]gitx.LineRange `json:\"-\"`\n\t// HeadMoved is set when the PR gained code (anything outside .ard/) after\n\t// the commit the review pinned. An approve is then not a pass: the review\n\t// is posted but no label says done, so the request stays and runs again.\n\tHeadMoved bool\n}\n\n// ReviewPlan is the PR review close-out posts for a review job that reached a\n// verdict.\ntype ReviewPlan struct {\n\tCommitSHA string // the pinned commit the agent reviewed\n\tVerdict   string // after any downgrade\n\t// Downgraded: the role file said approve but carried a blocking finding.\n\tDowngraded bool\n\tHeadMoved  bool\n\tInline     []Finding // on lines the PR added: posted as inline comments\n\tOther      []Finding // everything else: listed in the review body\n\t// NoLines: the added lines were not known (a Reaper close-out after a\n\t// restart), so every finding is in Other.\n\tNoLines bool\n\t// PRGone is set (merged, closed or branch gone) when the PR was gone at\n\t// close-out: nothing was committed and the job is stale.\n\tPRGone string `json:\",omitempty\"`\n}\n\n// reviewPlan splits the findings of a review by whether their line is one the\n// PR added.\nfunc reviewPlan(j Job, verdict string, downgraded bool, fs []Finding) *ReviewPlan {\n\trp := &ReviewPlan{CommitSHA: j.BaseSHA, Verdict: verdict, Downgraded: downgraded}\n\tif j.Review == nil {\n\t\trp.NoLines, rp.HeadMoved = true, true\n\t\trp.Other = append(rp.Other, fs...)\n\t\treturn rp\n\t}\n\trp.HeadMoved = j.Review.HeadMoved\n\tfor _, f := range fs {\n\t\tif f.Line > 0 && inRanges(f.Line, j.Review.Added[f.File]) {\n\t\t\trp.Inline = append(rp.Inline, f)\n\t\t} else {\n\t\t\trp.Other = append(rp.Other, f)\n\t\t}\n\t}\n\treturn rp\n}\n\nfunc inRanges(line int, rs []gitx.LineRange) bool {\n\tfor _, r := range rs {\n\t\tif line >= r.From && line <= r.To {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc findingTag(f Finding) string {\n\tb := \"non-blocking\"\n\tif f.Blocking {\n\t\tb = \"blocking\"\n\t}\n\treturn fmt.Sprintf(\"**%s · %s**\", f.Severity, b)\n}\n\n// inlineBody is the text of one inline comment.\nfunc inlineBody(f Finding) string {\n\treturn findingTag(f) + \"\\n\\n\" + sanitize(cutRunes(f.Message, maxInlineRunes))\n}\n\nfunc cutRunes(s string, n int) string {\n\tif r := []rune(s); len(r) > n {\n\t\treturn string(r[:n-1]) + \"…\"\n\t}\n\treturn s\n}\n\nfunc bullet(f Finding) string {\n\tloc := f.File\n\tif f.Line > 0 {\n\t\tloc = fmt.Sprintf(\"%s:%d\", f.File, f.Line)\n\t}\n\tfirst := strings.TrimSpace(strings.SplitN(strings.TrimSpace(f.Message), \"\\n\", 2)[0])\n\treturn fmt.Sprintf(\"- %s %s %s\", findingTag(f), codeSpan(loc, 340), sanitize(cutRunes(first, maxBulletRunes)))\n}\n\n// inlineComments builds the inline comments of a review plan.\nfunc inlineComments(rp *ReviewPlan) []github.InlineComment {\n\tout := make([]github.InlineComment, 0, len(rp.Inline))\n\tfor _, f := range rp.Inline {\n\t\tout = append(out, github.InlineComment{Path: f.File, Line: f.Line, Side: \"RIGHT\", Body: inlineBody(f)})\n\t}\n\treturn out\n}\n\n// RenderReview builds the body of the PR review (or of the plain comment that\n// replaces it). With allInBody every finding is listed in the body, for the\n// fallbacks that carry no inline comments. The body is at most 60,000 runes.\nfunc RenderReview(r Record, repo github.Repo, dryRun, allInBody bool) string {\n\tj, p := r.Job, r.Plan\n\trp := p.Review\n\tvar b strings.Builder\n\tb.WriteString(marker(j.ID, j.Attempt) + \"\\n\")\n\tfmt.Fprintf(&b, \"**ard · review:%s · %s**\\n\", j.Role, rp.Verdict)\n\tif s := strings.TrimSpace(p.Summary); s != \"\" {\n\t\tb.WriteString(\"\\n\" + sanitize(cutSummary(s)) + \"\\n\")\n\t}\n\tvar notes []string\n\tif rp.Downgraded {\n\t\tnotes = append(notes, \"The review approved but listed a blocking finding, so ard treats it as changes requested.\")\n\t}\n\tif rp.HeadMoved && rp.PRGone == \"\" {\n\t\tnotes = append(notes, \"The branch gained code after this commit was reviewed. The review stays requested and runs again on the new head.\")\n\t}\n\tif rp.PRGone != \"\" {\n\t\tnotes = append(notes, \"The pull request was merged or closed before this review finished, so nothing was committed and the job is recorded as stale.\")\n\t}\n\tif len(notes) > 0 {\n\t\tb.WriteString(\"\\n\" + strings.Join(notes, \"\\n\") + \"\\n\")\n\t}\n\tlist, heading := rp.Other, \"Findings outside the changed lines:\"\n\tswitch {\n\tcase allInBody:\n\t\tlist = append(append([]Finding(nil), rp.Inline...), rp.Other...)\n\t\theading = \"Findings:\"\n\tcase rp.NoLines:\n\t\theading = \"Findings (line placement unavailable):\"\n\t}\n\tif len(list) > 0 {\n\t\tb.WriteString(\"\\n\" + heading + \"\\n\")\n\t\tused := len([]rune(b.String()))\n\t\tfor i, f := range list {\n\t\t\tline := bullet(f)\n\t\t\tif used+len([]rune(line))+1 > maxReviewRunes-reviewFooterRoom {\n\t\t\t\tfmt.Fprintf(&b, \"- … and %d more in the committed file\\n\", len(list)-i)\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tb.WriteString(line + \"\\n\")\n\t\t\tused += len([]rune(line)) + 1\n\t\t}\n\t}\n\tvar lines []string\n\tif sha := rp.CommitSHA; sha != \"\" {\n\t\tif len(sha) > 12 {\n\t\t\tsha = sha[:12]\n\t\t}\n\t\tlines = append(lines, fmt.Sprintf(\"Reviewed commit `%s`\", sha))\n\t}\n\tif out := outputLine(r, repo, dryRun); out != \"\" {\n\t\tlines = append(lines, out)\n\t}\n\tif len(lines) > 0 {\n\t\tb.WriteString(\"\\n\" + strings.Join(lines, \"\\n\") + \"\\n\")\n\t}\n\treturn b.String()\n}\n\n\tpromptInfo, hasPrompt := files[\"prompt.txt\"]\n\tscanInfo, hasScan := files[\"scan\"]\n\tif _, hasDockerfile := files[\"Dockerfile\"]; hasDockerfile {\n\t\trole.Dockerfile = dir + \"/Dockerfile\"\n\t\tdelete(extras, \"Dockerfile\")\n\t}\n\n\tswitch kind {\n\tcase Kind