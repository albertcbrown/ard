d when no path outside `.ard/<issue#>/` changed since the reviewed commit, or, for the merger, when every such path came from `main` (an update-branch merge does not invalidate a review, but a path both the PR and `main` changed since the review does). A review made stale by code that changed since it is re-requested once per head: the merger removes `ard:review:<role>:done` (the reviewer then claims the role again at the current head), records a `review_rerequest` event for that PR and head, and logs `merge.review_rerequested`. A head that moved only by an update-branch merge from `main` is still covered and triggers nothing. Under dry-run it logs `merge.would_rerequest` and writes only to the ledger, with no event\n - it carries none of `ard:hold`, `ard:needs-human`, `ard:tests:failed` or `ard:executor:failed`, its issue is open and carries neither `ard:hold` nor `ard:needs-human`, and no worker or review job of the issue is running\n - the first line of the PR body is exactly `Closes #<issue>` (what the worker writes; it is what closes the issue) and the state records a worker job of the issue on this branch (its id is the `Ard-Job` trailer). Otherwise the PR gets `ard:needs-human`\n-- GitHub has computed that the branch does not conflict with `main`. Only a computed `mergeable: false` or `mergeable_state: dirty` is a conflict: it gets `ard:needs-human` and one comment, and a follow-up to #41 will turn this into a rebase round (`reviewfix.RequestRound`) that counts toward `max_review_rounds`. A `mergeable` that is still null or unknown, and a 405 \"not mergeable\" from the merge call, mean GitHub is still computing: the merger retries next tick and never labels\n+- GitHub has computed that the branch does not conflict with `main`. Only a computed `mergeable: false` or `mergeable_state: dirty` is a conflict: it gets `ard:needs-human` and one comment, and, once the merger's `Rounds` dependency is wired (part B of #255; unset today), it becomes a conflict round (`reviewfix.RequestRound`) that counts toward `max_review_rounds`. A `mergeable` that is still null or unknown, and a 405 \"not mergeable\" from the merge call, mean GitHub is still computing: the merger retries next tick and never labels\n - the branch is up to date with `main`; if it is behind, the merger updates it and checks again next tick on the new head. \"Behind\" means `main` changed something **outside `.ard/<digits>/`** since the merge base: the committer pushes `.ard/<issue#>/` to `main` on every close-out, and counting those would keep every branch behind forever. A history with several merge bases (criss-cross merges) is skipped with a warning, because the choice would decide what counts as the PR's own change. GitHub's merge API guards the head SHA, not the base, so a push to `main` between the merger's fetch and the merge goes unseen\n - checks are green on the current head, read from check runs and commit statuses (the Statuses API, which Jenkins and other external CI report through; the App needs Commit statuses: read). A required context is satisfied by either a check run or a commit status of the same name; if both exist the newer wins, and red from either never counts as green. As on GitHub, a rule pinned to an `integration_id` is satisfied only by a status created by that App: the merger resolves the creator's `<slug>[bot]` login to an App id (`GET /apps/{slug}`, cached per process); a status from a user or another App does not count, and a lookup error means nothing merges that tick. A status `success` is green, `pending` waits, `failure` or `error` is red. A statuses read error (a missing permission included) means nothing merges that tick. The required list comes from GitHub's branch rules API for `main` (`GET /repos/{o}/{r}/rules/branches/main`, metadata read), with no copy in config:\n   - when the rules are readable and name required checks, each must be completed with `success`, `neutral` or `skipped` on the head (the latest run per name; a rerun in flight hides the old result), or have a latest commit status `success`. Missing or running checks wait; a red one (failure, cancelled, timed out, action required) gets `ard:needs-human` and one comment naming the checks, until #41 adds fix rounds\ndiff --git a/internal/gitx/gitx_test.go b/internal/gitx/gitx_test.go\nindex 8b85147..caf26e5 100644\n--- a/internal/gitx/gitx_test.go\n+++ b/internal/gitx/gitx_test.go\n@@ -496,3 +496,43 @@ func TestWorktreeAdminWithAutoGC(t *testing.T) {\n \t}\n \twg.Wait()\n }\n+\n+func TestIsAncestorAndParents(t *testing.T) {\n+\tctx := context.Background()\n+\tg := New(\"\")\n+\t_, clone := gittest.NewRemote(t)\n+\tcommit := func(name string) string {\n+\t\tif err := os.WriteFile(filepath.Join(clone, name), []byte(name), 0o644); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tgittest.Run(t, clone, \"add\", name)\n+\t\tgittest.Run(t, clone, \"commit\", \"-q\", \"-m\", name)\n+\t\treturn strings.TrimSpace(gittest.Run(t, clone, \"rev-parse\", \"HEAD\"))\n+\t}\n+\tbase := commit(\"a\")\n+\tgittest.Run(t, clone, \"checkout\", \"-q\", \"-b\", \"side\")\n+\tside := commit(\"b\")\n+\tgittest.Run(t, clone, \"checkout\", \"-q\", \"-\")\n+\tother := commit(\"c\")\n+\tgittest.Run(t, clone, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"merge\", \"side\")\n+\tmerge := strings.TrimSpace(gittest.Run(t, clone, \"rev-parse\", \"HEAD\"))\n+\tfor _, tc := range []struct {\n+\t\ta, b string\n+\t\twant bool\n+\t}{{base, side, true}, {side, side, true}, {side, other, false}, {side, merge, true}, {merge, side, false}} {\n+\t\tgot, err := g.IsAncestor(ctx, clone, tc.a, tc.b)\n+\t\tif err != nil || got != tc.want {\n+\t\t\tt.Errorf(\"IsAncestor(%.7s, %.7s) = %v, %v; want %v\", tc.a, tc.b, got, err, tc.want)\n+\t\t}\n+\t}\n+\tif _, err := g.IsAncestor(ctx, clone, \"nope\", side); err == nil {\n+\t\tt.Error(\"want error for an unknown commit\")\n+\t}\n+\tps, err := g.Parents(ctx, clone, merge)\n+\tif err != nil || len(ps) != 2 {\n+\t\tt.Errorf(\"merge parents = %v, %v\", ps, err)\n+\t}\n+\tif ps, err = g.Parents(ctx, clone, other); err != nil || len(ps) != 1 || ps[0] != base {\n+\t\tt.Errorf(\"parents = %v, %v\", ps, err)\n+\t}\n+}\ndiff --git a/internal/gitx/inspect.go b/internal/gitx/inspect.go\nindex 9ad7501..169ec23 100644\n--- a/internal/gitx/inspect.go\n+++ b/internal/gitx/inspect.go\n@@ -69,3 +69,29 @@ func (g *Git) MergeBase(ctx context.Context, repoDir, a, b string) (string, erro\n \t}\n \treturn strings.TrimSpace(out), nil\n }\n+\n+// IsAncestor reports whether commit a is an ancestor of (or equal to) b. Exit\n+// status 1 of git merge-base --is-ancestor is false, not an error.\n+func (g *Git) IsAncestor(ctx context.Context, repoDir, a, b string) (bool, error) {\n+\t_, _, err := g.run(ctx, repoDir, nil, \"\", nil, \"--git-dir=\"+gitDirOf(repoDir), \"merge-base\", \"--is-ancestor\", a, b)\n+\tif err == nil {\n+\t\treturn true, nil\n+\t}\n+\tif isExit(err, 1) {\n+\t\treturn false, nil\n+\t}\n+\treturn false, fmt.Errorf(\"gitx: merge-base --is-ancestor %s %s: %w\", a, b, err)\n+}\n+\n+// Parents returns the parent commits of rev: two or more for a merge.\n+func (g *Git) Parents(ctx context.Context, repoDir, rev string) ([]string, error) {\n+\tout, _, err := g.run(ctx, repoDir, nil, \"\", nil, \"--git-dir=\"+gitDirOf(repoDir), \"rev-list\", \"--parents\", \"-n\", \"1\", rev)\n+\tif err != nil {\n+\t\treturn nil, fmt.Errorf(\"gitx: parents of %s: %w\", rev, err)\n+\t}\n+\tf := strings.Fields(out)\n+\tif len(f) == 0 {\n+\t\treturn nil, nil\n+\t}\n+\treturn f[1:], nil\n+}\ndiff --git a/internal/merger/conflict_test.go b/internal/merger/conflict_test.go\nnew file mode 100644\nindex 0000000..c61ca52\n--- /dev/null\n+++ b/internal/merger/conflict_test.go\n@@ -0,0 +1,167 @@\n+package merger\n+\n+import (\n+\t\"context\"\n+\t\"encoding/json\"\n+\t\"strings\"\n+\t\"testing\"\n+\n+\t\"github.com/albertcbrown/ard/internal/config\"\n+\t\"github.com/albertcbrown/ard/internal/gitx\"\n+\t\"github.com/albertcbrown/ard/internal/l