134-\t\t\tbroken = append(broken, p)\ninternal/prgate/prgate.go-135-\t\t}\ninternal/prgate/prgate.go-136-\t}\ninternal/prgate/prgate.go-137-\treturn len(broken) == 0, broken, nil\ninternal/prgate/prgate.go-138-}\ninternal/prgate/prgate.go-139-\ninternal/prgate/prgate.go-140-func dropIssuePaths(paths []string, issue int) []string {\ninternal/prgate/prgate.go-141-\tvar out []string\ninternal/prgate/prgate.go-142-\tfor _, p := range paths {\ninternal/prgate/prgate.go-143-\t\tif !strings.HasPrefix(p, fmt.Sprintf(\".ard/%d/\", issue)) {\ninternal/prgate/prgate.go-144-\t\t\tout = append(out, p)\ninternal/prgate/prgate.go-145-\t\t}\ninternal/reviewfix/harness_test.go:143:\terr := h.loop.appendRound(context.Background(), s.issue, Round{N: n, Phase: phase, Reason: ReasonReview, PR: s.pr, Head: head, Worker: wrk, Roles: []string{engRev}})\ninternal/reviewfix/loop.go:277:\tstarted, err := t.l.RequestRound(ctx, Request{Issue: n, PR: pr.Number, Head: pr.HeadSHA, Worker: worker, Reason: ReasonReview, Roles: changed, Max: wr.MaxReviewRounds})\ninternal/reviewfix/loop.go:381:\treturn l.appendRound(ctx, issue, Round{N: count, Phase: PhaseCapped, Reason: ReasonReview, PR: pr, Head: head, Worker: worker, Roles: roles})\ninternal/reviewfix/loop_test.go:179:\tif r.N != 1 || r.PR != s.pr || r.Head != \"h2\" || r.Worker != wrk || r.Reason != ReasonReview || len(r.Roles) != 1 || r.Roles[0] != engRev || r.ID == 0 {\ninternal/reviewfix/round.go:18:\tReasonReview   = \"review\"\ninternal/reviewfix/round.go:19:\tReasonConflict = \"conflict\"\ninternal/gitx/inspect.go:55:func (g *Git) MergeBaseAll(ctx context.Context, repoDir, a, b string) ([]string, error) {\ninternal/gitx/inspect.go:65:func (g *Git) MergeBase(ctx context.Context, repoDir, a, b string) (string, error) {\n129:Close-out checks `plan.md` against the job's base commit, but the committer writes it onto the latest `main`. So at commit time the committer replaces only the job's own `##` section in the current `main` copy (adding it at the end if absent, dropping it if the job removed it) and keeps every other section as `main` has it; a section another role committed after the job's base is not reverted. This runs again on each push retry. If the `main` copy cannot be merged (the job's heading appears twice, or its section holds a heading-like line), the job fails closed as `needs-human` with a `plan.md conflict` reason; like an allowlist denial, only the redacted log and the job's usage record are committed, never `plan.md` or the job's other files.\n158:**One writer location per issue directory at a time.** Until the worker branch exists, `main` owns `.ard/<issue#>/`; scanners and triage write there. Once the branch is cut, the branch owns it; workers and reviewers commit to the PR, and a scanner with new findings comments on the issue instead. This keeps the PR merge free of conflicts in `.ard/`.\n160:**One committer for main.** Close-outs never push. They hand a file set to the controller's committer, which keeps its own clean worktree of `main`, commits as `ard[bot]` with `ard(<stage>:<role>): #<issue> <summary> [skip ci]`, re-applies its snapshot on the fetched head, pushes with a lease, and retries up to 3 times (re-applying the whole-file snapshot is the rebase; if upstream changed one of its paths the request fails with a conflict instead of overwriting). A replay of an unchanged tree is a no-op that returns the upstream head. It refuses any change outside the `.ard/<issue#>/` directories. Worker code takes a separate lane: `Branches.CommitCode` commits only paths `committer.CheckCodePath` accepts (nothing under `.ard/`, `.ard-input/` or `.github/`, no `.git` or secret-shaped names), only to `worker/` branches, creating a branch with a push whose lease expects it to be absent and refusing to overwrite a path that changed on the branch since the job started. The one other lane is `ard init`'s: it commits only `.ard/config.yaml` and files under the four role trees, only to the new branch `ard-init` cut from `main`, with a push whose lease expects the ref to be absent, so it creates the branch and never updates an existing one, and opens a PR; a human merges it with a squash or merge commit, so the bot-commit check never sees a bot commit outside `.ard/<issue#>/` on main's first-parent history. Because the bot must bypass branch protection on `main`, a detective check audits it: the workflow `.github/workflows/bot-commits.yml` walks the first-parent history of `main` (the last 500 commits, or everything after the repository variable `ARD_BOT_CHECK_SINCE`) and fails the run, listing the commits and paths in the job summary, when a commit made by the bot changes anything but regular files under a single `.ard/<issue#>/` directory. Bot commits are identified by **committer** (the App's noreply email or login), not author, because a squash merge of a bot PR has the bot as author. If the 500-commit window is full and its oldest commit is the bot's, the check fails closed until `ARD_BOT_CHECK_SINCE` is set, so a bad commit cannot be flushed out of view. It runs hourly as well as on push, because `[skip ci]` suppresses the push trigger. It fails closed when the `ARD_BOT_LOGIN` repository variable is unset. It reads both variables from repository settings and lives in `.github/workflows/`, which the App cannot write. Alerting is the failed run only; it does not open issues or pause ard.\n330:6. **Two commits per round.** The loop commits the code through the committer's code lane (`Branches.CommitCode`) with the title `[<type>: ]<issue title> (#<issue>)`, the redacted summary (secrets and host paths) as the body and an `Ard-Job: <job-id>` trailer, no `[skip ci]`. `<type>` comes from the issue's `type:*` label (`feature` is `feat`, `bug` is `fix`; `docs`, `chore`, `refactor` and `test` keep their names) and with no `type:*` label the `<type>: ` part is dropped and the title is `<issue title> (#<issue>)`. The prefix is never taken from the plan or the lead's routing, so it depends on a maintainer applying `type:*` at intake. At the end close-out commits `worker-<role>.md` and the redacted logs of every agent step to the same branch (or to `main`, as triage's are, when the job stopped before its first push). `.ard/<issue#>/` never goes through the code lane. A push failure (branch exists, conflict, branch gone, guard) fails the job with no automatic retry.\n337:**Review feedback loops back here.** The `reviewfix` loop (#41) starts a round when every requested reviewer has finished and at least one ended `ard:review:<role>:changes`, backed by that role's close-out record (a label alone does not count). It records a `review_round` event in `_controller.db` (counted when requested, ordered by event ID, local to that database) and removes `ard:worker:<role>:done` from the issue, so the worker loop claims it again. The worker fixes on the same branch and reads `review-feedback.md`. When the fix lands with code changes, every requested reviewer runs again at the new head (their `:done` and `:changes` labels come off), because merge-gating approvals must cover the merged head. A round that changes no code, or one that would pass `max_review_rounds` (default 3), posts one comment and adds `ard:needs-human` on the issue; it is not repeated on the same head after a person removes the label. Removing `ard:needs-human` and pushing a new head caps again at once and never reruns reviewers; to continue, raise max_review_rounds, or fix the PR and remove the ard:review:<role>:changes labels so reviewers rerun. Merger conflict and rebase rounds are a follow-up that will use the same round API (`reviewfix.RequestRound`); until then a conflict, like a red required check, goes to `ard:needs-human`.\n383:- GitHub has computed that the branch does not conflict with `main`. Only a computed `mergeable: false` or `mergeable_state: dirty` is a conflict: it gets `ard:needs-human` and one comment, and a follow-up to #41 will turn this into a rebase round (`reviewfix.RequestRound`) that counts toward `max_review_rounds`. A `mergeable` that is still null or unknown, and a 405 \"not mergeable\" from the merge call, mean GitHub is still computing: the merger retries next tick and never labels\n401:A PR can change state behind ard's back, or stop moving, and the merger sees only ready, open PRs. `internal/prwatch` is a controller loop, not an agent, and takes no slot. Every `intervals.prwatch` (default 5m) it reads ard's PRs (App-authored `worker/` branches with base `main`: draft, ready, merged and closed) and **only observes, records and notifies**. It never merges, updates a branch, re-requests a review or starts a round: those belong to the merger, to #252 (stale reviews), #255 (conflicts) and `reviewfix` (#41), and the loop's effects interface has no such call. It is skipped while the controller is paused, like the merger.\n409:| Head moved, conflicts, requested changes, comments, label edits | Logged only |\n474:**`ard init` proposes the starter `.ard/` as a PR (decided, #27).** It builds `config.yaml` and the starter roles in memory (today `scanners/cve`, `scanners/lts`, `scanners/docs`, `scanners/error-codes`, `scanners/lint`, `scanners/missing-tests`, `scanners/trufflehog`, `scanners/trufflehog-history`, `triage/lead`, `triage/engineer`, `workers/engineer`, `reviewers/eng-review`, `reviewers/license-review`, `reviewers/product-manager-review` and `reviewers/security-review`; `intake: {mode: label}`, the protected-path defaults above, and the cve, lts, docs, error-codes, lint, lead, engineer, worker, eng-review, security-review, license-review and product-manager-review overrides), compares them with `main`, commits them on a new branch `ard-init` cut from `main` through the effect layer and a narrow committer lane, pushes it and opens a PR. It writes nothing to the local working tree or to `main`, and `scan` is committed `100755`. Files that already exist on `main` with different contents are a conflict naming the paths; `--force` proposes overwriting them, and init never deletes anything. It refuses while `ard-init` exists on the remote, whatever its PR's state, so it never force-pushes over or stacks commits on a human's edits: merge or close the PR, delete the branch and rerun. If `main` already has every starter file it prints `nothing to propose`. It syncs the label catalogue first (like `ard labels sync`), so a failure leaves nothing pushed. With `--dry-run` the commit, push and PR are logged to the ledger instead of acting. A missing repo, credentials or `main` branch exits 1 with nothing written, and `ARD_GITHUB_TOKEN` auth is refused outside `--dry-run`. The PR body carries the one step the App cannot do: copy `.github/workflows/bot-commits.yml` and set the repository variable `ARD_BOT_LOGIN` (optionally `ARD_BOT_CHECK_SINCE`). When the lint scanner is among the files, it also says the scanner fails until `.ard/scanners/lint/baseline` is committed. It also says to merge with **Squash and merge** or **Create a merge commit**, never a fast-forward from the command line, which would put the bot's commit on main's first-parent history. **Rebase and merge** is also safe: the scratch-repo run (#85) showed GitHub records the merging human as committer of a rebase-merged commit (the bot stays the author), and the bot-commit check keys on committer, so it does not flag it. The body still names only the two merges above.\n515:| Parallel triage roles share `plan.md` | Lost sections, conflicting commits | One triage job per issue at a time |","is_error":false}]},"parent_tool_use_id":null,"session_id":"1ee49b56-56d6-4e98-9fc3-39fc1512d83c","uuid":"9b46fff0-26df-42c9-afc9-bc7b2d3b563d","timestamp":"2026-11-24T17:41:39.525Z","tool_use_result":{"stdout":"internal/servecmd/merger.go:13:\treturn merger.New(merger.Deps{\ninternal/servecmd/reviewfix.go:13:\treturn reviewfix.New(reviewfix.Deps{\n(eval):1: no matches found: --include=*.go\ninternal/prgate/prgate.go:105:func Cover