{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01477e5beCwqwERLPRjZhyjp","type":"tool_result","content":"      18 reviewfix/doc.go\n     205 reviewfix/harness_test.go\n     382 reviewfix/loop.go\n     221 reviewfix/loop_test.go\n     124 reviewfix/round.go\n      90 merger/candidates.go\n      74 merger/doc.go\n      90 merger/gates.go\n     106 merger/gates_test.go\n     319 merger/harness_test.go\n     380 merger/integration_test.go\n     290 merger/loop.go\n     821 merger/loop_test.go\n     440 merger/merge.go\n      71 gitx/inspect.go\n    3631 total\npackage reviewfix\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\n\t\"github.com/albertcbrown/ard/internal/labels\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// Phases and reasons of a round.\nconst (\n\tPhaseRequested = \"requested\"\n\tPhaseApplied   = \"applied\"\n\tPhaseCapped    = \"capped\"\n\n\tReasonReview   = \"review\"\n\tReasonConflict = \"conflict\"\n)\n\n// Round is one review_round event.\ntype Round struct {\n\tID     int64    `json:\"-\"` // the event ID\n\tN      int      `json:\"round\"`\n\tPhase  string   `json:\"phase\"`\n\tReason string   `json:\"reason\"`\n\tPR     int      `json:\"pr\"`\n\tHead   string   `json:\"head\"`\n\tWorker string   `json:\"worker\"`\n\tRoles  []string `json:\"roles\"`\n}\n\n// EventStore is the part of *state.Store the round API uses.\ntype EventStore interface {\n\tEvents(ctx context.Context, f state.EventFilter) ([]state.Event, error)\n\tAppendEvent(ctx context.Context, e state.Event) error\n}\n\nfunc decodeRound(e state.Event) (Round, error) {\n\tvar r Round\n\tif err := json.Unmarshal(e.Data, &r); err != nil {\n\t\treturn Round{}, fmt.Errorf(\"review_round event %d: %w\", e.ID, err)\n\t}\n\tr.ID = e.ID\n\treturn r, nil\n}\n\n// Rounds returns the issue's round events in ID order. A row that does not\n// decode is an error.\nfunc Rounds(ctx context.Context, s interface {\n\tEvents(ctx context.Context, f state.EventFilter) ([]state.Event, error)\n}, issue int) ([]Round, error) {\n\tevs, err := s.Events(ctx, state.EventFilter{Kind: state.EventReviewRound, Issue: issue})\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"read review rounds of issue %d: %w\", issue, err)\n\t}\n\treturn decodeRounds(evs)\n}\n\nfunc decodeRounds(evs []state.Event) ([]Round, error) {\n\tvar out []Round\n\tfor _, e := range evs {\n\t\tr, err := decodeRound(e)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tout = append(out, r)\n\t}\n\treturn out, nil\n}\n\n// Requested counts the requested rounds, whatever their reason: the number\n// max_review_rounds caps.\nfunc Requested(rs []Round) int {\n\tn := 0\n\tfor _, r := range rs {\n\t\tif r.Phase == PhaseRequested {\n\t\t\tn++\n\t\t}\n\t}\n\treturn n\n}\n\n// Request describes a round to start.\ntype Request struct {\n\tIssue, PR            int\n\tHead, Worker, Reason string\n\tRoles                []string\n\tMax                  int\n}\n\nfunc (l *Loop) appendRound(ctx context.Context, issue int, r Round) error {\n\tdata, err := json.Marshal(r)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"encode review round: %w\", err)\n\t}\n\tif err := l.d.Store.AppendEvent(ctx, state.Event{Kind: state.EventReviewRound, Issue: issue, Role: r.Worker, Data: data}); err != nil {\n\t\treturn fmt.Errorf(\"issue %d: record %s review round: %w\", issue, r.Phase, err)\n\t}\n\treturn nil\n}\n\n// RequestRound starts a round: it records a requested event first, then\n// removes the worker's :done label so the worker loop claims the issue again.\n// At the cap it runs the cap path and returns false.\nfunc (l *Loop) RequestRound(ctx context.Context, r Request) (bool, error) {\n\trs, err := Rounds(ctx, l.d.Store, r.Issue)\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tcount := Requested(rs)\n\tif count >= r.Max {\n\t\treturn false, l.capPath(ctx, r.Issue, r.PR, r.Head, r.Worker, count, r.Roles, fmt.Sprintf(\"the limit of %d review rounds is reached\", r.Max))\n\t}\n\terr = l.appendRound(ctx, r.Issue, Round{N: count + 1, Phase: PhaseRequested, Reason: r.Reason, PR: r.PR, Head: r.Head, Worker: r.Worker, Roles: r.Roles})\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tif err := l.d.Effects.RemoveLabel(ctx, r.Issue, labels.Done(labels.StageWorker, r.Worker)); err != nil {\n\t\treturn true, fmt.Errorf(\"issue %d: remove worker done label: %w\", r.Issue, err)\n\t}\n\treturn true, nil\n}\n\t}\n\tif started {\n\t\tt.log.Info(\"reviewfix.request\", \"issue\", n, \"pr\", pr.Number, \"round\", Requested(rs)+1, \"roles\", changed)\n\t} else {\n\t\tt.log.Warn(\"reviewfix.cap_reached\", \"issue\", n, \"pr\", pr.Number, \"max\", wr.MaxReviewRounds)\n\t}\n\treturn nil\n}\n\n// landing handles an issue whose newest round is requested.\nfunc (t *tick) landing(ctx context.Context, pr github.PullRequest, is github.Issue, worker string, n int, requested []string, rs []Round) error {\n\td := t.l.d\n\tR := rs[len(rs)-1]\n\tdoneLabel := labels.Done(labels.StageWorker, worker)\n\thasDone := prgate.HasLabel(is.Labels, doneLabel)\n\trunning := prgate.HasLabel(is.Labels, labels.Running(labels.StageWorker, worker))\n\tclaims, err := d.Store.Events(ctx, state.EventFilter{Kind: state.EventClaim, Stage: string(labels.StageWorker), Issue: n})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"issue %d: worker claims: %w\", n, err)\n\t}\n\tclaimed := false\n\tfor _, c := range claims {\n\t\tif c.ID > R.ID {\n\t\t\tclaimed = true\n\t\t}\n\t}\n\tswitch {\n\tcase !claimed && hasDone:\n\t\tif t.dry {\n\t\t\tt.log.Info(\"reviewfix.would_request\", \"issue\", n, \"replay\", true)\n\t\t\treturn nil\n\t\t}\n\t\tif err := d.Effects.RemoveLabel(ctx, n, doneLabel); err != nil {\n\t\t\treturn fmt.Errorf(\"issue %d: replay remove worker done label: %w\", n, err)\n\t\t}\n\t\treturn nil\n\tcase !claimed || running || !hasDone:\n\t\treturn nil\n\t}\n\tref := fmt.Sprintf(\"refs/ard/reviewfix/%d\", pr.Number)\n\tif err := d.Git.FetchRef(ctx, d.RepoDir, d.RemoteURL, \"+refs/heads/\"+pr.HeadRef+\":\"+ref, d.Token); err != nil {\n\t\treturn fmt.Errorf(\"pr %d: fetch branch: %w\", pr.Number, err)\n\t}\n\ttip, err := d.Git.RevParse(ctx, d.RepoDir, ref)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"pr %d: %w\", pr.Number, err)\n\t}\n\tif tip != pr.HeadSHA {\n\t\treturn nil\n\t}\n\tcovered, _, err := prgate.Covers(ctx, d.Git, d.RepoDir, R.Head, pr.HeadSHA, \"\", n)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"pr %d: compare heads: %w\", pr.Number, err)\n\t}\n\tif covered {\n\t\tif t.dry {\n\t\t\tt.log.Info(\"reviewfix.would_cap\", \"issue\", n, \"pr\", pr.Number, \"why\", \"no code\")\n\t\t\treturn nil\n\t\t}\n\t\tvar asking []string\n\t\tfor _, r := range requested {\n\t\t\tif prgate.HasLabel(pr.Labels, labels.Changes(r)) {\n\t\t\t\tasking = append(asking, r)\n\t\t\t}\n\t\t}\n\t\treturn t.l.capPath(ctx, n, pr.Number, pr.HeadSHA, worker, Requested(rs), asking, \"the last fix round changed no code\")\n\t}\n\tif t.dry {\n\t\tt.log.Info(\"reviewfix.would_apply\", \"issue\", n, \"pr\", pr.Number)\n\t\treturn nil\n\t}\n\tfor _, r := range requested {\n\t\tfor _, name := range []string{labels.Changes(r), labels.Done(labels.StageReview, r)} {\n\t\t\tif !prgate.HasLabel(pr.Labels, name) {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif err := d.Effects.RemoveLabel(ctx, pr.Number, name); err != nil {\n\t\t\t\treturn fmt.Errorf(\"pr %d: remove %s: %w\", pr.Number, name, err)\n\t\t\t}\n\t\t}\n\t}\n\tt.log.Info(\"reviewfix.apply\", \"issue\", n, \"pr\", pr.Number, \"round\", R.N)\n\treturn t.l.appendRound(ctx, n, Round{N: R.N, Phase: PhaseApplied, Reason: R.Reason, PR: pr.Number, Head: pr.HeadSHA, Worker: worker, Roles: requested})\n}\n\n// capPath hands the issue to a human: one comment (never finding text), the\n// needs-human label, then the capped event. A crash replays the first two.\nfunc (l *Loop) capPath(ctx context.Context, issue, pr int, head, worker string, count int, roles []string, why string) error {\n\td := l.d\n\tmarker := \"<!-- ard:review-rounds head=\" + head + \" -->\"\n\ttext := fmt.Sprintf(\"Review fix rounds stopped on pull request #%d: %s. Reviewers still asking for changes: %s. A person needs to look at it: raise max_review_rounds, or fix the PR and remove the ard:review:<role>:changes labels so reviewers rerun.\",\n\t\tpr, why, strings.Join(roles, \", \"))\n\tif len(roles) == 0 {\n\t\ttext = fmt.Sprintf(\"Review fix rounds stopped on pull request #%d: %s. A person needs to look at it: raise max_review_rounds, or fix the PR and remove the ard:review:<role>:changes labels so reviewers rerun.\", pr, why)\n\t}\n\tif err := agentjob.PostOnce(ctx, d.Reader, d.Effects, issue, marker, text); err != nil {\n\t\treturn err\n\t}\n\tif err := d.Effects.AddLabels(ctx, issue, labels.NeedsHuman); err != nil {\n\t\treturn fmt.Errorf(\"issue %d: add needs-human: %w\", issue, err)\n\t}\n\treturn l.appendRound(ctx, issue, Round{N: count, Phase: PhaseCapped, Reason: ReasonReview, PR: pr, Head: head, Worker: worker, Roles: roles})\n}\n25:type Reader interface {\n26-\tIdentity(ctx context.Context) (github.Identity, error)\n27-\tGetIssue(ctx context.Context, n int) (github.Issue, error)\n28-\tGetPR(ctx context.Context, n int) (github.PullRequest, error)\n29-\tSearchIssues(ctx context.Context, q string, o github.SearchOpts) ([]github.Issue, error)\n30-\tListComments(ctx context.Context, n int, since time.Time) ([]github.Comment, error)\n31-}\n32-\n33-// Effects is the part of effects.Effects the loop uses.\n34:type Effects interface {\n35-\tAddLabels(ctx context.Context, n int, labels ...string) error\n36-\tRemoveLabel(ctx context.Context, n int, label string) error\n37-\tCreateComment(ctx context.Context, n int, body string) (github.Comment, error)\n38-\tDryRun() bool\n39-}\n40-\n41-// Store is the part of *state.Store the loop uses.\n42:type Store interface {\n43-\tEventStore\n44-\tRunningJobs(ctx context.Context) ([]state.Job, error)\n45-\tCloseoutsOf(ctx context.Context, issue int, stage string) ([]state.Job, error)\n46-}\n47-\n48-//