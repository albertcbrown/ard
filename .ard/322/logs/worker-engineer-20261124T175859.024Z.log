anch(pr.HeadRef)\n\tif !ok {\n\t\treturn t.needsHuman(ctx, pr, \"conflict\", \"\")\n\t}\n\twr, ok := t.cfg.Role(config.KindWorker, worker)\n\tif !ok {\n\t\treturn t.needsHuman(ctx, pr, \"conflict\", \"\")\n\t}\n\trs, err := reviewfix.Rounds(ctx, d.Store, issue)\n\tif err != nil {\n\t\tt.fail(pr.Number, \"conflict_rounds\", err)\n\t\treturn false\n\t}\n\tif len(rs) > 0 {\n\t\tif last := rs[len(rs)-1]; last.Head == pr.HeadSHA {\n\t\t\tswitch last.Phase {\n\t\t\tcase reviewfix.PhaseRequested:\n\t\t\t\tt.log.Info(\"merge.conflict_round_pending\", \"pr\", pr.Number, \"issue\", issue, \"head\", pr.HeadSHA)\n\t\t\t\treturn false\n\t\t\tcase reviewfix.PhaseCapped:\n\t\t\t\treturn false // a human owns it\n\t\t\t}\n\t\t}\n\t}\n\tif t.dry {\n\t\tt.log.Info(\"merge.would_request_conflict_round\", \"pr\", pr.Number, \"issue\", issue, \"head\", pr.HeadSHA)\n\t\treturn false\n\t}\n\tstarted, err := d.Rounds.RequestRound(ctx, reviewfix.Request{Issue: issue, PR: pr.Number, Head: pr.HeadSHA, Worker: worker, Reason: reviewfix.ReasonConflict, Roles: roles, Max: wr.MaxReviewRounds})\n\tif err != nil {\n\t\tt.fail(pr.Number, \"conflict_round\", err)\n\t\treturn false\n\t}\n\tif started {\n\t\tt.log.Info(\"merge.conflict_round\", \"pr\", pr.Number, \"issue\", issue, \"head\", pr.HeadSHA)\n\t}\n\treturn false\n}\n\n// updateBranch merges''')\nsub(p,'\"github.com/albertcbrown/ard/internal/prgate\"\\n','\"github.com/albertcbrown/ard/internal/prgate\"\\n\\t\"github.com/albertcbrown/ard/internal/reviewfix\"\\n')\np='servecmd/merger.go'\nsub(p,'\treturn merger.New','\t// Rounds is deliberately unset: conflict rounds stay off until part B of\\n\t// #255 wires the review fix loop in, so a conflict still goes needs-human.\\n\treturn merger.New')\np='reviewfix/harness_test.go'\nsub(p,'type harness struct','''func (g *stubGit) IsAncestor(context.Context, string, string, string) (bool, error) {\n\treturn g.ancestor, nil\n}\nfunc (g *stubGit) Parents(context.Context, string, string) ([]string, error)