{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018xEB61fiXpL6SqygfEMKzZ","type":"tool_result","content":"// Git is the read side of *gitx.Git, run against the controller's clone only.\n// It has no Commit or Push: only internal/effects may call those.\ntype Git interface {\n\tFetchRef(ctx context.Context, repoDir, url, refspec string, token gitx.TokenFunc) error\n\tRevParse(ctx context.Context, dir, ref string) (string, error)\n\tMergeBaseAll(ctx context.Context, repoDir, a, b string) ([]string, error)\n\tCodeChanged(ctx context.Context, repoDir, from, to string, exclude ...string) ([]string, error)\n}\n\n// Deps are the loop's collaborators.\ntype Deps struct {\n\tReader  Reader\n\tEffects Effects\n\tStore   Store\n\tGit     Git\n\n\tRepoDir   string // absolute path of the controller's clone\n\tRemoteURL string\n\tToken     gitx.TokenFunc\n\t// NoCIGrace is how long a head must have been known before \"no check\n\t// runs\" counts as green; default 2 minutes.\n\tNoCIGrace time.Duration\n\tNow       func() time.Time\n\tLog       *slog.Logger\n}\n\n// headSeen is when the loop first saw a PR's current head, and in which tick.\ntype headSeen struct {\n\tsha  string\n\tat   time.Time\n\ttick uint64\n}\n\n// Loop is the merger loop. It implements controller.Loop.\ntype Loop struct {\n\td Deps\n\n\tmu    sync.Mutex\n\tticks uint64\n\theads map[int]headSeen\n\tapps  map[string]int64 // App slug -> id, per process\n}\n\nvar _ controller.Loop = (*Loop)(nil)\n\n// New returns the loop with defaults applied.\nfunc New(d Deps) *Loop {\n\tif d.NoCIGrace <= 0 {\n\t\td.NoCIGrace = defaultNoCI\n\t}\n\tif d.Now == nil {\n\t\td.Now = time.Now\n\t}\n\tif d.Log == nil {\n\t\td.Log = slog.Default()\n\t}\n\treturn &Loop{d: d, heads: map[int]headSeen{}, apps: map[string]int64{}}\n}\n\n// Name implements controller.Loop.\nfunc (*Loop) Name() string { return \"merger\" }\n\n// Interval implements controller.Loop.\nfunc (*Loop) Interval(c *config.Resolved) time.Duration {\n\tif c == nil || c.Intervals.Merger <= 0 {\n\t\treturn defaultInterval\n\t}\n\treturn time.Duration(c.Intervals.Merger)\n}\n\n// TickTimeout implements controller.TickTimeouter.\nfunc (*Loop) TickTimeout(*config.Resolved) time.Duration { return 5 * time.Minute }\n\n// Claims implements controller.Loop: the loop is skipped while paused.\nfunc (*Loop) Claims() bool { return true }\n\n\nfunc mergeRef(pr int) string { return \"refs/ard/merge/\" + strconv.Itoa(pr) }\n\n// consider runs the gates of one PR in order and reports whether it merged\n// (which ends the tick). Every path that does not merge logs why.\nfunc (t *tick) consider(ctx context.Context, listed github.PullRequest) (merged bool) {\n\td := t.l.d\n\tpr, issue, ok := t.recheck(ctx, listed)\n\tif !ok {\n\t\treturn false\n\t}\n\tn := pr.Number\n\troles := t.reviewerRoles()\n\tv := prgate.Labels(pr.Labels, roles)\n\tif !v.OK {\n\t\tt.skip(n, v.Reason)\n\t\treturn false\n\t}\n\n\t// Review labels of roles that are not configured (a stale or hand-made\n\t// :changes or :running) still block.\n\tfor _, l := range pr.Labels {\n\t\tif p, ok := labels.Parse(l); ok && p.Stage == labels.StageReview && (p.State == labels.StateChanges || p.State == labels.StateRunning) {\n\t\t\tt.skip(n, prgate.ReasonChanges)\n\t\t\treturn false\n\t\t}\n\t}\n\n\t// d. Pin the head: the branch tip must be the SHA the API reported.\n\tif err := d.Git.FetchRef(ctx, d.RepoDir, d.RemoteURL, \"+refs/heads/\"+pr.HeadRef+\":\"+mergeRef(n), d.Token); err != nil {\n\t\tt.fail(n, \"fetch\", err)\n\t\treturn false\n\t}\n\thead, err := d.Git.RevParse(ctx, d.RepoDir, mergeRef(n))\n\tif err != nil {\n\t\tt.fail(n, \"rev_parse\", err)\n\t\treturn false\n\t}\n\tif head != pr.HeadSHA {\n\t\tt.log.Info(\"merge.head_moved\", \"pr\", n, \"api_head\", pr.HeadSHA, \"branch_head\", head)\n\t\treturn false\n\t}\n\tgraceOver := t.sawHead(n, head)\n\tbases, err := d.Git.MergeBaseAll(ctx, d.RepoDir, t.mainTip, head)\n\tif err != nil {\n\t\tt.fail(n, \"me