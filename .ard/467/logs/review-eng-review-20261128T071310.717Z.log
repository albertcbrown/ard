th := newHarness(t)\n185\t-\tn, branch, _ := conflictSetup(t, h, []string{\"a.txt\"}, false)\n186\t+\tn, branch, mainTip := conflictSetup(t, h, []string{\"a.txt\"}, false)\n187\t \trequestConflictRound(t, h, n)\n188\t \tcr, err := h.loop.conflictInput(context.Background(), n, branch)\n189\t-\tif err != nil || !cr.applies || cr.input != nil || len(cr.conflicted) != 0 {\n190\t-\t\tt.Fatalf(\"cr = %+v, err = %v; want a round with no input\", cr, err)\n191\t+\tif err != nil || !cr.applies || !cr.clean || cr.input != nil || len(cr.conflicted) != 0 {\n192\t+\t\tt.Fatalf(\"cr = %+v, err = %v; want a clean round with no input\", cr, err)\n193\t+\t}\n194\t+\tif cr.mainTip != mainTip || cr.wt == \"\" || cr.branchTip == \"\" {\n195\t+\t\tt.Errorf(\"mainTip %q (want %q), wt %q, branchTip %q\", cr.mainTip, mainTip, cr.wt, cr.branchTip)\n196\t+\t}\n197\t+\tcr.release()\n198\t+\tif _, err := os.Stat(cr.wt); err == nil {\n199\t+\t\tt.Error(\"release left the scratch worktree\")\n200\t+\t}\n201\t+}\n202\t+\n203\t+// noAgent fails the test when an agent step starts.\n204\t+func noAgent(t *testing.T, h *harness) {\n205\t+\tt.Helper()\n206\t+\th.ex.run = func(kind string, j executor.Job, hd executor.Handle) int {\n207\t+\t\tif kind == \"agent\" {\n208\t+\t\t\tt.Error(\"an agent started in a clean-merge conflict round\")\n209\t+\t\t}\n210\t+\t\treturn 0\n211\t+\t}\n212\t+}\n213\t+\n214\t+func TestConflictRoundCleanMergePushes(t *testing.T) {\n215\t+\th := newHarness(t)\n216\t+\tn, branch, mainTip := conflictSetup(t, h, []string{\"a.txt\"}, false)\n217\t+\trequestConflictRound(t, h, n)\n218\t+\tnoAgent(t, h)\n219\t+\ttip := strings.TrimSpace(gittest.Run(t, h.clone, \"rev-parse\", localRef(branch)))\n220\t+\th.code.shas[0] = tip\n221\t+\tbuf := h.captureLog()\n222\t+\th.mustTick()\n223\t+\tif h.claimed() {\n224\t+\t\tt.Errorf(\"executor jobs = %v, want none\", h.ex.ids())\n225\t+\t}\n226\t+\tif h.code.n() != 1 {\n227\t+\t\tt.Fatalf(\"commit requests = %d, want 1; issue labels %v\", h.code