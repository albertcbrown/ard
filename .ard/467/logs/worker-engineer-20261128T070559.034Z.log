 \", \")\n}\n\n// markersLeft opens the agent's worktree as a root and scans the recorded\n// conflicted paths.\nfunc (jb *job) markersLeft(h executor.Handle) []string {\n\troot, err := os.OpenRoot(h.Worktree)\n\tif err != nil {\n\t\treturn nil\n\t}\n\tdefer root.Close()\n\treturn markersLeft(root, jb.conflicted)\n}\n    1047 run.go\n83:\t// A conflict round: mainTip is the fetched tip of main (the committer's\n84:\t// MergeParent), conflicted the paths the controller's trial merge left in\n85:\t// conflict, mergePending that the first agent step still needs the merge.\n87:\tconflicted   map[string]bool\n96:func (l *Loop) run(ctx context.Context, env controller.Env, cfg *config.Resolved, c candidate, slot *pool.Slot) {\n126:\tvar cround conflictRound\n129:\t\tif cround, err = l.conflictInput(ctx, n, branch); err != nil {\n130:\t\t\tlog.Error(\"worker.claim_failed\", \"step\", \"conflict_input\", \"error\", err)\n133:\t\tif cround.input != nil {\n134:\t\t\tinputs = append(inputs, *cround.input)\n135:\t\t\tuntrusted = append(untrusted, cround.input.Path)\n138:\tif exists && !cround.applies {\n184:\tif cround.input != nil {\n185:\t\tjb.mainTip, jb.conflicted, jb.mergePending = cround.mainTip, cround.conflicted, true\n192:func (l *Loop) ambiguous(ctx context.Context, log *slog.Logger, n int) {\n207:func (jb *job) budgetCap() float64 {\n214:func (jb *job) cause(kind closeout.CauseKind, detail string, retry bool) closeout.Cause {\n218:func (jb *job) remaining() time.Duration { return jb.deadline.Sub(jb.l.d.Now()) }\n222:func (jb *job) exec(ctx context.Context) {\n265:func (jb *job) agentStep(ctx context.Context, id, ref string, extra []executor.File) (step, bool) {\n340:// preMerge starts the merge of main in the worktree of a conflict round's\n341:// first agent step, before the agent runs, so it sees real conflict markers.\n343:// The conflicts must be the ones the trial merge recorded.\n344:func (jb *job) preMerge(ctx context.Context, h executor.Handle) error {\n353:\t