t\tmainTip = strings.TrimSpace(gittest.Run(t, h.clone, \"rev-parse\", \"HEAD\"))\n47\t\treturn n, branch, mainTip\n48\t}\n49\t\n50\tfunc requestConflictRound(t *testing.T, h *harness, n int) {\n51\t\tt.Helper()\n52\t\tpr := h.gh.SeedPR(github.PullRequest{State: github.StateOpen, Author: self, HeadRef: BranchName(\"engineer\", n, \"Say hello\"), HeadSHA: \"x\", BaseRef: \"main\"})\n53\t\tdata, _ := json.Marshal(map[string]any{\"round\": 1, \"phase\": \"requested\", \"reason\": \"conflict\", \"pr\": pr, \"head\": \"h\", \"worker\": \"engineer\", \"roles\": []string{\"eng-review\"}})\n54\t\tif err := h.store.AppendEvent(context.Background(), state.Event{Kind: state.EventReviewRound, Issue: n, Role: \"engineer\", Data: data}); err != nil {\n55\t\t\tt.Fatal(err)\n56\t\t}\n57\t}\n58\t\n59\tfunc TestConflictRoundInput(t *testing.T) {\n60\t\th := newHarness(t)\n61\t\tpaths := []string{\"a\\\"b\\nc.txt\"}\n62\t\tfor i := 0; i < conflictPathCap+5; i++ {\n63\t\t\tpaths = append(paths, fmt.Sprintf(\"f%03d.txt\", i))\n64\t\t}\n65\t\tn, branch, mainTip := conflictSetup(t, h, paths, true)\n66\t\trequestConflictRound(t, h, n)\n67\t\tcr, err := h.loop.conflictInput(context.Background(), n, branch)\n68\t\tif err != nil || !cr.applies || cr.input == nil {\n69\t\t\tt.Fatalf(\"cr = %+v, err = %v\", cr, err)\n70\t\t}\n71\t\tif cr.mainTip != mainTip {\n72\t\t\tt.Errorf(\"mainTip = %q, want the remote's %q\", cr.mainTip, mainTip)\n73\t\t}\n74\t\tif len(cr.conflicted) != len(paths) || !cr.conflicted[paths[0]] {\n75\t\t\tt.Errorf(\"conflicted = %d paths\", len(cr.conflicted))\n76\t\t}\n77\t\tbody := string(cr.input.Data)\n78\t\tif cr.input.Path != fmt.Sprintf(\".ard-input/%d/conflict.md\", n) || !strings.HasPrefix(body, \"UNTRUSTED INPUT\") {\n79\t\t\tt.Errorf(\"path %q, body:\\n%s\", cr.input.Path, body)\n80\t\t}\n81\t\tif !strings.Contains(body, `\"a\\\"b\\nc.txt\"`) || strings.Contains(body, \"a\\\"b\\nc\") {\n82\t\t\tt.Errorf(\"name not escaped:\\n%s\", body)\n83\t\t}\n84\t\tif !strings.