n\t\t\t}\n\t\t}\n\t\tchanges = append(changes, c)\n\t}\n\treturn changes, prLines, nil\n}\n\n// fileFacts fills the on-disk facts of one changed file. Only the added line ranges are pattern-scanned.\nfunc (l *Loop) fileFacts(ctx context.Context, root *os.Root, c *Change, secrets *redact.Secrets, added []gitx.LineRange, stage string, seq int) {\n\tfi, err := root.Lstat(c.Path)\n\tswitch {\ninternal/gitx/merge.go-24-\t\"-c\", \"commit.gpgsign=false\", \"-c\", \"core.hooksPath=/dev/null\",\ninternal/gitx/merge.go-25-}\ninternal/gitx/merge.go-26-\ninternal/gitx/merge.go:27:// MergeNoCommit merges ref into the worktree at dir without committing and\ninternal/gitx/merge.go-28-// returns the conflicted paths. A clean merge returns none. A failure that\ninternal/gitx/merge.go-29-// leaves no unmerged path is an error. The merge ignores every attribute file\ninternal/gitx/merge.go-30-// (GIT_ATTR_SOURCE is the empty tree), takes no -X options and runs no hooks.\ninternal/gitx/merge.go:31:func (g *Git) MergeNoCommit(ctx context.Context, dir, ref string) ([]string, error) {\ninternal/gitx/merge.go-32-\tempty, err := g.emptyTreeID(ctx, dir)\ninternal/gitx/merge.go-33-\tif err != nil {\ninternal/gitx/merge.go-34-\t\treturn nil, err\ninternal/gitx/merge.go-35-\t}\ninternal/gitx/merge.go-36-\targs := append(append([]string{}, hardenedMerge...),\ninternal/gitx/merge.go-37-\t\t\"merge\", \"--no-commit\", \"--no-ff\", \"--no-verify\", \"--no-edit\", \"-s\", \"ort\", ref)\ninternal/gitx/merge.go-38-\t_, _, mergeErr := g.run(ctx, dir, []string{\"GIT_ATTR_SOURCE=\" + empty,\ninternal/gitx/merge.go-39-\t\t\"GIT_AUTHOR_NAME=ard\", \"GIT_AUTHOR_EMAIL=ard@localhost\",\ninternal/gitx/merge.go-40-\t\t\"GIT_COMMITTER_NAME=ard\", \"GIT_COMMITTER_EMAIL=ard@localhost\"}, \"\", nil, args...)\ninternal/gitx/merge.go-41-\tif mergeErr == nil {\ninternal/gitx/merge.go-42-\t\treturn nil, nil\ninternal/gitx/merge.go-43-\t}\ninternal/gitx/merge.go-44-\tif !isExit(mergeErr, 1) {\ninternal/gitx/merge.go-45-\t\treturn nil, fmt.Errorf(\"gitx: merge %s: %w\", ref, mergeErr)\ninternal/gitx/merge.go-46-\t}\ninternal/gitx/merge.go-47-\tout, _, err := g.run(ctx, dir, nil, \"\", nil, \"diff\", \"--name-only\", \"-z\", \"--diff-filter=U\")\ninternal/gitx/merge.go-48-\tif err != nil {\ninternal/gitx/merge.go-49-\t\treturn nil, fmt.Errorf(\"gitx: list conflicts: %w\", err)\ninternal/gitx/merge.go-50-\t}\ninternal/gitx/merge.go-51-\tvar ps []string\ninternal/gitx/merge.go-52-\tfor _, p := range strings.Split(out, \"\\x00\") {\ninternal/gitx/merge.go-53-\t\tif p != \"\" {\ninternal/gitx/merge.go-54-\t\t\tps = append(ps, p)\ninternal/gitx/merge.go-55-\t\t}\ninternal/gitx/merge.go-56-\t}\ninternal/gitx/merge.go-57-\tif len(ps) == 0 {\ninternal/gitx/merge.go-58-\t\treturn nil, fmt.Errorf(\"gitx: merge %s: %w\", ref, mergeErr)\ninternal/gitx/merge.go-59-\t}\ninternal/gitx/merge.go-60-\treturn ps, nil\ninternal/gitx/merge.go-61-}\ninternal/gitx/merge.go-62-\ninternal/gitx/merge.go:63:// MergeAbort abandons a merge started by MergeNoCommit.\ninternal/gitx/merge.go-64-func (g *Git) MergeAbort(ctx context.Context, dir string) error {\ninternal/gitx/merge.go-65-\tif _, _, err := g.run(ctx, dir, nil, \"\", nil, \"merge\", \"--abort\"); err != nil {\ninternal/gitx/merge.go-66-\t\treturn fmt.Errorf(\"gitx: merge abort: %w\", err)\ninternal/gitx/merge.go-67-\t}\ninternal/gitx/merge.go-68-\treturn nil\ninternal/gitx/merge.go-69-}\n--","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01LGPewyNYPMt19ggBSwhDS6","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
