{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K6VMEfUeqKogXsRsniHhWc","type":"tool_result","content":"VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)\nLDFLAGS := -s -w -X main.version=$(VERSION)\n\n.PHONY: build test lint fmt clean cve-fixtures lts-fixtures lint-scanner-fixtures chart-test image-test\n\nbuild:\n\tCGO_ENABLED=0 go build -ldflags \"$(LDFLAGS)\" -o bin/ard ./cmd/ard\n\ntest:\n\tgo test ./...\n\nlint:\n\tgo vet ./...\n\t@out=\"$$(gofmt -l .)\"; if [ -n \"$$out\" ]; then echo \"gofmt needed:\"; echo \"$$out\"; exit 1; fi\n\nfmt:\n\tgofmt -w .\n\n# Renders the two Argo CD charts under deploy/ and checks them (needs helm and yq;\n# run by the ard-ci pipeline, not part of `make test`).\nchart-test:\n\tdeploy/test-charts.sh\n\n# Builds the ard image for both platforms and checks it (needs Docker buildx and\n# network; not part of `make test`).\nimage-test:\n\tdeploy/test-image.sh\n\n# Regenerates the real cve scanner fixtures inside the pinned tool image.\n# Needs Docker and network; not part of `make test`.\ncve-fixtures:\n\tdocker build -t ard-cve-fixtures internal/roles/scanners/cve\n\tdocker run --rm --user \"$$(id -u):$$(id -g)\" -e HOME=/tmp \\\n\t  -v \"$$PWD/internal/roles:/roles\" -w /roles ard-cve-fixtures sh testdata/cve/regen.sh\n\n# Regenerates the real lts API fixtures inside the pinned lts image (see\n# internal/roles/testdata/lts/regen.sh). Needs Docker and network; not part of `make test`.\nlts-fixtures:\n\tdocker build -t ard-lts-fixtures internal/roles/scanners/lts\n\tdocker run --rm --user \"$$(id -u):$$(id -g)\" -e HOME=/tmp \\\n\t  -v \"$$PWD/internal/roles:/roles\" -w /roles ard-lts-fixtures sh testdata/lts/regen.sh\n\n# Regenerates the real lint scanner fixtures in the pinned image (see\n# internal/roles/testdata/lint/regen.sh). Needs Docker; not part of `make test`.\nlint-scanner-fixtures:\n\tdocker build -t ard-lint-fixtures internal/roles/scanners/lint\n\tdocker run --rm --user \"$$(id -u):$$(id -g)\" -e HOME=/tmp \\\n\t  -v \"$$PWD/internal/roles:/roles\" -w /roles ard-lint-fixtures sh testdata/lint/regen.sh\n\nclean:\n\trm -rf bin\nls: internal/versioncheck: No such file or directory\ndocs:\nTODO.md\nlayout.md\nproposal.md\nrunbooks\n\ndocs/runbooks:\ngate-2.md\n\ninternal:\nagent\nagentjob\nbotcheck\nbudget\ncli\ncloseout\ncommitter\nconfig\nconfigcmd\nconfigsrc\ncontroller\ncostblock\ncosts\neffects\nexecutor\ngithub\ngitref\ngitx\ninitcmd\nintake\njanitor\nlabels\nlimits\nmerger\nmodelauth\npool\nprgate\nprwatch\nreaper\nredact\nrepopath\nreviewer\nreviewfix\nroles\nscanner\nservecmd\nstate\ntriage\nworker\nwtlock\n# Versions every PR merge to main as vX.Y.Z (#183). Each run reconciles: it\n# tags every untagged first-parent commit after the newest version tag, oldest\n# first, with an annotated tag and a notes-only release. It never moves or\n# deletes a tag. The bump comes from the merged PR's labels: semver:major,\n# semver:minor, else patch. ard's own main-lane commits (committer ARD_BOT_LOGIN)\n# are skipped; a direct push gets patch.\n#\n# Every run is a dry run until the repository variable ARD_VERSIONING is \"on\".\n# workflow_dispatch is a dry run unless dry_run is false.\n#\n# The logic is inline bash here, not Go, for the reason bot-commits.yml gives:\n# the job holds a tag-writing credential, and .github/ is the one place ard\n# cannot change. It never runs code from the checkout. internal/versioncheck\n# extracts the scripts in steps \"plan\" and \"tag\" and tests them.\nname: version\n\non:\n  push:\n    branches: [main]\n  # Catches merges whose push run was suppressed by [skip ci] or dropped.\n  schedule:\n    - cron: '23 * * * *'\n  workflow_dispatch:\n    inputs:\n      dry_run:\n        description: Plan only; create no tag or release\n        type: boolean\n        default: true\n      max_tags:\n        description: Most tags one run may create\n        type: string\n        default: '20'\n\nconcurrency:\n  group: version-main\n  cancel-in-progress: false\n\npermissions:\n  contents: read\n\njobs:\n  plan:\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    permissions:\n      contents: read\n      pull-requests: read\n    outputs:\n      live: ${{ steps.plan.outputs.live }}\n      count: ${{ steps.plan.outputs.count }}\n      plan: ${{ steps.plan.outputs.plan }}\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0\n        with:\n          fetch-depth: 0\n          fetch-tags: true\n          ref: main\n          persist-credentials: false\n      - id: plan\n        shell: bash\n        env:\n          GH_TOKEN: ${{ github.token }}\n          REPO: ${{ github.repository }}\n          BRANCH: main\n          BOT_LOGIN: ${{ vars.ARD_BOT_LOGIN }}\n          ENABLED: ${{ vars.ARD_VERSIONING }}\n          EVENT: ${{ github.event_name }}\n          INPUT_DRY_RUN: ${{ inputs.dry_run }}\n          MAX_TAGS: ${{ inputs.max_tags }}\n        run: |\n          set -euo pipefail\n          export LC_ALL=C\n\n          # Exit 0: plan written (possibly empty). 2: cannot plan. Never 1.\n          # Plan rows, tab-separated: kind sha tag pr bump title, where kind is\n          # \"tag\" or \"backfill\" (a release for an existing tag).\n          tmpd=\"\"\n          on_exit() {\n            local rc=$?\n            if [[ -n \"$tmpd\" ]]; then rm -rf \"$tmpd\"; fi\n            if [[ $rc -ne 0 && $rc -ne 2 ]]; then\n              echo \"::error title=version::unexpected failure (exit $rc)\"\n              exit 2\n            fi\n          }\n          trap on_exit EXIT\n          esc() {\n            local s=$1\n            s=${s//'%'/%25}\n            s=${s//$'\\r'/%0D}\n            s=${s//$'\\n'/%0A}\n            printf '%s' \"$s\"\n          }\n          fail() { echo \"::error title=version::$(esc \"$1\")\"; exit 2; }\n          warn() { echo \"::warning title=version::$(esc \"$1\")\"; }\n\n          if [[ -z \"${BOT_LOGIN:-}\" ]]; then\n            fail \"set the ARD_BOT_LOGIN repository variable to the App's <slug>[bot] login\"\n          fi\n          [[ -n \"${REPO:-}\" ]] || fail \"REPO is not set\"\n          branch=${BRANCH:-main}\n          head_ref=\"refs/remotes/origin/$branch\"\n          retry_sleep=${RETRY_SLEEP:-5}\n          [[ \"$retry_sleep\" =~ ^[0-9]{1,4}$ ]] || retry_sleep=5\n          retry_max=${RETRY_MAX:-3}\n          [[ \"$retry_max\" =~ ^[0-9]{1,4}$ ]] || retry_max=3\n          max_tags=20\n          if [[ \"${MAX_TAGS:-}\" =~ ^[0-9]{1,6}$ ]]; then\n            max_tags=$((10#$MAX_TAGS))\n          fi\n\n          live=false\n          mode=\"dry run: ARD_VERSIONING is not on\"\n          if [[ \"${ENABLED:-}\" == on ]]; then\n            if [[ \"${EVENT:-}\" != workflow_dispatch || \"${INPUT_DRY_RUN:-}\" == false ]]; then\n              live=true\n              mode=live\n            else\n              mode=\"dry run: workflow_dispatch with dry_run\"\n            fi\n          fi\n\n          tmpd=$(mktemp -d \"${RUNNER_TEMP:-${TMPDIR:-/tmp}}/version.XXXXXX\")\n          plan=$tmpd/plan\n          : >\"$plan\"\n          rows=()\n\n          write_outputs() {\n            local count b64\n            count=$(wc -l <\"$plan\")\n            count=$((count + 0))\n            b64=$(base64 <\"$plan\" | tr -d '\\n')\n            if [[ -n \"${GITHUB_OUTPUT:-}\" ]]; then\n              {\n                echo \"live=$live\"\n                echo \"count=$count\"\n                echo \"plan=$b64\"\n              } >>\"$GITHUB_OUTPUT\"\n            fi\n            echo \"$count plan row(s); $mode\"\n          }\n\n          write_summary() { # note\n            [[ -n \"${GITHUB_STEP_SUMMARY:-}\" ]] || return 0\n            {\n              echo \"### Version plan ($mode)\"\n              echo\n              if [[ ${#rows[@]} -gt 0 ]]; then\n                echo \"| sha | tag | bump | PR |\"\n                echo \"| --- | --- | --- | --- |\"\n                printf '%s\\n' \"${rows[@]}\"\n              else\n                echo \"$1\"\n              fi\n            } >>\"$GITHUB_STEP_SUMMARY\"\n          }\n\n          # api PATH: API_STATUS=ok with API_BODY, or API_STATUS=404.\n          # Any other failure stops the run: it never guesses after an API error.\n          api() {\n            API_BODY=\"\"\n            API_STATUS=\"\"\n            if API_BODY=$(gh api \"$1\" 2>\"$tmpd/gh.err\"); then\n              API_STATUS=ok\n              return 0\n            fi\n            if grep -q 'HTTP 404' \"$tmpd/gh.err\"; then\n              API_STATUS=404\n              return 0\n            fi\n            cat \"$tmpd/gh.err\" >&2\n            fail \"GitHub API call $1 failed\"\n          }\n\n          [[ \"$(git rev-parse --is-shallow-repository)\" == false ]] || fail \"shallow clone; check out with fetch-depth: 0\"\n          git rev-parse -q --verify \"$head_ref^{commit}\" >/dev/null || fail \"$head_ref is missing\"\n          head=$(git rev-parse \"$head_ref^{commit}\")\n\n          # Version tags. Anything not matching ver_re is ignored.\n          ver_re='^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$'\n          vgt() { # x y z X Y Z: is x.y.z greater than X.Y.Z\n            if (($1 != $4)); then (($1 > $4)); return; fi\n            if (($2 != $5)); then (($2 > $5)); return; fi\n            (($3 > $6))\n          }\n          parts() { # tag: sets PX PY PZ\n            [[ \"$1\" =~ $ver_re ]] || fail \"$1 is not a version tag\"\n            if ((${#BASH_REMATCH[1]} > 9 || ${#BASH_REMATCH[2]} > 9 || ${#BASH_REMATCH[3]} > 9)); then\n              fail \"version tag $1 is too large\"\n            fi\n            PX=${BASH_REMATCH[1]}\n            PY=${BASH_REMATCH[2]}\n            PZ=${BASH_REMATCH[3]}\n          }\n          declare -A tag_of=()\n          max_tag=\"\"\n          mx=0 my=0 mz=0\n          while IFS= read -r name; do\n            [[ \"$name\" =~ $ver_re ]] || continue\n            parts \"$name\"\n            x=$PX y=$PY z=$PZ\n            c=$(git rev-parse -q --verify \"refs/tags/$name^{commit}\") || fail \"version tag $name does not point at a commit\"\n            if [[ -n \"${tag_of[$c]:-}\" ]]; then\n              parts \"${tag_of[$c]}\"\n              if vgt \"$x\" \"$y\" \"$z\" \"$PX\" \"$PY\" \"$PZ\"; then tag_of[$c]=$name; fi\n            else\n              tag_of[$c]=$name\n            fi\n            if [[ -z \"$max_tag\" ]] || vgt \"$x\" \"$y\" \"$z\" \"$mx\" \"$my\" \"$mz\"; then\n              max_tag=$name mx=$x my=$y mz=$z\n            fi\n          done < <(git for-each-ref --format='%(refname:strip=2)' 'refs/tags/v*')\n\n          if [[ -z \"$max_tag\" ]]; then\n            if [[ \"$live\" == true ]]; then\n              fail \"no version tag: create the annotated seed tag v0.1.0 (docs/runbooks/release.md)\"\n            fi\n            echo \"::notice title=version::no version tag yet; nothing to plan until an admin creates the annotated seed tag v0.1.0 (docs/runbooks/release.md)\"\n            write_summary \"No version tag yet: create the annotated seed tag v0.1.0 (docs/runbooks/release.md).\"\n            write_outputs\n            exit 0\n          fi\n\n          base=\"\" base_tag=\"\"\n          while IFS= read -r c; do\n            if [[ -n \"${tag_of[$c]:-}\" ]]; then\n              base=$c base_tag=${tag_of[$c]}\n              break\n            fi\n          done < <(git rev-list --first-parent \"$head\")\n          [[ -n \"$base\" ]] || fail \"version tags exist (highest $max_tag) but none is on first-parent origin/$branch\"\n          if [[ \"$max_tag\" != \"$base_tag\" ]]; then\n            warn \"highest version tag $max_tag is not the newest on first-parent origin/$branch ($base_tag); numbering continues from $max_tag\"\n          fi\n\n          # A tag without a release: the seed tag, or a run that died between\n          # pushing a tag and creating its release.\n          api \"repos/$REPO/releases/tags/$base_tag\"\n          if [[ \"$API_STATUS\" == 404 ]]; then\n            printf 'backfill\\t%s\\t%s\\t\\t\\t\\n' \"$base\" \"$base_tag\" >>\"$plan\"\n            rows+=(\"| \\`${base:0:12}\\` | $base_tag | release only | |\")\n            echo \"$base -> $base_tag (release backfill)\"\n          fi\n\n          squash_re='\\(#([0-9]+)\\)$'\n          merge_re='^Merge pull request #([0-9]+) from '\n          # shellcheck disable=SC2016 # jq variables, not shell\n          match='select(.merged_at != null and .merge_commit_sha == $sha and .base.ref == $b)'\n          suffix=\"+${BOT_LOGIN}@users.noreply.github.com\"\n          ntag=0\n          while IFS= read -r -u 3 sha; do\n            ce=$(git log -1 --format=%ce \"$sha\")\n            cn=$(git log -1 --format=%cn \"$sha\")\n            subject=$(git log -1 --format=%s \"$sha\")\n\n            # ard's main-lane commits: the identity test bot-commits.yml uses.\n            bot=0\n            # Case-insensitive; the legacy <login>@users.noreply form and any\n            # control character in the identity (fail closed) also count.\n            shopt -s nocasematch\n            [[ \"$cn\" == \"$BOT_LOGIN\" ]] && bot=1\n            [[ \"$ce\" == \"$BOT_LOGIN@users.noreply.github.com\" ]] && bot=1\n            if [[ \"$ce\" == *\"$suffix\" ]]; then\n              prefix=${ce:0:$((${#ce} - ${#suffix}))}\n              [[ -n \"$prefix\" && \"$prefix\" != *[!0-9]* ]] && bot=1\n            fi\n            shopt -u nocasematch\n            [[ \"$cn\" == *[[:cntrl:]]* || \"$ce\" == *[[:cntrl:]]* ]] && bot=1\n            if [[ $bot == 1 ]]; then\n              echo \"skip $sha (ard main-lane commit)\"\n              continue\n            fi\n\n            subj_pr=\"\"\n            if [[ \"$subject\" =~ $squash_re || \"$subject\" =~ $merge_re ]]; then\n              if ((${#BASH_REMATCH[1]} <= 9)); then subj_pr=$((10#${BASH_REMATCH[1]})); fi\n            fi\n\n            # The merged PR: commits/{sha}/pulls, then the number in the\n            # subject; retried while GitHub's association lags the merge.\n            pr_json=\"\"\n            attempt=0\n            while :; do\n              api \"repos/$REPO/commits/$sha/pulls\"\n              [[ \"$API_STATUS\" == ok ]] || fail \"GitHub API call repos/$REPO/commits/$sha/pulls: HTTP 404\"\n              pr_json=$(jq -c --arg sha \"$sha\" --arg b \"$branch\" \"first(.[] | $match) // empty\" <<<\"$API_BODY\")\n              [[ -n \"$pr_json\" ]] && break\n              [[ -n \"$subj_pr\" ]] || break\n              api \"repos/$REPO/pulls/$subj_pr\"\n              if [[ \"$API_STATUS\" == ok ]]; then\n                pr_json=$(jq -c --arg sha \"$sha\" --arg b \"$branch\" \"$match\" <<<\"$API_BODY\")\n              fi\n              [[ -n \"$pr_json\" ]] && break\n              ((attempt < retry_max)) || break\n              attempt=$((attempt + 1))\n              sleep \"$retry_sleep\"\n            done\n\n            if [[ -n \"$pr_json\" ]]; then\n              pr=$(jq -r '.number' <<<\"$pr_json\")\n              title=$(jq -r '.title // \"\"' <<<\"$pr_json\")\n              major=$(jq -r 'any(.labels[]?; .name == \"semver:major\")' <<<\"$pr_json\")\n              minor=$(jq -r 'any(.labels[]?; .name == \"semver:minor\")' <<<\"$pr_json\")\n              who=\"PR #$pr\"\n            else\n              warn \"$sha has no merged PR; patch bump\"\n              pr=\"\" title=$subject major=false minor=false\n              who=\"commit $sha\"\n            fi\n            [[ \"$pr\" =~ ^[0-9]*$ ]] || fail \"$sha: unexpected PR number\"\n            title=$(jq -rn --arg t \"$title\" '$t | gsub(\"\\\\p{Cc}\"; \" \") | .[0:200]')\n\n            if [[ \"$major\" == true ]]; then\n              bump=\"major\"\n              if [[ \"$minor\" == true ]]; then warn \"PR #$pr has both semver labels; major wins\"; fi\n              mx=$((mx + 1)) my=0 mz=0\n            elif [[ \"$minor\" == true ]]; then\n              bump=\"minor\"\n              my=$((my + 1)) mz=0\n            else\n              bump=\"patch\"\n              mz=$((mz + 1))\n            fi\n            ver=\"v$mx.$my.$mz\"\n\n            # Go requires the /vN module path for a vN tag, N >= 2, and none below.\n            mod=\"\"\n            if git cat-file -e \"$sha:go.mod\" 2>/dev/null; then\n              mod=$(git cat-file blob \"$sha:go.mod\" | awk '$1 == \"module\" { m = $2 } END { print m }')\n              mod=${mod//\\\"/}\n            fi\n            s=0\n            if [[ \"$mod\" =~ /v([0-9]{1,9})$ ]] && ((10#${BASH_REMATCH[1]} >= 2)); then\n              s=$((10#${BASH_REMATCH[1]}))\n            fi\n            if ! { ((mx >= 2 && s == mx)) || ((mx < 2 && s == 0)); }; then\n              if ((mx >= 2)); then need=\"module path ending in /v$mx\"; else need=\"module path without a /vN suffix\"; fi\n              fail \"$who ($sha) would be $ver, which needs a $need, but go.mod declares module '$mod'. Relabel the PR and rerun, or change go.mod.\"\n            fi\n\n            printf 'tag\\t%s\\t%s\\t%s\\t%s\\t%s\\n' \"$sha\" \"$ver\" \"$pr\" \"$bump\" \"$title\" >>\"$plan\"\n            if [[ -n \"$pr\" ]]; then\n              echo \"$sha -> $ver ($bump, #$pr)\"\n              rows+=(\"| \\`${sha:0:12}\\` | $ver | $bump | #$pr |\")\n            else\n              echo \"$sha -> $ver ($bump, no PR)\"\n              rows+=(\"| \\`${sha:0:12}\\` | $ver | $bump | none |\")\n            fi\n            ntag=$((ntag + 1))\n          done 3< <(git rev-list --first-parent --reverse \"$base..$head\")\n\n          write_summary \"Nothing to tag: $base_tag is current.\"\n          if ((ntag > max_tags)); then\n            fail \"$ntag untagged merges, over the cap of $max_tags; rerun with workflow_dispatch max_tags=$ntag after checking the plan\"\n          fi\n          write_outputs\n\n  tag:\n    needs: plan\n    if: needs.plan.outputs.live == 'true' && needs.plan.outputs.count != '0'\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    environment: release\n    permissions:\n      contents: read\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0\n        with:\n          fetch-depth: 0\n          fetch-tags: true\n          ref: main\n          persist-credentials: false\n      - id: app\n        uses: actions/create-github-app-token@fee1f7d63c2ff003460e3d139729b119787bc349 # v2.2.2\n        with:\n          app-id: ${{ vars.RELEASE_APP_ID }}\n          private-key: ${{ secrets.RELEASE_APP_PRIVATE_KEY }}\n          permission-contents: write\n      - id: tag\n        shell: bash\n        env:\n          GH_TOKEN: ${{ steps.app.outputs.token }}\n          PUSH_TOKEN: ${{ steps.app.outputs.token }}\n          APP_SLUG: ${{ steps.app.outputs.app-slug }}\n          BOT_LOGIN: ${{ vars.ARD_BOT_LOGIN }}\n          TAGGER_NAME: ${{ vars.RELEASE_BOT_NAME }}\n          TAGGER_EMAIL: ${{ vars.RELEASE_BOT_EMAIL }}\n          REPO: ${{ github.repository }}\n          BRANCH: main\n          LIVE: ${{ needs.plan.outputs.live }}\n          PLAN_B64: ${{ needs.plan.outputs.plan }}\n        run: |\n          set -euo pipefail\n          export LC_ALL=C\n\n          # Exit 0: every plan row done. 2: stopped at the first failure; the\n          # next run replans from the tags that exist. Never 1.\n          tmpd=\"\"\n          on_exit() {\n            local rc=$?\n            if [[ -n \"$tmpd\" ]]; then rm -rf \"$tmpd\"; fi\n            if [[ $rc -ne 0 && $rc -ne 2 ]]; then\n              echo \"::error title=version::unexpected failure (exit $rc)\"\n              exit 2\n            fi\n          }\n          trap on_exit EXIT\n          esc() {\n            local s=$1\n            s=${s//'%'/%25}\n            s=${s//$'\\r'/%0D}\n            s=${s//$'\\n'/%0A}\n            printf '%s' \"$s\"\n          }\n          fail() { echo \"::error title=version::$(esc \"$1\")\"; exit 2; }\n\n          [[ \"${LIVE:-}\" == true ]] || fail \"refusing to tag: not a live run\"\n          if [[ -z \"${BOT_LOGIN:-}\" ]]; then\n            fail \"set the ARD_BOT_LOGIN repository variable to the App's <slug>[bot] login\"\n          fi\n          shopt -s nocasematch\n          if [[ \"${APP_SLUG:-}[bot]\" == \"$BOT_LOGIN\" ]]; then\n            shopt -u nocasematch\n            fail \"refusing to tag: the release App must not be ard's App ($BOT_LOGIN)\"\n          fi\n          shopt -u nocasematch\n          if [[ -z \"${TAGGER_NAME:-}\" || -z \"${TAGGER_EMAIL:-}\" ]]; then\n            fail \"refusing to tag: set the RELEASE_BOT_NAME and RELEASE_BOT_EMAIL repository variables\"\n          fi\n          [[ -n \"${REPO:-}\" ]] || fail \"REPO is not set\"\n          export GH_REPO=$REPO\n          branch=${BRANCH:-main}\n          head_ref=\"refs/remotes/origin/$branch\"\n          ver_re='^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$'\n\n          tmpd=$(mktemp -d \"${RUNNER_TEMP:-${TMPDIR:-/tmp}}/version.XXXXXX\")\n          plan=$tmpd/plan\n          printf '%s' \"${PLAN_B64:-}\" | base64 --decode >\"$plan\" || fail \"cannot decode the plan\"\n\n          # The token goes in a per-command header, never into .git/config.\n          auth=()\n          if [[ -n \"${PUSH_TOKEN:-}\" ]]; then\n            basic=$(printf 'x-access-token:%s' \"$PUSH_TOKEN\" | base64 | tr -d '\\n')\n            echo \"::add-mask::$basic\"\n            auth=(-c \"http.https://github.com/.extraheader=AUTHORIZATION: basic $basic\")\n          fi\n\n          # Split a plan row on tabs, keeping empty fields.\n          split() {\n            local s=$1\n            F=()\n            while [[ \"$s\" == *$'\\t'* ]]; do\n              F+=(\"${s%%$'\\t'*}\")\n              s=${s#*$'\\t'}\n            done\n            F+=(\"$s\")\n          }\n\n          # Notes: the tag message body and the release notes. The title is\n          # untrusted; a code span keeps mentions, markdown and closing\n          # references from rendering.\n          notes() { # title pr sha bump\n            local t=${1//'`'/\\'} link\n            [[ -n \"$t\" ]] || t=\"(no title)\"\n            if [[ -n \"$2\" ]]; then\n              link=\" ([#$2](https://github.com/$REPO/pull/$2))\"\n            else\n              link=\" (${3:0:7})\"\n            fi\n            # shellcheck disable=SC2016 # literal backticks: a code span\n            printf '`%s`%s\\n\\nBump: %s\\n' \"$t\" \"$link\" \"$4\"\n          }\n\n          # Check every row before acting on any.\n          n=0\n          while IFS= read -r line || [[ -n \"$line\" ]]; do\n            n=$((n + 1))\n            split \"$line\"\n            [[ ${#F[@]} -eq 6 ]] || fail \"plan row $n: want 6 fields, got ${#F[@]}\"\n            case \"${F[0]}\" in\n              tag)\n                [[ \"${F[1]}\" =~ ^[0-9a-f]{40}$ && \"${F[2]}\" =~ $ver_re && \"${F[3]}\" =~ ^[0-9]*$ ]] || fail \"plan row $n is malformed\"\n                case \"${F[4]}\" in major | minor | patch) ;; *) fail \"plan row $n: bad bump\" ;; esac\n                ;;\n              backfill)\n                [[ \"${F[2]}\" =~ $ver_re ]] || fail \"plan row $n is malformed\"\n                ;;\n              *) fail \"plan row $n: unknown kind\" ;;\n            esac\n          done <\"$plan\"\n          if [[ $n -eq 0 ]]; then\n            echo \"empty plan; nothing to do\"\n            exit 0\n          fi\n\n          git rev-parse -q --verify \"$head_ref^{commit}\" >/dev/null || fail \"$head_ref is missing\"\n          declare -A first_parent=()\n          while IFS= read -r c; do first_parent[$c]=1; done < <(git rev-list --first-parent \"$head_ref\")\n\n          # Tags on origin now: name -> commit, and commit -> version tag.\n          git \"${auth[@]}\" ls-remote --tags origin >\"$tmpd/remote\" || fail \"cannot list the tags on origin\"\n          declare -A remote_tag=() remote_ver_at=()\n          while IFS=$'\\t' read -r obj ref; do\n            name=${ref#refs/tags/}\n            name=${name%'^{}'}\n            remote_tag[$name]=1\n            if [[ \"$name\" =~ $ver_re ]]; then\n              # Keyed by the object and, from the peeled ^{} line, by the commit.\n              remote_ver_at[$obj]=$name\n            fi\n          done <\"$tmpd/remote\"\n\n          while IFS= read -r line || [[ -n \"$line\" ]]; do\n            split \"$line\"\n            kind=${F[0]} sha=${F[1]} ver=${F[2]} pr=${F[3]} bump=${F[4]} title=${F[5]}\n\n            if [[ \"$kind\" == backfill ]]; then\n              git rev-parse -q --verify \"refs/tags/$ver\" >/dev/null || fail \"backfill: $ver is not a local tag\"\n              body=\"\"\n              if [[ \"$(git cat-file -t \"refs/tags/$ver\")\" == tag ]]; then\n                body=$(git for-each-ref --format='%(contents:body)' \"refs/tags/$ver\")\n              fi\n              [[ -n \"${body//[[:space:]]/}\" ]] || body=\"Version $ver.\"\n              printf '%s\\n' \"$body\" >\"$tmpd/notes\"\n              gh release create \"$ver\" --verify-tag --title \"$ver\" --notes-file \"$tmpd/notes\" || fail \"release for $ver failed; the next run retries it\"\n              echo \"released $ver (backfill)\"\n              continue\n            fi\n\n            # Re-check against what exists now; never renumber.\n            [[ -n \"${first_parent[$sha]:-}\" ]] || fail \"$sha is not on first-parent origin/$branch; not tagging $ver\"\n            while IFS= read -r t; do\n              [[ \"$t\" =~ $ver_re ]] && fail \"$sha already has version tag $t\"\n            done < <(git tag --points-at \"$sha\")\n            [[ -z \"${remote_ver_at[$sha]:-}\" ]] || fail \"$sha already has version tag ${remote_ver_at[$sha]} on origin\"\n            if git rev-parse -q --verify \"refs/tags/$ver\" >/dev/null || [[ -n \"${remote_tag[$ver]:-}\" ]]; then\n              fail \"$ver already exists; not tagging $sha\"\n            fi\n\n            notes \"$title\" \"$pr\" \"$sha\" \"$bump\" >\"$tmpd/notes\"\n            { printf '%s\\n\\n' \"$ver\"; cat \"$tmpd/notes\"; } >\"$tmpd/msg\"\n            GIT_COMMITTER_NAME=$TAGGER_NAME GIT_COMMITTER_EMAIL=$TAGGER_EMAIL \\\n              git tag -a --cleanup=whitespace -F \"$tmpd/msg\" \"$ver\" \"$sha\" || fail \"cannot create tag $ver\"\n            git \"${auth[@]}\" push origin \"refs/tags/$ver\" || fail \"push of $ver was rejected\"\n            echo \"tagged $sha as $ver\"\n            gh release create \"$ver\" --verify-tag --title \"$ver\" --notes-file \"$tmpd/notes\" || fail \"release for $ver failed; the next run backfills it\"\n            echo \"released $ver\"\n          done <\"$plan\"\n(eval):1: no matches found: --include=*.go\n14:  protected_paths:\n15-    - .github/\n16-    - .ard/config.yaml\n17-    - .ard/scanners/\n18-    - .ard/triage/\n19-    - .ard/workers/\n20-    - .ard/reviewers/\n21-    - \"**/CODEOWNERS\"\n22-    # Agent instructions a PR could plant to steer later agents.\n23-    - CLAUDE.md\n24-    - \"**/CLAUDE.md\"\n25-    - AGENTS.md\n26-    - \"**/AGENTS.md\"\n232dcfc worker diff guard: warn at 2,000 and block at 3,000 changed lines by default (#311)\nf005ec3 prwatch: watch ard's open PRs for status changes (#267) (#310)\n61e9c59 feat: Scanner: lts (#47) (#309)\n37ec441 feat: Shared roles repo (#59) (#308)\n58cb1de ard(triage:engineer): #241 Revises the plan to the owner decision: a token-count config type with… [skip ci]\n7c219ef ard(triage:engineer): #58 Adds a new digest loop that posts one comment a day on the status issue… [skip ci]\n137aad5 ard(triage:lead): #205 The request is clear, but it cannot start yet. It needs the default ard… [skip ci]\nbc8a134 ard(triage:engineer): #178 Plans MkDocs Material user docs under docs/site/, two small helpers tha… [skip ci]\n28:## Layout\n30:[docs/layout.md](docs/layout.md) lists every directory and package and what it holds. Read it to find where code lives; a PR that adds, removes or renames a directory or package updates that file, not this one.","is_error":false}]},"parent_tool_use_id":null,"session_id":"134331be-a9b3-411a-a3cb-0c7c0e56132c","uuid":"1e18b74e-04f5-4860-b545-f1cd2f79f88d","timestamp":"2026-11-24T13:00:39.236Z","tool_use_result":{"stdout":"VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)\nLDFLAGS := -s -w -X main.version=$(VERSION)\n\n.PHONY: build test lint fmt clean cve-fixtures lts-fixtures lint-scanner-fixtures chart-test image-test\n\nbuild:\n\tCGO_ENABLED=0 go build -ldflags \"$(LDFLAGS)\" -o bin/ard ./cmd/ard\n\ntest:\n\tgo test ./...\n\nlint:\n\tgo vet ./...\n\t@out=\"$$(gofmt -l .)\"; if [ -n \"$$out\" ]; then echo \"gofmt needed:\"; echo \"$$out\"; exit 1; fi\n\nfmt:\n\tgofmt -w .\n\n# Renders the two Argo CD charts under deploy/ and checks them (needs helm and yq;\n# run by the ard-ci pipeline, not part of `make test`).\nchart-test:\n\tdeploy/test-charts.sh\n\n# Builds the ard image for both platforms and checks it (needs Docker buildx and\n# network; not part of `make test`).\nimage-test:\n\tdeploy/test-image.sh\n\n# Regenerates the real cve scanner fixtures inside the pinned tool image.\n# Needs Docker and network; not part of `make test`.\ncve-fixtures:\n\tdocker build -t ard-cve-fixtures internal/roles/scanners/cve\n\tdocker run --rm --user \"$$(id -u):$$(id -g)\" -e HOME=/tmp \\\n\t  -v \"$$PWD/internal/roles:/roles\" -w /roles ard-cve-fixtures sh testdata/cve/regen.sh\n\n# Regenerates the real lts API fixtures inside the pinned lts image (see\n# internal/roles/testdata/lts/regen.sh). Needs Docker and network; not part of `make test`.\nlts-fixtures:\n\tdocker build -t ard-lts-fixtures internal/roles/scanners/lts\n\tdocker run --rm --user \"$$(id -u):$$(id -g)\" -e HOME=/tmp \\\n\t  -v \"$$PWD/internal/roles:/roles\" -w /roles ard-lts-fixtures sh testdata/lts/regen.sh\n\n# Regenerates the real lint scanner fixtures in the pinned image (see\n# internal/roles/testdata/lint/regen.sh). Needs Docker; not part of `make test`.\nlint-scanner-fixtures:\n\tdocker build -t ard-lint-fixtures internal/roles/scanners/lint\n\tdocker run --rm --user \"$$(id -u):$$(id -g)\" -e HOME=/tmp \\\n\t  -v \"$$PWD/internal/roles:/roles\" -w /roles ard-lint-fixtures sh testdata/lint/regen.sh\n\nclean:\n\trm -rf bin\nls: internal/versioncheck: No such file or directory\ndocs:\nTODO.md\nlayout.md\nproposal.md\nrunbooks\n\ndocs/runbooks:\ngate-2.md\n\ninternal:\nagent\nagentjob\nbotcheck\nbudget\ncli\ncloseout\ncommitter\nconfig\nconfigcmd\nconfigsrc\ncontroller\ncostblock\ncosts\neffects\nexecutor\ngithub\ngitref\ngitx\ninitcmd\nintake\njanitor\nlabels\nlimits\nmerger\nmodelauth\npool\nprgate\nprwatch\nreaper\nredact\nrepopath\nreviewer\nreviewfix\nroles\nscanner\nservecmd\nstate\ntriage\nworker\nwtlock\n# Versions every PR merge to main as vX.Y.Z (#183). Each run reconciles: it\n# tags every untagged first-parent commit after the newest version tag, oldest\n# first, with an annotated tag and a notes-only release. It never moves or\n# deletes a tag. The bump comes from the merged PR's labels: semver:major,\n# semver:minor, else patch. ard's own main-lane commits (committer ARD_BOT_LOGIN)\n# are skipped; a direct push gets patch.\n#\n# Every run is a dry run until the repository variable ARD_VERSIONING is \"on\".\n# workflow_dispatch is a dry run unless dry_run is false.\n#\n# The logic is inline bash here, not Go, for the reason bot-commits.yml gives:\n# the job holds a tag-writing credential, and .github/ is the one place ard\n# cannot change. It never runs code from the checkout. internal/versioncheck\n# extracts the scripts in steps \"plan\" and \"tag\" and tests them.\nname: version\n\non:\n  push:\n    branches: [main]\n  # Catches merges whose push run was suppressed by [skip ci] or dropped.\n  schedule:\n    - cron: '23 * * * *'\n  workflow_dispatch:\n    inputs:\n      dry_run:\n        description: Plan only; create no tag or release\n        type: boolean\n        default: true\n      max_tags:\n        description: Most tags one run may create\n        type: string\n        default: '20'\n\nconcurrency:\n  group: version-main\n  cancel-in-progress: false\n\npermissions:\n  contents: read\n\njobs:\n  plan:\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    permissions:\n      contents: read\n      pull-requests: read\n    outputs:\n      live: ${{ steps.plan.outputs.live }}\n      count: ${{ steps.plan.outputs.count }}\n      plan: ${{ steps.plan.outputs.plan }}\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0\n        with:\n          fetch-depth: 0\n          fetch-tags: true\n          ref: main\n          persist-credentials: false\n      - id: plan\n        shell: bash\n        env:\n          GH_TOKEN: ${{ github.token }}\n          REPO: ${{ github.repository }}\n          BRANCH: main\n          BOT_LOGIN: ${{ vars.ARD_BOT_LOGIN }}\n          ENABLED: ${{ vars.ARD_VERSIONING }}\n          EVENT: ${{ github.event_name }}\n          INPUT_DRY_RUN: ${{ inputs.dry_run }}\n          MAX_TAGS: ${{ inputs.max_tags }}\n        run: |\n          set -euo pipefail\n          export LC_ALL=C\n\n          # Exit 0: plan written (possibly empty). 2: cannot plan. Never 1.\n          # Plan rows, tab-separated: kind sha tag pr bump title, where kind is\n          # \"tag\" or \"backfill\" (a release for an existing tag).\n          tmpd=\"\"\n          on_exit() {\n            local rc=$?\n            if [[ -n \"$tmpd\" ]]; then rm -rf \"$tmpd\"; fi\n            if [[ $rc -ne 0 && $rc -ne 2 ]]; then\n              echo \"::error title=version::unexpected failure (exit $rc)\"\n              exit 2\n            fi\n          }\n          trap on_exit EXIT\n          esc() {\n            local s=$1\n            s=${s//'%'/%25}\n            s=${s//$'\\r'/%0D}\n            s=${s//$'\\n'/%0A}\n            printf '%s' \"$s\"\n          }\n          fail() { echo \"::error title=version::$(esc \"$1\")\"; exit 2; }\n          warn() { echo \"::warning title=version::$(esc \"$1\")\"; }\n\n          if [[ -z \"${BOT_LOGIN:-}\" ]]; then\n            fail \"set the ARD_BOT_LOGIN repository variable to the App's <slug>[bot] login\"\n          fi\n          [[ -n \"${REPO:-}\" ]] || fail \"REPO is not set\"\n          branch=${BRANCH:-main}\n          head_ref=\"refs/remotes/origin/$branch\"\n          retry_sleep=${RETRY_SLEEP:-5}\n          [[ \"$retry_sleep\" =~ ^[0-9]{1,4}$ ]] || retry_sleep=5\n          retry_max=${RETRY_MAX:-3}\n          [[ \"$retry_max\" =~ ^[0-9]{1,4}$ ]] || retry_max=3\n          max_tags=20\n          if [[ \"${MAX_TAGS:-}\" =~ ^[0-9]{1,6}$ ]]; then\n            max_tags=$((10#$MAX_TAGS))\n          fi\n\n          live=false\n          mode=\"dry run: ARD_VERSIONING is not on\"\n          if [[ \"${ENABLED:-}\" == on ]]; then\n            if [[ \"${EVENT:-}\" != workflow_dispatch || \"${INPUT_DRY_RUN:-}\" == false ]]; then\n              live=true\n              mode=live\n            else\n              mode=\"dry run: workflow_dispatch with dry_run\"\n            fi\n          fi\n\n          tmpd=$(mktemp -d \"${RUNNER_TEMP:-${TMPDIR:-/tmp}}/version.XXXXXX\")\n          plan=$tmpd/plan\n          : >\"$plan\"\n          rows=()\n\n          write_outputs() {\n            local count b64\n            count=$(wc -l <\"$plan\")\n            count=$((count + 0))\n            b64=$(base64 <\"$plan\" | tr -d '\\n')\n            if [[ -n \"${GITHUB_OUTPUT:-}\" ]]; then\n              {\n                echo \"live=$live\"\n                echo \"count=$count\"\n                echo \"plan=$b64\"\n              } >>\"$GITHUB_OUTPUT\"\n            fi\n            echo \"$count plan row(s); $mode\"\n          }\n\n          write_summary() { # note\n            [[ -n \"${GITHUB_STEP_SUMMARY:-}\" ]] || return 0\n            {\n              echo \"### Version plan ($mode)\"\n              echo\n              if [[ ${#rows[@]} -gt 0 ]]; then\n                echo \"| sha | tag | bump | PR |\"\n                echo \"| --- | --- | --- | --- |\"\n                printf '%s\\n' \"${rows[@]}\"\n              else\n                echo \"$1\"\n              fi\n            } >>\"$GITHUB_STEP_SUMMARY\"\n          }\n\n          # api PATH: API_STATUS=ok with API_BODY, or API_STATUS=404.\n          # Any other failure stops the run: it never guesses after an API error.\n          api() {\n            API_BODY=\"\"\n            API_STATUS=\"\"\n            if API_BODY=$(gh api \"$1\" 2>\"$tmpd/gh.err\"); then\n              API_STATUS=ok\n              return 0\n            fi\n            if grep -q 'HTTP 404' \"$tmpd/gh.err\"; then\n              API_STATUS=404\n              return 0\n            fi\n            cat \"$tmpd/gh.err\" >&2\n            fail \"GitHub API call $1 failed\"\n          }\n\n          [[ \"$(git rev-parse --is-shallow-repository)\" == false ]] || fail \"shallow clone; check out with fetch-depth: 0\"\n          git rev-parse -q --verify \"$head_ref^{commit}\" >/dev/null || fail \"$head_ref is missing\"\n          head=$(git rev-parse \"$head_ref^{commit}\")\n\n          # Version tags. Anything not matching ver_re is ignored.\n          ver_re='^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$'\n          vgt() { # x y z X Y Z: is x.y.z greater than X.Y.Z\n            if (($1 != $4)); then (($1 > $4)); return; fi\n            if (($2 != $5)); then (($2 > $5)); return; fi\n            (($3 > $6))\n          }\n          parts() { # tag: sets PX PY PZ\n            [[ \"$1\" =~ $ver_re ]] || fail \"$1 is not a version tag\"\n            if ((${#BASH_REMATCH[1]} > 9 || ${#BASH_REMATCH[2]} > 9 || ${#BASH_REMATCH[3]} > 9)); then\n              fail \"version tag $1 is too large\"\n            fi\n            PX=${BASH_REMATCH[1]}\n            PY=${BASH_REMATCH[2]}\n            PZ=${BASH_REMATCH[3]}\n          }\n          declare -A tag_of=()\n          max_tag=\"\"\n          mx=0 my=0 mz=0\n          while IFS= read -r name; do\n            [[ \"$name\" =~ $ver_re ]] || continue\n            parts \"$name\"\n            x=$PX y=$PY z=$PZ\n            c=$(git rev-parse -q --verify \"refs/tags/$name^{commit}\") || fail \"version tag $name does not point at a commit\"\n            if [[ -n \"${tag_of[$c]:-}\" ]]; then\n              parts \"${tag_of[$c]}\"\n              if vgt \"$x\" \"$y\" \"$z\" \"$PX\" \"$PY\" \"$PZ\"; then tag_of[$c]=$name; fi\n            else\n              tag_of[$c]=$name\n            fi\n            if [[ -z \"$max_tag\" ]] || vgt \"$x\" \"$y\" \"$z\" \"$mx\" \"$my\" \"$mz\"; then\n              max_tag=$name mx=$x my=$y mz=$z\n            fi\n          done < <(git for-each-ref --format='%(refname:strip=2)' 'refs/tags/v*')\n\n          if [[ -z \"$max_tag\" ]]; then\n            if [[ \"$live\" == true ]]; then\n              fail \"no version tag: create the annotated seed tag v0.1.0 (docs/runbooks/release.md)\"\n            fi\n            echo \"::notice title=version::no version tag yet; nothing to plan until an admin creates the annotated seed tag v0.1.0 (docs/runbooks/release.md)\"\n            write_summary \"No version tag yet: create the annotated seed tag v0.1.0 (docs/runbooks/release.md).\"\n            write_outputs\n            exit 0\n          fi\n\n          base=\"\" base_tag=\"\"\n          while IFS= read -r c; do\n            if [[ -n \"${tag_of[$c]:-}\" ]]; then\n              base=$c base_tag=${tag_of[$c]}\n              break\n            fi\n          done < <(git rev-list --first-parent \"$head\")\n          [[ -n \"$base\" ]] || fail \"version tags exist (highest $max_tag) but none is on first-parent origin/$branch\"\n          if [[ \"$max_tag\" != \"$base_tag\" ]]; then\n            warn \"highest version tag $max_tag is not the newest on first-parent origin/$branch ($base_tag); numbering continues from $max_tag\"\n          fi\n\n          # A tag without a release: the seed tag, or a run that died between\n          # pushing a tag and creating its release.\n          api \"repos/$REPO/releases/tags/$base_tag\"\n          if [[ \"$API_STATUS\" == 404 ]]; then\n            printf 'backfill\\t%s\\t%s\\t\\t\\t\\n' \"$base\" \"$base_tag\" >>\"$plan\"\n            rows+=(\"| \\`${base:0:12}\\` | $base_tag | release only | |\")\n            echo \"$base -> $base_tag (release backfill)\"\n          fi\n\n          squash_re='\\(#([0-9]+)\\)$'\n          merge_re='^Merge pull request #([0-9]+) from '\n          # shellcheck disable=SC2016 # jq variables, not shell\n          match='select(.merged_at != null and .merge_commit_sha == $sha and .base.ref == $b)'\n          suffix=\"+${BOT_LOGIN}@users.noreply.github.com\"\n          ntag=0\n          while IFS= read -r -u 3 sha; do\n            ce=$(git log -1 --format=%ce \"$sha\")\n            cn=$(git log -1 --format=%cn \"$sha\")\n            subject=$(git log -1 --format=%s \"$sha\")\n\n            # ard's main-lane commits: the identity test bot-commits.yml uses.\n            bot=0\n            # Case-insensitive; the legacy <login>@users.noreply form and any\n            # control character in the identity (fail closed) also count.\n            shopt -s nocasematch\n            [[ \"$cn\" == \"$BOT_LOGIN\" ]] && bot=1\n            [[ \"$ce\" == \"$BOT_LOGIN@users.noreply.github.com\" ]] && bot=1\n            if [[ \"$ce\" == *\"$suffix\" ]]; then\n              prefix=${ce:0:$((${#ce} - ${#suffix}))}\n              [[ -n \"$prefix\" && \"$prefix\" != *[!0-9]* ]] && bot=1\n            fi\n            shopt -u nocasematch\n            [[ \"$cn\" == *[[:cntrl:]]* || \"$ce\" == *[[:cntrl:]]* ]] && bot=1\n            if [[ $bot == 1 ]]; then\n              echo \"skip $sha (ard main-lane commit)\"\n              continue\n            fi\n\n            subj_pr=\"\"\n            if [[ \"$subject\" =~ $squash_re || \"$subject\" =~ $merge_re ]]; then\n              if ((${#BASH_REMATCH[1]} <= 9)); then subj_pr=$((10#${BASH_REMATCH[1]})); fi\n            fi\n\n            # The merged PR: commits/{sha}/pulls, then the number in the\n            # subject; retried while GitHub's association lags the merge.\n            pr_json=\"\"\n            attempt=0\n            while :; do\n              api \"repos/$REPO/commits/$sha/pulls\"\n              [[ \"$API_STATUS\" == ok ]] || fail \"GitHub API call repos/$REPO/commits/$sha/pulls: HTTP 404\"\n              pr_json=$(jq -c --arg sha \"$sha\" --arg b \"$branch\" \"first(.[] | $match) // empty\" <<<\"$API_BODY\")\n              [[ -n \"$pr_json\" ]] && break\n              [[ -n \"$subj_pr\" ]] || break\n              api \"repos/$REPO/pulls/$subj_pr\"\n              if [[ \"$API_STATUS\" == ok ]]; then\n                pr_json=$(jq -c --arg sha \"$sha\" --arg b \"$branch\" \"$match\" <<<\"$API_BODY\")\n              fi\n              [[ -n \"$pr_json\" ]] && break\n              ((attempt < retry_max)) || break\n              attempt=$((attempt + 1))\n              sleep \"$retry_sleep\"\n            done\n\n            if [[ -n \"$pr_json\" ]]; then\n              pr=$(jq -r '.number' <<<\"$pr_json\")\n              title=$(jq -r '.title // \"\"' <<<\"$pr_json\")\n              major=$(jq -r 'any(.labels[]?; .name == \"semver:major\")' <<<\"$pr_json\")\n              minor=$(jq -r 'any(.labels[]?; .name == \"semver:minor\")' <<<\"$pr_json\")\n              who=\"PR #$pr\"\n            else\n              warn \"$sha has no merged PR; patch bump\"\n              pr=\"\" title=$subject major=false minor=false\n              who=\"commit $sha\"\n            fi\n            [[ \"$pr\" =~ ^[0-9]*$ ]] || fail \"$sha: unexpected PR number\"\n            title=$(jq -rn --arg t \"$title\" '$t | gsub(\"\\\\p{Cc}\"; \" \") | .[0:200]')\n\n            if [[ \"$major\" == true ]]; then\n              bump=\"major\"\n              if [[ \"$minor\" == true ]]; then warn \"PR #$pr has both semver labels; major wins\"; fi\n              mx=$((mx + 1)) my=0 mz=0\n            elif [[ \"$minor\" == true ]]; then\n              bump=\"minor\"\n              my=$((my + 1)) mz=0\n            else\n              bump=\"patch\"\n              mz=$((mz + 1))\n            fi\n            ver=\"v$mx.$my.$mz\"\n\n            # Go requires the /vN module path for a vN tag, N >= 2, and none below.\n            mod=\"\"\n            if git cat-file -e \"$sha:go.mod\" 2>/dev/null; then\n              mod=$(git cat-file blob \"$sha:go.mod\" | awk '$1 == \"module\" { m = $2 } END { print m }')\n              mod=${mod//\\\"/}\n            fi\n            s=0\n            if [[ \"$mod\" =~ /v([0-9]{1,9})$ ]] && ((10#${BASH_REMATCH[1]} >= 2)); then\n              s=$((10#${BASH_REMATCH[1]}))\n            fi\n            if ! { ((mx >= 2 && s == mx)) || ((mx < 2 && s == 0)); }; then\n              if ((mx >= 2)); then need=\"module path ending in /v$mx\"; else need=\"module path without a /vN suffix\"; fi\n              fail \"$who ($sha) would be $ver, which needs a $need, but go.mod declares module '$mod'. Relabel the PR and rerun, or change go.mod.\"\n            fi\n\n            printf 'tag\\t%s\\t%s\\t%s\\t%s\\t%s\\n' \"$sha\" \"$ver\" \"$pr\" \"$bump\" \"$title\" >>\"$plan\"\n            if [[ -n \"$pr\" ]]; then\n              echo \"$sha -> $ver ($bump, #$pr)\"\n              rows+=(\"| \\`${sha:0:12}\\` | $ver | $bump | #$pr |\")\n            else\n              echo \"$sha -> $ver ($bump, no PR)\"\n              rows+=(\"| \\`${sha:0:12}\\` | $ver | $bump | none |\")\n            fi\n            ntag=$((ntag + 1))\n          done 3< <(git rev-list --first-parent --reverse \"$base..$head\")\n\n          write_summary \"Nothing to tag: $base_tag is current.\"\n          if ((ntag > max_tags)); then\n            fail \"$ntag untagged merges, over the cap of $max_tags; rerun with workflow_dispatch max_tags=$ntag after checking the plan\"\n          fi\n          write_outputs\n\n  tag:\n    needs: plan\n    if: needs.plan.outputs.live == 'true' && needs.plan.outputs.count != '0'\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    environment: release\n   