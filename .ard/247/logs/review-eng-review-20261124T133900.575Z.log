0b4529..24db356 100644\n--- a/cmd/ard/main.go\n+++ b/cmd/ard/main.go\n@@ -5,6 +5,7 @@ package main\n import (\n \t\"io\"\n \t\"os\"\n+\t\"runtime/debug\"\n \n \t\"github.com/albertcbrown/ard/internal/cli\"\n \t\"github.com/albertcbrown/ard/internal/configcmd\"\n@@ -21,7 +22,20 @@ func main() {\n }\n \n func run(args []string, stdout, stderr io.Writer) int {\n-\treturn cli.Run(args, stdout, stderr, handlers(), version)\n+\tinfo, ok := debug.ReadBuildInfo()\n+\treturn cli.Run(args, stdout, stderr, handlers(), resolveVersion(version, info, ok))\n+}\n+\n+// resolveVersion prefers the -X main.version value. Without it, a binary\n+// from \"go install ...@vX.Y.Z\" carries the tag only in its build info.\n+func resolveVersion(v string, info *debug.BuildInfo, ok bool) string {\n+\tif v != \"dev\" {\n+\t\treturn v\n+\t}\n+\tif ok && info != nil && info.Main.Version != \"\" && info.Main.Version != \"(devel)\" {\n+\t\treturn info.Main.Version\n+\t}\n+\treturn \"dev\"\n }\n \n // handlers wires one function per subcommand. Each new command adds one\ndiff --git a/cmd/ard/main_test.go b/cmd/ard/main_test.go\nindex 90dfa50..2d132ec 100644\n--- a/cmd/ard/main_test.go\n+++ b/cmd/ard/main_test.go\n@@ -4,6 +4,7 @@ import (\n \t\"bytes\"\n \t\"os\"\n \t\"path/filepath\"\n+\t\"runtime/debug\"\n \t\"strings\"\n \t\"testing\"\n )\n@@ -51,3 +52,29 @@ func TestInitOutsideRepoExitsOne(t *testing.T) {\n \t\tt.Error(\"init wrote .ard/\")\n \t}\n }\n+\n+func TestResolveVersion(t *testing.T) {\n+\tinfo := func(v string) *debug.BuildInfo {\n+\t\treturn &debug.BuildInfo{Main: debug.Module{Version: v}}\n+\t}\n+\ttests := []struct {\n+\t\tname string\n+\t\tv    string\n+\t\tinfo *debug.BuildInfo\n+\t\tok   bool\n+\t\twant string\n+\t}{\n+\t\t{\"ldflag wins\", \"v1.2.3\", info(\"v9.9.9\"), true, \"v1.2.3\"},\n+\t\t{\"build info tag\", \"dev\", info(\"v1.4.0\"), true, \"v1.4.0\"},\n+\t\t{\"devel\", \"dev\", info(\"(devel)\"), true, \"dev\"},\n+\t\t{\"empty\", \"dev\", info(\"\"), true, \"dev\"},\n+\t\t{\"no build info\", \"dev\", nil, false, \"dev\"},\n+\t}\n+\tfor _, tt := range tests {\n+\t\tt.Run(tt.name, func(t *testing.T) {\n+\t\t\tif got := resolveVersion(tt.v, tt.info, tt.ok); got != tt.want {\n+\t\t\t\tt.Errorf(\"got %q, want %q\", got, tt.want)\n+\t\t\t}\n+\t\t})\n+\t}\n+}\ndiff --git a/docs/layout.md b/docs/layout.md\nindex 8984b19..4b700b4 100644\n--- a/docs/layout.md\n+++ b/docs/layout.md\n@@ -6,6 +6,7 @@ Every top-level directory and Go package, with what it holds. Keep it current: a\n cmd/ard/                    CLI entry point; wire a new subcommand by adding one line to handlers()\n internal/cli/               cobra command tree, global flags, slog logging; Handlers is the plug-in point\n internal/botcheck/          tests for the bot-commit audit in .github/workflows/bot-commits.yml\n+internal/versioncheck/       tests for the version workflow in .github/workflows/version.yml (plan and tag scripts)\n internal/github/            GitHub client: domain types, Reader/Writer/Client, App auth, retry transport; query/ (search builder), fake/ (test double), clienttest/ (conformance suite)\n internal/config/            .ard/config.yaml + role directory loading into a Resolved value (pure, fs.FS in)\n internal/configcmd/         `ard config check` handler: prints the resolved config, returns validation errors; `--ref` checks a commit\ndiff --git a/docs/proposal.md b/docs/proposal.md\nindex cec8c5c..2e9b1cf 100644\n--- a/docs/proposal.md\n+++ b/docs/proposal.md\n@@ -487,6 +487,7 @@ Agents with push access read text that strangers can write, so the controls sit\n - **Planted repo config does not steer agents.** A branch can carry CLAUDE.md, AGENTS.md, `.claude/` settings, hooks, skills, agents or a `.mcp.json`. The Claude adapter's flags stop all of them loading (see Executors). Residual risk: auth isolation comes from the empty per-job config dir and HOME, not a flag (the CLI reads no Keychain entry but the one keyed to the per-job dir); a host-mode job on macOS still runs as the operator's uid, so agent Bash could call `security` against the operator's login Keychain, including Claude's own entry, which is within the host-mode risk of #84 (a Dockerfile role or a dedicated macOS user for `ard serve` closes it); the subscription token is a one-year, model-only credential, rotated by running `claude setup-token` again and restarting `ard serve`; `--max-budget-usd` and `total_cost_usd` are estimates on a subscription; part of the block (AGENTS.md, and CLAUDE.md under `--restricted`) is observed behaviour that holds only on the tested CLI version and is re-checked by the integration tests; built-in plugins and the host's managed settings still apply; system reminders and fixed CLI prompt text are back; isolation of settings `env` is not pinned by a test, since no Bash call is scripted; Bash can still read anything the process can (host mode, #84); and an agent can rewrite CLAUDE.md or `.claude/` in its worktree, which later runs ignore but a worker PR could carry into the target repo (the `ard init` protected-path defaults cover `CLAUDE.md`, `AGENTS.md`, `.claude/` and `.mcp.json`, so such a PR needs a human).\n - **Agents write only their own files.** Close-out lets a job change under `.ard/<issue#>/` only its own role file and what its role owns (a `plan.md` section, `design/`); anything else fails the job as `needs-human` and is not committed (see the `.ard/` contract).\n - **Role files are human-owned.** The diff guard and the committer's code lane reject any worker change under `.ard/` or `.github/` (so `.ard/config.yaml` and every role directory), and the merger treats those paths as protected through `merge.protected_paths` (the `ard init` defaults), so no agent can rewrite its own prompt. `ard init` only proposes them, in a PR a human merges.\n+- **The tag-writing credential is separate.** Only the `tag` job of `version.yml`, in the `release` environment, holds a token that can push tags, from a release App that must differ from ard's App (the job refuses otherwise). Tags are never moved or deleted. The logic is inline bash under `.github/`, which agents cannot change, and `internal/versioncheck` tests it.\n - **Merges are gated.** The merger lands a PR only when every review passed and required checks (read from the branch rules API) are green on an up-to-date branch; protected paths wait for a write-access human approval. The App bypasses `main`'s ruleset (its direct `.ard/` commits need it), so the merger's own check that required checks are green is what gates a merge, backed by the bot-commit audit.\n - **Agent text cannot close issues.** Agent text in a commit message, PR title or PR body has closing references neutralised (`committer.NeutraliseRefs`: \"Fixes #12\" becomes \"Fixes issue 12\"). Only a closing keyword directly before a reference closes an issue on GitHub, so only those are rewritten, including the HTML-entity (`&#35;12`, `&#x23;12`, `&num;12`) and backslash-escaped (`\\#12`) forms, which markdown renders as `#12`; \"fixed a typo in #12's test\" is left alone. Only ard's own `Closes #<issue>` on the worker PR closes an issue.\n - **Worker diffs are scanned.** The worker's diff is checked for known credential values and for secret patterns on the lines the job added. A hit holds the change for a human (the comment names file, line and rule, never text). Test fixtures that look like credentials must be built at run time, as `internal/redact`'s tests do; a literal is held.\n@@ -523,7 +524,8 @@ How ard itself is built, published and deployed. Jenkins and Argo CD do the work\n - **Checks.** The Jenkins multibranch job `ard-ci` builds every same-repository branch and pull request, `worker/*` branches included, but never forks, with `make lint`, `make test`, `make build` and `make chart-test`. Its pipeline is loaded from the deployment repository, never from the branch, so branch code supplies only those targets and runs in a pod with no credential and no service account token. `main` requires both its status, `continuous-integration/jenkins/pr-merge`, and the Actions `test` job ([#219](https://github.com/albertcbrown/ard/issues/219)): Jenkins stops reporting to a PR it has seen close, so a PR that merged before Jenkins finished kept a `pending` status for good. A fork PR gets no Jenkins build, so a maintainer pushes it to a same-repository branch to merge it. `ci.yml` and `bot-commits.yml` stay as they are.\n - **Publish.** A green `main` build starts `ard-build`, whose Jenkinsfile is not in this repository, so nothing merged here can reach its credentials. It builds the `Dockerfile` for `linux/amd64` and `linux/arm64` (no emulation: every `RUN` cross-compiles or downloads on the build platform), signs the digest with cosign, and pushes `ghcr.io/albertcbrown/ard:sha-<7>` (never re-pushed) and `:main`.\n - **Deploy.** A deploy job verifies the signature and the revision label, checks the new commit descends from the pinned one, and pins the digest and commit in the deployment repository. Argo CD renders this repository's `deploy/argocd` chart (the app of apps) with that pin and the site's values: one child Application per target repository, named `ard-<instance>`, reading `deploy/charts/ard-serve` at the pinned commit, so chart and image move together. The cluster admits no other Application from that chart.\n-- **Release.** An annotated tag `vX.Y.Z` (`git tag -a`) builds that commit with `VERSION=vX.Y.Z`, pushes `:vX.Y.Z` and moves `:latest` when it is the highest version. Release tags are annotated because Jenkins builds only tags at most a day old and dates a lightweight tag by its commit, so a lightweight tag on an older commit never builds. Releases do not change what is deployed, which follows `main`.\n+- **Versioning ([#183](https://github.com/albertcbrown/ard/issues/183)).** `version.yml` gives every first-parent merge to `main` an annotated tag `vX.Y.Z` and a notes-only release, oldest first. The bump comes from the merged PR's labels: `semver:major`, `semver:minor`, else patch; a direct push gets patch, and ard's own main-lane commits (committer `ARD_BOT_LOGIN`) are skipped. The seed tag is `v0.1.0`. The workflow is a dry run until the repository variable `ARD_VERSIONING` is `on`. `make build` (`git describe` limited to plain `vX.Y.Z` tags) and `go install ...@vX.Y.Z` (build info) both print the tag from `ard version`. `internal/versioncheck` tests the workflow's scripts. See `docs/runbooks/release.md`.\n+- **Release.** An annotated tag `vX.Y.Z` (`git tag -a`) builds that commit with `VERSION=vX.Y.Z`, pushes `:vX.Y.Z` and moves `:latest` when it is the highest version. Release tags are annotated because Jenkins builds only tags at most a day old and dates a lightweight tag by its commit, so a lightweight tag on an older commit never builds. Every merge to `main` is tagged by the Versioning step above; releases do not change what is deployed, which follows `main`.\n - **Kill switch in a cluster.** `kubectl -n <namespace> exec deploy/ard-<instance> -- touch /home/ard/.ard/pause/<owner>/<repo>` pauses `ard serve`; `rm` resumes.\n \n ## Rollout\ndiff --git a/docs/runbooks/release.md b/docs/runbooks/release.md\nnew file mode 100644\nindex 0000000..4194a43\n--- /dev/null\n+++ b/docs/runbooks/release.md\n@@ -0,0 +1,33 @@\n+# Release runbook\n+\n+`.github/workflows/version.yml` tags every first-parent merge to `main` as `vX.Y.Z` and creates a notes-only release. This runbook covers setup and recovery. Names come from the workflow.\n+\n+## Seed tag\n+\n+An admin creates the annotated seed tag once, on a commit on `main`:\n+\n+```\n+git tag -a v0.1.0 <sha> -m v0.1.0\n+git push origin refs/tags/v0.1.0\n+```\n+\n+Until it exists a dry run plans nothing and a live run fails.\n+\n+## Settings checklist\n+\n+- Repository variables: `ARD_BOT_LOGIN` (ard's App login, `<slug>[bot]`), `ARD_VERSIONING` (`on` for live), `RELEASE_APP_ID`, `RELEASE_BOT_NAME`, `RELEASE_BOT_EMAIL`.\n+- A `release` environment holding the secret `RELEASE_APP_PRIVATE_KEY`. The release App needs contents: write only, and must not be ard's App.\n+\n+## Dry run to live\n+\n+Every run is a dry run until `ARD_VERSIONING` is `on`. Check the plan in a dry run's step summary, then set the variable. `workflow_dispatch` is a dry run unless `dry_run` is false; `max_tags` (default 20) caps the tags one run creates, so raise it after reading the plan when a backlog is larger.\n+\n+## Bumps and the module path\n+\n+Label a PR `semver:minor` or `semver:major`; with neither it is a patch, and with both major wins. Go requires a `/vN` module path for N >= 2. A `semver:major` that would reach v2 stops the run (exit 2) until `go.mod` says `module .../v2`; relabel the PR or change `go.mod`, then rerun.\n+\n+## Recovery\n+\n+- A failed run stops at the first failure. Rerun it: the plan is rebuilt from the tags that exist, and a tag without a release gets a release-only backfill row.\n+- Never delete or move a tag. If a tag is wrong, fix forward with the next version.\n+- `ard version` prints the tag after `make build` on a tagged commit, and after `go install github.com/albertcbrown/ard/cmd/ard@vX.Y.Z`.\ndiff --git a/internal/versioncheck/doc.go b/internal/versioncheck/doc.go\nnew file mode 100644\nindex 0000000..1535428\n--- /dev/null\n+++ b/internal/versioncheck/doc.go\n@@ -0,0 +1,5 @@\n+// Package versioncheck only tests the version workflow. The logic is the pair\n+// of inline scripts in steps \"plan\" and \"tag\" of .github/workflows/version.yml;\n+// the tests extract them from the YAML and run them against throwaway bare\n+// repositories and a fake gh.\n+package versioncheck\ndiff --git a/internal/versioncheck/versioncheck_test.go b/internal/versioncheck/versioncheck_test.go\nnew file mode 100644\nindex 0000000..f305dbe\n--- /dev/null\n+++ b/internal/versioncheck/versioncheck_test.go\n@@ -0,0 +1,691 @@\n+package versioncheck_test\n+\n+import (\n+\t\"bytes\"\n+\t\"encoding/base64\"\n+\t\"encoding/json\"\n+\t\"errors\"\n+\t\"os\"\n+\t\"os/exec\"\n+\t\"path/filepath\"\n+\t\"strconv\"\n+\t\"strings\"\n+\t\"testing\"\n+\n+\t\"gopkg.in/yaml.v3\"\n+)\n+\n+const (\n+\tworkflowPath = \"../../.github/workflows/version.yml\"\n+\trepo         = \"o/r\"\n+\tbotLogin     = \"ard-test[bot]\"\n+\tsha40        = \"0123456789012345678901234567890123456789\"\n+)\n+\n+func loadYAML(t *testing.T) map[string]any {\n+\tt.Helper()\n+\tb, err := os.ReadFile(workflowPath)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tvar m map[string]any\n+\tif err := yaml.Unmarshal(b, &m); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\treturn m\n+}\n+\n+func as[T any](t *testing.T, v any, what string) T {\n+\tt.Helper()\n+\tx, ok := v.(T)\n+\tif !ok {\n+\t\tt.Fatalf(\"%s: unexpected %T\", what, v)\n+\t}\n+\treturn x\n+}\n+\n+// script returns the run: block of step id in job.\n+func script(t *testing.T, job, id string) string {\n+\tt.Helper()\n+\tjobs := as[map[string]any](t, loadYAML(t)[\"jobs\"], \"jobs\")\n+\tj := as[map[string]any](t, jobs[job], job)\n+\tfor _, s := range as[[]any](t, j[\"steps\"], \"steps\") {\n+\t\tm := as[map[string]any](t, s, \"step\")\n+\t\tif m[\"id\"] == id {\n+\t\t\trun := as[string](t, m[\"run\"], \"run\")\n+\t\t\tif strings.Contains(run, \"${{\") {\n+\t\t\t\tt.Fatal(\"run: must not contain ${{ }}; pass inputs through env\")\n+\t\t\t}\n+\t\t\treturn run\n+\t\t}\n+\t}\n+\tt.Fatalf(\"step %s/%s not found\", job, id)\n+\treturn \"\"\n+}\n+\n+// bash4 finds a bash that supports declare -A.\n+func bash4(t *testing.T) string {\n+\tt.Helper()\n+\tfor _, c := range []string{\"bash\", \"/opt/homebrew/bin/bash\", \"/usr/local/bin/bash\"} {\n+\t\tp, err := exec.LookPath(c)\n+\t\tif err != nil {\n+\t\t\tcontinue\n+\t\t}\n+\t\tout, err := exec.Command(p, \"-c\", \"echo ${BASH_VERSINFO[0]}\").Output()\n+\t\tif err == nil && strings.TrimSpace(string(out)) >= \"4\" {\n+\t\t\treturn p\n+\t\t}\n+\t}\n+\tt.Skip(\"needs bash 4 or newer\")\n+\treturn \"\"\n+}\n+\n+func gitEnv(extra ...string) []string {\n+\treturn append(append(os.Environ(), \"GIT_CONFIG_GLOBAL=/dev/null\", \"GIT_CONFIG_SYSTEM=/dev/null\",\n+\t\t\"GIT_AUTHOR_NAME=Test\", \"GIT_AUTHOR_EMAIL=test@example.com\",\n+\t\t\"GIT_COMMITTER_NAME=Test\", \"GIT_COMMITTER_EMAIL=test@example.com\"), extra...)\n+}\n+\n+func git(t *testing.T, dir string, env []string, args ...string) string {\n+\tt.Helper()\n+\tcmd := exec.Command(\"git\", args...)\n+\tcmd.Dir = dir\n+\tcmd.Env = gitEnv(env...)\n+\tout, err := cmd.CombinedOutput()\n+\tif err != nil {\n+\t\tt.Fatalf(\"git %q: %v\\n%s\", args, err, out)\n+\t}\n+\treturn strings.TrimSpace(string(out))\n+}\n+\n+type ident struct{ name, email string }\n+\n+var human = ident{\"Test\", \"test@example.com\"}\n+\n+const fakeGH = `#!/bin/bash\n+# fake gh: \"api PATH\" reads $GHSTATE/api/<PATH with / as _>.json\n+case \"$1\" in\n+api)\n+  f=\"$GHSTATE/api/${2//\\//_}.json\"\n+  n=$(cat \"$f.n\" 2>/dev/null || echo 0)\n+  echo $((n + 1)) >\"$f.n\"\n+  if [[ -f \"$f.err\" ]]; then echo \"gh: Server Error (HTTP 500)\" >&2; exit 1; fi\n+  if [[ $n -eq 0 && -f \"$f.first\" ]]; then cat \"$f.first\"; exit 0; fi\n+  if [[ -f \"$f\" ]]; then cat \"$f\"; exit 0; fi\n+  echo \"gh: Not Found (HTTP 404)\" >&2; exit 1 ;;\n+release)\n+  echo \"$*\" >>\"$GHSTATE/release.log\"\n+  [[ ! -f \"$GHSTATE/release.fail\" ]] || exit 1\n+  exit 0 ;;\n+esac\n+exit 1\n+`\n+\n+type fx struct {\n+\tt             *testing.T\n+\tbash          string\n+\torigin, clone string\n+\tstate         string\n+}\n+\n+func newFx(t *testing.T, seedTag, gomod string) *fx {\n+\tt.Helper()\n+\tif _, err := exec.LookPath(\"jq\"); err != nil {\n+\t\tt.Skip(\"needs jq\")\n+\t}\n+\td := t.TempDir()\n+\tf := &fx{t: t, bash: bash4(t), origin: filepath.Join(d, \"origin.git\"), clone: filepath.Join(d, \"clone\"),\n+\t\tstate: filepath.Join(d, \"state\")}\n+\tif err := os.MkdirAll(filepath.Join(f.state, \"api\"), 0o755); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tbin := filepath.Join(d, \"bin\")\n+\tif err := os.MkdirAll(bin, 0o755); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif err := os.WriteFile(filepath.Join(bin, \"gh\"), []byte(fakeGH), 0o755); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tt.Setenv(\"PATH\", bin+string(os.PathListSeparator)+os.Getenv(\"PATH\"))\n+\tt.Setenv(\"GHSTATE\", f.state)\n+\tgit(t, d, nil, \"init\", \"-q\", \"--bare\", \"-b\", \"main\", f.origin)\n+\tgit(t, d, nil, \"init\", \"-q\", \"-b\", \"main\", f.clone)\n+\tgit(t, f.clone, nil, \"remote\", \"add\", \"origin\", f.origin)\n+\tf.setGoMod(gomod)\n+\tf.commit(\"seed\", human)\n+\tif seedTag != \"\" {\n+\t\tgit(t, f.clone, nil, \"tag\", \"-a\", \"-m\", seedTag, seedTag)\n+\t\tgit(t, f.clone, nil, \"push\", \"-q\", \"origin\", \"refs/tags/\"+seedTag)\n+\t\tf.ghJSON(\"repos/\"+repo+\"/releases/tags/\"+seedTag, map[string]any{\"tag_name\": seedTag})\n+\t}\n+\treturn f\n+}\n+\n+func (f *fx) setGoMod(module string) {\n+\tf.t.Helper()\n+\tbody := \"module \" + module + \"\\n\\ngo 1.22\\n\"\n+\tif err := os.WriteFile(filepath.Join(f.clone, \"go.mod\"), []byte(body), 0o644); err != nil {\n+\t\tf.t.Fatal(err)\n+\t}\n+\tgit(f.t, f.clone, nil, \"add\", \"go.mod\")\n+}\n+\n+// commit makes a commit on main, pushes it and returns its sha.\n+func (f *fx) commit(subject string, c ident) string {\n+\tf.t.Helper()\n+\tgit(f.t, f.clone, []string{\"GIT_COMMITTER_NAME=\" + c.name, \"GIT_COMMITTER_EMAIL=\" + c.email},\n+\t\t\"commit\", \"-q\", \"--allow-empty\", \"-m\", subject)\n+\tgit(f.t, f.clone, nil, \"push\", \"-q\", \"origin\", \"main\")\n+\treturn git(f.t, f.clone, nil, \"rev-parse\", \"HEAD\")\n+}\n+\n+// merge makes a --no-ff merge commit of a side branch.\n+func (f *fx) merge(subject string) string {\n+\tf.t.Helper()\n+\tgit(f.t, f.clone, nil, \"checkout\", \"-q\", \"-b\", \"side\")\n+\tgit(f.t, f.clone, nil, \"commit\", \"-q\", \"--allow-empty\", \"-m\", \"side work\")\n+\tgit(f.t, f.clone, nil, \"checkout\", \"-q\", \"main\")\n+\tgit(f.t, f.clone, nil, \"merge\", \"-q\", \"--no-ff\", \"-m\", subject, \"side\")\n+\tgit(f.t, f.clone, nil, \"branch\", \"-q\", \"-D\", \"side\")\n+\tgit(f.t, f.clone, nil, \"push\", \"-q\", \"origin\", \"main\")\n+\treturn git(f.t, f.clone, nil, \"rev-parse\", \"HEAD\")\n+}\n+\n+// ghFile writes a fake API answer; suffix is \"\" (normal), \".first\" (first\n+// call only) or \".err\" (a server error).\n+func (f *fx) ghFile(path, suffix, body string) {\n+\tf.t.Helper()\n+\tp := filepath.Join(f.state, \"api\", strings.ReplaceAll(path, \"/\", \"_\")+\".json\"+suffix)\n+\tif err := os.WriteFile(p, []byte(body), 0o644); err != nil {\n+\t\tf.t.Fatal(err)\n+\t}\n+}\n+\n+func (f *fx) ghJSON(path string, v any) {\n+\tf.t.Helper()\n+\tb, _ := json.Marshal(v)\n+\tf.ghFile(path, \"\", string(b))\n+}\n+\n+// pr registers a merged PR for sha.\n+func (f *fx) pr(sha string, n int, title string, labels ...string) {\n+\tf.t.Helper()\n+\tls := []map[string]string{}\n+\tfor _, l := range labels {\n+\t\tls = append(ls, map[string]string{\"name\": l})\n+\t}\n+\tp := map[string]any{\"number\": n, \"title\": title, \"merged_at\": \"2026-01-01T00:00:00Z\",\n+\t\t\"merge_commit_sha\": sha, \"base\": map[string]string{\"ref\": \"main\"}, \"labels\": ls}\n+\tf.ghJSON(\"repos/\"+repo+\"/commits/\"+sha+\"/pulls\", []any{p})\n+\tf.ghJSON(\"repos/\"+repo+\"/pulls/\"+strconv.Itoa(n), p)\n+}\n+\n+func (f *fx) noPRs(sha string) {\n+\tf.ghJSON(\"repos/\"+repo+\"/commits/\"+sha+\"/pulls\", []any{})\n+}\n+\n+type result struct {\n+\tcode int\n+\tout  string\n+\trows [][]string\n+\tlive string\n+\traw  []byte\n+\tcnt  string\n+}\n+\n+func (f *fx) run(script string, env map[string]string, out string) result {\n+\tf.t.Helper()\n+\tcmd := exec.Command(f.bash, \"-c\", script)\n+\tcmd.Dir = f.clone\n+\tcmd.Env = gitEnv(\"GITHUB_OUTPUT=\"+out, \"GITHUB_STEP_SUMMARY=\"+filepath.Join(f.t.TempDir(), \"sum\"))\n+\tfor k, v := range env {\n+\t\tcmd.Env = append(cmd.Env, k+\"=\"+v)\n+\t}\n+\tvar buf bytes.Buffer\n+\tcmd.Stdout, cmd.Stderr = &buf, &buf\n+\terr := cmd.Run()\n+\tcode := 0\n+\tvar ee *exec.ExitError\n+\tif errors.As(err, &ee) {\n+\t\tcode = ee.ExitCode()\n+\t} else if err != nil {\n+\t\tf.t.Fatal(err)\n+\t}\n+\treturn result{code: code, out: buf.String()}\n+}\n+\n+// plan runs the plan script after fetching origin.\n+func (f *fx) plan(env map[string]string) result {\n+\tf.t.Helper()\n+\tgit(f.t, f.clone, nil, \"fetch\", \"-q\", \"--tags\", \"origin\")\n+\te := map[string]string{\"REPO\": repo, \"BRANCH\": \"main\", \"BOT_LOGIN\": botLogin, \"ENABLED\": \"on\",\n+\t\t\"EVENT\": \"push\", \"RETRY_SLEEP\": \"0\", \"RETRY_MAX\": \"3\"}\n+\tfor k, v := range env {\n+\t\te[k] = v\n+\t}\n+\tout := filepath.Join(f.t.TempDir(), \"out\")\n+\tr := f.run(script(f.t, \"plan\", \"plan\"), e, out)\n+\tb, _ := os.ReadFile(out)\n+\tfor _, l := range strings.Split(string(b), \"\\n\") {\n+\t\tk, v, _ := strings.Cut(l, \"=\")\n+\t\tswitch k {\n+\t\tcase \"live\":\n+\t\t\tr.live = v\n+\t\tcase \"count\":\n+\t\t\tr.cnt = v\n+\t\tcase \"plan\":\n+\t\t\traw, err := base64.StdEncoding.DecodeString(v)\n+\t\t\tif err != nil {\n+\t\t\t\tf.t.Fatal(err)\n+\t\t\t}\n+\t\t\tr.raw = raw\n+\t\t\tfor _, row := range strings.Split(strings.TrimSuffix(string(raw), \"\\n\"), \"\\n\") {\n+\t\t\t\tif row != \"\" {\n+\t\t\t\t\tr.rows = append(r.rows, strings.Split(row, \"\\t\"))\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\t}\n+\treturn r\n+}\n+\n+func (f *fx) tag(plan []byte, env map[string]string) result {\n+\tf.t.Helper()\n+\te := map[string]string{\"REPO\": repo, \"BRANCH\": \"main\", \"BOT_LOGIN\": botLogin, \"LIVE\": \"true\",\n+\t\t\"APP_SLUG\": \"release-app\", \"TAGGER_NAME\": \"Release Bot\", \"TAGGER_EMAIL\": \"release@example.com\",\n+\t\t\"PLAN_B64\": base64.StdEncoding.EncodeToString(plan)}\n+\tfor k, v := range env {\n+\t\te[k] = v\n+\t}\n+\treturn f.run(script(f.t, \"tag\", \"tag\"), e, \"\")\n+}\n+\n+func (f *fx) releases() string {\n+\tb, _ := os.ReadFile(filepath.Join(f.state, \"release.log\"))\n+\treturn string(b)\n+}\n+\n+// want checks the plan rows, each as \"kind tag pr bump\".\n+func want(t *testing.T, r result, rows ...string) {\n+\tt.Helper()\n+\tif r.code != 0 {\n+\t\tt.Fatalf(\"exit %d\\n%s\", r.code, r.out)\n+\t}\n+\tvar got []string\n+\tfor _, row := range r.rows {\n+\t\tif len(row) != 6 {\n+\t\t\tt.Fatalf(\"bad row %q\", row)\n+\t\t}\n+\t\tgot = append(got, strings.Join([]string{row[0], row[2], row[3], row[4]}, \" \"))\n+\t}\n+\tif strings.Join(got, \"|\") != strings.Join(rows, \"|\") {\n+\t\tt.Fatalf(\"rows = %q, want %q\\n%s\", got, rows, r.out)\n+\t}\n+}\n+\n+func TestPlanCommitKinds(t *testing.T) {\n+\tt.Run(\"squash\", func(t *testing.T) {\n+\t\tf := newFx(t, \"v0.1.0\", \"example.com/ard\")\n+\t\ts := f.commit(\"t (#5)\", human)\n+\t\tf.pr(s, 5, \"t\")\n+\t\twant(t, f.plan(nil), \"tag v0.1.1 5 patch\")\n+\t})\n+\tt.Run(\"merge commit\", func(t *testing.T) {\n+\t\tf := newFx(t, \"v0.1.0\", \"example.com/ard\")\n+\t\ts := f.merge(\"Merge pull request #6 from a/b\")\n+\t\tf.pr(s, 6, \"b\")\n+\t\twant(t, f.plan(nil), \"tag v0.1.1 6 patch\")\n+\t})\n+\tt.Run(\"direct push\", func(t *testing.T) {\n+\t\tf := newFx(t, \"v0.1.0\", \"example.com/ard\")\n+\t\ts := f.commit(\"fix it\", human)\n+\t\tf.noPRs(s)\n+\t\tr := f.plan(nil)\n+\t\twant(t, r, \"tag v0.1.1  patch\")\n+\t\tif !strings.Contains(r.out, \"no merged PR\") {\n+\t\t\tt.Errorf(\"no warning:\\n%s\", r.out)\n+\t\t}\n+\t})\n+}\n+\n+func TestPlanLabels(t *testing.T) {\n+\ttests := []struct {\n+\t\tname   string\n+\t\tlabels []string\n+\t\twant   string\n+\t\twarn   string\n+\t}{\n+\t\t{\"none\", nil, \"tag v0.1.1 5 patch\", \"\"},\n+\t\t{\"minor\", []string{\"semver:minor\"}, \"tag v0.2.0 5 minor\", \"\"},\n+\t\t{\"major\", []string{\"semver:major\"}, \"tag v1.0.0 5 major\", \"\"},\n+\t\t{\"both\", []string{\"semver:minor\", \"semver:major\"}, \"tag v1.0.0 5 major\", \"both semver labels\"},\n+\t\t{\"unrelated\", []string{\"bug\"}, \"tag v0.1.1 5 patch\", \"\"},\n+\t}\n+\tfor _, tt := range tests {\n+\t\tt.Run(tt.name, func(t *testing.T) {\n+\t\t\tf := newFx(t, \"v0.1.0\", \"example.com/ard\")\n+\t\t\ts := f.commit(\"t (#5)\", human)\n+\t\t\tf.pr(s, 5, \"t\", tt.labels...)\n+\t\t\tr := f.plan(nil)\n+\t\t\twant(t, r, tt.want)\n+\t\t\tif tt.warn != \"\" && !strings.Contains(r.out, tt.warn) {\n+\t\t\t\tt.Errorf(\"missing warning %q:\\n%s\", tt.warn, r.out)\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+func TestPlanSkipsArdCommits(t *testing.T) {\n+\tforms := map[string]ident{\n+\t\t\"name\":         {botLogin, \"x@example.com\"},\n+\t\t\"email\":        {\"x\", \"ard-test[bot]@users.noreply.github.com\"},\n+\t\t\"numeric id\":   {\"x\", \"12345+ard-test[bot]@users.noreply.github.com\"},\n+\t\t\"mixed case\":   {\"ARD-Test[BOT]\", \"x@example.com\"},\n+\t\t\"mixed email\":  {\"x\", \"99+ARD-TEST[bot]@Users.Noreply.GitHub.com\"},\n+\t\t\"control char\": {\"x\\x01y\", \"x@example.com\"},\n+\t}\n+\tfor name, id := range forms {\n+\t\tt.Run(name, func(t *testing.T) {\n+\t\t\tf := newFx(t, \"v0.1.0\", \"example.com/ard\")\n+\t\t\tf.commit(\"ard(plan): #1 [skip ci]\", id)\n+\t\t\tr := f.plan(nil)\n+\t\t\twant(t, r)\n+\t\t\tif r.cnt != \"0\" || !strings.Contains(r.out, \"skip \") {\n+\t\t\t\tt.Errorf(\"count %q\\n%s\", r.cnt, r.out)\n+\t\t\t}\n+\t\t})\n+\t}\n+\tt.Run(\"human after bot numbers from base\", func(t *testing.T) {\n+\t\tf := newFx(t, \"v0.1.0\", \"example.com/ard\")\n+\t\tf.commit(\"ard: x\", ident{botLogin, \"x@example.com\"})\n+\t\ts := f.commit(\"h (#7)\", human)\n+\t\tf.pr(s, 7, \"h\")\n+\t\twant(t, f.plan(nil), \"tag v0.1.1 7 patch\")\n+\t})\n+\tt.Run(\"a different login is not skipped\", func(t *testing.T) {\n+\t\tf := newFx(t, \"v0.1.0\", \"example.com/ard\")\n+\t\ts := f.commit(\"h (#7)\", ident{\"other[bot]\", \"1+other[bot]@users.noreply.github.com\"})\n+\t\tf.pr(s, 7, \"h\")\n+\t\twant(t, f.plan(nil), \"tag v0.1.1 7 patch\")\n+\t})\n+}\n+\n+func TestPlanTwoMerges(t *testing.T) {\n+\tfor _, tt := range []struct {\n+\t\tlabel string\n+\t\twant  []string\n+\t}{\n+\t\t{\"\", []string{\"tag v0.1.1 1 patch\", \"tag v0.1.2 2 patch\"}},\n+\t\t{\"semver:minor\", []string{\"tag v0.2.0 1 minor\", \"tag v0.2.1 2 patch\"}},\n+\t} {\n+\t\tt.Run(\"label \"+tt.label, func(t *testing.T) {\n+\t\t\tf := newFx(t, \"v0.1.0\", \"example.com/ard\")\n+\t\t\ta := f.commit(\"a (#1)\", human)\n+\t\t\tb := f.commit(\"b (#2)\", human)\n+\t\t\tif tt.label != \"\" {\n+\t\t\t\tf.pr(a, 1, \"a\", tt.label)\n+\t\t\t} else {\n+\t\t\t\tf.pr(a, 1, \"a\")\n+\t\t\t}\n+\t\t\tf.pr(b, 2, \"b\")\n+\t\t\twant(t, f.plan(nil), tt.want...)\n+\t\t})\n+\t}\n+}\n+\n+func TestRerunsAndResume(t *testing.T) {\n+\tf := newFx(t, \"v0.1.0\", \"example.com/ard\")\n+\ta := f.commit(\"a (#1)\", human)\n+\tf.pr(a, 1, \"a\")\n+\tr := f.plan(nil)\n+\twant(t, r, \"tag v0.1.1 1 patch\")\n+\tif tr := f.tag(r.raw, nil); tr.code != 0 {\n+\t\tt.Fatalf(\"tag exit %d\\n%s\", tr.code, tr.out)\n+\t}\n+\tif got := git(t, f.clone, nil, \"cat-file\", \"-t\", \"v0.1.1\"); got != \"tag\" {\n+\t\tt.Errorf(\"tag type %q\", got)\n+\t}\n+\tif got := git(t, f.origin, nil, \"rev-parse\", \"v0.1.1^{commit}\"); got != a {\n+\t\tt.Errorf(\"origin tag at %s\", got)\n+\t}\n+\tif got := git(t, f.clone, nil, \"for-each-ref\", \"--format=%(taggername)\", \"refs/tags/v0.1.1\"); got != \"Release Bot\" {\n+\t\tt.Errorf(\"tagger %q\", got)\n+\t}\n+\tif rl := f.releases(); !strings.Contains(rl, \"create v0.1.1 --verify-tag\") {\n+\t\tt.Errorf(\"release log %q\", rl)\n+\t}\n+\t// Replan once the release exists: nothing to do.\n+\tf.ghJSON(\"repos/\"+repo+\"/releases/tags/v0.1.1\", map[string]any{})\n+\tr2 := f.plan(nil)\n+\twant(t, r2)\n+\tif r2.cnt != \"0\" {\n+\t\tt.Errorf(\"count %q\", r2.cnt)\n+\t}\n+\t// Rerunning the old plan moves nothing.\n+\tagain := f.tag(r.raw, nil)\n+\tif again.code != 2 || !strings.Contains(again.out, \"already has version tag\") {\n+\t\tt.Errorf(\"rerun: exit %d\\n%s\", again.code, again.out)\n+\t}\n+\tif got := git(t, f.origin, nil, \"rev-parse\", \"v0.1.1^{commit}\"); got != a {\n+\t\tt.Errorf(\"tag moved to %s\", got)\n+\t}\n+}\n+\n+func TestResumeAfterReleaseFailure(t *testing.T) {\n+\tf := newFx(t, \"v0.1.0\", \"example.com/ard\")\n+\ta := f.commit(\"a (#1)\", human)\n+\tb := f.commit(\"b (#2)\", human)\n+\tf.pr(a, 1, \"a\")\n+\tf.pr(b, 2, \"b\")\n+\tr := f.plan(nil)\n+\twant(t, r, \"tag v0.1.1 1 patch\", \"tag v0.1.2 2 patch\")\n+\tif err := os.WriteFile(filepath.Join(f.state, \"release.fail\"), nil, 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\ttr := f.tag(r.raw, nil)\n+\tif tr.code != 2 || !strings.Contains(tr.out, \"release for v0.1.1 failed\") {\n+\t\tt.Fatalf(\"exit %d\\n%s\", tr.code, tr.out)\n+\t}\n+\tif err := os.Remove(filepath.Join(f.state, \"release.fail\")); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\t// v0.1.1 has no release (404): backfill it, then tag the second commit.\n+\tr2 := f.plan(nil)\n+\twant(t, r2, \"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/ard-home/.claude/projects/-Users-al--ard-work-albertcbrown-ard-01M86WFYQY3AP0YHJZ18XPJSY7/bf5b2fdc-b5fe-4211-abf8-0975d0c14b2f/tool-results/b00v70okn.txt","persistedOutputSize":30092},"tool_result_meta":[{"id":"toolu_01SKahFgZ5ZKa8azweHHbqtg","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
