t-installed\"\n+\tConnectMissingPermission ConnectKind = \"missing-permission\"\n+\tConnectRepoNotFound      ConnectKind = \"repo-not-found\"\n+\tConnectUnauthorized      ConnectKind = \"unauthorized\"\n+\tConnectUnreachable       ConnectKind = \"unreachable\"\n+)\n+\n+// ConnectError is a failed startup check. Detail is built from fixed strings,\n+// repo names and permission names only, never from a response body, a header\n+// or a credential, so Error is one safe line.\n+type ConnectError struct {\n+\tKind   ConnectKind\n+\tDetail string\n+}\n+\n+func (e *ConnectError) Error() string { return \"github: \" + string(e.Kind) + \": \" + e.Detail }\ndiff --git a/internal/github/ghcli.go b/internal/github/ghcli.go\nnew file mode 100644\nindex 0000000..b0af780\n--- /dev/null\n+++ b/internal/github/ghcli.go\n@@ -0,0 +1,56 @@\n+package github\n+\n+import (\n+\t\"context\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"io\"\n+\t\"os/exec\"\n+\t\"strings\"\n+)\n+\n+// GhLoginCommand is what a user runs when `gh` is installed but logged out.\n+const GhLoginCommand = \"gh auth login --hostname github.com --git-protocol https --scopes repo\"\n+\n+// Errors from GhFallback.\n+var (\n+\tErrNoGh = errors.New(\"no GitHub credentials: set the GitHub App variables \" +\n+\t\t\"(ARD_GITHUB_APP_ID, ARD_GITHUB_INSTALLATION_ID, ARD_GITHUB_PRIVATE_KEY or ARD_GITHUB_PRIVATE_KEY_FILE) \" +\n+\t\t\"or ARD_GITHUB_TOKEN, or install the gh CLI and log in; gh is not installed\")\n+\tErrGhNotLoggedIn = errors.New(\"no GitHub credentials: gh is installed but not logged in; run: \" + GhLoginCommand)\n+)\n+\n+// RunFunc runs a command and returns its stdout. Stderr is dropped: it may\n+// echo a token.\n+type RunFunc func(ctx co","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/ard-home/.claude/projects/-Users-al--ard-work-albertcbrown-ard-01M8A94HBPAQMX773HGN676ZQ3/fad917fc-25be-4d22-a837-4d288a00268a/tool-results/bv3pjzipz.txt","persistedOutputSize":37356},"tool