n \t\"strings\"\n \t\"sync\"\n \t\"sync/atomic\"\n@@ -393,7 +394,7 @@ func serveLoops(ctx context.Context, e *cli.Env, build builder, wantLoops []stri\n \tif cfg != nil {\n \t\tstartSHA = cfg.SHA\n \t}\n-\tlog.Info(\"serve.start\", \"repo\", repo.String(), \"dry_run\", e.DryRun, \"pause_file\", pausePath, \"config_sha\", startSHA)\n+\tlog.Info(\"serve.start\", \"repo\", repo.String(), \"dry_run\", e.DryRun, \"identity\", identityOf(ctx, d.Reader), \"pause_file\", pausePath, \"config_sha\", startSHA)\n \tif useUI {\n \t\treturn runWithUI(ctx, cc.Run, w.snap.Take, &controls{w: w, pausePath: pausePath, loops: loopNames(selected)}, approveFn(w.Effects, w.wakeLoops, repo.String(), ui.OpenBrowser), repo.String(), logPath, os.Stdin, e.Stdout)\n \t}\n@@ -786,17 +787,57 @@ func forceOnSecondSignal(ctx context.Context) <-chan struct{} {\n \treturn force\n }\n \n-// buildDeps is the production builder: credentials from the environment,\n-// the client and effect layer from effects.Open. Dev-token auth is refused\n-// outside dry-run.\n-func buildDeps(ctx context.Context, e *cli.Env, repo github.Repo, stateDir string) (deps, error) {\n+// Seams for tests: the gh lookup and runner, and the GitHub API base URL.\n+var (\n+\tlookPath         = exec.LookPath\n+\trunGh            = github.ExecRun\n+\tgithubAPIBaseURL = \"\" // empty means api.github.com\n+)\n+\n+// resolveAuth reads credentials from the environment and, when none are set,\n+// falls back to the gh CLI's token. The token stays in memory.\n+func resolveAuth(ctx context.Context, e *cli.Env) (github.Auth, error) {\n \tauth, err := github.AuthFromEnv(os.Getenv, os.ReadFile)\n+\tif errors.Is(err, github.ErrNoCredentials) {\n+\t\tta, gerr := github.GhFallback(ctx, lookPath, runGh, e.Stderr)\n+\t\tif gerr != nil {\n+\t\t\tif errors.Is(gerr, github.ErrNoGh) || errors.Is(gerr, github.ErrGhNotLoggedIn) {\n+\t\t\t\treturn nil, &cli.ExitError{Code: 1, Err: fmt.Errorf(\"ard serve: %w\", gerr)}\n+\t\t\t}\n+\t\t\treturn nil, fmt.Errorf(\"ard serve: %w\", gerr)\n+\t\t}\n+\t\treturn ta, nil\n+\t}\n \tif err != nil {\n-\t\treturn deps{}, fmt.Errorf(\"ard serve: %w\", err)\n+\t\treturn nil, fmt.Errorf(\"ard serve: %w\", err)\n+\t}\n+\treturn auth, nil\n+}\n+\n+// buildDeps is the production builder: credentials from the environment (or\n+// the gh CLI), a startup connectivity check, then the client and effect layer\n+// from effects.Open.\n+func buildDeps(ctx context.Context, e *cli.Env, repo github.Repo, stateDir string) (deps, error) {\n+\tauth, err := resolveAuth(ctx, e)\n+\tif err != nil {\n+\t\treturn deps{}, err\n+\t}\n+\tgcfg := github.Config{Repo: repo, Auth: auth, Log: e.Log, BaseURL: githubAPIBaseURL, ReadOnly: e.DryRun}\n+\tconn, err := github.Connect(ctx, gcfg)\n+\tif err != nil {\n+\t\treturn deps{}, &cli.ExitError{Code: 1, Err: fmt.Errorf(\"ard serve: %w\", err)}\n \t}\n-\tif auth.Kind() == github.AuthToken && !e.DryRun {\n-\t\treturn deps{}, errors.New(\"ard serve: ARD_GITHUB_TOKEN auth is for --dry-run only; configure a GitHub App for live runs\")\n+\tsrc := \"app\"\n+\tif ta, ok := auth.(*github.TokenAuth); ok {\n+\t\tsrc = ta.Source\n \t}\n+\tperms := make([]string, 0, len(conn.Permissions))\n+\tfor k, v := range conn.Permissions {\n+\t\tperms = append(perms, k+\":\"+v)\n+\t}\n+\tsort.Strings(perms)\n+\te.Log.Info(\"github.connect\", \"auth\", string(conn.Kind), \"source\", src, \"login\", conn.Login, \"repo\", repo.String(),\n+\t\t\"permissions\", strings.Join(perms, \",\"), \"scopes\", strings.Join(conn.Scopes, \",\"))\n \tcred, err := modelauth.Resolve(modelauth.Mode(os.Getenv(modelauth.EnvMode)), claude.New(claude.Options{}).CredentialEnv, os.Getenv)\n \tvar model modelauth.Credential\n \tswitch {\n@@ -809,14 +850,14 @@ func buildDeps(ctx context.Context, e *cli.Env, repo github.Repo, stateDir strin\n \t\tmodel = cred\n \t\te.Log.Info(\"serve.model_credential\", \"credential\", cred)\n \t}\n-\tred, err := redact.New(redact.FromEnviron(os.Environ()), redact.Options{})\n+\tred, err := newRedactor(auth)\n \tif err != nil {\n \t\treturn deps{}, fmt.Errorf(\"ard serve: %w\", err)\n \t}\n \to := effects.Options{\n \t\tRedact: func(text string) string { return redactText(context.WithoutCancel(ctx), e.Log, red, text) },\n \t\tDryRun: e.DryRun,\n-\t\tGitHub: github.Config{Repo: repo, Auth: auth, Log: e.Log},\n+\t\tGitHub: github.Config{Repo: repo, Auth: auth, Log: e.Log, BaseURL: githubAPIBaseURL},\n \t\tLog:    e.Log,\n \t}\n \tif e.DryRun {\n@@ -848,3 +889,25 @@ func redactText(ctx context.Context, log *slog.Logger, rd *redact.Redactor, text\n \t}\n \treturn string(res.Clean)\n }\n+\n+// identityOf returns the login ard acts as, or \"unknown\" when GitHub cannot say.\n+func identityOf(ctx context.Context, rd github.Reader) string {\n+\tif rd == nil {\n+\t\treturn \"unknown\"\n+\t}\n+\tid, err := rd.Identity(ctx)\n+\tif err != nil || id.Login == \"\" {\n+\t\treturn \"unknown\"\n+\t}\n+\treturn id.Login\n+}\n+\n+// newRedactor masks the environment's credentials and the token in auth. A gh\n+// token is not in the environment, so it is added by hand.\n+func newRedactor(auth github.Auth) (*redact.Redactor, error) {\n+\tsecrets := redact.FromEnviron(os.Environ())\n+\tif ta, ok := auth.(*github.TokenAuth); ok {\n+\t\t_ = secrets.Add(\"ARD_GITHUB_TOKEN\", ta.Value)\n+\t}\n+\treturn redact.New(secrets, redact.Options{})\n+}","is_error":false}]},"parent_tool_use_id":null,"session_id":"1053d44c-4fd2-436e-b2aa-ceefd973f15b","uuid":"a256fd65-f309-4f77-8f17-ce729ccafbfa","timestamp":"2026-11-25T21:17:47.218Z","tool_use_result":{"stdout":"   - `GET /repos/{owner}/{repo}` succeeds, and the permissions ard needs are present (contents, issues and pull requests write; checks and statuses read). For an App, read them from the installation; for a token, from the repo response's `permissions` and, for a classic PAT, the `X-OAuth-Scopes` header.\n   - On failure it exits non-zero with one clear line naming what is missing (no credentials, bad key, App not installed on the repo, token lacks a permission, repo not found). It never prints a secret.\n   - The result is logged once (`github.connect`: auth kind, login or App slug, repo, permissions found).\n2. **PAT accepted for live runs.** `ARD_GITHUB_TOKEN` works without `--dry-run`. `ard config check` and the startup log say which identity ard acts as.\n3. **`gh` fallback.** When neither App variables nor `ARD_GITHUB_TOKEN` are set:\n   - If `gh` is not on `PATH`: exit as today, with the message listing both ways to configure auth.\n   - If `gh` is on `PATH` but not logged in: print the command to run, e.g. `gh auth login --hostname github.com --git-protocol https --scopes repo`, and exit.\n   - If `gh` is logged in: print that ard will use the `gh` token for this session (and the command it runs, `gh auth token`), read the token once at startup, and use it as a PAT for the session. It is held in memory only: never written to disk, logged, passed to agents or put in a job's environment (invariant 2).\n   - The connectivity check (1) then runs on that token as on any PAT.\n4. **Docs.** `docs/proposal.md` (Guardrails: Identity) states both identities and what a PAT loses (below); README and the runbook show the three ways to start.\n\n## What a PAT changes (to document and test)\n\n- **Identity.** Issues, comments, commits on `worker/` branches and PRs are made as the token's user, not `ard[bot]`.\n- **Self-review.** GitHub does not let a user approve their own PR. With a PAT, ard opens PRs and posts reviews as the same user, so an `approve` review is rejected or counts as a comment. The reviewer and merger must handle this (post a `COMMENT` review carrying the verdict and gate on ard's own record of it), or the docs must say a PAT setup needs reviews from another identity. **Decide in triage.**\n- **Bot-commit audit.** `.github/workflows/bot-commits.yml` keys on the App's identity (`ARD_BOT_LOGIN`). With a PAT, main-lane commits under `.ard/<issue#>/` are the user's and the audit cannot tell them from the human's own commits. Document it; `ARD_BOT_LOGIN` set to the user would flag every human commit.\n- **Workflows backstop.** An App without the `workflows` permission cannot push `.github/workflows/`; a classic `repo`-scoped PAT can (without `workflow` scope it cannot), a fine-grained PAT only if granted. The code guard (`committer.CheckCodePath`) still refuses `.github/`. Recommend a fine-grained PAT scoped to the one repo, without workflows.\n- **Expiry and scope.** A PAT does not expire hourly; recommend a fine-grained, single-repo token with an expiry.\n\n## Acceptance criteria\n\n- [ ] `ard serve` exits non-zero before starting loops when the repo is unreachable or a needed permission is missing, naming what is missing, with tests against the GitHub fake for each case.\n- [ ] `ard serve` runs live with `ARD_GITHUB_TOKEN`.\n- [ ] With no credentials: `gh` absent prints both setup options and exits; `gh` logged out prints the `gh auth login` command and exits; `gh` logged in uses `gh auth token` for the session (tests with a fake `gh` on `PATH`).\n- [ ] The `gh` token never appears in logs, files, agent environments or job specs (redaction test).\n- [ ] The self-review case has a decided behaviour with a test.\n- [ ] The proposal documents both identities and the PAT trade-offs above.\n\n## Out of scope\n\n- Per-repo App or token selection across several `ard serve` processes (each `ard serve` serves one repo with its own credentials).\n- Refreshing a `gh` token during the session.\n\npackage github\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/http\"\n\t\"sort\"\n\t\"strings\"\n\t\"time\"\n)\n\n// Connection is what Connect learned about the credentials.\ntype Connection struct {\n\tKind        AuthKind\n\tLogin       string // token user, or the App's slug with [bot]\n\tRepo        Repo\n\tPermissions map[string]string // permission name to level (read, write); a token's repo flags map to contents-style levels\n\tScopes      []string          // X-OAuth-Scopes of a classic PAT\n}\n\n// appNeeds lists the App permissions ard needs and the level each requires.\nvar appNeeds = []struct{ name, level string }{\n\t{\"contents\", \"write\"}, {\"issues\", \"write\"}, {\"pull_requests\", \"write\"},\n\t{\"checks\", \"read\"}, {\"statuses\", \"read\"},\n}\n\nfunc levelOK(have, need string) bool {\n\tswitch have {\n\tcase \"admin\", \"write\":\n\t\treturn true\n\tcase \"read\":\n\t\treturn need == \"read\"\n\t}\n\treturn false\n}\n\n// Connect checks cfg's credentials against the repo before any loop starts. It\n// returns a *ConnectError naming what is missing. With cfg.ReadOnly only read\n// access is required. Errors never carry a credential or a response body.\nfunc Connect(ctx context.Context, cfg Config) (Connection, error) {\n\tif cfg.Auth == nil {\n\t\treturn Connection{}, &ConnectError{ConnectNoCredentials, \"no GitHub credentials configured\"}\n\t}\n\tbase := http.DefaultTransport\n\tif cfg.HTTPClient != nil && cfg.HTTPClient.Transport != nil {\n\t\tbase = cfg.HTTPClient.Transport\n\t}\n\tbaseURL := cfg.BaseURL\n\tif baseURL == \"\" {\n\t\tbaseURL = defaultBaseURL\n\t}\n\tbaseURL = strings.TrimRight(baseURL, \"/\")\n\tc := &connector{cfg: cfg, base: base, baseURL: baseURL}\n\tif app, ok := cfg.Auth.(*AppAuth); ok {\n\t\treturn c.app(ctx, app)\n\t}\n\treturn c.token(ctx)\n}\n\ntype connector struct {\n\tcfg     Config\n\tbase    http.RoundTripper\n\tbaseURL string\n}\n\n// get fetches path with rt. It returns the status, headers and a bounded body.\nfunc (c *connector) get(ctx context.Context, rt http.RoundTripper, path string) (int, http.Header, []byte, error) {\n\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, c.baseURL+path, nil)\n\tif err != nil {\n\t\treturn 0, nil, nil, err\n\t}\n\treq.Header.Set(\"Accept\", \"application/vnd.github+json\")\n\treq.Header.Set(\"User-Agent\", \"ard\")\n\thc := &http.Client{Transport: rt, Timeout: 30 * time.Second, CheckRedirect: refuseRedirect}\n\tresp, err := hc.Do(req)\n\tif err != nil {\n\t\treturn 0, nil, nil, err\n\t}\n\tdefer resp.Body.Close()\n\tbody, _ := io.ReadAll(io.LimitReader(resp.Body, 1<<20))\n\treturn resp.StatusCode, resp.Header, body, nil\n}\n\nfunc unreachable(ctx context.Context) error {\n\tif ctx.Err() != nil {\n\t\treturn ctx.Err()\n\t}\n\treturn &ConnectError{ConnectUnreachable, \"cannot reach the GitHub API\"}\n}\n\nfunc (c *connector) token(ctx context.Context) (Connection, error) {\n\trepo := c.cfg.Repo\n\trt, err := c.cfg.Auth.Transport(c.base)\n\tif err != nil {\n\t\treturn Connection{}, &ConnectError{ConnectNoCredentials, \"no GitHub token configured\"}\n\t}\n\tstatus, hdr, body, err := c.get(ctx, rt, \"/repos/\"+repo.String())\n\tif err != nil {\n\t\treturn Connection{}, unreachable(ctx)\n\t}\n\tswitch status {\n\tcase http.StatusOK:\n\tcase http.StatusUnauthorized:\n\t\treturn Connection{}, &ConnectError{ConnectUnauthorized, \"GitHub rejected the token (bad or expired)\"}\n\tcase http.StatusNotFound:\n\t\treturn Connection{}, &ConnectError{ConnectRepoNotFound, fmt.Sprintf(\"repository %s not found, or the token cannot see it\", repo)}\n\tdefault:\n\t\treturn Connection{}, &ConnectError{ConnectUnreachable, fmt.Sprintf(\"GET /repos/%s returned HTTP %d\", repo, status)}\n\t}\n\tvar r struct {\n\t\tPrivate     bool            `json:\"private\"`\n\t\tPermissions map[string]bool `json:\"permissions\"`\n\t}\n\tif json.Unmarshal(body, &r) != nil {\n\t\treturn Connection{}, &ConnectError{ConnectUnreachable, \"unexpected response for the repository\"}\n\t}\n\tconn := Connection{Kind: AuthToken, Repo: repo, Permissions: map[string]string{}}\n\tswitch {\n\tcase r.Permissions[\"admin\"] || r.Permissions[\"maintain\"] || r.Permissions[\"push\"]:\n\t\tconn.Permissions[\"contents\"], conn.Permissions[\"issues\"], conn.Permissions[\"pull_requests\"] = \"write\", \"write\", \"write\"\n\tcase r.Permissions[\"pull\"]:\n\t\tconn.Permissions[\"contents\"], conn.Permissions[\"issues\"], conn.Permissions[\"pull_requests\"] = \"read\", \"read\", \"read\"\n\t}\n\tif s := strings.TrimSpace(hdr.Get(\"X-OAuth-Scopes\")); s != \"\" {\n\t\tfor _, p := range strings.Split(s, \",\") {\n\t\t\tconn.Scopes = append(conn.Scopes, strings.TrimSpace(p))\n\t\t}\n\t}\n\tvar missing []string\n\tif c.cfg.ReadOnly {\n\t\tif conn.Permissions[\"contents\"] == \"\" {\n\t\t\tmissing = []string{\"contents read\", \"issues read\", \"pull requests read\"}\n\t\t}\n\t} else if conn.Permissions[\"contents\"] != \"write\" {\n\t\tmissing = []string{\"contents write\", \"issues write\", \"pull requests write\"}\n\t}\n\tif len(missing) == 0 && len(conn.Scopes) > 0 && !c.cfg.ReadOnly && !hasScope(conn.Scopes, \"repo\", !r.Private) {\n\t\tmissing = []string{\"the repo scope (token scopes: \" + strings.Join(conn.Scopes, \", \") + \")\"}\n\t}\n\tif len(missing) > 0 {\n\t\treturn Connection{}, &ConnectError{ConnectMissingPermission, \"token lacks \" + strings.Join(missing, \", \")}\n\t}\n\tif len(conn.Scopes) == 0 {\n\t\t// A fine-grained token lists no permissions: probe issues and pull requests.\n\t\tfor _, p := range []struct{ path, name string }{{\"/issues\", \"issues\"}, {\"/pulls\", \"pull requests\"}} {\n\t\t\tst, _, _, err := c.get(ctx, rt, \"/repos/\"+repo.String()+p.path+\"?per_page=1\")\n\t\t\tif err != nil {\n\t\t\t\treturn Connection{}, unreachable(ctx)\n\t\t\t}\n\t\t\tif st != http.StatusOK {\n\t\t\t\treturn Connection{}, &ConnectError{ConnectMissingPermission, \"token lacks \" + p.name + \" access\"}\n\t\t\t}\n\t\t}\n\t}\n\tst, _, ub, err := c.get(ctx, rt, \"/user\")\n\tif err != nil {\n\t\treturn Connection{}, unreachable(ctx)\n\t}\n\tif st == http.StatusOK {\n\t\tvar u struct {\n\t\t\tLogin string `json:\"login\"`\n\t\t}\n\t\t_ = json.Unmarshal(ub, &u)\n\t\tconn.Login = u.Login\n\t}\n\treturn conn, nil\n}\n\n// hasScope reports whether scopes include want, or public_repo for a public repo.\nfunc hasScope(scopes []string, want string, public bool) bool {\n\tfor _, s := range scopes {\n\t\tif s == want || (public && s == \"public_repo\") {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc (c *connector) app(ctx context.Context, app *AppAuth) (Connection, error) {\n\trepo := c.cfg.Repo\n\tapp.configure(repo, c.baseURL)\n\tjwt, err := app.appsTransport(c.base)\n\tif err != nil {\n\t\treturn Connection{}, &ConnectError{ConnectBadKey, \"the GitHub App private key is unusable\"}\n\t}\n\tstatus, _, body, err := c.get(ctx, jwt, \"/repos/\"+repo.String()+\"/installation\")\n\tif err != nil {\n\t\treturn Connection{}, unreachable(ctx)\n\t}\n\tswitch status {\n\tcase http.StatusOK:\n\tcase http.StatusUnauthorized:\n\t\treturn Connection{}, &ConnectError{ConnectBadKey, \"GitHub rejected the App credentials (wrong app ID or private key)\"}\n\tcase http.StatusNotFound:\n\t\treturn Connection{}, &ConnectError{ConnectAppNotInstalled, fmt.Sprintf(\"the GitHub App is not installed on %s\", repo)}\n\tdefault:\n\t\treturn Connection{}, &ConnectError{ConnectUnreachable, fmt.Sprintf(\"GET /repos/%s/installation returned HTTP %d\", repo, status)}\n\t}\n\tvar in struct {\n\t\tAppSlug     string            `json:\"app_slug\"`\n\t\tPermissions map[string]string `json:\"permissions\"`\n\t}\n\tif json.Unmarshal(body, &in) != nil {\n\t\treturn Connection{}, &ConnectError{ConnectUnreachable, \"unexpected response for the installation\"}\n\t}\n\tconn := Connection{Kind: AuthApp, Repo: repo, Permissions: in.Permissions}\n\tif in.AppSlug != \"\" {\n\t\tconn.Login = in.AppSlug + \"[bot]\"\n\t}\n\tvar missing []string\n\tfor _, n := range appNeeds {\n\t\tneed := n.level\n\t\tif c.cfg.ReadOnly {\n\t\t\tneed = \"read\"\n\t\t}\n\t\tif !levelOK(in.Permissions[n.name], need) {\n\t\t\tmissing = append(missing, strings.ReplaceAll(n.name, \"_\", \" \")+\" \"+need)\n\t\t}\n\t}\n\tif len(missing) > 0 {\n\t\tsort.Strings(missing)\n\t\treturn Connection{}, &ConnectError{ConnectMissingPermission, \"the GitHub App installation lacks \" + strings.Join(missing, \", \")}\n\t}\n\t// Prove the installation token works and the repo is reachable.\n\trt, err := app.Transport(c.base)\n\tif err != nil {\n\t\treturn Connection{}, &ConnectError{ConnectBadKey, \"the GitHub App private key is unusable\"}\n\t}\n\tst, _, _, err := c.get(ctx, rt, \"/repos/\"+repo.String())\n\tif err != nil {\n\t\treturn Connection{}, unreachable(ctx)\n\t}\n\tif st == http.StatusNotFound {\n\t\treturn Connection{}, &ConnectError{ConnectRepoNotFound, fmt.Sprintf(\"repository %s not found for the App installation\", repo)}\n\t}\n\tif st != http.StatusOK {\n\t\treturn Connection{}, &ConnectError{ConnectUnauthorized, fmt.Sprintf(\"GET /repos/%s returned HTTP %d\", repo, st)}\n\t}\n\treturn conn, nil\n}\ndiff --git a/internal/github/ghcli.go b/internal/github/ghcli.go\nnew file mode 100644\nindex 0000000..b0af780\n--- /dev/null\n+++ b/internal/github/ghcli.go\n@@ -0,0 +1,56 @@\n+package github\n+\n+import (\n+\t\"context\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"io\"\n+\t\"os/exec\"\n+\t\"strings\"\n+)\n+\n+// GhLoginCommand is what a user runs when `gh` is installed but logged out.\n+const GhLoginCommand = \"gh auth login --hostname github.com --git-protocol https --scopes repo\"\n+\n+// Errors from GhFallback.\n+var (\n+\tErrNoGh = errors.New(\"no GitHub credentials: set the GitHub App variables \" +\n+\t\t\"(ARD_GITHUB_APP_ID, ARD_GITHUB_INSTALLATION_ID, ARD_GITHUB_PRIVATE_KEY or ARD_GITHUB_PRIVATE_KEY_FILE) \" +\n+\t\t\"or ARD_GITHUB_TOKEN, or install the gh CLI and log in; gh is not installed\")\n+\tErrGhNotLoggedIn = errors.New(\"no GitHub credentials: gh is installed but not logged in; run: \" + GhLoginCommand)\n+)\n+\n+// RunFunc runs a command and returns its stdout. Stderr is dropped: it may\n+// echo a token.\n+type RunFunc func(ctx context.Context, name string, args ...string) ([]byte, error)\n+\n+// ExecRun is the RunFunc backed by os/exec.\n+func ExecRun(ctx context.Context, name string, args ...string) ([]byte, error) {\n+\treturn exec.CommandContext(ctx, name, args...).Output()\n+}\n+\n+// GhFallback reads the gh CLI's token for this session. lookPath and run are\n+// seams for tests. The token is returned in memory only; errors never carry\n+// it or gh's stderr.\n+func GhFallback(ctx context.Context, lookPath func(string) (string, error), run RunFunc, out io.Writer) (*TokenAuth, error) {\n+\tgh, err := lookPath(\"gh\")\n+\tif err != nil {\n+\t\treturn nil, ErrNoGh\n+\t}\n+\tif _, err := run(ctx, gh, \"auth\", \"status\", \"--hostname\", \"github.com\"); err != nil {\n+\t\tif ctx.Err() != nil {\n+\t\t\treturn nil, ctx.Err()\n+\t\t}\n+\t\treturn nil, ErrGhNotLoggedIn\n+\t}\n+\tfmt.Fprintln(out, \"ard: no GitHub credentials set; using the gh token for this session (running: gh auth token --hostname github.com). It is kept in memory only.\")\n+\tb, err := run(ctx, gh, \"auth\", \"token\", \"--hostname\", \"github.com\")\n+\tif err != nil {\n+\t\treturn nil, errors.New(\"github: gh auth token failed\")\n+\t}\n+\ttok := strings.TrimSpace(string(b))\n+\tif tok == \"\" {\n+\t\treturn nil, errors.New(\"github: gh auth token printed no token\")\n+\t}\n+\treturn &TokenAuth{Value: tok, Source: \"gh\"}, nil\n+}\ndiff --git a/internal/servecmd/serve.go b/internal/servecmd/serve.go\nindex 582142a..61f61cd 100644\n--- a/internal/servecmd/serve.go\n+++ b/internal/servecmd/serve.go\n@@ -14,6 +14,7 @@ import (\n \t\"os/signal\"\n \t\"path/filepath\"\n \t\"slices\"\n+\t\"sort\"\n \t\"strings\"\n \t\"sync\"\n \t\"sync/atomic\"\n@@ -393,7 +394,7 @@ func serveLoops(ctx context.Context, e *cli.Env, build builder, wantLoops []stri\n \tif cfg != nil {\n \t\tstartSHA = cfg.SHA\n \t}\n-\tlog.Info(\"serve.start\", \"repo\", repo.String(), \"dry_run\", e.DryRun, \"pause_file\", pausePath, \"config_sha\", startSHA)\n+\tlog.Info(\"serve.start\", \"repo\", repo.String(), \"dry_run\", e.DryRun, \"identity\", identityOf(ctx, d.Reader), \"pause_file\", pausePath, \"config_sha\", startSHA)\n \tif useUI {\n \t\treturn runWithUI(ctx, cc.Run, w.snap.Take, &controls{w: w, pausePath: pausePath, loops: loopNames(selected)}, approveFn(w.Effects, w.wakeLoops, repo.String(), ui.OpenBrowser), repo.String(), logPath, os.Stdin, e.Stdout)\n \t}\n@@ -786,17 +787,57 @@ func forceOnSecondSignal(ctx context.Context) <-chan struct{} {\n \treturn force\n }\n \n-// buildDeps is the production builder: credentials from the environment,\n-// the client and effect layer from effects.Open. Dev-token auth is refused\n-// outside dry-run.\n-func buildDeps(ctx context.Context, e *cli.Env, repo github.Repo, stateDir string) (deps, error) {\n+// Seams for tests: the gh lookup and runner, and the GitHub API base URL.\n+var (\n+\tlookPath         = exec.LookPath\n+\trunGh            = github.ExecRun\n+\tgithubAPIBaseURL = \"\" // empty means api.github.com\n+)\n+\n+// resolveAuth reads credentials from the environment and, when none are set,\n+// falls back to the gh CLI's token. The token stays in memory.\n+func resolveAuth(ctx context.Context, e *cli.Env) (github.Auth, error) {\n \tauth, err := github.AuthFromEnv(os.Getenv, os.ReadFile)\n+\tif errors.Is(err, github.ErrNoCredentials) {\n+\t\tta, gerr := github.GhFallback(ctx, lookPath, runGh, e.Stderr)\n+\t\tif gerr != nil {\n+\t\t\tif errors.Is(gerr, github.ErrNoGh) || errors.Is(gerr, github.ErrGhNotLoggedIn) {\n+\t\t\t\treturn nil, &cli.ExitError{Code: 1, Err: fmt.Errorf(\"ard serve: %w\", gerr)}\n+\t\t\t}\n+\t\t\treturn nil, fmt.Errorf(\"ard serve: %w\", gerr)\n+\t\t}\n+\t\treturn ta, nil\n+\t}\n \tif err != nil {\n-\t\treturn deps{}, fmt.Errorf(\"ard serve: %w\", err)\n+\t\treturn nil, fmt.Errorf(\"ard serve: %w\", err)\n+\t}\n+\treturn auth, nil\n+}\n+\n+// buildDeps is the production builder: credentials from the environment (or\n+// the gh CLI), a startup connectivity check, then the client and effect layer\n+// from effects.Open.\n+func buildDeps(ctx context.Context, e *cli.Env, repo github.Repo, stateDir string) (deps, error) {\n+\tauth, err := resolveAuth(ctx, e)\n+\tif err != nil {\n+\t\treturn deps{}, err\n+\t}\n+\tgcfg := github.Config{Repo: repo, Auth: auth, Log: e.Log, BaseURL: githubAPIBaseURL, ReadOnly: e.DryRun}\n+\tconn, err := github.Connect(ctx, gcfg)\n+\tif err != nil {\n+\t\treturn deps{}, &cli.ExitError{Code: 1, Err: fmt.Errorf(\"ard serve: %w\", err)}\n \t}\n-\tif auth.Kind() == github.AuthToken && !e.DryRun {\n-\t\treturn deps{}, errors.New(\"ard serve: ARD_GITHUB_TOKEN auth is for --dry-run only; configure a GitHub App for live runs\")\n+\tsrc := \"app\"\n+\tif ta, ok := auth.(*github.TokenAuth); ok {\n+\t\tsrc = ta.Source\n \t}\n+\tperms := make([]string, 0, len(conn.Permissions))\n+\tfor k, v := range conn.Permissions {\n+\t\tperms = append(perms, k+\":\"+v)\n+\t}\n+\tsort.Strings(perms)\n+\te.Log.Info(\"github.connect\", \"auth\", string(conn.Kind), \"source\", src, \"login\", conn.Login, \"repo\", repo.String(),\n+\t\t\"permissions\", strings.Join(perms, \",\"), \"scopes\", strings.Join(conn.Scopes, \",\"))\n \tcred, err := modelauth.Resolve(modelauth.Mode(os.Getenv(modelauth.EnvMode)), claude.New(claude.Options{}).CredentialEnv, os.Getenv)\n \tvar model modelauth.Credential\n \tswitch {\n@@ -809,14 +850,14 @@ func buildDeps(ctx context.Context, e *cli.Env, repo github.Repo, stateDir strin\n \t\tmodel = cred\n \t\te.Log.Info(\"serve.model_credential\", \"credential\", cred)\n \t}\n-\tred, err := redact.New(redact.FromEnviron(os.Environ()), redact.Options{})\n+\tred, err := newRedactor(auth)\n \tif err != nil {\n \t\treturn deps{}, fmt.Errorf(\"ard serve: %w\", err)\n \t}\n \to := effects.Options{\n \t\tRedact: func(text string) string { return redactText(context.WithoutCancel(ctx), e.Log, red, text) },\n \t\tDryRun: e.DryRun,\n-\t\tGitHub: github.Config{Repo: repo, Auth: auth, Log: e.Log},\n+\t\tGitHub: github.Config{Repo: repo, Auth: auth, Log: e.Log, BaseURL: githubAPIBaseURL},\n \t\tLog:    e.Log,\n \t}\n \tif e.DryRun {\n@@ -848,3 +889,25 @@ func redactText(ctx context.Context, log *slog.Logger, rd *redact.