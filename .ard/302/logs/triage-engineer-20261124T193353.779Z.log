{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MSqaoRdb39jwQjJk93NCPQ","type":"tool_result","content":"1\tpackage github\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"crypto/x509\"\n6\t\t\"encoding/json\"\n7\t\t\"encoding/pem\"\n8\t\t\"errors\"\n9\t\t\"fmt\"\n10\t\t\"io\"\n11\t\t\"net/http\"\n12\t\t\"net/url\"\n13\t\t\"strconv\"\n14\t\t\"strings\"\n15\t\t\"sync\"\n16\t\n17\t\t\"github.com/bradleyfalzon/ghinstallation/v2\"\n18\t)\n19\t\n20\t// EnvNames lists every environment variable that carries GitHub credentials.\n21\t// The executor (#18) strips these from every agent environment (invariant 2).\n22\tvar EnvNames = []string{\n23\t\t\"ARD_GITHUB_APP_ID\",\n24\t\t\"ARD_GITHUB_INSTALLATION_ID\",\n25\t\t\"ARD_GITHUB_PRIVATE_KEY\",\n26\t\t\"ARD_GITHUB_PRIVATE_KEY_FILE\",\n27\t\t\"ARD_GITHUB_TOKEN\",\n28\t}\n29\t\n30\t// Auth supplies credentials. This package does not decide policy: `ard serve`\n31\t// must refuse AuthToken unless --dry-run is set.\n32\ttype Auth interface {\n33\t\tKind() AuthKind\n34\t\t// Transport wraps base so requests carry credentials. It makes no request.\n35\t\tTransport(base http.RoundTripper) (http.RoundTripper, error)\n36\t\t// Token returns a fresh token, for git push (#17).\n37\t\tToken(ctx context.Context) (string, error)\n38\t}\n39\t\n40\t// AppAuth authenticates as a GitHub App installation. InstallationID 0 means\n41\t// discover it via GET /repos/{owner}/{repo}/installation on first use.\n42\ttype AppAuth struct {\n43\t\tAppID          int64\n44\t\tInstallationID int64\n45\t\tPrivateKey     []byte\n46\t\n47\t\tmu      sync.Mutex\n48\t\tbase    http.RoundTripper\n49\t\tbaseURL string\n50\t\trepo    Repo\n51\t\tinst    *ghinstallation.Transport\n52\t}\n53\t\n54\t// configure is called by New with the repo and API base URL.\n55\tfunc (a *AppAuth) configure(repo Repo, baseURL string) {\n56\t\ta.mu.Lock()\n57\t\tdefer a.mu.Unlock()\n58\t\ta.repo = repo\n59\t\ta.baseURL = strings.TrimRight(baseURL, \"/\")\n60\t}\n61\t\n62\tfunc (a *AppAuth) Kind() AuthKind { return AuthApp }\n63\t\n64\t// Transport returns a lazy round tripper: the installation is discovered and\n65\t// its token minted on first use, and ghinstallation refreshes the token before\n66\t// it expires.\n67\tfunc (a *AppAuth) Transport(base http.RoundTripper) (http.RoundTripper, error) {\n68\t\tif a.AppID == 0 || len(a.PrivateKey) == 0 {\n69\t\t\treturn nil, errors.New(\"github: app auth needs an app ID and a private key\")\n70\t\t}\n71\t\tif base == nil {\n72\t\t\tbase = http.DefaultTransport\n73\t\t}\n74\t\ta.mu.Lock()\n75\t\ta.base = base\n76\t\ta.mu.Unlock()\n77\t\treturn roundTripFunc(func(req *http.Request) (*http.Response, error) {\n78\t\t\tt, err := a.installation(req.Context())\n79\t\t\tif err != nil {\n80\t\t\t\treturn nil, err\n81\t\t\t}\n82\t\t\treturn t.RoundTrip(req)\n83\t\t}), nil\n84\t}\n85\t\n86\t// Token returns the current installation token, minting one if needed.\n87\tfunc (a *AppAuth) Token(ctx context.Context) (string, error) {\n88\t\tt, err := a.installation(ctx)\n89\t\tif err != nil {\n90\t\t\treturn \"\", err\n91\t\t}\n92\t\ttok, err := t.Token(ctx)\n93\t\tif err != nil {\n94\t\t\treturn \"\", fmt.Errorf(\"github: installation token: %w\", err)\n95\t\t}\n96\t\treturn tok, nil\n97\t}\n98\t\n99\tfunc (a *AppAuth) installation(ctx context.Context) (*ghinstallation.Transport, error) {\n100\t\ta.mu.Lock()\n101\t\tdefer a.mu.Unlock()\n102\t\tif a.inst != nil {\n103\t\t\treturn a.inst, nil\n104\t\t}\n105\t\tbase := a.base\n106\t\tif base == nil {\n107\t\t\tbase = http.DefaultTransport\n108\t\t}\n109\t\tid := a.InstallationID\n110\t\tif id == 0 {\n111\t\t\tvar err error\n112\t\t\tif id, err = a.discover(ctx, base); err != nil {\n113\t\t\t\treturn nil, err\n114\t\t\t}\n115\t\t}\n116\t\tt, err := ghinstallation.New(base, a.AppID, id, a.PrivateKey)\n117\t\tif err != nil {\n118\t\t\treturn nil, fmt.Errorf(\"github: app transport: %w\", err)\n119\t\t}\n120\t\tif a.baseURL != \"\" {\n121\t\t\tt.BaseUR