se keyEnv != \"\":\n264\t\t\tkey = []byte(keyEnv)\n265\t\t\tif !strings.Contains(keyEnv, \"\\n\") {\n266\t\t\t\tkey = []byte(strings.ReplaceAll(keyEnv, `\\n`, \"\\n\"))\n267\t\t\t}\n268\t\tdefault:\n269\t\t\treturn nil, errors.New(\"github: ARD_GITHUB_PRIVATE_KEY or ARD_GITHUB_PRIVATE_KEY_FILE is required for GitHub App auth\")\n270\t\t}\n271\t\tif err := checkPEM(key); err != nil {\n272\t\t\treturn nil, err\n273\t\t}\n274\t\treturn &AppAuth{AppID: id, InstallationID: inst, PrivateKey: key}, nil\n275\t}\n276\t\n277\tfunc checkPEM(key []byte) error {\n278\t\tblock, _ := pem.Decode(key)\n279\t\tif block == nil {\n280\t\t\treturn errors.New(\"github: GitHub App private key is not valid PEM\")\n281\t\t}\n282\t\tif _, err := x509.ParsePKCS1PrivateKey(block.Bytes); err == nil {\n283\t\t\treturn nil\n284\t\t}\n285\t\tif _, err := x509.ParsePKCS8PrivateKey(block.Bytes); err == nil {\n286\t\t\treturn nil\n287\t\t}\n288\t\treturn errors.New(\"github: GitHub App private key is not a parseable RSA key\")\n289\t}\n290\t"}]},"parent_tool_use_id":null,"session_id":"fa9a21b1-35e3-4ca3-b95f-ce0acb314eea","uuid":"c68b675d-dc63-45f7-b82e-9fe6dc5ba628","timestamp":"2026-11-24T19:33:58.863Z","tool_use_result":{"type":"text","file":{"filePath":"/work/internal/github/auth.go","content":"package github\n\nimport (\n\t\"context\"\n\t\"crypto/x509\"\n\t\"encoding/json\"\n\t\"encoding/pem\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/url\"\n\t\"strconv\"\n\t\"strings\"\n\t\"sync\"\n\n\t\"github.com/bradleyfalzon/ghinstallation/v2\"\n)\n\n// EnvNames lists every environment variable that carries GitHub credentials.\n// The executor (#18) strips these from every agent environment (invariant 2).\nvar EnvNames = []string{\n\t\"ARD_GITHUB_APP_ID\",\n\t\"ARD_GITHUB_INSTALLATION_ID\",\n\t\"ARD_GITHUB_PRIVATE_KEY\",\n\t\"ARD_GITHUB_PRIVATE_KEY_FILE\",\n\t\"ARD_GITHUB_TOKEN\",\n}\n\n// Auth supplies credentials. This package does not decide policy: `ard serve`\n// must refuse AuthToken