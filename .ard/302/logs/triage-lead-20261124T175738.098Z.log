ry).\n    - \"Jenkinsfile*\"\n    - Dockerfile\n    - .dockerignore\n    - deploy/\n\noverrides:\n  scanners/cve: { every: 6h, max_open: 10, group_size: 1, autoclose: true }\n  # Phase 1 agent roles (the ard init starter set, #39 Gate 2).\n  triage/lead:  { model: claude-opus-5-5, timeout: 15m }\n  triage/engineer: { model: claude-sonnet-5-5 }\n  workers/engineer: { model: claude-sonnet-5-5, timeout: 60m, tests: make test }\n  reviewers/eng-review: { model: claude-sonnet-5-5 }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01BYE77h1GgNhqC2mEZuhW6S","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
