{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011ChQJdxrRdbHkBSmKtxpjE","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01N4njxWebLy7YxkwWJekT6P","name":"Bash","input":{"command":"cat > internal/github/connect.go <<'EOF'\npackage github\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/http\"\n\t\"sort\"\n\t\"strings\"\n\t\"time\"\n)\n\n// Connection is what the startup check found.\ntype Connection struct {\n\tKind        AuthKind\n\tSource      string // \"env\", \"gh\" or \"app\"\n\tLogin       string // user login, or the App slug\n\tRepo        Repo\n\tPermissions map[string]string\n\tScopes      []string // classic PAT scopes; nil for fine-grained tokens and Apps\n}\n\n// PermissionList renders Permissions as sorted name=level pairs for a log line.\nfunc (c Connection) PermissionList() []string {\n\tout := make([]string, 0, len(c.Permissions))\n\tfor k, v := range c.Permissions {\n\t\tout = append(out, k+\"=\"+v)\n\t}\n\tsort.Strings(out)\n\treturn out\n}\n\n// needed is what ard needs from an App installation; \"write\" satisfies \"read\".\nvar needed = []struct{ name, level string }{\n\t{\"contents\", \"write\"}, {\"issues\", \"write\"}, {\"pull_requests\", \"write\"},\n\t{\"checks\", \"read\"}, {\"statuses\", \"read\"},\n}\n\n// Connect resolves cfg.Auth and checks it against cfg.Repo: the repo is\n// reachable and the permissions ard needs are present (read only when\n// cfg.ReadOnly). It makes a handful of GET requests and never echoes a body,\n// header or credential in an error.\nfunc Connect(ctx context.Context, cfg Config) (Connection, error) {\n\tif cfg.Auth == nil {\n\t\treturn Connection{}, &ConnectError{Kind: ConnNoCredentials, Detail: \"no GitHub App or token configured\"}\n\t}\n\tbase := http.DefaultTransport\n\tif cfg.HTTPClient != nil && cfg.HTTPClient.Transport != nil {\n\t\tbase = cfg.HTTPClient.Transport\n\t}\n\tbaseURL := cfg.BaseURL\n\tif baseURL == \"\" {\n\t\tbaseURL = defaultBaseURL\n\t}\n\tbaseURL = strings.TrimRight(baseURL, \"/\")\n\ttimeout := cfg.Timeout\n\tif timeout <= 0 {\n\t\ttimeout = 30 * time.Second\n\t}\n\tc := &connector{ctx: ctx, base: baseURL, repo: cfg.Repo, readOnly: cfg.ReadOnly, timeout: timeout}\n\tconn := Connection{Kind: cfg.Auth.Kind(), Repo: cfg.Repo}\n\tswitch a := cfg.Auth.(type) {\n\tcase *AppAuth:\n\t\treturn c.app(a, base, conn)\n\tcase *TokenAuth:\n\t\trt, err := a.Transport(base)\n\t\tif err != nil {\n\t\t\treturn conn, &ConnectError{Kind: ConnNoCredentials, Detail: \"the token is empty\"}\n\t\t}\n\t\tc.hc = newAPIClient(rt)\n\t\tconn.Source = a.Source\n\t\treturn c.token(conn)\n\t}\n\treturn conn, &ConnectError{Kind: ConnNoCredentials, Detail: \"unsupported credential type\"}\n}\n\ntype connector struct {\n\tctx      context.Context\n\tbase     string\n\trepo     Repo\n\treadOnly bool\n\ttimeout  time.Duration\n\thc       *http.Client\n}\n\ntype reply struct {\n\tstatus int\n\theader http.Header\n\tbody   []byte\n}\n\nfunc (c *connector) get(hc *http.Client, path string) (reply, error) {\n\tctx, cancel := context.WithTimeout(c.ctx, c.timeout)\n\tdefer cancel()\n\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, c.base+path, nil)\n\tif err != nil {\n\t\treturn reply{}, err\n\t}\n\treq.Header.Set(\"Accept\", \"application/vnd.github+json\")\n\treq.Header.Set(\"User-Agent\", \"ard\")\n\tresp, err := hc.Do(req)\n\tif err != nil {\n\t\tif c.ctx.Err() != nil {\n\t\t\treturn reply{}, c.ctx.Err()\n\t\t}\n\t\tvar ce *ConnectError\n\t\tif errors.As(err, &ce) {\n\t\t\treturn reply{}, ce\n\t\t}\n\t\treturn reply{}, &ConnectError{Kind: ConnUnreachable, Detail: \"cannot reach \" + c.base}\n\t}\n\tdefer resp.Body.Close()\n\tb, _ := io.ReadAll(io.LimitReader(resp.Body, 1<<20))\n\treturn reply{status: resp.StatusCode, header: resp.Header, body: b}, nil\n}\n\n// repoErr maps a failed repo request to a ConnectError.\nfunc (c *connector) repoErr(status int, token bool) *ConnectError {\n\tswitch {\n\tcase status == http.StatusUnauthorized:\n\t\treturn &ConnectError{Kind: ConnUnauthorized, Detail: \"GitHub rejected the credentials (bad, expired or revoked)\"}\n\tcase status == http.StatusNotFound && token:\n\t\treturn &ConnectError{Kind: ConnRepoNotFound, Detail: c.repo.String() + \" not found (or the token cannot see it)\"}\n\tcase status == http.StatusNotFound:\n\t\treturn &ConnectError{Kind: ConnRepoNotFound, Detail: c.repo.String() + \" not found\"}\n\tcase status == http.StatusForbidden:\n\t\treturn &ConnectError{Kind: ConnMissingPermission, Detail: \"access to \" + c.repo.String() + \" is forbidden (missing repository access or permission)\"}\n\t}\n\treturn &ConnectError{Kind: ConnUnreachable, Detail: fmt.Sprintf(\"GET %s returned HTTP %d\", c.repo, status)}\n}\n\nfunc (c *connector) token(conn Connection) (Connection, error) {\n\tr, err := c.get(c.hc, \"/repos/\"+c.repo.String())\n\tif err != nil {\n\t\treturn conn, err\n\t}\n\tif r.status != http.StatusOK {\n\t\treturn conn, c.repoErr(r.status, true)\n\t}\n\tvar repo struct {\n\t\tPermissions struct {\n\t\t\tPush bool `json:\"push\"`\n\t\t\tPull bool `json:\"pull\"`\n\t\t} `json:\"permissions\"`\n\t}\n\tif err := json.Unmarshal(r.body, &repo); err != nil {\n\t\treturn conn, &ConnectError{Kind: ConnUnreachable, Detail: \"unexpected response for the repository\"}\n\t}\n\tif sc, ok := r.header[\"X-Oauth-Scopes\"]; ok {\n\t\tconn.Scopes = []string{}\n\t\tfor _, s := range strings.Split(strings.Join(sc, \",\"), \",\") {\n\t\t\tif s = strings.TrimSpace(s); s != \"\" {\n\t\t\t\tconn.Scopes = append(conn.Scopes, s)\n\t\t\t}\n\t\t}\n\t\tif !c.readOnly && !hasScope(conn.Scopes, \"repo\") {\n\t\t\treturn conn, &ConnectError{Kind: ConnMissingPermission, Detail: \"classic token lacks the repo scope (contents, issues and pull requests write)\"}\n\t\t}\n\t}\n\tconn.Permissions = map[string]string{}\n\tlevel := \"read\"\n\tif repo.Permissions.Push {\n\t\tlevel = \"write\"\n\t}\n\tif !repo.Permissions