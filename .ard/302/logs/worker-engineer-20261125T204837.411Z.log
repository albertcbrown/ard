k: %v (stderr: %s)\", err, stderr.String())\n\t}\n\tout := stdout.String()\n\tfor _, want := range []string{\"max_pods: 5\", \"executor: local\", \"every: 6h\", \"name: cve\", \"dir: .ard/scanners/cve\"} {\n\t\tif !strings.Contains(out, want) {\n\t\t\tt.Errorf(\"stdout missing %q:\\n%s\", want, out)\n\t\t}\n\t}\n\t// The fixture's triage role has no Dockerfile and network defaults to\n\t// true, so the host and host-network warnings are all that is on stderr.\n\tif want := local.HostRoleText(\"triage\", \"lead\") + local.HostNetworkText(\"triage\", \"lead\"); stderr.String() != want {","is_error":false}]},"parent_tool_use_id":null,"session_id":"65048bc8-546a-4025-a94f-356c42be7752","uuid":"22bc8b7e-a21a-482f-bcd1-4fdcd01eaa72","timestamp":"2026-11-25T20:53:14.040Z","tool_use_result":{"stdout":"package configcmd\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"errors\"\n\t\"io\"\n\t\"log/slog\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/albertcbrown/ard/internal/cli\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/executor\"\n\t\"github.com/albertcbrown/ard/internal/executor/local\"\n\t\"github.com/albertcbrown/ard/internal/gitx/gittest\"\n)\n\nfunc testEnv(t *testing.T, configPath string) (*cli.Env, *bytes.Buffer, *bytes.Buffer) {\n\tt.Helper()\n\tvar stdout, stderr bytes.Buffer\n\te := &cli.Env{\n\t\tGlobals: cli.Globals{ConfigPath: configPath},\n\t\tLog:     slog.New(slog.NewTextHandler(io.Discard, nil)),\n\t\tStdout:  &stdout,\n\t\tStderr:  &stderr,\n\t}\n\treturn e, &stdout, &stderr\n}\n\n// writeRepo materialises a repository with .ard/config.yaml and one scanner\n// role, returning its root.\nfunc writeRepo(t *testing.T, config string) string {\n\tt.Helper()\n\troot := t.TempDir()\n\tmk := func(rel, data string, mode os.FileMode) {\n\t\tt.Helper()\n\t\tp := filepath.Join(root, filepath.FromSlash(rel))\n\t\tif err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {\n\t\t\tt.Fatal(err