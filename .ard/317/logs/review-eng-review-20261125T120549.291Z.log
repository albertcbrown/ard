Meta is the metadata common to every object.\n1178\t+type ObjectMeta struct {\n1179\t+\tName              string            `json:\"name,omitempty\"`\n1180\t+\tNamespace         string            `json:\"namespace,omitempty\"`\n1181\t+\tUID               string            `json:\"uid,omitempty\"`\n1182\t+\tLabels            map[string]string `json:\"labels,omitempty\"`\n1183\t+\tAnnotations       map[string]string `json:\"annotations,omitempty\"`\n1184\t+\tOwnerReferences   []OwnerReference  `json:\"ownerReferences,omitempty\"`\n1185\t+\tCreationTimestamp time.Time         `json:\"creationTimestamp,omitzero\"`\n1186\t+}\n1187\t+\n1188\t+// OwnerReference links an object to its owner.\n1189\t+type OwnerReference struct {\n1190\t+\tAPIVersion string `json:\"apiVersion,omitempty\"`\n1191\t+\tKind       string `json:\"kind,omitempty\"`\n1192\t+\tName       string `json:\"name,omitempty\"`\n1193\t+\tUID        string `json:\"uid,omitempty\"`\n1194\t+}\n1195\t+\n1196\t+// Pod is a v1 Pod.\n1197\t+type Pod struct {\n1198\t+\tMeta   ObjectMeta `json:\"metadata\"`\n1199\t+\tSpec   PodSpec    `json:\"spec\"`\n1200\t+\tStatus PodStatus  `json:\"status,omitzero\"`\n1201\t+}\n1202\t+\n1203\t+// PodSpec is the part of the pod spec ard sets.\n1204\t+type PodSpec struct {\n1205\t+\tInitContainers                []Container         `json:\"initContainers,omitempty\"`\n1206\t+\tContainers                    []Container         `json:\"containers,omitempty\"`\n1207\t+\tVolumes                       []Volume            `json:\"volumes,omitempty\"`\n1208\t+\tRestartPolicy                 string              `json:\"restartPolicy,omitempty\"`\n1209\t+\tActiveDeadlineSeconds         *int64              `json:\"activeDeadlineSeconds,omitempty\"`\n1210\t+\tTerminationGracePeriodSeconds *int64              `json:\"terminationGracePeriodSeconds,omitempty\"`\n1211\t+\tAutomountServiceAccountToken  *bool               `json:\"automountServiceAccountToken,omitempty\"`\n1212\t+\tEnableServiceLinks            *bool               `json:\"enableServiceLinks,omitempty\"`\n1213\t+\tServiceAccountName            string              `json:\"serviceAccountName,omitempty\"`\n1214\t+\tSecurityContext               *PodSecurityContext `json:\"securityContext,omitempty\"`\n1215\t+\tShareProcessNamespace         *bool               `json:\"shareProcessNamespace,omitempty\"`\n1216\t+}\n1217\t+\n1218\t+// Container is a v1 Container.\n1219\t+type Container struct {\n1220\t+\tName                     string               `json:\"name\"`\n1221\t+\tImage                    string               `json:\"image,omitempty\"`\n1222\t+\tImagePullPolicy          string               `json:\"imagePullPolicy,omitempty\"`\n1223\t+\tTerminationMessagePolicy string               `json:\"terminationMessagePolicy,omitempty\"`\n1224\t+\tCommand                  []string             `json:\"command,omitempty\"`\n1225\t+\tArgs                     []string             `json:\"args,omitempty\"`\n1226\t+\tEnv                      []EnvVar             `json:\"env,omitempty\"`\n1227\t+\tPorts                    []ContainerPort      `json:\"ports,omitempty\"`\n1228\t+\tVolumeMounts             []VolumeMount        `json:\"volumeMounts,omitempty\"`\n1229\t+\tResources                ResourceRequirements `json:\"resources,omitzero\"`\n1230\t+\tSecurityContext          *SecurityContext     `json:\"securityContext,omitempty\"`\n1231\t+\tWorkingDir               string               `json:\"workingDir,omitempty\"`\n1232\t+\t// RestartPolicy \"Always\" on an init container makes it a native sidecar.\n1233\t+\tRestartPolicy *string `json:\"restartPolicy,omitempty\"`\n1234\t+}\n1235\t+\n1236\t+// ContainerPort declares a container port.\n1237\t+type ContainerPort struct {\n1238\t+\tName          string `json:\"name,omitempty\"`\n1239\t+\tContainerPort int32  `json:\"containerPort\"`\n1240\t+\tProtocol      string `json:\"protocol,omitempty\"`\n1241\t+}\n1242\t+\n1243\t+// EnvVar is an environment variable,