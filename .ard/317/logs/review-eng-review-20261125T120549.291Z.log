s\", e.Code, e.Reason, e.Message)\n+}\n+\n+// Client is the few Kubernetes endpoints ard uses. There is deliberately no\n+// pods/exec, no Secret get or list and no patch.\n+type Client interface {\n+\tCreatePod(ctx context.Context, ns string, p *Pod) (*Pod, error)\n+\t// GetPod returns ErrNotFound when the pod does not exist.\n+\tGetPod(ctx context.Context, ns, name string) (*Pod, error)\n+\tListPods(ctx context.Context, ns, labelSelector string) ([]Pod, error)\n+\t// DeletePod uses background propagation; a missing pod is not an error.\n+\tDeletePod(ctx context.Context, ns, name string, graceSec int64) error\n+\t// PodLogs follows the container log with timestamps. A zero sinceTime\n+\t// starts at the beginning.\n+\tPodLogs(ctx context.Context, ns, name, container string, sinceTime time.Time) (io.ReadCloser, error)\n+\t// CreateSecret returns ErrConflict when the Secret exists.\n+\tCreateSecret(ctx context.Context, ns string, s *Secret) error\n+\t// DeleteSecret treats a missing Secret as success.\n+\tDeleteSecret(ctx context.Context, ns, name string) error\n+\tListEvents(ctx context.Context, ns, fieldSelector string) ([]Event, error)\n+}\ndiff --git a/internal/executor/kube/api/fake/fake.go b/internal/executor/kube/api/fake/fake.go\nnew file mode 100644\nindex 0000000..c102f18\n--- /dev/null\n+++ b/internal/executor/kube/api/fake/fake.go\n@@ -0,0 +1,322 @@\n+// Package fake is an in-memory api.Client for tests.\n+package fake\n+\n+import (\n+\t\"context\"\n+\t\"fmt\"\n+\t\"io\"\n+\t\"strings\"\n+\t\"sync\"\n+\t\"time\"\n+\n+\t\"github.com/albertcbrown/ard/internal/executor/kube/api\"\n+)\n+\n+var _ api.Client = (*Fake)(nil)\n+\n+// LogBase is the timestamp of the first scripted log line; line i is at\n+// LogBase + i seconds.\n+var LogBase = time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)\n+\n+// Fake is a mutex-guarded in-memory Client.\n+type Fake struct {\n+\t// Err maps a method name (e.g. \"GetPod\") to an error that method returns.\n+\t// Set it before use; it is read under the lock.\n+\tErr map[string]error\n+\t// LogLimit, when > 0, ends each PodLogs stream after that many lines, so\n+\t// a caller must reconnect with sinceTime.\n+\tLogLimit int\n+\n+\tmu      sync.Mutex\n+\tpods    map[string]*api.Pod // key ns/name\n+\tsecrets map[string]*api.Secret\n+\tevents  map[string][]api.Event // by ns\n+\tlogs    map[string][]string    // key ns/pod/container\n+\tcalls   []string\n+\tnextUID int\n+}\n+\n+// New returns an empty Fake.\n+func New() *Fake {\n+\treturn &Fake{\n+\t\tErr:     map[string]error{},\n+\t\tpods:    map[string]*api.Pod{},\n+\t\tsecrets: map[string]*api.Secret{},\n+\t\tevents:  map[string][]api.Event{},\n+\t\tlogs:    map[string][]string{},\n+\t}\n+}\n+\n+func key(ns, name string) string { return ns + \"/\" + name }\n+\n+// enter records the call and returns any injected error. Caller holds mu.\n+func (f *Fake) enter(method string) error {\n+\tf.calls = append(f.calls, method)\n+\treturn f.Err[method]\n+}\n+\n+// Calls returns the method names called so far, in order.\n+func (f *Fake) Calls() []string {\n+\tf.mu.Lock()\n+\tdefer f.mu.Unlock()\n+\treturn append([]string(nil), f.calls...)\n+}\n+\n+func (f *Fake) uid() string {\n+\tf.nextUID++\n+\treturn fmt.Sprintf(\"uid-%d\", f.nextUID)\n+}\n+\n+func copyPod(p *api.Pod) *api.Pod {\n+\tc := *p\n+\tc.Status.ContainerStatuses = append([]api.ContainerStatus(nil), p.Status.ContainerStatuses...)\n+\tc.Status.InitContainerStatuses = append([]api.ContainerStatus(nil), p.Status.InitContainerStatuses...)\n+\treturn &c\n+}\n+\n+func (f *Fake) CreatePod(_ context.Context, ns string, p *api.Pod) (*api.Pod, error) {\n+\tf.mu.Lock()\n+\tdefer f.mu.Unlock()\n+\tif err := f.enter(\"CreatePod\"); err != nil {\n+\t\treturn nil, err\n+\t}\n+\tk := key(ns, p.Meta.Name)\n+\tif _, ok := f.pods[k]; ok {\n+\t\treturn nil, api.ErrConflict\n+\t}\n+\tc := copyPod(p)\n+\tc.Meta.Namespace = ns\n+\tc.Meta.UID = f.uid()\n+\tc.Status.Phase = \"Pending\"\n+\tf.pods[k] = c\n+\treturn copyPod(c), nil\n+}\n+\n+func (f *Fake) GetPod(_ context.Context, ns, name string) (*api.Pod, error) {\n+\tf.mu.Lock()\n+\tdefer f.mu.Unlock()\n+\tif err := f.enter(\"GetPod\"); err != nil {\n+\t\treturn nil, err\n+\t}\n+\tp, ok := f.pods[key(ns, name)]\n+\tif !ok {\n+\t\treturn nil, api.ErrNotFound\n+\t}\n+\treturn copyPod(p), nil\n+}\n+\n+// parseSelector parses \"k=v,k2=v2\" (equality only; \"==\" accepted).\n+func parseSelector(sel string) (map[string]string, error) {\n+\tout := map[string]string{}\n+\tif strings.TrimSpace(sel) == \"\" {\n+\t\treturn out, nil\n+\t}\n+\tfor _, part := range strings.Split(sel, \",\") {\n+\t\tk, v, ok := strings.Cut(strings.TrimSpace(part), \"=\")\n+\t\tif !ok || k == \"\" {\n+\t\t\treturn nil, fmt.Errorf(\"fake: unsupported selector %q\", part)\n+\t\t}\n+\t\tout[k] = strings.TrimPrefix(v, \"=\")\n+\t}\n+\treturn out, nil\n+}\n+\n+func (f *Fake) ListPods(_ context.Context, ns, labelSelector string) ([]api.Pod, error) {\n+\tf.mu.Lock()\n+\tdefer f.mu.Unlock()\n+\tif err := f.enter(\"ListPods\"); err != nil {\n+\t\treturn nil, err\n+\t}\n+\twant, err := parseSelector(labelSelector)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tvar out []api.Pod\n+\tfor _, p := range f.pods {\n+\t\tif p.Meta.Namespace != ns {\n+\t\t\tcontinue\n+\t\t}\n+\t\tmatch := true\n+\t\tfor k, v := range want {\n+\t\t\tif got, ok := p.Meta.Labels[k]; !ok || got != v {\n+\t\t\t\tmatch = false\n+\t\t\t\tbreak\n+\t\t\t}\n+\t\t}\n+\t\tif match {\n+\t\t\tout = append(out, *copyPod(p))\n+\t\t}\n+\t}\n+\treturn out, nil\n+}\n+\n+func (f *Fake) DeletePod(_ context.Context, ns, name string, _ int64) error {\n+\tf.mu.Lock()\n+\tdefer f.mu.Unlock()\n+\tif err := f.enter(\"DeletePod\"); err != nil {\n+\t\treturn err\n+\t}\n+\tdelete(f.pods, key(ns, name))\n+\treturn nil\n+}\n+\n+func (f *Fake) CreateSecret(_ context.Context, ns string, s *api.Secret) error {\n+\tf.mu.Lock()\n+\tdefer f.mu.Unlock()\n+\tif err := f.enter(\"CreateSecret\"); err != nil {\n+\t\treturn err\n+\t}\n+\tk := key(ns, s.Meta.Name)\n+\tif _, ok := f.secrets[k]; ok {\n+\t\treturn api.ErrConflict\n+\t}\n+\tc := *s\n+\tc.Data = cloneData(s.Data)\n+\tc.Meta.Namespace = ns\n+\tc.Meta.UID = f.uid()\n+\tf.secrets[k] = &c\n+\treturn nil\n+}\n+\n+func (f *Fake) DeleteSecret(_ context.Context, ns, name string) error {\n+\tf.mu.Lock()\n+\tdefer f.mu.Unlock()\n+\tif err := f.enter(\"DeleteSecret\"); err != nil {\n+\t\treturn err\n+\t}\n+\tdelete(f.secrets, key(ns, name))\n+\treturn nil\n+}\n+\n+// Secret returns a stored Secret for assertions (the Client has no Get).\n+func (f *Fake) Secret(ns, name string) (*api.Secret, bool) {\n+\tf.mu.Lock()\n+\tdefer f.mu.Unlock()\n+\ts, ok := f.secrets[key(ns, name)]\n+\tif !ok {\n+\t\treturn nil, false\n+\t}\n+\tc := *s\n+\tc.Data = cloneData(s.Data)\n+\treturn &c, true\n+}\n+\n+func (f *Fake) ListEvents(_ context.Context, ns, fieldSelector string) ([]api.Event, error) {\n+\tf.mu.Lock()\n+\tdefer f.mu.Unlock()\n+\tif err := f.enter(\"ListEvents\"); err != nil {\n+\t\treturn nil, err\n+\t}\n+\twant, err := parseSelector(fieldSelector)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tvar out []api.Event\n+\tfor _, e := range f.events[ns] {\n+\t\tif v, ok := want[\"involvedObject.name\"]; ok && e.InvolvedObject.Name != v {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif v, ok := want[\"involvedObject.uid\"]; ok && e.InvolvedObject.UID != v {\n+\t\t\tcontinue\n+\t\t}\n+\t\tout = append(out, e)\n+\t}\n+\treturn out, nil\n+}\n+\n+// AddEvent stores an event in ns.\n+func (f *Fake) AddEvent(ns string, e api.Event) {\n+\tf.mu.Lock()\n+\tdefer f.mu.Unlock()\n+\te.Meta.Namespace = ns\n+\tf.events[ns] = append(f.events[ns], e)\n+}\n+\n+func (f *Fake) mutate(ns, name string, fn func(*api.Pod)) error {\n+\tf.mu.Lock()\n+\tdefer f.mu.Unlock()\n+\tp, ok := f.pods[key(ns, name)]\n+\tif !ok {\n+\t\treturn api.ErrNotFound\n+\t}\n+\tfn(p)\n+\treturn nil\n+}\n+\n+// SetPhase sets the pod phase.\n+func (f *Fake) SetPhase(ns, name, phase string) error {\n+\treturn f.mutate(ns, name, func(p *api.Pod) { p.Status.Phase = phase })\n+}\n+\n+// SetPodIP sets the pod IP.\n+func (f *Fake) SetPodIP(ns, name, ip string) error {\n+\treturn f.mutate(ns, name, func(p *api.Pod) { p.Status.PodIP = ip })\n+}\n+\n+// SetContainer sets the state of the named container status, replacing an\n+// existing entry or appending one.\n+func (f *Fake) SetContainer(ns, pod, name string, st api.ContainerState) error {\n+\treturn f.mutate(ns, pod, func(p *api.Pod) {\n+\t\tfor i := range p.Status.ContainerStatuses {\n+\t\t\tif p.Status.ContainerStatuses[i].Name == name {\n+\t\t\t\tp.Status.ContainerStatuses[i].State = st\n+\t\t\t\treturn\n+\t\t\t}\n+\t\t}\n+\t\tp.Status.ContainerStatuses = append(p.Status.ContainerStatuses, api.ContainerStatus{Name: name, State: st})\n+\t})\n+}\n+\n+// Evict marks the pod Failed with reason Evicted.\n+func (f *Fake) Evict(ns, name string) error {\n+\treturn f.mutate(ns, name, func(p *api.Pod) {\n+\t\tp.Status.Phase = \"Failed\"\n+\t\tp.Status.Reason = \"Evicted\"\n+\t})\n+}\n+\n+// SetLogs scripts a container's log. Line i is served as\n+// \"<LogBase+i seconds, RFC3339Nano> <line>\".\n+func (f *Fake) SetLogs(ns, pod, container string, lines []string) {\n+\tf.mu.Lock()\n+\tdefer f.mu.Unlock()\n+\tf.logs[ns+\"/\"+pod+\"/\"+container] = append([]string(nil), lines...)\n+}\n+\n+// PodLogs serves the scripted lines strictly after sinceTime, at most\n+// LogLimit of them when set.\n+func (f *Fake) PodLogs(_ context.Context, ns, name, container string, sinceTime time.Time) (io.ReadCloser, error) {\n+\tf.mu.Lock()\n+\tdefer f.mu.Unlock()\n+\tif err := f.enter(\"PodLogs\"); err != nil {\n+\t\treturn nil, err\n+\t}\n+\tif _, ok := f.pods[key(ns, name)]; !ok {\n+\t\treturn nil, api.ErrNotFound\n+\t}\n+\tvar b strings.Builder\n+\tn := 0\n+\tfor i, l := range f.logs[ns+\"/\"+name+\"/\"+container] {\n+\t\tts := LogBase.Add(time.Duration(i) * time.Second)\n+\t\tif !sinceTime.IsZero() && !ts.After(sinceTime) {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif f.LogLimit > 0 && n >= f.LogLimit {\n+\t\t\tbreak\n+\t\t}\n+\t\tfmt.Fprintf(&b, \"%s %s\\n\", ts.Format(time.RFC3339Nano), l)\n+\t\tn++\n+\t}\n+\treturn io.NopCloser(strings.NewReader(b.String())), nil\n+}\n+\n+func cloneData(m map[string][]byte) map[string][]byte {\n+\tif m == nil {\n+\t\treturn nil\n+\t}\n+\tc := make(map[string][]byte, len(m))\n+\tfor k, v := range m {\n+\t\tc[k] = append([]byte(nil), v...)\n+\t}\n+\treturn c\n+}\ndiff --git a/internal/executor/kube/api/fake/fake_test.go b/internal/executor/kube/api/fake/fake_test.go\nnew file mode 100644\nindex 0000000..c2ec206\n--- /dev/null\n+++ b/internal/executor/kube/api/fake/fake_test.go\n@@ -0,0 +1,156 @@\n+package fake\n+\n+import (\n+\t\"context\"\n+\t\"errors\"\n+\t\"io\"\n+\t\"strings\"\n+\t\"testing\"\n+\t\"time\"\n+\n+\t\"github.com/albertcbrown/ard/internal/executor/kube/api\"\n+)\n+\n+var ctx = context.Background()\n+\n+func pod(name string, labels map[string]string) *api.Pod {\n+\treturn &api.Pod{Meta: api.ObjectMeta{Name: name, Labels: labels}}\n+}\n+\n+func TestRoundTrip(t *testing.T) {\n+\tf := New()\n+\tp, err := f.CreatePod(ctx, \"ns\", pod(\"a\", nil))\n+\tif err != nil || p.Meta.UID == \"\" || p.Status.Phase != \"Pending\" {\n+\t\tt.Fatalf(\"create: %v %+v\", err, p)\n+\t}\n+\tif _, err := f.CreatePod(ctx, \"ns\", pod(\"a\", nil)); !errors.Is(err, api.ErrConflict) {\n+\t\tt.Fatalf(\"duplicate: %v\", err)\n+\t}\n+\tif _, err := f.GetPod(ctx, \"ns\", \"a\"); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif err := f.DeletePod(ctx, \"ns\", \"a\", 0); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif err := f.DeletePod(ctx, \"ns\", \"a\", 0); err != nil {\n+\t\tt.Fatalf(\"second delete: %v\", err)\n+\t}\n+\tif _, err := f.GetPod(ctx, \"ns\", \"a\"); !errors.Is(err, api.ErrNotFound) {\n+\t\tt.Fatalf(\"get after delete: %v\", err)\n+\t}\n+}\n+\n+func TestSecrets(t *testing.T) {\n+\tf := New()\n+\ts := &api.Secret{Meta: api.ObjectMeta{Name: \"s\"}, Data: map[string][]byte{\"k\": []byte(\"v\")}}\n+\tif err := f.CreateSecret(ctx, \"ns\", s); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif err := f.CreateSecret(ctx, \"ns\", s); !errors.Is(err, api.ErrConflict) {\n+\t\tt.Fatalf(\"dup: %v\", err)\n+\t}\n+\tif _, ok := f.Secret(\"ns\", \"s\"); !ok {\n+\t\tt.Fatal(\"missing secret\")\n+\t}\n+\tif err := f.DeleteSecret(ctx, \"ns\", \"s\"); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif err := f.DeleteSecret(ctx, \"ns\", \"s\"); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+}\n+\n+func TestEvict(t *testing.T) {\n+\tf := New()\n+\tf.CreatePod(ctx, \"ns\", pod(\"a\", nil))\n+\tif err := f.Evict(\"ns\", \"a\"); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tp, _ := f.GetPod(ctx, \"ns\", \"a\")\n+\tif p.Status.Phase != \"Failed\" || p.Status.Reason != \"Evicted\" {\n+\t\tt.Fatalf(\"status %+v\", p.Status)\n+\t}\n+}\n+\n+func TestSetContainer(t *testing.T) {\n+\tf := New()\n+\tf.CreatePod(ctx, \"ns\", pod(\"a\", nil))\n+\tf.SetContainer(\"ns\", \"a\", \"agent\", api.ContainerState{Running: &api.StateRunning{}})\n+\tf.SetContainer(\"ns\", \"a\", \"agent\", api.ContainerState{Terminated: &api.StateTerminated{ExitCode: 3}})\n+\tp, _ := f.GetPod(ctx, \"ns\", \"a\")\n+\tif len(p.Status.ContainerStatuses) != 1 || p.Status.ContainerStatuses[0].State.Terminated.ExitCode != 3 {\n+\t\tt.Fatalf(\"status %+v\", p.Status)\n+\t}\n+}\n+\n+func readAll(t *testing.T, rc io.ReadCloser) string {\n+\tt.Helper()\n+\tdefer rc.Close()\n+\tb, _ := io.ReadAll(rc)\n+\treturn string(b)\n+}\n+\n+func TestLogsResume(t *testing.T) {\n+\tf := New()\n+\tf.LogLimit = 2\n+\tf.CreatePod(ctx, \"ns\", pod(\"a\", nil))\n+\tf.SetLogs(\"ns\", \"a\", \"agent\", []string{\"one\", \"two\", \"three\"})\n+\trc, err := f.PodLogs(ctx, \"ns\", \"a\", \"agent\", time.Time{})\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tfirst := strings.Split(strings.TrimSpace(readAll(t, rc)), \"\\n\")\n+\tif len(first) != 2 || !strings.HasSuffix(first[1], \" two\") {\n+\t\tt.Fatalf(\"first %q\", first)\n+\t}\n+\tts, _, _ := strings.Cut(first[1], \" \")\n+\tsince, err := time.Parse(time.RFC3339Nano, ts)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\trc, _ = f.PodLogs(ctx, \"ns\", \"a\", \"agent\", since)\n+\tif got := strings.TrimSpace(readAll(t, rc)); !strings.HasSuffix(got, \" three\") || strings.Contains(got, \"two\") {\n+\t\tt.Fatalf(\"resume %q\", got)\n+\t}\n+}\n+\n+func TestInjectedErrAndCalls(t *testing.T) {\n+\tf := New()\n+\tboom := errors.New(\"boom\")\n+\tf.Err[\"GetPod\"] = boom\n+\tf.CreatePod(ctx, \"ns\", pod(\"a\", nil))\n+\tif _, err := f.GetPod(ctx, \"ns\", \"a\"); err != boom {\n+\t\tt.Fatalf(\"err %v\", err)\n+\t}\n+\tf.ListPods(ctx, \"ns\", \"\")\n+\tgot := strings.Join(f.Calls(), \",\")\n+\tif got != \"CreatePod,GetPod,ListPods\" {\n+\t\tt.Fatalf(\"calls %s\", got)\n+\t}\n+}\n+\n+func TestListSelector(t *testing.T) {\n+\tf := New()\n+\tf.CreatePod(ctx, \"ns\", pod(\"a\", map[string]string{\"app\": \"ard\", \"job\": \"1\"}))\n+\tf.CreatePod(ctx, \"ns\", pod(\"b\", map[string]string{\"app\": \"ard\", \"job\": \"2\"}))\n+\tf.CreatePod(ctx, \"other\", pod(\"c\", map[string]string{\"app\": \"ard\"}))\n+\tfor sel, want := range map[string]int{\"\": 2, \"app=ard\": 2, \"app=ard,job=2\": 1, \"job=3\": 0} {\n+\t\tgot, err := f.ListPods(ctx, \"ns\", sel)\n+\t\tif err != nil || len(got) != want {\n+\t\t\tt.Errorf(\"%q: %d %v, want %d\", sel, len(got), err, want)\n+\t\t}\n+\t}\n+\tif _, err := f.ListPods(ctx, \"ns\", \"app in (x)\"); err == nil {\n+\t\tt.Error(\"set selector accepted\")\n+\t}\n+}\n+\n+func TestEvents(t *testing.T) {\n+\tf := New()\n+\tf.AddEvent(\"ns\", api.Event{Reason: \"x\", InvolvedObject: api.ObjectReference{Name: \"a\"}})\n+\tf.AddEvent(\"ns\", api.Event{Reason: \"y\", InvolvedObject: api.ObjectReference{Name: \"b\"}})\n+\tgot, _ := f.ListEvents(ctx, \"ns\", \"involvedObject.name=a\")\n+\tif len(got) != 1 || got[0].Reason != \"x\" {\n+\t\tt.Fatalf(\"%+v\", got)\n+\t}\n+}\ndiff --git a/internal/executor/kube/api/rest.go b/internal/executor/kube/api/rest.go\nnew file mode 100644\nindex 0000000..89c722b\n--- /dev/null\n+++ b/internal/executor/kube/api/rest.go\n@@ -0,0 +1,297 @@\n+package api\n+\n+import (\n+\t\"bytes\"\n+\t\"context\"\n+\t\"crypto/tls\"\n+\t\"crypto/x509\"\n+\t\"encoding/json\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"io\"\n+\t\"net\"\n+\t\"net/http\"\n+\t\"net/url\"\n+\t\"os\"\n+\t\"regexp\"\n+\t\"strings\"\n+\t\"time\"\n+\t\"unicode/utf8\"\n+)\n+\n+const (\n+\tdefaultTokenFile = \"/var/run/secrets/kubernetes.io/serviceaccount/token\"\n+\tdefaultCAFile    = \"/var/run/secrets/kubernetes.io/serviceaccount/ca.crt\"\n+\tmaxBody          = 1 << 20\n+\tmaxMessage       = 512\n+)\n+\n+var dnsLabel = regexp.MustCompile(`^[a-z0-9]([-a-z0-9]*[a-z0-9])?$`)\n+\n+// RESTOptions configures InCluster. Zero values select the in-cluster\n+// defaults.\n+type RESTOptions struct {\n+\tHost      string // host:port; default from KUBERNETES_SERVICE_HOST/_PORT\n+\tTokenFile string\n+\tCAFile    string\n+\tTimeout   time.Duration // per request, except PodLogs; default 30s\n+}\n+\n+type rest struct {\n+\tbase      string\n+\ttokenFile string\n+\tc         *http.Client // with timeout\n+\tstream    *http.Client // no timeout, for log follow\n+}\n+\n+// InCluster returns a Client that talks to the API server with the pod's\n+// projected service account token (re-read on every request) and only the\n+// cluster CA.\n+func InCluster(o RESTOptions) (Client, error) {\n+\thost := o.Host\n+\tif host == \"\" {\n+\t\th, p := os.Getenv(\"KUBERNETES_SERVICE_HOST\"), os.Getenv(\"KUBERNETES_SERVICE_PORT\")\n+\t\tif h == \"\" || p == \"\" {\n+\t\t\treturn nil, errors.New(\"kube: no API host: KUBERNETES_SERVICE_HOST/_PORT unset\")\n+\t\t}\n+\t\thost = net.JoinHostPort(h, p)\n+\t}\n+\tif o.TokenFile == \"\" {\n+\t\to.TokenFile = defaultTokenFile\n+\t}\n+\tif o.CAFile == \"\" {\n+\t\to.CAFile = defaultCAFile\n+\t}\n+\tif o.Timeout <= 0 {\n+\t\to.Timeout = 30 * time.Second\n+\t}\n+\tca, err := os.ReadFile(o.CAFile)\n+\tif err != nil {\n+\t\treturn nil, fmt.Errorf(\"kube: read CA: %w\", err)\n+\t}\n+\tpool := x509.NewCertPool()\n+\tif !pool.AppendCertsFromPEM(ca) {\n+\t\treturn nil, errors.New(\"kube: CA file holds no certificate\")\n+\t}\n+\ttr := &http.Transport{TLSClientConfig: &tls.Config{MinVersion: tls.VersionTLS12, RootCAs: pool}}\n+\tnoRedirect := func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }\n+\treturn &rest{\n+\t\tbase:      \"https://\" + host,\n+\t\ttokenFile: o.TokenFile,\n+\t\tc:         &http.Client{Transport: tr, Timeout: o.Timeout, CheckRedirect: noRedirect},\n+\t\tstream:    &http.Client{Transport: tr, CheckRedirect: noRedirect},\n+\t}, nil\n+}\n+\n+func checkName(kind, s string) error {\n+\tif len(s) == 0 || len(s) > 63 || !dnsLabel.MatchString(s) {\n+\t\treturn fmt.Errorf(\"kube: invalid %s %q\", kind, s)\n+\t}\n+\treturn nil\n+}\n+\n+func (r *rest) path(ns, res, name, sub string) (string, error) {\n+\tif err := checkName(\"namespace\", ns); err != nil {\n+\t\treturn \"\", err\n+\t}\n+\tp := \"/api/v1/namespaces/\" + ns + \"/\" + res\n+\tif name != \"\" {\n+\t\tif err := checkName(\"name\", name); err != nil {\n+\t\t\treturn \"\", err\n+\t\t}\n+\t\tp += \"/\" + name\n+\t}\n+\treturn p + sub, nil\n+}\n+\n+// namedPath is path for a single object: an empty name is an error rather\n+// than a request for the whole collection.\n+func (r *rest) namedPath(ns, res, name, sub string) (string, error) {\n+\tif err := checkName(\"name\", name); err != nil {\n+\t\treturn \"\", err\n+\t}\n+\treturn r.path(ns, res, name, sub)\n+}\n+\n+// do sends a request and returns the 2xx response; the caller closes Body.\n+func (r *rest) do(ctx context.Context, c *http.Client, method, path string, q url.Values, body any) (*http.Response, error) {\n+\tvar rd io.Reader\n+\tif body != nil {\n+\t\tb, err := json.Marshal(body)\n+\t\tif err != nil {\n+\t\t\treturn nil, err\n+\t\t}\n+\t\trd = bytes.NewReader(b)\n+\t}\n+\tu := r.base + path\n+\tif len(q) > 0 {\n+\t\tu += \"?\" + q.Encode()\n+\t}\n+\treq, err := http.NewRequestWithContext(ctx, method, u, rd)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\ttok, err := os.ReadFile(r.tokenFile)\n+\tif err != nil {\n+\t\treturn nil, fmt.Errorf(\"kube: read token: %w\", err)\n+\t}\n+\treq.Header.Set(\"Authorization\", \"Bearer \"+strings.TrimSpace(string(tok)))\n+\treq.Header.Set(\"Accept\", \"application/json\")\n+\tif body != nil {\n+\t\treq.Header.Set(\"Content-Type\", \"application/json\")\n+\t}\n+\tresp, err := c.Do(req)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tif resp.StatusCode >= 200 && resp.StatusCode < 300 {\n+\t\treturn resp, nil\n+\t}\n+\tdefer resp.Body.Close()\n+\traw, _ := io.ReadAll(io.LimitReader(resp.Body, maxBody))\n+\tswitch {\n+\tcase resp.StatusCode == http.StatusNotFound:\n+\t\treturn nil, ErrNotFound\n+\tcase resp.StatusCode == http.StatusConflict:\n+\t\treturn nil, ErrConflict\n+\tcase resp.StatusCode >= 300 && resp.StatusCode < 400:\n+\t\treturn nil, fmt.Errorf(\"kube: unexpected redirect (status %d)\", resp.StatusCode)\n+\t}\n+\tvar st Status\n+\tif json.Unmarshal(raw, &st) != nil {\n+\t\tst = Status{Message: string(raw)}\n+\t}\n+\tif len(st.Message) > maxMessage {\n+\t\tn := maxMessage\n+\t\tfor n > 0 && !utf8.RuneStart(st.Message[n]) {\n+\t\t\tn--\n+\t\t}\n+\t\tst.Message = st.Message[:n]\n+\t}\n+\treturn nil, &StatusError{Code: resp.StatusCode, Reason: st.Reason, Message: st.Message}\n+}\n+\n+func (r *rest) call(ctx context.Context, method, path string, q url.Values, in, out any) error {\n+\tresp, err := r.do(ctx, r.c, method, path, q, in)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tdefer resp.Body.Close()\n+\tif out == nil {\n+\t\t_, _ = io.Copy(io.Discard, io.LimitReader(resp.Body, maxBody))\n+\t\treturn nil\n+\t}\n+\treturn json.NewDecoder(io.LimitReader(resp.Body, 8*maxBody)).Decode(out)\n+}\n+\n+func (r *rest) CreatePod(ctx context.Context, ns string, p *Pod) (*Pod, error) {\n+\tpath, err := r.path(ns, \"pods\", \"\", \"\")\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tvar out Pod\n+\tif err := r.call(ctx, http.MethodPost, path, nil, p, &out); err != nil {\n+\t\treturn nil, err\n+\t}\n+\treturn &out, nil\n+}\n+\n+func (r *rest) GetPod(ctx context.Context, ns, name string) (*Pod, error) {\n+\tpath, err := r.namedPath(ns, \"pods\", name, \"\")\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tvar out Pod\n+\tif err := r.call(ctx, http.MethodGet, path, nil, nil, &out); err != nil {\n+\t\treturn nil, err\n+\t}\n+\treturn &out, nil\n+}\n+\n+func (r *rest) ListPods(ctx context.Context, ns, labelSelector string) ([]Pod, error) {\n+\tpath, err := r.path(ns, \"pods\", \"\", \"\")\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tq := url.Values{}\n+\tif labelSelector != \"\" {\n+\t\tq.Set(\"labelSelector\", labelSelector)\n+\t}\n+\tvar out struct {\n+\t\tItems []Pod `json:\"items\"`\n+\t}\n+\tif err := r.call(ctx, http.MethodGet, path, q, nil, &out); err != nil {\n+\t\treturn nil, err\n+\t}\n+\treturn out.Items, nil\n+}\n+\n+func (r *rest) DeletePod(ctx context.Context, ns, name string, graceSec int64) error {\n+\tpath, err := r.namedPath(ns, \"pods\", name, \"\")\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tbody := map[string]any{\"propagationPolicy\": \"Background\", \"gracePeriodSeconds\": graceSec}\n+\terr = r.call(ctx, http.MethodDelete, path, nil, body, nil)\n+\tif errors.Is(err, ErrNotFound) {\n+\t\treturn nil\n+\t}\n+\treturn err\n+}\n+\n+func (r *rest) PodLogs(ctx context.Context, ns, name, container string, sinceTime time.Time) (io.ReadCloser, error) {\n+\tpath, err := r.namedPath(ns, \"pods\", name, \"/log\")\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tq := url.Values{\"follow\": {\"true\"}, \"timestamps\": {\"true\"}}\n+\tif container != \"\" {\n+\t\tq.Set(\"container\", container)\n+\t}\n+\tif !sinceTime.IsZero() {\n+\t\tq.Set(\"sinceTime\", sinceTime.UTC().Format(time.RFC3339Nano))\n+\t}\n+\tresp, err := r.do(ctx, r.stream, http.MethodGet, path, q, nil)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\treturn resp.Body, nil\n+}\n+\n+func (r *rest) CreateSecret(ctx context.Context, ns string, s *Secret) error {\n+\tpath, err := r.path(ns, \"secrets\", \"\", \"\")\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\treturn r.call(ctx, http.MethodPost, path, nil, s, nil)\n+}\n+\n+func (r *rest) DeleteSecret(ctx context.Context, ns, name string) error {\n+\tpath, err := r.namedPath(ns, \"secrets\", name, \"\")\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\terr = r.call(ctx, http.MethodDelete, path, nil, nil, nil)\n+\tif errors.Is(err, ErrNotFound) {\n+\t\treturn nil\n+\t}\n+\treturn err\n+}\n+\n+func (r *rest) ListEvents(ctx context.Context, ns, fieldSelector string) ([]Event, error) {\n+\tpath, err := r.path(ns, \"events\", \"\", \"\")\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tq := url.Values{}\n+\tif fieldSelector != \"\" {\n+\t\tq.Set(\"fieldSelector\", fieldSelector)\n+\t}\n+\tvar out struct {\n+\t\tItems []Event `json:\"items\"`\n+\t}\n+\tif err := r.call(ctx, http.MethodGet, path, q, nil, &out); err != nil {\n+\t\treturn nil, err\n+\t}\n+\treturn out.Items, nil\n+}\ndiff --git a/internal/executor/kube/api/rest_test.go b/internal/executor/kube/api/rest_test.go\nnew file mode 100644\nindex 0000000..cab0a06\n--- /dev/null\n+++ b/internal/executor/kube/api/rest_test.go\n@@ -0,0 +1,285 @@\n+package api\n+\n+import (\n+\t\"context\"\n+\t\"encoding/json\"\n+\t\"encoding/pem\"\n+\t\"errors\"\n+\t\"io\"\n+\t\"net/http\"\n+\t\"net/http/httptest\"\n+\t\"net/url\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"sync/atomic\"\n+\t\"testing\"\n+\t\"time\"\n+)\n+\n+var ctx = context.Background()\n+\n+type env struct {\n+\tsrv   *httptest.Server\n+\ttoken string\n+\tc     Client\n+\thits  atomic.Int32\n+}\n+\n+func setup(t *testing.T, h http.HandlerFunc) *env {\n+\tt.Helper()\n+\te := &env{}\n+\te.srv = httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n+\t\te.hits.Add(1)\n+\t\th(w, r)\n+\t}))\n+\tt.Cleanup(e.srv.Close)\n+\tdir := t.TempDir()\n+\te.token = filepath.Join(dir, \"token\")\n+\tif err := os.WriteFile(e.token, []byte(\"a\\n\"), 0o600); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tca := filepath.Join(dir, \"ca.crt\")\n+\tpemBytes := pem.EncodeToMemory(&pem.Block{Type: \"CERTIFICATE\", Bytes: e.srv.Certificate().Raw})\n+\tif err := os.WriteFile(ca, pemBytes, 0o600); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tc, err := InCluster(RESTOptions{Host: strings.TrimPrefix(e.srv.URL, \"https://\"), TokenFile: e.token, CAFile: ca})\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\te.c = c\n+\treturn e\n+}\n+\n+func TestTokenReread(t *testing.T) {\n+\tvar seen []string\n+\te := setup(t, func(w http.ResponseWriter, r *http.Request) {\n+\t\tseen = append(seen, r.Header.Get(\"Authorization\"))\n+\t\tw.Write([]byte(`{}`))\n+\t})\n+\te.c.GetPod(ctx, \"ns\", \"p\")\n+\tos.WriteFile(e.token, []byte(\"b\"), 0o600)\n+\te.c.GetPod(ctx, \"ns\", \"p\")\n+\tif strings.Join(seen, \"|\") != \"Bearer a|Bearer b\" {\n+\t\tt.Fatalf(\"seen %v\", seen)\n+\t}\n+}\n+\n+func TestNoRedirect(t *testing.T) {\n+\tvar target atomic.Int32\n+\te := setup(t, func(w http.ResponseWriter, r *http.Request) {\n+\t\tif r.URL.Path == \"/elsewhere\" {\n+\t\t\ttarget.Add(1)\n+\t\t\treturn\n+\t\t}\n+\t\thttp.Redirect(w, r, \"/elsewhere\", http.StatusFound)\n+\t})\n+\tif _, err := e.c.GetPod(ctx, \"ns\", \"p\"); err == nil {\n+\t\tt.Fatal(\"expected error\")\n+\t}\n+\tif target.Load() != 0 {\n+\t\tt.Fatal(\"redirect followed\")\n+\t}\n+}\n+\n+func TestErrors(t *testing.T) {\n+\ttests := []struct {\n+\t\tname   string\n+\t\tcode   int\n+\t\tbody   string\n+\t\tcheck  func(error) bool\n+\t\tmaxMsg int\n+\t}{\n+\t\t{\"404\", 404, `{}`, func(e error) bool { return errors.Is(e, ErrNotFound) }, 0},\n+\t\t{\"409\", 409, `{}`, func(e error) bool { return errors.Is(e, ErrConflict) }, 0},\n+\t\t{\"403\", 403, `{\"code\":403,\"reason\":\"Forbidden\",\"message\":\"no\"}`, func(e error) bool {\n+\t\t\tvar se *StatusError\n+\t\t\treturn errors.As(e, &se) && se.Code == 403 && se.Reason == \"Forbidden\"\n+\t\t}, 0},\n+\t\t{\"big\", 500, `{\"message\":\"` + strings.Repeat(\"x\", 10240) + `\"}`, func(e error) bool {\n+\t\t\tvar se *StatusError\n+\t\t\treturn errors.As(e, &se) && len(se.Message) <= 512\n+\t\t}, 0},\n+\t\t{\"nonjson\", 502, \"bad gateway\", func(e error) bool {\n+\t\t\tvar se *StatusError\n+\t\t\treturn errors.As(e, &se) && se.Code == 502 && se.Message == \"bad gateway\"\n+\t\t}, 0},\n+\t}\n+\tfor _, tc := range tests {\n+\t\tt.Run(tc.name, func(t *testing.T) {\n+\t\t\te := setup(t, func(w http.ResponseWriter, r *http.Request) {\n+\t\t\t\tw.WriteHeader(tc.code)\n+\t\t\t\tio.WriteString(w, tc.body)\n+\t\t\t})\n+\t\t\terr := e.c.CreateSecret(ctx, \"ns\", &Secret{Meta: ObjectMeta{Name: \"s\"}})\n+\t\t\tif err == nil || !tc.check(err) {\n+\t\t\t\tt.Fatalf(\"err %v\", err)\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+func TestCreatePodBody(t *testing.T) {\n+\tvar got map[string]any\n+\te := setup(t, func(w http.ResponseWriter, r *http.Request) {\n+\t\tif r.Method != \"POST\" || r.URL.Path != \"/api/v1/namespaces/ns/pods\" {\n+\t\t\tt.Errorf(\"%s %s\", r.Method, r.URL.Path)\n+\t\t}\n+\t\tb, _ := io.ReadAll(r.Body)\n+\t\tjson.Unmarshal(b, &got)\n+\t\tvar p Pod\n+\t\tjson.Unmarshal(b, &p)\n+\t\tp.Status = PodStatus{Phase: \"Pending\", ContainerStatuses: []ContainerStatus{{Name: \"agent\",\n+\t\t\tState: ContainerState{Terminated: &StateTerminated{ExitCode: 7}}}}}\n+\t\tjson.NewEncoder(w).Encode(p)\n+\t})\n+\tdl := int64(60)\n+\tmode := int32(0o400)\n+\talways := \"Always\"\n+\tin := &Pod{\n+\t\tMeta: ObjectMeta{Name: \"p\"},\n+\t\tSpec: PodSpec{\n+\t\t\tActiveDeadlineSeconds: &dl,\n+\t\t\tInitContainers:        []Container{{Name: \"pre\", Image: \"i\", RestartPolicy: &always}},\n+\t\t\tContainers: []Container{{Name: \"agent\", Env: []EnvVar{{Name: \"K\",\n+\t\t\t\tValueFrom: &EnvVarSource{SecretKeyRef: &SecretKeySelector{Name: \"s\", Key: \"k\"}}}}}},\n+\t\t\tVolumes: []Volume{{Name: \"v\", Secret: &SecretVolumeSource{SecretName: \"s\",\n+\t\t\t\tItems: []KeyToPath{{Key: \"k\", Path: \"k\", Mode: &mode}}}}},\n+\t\t},\n+\t}\n+\tout, err := e.c.CreatePod(ctx, \"ns\", in)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tspec := got[\"spec\"].(map[string]any)\n+\tfor _, k := range []string{\"initContainers\", \"activeDeadlineSeconds\", \"containers\", \"volumes\"} {\n+\t\tif _, ok := spec[k]; !ok {\n+\t\t\tt.Errorf(\"missing spec.%s\", k)\n+\t\t}\n+\t}\n+\tif _, ok := got[\"metadata\"]; !ok {\n+\t\tt.Error(\"missing metadata\")\n+\t}\n+\traw, _ := json.Marshal(got)\n+\tfor _, k := range []string{\"secretKeyRef\", `\"items\"`, `\"restartPolicy\":\"Always\"`} {\n+\t\tif !strings.Contains(string(raw), k) {\n+\t\t\tt.Errorf(\"missing %s\", k)\n+\t\t}\n+\t}\n+\tif out.Status.ContainerStatuses[0].State.Terminated.ExitCode != 7 || *out.Spec.ActiveDeadlineSeconds != 60 {\n+\t\tt.Fatalf(\"round trip %+v\", out)\n+\t}\n+}\n+\n+func TestSecretDataBase64(t *testing.T) {\n+\tvar body map[string]any\n+\te := setup(t, func(w http.ResponseWriter, r *http.Request) {\n+\t\tjson.NewDecoder(r.Body).Decode(&body)\n+\t})\n+\te.c.CreateSecret(ctx, \"ns\", &Secret{Meta: ObjectMeta{Name: \"s\"}, Data: map[string][]byte{\"k\": []byte(\"hi\")}})\n+\tif body[\"data\"].(map[string]any)[\"k\"] != \"aGk=\" {\n+\t\tt.Fatalf(\"%v\", body)\n+\t}\n+}\n+\n+func TestPodLogsQuery(t *testing.T) {\n+\tvar q url.Values\n+\te := setup(t, func(w http.ResponseWriter, r *http.Request) {\n+\t\tq = r.URL.Query()\n+\t\tif !strings.HasSuffix(r.URL.Path, \"/pods/p/log\") {\n+\t\t\tt.Errorf(\"path %s\", r.URL.Path)\n+\t\t}\n+\t\tio.WriteString(w, \"line\\n\")\n+\t})\n+\tsince := time.Date(2026, 1, 2, 3, 4, 5, 6, time.UTC)\n+\trc, err := e.c.PodLogs(ctx, \"ns\", \"p\", \"agent\", since)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tb, _ := io.ReadAll(rc)\n+\trc.Close()\n+\tif string(b) != \"line\\n\" || q.Get(\"follow\") != \"true\" || q.Get(\"timestamps\") != \"true\" ||\n+\t\tq.Get(\"container\") != \"agent\" || q.Get(\"sinceTime\") != \"2026-01-02T03:04:05.000000006Z\" {\n+\t\tt.Fatalf(\"body %q query %v\", b, q)\n+\t}\n+\trc, _ = e.c.PodLogs(ctx, \"ns\", \"p\", \"agent\", time.Time{})\n+\trc.Close()\n+\tif q.Has(\"sinceTime\") {\n+\t\tt.Fatal(\"sinceTime sent for zero time\")\n+\t}\n+}\n+\n+func TestDeletePropagation(t *testing.T) {\n+\tvar body map[string]any\n+\tvar code = 200\n+\te := setup(t, func(w http.ResponseWriter, r *http.Request) {\n+\t\tif r.Method != \"DELETE\" {\n+\t\t\tt.Errorf(\"method %s\", r.Method)\n+\t\t}\n+\t\tbody = nil\n+\t\tjson.NewDecoder(r.Body).Decode(&body)\n+\t\tw.WriteHeader(code)\n+\t\tio.WriteString(w, `{}`)\n+\t})\n+\tif err := e.c.DeletePod(ctx, \"ns\", \"p\", 5); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif body[\"propagationPolicy\"] != \"Background\" || body[\"gracePeriodSeconds\"] != float64(5) {\n+\t\tt.Fatalf(\"body %v\", body)\n+\t}\n+\tcode = 404\n+\tif err := e.c.DeletePod(ctx, \"ns\", \"p\", 5); err != nil {\n+\t\tt.Fatalf(\"pod 404: %v\", err)\n+\t}\n+\tif err := e.c.DeleteSecret(ctx, \"ns\", \"s\"); err != nil {\n+\t\tt.Fatalf(\"secret 404: %v\", err)\n+\t}\n+}\n+\n+func TestBadName(t *testing.T) {\n+\te := setup(t, func(w http.ResponseWriter, r *http.Request) {})\n+\tbad := []string{\"../x\", \"\", \"Upper\", strings.Repeat(\"a\", 64), \"a/b\", \"-a\"}\n+\tfor _, n := range bad {\n+\t\tif _, err := e.c.GetPod(ctx, \"ns\", n); err == nil {\n+\t\t\tt.Errorf(\"name %q accepted\", n)\n+\t\t}\n+\t\tif _, err := e.c.GetPod(ctx, n, \"p\"); err == nil {\n+\t\t\tt.Errorf(\"namespace %q accepted\", n)\n+\t\t}\n+\t}\n+\tif e.hits.Load() != 0 {\n+\t\tt.Fatalf(\"%d requests made\", e.hits.Load())\n+\t}\n+}\n+\n+func TestListSelectors(t *testing.T) {\n+\tvar raw string\n+\te := setup(t, func(w http.ResponseWriter, r *http.Request) {\n+\t\traw = r.URL.RawQuery\n+\t\tio.WriteString(w, `{\"items\":[{\"metadata\":{\"name\":\"x\"}}]}`)\n+\t})\n+\tpods, err := e.c.ListPods(ctx, \"ns\", \"a=b,c=d\")\n+\tif err != nil || len(pods) != 1 || raw != \"labelSelector=a%3Db%2Cc%3Dd\" {\n+\t\tt.Fatalf(\"%v %v %q\", pods, err, raw)\n+\t}\n+\tif _, err := e.c.ListEvents(ctx, \"ns\", \"involvedObject.name=p\"); err != nil || raw != \"fieldSelector=involvedObject.name%3Dp\" {\n+\t\tt.Fatalf(\"%v %q\", err, raw)\n+\t}\n+}\n+\n+func TestInClusterErrors(t *testing.T) {\n+\tt.Setenv(\"KUBERNETES_SERVICE_HOST\", \"\")\n+\tt.Setenv(\"KUBERNETES_SERVICE_PORT\", \"\")\n+\tif _, err := InCluster(RESTOptions{}); err == nil {\n+\t\tt.Error(\"no host accepted\")\n+\t}\n+\tif _, err := InCluster(RESTOptions{Host: \"h:1\", CAFile: filepath.Join(t.TempDir(), \"none\")}); err == nil {\n+\t\tt.Error(\"missing CA accepted\")\n+\t}\n+\tbad := filepath.Join(t.TempDir(), \"ca\")\n+\tos.WriteFile(bad, []byte(\"junk\"), 0o600)\n+\tif _, err := InCluster(RESTOptions{Host: \"h:1\", CAFile: bad}); err == nil {\n+\t\tt.Error(\"junk CA accepted\")\n+\t}\n+}\ndiff --git a/internal/executor/kube/api/types.go b/internal/executor/kube/api/types.go\nnew file mode 100644\nindex 0000000..3f8efa5\n--- /dev/null\n+++ b/internal/executor/kube/api/types.go\n@@ -0,0 +1,236 @@\n+// Package api is a minimal Kubernetes REST layer: only the JSON fields ard\n+// sets or reads, a Client interface, and an in-cluster implementation.\n+// It uses the standard library only (no client-go).\n+package api\n+\n+import \"time\"\n+\n+// ObjectMeta is the metadata common to every object.\n+type ObjectMeta struct {\n+\tName              string            `json:\"name,omitempty\"`\n+\tNamespace         string            `json:\"namespace,omitempty\"`\n+\tUID               string            `json:\"uid,omitempty\"`\n+\tLabels            map[string]string `json:\"labels,omitempty\"`\n+\tAnnotations       map[string]string `json:\"annotations,omitempty\"`\n+\tOwnerReferences   []OwnerReference  `json:\"ownerReferences,omitempty\"`\n+\tCreationTimestamp time.Time         `json:\"creationTimestamp,omitzero\"`\n+}\n+\n+// OwnerReference links an object to its owner.\n+type OwnerReference struct {\n+\tAPIVersion string `json:\"apiVersion,omitempty\"`\n+\tKind       string `json:\"kind,omitempty\"`\n+\tName       string `json:\"name,omitempty\"`\n+\tUID        string `json:\"uid,omitempty\"`\n+}\n+\n+// Pod is a v1 Pod.\n+type Pod struct {\n+\tMeta   ObjectMeta `json:\"metadata\"`\n+\tSpec   PodSpec    `json:\"spec\"`\n+\tStatus PodStatus  `json:\"status,omitzero\"`\n+}\n+\n+// PodSpec is the part of the pod spec ard sets.\n+type PodSpec struct {\n+\tInitContainers                []Container         `json:\"initContainers,omitempty\"`\n+\tContainers                    []Container         `json:\"containers,omitempty\"`\n+\tVolumes                       []Volume            `json:\"volumes,omitempty\"`\n+\tRestartPolicy                 string              `json:\"restartPolicy,omitempty\"`\n+\tActiveDeadlineSeconds         *int64              `json:\"activeDeadlineSeconds,omitempty\"`\n+\tTerminationGracePeriodSeconds *int64              `json:\"terminationGracePeriodSeconds,omitempty\"`\n+\tAutomountServiceAccountToken  *bool               `json:\"automountServiceAccountToken,omitempty\"`\n+\tEnableServiceLinks            *bool               `json:\"enableServiceLinks,omitempty\"`\n+\tServiceAccountName            string              `json:\"serviceAccountName,omitempty\"`\n+\tSecurityContext               *PodSecurityContext `json:\"securityContext,omitempty\"`\n+\tShareProcessNamespace         *bool               `json:\"shareProcessNamespace,omitempty\"`\n+}\n+\n+// Container is a v1 Container.\n+type Container struct {\n+\tName                     string               `json:\"name\"`\n+\tImage                    string               `json:\"image,omitempty\"`\n+\tImagePullPolicy          string               `json:\"imagePullPolicy,omitempty\"`\n+\tTerminationMessagePolicy string               `json:\"terminationMessagePolicy,omitempty\"`\n+\tCommand                  []string             `json:\"command,omitempty\"`\n+\tArgs                     []string             `json:\"args,omitempty\"`\n+\tEnv                      []EnvVar             `json:\"env,omitempty\"`\n+\tPorts                    []ContainerPort      `json:\"ports,omitempty\"`\n+\tVolumeMounts             []VolumeMount        `json:\"volumeMounts,omitempty\"`\n+\tResources                ResourceRequirements `json:\"resources,omitzero\"`\n+\tSecurityContext          *SecurityContext     `json:\"securityContext,omitempty\"`\n+\tWorkingDir               string               `json:\"workingDir,omitempty\"`\n+\t// RestartPolicy \"Always\" on an init container makes it a native sidecar.\n+\tRestartPolicy *string `json:\"restartPolicy,omitempty\"`\n+}\n+\n+// ContainerPort declares a container port.\n+type ContainerPort struct {\n+\tName          string `json:\"name,omitempty\"`\n+\tContainerPort int32  `json:\"containerPort\"`\n+\tProtocol      string `json:\"protocol,omitempty\"`\n+}\n+\n+// EnvVar is an environment variable, literal or from a Secret.\n+type EnvVar struct {\n+\tName      string        `json:\"name\"`\n+\tValue     string        `json:\"value,omitempty\"`\n+\tValueFrom *EnvVarSource `json:\"valueFrom,omitempty\"`\n+}\n+\n+// EnvVarSource is where an EnvVar value comes from.\n+type EnvVarSource struct {\n+\tSecretKeyRef *SecretKeySelector `json:\"secretKeyRef,omitempty\"`\n+}\n+\n+// SecretKeySelector names one key of a Secret.\n+type SecretKeySelector struct {\n+\tName string `json:\"name\"`\n+\tKey  string `json:\"key\"`\n+}\n+\n+// VolumeMount mounts a volume into a container.\n+type VolumeMount struct {\n+\tName      string `json:\"name\"`\n+\tMountPath string `json:\"mountPath\"`\n+\tSubPath   string `json:\"subPath,omitempty\"`\n+\tReadOnly  bool   `json:\"readOnly,omitempty\"`\n+}\n+\n+// Volume is a pod volume: an emptyDir or a Secret.\n+type Volume struct {\n+\tName     string                `json:\"name\"`\n+\tEmptyDir *EmptyDirVolumeSource `json:\"emptyDir,omitempty\"`\n+\tSecret   *SecretVolumeSource   `json:\"secret,omitempty\"`\n+}\n+\n+// EmptyDirVolumeSource is an emptyDir volume.\n+type EmptyDirVolumeSource struct {\n+\tSizeLimit string `json:\"sizeLimit,omitempty\"`\n+}\n+\n+// SecretVolumeSource projects a Secret as files.\n+type SecretVolumeSource struct {\n+\tSecretName  string      `json:\"secretName\"`\n+\tItems       []KeyToPath `json:\"items,omitempty\"`\n+\tDefaultMode *int32      `json:\"defaultMode,omitempty\"`\n+}\n+\n+// KeyToPath maps a Secret key to a file path.\n+type KeyToPath struct {\n+\tKey  string `json:\"key\"`\n+\tPath string `json:\"path\"`\n+\tMode *int32 `json:\"mode,omitempty\"`\n+}\n+\n+// SecurityContext is the container security context.\n+type SecurityContext struct {\n+\tRunAsUser                *int64          `json:\"runAsUser,omitempty\"`\n+\tRunAsGroup               *int64          `json:\"runAsGroup,omitempty\"`\n+\tRunAsNonRoot             *bool           `json:\"runAsNonRoot,omitempty\"`\n+\tAllowPrivilegeEscalation *bool           `json:\"allowPrivilegeEscalation,omitempty\"`\n+\tReadOnlyRootFilesystem   *bool           `json:\"readOnlyRootFilesystem,omitempty\"`\n+\tCapabilities             *Capabilities   `json:\"capabilities,omitempty\"`\n+\tSeccompProfile           *SeccompProfile `json:\"seccompProfile,omitempty\"`\n+}\n+\n+// PodSecurityContext is the pod-level security context.\n+type PodSecurityContext struct {\n+\tRunAsUser      *int64          `json:\"runAsUser,omitempty\"`\n+\tRunAsGroup     *int64          `json:\"runAsGroup,omitempty\"`\n+\tRunAsNonRoot   *bool           `json:\"runAsNonRoot,omitempty\"`\n+\tFSGroup        *int64          `json:\"fsGroup,omitempty\"`\n+\tSeccompProfile *SeccompProfile `json:\"seccompProfile,omitempty\"`\n+}\n+\n+// Capabilities lists Linux capabilities to drop.\n+type Capabilities struct {\n+\tDrop []string `json:\"drop,omitempty\"`\n+}\n+\n+// SeccompProfile selects a seccomp profile type.\n+type SeccompProfile struct {\n+\tType string `json:\"type\"`\n+}\n+\n+// ResourceRequirements are requests and limits by resource name.\n+type ResourceRequirements struct {\n+\tRequests map[string]string `json:\"requests,omitempty\"`\n+\tLimits   map[string]string `json:\"limits,omitempty\"`\n+}\n+\n+// PodStatus is the observed pod state.\n+type PodStatus struct {\n+\tPhase                 string            `json:\"phase,omitempty\"`\n+\tReason                string            `json:\"reason,omitempty\"`\n+\tMessage               string            `json:\"message,omitempty\"`\n+\tPodIP                 string            `json:\"podIP,omitempty\"`\n+\tInitContainerStatuses []ContainerStatus `json:\"initContainerStatuses,omitempty\"`\n+\tContainerStatuses     []ContainerStatus `json:\"containerStatuses,omitempty\"`\n+}\n+\n+// ContainerStatus is one container's observed state.\n+type ContainerStatus struct {\n+\tName         string         `json:\"name\"`\n+\tState        ContainerState `json:\"state,omitzero\"`\n+\tRestartCount int32          `json:\"restartCount,omitempty\"`\n+}\n+\n+// ContainerState is exactly one of Waiting, Running or Terminated.\n+type ContainerState struct {\n+\tWaiting    *StateWaiting    `json:\"waiting,omitempty\"`\n+\tRunning    *StateRunning    `json:\"running,omitempty\"`\n+\tTerminated *StateTerminated `json:\"terminated,omitempty\"`\n+}\n+\n+// StateWaiting is a waiting container.\n+type StateWaiting struct {\n+\tReason  string `json:\"reason,omitempty\"`\n+\tMessage string `json:\"message,omitempty\"`\n+}\n+\n+// StateRunning is a running container.\n+type StateRunning struct {\n+\tStartedAt time.Time `json:\"startedAt,omitzero\"`\n+}\n+\n+// StateTerminated is a terminated container.\n+type StateTerminated struct {\n+\tExitCode   int32     `json:\"exitCode\"`\n+\tSignal     int32     `json:\"signal,omitempty\"`\n+\tReason     string    `json:\"reason,omitempty\"`\n+\tMessage    string    `json:\"message,omitempty\"`\n+\tStartedAt  time.Time `json:\"startedAt,omitzero\"`\n+\tFinishedAt time.Time `json:\"finishedAt,omitzero\"`\n+}\n+\n+// Secret is a v1 Secret; Data is base64 on the wire, which encoding/json\n+// does for []byte.\n+type Secret struct {\n+\tMeta ObjectMeta        `json:\"metadata\"`\n+\tType string            `json:\"type,omitempty\"`\n+\tData map[string][]byte `json:\"data,omitempty\"`\n+}\n+\n+// ObjectReference identifies the object an Event is about.\n+type ObjectReference struct {\n+\tName string `json:\"name,omitempty\"`\n+\tUID  string `json:\"uid,omitempty\"`\n+}\n+\n+// Event is a v1 Event.\n+type Event struct {\n+\tMeta           ObjectMeta      `json:\"metadata\"`\n+\tInvolvedObject ObjectReference `json:\"involvedObject,omitzero\"`\n+\tReason         string          `json:\"reason,omitempty\"`\n+\tMessage        string          `json:\"message,omitempty\"`\n+\tType           string          `json:\"type,omitempty\"`\n+\tLastTimestamp  time.Time       `json:\"lastTimestamp,omitzero\"`\n+}\n+\n+// Status is the body of an API error response.\n+type Status struct {\n+\tCode    int    `json:\"code,omitempty\"`\n+\tReason  string `json:\"reason,omitempty\"`\n+\tMessage string `json:\"message,omitempty\"`\n+}\n","numLines":1406,"startLine":1,"totalLines":1406}},"tool_result_meta":[{"id":"toolu_01Diu4YGCM7ezCjzF8kZdU4i","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
