\tdefaultTokenFile = \"/var/run/secrets/kubernetes.io/serviceaccount/token\"\n599\t+\tdefaultCAFile    = \"/var/run/secrets/kubernetes.io/serviceaccount/ca.crt\"\n600\t+\tmaxBody          = 1 << 20\n601\t+\tmaxMessage       = 512\n602\t+)\n603\t+\n604\t+var dnsLabel = regexp.MustCompile(`^[a-z0-9]([-a-z0-9]*[a-z0-9])?$`)\n605\t+\n606\t+// RESTOptions configures InCluster. Zero values select the in-cluster\n607\t+// defaults.\n608\t+type RESTOptions struct {\n609\t+\tHost      string // host:port; default from KUBERNETES_SERVICE_HOST/_PORT\n610\t+\tTokenFile string\n611\t+\tCAFile    string\n612\t+\tTimeout   time.Duration // per request, except PodLogs; default 30s\n613\t+}\n614\t+\n615\t+type rest struct {\n616\t+\tbase      string\n617\t+\ttokenFile string\n618\t+\tc         *http.Client // with timeout\n619\t+\tstream    *http.Client // no timeout, for log follow\n620\t+}\n621\t+\n622\t+// InCluster returns a Client that talks to the API server with the pod's\n623\t+// projected service account token (re-read on every request) and only the\n624\t+// cluster CA.\n625\t+func InCluster(o RESTOptions) (Client, error) {\n626\t+\thost := o.Host\n627\t+\tif host == \"\" {\n628\t+\t\th, p := os.Getenv(\"KUBERNETES_SERVICE_HOST\"), os.Getenv(\"KUBERNETES_SERVICE_PORT\")\n629\t+\t\tif h == \"\" || p == \"\" {\n630\t+\t\t\treturn nil, errors.New(\"kube: no API host: KUBERNETES_SERVICE_HOST/_PORT unset\")\n631\t+\t\t}\n632\t+\t\thost = net.JoinHostPort(h, p)\n633\t+\t}\n634\t+\tif o.TokenFile == \"\" {\n635\t+\t\to.TokenFile = defaultTokenFile\n636\t+\t}\n637\t+\tif o.CAFile == \"\" {\n638\t+\t\to.CAFile = defaultCAFile\n639\t+\t}\n640\t+\tif o.Timeout <= 0 {\n641\t+\t\to.Timeout = 30 * time.Second\n642\t+\t}\n643\t+\tca, err := os.ReadFile(o.CAFile)\n644\t+\tif err != nil {\n645\t+\t\treturn nil, fmt.Errorf(\"kube: read CA: %w\", err)\n646\t+\t}\n647\t+\tpool := x509.NewCertPool()\n648\t+\tif !pool.AppendCertsFromPEM(ca) {\n649\t+\t\treturn nil, errors.New(\"kube: CA file holds no certificate\")\n650\t+\t}\n651\t+\ttr := &http.Transport{TLSClientConfig: &tls.Config{MinVersion: tls.VersionTLS12, RootCAs: pool}}\n652\t+\tnoRedirect := func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }\n653\t+\treturn &rest{\n654\t+\t\tbase:      \"https://\" + host,\n655\t+\t\ttokenFile: o.TokenFile,\n656\t+\t\tc:         &http.Client{Transport: tr, Timeout: o.Timeout, CheckRedirect: noRedirect},\n657\t+\t\tstream:    &http.Client{Transport: tr, CheckRedirect: noRedirect},\n658\t+\t}, nil\n659\t+}\n660\t+\n661\t+func checkName(kind, s string) error {\n662\t+\tif len(s) == 0 || len(s) > 63 || !dnsLabel.MatchString(s) {\n663\t+\t\treturn fmt.Errorf(\"kube: invalid %s %q\", kind, s)\n664\t+\t}\n665\t+\treturn nil\n666\t+}\n667\t+\n668\t+func (r *rest) path(ns, res, name, sub string) (string, error) {\n669\t+\tif err := checkName(\"namespace\", ns); err != nil {\n670\t+\t\treturn \"\", err\n671\t+\t}\n672\t+\tp := \"/api/v1/namespaces/\" + ns + \"/\" + res\n673\t+\tif name != \"\" {\n674\t+\t\tif err := checkName(\"name\", name); err != nil {\n675\t+\t\t\treturn \"\", err\n676\t+\t\t}\n677\t+\t\tp += \"/\" + name\n678\t+\t}\n679\t+\treturn p + sub, nil\n680\t+}\n681\t+\n682\t+// namedPath is path for a single object: an empty name is an error rather\n683\t+// than a request for the whole collection.\n684\t+func (r *rest) namedPath(ns, res, name, sub string) (string, error) {\n685\t+\tif err := checkName(\"name\", name); err != nil {\n686\t+\t\treturn \"\", err\n687\t+\t}\n688\t+\treturn r.path(ns, res, name, sub)\n689\t+}\n690\t+\n691\t+// do sends a request and returns the 2xx response; the caller closes Body.\n692\t+func (r *rest) do(ctx context.Context, c *http.Client, method, path string, q url.Values, body any) (*http.Response, error) {\n693\t+\tvar rd io.Reader\n694\t+\tif body != nil {\n695\t+\t\tb, err := json.Marshal(body)\n696\t+\t\tif err != nil {\n697\t+\t\t\treturn nil, err\n698\t+\t\t}\n699\t+\t\trd = bytes.NewReader