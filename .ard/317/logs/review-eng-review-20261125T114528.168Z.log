tionTimestamp,omitzero\"`\n1167\t+}\n1168\t+\n1169\t+// OwnerReference links an object to its owner.\n1170\t+type OwnerReference struct {\n1171\t+\tAPIVersion string `json:\"apiVersion,omitempty\"`\n1172\t+\tKind       string `json:\"kind,omitempty\"`\n1173\t+\tName       string `json:\"name,omitempty\"`\n1174\t+\tUID        string `json:\"uid,omitempty\"`\n1175\t+}\n1176\t+\n1177\t+// Pod is a v1 Pod.\n1178\t+type Pod struct {\n1179\t+\tMeta   ObjectMeta `json:\"metadata\"`\n1180\t+\tSpec   PodSpec    `json:\"spec\"`\n1181\t+\tStatus PodStatus  `json:\"status,omitzero\"`\n1182\t+}\n1183\t+\n1184\t+// PodSpec is the part of the pod spec ard sets.\n1185\t+type PodSpec struct {\n1186\t+\tInitContainers                []Container         `json:\"initContainers,omitempty\"`\n1187\t+\tContainers                    []Container         `json:\"containers,omitempty\"`\n1188\t+\tVolumes                       []Volume            `json:\"volumes,omitempty\"`\n1189\t+\tRestartPolicy                 string              `json:\"restartPolicy,omitempty\"`\n1190\t+\tActiveDeadlineSeconds         *int64              `json:\"activeDeadlineSeconds,omitempty\"`\n1191\t+\tTerminationGracePeriodSeconds *int64              `json:\"terminationGracePeriodSeconds,omitempty\"`\n1192\t+\tAutomountServiceAccountToken  *bool               `json:\"automountServiceAccountToken,omitempty\"`\n1193\t+\tEnableServiceLinks            *bool               `json:\"enableServiceLinks,omitempty\"`\n1194\t+\tServiceAccountName            string              `json:\"serviceAccountName,omitempty\"`\n1195\t+\tSecurityContext               *PodSecurityContext `json:\"securityContext,omitempty\"`\n1196\t+\tShareProcessNamespace         *bool               `json:\"shareProcessNamespace,omitempty\"`\n1197\t+}\n1198\t+\n1199\t+// Container is a v1 Container.\n1200\t+type Container struct {\n1201\t+\tName                     string               `json:\"name\"`\n1202\t+\tImage                    string               `json:\"image,omitempty\"`\n1203\t+\tImagePullPolicy          string               `json:\"imagePullPolicy,omitempty\"`\n1204\t+\tTerminationMessagePolicy string               `json:\"terminationMessagePolicy,omitempty\"`\n1205\t+\tCommand                  []string             `json:\"command,omitempty\"`\n1206\t+\tArgs                     []string             `json:\"args,omitempty\"`\n1207\t+\tEnv                      []EnvVar             `json:\"env,omitempty\"`\n1208\t+\tPorts                    []ContainerPort      `json:\"ports,omitempty\"`\n1209\t+\tVolumeMounts             []VolumeMount        `json:\"volumeMounts,omitempty\"`\n1210\t+\tResources                ResourceRequirements `json:\"resources,omitzero\"`\n1211\t+\tSecurityContext          *SecurityContext     `json:\"securityContext,omitempty\"`\n1212\t+\tWorkingDir               string               `json:\"workingDir,omitempty\"`\n1213\t+}\n1214\t+\n1215\t+// ContainerPort declares a container port.\n1216\t+type ContainerPort struct {\n1217\t+\tName          string `json:\"name,omitempty\"`\n1218\t+\tContainerPort int32  `json:\"containerPort\"`\n1219\t+\tProtocol      string `json:\"protocol,omitempty\"`\n1220\t+}\n1221\t+\n1222\t+// EnvVar is an environment variable, literal or from a Secret.\n1223\t+type EnvVar struct {\n1224\t+\tName      string        `json:\"name\"`\n1225\t+\tValue     string        `json:\"value,omitempty\"`\n1226\t+\tValueFrom *EnvVarSource `json:\"valueFrom,omitempty\"`\n1227\t+}\n1228\t+\n1229\t+// EnvVarSource is where an EnvVar value comes from.\n1230\t+type EnvVarSource struct {\n1231\t+\tSecretKeyRef *SecretKeySelector `json:\"secretKeyRef,omitempty\"`\n1232\t+}\n1233\t+\n1234\t+// SecretKeySelector names one key of a Secret.\n1235\t+type SecretKeySelector struct {\n1236\t+\tName string `json:\"name\"`\n1237\t+\tKey  string `json:\"key\"`\n1238\t+}\n1239\t+\n1240\t+// VolumeMount mounts a volume into a container.\n1241\t+type VolumeMount struct {\n1242\t+\tName      string `json:\"name\"`\n1243\t+\tMountPath string `json:\"mountPath\"`\n1244\t+\tSubPath   string `json:\"subPath,omitempty\"`\n1245\t+\tReadOnly  bool   `json:\"readOnly,omitempty\"`\n1246\t+}\n1247\t+\n1248\t+// Volume is a pod volume: an emptyDir or a Secret.\n1249\t+type Volume struct {\n1250\t+\tName     string                `json:\"name\"`\n1251\t+\tEmptyDir *EmptyDirVolumeSource `json:\"emptyDir,omitempty\"`\n1252\t+\tSecret   *SecretVolumeSource   `json:\"secret,omitempty\"`\n1253\t+}\n1254\t+\n1255\t+// EmptyDirVolumeSource is an emptyDir volume.\n1256\t+type EmptyDirVolumeSource struct {\n1257\t+\tSizeLimit string `json:\"sizeLimit,omitempty\"`\n1258\t+}\n1259\t+\n1260\t+// SecretVolumeSource projects a Secret as files.\n1261\t+type SecretVolumeSource struct {\n1262\t+\tSecretName  string      `json:\"secretName\"`\n1263\t+\tItems       []KeyToPath `json:\"items,omitempty\"`\n1264\t+\tDefaultMode *int32      `json:\"defaultMode,omitempty\"`\n1265\t+}\n1266\t+\n1267\t+// KeyToPath maps a Secret key to a file path.\n1268\t+type KeyToPath struct {\n1269\t+\tKey  string `json:\"key\"`\n1270\t+\tPath string `json:\"path\"`\n1271\t+\tMode *int32 `json:\"mode,omitempty\"`\n1272\t+}\n1273\t+\n1274\t+// SecurityContext is the container security context.\n1275\t+type SecurityContext struct {\n1276\t+\tRunAsUser                *int64          `json:\"runAsUser,omitempty\"`\n1277\t+\tRunAsGroup               *int64          `json:\"runAsGroup,omitempty\"`\n1278\t+\tRunAsNonRoot             *bool           `json:\"runAsNonRoot,omitempty\"`\n1279\t+\tAllowPrivilegeEscalation *bool           `json:\"allowPrivilegeEscalation,omitempty\"`\n1280\t+\tReadOnlyRootFilesystem   *bool           `json:\"readOnlyRootFilesystem,omitempty\"`\n1281\t+\tCapabilities             *Capabilities   `json:\"capabilities,omitempty\"`\n1282\t+\tSeccompProfile           *SeccompProfile `json:\"seccompProfile,omitempty\"`\n1283\t+}\n1284\t+\n1285\t+// PodSecurityContext is the pod-level security