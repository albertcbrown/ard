\"}))\n536\t+\tf.CreatePod(ctx, \"other\", pod(\"c\", map[string]string{\"app\": \"ard\"}))\n537\t+\tfor sel, want := range map[string]int{\"\": 2, \"app=ard\": 2, \"app=ard,job=2\": 1, \"job=3\": 0} {\n538\t+\t\tgot, err := f.ListPods(ctx, \"ns\", sel)\n539\t+\t\tif err != nil || len(got) != want {\n540\t+\t\t\tt.Errorf(\"%q: %d %v, want %d\", sel, len(got), err, want)\n541\t+\t\t}\n542\t+\t}\n543\t+\tif _, err := f.ListPods(ctx, \"ns\", \"app in (x)\"); err == nil {\n544\t+\t\tt.Error(\"set selector accepted\")\n545\t+\t}\n546\t+}\n547\t+\n548\t+func TestEvents(t *testing.T) {\n549\t+\tf := New()\n550\t+\tf.AddEvent(\"ns\", api.Event{Reason: \"x\", InvolvedObject: api.ObjectReference{Name: \"a\"}})\n551\t+\tf.AddEvent(\"ns\", api.Event{Reason: \"y\", InvolvedObject: api.ObjectReference{Name: \"b\"}})\n552\t+\tgot, _ := f.ListEvents(ctx, \"ns\", \"involvedObject.name=a\")\n553\t+\tif len(got) != 1 || got[0].Reason != \"x\" {\n554\t+\t\tt.Fatalf(\"%+v\", got)\n555\t+\t}\n556\t+}\n557\tdiff --git a/internal/executor/kube/api/rest.go b/internal/executor/kube/api/rest.go\n558\tnew file mode 100644\n559\tindex 0000000..a32adae\n560\t--- /dev/null\n561\t+++ b/internal/executor/kube/api/rest.go\n562\t@@ -0,0 +1,292 @@\n563\t+package api\n564\t+\n565\t+import (\n566\t+\t\"bytes\"\n567\t+\t\"context\"\n568\t+\t\"crypto/tls\"\n569\t+\t\"crypto/x509\"\n570\t+\t\"encoding/json\"\n571\t+\t\"errors\"\n572\t+\t\"fmt\"\n573\t+\t\"io\"\n574\t+\t\"net\"\n575\t+\t\"net/http\"\n576\t+\t\"net/url\"\n577\t+\t\"os\"\n578\t+\t\"regexp\"\n579\t+\t\"strings\"\n580\t+\t\"time\"\n581\t+)\n582\t+\n583\t+const (\n584\t+\tdefaultTokenFile = \"/var/run/secrets/kubernetes.io/serviceaccount/token\"\n585\t+\tdefaultCAFile    = \"/var/run/secrets/kubernetes.io/serviceaccount/ca.crt\"\n586\t+\tmaxBody          = 1 << 20\n587\t+\tmaxMessage       = 512\n588\t+)\n589\t+\n590\t+var dnsLabel = regexp.MustCompile(`^[a-z0-9]([-a-z0-9]*[a-z0-9])?$`)\n591\t+\n592\t+// RESTOptions configures InCluster. Zero values select the in-cluster\n593\t+// defaults.\n594\t+type RESTOptions struct {\n595\t+\tHost      string // host:port; default from KUBERNETES_SERVICE_HOST/_PORT\n596\t+\tTokenFile string\n597\t+\tCAFile    string\n598\t+\tTimeout   time.Duration // per request, except PodLogs; default 30s\n599\t+}\n600\t+\n601\t+type rest struct {\n602\t+\tbase      string\n603\t+\ttokenFile string\n604\t+\tc         *http.Client // with timeout\n605\t+\tstream    *http.Client // no timeout, for log follow\n606\t+}\n607\t+\n608\t+// InCluster returns a Client that talks to the API server with the pod's\n609\t+// projected service account token (re-read on every request) and only the\n610\t+// cluster CA.\n611\t+func InCluster(o RESTOptions) (Client, error) {\n612\t+\thost := o.Host\n613\t+\tif host == \"\" {\n614\t+\t\th, p := os.Getenv(\"KUBERNETES_SERVICE_HOST\"), os.Getenv(\"KUBERNETES_SERVICE_PORT\")\n615\t+\t\tif h == \"\" || p == \"\" {\n616\t+\t\t\treturn nil, errors.New(\"kube: no API host: KUBERNETES_SERVICE_HOST/_PORT unset\")\n617\t+\t\t}\n618\t+\t\thost = net.JoinHostPort(h, p)\n619\t+\t}\n620\t+\tif o.TokenFile == \"\" {\n621\t+\t\to.TokenFile = defaultTokenFile\n622\t+\t}\n623\t+\tif o.CAFile == \"\" {\n624\t+\t\to.CAFile = defaultCAFile\n625\t+\t}\n626\t+\tif o.Timeout <= 0 {\n627\t+\t\to.Timeout = 30 * time.Second\n628\t+\t}\n629\t+\tca, err := os.ReadFile(o.CAFile)\n630\t+\tif err != nil {\n631\t+\t\treturn nil, fmt.Errorf(\"kube: read CA: %w\", err)\n632\t+\t}\n633\t+\tpool := x509.NewCertPool()\n634\t+\tif !pool.AppendCertsFromPEM(ca) {\n635\t+\t\treturn nil, errors.New(\"kube: CA file holds no certificate\")\n636\t+\t}\n637\t+\ttr := &http.Transport{TLSClientConfig: &tls.Config{MinVersion: tls.VersionTLS12, RootCAs: pool}}\n638\t+\tnoRedirect := func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }\n639\t+\treturn &rest{\n640\t+\t\tbase:      \"https://\" + host,\n641\t+\t\ttokenFile: o.TokenFile,\n642\t+\t\tc:         &http.Client{Transport: tr, Timeout: o.Timeout, CheckRedirect: noRedirect},\n643\t+\t\tstream:    &http.Client{Transport: tr, CheckRedirect: noRedirect},\n644\t+\t}, nil\n645\t+}\n646\t+\n647\t+func checkName(kind, s string) error {\n648\t+\tif len(s) == 0 || len(s) > 63 || !dnsLabel.MatchString(s) {\n649\t+\t\treturn fmt.Errorf(\"kube: invalid %s %q\", kind, s)\n650\t+\t}\n651\t+\treturn nil\n652\t+}\n653\t+\n654\t+func (r *rest) path(ns, res, name, sub string) (string, error) {\n655\t+\tif err := checkName(\"namespace\", ns); err != nil {\n656\t+\t\treturn \"\", err\n657\t+\t}\n658\t+\tp := \"/api/v1/namespaces/\" + ns + \"/\" + res\n659\t+\tif name != \"\" {\n660\t+\t\tif err := checkName(\"name\", name); err != nil {\n661\t+\t\t\treturn \"\", err\n662\t+\t\t}\n663\t+\t\tp += \"/\" + name\n664\t+\t}\n665\t+\treturn p + sub, nil\n666\t+}\n667\t+\n668\t+// namedPath is path for a single object: an empty name is an error rather\n669\t+// than a request for the whole collection.\n670\t+func (r *rest) namedPath(ns, res, name, sub string) (string, error) {\n671\t+\tif err := checkName(\"name\", name); err != nil {\n672\t+\t\treturn \"\", err\n673\t+\t}\n674\t+\treturn r.path(ns, res, name, sub)\n675\t+}\n676\t+\n677\t+// do sends a request and returns the 2xx response; the caller closes Body.\n678\t+func (r *rest) do(ctx context.Context, c *http.Client, method, path string, q url.Values, body any) (*http.Response, error) {\n679\t+\tvar rd io.Reader\n680\t+\tif body != nil {\n681\t+\t\tb, err := json.Marshal(body)\n682\t+\t\tif err != nil {\n683\t+\t\t\treturn nil, err\n684\t+\t\t}\n685\t+\t\trd = bytes.NewReader(b)\n686\t+\t}\n687\t+\tu := r.base + path\n688\t+\tif len(q) > 0 {\n689\t+\t\tu += \"?\" + q.Encode()\n690\t+\t}\n691\t+\treq, err := http.NewRequestWithContext(ctx, method, u, rd)\n692\t+\tif err != nil {\n693\t+\t\treturn nil, err\n694\t+\t}\n695\t+\ttok, err := os.ReadFile(r.tokenFile)\n696\t+\tif err != nil {\n697\t+\t\treturn nil, fmt.Errorf(\"kube: read token: %w\", err)\n