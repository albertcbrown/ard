{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PgCnFYBxWshQmD1xi7Sqgt","type":"tool_result","content":"// Package initcmd implements `ard init`: propose the starter .ard/ tree\n// (internal/roles.FS) as a PR on branch ard-init, and sync the label\n// catalogue. It never writes the working tree or main.\npackage initcmd\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/cli\"\n\t\"github.com/albertcbrown/ard/internal/committer\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/effects\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n\t\"github.com/albertcbrown/ard/internal/labels/labelsync\"\n)\n\n// prTitle is the title of the PR init opens.\nconst prTitle = \"ard init: starter .ard/ configuration\"\n\n// deps is what run needs from the outside; tests supply the GitHub fake,\n// effects.NewLive(fake, gitx.New(\"\"), log) and a file:// remote.\ntype deps struct {\n\tRepo      github.Repo\n\tReader    github.Reader\n\tEffects   effects.Effects\n\tRemoteURL string\n\tToken     gitx.TokenFunc\n\tClose     func() error // optional\n}\n\n// Init is the handler behind `ard init`.\nfunc Init(ctx context.Context, e *cli.Env, o cli.InitOpts) error {\n\treturn run(ctx, e, o, func(ctx context.Context, root string) (deps, error) {\n\t\trepo, err := resolveRepo(ctx, e.Repo, root)\n\t\tif err != nil {\n\t\t\treturn deps{}, err\n\t\t}\n\t\tauth, err := github.AuthFromEnv(os.Getenv, os.ReadFile)\n\t\tif err != nil {\n\t\t\treturn deps{}, fmt.Errorf(\"ard init: %w\", err)\n\t\t}\n\t\tif err := checkAuth(auth.Kind(), e.DryRun); err != nil {\n\t\t\treturn deps{}, err\n\t\t}\n\t\tfx, rd, err := effects.Open(ctx, effects.Options{\n\t\t\tDryRun: e.DryRun,\n\t\t\tGitHub: github.Config{Repo: repo, Auth: auth, Log: e.Log},\n\t\t\tLog:    e.Log,\n\t\t})\n\t\tif err != nil {\n\t\t\treturn deps{}, fmt.Errorf(\"ard init: %w\", err)\n\t\t}\n\t\td := deps{Repo: repo, Reader: rd, Effects: fx, Token: auth.Token, RemoteURL: fmt.Sprintf(\"https://github.com/%s.git\", repo)}\n\t\tif c, ok := fx.(interface{ Close() error }); ok {\n\t\t\td.Close = c.Close\n\t\t}\n\t\treturn d, nil\n\t})\n}\n\n// checkAuth refuses a personal token for a live run, as serve does.\nfunc checkAuth(kind github.AuthKind, dryRun bool) error {\n\tif kind == github.AuthToken && !dryRun {\n\t\treturn errors.New(\"ard init: ARD_GITHUB_TOKEN auth is for --dry-run only; configure a GitHub App\")\n\t}\n\treturn nil\n}\n\n// resolveRepo takes --repo, or falls back to the origin remote of root. Its\n// errors never include the remote URL, which may embed a token.\nfunc resolveRepo(ctx context.Context, flag, root string) (github.Repo, error) {\n\tif flag != \"\" {\n\t\tr, err := github.ParseRepo(flag)\n\t\tif err != nil {\n\t\t\treturn github.Repo{}, fmt.Errorf(\"ard init: %w\", err)\n\t\t}\n\t\treturn r, nil\n\t}\n\turl, err := gitx.New(\"\").RemoteURL(ctx, root, \"origin\")\n\tif err != nil {\n\t\treturn github.Repo{}, errors.New(\"ard init: --repo owner/repo is required (no origin remote to fall back on)\")\n\t}\n\tr, err := github.RepoFromRemote(url)\n\tif err != nil {\n\t\treturn github.Repo{}, errors.New(\"ard init: --repo owner/repo is required (origin remote is not a github.com owner/repo URL)\")\n\t}\n\treturn r, nil\n}\n\n// run does every check before any write; see the order in the comments.\nfunc run(ctx context.Context, e *cli.Env, o cli.InitOpts, open func(ctx context.Context, root string) (deps, error)) error {\n\t// 1. The checkout is only the object store and the origin fallback.\n\troot, err := config.RepoRoot(e.ConfigPath)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tif root, err = filepath.Abs(root); err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tif _, err := os.Stat(filepath.Join(root, \".git\")); err != nil {\n\t\treturn fmt.Errorf(\"ard init: %s is not the root of a git repository (run it there, or pass --config <repo>/.ard/config.yaml)\", root)\n\t}\n\t// 2-3. Repo and credentials.\n\td, err := open(ctx, root)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif d.Close != nil {\n\t\tdefer d.Close()\n\t}\n\t// 4. Who commits.\n\tid, err := d.Reader.Identity(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: identify github user: %w\", err)\n\t}\n\n\ttmp, err := os.MkdirTemp(\"\", \"ard-init-\")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tdefer os.RemoveAll(tmp)\n\n\t// 5. Fetch main; refuse while ard-init exists.\n\tin, err := committer.NewInit(ctx, committer.Config{\n\t\tRepoDir: root, WorkDir: filepath.Join(tmp, \"work\"), RemoteURL: d.RemoteURL,\n\t\tBot: id, Token: d.Token, Log: e.Log,\n\t}, d.Effects, nil)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tbase, err := in.Base(ctx)\n\tswitch {\n\tcase errors.Is(err, committer.ErrInitExists):\n\t\treturn initExistsErr(ctx, d)\n\tcase errors.Is(err, committer.ErrBranchGone):\n\t\treturn fmt.Errorf(\"ard init: %s has no main branch; push an initial commit first\", d.Repo)\n\tcase err != nil:\n\t\treturn fmt.Errorf(\"ard init: fetch main: %w\", err)\n\t}\n\n\t// 6. Plan against main, then validate the result.\n\tfiles, err := starter()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tsnap := filepath.Join(tmp, \"main\")\n\tif err := gitx.New(\"\").ExportPaths(ctx, root, base, snap, append(append(config.SourcePaths(), ContextPaths()...), LockPath)...); err != nil {\n\t\treturn fmt.Errorf(\"ard init: read main's .ard/: %w\", err)\n\t}\n\texisting := os.DirFS(snap)\n\tvar lock Lock\n\tif data, err := os.ReadFile(filepath.Join(snap, filepath.FromSlash(LockPath))); err == nil {\n\t\tvar warns []string\n\t\tlock, warns = ParseLock(data)\n\t\tfor _, w := range warns {\n\t\t\tfmt.Fprintln(e.Stderr, \"warning: \"+w)\n\t\t}\n\t}\n\tpl, err := plan(existing, files, lock)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tops := pl.Ops\n\ttoWrite := changed(ops)\n\tif len(toWrite) > 0 {\n\t\tdata, err := withLock(lock, ops, o.Version).Marshal()\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t\t}\n\t\ttoWrite = append(toWrite, committer.InitFile{Path: LockPath, Data: data})\n\t}\n\tmerged, err := overlay(existing, toWrite)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tres, err := config.LoadFS(merged, root)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: the resulting configuration is invalid, nothing was written:\\n%w\", err)\n\t}\n\twant, err := labels.Desired(labels.SpecFrom(res))\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\n\t// 7. Labels first: a failure leaves nothing pushed, so a rerun is clean.\n\trep, err := labelsync.Sync(ctx, d.Reader, d.Effects, want, e.Log)\n\tif err != nil && rep.Failed == nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tlabelsync.Print(e.Stdout, rep, e.DryRun)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\n\t// 8. Propose.\n\tvar pr github.PullRequest\n\tif len(toWrite) > 0 {\n\t\tpres, err := in.Propose(ctx, base, toWrite)\n\t\tswitch {\n\t\tcase errors.Is(err, committer.ErrInitExists):\n\t\t\treturn initExistsErr(ctx, d)\n\t\tcase err != nil:\n\t\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t\tcase pres.NoOp:\n\t\t\ttoWrite = nil\n\t\t}\n\t}\n\tif len(toWrite) == 0 {\n\t\tif len(toWrite) == 0 {\n\t\t\tprintLeftAlone(e, pl)\n\t\t}\n\t\tfmt.Fprintln(e.Stdout, \"nothing to propose: main already has the starter files, or only edited ones differ\")\n\t\te.Log.InfoContext(ctx, \"init.done\", \"repo\", d.Repo.String(), \"base\", base, \"files\", 0, \"pr\", 0, \"dry_run\", e.DryRun)\n\t\treturn nil\n\t}\n\tprintOps(e, ops)\n\tprintLeftAlone(e, pl)\n\n\t// 9. Open the PR.\n\tpr, err = d.Effects.CreatePR(ctx, github.NewPR{\n\t\tTitle: prTitle, Body: initBody(pl, res), Head: committer.InitBranch, Base: \"main\",\n\t})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: branch %s pushed but opening the PR failed: %w; open it by hand, or delete the branch and rerun\", committer.InitBranch, err)\n\t}\n\n\t// 10. Report.\n\tif e.DryRun {\n\t\tfmt.Fprintf(e.Stdout, \"dry-run: would open a PR from %s\\n\", committer.InitBranch)\n\t} else {\n\t\tfmt.Fprintf(e.Stdout, \"opened PR #%d: %s\\n\", pr.Number, pr.URL)\n\t}\n\te.Log.InfoContext(ctx, \"init.done\", \"repo\", d.Repo.String(), \"base\", base, \"files\", len(toWrite), \"pr\", pr.Number, \"dry_run\", e.DryRun)\n\treturn nil\n}\n\n// printLeftAlone prints the files init did not touch: edited ones with their\n// diff against the starter, and ones the starter dropped.\nfunc printLeftAlone(e *cli.Env, pl Result) {\n\tfor _, o := range pl.Ops {\n\t\tif o.Act == actEdited {\n\t\t\tfmt.Fprintf(e.Stdout, \"edited %s: left alone; the starter differs:\\n%s\", o.File.Path, o.Diff)\n\t\t}\n\t}\n\tfor _, p := range pl.Dropped {\n\t\tfmt.Fprintf(e.Stdout, \"%s: no longer in the starter, left in place\\n\", p)\n\t}\n}\n\n// printOps writes one line per file the PR adds or updates.\nfunc printOps(e *cli.Env, ops []op) {\n\tfor _, o := range ops {\n\t\tif o.Act == actUnchanged || o.Act == actEdited {\n\t\t\tcontinue\n\t\t}\n\t\tverb := string(o.Act)\n\t\tif e.DryRun {\n\t\t\tverb = \"would \" + verb\n\t\t} else {\n\t\t\tverb += \" \"\n\t\t}\n\t\tmode := \"\"\n\t\tif o.File.Exec {\n\t\t\tmode = \" (0755)\"\n\t\t}\n\t\tfmt.Fprintf(e.Stdout, \"%s %s%s\\n\", verb, o.File.Path, mode)\n\t}\n}\n\n// initExistsErr is the refusal when ard-init is already on the remote. It\n// names the open PR when there is one.\nfunc initExistsErr(ctx context.Context, d deps) error {\n\tmsg := \"ard init: branch ard-init already exists on the remote\"\n\tif prs, err := d.Reader.ListPRs(ctx, github.ListPRsOpts{Head: committer.InitBranch, State: github.StateOpen}); err == nil && len(prs) > 0 {\n\t\tmsg += fmt.Sprintf(\" (open PR #%d)\", prs[0].Number)\n\t}\n\treturn errors.New(strings.TrimSpace(msg) + \"; merge or close it and delete the branch, then rerun\")\n}\npackage setupcmd\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"io\"\n\t\"log/slog\"\n\t\"sort\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/labels\"\n\t\"github.com/albertcbrown/ard/internal/labels/labelsync\"\n)\n\n// Opts are the flags of `ard setup`.\ntype Opts struct{ Check bool }\n\n// Deps is what Run needs from the outside world.\ntype Deps struct {\n\tReader      labelsync.Reader\n\tWriter      labelsync.Writer // the effect layer: a dry-run writer writes nothing\n\tDesired     []labels.Label\n\tPermissions func(ctx context.Context) Row\n\tLocalVsMain func(ctx context.Context) (warning string, err error)\n\tDryRun      bool\n\tLog         *slog.Logger\n}\n\nconst (\n\tpermName  = \"permissions\"\n\tlabelName = \"labels\"\n)\n\n// Run executes the checks, then applies when the permission row is ok and\n// Check is not set. The returned report holds the final rows.\nfunc Run(ctx context.Context, d Deps, o Opts, out io.Writer) (Report, error) {\n\tif d.LocalVsMain != nil {\n\t\tw, err := d.LocalVsMain(ctx)\n\t\tif err != nil {\n\t\t\tw = \"could not compare ./.ard/ with origin/main\"\n\t\t}\n\t\tif w != \"\" {\n\t\t\tfmt.Fprintf(out, \"warning: %s\\n\", w)\n\t\t}\n\t}\n\tperm := Row{Name: permName, Status: StatusOK}\n\tif d.Permissions != nil {\n\t\tperm = d.Permissions(ctx)\n\t\tperm.Name = permName\n\t}\n\trep := Report{Rows: []Row{perm}}\n\tif perm.Status != StatusOK {\n\t\t// Nothing else can be read reliably without access.\n\t\treturn rep, nil\n\t}\n\thave, err := d.Reader.ListLabels(ctx)\n\tif err != nil {\n\t\treturn rep, fmt.Errorf(\"setup: list labels: %w\", err)\n\t}\n\tplan := labelsync.Diff(have, d.Desired)\n\trow := Row{Name: labelName, Status: StatusOK}\n\tif n, m := len(plan.Create), len(plan.Update); n+m > 0 {\n\t\trow.Status = StatusDrift\n\t\trow.Detail = fmt.Sprintf(\"%d to create, %d to update\", n, m)\n\t}\n\tif len(plan.Stale) > 0 {\n\t\tsep := \"\"\n\t\tif row.Detail != \"\" {\n\t\t\tsep = \"; \"\n\t\t}\n\t\trow.Detail += sep + \"stale (not deleted): \" + strings.Join(plan.Stale, \", \")\n\t}\n\trep.Rows = append(rep.Rows, row)\n\tif o.Check || row.Status != StatusDrift {\n\t\treturn rep, nil\n\t}\n\n\tsr, err := labelsync.Sync(ctx, d.Reader, d.Writer, d.Desired, d.Log)\n\tif err != nil && sr.Failed == nil {\n\t\treturn rep, err\n\t}\n\trow = Row{Name: labelName, Status: StatusChanged}\n\tswitch {\n\tcase len(sr.Failed) > 0:\n\t\tvar names []string\n\t\tfor n := range sr.Failed {\n\t\t\tnames = append(names, n)\n\t\t}\n\t\tsort.Strings(names)\n\t\trow = Row{Name: labelName, Status: StatusManual, Detail: \"create or update these labels by hand: \" + strings.Join(names, \", \")}\n\tcase d.DryRun:\n\t\trow.Detail = fmt.Sprintf(\"would create %d, would update %d\", len(sr.Create), len(sr.Update))\n\tdefault:\n\t\trow.Detail = fmt.Sprintf(\"created %d, updated %d\", len(sr.Create), len(sr.Update))\n\t}\n\trep.Rows[len(rep.Rows)-1] = row\n\treturn rep, err\n}\npackage cli\n\nimport (\n\t\"context\"\n\n\t\"github.com/spf13/cobra\"\n)\n\nfunc newInit(app *App) *cobra.Command {\n\tcmd := &cobra.Command{\n\t\tUse:   \"init\",\n\t\tShort: \"Open a PR that adds the starter .ard/ directory\",\n\t\tArgs:  cobra.NoArgs,\n\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n\t\t\treturn app.run(cmd, func(ctx context.Context, e *Env) error {\n\t\t\t\tif app.Handlers.Init == nil {\n\t\t\t\t\treturn notImpl(cmd.CommandPath(), \"#27\")\n\t\t\t\t}\n\t\t\t\treturn app.Handlers.Init(ctx, e, InitOpts{Version: app.Version})\n\t\t\t})\n\t\t},\n\t}\n\treturn cmd\n}\npackage initcmd\n\nimport (\n\t\"bytes\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"path\"\n\t\"slices\"\n\t\"sort\"\n\t\"strings\"\n\t\"testing/fstest\"\n\n\t\"github.com/albertcbrown/ard/internal/committer\"\n\t\"github.com/albertcbrown/ard/internal/roles\"\n)\n\n// action says what the PR does to one path on main.\ntype action string\n\nconst (\n\tactCreate    action = \"add\"\n\tactUnchanged action = \"unchanged\"\n\tactUpdate    action = \"update\"\n\tactEdited    action = \"edited\" // differs from the starter and from the lock: left alone\n)\n\n// ContextPaths are the optional repo context docs. ard init proposes each\n// only when it is missing on main: it never updates one, whatever the lock says.\nfunc ContextPaths() []string {\n\treturn []string{\".ard/PRODUCT.md\", \".ard/VISION.md\", \".ard/TECH_STACK.md\"}\n}\n\n// op is one starter file and what proposing it does.\ntype op struct {\n\tFile committer.InitFile\n\tAct  action\n\tDiff string // actEdited: main against the starter\n}\n\n// starter lists the embedded tree as files under .ard/, in sorted path\n// order. Files named in roles.ExecutableNames are executable.\nfunc starter() ([]committer.InitFile, error) {\n\tvar files []committer.InitFile\n\terr := fs.WalkDir(roles.FS, \".\", func(p string, d fs.DirEntry, err error) error {\n\t\tif err != nil || d.IsDir() {\n\t\t\treturn err\n\t\t}\n\t\tdata, err := roles.FS.ReadFile(p)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tfiles = append(files, committer.InitFile{\n\t\t\tPath: \".ard/\" + p,\n\t\t\tData: data,\n\t\t\tExec: slices.Contains(roles.ExecutableNames, path.Base(p)),\n\t\t})\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"read starter files: %w\", err)\n\t}\n\t// WalkDir sorts by entry name, so \"trufflehog/\" would precede \"trufflehog-history/\".\n\tslices.SortFunc(files, func(a, b committer.InitFile) int { return strings.Compare(a.Path, b.Path) })\n\treturn files, nil\n}\n\n// Result is the plan for one run.\ntype Result struct {\n\tOps []op\n\t// Dropped lists files the lock records that the starter no longer ships.\n\t// They are reported and never deleted.\n\tDropped []string\n}\n\n// plan compares files with existing (main's config tree) and the lock. Per\n// file: a context doc is created only when absent; an absent file is created;\n// one identical to the starter (content and exec bit) is unchanged; one whose\n// hash equals its lock entry is updated; any other is edited and never\n// touched, with a diff of main against the starter. No lock or no entry means\n// edited.\nfunc plan(existing fs.FS, files []committer.InitFile, lock Lock) (Result, error) {\n\tres := Result{Ops: make([]op, 0, len(files))}\n\tinStarter := map[string]bool{}\n\tfor _, f := range files {\n\t\tinStarter[f.Path] = true\n\t\to := op{File: f, Act: actCreate}\n\t\tfi, err := fs.Stat(existing, f.Path)\n\t\tswitch {\n\t\tcase err == nil && slices.Contains(ContextPaths(), f.Path):\n\t\t\t// create-if-absent: present in any form is left alone\n\t\t\to.Act = actUnchanged\n\t\tcase err != nil:\n\t\t\t// absent on main\n\t\tcase fi.IsDir():\n\t\t\treturn Result{}, fmt.Errorf(\"%s is a directory on main\", f.Path)\n\t\tdefault:\n\t\t\thave, err := fs.ReadFile(existing, f.Path)\n\t\t\tif err != nil {\n\t\t\t\treturn Result{}, fmt.Errorf(\"read %s from main: %w\", f.Path, err)\n\t\t\t}\n\t\t\thaveExec := fi.Mode()&0o111 != 0\n\t\t\tswitch want, ok := lock.Files[f.Path]; {\n\t\t\tcase bytes.Equal(have, f.Data) && haveExec == f.Exec:\n\t\t\t\to.Act = actUnchanged\n\t\t\tcase ok && want == hashOf(have):\n\t\t\t\to.Act = actUpdate\n\t\t\tdefault:\n\t\t\t\to.Act = actEdited\n\t\t\t\to.Diff = unifiedDiff(f.Path, string(have), string(f.Data))\n\t\t\t}\n\t\t}\n\t\tres.Ops = append(res.Ops, o)\n\t}\n\tfor p := range lock.Files {\n\t\tif !inStarter[p] && !slices.Contains(ContextPaths(), p) {\n\t\t\tres.Dropped = append(res.Dropped, p)\n\t\t}\n\t}\n\tsort.Strings(res.Dropped)\n\treturn res, nil\n}\n\n// changed returns the files the PR adds or updates.\nfunc changed(ops []op) []committer.InitFile {\n\tvar out []committer.InitFile\n\tfor _, o := range ops {\n\t\tif o.Act == actCreate || o.Act == actUpdate {\n\t\t\tout = append(out, o.File)\n\t\t}\n\t}\n\treturn out\n}\n\n// unifiedDiff is a plain line diff (LCS) of have against want, with the whole\n// file as one hunk. It is for the operator to read, not to apply.\nfunc unifiedDiff(name, have, want string) string {\n\ta, b := splitLines(have), splitLines(want)\n\tn, m := len(a), len(b)\n\tif n*m > 4_000_000 {\n\t\treturn fmt.Sprintf(\"--- %s (main)\\n+++ %s (starter)\\n(too large to diff)\\n\", name, name)\n\t}\n\tlcs := make([][]int, n+1)\n\tfor i := range lcs {\n\t\tlcs[i] = make([]int, m+1)\n\t}\n\tfor i := n - 1; i >= 0; i-- {\n\t\tfor j := m - 1; j >= 0; j-- {\n\t\t\tif a[i] == b[j] {\n\t\t\t\tlcs[i][j] = lcs[i+1][j+1] + 1\n\t\t\t} else {\n\t\t\t\tlcs[i][j] = max(lcs[i+1][j], lcs[i][j+1])\n\t\t\t}\n\t\t}\n\t}\n\tvar sb strings.Builder\n\tfmt.Fprintf(&sb, \"--- %s (main)\\n+++ %s (starter)\\n\", name, name)\n\ti, j := 0, 0\n\tfor i < n || j < m {\n\t\tswitch {\n\t\tcase i < n && j < m && a[i] == b[j]:\n\t\t\tsb.WriteString(\" \" + a[i] + \"\\n\")\n\t\t\ti++\n\t\t\tj++\n\t\tcase j < m && (i == n || lcs[i][j+1] >= lcs[i+1][j]):\n\t\t\tsb.WriteString(\"+\" + b[j] + \"\\n\")\n\t\t\tj++\n\t\tdefault:\n\t\t\tsb.WriteString(\"-\" + a[i] + \"\\n\")\n\t\t\ti++\n\t\t}\n\t}\n\treturn sb.String()\n}\n\nfunc splitLines(s string) []string {\n\tif s == \"\" {\n\t\treturn nil\n\t}\n\treturn strings.Split(strings.TrimSuffix(s, \"\\n\"), \"\\n\")\n}\n\n// overlay copies existing (files and directories) into a MapFS and lays files\n// on top, so config validation sees exactly the tree the PR would produce.\n// Directories are copied as well as files: an empty role directory on main\n// must still fail validation.\nfunc overlay(existing fs.FS, files []committer.InitFile) (fstest.MapFS, error) {\n\tm := fstest.MapFS{}\n\terr := fs.WalkDir(existing, \".\", func(p string, d fs.DirEntry, err error) error {\n\t\tif err != nil || p == \".\" {\n\t\t\treturn err\n\t\t}\n\t\tfi, err := d.Info()\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif d.IsDir() {\n\t\t\tm[p] = &fstest.MapFile{Mode: fs.ModeDir | 0o755}\n\t\t\treturn nil\n\t\t}\n\t\tdata, err := fs.ReadFile(existing, p)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tmode := fs.FileMode(0o644)\n\t\tif fi.Mode()&0o111 != 0 {\n\t\t\tmode = 0o755\n\t\t}\n\t\tm[p] = &fstest.MapFile{Data: data, Mode: mode}\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"read main's config tree: %w\", err)\n\t}\n\tfor _, f := range files {\n\t\tmode := fs.FileMode(0o644)\n\t\tif f.Exec {\n\t\t\tmode = 0o755\n\t\t}\n\t\tm[f.Path] = &fstest.MapFile{Data: f.Data, Mode: mode}\n\t}\n\treturn m, nil\n}\ninternal/initcmd/lock.go:27:func hashOf(b []byte) string {\ninternal/initcmd/lock.go:36:func ParseLock(data []byte) (Lock, []string) {\ninternal/initcmd/lock.go:77:func (l Lock) Marshal() ([]byte, error) {\ninternal/initcmd/lock.go:91:func withLock(old Lock, ops []op, version string) Lock {\ninternal/initcmd/body.go:12:func initBody(pl Result, res *config.Resolved) string {\ninternal/setupcmd/cmd.go:20:func Command(ctx context.Context, e *cli.Env, o cli.SetupOpts) error {\ninternal/setupcmd/cmd.go:72:func execute(ctx context.Context, e *cli.Env, d Deps, o cli.SetupOpts) error {\ninternal/setupcmd/cmd.go:89:func LocalVsMain(ctx context.Context, root string) (string, error) {\ninternal/setupcmd/report.go:32:func (r Report) Green() bool {\ninternal/setupcmd/report.go:42:func (r Report) HasDrift() bool {\ninternal/setupcmd/report.go:52:func Print(w io.Writer, r Report, dryRun bool) {","is_error":false}]},"parent_tool_use_id":null,"session_id":"b940d4dc-f25a-4782-8c27-634ecf829380","uuid":"7c1c17e4-db05-4b1c-a9d6-d4b7daa81228","timestamp":"2026-11-25T09:18:31.357Z","tool_use_result":{"stdout":"// Package initcmd implements `ard init`: propose the starter .ard/ tree\n// (internal/roles.FS) as a PR on branch ard-init, and sync the label\n// catalogue. It never writes the working tree or main.\npackage initcmd\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/cli\"\n\t\"github.com/albertcbrown/ard/internal/committer\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/effects\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n\t\"github.com/albertcbrown/ard/internal/labels/labelsync\"\n)\n\n// prTitle is the title of the PR init opens.\nconst prTitle = \"ard init: starter .ard/ configuration\"\n\n// deps is what run needs from the outside; tests supply the GitHub fake,\n// effects.NewLive(fake, gitx.New(\"\"), log) and a file:// remote.\ntype deps struct {\n\tRepo      github.Repo\n\tReader    github.Reader\n\tEffects   effects.Effects\n\tRemoteURL string\n\tToken     gitx.TokenFunc\n\tClose     func() error // optional\n}\n\n// Init is the handler behind `ard init`.\nfunc Init(ctx context.Context, e *cli.Env, o cli.InitOpts) error {\n\treturn run(ctx, e, o, func(ctx context.Context, root string) (deps, error) {\n\t\trepo, err := resolveRepo(ctx, e.Repo, root)\n\t\tif err != nil {\n\t\t\treturn deps{}, err\n\t\t}\n\t\tauth, err := github.AuthFromEnv(os.Getenv, os.ReadFile)\n\t\tif err != nil {\n\t\t\treturn deps{}, fmt.Errorf(\"ard init: %w\", err)\n\t\t}\n\t\tif err := checkAuth(auth.Kind(), e.DryRun); err != nil {\n\t\t\treturn deps{}, err\n\t\t}\n\t\tfx, rd, err := effects.Open(ctx, effects.Options{\n\t\t\tDryRun: e.DryRun,\n\t\t\tGitHub: github.Config{Repo: repo, Auth: auth, Log: e.Log},\n\t\t\tLog:    e.Log,\n\t\t})\n\t\tif err != nil {\n\t\t\treturn deps{}, fmt.Errorf(\"ard init: %w\", err)\n\t\t}\n\t\td := deps{Repo: repo, Reader: rd, Effects: fx, Token: auth.Token, RemoteURL: fmt.Sprintf(\"https://github.com/%s.git\", repo)}\n\t\tif c, ok := fx.(interface{ Close() error }); ok {\n\t\t\td.Close = c.Close\n\t\t}\n\t\treturn d, nil\n\t})\n}\n\n// checkAuth refuses a personal token for a live run, as serve does.\nfunc checkAuth(kind github.AuthKind, dryRun bool) error {\n\tif kind == github.AuthToken && !dryRun {\n\t\treturn errors.New(\"ard init: ARD_GITHUB_TOKEN auth is for --dry-run only; configure a GitHub App\")\n\t}\n\treturn nil\n}\n\n// resolveRepo takes --repo, or falls back to the origin remote of root. Its\n// errors never include the remote URL, which may embed a token.\nfunc resolveRepo(ctx context.Context, flag, root string) (github.Repo, error) {\n\tif flag != \"\" {\n\t\tr, err := github.ParseRepo(flag)\n\t\tif err != nil {\n\t\t\treturn github.Repo{}, fmt.Errorf(\"ard init: %w\", err)\n\t\t}\n\t\treturn r, nil\n\t}\n\turl, err := gitx.New(\"\").RemoteURL(ctx, root, \"origin\")\n\tif err != nil {\n\t\treturn github.Repo{}, errors.New(\"ard init: --repo owner/repo is required (no origin remote to fall back on)\")\n\t}\n\tr, err := github.RepoFromRemote(url)\n\tif err != nil {\n\t\treturn github.Repo{}, errors.New(\"ard init: --repo owner/repo is required (origin remote is not a github.com owner/repo URL)\")\n\t}\n\treturn r, nil\n}\n\n// run does every check before any write; see the order in the comments.\nfunc run(ctx context.Context, e *cli.Env, o cli.InitOpts, open func(ctx context.Context, root string) (deps, error)) error {\n\t// 1. The checkout is only the object store and the origin fallback.\n\troot, err := config.RepoRoot(e.ConfigPath)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tif root, err = filepath.Abs(root); err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tif _, err := os.Stat(filepath.Join(root, \".git\")); err != nil {\n\t\treturn fmt.Errorf(\"ard init: %s is not the root of a git repository (run it there, or pass --config <repo>/.ard/config.yaml)\", root)\n\t}\n\t// 2-3. Repo and credentials.\n\td, err := open(ctx, root)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif d.Close != nil {\n\t\tdefer d.Close()\n\t}\n\t// 4. Who commits.\n\tid, err := d.Reader.Identity(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: identify github user: %w\", err)\n\t}\n\n\ttmp, err := os.MkdirTemp(\"\", \"ard-init-\")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tdefer os.RemoveAll(tmp)\n\n\t// 5. Fetch main; refuse while ard-init exists.\n\tin, err := committer.NewInit(ctx, committer.Config{\n\t\tRepoDir: root, WorkDir: filepath.Join(tmp, \"work\"), RemoteURL: d.RemoteURL,\n\t\tBot: id, Token: d.Token, Log: e.Log,\n\t}, d.Effects, nil)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tbase, err := in.Base(ctx)\n\tswitch {\n\tcase errors.Is(err, committer.ErrInitExists):\n\t\treturn initExistsErr(ctx, d)\n\tcase errors.Is(err, committer.ErrBranchGone):\n\t\treturn fmt.Errorf(\"ard init: %s has no main branch; push an initial commit first\", d.Repo)\n\tcase err != nil:\n\t\treturn fmt.Errorf(\"ard init: fetch main: %w\", err)\n\t}\n\n\t// 6. Plan against main, then validate the result.\n\tfiles, err := starter()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tsnap := filepath.Join(tmp, \"main\")\n\tif err := gitx.New(\"\").ExportPaths(ctx, root, base, snap, append(append(config.SourcePaths(), ContextPaths()...), LockPath)...); err != nil {\n\t\treturn fmt.Errorf(\"ard init: read main's .ard/: %w\", err)\n\t}\n\texisting := os.DirFS(snap)\n\tvar lock Lock\n\tif data, err := os.ReadFile(filepath.Join(snap, filepath.FromSlash(LockPath))); err == nil {\n\t\tvar warns []string\n\t\tlock, warns = ParseLock(data)\n\t\tfor _, w := range warns {\n\t\t\tfmt.Fprintln(e.Stderr, \"warning: \"+w)\n\t\t}\n\t}\n\tpl, err := plan(existing, files, lock)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tops := pl.Ops\n\ttoWrite := changed(ops)\n\tif len(toWrite) > 0 {\n\t\tdata, err := withLock(lock, ops, o.Version).Marshal()\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t\t}\n\t\ttoWrite = append(toWrite, committer.InitFile{Path: LockPath, Data: data})\n\t}\n\tmerged, err := overlay(existing, toWrite)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tres, err := config.LoadFS(merged, root)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: the resulting configuration is invalid, nothing was written:\\n%w\", err)\n\t}\n\twant, err := labels.Desired(labels.SpecFrom(res))\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\n\t// 7. Labels first: a failure leaves nothing pushed, so a rerun is clean.\n\trep, err := labelsync.Sync(ctx, d.Reader, d.Effects, want, e.Log)\n\tif err != nil && rep.Failed == nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tlabelsync.Print(e.Stdout, rep, e.DryRun)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\n\t// 8. Propose.\n\tvar pr github.PullRequest\n\tif len(toWrite) > 0 {\n\t\tpres, err := in.Propose(ctx, base, toWrite)\n\t\tswitch {\n\t\tcase errors.Is(err, committer.ErrInitExists):\n\t\t\treturn initExistsErr(ctx, d)\n\t\tcase err != nil:\n\t\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t\tcase pres.NoOp:\n\t\t\ttoWrite = nil\n\t\t}\n\t}\n\tif len(toWrite) == 0 {\n\t\tif len(toWrite) == 0 {\n\t\t\tprintLeftAlone(e, pl)\n\t\t}\n\t\tfmt.Fprintln(e.Stdout, \"nothing to propose: main already has the starter files, or only edited ones differ\")\n\t\te.Log.InfoContext(ctx, \"init.done\", \"repo\", d.Repo.String(), \"base\", base, \"files\", 0, \"pr\", 0, \"dry_run\", e.DryRun)\n\t\treturn nil\n\t}\n\tprintOps(e, ops)\n\tprintLeftAlone(e, pl)\n\n\t// 9. Open the PR.\n\tpr, err = d.Effects.CreatePR(ctx, github.NewPR{\n\t\tTitle: prTitle, Body: initBody(pl, res), Head: committer.InitBranch, Base: \"main\",\n\t})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: branch %s pushed but opening the PR failed: %w; open it by hand, or delete the branch and rerun\", committer.InitBranch, err)\n\t}\n\n\t// 10. Report.\n\tif e.DryRun {\n\t\tfmt.Fprintf(e.Stdout, \"dry-run: would open a PR from %s\\n\", committer.InitBranch)\n\t} else {\n\t\tfmt.Fprintf(e.Stdout, \"opened PR #%d: %s\\n\", pr.Number, pr.URL)\n\t}\n\te.Log.InfoContext(ctx, \"init.done\", \"repo\", d.Repo.String(), \"base\", base, \"files\", len(toWrite), \"pr\", pr.Number, \"dry_run\", e.DryRun)\n\treturn nil\n}\n\n// printLeftAlone prints the files init did not touch: edited ones with their\n// diff against the starter, and ones the starter dropped.\nfunc printLeftAlone(e *cli.Env, pl Result) {\n\tfor _, o := range pl.Ops {\n\t\tif o.Act == actEdited {\n\t\t\tfmt.Fprintf(e.Stdout, \"edited %s: left alone; the starter differs:\\n%s\", o.File.Path, o.Diff)\n\t\t}\n\t}\n\tfor _, p := range pl.Dropped {\n\t\tfmt.Fprintf(e.Stdout, \"%s: no longer in the starter, left in place\\n\", p)\n\t}\n}\n\n// printOps writes one line per file the PR adds or updates.\nfunc printOps(e *cli.Env, ops []op) {\n\tfor _, o := range ops {\n\t\tif o.Act == actUnchanged || o.Act == actEdited {\n\t\t\tcontinue\n\t\t}\n\t\tverb := string(o.Act)\n\t\tif e.DryRun {\n\t\t\tverb = \"would \" + verb\n\t\t} else {\n\t\t\tverb += \" \"\n\t\t}\n\t\tmode := \"\"\n\t\tif o.File.Exec {\n\t\t\tmode = \" (0755)\"\n\t\t}\n\t\tfmt.Fprintf(e.Stdout, \"%s %s%s\\n\", verb, o.File.Path, mode)\n\t}\n}\n\n// initExistsErr is the refusal when ard-init is already on the remote. It\n// names the open PR when there is one.\nfunc initExistsErr(ctx context.Context, d deps) error {\n\tmsg := \"ard init: branch ard-init already exists on the remote\"\n\tif prs, err := d.Reader.ListPRs(ctx, github.ListPRsOpts{Head: committer.InitBranch, State: github.StateOpen}); err == nil && len(prs) > 0 {\n\t\tmsg += fmt.Sprintf(\" (open PR #%d)\", prs[0].Number)\n\t}\n\treturn errors.New(strings.TrimSpace(msg) + \"; merge or close it and delete the branch, then rerun\")\n}\npackage setupcmd\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"io\"\n\t\"log/slog\"\n\t\"sort\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/labels\"\n\t\"github.com/albertcbrown/ard/internal/labels/labelsync\"\n)\n\n// Opts are the flags of `ard setup`.\ntype Opts struct{ Check bool }\n\n// Deps is what Run needs from the outside world.\ntype Deps struct {\n\tReader      labelsync.Reader\n\tWriter      labelsync.Writer // the effect layer: a dry-run writer writes nothing\n\tDesired     []labels.Label\n\tPermissions func(ctx context.Context) Row\n\tLocalVsMain func(ctx context.Context) (warning string, err error)\n\tDryRun      bool\n\tLog         *slog.Logger\n}\n\nconst (\n\tpermName  = \"permissions\"\n\tlabelName = \"labels\"\n)\n\n// Run executes the checks, then applies when the permission row is ok and\n// Check is not set. The returned report holds the final rows.\nfunc Run(ctx context.Context, d Deps, o Opts, out io.Writer) (Report, error) {\n\tif d.LocalVsMain != nil {\n\t\tw, err := d.LocalVsMain(ctx)\n\t\tif err != nil {\n\t\t\tw = \"could not compare ./.ard/ with origin/main\"\n\t\t}\n\t\tif w != \"\" {\n\t\t\tfmt.Fprintf(out, \"warning: %s\\n\", w)\n\t\t}\n\t}\n\tperm := Row{Name: permName, Status: StatusOK}\n\tif d.Permissions != nil {\n\t\tperm = d.Permissions(ctx)\n\t\tperm.Name = permName\n\t}\n\trep := Report{Rows: []Row{perm}}\n\tif perm.Status != StatusOK {\n\t\t// Nothing else can be read reliably without access.\n\t\treturn rep, nil\n\t}\n\thave, err := d.Reader.ListLabels(ctx)\n\tif err != nil {\n\t\treturn rep, fmt.Errorf(\"setup: list labels: %w\", err)\n\t}\n\tplan := labelsync.Diff(have, d.Desired)\n\trow := Row{Name: labelName, Status: StatusOK}\n\tif n, m := len(plan.Create), len(plan.Update); n+m > 0 {\n\t\trow.Status = StatusDrift\n\t\trow.Detail = fmt.Sprintf(\"%d to create, %d to update\", n, m)\n\t}\n\tif len(plan.Stale) > 0 {\n\t\tsep := \"\"\n\t\tif row.Detail != \"\" {\n\t\t\tsep = \"; \"\n\t\t}\n\t\trow.Detail += sep + \"stale (not deleted): \" + strings.Join(plan.Stale, \", \")\n\t}\n\trep.Rows = append(rep.Rows, row)\n\tif o.Check || row.Status != StatusDrift {\n\t\treturn rep, nil\n\t}\n\n\tsr, err := labelsync.Sync(ctx, d.Reader, d.Writer, d.Desired, d.Log)\n\tif e