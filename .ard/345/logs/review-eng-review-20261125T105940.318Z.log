tes rulesets, bypass actors or App settings: a merged config change must not be able to loosen branch protection through an admin token. `ard setup --create-gh-app` (#350) creates the App itself with GitHub's manifest flow.\n \ndiff --git a/internal/cli/app.go b/internal/cli/app.go\nindex ac8f593..12052b2 100644\n--- a/internal/cli/app.go\n+++ b/internal/cli/app.go\n@@ -56,6 +56,8 @@ type ConfigCheckOpts struct {\n type InitOpts struct {\n \t// Version is the ard build version, recorded in .ard/ard-init.lock.\n \tVersion string\n+\t// PR opens the ard-init PR instead of writing the local tree.\n+\tPR bool\n }\n \n // SetupOpts is the parsed flag set of `ard setup`.\ndiff --git a/internal/cli/cli_test.go b/internal/cli/cli_test.go\nindex ce9d4b8..08a16ff 100644\n--- a/internal/cli/cli_test.go\n+++ b/internal/cli/cli_test.go\n@@ -142,6 +142,18 @@ func TestRunHandlers(t *testing.T) {\n \t\t}\n \t})\n \n+\tt.Run(\"init --pr is parsed\", func(t *testing.T) {\n+\t\tvar opts InitOpts\n+\t\th := Handlers{Init: func(_ context.Context, _ *Env, o InitOpts) error { opts = o; return nil }}\n+\t\tvar stdout, stderr strings.Builder\n+\t\tif code := Run([]string{\"init\", \"--pr\"}, &stdout, &stderr, h, \"dev\"); code != 0 {\n+\t\t\tt.Fatalf(\"exit = %d (stderr: %q)\", code, stderr.String())\n+\t\t}\n+\t\tif !opts.PR {\n+\t\t\tt.Error(\"InitOpts.PR = false\")\n+\t\t}\n+\t})\n+\n \tt.Run(\"setup --check and labels sync reach their handlers\", func(t *testing.T) {\n \t\tvar setup []SetupOpts\n \t\tsynced := false\ndiff --git a/internal/cli/cmd_init.go b/internal/cli/cmd_init.go\nindex cacc9dc..fc53fb7 100644\n--- a/internal/cli/cmd_init.go\n+++ b/internal/cli/cmd_init.go\n@@ -7,18 +7,20 @@ import (\n )\n \n func newInit(app *App) *cobra.Command {\n+\tvar pr bool\n \tcmd := &cobra.Command{\n \t\tUse:   \"init\",\n-\t\tShort: \"Open a PR that adds the starter .ard/ directory\",\n+\t\tShort: \"Write the starter .ard/ directory (--pr opens a PR instead)\",\n \t\tArgs:  cobra.NoArgs,\n \t