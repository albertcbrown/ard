T.md\", \".ard/TECH_STACK.md\", \".ard/VISION.md\", \".ard/config.yaml\", \".ard/reviewers/eng-review/prompt.txt\", \".ard/reviewers/license-review/allowlist.txt\", \".ard/reviewers/license-review/prompt.txt\", \".ard/reviewers/product-manager-review/prompt.txt\", \".ard/reviewers/security-review/Dockerfile\", \".ard/reviewers/security-review/aid\", \".ard/reviewers/security-review/normalize.jq\", \".ard/reviewers/security-review/prompt.txt\", \".ard/reviewers/security-review/rules/security.yml\", \".ard/scanners/cve/Dockerfile\", \".ard/scanners/cve/merge.jq\", \".ard/scanners/cve/scan\", \".ard/scanners/docs/Dockerfile\", \".ard/scanners/docs/docscan.go\", \".ard/scanners/docs/scan\", \".ard/scanners/error-codes/Dockerfile\", \".ard/scanners/error-codes/errcodes.jq\", \".ard/scanners/error-codes/scan\", \".ard/scanners/lint/Dockerfile\", \".ard/scanners/lint/normalize.jq\", \".ard/scanners/lint/scan\", \".ard/scanners/lts/Dockerfile\", \".ard/scanners/lts/eol.jq\", \".ard/scanners/lts/products.json\", \".ard/scanners/lts/refs.jq\", \".ard/scanners/lts/scan\", \".ard/scanners/missing-tests/Dockerfile\", \".ard/scanners/missing-tests/missingtests.go\", \".ard/scanners/missing-tests/scan\", \".ard/scanners/trufflehog-history/Dockerfile\", \".ard/scanners/trufflehog-history/exclude-paths\", \".ard/scanners/trufflehog-history/findings.jq\", \".ard/scanners/trufflehog-history/history\", \".ard/scanners/trufflehog-history/scan\", \".ard/scanners/trufflehog/Dockerfile\", \".ard/scanners/trufflehog/exclude-paths\", \".ard/scanners/trufflehog/findings.jq\", \".ard/scanners/trufflehog/scan\", \".ard/triage/architect/prompt.txt\", \".ard/triage/designer/prompt.txt\", \".ard/triage/documentation-planner/prompt.txt\", \".ard/triage/engineer/prompt.txt\", \".ard/triage/lead/prompt.txt\", \".ard/triage/product-manager/prompt.txt\", \".ard/workers/engineer/prompt.txt\"}\n\nfunc TestInitOpensPR(t *testing.T) {\n\th := newHarness(t)\n\tbefore := snapshot(t, h.clone)\n\tout, err := h