{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0163Mjds3bps9bcvgjm7h3vV","type":"tool_result","content":"// Package initcmd implements `ard init`: propose the starter .ard/ tree\n// (internal/roles.FS) as a PR on branch ard-init, and sync the label\n// catalogue. It never writes the working tree or main.\npackage initcmd\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/cli\"\n\t\"github.com/albertcbrown/ard/internal/committer\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/effects\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n\t\"github.com/albertcbrown/ard/internal/labels/labelsync\"\n)\n\n// prTitle is the title of the PR init opens.\nconst prTitle = \"ard init: starter .ard/ configuration\"\n\n// deps is what run needs from the outside; tests supply the GitHub fake,\n// effects.NewLive(fake, gitx.New(\"\"), log) and a file:// remote.\ntype deps struct {\n\tRepo      github.Repo\n\tReader    github.Reader\n\tEffects   effects.Effects\n\tRemoteURL string\n\tToken     gitx.TokenFunc\n\tClose     func() error // optional\n}\n\n// Init is the handler behind `ard init`.\nfunc Init(ctx context.Context, e *cli.Env, o cli.InitOpts) error {\n\treturn run(ctx, e, o, func(ctx context.Context, root string) (deps, error) {\n\t\trepo, err := resolveRepo(ctx, e.Repo, root)\n\t\tif err != nil {\n\t\t\treturn deps{}, err\n\t\t}\n\t\tauth, err := github.AuthFromEnv(os.Getenv, os.ReadFile)\n\t\tif err != nil {\n\t\t\treturn deps{}, fmt.Errorf(\"ard init: %w\", err)\n\t\t}\n\t\tif err := checkAuth(auth.Kind(), e.DryRun); err != nil {\n\t\t\treturn deps{}, err\n\t\t}\n\t\tfx, rd, err := effects.Open(ctx, effects.Options{\n\t\t\tDryRun: e.DryRun,\n\t\t\tGitHub: github.Config{Repo: repo, Auth: auth, Log: e.Log},\n\t\t\tLog:    e.Log,\n\t\t})\n\t\tif err != nil {\n\t\t\treturn deps{}, fmt.Errorf(\"ard init: %w\", err)\n\t\t}\n\t\td := deps{Repo: repo, Reader: rd, Effects: fx, Token: auth.Token, RemoteURL: fmt.Sprintf(\"https://github.com/%s.git\", repo)}\n\t\tif c, ok := fx.(interface{ Close() error }); ok {\n\t\t\td.Close = c.Close\n\t\t}\n\t\treturn d, nil\n\t})\n}\n\n// checkAuth refuses a personal token for a live run, as serve does.\nfunc checkAuth(kind github.AuthKind, dryRun bool) error {\n\tif kind == github.AuthToken && !dryRun {\n\t\treturn errors.New(\"ard init: ARD_GITHUB_TOKEN auth is for --dry-run only; configure a GitHub App\")\n\t}\n\treturn nil\n}\n\n// resolveRepo takes --repo, or falls back to the origin remote of root. Its\n// errors never include the remote URL, which may embed a token.\nfunc resolveRepo(ctx context.Context, flag, root string) (github.Repo, error) {\n\tif flag != \"\" {\n\t\tr, err := github.ParseRepo(flag)\n\t\tif err != nil {\n\t\t\treturn github.Repo{}, fmt.Errorf(\"ard init: %w\", err)\n\t\t}\n\t\treturn r, nil\n\t}\n\turl, err := gitx.New(\"\").RemoteURL(ctx, root, \"origin\")\n\tif err != nil {\n\t\treturn github.Repo{}, errors.New(\"ard init: --repo owner/repo is required (no origin remote to fall back on)\")\n\t}\n\tr, err := github.RepoFromRemote(url)\n\tif err != nil {\n\t\treturn github.Repo{}, errors.New(\"ard init: --repo owner/repo is required (origin remote is not a github.com owner/repo URL)\")\n\t}\n\treturn r, nil\n}\n\n// run does every check before any write; see the order in the comments.\nfunc run(ctx context.Context, e *cli.Env, o cli.InitOpts, open func(ctx context.Context, root string) (deps, error)) error {\n\t// 1. The checkout is only the object store and the origin fallback.\n\troot, err := config.RepoRoot(e.ConfigPath)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tif root, err = filepath.Abs(root); err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tif _, err := os.Stat(filepath.Join(root, \".git\")); err != nil {\n\t\treturn fmt.Errorf(\"ard init: %s is not the root of a git repository (run it there, or pass --config <repo>/.ard/config.yaml)\", root)\n\t}\n\t// 2-3. Repo and credentials.\n\td, err := open(ctx, root)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif d.Close != nil {\n\t\tdefer d.Close()\n\t}\n\t// 4. Who commits.\n\tid, err := d.Reader.Identity(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: identify github user: %w\", err)\n\t}\n\n\ttmp, err := os.MkdirTemp(\"\", \"ard-init-\")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tdefer os.RemoveAll(tmp)\n\n\t// 5. Fetch main; refuse while ard-init exists.\n\tin, err := committer.NewInit(ctx, committer.Config{\n\t\tRepoDir: root, WorkDir: filepath.Join(tmp, \"work\"), RemoteURL: d.RemoteURL,\n\t\tBot: id, Token: d.Token, Log: e.Log,\n\t}, d.Effects, nil)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tbase, err := in.Base(ctx)\n\tswitch {\n\tcase errors.Is(err, committer.ErrInitExists):\n\t\treturn initExistsErr(ctx, d)\n\tcase errors.Is(err, committer.ErrBranchGone):\n\t\treturn fmt.Errorf(\"ard init: %s has no main branch; push an initial commit first\", d.Repo)\n\tcase err != nil:\n\t\treturn fmt.Errorf(\"ard init: fetch main: %w\", err)\n\t}\n\n\t// 6. Plan against main, then validate the result.\n\tfiles, err := starter()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tsnap := filepath.Join(tmp, \"main\")\n\tif err := gitx.New(\"\").ExportPaths(ctx, root, base, snap, append(append(config.SourcePaths(), ContextPaths()...), LockPath)...); err != nil {\n\t\treturn fmt.Errorf(\"ard init: read main's .ard/: %w\", err)\n\t}\n\texisting := os.DirFS(snap)\n\tvar lock Lock\n\tif data, err := os.ReadFile(filepath.Join(snap, filepath.FromSlash(LockPath))); err == nil {\n\t\tvar warns []string\n\t\tlock, warns = ParseLock(data)\n\t\tfor _, w := range warns {\n\t\t\tfmt.Fprintln(e.Stderr, \"warning: \"+w)\n\t\t}\n\t}\n\tpl, err := plan(existing, files, lock)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tops := pl.Ops\n\ttoWrite := changed(ops)\n\tif len(toWrite) > 0 {\n\t\tdata, err := withLock(lock, ops, o.Version).Marshal()\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t\t}\n\t\ttoWrite = append(toWrite, committer.InitFile{Path: LockPath, Data: data})\n\t}\n\tmerged, err := overlay(existing, toWrite)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tres, err := config.LoadFS(merged, root)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: the resulting configuration is invalid, nothing was written:\\n%w\", err)\n\t}\n\twant, err := labels.Desired(labels.SpecFrom(res))\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\n\t// 7. Labels first: a failure leaves nothing pushed, so a rerun is clean.\n\trep, err := labelsync.Sync(ctx, d.Reader, d.Effects, want, e.Log)\n\tif err != nil && rep.Failed == nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tlabelsync.Print(e.Stdout, rep, e.DryRun)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\n\t// 8. Propose.\n\tvar pr github.PullRequest\n\tif len(toWrite) > 0 {\n\t\tpres, err := in.Propose(ctx, base, toWrite)\n\t\tswitch {\n\t\tcase errors.Is(err, committer.ErrInitExists):\n\t\t\treturn initExistsErr(ctx, d)\n\t\tcase err != nil:\n\t\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t\tcase pres.NoOp:\n\t\t\ttoWrite = nil\n\t\t}\n\t}\n\tif len(toWrite) == 0 {\n\t\tif len(toWrite) == 0 {\n\t\t\tprintLeftAlone(e, pl)\n\t\t}\n\t\tfmt.Fprintln(e.Stdout, \"nothing to propose: main already has the starter files, or only edited ones differ\")\n\t\te.Log.InfoContext(ctx, \"init.done\", \"repo\", d.Repo.String(), \"base\", base, \"files\", 0, \"pr\", 0, \"dry_run\", e.DryRun)\n\t\treturn nil\n\t}\n\tprintOps(e, ops)\n\tprintLeftAlone(e, pl)\n\n\t// 9. Open the PR.\n\tpr, err = d.Effects.CreatePR(ctx, github.NewPR{\n\t\tTitle: prTitle, Body: initBody(pl, res), Head: committer.InitBranch, Base: \"main\",\n\t})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: branch %s pushed but opening the PR failed: %w; open it by hand, or delete the branch and rerun\", committer.InitBranch, err)\n\t}\n\n\t// 10. Report.\n\tif e.DryRun {\n\t\tfmt.Fprintf(e.Stdout, \"dry-run: would open a PR from %s\\n\", committer.InitBranch)\n\t} else {\n\t\tfmt.Fprintf(e.Stdout, \"opened PR #%d: %s\\n\", pr.Number, pr.URL)\n\t}\n\te.Log.InfoContext(ctx, \"init.done\", \"repo\", d.Repo.String(), \"base\", base, \"files\", len(toWrite), \"pr\", pr.Number, \"dry_run\", e.DryRun)\n\treturn nil\n}\n\n// printLeftAlone prints the files init did not touch: edited ones with their\n// diff against the starter, and ones the starter dropped.\nfunc printLeftAlone(e *cli.Env, pl Result) {\n\tfor _, o := range pl.Ops {\n\t\tif o.Act == actEdited {\n\t\t\tfmt.Fprintf(e.Stdout, \"edited %s: left alone; the starter differs:\\n%s\", o.File.Path, o.Diff)\n\t\t}\n\t}\n\tfor _, p := range pl.Dropped {\n\t\tfmt.Fprintf(e.Stdout, \"%s: no longer in the starter, left in place\\n\", p)\n\t}\n}\n\n// printOps writes one line per file the PR adds or updates.\nfunc printOps(e *cli.Env, ops []op) {\n\tfor _, o := range ops {\n\t\tif o.Act == actUnchanged || o.Act == actEdited {\n\t\t\tcontinue\n\t\t}\n\t\tverb := string(o.Act)\n\t\tif e.DryRun {\n\t\t\tverb = \"would \" + verb\n\t\t} else {\n\t\t\tverb += \" \"\n\t\t}\n\t\tmode := \"\"\n\t\tif o.File.Exec {\n\t\t\tmode = \" (0755)\"\n\t\t}\n\t\tfmt.Fprintf(e.Stdout, \"%s %s%s\\n\", verb, o.File.Path, mode)\n\t}\n}\n\n// initExistsErr is the refusal when ard-init is already on the remote. It\n// names the open PR when there is one.\nfunc initExistsErr(ctx context.Context, d deps) error {\n\tmsg := \"ard init: branch ard-init already exists on the remote\"\n\tif prs, err := d.Reader.ListPRs(ctx, github.ListPRsOpts{Head: committer.InitBranch, State: github.StateOpen}); err == nil && len(prs) > 0 {\n\t\tmsg += fmt.Sprintf(\" (open PR #%d)\", prs[0].Number)\n\t}\n\treturn errors.New(strings.TrimSpace(msg) + \"; merge or close it and delete the branch, then rerun\")\n}\npackage setupcmd\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\n\t\"github.com/albertcbrown/ard/internal/cli\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/effects\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n\t\"github.com/albertcbrown/ard/internal/labels/labelsync\"\n)\n\n// Command is the handler behind `ard setup`. The config is loaded and\n// validated before any GitHub client exists.\nfunc Command(ctx context.Context, e *cli.Env, o cli.SetupOpts) error {\n\troot, err := config.RepoRoot(e.ConfigPath)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"setup: %w\", err)\n\t}\n\tres, err := config.Load(root)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"setup: %w\", err)\n\t}\n\twant, err := labels.Desired(labels.SpecFrom(res))\n\tif err != nil {\n\t\treturn err\n\t}\n\trepo, err := labelsync.ResolveRepo(ctx, e, root)\n\tif err != nil {\n\t\treturn err\n\t}\n\tauth, err := github.AuthFromEnv(os.Getenv, os.ReadFile)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"setup: %w\", err)\n\t}\n\tdry := e.DryRun && !o.Check\n\tfx, rd, err := effects.Open(ctx, effects.Options{\n\t\tDryRun: dry,\n\t\tGitHub: github.Config{Repo: repo, Auth: auth, Log: e.Log},\n\t\tLog:    e.Log,\n\t})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"setup: %w\", err)\n\t}\n\td := Deps{\n\t\tReader:  rd,\n\t\tWriter:  fx,\n\t\tDesired: want,\n\t\t// Placeholder until the shared permission check (#302) lands: the\n\t\t// repository must be readable with the configured credentials.\n\t\tPermissions: func(ctx context.Context) Row {\n\t\t\tif _, err := rd.ListLabels(ctx); err != nil {\n\t\t\t\treturn Row{Status: StatusManual, Detail: \"check ARD_GITHUB_* credentials and that the App is installed on \" + repo.String()}\n\t\t\t}\n\t\t\treturn Row{Status: StatusOK, Detail: \"repository reachable\"}\n\t\t},\n\t\tLocalVsMain: func(ctx context.Context) (string, error) { return LocalVsMain(ctx, root) },\n\t\tDryRun:      dry,\n\t\tLog:         e.Log,\n\t}\n\treturn execute(ctx, e, d, o)\n}\n\n// execute runs setup with the given dependencies and maps the report to\n// the command's outcome: exit 2 on drift under --check, an error when\n// manual steps are needed.\nfunc execute(ctx context.Context, e *cli.Env, d Deps, o cli.SetupOpts) error {\n\trep, err := Run(ctx, d, Opts{Check: o.Check}, e.Stdout)\n\tPrint(e.Stdout, rep, d.DryRun)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif o.Check && rep.HasDrift() {\n\t\treturn &cli.ExitError{Code: 2, Err: errors.New(\"setup: drift\")}\n\t}\n\tif !rep.Green() {\n\t\treturn errors.New(\"setup: manual steps needed\")\n\t}\n\treturn nil\n}\n\n// LocalVsMain returns a warning when ./.ard/ in the worktree differs from\n// origin/main, which is what ard serve reads. It never fails the run.\nfunc LocalVsMain(ctx context.Context, root string) (string, error) {\n\tg := gitx.New(\"\")\n\tif _, err := g.RevParse(ctx, root, \"origin/main\"); err != nil {\n\t\treturn \"origin/main not found; cannot compare ./.ard/ with what ard serve reads\", nil\n\t}\n\tch, err := g.ChangedSince(ctx, root, root, \"origin/main\", \".ard/\")\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tif len(ch) > 0 {\n\t\treturn \"./.ard/ differs from origin/main (ard serve reads origin/main)\", nil\n\t}\n\treturn \"\", nil\n}\npackage cli\n\nimport (\n\t\"context\"\n\n\t\"github.com/spf13/cobra\"\n)\n\nfunc newInit(app *App) *cobra.Command {\n\tcmd := &cobra.Command{\n\t\tUse:   \"init\",\n\t\tShort: \"Open a PR that adds the starter .ard/ directory\",\n\t\tArgs:  cobra.NoArgs,\n\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n\t\t\treturn app.run(cmd, func(ctx context.Context, e *Env) error {\n\t\t\t\tif app.Handlers.Init == nil {\n\t\t\t\t\treturn notImpl(cmd.CommandPath(), \"#27\")\n\t\t\t\t}\n\t\t\t\treturn app.Handlers.Init(ctx, e, InitOpts{Version: app.Version})\n\t\t\t})\n\t\t},\n\t}\n\treturn cmd\n}\n38:\tInit         func(ctx context.Context, e *Env, o InitOpts) error        // #27\n39-\tSetup        func(ctx context.Context, e *Env, o SetupOpts) error       // #346\n40-}\n41-\n42-// ServeOpts is the parsed flag set of `ard serve`.\n43-type ServeOpts struct {\n44-\t// Loops names the controller loops to run; empty means every loop (#187).\n45-\tLoops []string\n46-}\n47-\n48-// ConfigCheckOpts is the parsed flag set of `ard config check`.\n49-type ConfigCheckOpts struct {\n50-\t// Ref is a commit to validate instead of the working tree; \"\" means the\n--\n55:// InitOpts is the parsed flag set of `ard init`.\n56:type InitOpts struct {\n57-\t// Version is the ard build version, recorded in .ard/ard-init.lock.\n58-\tVersion string\n59-}\n60-\n61-// SetupOpts is the parsed flag set of `ard setup`.\n62-type SetupOpts struct {\n63-\tCheck bool\n64-}\n65-\n66-// ErrNotImplemented is returned (wrapped) by stub commands whose handler\n67-// has not been wired yet.\n68-var ErrNotImplemented = errors.New(\"not implemented yet\")\ninternal/gitx:\nexport_test.go\ngittest\ngitx.go\ngitx_test.go\ninspect.go\ninspect_test.go\nlocal.go\nreview.go\nreview_test.go\nshallow_test.go\nsnapshot.go\nversion.go\nversion_test.go\nwrite.go\n\ninternal/initcmd:\nbody.go\ninitcmd.go\ninitcmd_test.go\nlock.go\nplan.go\nplan_test.go\ninternal/gitx/gitx.go:34:func New(bin string) *Git {\ninternal/gitx/gitx.go:48:func (e *runError) Error() string {\ninternal/gitx/gitx.go:51:func (e *runError) Unwrap() error { return e.err }\ninternal/gitx/gitx.go:55:func (g *Git) run(ctx context.Context, dir string, env []string, stdin string, secrets []string, args ...string) (string, string, error) {\ninternal/gitx/gitx.go:89:func scrubArgs(args []string, secrets []string) []string {\ninternal/gitx/gitx.