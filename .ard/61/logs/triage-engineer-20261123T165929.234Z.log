\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n)\n\n// MaxFileBytes is the 1 MiB log cap from CLAUDE.md.\nconst MaxFileBytes = 1 << 20\n\nvar pathRe = regexp.MustCompile(`^\\.ard/([1-9][0-9]*)/[^/]+(/[^/]+)*$`)\n\n// CheckPath reports why p may not be written for issue, or nil. Paths must\n// already be canonical: they are rejected, not normalised.\nfunc CheckPath(issue int, p string) error {\n\tif p == \"\" {\n\t\treturn reason(\"empty path\")\n\t}\n\tfor _, r := range p {\n\t\tif r == '\\\\' || r < 0x20 || r == 0x7f {\n\t\t\treturn reason(\"backslash or control character\")\n\t\t}\n\t}\n\tif path.Clean(p) != p {\n\t\treturn reason(\"not canonical\")\n\t}\n\tm := pathRe.FindStringSubmatch(p)\n\tif m == nil {\n\t\treturn reason(\"outside .ard/<issue#>/\")\n\t}\n\tif n, _ := strconv.Atoi(m[1]); n != issue {\n\t\treturn reason(fmt.Sprintf(\"belongs to issue %s, not %d\", m[1], issue))\n\t}\n\tfor _, seg := range strings.Split(p, \"/\") {\n\t\tif strings.EqualFold(seg, \".git\") {\n\t\t\treturn reason(\"contains .git\")\n\t\t}\n// Package stale closes scanner issues nobody picked up. It is a plain\n// controller loop: no slot, executor, worktree or state of its own. It only\n// comments and closes as not planned; the owning scanner's next reconcile\n// sees the not-planned close and suppresses the fingerprints.\npackage stale\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"sort\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n)\n\nconst (\n\tName     = \"stale\"\n\tInterval = 24 * time.Hour\n\t// Marker tags the closing comment so a retry after a failed close does\n\t// not comment twice.\n\tMarker = \"<!-- ard:stale -->\"\n)\n\n// ErrNoBotIdentity is returned, with no writes, when the client is not\n// authenticated as a GitHub App: otherwise a token user's own issue