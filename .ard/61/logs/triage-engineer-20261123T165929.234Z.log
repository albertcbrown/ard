ateRunning)) {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// precheck applies every rule that needs no timeline, in order; the first\n// match wins.\nfunc precheck(is github.Issue, in inputs) reason {\n\tif _, ok := scannerOf(is, in.scanners); !ok || is.IsPR || is.State != github.StateOpen || !hasLabel(is, labels.Pending) {\n\t\treturn reasonNotCand\n\t}\n\tswitch {\n\tcase hasLabel(is, labels.Hold):\n\t\treturn reasonHold\n\tcase hasLabel(is, labels.NeedsHuman):\n\t\treturn reasonNeedsHuman\n\tcase running(is):\n\t\treturn reasonRunning\n\tcase is.Author != in.bot:\n\t\treturn reasonHumanAuthor\n\tcase in.now.Sub(is.CreatedAt) < in.inactiveFor:\n\t\treturn reasonTooNew\n\t}\n\treturn reasonClose\n}\n\n// decide runs precheck, then the two timeline rules. It returns the last\n// activity time for logging and for the prior-comment check.\nfunc decide(is github.Issue, tl []github.TimelineEvent, in inputs) (reason, time.Time) {\n\tif r := precheck(is, in); r != reasonClose {\n\t\treturn r, time.Time{}\n\t}\n\tlast := lastActivity(is, tl, in.bot)\n\tswitch {\n\tcase hasLinkedOpenPR(tl):\n\t\treturn reasonLinkedPR, last\n\tcase in.now.Sub(last) < in.inactiveFor:\n\t\treturn reasonActive, last\n\t}\n\treturn reasonClose, last\n}\npackage stale\n\nimport (\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n)\n\nfunc ev(name, actor string, ago time.Duration) github.TimelineEvent {\n\treturn github.TimelineEvent{Event: name, Actor: actor, CreatedAt: t0.Add(-ago)}\n}\n\nfunc pr(state github.State, actor string) github.TimelineEvent {\n\te := ev(\"cross-referenced\", actor, 35*day)\n\te.Source = &github.IssueRef{Number: 9, IsPR: true, State: state}\n\treturn e\n}\n\nfunc TestDecide(t *testing.T) {\n\tmod := func(f func(*github.Issue)) github.Issue { is := old(); f(&is); return is }\n\ttests := []struct {\n\t\tname string\n\t\tis   github.Issue\n\t\ttl   []github.TimelineEvent\n\t\tin   func(*inputs)\n\t\twant reason\n\t}{\n\t\t{\"eligible, no events\", old(), nil, nil, reasonClose},\n\t\t{\"hold\", old(labels.Hold), nil, nil, reasonHold},\n\t\t{\"needs-human\", old(labels.NeedsHuman), nil, nil, reasonNeedsHuman},\n\t\t{\"running triage\", old(labels.Running(labels.StageTriage, \"lead\")), nil, nil, reasonRunning},\n\t\t{\"running worker\", old(labels.Running(labels.StageWorker, \"engineer\")), nil, nil, reasonRunning},\n\t\t{\"running review\", old(labels.Running(labels.StageReview, \"eng-review\")), nil, nil, reasonRunning},\n\t\t{\"running, unparsed label\", old(labels.Prefix + \"merger:x:\" + string(labels.StateRunning)), nil, nil, reasonRunning},\n\t\t{\"human author\", mod(func(i *github.Issue) { i.Author = \"alice\" }), nil, nil, reasonHumanAuthor},\n\t\t{\"other bot author\", mod(func(i *github.Issue) { i.Author = \"dependabot[bot]\" }), nil, nil, reasonHumanAuthor},\n\t\t{\"not pending\", mod(func(i *github.Issue) { i.Labels = []string{labels.Scanner(\"cve\")} }), nil, nil, reasonNotCand},\n\t\t{\"no scanner label\", mod(func(i *github.Issue) { i.Labels = []string{labels.Pending} }), nil, nil, reasonNotCand},\n\t\t{\"undiscovered scanner\", mod(func(i *github.Issue) { i.Labels = []string{labels.Pending, labels.Scanner(\"gone\")} }), nil, nil, reasonNotCand},\n\t\t{\"pull request\", mod(func(i *github.Issue) { i.IsPR = true }), nil, nil, reasonNotCand},\n\t\t{\"closed\", mod(func(i *github.Issue) { i.State = github.StateClosed }), nil, nil, reasonNotCand},\n\t\t{\"created 29d ago\", mod(func(i *github.Issue) { i.CreatedAt = t0.Add(-29 * day) }), nil, nil, reasonTooNew},\n\t\t{\"custom inactive_for 7d\", mod(func(i *github.Issue) { i.CreatedAt = t0.Add(-8 * day) }), nil, func(in *inputs) { in.inactiveFor = 7 * day }, reasonClose},\n\t\t{\"open PR by human\", old(), []github.TimelineEvent{pr(github.StateOpen, \"alice\")}, nil, reasonLinkedPR},\n\t\t{\"open PR by bot\", old(), []github.TimelineEvent{pr(github.StateOpen, bot)}, nil, reasonLinkedPR},\n\t\t{\"closed PR\", old(), []github.TimelineEvent{pr(github.StateClosed, \"alice\")}, nil, reasonClose},\n\t\t{\"merged PR\", old(), []github.TimelineEvent{pr(github.StateClosed, bot)}, nil, reasonClose},\n\t\t{\"referenced from issue\", old(), []github.TimelineEvent{{Event: \"cross-referenced\", Actor: \"a\", CreatedAt: t0.Add(-35 * day), Source: &github.IssueRef{IsPR: false, State: github.StateOpen}}}, nil, reasonClose},\n\t\t{\"connected alone\", old(), []github.TimelineEvent{ev(\"connected\", \"alice\", 35*day)}, nil, reasonLinkedPR},\n\t\t{\"connected then disconnected\", old(), []github.TimelineEvent{ev(\"connected\", \"alice\", 38*day), ev(\"disconnected\", \"alice\", 36*day)}, nil, reasonClose},\n\t\t{\"human comment 10d ago\", old(), []github.TimelineEvent{ev(\"commented\", \"alice\", 10*day)}, nil, reasonActive},\n\t\t{\"bot comment 1d ago\", old(), []github.TimelineEvent{ev(\"commented\", bot, day)}, nil, reasonClose},\ninternal/servecmd/adopt.go:68:// scannerJobStore is what retiring stale scanner jobs needs; *state.Store\ninternal/servecmd/adopt.go:98:\t\t\t\tlog.Warn(\"scanner.stale_job_handle\", \"job\", j.ID, \"error\", err)\ninternal/servecmd/adopt.go:100:\t\t\t\tlog.Warn(\"scanner.stale_job_cleanup\", \"job\", j.ID, \"error\", err)\ninternal/servecmd/adopt.go:104:\t\t\terrs = append(errs, fmt.Errorf(\"fail stale scanner job %s: %w\", j.ID, err))\ninternal/servecmd/adopt.go:107:\t\tlog.Info(\"scanner.stale_job_failed\", \"job\", j.ID, \"scanner\", j.Role)\ninternal/servecmd/merger.go:9:// mergerLoop builds the merger loop (#46). It needs no executor, Finisher or\ninternal/servecmd/merger.go:12:func mergerLoop(w *wiring) controller.Loop {\ninternal/servecmd/reaping.go:21:\t\"github.com/albertcbrown/ard/internal/reaper\"\ninternal/servecmd/reaping.go:86:// reaperParts builds, once, the Finisher and Reaper that every loop shares.\ninternal/servecmd/reaping.go:87:func (w *wiring) reaperParts() (*reaper.Finisher, *reaper.Reaper, error) {\ninternal/servecmd/reaping.go:110:\tw.fin = &reaper.Finisher{Closer: cl, Cleaner: ex, Store: w.Store, Start: started, Log: w.Log,\ninternal/servecmd/reaping.go:111:\t\tClassify: reaper.UsageLimitClassifier(w.Model.Auth), Limits: lazyLimits{w}}\ninternal/servecmd/reaping.go:112:\tw.rp = reaper.New(reaper.Deps{\ninternal/servecmd/reaping.go:114:\t\tPool:   func() reaper.Lookup { return w.Pool() },\ninternal/servecmd/reaping.go:194:// has stopped (see package reaper for the contract).\ninternal/servecmd/reaping.go:195:func (w *wiring) finisher() (*reaper.Finisher, error) {\ninternal/servecmd/reaping.go:196:\tf, _, err := w.reaperParts()\ninternal/servecmd/reaping.go:200:// reaperLoop returns the Reaper loop, or nil when the executor cannot be built.\ninternal/servecmd/reaping.go:201:func reaperLoop(w *wiring) controller.Loop {\ninternal/servecmd/reaping.go:202:\t_, r, err := w.reaperParts()\ninternal/servecmd/reaping.go:204:\t\tw.Log.Error(\"reaper.executor_unavailable\", \"error\", err)\ninternal/servecmd/reaping.go:217:\t_, r, err := w.reaperParts()\ninternal/servecmd/reaping.go:220:\t\tw.Log.Error(\"reaper.resume_skipped\", \"error\", err)\ninternal/servecmd/reaping.go:228:func (w *wiring) parseFunc() reaper.ParseFunc {\ninternal/servecmd/reviewer.go:11:// reviewerLoop builds the reviewer loop (#35). It reuses the process-wide\ninternal/servecmd/reviewer.go:15:func reviewerLoop(w *wiring) controller.Loop {\ninternal/servecmd/reviewfix.go:9:// reviewfixLoop builds the review fix loop (#41). It needs no executor,\ninternal/servecmd/reviewfix.go:12:func reviewfixLoop(w *wiring) controller.Loop {\ninternal/servecmd/scanners.go:12:// scannerLoop builds the scanners loop (#23). Everything that touches git or\ninternal/servecmd/scanners.go:15:func scannerLoop(w *wiring) controller.Loop {\ninternal/servecmd/scanners.go:29:\treturn scanner.NewLoop(&scanner.Pipeline{\ninternal/servecmd/serve.go:4:// Loops are registered in registerLoops, one constructor call each.\ninternal/servecmd/serve.go:38:\t\"github.com/albertcbrown/ard/internal/reaper\"\ninternal/servecmd/serve.go:41:\t\"github.com/albertcbrown/ard/internal/scanner/stale\"\ninternal/servecmd/serve.go:68:\treturn serveLoops(ctx, e, buildDeps, o.Loops)\ninternal/servecmd/serve.go:72:\treturn serveLoops(ctx, e, build, nil)\ninternal/servecmd/serve.go:76:func loopNames(loops []controller.Loop) []string {\ninternal/servecmd/serve.go:84:// knownLoops are the names registerLoops' loops report (Loop.Name), in the\ninternal/servecmd/serve.go:86:var knownLoops = []string{\"scanners\", stale.Name, \"triage\", \"workers\", \"reviewers\", \"reviewfix\", \"merger\", \"reaper\"}\ninternal/servecmd/serve.go:88:// selectLoops keeps the loops named in want, in registration order; an empty\n164:**Directories outlive their issues as the audit trail.** A monthly janitor deletes `.ard/<issue#>/` for issues closed more than 90 days ago; git history keeps them.\n179:1. **Reconcile.** Fetch the scanner's open issues, plus a lookup of each issue that has a tracked finding and is no longer open, and update its state. Every marker line on an open issue becomes a row on that issue (a fingerprint on two open issues goes to the lowest number), so a crash between creating an issue and recording it heals here instead of filing a duplicate. Closed as completed: mark the fingerprints fixed, keeping a tombstone so a return can link the old issue. Closed as not planned or as a duplicate: suppress them for `stale.suppress_for` (default 90 days) from the close time. Deleted or transferred: drop. An issue that is reopened is tracked again and its suppression lifts. Reconcile also runs on a run that is then dropped, so state stays current.\n260:Local-executor details: the role directory (and its `Dockerfile`) is mounted from the config snapshot at the job's SHA, not from the working tree. The job worktree is always detached at a SHA resolved from the job's ref (the executor never checks out a branch; the committer owns branch worktrees). The controller's clone is a bare repository ard owns at `~/.ard/repos/<owner>/<repo>.git` (lowercased), with no remote, no stored credential and auto-gc off (`gc.auto=0`, `maintenance.auto=false`). `ard serve` creates it on first start and seeds it with one fetch of `main` (up to 30 min; if that fails, serve starts paused and the next start retries), and later starts reuse it. Config loads and committer lanes fetch into it, and every committer and executor worktree is cut from it (lanes under `~/.ard/work/<owner>/<repo>/lanes/`). `ard serve` never writes to the operator's checkout: it reads it only for the `origin` fallback of `--repo` and the local `paused` key. To rebuild a damaged clone, stop serve, `rm -rf` it and restart. Upgrading from a version that used the checkout: ard deletes its old lane and job worktree directories without running git there, so the old `refs/ard/*` refs and the dangling worktree registrations stay in the checkout until you remove them (`git for-each-ref --format='delete %(refname)' refs/ard/ | git update-ref --stdin; git worktree prune`). Every `git worktree add`, `remove` and `prune` on the controller's clone, by the executor and the committer's lanes alike, takes one in-process lock keyed by the clone's common git directory, because git's worktree bookkeeping is not safe under concurrent admin commands; fetches, commits and pushes do not take it. Each such command also has a 30 s deadline, and cleanup runs even when the job's context is cancelled, so one hung git cannot stall every lane. Do not run `git worktree prune` (or add/remove) in `~/.ard/repos/<owner>/<repo>.git` by hand while `ard serve` runs: the lock is per process and cannot cover a human's git. The operator's own checkout is free to use. The host keeps two files per job: `<base>.log` (stdout and stderr combined, the heartbeat source and the committed log) and `<base>.stdout` (stdout only, parsed by the adapter). A read-only job (`ReadOnly`, used by scanners) gets the worktree mounted `:ro` under Docker, or `chmod -R a-w` on the host. The heartbeat is the log file's mtime while the PID is alive; liveness alone is not a beat. Phase 0 local jobs do not survive a controller restart: the pipes belong to the controller, so after a restart the job reports `orphaned` (PID alive, start time verified) or `gone`, and the Reaper kills and fails it. The executor is not an effect: it never calls GitHub or commits, so jobs run normally under `--dry-run`. Sidecar auth: the sidecar fetch runs in the controller with the GitHub App installation token in a host-scoped `http.<url>.extraheader` passed through git's environment, never argv; the job receives plain files and no credential, and the cache stores no remote and no token. The App must be installed on the sidecar repo with contents:read. Host-mode jobs can reach `~/.ard/sidecars`, but it holds no credential. Host-mode jobs run as the controller's uid: they can read the GitHub App key and `~/.config/gh` by absolute path, write the controller's clone, and undo `chmod a-w`. Host mode is allowed for every role ([#84](https://github.com/albertcbrown/ard/issues/84)), but a role that reads untrusted input (every triage, worker and reviewer role, and an LLM scanner) warns loudly when it has no `Dockerfile`; deterministic scanners are exempt, and nothing warns under `executor: k8s`, where every job runs in a container. `ard config check` and the first successful config load of `ard serve` (and any role a later config adds) log one `executor.host_untrusted` WARN per such role and also write it to stderr, so it survives `--log-level`. The local executor logs the WARN again for every host-mode job of such a role and appends a `host_untrusted` row to the `events` table. Each warning lists what the job can reach, including `~/.ard` (state, config snapshots, the pause file, other jobs' worktrees and logs). The owner accepts this risk while ard runs only on owner-controlled repos, and revisits it when moving to the spark cluster, where every job runs in a container once the k8s executor (#54) lands. Until then the Gate 1 dry-run soak on spark (see Rollout and Delivery) runs `ard serve` with the local executor in a pod, and the deterministic cve scanner runs there as a host subprocess of the controller container: its role directory has no `Dockerfile`, and the `ard` image carries its pinned tools. Only deterministic scanners run in that pod: it starts `ard serve --loops scanners,stale,reaper` ([#187](https://github.com/albertcbrown/ard/issues/187)), so the triage, worker and reviewer loops never run there, even though `.ard/config.yaml` on `main` has agent roles. `--loops` takes a comma-separated list of loop names (scanners, stale, triage, workers, reviewers, reaper), defaults to every loop, and rejects an unknown name with exit 2. `ard serve` and `ard config check` refuse to run on git older than 2.47.0, because the committer's fetches fail on older versions.\n287:3. **Retention.** The worktree and job home are kept 24 hours after the job ended, then removed, together with the host logs of a failed job (the raw combined log is already deleted at close-out once its redacted copy is committed). A human extends this by adding `ard:keep` to the issue (or PR, for a review): the Reaper looks again 24 hours later. If it cannot read the issue it keeps everything. Branches are never deleted: closing the draft PR would lose the work a human retry reuses, so a human or a janitor removes them.\n290:Host log files older than 7 days are pruned hourly. The Reaper keeps running while the controller is paused.\n453:| Closed issues are removed from state | A won't-fix finding is refiled next run | Completed forgets; not-planned suppresses for 90 days |","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01MceL1o9VWMU7zVFhcMQ2vo","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
