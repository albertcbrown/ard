 controller container: its role directory has no `Dockerfile`, and the `ard` image carries its pinned tools. Only deterministic scanners run in that pod: it starts `ard serve --loops scanners,stale,reaper` ([#187](https://github.com/albertcbrown/ard/issues/187)), so the triage, worker and reviewer loops never run there, even though `.ard/config.yaml` on `main` has agent roles. `--loops` takes a comma-separated list of loop names (scanners, stale, triage, workers, reviewers, reviewfix, merger, janitor, reaper), defaults to every loop, and rejects an unknown name with exit 2. `ard serve` and `ard config check` refuse to run on git older than 2.47.0, because the committer's fetches fail on older versions.\n \n A worker job is several executor jobs (`<id>`, `<id>t1`, `<id>f1`, ...) under one state job and one slot; the Reaper watches whichever step is stored on the job, so its heartbeat and deadline rules apply to tests too.\n \ndiff --git a/internal/cli/cmd_serve.go b/internal/cli/cmd_serve.go\nindex 0a6a275..b4f4eed 100644\n--- a/internal/cli/cmd_serve.go\n+++ b/internal/cli/cmd_serve.go\n@@ -22,6 +22,6 @@ func newServe(app *App) *cobra.Command {\n \t\t},\n \t}\n \tcmd.Flags().StringSliceVar(&opts.Loops, \"loops\", nil,\n-\t\t\"run only these controller loops (comma-separated: scanners, stale, triage, workers, reviewers, reaper); default every loop\")\n+\t\t\"run only these controller loops (comma-separated: scanners, stale, triage, workers, reviewers, reviewfix, merger, janitor, reaper); default every loop\")\n \treturn cmd\n }\ndiff --git a/internal/github/fake/fake.go b/internal/github/fake/fake.go\nindex 02af575..ace8f8c 100644\n--- a/internal/github/fake/fake.go\n+++ b/internal/github/fake/fake.go\n@@ -1114,6 +1114,10 @@ func parseSearch(q string) (searchTerms, error) {\n \t\t\t\treturn nil, fmt.Errorf(\"unsupported qualifier in:%s\", v)\n \t\t\t}\n \t\tcase \"label\":\n+\t\tcase \"closed\":\n+\t\t\tif _, err := time.Parse(\"2006-01-02\", strings.TrimPrefix(v, \"<\")); err != nil || !strings.HasPrefix(v, \"<\") {\n+\t\t\t\treturn nil, fmt.Errorf(\"unsupported qualifier closed:%s (want closed:<YYYY-MM-DD)\", v)\n+\t\t\t}\n \t\tdefault:\n \t\t\treturn nil, fmt.Errorf(\"unsupported qualifier %q\", k)\n \t\t}\n@@ -1152,6 +1156,9 @@ func (ts searchTerms) match(it *item) bool {\n \t\t\t}\n \t\tcase \"label\":\n \t\t\tok = hasLabel(it.issue.Labels, t.value)\n+\t\tcase \"closed\":\n+\t\t\tday, _ := time.Parse(\"2006-01-02\", strings.TrimPrefix(t.value, \"<\"))\n+\t\t\tok = it.issue.ClosedAt != nil && it.issue.ClosedAt.UTC().Before(day)\n \t\t}\n \t\tif ok == t.neg {\n \t\t\treturn false\ndiff --git a/internal/gitx/export_test.go b/internal/gitx/export_test.go\nindex 40590b6..2e5eb4f 100644\n--- a/internal/gitx/export_test.go\n+++ b/internal/gitx/export_test.go\n@@ -4,6 +4,7 @@ import (\n \t\"context\"\n \t\"os\"\n \t\"path/filepath\"\n+\t\"reflect\"\n \t\"testing\"\n \n \t\"github.com/albertcbrown/ard/internal/gitx/gittest\"\n@@ -259,3 +260,34 @@ func TestFileAt(t *testing.T) {\n \t\t})\n \t}\n }\n+\n+func TestListTree(t *testing.T) {\n+\tctx := context.Background()\n+\tg := New(\"\")\n+\t_, clone := gittest.NewRemote(t)\n+\tsha := commitFiles(t, clone, map[string]fileSpec{\n+\t\t\".ard/7/plan.md\":    {\"a\", 0o644},\n+\t\t\".ard/7/logs/x.log\": {\"b\", 0o644},\n+\t\t\".ard/70/plan.md\":   {\"c\", 0o644},\n+\t\t\".ard/config.yaml\":  {\"d\", 0o644},\n+\t})\n+\tgot, err := g.ListTree(ctx, clone, sha, \".ard/7\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif want := []string{\".ard/7/logs/x.log\", \".ard/7/plan.md\"}; !reflect.DeepEqual(got, want) {\n+\t\tt.Errorf(\"got %v, want %v\", got, want)\n+\t}\n+\tif got, err := g.ListTree(ctx, clone, sha, \".ard/9\"); err != nil || len(got) != 0 {\n+\t\tt.Errorf(\"missing prefix: got %v, %v\", got, err)\n+\t}\n+\tall, err := g.ListTree(ctx, clone, sha, \".ard\")\n+\tif err != nil || len(all) != 4 {\n+\t\tt.Errorf(\".ard: got %v, %v\", all, err)\n+\t}\n+\tfor _, bad := range []string{\"\", \"/x\", \"../x\"} {\n+\t\tif _, err := g.ListTree(ctx, clone, sha, bad); err == nil {\n+\t\t\tt.Errorf(\"%q: want error\", bad)\n+\t\t}\n+\t}\n+}\ndiff --git a/internal/gitx/local.go b/internal/gitx/local.go\nindex db07fe5..594f5b8 100644\n--- a/internal/gitx/local.go\n+++ b/internal/gitx/local.go\n@@ -348,6 +348,25 @@ func (g *Git) FileAt(ctx context.Context, dir, rev, path string, maxBytes int64)\n \treturn []byte(blob), true, nil\n }\n \n+// ListTree returns the repo-relative paths of every file under prefix (a\n+// directory or a file path) at commit rev in the repository at dir, in git's\n+// order. A prefix that does not exist at rev gives an empty result. Like\n+// FileAt, dir must be the controller's own repository.\n+func (g *Git) ListTree(ctx context.Context, dir, rev, prefix string) ([]string, error) {\n+\tif prefix == \"\" || strings.HasPrefix(prefix, \"/\") || slices.Contains(strings.Split(prefix, \"/\"), \"..\") {\n+\t\treturn nil, fmt.Errorf(\"gitx: list %q at %.12s: bad path\", prefix, rev)\n+\t}\n+\tout, _, err := g.run(ctx, dir, nil, \"\", nil, \"--git-dir=\"+gitDirOf(dir), \"--literal-pathspecs\", \"ls-tree\", \"-r\", \"-z\", \"--name-only\", \"--full-tree\", rev, \"--\", prefix)\n+\tif err != nil {\n+\t\treturn nil, fmt.Errorf(\"gitx: list %s at %.12s: %w\", prefix, rev, err)\n+\t}\n+\tout = strings.TrimSuffix(out, \"\\x00\")\n+\tif out == \"\" {\n+\t\treturn nil, nil\n+\t}\n+\treturn strings.Split(out, \"\\x00\"), nil\n+}\n+\n // maxExportBytes caps the total size ExportPaths will write.\n var maxExportBytes int64 = 64 << 20\n \ndiff --git a/internal/janitor/janitor.go b/internal/janitor/janitor.go\nnew file mode 100644\nindex 0000000..6898b5f\n--- /dev/null\n+++ b/internal/janitor/janitor.go\n@@ -0,0 +1,187 @@\n+// Package janitor prunes the .ard/<issue#>/ directories of issues closed\n+// long ago (#61). Git history keeps the audit trail. It is a plain controller\n+// loop: no slot, executor or worktree. Every deletion goes through the main\n+// committer, whose path guard confines a request to its own issue's\n+// directory, so .ard/config.yaml and the role directories can never be hit.\n+package janitor\n+\n+import (\n+\t\"context\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"log/slog\"\n+\t\"regexp\"\n+\t\"sort\"\n+\t\"strconv\"\n+\t\"sync\"\n+\t\"time\"\n+\n+\t\"github.com/albertcbrown/ard/internal/committer\"\n+\t\"github.com/albertcbrown/ard/internal/config\"\n+\t\"github.com/albertcbrown/ard/internal/controller\"\n+\t\"github.com/albertcbrown/ard/internal/github\"\n+\t\"github.com/albertcbrown/ard/internal/labels\"\n+)\n+\n+const (\n+\tName = \"janitor\"\n+\t// Retention is how long an issue must have been closed before its\n+\t// directory is pruned.\n+\tRetention = 90 * 24 * time.Hour\n+\t// Interval is how often the loop wakes; Period is how often it works.\n+\tInterval = 24 * time.Hour\n+\tPeriod   = 30 * 24 * time.Hour\n+)\n+\n+// Reader is the read side, satisfied by github.Reader.\n+type Reader interface {\n+\tSearchIssues(ctx context.Context, q string, o github.SearchOpts) ([]github.Issue, error)\n+\tGetIssue(ctx context.Context, n int) (github.Issue, error)\n+}\n+\n+// Committer commits to main, satisfied by the shared main committer.\n+type Committer interface {\n+\tCommit(ctx context.Context, req committer.Request) (committer.Result, error)\n+}\n+\n+// Tree lists every file path under .ard/ at the latest main.\n+type Tree func(ctx context.Context) ([]string, error)\n+\n+// Janitor is the pruning loop.\n+type Janitor struct {\n+\tgh   Reader\n+\tcm   Committer\n+\ttree Tree\n+\tnow  func() time.Time\n+\n+\tmu      sync.Mutex\n+\tlastRun time.Time\n+}\n+\n+var _ controller.Loop = (*Janitor)(nil)\n+\n+// New returns a Janitor; a nil now means time.Now.\n+func New(gh Reader, cm Committer, tree Tree, now func() time.Time) *Janitor {\n+\tif now == nil {\n+\t\tnow = time.Now\n+\t}\n+\treturn &Janitor{gh: gh, cm: cm, tree: tree, now: now}\n+}\n+\n+func (j *Janitor) Name() string                            { return Name }\n+func (j *Janitor) Interval(*config.Resolved) time.Duration { return Interval }\n+\n+// Claims is true so that pause stops pruning.\n+func (j *Janitor) Claims() bool { return true }\n+\n+var issueDirRe = regexp.MustCompile(`^\\.ard/([1-9][0-9]*)/`)\n+\n+// Tick runs a pass when Period has passed since the last completed one. The\n+// pass is idempotent, so losing lastRun on a restart costs one extra scan.\n+func (j *Janitor) Tick(ctx context.Context, env controller.Env) error {\n+\tnow := j.now()\n+\tj.mu.Lock()\n+\tlast := j.lastRun\n+\tj.mu.Unlock()\n+\tif !last.IsZero() && now.Sub(last) < Period {\n+\t\treturn nil\n+\t}\n+\tif err := j.pass(ctx, env.Log, now); err != nil {\n+\t\treturn err\n+\t}\n+\tj.mu.Lock()\n+\tj.lastRun = now\n+\tj.mu.Unlock()\n+\treturn nil\n+}\n+\n+func (j *Janitor) pass(ctx context.Context, log *slog.Logger, now time.Time) error {\n+\tpaths, err := j.tree(ctx)\n+\tif err != nil {\n+\t\treturn fmt.Errorf(\"janitor: list .ard: %w\", err)\n+\t}\n+\tfiles := map[int][]string{}\n+\tfor _, p := range paths {\n+\t\tif m := issueDirRe.FindStringSubmatch(p); m != nil {\n+\t\t\tn, _ := strconv.Atoi(m[1])\n+\t\t\tfiles[n] = append(files[n], p)\n+\t\t}\n+\t}\n+\tif len(files) == 0 {\n+\t\treturn nil\n+\t}\n+\tcutoff := now.Add(-Retention).UTC().Format(\"2006-01-02\")\n+\tcands, err := j.gh.SearchIssues(ctx, \"is:issue is:closed closed:<\"+cutoff, github.SearchOpts{Sort: \"created\", Order: \"asc\", Max: 1000})\n+\tif err != nil {\n+\t\treturn fmt.Errorf(\"janitor: search: %w\", err)\n+\t}\n+\tsort.Slice(cands, func(a, b int) bool { return cands[a].Number < cands[b].Number })\n+\n+\tvar errs []error\n+\tpruned := 0\n+\tfor _, c := range cands {\n+\t\tfs := files[c.Number]\n+\t\tif len(fs) == 0 {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif ctx.Err() != nil {\n+\t\t\terrs = append(errs, ctx.Err())\n+\t\t\tbreak\n+\t\t}\n+\t\t// Re-fetch: the issue may have been reopened since the search.\n+\t\tcur, err := j.gh.GetIssue(ctx, c.Number)\n+\t\tif err != nil {\n+\t\t\terrs = append(errs, fmt.Errorf(\"issue #%d: get: %w\", c.Number, err))\n+\t\t\tcontinue\n+\t\t}\n+\t\tif cur.State != github.StateClosed || cur.IsPR || cur.ClosedAt == nil || now.Sub(*cur.ClosedAt) <= Retention {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif hasAny(cur.Labels, labels.Hold, labels.Keep) {\n+\t\t\tlog.Info(\"janitor skip\", \"issue\", cur.Number, \"reason\", \"hold or keep label\")\n+\t\t\tcontinue\n+\t\t}\n+\t\tif err := j.prune(ctx, cur.Number, fs); err != nil {\n+\t\t\tlog.Error(\"janitor failed\", \"issue\", cur.Number, \"error\", err)\n+\t\t\terrs = append(errs, fmt.Errorf(\"issue #%d: %w\", cur.Number, err))\n+\t\t\tcontinue\n+\t\t}\n+\t\tpruned++\n+\t\tlog.Info(\"janitor pruned\", \"issue\", cur.Number, \"files\", len(fs))\n+\t}\n+\tif len(errs) > 0 {\n+\t\treturn fmt.Errorf(\"janitor: %d issues failed (%d pruned): %w\", len(errs), pruned, errors.Join(errs...))\n+\t}\n+\treturn nil\n+}\n+\n+func (j *Janitor) prune(ctx context.Context, n int, paths []string) error {\n+\tsort.Strings(paths)\n+\tfor len(paths) > 0 {\n+\t\tk := min(len(paths), committer.MaxFiles)\n+\t\tfs := make([]committer.File, k)\n+\t\tfor i, p := range paths[:k] {\n+\t\t\tfs[i] = committer.File{Path: p, Delete: true}\n+\t\t}\n+\t\tpaths = paths[k:]\n+\t\t_, err := j.cm.Commit(ctx, committer.Request{\n+\t\t\tIssue: n, Stage: \"janitor\", Role: \"prune\",\n+\t\t\tSummary: \"prune closed issue directory\", Files: fs,\n+\t\t})\n+\t\tif err != nil {\n+\t\t\treturn err\n+\t\t}\n+\t}\n+\treturn nil\n+}\n+\n+func hasAny(have []string, want ...string) bool {\n+\tfor _, h := range have {\n+\t\tfor _, w := range want {\n+\t\t\tif h == w {\n+\t\t\t\treturn true\n+\t\t\t}\n+\t\t}\n+\t}\n+\treturn false\n+}\ndiff --git a/internal/janitor/janitor_test.go b/internal/janitor/janitor_test.go\nnew file mode 100644\nindex 0000000..908ff1f\n--- /dev/null\n+++ b/internal/janitor/janitor_test.go\n@@ -0,0 +1,178 @@\n+package janitor\n+\n+import (\n+\t\"context\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"io\"\n+\t\"log/slog\"\n+\t\"strings\"\n+\t\"testing\"\n+\t\"time\"\n+\n+\t\"github.com/albertcbrown/ard/internal/committer\"\n+\t\"github.com/albertcbrown/ard/internal/controller\"\n+\t\"github.com/albertcbrown/ard/internal/github\"\n+\t\"github.com/albertcbrown/ard/internal/github/fake\"\n+\t\"github.com/albertcbrown/ard/internal/labels\"\n+)\n+\n+var t0 = time.Date(2026, 11, 23, 12, 0, 0, 0, time.UTC)\n+\n+type rec struct {\n+\treqs []committer.Request\n+\tfail map[int]error\n+}\n+\n+func (r *rec) Commit(_ context.Context, req committer.Request) (committer.Result, error) {\n+\tif err := r.fail[req.Issue]; err != nil {\n+\t\treturn committer.Result{}, err\n+\t}\n+\tr.reqs = append(r.reqs, req)\n+\treturn committer.Result{SHA: \"abc\"}, nil\n+}\n+\n+// reopener reports one issue as reopened on re-fetch.\n+type reopener struct {\n+\tReader\n+\tn int\n+}\n+\n+func (r reopener) GetIssue(ctx context.Context, n int) (github.Issue, error) {\n+\tis, err := r.Reader.GetIssue(ctx, n)\n+\tif n == r.n {\n+\t\tis.State, is.ClosedAt = github.StateOpen, nil\n+\t}\n+\treturn is, err\n+}\n+\n+func closedAgo(days int, lbls ...string) github.Issue {\n+\tc := t0.Add(-time.Duration(days) * 24 * time.Hour)\n+\treturn github.Issue{Title: \"x\", State: github.StateClosed, ClosedAt: &c, CreatedAt: c.Add(-time.Hour), Labels: lbls}\n+}\n+\n+func env() controller.Env {\n+\treturn controller.Env{Log: slog.New(slog.NewTextHandler(io.Discard, nil))}\n+}\n+\n+func setup(t *testing.T, gh Reader, paths ...string) (*Janitor, *rec, *time.Time) {\n+\tt.Helper()\n+\tnow := t0\n+\tr := &rec{fail: map[int]error{}}\n+\tj := New(gh, r, func(context.Context) ([]string, error) { return paths, nil }, func() time.Time { return now })\n+\treturn j, r, &now\n+}\n+\n+func TestJanitorPrunesOldClosed(t *testing.T) {\n+\tf := fake.New()\n+\tn := f.SeedIssue(closedAgo(91))\n+\tj, r, _ := setup(t, f, fmt.Sprintf(\".ard/%d/a.md\", n), fmt.Sprintf(\".ard/%d/logs/x.log\", n))\n+\tif err := j.Tick(context.Background(), env()); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif len(r.reqs) != 1 || r.reqs[0].Issue != n || len(r.reqs[0].Files) != 2 {\n+\t\tt.Fatalf(\"reqs = %+v\", r.reqs)\n+\t}\n+\tfor _, f := range r.reqs[0].Files {\n+\t\tif !f.Delete {\n+\t\t\tt.Errorf(\"%s not a delete\", f.Path)\n+\t\t}\n+\t}\n+}\n+\n+func TestJanitorKeepsRecent(t *testing.T) {\n+\tf := fake.New()\n+\tn := f.SeedIssue(closedAgo(89))\n+\tj, r, _ := setup(t, f, fmt.Sprintf(\".ard/%d/a.md\", n))\n+\tif err := j.Tick(context.Background(), env()); err != nil || len(r.reqs) != 0 {\n+\t\tt.Fatalf(\"err %v reqs %v\", err, r.reqs)\n+\t}\n+}\n+\n+func TestJanitorSkipsOpenAndReopened(t *testing.T) {\n+\tf := fake.New()\n+\topen := f.SeedIssue(github.Issue{Title: \"o\", State: github.StateOpen})\n+\tre := f.SeedIssue(closedAgo(200))\n+\tj, r, _ := setup(t, reopener{f, re}, fmt.Sprintf(\".ard/%d/a.md\", open), fmt.Sprintf(\".ard/%d/a.md\", re))\n+\tif err := j.Tick(context.Background(), env()); err != nil || len(r.reqs) != 0 {\n+\t\tt.Fatalf(\"err %v reqs %v\", err, r.reqs)\n+\t}\n+}\n+\n+func TestJanitorNeverTouchesNonIssueDirs(t *testing.T) {\n+\tf := fake.New()\n+\tn := f.SeedIssue(closedAgo(100))\n+\tj, r, _ := setup(t, f, \".ard/config.yaml\", \".ard/triage/lead/x.md\", \".ard/workers/engineer/y.md\", \".ard/scanners/z\", fmt.Sprintf(\".ard/%d/a.md\", n))\n+\tif err := j.Tick(context.Background(), env()); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif len(r.reqs) != 1 || len(r.reqs[0].Files) != 1 || !strings.HasPrefix(r.reqs[0].Files[0].Path, fmt.Sprintf(\".ard/%d/\", n)) {\n+\t\tt.Fatalf(\"reqs = %+v\", r.reqs)\n+\t}\n+}\n+\n+func TestJanitorSkipsKeepAndHold(t *testing.T) {\n+\tf := fake.New()\n+\ta := f.SeedIssue(closedAgo(100, labels.Keep))\n+\tb := f.SeedIssue(closedAgo(100, labels.Hold))\n+\tj, r, _ := setup(t, f, fmt.Sprintf(\".ard/%d/a.md\", a), fmt.Sprintf(\".ard/%d/a.md\", b))\n+\tif err := j.Tick(context.Background(), env()); err != nil || len(r.reqs) != 0 {\n+\t\tt.Fatalf(\"err %v reqs %v\", err, r.reqs)\n+\t}\n+}\n+\n+func TestJanitorChunksOver256Files(t *testing.T) {\n+\tf := fake.New()\n+\tn := f.SeedIssue(closedAgo(100))\n+\tvar paths []string\n+\tfor i := 0; i < 300; i++ {\n+\t\tpaths = append(paths, fmt.Sprintf(\".ard/%d/f%03d.md\", n, i))\n+\t}\n+\tj, r, _ := setup(t, f, paths...)\n+\tif err := j.Tick(context.Background(), env()); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif len(r.reqs) != 2 || len(r.reqs[0].Files) != committer.MaxFiles || len(r.reqs[1].Files) != 44 || r.reqs[1].Issue != n {\n+\t\tt.Fatalf(\"got %d reqs\", len(r.reqs))\n+\t}\n+}\n+\n+func TestJanitorContinuesAfterCommitError(t *testing.T) {\n+\tf := fake.New()\n+\ta := f.SeedIssue(closedAgo(100))\n+\tb := f.SeedIssue(closedAgo(100))\n+\tj, r, _ := setup(t, f, fmt.Sprintf(\".ard/%d/a.md\", a), fmt.Sprintf(\".ard/%d/a.md\", b))\n+\tr.fail[a] = errors.New(\"boom\")\n+\tif err := j.Tick(context.Background(), env()); err == nil {\n+\t\tt.Fatal(\"want error\")\n+\t}\n+\tif len(r.reqs) != 1 || r.reqs[0].Issue != b {\n+\t\tt.Fatalf(\"reqs = %+v\", r.reqs)\n+\t}\n+}\n+\n+func TestJanitorMonthlyGate(t *testing.T) {\n+\tf := fake.New()\n+\tn := f.SeedIssue(closedAgo(100))\n+\tj, r, now := setup(t, f, fmt.Sprintf(\".ard/%d/a.md\", n))\n+\tctx := context.Background()\n+\t_ = j.Tick(ctx, env())\n+\t_ = j.Tick(ctx, env())\n+\t*now = now.Add(29 * 24 * time.Hour)\n+\t_ = j.Tick(ctx, env())\n+\tif len(r.reqs) != 1 {\n+\t\tt.Fatalf(\"within 30 days: %d commits\", len(r.reqs))\n+\t}\n+\t*now = now.Add(2 * 24 * time.Hour)\n+\t_ = j.Tick(ctx, env())\n+\tif len(r.reqs) != 2 {\n+\t\tt.Fatalf(\"after 30 days: %d commits\", len(r.reqs))\n+\t}\n+}\n+\n+func TestJanitorClaimsAndName(t *testing.T) {\n+\tj, _, _ := setup(t, fake.New())\n+\tif !j.Claims() || j.Name() != \"janitor\" {\n+\t\tt.Fatal(\"claims/name\")\n+\t}\n+}\ndiff --git a/internal/servecmd/janitor.go b/internal/servecmd/janitor.go\nnew file mode 100644\nindex 0000000..377ebe6\n--- /dev/null\n+++ b/internal/servecmd/janitor.go\n@@ -0,0 +1,31 @@\n+package servecmd\n+\n+import (\n+\t\"context\"\n+\t\"fmt\"\n+\n+\t\"github.com/albertcbrown/ard/internal/controller\"\n+\t\"github.com/albertcbrown/ard/internal/gitx\"\n+\t\"github.com/albertcbrown/ard/internal/janitor\"\n+)\n+\n+// janitorRef is where the janitor keeps its own fetch of main in the\n+// controller clone, apart from the committer lane's ref.\n+const janitorRef = \"refs/ard/janitor/main\"\n+\n+// janitorLoop builds the janitor loop (#61). It lists .ard/ on a fresh fetch\n+// of main and deletes only through the shared main committer.\n+func janitorLoop(w *wiring) controller.Loop {\n+\tg := gitx.New(\"\")\n+\ttree := func(ctx context.Context) ([]string, error) {\n+\t\tif err := g.FetchRef(ctx, w.Root, w.RemoteURL, \"+refs/heads/main:\"+janitorRef, w.Token); err != nil {\n+\t\t\treturn nil, fmt.Errorf(\"fetch main: %w\", err)\n+\t\t}\n+\t\tsha, err := g.RevParse(ctx, w.Root, janitorRef)\n+\t\tif err != nil {\n+\t\t\treturn nil, err\n+\t\t}\n+\t\treturn g.ListTree(ctx, w.Root, sha, \".ard\")\n+\t}\n+\treturn janitor.New(w.Reader, w.mainCommitter(), tree, nil)\n+}\ndiff --git a/internal/servecmd/loops_test.go b/internal/servecmd/loops_test.go\nindex 74057f2..2f1f7ab 100644\n--- a/internal/servecmd/loops_test.go\n+++ b/internal/servecmd/loops_test.go\n@@ -62,7 +62,7 @@ func TestSelectLoopsUnknownName(t *testing.T) {\n \tif !errors.As(err, &ee) || ee.Code != 2 {\n \t\tt.Fatalf(\"err = %v, want ExitError code 2\", err)\n \t}\n-\tfor _, s := range []string{`\"scaners\"`, \"scanners, stale, triage, workers, reviewers, reviewfix, merger, reaper\"} {\n+\tfor _, s := range []string{`\"scaners\"`, \"scanners, stale, triage, workers, reviewers, reviewfix, merger, janitor, reaper\"} {\n \t\tif !strings.Contains(err.Error(), s) {\n \t\t\tt.Errorf(\"error %q does not name %s\", err, s)\n \t\t}\n@@ -81,7 +81,7 @@ func TestServeUnknownLoopFailsFirst(t *testing.T) {\n \n // The loop names registerLoops' constructors report are the known names.\n func TestKnownLoopsMatchLoo