{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MkkLuhKBjegAwUJz9pE5sT","type":"tool_result","content":"// Package stale closes scanner issues nobody picked up. It is a plain\n// controller loop: no slot, executor, worktree or state of its own. It only\n// comments and closes as not planned; the owning scanner's next reconcile\n// sees the not-planned close and suppresses the fingerprints.\npackage stale\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"sort\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n)\n\nconst (\n\tName     = \"stale\"\n\tInterval = 24 * time.Hour\n\t// Marker tags the closing comment so a retry after a failed close does\n\t// not comment twice.\n\tMarker = \"<!-- ard:stale -->\"\n)\n\n// ErrNoBotIdentity is returned, with no writes, when the client is not\n// authenticated as a GitHub App: otherwise a token user's own issues would\n// count as bot-authored.\nvar ErrNoBotIdentity = errors.New(\"stale: no GitHub App bot identity (token auth?)\")\n\n// Reader is the read side, satisfied by github.Reader.\ntype Reader interface {\n\tIdentity(ctx context.Context) (github.Identity, error)\n\tSearchIssues(ctx context.Context, q string, o github.SearchOpts) ([]github.Issue, error)\n\tGetIssue(ctx context.Context, n int) (github.Issue, error)\n\tListTimeline(ctx context.Context, n int) ([]github.TimelineEvent, error)\n}\n\n// Writer is the write side, satisfied by effects.Effects.\ntype Writer interface {\n\tCreateComment(ctx context.Context, n int, body string) (github.Comment, error)\n\tUpdateIssue(ctx context.Context, n int, u github.IssueUpdate) error\n}\n\n// Closer is the stale-closer loop.\ntype Closer struct {\n\tgh  Reader\n\tfx  Writer\n\tnow func() time.Time\n}\n\nvar _ controller.Loop = (*Closer)(nil)\n\n// New returns a Closer; a nil now means time.Now.\nfunc New(gh Reader, fx Writer, now func() time.Time) *Closer {\n\tif now == nil {\n\t\tnow = time.Now\n\t}\n\treturn &Closer{gh: gh, fx: fx, now: now}\n}\n\nfunc (c *Closer) Name() string                            { return Name }\nfunc (c *Closer) Interval(*config.Resolved) time.Duration { return Interval }\n\n// Claims is true so that pause stops stale closes.\nfunc (c *Closer) Claims() bool { return true }\n\nfunc (c *Closer) Tick(ctx context.Context, env controller.Env) error {\n\treturn c.run(ctx, env.Log, env.Cfg)\n}\n\nfunc (c *Closer) run(ctx context.Context, log *slog.Logger, cfg *config.Resolved) error {\n\tid, err := c.gh.Identity(ctx)\n\tif err != nil || id.Kind != github.AuthApp || id.Login == \"\" {\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"%w: %v\", ErrNoBotIdentity, err)\n\t\t}\n\t\treturn ErrNoBotIdentity\n\t}\n\tscanners := map[string]bool{}\n\tfor _, r := range cfg.RolesOf(config.KindScanner) {\n\t\tscanners[r.Name] = true\n\t}\n\tin := inputs{\n\t\tbot: id.Login, scanners: scanners,\n\t\tinactiveFor: time.Duration(cfg.Stale.InactiveFor), now: c.now(),\n\t}\n\tq := fmt.Sprintf(`is:open label:\"%s\" -label:\"%s\" -label:\"%s\"`, labels.Pending, labels.NeedsHuman, labels.Hold)\n\tissues, err := c.gh.SearchIssues(ctx, q, github.SearchOpts{Sort: \"created\", Order: \"asc\", Max: 1000})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"stale: search: %w\", err)\n\t}\n\tsort.Slice(issues, func(i, j int) bool { return issues[i].Number < issues[j].Number })\n\n\tvar errs []error\n\tfor _, is := range issues {\n\t\tif ctx.Err() != nil {\n\t\t\terrs = append(errs, ctx.Err())\n\t\t\tbreak\n\t\t}\n\t\tif err := c.one(ctx, log, is, in, cfg.Stale); err != nil {\n\t\t\tlog.Error(\"stale failed\", \"issue\", is.Number, \"error\", err)\n\t\t\terrs = append(errs, fmt.Errorf(\"issue #%d: %w\", is.Number, err))\n\t\t}\n\t}\n\tif len(errs) > 0 {\n\t\treturn fmt.Errorf(\"stale: %d of %d issues failed: %w\", len(errs), len(issues), errors.Join(errs...))\n\t}\n\treturn nil\n}\n\nfunc (c *Closer) one(ctx context.Context, log *slog.Logger, is github.Issue, in inputs, st config.Stale) error {\n\tsc, _ := scannerOf(is, in.scanners)\n\tskip := func(r reason, last time.Time) {\n\t\tlog.Info(\"stale decision\", \"issue\", is.Number, \"scanner\", sc, \"action\", \"skip\", \"reason\", string(r), \"last_activity\", last)\n\t}\n\tif r := precheck(is, in); r != reasonClose {\n\t\tskip(r, time.Time{})\n\t\treturn nil\n\t}\n\ttl, err := c.gh.ListTimeline(ctx, is.Number)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"timeline: %w\", err)\n\t}\n\tr, last := decide(is, tl, in)\n\tif r != reasonClose {\n\t\tskip(r, last)\n\t\treturn nil\n\t}\n\t// Re-fetch: a claim or a human label may have raced the search.\n\tcur, err := c.gh.GetIssue(ctx, is.Number)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"get: %w\", err)\n\t}\n\tif r := precheck(cur, in); r != reasonClose {\n\t\tskip(r, last)\n\t\treturn nil\n\t}\n\tlog.Info(\"stale decision\", \"issue\", is.Number, \"scanner\", sc, \"action\", \"close\", \"reason\", \"\", \"last_activity\", last)\n\tif !priorStaleComment(tl, in.bot, last) {\n\t\tif _, err := c.fx.CreateComment(ctx, is.Number, commentBody(st)); err != nil {\n\t\t\treturn fmt.Errorf(\"comment: %w\", err)\n\t\t}\n\t}\n\tclosed, np := github.StateClosed, github.ReasonNotPlanned\n\tif err := c.fx.UpdateIssue(ctx, is.Number, github.IssueUpdate{State: &closed, StateReason: &np}); err != nil {\n\t\treturn fmt.Errorf(\"close: %w\", err)\n\t}\n\treturn nil\n}\n\nfunc commentBody(st config.Stale) string {\n\treturn fmt.Sprintf(\"%s\\nNo activity for %s while waiting for triage, so ard is closing this as not planned.\\n\"+\n\t\t\"Its findings will not be refiled for %s. Reopen this issue if it still matters.\\n\",\n\t\tMarker, st.InactiveFor, st.SuppressFor)\n}\ninternal/committer:\nbranches.go\ncode.go\ncode_test.go\ncodepath.go\ncodepath_test.go\ncommitter.go\ncommitter_test.go\nerrors.go\nguard.go\ninit.go\ninit_test.go\nmessage.go\nrefs.go\nrefs_test.go\nrequest.go\nunit_test.go\n\ninternal/gitx:\nexport_test.go\ngittest\ngitx.go\ngitx_test.go\ninspect.go\ninspect_test.go\nlocal.go\nreview.go\nreview_test.go\nshallow_test.go\nsnapshot.go\nversion.go\nversion_test.go\nwrite.go\n\ninternal/servecmd:\nadopt.go\nadopt_test.go\ncfgloader.go\ncfgloader_test.go\nclone.go\nclone_test.go\ncommitters.go\nlimits_test.go\nloops_test.go\nmerger.go\nreaping.go\nreaping_test.go\nrebuild.go\nrebuild_test.go\nreviewer.go\nreviewer_e2e_test.go\nreviewfix.go\nreviewfix_e2e_test.go\nscanners.go\nscanners_test.go\nserve.go\nserve_test.go\ntriage.go\ntriage_e2e_test.go\ntriage_test.go\nwake_other.go\nwake_unix.go\nwake_unix_test.go\nworker.go\nworker_e2e_test.go\n// Package servecmd implements `ard serve`: it resolves the target repo,\n// takes the leader lock, opens state, builds the GitHub reader and effect\n// layer, adopts running jobs into the slot pool, and runs the controller.\n// Loops are registered in registerLoops, one constructor call each.\npackage servecmd\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"os\"\n\t\"os/signal\"\n\t\"path/filepath\"\n\t\"slices\"\n\t\"strings\"\n\t\"sync\"\n\t\"sync/atomic\"\n\t\"syscall\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/agent/claude\"\n\t\"github.com/albertcbrown/ard/internal/cli\"\n\t\"github.com/albertcbrown/ard/internal/closeout\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/configsrc\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n\t\"github.com/albertcbrown/ard/internal/costblock\"\n\t\"github.com/albertcbrown/ard/internal/costs\"\n\t\"github.com/albertcbrown/ard/internal/effects\"\n\t\"github.com/albertcbrown/ard/internal/executor\"\n\t\"github.com/albertcbrown/ard/internal/executor/local\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n\t\"github.com/albertcbrown/ard/internal/limits\"\n\t\"github.com/albertcbrown/ard/internal/modelauth\"\n\t\"github.com/albertcbrown/ard/internal/pool\"\n\t\"github.com/albertcbrown/ard/internal/reaper\"\n\t\"github.com/albertcbrown/ard/internal/redact\"\n\t\"github.com/albertcbrown/ard/internal/repopath\"\n\t\"github.com/albertcbrown/ard/internal/scanner/stale\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n\t\"github.com/albertcbrown/ard/internal/state/scannerdb\"\n)\n\n// deps is what serve needs from the outside world. Tests inject fakes\n// through build, so no test builds a real GitHub client.\ntype deps struct {\n\tReader    github.Reader\n\tEffects   effects.Effects\n\tRemoteURL string         // where the controller fetches main from\n\tToken     gitx.TokenFunc // mints a push and fetch credential; nil in tests\n\tClose     func() error   // optional\n\t// Model is the credential agent jobs receive. The zero value means none\n\t// is set: deterministic scanners run, and a job that needs one fails\n\t// through Model.Require.\n\tModel modelauth.Credential\n}\n\n// builder constructs deps for repo. stateDir is where a dry-run ledger goes.\ntype builder func(ctx context.Context, e *cli.Env, repo github.Repo, stateDir string) (deps, error)\n\n// gitBin is the git binary the version check runs; empty means \"git\". Tests override it.\nvar gitBin = \"\"\n\n// Serve is the handler behind `ard serve`.\nfunc Serve(ctx context.Context, e *cli.Env, o cli.ServeOpts) error {\n\treturn serveLoops(ctx, e, buildDeps, o.Loops)\n}\n\nfunc serve(ctx context.Context, e *cli.Env, build builder) error {\n\treturn serveLoops(ctx, e, build, nil)\n}\n\n// loopNames lists the names of loops, for the serve.loops log line.\nfunc loopNames(loops []controller.Loop) []string {\n\tnames := make([]string, 0, len(loops))\n\tfor _, l := range loops {\n\t\tnames = append(names, l.Name())\n\t}\n\treturn names\n}\n\n// knownLoops are the names registerLoops' loops report (Loop.Name), in the\n// order they register.\nvar knownLoops = []string{\"scanners\", stale.Name, \"triage\", \"workers\", \"reviewers\", \"reviewfix\", \"merger\", \"reaper\"}\n\n// selectLoops keeps the loops named in want, in registration order; an empty\n// want keeps every loop. A name that is not a known loop is a usage error\n// (exit 2) naming the known ones, so a typo never silently drops a loop.\nfunc selectLoops(loops []controller.Loop, want []string) ([]controller.Loop, error) {\n\tif len(want) == 0 {\n\t\treturn loops, nil\n\t}\n\tkeep := map[string]bool{}\n\tfor _, n := range want {\n\t\tn = strings.TrimSpace(n)\n\t\tif !slices.Contains(knownLoops, n) {\n\t\t\treturn nil, &cli.ExitError{Code: 2, Err: fmt.Errorf(\"ard serve: --loops: unknown loop %q (known: %s)\", n, strings.Join(knownLoops, \", \"))}\n\t\t}\n\t\tkeep[n] = true\n\t}\n\tvar out []controller.Loop\n\tfor _, l := range loops {\n\t\tif keep[l.Name()] {\n\t\t\tout = append(out, l)\n\t\t}\n\t}\n\treturn out, nil\n}\n\nfunc serveLoops(ctx context.Context, e *cli.Env, build builder, wantLoops []string) error {\n\tif _, err := selectLoops(nil, wantLoops); err != nil {\n\t\treturn err\n\t}\n\troot, err := config.RepoRoot(e.ConfigPath)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard serve: %w\", err)\n\t}\n\t// root is the operator's checkout, made absolute because RepoRoot returns \".\" when --config is omitted. It is read only (origin fallback, local paused); git worktrees and commits use the controller clone (#113).\n\tif root, err = filepath.Abs(root); err != nil {\n\t\treturn fmt.Errorf(\"ard serve: %w\", err)\n\t}\n\trepo, err := resolveRepo(ctx, e.Repo, root)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := gitx.New(gitBin).CheckVersion(ctx); err != nil {\n\t\treturn &cli.ExitError{Code: 1, Err: fmt.Errorf(\"ard serve: %w\", err)}\n\t}\n\n\thome, err := os.UserHomeDir()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard serve: find home directory: %w\", err)\n\t}\n\tif err := state.CheckLegacy(filepath.Join(home, \".ard\"), repo.String()); err != nil {\n\t\treturn &cli.ExitError{Code: 1, Err: fmt.Errorf(\"ard serve: %w\", err)}\n\t}\n\tlockPath, err := controller.LockPath(home, repo.Owner, repo.Name)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard serve: %w\", err)\n\t}\n\tleader, err := controller.AcquireLeader(lockPath)\n\tif err != nil {\n\t\treturn &cli.ExitError{Code: 1, Err: fmt.Errorf(\"ard serve: %w\", err)}\n\t}\n\tdefer leader.Release()\n\n\tstateDir, err := state.Dir(filepath.Join(home, \".ard\"), repo.String(), e.DryRun)\n\tif err != nil {\n303-\treturn s.Changed(ctx, paths...)\n304-}\n305-\n306:// FileAt returns the contents of path at commit rev in the repository at dir.\n307-// ok is false (and err nil) when path does not exist at rev. A path that is a\n308-// tree, symlink or submodule at rev, or a blob larger than maxBytes, is an\n309-// error.\n310-//\n311-// dir must be the controller's own repository, never an agent's worktree: git\n312-// would trust the worktree's .git file.\n313:func (g *Git) FileAt(ctx context.Context, dir, rev, path string, maxBytes int64) ([]byte, bool, error) {\n314-\tif path == \"\" || strings.HasPrefix(path, \"/\") || slices.Contains(strings.Split(path, \"/\"), \"..\") {\n315-\t\treturn nil, false, fmt.Errorf(\"gitx: file %q at %.12s: bad path\", path, rev)\n316-\t}\n317-\tout, _, err := g.run(ctx, dir, nil, \"\", nil, \"--git-dir=\"+gitDirOf(dir), \"--literal-pathspecs\", \"ls-tree\", \"-l\", \"-z\", \"--full-tree\", rev, \"--\", path)\n318-\tif err != nil {\n319-\t\treturn nil, false, fmt.Errorf(\"gitx: file %s at %.12s: %w\", path, rev, err)\n320-\t}\n321-\trecs := strings.Split(strings.TrimSuffix(out, \"\\x00\"), \"\\x00\")\n322-\tif len(recs) == 1 && recs[0] == \"\" {\n323-\t\treturn nil, false, nil\n324-\t}\n325-\tif len(recs) != 1 {\n326-\t\treturn nil, false, fmt.Errorf(\"gitx: file %s at %.12s: %d ls-tree records\", path, rev, len(recs))\n327-\t}\n328-\tmeta, got, ok := strings.Cut(recs[0], \"\\t\")\n329-\tf := strings.Fields(meta)\n330-\tif !ok || len(f) != 4 || got != path {\n331-\t\treturn nil, false, fmt.Errorf(\"gitx: file %s at %.12s: bad ls-tree record %q\", path, rev, recs[0])\n332-\t}\n333-\tmode, typ, obj := f[0], f[1], f[2]\n334-\tif typ != \"blob\" || (mode != \"100644\" && mode != \"100755\") {\n335-\t\treturn nil, false, fmt.Errorf(\"gitx: file %s at %.12s: not a regular file (mode %s %s)\", path, rev, mode, typ)\n336-\t}\n337-\tsize, perr := strconv.ParseInt(f[3], 10, 64)\n338-\tif perr != nil {\n339-\t\treturn nil, false, fmt.Errorf(\"gitx: file %s at %.12s: bad size in %q\", path, rev, recs[0])\n340-\t}\n341-\tif size > maxBytes {\n342-\t\treturn nil, false, fmt.Errorf(\"gitx: file %s at %.12s: %d bytes, max %d\", path, rev, size, maxBytes)\n343-\t}\n344-\tblob, _, err := g.run(ctx, dir, nil, \"\", nil, \"--git-dir=\"+gitDirOf(dir), \"cat-file\", \"blob\", obj)\n345-\tif err != nil {\n346-\t\treturn nil, false, fmt.Errorf(\"gitx: file %s at %.12s: %w\", path, rev, err)\n347-\t}\n348-\treturn []byte(blob), true, nil\n349-}\n350-\n351-// maxExportBytes caps the total size ExportPaths will write.\n352-var maxExportBytes int64 = 64 << 20\n353-","is_error":false}]},"parent_tool_use_id":null,"session_id":"fbebf0c0-f7a1-4e30-ad80-df586c0d6495","uuid":"3c3c8bbe-ff81-4450-8c8e-36f73c577589","timestamp":"2026-11-23T17:15:45.157Z","tool_use_result":{"stdout":"// Package stale closes scanner issues nobody picked up. It is a plain\n// controller loop: no slot, executor, worktree or state of its own. It only\n// comments and closes as not planned; the owning scanner's next reconcile\n// sees the not-planned close and suppresses the fingerprints.\npackage stale\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"sort\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n)\n\nconst (\n\tName     = \"stale\"\n\tInterval = 24 * time.Hour\n\t// Marker tags the closing comment so a retry after a failed close does\n\t// not comment twice.\n\tMarker = \"<!-- ard:stale -->\"\n)\n\n// ErrNoBotIdentity is returned, with no writes, when the client is not\n// authenticated as a GitHub App: otherwise a token user's own issues would\n// count as bot-authored.\nvar ErrNoBotIdentity = errors.New(\"stale: no GitHub App bot identity (token auth?)\")\n\n// Reader is the read side, satisfied by github.Reader.\ntype Reader interface {\n\tIdentity(ctx context.Context) (github.Identity, error)\n\tSearchIssues(ctx context.Context, q string, o github.SearchOpts) ([]github.Issue, error)\n\tGetIssue(ctx context.Context, n int) (github.Issue, error)\n\tListTimeline(ctx context.Context, n int) ([]github.TimelineEvent, error)\n}\n\n// Writer is the write side, satisfied by effects.Effects.\ntype Writer interface {\n\tCreateComment(ctx context.Context, n int, body string) (github.Comment, error)\n\tUpdateIssue(ctx context.Context, n int, u github.IssueUpdate) error\n}\n\n// Closer is the stale-closer loop.\ntype Closer struct {\n\tgh  Reader\n\tfx  Writer\n\tnow func() time.Time\n}\n\nvar _ controller.Loop = (*Closer)(nil)\n\n// New returns a Closer; a nil now means time.Now.\nfunc New(gh Reader, fx Writer, now func() time.Time) *Closer {\n\tif now == nil {\n\t\tnow = time.Now\n\t}\n\treturn &Closer{gh: gh, fx: fx, now: now}\n}\n\nfunc (c *Closer) Name() string                            { return Name }\nfunc (c *Closer) Interval(*config.Resolved) time.Duration { return Interval }\n\n// Claims is true so that pause stops stale closes.\nfunc (c *Closer) Claims() bool { return true }\n\nfunc (c *Closer) Tick(ctx context.Context, env controller.Env) error {\n\treturn c.run(ctx, env.Log, env.Cfg)\n}\n\nfunc (c *Closer) run(ctx context.Context, log *slog.Logger, cfg *config.Resolved) error {\n\tid, err := c.gh.Identity(ctx)\n\tif err != nil || id.Kind != github.AuthApp || id.Login == \"\" {\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"%w: %v\", ErrNoBotIdentity, err)\n\t\t}\n\t\treturn ErrNoBotIdentity\n\t}\n\tscanners := map[string]bool{}\n\tfor _, r := range cfg.RolesOf(config.KindScanner) {\n\t\tscanners[r.Name] = true\n\t}\n\tin := inputs{\n\t\tbot: id.Login, scanners: scanners,\n\t\tinactiveFor: time.Duration(cfg.Stale.InactiveFor), now: c.now(),\n\t}\n\tq := fmt.Sprintf(`is:open label:\"%s\" -label:\"%s\" -label:\"%s\"`, labels.Pending, labels.NeedsHuman, labels.Hold)\n\tissues, err := c.gh.SearchIssues(ctx, q, github.SearchOpts{Sort: \"created\", Order: \"asc\", Max: 1000})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"stale: search: %w\", err)\n\t}\n\tsort.Slice(issues, func(i, j int) bool { return issues[i].Number < issues[j].Number })\n\n\tvar errs []error\n\tfor _, is := range issues {\n\t\tif ctx.Err() != nil {\n\t\t\terrs = append(errs, ctx.Err())\n\t\t\tbreak\n\t\t}\n\t\tif err := c.one(ctx, log, is, in, cfg.Stale); err != nil {\n\t\t\tlog.Error(\"stale failed\", \"issue\", is.Number, \"error\", err)\n\t\t\terrs = append(errs, fmt.Errorf(\"issue #%d: %w\", is.Number, err))\n\t\t}\n\t}\n\tif len(errs) > 0 {\n\t\treturn fmt.Errorf(\"stale: %d of %d issues failed: %w\", len(errs), len(issues), errors.Join(errs...))\n\t}\n\treturn nil\n}\n\nfunc (c *Closer) one(ctx context.Context, log *slog.Logger, is github.Issue, in inputs, st config.Stale) error {\n\tsc, _ := scannerOf(is, in.scanners)\n\tskip := func(r reason, last time.Time) {\n\t\tlog.Info(\"stale decision\", \"issue\", is.Number, \"scanner\", sc, \"action\", \"skip\", \"reason\", string(r), \"last_activity\", last)\n\t}\n\tif r := precheck(is, in); r != reasonClose {\n\t\tskip(r, time.Time{})\n\t\treturn nil\n\t}\n\ttl, err := c.gh.ListTimeline(ctx, is.Number)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"timeline: %w\", err)\n\t}\n\tr, last := decide(is, tl, in)\n\tif r != reasonClose {\n\t\tskip(r, last)\n\t\treturn nil\n\t}\n\t// Re-fetch: a claim or a human label may have raced the search.\n\tcur, err := c.gh.GetIssue(ctx, is.Number)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"get: %w\", err)\n\t}\n\tif r := precheck(cur, in); r != reasonClose {\n\t\tskip(r, last)\n\t\treturn nil\n\t}\n\tlog.Info(\"stale decision\", \"issue\", is.Number, \"scanner\", sc, \"action\", \"close\", \"reason\", \"\", \"last_activity\", last)\n\tif !priorStaleComment(tl, in.bot, last) {\n\t\tif _, err := c.fx.CreateComment(ctx, is.Number, commentBody(st)); err != nil {\n\t\t\treturn fmt.Errorf(\"comment: %w\", err)\n\t\t}\n\t}\n\tclosed, np := github.StateClosed, github.ReasonNotPlanned\n\tif err := c.fx.UpdateIssue(ctx, is.Number, github.IssueUpdate{State: &closed, StateReason: &np}); err != nil {\n\t\treturn fmt.Errorf(\"close: %w\", err)\n\t}\n\treturn nil\n}\n\nfunc commentBody(st config.Stale) string {\n\treturn fmt.Sprintf(\"%s\\nNo activity for %s while waiting for triage, so ard is closing this as not planned.\\n\"+\n\t\t\"Its findings will not be refiled for %s. Reopen this issue if it still matters.\\n\",\n\t\tMarker, st.InactiveFor, st.SuppressFor)\n}\ninternal/committer:\nbranches.go\ncode.go\ncode_test.go\ncodepath.go\ncodepath_test.go\ncommitter.go\ncommitter_test.go\nerrors.go\nguard.go\ninit.go\ninit_test.go\nmessage.go\nrefs.go\nrefs_test.go\nrequest.go\nunit_test.go\n\ninternal/gitx:\nexport_test.go\ngittest\ngitx.go\ngitx_test.go\ninspect.go\ninspect_test.go\nlocal.go\nreview.go\nreview_test.go\nshallow_test.go\nsnapshot.go\nversion.go\nversion_test.go\nwrite.go\n\ninternal/servecmd:\nadopt.go\nadopt_test.go\ncfgloader.go\ncfgloader_test.go\nclone.go\nclone_test.go\ncommitters.go\nlimits_test.go\nloops_test.go\nmerger.go\nreaping.go\nreaping_test.go\nrebuild.go\nrebuild_test.go\nreviewer.go\nreviewer_e2e_test.go\nreviewfix.go\nreviewfix_e2e_test.go\nscanners.go\nscanners_test.go\nserve.go\nserve_test.go\ntriage.go\ntriage_e2e_test.go\ntriage_test.go\nwake_other.go\nwake_unix.go\nwake_unix_test.go\nworker.go\nworker_e2e_test.go\n// Package servecmd implements `ard serve`: it resolves the target repo,\n// takes the leader lock, opens state, builds the GitHub reader and effect\n// layer, adopts running jobs into the slot pool, and runs the controller.\n// Loops are registered in registerLoops, one constructor call each.\npackage servecmd\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"os\"\n\t\"os/signal\"\n\t\"path/filepath\"\n\t\"slices\"\n\t\"strings\"\n\t\"sync\"\n\t\"sync/atomic\"\n\t\"syscall\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/agent/claude\"\n\t\"github.com/albertcbrown/ard/internal/cli\"\n\t\"github.com/albertcbrown/ard/internal/closeout\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/configsrc\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n\t\"github.com/albertcbrown/ard/internal/costblock\"\n\t\"github.com/albertcbrown/ard/internal/costs\"\n\t\"github.com/albertcbrown/ard/internal/effects\"\n\t\"github.com/albertcbrown/ard/internal/executor\"\n\t\"github.com/albertcbrown/ard/internal/executor/local\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n\t\"github.com/albertcbrown/ard/internal/limits\"\n\t\"github.com/albertcbrown/ard/internal/modelauth\"\n\t\"github.com/albertcbrown/ard/internal/pool\"\n\t\"github.com/albertcbrown/ard/internal/reaper\"\n\t\"github.com/albertcbrown/ard/internal/redact\"\n\t\"github.com/albertcbrown/ard/internal/repopath\"\n\t\"github.com/albertcbrown/ard/internal/scanner/stale\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n\t\"github.com/albertcbrown/ard/internal/state/scannerdb\"\n)\n\n// deps is what serve needs from the outside world. Tests inject fakes\n// through build, so no test builds a real GitHub client.\ntype deps struct {\n\tReader    github.Reader\n\tEffects   effects.Effects\n\tRemoteURL string         // where the controller fetches main from\n\tToken     gitx.TokenFunc // mints a push and fetch credential; nil in tests\n\tClose     func(