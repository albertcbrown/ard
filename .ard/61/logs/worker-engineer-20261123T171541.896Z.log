at-file\", \"blob\", obj)\n345-\tif err != nil {\n346-\t\treturn nil, false, fmt.Errorf(\"gitx: file %s at %.12s: %w\", path, rev, err)\n347-\t}\n348-\treturn []byte(blob), true, nil\n349-}\n350-\n351-// maxExportBytes caps the total size ExportPaths will write.\n352-var maxExportBytes int64 = 64 << 20\n353-","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01MkkLuhKBjegAwUJz9pE5sT","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
