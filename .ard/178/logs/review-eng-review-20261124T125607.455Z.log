{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018JwW9mYDkWaoo8Bz8tS1hJ","type":"tool_result","content":"457:diff --git a/docs/runbooks/gate-2.md b/docs/site/operations/gate-2-runbook.md\n473:diff --git a/docs/site/requirements.txt b/docs/site/requirements.txt\n481:diff --git a/docs/site/roles.md b/docs/site/roles.md\n540:diff --git a/docs/site/security.md b/docs/site/security.md\n559:diff --git a/docs/site/troubleshooting.md b/docs/site/troubleshooting.md\n602:diff --git a/go.mod b/go.mod\n615:diff --git a/internal/cli/commands.go b/internal/cli/commands.go\n650:diff --git a/internal/cli/commands_test.go b/internal/cli/commands_test.go\n674:diff --git a/internal/config/keys.go b/internal/config/keys.go\n707:diff --git a/internal/config/keys_test.go b/internal/config/keys_test.go\n771:diff --git a/internal/docscheck/docscheck.go b/internal/docscheck/docscheck.go\n926:diff --git a/internal/docscheck/docscheck_test.go b/internal/docscheck/docscheck_test.go\n1026:diff --git a/mkdocs.yml b/mkdocs.yml\ndiff --git a/go.mod b/go.mod\nindex f7eef86..149bda8 100644\n--- a/go.mod\n+++ b/go.mod\n@@ -23,7 +23,7 @@ require (\n \tgithub.com/mattn/go-isatty v0.0.24 // indirect\n \tgithub.com/ncruces/go-strftime v1.1.0 // indirect\n \tgithub.com/remyoudompheng/bigfft v0.0.0-20230129092748-24d4a6f8daec // indirect\n-\tgithub.com/spf13/pflag v1.0.9 // indirect\n+\tgithub.com/spf13/pflag v1.0.9\n \tgolang.org/x/mod v0.42.0 // indirect\n \tgolang.org/x/sync v0.24.0 // indirect\n \tgolang.org/x/sys v0.49.0 // indirect\ndiff --git a/internal/cli/commands.go b/internal/cli/commands.go\nnew file mode 100644\nindex 0000000..ab88ab7\n--- /dev/null\n+++ b/internal/cli/commands.go\n@@ -0,0 +1,29 @@\n+package cli\n+\n+import (\n+\t\"sort\"\n+\n+\t\"github.com/spf13/cobra\"\n+\t\"github.com/spf13/pflag\"\n+)\n+\n+// CommandPaths lists every command path (\"ard config check\") with the\n+// names of the flags it accepts (\"--loops\"), including inherited global\n+// flags. The docs drift check reads it.\n+func CommandPaths() map[string][]string {\n+\tout := map[string][]string{}\n+\tvar walk func(c *cobra.Command)\n+\twalk = func(c *cobra.Command) {\n+\t\tvar flags []string\n+\t\tadd := func(f *pflag.Flag) { flags = append(flags, \"--\"+f.Name) }\n+\t\tc.LocalFlags().VisitAll(add)\n+\t\tc.InheritedFlags().VisitAll(add)\n+\t\tsort.Strings(flags)\n+\t\tout[c.CommandPath()] = flags\n+\t\tfor _, sub := range c.Commands() {\n+\t\t\twalk(sub)\n+\t\t}\n+\t}\n+\twalk(NewRoot(&App{}))\n+\treturn out\n+}\ndiff --git a/internal/cli/commands_test.go b/internal/cli/commands_test.go\nnew file mode 100644\nindex 0000000..24a8975\n--- /dev/null\n+++ b/internal/cli/commands_test.go\n@@ -0,0 +1,18 @@\n+package cli\n+\n+import (\n+\t\"slices\"\n+\t\"testing\"\n+)\n+\n+func TestCommandPaths(t *testing.T) {\n+\tgot := CommandPaths()\n+\tfor _, p := range []string{\"ard\", \"ard serve\", \"ard init\", \"ard config check\", \"ard labels sync\", \"ard rebuild-state\", \"ard version\"} {\n+\t\tif _, ok := got[p]; !ok {\n+\t\t\tt.Errorf(\"missing command path %q\", p)\n+\t\t}\n+\t}\n+\tif !slices.Contains(got[\"ard serve\"], \"--loops\") || !slices.Contains(got[\"ard serve\"], \"--dry-run\") {\n+\t\tt.Errorf(\"ard serve flags = %v\", got[\"ard serve\"])\n+\t}\n+}\ndiff --git a/internal/config/keys.go b/internal/config/keys.go\nnew file mode 100644\nindex 0000000..1c3470e\n--- /dev/null\n+++ b/internal/config/keys.go\n@@ -0,0 +1,27 @@\n+package config\n+\n+// Keys returns every documented config key as a dotted path: the global\n+// keys in .ard/config.yaml and the per-role override keys. A map key is\n+// written as a placeholder (sidecars.<name>.repo). The user docs' key table\n+// is checked against this list, so a key added to the loader must be added\n+// here (TestKeysCoverRenderedConfig fails otherwise).\n+func Keys() []string {\n+\treturn []string{\n+\t\t\"max_pods\", \"executor\", \"agent\", \"require_approval\",\n+\t\t\"budget_usd_per_day\", \"max_budget_usd\", \"global_max_open\", \"paused\",\n+\t\t\"intervals.scanners\", \"intervals.triage\", \"intervals.workers\",\n+\t\t\"intervals.reviewers\", \"intervals.merger\",\n+\t\t\"intake.mode\", \"intake.label\",\n+\t\t\"merge.protected_paths\",\n+\t\t\"stale.inactive_for\", \"stale.suppress_for\",\n+\t\t\"redact.gitleaks.enabled\", \"redact.gitleaks.path\",\n+\t\t\"redact.gitleaks.block_autoclose_when_missing\",\n+\t\t\"sidecars.<name>.repo\", \"sidecars.<name>.ref\",\n+\t\t\"overrides\",\n+\t\t// Per-role override keys.\n+\t\t\"every\", \"max_open\", \"group_size\", \"autoclose\", \"route\",\n+\t\t\"model\", \"timeout\", \"sidecar\", \"after\", \"plan_section\",\n+\t\t\"tests\", \"max_test_fixes\", \"max_review_rounds\", \"reviewers\",\n+\t\t\"diff_warn_lines\", \"diff_max_lines\",\n+\t}\n+}\ndiff --git a/internal/config/keys_test.go b/internal/config/keys_test.go\nnew file mode 100644\nindex 0000000..45451aa\n--- /dev/null\n+++ b/internal/config/keys_test.go\n@@ -0,0 +1,58 @@\n+package config\n+\n+import (\n+\t\"reflect\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+// yamlPaths collects the dotted yaml-tag paths of leaf fields of t.\n+func yamlPaths(t reflect.Type, prefix string, out map[string]bool) {\n+\tfor i := 0; i < t.NumField(); i++ {\n+\t\ttag := strings.Split(t.Field(i).Tag.Get(\"yaml\"), \",\")[0]\n+\t\tif tag == \"\" || tag == \"-\" {\n+\t\t\tcontinue\n+\t\t}\n+\t\tpath := prefix + tag\n+\t\tft := t.Field(i).Type\n+\t\tswitch {\n+\t\tcase ft.Kind() == reflect.Struct && ft.PkgPath() == t.PkgPath():\n+\t\t\tyamlPaths(ft, path+\".\", out)\n+\t\tcase ft.Kind() == reflect.Map:\n+\t\t\tyamlPaths(ft.Elem(), path+\".<name>.\", out)\n+\t\tdefault:\n+\t\t\tout[path] = true\n+\t\t}\n+\t}\n+}\n+\n+func TestKeysCoverRenderedConfig(t *testing.T) {\n+\thave := map[string]bool{}\n+\tfor _, k := range Keys() {\n+\t\thave[k] = true\n+\t}\n+\tpaths := map[string]bool{}\n+\tyamlPaths(reflect.TypeOf(resolvedYAML{}), \"\", paths)\n+\tskip := map[string]bool{\"repo\": true, \"sha\": true, \"roles\": true}\n+\tfor p := range paths {\n+\t\tif skip[p] {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif p == \"protected_paths\" {\n+\t\t\tp = \"merge.protected_paths\"\n+\t\t}\n+\t\tif !have[p] {\n+\t\t\tt.Errorf(\"config key %q is rendered but missing from Keys()\", p)\n+\t\t}\n+\t}\n+\troles := map[string]bool{}\n+\tyamlPaths(reflect.TypeOf(roleYAML{}), \"\", roles)\n+\tfor _, k := range []string{\"agent\", \"model\", \"timeout\", \"sidecar\", \"every\", \"max_open\", \"group_size\", \"autoclose\", \"route\", \"after\", \"plan_section\", \"tests\", \"max_test_fixes\", \"max_review_rounds\", \"reviewers\", \"diff_warn_lines\", \"diff_max_lines\"} {\n+\t\tif !roles[k] {\n+\t\t\tt.Errorf(\"override key %q is no longer a roleYAML field\", k)\n+\t\t}\n+\t\tif !have[k] && k != \"agent\" {\n+\t\t\tt.Errorf(\"override key %q missing from Keys()\", k)\n+\t\t}\n+\t}\n+}\ndiff --git a/internal/docscheck/docscheck.go b/internal/docscheck/docscheck.go\nnew file mode 100644\nindex 0000000..68d43d0\n--- /dev/null\n+++ b/internal/docscheck/docscheck.go\n@@ -0,0 +1,149 @@\n+// Package docscheck keeps the user docs under docs/site honest: every ard\n+// command and flag they name must exist in the CLI, and the configuration\n+// reference must list exactly the keys the config package knows.\n+package docscheck\n+\n+import (\n+\t\"fmt\"\n+\t\"io/fs\"\n+\t\"regexp\"\n+\t\"strings\"\n+)\n+\n+// IgnoreMarker on the line before a command skips the check for that line.\n+const IgnoreMarker = \"<!-- docscheck:ignore -->\"\n+\n+var (\n+\tinlineCode = regexp.MustCompile(\"`([^`\\n]+)`\")\n+\twordRe     = regexp.MustCompile(`^[a-z][a-z-]*$`)\n+\tkeyCell    = regexp.MustCompile(\"^\\\\|\\\\s*`([^`]+)`\")\n+)\n+\n+// CheckCommands scans every .md file in fsys. Commands in fenced blocks\n+// (a line starting with \"ard\", optionally after \"$ \") and in inline code\n+// spans starting with \"ard \" are checked against paths, a map of command\n+// path (\"ard serve\") to its accepted flags. It returns one problem per\n+// bad command.\n+func CheckCommands(fsys fs.FS, paths map[string][]string) ([]string, error) {\n+\tvar problems []string\n+\terr := fs.WalkDir(fsys, \".\", func(p string, d fs.DirEntry, err error) error {\n+\t\tif err != nil || d.IsDir() || !strings.HasSuffix(p, \".md\") {\n+\t\t\treturn err\n+\t\t}\n+\t\tdata, err := fs.ReadFile(fsys, p)\n+\t\tif err != nil {\n+\t\t\treturn err\n+\t\t}\n+\t\tfenced, prev := false, \"\"\n+\t\tfor i, line := range strings.Split(string(data), \"\\n\") {\n+\t\t\ttrimmed := strings.TrimSpace(line)\n+\t\t\tignore := strings.TrimSpace(prev) == IgnoreMarker\n+\t\t\tprev = line\n+\t\t\tif strings.HasPrefix(trimmed, \"```\") {\n+\t\t\t\tfenced = !fenced\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tvar cmds []string\n+\t\t\tif fenced {\n+\t\t\t\tc := strings.TrimSpace(strings.TrimPrefix(trimmed, \"$ \"))\n+\t\t\t\tif c == \"ard\" || strings.HasPrefix(c, \"ard \") {\n+\t\t\t\t\tcmds = append(cmds, c)\n+\t\t\t\t}\n+\t\t\t} else {\n+\t\t\t\tfor _, m := range inlineCode.FindAllStringSubmatch(line, -1) {\n+\t\t\t\t\tif strings.HasPrefix(m[1], \"ard \") {\n+\t\t\t\t\t\tcmds = append(cmds, m[1])\n+\t\t\t\t\t}\n+\t\t\t\t}\n+\t\t\t}\n+\t\t\tif ignore {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tfor _, c := range cmds {\n+\t\t\t\tif msg := checkOne(c, paths); msg != \"\" {\n+\t\t\t\t\tproblems = append(problems, fmt.Sprintf(\"%s:%d: %s\", p, i+1, msg))\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\t\treturn nil\n+\t})\n+\treturn problems, err\n+}\n+\n+func checkOne(cmd string, paths map[string][]string) string {\n+\tvar toks []string\n+\tfor _, t := range strings.Fields(cmd) {\n+\t\tif t == \"|\" || t == \"&&\" || t == \";\" || t == \">\" || strings.HasPrefix(t, \"#\") {\n+\t\t\tbreak\n+\t\t}\n+\t\ttoks = append(toks, t)\n+\t}\n+\tpath, i := \"ard\", 1\n+\tvar flagToks []string\n+\tfor ; i < len(toks); i++ {\n+\t\tif next := path + \" \" + toks[i]; !strings.HasPrefix(toks[i], \"-\") {\n+\t\t\tif _, ok := paths[next]; ok {\n+\t\t\t\tpath = next\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t}\n+\t\tbreak\n+\t}\n+\thasChildren := false\n+\tfor p := range paths {\n+\t\tif strings.HasPrefix(p, path+\" \") {\n+\t\t\thasChildren = true\n+\t\t}\n+\t}\n+\tif i < len(toks) && hasChildren && wordRe.MatchString(toks[i]) {\n+\t\treturn fmt.Sprintf(\"unknown command %q\", path+\" \"+toks[i])\n+\t}\n+\tfor _, t := range toks[i:] {\n+\t\tif strings.HasPrefix(t, \"--\") {\n+\t\t\tflagToks = append(flagToks, t)\n+\t\t}\n+\t}\n+\tfor _, f := range flagToks {\n+\t\tname, _, _ := strings.Cut(f, \"=\")\n+\t\tname = strings.TrimRight(name, \",.\")\n+\t\tfound := false\n+\t\tfor _, ok := range paths[path] {\n+\t\t\tif ok == name {\n+\t\t\t\tfound = true\n+\t\t\t}\n+\t\t}\n+\t\tif !found {\n+\t\t\treturn fmt.Sprintf(\"%q has no flag %s\", path, name)\n+\t\t}\n+\t}\n+\treturn \"\"\n+}\n+\n+// CheckKeys compares the backticked keys in the first column of the\n+// tables in the configuration reference (page, an fs path) with keys.\n+func CheckKeys(fsys fs.FS, page string, keys []string) ([]string, error) {\n+\tdata, err := fs.ReadFile(fsys, page)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tdocumented := map[string]bool{}\n+\tfor _, line := range strings.Split(string(data), \"\\n\") {\n+\t\tif m := keyCell.FindStringSubmatch(line); m != nil {\n+\t\t\tdocumented[m[1]] = true\n+\t\t}\n+\t}\n+\twant := map[string]bool{}\n+\tvar problems []string\n+\tfor _, k := range keys {\n+\t\twant[k] = true\n+\t\tif !documented[k] {\n+\t\t\tproblems = append(problems, fmt.Sprintf(\"%s: config key %q is not documented\", page, k))\n+\t\t}\n+\t}\n+\tfor k := range documented {\n+\t\tif !want[k] {\n+\t\t\tproblems = append(problems, fmt.Sprintf(\"%s: documented key %q does not exist\", page, k))\n+\t\t}\n+\t}\n+\treturn problems, nil\n+}\ndiff --git a/internal/docscheck/docscheck_test.go b/internal/docscheck/docscheck_test.go\nnew file mode 100644\nindex 0000000..a92c581\n--- /dev/null\n+++ b/internal/docscheck/docscheck_test.go\n@@ -0,0 +1,94 @@\n+package docscheck\n+\n+import (\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"sort\"\n+\t\"strings\"\n+\t\"testing\"\n+\t\"testing/fstest\"\n+\n+\t\"github.com/albertcbrown/ard/internal/cli\"\n+\t\"github.com/albertcbrown/ard/internal/config\"\n+)\n+\n+func one(body string) fstest.MapFS {\n+\treturn fstest.MapFS{\"a.md\": {Data: []byte(body)}}\n+}\n+\n+func TestCheckCommandsFixtures(t *testing.T) {\n+\tpaths := cli.CommandPaths()\n+\tcases := []struct {\n+\t\tname, body, want string\n+\t}{\n+\t\t{\"unknown command\", \"Run `ard bogus`.\", `unknown command \"ard bogus\"`},\n+\t\t{\"unknown flag\", \"Run `ard serve --nope`.\", \"no flag --nope\"},\n+\t\t{\"known flag\", \"Run `ard serve --dry-run`.\", \"\"},\n+\t\t{\"global flag on subcommand\", \"`ard config check --repo a/b --ref main`\", \"\"},\n+\t\t{\"fenced prompt\", \"```sh\\n$ ard labels sync --dry-run\\n```\", \"\"},\n+\t\t{\"fenced bad\", \"```sh\\nard labels nope\\n```\", \"unknown command\"},\n+\t\t{\"ignored\", \"<!-- docscheck:ignore -->\\nRun `ard bogus`.\", \"\"},\n+\t\t{\"prose only\", \"ard is a tool. `ard:pending` and `ard-bot`.\", \"\"},\n+\t\t{\"placeholder arg\", \"`ard rebuild-state <scanner>`\", \"\"},\n+\t}\n+\tfor _, c := range cases {\n+\t\tgot, err := CheckCommands(one(c.body), paths)\n+\t\tif err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tjoined := strings.Join(got, \"\\n\")\n+\t\tif c.want == \"\" && joined != \"\" || !strings.Contains(joined, c.want) {\n+\t\t\tt.Errorf(\"%s: problems = %q, want %q\", c.name, joined, c.want)\n+\t\t}\n+\t}\n+}\n+\n+func TestCheckKeysFixtures(t *testing.T) {\n+\tkeys := []string{\"max_pods\", \"paused\"}\n+\tgot, _ := CheckKeys(one(\"| `max_pods` | 3 |\\n| `old_key` | x |\\n\"), \"a.md\", keys)\n+\tsort.Strings(got)\n+\tjoined := strings.Join(got, \"\\n\")\n+\tif !strings.Contains(joined, `\"paused\" is not documented`) || !strings.Contains(joined, `\"old_key\" does not exist`) {\n+\t\tt.Errorf(\"problems = %q\", joined)\n+\t}\n+\tif got, _ := CheckKeys(one(\"| `max_pods` |\\n| `paused` |\\n\"), \"a.md\", keys); len(got) != 0 {\n+\t\tt.Errorf(\"unexpected problems %q\", got)\n+\t}\n+}\n+\n+func siteDir(t *testing.T) string {\n+\tdir, err := os.Getwd()\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tfor {\n+\t\tif _, err := os.Stat(filepath.Join(dir, \"go.mod\")); err == nil {\n+\t\t\treturn filepath.Join(dir, \"docs\", \"site\")\n+\t\t}\n+\t\tparent := filepath.Dir(dir)\n+\t\tif parent == dir {\n+\t\t\tt.Fatal(\"go.mod not found\")\n+\t\t}\n+\t\tdir = parent\n+\t}\n+}\n+\n+func TestRealDocsCommandsExist(t *testing.T) {\n+\tproblems, err := CheckCommands(os.DirFS(siteDir(t)), cli.CommandPaths())\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tfor _, p := range problems {\n+\t\tt.Error(p)\n+\t}\n+}\n+\n+func TestRealDocsConfigKeysMatch(t *testing.T) {\n+\tproblems, err := CheckKeys(os.DirFS(siteDir(t)), \"configuration.md\", config.Keys())\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tfor _, p := range problems {\n+\t\tt.Error(p)\n+\t}\n+}\ndiff --git a/mkdocs.yml b/mkdocs.yml\nnew file mode 100644\nindex 0000000..2302c71\n--- /dev/null\n+++ b/mkdocs.yml\n@@ -0,0 +1,24 @@\n+site_name: ard\n+site_description: Automated repository development\n+site_url: https://albertcbrown.github.io/ard/\n+repo_url: https://github.com/albertcbrown/ard\n+docs_dir: docs/site\n+strict: true\n+theme:\n+  name: material\n+  features:\n+    - navigation.sections\n+    - search.suggest\n+plugins:\n+  - search\n+nav:\n+  - Overview: index.md\n+  - Install: install.md\n+  - Getting started: getting-started.md\n+  - Configuration: configuration.md\n+  - Roles: roles.md\n+  - Operations:\n+      - operations.md\n+      - Gate 2 runbook: operations/gate-2-runbook.md\n+  - Security model: security.md\n+  - Troubleshooting: troubleshooting.md","is_error":false}]},"parent_tool_use_id":null,"session_id":"26fa1537-61ed-429a-9d98-0b718b4bb6e1","uuid":"58b649e0-e6b5-4652-add8-0ff6d4f9c02f","timestamp":"2026-11-24T12:56:12.073Z","tool_use_result":{"stdout":"457:diff --git a/docs/runbooks/gate-2.md b/docs/site/operations/gate-2-runbook.md\n473:diff --git a/docs/site/requirements.txt b/docs/site/requirements.txt\n481:diff --git a/docs/site/roles.md b/docs/site/roles.md\n540:diff --git a/docs/site/security.md b/docs/site/security.md\n559:diff --git a/docs/site/troubleshooting.md b/docs/site/troubleshooting.md\n602:diff --git a/go.mod b/go.mod\n615:diff --git a/internal/cli/commands.go b/internal/cli/commands.go\n650:diff --git a/internal/cli/commands_test.go b/internal/cli/commands_test.go\n674:diff --git a/internal/config/keys.go b/internal/config/keys.go\n707:diff --git a/internal/config/keys_test.go b/internal/config/keys_test.go\n771:diff --git a/internal/docscheck/docscheck.go b/internal/docscheck/docscheck.go\n926:diff --git a/internal/docscheck/docscheck_test.go b/internal/docscheck/docscheck_test.go\n1026:diff --git a/mkdocs.yml b/mkdocs.yml\ndiff --git a/go.mod b/go.mod\nindex f7eef86..149bda8 100644\n--- a/go.mod\n+++ b/go.mod\n@@ -23,7 +23,7 @@ require (\n \tgithub.com/mattn/go-isatty v0.0.24 // indirect\n \tgithub.com/ncruces/go-strftime v1.1.0 // indirect\n \tgithub.com/remyoudompheng/bigfft v0.0.0-20230129092748-24d4a6f8daec // indirect\n-\tgithub.com/spf13/pflag v1.0.9 // indirect\n+\tgithub.com/spf13/pflag v1.0.9\n \tgolang.org/x/mod v0.42.0 // indirect\n \tgolang.org/x/sync v0.24.0 // indirect\n \tgolang.org/x/sys v0.49.0 // indirect\ndiff --git a/internal/cli/commands.go b/internal/cli/commands.go\nnew file mode 100644\nindex 0000000..ab88ab7\n--- /dev/null\n+++ b/internal/cli/commands.go\n@@ -0,0 +1,29 @@\n+package cli\n+\n+import (\n+\t\"sort\"\n+\n+\t\"github.com/spf13/cobra\"\n+\t\"github.com/spf13/pflag\"\n+)\n+\n+// CommandPaths lists every command path (\"ard config check\") with the\n+// names of the flags it accepts (\"--loops\"), including inherited global\n+// flags. The docs drift check reads it.\n+func CommandPaths() map[string][]string {\n+\tout := map[string][]string{}\n+\tvar walk func(c *cobra.Command)\n+\twalk = func(c *cobra.Command) {\n+\t\tvar flags []string\n+\t\tadd := func(f *pflag.Flag) { flags = append(flags, \"--\"+f.Name) }\n+\t\tc.LocalFlags().VisitAll(add)\n+\t\tc.InheritedFlags().VisitAll(add)\n+\t\tsort.Strings(flags)\n+\t\tout[c.CommandPath()] = flags\n+\t\tfor _, sub := range c.Commands() {\n+\t\t\twalk(sub)\n+\t\t}\n+\t}\n+\twalk(NewRoot(&App{}))\n+\treturn out\n+}\ndiff --git a/internal/cli/commands_test.go b/internal/cli/commands_test.go\nnew file mode 100644\nindex 0000000..24a8975\n--- /dev/null\n+++ b/internal/cli/commands_test.go\n@@ -0,0 +1,18 @@\n+package cli\n+\n+import (\n+\t\"slices\"\n+\t\"testing\"\n+)\n+\n+func TestCommandPaths(t *testing.T) {\n+\tgot := CommandPaths()\n+\tfor _, p := range []string{\"ard\", \"ard serve\", \"ard init\", \"ard config check\", \"ard labels sync\", \"ard rebuild-state\", \"ard version\"} {\n+\t\tif _, ok := got[p]; !ok {\n+\t\t\tt.Errorf(\"missing command path %q\", p)\n+\t\t}\n+\t}\n+\tif !slices.Contains(got[\"ard serve\"], \"--loops\") || !slices.Contains(got[\"ard serve\"], \"--dry-run\") {\n+\t\tt.Errorf(\"ard serve flags = %v\", got[\"ard serve\"])\n+\t}\n+}\ndiff --git a/internal/config/keys.go b/internal/config/keys.go\nnew file mode 100644\nindex 0000000..1c3470e\n--- /dev/null\n+++ b/internal/config/keys.go\n@@ -0,0 +1,27 @@\n+package config\n+\n+// Keys returns every documented config key as a dotted path: the global\n+// keys in .ard/config.yaml and the per-role override keys. A map key is\n+// written as a placeholder (sidecars.<name>.repo). The user docs' key table\n+// is checked against this list, so a key added to the loader must be added\n+// here (TestKeysCoverRenderedConfig fails otherwise).\n+func Keys() []string {\n+\treturn []string{\n+\t\t\"max_pods\", \"executor\", \"agent\", \"require_approval\",\n+\t\t\"budget_usd_per_day\", \"max_budget_usd\", \"global_max_open\", \"paused\",\n+\t\t\"intervals.scanners\", \"intervals.triage\", \"intervals.workers\",\n+\t\t\"intervals.reviewers\", \"intervals.merger\",\n+\t\t\"intake.mode\", \"intake.label\",\n+\t\t\"merge.protected_paths\",\n+\t\t\"stale.inactive_for\", \"stale.suppress_for\",\n+\t\t\"redact.gitleaks.enabled\", \"redact.gitleaks.path\",\n+\t\t\"redact.gitleaks.block_autoclose_when_missing\",\n+\t\t\"sidecars.<name>.repo\", \"sidecars.<name>.ref\",\n+\t\t\"overrides\",\n+\t\t// Per-role override keys.\n+\t\t\"every\", \"max_open\", \"group_size\", \"autoclose\", \"route\",\n+\t\t\"model\", \"timeout\", \"sidecar\", \"after\", \"plan_section\",\n+\t\t\"tests\", \"max_test_fixes\", \"max_review_rounds\", \"reviewers\",\n+\t\t\"diff_warn_lines\", \"diff_max_lines\",\n+\t}\n+}\ndiff --git a/internal/config/keys_test.go b/internal/config/keys_test.go\nnew file mode 100644\nindex 0000000..45451aa\n--- /dev/null\n+++ b/internal/config/keys_test.go\n@@ -0,0 +1,58 @@\n+package config\n+\n+import (\n+\t\"reflect\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+// yamlPaths collects the dotted yaml-tag paths of leaf fields of t.\n+func yamlPaths(t reflect.Type, prefix string, out map[string]bool) {\n+\tfor i := 0; i < t.NumField(); i++ {\n+\t\ttag := strings.Split(t.Field(i).Tag.Get(\"yaml\"), \",\")[0]\n+\t\tif tag == \"\" || tag == \"-\" {\n+\t\t\tcontinue\n+\t\t}\n+\t\tpath := prefix + tag\n+\t\tft := t.Field(i).Type\n+\t\tswitch {\n+\t\tcase ft.Kind() == reflect.Struct && ft.PkgPath() == t.PkgPath():\n+\t\t\tyamlPaths(ft, path+\".\", out)\n+\t\tcase ft.Kind() == reflect.Map:\n+\t\t\tyamlPaths(ft.Elem(), path+\".<name>.\", out)\n+\t\tdefault:\n+\t\t\tout[path] = true\n+\t\t}\n+\t}\n+}\n+\n+func TestKeysCoverRenderedConfig(t *testing.T) {\n+\thave := map[string]bool{}\n+\tfor _, k := range Keys() {\n+\t\thave[k] = true\n+\t}\n+\tpaths := map[string]bool{}\n+\tyamlPaths(reflect.TypeOf(resolvedYAML{}), \"\", paths)\n+\tskip := map[string]bool{\"repo\": true, \"sha\": true, \"roles\": true}\n+\tfor p := range paths {\n+\t\tif skip[p] {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif p == \"protected_paths\" {\n+\t\t\tp = \"merge.protected_paths\"\n+\t\t}\n+\t\tif !have[p] {\n+\t\t\tt.Errorf(\"config key %q is rendered but missing from Keys()\", p)\n+\t\t}\n+\t}\n+\troles := map[string]bool{}\n+\tyamlPaths(reflect.TypeOf(roleYAML{}), \"\", roles)\n+\tfor _, k := range []string{\"agent\", \"model\", \"timeout\", \"sidecar\", \"every\", \"max_open\", \"group_size\", \"autoclose\", \"route\", \"after\", \"plan_section\", \"tests\", \"max_test_fixes\", \"max_review_rounds\", \"reviewers\", \"diff_warn_lines\", \"diff_max_lines\"} {\n+\t\tif !roles[k] {\n+\t\t\tt.Errorf(\"override key %q is no longer a roleYAML field\", k)\n+\t\t}\n+\t\tif !have[k] && k != \"agent\" {\n+\t\t\tt.Errorf(\"override key %q missing from Keys()\", k)\n+\t\t}\n+\t}\n+}\ndiff --git a/internal/docscheck/docscheck.go b/internal/docscheck/docscheck.go\nnew file mode 100644\nindex 0000000..68d43d0\n--- /dev/null\n+++ b/internal/docscheck/docscheck.go\n@@ -0,0 +1,149 @@\n+// Package docscheck keeps the user docs under docs/site honest: every ard\n+// command and flag they name must exist in the CLI, and the configuration\n+// reference must list exactly the keys the config package knows.\n+package docscheck\n+\n+import (\n+\t\"fmt\"\n+\t\"io/fs\"\n+\t\"regexp\"\n+\t\"strings\"\n+)\n+\n+// IgnoreMarker on the line before a command skips the check for that line.\n+const IgnoreMarker = \"<!-- docscheck:ignore -->\"\n+\n+var (\n+\tinlineCode = regexp.MustCompile(\"`([^`\\n]+)`\")\n+\twordRe     = regexp.MustCompile(`^[a-z][a-z-]*$`)\n+\tkeyCell    = regexp.MustCompile(\"^\\\\|\\\\s*`([^`]+)`\")\n+)\n+\n+// CheckCommands scans every .md file in fsys. Commands in fenced blocks\n+// (a line starting with \"ard\", optionally after \"$ \") and in inline code\n+// spans starting with \"ard \" are checked against paths, a map of command\n+// path (\"ard serve\") to its accepted flags. It returns one problem per\n+// bad command.\n+func CheckCommands(fsys fs.FS, paths map[string][]string) ([]string, error) {\n+\tvar problems []string\n+\terr := fs.WalkDir(fsys, \".\", func(p string, d fs.DirEntry, err error) error {\n+\t\tif err != nil || d.IsDir() || !strings.HasSuffix(p, \".md\") {\n+\t\t\treturn err\n+\t\t}\n+\t\tdata, err := fs.ReadFile(fsys, p)\n+\t\tif err != nil {\n+\t\t\treturn err\n+\t\t}\n+\t\tfenced, prev := false, \"\"\n+\t\tfor i, line := range strings.Split(string(data), \"\\n\") {\n+\t\t\ttrimmed := strings.TrimSpace(line)\n+\t\t\tignore := strings.TrimSpace(prev) == IgnoreMarker\n+\t\t\tprev = line\n+\t\t\tif strings.HasPrefix(trimmed, \"```\") {\n+\t\t\t\tfenced = !fenced\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tvar cmds []string\n+\t\t\tif fenced {\n+\t\t\t\tc := strings.TrimSpace(strings.TrimPrefix(trimmed, \"$ \"))\n+\t\t\t\tif c == \"ard\" || strings.HasPrefix(c, \"ard \") {\n+\t\t\t\t\tcmds = append(cmds, c)\n+\t\t\t\t}\n+\t\t\t} else {\n+\t\t\t\tfor _, m := range inlineCode.FindAllStringSubmatch(line, -1) {\n+\t\t\t\t\tif strings.HasPrefix(m[1], \"ard \") {\n+\t\t\t\t\t\tcmds = append(cmds, m[1])\n+\t\t\t\t\t}\n+\t\t\t\t}\n+\t\t\t}\n+\t\t\tif ignore {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tfor _, c := range cmds {\n+\t\t\t\tif msg := checkOne(c, paths); msg != \"\" {\n+\t\t\t\t\tproblems = append(problems, fmt.Sprintf(\"%s:%d: %s\", p, i+1, msg))\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\t\treturn nil\n+\t})\n+\treturn problems, err\n+}\n+\n+func checkOne(cmd string, paths map[string][]string) string {\n+\tvar toks []string\n+\tfor _, t := range strings.Fields(cmd) {\n+\t\tif t == \"|\" || t == \"&&\" || t == \";\" || t == \">\" || strings.HasPrefix(t, \"#\") {\n+\t\t\tbreak\n+\t\t}\n+\t\ttoks = append(toks, t)\n+\t}\n+\tpath, i := \"ard\", 1\n+\tvar flagToks []string\n+\tfor ; i < len(toks); i++ {\n+\t\tif next := path + \" \" + toks[i]; !strings.HasPrefix(toks[i], \"-\") {\n+\t\t\tif _, ok := paths[next]; ok {\n+\t\t\t\tpath = next\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t}\n+\t\tbreak\n+\t}\n+\thasChildren := false\n+\tfor p := range paths {\n+\t\tif strings.HasPrefix(p, path+\" \") {\n+\t\t\thasChildren = true\n+\t\t}\n+\t}\n+\tif i < len(toks) && hasChildren && wordRe.MatchString(toks[i]) {\n+\t\treturn fmt.Sprintf(\"unknown command %q\", path+\" \"+toks[i])\n+\t}\n+\tfor _, t := range toks[i:] {\n+\t\tif strings.HasPrefix(t, \"--\") {\n+\t\t\tflagToks = append(flagToks, t)\n+\t\t}\n+\t}\n+\tfor _, f := range flagToks {\n+\t\tname, _, _ := strings.Cut(f, \"=\")\n+\t\tname = strings.TrimRight(name, \",.\")\n+\t\tfound := false\n+\t\tfor _, ok := range paths[path] {\n+\t\t\tif ok == name {\n+\t\t\t\tfound = true\n+\t\t\t}\n+\t\t}\n+\t\tif !found {\n+\t\t\treturn fmt.Sprintf(\"%q has no flag %s\", path, name)\n+\t\t}\n+\t}\n+\treturn \"\"\n+}\n+\n+// CheckKeys compares the backticked keys in the first column of the\n+// tables in the configuration reference (page, an fs path) with keys.\n+func CheckKeys(fsys fs.FS, page string, keys []string) ([]string, error) {\n+\tdata, err := fs.ReadFile(fsys, page)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tdocumented := map[string]bool{}\n+\tfor _, line := range strings.Split(string(data), \"\\n\") {\n+\t\tif m := keyCell.FindStringSubmatch(line); m != nil {\n+\t\t\tdocumented[m[1]] = true\n+\t\t}\n+\t}\n+\twant := map[string]bool{}\n+\tvar problems []string\n+\tfor _, k := range keys {\n+\t\twant[k] = true\n+\t\tif !documented[k] {\n+\t\t\tproblems = append(problems, fmt.Sprintf(\"%s: config key %q is not documented\", page, k))\n+\t\t}\n+\t}\n+\tfor k := range documented {\n+\t\tif !want[k] {\n+\t\t\tproblems = append(problems, fmt.Sprintf(\"%s: documented key %q does not exist\", page, k))\n+\t\t}\n+\t}\n+\treturn problems, nil\n+}\ndiff --git a/internal/docscheck/docscheck_test.go b/internal/docscheck/docscheck_test.go\nnew file mode 100644\nindex 0000000..a92c581\n--- /dev/null\n+++ b/internal/docscheck/docscheck_test.go\n@@ -0,0 +1,94 @@\n+package docscheck\n+\n+import (\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"sort\"\n+\t\"strings\"\n+\t\"testing\"\n+\t\"testing/fstest\"\n+\n+\t\"github.com/albertcbrown/ard/internal/cli\"\n+\t\"github.com/albertcbrown/ard/internal/config\"\n+)\n+\n+func one(body string) fstest.MapFS {\n+\treturn fstest.MapFS{\"a.md\": {Data: []byte(body)}}\n+}\n+\n+func TestCheckCommandsFixtures(t *testing.T) {\n+\tpaths := cli.CommandPaths()\n+\tcases := []struct {\n+\t\tname, body, want string\n+\t}{\n+\t\t{\"unknown command\", \"Run `ard bogus`.\", `unknown command \"ard bogus\"`},\n+\t\t{\"unknown flag\", \"Run `ard serve --nope`.\", \"no flag --nope\"},\n+\t\t{\"known flag\", \"Run `ard serve --dry-run`.\", \"\"},\n+\t\t{\"global flag on subcommand\", \"`ard config check --repo a/b --ref main`\", \"\"},\n+\t\t{\"fenced prompt\", \"```sh\\n$ ard labels sync --dry-run\\n```\", \"\"},\n+\t\t{\"fenced bad\", \"```sh\\nard labels nope\\n```\", \"unknown command\"},\n+\t\t{\"ignored\", \"<!-- docscheck:ignore -->\\nRun `ard bogus`.\", \"\"},\n+\t\t{\"prose only\", \"ard is a tool. `ard:pending` and `ard-bot`.\", \"\"},\n+\t\t{\"placeholder arg\", \"`ard rebuild-state <scanner>`\", \"\"},\n+\t}\n+\tfor _, c := range cases {\n+\t\tgot, err := CheckCommands(one(c.body), paths)\n+\t\tif err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tjoined := strings.Join(got, \"\\n\")\n+\t\tif c.want == \"\" && joined != \"\" || !strings.Contains(joined, c.want) {\n+\t\t\tt.Errorf(\"%s: problems = %q, want %q\", c.name, joined, c.want)\n+\t\t}\n+\t}\n+}\n+\n+func TestCheckKeysFixtures(t *testing.T) {\n+\tkeys := []string{\"max_pods\", \"paused\"}\n+\tgot, _ := CheckKeys(one(\"| `max_pods` | 3 |\\n| `old_key` | x |\\n\"), \"a.md\", keys)\n+\tsort.Strings(got)\n+\tjoined := strings.Join(got, \"\\n\")\n+\tif !strings.Contains(joined, `\"paused\" is not documented`) || !strings.Contains(joined, `\"old_key\" does not exist`) {\n+\t\tt.Errorf(\"problems = %q\", joined)\n+\t}\n+\tif got, _ := CheckKeys(one(\"| `max_pods` |\\n| `paused` |\\n\"), \"a.md\", keys); len(got) != 0 {\n+\t\tt.Errorf(\"unexpected problems %q\", got)\n+\t}\n+}\n+\n+func siteDir(t *testing.T) string {\n+\tdir, err := os.Getwd()\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tfor {\n+\t\tif _, err := os.Stat(filepath.Join(dir, \"go.mod\")); err == nil {\n+\t\t\treturn filepath.Join(dir, \"docs\", \"site\")\n+\t\t}\n+\t\tparent := filepath.Dir(dir)\n+\t\tif parent == dir {\n+\t\t\tt.Fatal(\"go.mod not found\")\n+\t\t}\n+\t\tdir = parent\n+\t}\n+}\n+\n+func TestRealDocsCommandsExist(t *testing.T) {\n+\tproblems, err := CheckCommands(os.DirFS(siteDir(t)), cli.CommandPaths())\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tfor _, p := range problems {\n+\t\tt.Error(p)\n+\t}\n+}\n+\n+func TestRealDocsConfigKeysMatch(t *testing.T) {\n+\tproblems, err := CheckKeys(os.DirFS(siteDir(t)), \"configuration.md\", config.Keys())\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tfor _, p := range problems {\n+\t\tt.Error(p)\n+\t}\n+}\ndiff --git a/mkdocs.yml b/mkdocs.yml\nnew file mode 100644\nindex 0000000..2302c71\n--- /dev/null\n+++ b/mkdocs.yml\n@@ -0,0 +1,24 @@\n+site_name: ard\n+site_description: Automated repository development\n+site_url: https://albertcbrown.github.io/ard/\n+repo_url: https://github.com/albertcbrown/ard\n+docs_dir: docs/site\n+strict: true\n+theme:\n+  name: material\n+  features:\n+    - navigation.sections\n+    - search.suggest\n+plugins:\n+  - search\n+nav:\n+  - Overview: index.md\n+  - Install: install.md\n+  - Getting started: getting-started.md\n+  - Configuration: configuration.md\n+  - Roles: roles.md\n+  - Operations:\n+      - operations.md\n+      - Gate 2 runbook: operations/gate-2-runbook.md\n+  - Security model: security.md\n+  - Troubleshooting: troubleshooting.md","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_018JwW9mYDkWaoo8Bz8tS1hJ","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
