{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018BzuDjreqKgTudrW6KSPR9","type":"tool_result","content":"bot-commits.yml\nci.yml\nversion.yml\npackage config\n\nimport (\n\t\"fmt\"\n\t\"io/fs\"\n\t\"strings\"\n\n\t\"gopkg.in/yaml.v3\"\n)\n\n// This file holds the YAML-facing structs. Every mapping is walked key by\n// key (instead of a plain struct decode) so that an error can name the\n// exact file and key that produced it; decoding individual values still\n// goes through yaml.Node.Decode, so anchors and scalars behave normally.\n\n// rawConfig is .ard/config.yaml before defaults and merging.\ntype rawConfig struct {\n\tmaxPods                *int\n\texecutor               *string\n\tagent                  *string\n\trequireApproval        *bool\n\tbudgetUSDPerDay        *float64\n\tmaxBudgetUSD           *float64\n\tglobalMaxOpen          *int\n\tpaused                 *bool\n\tintervals              rawIntervals\n\tintake                 rawIntake\n\tprotectedPaths         []string // merge.protected_paths\n\thaveMerge              bool\n\tstale                  rawStale\n\thaveStale              bool\n\tgitleaksEnabled        *bool // redact.gitleaks.enabled\n\tgitleaksPath           *string\n\tgitleaksBlockAutoclose *bool // redact.gitleaks.block_autoclose_when_missing\n\tsidecars               map[string]rawSidecar\n\toverrides              []rawOverrideRef\n}\n\n// rawIntervals keeps every interval optional so defaults can tell \"unset\"\n// apart from an explicit value.\ntype rawIntervals struct {\n\tscanners, triage, workers, reviewers, merger *Duration\n}\n\n// rawIntake keeps both keys optional so defaults can tell \"unset\" apart\n// from an explicit value (an explicit empty label is an error).\ntype rawIntake struct {\n\tmode, label *string\n}\n\ntype rawStale struct {\n\tinactiveFor, suppressFor *Duration\n}\n\ntype rawSidecar struct {\n\trepo *string\n\tref  *string\n}\n\n// rawOverrideRef is one overrides entry kept as its YAML node; entries are\n// validated and merged once the role directories are known.\ntype rawOverrideRef struct {\n\tkey   string // \"scanners/cve\"\n\tvalue *yaml.Node\n}\n\n// parseConfigFile reads cfgPath from fsys and parses it. A missing file is\n// not an error: it yields a zero rawConfig and every default applies.\nfunc parseConfigFile(fsys fs.FS, cfgPath string) (rawConfig, Errors) {\n\tvar raw rawConfig\n\tdata, err := fs.ReadFile(fsys, cfgPath)\n\tif err != nil {\n\t\treturn raw, nil // no config file: defaults only\n\t}\n\tvar doc yaml.Node\n\tif err := yaml.Unmarshal(data, &doc); err != nil {\n\t\treturn raw, Errors{{File: cfgPath, Msg: fmt.Sprintf(\"invalid YAML: %v\", err)}}\n\t}\n\treturn parseConfigDoc(&doc, cfgPath)\n}\npackage config\n\nimport (\n\t\"io\"\n\n\t\"gopkg.in/yaml.v3\"\n)\n\n// WriteYAML renders the resolved configuration to w in the same schema\n// .ard/config.yaml uses, so `ard config check` shows exactly what the\n// controller will see. Durations render in the compact unit form.\nfunc (r *Resolved) WriteYAML(w io.Writer) error {\n\tenc := yaml.NewEncoder(w)\n\tenc.SetIndent(2)\n\tif err := enc.Encode(r.render()); err != nil {\n\t\treturn err\n\t}\n\treturn enc.Close()\n}\n\ntype resolvedYAML struct {\n\tRepo            string                 `yaml:\"repo\"`\n\tSHA             string                 `yaml:\"sha,omitempty\"`\n\tMaxPods         int                    `yaml:\"max_pods\"`\n\tExecutor        string                 `yaml:\"executor\"`\n\tAgent           string                 `yaml:\"agent\"`\n\tRequireApproval bool                   `yaml:\"require_approval\"`\n\tBudgetUSDPerDay float64                `yaml:\"budget_usd_per_day\"`\n\tMaxBudgetUSD    float64                `yaml:\"max_budget_usd\"`\n\tGlobalMaxOpen   int                    `yaml:\"global_max_open\"`\n\tPaused          bool                   `yaml:\"paused\"`\n\tIntervals       intervalsYAML          `yaml:\"intervals\"`\n\tIntake          intakeYAML             `yaml:\"intake\"`\n\tProtectedPaths  []string               `yaml:\"protected_paths,omitempty\"`\n\tStale           staleYAML              `yaml:\"stale\"`\n\tRedact          redactYAML             `yaml:\"redact\"`\n\tSidecars        map[string]sidecarYAML `yaml:\"sidecars,omitempty\"`\n\tRoles           []roleYAML             `yaml:\"roles,omitempty\"`\n}\n\ntype intervalsYAML struct {\n\tScanners  Duration `yaml:\"scanners\"`\n\tTriage    Duration `yaml:\"triage\"`\n\tWorkers   Duration `yaml:\"workers\"`\n\tReviewers Duration `yaml:\"reviewers\"`\n\tMerger    Duration `yaml:\"merger\"`\n}\n\ntype intakeYAML struct {\n\tMode  IntakeMode `yaml:\"mode\"`\n\tLabel string     `yaml:\"label,omitempty\"`\n}\n\ntype staleYAML struct {\n\tInactiveFor Duration `yaml:\"inactive_for\"`\n\tSuppressFor Duration `yaml:\"suppress_for\"`\n}\n\ntype redactYAML struct {\n\tGitleaks gitleaksYAML `yaml:\"gitleaks\"`\nfunc NewRoot(app *App) *cobra.Command {\n\troot := &cobra.Command{\n\t\tUse:   \"ard\",\n\t\tShort: \"ard - automated repository development\",\n\t\tLong: `ard makes a GitHub repository maintain itself: scanners file\ndeduplicated issues, triage agents turn each issue into a plan, a worker\nimplements it on a branch, reviewer agents critique the PR, and the merger\nlands it once every review passes.`,\n\n\t\tVersion:           app.Version,\n\t\tSilenceErrors:     true,\n\t\tSilenceUsage:      true,\n\t\tCompletionOptions: cobra.CompletionOptions{DisableDefaultCmd: true},\n\t\tPersistentPreRunE: func(cmd *cobra.Command, _ []string) error {\n\t\t\treturn app.setup(cmd)\n\t\t},\n\t}\n\troot.SetVersionTemplate(\"ard {{.Version}}\\n\")\n\n\tg := &app.Globals\n\troot.PersistentFlags().StringVar(&g.Repo, \"repo\", \"\",\n\t\t`target repository as \"owner/repo\" (default: resolved from config)`)\n\troot.PersistentFlags().StringVar(&g.ConfigPath, \"config\", \"\",\n\t\t\"path to config.yaml (default: .ard/config.yaml in the target repo)\")\n\troot.PersistentFlags().Bool