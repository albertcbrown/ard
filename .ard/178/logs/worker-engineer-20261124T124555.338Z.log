internal/cli/cmd_rebuild.go:11:\t\tUse:   \"rebuild-state <scanner>\",\ninternal/cli/cmd_serve.go:12:\t\tUse:   \"serve\",\ninternal/cli/cmd_serve.go:24:\tcmd.Flags().StringSliceVar(&opts.Loops, \"loops\", nil,\ninternal/cli/cmd_version.go:11:\t\tUse:   \"version\",\n./docs/proposal.md\n./.ard/59/logs/triage-engineer-20261123T223006.764Z.log\n./.ard/161/logs/review-eng-review-20261123T130431.215Z.log\n./.ard/161/logs/review-eng-review-20261123T125942.695Z.log\n./.ard/161/logs/worker-engineer-20261123T125517.529Z.log\n./.ard/161/logs/triage-engineer-20261123T121503.359Z.log\n./.ard/161/plan.md\n./.ard/194/logs/triage-lead-20261123T140843.249Z.log\n./.ard/194/logs/worker-engineer-20261123T143325.353Z.log\n./.ard/194/logs/triage-engineer-20261123T142013.858Z.log\n./.ard/194/logs/review-eng-review-20261123T143852.142Z.log\n./.ard/194/plan.md\n./.ard/194/worker-engineer.md\n./.ard/158/logs/triage-lead-20261123T102041.483Z.log\n./.ard/158/logs/triage-engineer-20261123T102518.182Z.log\n./.ard/243/logs/triage-lead-20261123T225858.076Z.log\n./.ard/223/logs/review-eng-review-20261123T194055.568Z.log\n./.ard/223/logs/triage-lead-20261123T173548.125Z.log\n./.ard/223/logs/triage-engineer-20261123T174031.393Z.log\n./.ard/223/logs/worker-engineer-20261123T193355.843Z.log\n./.ard/223/logs/review-eng-review-20261123T200917.542Z.log\n./.ard/223/plan.md\n./.ard/223/worker-engineer.md\n./.ard/184/logs/review-eng-review-20261123T143327.004Z.log\n./.ard/184/logs/triage-engineer-20261123T134320.401Z.log\n./.ard/184/logs/worker-engineer-20261123T142451.747Z.log\n./.ard/184/plan.md\n./.ard/184/worker-engineer.md\n./.ard/178/logs/triage-engineer-20261124T122948.480Z.log\n./.ard/178/plan.md\n178\n33:\t\tcase \"scanners\", \"triage\", \"workers\", \"reviewers\", \"merger\":\n53:\t\tcase \"protected_paths\":\n86:\t\tcase \"mode\":\n88:\t\tcase \"label\":\n109:\t\tcase \"inactive_for\":\n111:\t\tcase \"suppress_for\":\n144:\t\t\tcase \"enabled\":\n146:\t\t\tcase \"path\":\n148:\t\t\tcase \"block