{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TzFbE9yTro57WpR12fuHjD","type":"tool_result","content":"VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)\nLDFLAGS := -s -w -X main.version=$(VERSION)\n\n.PHONY: build test lint fmt clean cve-fixtures lint-scanner-fixtures chart-test image-test\n\nbuild:\n\tCGO_ENABLED=0 go build -ldflags \"$(LDFLAGS)\" -o bin/ard ./cmd/ard\n\ntest:\n\tgo test ./...\n\nlint:\n\tgo vet ./...\n\t@out=\"$$(gofmt -l .)\"; if [ -n \"$$out\" ]; then echo \"gofmt needed:\"; echo \"$$out\"; exit 1; fi\n\nfmt:\n\tgofmt -w .\n\n# Renders the two Argo CD charts under deploy/ and checks them (needs helm and yq;\n# run by the ard-ci pipeline, not part of `make test`).\nchart-test:\n\tdeploy/test-charts.sh\n\n# Builds the ard image for both platforms and checks it (needs Docker buildx and\n# network; not part of `make test`).\nimage-test:\n\tdeploy/test-image.sh\n\n# Regenerates the real cve scanner fixtures inside the pinned tool image.\n# Needs Docker and network; not part of `make test`.\ncve-fixtures:\n\tdocker build -t ard-cve-fixtures internal/roles/scanners/cve\n\tdocker run --rm --user \"$$(id -u):$$(id -g)\" -e HOME=/tmp \\\n\t  -v \"$$PWD/internal/roles:/roles\" -w /roles ard-cve-fixtures sh testdata/cve/regen.sh\n\n# Regenerates the real lint scanner fixtures in the pinned image (see\n# internal/roles/testdata/lint/regen.sh). Needs Docker; not part of `make test`.\nlint-scanner-fixtures:\n\tdocker build -t ard-lint-fixtures internal/roles/scanners/lint\n\tdocker run --rm --user \"$$(id -u):$$(id -g)\" -e HOME=/tmp \\\n\t  -v \"$$PWD/internal/roles:/roles\" -w /roles ard-lint-fixtures sh testdata/lint/regen.sh\n\nclean:\n\trm -rf bin\n# Build output\n/bin/\n/dist/\n\n# Test and coverage output\n*.test\n*.out\ncoverage.*\n\n# Local ard state and scratch\n*.db\n*.db-journal\n.ard-local/\n\n# Editors and OS\n.idea/\ndocs:\nTODO.md\nlayout.md\nproposal.md\nrunbooks\n\ndocs/runbooks:\ngate-2.md\n\ninternal:\nagent\nagentjob\nbotcheck\nbudget\ncli\ncloseout\ncommitter\nconfig\nconfigcmd\nconfigsrc\ncontroller\ncostblock\ncosts\neffects\nexecutor\ngithub\ngitref\ngitx\ninitcmd\nintake\njanitor\nlabels\nlimits\nmerger\nmodelauth\npool\nprgate\nreaper\nredact\nrepopath\nreviewer\nreviewfix\nroles\nscanner\nservecmd\nstate\ntriage\nworker\nwtlock\n\ninternal/cli:\napp.go\ncli_test.go\ncmd_config.go\ncmd_init.go\ncmd_labels.go\ncmd_rebuild.go\ncmd_serve.go\ncmd_version.go\nlog.go\nlog_test.go\nroot.go\nrun.go\n\ninternal/config:\nafter.go\nafter_test.go\nbudget_test.go\ndefaults.go\ndiscover.go\nduration.go\nduration_test.go\nerrors.go\nload.go\nload_test.go\nprotected.go\nprotected_test.go\nraw.go\nrender.go\nrender_test.go\nroot.go\nselect.go\nsource.go\nsource_test.go\ntestdata\ntypes.go\nwhen_test.go\npackage config\n\nimport (\n\t\"fmt\"\n\t\"io/fs\"\n\t\"strings\"\n\n\t\"gopkg.in/yaml.v3\"\n)\n\n// This file holds the YAML-facing structs. Every mapping is walked key by\n// key (instead of a plain struct decode) so that an error can name the\n// exact file and key that produced it; decoding individual values still\n// goes through yaml.Node.Decode, so anchors and scalars behave normally.\n\n// rawConfig is .ard/config.yaml before defaults and merging.\ntype rawConfig struct {\n\tmaxPods                *int\n\texecutor               *string\n\tagent                  *string\n\trequireApproval        *bool\n\tbudgetUSDPerDay        *float64\n\tmaxBudgetUSD           *float64\n\tglobalMaxOpen          *int\n\tpaused                 *bool\n\tintervals              rawIntervals\n\tintake                 rawIntake\n\tprotectedPaths         []string // merge.protected_paths\n\thaveMerge              bool\n\tstale                  rawStale\n\thaveStale              bool\n\tgitleaksEnabled        *bool // redact.gitleaks.enabled\n\tgitleaksPath           *string\n\tgitleaksBlockAutoclose *bool // redact.gitleaks.block_autoclose_when_missing\n\tsidecars               map[string]rawSidecar\n\toverrides              []rawOverrideRef\n}\n\n// rawIntervals keeps every interval optional so defaults can tell \"unset\"\n// apart from an explicit value.\ntype rawIntervals struct {\n\tscanners, triage, workers, reviewers, merger *Duration\n}\n\n// rawIntake keeps both keys optional so defaults can tell \"unset\" apart\n// from an explicit value (an explicit empty label is an error).\ntype rawIntake struct {\n\tmode, label *string\n}\n\ntype rawStale struct {\n\tinactiveFor, suppressFor *Duration\n}\n\ntype rawSidecar struct {\n\trepo *string\n\tref  *string\n}\n\n// rawOverrideRef is one overrides entry kept as its YAML node; entries are\n// validated and merged once the role directories are known.\ntype rawOverrideRef struct {\n\tkey   string // \"scanners/cve\"\n\tvalue *yaml.Node\n}\n\n// parseConfigFile reads cfgPath from fsys and parses it. A missing file is\n// not an error: it yields a zero rawConfig and every default applies.\nfunc parseConfigFile(fsys fs.FS, cfgPath string) (rawConfig, Errors) {\n\tvar raw rawConfig\n\tdata, err := fs.ReadFile(fsys, cfgPath)\n\tif err != nil {\n\t\treturn raw, nil // no config file: defaults only\n\t}\n\tvar doc yaml.Node\n\tif err := yaml.Unmarshal(data, &doc); err != nil {\n\t\treturn raw, Errors{{File: cfgPath, Msg: fmt.Sprintf(\"invalid YAML: %v\", err)}}\n\t}\n\treturn parseConfigDoc(&doc, cfgPath)\n}\n\n// parseConfigDoc walks the top-level mapping of the config document.\nfunc parseConfigDoc(doc *yaml.Node, cfgPath string) (rawConfig, Errors) {\n\tvar raw rawConfig\n\tvar errs Errors\n\tif doc.Kind == yaml.DocumentNode {\n\t\tdoc = doc.Content[0]\n\t}\n\tif doc.Tag == \"!!null\" {\n\t\treturn raw, nil // empty file\n\t}\n\tif doc.Kind != yaml.MappingNode {\n\t\treturn raw, Errors{{File: cfgPath, Msg: \"top level must be a mapping of config keys\"}}\n\t}\n\tseen := map[string]bool{}\n\tfor i := 0; i < len(doc.Content); i += 2 {\n\t\tkey, value := doc.Content[i], doc.Content[i+1]\n\t\tname := key.Value\n\t\tif seen[name] {\n\t\t\terrs = append(errs, &Error{File: cfgPath, Key: name, Msg: \"duplicate key\"})\n\t\t\tcontinue\n\t\t}\n\t\tseen[name] = true\n\t\tswitch name {\n\t\tcase \"max_pods\":\n\t\t\terrs = append(errs, decodeValue(value, cfgPath, name, &raw.maxPods)...)\n\t\tcase \"executor\":\n\t\t\terrs = append(errs, decodeValue(value, cfgPath, name, &raw.executor)...)\n\t\tcase \"agent\":\n\t\t\terrs = append(errs, decodeValue(value, cfgPath, name, &raw.agent)...)\n\t\tcase \"require_approval\":\n\t\t\terrs = append(errs, decodeValue(value, cfgPath, name, &raw.requireApproval)...)\n\t\tcase \"budget_usd_per_day\":\n\t\t\terrs = append(errs, decodeValue(value, cfgPath, name, &raw.budgetUSDPerDay)...)\n\t\tcase \"max_budget_usd\":\n\t\t\terrs = append(errs, decodeValue(value, cfgPath, name, &raw.maxBudgetUSD)...)\n\t\tcase \"global_max_open\":\n\t\t\terrs = append(errs, decodeValue(value, cfgPath, name, &raw.globalMaxOpen)...)\n\t\tcase \"paused\":\n\t\t\terrs = append(errs, decodeValue(value, cfgPath, name, &raw.paused)...)\n\t\tcase \"intervals\":\n\t\t\terrs = append(errs, raw.intervals.parse(value, cfgPath, \"intervals\")...)\n\t\tcase \"intake\":\n\t\t\terrs = append(errs, raw.parseIntake(value, cfgPath)...)\n\t\tcase \"merge\":\n\t\t\terrs = append(errs, raw.parseMerge(value, cfgPath)...)\n\t\tcase \"stale\":\n\t\t\terrs = append(errs, raw.parseStale(value, cfgPath)...)\n\t\tcase \"redact\":\n\t\t\terrs = append(errs, raw.parseRedact(value, cfgPath)...)\n\t\tcase \"sidecars\":\n\t\t\terrs = append(errs, raw.parseSidecars(value, cfgPath)...)\n\t\tcase \"overrides\":\n\t\t\terrs = append(errs, raw.parseOverrides(value, cfgPath)...)\n\t\tdefault:\n\t\t\terrs = append(errs, &Error{File: cfgPath, Key: name, Msg: \"unknown key\"})\n\t\t}\n\t}\n\treturn raw, errs\n}\n\n// decodeValue decodes one YAML value into target, naming the key on a type\n// error. A null value leaves target untouched.\nfunc decodeValue(value *yaml.Node, file, key string, target any) Errors {\n\tif value.Tag == \"!!null\" {\n\t\treturn nil\n\t}\n\tif err := value.Decode(target); err != nil {\n\t\treturn Errors{{File: file, Key: key, Msg: err.Error()}}\n\t}\n22:\tRepo            string                 `yaml:\"repo\"`\n23:\tSHA             string                 `yaml:\"sha,omitempty\"`\n24:\tMaxPods         int                    `yaml:\"max_pods\"`\n25:\tExecutor        string                 `yaml:\"executor\"`\n26:\tAgent           string                 `yaml:\"agent\"`\n27:\tRequireApproval bool                   `yaml:\"require_approval\"`\n28:\tBudgetUSDPerDay float64                `yaml:\"budget_usd_per_day\"`\n29:\tMaxBudgetUSD    float64                `yaml:\"max_budget_usd\"`\n30:\tGlobalMaxOpen   int                    `yaml:\"global_max_open\"`\n31:\tPaused          bool                   `yaml:\"paused\"`\n32:\tIntervals       intervalsYAML          `yaml:\"intervals\"`\n33:\tIntake          intakeYAML             `yaml:\"intake\"`\n34:\tProtectedPaths  []string               `yaml:\"protected_paths,omitempty\"`\n35:\tStale           staleYAML              `yaml:\"stale\"`\n36:\tRedact          redactYAML             `yaml:\"redact\"`\n37:\tSidecars        map[string]sidecarYAML `yaml:\"sidecars,omitempty\"`\n38:\tRoles           []roleYAML             `yaml:\"roles,omitempty\"`\n42:\tScanners  Duration `yaml:\"scanners\"`\n43:\tTriage    Duration `yaml:\"triage\"`\n44:\tWorkers   Duration `yaml:\"workers\"`\n45:\tReviewers Duration `yaml:\"reviewers\"`\n46:\tMerger    Duration `yaml:\"merger\"`\n50:\tMode  IntakeMode `yaml:\"mode\"`\n51:\tLabel string     `yaml:\"label,omitempty\"`\n55:\tInactiveFor Duration `yaml:\"inactive_for\"`\n56:\tSuppressFor Duration `yaml:\"suppress_for\"`\n60:\tGitleaks gitleaksYAML `yaml:\"gitleaks\"`\n64:\tEnabled bool   `yaml:\"enabled\"`\n65:\tPath    string `yaml:\"path\"`\n67:\tBlockAutocloseWhenMissing bool `yaml:\"block_autoclose_when_missing\"`\n71:\tRepo string `yaml:\"repo\"`