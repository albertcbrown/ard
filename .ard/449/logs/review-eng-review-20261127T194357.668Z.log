lation,omitempty\"`\n154\t+\tReadOnlyRootFilesystem   *bool            `json:\"readOnlyRootFilesystem,omitempty\"`\n155\t+\tCapabilities             *Capabilities    `json:\"capabilities,omitempty\"`\n156\t+\tSeccompProfile           *SeccompProfile  `json:\"seccompProfile,omitempty\"`\n157\t+\tAppArmorProfile          *AppArmorProfile `json:\"appArmorProfile,omitempty\"`\n158\t+}\n159\t+\n160\t+// AppArmorProfile selects an AppArmor profile type.\n161\t+type AppArmorProfile struct {\n162\t+\tType string `json:\"type\"`\n163\t }\n164\t \n165\t // PodSecurityContext is the pod-level security context.\n166\tdiff --git a/internal/executor/kube/kube.go b/internal/executor/kube/kube.go\n167\tindex 0c96246..f0b2fff 100644\n168\t--- a/internal/executor/kube/kube.go\n169\t+++ b/internal/executor/kube/kube.go\n170\t@@ -50,8 +50,13 @@ type Options struct {\n171\t \tPolicy                 executor.EnvPolicy\n172\t \tConfigDirEnv           string // env name whose Fixed value must be the pod config dir\n173\t \tHTTP                   *http.Client\n174\t-\tNow                    func() time.Time\n175\t-\tLog                    *slog.Logger\n176\t+\t// RoleImages turns on in-cluster role image builds; nil keeps role\n177\t+\t// Dockerfiles ignored (the job runs on AgentImage). RoleTree reads the\n178\t+\t// role directory from the controller clone (default: git).\n179\t+\tRoleImages *RoleImages\n180\t+\tRoleTree   RoleTree\n181\t+\tNow        func() time.Time\n182\t+\tLog        *slog.Logger\n183\t \n184\t \t// Poll is the watcher interval (default 2s); PendingTimeout is how long a\n185\t \t// pod may stay unscheduled (default 5m). Tests shorten both.\n186\t@@ -78,6 +83,8 @@ type Executor struct {\n187\t \to    Options\n188\t \tmu   sync.Mutex\n189\t \tlive map[string]*liveJob\n190\t+\t// builds is the single-flight map of role image builds, by repo and tag.\n191\t+\tbuilds map[string]*buildCall\n192\t }\n193\t \n194\t var _ executor.Executor = (*Executor)(nil)\n195\t@@ -120,7 +127,33 @@ func New(o Options) (*Executor, error) {\n196\t \tif o.Log == nil {\n197\t \t\to.Log = slog.Default()\n198\t \t}\n199\t-\treturn &Executor{o: o, live: map[string]*liveJob{}}, nil\n200\t+\tif o.RoleImages != nil {\n201\t+\t\tri := *o.RoleImages\n202\t+\t\tif ri.Namespace == \"\" || ri.BuilderImage == \"\" || ri.Repository == \"\" || ri.PushSecret == \"\" || ri.BuilderUID <= 0 {\n203\t+\t\t\treturn nil, errors.New(\"kube: RoleImages needs Namespace, BuilderImage, BuilderUID, Repository and PushSecret\")\n204\t+\t\t}\n205\t+\t\tif err := executor.CheckImageRef(ri.BuilderImage); err != nil {\n206\t+\t\t\treturn nil, err\n207\t+\t\t}\n208\t+\t\tif !strings.Contains(ri.Repository, \"/\") {\n209\t+\t\t\treturn nil, errors.New(\"kube: RoleImages.Repository must be <registry>/<path>\")\n210\t+\t\t}\n211\t+\t\tri.Repository = strings.TrimSuffix(ri.Repository, \"/\")\n212\t+\t\tif ri.AgentBase == \"\" {\n213\t+\t\t\tri.AgentBase = DefaultAgentBase\n214\t+\t\t}\n215\t+\t\tif ri.Budget <= 0 {\n216\t+\t\t\tri.Budget = 15 * time.Minute\n217\t+\t\t}\n218\t+\t\tif ri.MaxContext <= 0 {\n219\t+\t\t\tri.MaxContext = 512 << 10\n220\t+\t\t}\n221\t+\t\to.RoleImages = &ri\n222\t+\t\tif o.RoleTree == nil {\n223\t+\t\t\to.RoleTree = ExecTree(\"\")\n224\t+\t\t}\n225\t+\t}\n226\t+\treturn &Executor{o: o, live: map[string]*liveJob{}, builds: map[string]*buildCall{}}, nil\n227\t }\n228\t \n229\t func (e *Executor) get(id string) *liveJob {\n230\t@@ -137,14 +170,25 @@ func (e *Executor) Prepare(ctx context.Context, j executor.Job) (executor.Handle\n231\t \tif j.RoleSource.SHA == \"\" || j.RoleSource.Path == \"\" {\n232\t \t\treturn executor.Handle{}, fmt.Errorf(\"%w: no role source (a config without a commit cannot run on Kubernetes)\", executor.ErrInvalidJob)\n233\t \t}\n234\t+\timage := e.o.AgentImage\n235\t+\tif j.Dockerfile != \"\" {\n236\t+\t\tif e.o.RoleImages == nil {\n237\t+\t\t\te.o.Log.Info(\"kube.dockerfile_ignored\", \"job\", j.ID, \"dockerfile\", j.Dockerfile)\n238\t+\t\t} e