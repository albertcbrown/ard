 := func() { e.o.Tokens.RevokeToken(context.WithoutCancel(ctx), tok.Value) }\n\tkey, err := jobpod.NewKey()\n\tif err != nil {\n\t\trevoke()\n\t\treturn h, err\n\t}\n\tpod := buildPod(h, c, e.o)\n\tcreated, err := e.o.Client.CreatePod(ctx, e.o.Namespace, pod)\n\tif err != nil {\n\t\trevoke()\n\t\treturn h, fmt.Errorf(\"create pod: %w\", err)\n\t}\n\tsec, err := buildSecret(h, c, lj.manifest, tok.Value, key, created.Meta.UID)\n\tif err == nil {\n\t\terr = e.o.Client.CreateSecret(ctx, e.o.Namespace, sec)\n\t}\n\tif err != nil {\n\t\te.o.Client.DeletePod(context.WithoutCancel(ctx), e.o.Namespace, pod.Meta.Name, 0)\n\t\trevoke()\n\t\treturn h, fmt.Errorf(\"create secret: %w\", err)\n\t}\n\twctx, stop := context.WithCancel(context.Background())\n\te.mu.Lock()\n\tlj.started, lj.uid, lj.key, lj.token, lj.stop = true, created.Meta.UID, key, tok.Value, stop\n\tlj.wg.Add(2)\n\te.mu.Unlock()\n\tgo func() {\n\t\tdefer lj.wg.Done()\n\t\te.watch(wctx, h, lj)\n\t}()\n\tgo func() {\n\t\tdefer lj.wg.Done()\n\t\te.followLogs(wctx, h, lj)\n\t}()\n\treturn h, nil\n}\n\nfunc githubRepos(repo string, h executor.Handle) ([]github.Repo, error) {\n\tvar out []github.Repo\n\tfor _, r := range []string{repo, h.Sidecar.Repo} {\n\t\tif r == \"\" {\n\t\t\tcontinue\n\t\t}\n}\n\nfunc (l *Local) docker(ctx context.Context, args ...string) ([]byte, error) {\n\tc := exec.CommandContext(ctx, l.dockerBin, args...)\n\tc.Env = os.Environ()\n\treturn c.CombinedOutput()\n}\n\n// ensureImage builds the role image unless the tag already exists. Build\n// output is appended to logPath.\nfunc (l *Local) ensureImage(ctx context.Context, j executor.Job, logPath string) (string, error) {\n\ttag, err := imageTag(j.Stage, j.Role, j.RoleDir)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"hash role dir: %w\", err)\n\t}\n\tif _, err := l.docker(ctx, \"image\", \"inspect\", tag); err == nil {\n\t\treturn tag, nil\n\t}\n\tbctx, cancel := context.WithTimeout(ctx, l.buildTimeout)\n\tdefer cancel()\n\tout, err := l.dock