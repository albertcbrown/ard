78\tdiff --git a/internal/executor/kube/roleimage.go b/internal/executor/kube/roleimage.go\n279\tnew file mode 100644\n280\tindex 0000000..b5cc5e4\n281\t--- /dev/null\n282\t+++ b/internal/executor/kube/roleimage.go\n283\t@@ -0,0 +1,471 @@\n284\t+package kube\n285\t+\n286\t+import (\n287\t+\t\"bufio\"\n288\t+\t\"bytes\"\n289\t+\t\"context\"\n290\t+\t\"crypto/sha256\"\n291\t+\t\"encoding/hex\"\n292\t+\t\"encoding/json\"\n293\t+\t\"errors\"\n294\t+\t\"fmt\"\n295\t+\t\"io\"\n296\t+\t\"net/http\"\n297\t+\t\"net/url\"\n298\t+\t\"os/exec\"\n299\t+\t\"regexp\"\n300\t+\t\"sort\"\n301\t+\t\"strconv\"\n302\t+\t\"strings\"\n303\t+\t\"time\"\n304\t+\n305\t+\t\"github.com/albertcbrown/ard/internal/executor\"\n306\t+\t\"github.com/albertcbrown/ard/internal/executor/kube/api\"\n307\t+\t\"github.com/albertcbrown/ard/internal/redact\"\n308\t+)\n309\t+\n310\t+// ErrRoleImageBuild wraps every failure to produce a role image.\n311\t+var ErrRoleImageBuild = errors.New(\"role image build failed\")\n312\t+\n313\t+// DefaultAgentBase is the agent image a role Dockerfile builds on in the cluster.\n314\t+const DefaultAgentBase = \"ghcr.io/albertcbrown/ard/agent:latest\"\n315\t+\n316\t+// RoleImages turns on in-cluster role image builds (#245, #449). The builder\n317\t+// pod shape is enforced by the chart's admission policy (#448).\n318\t+type RoleImages struct {\n319\t+\tNamespace    string // build namespace\n320\t+\tBuilderImage string // pinned by digest; the admission policy admits exactly this\n321\t+\tBuilderUID   int64\n322\t+\tRepository   string // e.g. ghcr.io/owner/ard; images are <Repository>/<type>-<name>\n323\t+\tPushSecret   string // name of the dockerconfigjson Secret in Namespace\n324\t+\tAgentBase    string // default DefaultAgentBase\n325\t+\tBudget       time.Duration\n326\t+\t// Registry overrides the registry base URL (default https://<host of Repository>).\n327\t+\tRegistry   string\n328\t+\tMaxContext int64 // default 512 KiB\n329\t+}\n330\t+\n331\t+// TreeEntry is one file of a role directory at a commit.\n332\t+type TreeEntry struct{ Mode, Blob, Path string }\n333\t+\n334\t+// RoleTree reads a role directory from the controller's clone at a commit. It\n335\t+// never reads a worktree.\n336\t+type RoleTree interface {\n337\t+\tLsTree(ctx context.Context, repo, sha, path string) ([]TreeEntry, error)\n338\t+\t// Archive returns the directory as a tar stream; more than max bytes is an error.\n339\t+\tArchive(ctx context.Context, repo, sha, path string, max int64) ([]byte, error)\n340\t+}\n341\t+\n342\t+// ExecTree is the RoleTree that runs git. bin \"\" means \"git\".\n343\t+func ExecTree(bin string) RoleTree {\n344\t+\tif bin == \"\" {\n345\t+\t\tbin = \"git\"\n346\t+\t}\n347\t+\treturn execTree{bin}\n348\t+}\n349\t+\n350\t+type execTree struct{ bin string }\n351\t+\n352\t+func (g execTree) run(ctx context.Context, repo string, max int64, args ...string) ([]byte, error) {\n353\t+\tc := exec.CommandContext(ctx, g.bin, append([]string{\"-C\", repo}, args...)...)\n354\t+\tc.Env = []string{\"GIT_CONFIG_NOSYSTEM=1\", \"GIT_CONFIG_GLOBAL=/dev/null\", \"GIT_TERMINAL_PROMPT=0\", \"LC_ALL=C\"}\n355\t+\tvar out, errb bytes.Buffer\n356\t+\tc.Stdout, c.Stderr = &limitWriter{w: &out, max: max}, &errb\n357\t+\tif err := c.Run(); err != nil {\n358\t+\t\tif errors.Is(err, errTooBig) {\n359\t+\t\t\treturn nil, errTooBig\n360\t+\t\t}\n361\t+\t\treturn nil, fmt.Errorf(\"git %s: %w: %s\", args[0], err, strings.TrimSpace(errb.String()))\n362\t+\t}\n363\t+\treturn out.Bytes(), nil\n364\t+}\n365\t+\n366\t+var errTooBig = errors.New(\"role directory is larger than the build context limit\")\n367\t+\n368\t+type limitWriter struct {\n369\t+\tw   io.Writer\n370\t+\tmax int64\n371\t+\tn   int64\n372\t+}\n373\t+\n374\t+func (l *limitWriter) Write(p []byte) (int, error) {\n375\t+\tl.n += int64(len(p))\n376\t+\tif l.max > 0 && l.n > l.max {\n377\t+\t\treturn 0, errTooBig\n378\t+\t}\n379\t+\treturn l.w.Write(p)\n380\t+}\n381\t+\n382\t+func (g execTree) LsTree(ctx context.Context, repo, sha, path string) ([]TreeEntry, error) {\n383\t+\tb, err := g.run(ctx, repo, 8<<20, \"ls-tree\", \"-r\", \"-z\", sha, \"--\", path)\n384\t+\tif err != nil {\n385\t+\t\treturn nil, err\n386\t+\t}\n387\t+\tvar out []TreeEntry\n388\t+\tfor _, rec := range strings.Split(string(b), \"\\x00\") {\n389\t+\t\tif rec == \"\" {\n390\t+\t\t\tcontinue\n391\t+\t\t}\n392\t+\t\tmeta, p, ok := strings.Cut(rec, \"\\t\")\n393\t+\t\tf := strings.Fields(meta)\n394\t+\t\tif !ok || len(f) != 3 {\n395\t+\t\t\treturn nil, fmt.Errorf(\"git ls-tree: unexpected record %q\", rec)\n396\t+\t\t}\n397\t+\t\trel := strings.TrimPrefix(p, strings.TrimSuffix(path, \"/\")+\"/\")\n398\t+\t\tout = append(out, TreeEntry{Mode: f[0], Blob: f[2], Path: rel})\n399\t+\t}\n400\t+\treturn out, nil\n401\t+}\n402\t+\n403\t+func (g execTree) Archive(ctx context.Context, repo, sha, path string, max int64) ([]byte, error) {\n404\t+\treturn g.run(ctx, repo, max, \"archive\", \"--format=tar\", sha+\":\"+path)\n405\t+}\n406\t+\n407\t+var segRE = regexp.MustCompile(`^[a-z0-9][a-z0-9-]*$`)\n408\t+\n409\t+var roleTypes = map[string]bool{\"scanners\": true, \"triage\": true, \"workers\": true, \"reviewers\": true}\n410\t+\n411\t+// roleName maps the role path .ard/<type>/<name> to \"<type>-<name>\".\n412\t+func roleName(path string) (string, error) {\n413\t+\tp := strings.Split(path, \"/\")\n414\t+\tif len(p) != 3 || p[0] != \".ard\" || !roleTypes[p[1]] || !segRE.MatchString(p[2]) {\n415\t+\t\treturn \"\", fmt.Errorf(\"%w: role path %q is not .ard/<type>/<name>\", executor.ErrInvalidJob, path)\n416\t+\t}\n417\t+\treturn p[1] + \"-\" + p[2], nil\n418\t+}\n419\t+\n420\t+// roleTag is the content tag: a hash of the sorted tree entries and the base.\n421\t+func roleTag(entries []TreeEntry, base string) string {\n422\t+\tlines := make([]string, 0, len(entries))\n423\t+\tfor _, e := range entries {\n424\t+\t\tlines = append(lines, e.Mode+\" \"+e.Path+\" \"+e.Blob+\"\\n\")\n425\t+\t}\n426\t+\tsort.Strings