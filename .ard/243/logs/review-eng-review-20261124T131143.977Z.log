ential helper (jobs get no credential), no AGPL tools\n+# (#217), no security tools (those belong in role images, #205).\n+#\n+# CLAUDE_VERSION is claude.TestedVersion (internal/agent/claude/adapter.go).\n+# A bump must change the version and both checksums in the same PR;\n+# TestAgentImagePins enforces it. Checksums are from the vendor's release\n+# manifest (https://downloads.claude.ai/claude-code-releases/<version>/manifest.json),\n+# captured 2026-11-24 and checked against the downloaded binaries.\n+#\n+# The base is trixie, not bookworm: git 2.39 breaks the committer's fetches (#163).\n+\n+FROM debian:trixie-slim\n+\n+ARG CLAUDE_VERSION=2.1.330\n+ARG CLAUDE_SHA256_AMD64=f390eaa0814e6a1bff74cbb47acb74cb9c89d30ced809fe0af5af00c7bfe8ebb\n+ARG CLAUDE_SHA256_ARM64=6016f90cac783e367fb1aa97c768a2efb94a0128a5b46b70fb3d8fcbbd9dd444\n+\n+RUN apt-get update && \\\n+    apt-get install -y --no-install-recommends \\\n+      ca-certificates curl git jq make shellcheck yamllint && \\\n+    rm -rf /var/lib/apt/lists/*\n+\n+RUN set -eu; \\\n+    arch=\"$(dpkg --print-architecture)\"; \\\n+    case \"$arch\" in \\\n+      amd64) platform=linux-x64; sha=\"$CLAUDE_SHA256_AMD64\" ;; \\\n+      arm64) platform=linux-arm64; sha=\"$CLAUDE_SHA256_ARM64\" ;; \\\n+      *) echo \"unsupported architecture: $arch\" >&2; exit 1 ;; \\\n+    esac; \\\n+    curl -fsSL -o /usr/local/bin/claude \\\n+      \"https://downloads.claude.ai/claude-code-releases/${CLAUDE_VERSION}/${platform}/claude\"; \\\n+    echo \"${sha}  /usr/local/bin/claude\" | sha256sum -c -; \\\n+    chmod 0755 /usr/local/bin/claude\n+\n+RUN useradd --create-home --uid 65532 --user-group agent\n+USER 65532:65532\n+WORKDIR /home/agent\n+ENV HOME=/home/agent\n+LABEL org.opencontainers.image.title=\"ard-agent\" \\\n+      org.opencontainers.image.version=\"${CLAUDE_VERSION}\"\ndiff --git a/deploy/test-agent-image.sh b/deploy/test-agent-image.sh\nnew file mode 100755\nindex 0000000..3ce3fe8\n--- /dev/null\n+++ b/deploy/test-agent-image.sh\n@@ -0,0 +1,35 @@\n+#!/usr/bin/env bash\n+# Checks the locally built ard-agent image (make agent-image): claude at the\n+# pinned version, git and the linters present, gh absent, not running as root.\n+# Usage: deploy/test-agent-image.sh [image]   (default ard-agent:dev)\n+# Needs Docker. Prints PASS:/FAIL: per case. Exit 0 ok, 1 a case failed, 2 tooling.\n+set -uo pipefail\n+\n+IMAGE=\"${1:-ard-agent:dev}\"\n+ROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\n+command -v docker >/dev/null 2>&1 || { echo \"ERROR: docker is required\" >&2; exit 2; }\n+docker image inspect \"$IMAGE\" >/dev/null 2>&1 || { echo \"ERROR: image $IMAGE not found; run make agent-image\" >&2; exit 2; }\n+\n+failed=0\n+pass() { echo \"PASS: $1\"; }\n+fail() { echo \"FAIL: $1\"; failed=1; }\n+run() { docker run --rm --entrypoint \"\" \"$IMAGE\" \"$@\"; }\n+\n+want=\"$(sed -n 's/^const TestedVersion = \"\\(.*\\)\"/\\1/p' \"$ROOT/internal/agent/claude/adapter.go\")\"\n+[ -n \"$want\" ] || { echo \"ERROR: cannot read claude.TestedVersion\" >&2; exit 2; }\n+\n+out=\"$(run claude --version 2>&1)\"\n+case \"$out\" in\n+  *\"$want\"*) pass \"claude --version reports $want\" ;;\n+  *) fail \"claude --version: want $want, got: $out\" ;;\n+esac\n+\n+for tool in git jq shellcheck yamllint make curl; do\n+  if run sh -c \"command -v $tool\" >/dev/null 2>&1; then pass \"$tool is on PATH\"; else fail \"$tool is missing\"; fi\n+done\n+\n+if run sh -c 'command -v gh' >/dev/null 2>&1; then fail \"gh is on PATH\"; else pass \"gh is not on PATH\"; fi\n+\n+if [ \"$(run id -u)\" != 0 ]; then pass \"runs as a non-root user\"; else fail \"runs as root\"; fi\n+\n+exit \"$failed\"\ndiff --git a/docs/proposal.md b/docs/proposal.md\nindex cec8c5c..f242c3a 100644\n--- a/docs/proposal.md\n+++ b/docs/proposal.md\n@@ -427,7 +427,7 @@ Configuration is by convention: a role exists because its directory exists, and\n ```\n \n - A directory with `prompt.txt` is an agent role; a scanner directory with an executable `scan` is a deterministic scanner.\n-- A `Dockerfile` builds the role's image; without one the local executor runs a host subprocess and the Kubernetes executor uses the default `ard-agent` image (agent CLIs, git, common linters). A role that reads untrusted input without one triggers the host-mode warning (see Executors and the Reaper).\n+- A `Dockerfile` builds the role's image; without one the local executor runs a host subprocess and the Kubernetes executor uses the default `ard-agent` image (agent CLIs, git, common linters). A role Dockerfile should start `FROM` the local `ard-agent` image by digest or ID. A role that reads untrusted input without one triggers the host-mode warning (see Executors and the Reaper).\n - Any other file in the directory (scripts, allowlists) is mounted read-only beside the prompt.\n \n ```yaml\n@@ -522,6 +522,7 @@ How ard itself is built, published and deployed. Jenkins and Argo CD do the work\n \n - **Checks.** The Jenkins multibranch job `ard-ci` builds every same-repository branch and pull request, `worker/*` branches included, but never forks, with `make lint`, `make test`, `make build` and `make chart-test`. Its pipeline is loaded from the deployment repository, never from the branch, so branch code supplies only those targets and runs in a pod with no credential and no service account token. `main` requires both its status, `continuous-integration/jenkins/pr-merge`, and the Actions `test` job ([#219](https://github.com/albertcbrown/ard/issues/219)): Jenkins stops reporting to a PR it has seen close, so a PR that merged before Jenkins finished kept a `pending` status for good. A fork PR gets no Jenkins build, so a maintainer pushes it to a same-repository branch to merge it. `ci.yml` and `bot-commits.yml` stay as they are.\n - **Publish.** A green `main` build starts `ard-build`, whose Jenkinsfile is not in this repository, so nothing merged here can reach its credentials. It builds the `Dockerfile` for `linux/amd64` and `linux/arm64` (no emulation: every `RUN` cross-compiles or downloads on the build platform), signs the digest with cosign, and pushes `ghcr.io/albertcbrown/ard:sha-<7>` (never re-pushed) and `:main`.\n+- **Agent image.** The default `ard-agent` image (`deploy/agent/Dockerfile`: the `claude` CLI pinned to `claude.TestedVersion` with per-architecture checksums, git and common linters; no `gh`, no credential helper, no AGPL tools) is built locally with `make agent-image` as `ard-agent:dev` and checked with `make agent-image-test`. It is never published, to a public registry or to GHCR, and `ard-build` does not build it. `TestAgentImagePins` fails when the Dockerfile's version or checksums fall out of step with `TestedVersion`.\n - **Deploy.** A deploy job verifies the signature and the revision label, checks the new commit descends from the pinned one, and pins the digest and commit in the deployment repository. Argo CD renders this repository's `deploy/argocd` chart (the app of apps) with that pin and the site's values: one child Application per target repository, named `ard-<instance>`, reading `deploy/charts/ard-serve` at the pinned commit, so chart and image move together. The cluster admits no other Application from that chart.\n - **Release.** An annotated tag `vX.Y.Z` (`git tag -a`) builds that commit with `VERSION=vX.Y.Z`, pushes `:vX.Y.Z` and moves `:latest` when it is the highest version. Release tags are annotated because Jenkins builds only tags at most a day old and dates a lightweight tag by its commit, so a lightweight tag on an older commit never builds. Releases do not change what is deployed, which follows `main`.\n - **Kill switch in a cluster.** `kubectl -n <namespace> exec deploy/ard-<instance> -- touch /home/ard/.ard/pause/<owner>/<repo>` pauses `ard serve`; `rm` resumes.\ndiff --git a/internal/agent/claude/agentimage_test.go b/internal/agent/claude/agentimage_test.go\nnew file mode 100644\nindex 0000000..937a795\n--- /dev/null\n+++ b/internal/agent/claude/agentimage_test.go\n@@ -0,0 +1,46 @@\n+package claude\n+\n+import (\n+\t\"os\"\n+\t\"regexp\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+// TestAgentImagePins keeps the default ard-agent image's claude pin in step\n+// with TestedVersion.\n+func TestAgentImagePins(t *testing.T) {\n+\tb, err := os.ReadFile(\"../../../deploy/agent/Dockerfile\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tdf := string(b)\n+\targ := func(name string) string {\n+\t\tm := regexp.MustCompile(`(?m)^ARG ` + name + `=(\\S*)\\s*$`).FindStringSubmatch(df)\n+\t\tif m == nil {\n+\t\t\treturn \"\"\n+\t\t}\n+\t\treturn m[1]\n+\t}\n+\tconst hint = \"a TestedVersion bump must update the Dockerfile's version and checksums in the same PR\"\n+\tif got := arg(\"CLAUDE_VERSION\"); got != TestedVersion {\n+\t\tt.Errorf(\"deploy/agent/Dockerfile CLAUDE_VERSION = %q, want %q: %s\", got, TestedVersion, hint)\n+\t}\n+\thex64 := regexp.MustCompile(`^[0-9a-f]{64}$`)\n+\tfor _, name := range []string{\"CLAUDE_SHA256_AMD64\", \"CLAUDE_SHA256_ARM64\"} {\n+\t\tif !hex64.MatchString(arg(name)) {\n+\t\t\tt.Errorf(\"deploy/agent/Dockerfile %s = %q, want 64 lowercase hex digits: %s\", name, arg(name), hint)\n+\t\t}\n+\t}\n+\tfor n, line := range strings.Split(df, \"\\n\") {\n+\t\tl := strings.TrimSpace(line)\n+\t\tif strings.HasPrefix(l, \"#\") {\n+\t\t\tcontinue\n+\t\t}\n+\t\tlow := strings.ToLower(l)\n+\t\tif regexp.MustCompile(`\\bgh\\b`).MatchString(low) || strings.Contains(low, \"credential.helper\") ||\n+\t\t\tstrings.Contains(low, \"credential-helper\") || strings.Contains(low, \"git-credential\") {\n+\t\t\tt.Errorf(\"deploy/agent/Dockerfile line %d installs gh or a credential helper: %q\", n+1, l)\n+\t\t}\n+\t}\n+}\n","numLines":210,"startLine":1,"totalLines":210}},"tool_result_meta":[{"id":"toolu_01RWBLCAqmi4vmMeFJ721njD","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
