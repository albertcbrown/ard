t+\t}\n1129\t+\treturn nil\n1130\t+}\n1131\t+\n1132\t+// WriteKey writes the private key with mode 0600. The parent directory is\n1133\t+// created with 0700. An existing path is refused unless force is set.\n1134\t+func WriteKey(path string, pem []byte, force bool) error {\n1135\t+\tif err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {\n1136\t+\t\treturn fmt.Errorf(\"setup: create key directory: %w\", err)\n1137\t+\t}\n1138\t+\tif fi, err := os.Lstat(path); err == nil && fi.Mode()&os.ModeSymlink != 0 {\n1139\t+\t\treturn fmt.Errorf(\"setup: %s is a symlink; refusing to write the key through it\", path)\n1140\t+\t}\n1141\t+\tflags := os.O_WRONLY | os.O_CREATE | os.O_EXCL\n1142\t+\tif force {\n1143\t+\t\tflags = os.O_WRONLY | os.O_CREATE | os.O_TRUNC\n1144\t+\t}\n1145\t+\tf, err := os.OpenFile(path, flags, 0o600)\n1146\t+\tif err != nil {\n1147\t+\t\tif errors.Is(err, os.ErrExist) {\n1148\t+\t\t\treturn fmt.Errorf(\"setup: %s already exists; use --force to overwrite\", path)\n1149\t+\t\t}\n1150\t+\t\treturn fmt.Errorf(\"setup: write key file: %w\", err)\n1151\t+\t}\n1152\t+\tif err := f.Chmod(0o600); err != nil {\n1153\t+\t\tf.Close()\n1154\t+\t\treturn fmt.Errorf(\"setup: chmod key file: %w\", err)\n1155\t+\t}\n1156\t+\tif _, err := f.Write(pem); err != nil {\n1157\t+\t\tf.Close()\n1158\t+\t\treturn fmt.Errorf(\"setup: write key file: %w\", err)\n1159\t+\t}\n1160\t+\tif err := f.Close(); err != nil {\n1161\t+\t\treturn fmt.Errorf(\"setup: write key file: %w\", err)\n1162\t+\t}\n1163\t+\treturn nil\n1164\t+}\n1165\t+\n1166\t+// WriteKeyWithFallback writes the key to path. GitHub returns the private key\n1167\t+// only once, so when that write fails (for example the default file exists or\n1168\t+// the directory is unwritable) it falls back to a fresh <name>-<timestamp>.pem\n1169\t+// created with O_EXCL, first beside path, then under ~/.ard/keys, then in the\n1170\t+// temp directory. It returns the path actually used.\n1171\t+func WriteKeyWithFallback(path