-from-a-manifest.\n+type Manifest struct {\n+\tName               string            `json:\"name\"`\n+\tURL                string            `json:\"url\"`\n+\tRedirectURL        string            `json:\"redirect_url\"`\n+\tPublic             bool              `json:\"public\"`\n+\tDefaultEvents      []string          `json:\"default_events\"`\n+\tDefaultPermissions map[string]string `json:\"default_permissions\"`\n+}\n+\n+// manifestHomepage is the App's homepage URL; GitHub requires one.\n+const manifestHomepage = \"https://github.com/albertcbrown/ard\"\n+\n+// BuildManifest returns the manifest for the built-in permission set. It has\n+// no webhook and is private. It fails if a forbidden permission is present.\n+func BuildManifest(name, redirectURL string) (Manifest, error) {\n+\treturn buildManifest(AppPermissions, name, redirectURL)\n+}\n+\n+func buildManifest(perms map[string]string, name, redirectURL string) (Manifest, error) {\n+\tfor _, f := range ForbiddenPermissions {\n+\t\tif _, ok := perms[f]; ok {\n+\t\t\treturn Manifest{}, fmt.Errorf(\"setup: permission %q must never be requested\", f)\n+\t\t}\n+\t}\n+\tcp := make(map[string]string, len(perms))\n+\tfor k, v := range perms {\n+\t\tcp[k] = v\n+\t}\n+\treturn Manifest{\n+\t\tName:               name,\n+\t\tURL:                manifestHomepage,\n+\t\tRedirectURL:        redirectURL,\n+\t\tPublic:             false,\n+\t\tDefaultEvents:      []string{},\n+\t\tDefaultPermissions: cp,\n+\t}, nil\n+}\n+\n+// ManifestURL is where the manifest form is POSTed: the user's settings, or\n+// the organization's for an org-owned repository.\n+func ManifestURL(owner string, ownerIsOrg bool, state string) string {\n+\tbase := \"https://github.com/settings/apps/new\"\n+\tif ownerIsOrg {\n+\t\tbase = \"https://github.com/organizations/\" + url.PathEscape(owner) + \"/settings/apps/new\"\n+\t}\n+\treturn base + \"?state=\" + url.QueryEscape(state)\n+}\n+\n+// CheckPermissions compares granted repository permissions with the built-in\n+// definition. missing lists permissions that are absent or too weak; extra\n+// lists forbidden ones that are granted. Both are sorted.\n+func CheckPermissions(granted map[string]string) (missing, extra []string) {\n+\tfor k, want := range AppPermissions {\n+\t\tgot := granted[k]\n+\t\tif got == want || (want == \"read\" && got == \"write\") {\n+\t\t\tcontinue\n+\t\t}\n+\t\tmissing = append(missing, k)\n+\t}\n+\tfor _, f := range ForbiddenPermissions {\n+\t\tif _, ok := granted[f]; ok {\n+\t\t\textra = append(extra, f)\n+\t\t}\n+\t}\n+\tsort.Strings(missing)\n+\tsort.Strings(extra)\n+\treturn missing, extra\n+}\ndiff --git a/internal/setupcmd/callback.go b/internal/setupcmd/callback.go\nnew file mode 100644\nindex 0000000..47fe681\n--- /dev/null\n+++ b/internal/setupcmd/callback.go\n@@ -0,0 +1,91 @@\n+package setupcmd\n+\n+import (\n+\t\"context\"\n+\t\"crypto/rand\"\n+\t\"crypto/subtle\"\n+\t\"encoding/hex\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"html\"\n+\t\"net\"\n+\t\"net/http\"\n+\t\"time\"\n+)\n+\n+// DefaultCallbackTimeout bounds how long ard waits for the browser step.\n+const DefaultCallbackTimeout = 5 * time.Minute\n+\n+// newState returns a one-time random state value.\n+func newState() (string, error) {\n+\tb := make([]byte, 16)\n+\tif _, err := rand.Read(b); err != nil {\n+\t\treturn \"\", fmt.Errorf(\"setup: random state: %w\", err)\n+\t}\n+\treturn hex.EncodeToString(b), nil\n+}\n+\n+// formPage is the auto-submitting page that POSTs the manifest to GitHub.\n+func formPage(manifestJSON []byte, postURL string) string {\n+\treturn `<!doctype html><html><body><p>Redirecting to GitHub…</p>\n+<form id=\"f\" method=\"post\" action=\"` + html.EscapeString(postURL) + `\">\n+<input type=\"hidden\" name=\"manifest\" value=\"` + html.EscapeString(string(manifestJSON)) + `\">\n+<noscript><button type=\"submit\">Continue to GitHub</button></noscript>\n+</form><script>document.getElementById(\"f\").submit();</script></body></html>`\n+}\n+\n+// serveCallback listens on 127.0.0.1 (random port), serves the manifest form\n+// at \"/\" and waits for exactly one valid GET /callback carrying state. ready\n+// is called with the local URL once the listener is up. The server is shut\n+// down on return: after the code, on timeout, or on context cancel.\n+func serveCallback(ctx context.Context, render func(base string) (manifestJSON []byte, postURL string), state string, timeout time.Duration, ready func(localURL string)) (string, error) {\n+\tln, err := net.Listen(\"tcp\", \"127.0.0.1:0\")\n+\tif err != nil {\n+\t\treturn \"\", fmt.Errorf(\"setup: listen on loopback: %w\", err)\n+\t}\n+\tmanifestJSON, postURL := render(\"http://\" + ln.Addr().String())\n+\tpage := formPage(manifestJSON, postURL)\n+\tcodeCh := make(chan string, 1)\n+\tmux := http.NewServeMux()\n+\tmux.HandleFunc(\"GET /{$}\", func(w http.ResponseWriter, _ *http.Request) {\n+\t\tw.Header().Set(\"Content-Type\", \"text/html; charset=utf-8\")\n+\t\tw.Header().Set(\"Cache-Control\", \"no-store\")\n+\t\t_, _ = w.Write([]byte(page))\n+\t})\n+\tmux.HandleFunc(\"GET /callback\", func(w http.ResponseWriter, r *http.Request) {\n+\t\tq := r.URL.Query()\n+\t\tgot := q.Get(\"state\")\n+\t\tif subtle.ConstantTimeCompare([]byte(got), []byte(state)) != 1 || q.Get(\"code\") == \"\" {\n+\t\t\thttp.Error(w, \"invalid state or code\", http.StatusBadRequest)\n+\t\t\treturn\n+\t\t}\n+\t\tselect {\n+\t\tcase codeCh <- q.Get(\"code\"):\n+\t\t\t_, _ = w.Write([]byte(\"ard: GitHub App created. You can close this tab.\"))\n+\t\tdefault:\n+\t\t\thttp.Error(w, \"already used\", http.StatusGone)\n+\t\t}\n+\t})\n+\tsrv := &http.Server{Handler: mux, ReadHeaderTimeout: 10 * time.Second}\n+\tgo func() { _ = srv.Serve(ln) }()\n+\tdefer func() {\n+\t\tsctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)\n+\t\tdefer cancel()\n+\t\tif srv.Shutdown(sctx) != nil {\n+\t\t\t_ = srv.Close()\n+\t\t}\n+\t}()\n+\tif ready != nil {\n+\t\tready(\"http://\" + ln.Addr().String() + \"/\")\n+\t}\n+\ttimer := time.NewTimer(timeout)\n+\tdefer timer.Stop()\n+\tselect {\n+\tcase code := <-codeCh:\n+\t\treturn code, nil\n+\tcase <-timer.C:\n+\t\treturn \"\", errors.New(\"setup: timed out waiting for the GitHub confirmation\")\n+\tcase <-ctx.Done():\n+\t\treturn \"\", fmt.Errorf(\"setup: %w\", ctx.Err())\n+\t}\n+}\ndiff --git a/internal/setupcmd/cmd.go b/internal/setupcmd/cmd.go\nindex 29876f1..1e46ea3 100644\n--- a/internal/setupcmd/cmd.go\n+++ b/internal/setupcmd/cmd.go\n@@ -34,6 +34,14 @@ func Command(ctx context.Context, e *cli.Env, o cli.SetupOpts) error {\n \tif err != nil {\n \t\treturn err\n \t}\n+\tif o.CreateGHApp {\n+\t\tif err := CreateApp(ctx, e, repo, CreateAppOpts{Name: o.AppName, KeyPath: o.KeyFile, Force: o.Force}); err != nil {\n+\t\t\treturn err\n+\t\t}\n+\t\tif e.DryRun {\n+\t\t\treturn nil\n+\t\t}\n+\t}\n \tauth, err := github.AuthFromEnv(os.Getenv, os.ReadFile)\n \tif err != nil {\n \t\treturn fmt.Errorf(\"setup: %w\", err)\ndiff --git a/internal/setupcmd/convert.go b/internal/setupcmd/convert.go\nnew file mode 100644\nindex 0000000..314f25e\n--- /dev/null\n+++ b/internal/setupcmd/convert.go\n@@ -0,0 +1,73 @@\n+package setupcmd\n+\n+import (\n+\t\"context\"\n+\t\"encoding/json\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"io\"\n+\t\"log/slog\"\n+\t\"net/http\"\n+\t\"net/url\"\n+\t\"strings\"\n+)\n+\n+// Conversion is the result of exchanging a manifest code. Its private key\n+// and secrets are redacted from every formatting verb.\n+type Conversion struct {\n+\tID   int64\n+\tSlug string\n+\tPEM  string\n+}\n+\n+func (c Conversion) String() string {\n+\treturn fmt.Sprintf(\"Conversion{id=%d slug=%s pem=[redacted]}\", c.ID, c.Slug)\n+}\n+func (c Conversion) GoString() string { return c.String() }\n+\n+// Format makes %v, %+v, %#v and %s all print the redacted form.\n+func (c Conversion) Format(f fmt.State, _ rune) { _, _ = io.WriteString(f, c.String()) }\n+\n+// LogValue keeps slog from printing the key.\n+func (c Conversion) LogValue() slog.Value { return slog.StringValue(c.String()) }\n+\n+// Convert exchanges a manifest code for the App's credentials. The endpoint\n+// needs no authentication. Errors carry only the status and GitHub's\n+// message, never the response body.\n+func Convert(ctx context.Context, apiBase string, hc *http.Client, code string) (Conversion, error) {\n+\tif hc == nil {\n+\t\thc = http.DefaultClient\n+\t}\n+\tu := strings.TrimRight(apiBase, \"/\") + \"/app-manifests/\" + url.PathEscape(code) + \"/conversions\"\n+\treq, err := http.NewRequestWithContext(ctx, http.MethodPost, u, nil)\n+\tif err != nil {\n+\t\treturn Conversion{}, errors.New(\"setup: build conversion request\")\n+\t}\n+\treq.Header.Set(\"Accept\", \"application/vnd.github+json\")\n+\tresp, err := hc.Do(req)\n+\tif err != nil {\n+\t\treturn Conversion{}, errors.New(\"setup: manifest conversion request failed\")\n+\t}\n+\tdefer resp.Body.Close()\n+\tbody, _ := io.ReadAll(io.LimitReader(resp.Body, 1<<20))\n+\tif resp.StatusCode != http.StatusCreated && resp.StatusCode != http.StatusOK {\n+\t\tvar m struct {\n+\t\t\tMessage string `json:\"message\"`\n+\t\t}\n+\t\t_ = json.Unmarshal(body, &m)\n+\t\tmsg := \"\"\n+\t\tif m.Message != \"\" && !strings.Contains(m.Message, \"PRIVATE KEY\") {\n+\t\t\tmsg = \": \" + m.Message\n+\t\t}\n+\t\treturn Conversion{}, fmt.Errorf(\"setup: manifest conversion failed (HTTP %d)%s\", resp.StatusCode, msg)\n+\t}\n+\tvar out struct {\n+\t\tID   int64  `json:\"id\"`\n+\t\tSlug string `json:\"slug\"`\n+\t\tPEM  string `json:\"pem\"`\n+\t}\n+\tif err := json.Unmarshal(body, &out); err != nil || out.ID == 0 || out.Slug == \"\" || out.PEM == \"\" {\n+\t\treturn Conversion{}, errors.New(\"setup: manifest conversion returned an unexpected response\")\n+\t}\n+\treturn Conversion{ID: out.ID, Slug: out.Slug, PEM: out.PEM}, nil\n+}\ndiff --git a/internal/setupcmd/createapp.go b/internal/setupcmd/createapp.go\nnew file mode 100644\nindex 0000000..b0b9598\n--- /dev/null\n+++ b/internal/setupcmd/createapp.go\n@@ -0,0 +1,222 @@\n+package setupcmd\n+\n+import (\n+\t\"context\"\n+\t\"encoding/json\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"net/http\"\n+\t\"net/url\"\n+\t\"os\"\n+\t\"os/exec\"\n+\t\"runtime\"\n+\t\"strconv\"\n+\t\"time\"\n+\n+\t\"github.com/albertcbrown/ard/internal/cli\"\n+\t\"github.com/albertcbrown/ard/internal/github\"\n+)\n+\n+// CreateAppOpts are the user's choices for --create-gh-app.\n+type CreateAppOpts struct {\n+\tName    string // App name; default ard-<owner>-<repo>\n+\tKeyPath string // private key file; default ~/.ard/keys/<slug>.pem\n+\tForce   bool   // overwrite an existing key file\n+}\n+\n+// createDeps are the seams tests replace. Zero values use the real thing.\n+type createDeps struct {\n+\tapiBase      string\n+\thc           *http.Client\n+\topenBrowser  func(string) error\n+\tdiscover     func(ctx context.Context, appID int64, pem []byte, repo github.Repo) (int64, error)\n+\townerIsOrg   func(ctx context.Context, owner string) (bool, error)\n+\tcallbackWait time.Duration\n+\tpollEvery    time.Duration\n+\tpollFor      time.Duration\n+}\n+\n+func (d *createDeps) defaults() {\n+\tif d.apiBase == \"\" {\n+\t\td.apiBase = github.DefaultAPIBaseURL()\n+\t}\n+\tif d.hc == nil {\n+\t\td.hc = &http.Client{Timeout: 30 * time.Second}\n+\t}\n+\tif d.openBrowser == nil {\n+\t\td.openBrowser = openBrowser\n+\t}\n+\tif d.discover == nil {\n+\t\td.discover = func(ctx context.Context, appID int64, pem []byte, repo github.Repo) (int64, error) {\n+\t\t\ta := &github.AppAuth{AppID: appID, PrivateKey: pem}\n+\t\t\treturn a.DiscoverInstallation(ctx, repo, d.apiBase)\n+\t\t}\n+\t}\n+\tif d.ownerIsOrg == nil {\n+\t\td.ownerIsOrg = func(ctx context.Context, owner string) (bool, error) {\n+\t\t\treturn lookupOwnerIsOrg(ctx, d.hc, d.apiBase, owner)\n+\t\t}\n+\t}\n+\tif d.callbackWait == 0 {\n+\t\td.callbackWait = DefaultCallbackTimeout\n+\t}\n+\tif d.pollEvery == 0 {\n+\t\td.pollEvery = 3 * time.Second\n+\t}\n+\tif d.pollFor == 0 {\n+\t\td.pollFor = 5 * time.Minute\n+\t}\n+}\n+\n+// CreateApp creates ard's GitHub App through the manifest flow, stores the\n+// key and prints the environment lines. On success it also sets them in this\n+// process so the normal setup checks use the new App.\n+func CreateApp(ctx context.Context, e *cli.Env, repo github.Repo, o CreateAppOpts) error {\n+\tvar d createDeps\n+\treturn createApp(ctx, e, repo, o, d)\n+}\n+\n+func createApp(ctx context.Context, e *cli.Env, repo github.Repo, o CreateAppOpts, d createDeps) error {\n+\td.defaults()\n+\tname := o.Name\n+\tif name == \"\" {\n+\t\tname = \"ard-\" + repo.Owner + \"-\" + repo.Name\n+\t}\n+\tisOrg, err := d.ownerIsOrg(ctx, repo.Owner)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tstate, err := newState()\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\trender := func(base string) ([]byte, string) {\n+\t\tm, err := BuildManifest(name, base+\"/callback\")\n+\t\tif err != nil {\n+\t\t\treturn []byte(\"{}\"), \"\"\n+\t\t}\n+\t\tb, _ := json.MarshalIndent(m, \"\", \"  \")\n+\t\treturn b, ManifestURL(repo.Owner, isOrg, state)\n+\t}\n+\tif e.DryRun {\n+\t\tb, _ := render(\"http://127.0.0.1:<port>\")\n+\t\tfmt.Fprintf(e.Stdout, \"dry-run: would create a GitHub App; nothing was created.\\nmanifest URL: %s\\nmanifest:\\n%s\\n\", ManifestURL(repo.Owner, isOrg, \"<state>\"), b)\n+\t\treturn nil\n+\t}\n+\tif _, err := BuildManifest(name, \"http://127.0.0.1/callback\"); err != nil {\n+\t\treturn err\n+\t}\n+\t// A fixed key path is checked now so the user does not create an App\n+\t// that cannot be stored. The default path depends on the slug.\n+\tif o.KeyPath != \"\" {\n+\t\tif err := CheckKeyPath(o.KeyPath, o.Force); err != nil {\n+\t\t\treturn err\n+\t\t}\n+\t} else if _, err := DefaultKeyPath(\"x\"); err != nil {\n+\t\treturn err\n+\t}\n+\tready := func(local string) {\n+\t\tfmt.Fprintf(e.Stdout, \"Open this URL to create the App on GitHub (listening on loopback only):\\n  %s\\n\", local)\n+\t\tif err := d.openBrowser(local); err != nil {\n+\t\t\tfmt.Fprintln(e.Stdout, \"could not open a browser; open the URL above yourself\")\n+\t\t}\n+\t}\n+\tcode, err := serveCallback(ctx, render, state, d.callbackWait, ready)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tconv, err := Convert(ctx, d.apiBase, d.hc, code)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tpath := o.KeyPath\n+\tif path == \"\" {\n+\t\tif path, err = DefaultKeyPath(conv.Slug); err != nil {\n+\t\t\treturn err\n+\t\t}\n+\t}\n+\tused, err := WriteKeyWithFallback(path, []byte(conv.PEM), o.Force)\n+\tif err != nil {\n+\t\treturn fmt.Errorf(\"%w (the App %q was already created; its key could not be saved anywhere)\", err, conv.Slug)\n+\t}\n+\tif used != path {\n+\t\tfmt.Fprintf(e.Stdout, \"could not write %s; the key was saved to %s instead.\\n\", path, used)\n+\t\tpath = used\n+\t}\n+\tfmt.Fprintf(e.Stdout, \"App %q created; private key written to %s (mode 0600).\\n\", conv.Slug, path)\n+\tinstallURL := \"https://github.com/apps/\" + conv.Slug + \"/installations/new\"\n+\tfmt.Fprintf(e.Stdout, \"Install it on %s: %s\\n\", repo, installURL)\n+\n+\tinstID, err := waitInstallation(ctx, d, conv, repo)\n+\tif err != nil {\n+\t\tfmt.Fprintf(e.Stdout, \"Set ARD_GITHUB_APP_ID=%d and ARD_GITHUB_PRIVATE_KEY_FILE=%s, install the App, then rerun `ard setup`.\\n\", conv.ID, path)\n+\t\treturn err\n+\t}\n+\tlines := [][2]string{\n+\t\t{\"ARD_GITHUB_APP_ID\", strconv.FormatInt(conv.ID, 10)},\n+\t\t{\"ARD_GITHUB_INSTALLATION_ID\", strconv.FormatInt(instID, 10)},\n+\t\t{\"ARD_GITHUB_PRIVATE_KEY_FILE\", path},\n+\t}\n+\tfmt.Fprintln(e.Stdout, \"Add these to ard's environment:\")\n+\tfor _, l := range lines {\n+\t\tfmt.Fprintf(e.Stdout, \"  %s=%s\\n\", l[0], l[1])\n+\t\tif err := os.Setenv(l[0], l[1]); err != nil {\n+\t\t\treturn fmt.Errorf(\"setup: %w\", err)\n+\t\t}\n+\t}\n+\treturn nil\n+}\n+\n+// waitInstallation polls until the App is installed on repo.\n+func waitInstallation(ctx context.Context, d createDeps, conv Conversion, repo github.Repo) (int64, error) {\n+\tctx, cancel := context.WithTimeout(ctx, d.pollFor)\n+\tdefer cancel()\n+\tt := time.NewTicker(d.pollEvery)\n+\tdefer t.Stop()\n+\tfor {\n+\t\tif id, err := d.discover(ctx, conv.ID, []byte(conv.PEM), repo); err == nil && id != 0 {\n+\t\t\treturn id, nil\n+\t\t}\n+\t\tselect {\n+\t\tcase <-ctx.Done():\n+\t\t\treturn 0, errors.New(\"setup: timed out waiting for the App to be installed\")\n+\t\tcase <-t.C:\n+\t\t}\n+\t}\n+}\n+\n+func lookupOwnerIsOrg(ctx context.Context, hc *http.Client, apiBase, owner string) (bool, error) {\n+\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, apiBase+\"/users/\"+url.PathEscape(owner), nil)\n+\tif err != nil {\n+\t\treturn false, err\n+\t}\n+\treq.Header.Set(\"Accept\", \"application/vnd.github+json\")\n+\tresp, err := hc.Do(req)\n+\tif err != nil {\n+\t\treturn false, fmt.Errorf(\"setup: look up owner %s: %w\", owner, err)\n+\t}\n+\tdefer resp.Body.Close()\n+\tif resp.StatusCode != http.StatusOK {\n+\t\treturn false, fmt.Errorf(\"setup: look up owner %s: HTTP %d\", owner, resp.StatusCode)\n+\t}\n+\tvar out struct {\n+\t\tType string `json:\"type\"`\n+\t}\n+\tif err := json.NewDecoder(resp.Body).Decode(&out); err != nil {\n+\t\treturn false, fmt.Errorf(\"setup: look up owner %s: unexpected response\", owner)\n+\t}\n+\treturn out.Type == \"Organization\", nil\n+}\n+\n+func openBrowser(u string) error {\n+\tvar c *exec.Cmd\n+\tswitch runtime.GOOS {\n+\tcase \"darwin\":\n+\t\tc = exec.Command(\"open\", u)\n+\tcase \"windows\":\n+\t\tc = exec.Command(\"rundll32\", \"url.dll,FileProtocolHandler\", u)\n+\tdefault:\n+\t\tc = exec.Command(\"xdg-open\", u)\n+\t}\n+\treturn c.Start()\n+}\ndiff --git a/internal/setupcmd/createapp_test.go b/internal/setupcmd/createapp_test.go\nnew file mode 100644\nindex 0000000..ddcb228\n--- /dev/null\n+++ b/internal/setupcmd/createapp_test.go\n@@ -0,0 +1,394 @@\n+package setupcmd\n+\n+import (\n+\t\"bytes\"\n+\t\"context\"\n+\t\"encoding/json\"\n+\t\"fmt\"\n+\t\"log/slog\"\n+\t\"net/http\"\n+\t\"net/http/httptest\"\n+\t\"net/url\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"reflect\"\n+\t\"strings\"\n+\t\"testing\"\n+\t\"time\"\n+\n+\t\"github.com/albertcbrown/ard/internal/cli\"\n+\t\"github.com/albertcbrown/ard/internal/github\"\n+)\n+\n+// testPEM is built at run time so no key-shaped literal is in the source.\n+var testPEM = \"-----BEGIN \" + \"RSA PRIVATE KEY-----\\nQUJDREVGRw==\\n-----END \" + \"RSA PRIVATE KEY-----\\n\"\n+\n+func TestManifestPermissionsMatchBuiltIn(t *testing.T) {\n+\tm, err := BuildManifest(\"n\", \"http://127.0.0.1:1/callback\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif !reflect.DeepEqual(m.DefaultPermissions, AppPermissions) {\n+\t\tt.Errorf(\"permissions = %v\", m.DefaultPermissions)\n+\t}\n+\tif miss, extra := CheckPermissions(m.DefaultPermissions); len(miss)+len(extra) != 0 {\n+\t\tt.Errorf(\"check disagrees: missing %v extra %v\", miss, extra)\n+\t}\n+\tfor _, f := range ForbiddenPermissions {\n+\t\tif _, ok := m.DefaultPermissions[f]; ok {\n+\t\t\tt.Errorf(\"%s requested\", f)\n+\t\t}\n+\t}\n+\tb, _ := json.Marshal(m)\n+\tif m.Public || strings.Contains(string(b), \"hook_attributes\") {\n+\t\tt.Errorf(\"manifest must be private with no webhook: %s\", b)\n+\t}\n+\tmiss, extra := CheckPermissions(map[string]string{\"contents\": \"read\", \"workflows\": \"write\"})\n+\tif len(miss) == 0 || len(extra) != 1 {\n+\t\tt.Errorf(\"missing %v extra %v\", miss, extra)\n+\t}\n+}\n+\n+func TestManifestRejectsForbidden(t *testing.T) {\n+\tfor _, f := range ForbiddenPermissions {\n+\t\tp := map[string]string{f: \"write\"}\n+\t\tif _, err := buildManifest(p, \"n\", \"u\"); err == nil {\n+\t\t\tt.Errorf(\"%s accepted\", f)\n+\t\t}\n+\t}\n+}\n+\n+func TestManifestURLUserVsOrg(t *testing.T) {\n+\tu := ManifestURL(\"me\", false, \"st\")\n+\tif u != \"https://github.com/settings/apps/new?state=st\" {\n+\t\tt.Errorf(\"user url %s\", u)\n+\t}\n+\to := ManifestURL(\"acme\", true, \"st\")\n+\tif o != \"https://github.com/organizations/acme/settings/apps/new?state=st\" {\n+\t\tt.Errorf(\"org url %s\", o)\n+\t}\n+}\n+\n+func startCallback(t *testing.T, ctx context.Context, timeout time.Duration) (base string, res chan [2]string) {\n+\tt.Helper()\n+\tbaseCh := make(chan string, 1)\n+\tres = make(chan [2]string, 1)\n+\trender := func(string) ([]byte, string) {\n+\t\treturn []byte(`{\"a\":\"<b>\"}`), \"https://github.com/settings/apps/new?state=s\"\n+\t}\n+\tgo func() {\n+\t\tcode, err := serveCallback(ctx, render, \"s\", timeout, func(u string) { baseCh <- u })\n+\t\te := \"\"\n+\t\tif err != nil {\n+\t\t\te = err.Error()\n+\t\t}\n+\t\tres <- [2]string{code, e}\n+\t}()\n+\tselect {\n+\tcase base = <-baseCh:\n+\tcase <-time.After(5 * time.Second):\n+\t\tt.Fatal(\"server did not start\")\n+\t}\n+\treturn base, res\n+}\n+\n+func TestCallbackLoopbackStateAndSingleUse(t *testing.T) {\n+\tbase, res := startCallback(t, context.Background(), time.Minute)\n+\tu, _ := url.Parse(base)\n+\tif !strings.HasPrefix(u.Host, \"127.0.0.1:\") {\n+\t\tt.Fatalf(\"host %s\", u.Host)\n+\t}\n+\tpage, err := http.Get(base)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tvar pb bytes.Buffer\n+\t_, _ = pb.ReadFrom(page.Body)\n+\tpage.Body.Close()\n+\tif !strings.Contains(pb.String(), \"&lt;b&gt;\") || strings.Contains(pb.String(), \"<b>\") {\n+\t\tt.Errorf(\"manifest not escaped: %s\", pb.String())\n+\t}\n+\tr, err := http.Get(base + \"callback?code=c1&state=wrong\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tr.Body.Close()\n+\tif r.StatusCode != http.StatusBadRequest {\n+\t\tt.Errorf(\"wrong state status %d\", r.StatusCode)\n+\t}\n+\tr, err = http.Get(base + \"callback?code=c1&state=s\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tr.Body.Close()\n+\tif r.StatusCode != 200 {\n+\t\tt.Errorf(\"status %d\", r.StatusCode)\n+\t}\n+\tif got := <-res; got[0] != \"c1\" || got[1] != \"\" {\n+\t\tt.Errorf(\"result %v\", got)\n+\t}\n+\tc := http.Client{Timeout: time.Second}\n+\tif r, err := c.Get(base + \"callback?code=c2&state=s\"); err == nil {\n+\t\tr.Body.Close()\n+\t\tt.Error(\"server still accepting after the first valid request\")\n+\t}\n+}\n+\n+func TestCallbackTimeoutAndCancel(t *testing.T) {\n+\tbase, res := startCallback(t, context.Background(), 50*time.Millisecond)\n+\tif got := <-res; got[1] == \"\" {\n+\t\tt.Error(\"want timeout error\")\n+\t}\n+\tc := http.Client{Timeout: time.Second}\n+\tif r, err := c.Get(base); err == nil {\n+\t\tr.Body.Close()\n+\t\tt.Error(\"listener open after timeout\")\n+\t}\n+\tctx, cancel := context.WithCancel(context.Background())\n+\t_, res = startCallback(t, ctx, time.Minute)\n+\tcancel()\n+\tif got := <-res; got[1] == \"\" {\n+\t\tt.Error(\"want cancel error\")\n+\t}\n+}\n+\n+func fakeAPI(t *testing.T, status int, body string) *httptest.Server {\n+\tt.Helper()\n+\tmux := http.NewServeMux()\n+\tmux.HandleFunc(\"POST /app-manifests/{code}/conversions\", func(w http.ResponseWriter, r *http.Request) {\n+\t\tif r.Header.Get(\"Authorization\") != \"\" || r.PathValue(\"code\") != \"thecode\" {\n+\t\t\tw.WriteHeader(400)\n+\t\t\treturn\n+\t\t}\n+\t\tw.WriteHeader(status)\n+\t\t_, _ = w.Write([]byte(body))\n+\t})\n+\tmux.HandleFunc(\"GET /users/{o}\", func(w http.ResponseWriter, r *http.Request) {\n+\t\ttyp := \"User\"\n+\t\tif r.PathValue(\"o\") == \"acme\" {\n+\t\t\ttyp = \"Organization\"\n+\t\t}\n+\t\t_, _ = fmt.Fprintf(w, `{\"type\":%q}`, typ)\n+\t})\n+\ts := httptest.NewServer(mux)\n+\tt.Cleanup(s.Close)\n+\treturn s\n+}\n+\n+func okBody() string {\n+\tb, _ := json.Marshal(map[string]any{\"id\": 42, \"slug\": \"ard-x\", \"pem\": testPEM, \"client_secret\": \"s3cret\"})\n+\treturn string(b)\n+}\n+\n+func TestConvert(t *testing.T) {\n+\ts := fakeAPI(t, 201, okBody())\n+\tc, err := Convert(context.Background(), s.URL, nil, \"thecode\")\n+\tif err != nil || c.ID != 42 || c.Slug != \"ard-x\" || c.PEM != testPEM {\n+\t\tt.Fatalf(\"%v %+v\", err, c)\n+\t}\n+\tvar buf bytes.Buffer\n+\tslog.New(slog.NewTextHandler(&buf, nil)).Info(\"x\", \"c\", c)\n+\tall := fmt.Sprintf(\"%v %+v %#v %s\", c, c, c, c) + buf.String()\n+\tif strings.Contains(all, \"QUJDREVGRw\") || strings.Contains(all, \"PRIVATE KEY\") {\n+\t\tt.Errorf(\"key leaked: %s\", all)\n+\t}\n+\tfor _, st := range []int{404, 422} {\n+\t\ts := fakeAPI(t, st, `{\"message\":\"bad\",\"echo\":\"`+strings.ReplaceAll(testPEM, \"\\n\", `\\n`)+`\"}`)\n+\t\t_, err := Convert(context.Background(), s.URL, nil, \"thecode\")\n+\t\tif err == nil || strings.Contains(err.Error(), \"QUJDREVGRw\") || !strings.Contains(err.Error(), fmt.Sprint(st)) {\n+\t\t\tt.Errorf(\"status %d err %v\", st, err)\n+\t\t}\n+\t}\n+}\n+\n+func TestWriteKey(t *testing.T) {\n+\tp := filepath.Join(t.TempDir(), \"keys\", \"a.pem\")\n+\tif err := WriteKey(p, []byte(\"one\"), false); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tfi, _ := os.Stat(p)\n+\tdi, _ := os.Stat(filepath.Dir(p))\n+\tif fi.Mode().Perm() != 0o600 || di.Mode().Perm() != 0o700 {\n+\t\tt.Errorf(\"modes %v %v\", fi.Mode().Perm(), di.Mode().Perm())\n+\t}\n+\tif err := WriteKey(p, []byte(\"two\"), false); err == nil {\n+\t\tt.Error(\"overwrote without force\")\n+\t}\n+\tif err := CheckKeyPath(p, false); err == nil {\n+\t\tt.Error(\"CheckKeyPath accepted existing path\")\n+\t}\n+\tif b, _ := os.ReadFile(p); string(b) != \"one\" {\n+\t\tt.Errorf(\"contents %q\", b)\n+\t}\n+\tif err := WriteKey(p, []byte(\"two\"), true); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tfi, _ = os.Stat(p)\n+\tif b, _ := os.ReadFile(p); string(b) != \"two\" || fi.Mode().Perm() != 0o600 {\n+\t\tt.Errorf(\"force: %q %v\", b, fi.Mode().Perm())\n+\t}\n+}\n+\n+func testEnv(dry bool) (*cli.Env, *bytes.Buffer) {\n+\tvar out bytes.Buffer\n+\treturn &cli.Env{Globals: cli.Globals{DryRun: dry}, Log: quiet, Stdout: &out, Stderr: &out}, &out\n+}\n+\n+func TestCreateAppDryRun(t *testing.T) {\n+\ts := fakeAPI(t, 201, okBody())\n+\te, out := testEnv(true)\n+\tkeyPath := filepath.Join(t.TempDir(), \"k.pem\")\n+\topened := false\n+\terr := createApp(context.Background(), e, github.Repo{Owner: \"acme\", Name: \"r\"}, CreateAppOpts{KeyPath: keyPath},\n+\t\tcreateDeps{apiBase: s.URL, openBrowser: func(string) error { opened = true; return nil }})\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif opened || !strings.Contains(out.String(), \"/organizations/acme/settings/apps/new\") || !strings.Contains(out.String(), `\"default_permissions\"`) {\n+\t\tt.Errorf(\"output: %s\", out.String())\n+\t}\n+\tif _, err := os.Stat(keyPath); err == nil {\n+\t\tt.Error(\"key written in dry run\")\n+\t}\n+}\n+\n+func TestCreateAppUserAndOrg(t *testing.T) {\n+\tfor _, tc := range []struct{ owner, wantHost string }{\n+\t\t{\"me\", \"https://github.com/settings/apps/new\"},\n+\t\t{\"acme\", \"https://github.com/organizations/acme/settings/apps/new\"},\n+\t} {\n+\t\tt.Run(tc.owner, func(t *testing.T) {\n+\t\t\ts := fakeAPI(t, 201, okBody())\n+\t\t\tkeyPath := filepath.Join(t.TempDir(), \"k.pem\")\n+\t\t\te, out := testEnv(false)\n+\t\t\tfor _, k := range []string{\"ARD_GITHUB_APP_ID\", \"ARD_GITHUB_INSTALLATION_ID\", \"ARD_GITHUB_PRIVATE_KEY_FILE\"} {\n+\t\t\t\tt.Setenv(k, \"\")\n+\t\t\t}\n+\t\t\tvar form string\n+\t\t\td := createDeps{\n+\t\t\t\tapiBase: s.URL,\n+\t\t\t\topenBrowser: func(local string) error {\n+\t\t\t\t\tresp, err := http.Get(local)\n+\t\t\t\t\tif err != nil {\n+\t\t\t\t\t\treturn err\n+\t\t\t\t\t}\n+\t\t\t\t\tvar b bytes.Buffer\n+\t\t\t\t\t_, _ = b.ReadFrom(resp.Body)\n+\t\t\t\t\tresp.Body.Close()\n+\t\t\t\t\tform = b.String()\n+\t\t\t\t\t// GitHub would redirect back with the state it was given.\n+\t\t\t\t\ti := strings.Index(form, \"state=\")\n+\t\t\t\t\tst := form[i+len(\"state=\") : i+len(\"state=\")+32]\n+\t\t\t\t\tr, err := http.Get(local + \"callback?code=thecode&state=\" + st)\n+\t\t\t\t\tif err == nil {\n+\t\t\t\t\t\tr.Body.Close()\n+\t\t\t\t\t}\n+\t\t\t\t\treturn err\n+\t\t\t\t},\n+\t\t\t\tdiscover: func(_ context.Context, id int64, pem []byte, _ github.Repo) (int64, error) {\n+\t\t\t\t\tif id != 42 || string(pem) != testPEM {\n+\t\t\t\t\t\treturn 0, fmt.Errorf(\"bad creds\")\n+\t\t\t\t\t}\n+\t\t\t\t\treturn 7, nil\n+\t\t\t\t},\n+\t\t\t\tpollEvery: time.Millisecond,\n+\t\t\t}\n+\t\t\tif err := createApp(context.Background(), e, github.Repo{Owner: tc.owner, Name: \"r\"}, CreateAppOpts{KeyPath: keyPath}, d); err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t\tif !strings.Contains(form, tc.wantHost+\"?state=\") {\n+\t\t\t\tt.Errorf(\"form posts elsewhere: %s\", form)\n+\t\t\t}\n+\t\t\tfor _, w := range []string{\"ARD_GITHUB_APP_ID=42\", \"ARD_GITHUB_INSTALLATION_ID=7\", \"ARD_GITHUB_PRIVATE_KEY_FILE=\" + keyPath, \"/apps/ard-x/installations/new\"} {\n+\t\t\t\tif !strings.Contains(out.String(), w) {\n+\t\t\t\t\tt.Errorf(\"missing %q in %s\", w, out.String())\n+\t\t\t\t}\n+\t\t\t}\n+\t\t\tif strings.Contains(out.String(), \"QUJDREVGRw\") || strings.Contains(out.String(), \"s3cret\") {\n+\t\t\t\tt.Errorf(\"secret printed: %s\", out.String())\n+\t\t\t}\n+\t\t\tif b, _ := os.ReadFile(keyPath); string(b) != testPEM {\n+\t\t\t\tt.Error(\"key not stored\")\n+\t\t\t}\n+\t\t\tif os.Getenv(\"ARD_GITHUB_APP_ID\") != \"42\" {\n+\t\t\t\tt.Error(\"env not set\")\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+func TestCreateAppInstallTimeoutAndBrowserFailure(t *testing.T) {\n+\ts := fakeAPI(t, 201, okBody())\n+\te, out := testEnv(false)\n+\td := createDeps{\n+\t\tapiBase: s.URL,\n+\t\topenBrowser: func(local string) error {\n+\t\t\tgo func() {\n+\t\t\t\tresp, _ := http.Get(local)\n+\t\t\t\tb := new(bytes.Buffer)\n+\t\t\t\t_, _ = b.ReadFrom(resp.Body)\n+\t\t\t\tresp.Body.Close()\n+\t\t\t\tst := b.String()[strings.Index(b.String(), \"state=\")+6:][:32]\n+\t\t\t\tr, _ := http.Get(local + \"callback?code=thecode&state=\" + st)\n+\t\t\t\tr.Body.Close()\n+\t\t\t}()\n+\t\t\treturn fmt.Errorf(\"no browser\")\n+\t\t},\n+\t\tdiscover:  func(context.Context, int64, []byte, github.Repo) (int64, error) { return 0, fmt.Errorf(\"404\") },\n+\t\tpollEvery: time.Millisecond,\n+\t\tpollFor:   30 * time.Millisecond,\n+\t}\n+\tkeyPath := filepath.Join(t.TempDir(), \"k.pem\")\n+\terr := createApp(context.Background(), e, github.Repo{Owner: \"me\", Name: \"r\"}, CreateAppOpts{KeyPath: keyPath}, d)\n+\tif err == nil || !strings.Contains(err.Error(), \"installed\") {\n+\t\tt.Errorf(\"err %v\", err)\n+\t}\n+\tif !strings.Contains(out.String(), \"open the URL above\") || !strings.Contains(out.String(), \"rerun `ard setup`\") {\n+\t\tt.Errorf(\"output %s\", out.String())\n+\t}\n+\tif strings.Contains(out.String(), \"QUJDREVGRw\") {\n+\t\tt.Error(\"key printed\")\n+\t}\n+}\n+\n+func TestCreateAppRefusesExistingKeyBeforeBrowser(t *testing.T) {\n+\ts := fakeAPI(t, 201, okBody())\n+\tkeyPath := filepath.Join(t.TempDir(), \"k.pem\")\n+\t_ = os.WriteFile(keyPath, []byte(\"x\"), 0o600)\n+\te, _ := testEnv(false)\n+\topened := false\n+\terr := createApp(context.Background(), e, github.Repo{Owner: \"me\", Name: \"r\"}, CreateAppOpts{KeyPath: keyPath},\n+\t\tcreateDeps{apiBase: s.URL, openBrowser: func(string) error { opened = true; return nil }})\n+\tif err == nil || opened {\n+\t\tt.Errorf(\"err %v opened %v\", err, opened)\n+\t}\n+}\n+\n+func TestWriteKeyFallbackAndSymlink(t *testing.T) {\n+\tdir := t.TempDir()\n+\tp := filepath.Join(dir, \"a.pem\")\n+\tif err := os.WriteFile(p, []byte(\"old\"), 0o600); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tused, err := WriteKeyWithFallback(p, []byte(\"new\"), false)\n+\tif err != nil || used == p || filepath.Dir(used) != dir {\n+\t\tt.Fatalf(\"used %q err %v\", used, err)\n+\t}\n+\tif b, _ := os.ReadFile(used); string(b) != \"new\" {\n+\t\tt.Errorf(\"fallback contents %q\", b)\n+\t}\n+\tif b, _ := os.ReadFile(p); string(b) != \"old\" {\n+\t\tt.Errorf(\"original changed: %q\", b)\n+\t}\n+\ttarget := filepath.Join(dir, \"target\")\n+\tlink := filepath.Join(dir, \"link.pem\")\n+\tif err := os.Symlink(target, link); err != nil {\n+\t\tt.Skip(\"symlinks unavailable\")\n+\t}\n+\tif err := WriteKey(link, []byte(\"x\"), true); err == nil {\n+\t\tt.Error(\"wrote through symlink\")\n+\t}\n+\tif _, err := os.Stat(target); err == nil {\n+\t\tt.Error(\"symlink target created\")\n+\t}\n+}\ndiff --git a/internal/setupcmd/keyfile.go b/internal/setupcmd/keyfile.go\nnew file mode 100644\nindex 0000000..c1f1771\n--- /dev/null\n+++ b/internal/setupcmd/keyfile.go\n@@ -0,0 +1,86 @@\n+package setupcmd\n+\n+import (\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"time\"\n+)\n+\n+// DefaultKeyPath is ~/.ard/keys/<slug>.pem.\n+func DefaultKeyPath(slug string) (string, error) {\n+\thome, err := os.UserHomeDir()\n+\tif err != nil || home == \"\" {\n+\t\treturn \"\", errors.New(\"setup: cannot resolve the home directory; pass --key-file\")\n+\t}\n+\treturn filepath.Join(home, \".ard\", \"keys\", slug+\".pem\"), nil\n+}\n+\n+// CheckKeyPath fails when path exists and force is not set.\n+func CheckKeyPath(path string, force bool) error {\n+\tif _, err := os.Lstat(path); err == nil && !force {\n+\t\treturn fmt.Errorf(\"setup: %s already exists; use --force to overwrite\", path)\n+\t}\n+\treturn nil\n+}\n+\n+// WriteKey writes the private key with mode 0600. The parent directory is\n+// created with 0700. An existing path is refused unless force is set.\n+func WriteKey(path string, pem []byte, force bool) error {\n+\tif err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {\n+\t\treturn fmt.Errorf(\"setup: create key directory: %w\", err)\n+\t}\n+\tif fi, err := os.Lstat(path); err == nil && fi.Mode()&os.ModeSymlink != 0 {\n+\t\treturn fmt.Errorf(\"setup: %s is a symlink; refusing to write the key through it\", path)\n+\t}\n+\tflags := os.O_WRONLY | os.O_CREATE | os.O_EXCL\n+\tif force {\n+\t\tflags = os.O_WRONLY | os.O_CREATE | os.O_TRUNC\n+\t}\n+\tf, err := os.OpenFile(path, flags, 0o600)\n+\tif err != nil {\n+\t\tif errors.Is(err, os.ErrExist) {\n+\t\t\treturn fmt.Errorf(\"setup: %s already exists; use --force to overwrite\", path)\n+\t\t}\n+\t\treturn fmt.Errorf(\"setup: write key file: %w\", err)\n+\t}\n+\tif err := f.Chmod(0o600); err != nil {\n+\t\tf.Close()\n+\t\treturn fmt.Errorf(\"setup: chmod key file: %w\", err)\n+\t}\n+\tif _, err := f.Write(pem); err != nil {\n+\t\tf.Close()\n+\t\treturn fmt.Errorf(\"setup: write key file: %w\", err)\n+\t}\n+\tif err := f.Close(); err != nil {\n+\t\treturn fmt.Errorf(\"setup: write key file: %w\", err)\n+\t}\n+\treturn nil\n+}\n+\n+// WriteKeyWithFallback writes the key to path. GitHub returns the private key\n+// only once, so when that write fails (for example the default file exists or\n+// the directory is unwritable) it falls back to a fresh <name>-<timestamp>.pem\n+// created with O_EXCL, first beside path, then under ~/.ard/keys, then in the\n+// temp directory. It returns the path actually used.\n+func WriteKeyWithFallback(path string, pem []byte, force bool) (string, error) {\n+\tfirstErr := WriteKey(path, pem, force)\n+\tif firstErr == nil {\n+\t\treturn path, nil\n+\t}\n+\tbase := strings.TrimSuffix(filepath.Base(path), \".pem\") + \"-\" + time.Now().UTC().Format(\"20060102T150405.000000000\") + \".pem\"\n+\tdirs := []string{filepath.Dir(path)}\n+\tif home, err := os.UserHomeDir(); err == nil && home != \"\" {\n+\t\tdirs = append(dirs, filepath.Join(home, \".ard\", \"keys\"))\n+\t}\n+\tdirs = append(dirs, os.TempDir())\n+\tfor _, d := range dirs {\n+\t\talt := filepath.Join(d, base)\n+\t\tif WriteKey(alt, pem, false) == nil {\n+\t\t\treturn alt, nil\n+\t\t}\n+\t}\n+\treturn \"\", firstErr\n+}\n","numLines":1171,"startLine":1,"totalLines":1171}},"tool_result_meta":[{"id":"toolu_015Vc9oo7nQ9bG38wegFzwh3","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
