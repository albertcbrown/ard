tif got := <-res; got[0] != \"c1\" || got[1] != \"\" {\n812\t+\t\tt.Errorf(\"result %v\", got)\n813\t+\t}\n814\t+\tc := http.Client{Timeout: time.Second}\n815\t+\tif r, err := c.Get(base + \"callback?code=c2&state=s\"); err == nil {\n816\t+\t\tr.Body.Close()\n817\t+\t\tt.Error(\"server still accepting after the first valid request\")\n818\t+\t}\n819\t+}\n820\t+\n821\t+func TestCallbackTimeoutAndCancel(t *testing.T) {\n822\t+\tbase, res := startCallback(t, context.Background(), 50*time.Millisecond)\n823\t+\tif got := <-res; got[1] == \"\" {\n824\t+\t\tt.Error(\"want timeout error\")\n825\t+\t}\n826\t+\tc := http.Client{Timeout: time.Second}\n827\t+\tif r, err := c.Get(base); err == nil {\n828\t+\t\tr.Body.Close()\n829\t+\t\tt.Error(\"listener open after timeout\")\n830\t+\t}\n831\t+\tctx, cancel := context.WithCancel(context.Background())\n832\t+\t_, res = startCallback(t, ctx, time.Minute)\n833\t+\tcancel()\n834\t+\tif got := <-res; got[1] == \"\" {\n835\t+\t\tt.Error(\"want cancel error\")\n836\t+\t}\n837\t+}\n838\t+\n839\t+func fakeAPI(t *testing.T, status int, body string) *httptest.Server {\n840\t+\tt.Helper()\n841\t+\tmux := http.NewServeMux()\n842\t+\tmux.HandleFunc(\"POST /app-manifests/{code}/conversions\", func(w http.ResponseWriter, r *http.Request) {\n843\t+\t\tif r.Header.Get(\"Authorization\") != \"\" || r.PathValue(\"code\") != \"thecode\" {\n844\t+\t\t\tw.WriteHeader(400)\n845\t+\t\t\treturn\n846\t+\t\t}\n847\t+\t\tw.WriteHeader(status)\n848\t+\t\t_, _ = w.Write([]byte(body))\n849\t+\t})\n850\t+\tmux.HandleFunc(\"GET /users/{o}\", func(w http.ResponseWriter, r *http.Request) {\n851\t+\t\ttyp := \"User\"\n852\t+\t\tif r.PathValue(\"o\") == \"acme\" {\n853\t+\t\t\ttyp = \"Organization\"\n854\t+\t\t}\n855\t+\t\t_, _ = fmt.Fprintf(w, `{\"type\":%q}`, typ)\n856\t+\t})\n857\t+\ts := httptest.NewServer(mux)\n858\t+\tt.Cleanup(s.Close)\n859\t+\treturn s\n860\t+}\n861\t+\n862\t+func okBody() string {\n863\t+\tb, _ := json.Marshal(map[string]any{\"id\": 42, \"s