{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011WdxuKbdVai8yuaipHFjLd","type":"tool_result","content":"\t// deletes logs and is idempotent.\n\tCleanup(ctx context.Context, h Handle, o CleanupOptions) error\n}\n\n// Job describes one run.\ntype Job struct {\n\tID         string  // ULID minted at claim; ^[0-9A-Za-z]{1,64}$\n\tRepo       string  // \"owner/repo\"\n\tIssue      int     // 0 = scanner run with no issue\n\tStage      string  // \"scanner\" | \"triage\" | \"worker\" | \"review\"\n\tRole       string  // ^[a-z0-9][a-z0-9-]*$\n\tRepoDir    string  // abs path of the controller's clone, already fetched\n\tRef        string  // commit-ish resolved in RepoDir; the worktree is detached at it\n\tRoleDir    string  // abs host path of the role directory\n\tDockerfile string  // abs host path; \"\" = host subprocess\n\tSidecar    Sidecar // zero = none; the executor clones, pins and mounts it read-only\n\tReadOnly   bool    // worktree read-only: Docker mounts :ro, host chmod -R a-w after Prepare\n\tInputs     []File  // written into the worktree by Prepare\n\t// Scrub lists repo-relative paths Prepare removes from the worktree after\n\t// checkout and before Start, so a file at Ref cannot pass for this job's\n\t// own output. Use it for the job's role file: close-out then trusts that\n\t// file only if it exists, because the agent wrote it. Each path must be a\n\t// file directly under .ard/<Issue>/ (Issue >= 1).\n\tScrub   []string\n\tTimeout time.Duration // > 0\n\t// TrustedInput: the job reads no untrusted input (a deterministic\n\t// scanner); only valid with Stage \"scanner\". The zero value means it\n\t// does, so a builder that forgets the field gets the host-mode warning.\n\tTrustedInput bool\n}\n\n// Sidecar is a read-only companion repo the executor clones for the job.\ntype Sidecar struct {\n\tName string // config key, for messages\n\tRepo string // \"owner/name\"\n\tRef  string // branch, tag or full 40-hex SHA (gitref.Check)\n}\n\n// File is a worktree-relative file written 0644 by Prepare.\ntype File struct {\n\tPath string\n\tData []byte\n}\n\n// Paths are the locations as the job process sees them. ConfigDir is the\n// job's empty agent-CLI config dir (host: <home>/.claude; Docker:\n// /ard-config); it is empty on a handle stored before it existed.\ntype Paths struct{ Work, Role, Sidecar, ConfigDir string }\n\n// Command is what to run. Paths must come from Handle.View.\ntype Command struct {\n\tPath string\n\tArgs []string\n\tEnv  []string // \"NAME=value\" secrets; only names the executor allows (AllowEnv)\n\t// Fixed holds non-secret \"NAME=value\" settings the CLI needs (for example\n\t// an agent adapter's config dir). Only names on the executor's AllowFixed\n\t// list are accepted; the executor's own names, GitHub credentials and\n\t// secret-shaped names are always refused.\n\tFixed []string\n\tStdin io.Reader\n}\n\n// Handle identifies a prepared or running job. It is JSON-serialisable and\n// holds no env values or secrets.\ntype Handle struct {\n\tJobID, Kind         string // Kind: \"host\" | \"docker\"\n\tIssue               int\n\tStage, Role         string\n\tWorktree, Home      string\n\tRepoDir             string\n\tBaseSHA             string\n\tLogPath, StdoutPath string\n\tView                Paths\n\tImage, Container    string\n\tPID                 int\n\tProcStart           string\n\tPreparedAt          time.Time\n\tStartedAt, Deadline time.Time\n\tReadOnly            bool\n\tTimeout             time.Duration\n\tRoleDir, SidecarDir string  // host paths; SidecarDir is the executor's output (<Home>/sidecar), \"\" = none\n\tSidecar             Sidecar // copied from Job; zero on a handle stored before sidecars\n\tSidecarSHA          string  // the commit the job sees; \"\" = no sidecar\n\tTrustedInput        bool    // copied from Job by Prepare\n\t// Scrubbed lists the Job.Scrub paths Prepare removed from the worktree.\n\t// Close-out trusts an unchanged role file only if it is listed here.\n\tScrubbed []string\n}\n\n// State is the lifecycle state of a job.\ntype State string\n\nconst (\n\tPrepared State = \"prepared\"\n\tRunning  State = \"running\"\n\tExited   State = \"exited\"\n\tTimedOut State = \"timed_out\"\n\t// Orphaned: alive with a verified start time but not tracked by this\n\t// process (the controller restarted).\n\tOrphaned State = \"orphaned\"\n\t// Gone: not tracked and not alive; no exit code known.\n\t}\n\tswitch {\n\tcase !idRE.MatchString(j.ID):\n\t\treturn bad(\"id %q\", j.ID)\n\tcase !validRepo(j.Repo):\n\t\treturn bad(\"repo %q\", j.Repo)\n\tcase j.Issue < 0:\n\t\treturn bad(\"issue %d\", j.Issue)\n\tcase !stages[j.Stage]:\n\t\treturn bad(\"stage %q\", j.Stage)\n\tcase !roleRE.MatchString(j.Role):\n\t\treturn bad(\"role %q\", j.Role)\n\tcase j.Ref == \"\" || strings.HasPrefix(j.Ref, \"-\"):\n\t\treturn bad(\"ref %q\", j.Ref)\n\tcase j.TrustedInput && j.Stage != \"scanner\":\n\t\treturn bad(\"trusted input is only valid for a scanner job\")\n\tcase j.Timeout <= 0:\n\t\treturn bad(\"timeout %s\", j.Timeout)\n\t}\n\tfor name, p := range map[string]string{\"repo dir\": j.RepoDir, \"role dir\": j.RoleDir} {\n\t\tif !filepath.IsAbs(p) {\n\t\t\treturn bad(\"%s %q is not absolute\", name, p)\n\t\t}\n\t}\n\tfor name, p := range map[string]string{\"dockerfile\": j.Dockerfile} {\n\t\tif p != \"\" && !filepath.IsAbs(p) {\n\t\t\treturn bad(\"%s %q is not absolute\", name, p)\n\t\t}\n\t}\n\tif j.Sidecar != (Sidecar{}) {\n\t\tif !validRepo(j.Sidecar.Repo) {\n\t\t\treturn bad(\"sidecar repo %q\", j.Sidecar.Repo)\n\t\t}\n\t\tif err := gitref.Check(j.Sidecar.Ref); err != nil {\n\t\t\treturn bad(\"sidecar ref: %v\", err)\n\t\t}\n\t\to.BuildTimeout = 15 * time.Minute\n\t}\n\tif o.Now == nil {\n\t\to.Now = time.Now\n\t}\n\tif o.Log == nil {\n\t\to.Log = slog.Default()\n\t}\n\tif o.SidecarGit == nil {\n\t\to.SidecarGit = gitx.New(\"\")\n\t}\n\tif o.SidecarURL == nil {\n\t\to.SidecarURL = defaultSidecarURL\n\t}\n\tif o.SidecarTimeout <= 0 {\n\t\to.SidecarTimeout = defaultSidecarTimeout\n\t}\n\tallow := map[string]bool{}\n\tfor _, n := range o.AllowEnv {\n\t\tallow[n] = true\n\t}\n\tfixed := map[string]bool{}\n\tfor _, n := range o.AllowFixed {\n\t\tfixed[n] = true\n\t}\n\treturn &Local{configDirEnv: o.ConfigDirEnv, allowFixed: fixed, root: o.Root, dockerBin: o.DockerBin, pathEnv: o.PathEnv, git: o.Git,\n\t\tallowEnv: allow, grace: o.KillGrace, buildTimeout: o.BuildTimeout, now: o.Now, log: o.Log, onHostUntrusted: o.OnHostUntrusted,\n\t\ttracks: map[string]*track{}, sgit: o.SidecarGit, sidecarURL: o.SidecarURL, sidecarToken: o.SidecarToken,\n\t\tsidecarTimeout: o.SidecarTimeout, cloneDir: cleanDir(o.CloneDir)}, nil\n}\n\n// configDirName is the per-job agent config dir inside the job home. Under\n// HOME, the CLI's default ~/.claude resolves to the same fresh dir even if\n// the config-dir variable were dropped.\nconst configDirName = \".claude\"\n\n// Prepare creates the worktree, writes inputs, creates log files and, for a\n// Dockerfile role, ensures the image. It starts no process.\nfunc (l *Local) Prepare(ctx context.Context, j executor.Job) (h executor.Handle, err error) {\n\tif err := j.Validate(); err != nil {\n\t\treturn h, err\n\t}\n\twt, err := l.WorktreePath(j.Repo, j.ID)\n\tif err != nil {\n\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, err)\n\t}\n\tif _, err := os.Lstat(wt); err == nil {\n\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, executor.ErrExists)\n\t}\n\tsha, err := l.git.RevParse(ctx, j.RepoDir, j.Ref)\n\tif err != nil {\n\t\treturn h, fmt.Errorf(\"resolve ref %q: %w: %w\", j.Ref, executor.ErrClone, err)\n\t}\n\tnow := l.now().UTC()\n\tbase := LogBase(j.Stage, j.Role, now)\n\tlogDir, err := l.logDir(j.Repo, j.Issue)\n\tif err != nil {\n\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, err)\n\t}\n\thome, err := l.homePath(j.Repo, j.ID)\n\tif err != nil {\n\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, err)\n\t}\n\th = executor.Handle{\n\t\tJobID