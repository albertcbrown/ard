h salt, so a value has the same fingerprint as at HEAD. A scanner role asks for history by holding an empty file named `history` in its directory (`Role.ReadsHistory`; there is no config key, so an override cannot grant it). The executor then sets `Job.History` (scanner stage only) and mounts the controller's bare clone read-only at `/history` in Docker (host mode uses the clone path) and sets `ARD_HISTORY`. The mount includes unmerged PR branches. Commit, author and timestamp are dropped; only the detector, file, line and hash leave the scan. It never autocloses, because history does not go away. A Kubernetes executor must provide a read-only copy at the same place.'''+s[j:]\nopen('docs/proposal.md','w').write(s)\nE\nsed -i '' 's/^- #224 Scanner: trufflehog history scan/- #224 Scanner: trufflehog history scan (done: read-only history mount, `history` marker file)/' docs/TODO.md\ngofmt -l internal/*/ ; go test ./... 2>&1 | grep -v \"^ok\\|no test files\\|downloading\"; git -c core.excludesFile=/dev/null status --porcelain --untracked-files=all"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":648,"cache_read_input_tokens":69423,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":648},"output_tokens":33,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"74408439-f49d-4817-a8b7-ff57f9f6ddad","uuid":"c9171326-ba42-4e6c-b2cf-fa606168695d","timestamp":"2026-11-23T23:05:12.631Z","request_id":"req_011ChLhNg3eEPvqXxQCHG29T"}
