ully merged configuration: built-in defaults, then the\n171-// global config, then per-role overrides.\n172-type Resolved struct {\n173-\tRepo string // repo root: a working tree, or the snapshot directory of SHA\n174-\t// SHA is the commit the config and role directories were read from; empty\n175-\t// when loaded from a working tree. Job builders (#29, #33, #35, #37) use\n176-\t// Ref = SHA and resolve Role.Dir, Role.Dockerfile and Role.PromptPath\n--\n226-\t}\n227-\tvar out []Role\n228-\tfor _, role := range r.Roles {\n229:\t\tif role.ReadsUntrusted() && role.Dockerfile == \"\" {\n230-\t\t\tout = append(out, role)\n231-\t\t}\n232-\t}\n233-\treturn out\n234-}\n235-\n236-// SidecarFor returns the sidecar the role mounts; ok is false when it has none.\n237-// Loops set executor.Sidecar.Name from role.Sidecar so errors name the key.\n238-func (r *Resolved) SidecarFor(role Role) (sc Sidecar, ok bool) {\n239-\tif role.Sidecar == \"\" {\n240-\t\treturn Sidecar{}, false\n241-\t}\n\tslot.SetJobID(job.ID)\n\tdefer func() {\n\t\tbg := context.WithoutCancel(ctx)\n\t\tvar jerr error\n\t\tif err == nil {\n\t\t\tjerr = d.Jobs.Complete(bg, job.ID, nil)\n\t\t} else {\n\t\t\tjerr = d.Jobs.Fail(bg, job.ID, err.Error(), time.Time{})\n\t\t}\n\t\tif jerr != nil {\n\t\t\tlog.Error(\"scanner.job_record_failed\", \"job\", job.ID, \"error\", jerr)\n\t\t}\n\t}()\n\n\tej := executor.Job{\n\t\tID: job.ID, Repo: d.Repo, Stage: \"scanner\", Role: role.Name,\n\t\tRepoDir: d.RepoDir, Ref: sha, ReadOnly: true, Timeout: role.Timeout,\n\t\tRoleDir: filepath.Join(cfg.Repo, filepath.FromSlash(role.Dir)),\n\t}\n\tej.TrustedInput = !role.ReadsUntrusted()\n\tif role.Dockerfile != \"\" {\n\t\tej.Dockerfile = filepath.Join(cfg.Repo, filepath.FromSlash(role.Dockerfile))\n\t}\n\th, err := d.Executor.Prepare(ctx, ej)\n\tif err != nil {\n\t\treturn ScanResult{SHA: sha}, fmt.Errorf(\"prepare scan: %w\", err)\n\t}\n\tdefer func() {\n\t\tif cerr := d.Executor.Cleanup(context.WithoutCancel(ctx), h, executor.CleanupOptions{}); cerr != nil {\n\t\t\tlog.Warn(\"scanner.cleanup_failed\", \"job\", job.ID, \"error\", cerr)\n\t\t}\npackage local\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/executor\"\n)\n\nvar baseNames = map[string]bool{\n\t\"PATH\": true, \"HOME\": true, \"LANG\": true, \"TMPDIR\": true,\n\t\"GIT_TERMINAL_PROMPT\": true, \"GIT_CONFIG_NOSYSTEM\": true, \"GIT_CONFIG_GLOBAL\": true,\n}\n\nvar ghRE = regexp.MustCompile(`(?i)^(GH|GITHUB)_|GITHUB`)\n\n// ardEnv returns the ARD_* entries with the paths as the process sees them.\nfunc ardEnv(h executor.Handle) []string {\n\te := []string{\n\t\t\"ARD_JOB=\" + h.JobID,\n\t\t\"ARD_ISSUE=\" + strconv.Itoa(h.Issue),\n\t\t\"ARD_STAGE=\" + h.Stage,\n\t\t\"ARD_ROLE=\" + h.Role,\n\t\t\"ARD_WORK=\" + h.View.Work,\n\t\t\"ARD_ROLE_DIR=\" + h.View.Role,\n\t}\n\tif h.View.Sidecar != \"\" {\n\t\te = append(e, \"ARD_SIDECAR=\"+h.View.Sidecar)\n\t}\n\treturn e\n}\n\n// hostEnv builds the environment of a host job from scratch. Nothing is\n// inherited from the controller.\nfunc (l *Local) hostEnv(h executor.Handle) []string {\n\treturn append([]string{\n\t\t\"PATH=\" + l.pathEnv,\n\t\t\"HOME=\" + h.Home,\n\t\t\"LANG=C.UTF-8\",\n\t\t\"GOFLAGS=-modcacherw\",\n\t\t\"TMPDIR=\" + h.Home + \"/tmp\",\n\t\t\"GIT_TERMINAL_PROMPT=0\",\n\t\t\"GIT_CONFIG_NOSYSTEM=1\",\n\t\t\"GIT_CONFIG_GLOBAL=/dev/null\",\n\t}, ardEnv(h)...)\n}\n\n// checkEnv validates Command.Env: only AllowEnv names may be added.\nfunc (l *Local) checkEnv(env []string) error {\n\t// One credential per job: the CLI prefers the API key, so a second\n\t// entry would silently win or be ignored.\n\tif len(env) > 1 {\n\t\treturn fmt.Errorf(\"%w: at most one credential per job\", executor.ErrForbiddenEnv)\n\t}\n\tfor _, kv := range env {\n\t\tname, _, ok := strings.Cut(kv, \"=\")\n\t\tswitch {\n\t\tcase !ok || name == \"\":\n\t\t\treturn fmt.Errorf(\"%w: entry without name=value\", executor.ErrForbiddenEnv)\n\t\tcase ghRE.MatchString(name), baseNames[name], strings.HasPrefix(name, \"ARD_\"), name == \"SSH_AUTH_SOCK\":\n\t\t\treturn fmt.Errorf(\"%w: %s\", executor.ErrForbiddenEnv, name)\n\t\tcase !l.allowEnv[name]:\n\t\t\treturn fmt.Errorf(\"%w: %s is not in the allow list\", executor.ErrForbiddenEnv, name)\n\t\t}\n\t}\n\treturn nil\n}\n\nvar secretRE = regexp.MustCompile(`(?i)TOKEN|SECRET|PASSWORD|KEY|CREDENTIAL`)\n\n// checkFixed validates Command.Fixed: only AllowFixed names, and never the\n// executor's own, GitHub or secret-shaped names.\nfunc (l *Local) checkFixed(env []string) error {\n\tfor _, kv := range env {\n\t\tname, _, ok := strings.Cut(kv, \"=\")\n\t\tswitch {\n\t\tcase !ok || name == \"\":\n\t\t\treturn fmt.Errorf(\"%w: entry without name=value\", executor.ErrForbiddenEnv)\n\t\tcase ghRE.MatchString(name), baseNames[name], strings.HasPrefix(name, \"ARD_\"), name == \"SSH_AUTH_SOCK\", secretRE.MatchString(name):\n\t\t\treturn fmt.Errorf(\"%w: %s\", executor.ErrForbiddenEnv, name)\n\t\tcase !l.allowFixed[name]:\n\t\t\treturn fmt.Errorf(\"%w: %s is not in the fixed allow list\", executor.ErrForbiddenEnv, name)\n\t\t}\n\t}\n\treturn nil\n}\n\n// checkConfigDir keeps a job on its own config dir. A Fixed entry for the\n// config-dir variable must equal View.ConfigDir, and a prepared dir must\n// still be the empty 0700 directory Prepare made.\nfunc (l *Local) checkConfigDir(h executor.Handle, fixed []string) error {\n\tfor _, kv := range fixed {\n\t\tname, val, _ := strings.Cut(kv, \"=\")\n\t\tif name == l.configDirEnv && (h.View.ConfigDir == \"\" || val != h.View.ConfigDir) {\n\t\t\treturn fmt.Errorf(\"%w: %s must be the job config dir\", executor.ErrForbiddenEnv, name)\n\t\t}\n\t}\n\tif h.View.ConfigDir == \"\" {\n\t\treturn nil\n\t}\n\tp := filepath.Join(h.Home, configDirName)\n\twant := p\n\tif h.Kind == \"docker\" {\n\t\twant = \"/ard-config\"\n\t}\n\tif h.View.ConfigDir != want {\n\t\treturn fmt.Errorf(\"%w: config dir %q, want %q\", executor.ErrNotPrepared, h.View.ConfigDir, want)\n\t}\n\tif rel, err := filepath.Rel(l.root, h.Home); err != nil || rel == \"..\" || strings.HasPrefix(rel, \"../\") || rel == \".\" {\n\t\treturn fmt.Errorf(\"%w: job home %s is not under %s\", executor.ErrNotPrepared, h.Home, l.root)\n\t}\n\tif hst, err := os.Lstat(h.Home); err != nil || !hst.IsDir() {\n\t\treturn fmt.Errorf(\"%w: job home %s is not a directory\", executor.ErrNotPrepared, h.Home)\n\t}\n\tfail := func(why string) error {\n\t\treturn fmt.Errorf(\"%w: config dir %s: %s\", executor.ErrNotPrepared, p, why)\n\t}\n\tst, err := os.Lstat(p)\n\tswitch {\n\tcase err != nil:\n\t\treturn fail(err.Error())\n\tcase !st.IsDir():\n\t\treturn fail(\"not a directory\")\n\tcase st.Mode().Perm() != 0o700:\n\t\treturn fail(fmt.Sprintf(\"mode %o, want 700\", st.Mode().Perm()))\n\t}\n\tents, err := os.ReadDir(p)\n\tif err != nil {\n\t\treturn fail(err.Error())\n\t}\n\tif len(ents) != 0 {\n\t\treturn fail(\"not empty\")\n\t}\n\treturn nil\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"74408439-f49d-4817-a8b7-ff57f9f6ddad","uuid":"da7a7f63-944a-475f-8362-d2150aaa9215","timestamp":"2026-11-23T23:00:01.429Z","tool_use_result":{"stdout":"\t// deletes logs and is idempotent.\n\tCleanup(ctx context.Context, h Handle, o CleanupOptions) error\n}\n\n// Job describes one run.\ntype Job struct {\n\tID         string  // ULID minted at claim; ^[0-9A-Za-z]{1,64}$\n\tRepo       string  // \"owner/repo\"\n\tIssue      int     // 0 = scanner run with no issue\n\tStage      string  // \"scanner\" | \"triage\" | \"worker\" | \"review\"\n\tRole       string  // ^[a-z0-9][a-z0-9-]*$\n\tRepoDir    string  // abs path of the controller's clone, already fetched\n\tRef        string  // commit-ish resolved in RepoDir; the worktree is detached at it\n\tRoleDir    string  // abs host path of the role directory\n\tDockerfile string  // abs host path; \"\" = host subprocess\n\tSidecar    Sidecar // zero = none; the executor clones, pins and mounts it read-only\n\tReadOnly   bool    // worktree read-only: Docker mounts :ro, host chmod -R a-w after Prepare\n\tInputs     []File  // written into the worktree by Prepare\n\t// Scrub lists repo-relative paths Prepare removes from the worktree after\n\t// checkout and before Start, so a file at Ref cannot pass for this job's\n\t// own output. Use it for the job's role file: close-out then trusts that\n\t// file only if it exists, because the agent wrote it. Each path must be a\n\t// file directly under .ard/<Issue>/ (Issue >= 1).\n\tScrub   []string\n\tTimeout time.Duration // > 0\n\t// TrustedInput: the job reads no untrusted input (a deterministic\n\t// scanner); only valid with Stage \"scanner\". The zero value means it\n\t// does, so a builder that forgets the field gets the host-mode warning.\n\tTrustedInput bool\n}\n\n// Sidecar is a read-only companion repo the executor clones for the job.\ntype Sidecar struct {\n\tName string // config key, for messages\n\tRepo string // \"owner/name\"\n\tRef  string // branch, tag or full 40-hex SHA (gitref.Check)\n}\n\n// File is a worktree-relative file written 0644 by Prepare.\ntype File struct {\n\tPath string\n\tData []byte\n}\n\n// Paths are the locations as the job process sees them. ConfigDir is the\n// job's empty agent-CLI config dir (host: <home>/.claude; Docker:\n// /ard-config); it is empty on a handle stored before it existed.\ntype Paths struct{ Work, Role, Sidecar, ConfigDir string }\n\n// Command is what to run. Paths must come from Handle.View.\ntype Command struct {\n\tPath string\n\tArgs []string\n\tEnv  []string // \"NAME=value\" secrets; only names the executor allows (AllowEnv)\n\t// Fixed holds non-secret \"NAME=value\" settings the CLI needs (for example\n\t// an agent adapter's config dir). Only names on the executor's AllowFixed\n\t// list are accepted; the executor's own names, GitHub credentials and\n\t// secret-shaped names are always refused.\n\tFixed []string\n\tStdin io.Reader\n}\n\