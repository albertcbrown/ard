), \"scan\"))\n\tcmd.Dir = work\n\tcmd.Env = []string{\"PATH=\" + os.Getenv(\"PATH\"), \"TMPDIR=\" + tmp, \"ARD_HISTORY=\" + bare, \"HOME=\" + work}\n\tvar so, se strings.Builder\n\tcmd.Stdout, cmd.Stderr = &so, &se\n\tif err := cmd.Run(); err != nil {\n\t\tt.Fatalf(\"scan: %v\\n%s\", err, se.String())\n\t}\n\tif n := strings.Count(so.String(), \"\\n\"); n != 1 {\n\t\tt.Fatalf(\"want one finding, got %d: %s\", n, so.String())\n\t}\n\tfor _, s := range []string{id, key} {\n\t\tif strings.Contains(so.String(), s) || strings.Contains(se.String(), s) {\n\t\t\tt.Error(\"secret leaked\")\n\t\t}\n\t}\n\tthTmpEmpty(t, tmp)\n}\nE\ngo test -run TestTrufflehogHistory -v . 2>&1 | grep -v \"^=== \" | tail -20"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1548,"cache_read_input_tokens":27879,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1548},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"55770d8f-210b-4e4f-bcea-84f01a44058e","uuid":"94b155eb-79af-41d9-821c-0c995b4f987e","timestamp":"2026-11-24T11:52:51.838Z","request_id":"req_011ChMhuqEuHEvQ2WNDwLMFp"}
