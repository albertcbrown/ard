{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Xb1xpHc1hDKrHKpVjjUpJo","type":"tool_result","content":"// Package executor defines the contract for running one agent job somewhere\n// and reporting back. It holds plain data types only and imports nothing from\n// config, state, agent or github, so other executors (Kubernetes, Phase 3)\n// can implement the same five calls.\npackage executor\n\nimport (\n\t\"context\"\n\t\"io\"\n\t\"time\"\n)\n\n// Executor runs one agent job. The controller keeps the Handle (as JSON) and\n// passes it back on every call; the executor keeps no durable state.\ntype Executor interface {\n\t// Prepare creates the workspace, writes inputs and opens log files. It\n\t// starts no process.\n\tPrepare(ctx context.Context, j Job) (Handle, error)\n\t// Start launches c without blocking. The ctx does not bound the process:\n\t// only the job deadline and Cleanup stop it.\n\tStart(ctx context.Context, h Handle, c Command) (Handle, error)\n\tStatus(ctx context.Context, h Handle) (Status, error)\n\tLogs(ctx context.Context, h Handle, o LogsOptions) (io.ReadCloser, error)\n\t// Cleanup stops the process if needed and removes the workspace. It never\n\t// deletes logs and is idempotent.\n\tCleanup(ctx context.Context, h Handle, o CleanupOptions) error\n}\n\n// Job describes one run.\ntype Job struct {\n\tID         string  // ULID minted at claim; ^[0-9A-Za-z]{1,64}$\n\tRepo       string  // \"owner/repo\"\n\tIssue      int     // 0 = scanner run with no issue\n\tStage      string  // \"scanner\" | \"triage\" | \"worker\" | \"review\"\n\tRole       string  // ^[a-z0-9][a-z0-9-]*$\n\tRepoDir    string  // abs path of the controller's clone, already fetched\n\tRef        string  // commit-ish resolved in RepoDir; the worktree is detached at it\n\tRoleDir    string  // abs host path of the role directory\n\tDockerfile string  // abs host path; \"\" = host subprocess\n\tSidecar    Sidecar // zero = none; the executor clones, pins and mounts it read-only\n\tReadOnly   bool    // worktree read-only: Docker mounts :ro, host chmod -R a-w after Prepare\n\tInputs     []File  // written into the worktree by Prepare\n\t// Scrub lists repo-relative paths Prepare removes from the worktree after\n\t// checkout and before Start, so a file at Ref cannot pass for this job's\n\t// own output. Use it for the job's role file: close-out then trusts that\n\t// file only if it exists, because the agent wrote it. Each path must be a\n\t// file directly under .ard/<Issue>/ (Issue >= 1).\n\tScrub   []string\n\tTimeout time.Duration // > 0\n\t// TrustedInput: the job reads no untrusted input (a deterministic\n\t// scanner); only valid with Stage \"scanner\". The zero value means it\n\t// does, so a builder that forgets the field gets the host-mode warning.\n\tTrustedInput bool\n}\n\n// Sidecar is a read-only companion repo the executor clones for the job.\ntype Sidecar struct {\n\tName string // config key, for messages\n\tRepo string // \"owner/name\"\n\tRef  string // branch, tag or full 40-hex SHA (gitref.Check)\n}\n\n// File is a worktree-relative file written 0644 by Prepare.\ntype File struct {\n\tPath string\n\tData []byte\n}\n\n// Paths are the locations as the job process sees them. ConfigDir is the\n// job's empty agent-CLI config dir (host: <home>/.claude; Docker:\n// /ard-config); it is empty on a handle stored before it existed.\ntype Paths struct{ Work, Role, Sidecar, ConfigDir string }\n\n// Command is what to run. Paths must come from Handle.View.\ntype Command struct {\n\tPath string\n\tArgs []string\n\tEnv  []string // \"NAME=value\" secrets; only names the executor allows (AllowEnv)\n\t// Fixed holds non-secret \"NAME=value\" settings the CLI needs (for example\n\t// an agent adapter's config dir). Only names on the executor's AllowFixed\n\t// list are accepted; the executor's own names, GitHub credentials and\n\t// secret-shaped names are always refused.\n\tFixed []string\n\tStdin io.Reader\n}\n\n// Handle identifies a prepared or running job. It is JSON-serialisable and\n// holds no env values or secrets.\ntype Handle struct {\n\tJobID, Kind         string // Kind: \"host\" | \"docker\"\n\tIssue               int\n\tStage, Role         string\n\tWorktree, Home      string\n\tRepoDir             string\n\tBaseSHA             string\n\tLogPath, StdoutPath string\n\tView                Paths\n\tImage, Container    string\n\tPID                 int\n\tProcStart           string\n\tPreparedAt          time.Time\n\tStartedAt, Deadline time.Time\n\tReadOnly            bool\n\tTimeout             time.Duration\n\tRoleDir, SidecarDir string  // host paths; SidecarDir is the executor's output (<Home>/sidecar), \"\" = none\n\tSidecar             Sidecar // copied from Job; zero on a handle stored before sidecars\n\tSidecarSHA          string  // the commit the job sees; \"\" = no sidecar\n\tTrustedInput        bool    // copied from Job by Prepare\n\t// Scrubbed lists the Job.Scrub paths Prepare removed from the worktree.\n\t// Close-out trusts an unchanged role file only if it is listed here.\n\tScrubbed []string\n}\n\n// State is the lifecycle state of a job.\ntype State string\n\nconst (\n\tPrepared State = \"prepared\"\n\tRunning  State = \"running\"\n\tExited   State = \"exited\"\n\tTimedOut State = \"timed_out\"\n\t// Orphaned: alive with a verified start time but not tracked by this\n\t// process (the controller restarted).\n\tOrphaned State = \"orphaned\"\n\t// Gone: not tracked and not alive; no exit code known.\n\tGone State = \"gone\"\n)\n\n// Terminal reports whether the job will not change state again.\nfunc (s State) Terminal() bool { return s == Exited || s == TimedOut || s == Gone }\n\n// Status is a snapshot of a job.\ntype Status struct {\n\tState      State\n\tExitCode   int    // -1 if killed by a signal\n\tSignal     string // e.g. \"killed\"; \"\" if exited normally\n\tAlive      bool\n\tLastOutput time.Time // mtime of the combined log\n\tStartedAt  time.Time\n\tFinishedAt time.Time\n\tReason     string\n}\n\n// LogStream selects which log file Logs reads.\ntype LogStream int\n\nconst (\n\tCombined LogStream = iota\n\tStdout\n)\n\n// LogsOptions selects a stream and an optional tail.\ntype LogsOptions struct {\n\tStream    LogStream\n\tTailLines int // 0 = whole file\n}\n\n// CleanupOptions tunes Cleanup.\ntype CleanupOptions struct{ KeepWorktree bool }\n\n// WaitFor polls Status until the state is terminal or ctx ends.\nfunc WaitFor(ctx context.Context, ex Executor, h Handle, every time.Duration) (Status, error) {\n\tif every <= 0 {\n\t\tevery = 100 * time.Millisecond\n\t}\n\tt := time.NewTicker(every)\n\tdefer t.Stop()\n\tfor {\n\t\tst, err := ex.Status(ctx, h)\n\t\tif err != nil {\n\t\t\treturn st, err\n\t\t}\n\t\tif st.State.Terminal() {\n\t\t\treturn st, nil\n\t\t}\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn st, ctx.Err()\n\t\tcase <-t.C:\n\t\t}\n\t}\n}\nbytesreader.go\ncleanup_test.go\nconfigdir_test.go\ndocker.go\ndocker_integration_test.go\nenv.go\ngit.go\nhostwarn.go\nhostwarn_test.go\nlayout.go\nlocal.go\nlocal_test.go\nmisc_test.go\nproc_other.go\nproc_unix.go\nsidecar.go\nsidecar_test.go\ntail.go\ntestdata\nzombie_linux.go\nzombie_linux_test.go\nzombie_other.go\nzombie_test.go\n       8 executor/local/bytesreader.go\n     101 executor/local/cleanup_test.go\n     260 executor/local/configdir_test.go\n     131 executor/local/docker.go\n      88 executor/local/docker_integration_test.go\n     139 executor/local/env.go\n     112 executor/local/git.go\n      60 executor/local/hostwarn.go\n     134 executor/local/hostwarn_test.go\n      50 executor/local/layout.go\n     456 executor/local/local.go\n     792 executor/local/local_test.go\n     154 executor/local/misc_test.go\n       6 executor/local/proc_other.go\n     328 executor/local/proc_unix.go\n     166 executor/local/sidecar.go\n     433 executor/local/sidecar_test.go\n      48 executor/local/tail.go\n      32 executor/local/zombie_linux.go\n      28 executor/local/zombie_linux_test.go\n       7 executor/local/zombie_other.go\n      49 executor/local/zombie_test.go\n    3582 total\n40-  # Leaked credentials go straight to a human: route: needs-human files without\n41-  # ard:pending, so no agent triages them.\n42:  scanners/trufflehog: { every: 24h, max_open: 5, group_size: 1, autoclose: true, route: needs-human, timeout: 30m }\n43-  triage/lead:  { model: claude-opus-5-5, timeout: 15m }\n44-  triage/product-manager: { model: claude-opus-5-5 }\n45-  triage/architect: { model: claude-opus-5-5, after: [product-manager] }\n46-  triage/designer: { model: claude-haiku-5-5 }\n47-  triage/documentation-planner: { model: claude-haiku-5-5, after: [designer] }\n48-  triage/engineer: { model: claude-sonnet-5-5, after: [architect, documentation-planner] }\n49-  # timeout covers the whole worker job (agent, tests, fix rounds). tests is your\n50-  # repo's test command; \"\" turns the test step off. Over diff_warn_lines changed\n51-  # lines the PR goes ahead with a \"Large change\" note; over diff_max_lines it is\n52-  # held for a human.\n53-  workers/engineer: { model: claude-sonnet-5-5, timeout: 60m, tests: make test, diff_warn_lines: 1000, diff_max_lines: 2000 }\n54-  reviewers/eng-review: { model: claude-sonnet-5-5 }\nroles/roles.go:10:// directories (scanners/cve, scanners/docs, scanners/error-codes, scanners/lint, scanners/trufflehog, triage/lead, triage/engineer, triage/product-manager, triage/architect, triage/designer, triage/documentation-planner, workers/engineer, reviewers/eng-review, reviewers/license-review and reviewers/security-review); paths are relative to .ard/.\nroles/roles.go:14://go:embed config.yaml reviewers scanners/cve scanners/docs scanners/error-codes scanners/lint scanners/trufflehog triage workers\ninitcmd/body.go:39:\tb.WriteString(\"- `scanners/trufflehog` is included. It files leaked-credential issues for a human (never for an agent) and needs a TruffleHog binary (AGPL-