roposes: config.yaml plus the role\n-// directories (scanners/cve, scanners/docs, scanners/error-codes, scanners/lint, scanners/trufflehog, triage/lead, triage/engineer, triage/product-manager, triage/architect, triage/designer, triage/documentation-planner, workers/engineer, reviewers/eng-review, reviewers/license-review, reviewers/product-manager-review and reviewers/security-review); paths are relative to .ard/.\n+// directories (scanners/cve, scanners/docs, scanners/error-codes, scanners/lint, scanners/trufflehog, scanners/trufflehog-history, triage/lead, triage/engineer, triage/product-manager, triage/architect, triage/designer, triage/documentation-planner, workers/engineer, reviewers/eng-review, reviewers/license-review, reviewers/product-manager-review and reviewers/security-review); paths are relative to .ard/.\n //\n // scanners/missing-tests is left out until its scan driver exists; re-add it when wiring it in.\n //\n-//go:embed config.yaml reviewers scanners/cve scanners/docs scanners/error-codes scanners/lint scanners/trufflehog triage workers\n+//go:embed config.yaml reviewers scanners/cve scanners/docs scanners/error-codes scanners/lint scanners/trufflehog scanners/trufflehog-history triage workers\n var FS embed.FS\n \n // ExecutableNames lists base names that must be written 0755.\ndiff --git a/internal/roles/roles_test.go b/internal/roles/roles_test.go\nindex 1355908..d47b484 100644\n--- a/internal/roles/roles_test.go\n+++ b/internal/roles/roles_test.go\n@@ -29,7 +29,7 @@ func TestFSContents(t *testing.T) {\n \t\tt.Fatal(err)\n+\t\tt.Errorf(\"exclude-paths differ\")\n+\t}\n+}\ndiff --git a/internal/scanner/engine_exec.go b/internal/scanner/engine_exec.go\nindex 398d6e8..12c4904 100644\n--- a/internal/scanner/engine_exec.go\n+++ b/internal/scanner/engine_exec.go\n@@ -122,6 +122,7 @@ func (x *ExecEngine) Scan(ctx context.Context, cfg *config.Resolved, role config\n \t\tRoleDir: filepath.Join(cfg.Repo, filepath.FromSlash(role.Dir)),\n \t}\n \tej.TrustedInput = !role.ReadsUntrusted()\n+\tej.History = role.ReadsHistory()\n \tif role.Dockerfile != \"\" {\n \t\tej.Dockerfile = filepath.Join(cfg.Repo, filepath.FromSlash(role.Dockerfile))\n \t}\ndiff --git a/internal/scanner/engine_exec_test.go b/internal/scanner/engine_exec_test.go\nindex 958903b..4cf0e46 100644\n--- a/internal/scanner/engine_exec_test.go\n+++ b/internal/scanner/engine_exec_test.go\n@@ -162,6 +162,9 @@ func TestExecEngineScan(t *testing.T) {\n \tif !j.TrustedInput {\n \t\tt.Errorf(\"a deterministic scan must be marked TrustedInput: %+v\", j)\n \t}\n+\tif j.History {\n+\t\tt.Errorf(\"a role without a history marker must not get history: %+v\", j)\n+\t}\n \tif f.ex.cmd.Path != \"/role/scan\" || len(f.ex.cmd.Env) != 0 || len(f.ex.cmd.Fixed) != 0 {\n \t\tt.Errorf(\"command = %+v: no env of any kind may reach a scan\", f.ex.cmd)\n \t}\n@@ -287,3 +290,15 @@ func TestExecEngineShutdownCleansUp(t *testing.T) {\n \t\tt.Errorf(\"cleanup %d, jobs %+v\", f.ex.cleaned, f.jobs)\n \t}\n }\n+\n+func TestExecEngineScanHistory(t *testing.T) {\n+\tf := newEngineFixture()\n+\trole := scannerRole(\"trufflehog-history\")\n+\trole.Extra = []string{\"history\"}\n+\tif _, err := f.eng.Scan(tctx(t), f.cfg, role, time.Unix(500, 0)); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif !f.ex.job.History {\n+\t\tt.Errorf(\"job = %+v, want History\", f.ex.job)\n+\t}\n+}\ntotal 48\ndrwxr-xr-x@ 7 al  staff   224 Nov 24 00:10 .\ndrwxr-xr-x@ 9 al  staff   288 Nov 24 00:10 ..\n-rw-r--r--@ 1 al  staff  2774 Nov 24 00:10 Dockerfile\n-rw-r--r--@ 1 al  staff   290 Nov 24 00:10 exclude-paths\n-rw-r--r--@ 1 al  staff  4385 Nov 24 00:10 findings.jq\n-rw-r--r--@ 1 al  staff     0 Nov 24 00:10 history\n-rwxr-xr-x@ 1 al  staff  5475 Nov 24 00:10 scan\n---\nrole: engineer\nstatus: done\nattempt: 1\n---\nAdds a built-in `scanners/trufflehog-history` scanner that scans the full git history for leaked credentials, and an executor change that gives a scanner job a read-only view of the controller's bare clone. Fingerprints use the same salt as the HEAD scanner, so one value has one fingerprint in both.\n\n## Changes\n- Executor: `Job.History` (scanner stage only), `Paths.History`, `Handle.HistoryDir`. Docker mounts the clone at `/history:ro` with a fixed `safe.directory` git setting. Host mode uses the clone path. `ARD_HISTORY` is set in both.\n- Config: `Role.ReadsHistory()` is true for a deterministic scanner whose directory holds an empty file named `history`. There is no config key, so an override cannot grant it. The scanner engine sets `Job.History` from it.\n- New role `internal/roles/scanners/trufflehog-history/`: Dockerfile (same pins), `scan` (`trufflehog git`, no partial-scan flags, fail-closed, same hash line), `findings.jq` (reads git location, keeps only detector, file and line, with a no-autoclose runbook), `exclude-paths`, `history` marker.\n- Starter: embedded in `roles.go`, override in `config.yaml` (7d, autoclose false, needs-human, 60m, max_open 5), PR-body note in `initcmd/body.go`. `starter()` now sorts by full path, because `trufflehog/` would otherwise precede `trufflehog-history/`.\n- Docs: `proposal.md`, `layout.md`, `TODO.md`.\n- Tests: validation, `Prepare`, docker argv, `ReadsHistory`, engine job, embedded role, and `trufflehog_history_test.go` (fingerprint parity, no leaks, fail-closed, argv, missing tool or `ARD_HISTORY`, zero chunks with commits, Dockerfile and salt parity).\n\n## Testing\n`go test ./...` passes. I did not run `make lint`. `gofmt -l` flags only the existing `internal/roles/testdata/docs/skips/src/_x.go`, a deliberately broken fixture.\n\n## Open issues\n- The Docker integration test from the plan (git log in a container, write to `/history` fails) was not added. It is untested against real Docker, including whether `safe.directory` is needed.\n- The read-only clone mount exposes every fetched ref, including unmerged PR branches. A maintainer should confirm the mount over a bundle.\n- Whether a value found by both scanners becomes one issue depends on the scanner engine's cross-role handling, which this change does not touch.\n- Enabling the scanner in this repository needs a maintainer-made copy under `.ard/scanners/` and an entry in `.ard/config.yaml`.\n- No Kubernetes executor exists yet; only a comment on `Paths.History` and `proposal.md` document the contract.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01BjYErPf2vvj5SQvY1fn2M2","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
