{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Kd8o1kyuEQz9JG6UaCf3ns","type":"tool_result","content":"457\t+\t\t\tt.Errorf(\"unexpected role: %+v\", r)\n458\t+\t\t}\n459\t+\t\tif r.Route != config.RouteNeedsHuman || r.Dockerfile != \".ard/scanners/trufflehog-history/Dockerfile\" {\n460\t+\t\t\tt.Errorf(\"Route %v, Dockerfile %q\", r.Route, r.Dockerfile)\n461\t+\t\t}\n462\t+\t\tif !r.ReadsHistory() {\n463\t+\t\t\tt.Errorf(\"ReadsHistory = false; Extra = %v\", r.Extra)\n464\t+\t\t}\n465\t+\t\treturn\n466\t+\t}\n467\t+\tt.Fatal(\"no scanner role trufflehog-history\")\n468\t+}\n469\t+\n470\t+func TestHeadTrufflehogDoesNotReadHistory(t *testing.T) {\n471\t+\tres, err := config.LoadFS(starterFS(t, true), \"/repo\")\n472\t+\tif err != nil {\n473\t+\t\tt.Fatal(err)\n474\t+\t}\n475\t+\tfor _, r := range res.Roles {\n476\t+\t\tif r.Name != \"trufflehog-history\" && r.ReadsHistory() {\n477\t+\t\t\tt.Errorf(\"role %s reads history\", r.Name)\n478\t+\t\t}\n479\t+\t}\n480\t+}\n481\tdiff --git a/internal/roles/scanners/trufflehog-history/Dockerfile b/internal/roles/scanners/trufflehog-history/Dockerfile\n482\tnew file mode 100644\n483\tindex 0000000..75017f7\n484\t--- /dev/null\n485\t+++ b/internal/roles/scanners/trufflehog-history/Dockerfile\n486\t@@ -0,0 +1,49 @@\n487\t+# Pinned tool image for the trufflehog-history scanner. Versions verified 2026-11-23:\n488\t+#   trufflehog 3.100.0 (released 2026-11-19), jq 1.8.2.\n489\t+# The trufflehog tarball checksums come from trufflehog_3.100.0_checksums.txt,\n490\t+# whose signature was verified on 2026-11-23 with cosign v3.1.4 (\"Verified OK\"):\n491\t+#   cosign verify-blob trufflehog_3.100.0_checksums.txt \\\n492\t+#     --certificate trufflehog_3.100.0_checksums.txt.pem \\\n493\t+#     --signature trufflehog_3.100.0_checksums.txt.sig \\\n494\t+#     --certificate-identity-regexp 'https://github\\.com/trufflesecurity/trufflehog/' \\\n495\t+#     --certificate-oidc-issuer https://token.actions.githubusercontent.com\n496\t+# jq's checksums are the ones in scanners/cve/Dockerfile.\n497\t+# The base is the same golang:1.27.4-trixie index digest as cve and the ard\n498\t+# image (root Dockerfile), so the layers are shared.\n499\t+#\n500\t+# LICENCE: trufflehog is AGPL-3.0. It is downloaded into this role's image only;\n501\t+# the binary is NOT in the published ard image.\n502\t+#\n503\t+# The image does NOT copy `scan` or `findings.jq`: the executor mounts this role\n504\t+# directory read-only, so the mounted script is always the one that runs.\n505\t+# Run:  docker run --rm -v \"$PWD\":/repo:ro -v <role dir>:/role:ro -w /repo IMAGE /role/scan\n506\t+\n507\t+ARG GO_IMAGE=golang:1.27.4-trixie@sha256:f18c3d73a184fb0582828510722e723b63a93f7188d11dd223d9be6f6880e65d\n508\t+\n509\t+FROM ${GO_IMAGE} AS tools\n510\t+ARG TARGETARCH\n511\t+ARG TRUFFLEHOG_VERSION=3.100.0\n512\t+ARG TRUFFLEHOG_SHA256_AMD64=b2d85eba59865e98f45c9fc9f77d2c6d62df529fdd5755af121304ea5a7cecbb\n513\t+ARG TRUFFLEHOG_SHA256_ARM64=aa61657049229ae523e8455fcbba87dff57b0a2ba6bdb391a38cf75e6d4016dd\n514\t+ARG JQ_VERSION=1.8.2\n515\t+ARG JQ_SHA256_AMD64=b1c22172dd303f3be49e935aa56aa48a8b7a46e0bc838b4997d3bb451495870f\n516\t+ARG JQ_SHA256_ARM64=8b85c817833814ddca00a144c33705546355afccf0cf39b188f3cdb48b852309\n517\t+RUN set -eu; \\\n518\t+    case \"${TARGETARCH}\" in \\\n519\t+      amd64) th_sha=\"${TRUFFLEHOG_SHA256_AMD64}\"; jq_sha=\"${JQ_SHA256_AMD64}\" ;; \\\n520\t+      arm64) th_sha=\"${TRUFFLEHOG_SHA256_ARM64}\"; jq_sha=\"${JQ_SHA256_ARM64}\" ;; \\\n521\t+      *) echo \"unsupported arch: ${TARGETARCH}\" >&2; exit 1 ;; \\\n522\t+    esac; \\\n523\t+    mkdir /out; \\\n524\t+    curl -fsSL -o /tmp/th.tgz \"https://github.com/trufflesecurity/trufflehog/releases/download/v${TRUFFLEHOG_VERSION}/trufflehog_${TRUFFLEHOG_VERSION}_linux_${TARGETARCH}.tar.gz\"; \\\n525\t+    echo \"${th_sha}  /tmp/th.tgz\" | sha256sum -c -; \\\n526\t+    tar -xzf /tmp/th.tgz -C /out trufflehog; \\\n527\t+    curl -fsSL -o /out/jq \"https://github.com/jqlang/jq/releases/download/jq-${JQ_VERSION}/jq-linux-${TARGETARCH}\"; \\\n528\t+    echo \"${jq_sha}  /out/jq\" | sha256sum -c -; \\\n529\t+    chmod 0755 /out/trufflehog /out/jq\n530\t+\n531\t+FROM ${GO_IMAGE}\n532\t+COPY --from=tools /out/trufflehog /usr/local/bin/trufflehog\n533\t+COPY --from=tools /out/jq /usr/local/bin/jq\n534\t+# The executor's /tmp is a noexec tmpfs; keep the temp dir in /var/tmp.\n535\t+ENV TMPDIR=/var/tmp\n536\tdiff --git a/internal/roles/scanners/trufflehog-history/exclude-paths b/internal/roles/scanners/trufflehog-history/exclude-paths\n537\tnew file mode 100644\n538\tindex 0000000..b83ab0b\n539\t--- /dev/null\n540\t+++ b/internal/roles/scanners/trufflehog-history/exclude-paths\n541\t@@ -0,0 +1,6 @@\n542\t+# trufflehog path regexes (Go RE2), one per line, matched against repo-relative\n543\t+# paths. Human-owned: change it in a reviewed PR. scan drops # lines and blanks.\n544\t+# .ard/<n>/logs/ were secret-scanned at close-out (model signature blobs are noise).\n545\t+^\\.ard/[0-9]+/logs/\n546\t+^vendor/\n547\t+^node_modules/\n548\tdiff --git a/internal/roles/scanners/trufflehog-history/findings.jq b/internal/roles/scanners/trufflehog-history/findings.jq\n549\tnew file mode 100644\n550\tindex 0000000..f4546a9\n551\t--- /dev/null\n552\t+++ b/internal/roles/scanners/trufflehog-history/findings.jq\n553\t@@ -0,0 +1,60 @@\n554\t+# project: trufflehog --json result lines in; one \"<base64 secret>\\t<json>\" line out\n555\t+#          per result. The json holds only d (DetectorName), f (file), l (line).\n556\t+#          Errors carry fixed text only (scan drops this stage's stderr anyway).\n557\t+# merge:   \"<h16>\\t<json>\" lines in (-n -R, inputs); findings out.\n558\t+def die(m): error(\"trufflehog: \" + m);\n559\t+\n560\t+def project:\n561\t+  if type != \"object\" then die(\"result is not an object\") else . end\n562\t+  | (.SourceMetadata.Data.Git // die(\"result has no git location\")) as $fs\n563\t+  | (if (.Raw | type) == \"string\" and .Raw != \"\" then .Raw\n564\t+     elif (.RawV2 | type) == \"string\" and .RawV2 != \"\" then .RawV2\n565\t+     else die(\"result has no Raw or RawV2 value\") end) as $secret\n566\t+  | (.DetectorName | if type == \"string\" and test(\"^[A-Za-z0-9_.-]{1,64}$\") then . else die(\"bad detector name\") end) as $d\n567\t+  | ($fs.file | if type == \"string\" then ltrimstr(\"./\") else die(\"result file is not a string\") end) as $f\n568\t+  | if $f == \"\" or ($f | startswith(\"/\")) or ($f | split(\"/\") | any(. == \"..\" or . == \".\" or . == \"\"))\n569\t+       or ($f | explode | any(. < 32 or . == 127))\n570\t+    then die(\"result file is not a clean repo-relative path\") else . end\n571\t+  | ($fs.line // 0 | if type == \"number\" and . >= 0 then floor else die(\"bad line\") end) as $l\n572\t+  | \"\\($secret | @base64)\\t\\({d: $d, f: $f, l: $l} | tojson)\";\n573\t+\n574\t+# A code span whose fence is longer than any backtick run in the text.\n575\t+def code: ([match(\"`+\"; \"g\").length] | max // 0) as $n | (\"`\" * ($n + 1)) as $fence\n576\t+  | if $n > 0 then \"\\($fence) \\(.) \\($fence)\" else \"\\($fence)\\(.)\\($fence)\" end;\n577\t+\n578\t+def merge($allow):\n579\t+  [inputs | select(length > 0) | split(\"\\t\")\n580\t+   | if length != 2 or (.[0] | test(\"^[0-9a-f]{16}$\") | not) then die(\"bad hashed line\") else . end\n581\t+   | {h: .[0]} + (.[1] | fromjson)]\n582\t+  | map(select((\"trufflehog:\" + .h) as $fp | $allow | index($fp) | not))\n583\t+  | group_by(.h)\n584\t+  | map((\"trufflehog:\" + .[0].h) as $fp\n585\t+      | (map(.d) | unique) as $dets\n586\t+      | (map({f, l}) | unique_by([.f, .l]) | sort_by(.f, .l)) as $locs\n587\t+      | ($locs | map(.f) | unique) as $files\n588\t+      | {fingerprint: $fp,\n589\t+         title: (\"Possible \\($dets[0]) credential in \\($files[0])\" | .[0:200]),\n590\t+         severity: \"high\", group: \"\", files: $files[0:1000],\n591\t+         body: ([\n592\t+           \"trufflehog matched a value that looks like a credential (detector: \\($dets | map(code) | join(\", \"))). ard did not verify it and never stores or prints the value.\",\n593\t+           \"\",\n594\t+           \"**Treat it as leaked.** Revoke or rotate it at the provider first. The value is in git history, possibly only on an unmerged branch ard fetched (it may not have reached main), so removing it from HEAD does not revoke it, and on a public repository it is already public.\",\n595\t+           \"\",\n596\t+           \"**Do not add `ard:pending` to this issue before the credential is rotated.** Triage and worker agents would read the file that holds it.\",\n597\t+           \"\",\n598\t+           \"What to do: 1. Rotate or revoke the credential at the provider. 2. Closing this issue does not remove the value from history; rotation is what makes that safe. Rewriting history is a separate decision for a maintainer. 3. This issue never closes itself: close it by hand once the credential is rotated. 4. For a false positive or a test fixture, add the fingerprint to `allow` or the path to `exclude-paths` (a reviewed PR), or close as not planned (it refiles after 90 days). 5. At 5 open issues the scanner does not run, so close handled ones by hand.\",\n599\t+           \"\",\n600\t+           \"Not a secret? A maintainer adds the fingerprint below to `.ard/scanners/trufflehog-history/allow`, or a path pattern to `.ard/scanners/trufflehog-history/exclude-paths`, in a reviewed PR. Inline `trufflehog:ignore` comments are not honoured.\",\n601\t+           \"\",\n602\t+           \"Fingerprint: `\\($fp)`\",\n603\t+           \"\",\n604\t+           \"Locations in history (file and line only; commits are not listed) (\\($locs | length)):\"]\n605\t+           + ($locs[0:50] | map(\"- \\(.f | code)\" + (if .l > 0 then \" line \\(.l)\" else \"\" end)))\n606\t+           + (if ($locs | length) > 50 then [\"- and \\(($locs | length) - 50) more\"] else [] end)\n607\t+           + (if ($files | length) > 1000 then [\"\", \"Only the first 1,000 of \\($files | length) files are listed.\"] else [] end)\n608\t+           | join(\"\\n\"))})\n609\t+  | sort_by(.fingerprint) | .[];\n610\t+\n611\t+if $stage == \"project\" then project\n612\t+elif $stage == \"merge\" then merge($allow | split(\"\\n\") | map(sub(\"#.*$\"; \"\") | gsub(\"^\\\\s+|\\\\s+$\"; \"\")) | map(select(. != \"\")))\n613\t+else die(\"unknown stage\") end\n614\tdiff --git a/internal/roles/scanners/trufflehog-history/history b/internal/roles/scanners/trufflehog-history/history\n615\tnew file mode 100644\n616\tindex 0000000..e69de29\n617\tdiff --git a/internal/roles/scanners/trufflehog-history/scan b/internal/roles/scanners/trufflehog-history/scan\n618\tnew file mode 100755\n619\tindex 0000000..1ef920c\n620\t--- /dev/null\n621\t+++ b/internal/roles/scanners/trufflehog-history/scan\n622\t@@ -0,0 +1,115 @@\n623\t+#!/bin/sh\n624\t+# trufflehog-history scanner: files leaked-credential findings for a human,\n625\t+# from the full git history.\n626\t+#\n627\t+# Contract: run with $ARD_HISTORY set to a read-only bare clone with every fetched ref. Sibling\n628\t+# files (findings.jq, exclude-paths, allow) are found from this script's own\n629\t+# path. Writes only to a temp dir. Needs no token. stdout (JSON lines, one\n630\t+# finding each) is printed only at the very end. Exit 0 = ok, 1 = failed\n631\t+# (nothing on stdout), 2 = a required tool is missing.\n632\t+#\n633\t+# Owner rules: no verification (--no-verification: no credential is ever sent\n634\t+# to a provider); every commit of every ref (trufflehog git on $ARD_HISTORY); only DetectorName,\n635\t+# the file, the line and a hash of the secret leave the project stage: Raw,\n636\t+# RawV2, Redacted, SecretParts, ExtraData, StructuredData and the rest never\n637\t+# leave this script. The secret exists only in pipes: never in a file, argv,\n638\t+# stdout or stderr. --no-ignore-tag: inline trufflehog:ignore is not honoured.\n639\t+#\n640\t+# Human-owned files next to this script: exclude-paths (regexes) and allow\n641\t+# (one trufflehog:<16 hex> fingerprint per line, # comments). A bad allow\n642\t+# entry fails the run. .git is always excluded.\n643\t+#\n644\t+# The commit, author email and timestamp trufflehog reports are dropped too.\n645\t+# Fingerprints use the same salt as scanners/trufflehog, so one value is one fingerprint in both.\n646\t+#\n647\t+# Never pass --since-commit, --max-depth, --branch, --detector-timeout, --archive-timeout,\n648\t+# --filter-unverified, --filter-entropy, --filter-* or --results: a partial or\n649\t+# load-dependent result would make the pipeline autoclose live findings.\n650\t+# Never use set -x: it would print the secret.\n651\t+set -eu\n652\t+dir=$(CDPATH= cd -- \"$(dirname -- \"$0\")\" && pwd)\n653\t+die() { echo \"trufflehog: $*\" >&2; exit 1; }\n654\t+need() { command -v \"$1\" >/dev/null 2>&1 || { echo \"trufflehog: $1 not found\" >&2; exit 2; }; }\n655\t+need trufflehog\n656\t+need jq\n657\t+need git\n658\t+if command -v sha256sum >/dev/null 2>&1; then sha() { sha256sum; }\n659\t+elif command -v shasum >/dev/null 2>&1; then sha() { shasum -a 256; }\n660\t+else echo \"trufflehog: sha256sum not found\" >&2; exit 2; fi\n661\t+\n662\t+tmp=$(mktemp -d \"${TMPDIR:-/tmp}/ard-trufflehog-history.XXXXXX\")\n663\t+trap 'rm -rf \"$tmp\"' EXIT\n664\t+trap 'exit 130' INT\n665\t+trap 'exit 143' TERM\n666\t+\n667\t+[ -n \"${ARD_HISTORY:-}\" ] && [ -d \"$ARD_HISTORY\" ] || { echo \"trufflehog: ARD_HISTORY is not a directory\" >&2; exit 2; }\n668\t+\n669\t+echo \"trufflehog: $(trufflehog --version 2>&1 | head -n 1 || true)\" >&2\n670\t+\n671\t+# Exclusions: .git always, then the human-owned file without comments or blanks.\n672\t+printf '%s\\n' '^\\.git(/|$)' > \"$tmp/exclude\"\n673\t+if [ -e \"$dir/exclude-paths\" ]; then\n674\t+  grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' \"$dir/exclude-paths\" >> \"$tmp/exclude\" || true\n675\t+fi\n676\t+allow=$tmp/allow.txt\n677\t+: > \"$allow\"\n678\t+[ ! -e \"$dir/allow\" ] || cat \"$dir/allow\" > \"$allow\"\n679\t+jq -n -R --rawfile allow \"$allow\" '$allow | split(\"\\n\") | map(sub(\"#.*$\"; \"\") | gsub(\"^\\\\s+|\\\\s+$\"; \"\"))\n680\t+  | map(select(. != \"\")) | if any(test(\"^trufflehog:[0-9a-f]{16}$\") | not) then error(\"bad\") else empty end' 2>/dev/null \\\n681\t+  || die \"allow: every entry must be trufflehog:<16 hex digits> (comments start with #)\"\n682\t+\n683\t+tab=$(printf '\\t')\n684\t+# The secret exists only in these pipes: never in a file, argv, stdout or stderr.\n685\t+# Each stage records its own status (no pipefail in POSIX sh); \"|| rc=$?\" keeps\n686\t+# set -e from skipping the echo.\n687\t+{\n688\t+  rc=0\n689\t+  trufflehog git \"file://$ARD_HISTORY\" --bare --json --no-update --no-color --no-verification \\\n690\t+    --no-ignore-tag --fail-on-scan-errors --concurrency=2 -x \"$tmp/exclude\" \\\n691\t+    2>\"$tmp/th.err\" || rc=$?\n692\t+  echo \"$rc\" > \"$tmp/th.rc\"\n693\t+} | {\n694\t+  rc=0\n695\t+  # stderr dropped: a jq type error can quote the input, which holds the secret.\n696\t+  jq -r --arg stage project --arg allow \"\" -f \"$dir/findings.jq\" 2>/dev/null || rc=$?\n697\t+  echo \"$rc\" > \"$tmp/project.rc\"\n698\t+} | {\n699\t+  rc=0\n700\t+  while IFS=$tab read -r pre rest; do\n701\t+    h=$(printf 'ard-trufflehog-v1\\000%s' \"$pre\" | sha | cut -c1-16) || { rc=1; break; }\n702\t+    case $h in *[!0-9a-f]*|'') rc=1; break ;; esac\n703\t+    [ ${#h} -eq 16 ] || { rc=1; break; }\n704\t+    printf '%s\\t%s\\n' \"$h\" \"$rest\"\n705\t+  done\n706\t+  echo \"$rc\" > \"$tmp/hash.rc\"\n707\t+} > \"$tmp/hashed.tsv\"\n708\t+\n709\t+rcof() { [ -s \"$tmp/$1.rc\" ] && cat \"$tmp/$1.rc\" || echo missing; }\n710\t+th=$(rcof th)\n711\t+if [ \"$th\" != 0 ]; then\n712\t+  jq -r 'select(.level == \"error\") | \"trufflehog: \\(.msg // \"\") \\((.error // \"\") | tostring | .[0:200])\"' \\\n713\t+    \"$tmp/th.err\" 2>/dev/null | head -n 5 >&2 || true\n714\t+  die \"trufflehog failed (exit status $th)\"\n715\t+fi\n716\t+[ \"$(rcof project)\" = 0 ] || die \"cannot parse trufflehog results\"\n717\t+[ \"$(rcof hash)\" = 0 ] || die \"cannot hash a result\"\n718\t+\n719\t+summary=$(jq -c 'select(.msg == \"finished scanning\") | [.chunks, .verified_secrets, .unverified_secrets]' \\\n720\t+  \"$tmp/th.err\" 2>/dev/null | tail -n 1) || die \"cannot read trufflehog's log\"\n721\t+case $summary in\n722\t+  \\[[0-9]*,[0-9]*,[0-9]*\\]) ;;\n723\t+  *) die \"no \\\"finished scanning\\\" summary from trufflehog\" ;;\n724\t+esac\n725\t+set -- $(echo \"$summary\" | tr -d '[]' | tr ',' ' ')\n726\t+chunks=$1 want=$(($2 + $3))\n727\t+got=$(wc -l < \"$tmp/hashed.tsv\" | tr -d ' ')\n728\t+echo \"trufflehog: $chunks chunk(s), $got result(s)\" >&2\n729\t+if [ \"$chunks\" -eq 0 ] && [ -n \"$(git --git-dir \"$ARD_HISTORY\" rev-list -n 1 --all 2>/dev/null)\" ]; then\n730\t+  die \"trufflehog scanned nothing in a repository that has commits\"\n731\t+fi\n732\t+[ \"$got\" -eq \"$want\" ] || die \"result count $got does not match the summary's $want\"\n733\t+\n734\t+jq -n -R -c --arg stage merge --rawfile allow \"$allow\" -f \"$dir/findings.jq\" \"$tmp/hashed.tsv\" \\\n735\t+  > \"$tmp/out.jsonl\" || die \"merge failed\"\n736\t+echo \"trufflehog: $(wc -l < \"$tmp/out.jsonl\" | tr -d ' ') finding(s)\" >&2\n737\t+cat \"$tmp/out.jsonl\"\n738\tdiff --git a/internal/roles/trufflehog_history_test.go b/internal/roles/trufflehog_history_test.go\n739\tnew file mode 100644\n740\tindex 0000000..e4aa05d\n741\t--- /dev/null\n742\t+++ b/internal/roles/trufflehog_history_test.go\n743\t@@ -0,0 +1,229 @@\n744\t+package roles\n745\t+\n746\t+import (\n747\t+\t\"os\"\n748\t+\t\"os/exec\"\n749\t+\t\"path/filepath\"\n750\t+\t\"regexp\"\n751\t+\t\"strings\"\n752\t+\t\"testing\"\n753\t+)\n754\t+\n755\t+const thHist = \"scanners/trufflehog-history\"\n756\t+\n757\t+func thGitLine(raw, det, file string, line int) thLine {\n758\t+\tl := thResultLine(raw, det, file, line)\n759\t+\tl[\"SourceMetadata\"] = map[string]any{\"Data\": map[string]any{\"Git\": map[string]any{\n760\t+\t\t\"file\": file, \"line\": line, \"commit\": \"commit-marker\", \"email\": \"email-marker\", \"timestamp\": \"ts-marker\", \"repository\": \"repo-marker\"}}}\n761\t+\treturn l\n762\t+}\n763\t+\n764\t+func thHistRun(t *testing.T, out, errlog string, rc int, extra map[string]string) thResult {\n765\t+\tt.Helper()\n766\t+\tif extra == nil {\n767\t+\t\textra = map[string]string{\"ARD_HISTORY\": t.TempDir()}\n768\t+\t}\n769\t+\treturn thRunFull(t, mustAbs(t, thHist), out, errlog, rc, map[string]string{\"a.txt\": \"x\"}, extra)\n770\t+}\n771\t+\n772\t+func TestTrufflehogHistoryFingerprintMatchesHead(t *testing.T) {\n773\t+\thead := thRun(t, thJoin([]thLine{thResultLine(\"canary-raw-alpha\", \"Alpha\", \"a.txt\", 1)}), thSummary(1, 1), 0, map[string]string{\"a.txt\": \"x\"}, nil)\n774\t+\thist := thHistRun(t, thJoin([]thLine{thGitLine(\"canary-raw-alpha\", \"Alpha\", \"old/b.txt\", 7)}), thSummary(1, 1), 0, nil)\n775\t+\tif head.code != 0 || hist.code != 0 {\n776\t+\t\tt.Fatalf(\"exit %d/%d: %s %s\", head.code, hist.code, head.stderr, hist.stderr)\n777\t+\t}\n778\t+\tre := regexp.MustCompile(`\"fingerprint\":\"(trufflehog:[0-9a-f]{16})\"`)\n779\t+\ta, b := re.FindStringSubmatch(head.stdout), re.FindStringSubmatch(hist.stdout)\n780\t+\tif a == nil || b == nil || a[1] != b[1] {\n781\t+\t\tt.Fatalf(\"fingerprints differ: %v vs %v\", a, b)\n782\t+\t}\n783\t+\tif !strings.Contains(hist.stdout, \"old/b.txt\") || !strings.Contains(hist.stdout, \"line 7\") {\n784\t+\t\tt.Errorf(\"location missing: %s\", hist.stdout)\n785\t+\t}\n786\t+\tif strings.Contains(hist.stdout, \"closes itself on the next run\") {"}]},"parent_tool_use_id":null,"session_id":"093f08d4-b09b-499f-bd19-e585b5d48205","uuid":"8e2e18b9-a91c-49a5-80df-6b1f3e5218f2","timestamp":"2026-11-24T12:06:44.460Z","tool_use_result":{"type":"text","file":{"filePath":"/work/.ard-input/224/diff.patch","content":"+\t\t\tt.Errorf(\"unexpected role: %+v\", r)\n+\t\t}\n+\t\tif r.Route != config.RouteNeedsHuman || r.Dockerfile != \".ard/scanners/trufflehog-history/Dockerfile\" {\n+\t\t\tt.Errorf(\"Route %v, Dockerfile %q\", r.Route, r.Dockerfile)\n+\t\t}\n+\t\tif !r.ReadsHistory() {\n+\t\t\tt.Errorf(\"ReadsHistory = false; Extra = %v\", r.Extra)\n+\t\t}\n+\t\treturn\n+\t}\n+\tt.Fatal(\"no scanner role trufflehog-history\")\n+}\n+\n+func TestHeadTrufflehogDoesNotReadHistory(t *testing.T) {\n+\tres, err := config.LoadFS(starterFS(t, true), \"/repo\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tfor _, r := range res.Roles {\n+\t\tif r.Name != \"trufflehog-history\" && r.ReadsHistory() {\n+\t\t\tt.Errorf(\"role %s reads history\", r.Name)\n+\t\t}\n+\t}\n+}\ndiff --git a/internal/roles/scanners/trufflehog-history/Dockerfile b/internal/roles/scanners/trufflehog-history/Dockerfile\nnew file mode 100644\nindex 0000000..75017f7\n--- /dev/null\n+++ b/internal/roles/scanners/trufflehog-history/Dockerfile\n@@ -0,0 +1,49 @@\n+# Pinned tool image for the trufflehog-history scanner. Versions verified 2026-11-23:\n+#   trufflehog 3.100.0 (released 2026-11-19), jq 1.8.2.\n+# The trufflehog tarball checksums come from trufflehog_3.100.0_checksums.txt,\n+# whose signature was verified on 2026-11-23 with cosign v3.1.4 (\"Verified OK\"):\n+#   cosign verify-blob trufflehog_3.100.0_checksums.txt \\\n+#     --certificate trufflehog_3.100.0_checksums.txt.pem \\\n+#     --signature trufflehog_3.100.0_checksums.txt.sig \\\n+#     --certificate-identity-regexp 'https://github\\.com/trufflesecurity/trufflehog/' \\\n+#     --certificate-oidc-issuer https://token.actions.githubusercontent.com\n+# jq's checksums are the ones in scanners/cve/Dockerfile.\n+# The base is the same golang:1.27.4-trixie index digest as cve and the ard\n+# image (root Dockerfile), so the layers are shared.\n+#\n+# LICENCE: trufflehog is AGPL-3.0. It is downloaded into this role's image only;\n+# the binary is NOT in the published ard image.\n+#\n+# The image does NOT copy `scan` or `findings.jq`: the executor mounts this role\n+# directory read-only, so the mounted script is always the one that runs.\n+# Run:  docker run --rm -v \"$PWD\":/repo:ro -v <role dir>:/role:ro -w /repo IMAGE /role/scan\n+\n+ARG GO_IMAGE=golang:1.27.4-trixie@sha256:f18c3d73a184fb0582828510722e723b63a93f7188d11dd223d9be6f6880e65d\n+\n+FROM ${GO_IMAGE} AS tools\n+ARG TARGETARCH\n+ARG TRUFFLEHOG_VERSION=3.100.0\n+ARG TRUFFLEHOG_SHA256_AMD64=b2d85eba59865e98f45c9fc9f77d2c6d62df529fdd5755af121304ea5a7cecbb\n+ARG TRUFFLEHOG_SHA256_ARM64=aa61657049229ae523e8455fcbba87dff57b0a2ba6bdb391a38cf75e6d4016dd\n+ARG JQ_VERSION=1.8.2\n+ARG JQ_SHA256_AMD64=b1c22172dd303f3be49e935aa56aa48a8b7a46e0bc838b4997d3bb451495870f\n+ARG JQ_SHA256_ARM64=8b85c817833814ddca00a144c33705546355afccf0cf39b188f3cdb48b852309\n+RUN set -eu; \\\n+    case \"${TARGETARCH}\" in \\\n+      amd64) th_sha=\"${TRUFFLEHOG_SHA256_AMD64}\"; jq_sha=\"${JQ_SHA256_AMD64}\" ;; \\\n+      arm64) th_sha=\"${TRUFFLEHOG_SHA256_ARM64}\"; jq_sha=\"${JQ_SHA256_ARM64}\" ;; \\\n+      *) echo \"unsupported arch: ${TARGETARCH}\" >&2; exit 1 ;; \\\n+    esac; \\\n+    mkdir /out; \\\n+    curl -fsSL -o /tmp/th.tgz \"https://github.com/trufflesecurity/trufflehog/releases/download/v${TRUFFLEHOG_VERSION}/trufflehog_${TRUFFLEHOG_VERSION}_linux_${TARGETARCH}.tar.gz\"; \\\n+    echo \"${th_sha}  /tmp/th.tgz\" | sha256sum -c -; \\\n+    tar -xzf /tmp/th.tgz -C /out trufflehog; \\\n+    curl -fsSL -o /out/jq \"https://github.com/jqlang/jq/releases/download/jq-${JQ_VERSION}/jq-linux-${TARGETARCH}\"; \\\n+    echo \"${jq_sha}  /out/jq\" | sha256sum -c -; \\\n+    chmod 0755 /out/trufflehog /out/jq\n+\n+FROM ${GO_IMAGE}\n+COPY --from=tools /out/trufflehog /usr/local/bin/trufflehog\n+COPY --from=tools /out/jq /usr/local/bin/jq\n+# The executor's /tmp is a noexec tmpfs; keep the temp dir in /var/tmp.\n+ENV TMPDIR=/var/tmp\ndiff --git a/internal/roles/scanners/trufflehog-history/exclude-paths b/internal/roles/scanners/trufflehog-history/exclude-paths\nnew file mode 100644\nindex 0000000..b83ab0b\n--- /dev/null\n+++ b/internal/roles/scanners/trufflehog-history/exclude-paths\n@@ -0,0 +1,6 @@\n+# trufflehog path regexes (Go RE2), one per line, matched against repo-relative\n+# paths. Human-owned: change it in a reviewed PR. scan drops # lines and blanks.\n+# .ard/<n>/logs/ were secret-scanned at close-out (model signature blobs are noise).\n+^\\.ard/[0-9]+/logs/\n+^vendor/\n+^node_modules/\ndiff --git a/internal/roles/scanners/trufflehog-history/findings.jq b/internal/roles/scanners/trufflehog-history/findings.jq\nnew file mode 100644\nindex 0000000..f4546a9\n--- /dev/null\n+++ b/internal/roles/scanners/trufflehog-history/findings.jq\n@@ -0,0 +1,60 @@\n+# project: trufflehog --json result lines in; one \"<base64 secret>\\t<json>\" line out\n+#          per result. The json holds only d (DetectorName), f (file), l (line).\n+#          Errors carry fixed text only (scan drops this stage's stderr anyway).\n+# merge:   \"<h16>\\t<json>\" lines in (-n -R, inputs); findings out.\n+def die(m): error(\"trufflehog: \" + m);\n+\n+def project:\n+  if type != \"object\" then die(\"result is not an object\") else . end\n+  | (.SourceMetadata.Data.Git // die(\"result has no git location\")) as $fs\n+  | (if (.Raw | type) == \"string\" and .Raw != \"\" then .Raw\n+     elif (.RawV2 | type) == \"string\" and .RawV2 != \"\" then .RawV2\n+     else die(\"result has no Raw or RawV2 value\") end) as $secret\n+  | (.DetectorName | if type == \"string\" and test(\"^[A-Za-z0-9_.-]{1,64}$\") then . else die(\"bad detector name\") end) as $d\n+  | ($fs.file | if type == \"string\" then ltrimstr(\"./\") else die(\"result file is not a string\") end) as $f\n+  | if $f == \"\" or ($f | startswith(\"/\")) or ($f | split(\"/\") | any(. == \"..\" or . == \".\" or . == \"\"))\n+       or ($f | explode | any(. < 32 or . == 127))\n+    then die(\"result file is not a clean repo-relative path\") else . end\n+  | ($fs.line // 0 | if type == \"number\" and . >= 0 then floor else die(\"bad line\") end) as $l\n+  | \"\\($secret | @base64)\\t\\({d: $d, f: $f, l: $l} | tojson)\";\n+\n+# A code span whose fence is longer than any backtick run in the text.\n+def code: ([match(\"`+\"; \"g\").length] | max // 0) as $n | (\"`\" * ($n + 1)) as $fence\n+  | if $n > 0 then \"\\($fence) \\(.) \\($fence)\" else \"\\($fence)\\(.)\\($fence)\" end;\n+\n+def merge($allow):\n+  [inputs | select(length > 0) | split(\"\\t\")\n+   | if length != 2 or (.[0] | test(\"^[0-9a-f]{16}$\") | not) then die(\"bad hashed line\") else . end\n+   | {h: .[0]} + (.[1] | fromjson)]\n+  | map(select((\"trufflehog:\" + .h) as $fp | $allow | index($fp) | not))\n+  | group_by(.h)\n+  | map((\"trufflehog:\" + .[0].h) as $fp\n+      | (map(.d) | unique) as $dets\n+      | (map({f, l}) | unique_by([.f, .l]) | sort_by(.f, .l)) as $locs\n+      | ($locs | map(.f) | unique) as $files\n+      | {fingerprint: $fp,\n+         title: (\"Possible \\($dets[0]) credential in \\($files[0])\" | .[0:200]),\n+         severity: \"high\", group: \"\", files: $files[0:1000],\n+         body: ([\n+           \"trufflehog matched a value that looks like a credential (detector: \\($dets | map(code) | join(\", \"))). ard did not verify it and never stores or prints the value.\",\n+           \"\",\n+           \"**Treat it as leaked.** Revoke or rotate it at the provider first. The value is in git history, possibly only on an unmerged branch ard fetched (it may not have reached main), so removing it from HEAD does not revoke it, and on a public repository it is already public.\",\n+           \"\",\n+           \"**Do not add `ard:pending` to this issue before the credential is rotated.** Triage and worker agents would read the file that holds it.\",\n+           \"\",\n+           \"What to do: 1. Rotate or revoke the credential at the provider. 2. Closing this issue does not remove the value from history; rotation is what makes that safe. Rewriting history is a separate decision for a maintainer. 3. This issue never closes itself: close it by hand once the credential is rotated. 4. For a false positive or a test fixture, add the fingerprint to `allow` or the path to `exclude-paths` (a reviewed PR), or close as not planned (it refiles after 90 days). 5. At 5 open issues the scanner does not run, so close handled ones by hand.\",\n+           \"\",\n+           \"Not a secret? A maintainer adds the fingerprint below to `.ard/scanners/trufflehog-history/allow`, or a path pattern to `.ard/scanners/trufflehog-history/exclude-paths`, in a reviewed PR. Inline `trufflehog:ignore` comments are not honoured.\",\n+           \"\",\n+           \"Fingerprint: `\\($fp)`\",\n+           \"\",\n+           \"Locations in history (file and line only; commits are not listed) (\\($locs | length)):\"]\n+           + ($locs[0:50] | map(\"- \\(.f | code)\" + (if .l > 0 then \" line \\(.l)\" else \"\" end)))\n+           + (if ($locs | length) > 50 then [\"- and \\(($locs | length) - 50) more\"] else [] end)\n+           + (if ($files | length) > 1000 then [\"\", \"Only the first 1,000 of \\($files | length) files are listed.\"] else [] end)\n+           | join(\"\\n\"))})\n+  | sort_by(.fingerprint) | .[];\n+\n+if $stage == \"project\" then project\n+elif $stage == \"merge\" then merge($allow | split(\"\\n\") | map(sub(\"#.*$\"; \"\") | gsub(\"^\\\\s+|\\\\s+$\"; \"\")) | map(select(. != \"\")))\n+else die(\"unknown stage\") end\ndiff --git a/internal/roles/scanners/trufflehog-history/history b/internal/roles/scanners/trufflehog-history/history\nnew file mode 100644\nindex 0000000..e69de29\ndiff --git a/internal/roles/scanners/trufflehog-history/scan b/internal/roles/scanners/trufflehog-history/scan\nnew file mode 100755\nindex 0000000..1ef920c\n--- /dev/null\n+++ b/internal/roles/scanners/trufflehog-history/scan\n@@ -0,0 +1,115 @@\n+#!/bin/sh\n+# trufflehog-history scanner: files leaked-credential findings for a human,\n+# from the full git history.\n+#\n+# Contract: run with $ARD_HISTORY set to a read-only bare clone with every fetched ref. Sibling\n+# files (findings.jq, exclude-paths, allow) are found from this script's own\n+# path. Writes only to a temp dir. Needs no token. stdout (JSON lines, one\n+# finding each) is printed only at the very end. Exit 0 = ok, 1 = failed\n+# (nothing on stdout), 2 = a required tool is missing.\n+#\n+# Owner rules: no verification (--no-verification: no credential is ever sent\n+# to a provider); every commit of every ref (trufflehog git on $ARD_HISTORY); only DetectorName,\n+# the file, the line and a hash of the secret leave the project stage: Raw,\n+# RawV2, Redacted, SecretParts, ExtraData, StructuredData and the rest never\n+# leave this script. The secret exists only in pipes: never in a file, argv,\n+# stdout or stderr. --no-ignore-tag: inline trufflehog:ignore is not honoured.\n+#\n+# Human-owned files next to this script: exclude-paths (regexes) and allow\n+# (one trufflehog:<16 hex> fingerprint per line, # comments). A bad allow\n+# entry fails the run. .git is always excluded.\n+#\n+# The commit, author email and timestamp trufflehog reports are dropped too.\n+# Fingerprints use the same salt as scanners/trufflehog, so one value is one fingerprint in both.\n+#\n+# Never pass --since-commit, --max-depth, --branch, --detector-timeout, --archive-timeout,\n+# --filter-unverified, --filter-entropy, --filter-* or --results: a partial or\n+# load-dependent result would make the pipeline autoclose live findings.\n+# Never use set -x: it would print the secret.\n+set -eu\n+dir=$(CDPATH= cd -- \"$(dirname -- \"$0\")\" && pwd)\n+die() { echo \"trufflehog: $*\" >&2; exit 1; }\n+need() { command -v \"$1\" >/dev/null 2>&1 || { echo \"trufflehog: $1 not found\" >&2; exit 2; }; }\n+need trufflehog\n+need jq\n+need git\n+if command -v sha256sum >/dev/null 2>&1; then sha() { sha256sum; }\n+elif command -v shasum >/dev/null 2>&1; then sha() { shasum -a 256; }\n+else echo \"trufflehog: sha256sum not found\" >&2; exit 2; fi\n+\n+tmp=$(mktemp -d \"${TMPDIR:-/tmp}/ard-trufflehog-history.XXXXXX\")\n+trap 'rm -rf \"$tmp\"' EXIT\n+trap 'exit 130' INT\n+trap 'exit 143' TERM\n+\n+[ -n \"${ARD_HISTORY:-}\" ] && [ -d \"$ARD_HISTORY\" ] || { echo \"trufflehog: ARD_HISTORY is not a directory\" >&2; exit 2; }\n+\n+echo \"trufflehog: $(trufflehog --version 2>&1 | head -n 1 || true)\" >&2\n+\n+# Exclusions: .git always, then the human-owned file without comments or blanks.\n+printf '%s\\n' '^\\.git(/|$)' > \"$tmp/exclude\"\n+if [ -e \"$dir/exclude-paths\" ]; then\n+  grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' \"$dir/exclude-paths\" >> \"$tmp/exclude\" || true\n+fi\n+allow=$tmp/allow.txt\n+: > \"$allow\"\n+[ ! -e \"$dir/allow\" ] || cat \"$dir/allow\" > \"$allow\"\n+jq -n -R --rawfile allow \"$allow\" '$allow | split(\"\\n\") | map(sub(\"#.*$\"; \"\") | gsub(\"^\\\\s+|\\\\s+$\"; \"\"))\n+  | map(select(. != \"\")) | if any(test(\"^trufflehog:[0-9a-f]{16}$\") | not) then error(\"bad\") else empty end' 2>/dev/null \\\n+  || die \"allow: every entry must be trufflehog:<16 hex digits> (comments start with #)\"\n+\n+tab=$(printf '\\t')\n+# The secret exists only in these pipes: never in a file, argv, stdout or stderr.\n+# Each stage records its own status (no pipefail in POSIX sh); \"|| rc=$?\" keeps\n+# set -e from skipping the echo.\n+{\n+  rc=0\n+  trufflehog git \"file://$ARD_HISTORY\" --bare --json --no-update --no-color --no-verification \\\n+    --no-ignore-tag --fail-on-scan-errors --concurrency=2 -x \"$tmp/exclude\" \\\n+    2>\"$tmp/th.err\" || rc=$?\n+  echo \"$rc\" > \"$tmp/th.rc\"\n+} | {\n+  rc=0\n+  # stderr dropped: a jq type error can quote the input, which holds the secret.\n+  jq -r --arg stage project --arg allow \"\" -f \"$dir/findings.jq\" 2>/dev/null || rc=$?\n+  echo \"$rc\" > \"$tmp/project.rc\"\n+} | {\n+  rc=0\n+  while IFS=$tab read -r pre rest; do\n+    h=$(printf 'ard-trufflehog-v1\\000%s' \"$pre\" | sha | cut -c1-16) || { rc=1; break; }\n+    case $h in *[!0-9a-f]*|'') rc=1; break ;; esac\n+    [ ${#h} -eq 16 ] || { rc=1; break; }\n+    printf '%s\\t%s\\n' \"$h\" \"$rest\"\n+  done\n+  echo \"$rc\" > \"$tmp/hash.rc\"\n+} > \"$tmp/hashed.tsv\"\n+\n+rcof() { [ -s \"$tmp/$1.rc\" ] && cat \"$tmp/$1.rc\" || echo missing; }\n+th=$(rcof th)\n+if [ \"$th\" != 0 ]; then\n+  jq -r 'select(.level == \"error\") | \"trufflehog: \\(.msg // \"\") \\((.error // \"\") | tostring | .[0:200])\"' \\\n+    \"$tmp/th.err\" 2>/dev/null | head -n 5 >&2 || true\n+  die \"trufflehog failed (exit status $th)\"\n+fi\n+[ \"$(rcof project)\" = 0 ] || die \"cannot parse trufflehog results\"\n+[ \"$(rcof hash)\" = 0 ] || die \"cannot hash a result\"\n+\n+summary=$(jq -c 'select(.msg == \"finished scanning\") | [.chunks, .verified_secrets, .unverified_secrets]' \\\n+  \"$tmp/th.err\" 2>/dev/null | tail -n 1) || die \"cannot read trufflehog's log\"\n+case $summary in\n+  \\[[0-9]*,[0-9]*,[0-9]*\\]) ;;\n+  *) die \"no \\\"finished scanning\\\" summary from trufflehog\" ;;\n+esac\n+set -- $(echo \"$summary\" | tr -d '[]' | tr ',' ' ')\n+chunks=$1 want=$(($2 + $3))\n+got=$(wc -l < \"$tmp/hashed.tsv\" | tr -d ' ')\n+echo \"trufflehog: $chunks chunk(s), $got result(s)\" >&2\n+if [ \"$chunks\" -eq 0 ] && [ -n \"$(git --git-dir \"$ARD_HISTORY\" rev-list -n 1 --all 2>/dev/null)\" ]; then\n+  die \"trufflehog scanned nothing in a repository that has commits\"\n+fi\n+[ \"$got\" -eq \"$want\" ] || die \"result count $got does not match the summary's $want\"\n+\n+jq -n -R -c --arg stage merge --rawfile allow \"$allow\" -f \"$dir/findings.jq\" \"$tmp/hashed.tsv\" \\\n+  > \"$tmp/out.jsonl\" || die \"merge failed\"\n+echo \"trufflehog: $(wc -l < \"$tmp/out.jsonl\" | tr -d ' ') finding(s)\" >&2\n+cat \"$tmp/out.jsonl\"\ndiff --git a/internal/roles/trufflehog_history_test.go b/internal/roles/trufflehog_history_test.go\nnew file mode 100644\nindex 0000000..e4aa05d\n--- /dev/null\n+++ b/internal/roles/trufflehog_history_test.go\n@@ -0,0 +1,229 @@\n+package roles\n+\n+import (\n+\t\"os\"\n+\t\"os/exec\"\n+\t\"path/filepath\"\n+\t\"regexp\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+const thHist = \"scanners/trufflehog-history\"\n+\n+func thGitLine(raw, det, file string, line int) thLine {\n+\tl := thResultLine(raw, det, file, line)\n+\tl[\"SourceMetadata\"] = map[string]any{\"Data\": map[string]any{\"Git\": map[string]any{\n+\t\t\"file\": file, \"line\": line, \"commit\": \"commit-marker\", \"email\": \"email-marker\", \"timestamp\": \"ts-marker\", \"repository\": \"repo-marker\"}}}\n+\treturn l\n+}\n+\n+func thHistRun(t *testing.T, out, errlog string, rc int, extra map[string]string) thResult {\n+\tt.Helper()\n+\tif extra == nil {\n+\t\textra = map[string]string{\"ARD_HISTORY\": t.TempDir()}\n+\t}\n+\treturn thRunFull(t, mustAbs(t, thHist), out, errlog, rc, map[string]string{\"a.txt\": \"x\"}, extra)\n+}\n+\n+func TestTrufflehogHistoryFingerprintMatchesHead(t *testing.T) {\n+\thead := thRun(t, thJoin([]thLine{thResultLine(\"canary-raw-alpha\", \"Alpha\", \"a.txt\", 1)}), thSummary(1, 1), 0, map[string]string{\"a.txt\": \"x\"}, nil)\n+\thist := thHistRun(t, thJoin([]thLine{thGitLine(\"canary-raw-alpha\", \"Alpha\", \"old/b.txt\", 7)}), thSummary(1, 1), 0, nil)\n+\tif head.code != 0 || hist.code != 0 {\n+\t\tt.Fatalf(\"exit %d/%d: %s %s\", head.code, hist.code, head.stderr, hist.stderr)\n+\t}\n+\tre := regexp.MustCompile(`\"fingerprint\":\"(trufflehog:[0-9a-f]{16})\"`)\n+\ta, b := re.FindStringSubmatch(head.stdout), re.FindStringSubmatch(hist.stdout)\n+\tif a == nil || b == nil || a[1] != b[1] {\n+\t\tt.Fatalf(\"fingerprints differ: %v vs %v\", a, b)\n+\t}\n+\tif !strings.Contains(hist.stdout, \"old/b.txt\") || !strings.Contains(hist.stdout, \"line 7\") {\n+\t\tt.Errorf(\"location missing: %s\", hist.stdout)\n+\t}\n+\tif strings.Contains(hist.stdout, \"closes itself on the next run\") {","numLines":330,"startLine":457,"totalLines":1015}},"tool_result_meta":[{"id":"