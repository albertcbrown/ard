log --all --format=%H | wc -l)\\\" -gt 1 ]\\n\"+\n221\t+\t\t\"! touch /history/probe\\n\"), 0o755)\n222\t+\tj := f.job(2 * time.Minute)\n223\t+\tj.Stage, j.Role, j.History, j.RepoDir, j.Dockerfile = \"scanner\", \"hist\", true, bare, df\n224\t+\th, st := f.run(t, j, executor.Command{Path: \"/role/hist.sh\"})\n225\t+\tif st.State != executor.Exited || st.ExitCode != 0 {\n226\t+\t\tt.Fatalf(\"%+v stderr %q\", st, readFile(t, h.StdoutPath))\n227\t+\t}\n228\t+\tif _, err := os.Stat(filepath.Join(bare, \"probe\")); err == nil {\n229\t+\t\tt.Error(\"write to read-only /history reached the host\")\n230\t+\t}\n231\t+\tf.l.Cleanup(context.Background(), h, executor.CleanupOptions{})\n232\t+}\n233\tdiff --git a/internal/executor/local/env.go b/internal/executor/local/env.go\n234\tindex 59012ee..d81d96f 100644\n235\t--- a/internal/executor/local/env.go\n236\t+++ b/internal/executor/local/env.go\n237\t@@ -31,6 +31,9 @@ func ardEnv(h executor.Handle) []string {\n238\t \tif h.View.Sidecar != \"\" {\n239\t \t\te = append(e, \"ARD_SIDECAR=\"+h.View.Sidecar)\n240\t \t}\n241\t+\tif h.View.History != \"\" {\n242\t+\t\te = append(e, \"ARD_HISTORY=\"+h.View.History)\n243\t+\t}\n244\t \treturn e\n245\t }\n246\t \n247\tdiff --git a/internal/executor/local/local.go b/internal/executor/local/local.go\n248\tindex 54ed05b..fafdbd5 100644\n249\t--- a/internal/executor/local/local.go\n250\t+++ b/internal/executor/local/local.go\n251\t@@ -254,6 +254,11 @@ func (l *Local) Prepare(ctx context.Context, j executor.Job) (h executor.Handle,\n252\t \t\treturn h, fmt.Errorf(\"create config dir: %w\", err)\n253\t \t}\n254\t \th.View.ConfigDir = cfg\n255\t+\tif j.History {\n256\t+\t\t// Host mode hands over the live clone: read-only is enforced only by the\n257\t+\t\t// Docker mount (:ro), not on the host.\n258\t+\t\th.HistoryDir, h.View.History = j.RepoDir, j.RepoDir\n259\t+\t}\n260\t \t// --- sidecar (#28): the executor clones, pins and mounts it read-only ---\n261\t \tif j.Sidecar != (executor.Sidecar{}