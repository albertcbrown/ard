odel: claude-sonnet-5-5, timeout: 60m, tests: make test }\n  reviewers/eng-review: { model: claude-sonnet-5-5 }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01KmzF6LHDuZA6Ae4G1HjGk1","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
