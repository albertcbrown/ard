request, Issue: issue, Stage: \"review\", Role: role})\n\tif err != nil {\n\t\tt.fail(n, \"rerequest_events\", err)\n\t\treturn\n\t}\n\tfor _, e := range evs {\n\t\tvar data struct {\n\t\t\tPR   int    `json:\"pr\"`\n\t\t\tHead string `json:\"head\"`\n\t\t}\n\t\tif json.Unmarshal(e.Data, &data) == nil && data.PR == n && data.Head == head {\n\t\t\treturn\n\t\t}\n\t}\n\tif err := d.Effects.RemoveLabel(ctx, n, done); err != nil {\n\t\tt.fail(n, \"rerequest_label\", err)\n\t\treturn\n\t}\n\tif t.dry {\n\t\tt.log.Info(\"merge.would_rerequest\", \"pr\", n, \"issue\", issue, \"role\", role, \"reviewed\", reviewed, \"head\", head)\n\t\treturn\n\t}\n\tt.log.Info(\"merge.review_rerequested\", \"pr\", n, \"issue\", issue, \"role\", role, \"reviewed\", reviewed, \"head\", head)\n\tdata, _ := json.Marshal(map[string]any{\"pr\": n, \"head\": head, \"reviewed\": reviewed})\n\tif err := d.Store.AppendEvent(ctx, state.Event{Kind: state.EventReviewRerequest, Issue: issue, Stage: \"review\", Role: role, Data: data}); err != nil {\n\t\tt.log.Warn(\"merge.event_failed\", \"pr\", n, \"error\", err)\n\t}\n}\n\n// resolveApps fills''',1)\nopen(p,'w').write(s)\np='internal/merger/doc.go'\ns=open(p).read()\ns=s.replace('''A stale\n//     review is only logged: until review fix rounds (#41) a human must\n//     re-request it.''','''A stale\n//     review (code changed since it) is re-requested once per head: the merger\n//     removes the role's :done label, records a review_rerequest event and logs\n//     merge.review_rerequested (merge.would_rerequest in dry-run).''',1)\nopen(p,'w').write(s)\np='docs/proposal.md'\ns=open(p).read()\ni=s.index('A stale review is only logged: a person must re-request it')\nj=s.index('\\n',i)\nprint(repr(s[i:j]))\ns=s[:i]+'A review made stale by code that changed since it is re-requested once per head: the merger removes `ard:review:<role>:done` (the reviewer then claims the role again at the current head), records a `review_rerequest` event for that PR and he