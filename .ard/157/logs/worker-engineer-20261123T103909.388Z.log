{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JUFeoJaRrrGE4uLzLu3F4f","type":"tool_result","content":"const (\n\tOutcomeSkip   Outcome = \"skip\" // not admitted; take no action this poll (the zero value is never \"admit\")\n\tOutcomeAdmit  Outcome = \"admit\"\n\tOutcomeRefuse Outcome = \"refuse\" // label present but not honoured; #29 adds ard:needs-human with a comment asking a maintainer to re-apply it\n)\n\n// Reason is stable, for slog and the refusal comment.\ntype Reason string\n\nconst (\n\tReasonAllMode      Reason = \"all-mode\"\n\tReasonAppAuthored  Reason = \"app-authored\" // scanner-filed: unaffected by intake\n\tReasonAppLabeled   Reason = \"app-labeled\"\n\tReasonAuthorised   Reason = \"authorised-labeler\"\n\tReasonPR           Reason = \"pull-request\"\n\tReasonLabelAbsent  Reason = \"label-absent\"\n\tReasonNoLabelEvent Reason = \"no-labeled-event\" // label present, timeline doesn't show it (yet)\n\tReasonPermUnknown  Reason = \"permission-unknown\"\n\tReasonUnknownActor Reason = \"unknown-actor\"\n\tReasonUnauthorised Reason = \"unauthorised-labeler\" // refuse: the labeler lacks triage permission\n\tReasonBadConfig    Reason = \"invalid-config\"\n)\n\n// Decision says whether a human-filed issue may enter triage. Actor and At\n// are the labeled event Admit judged (label rules only) so #29 can record\n// labeled_by.\n// consider re-reads issue n (search is eventually consistent), then gates it.\nfunc (t *tick) consider(ctx context.Context, role config.Role, n int) (candidate, bool, error) {\n\tl := t.l\n\tis, err := l.d.Reader.GetIssue(ctx, n)\n\tif err != nil {\n\t\tif errors.Is(err, github.ErrNotFound) {\n\t\t\treturn candidate{}, false, nil\n\t\t}\n\t\treturn candidate{}, false, fmt.Errorf(\"triage issue %d: re-read: %w\", n, err)\n\t}\n\tif is.State != github.StateOpen || is.IsPR || !hasLabel(is.Labels, labels.Request(labels.StageTriage, role.Name)) ||\n\t\thasAny(is.Labels, excluded(role.Name)) {\n\t\treturn candidate{}, false, nil\n\t}\n\tif dep, held := heldBy(role, is.Labels); held {\n\t\t// Not a candidate, so it does not mark the issue busy: the prerequisite\n\t\t// may still claim it this tick. Held before intake, so it costs no reads.\n\t\tt.log.Info(\"triage.held\", \"issue\", n, \"role\", role.Name, \"waiting_for\", dep)\n\t\treturn candidate{}, false, nil\n\t}\n\tc := candidate{role: role, issue: is, reason: intake.ReasonAppAuthored}\n\tif strings.EqualFold(is.Author, t.self) { // scanner issues: the App rewrites its own bodies\n\t\treturn c, true, nil\n\t}\n\thash := agentjob.BodyHash(is)\n\tvar stored *state.Admission\n\tif a, err := l.d.Store.Admission(ctx, n); err == nil {\n\t\tstored = &a\n\t} else if !errors.Is(err, state.ErrNotFound) {\n\t\treturn candidate{}, false, fmt.Errorf(\"triage issue %d: read admission: %w\", n, err)\n\t}\n\tlead := role.Name == leadRole\n\tif !lead && (stored == nil || stored.BodyHash == hash) {\n\t\tif stored == nil {\n\t\t\tt.log.Info(\"triage.not_admitted\", \"issue\", n, \"role\", role.Name)\n\t\t\treturn candidate{}, false, nil\n\t\t}\n\t\treturn c, true, nil\n\t}\n\tj := t.judge(is)\n\tvar d, lr intake.Decision\n\tif lead {\n\t\tif d, err = j.decide(ctx, t.cfg.Intake); err != nil {\n\t\t\treturn candidate{}, false, err\n\t\t}\n\t}\n\tif stored != nil && stored.BodyHash != hash {\n\t\tif t.cfg.Intake.Mode == config.IntakeLabel && lead {\n\t\t\tlr = d\n\t\t} else if lr, err = j.decide(ctx, config.Intake{Mode: config.IntakeLabel, Label: t.cfg.Intake.Label}); err != nil {\n\t\t\treturn candidate{}, false, err\n\t\t}\n\t}\n\ttmpl := state.Admission{Issue: n, Mode: string(t.cfg.Intake.Mode), BodyHash: hash, LabeledAt: later(is.CreatedAt, is.UpdatedAt)}\n\tv, rec := gate(lead, stored, d, lr, tmpl)\n\tt.log.Info(\"triage.gate\", \"issue\", n, \"role\", role.Name, \"verdict\", v.String(), \"outcome\", string(d.Outcome), \"reason\", string(d.Reason), \"actor\", d.Actor)\n\tswitch v {\n\tcase vRefuse:\n\t\treturn candidate{}, false, 