{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JzWXDe9SxN2pitPrynpGX4","type":"tool_result","content":"1\tpackage triage\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"sort\"\n8\t\t\"strings\"\n9\t\t\"time\"\n10\t\n11\t\t\"github.com/albertcbrown/ard/internal/agentjob\"\n12\t\t\"github.com/albertcbrown/ard/internal/config\"\n13\t\t\"github.com/albertcbrown/ard/internal/github\"\n14\t\t\"github.com/albertcbrown/ard/internal/github/query\"\n15\t\t\"github.com/albertcbrown/ard/internal/intake\"\n16\t\t\"github.com/albertcbrown/ard/internal/labels\"\n17\t\t\"github.com/albertcbrown/ard/internal/state\"\n18\t)\n19\t\n20\t// candidate is an issue a role may claim, with the fresh re-read of the issue\n21\t// and the admission record the claim must write (nil when none changes).\n22\ttype candidate struct {\n23\t\trole   config.Role\n24\t\tissue  github.Issue\n25\t\trec    *state.Admission\n26\t\treason intake.Reason\n27\t}\n28\t\n29\t// candidates finds, per triage role (the lead first), the issues that request\n30\t// it and pass the gate. At most one candidate per issue is returned, and none\n31\t// for an issue that already has a running triage job.\n32\tfunc (t *tick) candidates(ctx context.Context) ([]candidate, []error) {\n33\t\tl := t.l\n34\t\trunning, err := l.d.Store.RunningJobs(ctx)\n35\t\tif err != nil {\n36\t\t\treturn nil, []error{fmt.Errorf(\"triage: list running jobs: %w\", err)}\n37\t\t}\n38\t\tbusy := map[int]bool{}\n39\t\tfor _, j := range running {\n40\t\t\t// A running worker job is busy too: a re-run of triage would rewrite\n41\t\t\t// plan.md under it.\n42\t\t\tif j.Stage == stageTriage || j.Stage == \"worker\" {\n43\t\t\t\tbusy[j.Issue] = true\n44\t\t\t}\n45\t\t}\n46\t\troles := t.cfg.RolesOf(config.KindTriage)\n47\t\tsort.SliceStable(roles, func(i, j int) bool {\n48\t\t\treturn roles[i].Name == leadRole && roles[j].Name != leadRole\n49\t\t})\n50\t\tvar out []candidate\n51\t\tvar errs []error\n52\t\tfor _, role := range roles {\n53\t\t\tq, err := query.RoleQuery{\n54\t\t\t\tType: query.TypeIssue, Request: labels.Request(labels.StageTriage, role.Name),\n55\t\t\t\tStates: []string{labels.Running(labels.StageTriage, role.Name), labels.Done(labels.StageTriage, role.Name)},\n56\t\t\t\tGuards: []string{labels.ExecutorFailed, labels.NeedsHuman, labels.Hold},\n57\t\t\t}.Build()\n58\t\t\tif err != nil {\n59\t\t\t\terrs = append(errs, fmt.Errorf(\"triage role %s: %w\", role.Name, err))\n60\t\t\t\tcontinue\n61\t\t\t}\n62\t\t\thits, err := l.d.Reader.SearchIssues(ctx, q, github.SearchOpts{Sort: \"created\", Order: \"asc\", Max: 50})\n63\t\t\tif err != nil {\n64\t\t\t\terrs = append(errs, fmt.Errorf(\"triage role %s: search: %w\", role.Name, err))\n65\t\t\t\tcontinue\n66\t\t\t}\n67\t\t\tfor _, hit := range hits {\n68\t\t\t\tif busy[hit.Number] {\n69\t\t\t\t\tcontinue\n70\t\t\t\t}\n71\t\t\t\tc, ok, err := t.consider(ctx, role, hit.Number)\n72\t\t\t\tif err != nil {\n73\t\t\t\t\terrs = append(errs, err)\n74\t\t\t\t\tcontinue\n75\t\t\t\t}\n76\t\t\t\tif ok {\n77\t\t\t\t\tbusy[c.issue.Number] = true\n78\t\t\t\t\tout = append(out, c)\n79\t\t\t\t}\n80\t\t\t}\n81\t\t}\n82\t\treturn out, errs\n83\t}\n84\t\n85\t// consider re-reads issue n (search is eventually consistent), then gates it.\n86\tfunc (t *tick) consider(ctx context.Context, role config.Role, n int) (candidate, bool, error) {\n87\t\tl := t.l\n88\t\tis, err := l.d.Reader.GetIssue(ctx, n)\n89\t\tif err != nil {\n90\t\t\tif errors.Is(err, github.ErrNotFound) {\n91\t\t\t\treturn candidate{}, false, nil\n92\t\t\t}\n93\t\t\treturn candidate{}, false, fmt.Errorf(\"triage issue %d: re-read: %w\", n, err)\n94\t\t}\n95\t\tif is.State != github.StateOpen || is.IsPR || !hasLabel(is.Labels, labels.Request(labels.StageTriage, role.Name)) ||\n96\t\t\thasAny(is.Labels, excluded(role.Name)) {\n97\t\t\treturn candidate{}, false, nil\n98\t\t}\n99\t\tif dep, held := heldBy(role, is.Labels); held {\n100\t\t\t// Not a candidate, so it does not mark the issue busy: the prerequisite\n101\t\t\t// may still claim it this tick. Held before intake, so it costs no reads.\n102\t\t\tt.log.Info(\"triage.held\", \"issue\", n, \"role\", role.Name, \"waiting_for\", dep)\n103\t\t\treturn candidate{}, false, nil\n104\t\t}\n105\t\tc := candidate{role: role, issue: is, reason: intake.ReasonAppAuthored}\n106\t\tif strings.EqualFold(is.Author, t.self) { // scanner issues: the App rewrites its own bodies\n107\t\t\treturn c, true, nil\n108\t\t}\n109\t\thash := agentjob.BodyHash(is)\n110\t\tvar stored *state.Admission\n111\t\tif a, err := l.d.Store.Admission(ctx, n); err == nil {\n112\t\t\tstored = &a\n113\t\t} else if !errors.Is(err, state.ErrNotFound) {\n114\t\t\treturn candidate{}, false, fmt.Errorf(\"triage issue %d: read admission: %w\", n, err)\n115\t\t}\n116\t\tlead := role.Name == leadRole\n117\t\tif !lead && (stored == nil || stored.BodyHash == hash) {\n118\t\t\tif stored == nil {\n119\t\t\t\tt.log.Info(\"triage.not_admitted\", \"issue\", n, \"role\", role.Name)\n120\t\t\t\treturn candidate{}, false, nil\n121\t\t\t}\n122\t\t\treturn c, true, nil\n123\t\t}\n124\t\tj := t.judge(is)\n125\t\tvar d, lr intake.Decision\n126\t\tif lead {\n127\t\t\tif d, err = j.decide(ctx, t.cfg.Intake); err != nil {\n128\t\t\t\treturn candidate{}, false, err\n129\t\t\t}\n130\t\t}\n131\t\tif stored != nil && stored.BodyHash != hash {\n132\t\t\tif t.cfg.Intake.Mode == config.IntakeLabel && lead {\n133\t\t\t\tlr = d\n134\t\t\t} else if lr, err = j.decide(ctx, config.Intake{Mode: config.IntakeLabel, Label: t.cfg.Intake.Label}); err != nil {\n135\t\t\t\treturn candidate{}, false, err\n136\t\t\t}\n137\t\t}\n138\t\ttmpl := state.Admission{Issue: n, Mode: string(t.cfg.Intake.Mode), BodyHash: hash, LabeledAt: later(is.CreatedAt, is.UpdatedAt)}\n139\t\tv, rec := gate(lead, stored, d, lr, tmpl)\n140\t\tt.log.Info(\"triage.gate\", \"issue\", n, \"role\", role.Name, \"verdict\", v.String(), \"outcome\", string(d.Outcome), \"reason\", string(d.Rea