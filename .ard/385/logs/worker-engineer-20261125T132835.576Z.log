eft unset in `servecmd`). When on, it applies to a first worker job only (no branch or PR, and nothing pushed by this job): close-out requests `ard:triage:engineer` instead of `needs-human` and removes `ard:triage:engineer:done`, `ard:worker:<role>` and `:running`, in that order. The triage job gets `network-request.md`, rendered from the record's structured list and marked as agent-written, untrusted input. One network round per issue is allowed, counted from closed worker close-outs with outcome `needs-network`; a second, a fix, review or conflict round, a pushed job or a repository without a triage engineer role ends `needs-human` with the list. The live prompts under `.ard/` need a human PR to match the starter copies.''')\nE\nsed -n 700,739p closeout/closer_test.go; sed -n 1,55p closeout/closer_test.go"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2608,"cache_read_input_tokens":48431,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2608},"output_tokens":30,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"fcf67195-41f3-4755-bbbb-55be9c472f0a","uuid":"b62737d1-34b6-4108-a699-14b94fc2b3dc","timestamp":"2026-11-25T13:29:39.407Z","request_id":"req_011ChPj71tXa822RSrU4vJwt"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Uwbyrb2xnb4UJJfnvonqxH","type":"tool_result","content":"\t}\n\tgot, err := TriageRoles(ctx, e.store, 7)\n\tif err != nil || len(got) != 1 || !got[\"lead\"] {\n\t\tt.Errorf(\"after done close-out = %v, %v; want {lead}\", got, err)\n\t}\n\tif got, err := TriageRoles(ctx, e.store, 8); err != nil || len(got) != 0 {\n\t\tt.Errorf(\"other issue = %v, %v; want none\", got, err)\n\t}\n}\n\nfunc TestRunWorkerNeedsNetwork(t *testing.T) {\n\te := newEnv(t)\n\te.write(\".ard/7/worker-engineer.md\", roleFile(\"engineer\", \"needs-network\",\n\t\t\"network:\\n  - what: the spec\\n    url: https://example.com/spec\\n    why: to read it\"))\n\tj := e.claim(StageWorker, \"engineer\")\n\tj.Worker = &WorkerResult{Tests: TestsPassed}\n\tprBefore := e.labels(9)\n\tout, err := New(e.d).Run(context.Background(), j)\n\tif err != nil || out != OutcomeNeedsNetwork {\n\t\tt.Fatalf(\"Run = %s, %v\", out, err)\n\t}\n\tl := e.labels(7)\n\tif !l[\"ard:needs-human\"] || l[\"ard:worker:engineer:running\"] || l[\"ard:worker:engineer:done\"] || l[\"ard:review:eng-review\"] {\n\t\tt.Errorf(\"issue labels = %v\", l)\n\t}\n\tif l := e.labels(9); fmt.Sprint(l) != fmt.Sprint(prBefore) {\n\t\tt.Errorf(\"PR labels = %v, were %v\", l, prBefore)\n\t}\n\tcs, _ := e.gh.ListComments(context.Background(), 7, timeZero)\n\tif len(cs) != 1 || !strings.Contains(cs[0].Body, \"https://example.com/spec\") {\n\t\tt.Errorf(\"comments = %+v\", cs)\n\t}\n\tfor _, files := range e.cm.commits {\n\t\tfor p := range files {\n\t\t\tif !strings.HasPrefix(p, \".ard/\") {\n\t\t\t\tt.Errorf(\"committed %s outside .ard/\", p)\n\t\t\t}\n\t\t}\n\t}\n}\npackage closeout\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/committer\"\n\t\"github.com/albertcbrown/ard/internal/effects\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n\t\"github.com/albertcbrown/ard/internal/gitx/gittest\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\nfunc (e *env) lead() Job {\n\te.write(\".ard/7/triage-lead.md\", roleFile(\"lead\", \"done\", \"next: [triage:architect, review:license-review]\", \"worker: engineer\"))\n\treturn e.claim(StageTriage, \"lead\")\n}\n\n// assertLeadClosed checks the end state of a lead close-out.\nfunc (e *env) assertLeadClosed(j Job) {\n\te.t.Helper()\n\tl := e.labels(7)\n\tfor _, gone := range []string{\"ard:triage:lead:running\", \"ard:pending\"} {\n\t\tif l[gone] {\n\t\t\te.t.Errorf(\"%s still present: %v\", gone, l)\n\t\t}\n\t}\n\tfor _, want := range []string{\"ard:triage:lead:done\", \"ard:triage:architect\", \"ard:worker:engineer:running\"} {\n\t\tif !l[want] {\n\t\t\te.t.Errorf(\"%s missing: %v\", want, l)\n\t\t}\n\t}\n\tif n := e.markerComments(7, j.ID); n != 1 {\n\t\te.t.Errorf(\"marker comments = %d, want 1\", n)\n\t}\n\tif len(e.cm.commits) != 1 {\n\t\te.t.Errorf(\"distinct commits = %d, want 1\", len(e.cm.commits))\n\t}\n\tsj := e.sjob(j.ID)\n\tif sj.CloseoutPhase != string(PhaseClosed) || sj.Status != state.StatusDone {\n\t\te.t.Errorf(\"job = phase %q status %s\", sj.CloseoutPhase, sj.Status)\n\t}\n\tif _, err := os.Stat(filepath.Join(e.staging, j.ID)); !errors.Is(err, os.ErrNotExist) {\n\t\te.t.Errorf(\"staging dir remains: %v\", err)\n\t}\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"fcf67195-41f3-4755-bbbb-55be9c472f0a","uuid":"cf477a45-ff05-43ea-9191-57eb1dde2058","timestamp":"2026-11-25T13:29:39.486Z","tool_use_result":{"stdout":"\t}\n\tgot, err := TriageRoles(ctx, e.store, 7)\n\tif err != nil || len(got) != 1 || !got[\"lead\"] {\n\t\tt.Errorf(\"after done close-out = %v, %v; want {lead}\", got, err)\n\t}\n\tif got, err := TriageRoles(ctx, e.store, 8); err != nil || len(got) != 0 {\n\t\tt.Errorf(\"other issue = %v, %v; want none\", got, err)\n\t}\n}\n\nfunc TestRunWorkerNeedsNetwork(t *tes