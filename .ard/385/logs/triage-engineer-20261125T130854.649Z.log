{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014ajifHumZVr1adgqxEX5Xm","type":"tool_result","content":"\tStagingDir string\n\tLog        *slog.Logger\n\tNow        func() time.Time\n}\n\nfunc (d Deps) log() *slog.Logger {\n\tif d.Log != nil {\n\t\treturn d.Log\n\t}\n\treturn slog.Default()\n}\n\nfunc (d Deps) now() time.Time {\n\tif d.Now != nil {\n\t\treturn d.Now()\n\t}\n\treturn time.Now()\n}\n\n// Closer executes close-out plans.\ntype Closer struct {\n\td    Deps\n\tmu   sync.Mutex\n\tbusy map[string]bool // jobs with an advance in flight\n}\n\n// New returns a Closer.\nfunc New(d Deps) *Closer { return &Closer{d: d, busy: map[string]bool{}} }\n\n// acquire marks a job busy; it reports false when another Run or Resume\n// already holds it. Without it a concurrent list-then-create would double-post.\nfunc (c *Closer) acquire(id string) bool {\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\tif c.busy == nil {\n\t\tc.busy = map[string]bool{}\n\t}\n\tif c.busy[id] {\n\t\treturn false\n\t}\n\tc.busy[id] = true\n\treturn true\n}\n\nfunc (c *Closer) release(id string) {\n\tc.mu.Lock()\n\tdelete(c.busy, id)\n\tc.mu.Unlock()\n}\n\n// checkDeps refuses a live Closer that cannot look for its own comment.\nfunc (c *Closer) checkDeps() error {\n\tif c.d.Comments == nil && !c.d.Effects.DryRun() {\n\t\treturn errors.New(\"closeout: Deps.Comments is required outside dry-run (a replay would post twice)\")\n\t}\n\treturn nil\n}\n\n// Run closes out j. If the job already has a record it resumes that one and\n// never reads the worktree again.\nfunc (c *Closer) Run(ctx context.Context, j Job) (Outcome, error) {\n\tif err := j.validate(); err != nil {\n\t\treturn \"\", err\n\t}\n\tif err := c.checkDeps(); err != nil {\n\t\treturn \"\", err\n\t}\n\tif !c.acquire(j.ID) {\n\t\treturn \"\", fmt.Errorf(\"closeout job %s: %w\", j.ID, ErrBusy)\n\t}\n\tdefer c.release(j.ID)\n\tsj, err := c.d.Store.Job(ctx, j.ID)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"closeout job %s: load job: %w\", j.ID, err)\n\t}\n\tif sj.CloseoutPhase != \"\" && len(sj.CloseoutPlan) > 0 {\n\t\trec, err := decode(sj)\n\t\tif err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\treturn c.advance(ctx, rec)\n\t}\n\tstart := c.d.now()\n\trec, err := Prepare(ctx, j, c.d)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"closeout job %s: prepare: %w\", j.ID, err)\n\t}\n\tif err := c.save(ctx, rec); err != nil {\n\t\treturn \"\", err\n\t}\n\tout, err := c.advance(ctx, rec)\n\tif err == nil {\n\t\tc.d.log().Info(\"closeout\", \"job\", j.ID, \"issue\", j.Issue, \"stage\", j.Stage, \"role\", j.Role,\n\t\t\t\"outcome\", out, \"skipped\", len(rec.Plan.Skipped), \"dur\", c.d.now().Sub(start))\n\t}\n\treturn out, err\n}\n\n// ResumeJob finishes the open close-out of one job. A job with no open phase\n// is state.ErrNotFound (wrapped); one whose close-out another goroutine is\n// advancing is ErrBusy. The Reaper uses it for jobs nobody is driving.\nfunc (c *Closer) ResumeJob(ctx context.Context, id string) (Outcome, error) {\n\tif err := c.checkDeps(); err != nil {\n\t\treturn \"\", err\n\t}\n\tif !c.acquire(id) {\n\t\treturn \"\", fmt.Errorf(\"closeout job %s: %w\", id, ErrBusy)\n\t}\n\tdefer c.release(id)\n\t// Read after taking the lock: a Run may have closed the job meanwhile.\n\tsj, err := c.d.Store.Job(ctx, id)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"closeout job %s: load job: %w\", id, err)\n\t}\n\tif sj.CloseoutPhase == \"\" || sj.CloseoutPhase == string(PhaseClosed) || len(sj.CloseoutPlan) == 0 {\n\t\treturn \"\", fmt.Errorf(\"closeout job %s: no open close-out: %w\", id, state.ErrNotFound)\n\t}\n\trec, err := decode(sj)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tc.d.log().Info(\"closeout.resume\", \"job\", id, \"issue\", rec.Job.Issue, \"phase\", rec.Phase)\n\treturn c.advance(ctx, rec)\n}\n\n// Resume finishes every close-out that was started and not closed.\nfunc (c *Closer) Resume(ctx context.Context) error {\n\tif err := c.checkDeps(); err != nil {\n\t\treturn err\n\t}\n\tjobs, err := c.d.Store.OpenCloseouts(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"closeout resume: %w\", err)\n\t}\n\tvar errs []error\n\tfor _, sj := range jobs {\n\t\t// ResumeJob re-reads the record after taking the job's lock. Advancing\n\t\t// the copy listed above could replay phases a concurrent Run has\n\t\t// already finished, and overwrite its closed record with a stale one.\n\t\t_, err := c.ResumeJob(ctx, sj.ID)\n\t\tswitch {\n\t\tcase err == nil:\n\t\tcase errors.Is(err, ErrBusy):\n\t\t\tc.d.log().Info(\"closeout.resume skipped: in flight\", \"job\", sj.ID)\n\t\tcase errors.Is(err, state.ErrNotFound):\n\t\t\t// Closed by a concurrent Run since the list was read.\n\t\tdefault:\n\t\t\terrs = append(errs, err)\n\t\t}\n\t}\n\treturn errors.Join(errs...)\n}\n\nfunc decode(sj state.Job) (Record, error) {\n\tvar rec Record\n\tif err := json.Unmarshal(sj.CloseoutPlan, &rec); err != nil {\n\t\treturn Record{}, fmt.Errorf(\"closeout job %s: decode record: %w\", sj.ID, err)\n\t}\n\tif rec.Version != recordVersion {\n\t\treturn Record{}, fmt.Errorf(\"closeout job %s: record version %d, want %d\", sj.ID, rec.Version, recordVersion)\n\t}\n\treturn rec, nil\n}\n\nfunc (c *Closer) save(ctx context.Context, rec Record) error {\n\tb, err := json.Marshal(rec)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"closeout job %s: encode record: %w\", rec.Job.ID, err)\n\t}\n\tif err := c.d.Store.SetCloseout(ctx, rec.Job.ID, string(rec.Phase), b); err != nil {\n\t\treturn fmt.Errorf(\"closeout job %s phase %s: save: %w\", rec.Job.ID, rec.Phase, err)\n\t}\n\treturn nil\n}\n\nfunc (c *Closer) fail(rec Record, err error) error {\n\terr = fmt.Errorf(\"closeout job %s phase %s: %w\", rec.Job.ID, rec.Phase, err)\n\tc.d.log().Error(\"closeout failed\", \"job\", rec.Job.ID, \"issue\", rec.Job.Issue, \"phase\", rec.Phase, \"error\", err)\n\treturn err\n}\n\n// advance runs the steps after rec.Phase.\nfunc (c *Closer) advance(ctx context.Context, rec Record) (Outcome, error) {\n\tif rec.Phase == PhaseClosed {\n\t\treturn rec.Plan.Outcome, nil\n\t}\n\tif rec.Phase == PhasePrepared {\n\t\tif err := c.commit(ctx, &rec); err != nil {\n\t\t\treturn \"\", c.fail(rec, err)\n\t\t}\n\t\trec.Phase = PhaseCommitted\n\t\tif err := c.save(ctx, rec); err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t}\n\tif rec.Phase == PhaseCommitted {\n\t\tif err := c.request(ctx, rec); err != nil {\n\t\t\treturn \"\", c.fail(rec, err)\n\t\t}\n\t\trec.Phase = PhaseRequested\n\t\tif err := c.save(ctx, rec); err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t}\n\tif rec.Phase == PhaseRequested {\n\t\tif err := c.comment(ctx, &rec); err != nil {\n\t\t\treturn \"\", c.fail(rec, err)\n\t\t}\n\t\trec.Phase = PhaseCommented\n\t\tif err := c.save(ctx, rec); err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t}\n\tif err := c.finish(ctx, rec); err != nil {\n\t\treturn \"\", c.fail(rec, err)\n\t}\n\trec.Phase = PhaseClosed\n\tif err := c.save(ctx, rec); err != nil {\n\t\treturn \"\", err\n\t}\n\tif err := os.RemoveAll(filepath.Join(c.d.StagingDir, rec.Job.ID)); err != nil {\n\t\tc.d.log().Warn(\"closeout: remove staging\", \"job\", rec.Job.ID, \"error\", err)\n\t}\n\tif rec.Synthetic || c.d.Effects.DryRun() {\n\t\tc.d.log().Info(\"closeout: raw log kept (dry-run)\", \"job\", rec.Job.ID)\n\t} else {\n\t\tc.dropRawLog(rec)\n\t}\n\treturn rec.Plan.Outcome, nil\n}\n\n// commit hands the staged files to the committer. A permanent error (the\n// committer already retried) turns the job into a failure with no files.\nfunc (c *Closer) commit(ctx context.Context, rec *Record) error {\n\tp := &rec.Plan\n\tif len(p.Files) == 0 {\n\t\treturn nil\n\t}\n\tisReview := rec.Job.Stage == StageReview && p.Review != nil\n\tif isReview && rec.Job.PR > 0 && c.d.PR != nil {\n\t\tpr, err := c.d.PR(ctx, rec.Job.PR)\n\t\tswitch {\n\t\tcase err != nil:\n\t\t\tc.d.log().Warn(\"closeout: read PR before commit\", \"job\", rec.Job.ID, \"pr\", rec.Job.PR, \"error\", err)\n\t\tcase pr.Merged || pr.State != github.StateOpen:\n\t\t\twhy := \"closed\"\n\t\t\tif pr.Merged {\n\t\t\t\twhy = \"merged\"\n\t\t\t}\n\t\t\tc.prGone(rec, why, why)\n\t\t\treturn nil\n\t\t}\n\t}\n\treq := committer.Request{Issue: rec.Job.Issue, Stage: rec.Job.Stage, Role: rec.Job.Role,\n\t\tSummary: commitSummary(*p), JobID: rec.Job.ID}\n\tsec := sectionOf(c.d.Roles, rec.Job.Stage, rec.Job.Role)\n\tplanPath := fmt.Sprintf(\".ard/%d/plan.md\", rec.Job.Issue)\n\tfor _, f := range p.Files {\n\t\tcf := committer.File{Path: f.Path, Delete: f.Delete}\n\t\tif !f.Delete {\n\t\t\tcf.Src = f.Staged\n\t\t\tif sec != \"\" && f.Path == planPath && rec.Job.Branch == \"\" {\n\t\t\t\tcf.Merge = mergeOwnSection(sec)\n\t\t\t}\n\t\t}\n\t\treq.Files = append(req.Files, cf)\n\t}\n\tres, err := c.d.Committer.Commit(ctx, rec.Job.Branch, req)\n\tswitch {\n\tcase err == nil:\n\t\trec.SHA, rec.Synthetic = res.SHA, res.Synthetic\n\t\treturn nil\n\tcase errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded):\n\t\treturn err\n\t}\n\tc.d.log().Warn(\"closeout: commit failed\", \"job\", rec.Job.ID, \"error\", err)\n\tif p.Outcome == OutcomeRetry || p.Outcome == OutcomeLimited {\n\t\t// The log is evidence, not the result: a retry or a limit stop must\n\t\t// not turn into a failure because it could not be committed (a worker\n\t\t// that stopped before its first push has no branch to commit to).\n\t\tp.Files, p.LogPath = nil, \"\"\n\t\tp.Reason += \"; log not committed: \" + err.Error()\n\t\treturn nil\n\t}\n\ttail, tailWithheld, keep := p.Tail, p.TailWithheld, p.KeepUntil\n\tif isReview && errors.Is(err, committer.ErrBranchGone) {\n\t\tc.prGone(rec, \"branch gone\", \"branch_gone\")\n\t\treturn nil\n\t}\n\tif errors.Is(err, committer.ErrMerge) {\n\t\treturn c.commitConflict(ctx, rec, err, tail, tailWithheld, keep)\n\t}\n\t*p = failedPlan(rec.Job, \"commit failed: \"+err.Error(), p.LogWithheld)\n\tp.Tail, p.TailWithheld, p.KeepUntil = tail, tailWithheld, keep\n\treturn nil\n}\n\n// prGone turns a review's plan into a stale one: its PR was merged or closed,\n// or its branch deleted, so there is nothing to commit to and nothing failed.\nfunc (c *Closer) prGone(rec *Record, why, state string) {\n\tc.d.log().Warn(\"review.pr_gone\", \"job\", rec.Job.ID, \"pr\", rec.Job.PR, \"issue\", rec.Job.Issue,\n\t\t\"role\", rec.Job.Role, \"state\", state)\n\trec.Plan = stalePRPlan(rec.Plan, rec.Job, why)\n}\n\n// commitConflict turns a plan.md merge conflict into needs-human. Like an\n// allowlist denial it still commits the redacted log and the controller's usage\n// record, and nothing else: neither carries no Merge func, so it cannot hit the conflict again.\nfunc (c *Closer) commitConflict(ctx context.Context, rec *Record, cause error, tail string, tailWithheld bool, keep time.Time) error {\n\tp := &rec.Plan\n\tlogPath := p.LogPath\n\tusagePath := fmt.Sprintf(\".ard/%d/costs/%s.json\", rec.Job.Issue, rec.Job.ID)\n\tvar logFiles []FileRef\n\tfor _, f := range p.Files {\n\t\tif (logPath != \"\" && f.Path == logPath) || f.Path == usagePath {\n\t\t\tlogFiles = append(logFiles, f)\n\t\t}\n\t}\n\t*p = needsHumanPlan(rec.Job, p.Status, \"plan.md conflict: \"+cause.Error())\n\tp.Tail, p.TailWithheld, p.KeepUntil = tail, tailWithheld, keep\n\tif len(logFiles) == 0 {\n\t\treturn nil\n\t}\n\treq := committer.Request{Issue: rec.Job.Issue, Stage: rec.Job.Stage, Role: rec.Job.Role,\n\t\tSummary: commitSummary(*p), JobID: rec.Job.ID}\n\tfor _, f := range logFiles {\n\t\treq.Files = append(req.Files, committer.File{Path: f.Path, Src: f.Staged})\n\t}\n\tres, err := c.d.Committer.Commit(ctx, rec.Job.Branch, req)\n\tswitch {\n\tcase err == nil:\n\t\tp.Files, p.LogPath = logFiles, logPath\n\t\trec.SHA, rec.Synthetic = res.SHA, res.Synthetic\n\t\treturn nil\n\tcase errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded):\n\t\treturn err\n\t}\n\tc.d.log().Warn(\"closeout: commit log after plan conflict failed\", \"job\", rec.Job.ID, \"error\", err)\n\tp.Reason += \"; log not committed: \" + err.Error()\n\treturn nil\n}\n\nfunc commitSummary(p Plan) string {\n\tfor _, s := range []string{p.Summary, p.Reason} {\n\t\tif l := strings.TrimSpace(strings.SplitN(strings.TrimSpace(s), \"\\n\", 2)[0]); l != \"\" {\n\t\t\treturn l\n\t\t}\n\t}\n\treturn \"close-out \" + string(p.Outcome)\n}\n\n// request applies the next labels, grouped by target number.\nfunc (c *Closer) request(ctx context.Context, rec Record) error {\n\treturn c.addGrouped(ctx, rec.Plan.Requests)\n}\n\nfunc (c *Closer) addGrouped(ctx context.Context, ls []Label) error {\n\tvar order []int\n\tby := map[int][]string{}\n\tfor _, l := range ls {\n\t\tif _, ok := by[l.Number]; !ok {\n\t\t\torder = append(order, l.Number)\n\t\t}\n\t\tby[l.Number] = append(by[l.Number], l.Name)\n\t}\n\tfor _, n := range order {\n\t\tif err := c.d.Effects.AddLabels(ctx, n, by[n]...); err != nil {\n\t\t\treturn fmt.Errorf(\"add labels on #%d: %w\", n, err)\n\t\t}\n\t}\n\treturn nil\n}\n\n// comment posts the summary once; the marker makes a replay find it.\nfunc (c *Closer) comment(ctx context.Context, rec *Record) error {\n\tif rec.Plan.Review != nil {\n\t\treturn c.postReview(ctx, rec)\n\t}\n\tn := rec.Job.target()\n\tif n > 0 && c.d.Comments != nil {\n\t\tcs, err := c.d.Comments.ListComments(ctx, n, time.Time{})\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"list comments on #%d: %w\", n, err)\n\t\t}\n\t\tfor _, cm := range cs {\n\t\t\tif strings.HasPrefix(cm.Body, markerFor(rec.Job.ID)) {\n\t\t\t\trec.CommentID = cm.ID\n\t\t\t\treturn nil\n\t\t\t}\n\t\t}\n\t}\n\tcm, err := c.d.Effects.CreateComment(ctx, n, RenderComment(*rec, c.d.Repo, c.d.Effects.DryRun()))\n\tif err != nil {\n\t\treturn fmt.Errorf(\"comment on #%d: %w\", n, err)\n\t}\n\trec.CommentID = cm.ID\n\treturn nil\n}\n\n// postReview posts a review job's summary and findings once: one PR review\n// with inline comments, else (GitHub answers 422: a line or the commit is not\n// in the PR) one review with every finding in its body, else a plain comment.\n// A 422 created nothing, so a replay walks the same chain. Any other error is\n// returned and the close-out stays resumable. The marker in the body makes a\n// replay after a crash find an earlier post.\nfunc (c *Closer) postReview(ctx context.Context, rec *Record) error {\n\tj, rp := rec.Job, rec.Plan.Review\n\tn := j.target()\n\tif n > 0 && c.d.Comments != nil {\n\t\trs, err := c.d.Comments.ListReviews(ctx, n)\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"list reviews on #%d: %w\", n, err)\n\t\t}\n\t\tfor _, r := range rs {\n\t\t\tif strings.HasPrefix(r.Body, markerFor(j.ID)) {\n\t\t\t\trec.CommentID, rec.ReviewMode = r.ID, ReviewFound\n\t\t\t\treturn nil\n\t\t\t}\n\t\t}\n\t\tcs, err := c.d.Comments.ListComments(ctx, n, time.Time{})\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"list comments on #%d: %w\", n, err)\n\t\t}\n\t\tfor _, cm := range cs {\n\t\t\tif strings.HasPrefix(cm.Body, markerFor(j.ID)) {\n\t\t\t\trec.CommentID, rec.ReviewMode = cm.ID, ReviewFound\n\t\t\t\treturn nil\n\t\t\t}\n\t\t}\n\t}\n\tdry := c.d.Effects.DryRun()\n\trejected := func(err error) bool {\n\t\tvar he *github.HTTPError\n\t\treturn errors.As(err, &he) && he.Status == 422\n\t}\n\tinline := inlineComments(rp)\n\tif len(inline) > 0 {\n\t\trid, err := c.d.Effects.CreateReview(ctx, n, github.ReviewInput{CommitSHA: rp.CommitSHA,\n\t\t\tBody: RenderReview(*rec, c.d.Repo, dry, false), Comments: inline})\n\t\tif err == nil {\n\t\t\trec.CommentID, rec.ReviewMode = rid, ReviewInline\n\t\t\treturn nil\n\t\t}\n\t\tif !rejected(err) {\n\t\t\treturn c.postFailed(rec, fmt.Errorf(\"review on #%d: %w\", n, err))\n\t\t}\n\t\tc.d.log().Warn(\"closeout.review_inline_rejected\", \"job\", j.ID, \"pr\", n, \"error\", err)\n\t}\n\tbody := RenderReview(*rec, c.d.Repo, dry, len(inline) > 0)\n\trid, err := c.d.Effects.CreateReview(ctx, n, github.ReviewInput{CommitSHA: rp.CommitSHA, Body: body})\n\tif err == nil {\n\t\trec.CommentID, rec.ReviewMode = rid, ReviewBody\n\t\treturn nil\n\t}\n\tif !rejected(err) {\n\t\treturn c.postFailed(rec, fmt.Errorf(\"review on #%d: %w\", n, err))\n\t}\n\tc.d.log().Warn(\"closeout.review_rejected\", \"job\", j.ID, \"pr\", n, \"error\", err)\n\tcm, err := c.d.Effects.CreateComment(ctx, n, body)\n\tif err != nil {\n\t\treturn c.postFailed(rec, fmt.Errorf(\"comment on #%d: %w\", n, err))\n\t}\n\trec.CommentID, rec.ReviewMode = cm.ID, ReviewComment\n\treturn nil\n}\n\n// postFailed passes a review-post error on, except for a stale review of a\n// gone PR: posting there is best-effort, so the error is logged and dropped.\nfunc (c *Closer) postFailed(rec *Record, err error) error {\n\tif rp := rec.Plan.Review; rp != nil && rp.PRGone != \"\" {\n\t\tc.d.log().Warn(\"closeout: review not posted on gone PR\", \"job\", rec.Job.ID, \"pr\", rec.Job.PR, \"error\", err)\n\t\treturn nil\n\t}\n\treturn err\n}\n\n// finish swaps the labels (\":running\" is removed last, so it marks the commit\n// point) and closes the job in state.\nfunc (c *Closer) finish(ctx context.Context, rec Record) error {\n\tp := rec.Plan\n\tif err := c.addGrouped(ctx, p.Terminal); err != nil {\n\t\treturn err\n\t}\n\tfor _, l := range p.Remove {\n\t\tif err := c.d.Effects.RemoveLabel(ctx, l.Number, l.Name); err != nil {\n\t\t\treturn fmt.Errorf(\"remove %s on #%d: %w\", l.Name, l.Number, err)\n\t\t}\n\t}\n\tvar cost *float64\n\tif rec.Job.CostUSD > 0 {\n\t\tv := rec.Job.CostUSD\n\t\tcost = &v\n\t}\n\tkeep := p.KeepUntil\n\tif keep.IsZero() {\n\t\tkeep = c.d.now().Add(failedKeep)\n\t}\n\tvar err error\n\tswitch p.Outcome {\n\tcase OutcomeFailed:\n\t\terr = c.d.Store.Fail(ctx, rec.Job.ID, clip(p.Reason, maxReasonRunes), keep)\n\tcase OutcomeRetry:\n\t\terr = c.d.Store.FailRetry(ctx, rec.Job.ID, clip(p.Reason, maxReasonRunes), keep)\n\tcase OutcomeLimited:\n\t\terr = c.d.Store.FailLimited(ctx, rec.Job.ID, clip(p.Reason, maxReasonRunes), keep)\n\tdefault:\n\t\terr = c.d.Store.Complete(ctx, rec.Job.ID, cost)\n\t}\n\tif err != nil {\n\t\treturn fmt.Errorf(\"close job in state: %w\", err)\n\t}\n\treturn nil\n}\n\n// dropRawLog deletes the unredacted host log once its redacted copy has been\n// committed. It is kept, and the keep is logged, when redaction failed or the\n// scan flagged it (so a human can inspect it) or when the commit did not\n// carry it.\nfunc (c *Closer) dropRawLog(rec Record) {\n\tj := rec.Job\n\tcommitted := map[string]bool{}\n\tfor _, p := range rec.Plan.ExtraLogPaths {\n\t\tcommitted[p] = true\n\t}\n\tdrop := func(path string, ok bool) {\n\t\tif !ok {\n\t\t\tc.d.log().Warn(\"closeout: raw log kept\", \"job\", j.ID, \"path\", path, \"withheld\", rec.Plan.LogWithheld)\n\t\t\treturn\n\t\t}\n\t\tif err := os.Remove(path); err != nil && !errors.Is(err, os.ErrNotExist) {\n\t\t\tc.d.log().Warn(\"closeout: remove raw log\", \"job\", j.ID, \"path\", path, \"error\", err)\n\t\t}\n\t}\n\tif j.LogPath != \"\" {\n\t\tdrop(j.LogPath, rec.Plan.LogPath != \"\")\n\t}\n\tfor _, extra := range j.ExtraLogs {\n\t\tcp, err := redact.CommitPath(rec.Job.Issue, extra)\n\t\tdrop(extra, err == nil && committed[cp])\n\t}\n}\n\n// TriageRoles returns the triage roles that ran to a closed, done close-out\n// for issue. Failed, open and needs-human jobs do not count.\nfunc TriageRoles(ctx context.Context, s interface {\n\tCloseoutsOf(ctx context.Context, issue int, stage string) ([]state.Job, error)\n}, issue int) (map[string]bool, error) {\n\tjobs, err := s.CloseoutsOf(ctx, issue, StageTriage)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"triage roles of issue %d: %w\", issue, err)\n\t}\n\tout := map[string]bool{}\n\tfor _, sj := range jobs {\n\t\trec, err := decode(sj)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tif rec.Phase == PhaseClosed && rec.Plan.Outcome == OutcomeDone {\n\t\t\tout[sj.Role] = true\n\t\t}\n\t}\n\treturn out, nil\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"810fcc1c-bd8c-400e-9091-18198e00ee90","uuid":"ef07bdc4-7a80-47ba-8937-bceb826095e0","timestamp":"2026-11-25T13:09:09.054Z","tool_use_result":{"stdout":"\tStagingDir string\n\tLog        *slog.Logger\n\tNow        func() time.Time\n}\n\nfunc (d Deps) log() *slog.Logger {\n\tif d.Log != nil {\n\t\treturn d.Log\n\t}\n\treturn slog.Default()\n}\n\nfunc (d Deps) now() time.Time {\n\tif d.Now != nil {\n\t\treturn d.Now()\n\t}\n\treturn time.Now()\n}\n\n// Closer executes close-out plans.\ntype Closer struct {\n\td    Deps\n\tmu   sync.Mutex\n\tbusy map[string]bool // jobs with an advance in flight\n}\n\n// New returns a Closer.\nfunc New(d Deps) *Closer { return &Closer{d: d, busy: map[string]bool{}} }\n\n// acquire marks a job busy; it reports false when another Run or Resume\n// already holds it. Without it a concurrent list-then-create would double-post.\nfunc (c *Closer) acquire(id string) bool {\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\tif c.busy == nil {\n\t\tc.busy = map[string]bool{}\n\t}\n\tif c.busy[id] {\n\t\treturn false\n\t}\n\tc.busy[id] = true\n\treturn true\n}\n\nfunc (c *Closer) release(id string) {\n\tc.mu.Lock()\n\tdelete(c.busy, id)\n\tc.mu.Unlock()\n}\n\n// checkDeps refuses a live Closer that cannot look for its own comment.\nfunc (c *Closer) checkDeps() error {\n\tif c.d.Comments == nil && !c.d.Effects.DryRun() {\n\t\treturn errors.New(\"closeout: Deps.Comments is required outside dry-run (a replay would post twice)\")\n\t}\n\treturn nil\n}\n\n// Run closes out j. If the job already has a record it resumes that one and\n// never reads the worktree again.\nfunc (c *Closer) Run(ctx context.Context, j Job) (Outcome, error) {\n\tif err := j.validate(); err != nil {\n\t\treturn \"\", err\n\t}\n\tif err := c.checkDeps(); err != nil {\n\t\treturn \"\", err\n\t}\n\tif !c.acquire(j.ID) {\n\t\treturn \"\", fmt.Errorf(\"closeout job %s: %w\", j.ID, ErrBusy)\n\t}\n\tdefer c.release(j.ID)\n\tsj, err := c.d.Store.Job(ctx, j.ID)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"closeout job %s: load job: %w\", j.ID, err)\n\t}\n\tif sj.CloseoutPhase != \"\" && len(sj.CloseoutPlan) > 0 {\n\t\trec, err := decode(sj)\n\t\tif err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\treturn c.advance(ctx, rec)\n\t}\n\tstart := c.d.now()\n\trec, err := Prepare(ctx, j, c.d)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"closeout job %s: prepare: %w\", j.ID, err)\n\t}\n\tif err := c.save(ctx, rec); err != nil {\n\t\treturn \"\", err\n\t}\n\tout, err := c.advance(ctx, rec)\n\tif err == nil {\n\t\tc.d.log().Info(\"closeout\", \"job\", j.ID, \"issue\", j.Issue, \"stage\", j.Stage, \"role\", j.Role,\n\t\t\t\"outcome\", out, \"skipped\", len(rec.Plan.Skipped), \"dur\", c.d.now().Sub(start))\n\t}\n\treturn out, err\n}\n\n// ResumeJob finishes the open close-out of one job. A job with no open phase\n// is state.ErrNotFound (wrapped); one whose close-out another goroutine is\n// advancing is ErrBusy. The Reaper uses it for jobs nobody is driving.\nfunc (c *Closer) ResumeJob(ctx context.Context, id string) (Outcome, error) {\n\tif err := c.checkDeps(); err != nil {\n\t\treturn \"\", err\n\t}\n\tif !c.acquire(id) {\n\t\treturn \"\", fmt.Errorf(\"closeout job %s: %w\", id, ErrBusy)\n\t}\n\tdefer c.release(id)\n\t// Read after taking the lock: a Run may have closed the job meanwhile.\n\tsj, err := c.d.Store.Job(ctx, id)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"closeout job %s: load job: %w\", id, err)\n\t}\n\tif sj.CloseoutPhase == \"\" || sj.CloseoutPhase == string(PhaseClosed) || len(sj.CloseoutPlan) == 0 {\n\t\treturn \"\", fmt.Errorf(\"closeout job %s: no open close-out: %w\", id, state.ErrNotFound)\n\t}\n\trec, err := decode(sj)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tc.d.log().Info(\"closeout.resume\", \"job\", id, \"issue\", rec.Job.Issue, \"phase\", rec.Phase)\n\treturn c.advance(ctx, rec)\n}\n\n// Resume finishes every close-out that was started and not closed.\nfunc (c *Closer) Resume(ctx context.Context) error {\n\tif err := c.checkDeps(); err != nil {\n\t\treturn err\n\t}\n\tjobs, err := c.d.Store.OpenCloseouts(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"closeout resume: %w\", err)\n\t}\n\tvar errs []error\n\tfor _, sj := range jobs {\n\t\t// ResumeJob re-reads the record after taking the job's lock. Advancing\n\t\t// the copy listed above could replay phases a concurrent Run has\n\t\t// already finished, and overwrite its closed record with a stale one.\n\t\t_, err := c.ResumeJob(ctx, sj.ID)\n\t\tswitch {\n\t\tcase err == nil:\n\t\tcase errors.Is(err, ErrBusy):\n\t\t\tc.d.log().Info(\"closeout.resume skipped: in flight\", \"job\", sj.ID)\n\t\tcase errors.Is(err, state.ErrNotFound):\n\t\t\t// Closed by a concurrent Run since the list was read.\n\t\tdefault:\n\t\t\terrs = append(errs, err)\n\t\t}\n\t}\n\treturn errors.Join(errs...)\n}\n\nfunc decode(sj state.Job) (Record, error) {\n\tvar rec Record\n\tif err := json.Unmarshal(sj.CloseoutPlan, &rec); err != nil {\n\t\treturn Record{}, fmt.Errorf(\"closeout job %s: decode record: %w\", sj.ID, err)\n\t}\n\tif rec.Version != recordVersion {\n\t\treturn Record{}, fmt.Errorf(\"closeout job %s: record version %d, want %d\", sj.ID, rec.Version, recordVersion)\n\t}\n\treturn rec, nil\n}\n\nfunc (c *Closer) save(ctx context.Context, rec Record) error {\n\tb, err := json.Marshal(rec)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"closeout job %s: encode record: %w\", rec.Job.ID, err)\n\t}\n\tif err := c.d.Store.SetCloseout(ctx, rec.Job.ID, string(rec.Phase), b); err != nil {\n\t\treturn fmt.Errorf(\"closeout job %s phase %s: save: %w\", rec.Job.ID, rec.Phase, err)\n\t}\n\treturn nil\n}\n\nfunc (c *Closer) fail(rec Record, err error) error {\n\terr = fmt.Errorf(\"closeout job %s phase %s: %w\", rec.Job.ID, rec.Phase, err)\n\tc.d.log().Error(\"closeout failed\", \"job\", rec.Job.ID, \"issue\", rec.Job.Issue, \"phase\", rec.Phase, \"error\", err)\n\treturn err\n}\n\n// advance runs the steps after rec.Phase.\nfunc (c *Closer) advance(ctx context.Context, rec Record) (Outcome, error) {\n\tif rec.Phase == PhaseClosed {\n\t\treturn rec.Plan.Outcome, nil\n\t}\n\tif rec.Phase == PhasePrepared {\n\t\tif err := c.commit(ctx, &rec); err != nil {\n\t\t\treturn \"\", c.fail(rec, err)\n\t\t}\n\t\trec.Phase = PhaseCommitted\n\t\tif err := c.save(ctx, rec); err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t}\n\tif rec.Phase == PhaseCommitted {\n\t\tif err := c.request(ctx, rec); err != nil {\n\t\t\treturn \"\", c.fail(rec, err)\n\t\t}\n\t\trec.Phase = PhaseRequested\n\t\tif err := c.save(ctx, rec); err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t}\n\tif rec.Phase == PhaseRequested {\n\t\tif err := c.comment(ctx, &rec); err != nil {\n\t\t\treturn \"\", c.fail(rec, err)\n\t\t}\n\t\trec.Phase = PhaseCommented\n\t\tif err := c.save(ctx, rec); err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t}\n\tif err := c.finish(ctx, rec); err != nil {\n\t\treturn \"\", c.fail(rec, err)\n\t}\n\trec.Phase = PhaseClosed\n\tif err := c.save(ctx, rec); err != nil {\n\t\treturn \"\", err\n\t}\n\tif err := os.RemoveAll(filepath.Join(c.d.StagingDir, rec.Job.ID)); err != nil {\n\t\tc.d.log().Warn(\"closeout: remove staging\", \"job\", rec.Job.ID, \"error\", err)\n\t}\n\tif rec.Synthetic || c.d.Effects.DryRun() {\n\t\tc.d.log().Info(\"closeout: raw log kept (dry-run)\", \"job\", rec.Job.ID)\n\t} else {\n\t\tc.dropRawLog(rec)\n\t}\n\treturn rec.Plan.Outcome, nil\n}\n\n// commit hands the staged files to the committer. A permanent error (the\n// committer already retried) turns the job into a failure with no files.\nfunc (c *Closer) commit(ctx context.Context, rec *Record) error {\n\tp := &rec.Plan\n\tif len(p.Files) == 0 {\n\t\treturn nil\n\t}\n\tisReview := rec.Job.Stage == StageReview && p.Review != nil\n\tif isReview && rec.Job.PR > 0 && c.d.PR != nil {\n\t\tpr, err := c.d.PR(ctx, rec.Job.PR)\n\t\tswitch {\n\t\tcase err != nil:\n\t\t\tc.d.log().Warn(\"closeout: read PR before commit\", \"job\", rec.Job.ID, \"pr\", rec.Job.PR, \"error\", err)\n\t\tcase pr.Merged || pr.State != github.StateOpen:\n\t\t\twhy := \"closed\"\n\t\t\tif pr.Merged {\n\t\t\t\twhy = \"merged\"\n\t\t\t}\n\t\t\tc.prGone(rec, why, why)\n\t\t\treturn nil\n\t\t}\n\t}\n\treq := committer.Request{Issue: rec.Job.Issue, Stage: rec.Job.Stage, Role: rec.Job.Role,\n\t\tSummary: commitSummary(*p), JobID: rec.Job.ID}\n\tsec := sectionOf(c.d.Roles, rec.Job.Stage, rec.Job.Role)\n\tplanPath := fmt.Sprintf(\".ard/%d/plan.md\", rec.Job.Issue)\n\tfor _, f := range p.Files {\n\t\tcf := committer.File{Path: f.Path, Delete: f.Delete}\n\t\tif !f.Delete {\n\t\t\tcf.Src = f.Staged\n\t\t\tif sec != \"\" && f.Path == planPath && rec.Job.Branch == \"\" {\n\t\t\t\tcf.Merge = mergeOwnSection(sec)\n\t\t\t}\n\t\t}\n\t\treq.Files = append(req.Files, cf)\n\t}\n\tres, err := c.d.Committer.Commit(ctx, rec.Job.Branch, req)\n\tswitch {\n\tcase err == nil:\n\t\trec.SHA, rec.Synthetic = res.SHA, res.Synthetic\n\t\treturn nil\n\tcase errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded):\n\t\treturn err\n\t}\n\tc.d.log().Warn(\"closeout: commit failed\", \"job\", rec.Job.ID, \"error\", err)\n\tif p.Outcome == OutcomeRetry || p.Outcome == OutcomeLimited {\n\t\t// The log is evidence, not the result: a retry or a limit stop must\n\t\t// not turn into a failure because it could not be committed (a worker\n\t\t// that stopped before its first push has no branch to commit to).\n\t\tp.Files, p.LogPath = nil, \"\"\n\t\tp.Reason += \"; log not committed: \" + err.Error()\n\t\treturn nil\n\t}\n\ttail, tailWithheld, keep := p.Tail, p.TailWithheld, p.KeepUntil\n\tif isReview && errors.Is(err, committer.ErrBranchGone) {\n\t\tc.prGone(rec, \"branch gone\", \"branch_gone\")\n\t\treturn nil\n\t}\n\tif errors.Is(err, committer.ErrMerge) {\n\t\treturn c.commitConflict(ctx, rec, err, tail, tailWithheld, keep)\n\t}\n\t*p = failedPlan(rec.Job, \"commit failed: \"+err.Error(), p.LogWithheld)\n\tp.Tail, p.TailWithheld, p.KeepUntil = tail, tailWithheld, keep\n\treturn nil\n}\n\n// prGone turns a review's plan into a stale one: its PR was merged or closed,\n// or its branch deleted, so there is nothing to commit to and nothing failed.\nfunc (c *Closer) prGone(rec *Record, why, state string) {\n\tc.d.log().Warn(\"review.pr_gone\", \"job\", rec.Job.ID, \"pr\", rec.Job.PR, \"issue\", rec.Job.Issue,\n\t\t\"role\", rec.Job.Role, \"state\", state)\n\trec.Plan = stalePRPlan(rec.Plan, rec.Job, why)\n}\n\n// commitConflict turns a plan.md merge conflict into needs-human. Like an\n// allowlist denial it still commits the redacted log and the controller's usage\n// record, and nothing else: neither carries no Merge func, so it cannot hit the conflict again.\nfunc (c *Closer) commitConflict(ctx context.Context, rec *Record, cause error, tail string, tailWithheld bool, keep time.Time) error {\n\tp := &rec.Plan\n\tlogPath := p.LogPath\n\tusagePath := fmt.Sprintf(\".ard/%d/costs/%s.json\", rec.Job.Issue, rec.Job.ID)\n\tvar logFiles []FileRef\n\tfor _, f := range p.Files {\n\t\tif (logPath != \"\" && f.Path == logPath) || f.Path == usagePath {\n\t\t\tlogFiles = append(logFiles, f)\n\t\t}\n\t}\n\t*p = needsHumanPlan(rec.Job, p.Status, \"plan.md conflict: \"+cause.Error())\n\tp.Tail, p.TailWithheld, p.KeepUntil = tail, tailWithheld, keep\n\tif len(logFiles) == 0 {\n\t\treturn nil\n\t}\n\treq := committer.Request{Issue: rec.Job.Issue, Stage: rec.Job.Stage, Role: rec.Job.Role,\n\t\tSummary: commitSummary(*p), JobID: rec.Job.ID}\n\tfor _, f := range logFiles {\n\t\treq.Files = append(req.Files, committer.File{Path: f.Path, Src: f.Staged})\n\t}\n\tres, err := c.d.Committer.Commit(ctx, rec.Job.Branch, req)\n\tswitch {\n\tcase err == nil:\n\t\tp.Files, p.LogPath = logFiles, logPath\n\t\trec.SHA, rec.Synthetic = res.SHA, res.Synthetic\n\t\treturn nil\n\tcase errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded):\n\t\treturn err\n\t}\n\tc.d.log().Warn(\"closeout: commit log after plan conflict failed\", \"job\", rec.Job.ID, \"error\", err)\n\tp.Reason += \"; log not committed: \" + err.Error()\n\treturn nil\n}\n\nfunc commitSummary(p Plan) string {\n\tfor _, s := range []string{p.Summary, p.Reason} {\n\t\tif l := strings.TrimSpace(strings.SplitN(strings.TrimSpace(s), \"\\n\", 2)[0]); l != \"\" {\n\t\t\treturn l\n\t\t}\n\t}\n\treturn \"close-out \" + string(p.Outcome)\n}\n\n// request applies the next labels, grouped by target number.\nfunc (c *Closer) request(ctx context.Context, rec Record) error {\n\treturn c.addGrouped(ctx, rec.Plan.Requests)\n}\n\nfunc (c *Closer) addGrouped(ctx context.Context, ls []Label) error {\n\tvar order []int\n\tby := map[int][]string{}\n\tfor _, l := range ls {\n\t\tif _, ok := by[l.Number]; !ok {\n\t\t\torder = append(order, l.Number)\n\t\t}\n\t\tby[l.Number] = append(by[l.Number], l.Name)\n\t}\n\tfor _, n := range order {\n\t\tif err := c.d.Effects.AddLabels(ctx, n, by[n]...); err != nil {\n\t\t\treturn fmt.Errorf(\"add labels on #%d: %w\", n, err)\n\t\t}\n\t}\n\treturn nil\n}\n\n// comment posts the summary once; the marker makes a replay find it.\nfunc (c *Closer) comment(ctx context.Context, rec *Record) error {\n\tif rec.Plan.Review != nil {\n\t\treturn c.postReview(ctx, rec)\n\t}\n\tn := rec.Job.target()\n\tif n > 0 && c.d.Comments != nil {\n\t\tcs, err := c.d.Comments.ListComments(ctx, n, time.Time{})\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"list comments on #%d: %w\", n, err)\n\t\t}\n\t\tfor _, cm := range cs {\n\t\t\tif strings.HasPrefix(cm.Body, markerFor(rec.Job.ID)) {\n\t\t\t\trec.CommentID = cm.ID\n\t\t\t\treturn nil\n\t\t\t}\n\t\t}\n\t}\n\tcm, err := c.d.Effects.CreateComment(ctx, n, RenderComment(*rec, c.d.Repo, c.d.Effects.DryRun()))\n\tif err != nil {\n\t\treturn fmt.Errorf(\"comment on #%d: %w\", n, err)\n\t}\n\trec.CommentID = cm.ID\n\treturn nil\n}\n\n// postReview posts a review job's summary and findings once: one PR review\n// with inline comments, else (GitHub answers 422: a line or the commit is not\n// in the PR) one review with every finding in its body, else a plain comment.\n// A 422 created nothing, so a replay walks the same chain. Any other error is\n// returned and the close-out stays resumable. The marker in the body makes a\n// replay after a crash find an earlier post.\nfunc (c *Closer) postReview(ctx context.Context, rec *Record) error {\n\tj, rp := rec.Job, rec.Plan.Review\n\tn := j.target()\n\tif n > 0 && c.d.Comments != nil {\n\t\trs, err := c.d.Comments.ListReviews(ctx, n)\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"list reviews on #%d: %w\", n, err)\n\t\t}\n\t\tfor _, r := range rs {\n\t\t\tif strings.HasPrefix(r.Body, markerFor(j.ID)) {\n\t\t\t\trec.CommentID, rec.ReviewMode = r.ID, ReviewFound\n\t\t\t\treturn nil\n\t\t\t}\n\t\t}\n\t\tcs, err := c.d.Comments.ListComments(ctx, n, time.Time{})\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"list comments on #%d: %w\", n, err)\n\t\t}\n\t\tfor _, cm := range cs {\n\t\t\tif strings.HasPrefix(cm.Body, markerFor(j.ID)) {\n\t\t\t\trec.CommentID, rec.ReviewMode = cm.ID, ReviewFound\n\t\t\t\treturn nil\n\t\t\t}\n\t\t}\n\t}\n\tdry := c.d.Effects.DryRun()\n\trejected := func(err error) bool {\n\t\tvar he *github.HTTPError\n\t\treturn errors.As(err, &he) && he.Status == 422\n\t}\n\tinline := inlineComments(rp)\n\tif len(inline) > 0 {\n\t\trid, err := c.d.Effects.CreateReview(ctx, n, github.ReviewInput{CommitSHA: rp.CommitSHA,\n\t\t\tBody: RenderReview(*rec, c.d.Repo, dry, false), Comments: inline})\n\t\tif err == nil {\n\t\t\trec.CommentID, rec.ReviewMode = rid, ReviewInline\n\t\t\treturn nil\n\t\t}\n\t\tif !rejected(err) {\n\t\t\treturn c.postFailed(rec, fmt.Errorf(\"review on #%d: %w\", n, err))\n\t\t}\n\t\tc.d.log().Warn(\"closeout.review_inline_rejected\", \"job\", j.ID, \"pr\", n, \"error\", err)\n\t}\n\tbody := RenderReview(*rec, c.d.Repo, dry, len(inline) > 0)\n\trid, err := c.d.Effects.CreateReview(ctx, n, github.ReviewInput{CommitSHA: rp.CommitSHA, Body: body})\n\tif err == nil {\n\t\trec.CommentID, rec.ReviewMode = rid, ReviewBody\n\t\treturn nil\n\t}\n\tif !rejected(err) {\n\t\treturn c.postFailed(rec, fmt.Errorf(\"review on #%d: %w\", n, err))\n\t}\n\tc.d.log().Warn(\"closeout.review_rejected\", \"job\", j.ID, \"pr\", n, \"error\", err)\n\tcm, err := c.d.Effects.CreateComment(ctx, n, body)\n\tif err != nil {\n\t\treturn c.postFailed(rec, fmt.Errorf(\"comment on #%d: %w\", n, err))\n\t}\n\trec.CommentID, rec.ReviewMode = cm.ID, ReviewComment\n\treturn nil\n}\n\n// postFailed passes a review-post error on, except for a stale review of a\n// gone PR: posting there is best-effort, so the error is logged and dropped.\nfunc (c *Closer) postFailed(rec *Record, err error) error {\n\tif rp := rec.Plan.Review; rp != nil && rp.PRGone != \"\" {\n\t\tc.d.log().Warn(\"closeout: review not posted on gone PR\", \"job\", rec.Job.ID, \"pr\", rec.Job.PR, \"error\", err)\n\t\treturn nil\n\t}\n\treturn err\n}\n\n// finish swaps the labels (\":running\" is removed last, so it marks the commit\n// point) and closes the job in state.\nfunc (c *Closer) finish(ctx context.Context, rec Record) error {\n\tp := rec.Plan\n\tif err := c.addGrouped(ctx, p.Terminal); err != nil {\n\t\treturn err\n\t}\n\tfor _, l := range p.Remove {\n\t\tif err := c.d.Effects.RemoveLabel(ctx, l.Number, l.Name); err != nil {\n\t\t\treturn fmt.Errorf(\"remove %s on #%d: %w\", l.Name, l.Number, err)\n\t\t}\n\t}\n\tvar cost *float64\n\tif rec.Job.CostUSD > 0 {\n\t\tv := rec.Job.CostUSD\n\t\tcost = &v\n\t}\n\tkeep := p.KeepUntil\n\tif keep.IsZero() {\n\t\tkeep = c.d.now().Add(failedKeep)\n\t}\n\tvar err error\n\tswitch p.Outcome {\n\tcase OutcomeFailed:\n\t\terr = c.d.Store.Fail(ctx, rec.Job.ID, clip(p.Reason, maxReasonRunes), keep)\n\tcase OutcomeRetry:\n\t\terr = c.d.Store.FailRetry(ctx, rec.Job.ID, clip(p.Reason, maxReasonRunes), keep)\n\tcase OutcomeLimited:\n\t\terr = c.d.Store.FailLimited(ctx, rec.Job.ID, clip(p.Reason, maxReasonRunes), keep)\n\tdefault:\n\t\terr = c.d.Store.Complete(ctx, rec.Job.ID, cost)\n\t}\n\tif err != nil {\n\t\treturn fmt.Errorf(\"close job in state: %w\", err)\n\t}\n\treturn nil\n}\n\n// dropRawLog deletes the unredacted host log once its redacted copy has been\n// committed. It is kept, and the keep is logged, when redaction failed or the\n// scan flagged it (so a human can inspect it) or when the commit did not\n// carry it.\nfunc (c *Closer) dropRawLog(rec Record) {\n\tj := rec.Job\n\tcommitted := map[string]bool{}\n\tfor _, p := range rec.Plan.ExtraLogPaths {\n\t\tcommitted[p] = true\n\t}\n\tdrop := func(path string, ok bool) {\n\t\tif !ok {\n\t\t\tc.d.log().Warn(\"closeout: raw log kept\", \"job\", j.ID, \"path\", path, \"withheld\", rec.Plan.LogWithheld)\n\t\t\treturn\n\t\t}\n\t\tif err := os.Remove(path); err != nil && !errors.Is(err, os.ErrNotExist) {\n\t\t\tc.d.log().Warn(\"closeout: remove raw log\", \"job\", j.ID, \"path\", path, \"error\", err)\n\t\t}\n\t}\n\tif j.LogPath != \"\" {\n\t\tdrop(j.LogPath, rec.Plan.LogPath != \"\")\n\t}\n\tfor _, extra := range j.ExtraLogs {\n\t\tcp, err := redact.CommitPath(rec.Job.Issue, extra)\n\t\tdrop(extra, err == nil && committed[cp])\n\t}\n}\n\n// TriageRoles returns the triage roles that ran to a closed, done close-out\n// for issue. Failed, open and needs-human jobs do not count.\nfunc TriageRoles(ctx context.Context, s interface {\n\tCloseoutsOf(ctx context.Context, issue int, stage string) ([]state.Job, error)\n}, issue int) (map[string]bool, error) {\n\tjobs, err := s.CloseoutsOf(ctx, issue, StageTriage)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"triage roles of issue %d: %w\", issue, err)\n\t}\n\tout := map[string]bool{}\n\tfor _, sj := range jobs {\n\t\trec, err := decode(sj)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tif rec.Phase == PhaseClosed && rec.Plan.Outcome == OutcomeDone {\n\t\t\tout[sj.Role] = true\n\t\t}\n\t}\n\treturn out, nil\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_014ajifHumZVr1adgqxEX5Xm","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
