{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L2GEChGxmKw6pjrdFbvQ6d","type":"tool_result","content":"package closeout\n\nimport (\n\t\"fmt\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/labels\"\n)\n\n// TestResult is how a worker's test run ended.\ntype TestResult string\n\n// Test results.\nconst (\n\tTestsPassed TestResult = \"passed\"\n\tTestsFailed TestResult = \"failed\"\n\tTestsNone   TestResult = \"none\" // the role has no tests configured\n)\n\n// WorkerResult is what the worker loop knows that the role file cannot say:\n// the pull request, the reviewers to request on it and how the tests went. The\n// loop passes it through reaper.Finisher.FinishWith; it is persisted in the\n// close-out record.\ntype WorkerResult struct {\n\tPR    int\n\tPRURL string\n\t// Reviewers are the reviewer roles to request on the PR, de-duplicated and\n\t// already limited to roles that exist. Close-out adds the role file's own\n\t// review requests after them.\n\tReviewers []string\n\tTests     TestResult\n\tFixes     int    // fix attempts that ran\n\tTestNote  string // fixed, non-secret text, such as \"ran out of time\"\n\t// Hold, when set, turns the result into needs-human with this reason (a\n\t// diff guard rejection, for example). It never quotes file content.\n\tHold string\n\t// Large, when set, is the diff guard's fixed note on a PR over the role's\n\t// diff_warn_lines (\"Large change: N changed lines (warn at W)\"). The PR\n\t// still proceeds; the note goes into the PR body and the issue comment.\n\tLarge string\n\t// Fetched are the inputs the worker recorded under fetched: in its role\n\t// file. They come only from the parsed frontmatter, never from free text.\n\tFetched []Fetched\n}\n\n// buildWorker maps a done worker role file and the loop's result to a plan.\nfunc buildWorker(j Job, rf RoleFile, rs RoleSet) Plan {\n\tw := j.Worker\n\tswitch {\n\tcase w == nil:\n\t\treturn needsHumanPlan(j, rf.Status, \"worker ended without the loop's result\")\n\tcase w.Hold != \"\":\n\t\treturn needsHumanPlan(j, rf.Status, w.Hold)\n\tcase j.PR <= 0:\n\t\treturn needsHumanPlan(j, rf.Status, \"worker finished without a pull request\")\n\t}\n\tn, pr := j.Issue, j.PR\n\trun := Label{n, labels.Running(labels.StageWorker, j.Role)}\n\tp := Plan{Status: rf.Status, Outcome: OutcomeDone}\n\tp.Terminal = []Label{{n, labels.Done(labels.StageWorker, j.Role)}}\n\tnow, deferred, skipped := resolveNext(j, rf.Next, rs)\n\tp.Deferred, p.Skipped = deferred, skipped\n\tif w.Tests == TestsFailed {\n\t\tp.Terminal = append(p.Terminal, Label{n, labels.TestsFailed}, Label{pr, labels.TestsFailed})\n\t\tfor _, r := range now {\n\t\t\tp.Skipped = append(p.Skipped, Skip{r.String(), \"tests failed\"})\n\t\t}\n\t} else {\n\t\tp.Remove = append(p.Remove, Label{n, labels.TestsFailed}, Label{pr, labels.TestsFailed})\n\t\tseen := map[string]bool{}\n\t\tadd := func(role string) {\n\t\t\tif seen[role] {\n\t\t\t\treturn\n\t\t\t}\n\t\t\tseen[role] = true\n\t\t\tp.Requests = append(p.Requests, Label{pr, labels.Request(labels.StageReview, role)})\n\t\t}\n\t\tfor _, r := range w.Reviewers {\n\t\t\tif hasRole(rs, StageReview, r) {\n\t\t\t\tadd(r)\n\t\t\t} else {\n\t\t\t\tp.Skipped = append(p.Skipped, Skip{\"review:\" + clip(r, 60), \"no such role\"})\n\t\t\t}\n\t\t}\n\t\tfor _, r := range now {\n\t\t\tadd(r.Role)\n\t\t}\n\t}\n\tp.Remove = append(p.Remove, run)\n\tif rf.Worker != \"\" {\n\t\tp.Skipped = append(p.Skipped, Skip{\"worker:\" + clip(rf.Worker, 60), \"wrong stage\"})\n\t}\n\treturn p\n}\n\n// workerLines are the PR and Tests lines of a worker's close-out comment.\nfunc workerLines(j Job) []string {\n\tw := j.Worker\n\tif w == nil || w.Hold != \"\" {\n\t\treturn nil\n\t}\n\tvar out []string\n\tif j.PR > 0 {\n\t\tif strings.HasPrefix(w.PRURL, \"https://github.com/\") && !strings.ContainsAny(w.PRURL, \" ()[]<>\\n\") {\n\t\t\tout = append(out, fmt.Sprintf(\"PR: [#%d](%s)\", j.PR, w.PRURL))\n\t\t} else {\n\t\t\tout = append(out, fmt.Sprintf(\"PR: #%d\", j.PR))\n\t\t}\n\t}\n\tfixes := \"\"\n\tswitch w.Fixes {\n\tcase 0:\n\tcase 1:\n\t\tfixes = \" after 1 fix attempt\"\n\tdefault:\n\t\tfixes = fmt.Sprintf(\" after %d fix attempts\", w.Fixes)\n\t}\n\tswitch w.Tests {\n\tcase TestsPassed:\n\t\tout = append(out, \"Tests: passed\"+fixes)\n\tcase TestsFailed:\n\t\tline := \"Tests: failed\" + fixes\n\t\tif w.TestNote != \"\" {\n\t\t\tline += \" · \" + sanitize(w.TestNote)\n\t\t}\n\t\tout = append(out, line)\n\tcase TestsNone:\n\t\tout = append(out, \"Tests: not configured\")\n\t}\n\tif w.Large != \"\" {\n\t\tout = append(out, sanitize(w.Large))\n\t}\n\treturn out\n}\npackage closeout\n\nimport (\n\t\"fmt\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/labels\"\n)\n\n// Outcome is what close-out decided about a job.\ntype Outcome string\n\nconst (\n\tOutcomeDone       Outcome = \"done\"\n\tOutcomeChanges    Outcome = \"changes\"\n\tOutcomeNeedsHuman Outcome = \"needs-human\"\n\tOutcomeFailed     Outcome = \"failed\"\n\t// OutcomeNeedsNetwork is a worker that asked for network inputs it could\n\t// not fetch. Nothing is pushed and no PR is opened. For now it ends like\n\t// needs-human, with the list in the comment.\n\tOutcomeNeedsNetwork Outcome = \"needs-network\"\n\t// OutcomeStale is a review whose verdict was approve but whose PR gained\n\t// code after the reviewed commit. The review is posted, no pass label is\n\t// set and the request label stays, so the review runs again. It is also a\n\t// review whose PR was merged or closed, or whose branch was deleted, before\n\t// close-out: nothing is committed, no failure is recorded, and the request\n\t// label comes off with :running (ReviewPlan.PRGone says why).\n\tOutcomeStale Outcome = \"stale\"\n\t// OutcomeRetry is a failure with a named transient cause. The job hands\n\t// off to one automatic retry: it gets no ard:executor:failed and keeps its\n\t// request label, so the next claim runs it again as a new job.\n\tOutcomeRetry Outcome = \"retry\"\n\t// OutcomeLimited is a stop at a subscription usage limit. Its labels are\n\t// those of OutcomeRetry: no ard:executor:failed, the request label stays,\n\t// and the issue is claimed again once the pool's pause for the limit ends.\n\t// It neither uses up nor grants the automatic retry.\n\tOutcomeLimited Outcome = \"usage-limit\"\n)\n\n// Label is a label name with the issue or PR number it goes on.\ntype Label struct {\n\tNumber int\n\tName   string\n}\n\n// FileRef is one file of the commit set. Staged is the host path of the\n// cleaned bytes; Resume reads only that, never the worktree.\ntype FileRef struct {\n\tPath   string // repo-relative, slash form: .ard/<n>/<stage>-<role>.md\n\tStaged string\n\tDelete bool\n}\n\n// Plan is everything close-out will do, decided before any side effect.\ntype Plan struct {\n\tOutcome     Outcome\n\tStatus      string // raw status of the role file, for the comment header\n\tReason      string // failure or withhold reason; never secret text\n\tRequests    []Label\n\tTerminal    []Label // added in order\n\tRemove      []Label // removed in order; Running is last\n\tDeferred    []NextReq\n\tWorker      string // the lead's validated worker choice, for the Phase 1 gate\n\tSkipped     []Skip\n\tFiles       []FileRef\n\tLogWithheld bool\n\tLogPath     string // committed log path when it is in Files\n\t// ExtraLogPaths are the committed paths of Job.ExtraLogs, in order.\n\tExtraLogPaths []string\n\tSummary       string // redacted role file summary, for the comment\n\t// Network is the redacted list of a needs-network worker.\n\tNetwork []NetworkNeed\n\t// Review is set for a review that reached a verdict: close-out posts one\n\t// PR review instead of a plain comment.\n\tReview   *ReviewPlan\n\tRolePath string // committed role file path, \"\" when none\n\n\t// Tail is the last lines of the redacted log, for a failed or retry\n\t// comment. It is \"\" when there is no log, when the log was withheld, or\n\t//