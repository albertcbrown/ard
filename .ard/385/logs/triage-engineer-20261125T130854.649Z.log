atusNotFound, http.StatusGone:\ninternal/github/errors.go:105:\t\treturn fmt.Errorf(\"%w: %s\", ErrNotFound, msg)\ninternal/github/http.go:203:\t\tcase http.StatusNotFound, http.StatusGone:\ninternal/github/http.go:204:\t\t\treturn fmt.Errorf(\"github: %s: %w: %s\", op, ErrNotFound, msg)\ninternal/github/http.go:245:\t\tif errors.Is(pe, ErrNotFound) {\ninternal/github/http.go:257:\t\t\treturn fmt.Errorf(\"%w: issue moved to another repository (%s)\", ErrNotFound, redirectPath(rerr.Location))\ninternal/github/http.go:330:func is404(err error) bool {\ninternal/github/http.go:332:\treturn ok && s == http.StatusNotFound","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01L5Df7HMHBvKtDUmYie3vpA","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
