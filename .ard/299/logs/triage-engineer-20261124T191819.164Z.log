end(out, role)\n\t\t}\n\t}\n\treturn out\n}\n\n// SidecarFor returns the sidecar the role mounts; ok is false when it has none.\n// Loops set executor.Sidecar.Name from role.Sidecar so errors name the key.\nfunc (r *Resolved) SidecarFor(role Role) (sc Sidecar, ok bool) {\n\tif role.Sidecar == \"\" {\n\t\treturn Sidecar{}, false\n\t}\n\tsc, ok = r.Sidecars[role.Sidecar]\n\treturn sc, ok\n}\n\n// RolesOf returns every role of the given kind, in canonical order.\nfunc (r *Resolved) RolesOf(k Kind) []Role {\n\tvar out []Role\n\tfor _, role := range r.Roles {\n\t\tif role.Kind == k {\n\t\t\tout = append(out, role)\n\t\t}\n\t}\n\treturn out\n}\n\n// sortRoles orders roles by kind (kindOrder) then name.\nfunc sortRoles(roles []Role) {\n\tsort.Slice(roles, func(i, j int) bool {\n\t\tif roles[i].Kind != roles[j].Kind {\n\t\t\treturn kindRank(roles[i].Kind) < kindRank(roles[j].Kind)\n\t\t}\n\t\treturn roles[i].Name < roles[j].Name\n\t})\n}\n\nfunc kindRank(k Kind) int {\n16:// Kind is the type of a role directory.\n17:type Kind string\n20:\tKindScanner  Kind = \"scanner\"\n21:\tKindTriage   Kind = \"triage\"\n22:\tKindWorker   Kind = \"worker\"\n23:\tKindReviewer Kind = \"reviewer\"\n27:var kindDir = map[Kind]string{\n28:\tKindScanner:  \"scanners\",\n29:\tKindTriage:   \"triage\",\n30:\tKindWorker:   \"workers\",\n31:\tKindReviewer: \"reviewers\",\n36:var kindOrder = []Kind{KindScanner, KindTriage, KindWorker, KindReviewer}\n120:\tKind Kind\n173:func (r Role) ReadsUntrusted() bool { return r.Kind != KindScanner || r.LLMScanner() }\n180:\tif r.Kind != KindScanner || r.ScanPath == \"\" {\n193:func (r Role) LLMScanner() bool { return r.Kind == KindScanner && r.ScanPath == \"\" }\n224:\tRoles          []Role   // sorted by Kind then Name\n228:func (r *Resolved) Role(k Kind, name string) (Role, bool) {\n230:\t\tif role.Kind == k && role.Name == name {\n280:func (r *Resolved) RolesOf(k Kind) []Role {\npackage claude\n\nimport (\n\t\"strings\"\n\t\"testing\"\n)\n\nfunc TestUserMess