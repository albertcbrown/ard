o marker for a command that did not start\")\n+\t}\n+}\n+\n+func TestExecNoArgv(t *testing.T) {\n+\tsetup(t, \"\")\n+\terr := Run(context.Background(), &cli.Env{}, cli.JobExecOpts{})\n+\tvar ee *cli.ExitError\n+\tif !errors.As(err, &ee) || ee.Code != 2 {\n+\t\tt.Fatalf(\"err = %v\", err)\n+\t}\n+}\ndiff --git a/internal/jobexec/proc_other.go b/internal/jobexec/proc_other.go\nnew file mode 100644\nindex 0000000..2c8cee8\n--- /dev/null\n+++ b/internal/jobexec/proc_other.go\n@@ -0,0 +1,25 @@\n+//go:build !unix\n+\n+package jobexec\n+\n+import (\n+\t\"os\"\n+\t\"os/exec\"\n+)\n+\n+const noFollow = 0\n+\n+var sigChld []os.Signal\n+\n+func setGroup(*exec.Cmd)                {}\n+func termGroup(pid int)                 { killPid(pid) }\n+func killGroup(pid int)                 { killPid(pid) }\n+func signalNumber(*os.ProcessState) int { return 0 }\n+func reapOrphans(int)                   {}\n+func reapAll()                          {}\n+\n+func killPid(pid int) {\n+\tif p, err := os.FindProcess(pid); err == nil {\n+\t\t_ = p.Kill()\n+\t}\n+}\ndiff --git a/internal/jobexec/proc_unix.go b/internal/jobexec/proc_unix.go\nnew file mode 100644\nindex 0000000..06647cc\n--- /dev/null\n+++ b/internal/jobexec/proc_unix.go\n@@ -0,0 +1,25 @@\n+//go:build unix\n+\n+package jobexec\n+\n+import (\n+\t\"os\"\n+\t\"os/exec\"\n+\t\"syscall\"\n+)\n+\n+const noFollow = syscall.O_NOFOLLOW\n+\n+var sigChld = []os.Signal{syscall.SIGCHLD}\n+\n+func setGroup(cmd *exec.Cmd) { cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true} }\n+\n+func termGroup(pid int) { _ = syscall.Kill(-pid, syscall.SIGTERM) }\n+func killGroup(pid int) { _ = syscall.Kill(-pid, syscall.SIGKILL) }\n+\n+func signalNumber(ps *os.ProcessState) int {\n+\tif ws, ok := ps.Sys().(syscall.WaitStatus); ok && ws.Signaled() {\n+\t\treturn int(ws.Signal())\n+\t}\n+\treturn 0\n+}\ndiff --git a/internal/jobexec/reap_linux.go b/internal/jobexec/reap_linux.go\nnew file mode 100644\nindex 0000000..709970b\n--- /dev/null\n+++ b/internal/jobexec/reap_linux.go\n@@ -0,0 +1,61 @@\n+package jobexec\n+\n+import (\n+\t\"encoding/binary\"\n+\t\"os\"\n+\t\"syscall\"\n+\t\"unsafe\"\n+)\n+\n+const (\n+\tpAll    = 0 // P_ALL\n+\twNoWait = 0x01000000\n+)\n+\n+// peekChild returns the pid of an exited child without reaping it, or 0.\n+func peekChild() int {\n+\tvar info [128]byte // siginfo_t\n+\t_, _, errno := syscall.Syscall6(syscall.SYS_WAITID, pAll, 0, uintptr(unsafe.Pointer(&info[0])),\n+\t\tsyscall.WEXITED|syscall.WNOHANG|wNoWait, 0, 0)\n+\tif errno != 0 || binary.NativeEndian.Uint32(info[0:4]) == 0 { // si_signo\n+\t\treturn 0\n+\t}\n+\toff := 16 // si_pid follows three ints and, on 64-bit, 4 bytes of padding\n+\tif unsafe.Sizeof(uintptr(0)) == 4 {\n+\t\toff = 12\n+\t}\n+\treturn int(int32(binary.NativeEndian.Uint32(info[off : off+4])))\n+}\n+\n+// reapOrphans collects zombie children that are not the agent, which os/exec\n+// is still going to wait for. When job-exec is PID 1 of the container, the\n+// agent's orphaned grandchildren are re-parented to it. It peeks with\n+// WNOWAIT so the agent's own status is never taken.\n+func reapOrphans(agent int) {\n+\tif os.Getpid() != 1 {\n+\t\treturn // only PID 1 inherits orphans; elsewhere wait4(-1) could take a stranger's child\n+\t}\n+\tfor {\n+\t\tpid := peekChild()\n+\t\tif pid <= 0 || pid == agent {\n+\t\t\treturn\n+\t\t}\n+\t\tvar ws syscall.WaitStatus\n+\t\tif _, err := syscall.Wait4(pid, &ws, syscall.WNOHANG, nil); err != nil {\n+\t\t\treturn\n+\t\t}\n+\t}\n+}\n+\n+// reapAll collects every exited child; the agent has been waited for.\n+func reapAll() {\n+\tif os.Getpid() != 1 {\n+\t\treturn\n+\t}\n+\tfor {\n+\t\tvar ws syscall.WaitStatus\n+\t\tif pid, err := syscall.Wait4(-1, &ws, syscall.WNOHANG, nil); err != nil || pid <= 0 {\n+\t\t\treturn\n+\t\t}\n+\t}\n+}\ndiff --git a/internal/jobexec/reap_other_unix.go b/internal/jobexec/reap_other_unix.go\nnew file mode 100644\nindex 0000000..8493694\n--- /dev/null\n+++ b/internal/jobexec/reap_other_unix.go\n@@ -0,0 +1,6 @@\n+//go:build unix && !linux\n+\n+package jobexec\n+\n+func reapOrphans(int) {}\n+func reapAll()        {}\ndiff --git a/internal/jobexec/sig_test.go b/internal/jobexec/sig_test.go\nnew file mode 100644\nindex 0000000..641fbcc\n--- /dev/null\n+++ b/internal/jobexec/sig_test.go\n@@ -0,0 +1,10 @@\n+//go:build unix\n+\n+package jobexec\n+\n+import (\n+\t\"os\"\n+\t\"os/signal\"\n+)\n+\n+func signalIgnore(s os.Signal) { signal.Ignore(s) }\ndiff --git a/internal/jobpost/post.go b/internal/jobpost/post.go\nnew file mode 100644\nindex 0000000..0ec2b51\n--- /dev/null\n+++ b/internal/jobpost/post.go\n@@ -0,0 +1,129 @@\n+// Package jobpost is `ard job-post`, the result server of a Kubernetes job\n+// pod. It serves one route, GET /v1/result, guarded by the per-job key, and\n+// streams the packed work tree and agent stdout once the agent step has\n+// written its done marker. It serves plain HTTP; the controller reaches it\n+// through the pod network.\n+package jobpost\n+\n+import (\n+\t\"context\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"io\"\n+\t\"log/slog\"\n+\t\"net\"\n+\t\"net/http\"\n+\t\"os\"\n+\t\"os/signal\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"syscall\"\n+\t\"time\"\n+\n+\t\"github.com/albertcbrown/ard/internal/cli\"\n+\t\"github.com/albertcbrown/ard/internal/jobpod\"\n+\t\"github.com/albertcbrown/ard/internal/tarball\"\n+)\n+\n+// Redirectable for tests.\n+var (\n+\tkeyDir  = jobpod.PostSecretDir\n+\tworkDir = jobpod.MountWork\n+\toutDir  = jobpod.MountOut\n+\tlisten  = func() (net.Listener, error) { return net.Listen(\"tcp\", fmt.Sprintf(\":%d\", jobpod.ResultPort)) }\n+)\n+\n+const maxKeyBytes = 1024\n+\n+// Run serves until SIGTERM, ctx cancellation or the deadline, then exits 0.\n+func Run(ctx context.Context, e *cli.Env, o cli.JobPostOpts) error {\n+\tkey, err := readKey()\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tln, err := listen()\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tctx, stop := signal.NotifyContext(ctx, syscall.SIGTERM, os.Interrupt)\n+\tdefer stop()\n+\tif !o.Deadline.IsZero() {\n+\t\tvar cancel context.CancelFunc\n+\t\tctx, cancel = context.WithDeadline(ctx, o.Deadline)\n+\t\tdefer cancel()\n+\t}\n+\treturn serve(ctx, ln, key)\n+}\n+\n+func readKey() (string, error) {\n+\tf, err := os.Open(filepath.Join(keyDir, jobpod.ItemResultKey))\n+\tif err != nil {\n+\t\treturn \"\", fmt.Errorf(\"result key: %w\", err)\n+\t}\n+\tdefer f.Close()\n+\tb, err := io.ReadAll(io.LimitReader(f, maxKeyBytes+1))\n+\tif err != nil {\n+\t\treturn \"\", fmt.Errorf(\"result key: %w\", err)\n+\t}\n+\tk := strings.TrimSpace(string(b))\n+\tif k == \"\" || len(b) > maxKeyBytes {\n+\t\treturn \"\", errors.New(\"result key: empty or oversize\")\n+\t}\n+\treturn k, nil\n+}\n+\n+func serve(ctx context.Context, ln net.Listener, key string) error {\n+\th := &handler{key: key, slot: make(chan struct{}, 1)}\n+\tmux := http.NewServeMux()\n+\tmux.HandleFunc(\"GET \"+jobpod.ResultPath, h.result)\n+\tsrv := &http.Server{\n+\t\tHandler:           mux,\n+\t\tReadHeaderTimeout: 10 * time.Second,\n+\t\tIdleTimeout:       60 * time.Second,\n+\t\tMaxHeaderBytes:    8 << 10,\n+\t\tErrorLog:          slog.NewLogLogger(slog.DiscardHandler, slog.LevelError),\n+\t}\n+\terrc := make(chan error, 1)\n+\tgo func() { errc <- srv.Serve(ln) }()\n+\tselect {\n+\tcase err := <-errc:\n+\t\treturn err\n+\tcase <-ctx.Done():\n+\t}\n+\tsctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)\n+\tdefer cancel()\n+\tif err := srv.Shutdown(sctx); err != nil {\n+\t\tsrv.Close()\n+\t}\n+\treturn nil\n+}\n+\n+type handler struct {\n+\tkey  string\n+\tslot chan struct{}\n+}\n+\n+func (h *handler) result(w http.ResponseWriter, r *http.Request) {\n+\tconst prefix = \"Bearer \"\n+\tgot := r.Header.Get(\"Authorization\")\n+\tif !strings.HasPrefix(got, prefix) || !jobpod.KeyMatches(got[len(prefix):], h.key) {\n+\t\thttp.Error(w, \"unauthorized\", http.StatusUnauthorized)\n+\t\treturn\n+\t}\n+\tselect {\n+\tcase h.slot <- struct{}{}:\n+\t\tdefer func() { <-h.slot }()\n+\tdefault:\n+\t\thttp.Error(w, \"busy\", http.StatusTooManyRequests)\n+\t\treturn\n+\t}\n+\tif _, err := os.Stat(filepath.Join(outDir, jobpod.DoneName)); err != nil {\n+\t\thttp.Error(w, \"not ready\", http.StatusConflict)\n+\t\treturn\n+\t}\n+\tw.Header().Set(\"Content-Type\", \"application/gzip\")\n+\t_, _ = tarball.Pack(w, []tarball.Root{\n+\t\t{Name: jobpod.RootWork, Dir: workDir},\n+\t\t{Name: jobpod.RootOut, Dir: outDir, Files: []string{jobpod.StdoutName}},\n+\t})\n+}\ndiff --git a/internal/jobpost/post_test.go b/internal/jobpost/post_test.go\nnew file mode 100644\nindex 0000000..41b06b7\n--- /dev/null\n+++ b/internal/jobpost/post_test.go\n@@ -0,0 +1,202 @@\n+package jobpost\n+\n+import (\n+\t\"archive/tar\"\n+\t\"bytes\"\n+\t\"compress/gzip\"\n+\t\"context\"\n+\t\"io\"\n+\t\"net\"\n+\t\"net/http\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"sort\"\n+\t\"strings\"\n+\t\"testing\"\n+\t\"time\"\n+\n+\t\"github.com/albertcbrown/ard/internal/cli\"\n+\t\"github.com/albertcbrown/ard/internal/jobpod\"\n+)\n+\n+const testKey = \"k3y-value-for-tests\"\n+\n+type rig struct {\n+\turl       string\n+\twork, out string\n+\tcancel    context.CancelFunc\n+\terrc      chan error\n+}\n+\n+func start(t *testing.T) *rig {\n+\tt.Helper()\n+\troot := t.TempDir()\n+\tr := &rig{work: filepath.Join(root, \"work\"), out: filepath.Join(root, \"out\"), errc: make(chan error, 1)}\n+\tos.MkdirAll(r.work, 0o755)\n+\tos.MkdirAll(r.out, 0o755)\n+\tworkDir, outDir = r.work, r.out\n+\tt.Cleanup(func() { workDir, outDir = jobpod.MountWork, jobpod.MountOut })\n+\tln, err := net.Listen(\"tcp\", \"127.0.0.1:0\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tr.url = \"http://\" + ln.Addr().String()\n+\tctx, cancel := context.WithCancel(context.Background())\n+\tr.cancel = cancel\n+\tt.Cleanup(cancel)\n+\tgo func() { r.errc <- serve(ctx, ln, testKey) }()\n+\treturn r\n+}\n+\n+func (r *rig) get(t *testing.T, path, auth string) (*http.Response, []byte) {\n+\tt.Helper()\n+\treq, _ := http.NewRequest(\"GET\", r.url+path, nil)\n+\tif auth != \"\" {\n+\t\treq.Header.Set(\"Authorization\", auth)\n+\t}\n+\tresp, err := http.DefaultClient.Do(req)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tdefer resp.Body.Close()\n+\tb, _ := io.ReadAll(resp.Body)\n+\treturn resp, b\n+}\n+\n+func (r *rig) finish(t *testing.T) {\n+\tt.Helper()\n+\tos.WriteFile(filepath.Join(r.work, \"a.txt\"), []byte(\"A\"), 0o644)\n+\tos.WriteFile(filepath.Join(r.out, jobpod.StdoutName), []byte(\"log\"), 0o644)\n+\tos.WriteFile(filepath.Join(r.out, \"other\"), []byte(\"no\"), 0o644)\n+\tos.WriteFile(filepath.Join(r.out, jobpod.DoneName), []byte(\"0\\n\"), 0o644)\n+}\n+\n+func names(t *testing.T, b []byte) []string {\n+\tt.Helper()\n+\tgz, err := gzip.NewReader(bytes.NewReader(b))\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\ttr := tar.NewReader(gz)\n+\tvar out []string\n+\tfor {\n+\t\th, err := tr.Next()\n+\t\tif err != nil {\n+\t\t\tbreak\n+\t\t}\n+\t\tif h.Typeflag == tar.TypeReg {\n+\t\t\tout = append(out, h.Name)\n+\t\t}\n+\t}\n+\tsort.Strings(out)\n+\treturn out\n+}\n+\n+func TestPost(t *testing.T) {\n+\tauth := \"Bearer \" + testKey\n+\tt.Run(\"auth\", func(t *testing.T) {\n+\t\tr := start(t)\n+\t\tr.finish(t)\n+\t\tos.Chmod(r.work, 0o000) // a read before auth would fail loudly\n+\t\tdefer os.Chmod(r.work, 0o755)\n+\t\tfor _, a := range []string{\"\", \"Bearer wrong\", testKey, \"Bearer \"} {\n+\t\t\tif resp, body := r.get(t, jobpod.ResultPath, a); resp.StatusCode != 401 || strings.Contains(string(body), testKey) {\n+\t\t\t\tt.Errorf(\"auth %q: %d %q\", a, resp.StatusCode, body)\n+\t\t\t}\n+\t\t}\n+\t})\n+\tt.Run(\"not ready then ready\", func(t *testing.T) {\n+\t\tr := start(t)\n+\t\tos.Chmod(r.work, 0o000)\n+\t\tif resp, _ := r.get(t, jobpod.ResultPath, auth); resp.StatusCode != 409 {\n+\t\t\tt.Errorf(\"before marker: %d\", resp.StatusCode)\n+\t\t}\n+\t\tos.Chmod(r.work, 0o755)\n+\t\tr.finish(t)\n+\t\tresp, b1 := r.get(t, jobpod.ResultPath, auth)\n+\t\tif resp.StatusCode != 200 {\n+\t\t\tt.Fatalf(\"after marker: %d\", resp.StatusCode)\n+\t\t}\n+\t\tgot := names(t, b1)\n+\t\tif strings.Join(got, \",\") != \"out/stdout,work/a.txt\" {\n+\t\t\tt.Errorf(\"entries = %v\", got)\n+\t\t}\n+\t\tif _, b2 := r.get(t, jobpod.ResultPath, auth); !bytes.Equal(b1, b2) {\n+\t\t\tt.Error(\"repeat GET differs\")\n+\t\t}\n+\t})\n+\tt.Run(\"routes\", func(t *testing.T) {\n+\t\tr := start(t)\n+\t\tfor _, p := range []string{\"/debug/pprof/\", \"/\", \"/v1/other\"} {\n+\t\t\tif resp, _ := r.get(t, p, auth); resp.StatusCode != 404 {\n+\t\t\t\tt.Errorf(\"%s: %d\", p, resp.StatusCode)\n+\t\t\t}\n+\t\t}\n+\t\treq, _ := http.NewRequest(\"POST\", r.url+jobpod.ResultPath, nil)\n+\t\treq.Header.Set(\"Authorization\", auth)\n+\t\tif resp, err := http.DefaultClient.Do(req); err != nil || resp.StatusCode != 405 {\n+\t\t\tt.Errorf(\"POST: %v %v\", resp, err)\n+\t\t}\n+\t})\n+\tt.Run(\"concurrent request gets 429\", func(t *testing.T) {\n+\t\tr := start(t)\n+\t\tr.finish(t)\n+\t\t// A big file and a client that does not read keep the first request busy.\n+\t\tos.WriteFile(filepath.Join(r.work, \"big\"), bytes.Repeat([]byte{1}, 64<<20), 0o644)\n+\t\treq, _ := http.NewRequest(\"GET\", r.url+jobpod.ResultPath, nil)\n+\t\treq.Header.Set(\"Authorization\", auth)\n+\t\tfirst, err := http.DefaultClient.Do(req)\n+\t\tif err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tdefer first.Body.Close()\n+\t\tresp, _ := r.get(t, jobpod.ResultPath, auth)\n+\t\tif resp.StatusCode != 429 {\n+\t\t\tt.Errorf(\"second request: %d\", resp.StatusCode)\n+\t\t}\n+\t})\n+\tt.Run(\"shutdown on cancel\", func(t *testing.T) {\n+\t\tr := start(t)\n+\t\tr.cancel()\n+\t\tselect {\n+\t\tcase err := <-r.errc:\n+\t\t\tif err != nil {\n+\t\t\t\tt.Errorf(\"serve = %v\", err)\n+\t\t\t}\n+\t\tcase <-time.After(15 * time.Second):\n+\t\t\tt.Error(\"no shutdown\")\n+\t\t}\n+\t})\n+}\n+\n+func TestRunKeyAndPort(t *testing.T) {\n+\tdir := t.TempDir()\n+\tkeyDir = dir\n+\tt.Cleanup(func() { keyDir = jobpod.PostSecretDir })\n+\tctx := context.Background()\n+\t// Missing and empty key.\n+\tif err := Run(ctx, &cli.Env{}, cli.JobPostOpts{}); err == nil {\n+\t\tt.Error(\"missing key accepted\")\n+\t}\n+\tos.WriteFile(filepath.Join(dir, jobpod.ItemResultKey), []byte(\"\\n\"), 0o444)\n+\tif err := Run(ctx, &cli.Env{}, cli.JobPostOpts{}); err == nil {\n+\t\tt.Error(\"empty key accepted\")\n+\t}\n+\tos.Remove(filepath.Join(dir, jobpod.ItemResultKey))\n+\tos.WriteFile(filepath.Join(dir, jobpod.ItemResultKey), []byte(testKey), 0o444)\n+\t// Port already bound.\n+\tbusy, _ := net.Listen(\"tcp\", \"127.0.0.1:0\")\n+\tdefer busy.Close()\n+\tlisten = func() (net.Listener, error) { return net.Listen(\"tcp\", busy.Addr().String()) }\n+\tdefer func() {\n+\t\tlisten = func() (net.Listener, error) { return net.Listen(\"tcp\", \":8080\") }\n+\t}()\n+\tif err := Run(ctx, &cli.Env{}, cli.JobPostOpts{}); err == nil {\n+\t\tt.Error(\"bound port accepted\")\n+\t}","numLines":1327,"startLine":1,"totalLines":1915,"truncatedByTokenCap":true}},"tool_result_meta":[{"id":"toolu_01ETftFJNs8oLTtbYnuEmBBU","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
