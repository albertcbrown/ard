ll.Root{\n\t\t{Name: jobpod.RootWork, Dir: workDir},\n\t\t{Name: jobpod.RootOut, Dir: outDir, Files: []string{jobpod.StdoutName}},\n\t})\n}\nEOF\ngrep -rn \"Authorization\\|Bearer\" internal/jobpod internal/executor 2>/dev/null | grep -v _test | head"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4471,"cache_read_input_tokens":72015,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4471},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b5ecbafa-7392-4828-b470-c1e3cfd37892","uuid":"fa4abdf4-550e-4634-8ab1-45d279292230","timestamp":"2026-11-25T11:34:04.256Z","request_id":"req_011ChPaHSmEhCjTymqC21L7G"}
