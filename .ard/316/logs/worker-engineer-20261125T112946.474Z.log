= \"token\"      // pre only\n\tItemResultKey = \"result-key\" // post only\n\tPreSecretDir  = \"/var/run/ard/pre\"\n\tPostSecretDir = \"/var/run/ard/post\"\n\tSecretMode    = 0o440\n)\n\n// ModelEnv lists the env names a model credential may have.\nvar ModelEnv = []string{\"ANTHROPIC_API_KEY\", \"CLAUDE_CODE_OAUTH_TOKEN\"}\n\n// Result route served by the post container.\nconst (\n\tResultPort     = 8080\n\tResultPortName = \"ard-result\"\n\tResultPath     = \"/v1/result\"\n\tRootWork       = \"work\"\n\tRootOut        = \"out\"\n\tStdoutName     = \"stdout\"\n\tDoneName       = \"done\" // marker in /out, never packed\n)\n\n// Pre exit codes: 3 means a retry cannot help, 1 is transient. A short reason\n// goes to /dev/termination-log.\nconst (\n\tExitPermanent = 3\n\tExitTransient = 1\n)\n\n// Labels.\nconst (\n\tlabelPrefix    = \"ard.albertcbrown/\"\n\tLabelPartOf    = \"app.kubernetes.io/part-of\"\n\tLabelComponent = \"app.kubernetes.io/component\"\n\tLabelInstance  = \"app.kubernetes.io/instance\"\n\tLabelRepo      = labelPrefix + \"repo\"\n\tLabelNetwork   = labelPrefix + \"network\"\n\tLabelJob       = labelPrefix + \"job\"\n\tLabelIssue     = labelPrefix + \"issue\"\n\tLabelStage     = labelPrefix + \"stage\"\n\tLabelRole      = labelPrefix + \"role\"\n\n\tComponentJob = \"ard-job\"\n)\n\n// Pod naming.\nconst (\n\tpodPrefix = \"ard-job-\"\n\t// MaxJobID is the longest job id whose pod name fits 63 characters.\n\tMaxJobID = 63 - len(podPrefix)\n)\n\n// PodName is the pod and Secret name of a job. ULIDs are case-insensitive;\n// names are lowercase.\nfunc PodName(id string) string { return podPrefix + strings.ToLower(id) }\n\n// RepoLabel is a label value for owner/name: 16 hex of the sha256 of the\n// lowercased repo.\nfunc RepoLabel(repo string) string {\n\tsum := sha256.Sum256([]byte(strings.ToLower(repo)))\n\treturn hex.EncodeToString(sum[:8])\n}\n\n// LabelValue returns s as a valid label value of at most 63 characters. A\n// value that does not fit is cut and given a short hash of the whole.\nfunc LabelValue(s string) string {\n\tclean := func(in string) string {\n\t\tb := []byte(in)\n\t\tfor i, c := range b {\n\t\t\tswitch {\n\t\t\tcase c >= 'a' && c <= 'z', c >= 'A' && c <= 'Z', c >= '0' && c <= '9', c == '-', c == '_', c == '.':\n\t\t\tdefault:\n\t\t\t\tb[i] = '_'\n\t\t\t}\n\t\t}\n\t\treturn strings.Trim(string(b), \"-_.\")\n\t}\n\tv := clean(s)\n\tif v == s && len(v) <= 63 {\n\t\treturn v\n\t}\n\tsum := sha256.Sum256([]byte(s))\n\th := hex.EncodeToString(sum[:4])\n\tif len(v) > 63-9 {\n\t\tv = v[:63-9]\n\t}\n\tv = strings.Trim(v, \"-_.\")\n\tif v == \"\" {\n\t\treturn h\n\t}\n\treturn v + \"-\" + h\n}\npackage jobpod\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"path\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/executor\"\n\t\"github.com/albertcbrown/ard/internal/gitref\"\n)\n\n// ManifestVersion is the only manifest version this package reads.\nconst ManifestVersion = 1\n\n// MaxManifestBytes caps the encoded manifest. The cap is on the JSON, because\n// base64 grows inputs by a third and a Secret is limited to 1 MiB.\nconst MaxManifestBytes = 768 << 10\n\n// ErrTooLarge means the encoded manifest is over MaxManifestBytes.\nvar ErrTooLarge = errors.New(\"jobpod: manifest exceeds the size cap\")\n\n// Source names a tree at a commit.\ntype Source struct {\n\tRepo string // owner/name\n\tSHA  string // 40-hex\n\tPath string // directory within the repo; unused for sidecars\n}\n\n// Manifest tells the pre container what to fetch and place.\ntype Manifest struct {\n\tV        int\n\tRepo     string // owner/name\n\tBaseSHA  string\n\tHistory  bool\n\tReadOnly bool\n\tRole     Source  // role dir at the config commit\n\tSidecar  *Source // pinned SHA\n\tScrub    []string\n\tInputs   []executor.File\n}\n\n// Encode validates and encodes m, refusing more than MaxManifestBytes.\nfunc Encode(m Manifest) ([]byte, error) {\n\tif err := m.validate(); err != nil {\n\t\treturn