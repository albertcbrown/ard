cmd_job.go\n@@ -0,0 +1,110 @@\n+package cli\n+\n+import (\n+\t\"context\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"time\"\n+\n+\t\"github.com/spf13/cobra\"\n+)\n+\n+// The job-* commands run inside a job pod of the Kubernetes executor. They\n+// are hidden: the pod builder writes their flags (#317).\n+\n+func parseDeadline(s string) (time.Time, error) {\n+\tt, err := time.Parse(time.RFC3339, s)\n+\tif err != nil {\n+\t\treturn time.Time{}, &ExitError{Code: 2, Err: fmt.Errorf(\"--deadline: want RFC 3339 UTC time: %w\", err)}\n+\t}\n+\treturn t, nil\n+}\n+\n+func addDeadline(cmd *cobra.Command, s *string) {\n+\tcmd.Flags().StringVar(s, \"deadline\", \"\", \"RFC 3339 UTC time by which the step must end\")\n+\t_ = cmd.MarkFlagRequired(\"deadline\")\n+}\n+\n+func newJobPre(app *App) *cobra.Command {\n+\tvar deadline string\n+\to := JobPreOpts{}\n+\tcmd := &cobra.Command{\n+\t\tUse:    \"job-pre\",\n+\t\tShort:  \"Pod init step: fetch and place the job inputs\",\n+\t\tHidden: true,\n+\t\tArgs:   cobra.NoArgs,\n+\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n+\t\t\td, err := parseDeadline(deadline)\n+\t\t\tif err != nil {\n+\t\t\t\treturn err\n+\t\t\t}\n+\t\t\to.Deadline = d\n+\t\t\treturn app.run(cmd, func(ctx context.Context, e *Env) error {\n+\t\t\t\tif app.Handlers.JobPre == nil {\n+\t\t\t\t\treturn notImpl(cmd.CommandPath(), \"#316\")\n+\t\t\t\t}\n+\t\t\t\treturn app.Handlers.JobPre(ctx, e, o)\n+\t\t\t})\n+\t\t},\n+\t}\n+\taddDeadline(cmd, &deadline)\n+\tcmd.Flags().StringVar(&o.GitBase, \"git-base\", \"https://github.com\", \"git host base URL\")\n+\treturn cmd\n+}\n+\n+func newJobExec(app *App) *cobra.Command {\n+\tvar deadline string\n+\to := JobExecOpts{}\n+\tcmd := &cobra.Command{\n+\t\tUse:    \"job-exec -- command [args...]\",\n+\t\tShort:  \"Pod agent step: run the agent command and write the done marker\",\n+\t\tHidden: true,\n+\t\tRunE: func(cmd *cobra.Command, args []string) error {\n+\t\t\td, err := parseDeadline(deadline)\n+\t\t\tif err != nil {\n+\t\t\t\treturn err\n+\t\t\t}\n+\t\t\to.Deadline = d\n+\t\t\tdash := cmd.ArgsLenAtDash()\n+\t\t\tif dash < 0 || dash != 0 || len(args) == 0 {\n+\t\t\t\treturn &ExitError{Code: 2, Err: errors.New(\"job-exec: want the agent command after --\")}\n+\t\t\t}\n+\t\t\to.Argv = args\n+\t\t\treturn app.run(cmd, func(ctx context.Context, e *Env) error {\n+\t\t\t\tif app.Handlers.JobExec == nil {\n+\t\t\t\t\treturn notImpl(cmd.CommandPath(), \"#316\")\n+\t\t\t\t}\n+\t\t\t\treturn app.Handlers.JobExec(ctx, e, o)\n+\t\t\t})\n+\t\t},\n+\t}\n+\taddDeadline(cmd, &deadline)\n+\tcmd.Flags().DurationVar(&o.Grace, \"grace\", 10*time.Second, \"time between SIGTERM and SIGKILL\")\n+\treturn cmd\n+}\n+\n+func newJobPost(app *App) *cobra.Command {\n+\tvar deadline string\n+\to := JobPostOpts{}\n+\tcmd := &cobra.Command{\n+\t\tUse:    \"job-post\",\n+\t\tShort:  \"Pod post step: serve the result to the controller\",\n+\t\tHidden: true,\n+\t\tArgs:   cobra.NoArgs,\n+\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n+\t\t\td, err := parseDeadline(deadline)\n+\t\t\tif err != nil {\n+\t\t\t\treturn err\n+\t\t\t}\n+\t\t\to.Deadline = d\n+\t\t\treturn app.run(cmd, func(ctx context.Context, e *Env) error {\n+\t\t\t\tif app.Handlers.JobPost == nil {\n+\t\t\t\t\treturn notImpl(cmd.CommandPath(), \"#316\")\n+\t\t\t\t}\n+\t\t\t\treturn app.Handlers.JobPost(ctx, e, o)\n+\t\t\t})\n+\t\t},\n+\t}\n+\taddDeadline(cmd, &deadline)\n+\treturn cmd\n+}\ndiff --git a/internal/cli/root.go b/internal/cli/root.go\nindex e2ead34..f12b743 100644\n--- a/internal/cli/root.go\n+++ b/internal/cli/root.go\n@@ -47,6 +47,9 @@ lands it once every review passes.`,\n \t\tnewRebuildState(app),\n \t\tnewInit(app),\n \t\tnewSetup(app),\n+\t\tnewJobPre(app),\n+\t\tnewJobExec(app),\n+\t\tnewJobPost(app),\n \t\tnewVersion(app),\n \t)\n \treturn root\ndiff --git a/internal/gitx/checkout_test.go b/internal/gitx/checkout_test.go\nnew file mode 100644\nindex 0000000..9cb212f\n--- /dev/null\n+++ b/internal/gitx/checkout_test.go\n@@ -0,0 +1,56 @@\n+package gitx\n+\n+import (\n+\t\"context\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"testing\"\n+\n+\t\"github.com/albertcbrown/ard/internal/gitx/gittest\"\n+)\n+\n+func TestCheckoutTree(t *testing.T) {\n+\tctx := context.Background()\n+\tg := New(\"\")\n+\t_, clone := gittest.NewRemote(t)\n+\tif err := os.WriteFile(filepath.Join(clone, \"run.sh\"), []byte(\"#!/bin/sh\\n\"), 0o755); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif err := os.Symlink(\"run.sh\", filepath.Join(clone, \"link\")); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\thook := filepath.Join(t.TempDir(), \"ran\")\n+\tgittest.Run(t, clone, \"add\", \"-A\")\n+\tgittest.Run(t, clone, \"commit\", \"-m\", \"files\")\n+\tsha := gittest.Run(t, clone, \"rev-parse\", \"HEAD\")\n+\tsha = sha[:40]\n+\n+\tgitDir := filepath.Join(t.TempDir(), \"repo.git\")\n+\tif err := g.InitBare(ctx, gitDir); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif err := g.FetchRef(ctx, gitDir, clone, \"+\"+sha+\":refs/ard/base\", nil); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\t// A post-checkout hook must not run.\n+\thd := filepath.Join(gitDir, \"hooks\")\n+\tos.MkdirAll(hd, 0o755)\n+\tos.WriteFile(filepath.Join(hd, \"post-checkout\"), []byte(\"#!/bin/sh\\ntouch \"+hook+\"\\n\"), 0o755)\n+\n+\twt := filepath.Join(t.TempDir(), \"wt\")\n+\tif err := g.CheckoutTree(ctx, gitDir, wt, sha); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif st, err := os.Stat(filepath.Join(wt, \"run.sh\")); err != nil || st.Mode().Perm()&0o100 == 0 {\n+\t\tt.Errorf(\"exec bit lost: %v %v\", st, err)\n+\t}\n+\tif dst, err := os.Readlink(filepath.Join(wt, \"link\")); err != nil || dst != \"run.sh\" {\n+\t\tt.Errorf(\"symlink = %q, %v\", dst, err)\n+\t}\n+\tif _, err := os.Lstat(filepath.Join(wt, \".git\")); err == nil {\n+\t\tt.Error(\"work tree has a .git\")\n+\t}\n+\tif _, err := os.Stat(hook); err == nil {\n+\t\tt.Error(\"hook ran\")\n+\t}\n+}\ndiff --git a/internal/gitx/local.go b/internal/gitx/local.go\nindex 594f5b8..b99353c 100644\n--- a/internal/gitx/local.go\n+++ b/internal/gitx/local.go\n@@ -545,3 +545,18 @@ func (g *Git) SetExec(ctx context.Context, dir string, paths ...string) error {\n \t}\n \treturn nil\n }\n+\n+// CheckoutTree writes the tree of sha into workTree with git checkout, keeping\n+// symlinks and exec bits. The index and HEAD live in gitDir, so workTree gets\n+// no .git. Unlike ExportTree it has no size cap and accepts symlinks. Hooks\n+// are off.\n+func (g *Git) CheckoutTree(ctx context.Context, gitDir, workTree, sha string) error {\n+\tif err := os.MkdirAll(workTree, 0o777); err != nil {\n+\t\treturn fmt.Errorf(\"gitx: checkout %s: %w\", workTree, err)\n+\t}\n+\tif _, _, err := g.run(ctx, workTree, nil, \"\", nil, \"--git-dir\", gitDir, \"--work-tree\", workTree,\n+\t\t\"checkout\", \"--quiet\", \"--detach\", \"--force\", sha); err != nil {\n+\t\treturn fmt.Errorf(\"gitx: checkout %s: %w\", sha, err)\n+\t}\n+\treturn nil\n+}\ndiff --git a/internal/jobexec/exec.go b/internal/jobexec/exec.go\nnew file mode 100644\nindex 0000000..a097ece\n--- /dev/null\n+++ b/internal/jobexec/exec.go\n@@ -0,0 +1,193 @@\n+// Package jobexec is `ard job-exec`, the agent step of a Kubernetes job pod.\n+// It runs the agent command as a child in its own process group, tees stdout\n+// to a file for the post container, enforces the deadline and writes the done\n+// marker. It reads no credential and no Secret path.\n+package jobexec\n+\n+import (\n+\t\"context\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"io\"\n+\t\"io/fs\"\n+\t\"os\"\n+\t\"os/exec\"\n+\t\"os/signal\"\n+\t\"path/filepath\"\n+\t\"strconv\"\n+\t\"time\"\n+\n+\t\"github.com/albertcbrown/ard/internal/cli\"\n+\t\"github.com/albertcbrown/ard/internal/executor/workspace\"\n+\t\"github.com/albertcbrown/ard/internal/jobpod\"\n+)\n+\n+// ExitDeadline is the exit code when the deadline killed the agent.\n+const ExitDeadline = 124\n+\n+// Redirectable for tests.\n+var (\n+\thomeDir           = jobpod.JobHome\n+\tworkDir           = jobpod.MountWork\n+\toutDir            = jobpod.MountOut\n+\tstdout  io.Writer = os.Stdout\n+\tstderr  io.Writer = os.Stderr\n+)\n+\n+// Run runs the agent command and returns its exit status as a cli.ExitError.\n+func Run(ctx context.Context, e *cli.Env, o cli.JobExecOpts) error {\n+\tcode, err := run(ctx, o)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tif code != 0 {\n+\t\treturn &cli.ExitError{Code: code, Err: fmt.Errorf(\"agent exited with status %d\", code)}\n+\t}\n+\treturn nil\n+}\n+\n+func run(ctx context.Context, o cli.JobExecOpts) (int, error) {\n+\tif len(o.Argv) == 0 {\n+\t\treturn 0, &cli.ExitError{Code: 2, Err: errors.New(\"job-exec: no command\")}\n+\t}\n+\tif _, err := workspace.MakeHome(homeDir); err != nil {\n+\t\treturn 0, err\n+\t}\n+\toutFile, err := os.OpenFile(filepath.Join(outDir, jobpod.StdoutName),\n+\t\tos.O_CREATE|os.O_WRONLY|os.O_TRUNC|noFollow, 0o644)\n+\tif err != nil {\n+\t\treturn 0, err\n+\t}\n+\tdefer outFile.Close()\n+\tdevNull, err := os.Open(os.DevNull)\n+\tif err != nil {\n+\t\treturn 0, err\n+\t}\n+\tdefer devNull.Close()\n+\n+\tcmd := exec.Command(o.Argv[0], o.Argv[1:]...)\n+\tsetGroup(cmd)\n+\tcmd.Stdin = devNull\n+\tcmd.Stdout = io.MultiWriter(stdout, outFile)\n+\tcmd.Stderr = stderr\n+\tcmd.WaitDelay = 2 * time.Second\n+\n+\tchld := make(chan os.Signal, 8)\n+\tsignal.Notify(chld, sigChld...)\n+\tdefer signal.Stop(chld)\n+\n+\tcode := 0\n+\tif err := cmd.Start(); err != nil {\n+\t\tfmt.Fprintf(stderr, \"job-exec: %v\\n\", err)\n+\t\tcode = 127\n+\t\tif errors.Is(err, fs.ErrPermission) {\n+\t\t\tcode = 126\n+\t\t}\n+\t\treturn code, finish(outFile, code)\n+\t}\n+\tpid := cmd.Process.Pid\n+\twaitCh := make(chan error, 1)\n+\tgo func() { waitCh <- cmd.Wait() }()\n+\n+\tvar deadline <-chan time.Time\n+\tif !o.Deadline.IsZero() {\n+\t\tt := time.NewTimer(time.Until(o.Deadline))\n+\t\tdefer t.Stop()\n+\t\tdeadline = t.C\n+\t}\n+\tvar kill <-chan time.Time\n+\tctxDone := ctx.Done()\n+\ttimedOut := false\n+\tterminate := func() {\n+\t\tif kill == nil {\n+\t\t\ttermGroup(pid)\n+\t\t\tt := time.NewTimer(o.Grace)\n+\t\t\t// Stopped on return; the timer is only read in this function.\n+\t\t\tkill = t.C\n+\t\t}\n+\t}\n+loop:\n+\tfor {\n+\t\tselect {\n+\t\tcase werr := <-waitCh:\n+\t\t\tcode = exitCode(cmd, werr)\n+\t\t\tbreak loop\n+\t\tcase <-chld:\n+\t\t\treapOrphans(pid)\n+\t\tcase <-deadline:\n+\t\t\tdeadline = nil\n+\t\t\ttimedOut = true\n+\t\t\tterminate()\n+\t\tcase <-ctxDone:\n+\t\t\tctxDone = nil\n+\t\t\tterminate()\n+\t\tcase <-kill:\n+\t\t\tkillGroup(pid)\n+\t\t\tkill = make(chan time.Time) // never fires again\n+\t\t}\n+\t}\n+\tkillGroup(pid)\n+\treapAll()\n+\tif timedOut {\n+\t\tcode = ExitDeadline\n+\t}\n+\treturn code, finish(outFile, code)\n+}\n+\n+func exitCode(cmd *exec.Cmd, werr error) int {\n+\tif ps := cmd.ProcessState; ps != nil {\n+\t\tif c := ps.ExitCode(); c >= 0 {\n+\t\t\treturn c\n+\t\t}\n+\t\treturn 128 + signalNumber(ps)\n+\t}\n+\tif werr != nil {\n+\t\treturn 1\n+\t}\n+\treturn 0\n+}\n+\n+// finish makes the work tree group-readable, syncs stdout and writes the done\n+// marker. The marker comes last: post serves nothing before it exists.\n+func finish(outFile *os.File, code int) error {\n+\tgroupReadable(workDir)\n+\tif err := outFile.Sync(); err != nil {\n+\t\treturn err\n+\t}\n+\tf, err := os.OpenFile(filepath.Join(outDir, jobpod.DoneName),\n+\t\tos.O_CREATE|os.O_WRONLY|os.O_TRUNC|noFollow, 0o644)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tif _, err := f.WriteString(strconv.Itoa(code) + \"\\n\"); err != nil {\n+\t\tf.Close()\n+\t\treturn err\n+\t}\n+\tif err := f.Sync(); err != nil {\n+\t\tf.Close()\n+\t\treturn err\n+\t}\n+\treturn f.Close()\n+}\n+\n+// groupReadable adds g+r to files and g+rx to directories under root, so the\n+// post container, another user in the same group, can read what the agent\n+// wrote. Symlinks are never followed.\n+func groupReadable(root string) {\n+\tfilepath.WalkDir(root, func(p string, d fs.DirEntry, err error) error {\n+\t\tif err != nil || d.Type()&fs.ModeSymlink != 0 {\n+\t\t\treturn nil\n+\t\t}\n+\t\tst, err := d.Info()\n+\t\tif err != nil {\n+\t\t\treturn nil\n+\t\t}\n+\t\tswitch {\n+\t\tcase d.IsDir():\n+\t\t\tos.Chmod(p, st.Mode().Perm()|0o050)\n+\t\tcase st.Mode().IsRegular():\n+\t\t\tos.Chmod(p, st.Mode().Perm()|0o040)\n+\t\t}\n+\t\treturn nil\n+\t})\n+}\ndiff --git a/internal/jobexec/exec_test.go b/internal/jobexec/exec_test.go\nnew file mode 100644\nindex 0000000..e1f96af\n--- /dev/null\n+++ b/internal/jobexec/exec_test.go\n@@ -0,0 +1,240 @@\n+//go:build unix\n+\n+package jobexec\n+\n+import (\n+\t\"bytes\"\n+\t\"context\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"os\"\n+\t\"os/exec\"\n+\t\"path/filepath\"\n+\t\"strconv\"\n+\t\"strings\"\n+\t\"syscall\"\n+\t\"testing\"\n+\t\"time\"\n+\n+\t\"github.com/albertcbrown/ard/internal/cli\"\n+\t\"github.com/albertcbrown/ard/internal/jobpod\"\n+)\n+\n+// TestMain turns the test binary into the fake agent when ARD_FAKE_AGENT is set.\n+func TestMain(m *testing.M) {\n+\tif mode := os.Getenv(\"ARD_FAKE_AGENT\"); mode != \"\" {\n+\t\tfakeAgent(mode)\n+\t\treturn\n+\t}\n+\tos.Exit(m.Run())\n+}\n+\n+func fakeAgent(mode string) {\n+\tswitch {\n+\tcase strings.HasPrefix(mode, \"exit:\"):\n+\t\tn, _ := strconv.Atoi(strings.TrimPrefix(mode, \"exit:\"))\n+\t\tfmt.Fprintln(os.Stdout, \"to-stdout\")\n+\t\tfmt.Fprintln(os.Stderr, \"to-stderr\")\n+\t\tos.Exit(n)\n+\tcase mode == \"sleep\":\n+\t\ttime.Sleep(time.Minute)\n+\tcase mode == \"ignoreterm\":\n+\t\tignoreTerm()\n+\t\tfmt.Println(\"ready\")\n+\t\ttime.Sleep(time.Minute)\n+\tcase mode == \"grandchild\":\n+\t\tc := exec.Command(\"sleep\", \"60\")\n+\t\tc.Start()\n+\t\tos.WriteFile(os.Getenv(\"ARD_PIDFILE\"), []byte(strconv.Itoa(c.Process.Pid)), 0o644)\n+\tcase mode == \"perm\":\n+\t\tos.WriteFile(filepath.Join(os.Getenv(\"ARD_WORK\"), \"secret.txt\"), []byte(\"x\"), 0o600)\n+\t\tos.Mkdir(filepath.Join(os.Getenv(\"ARD_WORK\"), \"d\"), 0o700)\n+\t\tos.WriteFile(filepath.Join(os.Getenv(\"ARD_WORK\"), \"d\", \"f\"), []byte(\"x\"), 0o600)\n+\t}\n+\tos.Exit(0)\n+}\n+\n+func ignoreTerm() { signalIgnore(syscall.SIGTERM) }\n+\n+type env struct {\n+\twork, out, home string\n+\tstdout, stderr  *bytes.Buffer\n+}\n+\n+func setup(t *testing.T, mode string) *env {\n+\tt.Helper()\n+\troot := t.TempDir()\n+\te := &env{work: filepath.Join(root, \"work\"), out: filepath.Join(root, \"out\"), home: filepath.Join(root, \"job\", \"home\"),\n+\t\tstdout: &bytes.Buffer{}, stderr: &bytes.Buffer{}}\n+\tfor _, d := range []string{e.work, e.out, filepath.Dir(e.home)} {\n+\t\tos.MkdirAll(d, 0o755)\n+\t}\n+\thomeDir, workDir, outDir, stdout, stderr = e.home, e.work, e.out, e.stdout, e.stderr\n+\tt.Cleanup(func() {\n+\t\thomeDir, workDir, outDir = jobpod.JobHome, jobpod.MountWork, jobpod.MountOut\n+\t\tstdout, stderr = os.Stdout, os.Stderr\n+\t})\n+\tt.Setenv(\"ARD_FAKE_AGENT\", mode)\n+\tt.Setenv(\"ARD_WORK\", e.work)\n+\treturn e\n+}\n+\n+func (e *env) run(ctx context.Context, d time.Duration, grace time.Duration) int {\n+\to := cli.JobExecOpts{Grace: grace, Argv: []string{os.Args[0]}}\n+\tif d > 0 {\n+\t\to.Deadline = time.Now().Add(d)\n+\t}\n+\terr := Run(ctx, &cli.Env{}, o)\n+\tvar ee *cli.ExitError\n+\tif errors.As(err, &ee) {\n+\t\treturn ee.Code\n+\t}\n+\tif err != nil {\n+\t\treturn -1\n+\t}\n+\treturn 0\n+}\n+\n+func (e *env) done(t *testing.T) string {\n+\tt.Helper()\n+\tb, err := os.ReadFile(filepath.Join(e.out, jobpod.DoneName))\n+\tif err != nil {\n+\t\tt.Fatalf(\"no done marker: %v\", err)\n+\t}\n+\treturn strings.TrimSpace(string(b))\n+}\n+\n+func TestExecExitCodes(t *testing.T) {\n+\tfor _, n := range []int{0, 3} {\n+\t\tt.Run(strconv.Itoa(n), func(t *testing.T) {\n+\t\t\te := setup(t, \"exit:\"+strconv.Itoa(n))\n+\t\t\tif got := e.run(context.Background(), time.Minute, time.Second); got != n {\n+\t\t\t\tt.Fatalf(\"exit = %d, want %d\", got, n)\n+\t\t\t}\n+\t\t\tif e.done(t) != strconv.Itoa(n) {\n+\t\t\t\tt.Errorf(\"marker = %q\", e.done(t))\n+\t\t\t}\n+\t\t\tfile, _ := os.ReadFile(filepath.Join(e.out, jobpod.StdoutName))\n+\t\t\tif string(file) != \"to-stdout\\n\" || e.stdout.String() != \"to-stdout\\n\" {\n+\t\t\t\tt.Errorf(\"stdout file %q, stream %q\", file, e.stdout.String())\n+\t\t\t}\n+\t\t\tif e.stderr.String() != \"to-stderr\\n\" || strings.Contains(string(file), \"stderr\") {\n+\t\t\t\tt.Errorf(\"stderr %q\", e.stderr.String())\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+func TestExecHome(t *testing.T) {\n+\te := setup(t, \"exit:0\")\n+\te.run(context.Background(), time.Minute, time.Second)\n+\tfor _, d := range []string{e.home, filepath.Join(e.home, \".claude\")} {\n+\t\tst, err := os.Stat(d)\n+\t\tif err != nil || st.Mode().Perm() != 0o700 && d != e.home {\n+\t\t\tt.Errorf(\"%s: %v %v\", d, st, err)\n+\t\t}\n+\t}\n+}\n+\n+func TestExecDeadline(t *testing.T) {\n+\te := setup(t, \"sleep\")\n+\tstart := time.Now()\n+\tif got := e.run(context.Background(), 300*time.Millisecond, time.Second); got != ExitDeadline {\n+\t\tt.Fatalf(\"exit = %d, want %d\", got, ExitDeadline)\n+\t}\n+\tif time.Since(start) > 10*time.Second {\n+\t\tt.Error(\"deadline not enforced promptly\")\n+\t}\n+\tif e.done(t) != \"124\" {\n+\t\tt.Errorf(\"marker = %q\", e.done(t))\n+\t}\n+}\n+\n+func TestExecKillAfterGrace(t *testing.T) {\n+\te := setup(t, \"ignoreterm\")\n+\tstart := time.Now()\n+\tif got := e.run(context.Background(), 500*time.Millisecond, 500*time.Millisecond); got != ExitDeadline {\n+\t\tt.Fatalf(\"exit = %d\", got)\n+\t}\n+\tif el := time.Since(start); el < 900*time.Millisecond || el > 10*time.Second {\n+\t\tt.Errorf(\"elapsed %v: want SIGTERM at 0.5s then SIGKILL after the grace\", el)\n+\t}\n+}\n+\n+func TestExecForwardedSIGTERM(t *testing.T) {\n+\te := setup(t, \"sleep\")\n+\tctx, cancel := context.WithCancel(context.Background())\n+\tgo func() { time.Sleep(300 * time.Millisecond); cancel() }()\n+\tif got := e.run(ctx, time.Minute, time.Second); got != 128+15 {\n+\t\tt.Fatalf(\"exit = %d, want 143\", got)\n+\t}\n+\te.done(t)\n+}\n+\n+func TestExecKillsGrandchild(t *testing.T) {\n+\te := setup(t, \"grandchild\")\n+\tpidFile := filepath.Join(t.TempDir(), \"pid\")\n+\tt.Setenv(\"ARD_PIDFILE\", pidFile)\n+\tif got := e.run(context.Background(), time.Minute, time.Second); got != 0 {\n+\t\tt.Fatalf(\"exit = %d\", got)\n+\t}\n+\tb, err := os.ReadFile(pidFile)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tpid, _ := strconv.Atoi(string(b))\n+\tvar alive bool\n+\tfor i := 0; i < 50; i++ {\n+\t\t// A killed grandchild is a zombie until its parent reaps it; signal 0\n+\t\t// to a zombie still succeeds, so check the process state.\n+\t\tout, _ := exec.Command(\"ps\", \"-o\", \"stat=\", \"-p\", strconv.Itoa(pid)).Output()\n+\t\ts := strings.TrimSpace(string(out))\n+\t\talive = s != \"\" && !strings.HasPrefix(s, \"Z\")\n+\t\tif !alive {\n+\t\t\tbreak\n+\t\t}\n+\t\ttime.Sleep(100 * time.Millisecond)\n+\t}\n+\tif alive {\n+\t\tsyscall.Kill(pid, syscall.SIGKILL)\n+\t\tt.Error(\"grandchild survived\")\n+\t}\n+}\n+\n+func TestExecPlantedDoneAndPerms(t *testing.T) {\n+\te := setup(t, \"perm\")\n+\tos.WriteFile(filepath.Join(e.out, jobpod.DoneName), []byte(\"planted-planted-planted\"), 0o644)\n+\tif got := e.run(context.Background(), time.Minute, time.Second); got != 0 {\n+\t\tt.Fatalf(\"exit = %d\", got)\n+\t}\n+\tif e.done(t) != \"0\" {\n+\t\tt.Errorf(\"marker = %q\", e.done(t))\n+\t}\n+\tif st, _ := os.Stat(filepath.Join(e.work, \"secret.txt\")); st.Mode().Perm() != 0o640 {\n+\t\tt.Errorf(\"file mode %v\", st.Mode().Perm())\n+\t}\n+\tif st, _ := os.Stat(filepath.Join(e.work, \"d\")); st.Mode().Perm() != 0o750 {\n+\t\tt.Errorf(\"dir mode %v\", st.Mode().Perm())\n+\t}\n+}\n+\n+func TestExecMissingCommand(t *testing.T) {\n+\te := setup(t, \"\")\n+\terr := Run(context.Background(), &cli.Env{}, cli.JobExecOpts{Argv: []string{\"/nonexistent/agent\"}, Grace: time.Second})\n+\tvar ee *cli.ExitError\n+\tif !errors.As(err, &ee) || ee.Code != 127 {\n+\t\tt.Fatalf(\"err = %v\", err)\n+\t}\n+\tif e.done(t) != \"127\" {\n+\t\tt.Error(\"no marker for a command that did not start\")\n+\t}\n+}\n+\n+func TestExecNoArgv(t *testing.T) {\n+\tsetup(t, \"\")\n+\terr := Run(context.Background(), &cli.Env{}, cli.JobExecOpts{})\n+\tvar ee *cli.ExitError\n+\tif !errors.As(err, &ee) || ee.Code != 2 {\n+\t\tt.Fatalf(\"err = %v\", err)\n+\t}\n+}\ndiff --git a/internal/jobexec/proc_other.go b/internal/jobexec/proc_other.go\nnew file mode 100644\nindex 0000000..2c8cee8\n--- /dev/null\n+++ b/internal/jobexec/proc_other.go\n@@ -0,0 +1,25 @@\n+//go:build !unix\n+\n+package jobexec\n+\n+import (\n+\t\"os\"\n+\t\"os/exec\"\n+)\n+\n+const noFollow = 0\n+\n+var sigChld []os.Signal\n+\n+func setGroup(*exec.Cmd)                {}\n+func termGroup(pid int)                 { killPid(pid) }\n+func killGroup(pid int)                 { killPid(pid) }\n+func signalNumber(*os.ProcessState) int { return 0 }\n+func reapOrphans(int)                   {}\n+func reapAll()                          {}\n+\n+func killPid(pid int) {\n+\tif p, err := os.FindProcess(pid); err == nil {\n+\t\t_ = p.Kill()\n+\t}\n+}\ndiff --git a/internal/jobexec/proc_unix.go b/internal/jobexec/proc_unix.go\nnew file mode 100644\nindex 0000000..06647cc\n--- /dev/null\n+++ b/internal/jobexec/proc_unix.go\n@@ -0,0 +1,25 @@\n+//go:build unix\n+\n+package jobexec\n+\n+import (\n+\t\"os\"\n+\t\"os/exec\"\n+\t\"syscall\"\n+)\n+\n+const noFollow = syscall.O_NOFOLLOW\n+\n+var sigChld = []os.Signal{syscall.SIGCHLD}\n+\n+func setGroup(cmd *exec.Cmd) { cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true} }\n+\n+func termGroup(pid int) { _ = syscall.Kill(-pid, syscall.SIGTERM) }\n+func killGroup(pid int) { _ = syscall.Kill(-pid, syscall.SIGKILL) }\n+\n+func signalNumber(ps *os.ProcessState) int {\n+\tif ws, ok := ps.Sys().(syscall.WaitStatus); ok && ws.Signaled() {\n+\t\treturn int(ws.Signal())\n+\t}\n+\treturn 0\n+}\ndiff --git a/internal/jobexec/reap_linux.go b/internal/jobexec/reap_linux.go\nnew file mode 100644\nindex 0000000..709970b\n--- /dev/null\n+++ b/internal/jobexec/reap_linux.go\n@@ -0,0 +1,61 @@\n+package jobexec\n+\n+import (\n+\t\"encoding/binary\"\n+\t\"os\"\n+\t\"syscall\"\n+\t\"unsafe\"\n+)\n+\n+const (\n+\tpAll    = 0 // P_ALL\n+\twNoWait = 0x01000000\n+)\n+\n+// peekChild returns the pid of an exited child without reaping it, or 0.\n+func peekChild() int {\n+\tvar info [128]byte // siginfo_t\n+\t_, _, errno := syscall.Syscall6(syscall.SYS_WAITID, pAll, 0, uintptr(unsafe.Pointer(&info[0])),\n+\t\tsyscall.WEXITED|syscall.WNOHANG|wNoWait, 0, 0)\n+\tif errno != 0 || binary.NativeEndian.Uint32(info[0:4]) == 0 { // si_signo\n+\t\treturn 0\n+\t}\n+\toff := 16 // si_pid follows three ints and, on 64-bit, 4 bytes of padding\n+\tif unsafe.Sizeof(uintptr(0)) == 4 {\n+\t\toff = 12\n+\t}\n+\treturn int(int32(binary.NativeEndian.Uint32(info[off : off+4])))\n+}\n+\n+// reapOrphans collects zombie children that are not the agent, which os/exec\n+// is still going to wait for. When job-exec is PID 1 of the container, the\n+// agent's orphaned grandchildren are re-parented to it. It peeks with\n+// WNOWAIT so the agent's own status is never taken.\n+func reapOrphans(agent int) {\n+\tif os.Getpid() != 1 {\n+\t\treturn // only PID 1 inherits orphans; elsewhere wait4(-1) could take a stranger's child\n+\t}\n+\tfor {\n+\t\tpid := peekChild()\n+\t\tif pid <= 0 || pid == agent {\n+\t\t\treturn\n+\t\t}\n+\t\tvar ws syscall.WaitStatus\n+\t\tif _, err := syscall.Wait4(pid, &ws, syscall.WNOHANG, nil); err != nil {\n+\t\t\treturn\n+\t\t}\n+\t}\n+}\n+\n+// reapAll collects every exited child; the agent has been waited for.\n+func reapAll() {\n+\tif os.Getpid() != 1 {\n+\t\treturn\n+\t}\n+\tfor {\n+\t\tvar ws syscall.WaitStatus\n+\t\tif pid, err := syscall.Wait4(-1, &ws, syscall.WNOHANG, nil); err != nil || pid <= 0 {\n+\t\t\treturn\n+\t\t}\n+\t}\n+}\ndiff --git a/internal/jobexec/reap_other_unix.go b/internal/jobexec/reap_other_unix.go\nnew file mode 100644\nindex 0000000..8493694\n--- /dev/null\n+++ b/internal/jobexec/reap_other_unix.go\n@@ -0,0 +1,6 @@\n+//go:build unix && !linux\n+\n+package jobexec\n+\n+func reapOrphans(int) {}\n+func reapAll()        {}\ndiff --git a/internal/jobexec/sig_test.go b/internal/jobexec/sig_test.go\nnew file mode 100644\nindex 0000000..641fbcc\n--- /dev/null\n+++ b/internal/jobexec/sig_test.go\n@@ -0,0 +1,10 @@\n+//go:build unix\n+\n+package jobexec\n+\n+import (\n+\t\"os\"\n+\t\"os/signal\"\n+)\n+\n+func signalIgnore(s os.Signal) { signal.Ignore(s) }\ndiff --git a/internal/jobpost/post.go b/internal/jobpost/post.go\nnew file mode 100644\nindex 0000000..0ec2b51\n--- /dev/null\n+++ b/internal/jobpost/post.go\n@@ -0,0 +1,129 @@\n+// Package jobpost is `ard job-post`, the result server of a Kubernetes job\n+// pod. It serves one route, GET /v1/result, guarded by the per-job key, and\n+// streams the packed work tree and agent stdout once the agent step has\n+// written its done marker. It serves plain HTTP; the controller reaches it\n+// through the pod network.\n+package jobpost\n+\n+import (\n+\t\"context\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"io\"\n+\t\"log/slog\"\n+\t\"net\"\n+\t\"net/http\"\n+\t\"os\"\n+\t\"os/signal\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"syscall\"\n+\t\"time\"\n+\n+\t\"github.com/albertcbrown/ard/internal/cli\"\n+\t\"github.com/albertcbrown/ard/internal/jobpod\"\n+\t\"github.com/albertcbrown/ard/internal/tarball\"\n+)\n+\n+// Redirectable for tests.\n+var (\n+\tkeyDir  = jobpod.PostSecretDir\n+\tworkDir = jobpod.MountWork\n+\toutDir  = jobpod.MountOut\n+\tlisten  = func() (net.Listener, error) { return net.Listen(\"tcp\", fmt.Sprintf(\":%d\", jobpod.ResultPort)) }\n+)\n+\n+const maxKeyBytes = 1024\n+\n+// Run serves until SIGTERM, ctx cancellation or the deadline, then exits 0.\n+func Run(ctx context.Context, e *cli.Env, o cli.JobPostOpts) error {\n+\tkey, err := readKey()\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tln, err := listen()\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tctx, stop := signal.NotifyContext(ctx, syscall.SIGTERM, os.Interrupt)\n+\tdefer stop()\n+\tif !o.Deadline.IsZero() {\n+\t\tvar cancel context.CancelFunc\n+\t\tctx, cancel = context.WithDeadline(ctx, o.Deadline)\n+\t\tdefer cancel()\n+\t}\n+\treturn serve(ctx, ln, key)\n+}\n+\n+func readKey() (string, error) {\n+\tf, err := os.Open(filepath.Join(keyDir, jobpod.ItemResultKey))\n+\tif err != nil {\n+\t\treturn \"\", fmt.Errorf(\"result key: %w\", err)\n+\t}\n+\tdefer f.Close()\n+\tb, err := io.ReadAll(io.LimitReader(f, maxKeyBytes+1))\n+\tif err != nil {\n+\t\treturn \"\", fmt.Errorf(\"result key: %w\", err)\n+\t}\n+\tk := strings.TrimSpace(string(b))\n+\tif k == \"\" || len(b) > maxKeyBytes {\n+\t\treturn \"\", errors.New(\"result key: empty or oversize\")\n+\t}\n+\treturn k, nil\n+}\n+\n+func serve(ctx context.Context, ln net.Listener, key string) error {\n+\th := &handler{key: key, slot: make(chan struct{}, 1)}\n+\tmux := http.NewServeMux()\n+\tmux.HandleFunc(\"GET \"+jobpod.ResultPath, h.result)\n+\tsrv := &http.Server{\n+\t\tHandler:           mux,\n+\t\tReadHeaderTimeout: 10 * time.Second,\n+\t\tIdleTimeout:       60 * time.Second,\n+\t\tMaxHeaderBytes:    8 << 10,\n+\t\tErrorLog:          slog.NewLogLogger(slog.DiscardHandler, slog.LevelError),\n+\t}\n+\terrc := make(chan error, 1)\n+\tgo func() { errc <- srv.Serve(ln) }()\n+\tselect {\n+\tcase err := <-errc:\n+\t\treturn err\n+\tcase <-ctx.Done():\n+\t}\n+\tsctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)\n+\tdefer cancel()\n+\tif err := srv.Shutdown(sctx); err != nil {\n+\t\tsrv.Close()\n+\t}\n+\treturn nil\n+}\n+\n+type handler struct {\n+\tkey  string\n+\tslot chan struct{}\n+}\n+\n+func (h *handler) result(w http.ResponseWriter, r *http.Request) {\n+\tconst prefix = \"Bearer \"\n+\tgot := r.Header.Get(\"Authorization\")\n+\tif !strings.HasPrefix(got, prefix) || !jobpod.KeyMatches(got[len(prefix):], h.key) {\n+\t\thttp.Error(w, \"unauthorized\", http.StatusUnauthorized)\n+\t\treturn\n+\t}\n+\tselect {\n+\tcase h.slot <- struct{}{}:\n+\t\tdefer func() { <-h.slot }()\n+\tdefault:\n+\t\thttp.Error(w, \"busy\", http.StatusTooManyRequests)\n+\t\treturn\n+\t}\n+\tif _, err := os.Stat(filepath.Join(outDir, jobpod.DoneName)); err != nil {\n+\t\thttp.Error(w, \"not ready\", http.StatusConflict)\n+\t\treturn\n+\t}\n+\tw.Header().Set(\"Content-Type\", \"application/gzip\")\n+\t_, _ = tarball.Pack(w, []tarball.Root{\n+\t\t{Name: jobpod.RootWork, Dir: workDir},\n+\t\t{Name: jobpod.RootOut, Dir: outDir, Files: []string{jobpod.StdoutName}},\n+\t})\n+}\ndiff --git a/internal/jobpost/post_test.go b/internal/jobpost/post_test.go\nnew file mode 100644\nindex 0000000..41b06b7\n--- /dev/null\n+++ b/internal/jobpost/post_test.go\n@@ -0,0 +1,202 @@\n+package jobpost\n+\n+import (\n+\t\"archive/tar\"\n+\t\"bytes\"\n+\t\"compress/gzip\"\n+\t\"context\"\n+\t\"io\"\n+\t\"net\"\n+\t\"net/http\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"sort\"\n+\t\"strings\"\n+\t\"testing\"\n+\t\"time\"\n+\n+\t\"github.com/albertcbrown/ard/internal/cli\"\n+\t\"github.com/albertcbrown/ard/internal/jobpod\"\n+)\n+\n+const testKey = \"k3y-value-for-tests\"\n+\n+type rig struct {\n+\turl       string\n+\twork, out string\n+\tcancel    context.CancelFunc\n+\terrc      chan error\n+}\n+\n+func start(t *testing.T) *rig {\n+\tt.Helper()\n+\troot := t.TempDir()\n+\tr := &rig{work: filepath.Join(root, \"work\"), out: filepath.Join(root, \"out\"), errc: make(chan error, 1)}\n+\tos.MkdirAll(r.work, 0o755)\n+\tos.MkdirAll(r.out, 0o755)\n+\tworkDir, outDir = r.work, r.out\n+\tt.Cleanup(func() { workDir, outDir = jobpod.MountWork, jobpod.MountOut })\n+\tln, err := net.Listen(\"tcp\", \"127.0.0.1:0\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tr.url = \"http://\" + ln.Addr().String()\n+\tctx, cancel := context.WithCancel(context.Background())\n+\tr.cancel = cancel\n+\tt.Cleanup(cancel)\n+\tgo func() { r.errc <- serve(ctx, ln, testKey) }()\n+\treturn r\n+}\n+\n+func (r *rig) get(t *testing.T, path, auth string) (*http.Response, []byte) {\n+\tt.Helper()\n+\treq, _ := http.NewRequest(\"GET\", r.url+path, nil)\n+\tif auth != \"\" {\n+\t\treq.Header.Set(\"Authorization\", auth)\n+\t}\n+\tresp, err := http.DefaultClient.Do(req)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tdefer resp.Body.Close()\n+\tb, _ := io.ReadAll(resp.Body)\n+\treturn resp, b\n+}\n+\n+func (r *rig) finish(t *testing.T) {\n+\tt.Helper()\n+\tos.WriteFile(filepath.Join(r.work, \"a.txt\"), []byte(\"A\"), 0o644)\n+\tos.WriteFile(filepath.Join(r.out, jobpod.StdoutName), []byte(\"log\"), 0o644)\n+\tos.WriteFile(filepath.Join(r.out, \"other\"), []byte(\"no\"), 0o644)\n+\tos.WriteFile(filepath.Join(r.out, jobpod.DoneName), []byte(\"0\\n\"), 0o644)\n+}\n+\n+func names(t *testing.T, b []byte) []string {\n+\tt.Helper()\n+\tgz, err := gzip.NewReader(bytes.NewReader(b))\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\ttr := tar.NewReader(gz)\n+\tvar out []string\n+\tfor {\n+\t\th, err := tr.Next()\n+\t\tif err != nil {\n+\t\t\tbreak\n+\t\t}\n+\t\tif h.Typeflag == tar.TypeReg {\n+\t\t\tout = append(out, h.Name)\n+\t\t}\n+\t}\n+\tsort.Strings(out)\n+\treturn out\n+}\n+\n+func TestPost(t *testing.T) {\n+\tauth := \"Bearer \" + testKey\n+\tt.Run(\"auth\", func(t *testing.T) {\n+\t\tr := start(t)\n+\t\tr.finish(t)\n+\t\tos.Chmod(r.work, 0o000) // a read before auth would fail loudly\n+\t\tdefer os.Chmod(r.work, 0o755)\n+\t\tfor _, a := range []string{\"\", \"Bearer wrong\", testKey, \"Bearer \"} {\n+\t\t\tif resp, body := r.get(t, jobpod.ResultPath, a); resp.StatusCode != 401 || strings.Contains(string(body), testKey) {\n+\t\t\t\tt.Errorf(\"auth %q: %d %q\", a, resp.StatusCode, body)\n+\t\t\t}\n+\t\t}\n+\t})\n+\tt.Run(\"not ready then ready\", func(t *testing.T) {\n+\t\tr := start(t)\n+\t\tos.Chmod(r.work, 0o000)\n+\t\tif resp, _ := r.get(t, jobpod.ResultPath, auth); resp.StatusCode != 409 {\n+\t\t\tt.Errorf(\"before marker: %d\", resp.StatusCode)\n+\t\t}\n+\t\tos.Chmod(r.work, 0o755)\n+\t\tr.finish(t)\n+\t\tresp, b1 := r.get(t, jobpod.ResultPath, auth)\n+\t\tif resp.StatusCode != 200 {\n+\t\t\tt.Fatalf(\"after marker: %d\", resp.StatusCode)\n+\t\t}\n+\t\tgot := names(t, b1)\n+\t\tif strings.Join(got, \",\") != \"out/stdout,work/a.txt\" {\n+\t\t\tt.Errorf(\"entries = %v\", got)\n+\t\t}\n+\t\tif _, b2 := r.get(t, jobpod.ResultPath, auth); !bytes.Equal(b1, b2) {\n+\t\t\tt.Error(\"repeat GET differs\")\n+\t\t}\n+\t})\n+\tt.Run(\"routes\", func(t *testing.T) {\n+\t\tr := start(t)\n+\t\tfor _, p := range []string{\"/debug/pprof/\", \"/\", \"/v1/other\"} {\n+\t\t\tif resp, _ := r.get(t, p, auth); resp.StatusCode != 404 {\n+\t\t\t\tt.Errorf(\"%s: %d\", p, resp.StatusCode)\n+\t\t\t}\n+\t\t}\n+\t\treq, _ := http.NewRequest(\"POST\", r.url+jobpod.ResultPath, nil)\n+\t\treq.Header.Set(\"Authorization\", auth)\n+\t\tif resp, err := http.DefaultClient.Do(req); err != nil || resp.StatusCode != 405 {\n+\t\t\tt.Errorf(\"POST: %v %v\", resp, err)\n+\t\t}\n+\t})\n+\tt.Run(\"concurrent request gets 429\", func(t *testing.T) {\n+\t\tr := start(t)\n+\t\tr.finish(t)\n+\t\t// A big file and a client that does not read keep the first request busy.\n+\t\tos.WriteFile(filepath.Join(r.work, \"big\"), bytes.Repeat([]byte{1}, 64<<20), 0o644)\n+\t\treq, _ := http.NewRequest(\"GET\", r.url+jobpod.ResultPath, nil)\n+\t\treq.Header.Set(\"Authorization\", auth)\n+\t\tfirst, err := http.DefaultClient.Do(req)\n+\t\tif err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tdefer first.Body.Close()\n+\t\tresp, _ := r.get(t, jobpod.ResultPath, auth)\n+\t\tif resp.StatusCode != 429 {\n+\t\t\tt.Errorf(\"second request: %d\", resp.StatusCode)\n+\t\t}\n+\t})\n+\tt.Run(\"shutdown on cancel\", func(t *testing.T) {\n+\t\tr := start(t)\n+\t\tr.cancel()\n+\t\tselect {\n+\t\tcase err := <-r.errc:\n+\t\t\tif err != nil {\n+\t\t\t\tt.Errorf(\"serve = %v\", err)\n+\t\t\t}\n+\t\tcase <-time.After(15 * time.Second):\n+\t\t\tt.Error(\"no shutdown\")\n+\t\t}\n+\t})\n+}\n+\n+func TestRunKeyAndPort(t *testing.T) {\n+\tdir := t.TempDir()\n+\tkeyDir = dir\n+\tt.Cleanup(func() { keyDir = jobpod.PostSecretDir })\n+\tctx := context.Background()\n+\t// Missing and empty key.\n+\tif err := Run(ctx, &cli.Env{}, cli.JobPostOpts{}); err == nil {\n+\t\tt.Error(\"missing key accepted\")\n+\t}\n+\tos.WriteFile(filepath.Join(dir, jobpod.ItemResultKey), []byte(\"\\n\"), 0o444)\n+\tif err := Run(ctx, &cli.Env{}, cli.JobPostOpts{}); err == nil {\n+\t\tt.Error(\"empty key accepted\")\n+\t}\n+\tos.Remove(filepath.Join(dir, jobpod.ItemResultKey))\n+\tos.WriteFile(filepath.Join(dir, jobpod.ItemResultKey), []byte(testKey), 0o444)\n+\t// Port already bound.\n+\tbusy, _ := net.Listen(\"tcp\", \"127.0.0.1:0\")\n+\tdefer busy.Close()\n+\tlisten = func() (net.Listener, error) { return net.Listen(\"tcp\", busy.Addr().String()) }\n+\tdefer func() {\n+\t\tlisten = func() (net.Listener, error) { return net.Listen(\"tcp\", \":8080\") }\n+\t}()\n+\tif err := Run(ctx, &cli.Env{}, cli.JobPostOpts{}); err == nil {\n+\t\tt.Error(\"bound port accepted\")\n+\t}\n+\t// Deadline ends the server with exit 0.","numLines":1328,"startLine":1,"totalLines":1915,"truncatedByTokenCap":true}},"tool_result_meta":[{"id":"toolu_01FaBD1iGL4kG4LTCrXsce6M","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
