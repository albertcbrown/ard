nute, time.Second)\n724\t+\tfor _, d := range []string{e.home, filepath.Join(e.home, \".claude\")} {\n725\t+\t\tst, err := os.Stat(d)\n726\t+\t\tif err != nil || st.Mode().Perm() != 0o700 && d != e.home {\n727\t+\t\t\tt.Errorf(\"%s: %v %v\", d, st, err)\n728\t+\t\t}\n729\t+\t}\n730\t+}\n731\t+\n732\t+func TestExecDeadline(t *testing.T) {\n733\t+\te := setup(t, \"sleep\")\n734\t+\tstart := time.Now()\n735\t+\tif got := e.run(context.Background(), 300*time.Millisecond, time.Second); got != ExitDeadline {\n736\t+\t\tt.Fatalf(\"exit = %d, want %d\", got, ExitDeadline)\n737\t+\t}\n738\t+\tif time.Since(start) > 10*time.Second {\n739\t+\t\tt.Error(\"deadline not enforced promptly\")\n740\t+\t}\n741\t+\tif e.done(t) != \"124\" {\n742\t+\t\tt.Errorf(\"marker = %q\", e.done(t))\n743\t+\t}\n744\t+}\n745\t+\n746\t+func TestExecKillAfterGrace(t *testing.T) {\n747\t+\te := setup(t, \"ignoreterm\")\n748\t+\tstart := time.Now()\n749\t+\tif got := e.run(context.Background(), 500*time.Millisecond, 500*time.Millisecond); got != ExitDeadline {\n750\t+\t\tt.Fatalf(\"exit = %d\", got)\n751\t+\t}\n752\t+\tif el := time.Since(start); el < 900*time.Millisecond || el > 10*time.Second {\n753\t+\t\tt.Errorf(\"elapsed %v: want SIGTERM at 0.5s then SIGKILL after the grace\", el)\n754\t+\t}\n755\t+}\n756\t+\n757\t+func TestExecForwardedSIGTERM(t *testing.T) {\n758\t+\te := setup(t, \"sleep\")\n759\t+\tctx, cancel := context.WithCancel(context.Background())\n760\t+\tgo func() { time.Sleep(300 * time.Millisecond); cancel() }()\n761\t+\tif got := e.run(ctx, time.Minute, time.Second); got != 128+15 {\n762\t+\t\tt.Fatalf(\"exit = %d, want 143\", got)\n763\t+\t}\n764\t+\te.done(t)\n765\t+}\n766\t+\n767\t+func TestExecKillsGrandchild(t *testing.T) {\n768\t+\te := setup(t, \"grandchild\")\n769\t+\tpidFile := filepath.Join(t.TempDir(), \"pid\")\n770\t+\tt.Setenv(\"ARD_PIDFILE\", pidFile)\n771\t+\tif got := e.run(context.Background(), time.Minute, time.Second); got != 0 {\n772\t+\t\tt.Fatalf(\"exit = %d\"