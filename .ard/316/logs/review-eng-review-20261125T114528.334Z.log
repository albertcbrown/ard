+\trole:      jobpod.JobRole,\n1377\t+\tsidecar:   jobpod.JobSidecar,\n1378\t+\thistory:   jobpod.JobHistory,\n1379\t+}\n1380\t+\n1381\t+// permanent marks an error a retry cannot fix.\n1382\t+type permanent struct{ err error }\n1383\t+\n1384\t+func (p permanent) Error() string { return p.err.Error() }\n1385\t+func (p permanent) Unwrap() error { return p.err }\n1386\t+\n1387\t+func perm(format string, a ...any) error { return permanent{fmt.Errorf(format, a...)} }\n1388\t+\n1389\t+// Run executes the step. Permanent failures exit jobpod.ExitPermanent with a\n1390\t+// reason in the termination log; everything else exits jobpod.ExitTransient.\n1391\t+func Run(ctx context.Context, e *cli.Env, o cli.JobPreOpts) error {\n1392\t+\tif !o.Deadline.IsZero() {\n1393\t+\t\tvar cancel context.CancelFunc\n1394\t+\t\tctx, cancel = context.WithDeadline(ctx, o.Deadline)\n1395\t+\t\tdefer cancel()\n1396\t+\t}\n1397\t+\terr := run(ctx, o)\n1398\t+\tif err == nil {\n1399\t+\t\treturn nil\n1400\t+\t}\n1401\t+\tvar p permanent\n1402\t+\tif errors.Is(err, gitx.ErrRefNotFound) || errors.Is(err, gitx.ErrRepoAccess) || errors.As(err, &p) {\n1403\t+\t\t_ = os.WriteFile(paths.termLog, []byte(truncate(err.Error(), 2048)), 0o644)\n1404\t+\t\treturn &cli.ExitError{Code: jobpod.ExitPermanent, Err: err}\n1405\t+\t}\n1406\t+\treturn &cli.ExitError{Code: jobpod.ExitTransient, Err: err}\n1407\t+}\n1408\t+\n1409\t+func truncate(s string, n int) string {\n1410\t+\tif len(s) > n {\n1411\t+\t\treturn s[:n]\n1412\t+\t}\n1413\t+\treturn s\n1414\t+}\n1415\t+\n1416\t+func readSecret(name string, limit int64) ([]byte, error) {\n1417\t+\tf, err := os.Open(filepath.Join(paths.secretDir, name))\n1418\t+\tif err != nil {\n1419\t+\t\treturn nil, err\n1420\t+\t}\n1421\t+\tdefer f.Close()\n1422\t+\tb, err := io.ReadAll(io.LimitReader(f, limit+1))\n1423\t+\tif err != nil {\n1424\t+\t\treturn nil, err\n1425\t+\t}\n1426\t+\tif int64(len(b)) > limit {\n1427\t+\t\treturn nil, fmt.Errorf(\"%s exceeds %d bytes\", name, limit)\n1428\t+\t}\n1429\t+\treturn b, nil\n1430\t+}\n1431\t+\n1432\t+func run(ctx context.Context, o cli.JobPreOpts) error {\n1433\t+\traw, err := readSecret(jobpod.ItemManifest, jobpod.MaxManifestBytes)\n1434\t+\tif err != nil {\n1435\t+\t\treturn perm(\"manifest: %v\", err)\n1436\t+\t}\n1437\t+\tm, err := jobpod.Decode(raw)\n1438\t+\tif err != nil {\n1439\t+\t\treturn perm(\"%v\", err)\n1440\t+\t}\n1441\t+\ttokB, err := readSecret(jobpod.ItemGitAccess, 4096)\n1442\t+\tif err != nil {\n1443\t+\t\treturn perm(\"git token: %v\", err)\n1444\t+\t}\n1445\t+\ttoken := strings.TrimSpace(string(tokB))\n1446\t+\ttok := func(context.Context) (string, error) { return token, nil }\n1447\t+\tif m.Role.Repo != m.Repo {\n1448\t+\t\treturn perm(\"role repo %q is not the job repo %q\", m.Role.Repo, m.Repo)\n1449\t+\t}\n1450\t+\n1451\t+\tsyscallUmask(0o002)\n1452\t+\thome := filepath.Join(paths.ctl, \"home\")\n1453\t+\tif err := os.MkdirAll(home, 0o700); err != nil {\n1454\t+\t\treturn err\n1455\t+\t}\n1456\t+\tfor k, v := range map[string]string{\"HOME\": home, \"GIT_CONFIG_NOSYSTEM\": \"1\", \"GIT_CONFIG_GLOBAL\": \"/dev/null\"} {\n1457\t+\t\tos.Setenv(k, v)\n1458\t+\t}\n1459\t+\n1460\t+\tbase := strings.TrimRight(o.GitBase, \"/\")\n1461\t+\turlOf := func(repo string) string { return base + \"/\" + repo + \".git\" }\n1462\t+\tg := gitx.New(\"\")\n1463\t+\trepoDir := filepath.Join(paths.ctl, \"repo.git\")\n1464\t+\tif err := g.InitBare(ctx, repoDir); err != nil {\n1465\t+\t\treturn err\n1466\t+\t}\n1467\t+\tfetch := func(sha, ref string) error {\n1468\t+\t\tif err := g.FetchShallow(ctx, repoDir, urlOf(m.Repo), \"+\"+sha+\":\"+ref, tok); err != nil {\n1469\t+\t\t\treturn err\n1470\t+\t\t}\n1471\t+\t\tgot, err := g.RevParse(ctx, repoDir, sha)\n1472\t+\t\tif err != nil {\n1473\t+\t\t\treturn err\n1474\t+\t\t}\n1475\t+\t\tif got != sha {\n1476\t+\t\t\treturn perm(\"fetched %s, want %s\", got, sha)\n1477\t+\t\t}\n1478\t+\t\treturn nil\n1479\t+\t}\n1480\t+\tif err := fetch(m.BaseSHA, \"ref