sha into workTree with git checkout, keeping\n376\t+// symlinks and exec bits. The index and HEAD live in gitDir, so workTree gets\n377\t+// no .git. Unlike ExportTree it has no size cap and accepts symlinks. Hooks\n378\t+// are off.\n379\t+func (g *Git) CheckoutTree(ctx context.Context, gitDir, workTree, sha string) error {\n380\t+\tif err := os.MkdirAll(workTree, 0o777); err != nil {\n381\t+\t\treturn fmt.Errorf(\"gitx: checkout %s: %w\", workTree, err)\n382\t+\t}\n383\t+\tif _, _, err := g.run(ctx, workTree, nil, \"\", nil, \"--git-dir\", gitDir, \"--work-tree\", workTree,\n384\t+\t\t\"checkout\", \"--quiet\", \"--detach\", \"--force\", sha); err != nil {\n385\t+\t\treturn fmt.Errorf(\"gitx: checkout %s: %w\", sha, err)\n386\t+\t}\n387\t+\treturn nil\n388\t+}\n389\tdiff --git a/internal/jobexec/exec.go b/internal/jobexec/exec.go\n390\tnew file mode 100644\n391\tindex 0000000..a097ece\n392\t--- /dev/null\n393\t+++ b/internal/jobexec/exec.go\n394\t@@ -0,0 +1,193 @@\n395\t+// Package jobexec is `ard job-exec`, the agent step of a Kubernetes job pod.\n396\t+// It runs the agent command as a child in its own process group, tees stdout\n397\t+// to a file for the post container, enforces the deadline and writes the done\n398\t+// marker. It reads no credential and no Secret path.\n399\t+package jobexec\n400\t+\n401\t+import (\n402\t+\t\"context\"\n403\t+\t\"errors\"\n404\t+\t\"fmt\"\n405\t+\t\"io\"\n406\t+\t\"io/fs\"\n407\t+\t\"os\"\n408\t+\t\"os/exec\"\n409\t+\t\"os/signal\"\n410\t+\t\"path/filepath\"\n411\t+\t\"strconv\"\n412\t+\t\"time\"\n413\t+\n414\t+\t\"github.com/albertcbrown/ard/internal/cli\"\n415\t+\t\"github.com/albertcbrown/ard/internal/executor/workspace\"\n416\t+\t\"github.com/albertcbrown/ard/internal/jobpod\"\n417\t+)\n418\t+\n419\t+// ExitDeadline is the exit code when the deadline killed the agent.\n420\t+const ExitDeadline = 124\n421\t+\n422\t+// Redirectable for tests.\n423\t+var (\n424\t+\thomeDir           = jobpod.JobHome\n425\t+\tworkDir           = jobpod.MountWork\n426\t+\toutDir            = jobpod.MountOut\n427\t+\tstdout  io.Writer = os.Stdout\n428\t+\tstderr  io.Writer = os.Stderr\n429\t+)\n430\t+\n431\t+// Run runs the agent command and returns its exit status as a cli.ExitError.\n432\t+func Run(ctx context.Context, e *cli.Env, o cli.JobExecOpts) error {\n433\t+\tcode, err := run(ctx, o)\n434\t+\tif err != nil {\n435\t+\t\treturn err\n436\t+\t}\n437\t+\tif code != 0 {\n438\t+\t\treturn &cli.ExitError{Code: code, Err: fmt.Errorf(\"agent exited with status %d\", code)}\n439\t+\t}\n440\t+\treturn nil\n441\t+}\n442\t+\n443\t+func run(ctx context.Context, o cli.JobExecOpts) (int, error) {\n444\t+\tif len(o.Argv) == 0 {\n445\t+\t\treturn 0, &cli.ExitError{Code: 2, Err: errors.New(\"job-exec: no command\")}\n446\t+\t}\n447\t+\tif _, err := workspace.MakeHome(homeDir); err != nil {\n448\t+\t\treturn 0, err\n449\t+\t}\n450\t+\toutFile, err := os.OpenFile(filepath.Join(outDir, jobpod.StdoutName),\n451\t+\t\tos.O_CREATE|os.O_WRONLY|os.O_TRUNC|noFollow, 0o644)\n452\t+\tif err != nil {\n453\t+\t\treturn 0, err\n454\t+\t}\n455\t+\tdefer outFile.Close()\n456\t+\tdevNull, err := os.Open(os.DevNull)\n457\t+\tif err != nil {\n458\t+\t\treturn 0, err\n459\t+\t}\n460\t+\tdefer devNull.Close()\n461\t+\n462\t+\tcmd := exec.Command(o.Argv[0], o.Argv[1:]...)\n463\t+\tsetGroup(cmd)\n464\t+\tcmd.Stdin = devNull\n465\t+\tcmd.Stdout = io.MultiWriter(stdout, outFile)\n466\t+\tcmd.Stderr = stderr\n467\t+\tcmd.WaitDelay = 2 * time.Second\n468\t+\n469\t+\tchld := make(chan os.Signal, 8)\n470\t+\tsignal.Notify(chld, sigChld...)\n471\t+\tdefer signal.Stop(chld)\n472\t+\n473\t+\tcode := 0\n474\t+\tif err := cmd.Start(); err != nil {\n475\t+\t\tfmt.Fprintf(stderr, \"job-exec: %v\\n\", err)\n476\t+\t\tcode = 127\n477\t+\t\tif errors.Is(err, fs.ErrPermission) {\n478\t+\t\t\tcode = 126\n479\t+\t\t}\n480\t+\t\treturn code, finish(outFile, code)\n481\t+\t}\n482\t+\tpid := cmd.Process.Pid\n483\t+\twaitCh := make(chan error, 1)\n484\t+\tgo func() { waitCh <- cmd.Wait() }()\n485\t+\n486\t+\tvar deadline <-chan time.Time\n487\t+\tif !o.Deadline.IsZero() {\n488\t+\t\tt := time.NewTimer(time.Until(o.Deadline))\n489\t+\t\tdefer t.Stop()\n490\t+\t\tdeadline = t.C\n491\t+\t}\n492\t+\tvar kill <-chan time.Time\n493\t+\tctxDone := ctx.Done()\n494\t+\ttimedOut := false\n495\t+\tterminate := func() {\n496\t+\t\tif kill == nil {\n497\t+\t\t\ttermGroup(pid)\n498\t+\t\t\tt := time.NewTimer(o.Grace)\n499\t+\t\t\t// Stopped on return; the timer is only read in this function.\n500\t+\t\t\tkill = t.C\n501\t+\t\t}\n502\t+\t}\n503\t+loop:\n504\t+\tfor {\n505\t+\t\tselect {\n506\t+\t\tcase werr := <-waitCh:\n507\t+\t\t\tcode = exitCode(cmd, werr)\n508\t+\t\t\tbreak loop\n509\t+\t\tcase <-chld:\n510\t+\t\t\treapOrphans(pid)\n511\t+\t\tcase <-deadline:\n512\t+\t\t\tdeadline = nil\n513\t+\t\t\ttimedOut = true\n514\t+\t\t\tterminate()\n515\t+\t\tcase <-ctxDone:\n516\t+\t\t\tctxDone = nil\n517\t+\t\t\tterminate()\n518\t+\t\tcase <-kill:\n519\t+\t\t\tkillGroup(pid)\n520\t+\t\t\tkill = make(chan time.Time) // never fires again\n521\t+\t\t}\n522\t+\t}\n523\t+\tkillGroup(pid)\n524\t+\treapAll()\n525\t+\tif timedOut {\n526\t+\t\tcode = ExitDeadline\n527\t+\t}\n528\t+\treturn code, finish(outFile, code)\n529\t+}\n530\t+\n531\t+func exitCode(cmd *exec.Cmd, werr error) int {\n532\t+\tif ps := cmd.ProcessState; ps != nil {\n533\t+\t\tif c := ps.ExitCode(); c >= 0 {\n534\t+\t\t\treturn c\n535\t+\t\t}\n536\t+\t\treturn 128 + signalNumber(ps)\n537\t+\t}\n538\t+\tif werr != nil {\n539\t+\t\treturn 1\n540\t+\t}\n541\t+\treturn 0\n542\t+}\n543\t+\n544\t+// finish makes the work tree group-readable, syncs stdout and writes the done\n545\t+// marker. The marker comes last: post serves nothing before it exists.\n546\t+func finish(outFile *os.File, code int) error {\n547\t+\tgroupReadable(workDir)\n548\t+\tif err := outFile.Sync(); err != nil {\n549\t+\t\treturn err\n550\t+\t}\n551\t+\tf, err := os.OpenFile(filepath.Join(outDir, jobpod.DoneName),\n552\t+\t\tos.O_CREATE|os.O_WRONLY|os.O_TRUNC|noFollow, 0o644)\n553\t+\tif err != nil {\n554\t+\t\treturn err\n555\t+\t}\n556\t+\tif _, err := f.WriteString(strconv.Itoa(code) + \"\\n\"); err != nil {\n557\t+\t\tf.Close()\n558\t+\t\treturn err\n559\t+\t}\n560\t+\tif err := f.Sync(); err != nil {\n561\t+\t\tf.Close()\n562\t+\t\treturn err\n563\t+\t}\n564\t+\treturn f.Close()\n565\t+}\n566\t+\n567\t+// groupReadable adds g+r to files and g+rx to directories under root, so the\n568\t+// post container, another user in the same group, can read what the agent\n569\t+// wrote. Symlinks are never followed.\n570\t+func groupReadable(root string) {\n571\t+\tfilepath.WalkDir(root, func(p string, d fs.DirEntry, err error) error {\n572\t+\t\tif err != nil || d.Type()&fs.ModeSymlink != 0 {\n573\t+\t\t\treturn nil\n574\t+\t\t}\n575\t+\t\tst, err := d.Info()\n576\t+\t\tif err != nil {\n577\t+\t\t\treturn nil\n578\t+\t\t}\n579\t+\t\tswitch {\n580\t+\t\tcase d.IsDir():\n581\t+\t\t\tos.Chmod(p, st.Mode().Perm()|0o050)\n582\t+\t\tcase st.Mode().IsRegular():\n583\t+\t\t\tos.Chmod(p, st.Mode().Perm()|0o040)\n584\t+\t\t}\n585\t+\t\treturn nil\n586\t+\t})\n587\t+}\n588\tdiff --git a/internal/jobexec/exec_test.go b/internal/jobexec/exec_test.go\n589\tnew file mode 100644\n590\tindex 0000000..e1f96af\n591\t--- /dev/null\n592\t+++ b/internal/jobexec/exec_test.go\n593\t@@ -0,0 +1,240 @@\n594\t+//go:build unix\n595\t+\n596\t+package jobexec\n597\t+\n598\t+import (\n599\t+\t\"bytes\"\n600\t+\t\"context\"\n601\t+\t\"errors\"\n602\t+\t\"fmt\"\n603\t+\t\"os\"\n604\t+\t\"os/exec\"\n605\t+\t\"path/filepath\"\n606\t+\t\"strconv\"\n607\t+\t\"strings\"\n608\t+\t\"syscall\"\n609\t+\t\"testing\"\n610\t+\t\"time\"\n611\t+\n612\t+\t\"github.com/albertcbrown/ard/internal/cli\"\n613\t+\t\"github.com/albertcbrown/ard/internal/jobpod\"\n614\t+)\n615\t+\n616\t+// TestMain turns the test binary into the fake agent when ARD_FAKE_AGENT is set.\n617\t+func TestMain(m *testing.M) {\n618\t+\tif mode := os.Getenv(\"ARD_FAKE_AGENT\"); mode != \"\" {\n619\t+\t\tfakeAgent(mode)\n620\t+\t\treturn\n621\t+\t}\n622\t+\tos.Exit(m.Run())\n623\t+}\n624\t+\n625\t+func fakeAgent(mode string) {\n626\t+\tswitch {\n627\t+\tcase strings.HasPrefix(mode, \"exit:\"):\n628\t+\t\tn, _ := strconv.Atoi(strings.TrimPrefix(mode, \"exit:\"))\n629\t+\t\tfmt.Fprintln(os.Stdout, \"to-stdout\")\n630\t+\t\tfmt.Fprintln(os.Stderr, \"to-stderr\")\n631\t+\t\tos.Exit(n)\n632\t+\tcase mode == \"sleep\":\n633\t+\t\ttime.Sleep(time.Minute)\n634\t+\tcase mode == \"ignoreterm\":\n635\t+\t\tignoreTerm()\n636\t+\t\tfmt.Println(\"ready\")\n637\t+\t\ttime.Sleep(time.Minute)\n638\t+\tcase mode == \"grandchild\":\n639\t+\t\tc := exec.Command(\"sleep\", \"60\")\n640\t+\t\tc.Start()\n641\t+\t\tos.WriteFile(os.Getenv(\"ARD_PIDFILE\"), []byte(strconv.Itoa(c.Process.Pid)), 0o644)\n642\t+\tcase mode == \"perm\":\n643\t+\t\tos.WriteFile(filepath.Join(os.Getenv(\"ARD_WORK\"), \"secret.txt\"), []byte(\"x\"), 0o600)\n644\t+\t\tos.Mkdir(filepath.Join(os.Getenv(\"ARD_WORK\"), \"d\"), 0o700)\n645\t+\t\tos.WriteFile(filepath.Join(os.Getenv(\"ARD_WORK\"), \"d\", \"f\"), []byte(\"x\"), 0o600)\n646\t+\t}\n647\t+\tos.Exit(0)\n648\t+}\n649\t+\n650\t+func ignoreTerm() { signalIgnore(syscall.SIGTERM) }\n651\t+\n652\t+type env struct {\n653\t+\twork, out, home string\n654\t+\tstdout, stderr  *bytes.Buffer\n655\t+}\n656\t+\n657\t+func setup(t *testing.T, mode string) *env {\n658\t+\tt.Helper()\n659\t+\troot := t.TempDir()\n660\t+\te := &env{work: filepath.Join(root, \"work\"), out: filepath.Join(root, \"out\"), home: filepath.Join(root, \"job\", \"home\"),\n661\t+\t\tstdout: &bytes.Buffer{}, stderr: &bytes.Buffer{}}\n662\t+\tfor _, d := range []string{e.work, e.out, filepath.Dir(e.home)} {\n663\t+\t\tos.MkdirAll(d, 0o755)\n664\t+\t}\n665\t+\thomeDir, workDir, outDir, stdout, stderr = e.home, e.work, e.out, e.stdout, e.stderr\n666\t+\tt.Cleanup(func() {\n667\t+\t\thomeDir, workDir, outDir = jobpod.JobHome, jobpod.MountWork, jobpod.MountOut\n668\t