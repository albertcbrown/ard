{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FczzRgyg1C77UpDLqnEtFy","type":"tool_result","content":"package pool\n\nimport \"time\"\n\n// Slot is a granted reservation, held from Offer until Release.\ntype Slot struct {\n\tpool      *Pool\n\tcand      Candidate\n\tjobID     string\n\tgrantedAt time.Time\n\treleased  bool\n\tadopted   bool\n}\n\n// Key returns the job key.\nfunc (s *Slot) Key() string { return s.cand.Key() }\n\n// Candidate returns the candidate the slot was granted to.\nfunc (s *Slot) Candidate() Candidate { return s.cand }\n\n// Adopted reports whether the slot was built from a job that was already\n// running when the pool was created (restart recovery), so no goroutine of\n// this process drives it. The Reaper closes such a job out itself.\nfunc (s *Slot) Adopted() bool { return s.adopted }\n\n// JobID returns the id set by SetJobID, or \"\".\nfunc (s *Slot) JobID() string {\n\ts.pool.mu.Lock()\n\tdefer s.pool.mu.Unlock()\n\treturn s.jobID\n}\n\n// SetJobID records the job's ULID once the loop has minted it. It is used\n// for logs and Stats only.\nfunc (s *Slot) SetJobID(id string) {\n\ts.pool.mu.Lock()\n\tdefer s.pool.mu.Unlock()\n\ts.jobID = id\n}\n\n// Release frees the slot. It returns true on the first call and false after,\n// so a stale handle never frees a slot re-granted under the same key. Safe\n// from any goroutine.\nfunc (s *Slot) Release() bool {\n\tp := s.pool\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\tif s.released {\n\t\treturn false\n\t}\n\ts.released = true\n\tif p.held[s.Key()] == s {\n\t\tdelete(p.held, s.Key())\n\t}\n\tp.log.Debug(\"pool.release\", \"key\", s.Key(), \"class\", s.cand.Class.String(),\n\t\t\"role\", s.cand.Role, \"number\", s.cand.Number, \"job_id\", s.jobID)\n\treturn true\n}\npackage pool\n\nimport \"time\"\n\n// loopDemand is one loop's candidates last denied for lack of a slot. It is a\n// reservation hint only: a loop that has not offered reserves nothing.\ntype loopDemand struct {\n\texpires time.Time\n\tcands   map[string]Candidate\n}\n\ntype waiting struct {\n\tcount  int\n\toldest time.Duration\n}\n\n// purgeLocked drops expired demand entries and their first-denied records.\nfunc (p *Pool) purgeLocked(now time.Time) {\n\tfor loop, d := range p.demand {\n\t\tif !now.Before(d.expires) {\n\t\t\tfor k := range d.cands {\n\t\t\t\tdelete(p.firstDenied, k)\n\t\t\t}\n\t\t\tdelete(p.demand, loop)\n\t\t}\n\t}\n}\n\n// foreignLocked returns other loops' live demand that is still worth\n// reserving: not held now, not in the current batch, and (for triage) whose\n// issue has no held triage job.\nfunc (p *Pool) foreignLocked(loop string, now time.Time, batch map[string]bool, triageHeld map[int]bool) []Candidate {\n\tvar out []Candidate\n\tfor l, d := range p.demand {\n\t\tif l == loop || !now.Before(d.expires) {\n\t\t\tcontinue\n\t\t}\n\t\tfor k, c := range d.cands {\n\t\t\tif p.held[k] != nil || batch[k] {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif c.Class == ClassTriage && triageHeld[c.Number] {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tout = append(out, c)\n\t\t}\n\t}\n\t// Only one triage job per issue can run, so only the best-ranked waiting\n\t// triage candidate on an issue reserves a slot.\n\tbest := map[int]Candidate{}\n\tfor _, c := range out {\n\t\tif c.Class == ClassTriage {\n\t\t\tif b, ok := best[c.Number]; !ok || less(c, b) {\n\t\t\t\tbest[c.Number] = c\n\t\t\t}\n\t\t}\n\t}\n\tkept := out[:0]\n\tfor _, c := range out {\n\t\tif c.Class == ClassTriage && best[c.Number] != c {\n\t\t\tcontinue\n\t\t}\n\t\tkept = append(kept, c)\n\t}\n\treturn kept\n}\n\n// setDemandLocked replaces loop's demand entry with denied (empty clears it).\nfunc (p *Pool) setDemandLocked(loop string, now time.Time, ttl time.Duration, denied []Candidate) {\n\told := p.demand[loop]\n\tdelete(p.demand, loop)\n\td := &loopDemand{expires: now.Add(ttl), cands: map[string]Candidate{}}\n\tif ttl > 0 {\n\t\tfor _, c := range denied {\n\t\t\td.cands[c.Key()] = c\n\t\t}\n\t}\n\t// Keys that stay keep their first-denied time; keys that dropped out lose it.\n\tif old != nil {\n\t\tfor k := range old.cands {\n\t\t\tif _, ok := d.cands[k]; !ok {\n\t\t\t\tdelete(p.firstDenied, k)\n\t\t\t}\n\t\t}\n\t}\n\tif len(d.cands) == 0 {\n\t\treturn\n\t}\n\tfor k := range d.cands {\n\t\tif _, ok := p.firstDenied[k]; !ok {\n\t\t\tp.firstDenied[k] = now\n\t\t}\n\t}\n\tp.demand[loop] = d\n}\n\n// waitingLocked summarises live demand per class.\nfunc (p *Pool) waitingLocked(now time.Time) map[Class]waiting {\n\tout := map[Class]waiting{}\n\tfor _, d := range p.demand {\n\t\tif !now.Before(d.expires) {\n\t\t\tcontinue\n\t\t}\n\t\tfor k, c := range d.cands {\n\t\t\tw := out[c.Class]\n\t\t\tw.count++\n\t\t\tif t, ok := p.firstDenied[k]; ok && now.Sub(t) > w.oldest {\n\t\t\t\tw.oldest = now.Sub(t)\n\t\t\t}\n\t\t\tout[c.Class] = w\n\t\t}\n\t}\n\treturn out\n}\n\n// checkStarvationLocked logs one pool.starved warning when a class's oldest\n// wait first crosses StarveAfter. It re-arms once the class has no waiting\n// demand (a grant also clears the flag in Offer).\nfunc (p *Pool) checkStarvationLocked(now time.Time) {\n\tw := p.waitingLocked(now)\n\tfor c := ClassReview; c <= ClassScanner; c++ {\n\t\tws, ok := w[c]\n\t\tif !ok {\n\t\t\tp.starved[c] = false\n\t\t\tcontinue\n\t\t}\n\t\tif ws.oldest >= p.starveAfter && !p.starved[c] {\n\t\t\tp.starved[c] = true\n\t\t\tp.log.Warn(\"pool.starved\", \"class\", c.String(), \"waiting\", ws.count, \"oldest_wait\", ws.oldest.String())\n\t\t}\n\t}\n}\ninternal/controller:\ncontroller.go\ndoc.go\nhelpers_test.go\ninflight.go\nlock_other.go\nlock_unix.go\nlock_unix_test.go\nloop.go\npause.go\npause_test.go\npausefile_test.go\nscheduler.go\nscheduler_test.go\nshutdown_test.go\nstatus.go\nstatus_test.go\n\ninternal/pool:\ncandidate.go\nclass.go\ndemand.go\npool.go\npool_test.go\nslot.go\nstats.go\n      52 internal/pool/candidate.go\n      49 internal/pool/class.go\n     132 internal/pool/demand.go\n     251 internal/pool/pool.go\n  