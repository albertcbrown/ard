{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BPKkjwM1nPNoF9rahet6L8","type":"tool_result","content":"package pool\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"io\"\n\t\"log/slog\"\n\t\"sort\"\n\t\"sync\"\n\t\"time\"\n)\n\n// Verdict is the pool's answer for one candidate.\ntype Verdict int\n\n// Verdicts. Anything other than Granted means the loop touches no label and\n// writes no state; the candidate is offered again next tick.\nconst (\n\tGranted         Verdict = iota\n\tDeniedFull              // no slot was free for it, and no other loop reserved one\n\tDeniedOutranked         // higher-ranked live demand from another loop reserved the free slots\n\tDeniedIssueBusy         // triage only: a triage job on the same issue is held or granted earlier in the batch\n\tDeniedDuplicate         // same key already held, or earlier in this batch\n\tDeniedInvalid           // malformed candidate (caller bug)\n\tDeniedLimited           // its account or model family is out of quota until a reset time\n\tDeniedBudget            // a daily dollar or token cap is reached\n)\n\nvar verdictNames = [...]string{\"granted\", \"full\", \"outranked\", \"issue-busy\", \"duplicate\", \"invalid\", \"limited\", \"budget\"}\n\n// String returns the verdict's log name.\nfunc (v Verdict) String() string {\n\tif v >= 0 && int(v) < len(verdictNames) {\n\t\treturn verdictNames[v]\n\t}\n\treturn fmt.Sprintf(\"verdict(%d)\", int(v))\n}\n\n// Decision is the result for one offered candidate.\ntype Decision struct {\n\tCandidate Candidate\n\tVerdict   Verdict\n\tSlot      *Slot  // non-nil if and only if Verdict == Granted\n\tReason    string // human-readable, for logs and the status issue\n}\n\n// Held is a job already running when the pool is built (restart recovery).\ntype Held struct {\n\tCandidate Candidate\n\tJobID     string\n}\n\n// Options configures New.\ntype Options struct {\n\tMax         int              // cfg.MaxPods; values < 1 are treated as 1\n\tNow         func() time.Time // nil means time.Now\n\tLog         *slog.Logger     // nil means discard\n\tHeld        []Held           // running jobs from state; held even if they exceed Max\n\tStarveAfter time.Duration    // 0 means 24h\n\t// Limited reports when a candidate may next start because its account or\n\t// model family is out of quota: zero or a past time means it may start\n\t// now. nil disables the check. A limited candidate takes no slot and\n\t// reserves no demand: it does not hold lower classes back.\n\tLimited func(c Candidate) time.Time\n\t// Budget reports whether a daily dollar or token cap forbids starting c, with the\n\t// reason. nil disables the check. A refused candidate takes no slot and\n\t// reserves no demand; a job already held is never affected.\n\tBudget func(c Candidate) (denied bool, reason string)\n}\n\n// Pool is the in-memory slot arbiter. One mutex guards all state; there are\n// no goroutines or timers, and demand expiry is evaluated lazily.\ntype Pool struct {\n\tmu          sync.Mutex\n\tmax         int\n\tnow         func() time.Time\n\tlog         *slog.Logger\n\tstarveAfter time.Duration\n\tlimited     func(c Candidate) time.Time\n\tbudget      func(c Candidate) (bool, string)\n\theld        map[string]*Slot\n\tdemand      map[string]*loopDemand\n\tfirstDenied map[string]time.Time\n\tstarved     map[Class]bool\n}\n\n// New builds a pool, adopting o.Held.\nfunc New(o Options) *Pool {\n\tp := &Pool{\n\t\tmax:         max(1, o.Max),\n\t\tnow:         o.Now,\n\t\tlog:         o.Log,\n\t\tstarveAfter: o.StarveAfter,\n\t\tlimited:     o.Limited,\n\t\tbudget:      o.Budget,\n\t\theld:        map[string]*Slot{},\n\t\tdemand:      map[string]*loopDemand{},\n\t\tfirstDenied: map[string]time.Time{},\n\t\tstarved:     map[Class]bool{},\n\t}\n\tif p.now == nil {\n\t\tp.now = time.Now\n\t}\n\tif p.log == nil {\n\t\tp.log = slog.New(slog.NewTextHandler(io.Discard, nil))\n\t}\n\tif p.starveAfter == 0 {\n\t\tp.starveAfter = 24 * time.Hour\n\t}\n\tfor _, h := range o.Held {\n\t\tk := h.Candidate.Key()\n\t\tif p.held[k] != nil {\n\t\t\tp.log.Warn(\"pool.adopt_duplicate\", \"key\", k, \"job_id\", h.JobID)\n\t\t\tcontinue\n\t\t}\n\t\tp.held[k] = &Slot{pool: p, cand: h.Candidate, jobID: h.JobID, grantedAt: p.now(), adopted: true}\n\t}\n\tif len(p.held) > p.max {\n\t\tp.log.Warn(\"pool.adopt_over_max\", \"held\", len(p.held), \"max\", p.max)\n\t}\n\treturn p\n}\n\n// SetMax changes the cap. It never revokes held slots; n < 1 is treated as 1.\nfunc (p *Pool) SetMax(n int) {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\tp.max = max(1, n)\n}\n\n// Lookup returns the held slot for key, for close-out and the Reaper after a restart.\nfunc (p *Pool) Lookup(key string) (*Slot, bool) {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\ts, ok := p.held[key]\n\treturn s, ok\n}\n\ntype item struct {\n\tcand Candidate\n\tidx  int // index into decisions; -1 for foreign demand\n}\n\n// Offer ranks cands against held slots and other loops' live demand and\n// returns one Decision per candidate, in input order. It replaces loop's\n// demand entry, which expires ttl after this call (ttl <= 0 records none).\n// Loops must call Offer once per tick even with no candidates, so stale\n// demand clears.\nfunc (p *Pool) Offer(loop string, ttl time.Duration, cands []Candidate) []Decision {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\tnow := p.now()\n\tp.purgeLocked(now)\n\n\tfree0 := max(0, p.max-len(p.held))\n\tfree := free0\n\tdecisions := make([]Decision, len(cands))\n\ttriageHeld := map[int]bool{}\n\tfor _, s := range p.held {\n\t\tif s.cand.Class == ClassTriage {\n\t\t\ttriageHeld[s.cand.Number] = true\n\t\t}\n\t}\n\n\t// Validation and duplicates.\n\tinBatch := map[string]bool{}\n\tvar items []item\n\tfor i, c := range cands {\n\t\tdecisions[i].Candidate = c\n\t\tif why := c.invalid(); why != \"\" {\n\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedInvalid, why\n\t\t\tp.log.Warn(\"pool.invalid\", \"loop\", loop, \"class\", c.Class.String(), \"role\", c.Role, \"number\", c.Number, \"reason\", why)\n\t\t\tcontinue\n\t\t}\n\t\tk := c.Key()\n\t\tif p.held[k] != nil || inBatch[k] {\n\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedDuplicate, \"already held or offered earlier in this batch\"\n\t\t\tcontinue\n\t\t}\n\t\tif p.limited != nil {\n\t\t\tif until := p.limited(c); now.Before(until) {\n\t\t\t\tdecisions[i].Verdict = DeniedLimited\n\t\t\t\tdecisions[i].Reason = \"usage limit until \" + until.UTC().Format(\"15:04\") + \" UTC\"\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tif p.budget != nil {\n\t\t\tif denied, why := p.budget(c); denied {\n\t\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedBudget, why\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tinBatch[k] = true\n\t\titems = append(items, item{c, i})\n\t}\n\tfor _, c := range p.foreignLocked(loop, now, inBatch, triageHeld) {\n\t\titems = append(items, item{c, -1})\n\t}\n\tsort.Slice(items, func(a, b int) bool { return less(items[a].cand, items[b].cand) })\n\n\t// Walk the merged ranking.\n\treserved := 0\n\ttriageGranted := map[int]bool{}\n\tvar denied []Candidate\n\tcapDenied := 0\n\tfor _, it := range items {\n\t\tif it.idx < 0 {\n\t\t\tif free > 0 {\n\t\t\t\tfree--\n\t\t\t\treserved++\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\td := &decisions[it.idx]\n\t\tc := it.cand\n\t\tswitch {\n\t\tcase c.Class == ClassTriage && (triageHeld[c.Number] || triageGranted[c.Number]):\n\t\t\td.Verdict, d.Reason = DeniedIssueBusy, fmt.Sprintf(\"a triage job on #%d is already held\", c.Number)\n\t\tcase free > 0:\n\t\t\tfree--\n\t\t\ts := &Slot{pool: p, cand: c, grantedAt: now}\n\t\t\tp.held[c.Key()] = s\n\t\t\tif c.Class == ClassTriage {\n\t\t\t\ttriageGranted[c.Number] = true\n\t\t\t}\n\t\t\tdelete(p.firstDenied, c.Key())\n\t\t\tp.starved[c.Class] = false\n\t\t\td.Verdict, d.Slot = Granted, s\n\t\t\tp.log.Debug(\"pool.grant\", \"loop\", loop, \"key\", c.Key(), \"class\", c.Class.String(), \"role\", c.Role, \"number\", c.Number)\n\t\tcase capDenied < reserved:\n\t\t\tcapDenied++\n\t\t\td.Verdict, d.Reason = DeniedOutranked, fmt.Sprintf(\"outranked by %d higher-ranked waiting job(s)\", reserved)\n\t\t\tdenied = append(denied, c)\n\t\tdefault:\n\t\t\tcapDenied++\n\t\t\td.Verdict, d.Reason = DeniedFull, \"no free slot\"\n\t\t\tdenied = append(denied, c)\n\t\t}\n\t}\n\tp.setDemandLocked(loop, now, ttl, denied)\n\tp.checkStarvationLocked(now)\n\n\tif p.log.Enabled(context.Background(), slog.LevelDebug) {\n\t\tcounts := map[string]int{}\n\t\tfor _, d := range decisions {\n\t\t\tcounts[d.Verdict.String()]++\n\t\t}\n\t\tp.log.Debug(\"pool.offer\", \"loop\", loop, \"verdicts\", fmt.Sprint(counts), \"free_before\", free0, \"free_after\", max(0, p.max-len(p.held)))\n\t}\n\treturn decisions\n}\npackage controller\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"math/rand/v2\"\n\t\"sort\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n)\n\n// DefaultGrace is how long shutdown waits for ticks and in-flight work.\nconst DefaultGrace = 2 * time.Minute\n\n// abandonWait is how long Run waits for goroutines to notice the cancelled\n// work context after the grace period expires or Force closes.\nconst abandonWait = 5 * time.Second\n\n// Hook is a named startup step run before any loop starts.\ntype Hook struct {\n\tName string\n\tFn   func(ctx context.Context) error\n}\n\n// Deps are the controller's collaborators.\ntype Deps struct {\n\tLog *slog.Logger\n\t// Config is called before every tick for a fresh snapshot, and once at\n\t// startup. An error counts as paused (fail closed): claiming loops are\n\t// skipped, and when no config has ever loaded no loop runs until one does.\n\tConfig func(ctx context.Context) (*config.Resolved, error)\n\tPause  Pauser\n\t// Startup hooks run in order before any loop starts; any error aborts Run.\n\tStartup []Hook\n\t// Grace is the shutdown wait; 0 means DefaultGrace.\n\tGrace time.Duration\n\t// Force is closed on a second signal; it abandons the grace wait.\n\tForce <-chan struct{}\n\t// Wake, when non-nil, makes every loop run one tick now for each receive\n\t// (still behind the kill switch and the pool). Pending wakes coalesce.\n\tWake <-chan struct{}\n\t// Rand returns a value in [0,1); nil means math/rand/v2.Float64.\n\tRand func() float64\n}\n\n// Controller schedules loops.\ntype Controller struct {\n\tdeps  Deps\n\tloops []Loop\n\n\tinflight *Inflight // set by Run\n\n\tmu     sync.Mutex\n\tactive map[string]bool\n}\n\n// New validates deps and loop names. It returns an error for a nil Log,\n// Config or Pause, or an empty or duplicate loop name.\nfunc New(d Deps, loops ...Loop) (*Controller, error) {\n\tswitch {\n\tcase d.Log == nil:\n\t\treturn nil, errors.New(\"controller: nil Log\")\n\tcase d.Config == nil:\n\t\treturn nil, errors.New(\"controller: nil Config\")\n\tcase d.Pause == nil:\n\t\treturn nil, errors.New(\"controller: nil Pause\")\n\t}\n\tseen := map[string]bool{}\n\tfor _, l := range loops {\n\t\tn := l.Name()\n\t\tif n == \"\" {\n\t\t\treturn nil, errors.New(\"controller: loop with empty name\")\n\t\t}\n\t\tif seen[n] {\n\t\t\treturn nil, fmt.Errorf(\"controller: duplicate loop name %q\", n)\n\t\t}\n\t\tseen[n] = true\n\t}\n\treturn &Controller{deps: d, loops: loops, active: map[string]bool{}}, nil\n}\n\nfunc (c *Controller) rand() float64 {\n\tif c.deps.Rand != nil {\n\t\treturn c.deps.Rand()\n\t}\n\treturn rand.Float64()\n}\n\nfunc (c *Controller) setActive(name string, on bool) {\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\tif on {\n\t\tc.active[name] = true\n\t} else {\n\t\tdelete(c.active, name)\n\t}\n}\n\nfunc (c *Controller) activeTicks() []string {\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\tvar out []string\n\tfor n := range c.active {\n\t\tout = append(out, \"tick:\"+n)\n\t}\n\tsort.Strings(out)\n\treturn out\n}\n\n// Run runs startup hooks, then every loop, and blocks until ctx is done and\n// shutdown completes. A clean drain returns nil. When the grace period ends\n// or Force closes, work contexts are cancelled and Run returns an error\n// naming what was abandoned.\nfunc (c *Controller) Run(ctx context.Context) error {\n\tlog := c.deps.Log\n\tfor _, h := range c.deps.Startup {\n\t\tstart := time.Now()\n\t\tif err := h.Fn(ctx); err != nil {\n\t\t\treturn fmt.Errorf(\"startup %s: %w\", h.Name, err)\n\t\t}\n\t\tlog.Info(\"controller.hook\", \"name\", h.Name, \"duration\", time.Since(start).String())\n\t}\n\t// A config that cannot be loaded does not abort startup: the controller\n\t// starts paused, with no config, and retries on every tick.\n\tlctx, cancelLoad := context.WithTimeout(ctx, configTimeout)\n\tcfg, err := c.deps.Config(lctx)\n\tcancelLoad()\n\tif err != nil {\n\t\tlog.Error(\"config.initial_failed\", \"error\", err)\n\t\tcfg = nil\n\t}\n\n\t// Work contexts outlive the first signal; only grace expiry or Force\n\t// cancels them.\n\tworkCtx, cancelWork := context.WithCancel(context.WithoutCancel(ctx))\n\tdefer cancelWork()\n\tc.inflight = NewInflight(workCtx, log)\n\tstopping := make(chan struct{})\n\n\tnames := make([]string, len(c.loops))\n\tvar wg sync.WaitGroup\n\tvar runners []*runner\n\tfor i, l := range c.loops {\n\t\tnames[i] = l.Name()\n\t\tr := &runner{c: c, loop: l, log: log.With(\"loop\", l.Name()), cfg: cfg, cfgBroken: err != nil, wake: make(chan struct{}, 1)}\n\t\trunners = append(runners, r)\n\t\twg.Add(1)\n\t\tgo func() {\n\t\t\tdefer wg.Done()\n\t\t\tr.run(workCtx, stopping)\n\t\t}()\n\t}\n\tlog.Info(\"controller.start\", \"loops\", names)\n\tif c.deps.Wake != nil {\n\t\twg.Add(1)\n\t\tgo func() {\n\t\t\tdefer wg.Done()\n\t\t\tfor {\n\t\t\t\tselect {\n\t\t\t\tcase <-stopping:\n\t\t\t\t\treturn\n\t\t\t\tcase <-c.deps.Wake:\n\t\t\t\t\tselect { // a wake racing shutdown starts nothing\n\t\t\t\t\tcase <-stopping:\n\t\t\t\t\t\treturn\n\t\t\t\t\tdefault:\n\t\t\t\t\t}\n\t\t\t\t\tlog.Info(\"controller.wake\", \"loops\", names)\n\t\t\t\t\tfor _, r := range runners {\n\t\t\t\t\t\tselect {\n\t\t\t\t\t\tcase r.wake <- struct{}{}:\n\t\t\t\t\t\tdefault: // one already pending\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}()\n\t}\n\n\t<-ctx.Done()\n\tlog.Info(\"controller.stopping\")\n\tclose(stopping)\n\n\tgrace := c.deps.Grace\n\tif grace == 0 {\n\t\tgrace = DefaultGrace\n\t}\n\ttimer := time.NewTimer(grace)\n\tdefer timer.Stop()\n\n\tdrained := make(chan struct{})\n\tgo func() {\n\t\twg.Wait() // every in-progress tick has returned\n\t\tc.inflight.close()\n\t\t<-c.inflight.Wait()\n\t\tclose(drained)\n\t}()\n\n\tvar result error\n\tselect {\n\tcase <-drained:\n\tcase <-timer.C:\n\t\tabandoned := append(c.activeTicks(), c.inflight.Pending()...)\n\t\tresult = fmt.Errorf(\"shutdown grace %s exceeded; abandoned: %s\", grace, strings.Join(abandoned, \", \"))\n\t\tc.abandon(cancelWork, drained)\n\tcase <-c.deps.Force:\n\t\tresult = errors.New(\"forced shutdown\")\n\t\tc.abandon(cancelWork, drained)\n\t}\n\tlog.Info(\"controller.stopped\", \"clean\", result == nil)\n\treturn result\n}\n\n// abandon cancels the work context and gives goroutines a moment to return.\nfunc (c *Controller) abandon(cancel context.CancelFunc, drained <-chan struct{}) {\n\tcancel()\n\tt := time.NewTimer(abandonWait)\n\tdefer t.Stop()\n\tselect {\n\tcase <-drained:\n\tcase <-t.C:\n\t}\n}\npackage controller\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"runtime/debug\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n)\n\nconst (\n\tbackoffAfter = 3 // consecutive errors before backoff starts\n\tbackoffCap   = 15 * time.Minute\n\n\t// configTimeout bounds one config load, which fetches from the remote.\n\tconfigTimeout = 2 * time.Minute\n)\n\n// runner drives one Loop. Ticks of one loop never overlap and a slow tick\n// never queues a second one; different loops run concurrently.\ntype runner struct {\n\tc    *Controller\n\tloop Loop\n\tlog  *slog.Logger\n\n\tcfg       *config.Resolved // last good config; nil until one has loaded\n\tcfgBroken bool             // last reload failed\n\tpaused    PauseState       // last pause state, for transition logs\n\tclamped   bool\n\tn         int // tick counter\n\terrs      int // consecutive tick errors\n\twake      chan struct{}\n}\n\n// jitter maps r in [0,1) to a factor in [0.9, 1.1).\nfunc jitter(r float64) float64 { return 0.9 + 0.2*r }\n\n// interval returns the loop's interval clamped to MinInterval.\nfunc (r *runner) interval() time.Duration {\n\tif r.cfg == nil { // no config yet: retry at the floor\n\t\treturn MinInterval\n\t}\n\td := r.loop.Interval(r.cfg)\n\tif d < MinInterval {\n\t\tif !r.clamped {\n\t\t\tr.clamped = true\n\t\t\tr.log.Warn(\"loop.interval_clamped\", \"requested\", d.String(), \"using\", MinInterval.String())\n\t\t}\n\t\treturn MinInterval\n\t}\n\treturn d\n}\n\n// run is the loop goroutine. It returns when stopping is closed.\nfunc (r *runner) run(workCtx context.Context, stopping <-chan struct{}) {\n\twait := time.Duration(r.c.rand() * 0.1 * float64(r.interval()))\n\tfor {\n\t\tt := time.NewTimer(wait)\n\t\tselect {\n\t\tcase <-stopping:\n\t\t\tt.Stop()\n\t\t\treturn\n\t\tcase <-t.C:\n\t\tcase <-r.wake:\n\t\t\tt.Stop()\n\t\t}\n\t\tselect { // a tick must not start once shutdown has begun\n\t\tcase <-stopping:\n\t\t\treturn\n\t\tdefault:\n\t\t}\n\t\twait = r.tick(workCtx, stopping)\n\t}\n}\n\n// tick runs one poll and returns how long to wait before the next one.\nfunc (r *runner) tick(workCtx context.Context, stopping <-chan struct{}) time.Duration {\n\tr.n++\n\tlog := r.log.With(\"tick\", r.n)\n\tr.reload(workCtx, log)\n\n\tif r.cfg == nil { // never loaded: nothing can run, and claiming loops are paused\n\t\tif r.loop.Claims() {\n\t\t\tr.transition(log, PauseState{Paused: true, Reason: ReasonConfigInvalid})\n\t\t}\n\t\treturn r.nextWait(nil)\n\t}\n\n\tif r.loop.Claims() {\n\t\tst := r.c.deps.Pause.Check(workCtx, r.cfg)\n\t\tif r.cfgBroken {\n\t\t\tst = PauseState{Paused: true, Reason: ReasonConfigInvalid}\n\t\t}\n\t\tr.transition(log, st)\n\t\tif st.Paused {\n\t\t\treturn r.nextWait(nil)\n\t\t}\n\t}\n\n\tinterval := r.interval()\n\ttimeout := interval\n\tif tt, ok := r.loop.(TickTimeouter); ok {\n\t\tif d := tt.TickTimeout(r.cfg); d > 0 {\n\t\t\ttimeout = max(d, time.Second)\n\t\t}\n\t}\n\tctx, cancel := context.WithTimeout(workCtx, timeout)\n\tdefer cancel()\n\n\tr.c.setActive(r.loop.Name(), true)\n\tstart := time.Now()\n\terr := r.safeTick(ctx, Env{Log: log, Cfg: r.cfg, Inflight: r.c.inflight, Stopping: stopping})\n\tr.c.setActive(r.loop.Name(), false)\n\tlog.Debug(\"loop.tick\", \"duration\", time.Since(start).String())\n\n\tif err != nil {\n\t\tr.errs++\n\t\tlog.Error(\"loop.error\", \"error\", err, \"consecutive\", r.errs)\n\t} else {\n\t\tr.errs = 0\n\t}\n\treturn r.nextWait(err)\n}\n\n// reload refreshes the config snapshot, keeping the last good one on error.\nfunc (r *runner) reload(ctx context.Context, log *slog.Logger) {\n\tctx, cancel := context.WithTimeout(ctx, configTimeout)\n\tdefer cancel()\n\tcfg, err := r.c.deps.Config(ctx)\n\tswitch {\n\tcase err != nil:\n\t\tif !r.cfgBroken {\n\t\t\tlog.Error(\"config.reload_failed\", \"error\", err)\n\t\t}\n\t\tr.cfgBroken = true\n\tdefault:\n\t\tif r.cfgBroken {\n\t\t\tlog.Info(\"config.reloaded\")\n\t\t}\n\t\tr.cfgBroken = false\n\t\tr.cfg = cfg\n\t}\n}\n\n// transition logs pause state changes, once per change rather than per tick.\nfunc (r *runner) transition(log *slog.Logger, st PauseState) {\n\tswitch {\n\tcase st.Paused && (!r.paused.Paused || r.paused.Reason != st.Reason):\n\t\tlog.Info(\"loop.paused\", \"reason\", string(st.Reason))\n\tcase !st.Paused && r.paused.Paused:\n\t\tlog.Info(\"loop.resumed\")\n\t}\n\tr.paused = st\n}\n\n// safeTick turns a panic into an error carrying the stack.\nfunc (r *runner) safeTick(ctx context.Context, env Env) (err error) {\n\tdefer func() {\n\t\tif p := recover(); p != nil {\n\t\t\terr = fmt.Errorf(\"panic in %s tick: %v\\n%s\", r.loop.Name(), p, debug.Stack())\n\t\t}\n\t}()\n\treturn r.loop.Tick(ctx, env)\n}\n\n// nextWait is the interval with jitter, or the backed-off interval after\n// backoffAfter consecutive errors, or at least until a rate limit resets.\nfunc (r *runner) nextWait(err error) time.Duration {\n\tinterval := r.interval()\n\tbase := interval\n\tif r.errs >= backoffAfter {\n\t\tlimit := max(interval, backoffCap)\n\t\tbase = interval\n\t\tfor i := 0; i < r.errs-backoffAfter+1 && base < limit; i++ {\n\t\t\tbase = min(base*2, limit)\n\t\t}\n\t}\n\twait := time.Duration(float64(base) * jitter(r.c.rand()))\n\tvar rl *github.RateLimitError\n\tif errors.As(err, &rl) && !rl.ResetAt.IsZero() {\n\t\twait = max(wait, time.Until(rl.ResetAt))\n\t}\n\treturn wait\n}\npackage controller\n\nimport (\n\t\"context\"\n\t\"log/slog\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n)\n\nconst (\n\t// ReaperInterval is how often the Reaper runs. The proposal fixes it at\n\t// one minute; it is not configurable.\n\tReaperInterval = time.Minute\n\t// MinInterval is the scheduler floor for any Interval result.\n\tMinInterval = time.Minute\n)\n\n// Loop is one polling loop. The controller owns scheduling, jitter, backoff,\n// the kill switch and shutdown; a Loop only does one poll per Tick.\ntype Loop interface {\n\t// Name is unique across loops: \"scanners\", \"triage\", \"workers\",\n\t// \"reviewers\", \"merger\", \"reaper\", ...\n\tName() string\n\t// Interval is read before every wait, so reloaded config applies.\n\tInterval(cfg *config.Resolved) time.Duration\n\t// Claims reports whether the loop starts work or writes to GitHub (claims,\n\t// scanner filing and autoclose, stale closes, merges); such loops are\n\t// skipped while the controller is paused. The Reaper and the costs loop (bookkeeping about work already done) return false.\n\tClaims() bool\n\t// Tick runs one poll. It must return promptly once ctx is done.\n\tTick(ctx context.Context, env Env) error\n}\n\n// TickTimeouter is optionally implemented by a Loop that needs a per-tick\n// deadline other than its interval (for example a scanner whose 4h interval\n// is much longer than a sane run). The result is clamped to at least one\n// second; a result <= 0 means the default, the loop's interval.\ntype TickTimeouter interface {\n\tTickTimeout(cfg *config.Resolved) time.Duration\n}\n\n// Env is what the controller passes to one Tick.\ntype Env struct {\n\tLog      *slog.Logger     // tagged loop=<name> tick=<n>\n\tCfg      *config.Resolved // snapshot for this tick; read-only\n\tInflight *Inflight\n\t// Stopping is closed when shutdown begins; long ticks may stop early.\n\tStopping <-chan struct{}\n}\n(eval):1: no matches found: --include=*.go\n303:**One pool of job slots, drained from the end.** At most `max_pods` jobs (default 3) run at once, shared by every loop. When a slot frees, the controller fills it in this order: reviewers, then workers, then triage, then scanners, oldest first within each. Finishing work in flight beats starting new work, so a busy day grows the scanner backlog, not the pile of half-done PRs. The merger and the Reaper are controller code and take no slot. Slots are granted when a loop polls and nothing is queued: a loop that found work waiting within the last two of its intervals has that demand reserved ahead of lower classes, so a freed slot can sit idle until that loop's next poll. A scanner run that gets no slot is skipped, not queued. The pool also starts no agent job for an exhausted account or model family until its reset: a job that stops at a subscription usage limit records the limit (in the controller database, so a restart keeps it), and the pool answers `limited` to any candidate whose role runs on that account or family (a whole-account session or weekly limit blocks every role; an Opus or Sonnet limit blocks only roles on that family, and a role with no model, which runs the CLI default, is blocked by any limit). A limited candidate takes no slot and reserves no demand, so lower classes are not held back. The block ends at the reset time the CLI reported; when it reported none the first pause is 30 minutes and each further stop with no reset doubles it up to 4 hours, starting over once a job succeeds; a reset time further away than 8 days is clamped. Running jobs are never killed for a limit. Deterministic scanners and the merger use no model and are unaffected. A daily dollar cap works the same way at the same gate: the pool answers `budget` to a candidate whose role cap or the repo cap is reached, and that candidate takes no slot and reserves no demand. A job that already holds a slot keeps it and finishes.\npackage controller\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"log/slog\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n)\n\n// logBuf is a goroutine-safe slog destination.\ntype logBuf struct {\n\tmu sync.Mutex\n\tb  bytes.Buffer\n}\n\nfunc (l *logBuf) Write(p []byte) (int, error) {\n\tl.mu.Lock()\n\tdefer l.mu.Unlock()\n\treturn l.b.Write(p)\n}\n\nfunc (l *logBuf) String() string {\n\tl.mu.Lock()\n\tdefer l.mu.Unlock()\n\treturn l.b.String()\n}\n\nfunc (l *logBuf) count(sub string) int { return strings.Count(l.String(), sub) }\n\nfunc newLog() (*slog.Logger, *logBuf) {\n\tb := &logBuf{}\n\treturn slog.New(slog.NewTextHandler(b, &slog.HandlerOptions{Level: slog.LevelDebug})), b\n}\n\n// testLoop is a configurable Loop recording when it ticked.\ntype testLoop struct {\n\tname     string\n\tclaims   bool\n\tinterval func(*config.Resolved) time.Duration\n\ttick     func(ctx context.Context, env Env) error\n\n\tmu     sync.Mutex\n\tstarts []time.Time\n\tends   []time.Time\n\tcur    int\n\tmaxCur int\n}\n\nfunc (l *testLoop) Name() string { return l.name }\nfunc (l *testLoop) Claims() bool { return l.claims }\nfunc (l *testLoop) Interval(c *config.Resolved) time.Duration {\n\tif l.interval != nil {\n\t\treturn l.interval(c)\n\t}\n\treturn 5 * time.Minute","is_error":false}]},"parent_tool_use_id":null,"session_id":"963dcc55-a817-4272-a2d8-3b75b64f6c55","uuid":"813a0c46-7210-4337-9a63-99e80298774f","timestamp":"2026-11-25T11:56:28.625Z","tool_use_result":{"stdout":"package pool\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"io\"\n\t\"log/slog\"\n\t\"sort\"\n\t\"sync\"\n\t\"time\"\n)\n\n// Verdict is the pool's answer for one candidate.\ntype Verdict int\n\n// Verdicts. Anything other than Granted means the loop touches no label and\n// writes no state; the candidate is offered again next tick.\nconst (\n\tGranted         Verdict = iota\n\tDeniedFull              // no slot was free for it, and no other loop reserved one\n\tDeniedOutranked         // higher-ranked live demand from another loop reserved the free slots\n\tDeniedIssueBusy         // triage only: a triage job on the same issue is held or granted earlier in the batch\n\tDeniedDuplicate         // same key already held, or earlier in this batch\n\tDeniedInvalid           // malformed candidate (caller bug)\n\tDeniedLimited           // its account or model family is out of quota until a reset time\n\tDeniedBudget            // a daily dollar or token cap is reached\n)\n\nvar verdictNames = [...]string{\"granted\", \"full\", \"outranked\", \"issue-busy\", \"duplicate\", \"invalid\", \"limited\", \"budget\"}\n\n// String returns the verdict's log name.\nfunc (v Verdict) String() string {\n\tif v >= 0 && int(v) < len(verdictNames) {\n\t\treturn verdictNames[v]\n\t}\n\treturn fmt.Sprintf(\"verdict(%d)\", int(v))\n}\n\n// Decision is the result for one offered candidate.\ntype Decision struct {\n\tCandidate Candidate\n\tVerdict   Verdict\n\tSlot      *Slot  // non-nil if and only if Verdict == Granted\n\tReason    string // human-readable, for logs and the status issue\n}\n\n// Held is a job already running when the pool is built (restart recovery).\ntype Held struct {\n\tCandidate Candidate\n\tJobID     string\n}\n\n// Options configures New.\ntype Options struct {\n\tMax         int              // cfg.MaxPods; values < 1 are treated as 1\n\tNow         func() time.Time // nil means time.Now\n\tLog         *slog.Logger     // nil means discard\n\tHeld        []Held           // running jobs from state; held even if they exceed Max\n\tStarveAfter time.Duration    // 0 means 24h\n\t// Limited reports when a candidate may next start because its account or\n\t// model family is out of quota: zero or a past time means it may start\n\t// now. nil disables the check. A limited candidate takes no slot and\n\t// reserves no demand: it does not hold lower classes back.\n\tLimited func(c Candidate) time.Time\n\t// Budget reports whether a daily dollar or token cap forbids starting c, with the\n\t// reason. nil disables the check. A refused candidate takes no slot and\n\t// reserves no demand; a job already held is never affected.\n\tBudget func(c Candidate) (denied bool, reason string)\n}\n\n// Pool is the in-memory slot arbiter. One mutex guards all state; there are\n// no goroutines or timers, and demand expiry is evaluated lazily.\ntype Pool struct {\n\tmu          sync.Mutex\n\tmax         int\n\tnow         func() time.Time\n\tlog         *slog.Logger\n\tstarveAfter time.Duration\n\tlimited     func(c Candidate) time.Time\n\tbudget      func(c Candidate) (bool, string)\n\theld        map[string]*Slot\n\tdemand      map[string]*loopDemand\n\tfirstDenied map[string]time.Time\n\tstarved     map[Class]bool\n}\n\n// New builds a pool, adopting o.Held.\nfunc New(o Options) *Pool {\n\tp := &Pool{\n\t\tmax:         max(1, o.Max),\n\t\tnow:         o.Now,\n\t\tlog:         o.Log,\n\t\tstarveAfter: o.StarveAfter,\n\t\tlimited:     o.Limited,\n\t\tbudget:      o.Budget,\n\t\theld:        map[string]*Slot{},\n\t\tdemand:      map[string]*loopDemand{},\n\t\tfirstDenied: map[string]time.Time{},\n\t\tstarved:     map[Class]bool{},\n\t}\n\tif p.now == nil {\n\t\tp.now = time.Now\n\t}\n\tif p.log == nil {\n\t\tp.log = slog.New(slog.NewTextHandler(io.Discard, nil))\n\t}\n\tif p.starveAfter == 0 {\n\t\tp.starveAfter = 24 * time.Hour\n\t}\n\tfor _, h := range o.Held {\n\t\tk := h.Candidate.Key()\n\t\tif p.held[k] != nil {\n\t\t\tp.log.Warn(\"pool.adopt_duplicate\", \"key\", k, \"job_id\", h.JobID)\n\t\t\tcontinue\n\t\t}\n\t\tp.held[k] = &Slot{pool: p, cand: h.Candidate, jobID: h.JobID, grantedAt: p.now(), adopted: true}\n\t}\n\tif len(p.held) > p.max {\n\t\tp.log.Warn(\"pool.adopt_over_max\", \"held\", len(p.held), \"max\", p.max)\n\t}\n\treturn p\n}\n\n// SetMax changes the cap. It never revokes held slots; n < 1 is treated as 1.\nfunc (p *Pool) SetMax(n int) {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\tp.max = max(1, n)\n}\n\n// Lookup returns the held slot for key, for close-out and the Reaper after a restart.\nfunc (p *Pool) Lookup(key string) (*Slot, bool) {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\ts, ok := p.held[key]\n\treturn s, ok\n}\n\ntype item struct {\n\tcand Candidate\n\tidx  int // index into decisions; -1 for foreign demand\n}\n\n// Offer ranks cands against held slots and other loops' live demand and\n// returns one Decision per candidate, in input order. It replaces loop's\n// demand entry, which expires ttl after this call (ttl <= 0 records none).\n// Loops must call Offer once per tick even with no candidates, so stale\n// demand clears.\nfunc (p *Pool) Offer(loop string, ttl time.Duration, cands []Candidate) []Decision {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\tnow := p.now()\n\tp.purgeLocked(now)\n\n\tfree0 := max(0, p.max-len(p.held))\n\tfree := free0\n\tdecisions := make([]Decision, len(cands))\n\ttriageHeld := map[int]bool{}\n\tfor _, s := range p.held {\n\t\tif s.cand.Class == ClassTriage {\n\t\t\ttriageHeld[s.cand.Number] = true\n\t\t}\n\t}\n\n\t// Validation and duplicates.\n\tinBatch := map[string]bool{}\n\tvar items []item\n\tfor i, c := range cands {\n\t\tdecisions[i].Candidate = c\n\t\tif why := c.invalid(); why != \"\" {\n\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedInvalid, why\n\t\t\tp.log.Warn(\"pool.invalid\", \"loop\", loop, \"class\", c.Class.String(), \"role\", c.Role, \"number\", c.Number, \"reason\", why)\n\t\t\tcontinue\n\t\t}\n\t\tk := c.Key()\n\t\tif p.held[k] != nil || inBatch[k] {\n\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedDuplicate, \"already held or offered earlier in this batch\"\n\t\t\tcontinue\n\t\t}\n\t\tif p.limited != nil {\n\t\t\tif until := p.limited(c); now.Before(until) {\n\t\t\t\tdecisions[i].Verdict = DeniedLimited\n\t\t\t\tdecisions[i].Reason = \"usage limit until \" + until.UTC().Format(\"15:04\") + \" UTC\"\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tif p.budget != nil {\n\t\t\tif denied, why := p.budget(c); denied {\n\t\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedBudget, why\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tinBatch[k] = true\n\t\titems = append(items, item{c, i})\n\t}\n\tfor _, c := range p.foreignLocked(loop, now, inBatch, triageHeld) {\n\t\titems = append(items, item{c, -1})\n\t}\n\tsort.Slice(items, func(a, b int) bool { return less(items[a].cand, items[b].cand) })\n\n\t// Walk the merged ranking.\n\treserved := 0\n\ttriageGranted := map[int]bool{}\n\tvar denied []Candidate\n\tcapDenied := 0\n\tfor _, it := range items {\n\t\tif it.idx < 0 {\n\t\t\tif free > 0 {\n\t\t\t\tfree--\n\t\t\t\treserved++\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\td := &decisions[it.idx]\n\t\tc := it.cand\n\t\tswitch {\n\t\tcase c.Class == ClassTriage && (triageHeld[c.Number] || triageGranted[c.Number]):\n\t\t\td.Verdict, d.Reason = DeniedIssueBusy, fmt.Sprintf(\"a triage job on #%d is already held\", c.Number)\n\t\tcase free > 0:\n\t\t\tfree--\n\t\t\ts := &Slot{pool: p, cand: c, grantedAt: now}\n\t\t\tp.held[c.Key()] = s\n\t\t\tif c.Class == ClassTriage {\n\t\t\t\ttriageGranted[c.Number] = true\n\t\t\t}\n\t\t\tdelete(p.firstDenied, c.Key())\n\t\t\tp.starved[c.Class] = false\n\t\t\td.Verdict, d.Slot = Granted, s\n\t\t\tp.log.Debug(\"pool.grant\", \"loop\", loop, \"key\", c.Key(), \"class\", c.Class.String(), \"role\", c.Role, \"number\", c.Number)\n\t\tcase capDenied < reserved:\n\t\t\tcapDenied++\n\t\t\td.Verdict, d.Reason = DeniedOutranked, fmt.Sprintf(\"outranked by %d higher-ranked waiting job(s)\", reserved)\n\t\t\tdenied = append(denied, c)\n\t\tdefault:\n\t\t\tcapDenied++\n\t\t\td.Verdict, d.Reason = DeniedFull, \"no free slot\"\n\t\t\tdenied = append(denied, c)\n\t\t}\n\t}\n\tp.setDemandLocked(loop, now, ttl, denied)\n\tp.checkStarvationLocked(now)\n\n\tif p.log.Enabled(context.Background(), slog.LevelDebug) {\n\t\tcounts := map[string]int{}\n\t\tfor _, d := range decisions {\n\t\t\tcounts[d.Verdict.String()]++\n\t\t}\n\t\tp.log.Debug(\"pool.offer\", \"loop\", loop, \"verdicts\", fmt.Sprint(counts), \"free_before\", free0, \"free_after\", max(0, p.max-len(p.held)))\n\t}\n\treturn decisions\n}\npackage controller\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"math/rand/v2\"\n\t\"sort\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n)\n\n// DefaultGrace is how long shutdown waits for ticks and in-flight work.\nconst DefaultGrace = 2 * time.Minute\n\n// abandonWait is how long Run waits for goroutines to notice the cancelled\n// work context after the grace period expires or Force closes.\nconst abandonWait = 5 * time.Second\n\n// Hook is a named startup step run before any loop starts.\ntype Hook struct {\n\tName string\n\tFn   func(ctx context.Context) error\n}\n\n// Deps are the controller's collaborators.\ntype Deps struct {\n\tLog *slog.Logger\n\t// Config is called before every tick for a fresh snapshot, and once at\n\t// startup. An error counts as paused (fail closed): claiming loops are\n\t// skipped, and when no config has ever loaded no loop runs until one does.\n\tConfig func(ctx context.Context) (*config.Resolved, error)\n\tPause  Pauser\n\t// Startup hooks run in order before any loop starts; any error aborts Run.\n\tStartup []Hook\n\t// Grace is the shutdown wait; 0 means DefaultGrace.\n\tGrace time.Duration\n\t// Force is closed on a second signal; it abandons the grace wait.\n\tForce <-chan struct{}\n\t// Wake, when non-nil, makes every loop run one tick now for each receive\n\t// (still behind the kill switch and the pool). Pending wakes coalesce.\n\tWake <-chan struct{}\n\t// Rand returns a value in [0,1); nil means math/rand/v2.Float64.\n\tRand func() float64\n}\n\n// Controller schedules loops.\ntype Controller struct {\n\tdeps  Deps\n\tloops []Loop\n\n\tinflight *Inflight // set by Run\n\n\tmu     sync.Mutex\n\tactive map[string]bool\n}\n\n// New validates deps and loop names. It returns an error for a nil Log,\n// Config or Pause, or an empty or duplicate loop name.\nfunc New(d Deps, loops ...Loop) (*Controller, error) {\n\tswitch {\n\tcase d.Log == nil:\n\t\treturn nil, errors.New(\"controller: nil Log\")\n\tcase d.Config == nil:\n\t\treturn nil, errors.New(\"controller: nil Config\")\n\tcase d.Pause == nil:\n\t\treturn nil, errors.New(\"controller: nil Pause\")\n\t}\n\tseen := map[string]bool{}\n\tfor _, l := range loops {\n\t\tn := l.Name()\n\t\tif n == \"\" {\n\t\t\treturn nil, errors.New(\"controller: loop with empty name\")\n\t\t}\n\t\tif seen[n] {\n\t\t\treturn nil, fmt.Errorf(\"controller: duplicate loop name %q\", n)\n\t\t}\n\t\tseen[n] = true\n\t}\n\treturn &Controller{deps: d, loops: loops, active: map[string]bool{}}, nil\n}\n\nfunc (c *Controller) rand() float64 {\n\tif c.deps.Rand != nil {\n\t\treturn c.deps.Rand()\n\t}\n\treturn rand.Float64()\n}\n\nfunc (c *Controller) setActive(name string, on bool) {\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\tif on {\n\t\tc.active[name] = true\n\t} else {\n\t\tdelete(c.active, name)\n\t}\n}\n\nfunc (c *Controller) activeTicks() []string {\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\tvar out []string\n\tfor n := range c.active {\n\t\tout = append(out, \"tick:\"+n)\n\t}\n\tsort.Strings(out)\n\treturn out\n}\n\n// Run runs startup hooks, then every loop, and blocks until ctx is done and\n// shutdown completes. A clean drain returns nil. When the grace period ends\n// or Force closes, work contexts are cancelled and Run returns an error\n// naming what was abandoned.\nfunc (c *Controller) Run(ctx context.Context) error {\n\tlog := c.deps.Log\n\tfor _, h := range c.deps.Startup {\n\t\tstart := time.Now()\n\t\tif err := h.Fn(ctx); err != nil {\n\t\t\treturn fmt.Errorf(\"startup %s: %w\", h.Name, err)\n\t\t}\n\t\tlog.Info(\"controller.hook\", \"name\", h.Name, \"duration\", time.Since(start).String())\n\t}\n\t// A config that cannot be loaded does not abort startup: the controller\n\t// starts paused, with no config, and retries on every tick.\n\tlctx, cancelLoad := context.WithTimeout(ctx, configTimeout)\n\tcfg, err := c.deps.Config(lctx)\n\tcancelLoad()\n\tif err != nil {\n\t\tlog.Error(\"config.initial_failed\", \"error\", err)\n\t\tcfg = nil\n\t}\n\n\t// Work contexts outlive the first signal; only grace expiry or Force\n\t// cancels them.\n\tworkCtx, cancelWork := context.WithCancel(context.WithoutCancel(ctx))\n\tdefer cancelWork()\n\tc.inflight = NewInflight(workCtx, log)\n\tstopping := make(chan struct{})\n\n\tnames := make([]string, len(c.loops))\n\tvar wg sync.WaitGroup\n\tvar runners []*runner\n\tfor i, l := range c.loops {\n\t\tnames[i] = l.Name()\n\t\tr := &runner{c: c, loop: l, log: log.With(\"loop\", l.Name()), cfg: cfg, cfgBroken: err != nil, wake: make(chan struct{}, 1)}\n\t\trunners = append(runners, r)\n\t\twg.Add(1)\n\t\tgo func() {\n\t\t\tdefer wg.Done()\n\t\t\tr.run(workCtx, stopping)\n\t\t}()\n\t}\n\tlog.Info(\"controller.start\", \"loops\", names)\n\tif c.deps.Wake != nil {\n\t\twg.Add(1)\n\t\tgo func() {\n\t\t\tdefer wg.Done()\n\t\t\tfor {\n\t\t\t\tselect {\n\t\t\t\tcase <-stopping:\n\t\t\t\t\treturn\n\t\t\t\tcase <-c.deps.Wake:\n\t\t\t\t\tselect { // a wake racing shutdown starts nothing\n\t\t\t\t\tcase <-stopping:\n\t\t\t\t\t\treturn\n\t\t\t\t\tdefault:\n\t\t\t\t\t}\n\t\t\t\t\tlog.Info(\"controller.wake\", \"loops\", names)\n\t\t\t\t\tfor _, r := range runners {\n\t\t\t\t\t\tselect {\n\t\t\t\t\t\tcase r.wake <- struct{}{}:\n\t\t\t\t\t\tdefault: // one already pending\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}()\n\t}\n\n\t<-ctx.Done()\n\tlog.Info(\"controller.stopping\")\n\tclose(stopping)\n\n\tgrace := c.deps.Grace\n\tif grace == 0 {\n\t\tgrace = DefaultGrace\n\t}\n\ttimer := time.NewTimer(grace)\n\tdefer timer.Stop()\n\n\tdrained := make(chan struct{})\n\tgo func() {\n\t\twg.Wait() // every in-progress tick has returned\n\t\tc.inflight.close()\n\t\t<-c.inflight.Wait()\n\t\tclose(drained)\n\t}()\n\n\tvar result error\n\tselect {\n\tcase <-drained:\n\tcase <-timer.C:\n\t\tabandoned := append(c.activeTicks(), c.inflight.Pending()...)\n\t\tresult = fmt.Errorf(\"shutdown grace %s exceeded; abandoned: %s\", grace, strings.Join(abandoned, \", \"))\n\t\tc.abandon(cancelWork, drained)\n\tcase <-c.deps.Force:\n\t\tresult = errors.New(\"forced shutdown\")\n\t\tc.abandon(cancelWork, drained)\n\t}\n\tlog.Info(\"controller.stopped\", \"clean\", result == nil)\n\treturn result\n}\n\n// abandon cancels the work context and gives goroutines a moment to return.\nfunc (c *Controller) abandon(cancel context.CancelFunc, drained <-chan struct{}) {\n\tcancel()\n\tt := time.NewTimer(abandonWait)\n\tdefer t.Stop()\n\tselect {\n\tcase <-drained:\n\tcase <-t.C:\n\t}\n}\npackage controller\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"runtime/debug\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n)\n\nconst (\n\tbackoffAfter = 3 // consecutive errors before backoff starts\n\tbackoffCap   = 15 * time.Minute\n\n\t// configTimeout bounds one config load, which fetches from the remote.\n\tconfigTimeout = 2 * time.Minute\n)\n\n// runner drives one Loop. Ticks of one loop never overlap and a slow tick\n// never queues a second one; different loops run concurrently.\ntype runner struct {\n\tc    *Controller\n\tloo