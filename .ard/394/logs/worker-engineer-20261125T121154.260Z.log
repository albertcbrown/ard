{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GtHG32bp2u5YAdYQpGZdJd","type":"tool_result","content":"package pool\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"io\"\n\t\"log/slog\"\n\t\"sort\"\n\t\"sync\"\n\t\"time\"\n)\n\n// Verdict is the pool's answer for one candidate.\ntype Verdict int\n\n// Verdicts. Anything other than Granted means the loop touches no label and\n// writes no state; the candidate is offered again next tick.\nconst (\n\tGranted         Verdict = iota\n\tDeniedFull              // no slot was free for it, and no other loop reserved one\n\tDeniedOutranked         // higher-ranked live demand from another loop reserved the free slots\n\tDeniedIssueBusy         // triage only: a triage job on the same issue is held or granted earlier in the batch\n\tDeniedDuplicate         // same key already held, or earlier in this batch\n\tDeniedInvalid           // malformed candidate (caller bug)\n\tDeniedLimited           // its account or model family is out of quota until a reset time\n\tDeniedBudget            // a daily dollar or token cap is reached\n)\n\nvar verdictNames = [...]string{\"granted\", \"full\", \"outranked\", \"issue-busy\", \"duplicate\", \"invalid\", \"limited\", \"budget\"}\n\n// String returns the verdict's log name.\nfunc (v Verdict) String() string {\n\tif v >= 0 && int(v) < len(verdictNames) {\n\t\treturn verdictNames[v]\n\t}\n\treturn fmt.Sprintf(\"verdict(%d)\", int(v))\n}\n\n// Decision is the result for one offered candidate.\ntype Decision struct {\n\tCandidate Candidate\n\tVerdict   Verdict\n\tSlot      *Slot  // non-nil if and only if Verdict == Granted\n\tReason    string // human-readable, for logs and the status issue\n}\n\n// Held is a job already running when the pool is built (restart recovery).\ntype Held struct {\n\tCandidate Candidate\n\tJobID     string\n}\n\n// Options configures New.\ntype Options struct {\n\tMax         int              // cfg.MaxPods; values < 1 are treated as 1\n\tNow         func() time.Time // nil means time.Now\n\tLog         *slog.Logger     // nil means discard\n\tHeld        []Held           // running jobs from state; held even if they exceed Max\n\tStarveAfter time.Duration    // 0 means 24h\n\t// Limited reports when a candidate may next start because its account or\n\t// model family is out of quota: zero or a past time means it may start\n\t// now. nil disables the check. A limited candidate takes no slot and\n\t// reserves no demand: it does not hold lower classes back.\n\tLimited func(c Candidate) time.Time\n\t// Budget reports whether a daily dollar or token cap forbids starting c, with the\n\t// reason. nil disables the check. A refused candidate takes no slot and\n\t// reserves no demand; a job already held is never affected.\n\tBudget func(c Candidate) (denied bool, reason string)\n}\n\n// Pool is the in-memory slot arbiter. One mutex guards all state; there are\n// no goroutines or timers, and demand expiry is evaluated lazily.\ntype Pool struct {\n\tmu          sync.Mutex\n\tmax         int\n\tnow         func() time.Time\n\tlog         *slog.Logger\n\tstarveAfter time.Duration\n\tlimited     func(c Candidate) time.Time\n\tbudget      func(c Candidate) (bool, string)\n\theld        map[string]*Slot\n\tdemand      map[string]*loopDemand\n\tfirstDenied map[string]time.Time\n\tstarved     map[Class]bool\n}\n\n// New builds a pool, adopting o.Held.\nfunc New(o Options) *Pool {\n\tp := &Pool{\n\t\tmax:         max(1, o.Max),\n\t\tnow:         o.Now,\n\t\tlog:         o.Log,\n\t\tstarveAfter: o.StarveAfter,\n\t\tlimited:     o.Limited,\n\t\tbudget:      o.Budget,\n\t\theld:        map[string]*Slot{},\n\t\tdemand:      map[string]*loopDemand{},\n\t\tfirstDenied: map[string]time.Time{},\n\t\tstarved:     map[Class]bool{},\n\t}\n\tif p.now == nil {\n\t\tp.now = time.Now\n\t}\n\tif p.log == nil {\n\t\tp.log = slog.New(slog.NewTextHandler(io.Discard, nil))\n\t}\n\tif p.starveAfter == 0 {\n\t\tp.starveAfter = 24 * time.Hour\n\t}\n\tfor _, h := range o.Held {\n\t\tk := h.Candidate.Key()\n\t\tif p.held[k] != nil {\n\t\t\tp.log.Warn(\"pool.adopt_duplicate\", \"key\", k, \"job_id\", h.JobID)\n\t\t\tcontinue\n\t\t}\n\t\tp.held[k] = &Slot{pool: p, cand: h.Candidate, jobID: h.JobID, grantedAt: p.now(), adopted: true}\n\t}\n\tif len(p.held) > p.max {\n\t\tp.log.Warn(\"pool.adopt_over_max\", \"held\", len(p.held), \"max\", p.max)\n\t}\n\treturn p\n}\n\n// SetMax changes the cap. It never revokes held slots; n < 1 is treated as 1.\nfunc (p *Pool) SetMax(n int) {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\tp.max = max(1, n)\n}\n\n// Lookup returns the held slot for key, for close-out and the Reaper after a restart.\nfunc (p *Pool) Lookup(key string) (*Slot, bool) {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\ts, ok := p.held[key]\n\treturn s, ok\n}\n\ntype item struct {\n\tcand Candidate\n\tidx  int // index into decisions; -1 for foreign demand\n}\n\n// Offer ranks cands against held slots and other loops' live demand and\n// returns one Decision per candidate, in input order. It replaces loop's\n// demand entry, which expires ttl after this call (ttl <= 0 records none).\n// Loops must call Offer once per tick even with no candidates, so stale\n// demand clears.\nfunc (p *Pool) Offer(loop string, ttl time.Duration, cands []Candidate) []Decision {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\tnow := p.now()\n\tp.purgeLocked(now)\n\n\tfree0 := max(0, p.max-len(p.held))\n\tfree := free0\n\tdecisions := make([]Decision, len(cands))\n\ttriageHeld := map[int]bool{}\n\tfor _, s := range p.held {\n\t\tif s.cand.Class == ClassTriage {\n\t\t\ttriageHeld[s.cand.Number] = true\n\t\t}\n\t}\n\n\t// Validation and duplicates.\n\tinBatch := map[string]bool{}\n\tvar items []item\n\tfor i, c := range cands {\n\t\tdecisions[i].Candidate = c\n\t\tif why := c.invalid(); why != \"\" {\n\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedInvalid, why\n\t\t\tp.log.Warn(\"pool.invalid\", \"loop\", loop, \"class\", c.Class.String(), \"role\", c.Role, \"number\", c.Number, \"reason\", why)\n\t\t\tcontinue\n\t\t}\n\t\tk := c.Key()\n\t\tif p.held[k] != nil || inBatch[k] {\n\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedDuplicate, \"already held or offered earlier in this batch\"\n\t\t\tcontinue\n\t\t}\n\t\tif p.limited != nil {\n\t\t\tif until := p.limited(c); now.Before(until) {\n\t\t\t\tdecisions[i].Verdict = DeniedLimited\n\t\t\t\tdecisions[i].Reason = \"usage limit until \" + until.UTC().Format(\"15:04\") + \" UTC\"\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tif p.budget != nil {\n\t\t\tif denied, why := p.budget(c); denied {\n\t\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedBudget, why\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tinBatch[k] = true\n\t\titems = append(items, item{c, i})\n\t}\n\tfor _, c := range p.foreignLocked(loop, now, inBatch, triageHeld) {\n\t\titems = append(items, item{c, -1})\n\t}\n\tsort.Slice(items, func(a, b int) bool { return less(items[a].cand, items[b].cand) })\n\n\t// Walk the merged ranking.\n\treserved := 0\n\ttriageGranted := map[int]bool{}\n\tvar denied []Candidate\n\tcapDenied := 0\n\tfor _, it := range items {\n\t\tif it.idx < 0 {\n\t\t\tif free > 0 {\n\t\t\t\tfree--\n\t\t\t\treserved++\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\td := &decisions[it.idx]\n\t\tc := it.cand\n\t\tswitch {\n\t\tcase c.Class == ClassTriage && (triageHeld[c.Number] || triageGranted[c.Number]):\n\t\t\td.Verdict, d.Reason = DeniedIssueBusy, fmt.Sprintf(\"a triage job on #%d is already held\", c.Number)\n\t\tcase free > 0:\n\t\t\tfree--\n\t\t\ts := &Slot{pool: p, cand: c, grantedAt: now}\n\t\t\tp.held[c.Key()] = s\n\t\t\tif c.Class == ClassTriage {\n\t\t\t\ttriageGranted[c.Number] = true\n\t\t\t}\n\t\t\tdelete(p.firstDenied, c.Key())\n\t\t\tp.starved[c.Class] = false\n\t\t\td.Verdict, d.Slot = Granted, s\n\t\t\tp.log.Debug(\"pool.grant\", \"loop\", loop, \"key\", c.Key(), \"class\", c.Class.String(), \"role\", c.Role, \"number\", c.Number)\n\t\tcase capDenied < reserved:\n\t\t\tcapDenied++\n\t\t\td.Verdict, d.Reason = DeniedOutranked, fmt.Sprintf(\"outranked by %d higher-ranked waiting job(s)\", reserved)\n\t\t\tdenied = append(denied, c)\n\t\tdefault:\n\t\t\tcapDenied++\n\t\t\td.Verdict, d.Reason = DeniedFull, \"no free slot\"\n\t\t\tdenied = append(denied, c)\n\t\t}\n\t}\n\tp.setDemandLocked(loop, now, ttl, denied)\n\tp.checkStarvationLocked(now)\n\n\tif p.log.Enabled(context.Background(), slog.LevelDebug) {\n\t\tcounts := map[string]int{}\n\t\tfor _, d := range decisions {\n\t\t\tcounts[d.Verdict.String()]++\n\t\t}\n\t\tp.log.Debug(\"pool.offer\", \"loop\", loop, \"verdicts\", fmt.Sprint(counts), \"free_before\", free0, \"free_after\", max(0, p.max-len(p.held)))\n\t}\n\treturn decisions\n}\npackage pool\n\nimport \"time\"\n\n// Slot is a granted reservation, held from Offer until Release.\ntype Slot struct {\n\tpool      *Pool\n\tcand      Candidate\n\tjobID     string\n\tgrantedAt time.Time\n\treleased  bool\n\tadopted   bool\n}\n\n// Key returns the job key.\nfunc (s *Slot) Key() string { return s.cand.Key() }\n\n// Candidate returns the candidate the slot was granted to.\nfunc (s *Slot) Candidate() Candidate { return s.cand }\n\n// Adopted reports whether the slot was built from a job that was already\n// running when the pool was created (restart recovery), so no goroutine of\n// this process drives it. The Reaper closes such a job out itself.\nfunc (s *Slot) Adopted() bool { return s.adopted }\n\n// JobID returns the id set by SetJobID, or \"\".\nfunc (s *Slot) JobID() string {\n\ts.pool.mu.Lock()\n\tdefer s.pool.mu.Unlock()\n\treturn s.jobID\n}\n\n// SetJobID records the job's ULID once the loop has minted it. It is used\n// for logs and Stats only.\nfunc (s *Slot) SetJobID(id string) {\n\ts.pool.mu.Lock()\n\tdefer s.pool.mu.Unlock()\n\ts.jobID = id\n}\n\n// Release frees the slot. It returns true on the first call and false after,\n// so a stale handle never frees a slot re-granted under the same key. Safe\n// from any goroutine.\nfunc (s *Slot) Release() bool {\n\tp := s.pool\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\tif s.released {\n\t\treturn false\n\t}\n\ts.released = true\n\tif p.held[s.Key()] == s {\n\t\tdelete(p.held, s.Key())\n\t}\n\tp.log.Debug(\"pool.release\", \"key\", s.Key(), \"class\", s.cand.Class.String(),\n\t\t\"role\", s.cand.Role, \"number\", s.cand.Number, \"job_id\", s.jobID)\n\treturn true\n}\npackage pool\n\nimport \"time\"\n\n// loopDemand is one loop's candidates last denied for lack of a slot. It is a\n// reservation hint only: a loop that has not offered reserves nothing.\ntype loopDemand struct {\n\texpires time.Time\n\tcands   map[string]Candidate\n}\n\ntype waiting struct {\n\tcount  int\n\toldest time.Duration\n}\n\n// purgeLocked drops expired demand entries and their first-denied records.\nfunc (p *Pool) purgeLocked(now time.Time) {\n\tfor loop, d := range p.demand {\n\t\tif !now.Before(d.expires) {\n\t\t\tfor k := range d.cands {\n\t\t\t\tdelete(p.firstDenied, k)\n\t\t\t}\n\t\t\tdelete(p.demand, loop)\n\t\t}\n\t}\n}\n\n// foreignLocked returns other loops' live demand that is still worth\n// reserving: not held now, not in the current batch, and (for triage) whose\n// issue has no held triage job.\nfunc (p *Pool) foreignLocked(loop string, now time.Time, batch map[string]bool, triageHeld map[int]bool) []Candidate {\n\tvar out []Candidate\n\tfor l, d := range p.demand {\n\t\tif l == loop || !now.Before(d.expires) {\n\t\t\tcontinue\n\t\t}\n\t\tfor k, c := range d.cands {\n\t\t\tif p.held[k] != nil || batch[k] {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif c.Class == ClassTriage && triageHeld[c.Number] {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tout = append(out, c)\n\t\t}\n\t}\n\t// Only one triage job per issue can run, so only the best-ranked waiting\n\t// triage candidate on an issue reserves a slot.\n\tbest := map[int]Candidate{}\n\tfor _, c := range out {\n\t\tif c.Class == ClassTriage {\n\t\t\tif b, ok := best[c.Number]; !ok || less(c, b) {\n\t\t\t\tbest[c.Number] = c\n\t\t\t}\n\t\t}\n\t}\n\tkept := out[:0]\n\tfor _, c := range out {\n\t\tif c.Class == ClassTriage && best[c.Number] != c {\n\t\t\tcontinue\n\t\t}\n\t\tkept = append(kept, c)\n\t}\n\treturn kept\n}\n\n// setDemandLocked replaces loop's demand entry with denied (empty clears it).\nfunc (p *Pool) setDemandLocked(loop string, now time.Time, ttl time.Duration, denied []Candidate) {\n\told := p.demand[loop]\n\tdelete(p.demand, loop)\n\td := &loopDemand{expires: now.Add(ttl), cands: map[string]Candidate{}}\n\tif ttl > 0 {\n\t\tfor _, c := range denied {\n\t\t\td.cands[c.Key()] = c\n\t\t}\n\t}\n\t// Keys that stay keep their first-denied time; keys that dropped out lose it.\n\tif old != nil {\n\t\tfor k := range old.cands {\n\t\t\tif _, ok := d.cands[k]; !ok {\n\t\t\t\tdelete(p.firstDenied, k)\n\t\t\t}\n\t\t}\n\t}\n\tif len(d.cands) == 0 {\n\t\treturn\n\t}\n\tfor k := range d.cands {\n\t\tif _, ok := p.firstDenied[k]; !ok {\n\t\t\tp.firstDenied[k] = now\n\t\t}\n\t}\n\tp.demand[loop] = d\n}\n\n// waitingLocked summarises live demand per class.\nfunc (p *Pool) waitingLocked(now time.Time) map[Class]waiting {\n\tout := map[Class]waiting{}\n\tfor _, d := range p.demand {\n\t\tif !now.Before(d.expires) {\n\t\t\tcontinue\n\t\t}\n\t\tfor k, c := range d.cands {\n\t\t\tw := out[c.Class]\n\t\t\tw.count++\n\t\t\tif t, ok := p.firstDenied[k]; ok && now.Sub(t) > w.oldest {\n\t\t\t\tw.oldest = now.Sub(t)\n\t\t\t}\n\t\t\tout[c.Class] = w\n\t\t}\n\t}\n\treturn out\n}\n\n// checkStarvationLocked logs one pool.starved warning when a class's oldest\n// wait first crosses StarveAfter. It re-arms once the class has no waiting\n// demand (a grant also clears the flag in Offer).\nfunc (p *Pool) checkStarvationLocked(now time.Time) {\n\tw := p.waitingLocked(now)\n\tfor c := ClassReview; c <= ClassScanner; c++ {\n\t\tws, ok := w[c]\n\t\tif !ok {\n\t\t\tp.starved[c] = false\n\t\t\tcontinue\n\t\t}\n\t\tif ws.oldest >= p.starveAfter && !p.starved[c] {\n\t\t\tp.starved[c] = true\n\t\t\tp.log.Warn(\"pool.starved\", \"class\", c.String(), \"waiting\", ws.count, \"oldest_wait\", ws.oldest.String())\n\t\t}\n\t}\n}\n     228 internal/controller/controller.go","is_error":false}]},"parent_tool_use_id":null,"session_id":"5ff4ebf2-2666-4434-877a-923cd6f2f050","uuid":"b2b69d0e-ea93-4c9f-a740-53a989a051fe","timestamp":"2026-11-25T12:11:57.047Z","tool_use_result":{"stdout":"package pool\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"io\"\n\t\"log/slog\"\n\t\"sort\"\n\t\"sync\"\n\t\"time\"\n)\n\n// Verdict is the pool's answer for one candidate.\ntype Verdict int\n\n// Verdicts. Anything other than Granted means the loop touches no label and\n// writes no state; the candidate is offered again next tick.\nconst (\n\tGranted         Verdict = iota\n\tDeniedFull              // no slot was free for it, and no other loop reserved one\n\tDeniedOutranked         // higher-ranked live demand from another loop reserved the free slots\n\tDeniedIssueBusy         // triage only: a triage job on the same issue is held or granted earlier in the batch\n\tDeniedDuplicate         // same key already held, or earlier in this batch\n\tDeniedInvalid           // malformed candidate (caller bug)\n\tDeniedLimited           // its account or model family is out of quota until a reset time\n\tDeniedBudget            // a daily dollar or token cap is reached\n)\n\nvar verdictNames = [...]string{\"granted\", \"full\", \"outranked\", \"issue-busy\", \"duplicate\", \"invalid\", \"limited\", \"budget\"}\n\n// String returns the verdict's log name.\nfunc (v Verdict) String() string {\n\tif v >= 0 && int(v) < len(verdictNames) {\n\t\treturn verdictNames[v]\n\t}\n\treturn fmt.Sprintf(\"verdict(%d)\", int(v))\n}\n\n// Decision is the result for one offered candidate.\ntype Decision struct {\n\tCandidate Candidate\n\tVerdict   Verdict\n\tSlot      *Slot  // non-nil if and only if Verdict == Granted\n\tReason    string // human-readable, for logs and the status issue\n}\n\n// Held is a job already running when the pool is built (restart recovery).\ntype Held struct {\n\tCandidate Candidate\n\tJobID     string\n}\n\n// Options configures New.\ntype Options struct {\n\tMax         int              // cfg.MaxPods; values < 1 are treated as 1\n\tNow         func() time.Time // nil means time.Now\n\tLog         *slog.Logger     // nil means discard\n\tHeld        []Held           // running jobs from state; held even if they exceed Max\n\tStarveAfter time.Duration    // 0 means 24h\n\t// Limited reports when a candidate may next start because its account or\n\t// model family is out of quota: zero or a past time means it may start\n\t// now. nil disables the check. A limited candidate takes no slot and\n\t// reserves no demand: it does not hold lower classes back.\n\tLimited func(c Candidate) time.Time\n\t// Budget reports whether a daily dollar or token cap forbids starting c, with the\n\t// reason. nil disables the check. A refused candidate takes no slot and\n\t// reserves no demand; a job already held is never affected.\n\tBudget func(c Candidate) (denied bool, reason string)\n}\n\n// Pool is the in-memory slot arbiter. One mutex guards all state; there are\n// no goroutines or timers, and demand expiry is evaluated lazily.\ntype Pool struct {\n\tmu          sync.Mutex\n\tmax         int\n\tnow         func() time.Time\n\tlog         *slog.Logger\n\tstarveAfter time.Duration\n\tlimited     func(c Candidate) time.Time\n\tbudget      func(c Candidate) (bool, string)\n\theld        map[string]*Slot\n\tdemand      map[string]*loopDemand\n\tfirstDenied map[string]time.Time\n\tstarved     map[Class]bool\n}\n\n// New builds a pool, adopting o.Held.\nfunc New(o Options) *Pool {\n\tp := &Pool{\n\t\tmax:         max(1, o.Max),\n\t\tnow:         o.Now,\n\t\tlog:         o.Log,\n\t\tstarveAfter: o.StarveAfter,\n\t\tlimited:     o.Limited,\n\t\tbudget:      o.Budget,\n\t\theld:        map[string]*Slot{},\n\t\tdemand:      map[string]*loopDemand{},\n\t\tfirstDenied: map[string]time.Time{},\n\t\tstarved:     map[Class]bool{},\n\t}\n\tif p.now == nil {\n\t\tp.now = time.Now\n\t}\n\tif p.log == nil {\n\t\tp.log = slog.New(slog.NewTextHandler(io.Discard, nil))\n\t}\n\tif p.starveAfter == 0 {\n\t\tp.starveAfter = 24 * time.Hour\n\t}\n\tfor _, h := range o.Held {\n\t\tk := h.Candidate.Key()\n\t\tif p.held[k] != nil {\n\t\t\tp.log.Warn(\"pool.adopt_duplicate\", \"key\", k, \"job_id\", h.JobID)\n\t\t\tcontinue\n\t\t}\n\t\tp.held[k] = &Slot{pool: p, cand: h.Candidate, jobID: h.JobID, grantedAt: p.now(), adopted: true}\n\t}\n\tif len(p.held) > p.max {\n\t\tp.log.Warn(\"pool.adopt_over_max\", \"held\", len(p.held), \"max\", p.max)\n\t}\n\treturn p\n}\n\n// SetMax changes the cap. It never revokes held slots; n < 1 is treated as 1.\nfunc (p *Pool) SetMax(n int) {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\tp.max = max(1, n)\n}\n\n// Lookup returns the held slot for key, for close-out and the Reaper after a restart.\nfunc (p *Pool) Lookup(key string) (*Slot, bool) {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\ts, ok := p.held[key]\n\treturn s, ok\n}\n\ntype item struct {\n\tcand Candidate\n\tidx  int // index into decisions; -1 for foreign demand\n}\n\n// Offer ranks cands against held slots and other loops' live demand and\n// returns one Decision per candidate, in input order. It replaces loop's\n// demand entry, which expires ttl after this call (ttl <= 0 records none).\n// Loops must call Offer once per tick even with no candidates, so stale\n// demand clears.\nfunc (p *Pool) Offer(loop string, ttl time.Duration, cands []Candidate) []Decision {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\tnow := p.now()\n\tp.purgeLocked(now)\n\n\tfree0 := max(0, p.max-len(p.held))\n\tfree := free0\n\tdecisions := make([]Decision, len(cands))\n\ttriageHeld := map[int]bool{}\n\tfor _, s := range p.held {\n\t\tif s.cand.Class == ClassTriage {\n\t\t\ttriageHeld[s.cand.Number] = true\n\t\t}\n\t}\n\n\t// Validation and duplicates.\n\tinBatch := map[string]bool{}\n\tvar items []item\n\tfor i, c := range cands {\n\t\tdecisions[i].Candidate = c\n\t\tif why := c.invalid(); why != \"\" {\n\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedInvalid, why\n\t\t\tp.log.Warn(\"pool.invalid\", \"loop\", loop, \"class\", c.Class.String(), \"role\", c.Role, \"number\", c.Number, \"reason\", why)\n\t\t\tcontinue\n\t\t}\n\t\tk := c.Key()\n\t\tif p.held[k] != nil || inBatch[k] {\n\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedDuplicate, \"already held or offered earlier in this batch\"\n\t\t\tcontinue\n\t\t}\n\t\tif p.limited != nil {\n\t\t\tif until := p.limited(c); now.Before(until) {\n\t\t\t\tdecisions[i].Verdict = DeniedLimited\n\t\t\t\tdecisions[i].Reason = \"usage limit until \" + until.UTC().Format(\"15:04\") + \" UTC\"\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tif p.budget != nil {\n\t\t\tif denied, why := p.budget(c); denied {\n\t\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedBudget, why\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tinBatch[k] = true\n\t\titems = append(items, item{c, i})\n\t}\n\tfor _, c := range p.foreignLocked(loop, now, inBatch, triageHeld) {\n\t\titems = append(items, item{c, -1})\n\t}\n\tsort.Slice(items, func(a, b int) bool { return less(items[a].cand, items[b].cand) })\n\n\t// Walk the merged ranking.\n\treserved := 0\n\ttriageGranted := map[int]bool{}\n\tvar denied []Candidate\n\tcapDenied := 0\n\tfor _, it := range items {\n\t\tif it.idx < 0 {\n\t\t\tif free > 0 {\n\t\t\t\tfree--\n\t\t\t\treserved++\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\td := &decisions[it.idx]\n\t\tc := it.cand\n\t\tswitch {\n\t\tcase c.Class == ClassTriage && (triageHeld[c.Number] || triageGranted[c.Number]):\n\t\t\td.Verdict, d.Reason = DeniedIssueBusy, fmt.Sprintf(\"a triage job on #%d is already held\", c.Number)\n\t\tcase free > 0:\n\t\t\tfree--\n\t\t\ts := &Slot{pool: p, cand: c, grantedAt: now}\n\t\t\tp.held[c.Key()] = s\n\t\t\tif c.Class == ClassTriage {\n\t\t\t\ttriageGranted[c.Number] = true\n\t\t\t}\n\t\t\tdelete(p.firstDenied, c.Key())\n\t\t\tp.starved[c.Class] = false\n\t\t\td.Verdict, d.Slot = Granted, s\n\t\t\tp.log.Debug(\"pool.grant\", \"loop\", loop, \"key\", c.Key(), \"class\", c.Class.String(), \"role\", c.Role, \"number\", c.Number)\n\t\tcase capDenied < reserved:\n\t\t\tcapDenied++\n\t\t\td.Verdict, d.Reason = DeniedOutranked, fmt.Sprintf(\"outranked by %d higher-ranked waiting job(s)\", reserved)\n\t\t\tdenied = append(denied, c)\n\t\tdefault:\n\t\t\tcapDenied++\n\t\t\td.Verdict, d.Reason = DeniedFull, \"no free slot\"\n\t\t\tdenied = append(denied, c)\n\t\t}\n\t}\n\tp.setDemandLocked(loop, now, ttl, denied)\n\tp.checkStarvationLocked(now)\n\n\tif p.log.Enabled(context.Background(), slog.LevelDebug) {\n\t\tcounts := map[string]int{}\n\t\tfor _, d := range decisions {\n\t\t\tcounts[d.Verdict.String()]++\n\t\t}\n\t\tp.log.Debug(\"pool.offer\", \"loop\", loop, \"verdicts\", fmt.Sprint(counts), \"free_before\", free0, \"free_after\", max(0, p.max-len(p.held)))\n\t}\n\treturn decisions\n}\npackage pool\n\nimport \"time\"\n\n// Slot is a granted reservation, held from Offer until Release.\ntype Slot struct {\n\tpool      *Pool\n\tcand      Candidate\n\tjobID     string\n\tgrantedAt time.Time\n\treleased  bool\n\tadopted   bool\n}\n\n// Key returns the job key.\nfunc (s *Slot) Key() string { return s.cand.Key() }\n\n// Candidate returns the candidate the slot was granted to.\nfunc (s *Slot) Candidate() Candidate { return s.cand }\n\n// Adopted reports whether the slot was built from a job that was already\n// running when the pool was created (restart recovery), so no goroutine of\n// this process drives it. The Reaper closes such a job out itself.\nfunc (s *Slot) Adopted() bool { return s.adopted }\n\n// JobID returns the id set by SetJobID, or \"\".\nfunc (s *Slot) JobID() string {\n\ts.pool.mu.Lock()\n\tdefer s.pool.mu.Unlock()\n\treturn s.jobID\n}\n\n// SetJobID records the job's ULID once the loop has minted it. It is used\n// for logs and Stats only.\nfunc (s *Slot) SetJobID(id string) {\n\t