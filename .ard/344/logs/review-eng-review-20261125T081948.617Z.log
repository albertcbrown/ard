}\n992\t+\tvar sb strings.Builder\n993\t+\tfmt.Fprintf(&sb, \"--- %s (main)\\n+++ %s (starter)\\n\", name, name)\n994\t+\ti, j := 0, 0\n995\t+\tfor i < n || j < m {\n996\t+\t\tswitch {\n997\t+\t\tcase i < n && j < m && a[i] == b[j]:\n998\t+\t\t\tsb.WriteString(\" \" + a[i] + \"\\n\")\n999\t+\t\t\ti++\n1000\t+\t\t\tj++\n1001\t+\t\tcase j < m && (i == n || lcs[i][j+1] >= lcs[i+1][j]):\n1002\t+\t\t\tsb.WriteString(\"+\" + b[j] + \"\\n\")\n1003\t+\t\t\tj++\n1004\t+\t\tdefault:\n1005\t+\t\t\tsb.WriteString(\"-\" + a[i] + \"\\n\")\n1006\t+\t\t\ti++\n1007\t+\t\t}\n1008\t+\t}\n1009\t+\treturn sb.String()\n1010\t+}\n1011\t+\n1012\t+func splitLines(s string) []string {\n1013\t+\tif s == \"\" {\n1014\t+\t\treturn nil\n1015\t+\t}\n1016\t+\treturn strings.Split(strings.TrimSuffix(s, \"\\n\"), \"\\n\")\n1017\t+}\n1018\t+\n1019\t // overlay copies existing (files and directories) into a MapFS and lays files\n1020\t // on top, so config validation sees exactly the tree the PR would produce.\n1021\t // Directories are copied as well as files: an empty role directory on main\n1022\tdiff --git a/internal/initcmd/plan_test.go b/internal/initcmd/plan_test.go\n1023\tnew file mode 100644\n1024\tindex 0000000..a7883d9\n1025\t--- /dev/null\n1026\t+++ b/internal/initcmd/plan_test.go\n1027\t@@ -0,0 +1,202 @@\n1028\t+package initcmd\n1029\t+\n1030\t+import (\n1031\t+\t\"io/fs\"\n1032\t+\t\"slices\"\n1033\t+\t\"strings\"\n1034\t+\t\"testing\"\n1035\t+\t\"testing/fstest\"\n1036\t+\n1037\t+\t\"github.com/albertcbrown/ard/internal/committer\"\n1038\t+)\n1039\t+\n1040\t+func mf(data string, exec bool) *fstest.MapFile {\n1041\t+\tmode := fs.FileMode(0o644)\n1042\t+\tif exec {\n1043\t+\t\tmode = 0o755\n1044\t+\t}\n1045\t+\treturn &fstest.MapFile{Data: []byte(data), Mode: mode}\n1046\t+}\n1047\t+\n1048\t+func lockOf(kv ...string) Lock {\n1049\t+\tl := Lock{Files: map[string]string{}}\n1050\t+\tfor i := 0; i < len(kv); i += 2 {\n1051\t+\t\tl.Files[kv[i]] = hashOf([]byte(kv[i+1]))\n1052\t+\t}\n1053\t+\t