er deleted.\n896\t+\tDropped []string\n897\t+}\n898\t+\n899\t+// plan compares files with existing (main's config tree) and the lock. Per\n900\t+// file: a context doc is created only when absent; an absent file is created;\n901\t+// one identical to the starter (content and exec bit) is unchanged; one whose\n902\t+// hash equals its lock entry is updated; any other is edited and never\n903\t+// touched, with a diff of main against the starter. No lock or no entry means\n904\t+// edited.\n905\t+func plan(existing fs.FS, files []committer.InitFile, lock Lock) (Result, error) {\n906\t+\tres := Result{Ops: make([]op, 0, len(files))}\n907\t+\tinStarter := map[string]bool{}\n908\t \tfor _, f := range files {\n909\t+\t\tinStarter[f.Path] = true\n910\t \t\to := op{File: f, Act: actCreate}\n911\t \t\tfi, err := fs.Stat(existing, f.Path)\n912\t \t\tswitch {\n913\t@@ -80,42 +92,93 @@ func plan(existing fs.FS, files []committer.InitFile, force bool) ([]op, error)\n914\t \t\tcase err != nil:\n915\t \t\t\t// absent on main\n916\t \t\tcase fi.IsDir():\n917\t-\t\t\treturn nil, fmt.Errorf(\"%s is a directory on main\", f.Path)\n918\t+\t\t\treturn Result{}, fmt.Errorf(\"%s is a directory on main\", f.Path)\n919\t \t\tdefault:\n920\t \t\t\thave, err := fs.ReadFile(existing, f.Path)\n921\t \t\t\tif err != nil {\n922\t-\t\t\t\treturn nil, fmt.Errorf(\"read %s from main: %w\", f.Path, err)\n923\t+\t\t\t\treturn Result{}, fmt.Errorf(\"read %s from main: %w\", f.Path, err)\n924\t \t\t\t}\n925\t \t\t\thaveExec := fi.Mode()&0o111 != 0\n926\t-\t\t\tif bytes.Equal(have, f.Data) && haveExec == f.Exec {\n927\t+\t\t\tswitch want, ok := lock.Files[f.Path]; {\n928\t+\t\t\tcase bytes.Equal(have, f.Data) && haveExec == f.Exec:\n929\t \t\t\t\to.Act = actUnchanged\n930\t-\t\t\t} else {\n931\t-\t\t\t\to.Act = actOverwrite\n932\t-\t\t\t\tif !force {\n933\t-\t\t\t\t\tconflicts = append(conflicts, f.Path)\n934\t-\t\t\t\t}\n935\t+\t\t\tcase ok && want == hashOf(have):\n936\t+\t\t\t\to.Act = actUpdate\n937\