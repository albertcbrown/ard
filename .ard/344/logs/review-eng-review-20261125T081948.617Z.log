.files, tc.lock)\n1083\t+\t\t\tif err != nil {\n1084\t+\t\t\t\tt.Fatal(err)\n1085\t+\t\t\t}\n1086\t+\t\t\to := res.Ops[0]\n1087\t+\t\t\tif o.Act != tc.want || (o.Diff != \"\") != tc.diff {\n1088\t+\t\t\t\tt.Fatalf(\"act = %s diff = %q, want %s (diff %v)\", o.Act, o.Diff, tc.want, tc.diff)\n1089\t+\t\t\t}\n1090\t+\t\t\twrote := len(changed(res.Ops)) == 1\n1091\t+\t\t\tif wrote != (tc.want == actCreate || tc.want == actUpdate) {\n1092\t+\t\t\t\tt.Errorf(\"changed = %v\", changed(res.Ops))\n1093\t+\t\t\t}\n1094\t+\t\t})\n1095\t+\t}\n1096\t+\tt.Run(\"directory on main\", func(t *testing.T) {\n1097\t+\t\t_, err := plan(fstest.MapFS{p + \"/x\": mf(\"\", false)}, files, Lock{})\n1098\t+\t\tif err == nil || !strings.Contains(err.Error(), \"directory\") {\n1099\t+\t\t\tt.Errorf(\"err = %v\", err)\n1100\t+\t\t}\n1101\t+\t})\n1102\t+}\n1103\t+\n1104\t+func TestPlanEditedDiff(t *testing.T) {\n1105\t+\tfiles := []committer.InitFile{{Path: \".ard/a\", Data: []byte(\"one\\nthree\\nfour\\n\")}}\n1106\t+\tres, err := plan(fstest.MapFS{\".ard/a\": mf(\"one\\ntwo\\nthree\\n\", false)}, files, Lock{})\n1107\t+\tif err != nil {\n1108\t+\t\tt.Fatal(err)\n1109\t+\t}\n1110\t+\tfor _, w := range []string{\"--- .ard/a (main)\", \" one\\n\", \"-two\\n\", \" three\\n\", \"+four\\n\"} {\n1111\t+\t\tif !strings.Contains(res.Ops[0].Diff, w) {\n1112\t+\t\t\tt.Errorf(\"diff lacks %q:\\n%s\", w, res.Ops[0].Diff)\n1113\t+\t\t}\n1114\t+\t}\n1115\t+}\n1116\t+\n1117\t+func TestPlanContextDocs(t *testing.T) {\n1118\t+\tfiles := []committer.InitFile{{Path: \".ard/PRODUCT.md\", Data: []byte(\"starter\\n\")}}\n1119\t+\tlock := lockOf(\".ard/PRODUCT.md\", \"old\\n\")\n1120\t+\tres, _ := plan(fstest.MapFS{}, files, lock)\n1121\t+\tif res.Ops[0].Act != actCreate {\n1122\t+\t\tt.Errorf(\"absent: %s\", res.Ops[0].Act)\n1123\t+\t}\n1124\t+\t// edited, or matching its lock entry: never updated\n1125\t+\tfor _, c := range []string{\"mine\\n\", \"old\\n\"} {\n1126\t+\t\tres, err := plan(fstest.MapFS{\".ard/PRODUCT.m