s, k)\n\t\t}\n\t\tsort.Strings(keys)\n\t\tfor _, k := range keys {\n\t\t\ts, ok := m[k].(string)\n\t\t\tif !ok || !sha256Re.MatchString(s) || committer.CheckInitPath(k) != nil {\n\t\t\t\twarns = append(warns, fmt.Sprintf(\"%s: ignoring entry %q\", LockPath, k))\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tl.Files[k] = s\n\t\t}\n\tdefault:\n\t\twarns = append(warns, LockPath+\": files is not a mapping; ignored\")\n\t}\n\treturn l, warns\n}\n\n// Marshal renders the lock with sorted keys.\nfunc (l Lock) Marshal() ([]byte, error) {\n\tfiles := l.Files\n\tif files == nil {\n\t\tfiles = map[string]string{}\n\t}\n\tout, err := yaml.Marshal(Lock{Version: l.Version, Files: files})\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"encode %s: %w\", LockPath, err)\n\t}\n\treturn append([]byte(\"# Written by ard init: sha256 of each starter file it wrote. Do not edit.\\n\"), out...), nil\n}\n\n// withLock returns old updated with the starter hash of each created or\n// updated file. Entries for other files are kept as they were.\nfunc withLock(old Lock, ops []op, version string) Lock {\n\tn := Lock{Version: old.Version, Files: map[string]string{}}\n\tfor k, v := range old.Files {\n\t\tn.Files[k] = v\n\t}\n\tfor _, o := range ops {\n\t\tif o.Act == actCreate || o.Act == actUpdate {\n\t\t\tn.Files[o.File.Path] = hashOf(o.File.Data)\n\t\t}\n\t}\n\tn.Version = version\n\treturn n\n}\nE\npython3 - <<'E'\np='internal/initcmd/plan.go'\ns=open(p).read()\na=s.index('// plan compares'); b=s.index('// overlay copies')\nnew='''// Result is the plan for one run.\ntype Result struct {\n\tOps []op\n\t// Dropped lists files the lock records that the starter no longer ships.\n\t// They are reported and never deleted.\n\tDropped []string\n}\n\n// plan compares files with existing (main's config tree) and the lock. Per\n// file: a context doc is created only when absent; an absent file is created;\n// one identical to the starter (content and exec bit) is unchanged; one whose\n// hash equals its lock entry is updated; any other is edited and never\n// touched, with a diff of main against the starter. No lock or no entry means\n// edited.\nfunc plan(existing fs.FS, files []committer.InitFile, lock Lock) (Result, error) {\n\tres := Result{Ops: make([]op, 0, len(files))}\n\tinStarter := map[string]bool{}\n\tfor _, f := range files {\n\t\tinStarter[f.Path] = true\n\t\to := op{File: f, Act: actCreate}\n\t\tfi, err := fs.Stat(existing, f.Path)\n\t\tswitch {\n\t\tcase err == nil && slices.Contains(ContextPaths(), f.Path):\n\t\t\t// create-if-absent: present in any form is left alone\n\t\t\to.Act = actUnchanged\n\t\tcase err != nil:\n\t\t\t// absent on main\n\t\tcase fi.IsDir():\n\t\t\treturn Result{}, fmt.Errorf(\"%s is a directory on main\", f.Path)\n\t\tdefault:\n\t\t\thave, err := fs.ReadFile(existing, f.Path)\n\t\t\tif err != nil {\n\t\t\t\treturn Result{}, fmt.Errorf(\"read %s from main: %w\", f.Path, err)\n\t\t\t}\n\t\t\thaveExec := fi.Mode()&0o111 != 0\n\t\t\tswitch want, ok := lock.Files[f.Path]; {\n\t\t\tcase bytes.Equal(have, f.Data) && haveExec == f.Exec:\n\t\t\t\to.Act = actUnchanged\n\t\t\tcase ok && want == hashOf(have):\n\t\t\t\to.Act = actUpdate\n\t\t\tdefault:\n\t\t\t\to.Act = actEdited\n\t\t\t\to.Diff = unifiedDiff(f.Path, string(have), string(f.Data))\n\t\t\t}\n\t\t}\n\t\tres.Ops = append(res.Ops, o)\n\t}\n\tfor p := range lock.Files {\n\t\tif !inStarter[p] && !slices.Contains(ContextPaths(), p) {\n\t\t\tres.Dropped = append(res.Dropped, p)\n\t\t}\n\t}\n\tsort.Strings(res.Dropped)\n\treturn res, nil\n}\n\n// changed returns the files the PR adds or updates.\nfunc changed(ops []op) []committer.InitFile {\n\tvar out []committer.InitFile\n\tfor _, o := range ops {\n\t\tif o.Act == actCreate || o.Act == actUpdate {\n\t\t\tout = append(out, o.File)\n\t\t}\n\t}\n\treturn out\n}\n\n// unifiedDiff is a plain line diff (LCS) of have against want, with the whole\n// file as one hunk. It is for the operator to read, not to apply.\nfunc unifiedDiff(name, have, want string) string {\n\ta, b := splitLines(have), splitLines(want)\n\tn, m := len(a), len(b)\n\tif n*m > 4_000_000 {\n\t\treturn fmt.Sprintf(\"--- %s (main)\\\\n+++ %s (starter)\\\\n(too large to diff)\\\\n\", name, name)\n\t}\n\tlcs := make([][]int, n+1)\n\tfor i := range lcs {\n\t\tlcs[i] = make([]int, m+1)\n\t}\n\tfor i := n - 1; i >= 0; i-- {\n\t\tfor j := m - 1; j >= 0; j-- {\n\t\t\tif a[i] == b[j] {\n\t\t\t\tlcs[i][j] = lcs[i+1][j+1] + 1\n\t\t\t} else {\n\t\t\t\tlcs[i][j] = max(lcs[i+1][j], lcs[i][j+1])\n\t\t\t}\n\t\t}\n\t}\n\tvar sb strings.Builder\n\tfmt.Fprintf(&sb, \"--- %s (main)\\\\n+++ %s (starter)\\\\n\", name, name)\n\ti, j := 0, 0\n\tfor i < n || j < m {\n\t\tswitch {\n\t\tcase i < n && j < m && a[i] == b[j]:\n\t\t\tsb.WriteString(\" \" + a[i] + \"\\\\n\")\n\t\t\ti++\n\t\t\tj++\n\t\tcase j < m && (i == n || lcs[i][j+1] >= lcs[i+1][j]):\n\t\t\tsb.WriteString(\"+\" + b[j] + \"\\\\n\")\n\t\t\tj++\n\t\tdefault:\n\t\t\tsb.WriteString(\"-\" + a[i] + \"\\\\n\")\n\t\t\ti++\n\t\t}\n\t}\n\treturn sb.String()\n}\n\nfunc splitLines(s string) []string {\n\tif s == \"\" {\n\t\treturn nil\n\t}\n\treturn strings.Split(strings.TrimSuffix(s, \"\\\\n\"), \"\\\\n\")\n}\n\n'''\ns=s[:a]+new+s[b:]\ns=s.replace('''\tactOverwrite action = \"overwrite\"\n''','''\tactUpdate    action = \"update\"\n\tactEdited    action = \"edited\" // differs from the starter and from the lock: left alone\n''')\ns=s.replace('''only when it is missing on main: it never overwrites one or reports a\n// conflict, even with --force.''','''only when it is missing on main: it never updates one, whatever the lock says.''')\ns=s.replace('\tFile committer.InitFile\\n\tAct  action\\n','\tFile committer.InitFile\\n\tAct  action\\n\tDiff string // actEdited: main against the starter\\n')\ns=s.replace('\t\"path\"\\n','\t\"path\"\\n\t\"sort\"\\n')\nopen(p,'w').write(s)\nE"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_crea