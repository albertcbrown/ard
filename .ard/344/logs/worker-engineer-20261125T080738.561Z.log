!= nil {\n\t\treturn Result{}, err\n\t}\n\tif err := CheckStaged(declared, changes); err != nil {\n\t\treturn Result{}, err\n\t}\n\tge := &GuardError{}\n\tfor _, c := range changes {\n\t\tif want := modeOf(wantExec[c.Path]); c.NewMode != want {\n\t\t\tge.add(c.Path, fmt.Sprintf(\"staged mode %s, want %s\", c.NewMode, want))\n\t\t}\n\t}\n\tif len(ge.Paths) > 0 {\n\t\treturn Result{}, ge\n\t}\n\tif len(changes) == 0 {\n\t\treturn Result{SHA: base, NoOp: true}, nil\n\t}\n\tcr, err := i.c.fx.Commit(ctx, effects.CommitOp{Dir: i.wt, Message: InitMessage, Author: i.c.author})\n\tif errors.Is(err, effects.ErrNothingToCommit) {\n\t\treturn Result{SHA: base, NoOp: true}, nil\n\t}\n\tif err != nil {\n\t\treturn Result{}, err\n\t}\n\terr = i.c.fx.Push(ctx, effects.PushOp{Dir: i.wt, Remote: i.c.cfg.RemoteURL, Ref: \"HEAD:refs/heads/\" + InitBranch,\n\t\tForceWithLease: strings.Repeat(\"0\", len(base)), Token: i.c.cfg.Token})\n\tswitch {\n\tcase errors.Is(err, effects.ErrNonFastForward), errors.Is(err, effects.ErrStaleLease):\n\t\treturn Result{}, fmt.Errorf(\"%w: %v\", ErrInitExists, err)\n\tcase err != nil:\n\t\treturn Result{}, err\n\t}\n\treturn Result{SHA: cr.SHA, Synthetic: cr.Synthetic, Attempts: 1}, nil\n}\n\nfunc modeOf(exec bool) string {\n\tif exec {\n\t\treturn \"100755\"\n\t}\n\treturn \"100644\"\n}\n\n// validateInit checks the file set and returns its sorted paths and the\n// expected exec bit of each.\nfunc validateInit(files []InitFile) (declared []string, wantExec map[string]bool, err error) {\n\tswitch {\n\tcase len(files) == 0:\n\t\treturn nil, nil, fmt.Errorf(\"%w: no files\", ErrInvalid)\n\tcase len(files) > MaxFiles:\n\t\treturn nil, nil, fmt.Errorf(\"%w: %d files, max %d\", ErrInvalid, len(files), MaxFiles)\n\t}\n\tge := &GuardError{}\n\twantExec = make(map[string]bool, len(files))\n\tfor _, f := range files {\n\t\tif perr := CheckInitPath(f.Path); perr != nil {\n\t\t\tge.add(f.Path, perr.Error())\n\t\t\tcontinue\n\t\t}\n\t\tif _, dup := wantExec[f.Path]; dup {\n\t\t\treturn nil, nil, fmt.Errorf(\"%w: duplicate path %q\", ErrInvalid, f.Path)\n\t\t}\n\t\tif len(f.Data) > MaxFileBytes {\n\t\t\tge.add(f.Path, \"larger than 1 MiB\")\n\t\t\tcontinue\n\t\t}\n\t\twantExec[f.Path] = f.Exec\n\t\tdeclared = append(declared, f.Path)\n\t}\n\tif len(ge.Paths) > 0 {\n\t\treturn nil, nil, ge\n\t}\n\tsort.Strings(declared)\n\treturn declared, wantExec, nil\n}\n../cli/app.go:56:\tForce bool\n../cli/cmd_init.go:10:\tvar force bool\n../cli/cmd_init.go:20:\t\t\t\treturn app.Handlers.Init(ctx, e, InitOpts{Force: force})\n../cli/cmd_init.go:24:\tcmd.Flags().BoolVar(&force, \"force\", false, \"propose starter files even where main has different contents (never deletes)\")","is_error":false}]},"parent_tool_use_id":null,"session_id":"b9fc659e-2b79-4850-b189-0bda8f59ffda","uuid":"0d53b6ea-d51c-4b4f-99c4-12e6dc2b0c00","timestamp":"2026-11-25T08:07:42.728Z","tool_use_result":{"stdout":"      48 body.go\n     252 initcmd.go\n     675 initcmd_test.go\n     159 plan.go\n    1134 total\npackage initcmd\n\nimport (\n\t\"bytes\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"path\"\n\t\"slices\"\n\t\"strings\"\n\t\"testing/fstest\"\n\n\t\"github.com/albertcbrown/ard/internal/committer\"\n\t\"github.com/albertcbrown/ard/internal/roles\"\n)\n\n// action says what the PR does to one path on main.\ntype action string\n\nconst (\n\tactCreate    action = \"add\"\n\tactUnchanged action = \"unchanged\"\n\tactOverwrite action = \"overwrite\"\n)\n\n// ContextPaths are the optional repo context docs. ard init proposes each\n// only when it is missing on main: it never overwrites one or reports a\n// conflict, even with --force.\nfunc ContextPaths() []string {\n\treturn []string{\".ard/PRODUCT.md\", \".ard/VISION.md\", \".ard/TECH_STACK.md\"}\n}\n\n// op is one starter file and what proposing it does.\ntype op struct {\n\tFile committer.InitFile\n\tAct  action\n}\n\n// starter lists the embedded tree as files under .ard/, in sorted path\n// order. Files named in roles.ExecutableNames are executable.\nfunc starter() ([]committer.InitFile, error) {\n\tvar files []committer.InitFile\n\terr := fs.WalkDir(roles.FS, \".\", func(p string, d fs.DirEntry, err error) error {\n\t\tif err != nil || d.IsDir() {\n\t\t\treturn err\n\t\t}\n\t\tdata, err := roles.FS.ReadFile(p)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tfiles = append(files, committer.InitFile{\n\t\t\tPath: \".ard/\" + p,\n\t\t\tData: data,\n\t\t\tExec: slices.Contains(roles.ExecutableNames, path.Base(p)),\n\t\t})\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"read starter files: %w\", err)\n\t}\n\t// WalkDir sorts by entry name, so \"trufflehog/\" would precede \"trufflehog-history/\".\n\tslices.SortFunc(files, func(a, b committer.InitFile) int { return strings.Compare(a.Path, b.Path) })\n\treturn files, nil\n}\n\n// plan compares files with existing (main's config tree) and assigns each a\n// create, unchanged or overwrite action. A context doc (ContextPaths) that\n// exists on main in any form is unchanged, whatever force is. A file that differs without force is\n// a conflict; the error names every such path. A different exec bit counts as\n// a difference.\nfunc plan(existing fs.FS, files []committer.InitFile, force bool) ([]op, error) {\n\tops := make([]op, 0, len(files))\n\tvar conflicts []string\n\tfor _, f := range files {\n\t\to := op{File: f, Act: actCreate}\n\t\tfi, err := fs.Stat(existing, f.Path)\n\t\tswitch {\n\t\tcase err == nil && slices.Contains(ContextPaths(), f.Path):\n\t\t\t// create-if-absent: present in any form is left alone\n\t\t\to.Act = actUnchanged\n\t\tcase err != nil:\n\t\t\t// absent on main\n\t\tcase fi.IsDir():\n\t\t\treturn nil, fmt.Errorf(\"%s is a directory on main\", f.Path)\n\t\tdefault:\n\t\t\thave, err := fs.ReadFile(existing, f.Path)\n\t\t\tif err != nil {\n\t\t\t\treturn nil, fmt.Errorf(\"read %s from main: %w\", f.Path, err)\n\t\t\t}\n\t\t\thaveExec := fi.Mode()&0o111 != 0\n\t\t\tif bytes.Equal(have, f.Data) && haveExec == f.Exec {\n\t\t\t\to.Act = actUnchanged\n\t\t\t} else {\n\t\t\t\to.Act = actOverwrite\n\t\t\t\tif !force {\n\t\t\t\t\tconflicts = append(conflicts, f.Path)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tops = append(ops, o)\n\t}\n\tif len(conflicts) > 0 {\n\t\treturn nil, fmt.Errorf(\"main already has different contents at %s; rerun with --force to propose overwriting them\",\n\t\t\tstrings.Join(conflicts, \", \"))\n\t}\n\treturn ops, nil\n}\n\n// changed returns the files the PR adds or overwrites.\nfunc changed(ops []op) []committer.InitFile {\n\tvar out []committer.InitFile\n\tfor _, o := range ops {\n\t\tif o.Act != actUnchanged {\n\t\t\tout = append(out, o.File)\n\t\t}\n\t}\n\treturn out\n}\n\n// overlay copies existing (files and directories) into a MapFS and lays files\n// on top, so config validation sees exactly the tree the PR would produce.\n// Directories are copied as well as files: an empty role directory on main\n// must still fail validation.\nfunc overlay(existing fs.FS, files []committer.InitFile) (fstest.MapFS, error) {\n\tm := fstest.MapFS{}\n\terr := fs.WalkDir(existing, \".\", func(p string, d fs.DirEntry, err error) error {\n\t\tif err != nil || p == \".\" {\n\t\t\treturn err\n\t\t}\n\t\tfi, err := d.Info()\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif d.IsDir() {\n\t\t\tm[p] = &fstest.MapFile{Mode: fs.ModeDir | 0o755}\n\t\t\treturn nil\n\t\t}\n\t\tdata, err := fs.ReadFile(existing, p)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tmode := fs.FileMode(0o644)\n\t\tif fi.Mode()&0o111 != 0 {\n\t\t\tmode = 0o755\n\t\t}\n\t\tm[p] = &fstest.MapFile{Data: data, Mode: mode}\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"read main's config tree: %w\", err)\n\t}\n\tfor _, f := range files {\n\t\tmode := fs.FileMode(0o644)\n\t\tif f.Exec {\n\t\t\tmode = 0o755\n\t\t}\n\t\tm[f.Path] = &fstest.MapFile{Data: f.Data, Mode: mode}\n\t}\n\treturn m, nil\n}\n// Package initcmd implements `ard init`: propose the starter .ard/ tree\n// (internal/roles.FS) as a PR on branch ard-init, and sync the label\n// catalogue. It never writes the working tree or main.\npackage initcmd\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/cli\"\n\t\"github.com/albertcbrown/ard/internal/committer\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/effects\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n\t\"github.com/albertcbrown/ard/internal/labels/labelsync\"\n)\n\n// prTitle is the title of the PR init opens.\nconst prTitle = \"ard init: starter .ard/ configuration\"\n\n// deps is what run needs from the outside; tests supply the GitHub fake,\n// effects.NewLive(fake, gitx.New(\"\"), log) and a file:// remote.\ntype deps struct {\n\tRepo      github.Repo\n\tReader    github.Reader\n\tEffects   effects.Effects\n\tRemoteURL string\n\tToken     gitx.TokenFunc\n\tClose     func() error // optional\n}\n\n// Init is the handler behind `ard init`.\nfunc Init(ctx context.Context, e *cli.Env, o cli.InitOpts) error {\n\treturn run(ctx, e, o, func(ctx context.Context, root string) (deps, error) {\n\t\trepo, err := resolveRepo(ctx, e.Repo, root)\n\t\tif err != nil {\n\t\t\treturn deps{}, err\n\t\t}\n\t\tauth, err := github.AuthFromEnv(os.Getenv, os.ReadFile)\n\t\tif err != nil {\n\t\t\treturn deps{}, fmt.Errorf(\"ard init: %w\", err)\n\t\t}\n\t\tif err := checkAuth(auth.Kind(), e.DryRun); err != nil {\n\t\t\treturn deps{}, err\n\t\t}\n\t\tfx, rd, err := effects.Open(ctx, effects.Options{\n\t\t\tDryRun: e.DryRun,\n\t\t\tGitHub: github.Config{Repo: repo, Auth: auth, Log: e.Log},\n\t\t\tLog:    e.Log,\n\t\t})\n\t\tif err != nil {\n\t\t\treturn deps{}, fmt.Errorf(\"ard init: %w\", err)\n\t\t}\n\t\td := deps{Repo: repo, Reader: rd, Effects: fx, Token: auth.Token, RemoteURL: fmt.Sprintf(\"https://github.com/%s.git\", repo)}\n\t\tif c, ok := fx.(interface{ Close() error }); ok {\n\t\t\td.Close = c.Close\n\t\t}\n\t\treturn d, nil\n\t})\n}\n\n// checkAuth refuses a personal token for a live run, as serve does.\nfunc checkAuth(kind github.AuthKind, dryRun bool) error {\n\tif kind == github.AuthToken && !dryRun {\n\t\treturn errors.New(\"ard init: ARD_GITHUB_TOKEN auth is for --dry-run only; configure a GitHub App\")\n\t}\n\treturn nil\n}\n\n// resolveRepo takes --repo, or falls back to the origin remote of root. Its\n// errors never include the remote URL, which may embed a token.\nfunc resolveRepo(ctx context.Context, flag, root string) (github.Repo, error) {\n\tif flag != \"\" {\n\t\tr, err := github.ParseRepo(flag)\n\t\tif err != nil {\n\t\t\treturn github.Repo{}, fmt.Errorf(\"ard init: %w\", err)\n\t\t}\n\t\treturn r, nil\n\t}\n\turl, err := gitx.New(\"\").RemoteURL(ctx, root, \"origin\")\n\tif err != nil {\n\t\treturn github.Repo{}, errors.New(\"ard init: --repo owner/repo is required (no origin remote to fall back on)\")\n\t}\n\tr, err := github.RepoFromRemote(url)\n\tif err != nil {\n\t\treturn github.Repo{}, errors.New(\"ard init: --repo owner/repo is required (origin remote is not a github.com owner/repo URL)\")\n\t}\n\treturn r, nil\n}\n\n// run does every check before any write; see the order in the comments.\nfunc run(ctx context.Context, e *cli.Env, o cli.InitOpts, open func(ctx context.Context, root string) (deps, error)) error {\n\t// 1. The checkout is only the object store and the origin fallback.\n\troot, err := config.RepoRoot(e.ConfigPath)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tif root, err = filepath.Abs(root); err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tif _, err := os.Stat(filepath.Join(root, \".git\")); err != nil {\n\t\treturn fmt.Errorf(\"ard init: %s is not the root of a git repository (run it there, or pass --config <repo>/.ard/config.yaml)\", root)\n\t}\n\t// 2-3. Repo and credentials.\n\td, err := open(ctx, root)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif d.Close != nil {\n\t\tdefer d.Close()\n\t}\n\t// 4. Who commits.\n\tid, err := d.Reader.Identity(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: identify github user: %w\", err)\n\t}\n\n\ttmp, err := os.MkdirTemp(\"\", \"ard-init-\")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tdefer os.RemoveAll(tmp)\n\n\t// 5. Fetch main; refuse while ard-init exists.\n\tin, err := committer.NewInit(ctx, committer.Config{\n\t\tRepoDir: root, WorkDir: filepath.Join(tmp, \"work\"), RemoteURL: d.RemoteURL,\n\t\tBot: id, Token: d.Token, Log: e.Log,\n\t}, d.Effects, nil)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tbase, err := in.Base(ctx)\n\tswitch {\n\tcase errors.Is(err, committer.ErrInitExists):\n\t\treturn initExistsErr(ctx, d)\n\tcase errors.Is(err, committer.ErrBranchGone):\n\t\treturn fmt.Errorf(\"ard init: %s has no main branch; push an initial commit first\", d.Repo)\n\tcase err != nil:\n\t\treturn fmt.Errorf(\"ard init: fetch main: %w\", err)\n\t}\n\n\t// 6. Plan against main, then validate the result.\n\tfiles, err := starter()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tsnap := filepath.Join(tmp, \"main\")\n\tif err := gitx.New(\"\").ExportPaths(ctx, root, base, snap, append(config.SourcePaths(), ContextPaths()...)...); err != nil {\n\t\treturn fmt.Errorf(\"ard init: read main's .ard/: %w\", err)\n\t}\n\texisting := os.DirFS(snap)\n\tops, err := plan(existing, files, o.Force)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tmerged, err := overlay(existing, changed(ops))\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tres, err := config.LoadFS(merged, root)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: the resulting configuration is invalid, nothing was written:\\n%w\", err)\n\t}\n\twant, err := labels.Desired(labels.SpecFrom(res))\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\n\t// 7. Labels first: a failure leaves nothing pushed, so a rerun is clean.\n\trep, err := labelsync.Sync(ctx, d.Reader, d.Effects, want, e.Log)\n\tif err != nil && rep.Failed == nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tlabelsync.Print(e.Stdout, rep, e.DryRun)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\n\t// 8. Propose.\n\ttoWrite := changed(ops)\n\tvar pr github.PullRequest\n\tif len(toWrite) > 0 {\n\t\tpres, err := in.Propose(ctx, base, toWrite)\n\t\tswitch {\n\t\tcase errors.Is(err, committer.ErrInitExists):\n\t\t\treturn initExistsErr(ctx, d)\n\t\tcase err != nil:\n\t\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t\tcase pres.NoOp:\n\t\t\ttoWrite = nil\n\t\t}\n\t}\n\tif len(toWrite) == 0 {\n\t\tfmt.Fprintln(e.Stdout, \"nothing to propose: main already has the starter files\")\n\t\te.Log.InfoContext(ctx, \"init.done\", \"repo\", d.Repo.String(), \"base\", base, \"files\", 0, \"pr\", 0, \"dry_run\", e.DryRun)\n\t\treturn nil\n\t}\n\tprintOps(e, ops)\n\n\t// 9. Open the PR.\n\tpr, err = d.Effects.CreatePR(ctx, github.NewPR{\n\t\tTitle: prTitle, Body: initBody(ops, res), Head: committer.InitBranch, Base: \"main\",\n\t})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: branch %s pushed but opening the PR failed: %w; open it by hand, or delete the branch and rerun\", committer.InitBranch, err)\n\t}\n\n\t// 10. Report.\n\tif e.DryRun {\n\t\tfmt.Fprintf(e.Stdout, \"dry-run: would open a PR from %s\\n\", committer.InitBranch)\n\t} else {\n\t\tfmt.Fprintf(e.Stdout, \"opened PR #%d: %s\\n\", pr.Number, pr.URL)\n\t}\n\te.Log.InfoContext(ctx, \"init.done\", \"repo\", d.Repo.String(), \"base\", base, \"files\", len(toWrite), \"pr\", pr.Number, \"dry_run\", e.DryRun)\n\treturn nil\n}\n\n// printOps writes one line per file the PR adds or overwrites.\nfunc printOps(e *cli.Env, ops []op) {\n\tfor _, o := range ops {\n\t\tif o.Act == actUnchanged {\n\t\t\tcontinue\n\t\t}\n\t\tverb := string(o.Act)\n\t\tif e.DryRun {\n\t\t\tverb = \"would \" + verb\n\t\t} else {\n\t\t\tverb += \" \"\n\t\t}\n\t\tmode := \"\"\n\t\tif o.File.Exec {\n\t\t\tmode = \" (0755)\"\n\t\t}\n\t\tfmt.Fprintf(e.Stdout, \"%s %s%s\\n\", verb, o.File.Path, mode)\n\t}\n}\n\n// initExistsErr is the refusal when ard-init is already on the remote. It\n// names the open PR when there is one.\nfunc initExistsErr(ctx context.Context, d deps) error {\n\tmsg := \"ard init: branch ard-init already exists on the remote\"\n\tif prs, err := d.Reader.ListPRs(ctx, github.ListPRsOpts{Head: committer.InitBranch, State: github.StateOpen}); err == nil && len(prs) > 0 {\n\t\tmsg += fmt.Sprintf(\" (open PR #%d)\", prs[0].Number)\n\t}\n\treturn errors.New(strings.TrimSpace(msg) + \"; merge or close it and delete the branch, then rerun\")\n}\npackage initcmd\n\nimport (\n\t\"fmt\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n)\n\n// initBody is the PR description. It is fixed text built from the file list\n// and the validated protected paths, with no issue or comment text in it.\nfunc initBody(ops []op, res *config.Resolved) string {\n\tvar b strings.Builder\n\tb.WriteString(\"This PR adds the starter `.ard/` directory proposed by `ard init`.\\n\\n\")\n\tb.WriteString(\"## Files\\n\\n\")\n\tfor _, o := range ops {\n\t\tif o.Act == actUnchanged {\n\t\t\tcontinue\n\t\t}\n\t\tmode := \"\"\n\t\tif o.File.Exec {\n\t\t\tmode = \" (executable)\"\n\t\t}\n\t\tfmt.Fprintf(&b, \"- %s `%s`%s\\n\", o.Act, o.File.Path, mode)\n\t}\n\tb.WriteString(\"\\n## Protected paths\\n\\nA pull request touching any of these waits for a human approval:\\n\\n\")\n\tfor _, p := range res.ProtectedPaths {\n\t\tfmt.Fprintf(&b, \"- `%s`\\n\", p)\n\t}\n\tb.WriteString(\"\\n## Before you merge\\n\\n\")\n\tb.WriteString(\"- Nothing takes effect until this is merged: ard serve reads its configuration from origin/main.\\n\")\n\tb.WriteString(\"- Merge with **Squash and merge** (recommended); **Create a merge commit** is also safe. Never fast-forward this branch into main from the command line: the bot-commit check reads main's first-parent history and would fail on the bot's commit.\\n\")\n\tb.WriteString(\"- If this repository already has an `.ard/config.yaml`, this PR does not edit it: add `.ard/PRODUCT.md`, `.ard/VISION.md` and `.ard/TECH_STACK.md` to `merge.protected_paths` yourself, so a PR cannot change them without a human approval.\\n\")\n\tfor _, o := range ops {\n\t\tif o.File.Path == \".ard/scanners/lint/scan\" {\n\t\t\tb.WriteString(\"- The lint scanner fails until you commit `.ard/scanners/lint/baseline`: run the command in `.ard/scanners/lint/Dockerfile`'s header (an empty file means no baseline).\\n\")\n\t\t\tbreak\n\t\t}\n\t}\n\tb.WriteString(\"- `scanners/trufflehog` is included. It files leaked-credential issues for a human (never for an agent) and needs a TruffleHog binary (AGPL-3.0; it is installed by the role's Dockerfile or taken from the host, and is not in the ard image). To opt out, delete `.ard/scanners/trufflehog/` and its `scanners/trufflehog` line under `overrides:` in `.ard/config.yaml` before merging.\\n\")\n\tb.WriteString(\"- `scanners/trufflehog-history` is included. It scans the full git history weekly for leaked credentials, with the same fingerprints as `scanners/trufflehog`, and its issues never autoclose. It reads the controller's clone through a read-only mount and needs the same TruffleHog binary. To opt out, delete `.ard/scanners/trufflehog-history/` and its `scanners/trufflehog-history` line under `overrides:` in `.ard/config.yaml` before merging.\\n\")\n\tb.WriteString(\"\\n## Follow-up the App cannot do\\n\\n\")\n\tb.WriteString(\"ard's GitHub App has no permission to write `.github/`, so do this by hand:\\n\\n\")\n\tb.WriteString(\"1. Copy `.github/workflows/bot-commits.yml` from the ard repository into this repository.\\n\")\n\tb.WriteString(\"2. Set the repository variable `ARD_BOT_LOGIN` to the App's `<slug>[bot]` login.\\n\")\n\tb.WriteString(\"3. Optionally set the repository variable `ARD_BOT_CHECK_SINCE`.\\n\")\n\treturn b.String()\n}\npackage committer\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/effects\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n)\n\n// InitBranch is the only branch Init commits to.\nconst InitBranch = \"ard-init\"\n\n// InitMessage is the fixed commit message. It has no [skip ci], because CI\n// must run on the PR.\nconst InitMessage = \"ard(init): add starter .ard/ configuration\"\n\n// InitFile is one starter file. Exec commits it as 100755.\ntype InitFile struct {\n\tPath string // canonical repo-relative slash path; see CheckInitPath\n\tData []byte\n\tExec bool\n}\n\nvar initPathRe = regexp.MustCompile(`^\\.ard/(?:config\\.yaml|PRODUCT\\.md|VISION\\.md|TECH_STACK\\.md|(?:scanners|triage|workers|reviewers)/([a-z0-9][a-z0-9-]*)/[^/]+(?:/[^/]+)*)$`)\n\n// CheckInitPath reports why p may not be proposed by ard init, or nil. It\n// accepts exactly .ard/config.yaml, the repo context docs .ard/PRODUCT.md, .ard/VISION.md and .ard/TECH_STACK.md, and files under\n// .ard/{scanners,triage,workers,reviewers}/<role>/, where <role> matches the\n// role-name rule and is not all digits. It applies CheckPath's checks for\n// empty, canonical, backslash, control characters and .git segments. It\n// rejects .ard/<issue#>/ and everything outside .ard/.\nfunc CheckInitPath(p string) error {\n\tif p == \"\" {\n\t\treturn reason(\"empty path\")\n\t}\n\tfor _, r := range p {\n\t\tif r == '\\\\' || r < 0x20 || r == 0x7f {\n\t\t\treturn reason(\"backslash or control character\")\n\t\t}\n\t}\n\tif path.Clean(p) != p {\n\t\treturn reason(\"not canonical\")\n\t}\n\tfor _, seg := range strings.Split(p, \"/\") {\n\t\tif strings.EqualFold(seg, \".git\") {\n\t\t\treturn reason(\"contains .git\")\n\t\t}\n\t}\n\tm := initPathRe.FindStringSubmatch(p)\n\tif m == nil {\n\t\treturn reason(\"not .ard/config.yaml, a context doc or a file under a role directory\")\n\t}\n\tif m[1] != \"\" && strings.Trim(m[1], \"0123456789\") == \"\" {\n\t\treturn reason(\"numeric role name\")\n\t}\n\treturn nil\n}\n\n// Init proposes the starter tree on InitBranch, cut from the base branch\n// (cfg.Branch, default \"main\"). Each Propose is one attempt: there is no\n// retry loop and no force push. It is a separate lane from the main\n// committer, which still writes only .ard/<issue#>/.\ntype Init struct {\n\tc    *core\n\tbase string\n\twt   string\n}\n\n// NewInit validates cfg and checks the git version the way NewMain does.\n// cfg.Bot is required unless fx.DryRun().\nfunc NewInit(ctx context.Context, cfg Config, fx Effects, g *gitx.Git) (*Init, error) {\n\tc, err := newCore(cfg, fx, g, false)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tmajor, minor, err := c.g.Version(ctx)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif major < 2 || (major == 2 && minor < 32) {\n\t\treturn nil, fmt.Errorf(\"git %d.%d is too old: 2.32 or later is required\", major, minor)\n\t}\n\tbase := cfg.Branch\n\tif base == \"\" {\n\t\tbase = \"main\"\n\t}\n\treturn &Init{c: c, base: base, wt: filepath.Join(cfg.WorkDir, \"committer-init\")}, nil\n}\n\n// Base fetches the base branch into refs/ard/upstream/<base> and returns its\n// SHA. It returns ErrInitExists if InitBranch exists on the remote, and\n// ErrBranchGone (naming the base) if the base branch does not exist.\nfunc (i *Init) Base(ctx context.Context) (string, error) {\n\tcfg := i.c.cfg\n\tspec := \"+refs/heads/\" + i.base + \":\" + upstreamRef(i.base)\n\tif err := i.c.g.FetchRef(ctx, cfg.RepoDir, cfg.RemoteURL, spec, cfg.Token); err != nil {\n\t\tif errors.Is(err, gitx.ErrRefNotFound) {\n\t\t\treturn \"\", fmt.Errorf(\"%w: %s\", ErrBranchGone, i.base)\n\t\t}\n\t\treturn \"\", err\n\t}\n\tspec = \"+refs/heads/\" + InitBranch + \":\" + upstreamRef(InitBranch)\n\tswitch err 