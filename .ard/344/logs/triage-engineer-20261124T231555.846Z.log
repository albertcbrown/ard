h, default \"main\"). Each Propose is one attempt: there is no\n// retry loop and no force push. It is a separate lane from the main\n// committer, which still writes only .ard/<issue#>/.\ntype Init struct {\n\tc    *core\n\tbase string\n\twt   string\n}\n\n// NewInit validates cfg and checks the git version the way NewMain does.\n// cfg.Bot is required unless fx.DryRun().\nfunc NewInit(ctx context.Context, cfg Config, fx Effects, g *gitx.Git) (*Init, error) {\n\tc, err := newCore(cfg, fx, g, false)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tmajor, minor, err := c.g.Version(ctx)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif major < 2 || (major == 2 && minor < 32) {\n\t\treturn nil, fmt.Errorf(\"git %d.%d is too old: 2.32 or later is required\", major, minor)\n\t}\n\tbase := cfg.Branch\n\tif base == \"\" {\n\t\tbase = \"main\"\n\t}\n\treturn &Init{c: c, base: base, wt: filepath.Join(cfg.WorkDir, \"committer-init\")}, nil\n}\n\n// Base fetches the base branch into refs/ard/upstream/<base> and returns its\n// SHA. It returns ErrInitExists if InitBranch exists on the remote, and\n// ErrBranchGone (naming the base) if the base branch does not exist.\nfunc (i *Init) Base(ctx context.Context) (string, error) {\n\tcfg := i.c.cfg\n\tspec := \"+refs/heads/\" + i.base + \":\" + upstreamRef(i.base)\n\tif err := i.c.g.FetchRef(ctx, cfg.RepoDir, cfg.RemoteURL, spec, cfg.Token); err != nil {\n\t\tif errors.Is(err, gitx.ErrRefNotFound) {\n\t\t\treturn \"\", fmt.Errorf(\"%w: %s\", ErrBranchGone, i.base)\n\t\t}\n\t\treturn \"\", err\n\t}\n\tspec = \"+refs/heads/\" + InitBranch + \":\" + upstreamRef(InitBranch)\npackage cli\n\nimport (\n\t\"context\"\n\n\t\"github.com/spf13/cobra\"\n)\n\nfunc newInit(app *App) *cobra.Command {\n\tvar force bool\n\tcmd := &cobra.Command{\n\t\tUse:   \"init\",\n\t\tShort: \"Open a PR that adds the starter .ard/ directory\",\n\t\tArgs:  cobra.NoArgs,\n\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n\t\t\treturn app.run(cmd, func(ctx context.Context, e *Env) error {\n\t\t\t\tif app.Handlers.Init == nil {\n\t\t\t\t\treturn notImpl(cmd.CommandPath(), \"#27\")\n\t\t\t\t}\n\t\t\t\treturn app.Handlers.Init(ctx, e, InitOpts{Force: force})\n\t\t\t})\n\t\t},\n\t}\n\tcmd.Flags().BoolVar(&force, \"force\", false, \"propose starter files even where main has different contents (never deletes)\")\n\treturn cmd\n}\n\t// working tree.\n\tRef string\n}\n\n// InitOpts is the parsed flag set of `ard init`.\ntype InitOpts struct {\n\tForce bool\n}\n\n// ErrNotImplemented is returned (wrapped) by stub commands whose handler\n// has not been wired yet.\ndocs/site/getting-started.md:33:ard init\ndocs/site/getting-started.md:36:`ard init` opens a pull request with the starter `.ard/` tree: `config.yaml` and the starter role directories. Review and merge it. Then:\ndocs/site/configuration.md:48:`ard init` writes a recommended list that includes `.github/`, `.ard/config.yaml`, the role directories, `CODEOWNERS`, `CLAUDE.md`, `AGENTS.md`, `.claude/`, `.mcp.json` and build and deploy files.\ninternal/config/source.go:15:func SourcePaths() []string {\ninternal/config/source.go-16-\tpaths := []string{\".ard/config.yaml\"}\ninternal/config/source.go-17-\tfor _, k := range kindOrder {\ninternal/config/source.go-18-\t\tpaths = append(paths, \".ard/\"+kindDir[k])\ninternal/config/source.go-19-\t}\ninternal/config/source.go-20-\treturn paths\ninternal/config/source.go-21-}\ninternal/config/source.go-22-\ninternal/config/source.go-23-// SharedSourcePaths lists the role-directory trees a shared roles repo\n--\ninternal/config/source.go:25:func SharedSourcePaths() []string { return SourcePaths()[1:] }\ninternal/config/source.go-26-\ninternal/config/source.go-27-// SharedRoles reads only the roles_repo key of the config file in fsys. A\ninternal/config/source.go-28-// missing file or an unset key returns nil, nil. The repo and ref are not\ninternal/config/source.go-29-// validated here; config.Load does that.\ninternal/config/source.go