story is not scanned. TruffleHog is AGPL-3.0: it is installed by the role\\'s Dockerfile and is not in the published `ard` image.']\nd='\\n'.join(out)\nd=d.replace(\"  scanners/error-codes:     { every: 24h, group_size: 20, autoclose: true }\\n\",\"  scanners/error-codes:     { every: 24h, group_size: 20, autoclose: true }\\n  scanners/trufflehog:      { every: 24h, max_open: 5, group_size: 1, autoclose: true, route: needs-human, timeout: 30m }\\n\",1)\nd=d.replace(\"`scanners/error-codes`, `triage/lea\",\"`scanners/error-codes`, `scanners/trufflehog`, `triage/lea\",1)\nopen('docs/proposal.md','w').write(d)\nEOF\ngit diff --stat; go build ./... && go test ./internal/... 2>&1 | grep -v '^ok' | head"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1037,"cache_read_input_tokens":45271,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1037},"output_tokens":9,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"df46bed3-dabf-4cad-b5b5-c68f6e97c979","uuid":"2c150d59-45b7-438c-8f81-fb75a64e1b39","timestamp":"2026-11-23T20:16:21.462Z","request_id":"req_011ChLUVvSkY4cfeuFUow1gH"}
