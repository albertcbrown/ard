{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LiNuGnDksoqARE7aW2BBLF","type":"tool_result","content":"- TTY detection (stdin and stdout); `--ui` / `--no-ui`; `TERM=dumb` or not a TTY → today's output unchanged.\n- While the UI runs, all log output and child stderr go to `~/.ard/logs/<owner>/<repo>/serve.log` (0600, size-capped); path in the header and printed on exit.\n- Render the panels from the slice 1 `Snapshot` every second: header, needs you, running, waiting per role, limits, issues (paged); recent events and next tick per loop on large terminals. Footer with main keys.\n- Keys: `?` help, `j`/`k`/arrows select, `o` open the selected issue in the browser, `q` quit with confirm; Ctrl-C stops gracefully (raw mode still delivers SIGINT). Resize handled.\n- Sanitise every untrusted string (titles, agent text) of control characters and escape sequences before drawing; render nothing secret.\n- Proposal: a \"Command center\" paragraph under Observability.\n\n**Acceptance criteria**\n- On a TTY the UI appears and logs go to the file; with `--no-ui`, a pipe or `TERM=dumb` output is unchanged.\n- Golden-frame tests at 80x24 and a large size from fixed snapshots; key handling tests with a fake program; escape-sequence titles render inert.\n- Refresh makes no GitHub calls; Ctrl-C stops gracefully; `make lint test` passes.\n\nDepends on: #413. Next: #415 and #416.\n\n\npackage servecmd\n\nimport (\n\t\"errors\"\n\t\"io\"\n\t\"os\"\n\n\t\"github.com/charmbracelet/x/term\"\n)\n\n// UI modes of `ard serve`.\nconst (\n\tuiAuto = \"\"    // draw the command center only on a terminal\n\tuiOn   = \"on\"  // --ui\n\tuiOff  = \"off\" // --no-ui\n)\n\nfunc isTTY(v any) bool {\n\tf, ok := v.(*os.File)\n\treturn ok && term.IsTerminal(f.Fd())\n}\n\n// uiWanted says whether serve draws the command center. Only a real terminal\n// on both stdin and stdout, with a TERM that can draw, gets it; anything else\n// keeps today's output. --ui on a terminal that cannot draw is an error.\nfunc uiWanted(mode string, stdin io.Reader, stdout io.Writer, getenv func(string) string) (bool, error) {\n\tif mode == uiOff {\n\t\treturn false, nil\n\t}\n\tt := getenv(\"TERM\")\n\tif isTTY(stdin) && isTTY(stdout) && t != \"\" && t != \"dumb\" {\n\t\treturn true, nil\n\t}\n\tif mode == uiOn {\n\t\treturn false, errors.New(\"--ui needs a terminal on stdin and stdout and a TERM that is not dumb\")\n\t}\n\treturn false, nil\n}\npackage servecmd\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"io\"\n\n\ttea \"charm.land/bubbletea/v2\"\n\n\t\"github.com/albertcbrown/ard/internal/snapshot\"\n\t\"github.com/albertcbrown/ard/internal/ui\"\n)\n\n// program is the part of a Bubble Tea program runWithUI needs; tests fake it.\ntype program interface {\n\tRun() (tea.Model, error)\n\tSend(tea.Msg)\n}\n\n// newProgram builds the real program on the terminal. A variable for tests.\nvar newProgram = func(m tea.Model, in io.Reader, out io.Writer) program {\n\treturn tea.NewProgram(m, tea.WithInput(in), tea.WithOutput(out))\n}\n\n// runWithUI runs the controller and the read-only UI side by side. The UI\n// ending (q, Ctrl-C) or ctx being canceled (SIGINT/SIGTERM) cancels the\n// controller; runWithUI returns once run has stopped, so shutdown is the same\n// graceful path as without a UI.\nfunc runWithUI(ctx context.Context, run func(context.Context) error, take func(context.Context) snapshot.Snapshot,\n\trepo, logPath string, in io.Reader, out io.Writer) error {\n\trctx, cancel := context.WithCancel(ctx)\n\tdefer cancel()\n\tdone := make(chan error, 1)\n\tgo func() { done <- run(rctx) }()\n\n\tp := newProgram(ui.New(repo, logPath, take, ui.OpenBrowser), in, out)\n\tstopped := make(chan struct{})\n\tgo func() {\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\tp.Send(tea.Quit())\n\t\tcase err := <-done:\n\t\t\t// The controller ended by itself; put the result back and close the UI.\n\t\t\tdone <- err\n\t\t\tp.Send(tea.Quit())\n\t\tcase <-stopped:\n\t\t}\n\t}()\n\t_, uiErr := p.Run()\n\tclose(stopped)\n\tcancel()\n\terr := <-done\n\tif err == nil && uiErr != nil && ctx.Err() == nil {\n\t\terr = fmt.Errorf(\"ard serve: ui: %w\", uiErr)\n\t}\n\treturn err\n}\npackage servecmd\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"sync\"\n\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/repopath\"\n)\n\n// serveLogCap is the size at which serve.log is rotated to serve.log.1.\nconst serveLogCap = 10 << 20\n\n// capFile is the serve.log writer: mode 0600, rotated at its cap so the log\n// never grows without bound. It is safe for concurrent use.\ntype capFile struct {\n\tmu   sync.Mutex\n\tpath string\n\tcap  int64\n\tf    *os.File\n\tsize int64\n}\n\n// openServeLog opens ~/.ard/logs/<owner>/<repo>/serve.log and returns it with its path.\nfunc openServeLog(home string, r github.Repo) (*capFile, string, error) {\n\tdir, err := repopath.Join(filepath.Join(home, \".ard\", \"logs\"), r.String())\n\tif err != nil {\n\t\treturn nil, \"\", err\n\t}\n\tif err := os.MkdirAll(dir, 0o700); err != nil {\n\t\treturn nil, \"\", err\n\t}\n\tc := &capFile{path: filepath.Join(dir, \"serve.log\"), cap: serveLogCap}\n\tif err := c.open(); err != nil {\n\t\treturn nil, \"\", err\n\t}\n\treturn c, c.path, nil\n}\n\nfunc (c *capFile) open() error {\n\tf, err := os.OpenFile(c.path, os.O_WRONLY|os.O_APPEND|os.O_CREATE, 0o600)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := f.Chmod(0o600); err != nil {\n\t\tf.Close()\n\t\treturn err\n\t}\n\tst, err := f.Stat()\n\tif err != nil {\n\t\tf.Close()\n\t\treturn err\n\t}\n\tc.f, c.size = f, st.Size()\n\treturn nil\n}\n\n// Write appends p, rotating first when it would pass the cap.\nfunc (c *capFile) Write(p []byte) (int, error) {\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\tif c.f == nil {\n\t\treturn 0, os.ErrClosed\n\t}\n\tif c.size > 0 && c.size+int64(len(p)) > c.cap {\n\t\tc.f.Close()\n\t\tif err := os.Rename(c.path, c.path+\".1\"); err != nil {\n\t\t\treturn 0, fmt.Errorf(\"rotate serve.log: %w\", err)\n\t\t}\n\t\tif err := c.open(); err != nil {\n\t\t\tc.f = nil\n\t\t\treturn 0, err\n\t\t}\n\t}\n\tn, err := c.f.Write(p)\n\tc.size += int64(n)\n\treturn n, err\n}\n\n// Close closes the file.\nfunc (c *capFile) Close() error {\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\tif c.f == nil {\n\t\treturn nil\n\t}\n\terr := c.f.Close()\n\tc.f = nil\n\treturn err\n}\ndiff --git a/internal/servecmd/serve.go b/internal/servecmd/serve.go\nindex d22985e..8ecca94 100644\n--- a/internal/servecmd/serve.go\n+++ b/internal/servecmd/serve.go\n@@ -77,11 +77,11 @@ var gitBin = \"\"\n \n // Serve is the handler behind `ard serve`.\n func Serve(ctx context.Context, e *cli.Env, o cli.ServeOpts) error {\n-\treturn serveLoops(ctx, e, buildDeps, o.Loops, o.K8s)\n+\treturn serveLoops(ctx, e, buildDeps, o.Loops, o.K8s, o.UI)\n }\n \n func serve(ctx context.Context, e *cli.Env, build builder) error {\n-\treturn serveLoops(ctx, e, build, nil, cli.K8sOpts{})\n+\treturn serveLoops(ctx, e, build, nil, cli.K8sOpts{}, uiOff)\n }\n \n // loopNames lists the names of loops, for the serve.loops log line.\n@@ -128,7 +128,7 @@ var dockerProbe = func(ctx context.Context) ([]byte, error) {\n \treturn exec.CommandContext(ctx, \"docker\", \"version\", \"--format\", \"{{.Server.Version}}\").CombinedOutput()\n }\n \n-func serveLoops(ctx context.Context, e *cli.Env, build builder, wantLoops []string, k8s cli.K8sOpts) error {\n+func serveLoops(ctx context.Context, e *cli.Env, build builder, wantLoops []string, k8s cli.K8sOpts, uiMode string) error {\n \tif _, err := selectLoops(nil, wantLoops); err != nil {\n \t\treturn err\n \t}\n@@ -165,6 +165,31 @@ func serveLoops(ctx context.Context, e *cli.Env, build builder, wantLoops []stri\n \t}\n \tdefer leader.Release()\n \n+\t// The command center draws on the terminal, so while it runs every log\n+\t// line goes to serve.log instead (#414).\n+\tuseUI, err := uiWanted(uiMode, os.Stdin, e.Stdout, os.Getenv)\n+\tif err != nil {\n+\t\