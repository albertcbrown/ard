\"xterm\", false, false},\n\t\t{\"no-ui\", uiOff, pw, \"xterm\", false, false},\n\t\t{\"dumb\", uiAuto, pw, \"dumb\", false, false},\n\t\t{\"--ui on a pipe\", uiOn, pw, \"xterm\", false, true},\n\t\t{\"--ui non-file\", uiOn, &buf, \"xterm\", false, true},\n\t} {\n\t\tgot, err := uiWanted(c.mode, pr, c.out, env(c.term))\n\t\tif got != c.want || (err != nil) != c.wantErr {\n\t\t\tt.Errorf(\"%s: got %v, %v\", c.name, got, err)\n\t\t}\n\t}\n}\n\nfunc TestServeLog(t *testing.T) {\n\thome := t.TempDir()\n\tlf, path, err := openServeLog(home, github.Repo{Owner: \"o\", Name: \"r\"})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer lf.Close()\n\tif want := filepath.Join(home, \".ard\", \"logs\", \"o\", \"r\", \"serve.log\"); path != want {\n\t\tt.Errorf(\"path = %s, want %s\", path, want)\n\t}\n\tif st, _ := os.Stat(path); st.Mode().Perm() != 0o600 {\n\t\tt.Errorf(\"file mode %v\", st.Mode())\n\t}\n\tif st, _ := os.Stat(filepath.Dir(path)); st.Mode().Perm() != 0o700 {\n\t\tt.Errorf(\"dir mode %v\", st.Mode())\n\t}\n\tlf.cap = 100\n\tfor i := 0; i < 20; i++ {\n\t\tif _, err := lf.Write([]byte(strings.Repeat(\"x\", 30) + \"\\n\")); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tfor _, p := range []string{path, path + \".1\"} {\n\t\tst, err := os.Stat(p)\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif st.Size() > 100 || st.Mode().Perm() != 0o600 {\n\t\t\tt.Errorf(\"%s: size %d mode %v\", p, st.Size(), st.Mode())\n\t\t}\n\t}\n}\n\ntype fakeProgram struct {\n\tquit chan struct{}\n\tonce sync.Once\n}\n\nfunc (f *fakeProgram) Run() (tea.Model, error) { <-f.quit; return nil, nil }\nfunc (f *fakeProgram) Send(m tea.Msg) {\n\tif _, ok := m.(tea.QuitMsg); ok {\n\t\tf.once.Do(func() { close(f.quit) })\n\t}\n}\n\nfunc TestRunWithUI(t *testing.T) {\n\told := newProgram\n\tdefer func() { newProgram = old }()\n\tvar fp *fakeProgram\n\tnewProgram = func(tea.Model, io.Reader, io.Writer) program {\n\t\tfp = &fakeProgram{quit: make(chan struct{})}\n\t\treturn fp\n\t}\n\ttake := func(context.Context) snapshot.Snapshot { return snapshot.Snapshot{} }\n\n\t// SIGINT path: ctx canceled, the controller stops gracefully.\n\tctx, cancel := context.WithCancel(context.Background())\n\tstopped := false\n\tgo func() { time.Sleep(20 * time.Millisecond); cancel() }()\n\terr := runWithUI(ctx, func(c context.Context) error { <-c.Done(); stopped = true; return nil }, take, \"o/r\", \"\", nil, io.Discard)\n\tif err != nil || !stopped {\n\t\tt.Errorf(\"err %v stopped %v\", err, stopped)\n\t}\n\n\t// UI quit path: the controller is canceled and waited for.\n\tstopped = false\n\tdone := make(chan error, 1)\n\tgo func() {\n\t\tdone <- runWithUI(context.Background(), func(c context.Context) error { <-c.Done(); stopped = true; return nil }, take, \"o/r\", \"\", nil, io.Discard)\n\t}()\n\ttime.Sleep(20 * time.Millisecond)\n\tfp.Send(tea.Quit())\n\tif err := <-done; err != nil || !stopped {\n\t\tt.Errorf(\"err %v stopped %v\", err, stopped)\n\t}\n}\nEOF\ngofmt -l internal; go mod tidy 2>&1|tail -2; go test ./internal/cli ./internal/servecmd ./internal/ui 2>&1 | tail -20"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1039,"cache_read_input_tokens":60369,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1039},"output_tokens":20,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"124935bb-3dbd-41ea-9f18-879320c85464","uuid":"37fa1609-986a-4ecd-ae1f-a66d5fc2bd77","timestamp":"2026-11-25T15:07:36.860Z","request_id":"req_011ChPrZtGDLAM1cN2aGc3oh"}
