{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VbVXvQ1wmYEDcjW7ZLa2GA","type":"tool_result","content":"// Package snapshot builds the in-process Snapshot behind the `ard serve`\n// command center (and a later `ard top`): pool, running jobs, kill switches,\n// usage limits, today's issues and spend, and recent log events.\n//\n// Taking a snapshot is cheap and local. It reads memory (pool, limits book,\n// controller) and the SQLite state only; it makes no GitHub call and the\n// package must not import internal/github (an import test enforces it).\npackage snapshot\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"math\"\n\t\"sort\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/budget\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n\t\"github.com/albertcbrown/ard/internal/limits\"\n\t\"github.com/albertcbrown/ard/internal/pool\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// Waiting reasons.\nconst (\n\tReasonSlot    = \"slot\"    // ready, waiting for a free slot\n\tReasonLimited = \"limited\" // account or model family is out of quota\n\tReasonBudget  = \"budget\"  // a daily cap is reached\n)\n\n// Snapshot is a point-in-time view. Errors holds one line per source that\n// failed; the other fields are still filled.\ntype Snapshot struct {\n\tTakenAt time.Time\n\tDayFrom time.Time // 00:00 UTC of TakenAt's day\n\tPool    PoolView\n\tRunning []RunningJob\n\tPause   []PauseView\n\tTicks   []TickView\n\tLimits  LimitsView\n\tIssues  []IssueView\n\tSpend   SpendView\n\tEvents  []Event\n\tErrors  []string\n}\n\n// PoolView is the slot pool.\ntype PoolView struct {\n\tUsed, Max int\n\tWaiting   []Waiting\n}\n\n// Waiting is demand or refused candidates of one role with the reason.\ntype Waiting struct {\n\tClass  string\n\tRole   string\n\tReason string // ReasonSlot, ReasonLimited or ReasonBudget\n\tCount  int\n\tOldest time.Duration // slot waits only\n}\n\n// RunningJob is one job holding a slot.\ntype RunningJob struct {\n\tJobID   string\n\tIssue   int // 0 for a scanner run\n\tPR      int\n\tStage   string\n\tRole    string\n\tModel   string        // from the role config; \"\" is the agent's default\n\tElapsed time.Duration // since the job was created\n\tTimeout time.Duration // from the role config; 0 when unknown\n\t// FinishedCostUSD is the cost of finished steps only; nil when no finished\n\t// step reported a cost. The running step contributes nothing.\n\tFinishedCostUSD *float64\n}\n\n// PauseView is one active kill switch for one claiming loop.\ntype PauseView struct {\n\tLoop   string\n\tReason controller.Reason\n\tErr    string\n}\n\n// TickView is the last tick of a loop.\ntype TickView struct {\n\tLoop       string\n\tCount      int\n\tStart, End time.Time\n\tErr        string\n}\n\n// LimitsView holds the usage-limit readings and active blocks.\ntype LimitsView struct {\n\tWindows []WindowView\n\tBlocks  []BlockView\n}\n\n// WindowView is the latest reading of one subscription window.\ntype WindowView struct {\n\tWindow      string\n\tUtilization float64 // normalised to 0..1\n\tStatus      string\n\tResetsAt    time.Time\n\tAge         time.Duration // now minus when it was observed\n}\n\n// BlockView is an active exhaustion block for a model family (\"\" = unknown).\ntype BlockView struct {\n\tFamily string\n\tUntil  time.Time\n}\n\n// IssueView is an issue with ard activity today.\ntype IssueView struct {\n\tIssue   int\n\tState   string // \"<stage>:<role> running\" or \"<stage>:<role> done|failed\" of the latest job\n\tJobs    int\n\tCostUSD *float64 // total of all recorded steps; nil when none priced\n}\n\n// SpendView is today's spend against the daily caps.\ntype SpendView struct {\n\tRepoUSD   float64\n\tRepoCap   float64 // 0 when no config\n\tUnpriced  int\n\tRoles     []RoleSpend\n\tCappedNow []budget.Cap\n}\n\n// RoleSpend is one role's spend today.\ntype RoleSpend struct {\n\tStage, Role string\n\tUSD         float64\n}\n\n// PoolSource is the slot pool; *pool.Pool satisfies it.\ntype PoolSource interface {\n\tStats() pool.Stats\n\tHeldSlots() []pool.HeldInfo\n}\n\n// LimitSource is the limits book; *limits.Book satisfies it.\ntype LimitSource interface {\n\tReadings() []limits.Reading\n\tUntil(family string) time.Time\n}\n\n// StateSource is the state store; *state.Store satisfies it.\ntype StateSource interface {\n\tRunningJobs(ctx context.Context) ([]state.Job, error)\n\tEndedSince(ctx context.Context, since time.Time) ([]state.Job, error)\n\tJobUsage(ctx context.Context, jobID string) (state.JobUsage, error)\n\tIssueUsage(ctx context.Context, issue int) (map[string]state.JobUsage, error)\n\tSpendSince(ctx context.Context, dayStart time.Time) (map[state.RoleKey]state.Spend, state.Spend, error)\n}\n\n// ControlSource is the controller; *controller.Controller satisfies it.\ntype ControlSource interface {\n\tPauseStates() map[string]controller.PauseState\n\tTicks() []controller.TickInfo\n}\n\n// CapSource lists the caps reached today; *budget.Gate satisfies it.\ntype CapSource interface {\n\tCapped(ctx context.Context) ([]budget.Cap, time.Time, error)\n}\n\n// Sources are what a Taker reads. Pool, Limits, Control and Caps may be nil\n// (or return nil), for example before startup hooks have run; Config may\n// return nil.\ntype Sources struct {\n\tPool    func() PoolSource\n\tLimits  func() LimitSource\n\tState   StateSource\n\tControl ControlSource\n\tCaps    CapSource\n\tConfig  func() *config.Resolved\n\tRing    *Ring\n\tNow     func() time.Time\n}\n\n// Taker takes snapshots. It is safe for concurrent use.\ntype Taker struct {\n\ts Sources\n\n\tmu    sync.Mutex\n\tcache map[int]cachedUsage\n}\n\ntype cachedUsage struct {\n\tkey   string\n\ttotal *float64\n}\n\n// New returns a Taker over s.\nfunc New(s Sources) *Taker {\n\tif s.Now == nil {\n\t\ts.Now = time.Now\n\t\treturn err\n\t}\n\tstore, err := state.Open(ctx, stateDir, state.Options{})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard serve: %w\", err)\n\t}\n\tdefer store.Close()\n\tscanners := scannerdb.NewRegistry(stateDir, scannerdb.Options{})\n\tdefer scanners.Close()\n\n\td, err := build(ctx, e, repo, stateDir)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif d.Close != nil {\n\t\tdefer d.Close()\n\t}\n\n\t// The ring keeps the newest log records for the command center; the tee\n\t// passes every record to the existing handler unchanged.\n\tevents := snapshot.NewRing(snapshotEvents)\n\tlog := slog.New(snapshot.NewTee(e.Log.Handler(), events, nil))\n\t// The controller's own bare clone: every config fetch, committer lane and\n\t// executor worktree uses it, never the operator's checkout (#113).\n\tclone, err := openClone(ctx, gitx.New(\"\"), home, repo, d.RemoteURL, d.Token, log)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard serve: %w\", err)\n\t}\n\t// Config comes from origin/main, not from the working tree (#87): a merged\n\t// change applies on the next tick without a pull, and every job of a tick\n\t// runs against one commit.\n\tcacheDir, err := repopath.Join(filepath.Join(home, \".ard\", \"config\"), repo.String())\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard serve: %w\", err)\n\t}\n\t// The shared roles repo (roles_repo) is cached as a bare clone beside the\n\t// config snapshots, one per consuming repo.\n\tsharedDir, err := repopath.Join(filepath.Join(home, \".ard\", \"roles-repo\"), repo.String())\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard serve: %w\", err)\n\t}\n\tsrc, err := configsrc.New(configsrc.Options{\n\t\tGit: gitx.New(\"\"), RepoDir: clone, RemoteURL: d.RemoteURL, Token: d.Token,\n\t\tCacheDir: cacheDir, SharedDir: sharedDir, Log: log,\n\t})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard serve: %w\", err)\n\t}\n\tgate := controller.NewPauseGate(d.Reader, log)\n\t// root is the operator's checkout: read only (origin fallback, local paused). ard never writes to it (#113).\n\tgate.SetLocalConfig(root)\n\tpausePath, err := controller.PauseFilePath(home, repo.Owner, repo.Name)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard serve: %w\", err)\n\t}\n\tgate.SetPauseFile(pausePath)\n\t// Make `touch ~/.ard/pause/<owner>/<repo>` work on a fresh host.\n\tif err := os.MkdirAll(filepath.Dir(pausePath), 0o700); err != nil {\n\t\tlog.Warn(\"serve.pause_dir_failed\", \"path\", filepath.Dir(pausePath), \"error\", err)\n\t}\n\n\tagentImage := os.Getenv(EnvAgentImage)\n\tif agentImage != \"\" {\n\t\tif err := executor.CheckImageRef(agentImage); err != nil {\n\t\t\treturn fmt.Errorf(\"ard serve: %s: %w\", EnvAgentImage, err)\n\t\t}\n\t\tif out, err := dockerProbe(ctx); err != nil {\n\t\t\treturn fmt.Errorf(\"ard serve: %s is set but Docker is not available: %w: %s\", EnvAgentImage, err, strings.TrimSpace(string(out)))\n\t\t}\n\t\tlog.Info(\"serve.agent_image\", \"image\", agentImage)\n\t}\n\n\tw := &wiring{\n\t\tAgentImage: agentImage, Log: log, Reader: d.Reader, Effects: d.Effects, Store: store, MaxPods: config.DefaultMaxPods,\n\t\tRepo: repo, Root: clone, Home: home, RemoteURL: d.RemoteURL, Token: d.Token, Scanners: scanners, Model: d.Model,\n\t\tStateDir: stateDir, Started: time.Now(), K8s: k8s, Auth: d.Auth,\n\t}\n\tdefer w.closeAll()\n\tpaths, perr := newPathRedactor(w.hostPaths())\n\tif perr != nil {\n\t\tlog.Error(\"serve.config_error_paths\", \"error\", perr)\n\t}\n\tloader := &cfgLoader{paths: paths, src: src, fx: d.Effects, log: log, stderr: e.Stderr, agentImage: agentImage != \"\", issue: func() int { return int(w.statusIssue.Load()) }}\n\n\t// An origin/main whose config cannot be loaded does not abort startup:\n\t// serve starts paused, tells the status issue, and retries every tick.\n\tloadCtx, cancelLoad := context.WithTimeout(ctx, 2*time.Minute)\n\tcfg, cfgErr := loader.Load(loadCtx)\n\tcancelLoad()\n\tif cfgErr != nil {\n\t\tlog.Error(\"serve.config_unavailable\", \"error\", cfgErr, \"hint\", \"starting paused; will retry every tick\")\n\t} else {\n\t\tw.MaxPods = cfg.MaxPods\n\t\tw.cfg.Store(cfg)\n\t\t// A k8s serve that cannot build its executor (a PAT cannot mint\n\t\t// scoped tokens, a missing flag) must not start.\n\t\tif cfg.Executor == \"k8s\" {\n\t\t\tif _, err := w.newExecutor(); err != nil {\n\t\t\t\treturn &cli.ExitError{Code: 1, Err: fmt.Errorf(\"ard serve: %w\", err)}\n\t\t\t}\n\t\t}\n\t\t\t\treturn nil\n\t\t\t}},\n\t\t\t{Name: \"status-issue\", Fn: func(ctx context.Context) error {\n\t\t\t\tid, err := d.Reader.Identity(ctx)\n\t\t\t\tif err != nil {\n\t\t\t\t\treturn fmt.Errorf(\"identify github user: %w\", err)\n\t\t\t\t}\n\t\t\t\tn, err := controller.EnsureStatusIssue(ctx, d.Reader, d.Effects, store, id.Login, log)\n\t\t\t\tif err != nil {\n\t\t\t\t\treturn err\n\t\t\t\t}\n\t\t\t\tgate.SetStatusIssue(n)\n\t\t\t\tw.statusIssue.Store(int64(n))\n\t\t\t\treturn nil\n\t\t\t}},\n\t\t},\n\t\tForce: forceOnSecondSignal(ctx),\n\t\tWake:  wakeSignals(ctx),\n\t}, selected...)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard serve: %w\", err)\n\t}\n\tw.snap = w.newSnapshotTaker(cc, events)\n\tw.ctl.Store(cc)\n\tstartSHA := \"\"\n\tif cfg != nil {\n\t\tstartSHA = cfg.SHA\n\t}\n\tlog.Info(\"serve.start\", \"repo\", repo.String(), \"dry_run\", e.DryRun, \"pause_file\", pausePath, \"config_sha\", startSHA)\n\treturn cc.Run(ctx)\n}\n\n// wiring holds the long-lived dependencies loops take through their own\n// constructors. The pool is not built yet when constructors run (the\n// pool-adopt startup hook builds it inside Run), so loops must call Pool()\n// at tick time, never in their constructors.\ntype wiring struct {\n\t// AgentImage is the default agent image (ARD_AGENT_IMAGE); \"\" = host mode for roles without a Dockerfile.\n\tAgentImage string\n\tLog        *slog.Logger\n\tReader     github.Reader\npackage servecmd\n\nimport (\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n\t\"github.com/albertcbrown/ard/internal/snapshot\"\n)\n\n// snapshotEvents is how many recent log records the command center keeps.\nconst snapshotEvents = 200\n\n// newSnapshotTaker builds the command center's Snapshot source. The pool and\n// the limits book exist only after the startup hooks, so they are looked up\n// at Take time; a Take before that sees them as absent. It makes no GitHub\n// call: the kill-switch state comes from the controller's last tick.\nfunc (w *wiring) newSnapshotTaker(c *controller.Controller, events *snapshot.Ring) *snapshot.Taker {\n\treturn snapshot.New(snapshot.Sources{\n\t\tPool: func() snapshot.PoolSource {\n\t\t\tif p := w.pool.Load(); p != nil {\n\t\t\t\treturn p\n\t\t\t}\n\t\t\treturn nil\n\t\t},\n\t\tLimits: func() snapshot.LimitSource {\n\t\t\tw.initMu.Lock()\n\t\t\tdefer w.initMu.Unlock()\n\t\t\tif w.lim != nil {\n\t\t\t\treturn w.lim\n\t\t\t}\n\t\t\treturn nil\n\t\t},\n\t\tState:   w.Store,\n\t\tControl: c,\n\t\tCaps:    w.budgetGate(),\n\t\tConfig:  func() *config.Resolved { return w.cfg.Load() },\n\t\tRing:    events,\n\t})\n}\ninternal/cli/app.go:26:type Env struct {\ninternal/cli/app.go-27-\tGlobals\ninternal/cli/app.go-28-\tLog            *slog.Logger\ninternal/cli/app.go-29-\tStdout, Stderr io.Writer\ninternal/cli/app.go-30-}\ninternal/cli/app.go-31-\ninternal/cli/app.go-32-// Handlers holds one function per implemented command. A nil field makes\ninternal/cli/app.go-33-// that command exit non-zero with an ErrNotImplemented message.\ninternal/cli/app.go-34-type Handlers struct {\ninternal/cli/app.go-35-\tServe        func(ctx context.Context, e *Env, o ServeOpts) error       // #15\ninternal/cli/app.go-36-\tConfigCheck  func(ctx context.Context, e *Env, o ConfigCheckOpts) error // #11\ninternal/cli/app.go-37-\tLabelsSync   func(ctx context.Context, e *Env) error                    // #22\ninternal/cli/app.go-38-\tRebuildState func(ctx context.Context, e *Env, scanner string) error    // #23\ninternal/cli/app.go-39-\tInit         func(ctx context.Context, e *Env, o InitOpts) error        // #27\ninternal/cli/app.go-40-\t