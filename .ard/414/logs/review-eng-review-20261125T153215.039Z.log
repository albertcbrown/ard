hat cannot draw is an error.\n+func uiWanted(mode string, stdin io.Reader, stdout io.Writer, getenv func(string) string) (bool, error) {\n+\tif mode == uiOff {\n+\t\treturn false, nil\n+\t}\n+\tt := getenv(\"TERM\")\n+\tif isTTY(stdin) && isTTY(stdout) && t != \"\" && t != \"dumb\" {\n+\t\treturn true, nil\n+\t}\n+\tif mode == uiOn {\n+\t\treturn false, errors.New(\"--ui needs a terminal on stdin and stdout and a TERM that is not dumb\")\n+\t}\n+\treturn false, nil\n+}\ndiff --git a/internal/servecmd/ui.go b/internal/servecmd/ui.go\nnew file mode 100644\nindex 0000000..199606b\n--- /dev/null\n+++ b/internal/servecmd/ui.go\n@@ -0,0 +1,57 @@\n+package servecmd\n+\n+import (\n+\t\"context\"\n+\t\"fmt\"\n+\t\"io\"\n+\n+\ttea \"charm.land/bubbletea/v2\"\n+\n+\t\"github.com/albertcbrown/ard/internal/snapshot\"\n+\t\"github.com/albertcbrown/ard/internal/ui\"\n+)\n+\n+// program is the part of a Bubble Tea program runWithUI needs; tests fake it.\n+type program interface {\n+\tRun() (tea.Model, error)\n+\tSend(tea.Msg)\n+}\n+\n+// newProgram builds the real program on the terminal. A variable for tests.\n+var newProgram = func(m tea.Model, in io.Reader, out io.Writer) program {\n+\treturn tea.NewProgram(m, tea.WithInput(in), tea.WithOutput(out))\n+}\n+\n+// runWithUI runs the controller and the read-only UI side by side. The UI\n+// ending (q, Ctrl-C) or ctx being canceled (SIGINT/SIGTERM) cancels the\n+// controller; runWithUI returns once run has stopped, so shutdown is the same\n+// graceful path as without a UI.\n+func runWithUI(ctx context.Context, run func(context.Context) error, take func(context.Context) snapshot.Snapshot,\n+\trepo, logPath string, in io.Reader, out io.Writer) error {\n+\trctx, cancel := context.WithCancel(ctx)\n+\tdefer cancel()\n+\tdone := make(chan error, 1)\n+\tgo func() { done <- run(rctx) }()\n+\n+\tp := newProgram(ui.New(repo, logPath, take, ui.OpenBrowser), in, out)\n+\tstopped := make(chan struct{})\n+\tgo func() {\n+\t\tselect {\n+\t\tcase <-ctx.Done():\n+\t\t\tp.Send(tea.Quit())\n+\t\tcase err := <-done:\n+\t\t\t// The controller ended by itself; put the result back and close the UI.\n+\t\t\tdone <- err\n+\t\t\tp.Send(tea.Quit())\n+\t\tcase <-stopped:\n+\t\t}\n+\t}()\n+\t_, uiErr := p.Run()\n+\tclose(stopped)\n+\tcancel()\n+\terr := <-done\n+\tif err == nil && uiErr != nil && ctx.Err() == nil {\n+\t\terr = fmt.Errorf(\"ard serve: ui: %w\", uiErr)\n+\t}\n+\treturn err\n+}\ndiff --git a/internal/servecmd/uilog.go b/internal/servecmd/uilog.go\nnew file mode 100644\nindex 0000000..1296a47\n--- /dev/null\n+++ b/internal/servecmd/uilog.go\n@@ -0,0 +1,92 @@\n+package servecmd\n+\n+import (\n+\t\"fmt\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"sync\"\n+\n+\t\"github.com/albertcbrown/ard/internal/github\"\n+\t\"github.com/albertcbrown/ard/internal/repopath\"\n+)\n+\n+// serveLogCap is the size at which serve.log is rotated to serve.log.1.\n+const serveLogCap = 10 << 20\n+\n+// capFile is the serve.log writer: mode 0600, rotated at its cap so the log\n+// never grows without bound. It is safe for concurrent use.\n+type capFile struct {\n+\tmu   sync.Mutex\n+\tpath string\n+\tcap  int64\n+\tf    *os.File\n+\tsize int64\n+}\n+\n+// openServeLog opens ~/.ard/logs/<owner>/<repo>/serve.log and returns it with its path.\n+func openServeLog(home string, r github.Repo) (*capFile, string, error) {\n+\tdir, err := repopath.Join(filepath.Join(home, \".ard\", \"logs\"), r.String())\n+\tif err != nil {\n+\t\treturn nil, \"\", err\n+\t}\n+\tif err := os.MkdirAll(dir, 0o700); err != nil {\n+\t\treturn nil, \"\", err\n+\t}\n+\tc := &capFile{path: filepath.Join(dir, \"serve.log\"), cap: serveLogCap}\n+\tif err := c.open(); err != nil {\n+\t\treturn nil, \"\", err\n+\t}\n+\treturn c, c.path, nil\n+}\n+\n+func (c *capFile) open() error {\n+\tf, err := os.OpenFile(c.path, os.O_WRONLY|os.O_APPEND|os.O_CREATE, 0o600)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tif err := f.Chmod(0o600); err != nil {\n+\t\tf.Close()\n+\t\treturn err\n+\t}\n+\tst, err := f.Stat()\n+\tif err != nil {\n+\t\tf.Close()\n+\t\treturn err\n+\t}\n+\tc.f, c.size = f, st.Size()\n+\treturn nil\n+}\n+\n+// Write appends p, rotating first when it would pass the cap.\n+func (c *capFile) Write(p []byte) (int, error) {\n+\tc.mu.Lock()\n+\tdefer c.mu.Unlock()\n+\tif c.f == nil {\n+\t\treturn 0, os.ErrClosed\n+\t}\n+\tif c.size > 0 && c.size+int64(len(p)) > c.cap {\n+\t\tc.f.Close()\n+\t\tif err := os.Rename(c.path, c.path+\".1\"); err != nil {\n+\t\t\treturn 0, fmt.Errorf(\"rotate serve.log: %w\", err)\n+\t\t}\n+\t\tif err := c.open(); err != nil {\n+\t\t\tc.f = nil\n+\t\t\treturn 0, err\n+\t\t}\n+\t}\n+\tn, err := c.f.Write(p)\n+\tc.size += int64(n)\n+\treturn n, err\n+}\n+\n+// Close closes the file.\n+func (c *capFile) Close() error {\n+\tc.mu.Lock()\n+\tdefer c.mu.Unlock()\n+\tif c.f == nil {\n+\t\treturn nil\n+\t}\n+\terr := c.f.Close()\n+\tc.f = nil\n+\treturn err\n+}\ndiff --git a/internal/servecmd/uilog_test.go b/internal/servecmd/uilog_test.go\nnew file mode 100644\nindex 0000000..8dfa1d2\n--- /dev/null\n+++ b/internal/servecmd/uilog_test.go\n@@ -0,0 +1,123 @@\n+package servecmd\n+\n+import (\n+\t\"bytes\"\n+\t\"context\"\n+\t\"io\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"sync\"\n+\t\"testing\"\n+\t\"time\"\n+\n+\ttea \"charm.land/bubbletea/v2\"\n+\n+\t\"github.com/albertcbrown/ard/internal/github\"\n+\t\"github.com/albertcbrown/ard/internal/snapshot\"\n+)\n+\n+func TestUIWanted(t *testing.T) {\n+\tenv := func(term string) func(string) string { return func(string) string { return term } }\n+\tvar buf bytes.Buffer\n+\tpr, pw, _ := os.Pipe()\n+\tdefer pr.Close()\n+\tdefer pw.Close()\n+\tfor _, c := range []struct {\n+\t\tname    string\n+\t\tmode    string\n+\t\tout     io.Writer\n+\t\tterm    string\n+\t\twant    bool\n+\t\twantErr bool\n+\t}{\n+\t\t{\"buffer\", uiAuto, &buf, \"xterm\", false, false},\n+\t\t{\"pipe\", uiAuto, pw, \"xterm\", false, false},\n+\t\t{\"no-ui\", uiOff, pw, \"xterm\", false, false},\n+\t\t{\"dumb\", uiAuto, pw, \"dumb\", false, false},\n+\t\t{\"--ui on a pipe\", uiOn, pw, \"xterm\", false, true},\n+\t\t{\"--ui non-file\", uiOn, &buf, \"xterm\", false, true},\n+\t} {\n+\t\tgot, err := uiWanted(c.mode, pr, c.out, env(c.term))\n+\t\tif got != c.want || (err != nil) != c.wantErr {\n+\t\t\tt.Errorf(\"%s: got %v, %v\", c.name, got, err)\n+\t\t}\n+\t}\n+}\n+\n+func TestServeLog(t *testing.T) {\n+\thome := t.TempDir()\n+\tlf, path, err := openServeLog(home, github.Repo{Owner: \"o\", Name: \"r\"})\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tdefer lf.Close()\n+\tif want := filepath.Join(home, \".ard\", \"logs\", \"o\", \"r\", \"serve.log\"); path != want {\n+\t\tt.Errorf(\"path = %s, want %s\", path, want)\n+\t}\n+\tif st, _ := os.Stat(path); st.Mode().Perm() != 0o600 {\n+\t\tt.Errorf(\"file mode %v\", st.Mode())\n+\t}\n+\tif st, _ := os.Stat(filepath.Dir(path)); st.Mode().Perm() != 0o700 {\n+\t\tt.Errorf(\"dir mode %v\", st.Mode())\n+\t}\n+\tlf.cap = 100\n+\tfor i := 0; i < 20; i++ {\n+\t\tif _, err := lf.Write([]byte(strings.Repeat(\"x\", 30) + \"\\n\")); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\tfor _, p := range []string{path, path + \".1\"} {\n+\t\tst, err := os.Stat(p)\n+\t\tif err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tif st.Size() > 100 || st.Mode().Perm() != 0o600 {\n+\t\t\tt.Errorf(\"%s: size %d mode %v\", p, st.Size(), st.Mode())\n+\t\t}\n+\t}\n+}\n+\n+type fakeProgram struct {\n+\tquit chan struct{}\n+\tonce sync.Once\n+}\n+\n+func (f *fakeProgram) Run() (tea.Model, error) { <-f.quit; return nil, nil }\n+func (f *fakeProgram) Send(m tea.Msg) {\n+\tif _, ok := m.(tea.QuitMsg); ok {\n+\t\tf.once.Do(func() { close(f.quit) })\n+\t}\n+}\n+\n+func TestRunWithUI(t *testing.T) {\n+\told := newProgram\n+\tdefer func() { newProgram = old }()\n+\tvar fp *fakeProgram\n+\tnewProgram = func(tea.Model, io.Reader, io.Writer) program {\n+\t\tfp = &fakeProgram{quit: make(chan struct{})}\n+\t\treturn fp\n+\t}\n+\ttake := func(context.Context) snapshot.Snapshot { return snapshot.Snapshot{} }\n+\n+\t// SIGINT path: ctx canceled, the controller stops gracefully.\n+\tctx, cancel := context.WithCancel(context.Background())\n+\tstopped := false\n+\tgo func() { time.Sleep(20 * time.Millisecond); cancel() }()\n+\terr := runWithUI(ctx, func(c context.Context) error { <-c.Done(); stopped = true; return nil }, take, \"o/r\", \"\", nil, io.Discard)\n+\tif err != nil || !stopped {\n+\t\tt.Errorf(\"err %v stopped %v\", err, stopped)\n+\t}\n+\n+\t// UI quit path: the controller is canceled and waited for.\n+\tstopped = false\n+\tdone := make(chan error, 1)\n+\tgo func() {\n+\t\tdone <- runWithUI(context.Background(), func(c context.Context) error { <-c.Done(); stopped = true; return nil }, take, \"o/r\", \"\", nil, io.Discard)\n+\t}()\n+\ttime.Sleep(20 * time.Millisecond)\n+\tfp.Send(tea.Quit())\n+\tif err := <-done; err != nil || !stopped {\n+\t\tt.Errorf(\"err %v stopped %v\", err, stopped)\n+\t}\n+}\ndiff --git a/internal/ui/keys.go b/internal/ui/keys.go\nnew file mode 100644\nindex 0000000..04fa87f\n--- /dev/null\n+++ b/internal/ui/keys.go\n@@ -0,0 +1,74 @@\n+package ui\n+\n+import (\n+\t\"fmt\"\n+\t\"os/exec\"\n+\t\"runtime\"\n+\n+\ttea \"charm.land/bubbletea/v2\"\n+)\n+\n+// IssueURL is the browser URL of issue n; it is built from the integer only.\n+func IssueURL(repo string, n int) string {\n+\treturn fmt.Sprintf(\"https://github.com/%s/issues/%d\", repo, n)\n+}\n+\n+// OpenBrowser opens url with the platform opener, no shell, errors ignored.\n+func OpenBrowser(url string) error {\n+\tname := \"xdg-open\"\n+\tif runtime.GOOS == \"darwin\" {\n+\t\tname = \"open\"\n+\t}\n+\tcmd := exec.Command(name, url)\n+\tif err := cmd.Start(); err != nil {\n+\t\treturn err\n+\t}\n+\tgo func() { _ = cmd.Wait() }()\n+\treturn nil\n+}\n+\n+func (m Model) handleKey(k tea.KeyPressMsg) (Model, tea.Cmd) {\n+\tkey := k.String()\n+\tif key == \"ctrl+c\" {\n+\t\treturn m, tea.Quit\n+\t}\n+\tif m.confirmQuit {\n+\t\tif key == \"y\" || key == \"enter\" {\n+\t\t\treturn m, tea.Quit\n+\t\t}\n+\t\tm.confirmQuit = false\n+\t\treturn m, nil\n+\t}\n+\tswitch key {\n+\tcase \"?\":\n+\t\tm.help = !m.help\n+\tcase \"j\", \"down\":\n+\t\tm.move(1)\n+\tcase \"k\", \"up\":\n+\t\tm.move(-1)\n+\tcase \"o\":\n+\t\tif m.selected >= 0 && m.selected < len(m.snap.Issues) && m.open != nil {\n+\t\t\tif n := m.snap.Issues[m.selected].Issue; n > 0 {\n+\t\t\t\t_ = m.open(IssueURL(m.Repo, n))\n+\t\t\t}\n+\t\t}\n+\tcase \"q\":\n+\t\tm.confirmQuit = true\n+\t}\n+\treturn m, nil\n+}\n+\n+func (m *Model) move(d int) {\n+\tn := len(m.snap.Issues)\n+\tif n == 0 {\n+\t\tm.selected = 0\n+\t\treturn\n+\t}\n+\tm.selected += d\n+\tif m.selected < 0 {\n+\t\tm.selected = 0\n+\t}\n+\tif m.selected > n-1 {\n+\t\tm.selected = n - 1\n+\t}\n+}\ndiff --git a/internal/ui/model.go b/internal/ui/model.go\nnew file mode 100644\nindex 0000000..31a2450\n--- /dev/null\n+++ b/internal/ui/model.go\n@@ -0,0 +1,73 @@\n+package ui\n+\n+import (\n+\t\"context\"\n+\t\"time\"\n+\n+\ttea \"charm.land/bubbletea/v2\"\n+\n+\t\"github.com/albertcbrown/ard/internal/snapshot\"\n+)\n+\n+// Model is the Bubble Tea model. It is read-only: it takes snapshots and\n+// draws them.\n+type Model struct {\n+\tRepo    string // owner/repo\n+\tLogPath string // shown in the header\n+\n+\ttake func(context.Context) snapshot.Snapshot\n+\topen func(url string) error\n+\n+\tsnap          snapshot.Snapshot\n+\twidth, height int\n+\tselected      int\n+\thelp          bool\n+\tconfirmQuit   bool\n+}\n+\n+type tickMsg struct{}\n+type snapMsg snapshot.Snapshot\n+\n+// RefreshEvery is the redraw interval.\n+const RefreshEvery = time.Second\n+\n+// New returns a Model. take must make no GitHub call; open may be nil.\n+func New(repo, logPath string, take func(context.Context) snapshot.Snapshot, open func(string) error) Model {\n+\treturn Model{Repo: repo, LogPath: logPath, take: take, open: open, width: 80, height: 24}\n+}\n+\n+func (m Model) tick() tea.Cmd {\n+\treturn tea.Tick