ear only on the large frame\")\n+\t}\n+}\n+\n+func TestEscapesInert(t *testing.T) {\n+\ts := fixed()\n+\tevil := \"\\x1b]0;pwn\\x07\\x1b[2J\\x9b31m\"\n+\ts.Errors = []string{evil + \"err\"}\n+\ts.Running[0].Role = evil + \"role\"\n+\ts.Pause[0].Err = evil\n+\ts.Events = []snapshot.Event{{Msg: evil + \"msg\", Attrs: evil}}\n+\ts.Issues[0].State = evil + \"state\"\n+\tfor _, sz := range [][2]int{{80, 24}, {160, 50}} {\n+\t\tout := Render(model(sz[0], sz[1], s))\n+\t\t// Only SGR style sequences may remain.\n+\t\tstripped := ansi.Strip(out)\n+\t\tif strings.ContainsAny(stripped, \"\\x1b\\x07\\x9b\") {\n+\t\t\tt.Fatalf(\"control characters survived: %q\", stripped)\n+\t\t}\n+\t\tif strings.Contains(out, \"]0;pwn\") || strings.Contains(out, \"[2J\") {\n+\t\t\tt.Fatal(\"escape payload survived\")\n+\t\t}\n+\t}\n+}\n+\n+func key(s string) tea.Msg {\n+\tswitch s {\n+\tcase \"ctrl+c\":\n+\t\treturn tea.KeyPressMsg{Code: 'c', Mod: tea.ModCtrl}\n+\tcase \"down\":\n+\t\treturn tea.KeyPressMsg{Code: tea.KeyDown}\n+\tcase \"up\":\n+\t\treturn tea.KeyPressMsg{Code: tea.KeyUp}\n+\tcase \"enter\":\n+\t\treturn tea.KeyPressMsg{Code: tea.KeyEnter}\n+\t}\n+\tr := []rune(s)[0]\n+\treturn tea.KeyPressMsg{Code: r, Text: s}\n+}\n+\n+func send(m Model, msgs ...string) (Model, tea.Cmd) {\n+\tvar cmd tea.Cmd\n+\tfor _, k := range msgs {\n+\t\tvar nm tea.Model\n+\t\tnm, cmd = m.Update(key(k))\n+\t\tm = nm.(Model)\n+\t}\n+\treturn m, cmd\n+}\n+\n+func isQuit(c tea.Cmd) bool {\n+\tif c == nil {\n+\t\treturn false\n+\t}\n+\t_, ok := c().(tea.QuitMsg)\n+\treturn ok\n+}\n+\n+func TestKeys(t *testing.T) {\n+\tvar opened []string\n+\tm := model(80, 24, fixed())\n+\tm.open = func(u string) error { opened = append(opened, u); return nil }\n+\n+\tm, _ = send(m, \"k\", \"up\")\n+\tif m.selected != 0 {\n+\t\tt.Errorf(\"selection below 0: %d\", m.selected)\n+\t}\n+\tm, _ = send(m, \"j\", \"down\", \"j\")\n+\tif m.selected != 3 {\n+\t\tt.Errorf(\"selected = %d\", m.selected)\n+\t}\n+\tm, _ = send(m, \"o\")\n+\tif len(opened) != 1 || opened[0] != \"https://github.com/o/r/issues/4\" {\n+\t\tt.Errorf(\"opened %v\", opened)\n+\t}\n+\tfor i := 0; i < 100; i++ {\n+\t\tm, _ = send(m, \"j\")\n+\t}\n+\tif m.selected != 59 {\n+\t\tt.Errorf(\"selection not clamped: %d\", m.selected)\n+\t}\n+\tm, _ = send(m, \"?\")\n+\tif !m.help {\n+\t\tt.Error(\"? should show help\")\n+\t}\n+\tm, _ = send(m, \"?\")\n+\tif m.help {\n+\t\tt.Error(\"? should hide help\")\n+\t}\n+\tm, c := send(m, \"q\")\n+\tif !m.confirmQuit || isQuit(c) {\n+\t\tt.Error(\"q must ask first\")\n+\t}\n+\tm, c = send(m, \"n\")\n+\tif m.confirmQuit || isQuit(c) {\n+\t\tt.Error(\"n must cancel\")\n+\t}\n+\tm, c = send(m, \"q\", \"y\")\n+\tif !isQuit(c) {\n+\t\tt.Error(\"q y must quit\")\n+\t}\n+\tif _, c = send(model(80, 24, fixed()), \"ctrl+c\"); !isQuit(c) {\n+\t\tt.Error(\"ctrl+c must quit at once\")\n+\t}\n+\tempty := model(80, 24, snapshot.Snapshot{})\n+\tempty.open = func(string) error { t.Error(\"open on empty list\"); return nil }\n+\tsend(empty, \"o\", \"j\")\n+}\n+\n+func TestUpdateTickAndResize(t *testing.T) {\n+\tcalls := 0\n+\tm := New(\"o/r\", \"\", func(context.Context) snapshot.Snapshot { calls++; return fixed() }, nil)\n+\tnm, _ := m.Update(tea.WindowSizeMsg{Width: 120, Height: 30})\n+\tm = nm.(Model)\n+\tif m.width != 120 || m.height != 30 {\n+\t\tt.Fatalf(\"size %dx%d\", m.width, m.height)\n+\t}\n+\tmsg := m.Init()()\n+\tif calls != 1 {\n+\t\tt.Fatalf(\"take called %d times\", calls)\n+\t}\n+\tnm, cmd := m.Update(msg)\n+\tm = nm.(Model)\n+\tif len(m.snap.Issues) != 60 || cmd == nil {\n+\t\tt.Fatal(\"snapshot not stored or tick not scheduled\")\n+\t}\n+\tnm, cmd = m.Update(tickMsg{})\n+\tif cmd == nil {\n+\t\tt.Fatal(\"tick must fetch\")\n+\t}\n+\tcmd()\n+\tif calls != 2 {\n+\t\tt.Errorf(\"take called %d times\", calls)\n+\t}\n+\t_ = fmt.Sprint(nm)\n+}\ndiff --git a/internal/ui/view.go b/internal/ui/view.go\nnew file mode 100644\nindex 0000000..8d17dad\n--- /dev/null\n+++ b/internal/ui/view.go\n@@ -0,0 +1,188 @@\n+package ui\n+\n+import (\n+\t\"fmt\"\n+\t\"strings\"\n+\t\"time\"\n+\n+\t\"charm.land/lipgloss/v2\"\n+)\n+\n+const (\n+\tminWidth, minHeight     = 20, 8\n+\tlargeWidth, largeHeight = 100, 40\n+)\n+\n+var (\n+\ttitleStyle = lipgloss.NewStyle().Bold(true)\n+\theadStyle  = lipgloss.NewStyle().Bold(true).Underline(true)\n+\tselStyle   = lipgloss.NewStyle().Reverse(true)\n+\twarnStyle  = lipgloss.NewStyle().Bold(true)\n+\tdimStyle   = lipgloss.NewStyle().Faint(true)\n+)\n+\n+func dur(d time.Duration) string {\n+\td = d.Round(time.Second)\n+\tif d < 0 {\n+\t\td = 0\n+\t}\n+\tif d >= time.Hour {\n+\t\treturn fmt.Sprintf(\"%dh%02dm\", int(d.Hours()), int(d.Minutes())%60)\n+\t}\n+\treturn fmt.Sprintf(\"%dm%02ds\", int(d.Minutes()), int(d.Seconds())%60)\n+}\n+\n+func usd(p *float64) string {\n+\tif p == nil {\n+\t\treturn \"-\"\n+\t}\n+\treturn fmt.Sprintf(\"$%.2f\", *p)\n+}\n+\n+// Render draws the model into a string of height lines, each at most width\n+// cells wide. It is pure: the clock comes from the snapshot. Every string that\n+// came from outside the process goes through Clean or Trunc.\n+func Render(m Model) string {\n+\tw, h := m.width, m.height\n+\tif w < minWidth || h < minHeight {\n+\t\treturn \"terminal too small\"\n+\t}\n+\ts := m.snap\n+\tvar lines []string\n+\tadd := func(l string) { lines = append(lines, Trunc(l, w)) }\n+\tsection := func(t string) { lines = append(lines, headStyle.Render(Trunc(t, w))) }\n+\n+\tadd(titleStyle.Render(\"ard serve\") + \"  \" + Clean(m.Repo))\n+\thdr := fmt.Sprintf(\"%s  pool %d/%d  spend $%.2f\", s.TakenAt.UTC().Format(\"2006-01-02 15:04:05Z\"), s.Pool.Used, s.Pool.Max, s.Spend.RepoUSD)\n+\tif s.Spend.RepoCap > 0 {\n+\t\thdr += fmt.Sprintf(\" of $%.2f\", s.Spend.RepoCap)\n+\t}\n+\tadd(hdr)\n+\tif m.LogPath != \"\" {\n+\t\tadd(dimStyle.Render(\"logs: \" + Clean(m.LogPath)))\n+\t}\n+\n+\tsection(\"Needs you\")\n+\tneed := 0\n+\tfor _, p := range s.Pause {\n+\t\tneed++\n+\t\tadd(warnStyle.Render(\"paused\") + fmt.Sprintf(\" %s: %s %s\", Clean(p.Loop), Clean(string(p.Reason)), Clean(p.Err)))\n+\t}\n+\tfor _, c := range s.Spend.CappedNow {\n+\t\tneed++\n+\t\tadd(warnStyle.Render(\"capped\") + fmt.Sprintf(\" %v\", c))\n+\t}\n+\tfor _, b := range s.Limits.Blocks {\n+\t\tneed++\n+\t\tfam := Clean(b.Family)\n+\t\tif fam == \"\" {\n+\t\t\tfam = \"unknown\"\n+\t\t}\n+\t\tadd(warnStyle.Render(\"limit\") + fmt.Sprintf(\" %s until %s\", fam, b.Until.UTC().Format(\"15:04Z\")))\n+\t}\n+\tfor _, e := range s.Errors {\n+\t\tneed++\n+\t\tadd(warnStyle.Render(\"error\") + \" \" + Clean(e))\n+\t}\n+\tif need == 0 {\n+\t\tadd(dimStyle.Render(\"nothing\"))\n+\t}\n+\n+\tsection(fmt.Sprintf(\"Running (%d)\", len(s.Running)))\n+\tfor _, r := range s.Running {\n+\t\tref := \"scan\"\n+\t\tif r.Issue > 0 {\n+\t\t\tref = fmt.Sprintf(\"#%d\", r.Issue)\n+\t\t}\n+\t\tt := dur(r.Elapsed)\n+\t\tif r.Timeout > 0 {\n+\t\t\tt += \"/\" + dur(r.Timeout)\n+\t\t}\n+\t\tadd(fmt.Sprintf(\"%-6s %s:%s %s %s\", ref, Clean(r.Stage), Clean(r.Role), t, usd(r.FinishedCostUSD)))\n+\t}\n+\n+\tsection(\"Waiting\")\n+\tif len(s.Pool.Waiting) == 0 {\n+\t\tadd(dimStyle.Render(\"nothing\"))\n+\t}\n+\tfor _, x := range s.Pool.Waiting {\n+\t\tl := fmt.Sprintf(\"%s:%s %d %s\", Clean(x.Class), Clean(x.Role), x.Count, Clean(x.Reason))\n+\t\tif x.Oldest > 0 {\n+\t\t\tl += \" oldest \" + dur(x.Oldest)\n+\t\t}\n+\t\tadd(l)\n+\t}\n+\n+\tsection(\"Limits\")\n+\tif len(s.Limits.Windows) == 0 {\n+\t\tadd(dimStyle.Render(\"no readings\"))\n+\t}\n+\tfor _, x := range s.Limits.Windows {\n+\t\tadd(fmt.Sprintf(\"%s %3.0f%% %s resets %s\", Clean(x.Window), x.Utilization*100, Clean(x.Status), x.ResetsAt.UTC().Format(\"15:04Z\")))\n+\t}\n+\n+\tvar tail []string\n+\tif w >= largeWidth && h >= largeHeight {\n+\t\ttail = append(tail, headStyle.Render(\"Next tick\"))\n+\t\tfor _, t := range s.Ticks {\n+\t\t\tl := fmt.Sprintf(\"%-10s ticks %d last %s\", Clean(t.Loop), t.Count, t.End.UTC().Format(\"15:04:05Z\"))\n+\t\t\tif t.Err != \"\" {\n+\t\t\t\tl += \" err: \" + Clean(t.Err)\n+\t\t\t}\n+\t\t\ttail = append(tail, Trunc(l, w))\n+\t\t}\n+\t\ttail = append(tail, headStyle.Render(\"Recent events\"))\n+\t\tev := s.Events\n+\t\tif len(ev) > 8 {\n+\t\t\tev = ev[len(ev)-8:]\n+\t\t}\n+\t\tfor _, e := range ev {\n+\t\t\ttail = append(tail, Trunc(fmt.Sprintf(\"%s %s %s %s\", e.Time.UTC().Format(\"15:04:05\"), e.Level, Clean(e.Msg), Clean(e.Attrs)), w))\n+\t\t}\n+\t}\n+\n+\tif m.help {\n+\t\tlines = append(lines, headStyle.Render(\"Help\"),\n+\t\t\t\"?  toggle help\", \"j/k, arrows  select issue\", \"o  open selected issue in the browser\", \"q  quit (asks first)\", \"ctrl+c  stop now\")\n+\t}\n+\n+\troom := h - len(lines) - len(tail) - 2 // issues heading and footer\n+\tif room < 1 {\n+\t\troom = 1\n+\t}\n+\tpages := (len(s.Issues) + room - 1) / room\n+\tif pages < 1 {\n+\t\tpages = 1\n+\t}\n+\tpage := m.selected / room\n+\ttitle := \"Issues\"\n+\tif pages > 1 {\n+\t\ttitle = fmt.Sprintf(\"Issues (page %d/%d)\", page+1, pages)\n+\t}\n+\tsection(title)\n+\tif len(s.Issues) == 0 {\n+\t\tlines = append(lines, dimStyle.Render(\"none today\"))\n+\t}\n+\tfor i := page * room; i < len(s.Issues) && i < (page+1)*room; i++ {\n+\t\tx := s.Issues[i]\n+\t\tl := Trunc(fmt.Sprintf(\"#%-5d %s  jobs %d  %s\", x.Issue, Clean(x.State), x.Jobs, usd(x.CostUSD)), w)\n+\t\tif i == m.selected {\n+\t\t\tl = selStyle.Render(l)\n+\t\t}\n+\t\tlines = append(lines, l)\n+\t}\n+\tlines = append(lines, tail...)\n+\n+\tfooter := \"? help  j/k select  o open  q quit\"\n+\tif m.confirmQuit {\n+\t\tfooter = \"quit? y/n\"\n+\t}\n+\tif len(lines) > h-1 {\n+\t\tlines = lines[:h-1]\n+\t}\n+\tfor len(lines) < h-1 {\n+\t\tlines = append(lines, \"\")\n+\t}\n+\tlines = append(lines, dimStyle.Render(Trunc(footer, w)))\n+\treturn strings.Join(lines, \"\\n\")\n+}\n","numLines":464,"startLine":1009,"totalLines":1472}},"tool_result_meta":[{"id":"toolu_017msnpyxCHpfLzBtfq9KGgY","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
