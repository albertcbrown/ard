os.MkdirAll(dir, 0o700); err != nil {\n484\t+\t\treturn nil, \"\", err\n485\t+\t}\n486\t+\tc := &capFile{path: filepath.Join(dir, \"serve.log\"), cap: serveLogCap}\n487\t+\tif err := c.open(); err != nil {\n488\t+\t\treturn nil, \"\", err\n489\t+\t}\n490\t+\treturn c, c.path, nil\n491\t+}\n492\t+\n493\t+func (c *capFile) open() error {\n494\t+\tf, err := os.OpenFile(c.path, os.O_WRONLY|os.O_APPEND|os.O_CREATE, 0o600)\n495\t+\tif err != nil {\n496\t+\t\treturn err\n497\t+\t}\n498\t+\tif err := f.Chmod(0o600); err != nil {\n499\t+\t\tf.Close()\n500\t+\t\treturn err\n501\t+\t}\n502\t+\tst, err := f.Stat()\n503\t+\tif err != nil {\n504\t+\t\tf.Close()\n505\t+\t\treturn err\n506\t+\t}\n507\t+\tc.f, c.size = f, st.Size()\n508\t+\treturn nil\n509\t+}\n510\t+\n511\t+// Write appends p, rotating first when it would pass the cap.\n512\t+func (c *capFile) Write(p []byte) (int, error) {\n513\t+\tc.mu.Lock()\n514\t+\tdefer c.mu.Unlock()\n515\t+\tif c.f == nil {\n516\t+\t\treturn 0, os.ErrClosed\n517\t+\t}\n518\t+\tif c.size > 0 && c.size+int64(len(p)) > c.cap {\n519\t+\t\tc.f.Close()\n520\t+\t\tif err := os.Rename(c.path, c.path+\".1\"); err != nil {\n521\t+\t\t\treturn 0, fmt.Errorf(\"rotate serve.log: %w\", err)\n522\t+\t\t}\n523\t+\t\tif err := c.open(); err != nil {\n524\t+\t\t\tc.f = nil\n525\t+\t\t\treturn 0, err\n526\t+\t\t}\n527\t+\t}\n528\t+\tn, err := c.f.Write(p)\n529\t+\tc.size += int64(n)\n530\t+\treturn n, err\n531\t+}\n532\t+\n533\t+// Close closes the file.\n534\t+func (c *capFile) Close() error {\n535\t+\tc.mu.Lock()\n536\t+\tdefer c.mu.Unlock()\n537\t+\tif c.f == nil {\n538\t+\t\treturn nil\n539\t+\t}\n540\t+\terr := c.f.Close()\n541\t+\tc.f = nil\n542\t+\treturn err\n543\t+}\n544\tdiff --git a/internal/servecmd/uilog_test.go b/internal/servecmd/uilog_test.go\n545\tnew file mode 100644\n546\tindex 0000000..8dfa1d2\n547\t--- /dev/null\n548\t+++ b/internal/servecmd/uilog_test.go\n549\t@@ -0,0 +1,123 @@\n550\t+package servecmd\n551\t+\n552\t+import (\n553\t+\t\"bytes\"\n554\t+\t\"context\"\n555\t+\t\"io\"\n556\t+\t\"os\"\n557\t+\t\"path/filepath\"\n558\t+\t\"strings\"\n559\t+\t\"sync\"\n560\t+\t\"testing\"\n561\t+\t\"time\"\n562\t+\n563\t+\ttea \"charm.land/bubbletea/v2\"\n564\t+\n565\t+\t\"github.com/albertcbrown/ard/internal/github\"\n566\t+\t\"github.com/albertcbrown/ard/internal/snapshot\"\n567\t+)\n568\t+\n569\t+func TestUIWanted(t *testing.T) {\n570\t+\tenv := func(term string) func(string) string { return func(string) string { return term } }\n571\t+\tvar buf bytes.Buffer\n572\t+\tpr, pw, _ := os.Pipe()\n573\t+\tdefer pr.Close()\n574\t+\tdefer pw.Close()\n575\t+\tfor _, c := range []struct {\n576\t+\t\tname    string\n577\t+\t\tmode    string\n578\t+\t\tout     io.Writer\n579\t+\t\tterm    string\n580\t+\t\twant    bool\n581\t+\t\twantErr bool\n582\t+\t}{\n583\t+\t\t{\"buffer\", uiAuto, &buf, \"xterm\", false, false},\n584\t+\t\t{\"pipe\", uiAuto, pw, \"xterm\", false, false},\n585\t+\t\t{\"no-ui\", uiOff, pw, \"xterm\", false, false},\n586\t+\t\t{\"dumb\", uiAuto, pw, \"dumb\", false, false},\n587\t+\t\t{\"--ui on a pipe\", uiOn, pw, \"xterm\", false, true},\n588\t+\t\t{\"--ui non-file\", uiOn, &buf, \"xterm\", false, true},\n589\t+\t} {\n590\t+\t\tgot, err := uiWanted(c.mode, pr, c.out, env(c.term))\n591\t+\t\tif got != c.want || (err != nil) != c.wantErr {\n592\t+\t\t\tt.Errorf(\"%s: got %v, %v\", c.name, got, err)\n593\t+\t\t}\n594\t+\t}\n595\t+}\n596\t+\n597\t+func TestServeLog(t *testing.T) {\n598\t+\thome := t.TempDir()\n599\t+\tlf, path, err := openServeLog(home, github.Repo{Owner: \"o\", Name: \"r\"})\n600\t+\tif err != nil {\n601\t+\t\tt.Fatal(err)\n602\t+\t}\n603\t+\tdefer lf.Close()\n604\t+\tif want := filepath.Join(home, \".ard\", \"logs\", \"o\", \"r\", \"serve.log\"); path != want {\n605\t+\t\tt.Errorf(\"path = %s, want %s\", path, want)\n606\t+\t}\n607\t+\tif st, _ := os.Stat(path); st.Mode().Perm() != 0o600 {\n608\t+\t\tt.Errorf(\"file mode %v\", st.Mode())\n609\t+\t}\n610\t+\tif st, _ := os.Stat(filepath.Dir(path)); st.Mode().Perm() != 0o700 {\n611\t+\t\tt.Errorf(\"dir mode %v\", st.Mode())\n612\t+\t}\n613\t+\tlf.cap = 100\n614\t+\tfor i := 0; i < 20; i++ {\n615\t+\t\tif _, err := lf.Write([]byte(strings.Repeat(\"x\", 30) + \"\\n\")); err != nil {\n616\t+\t\t\tt.Fatal(err)\n617\t+\t\t}\n618\t+\t}\n619\t+\tfor _, p := range []string{path, path + \".1\"} {\n620\t+\t\tst, err := os.Stat(p)\n621\t+\t\tif err != nil {\n622\t+\t\t\tt.Fatal(err)\n623\t+\t\t}\n624\t+\t\tif st.Size() > 100 || st.Mode().Perm() != 0o600 {\n625\t+\t\t\tt.Errorf(\"%s: size %d mode %v\", p, st.Size(), st.Mode())\n626\t+\t\t}\n627\t+\t}\n628\t+}\n629\t+\n630\t+type fakeProgram struct {\n631\t+\tquit chan struct{}\n632\t+\tonce sync.Once\n633\t+}\n634\t+\n635\t+func (f *fakeProgram) Run() (tea.Model, error) { <-f.quit; return nil, nil }\n636\t+func (f *fakeProgram) Send(m tea.Msg) {\n637\t+\tif _, ok := m.(tea.QuitMsg); ok {\n638\t+\t\tf.once.Do(func() { close(f.quit) })\n639\t+\t}\n640\t+}\n641\t+\n642\t+func TestRunWithUI(t *testing.T) {\n643\t+\told := newProgram\n644\t+\tdefer func() { newProgram = old }()\n645\t+\tvar fp *fakeProgram\n646\t+\tnewProgram = func(tea.Model, io.Reader, io.Writer) program {\n647\t+\t\tfp = &fakeProgram{quit: make(chan struct{})}\n648\t+\t\treturn fp\n649\t+\t}\n650\t+\ttake := func(context.Context) snapshot.Snapshot { return snapshot.Snapshot{} }\n651\t+\n652\t+\t// SIGINT path: ctx canceled, the controller stops gracefully.\n653\t+\tctx, cancel := context.WithCancel(context.Background())\n654\t+\tstopped := false\n655\t+\tgo func() { time.Sleep(20 * time.Millisecond); cancel() }()\n656\t+\terr := runWithUI(ctx, func(c context.Context) error { <-c.Done(); stopped = true; return nil }, take, \"o/r\", \"\", nil, io.Discard)\n657\t+\tif err != nil || !stopped {\n658\t+\t\tt.Errorf(\"err %v stopped %v\", err, stopped)\n659\t+\t}\n660\t+\n661\t+\t// UI quit path: the controller is canceled and waited for.\n662\t+\tstopped = false\n663\t+\tdone := make(chan error, 1)\n664\t+\tgo func() {\n665\t+\t\tdone <- runWithUI(context.Background(), func(c context.Context) error { <-c.Done(); stopped = true; return nil }, take, \"o/r\", \"\", nil, io.Discard)\n666\t+\t}()\n667\t+\ttime.Sleep(20 * time.Millisecond)\n668\t+\tfp.Send(tea.Quit())\n669\t+\tif err := <-done; err != nil || !stopped {\n670\t+\t\tt.Errorf(\"err %v stopped %v\", err, stopped)\n671\t+\t}\n672\t+}\n673\tdiff --git a/internal/ui/keys.go b/internal/ui/keys.go\n674\tnew file mode 100644\n675\tindex 0000000..04fa87f\n676\t--- /dev/null\n677\t+++ b/internal/ui/keys.go\n678\t@@ -0,0 +1,74 @@\n679\t+package ui\n680\t+\n681\t+import (\n682\t+\t\"fmt\"\n683\t+\t\"os/exec\"\n684\t+\t\"runtime\"\n685\t+\n686\t+\ttea \"charm.land/bubbletea/v2\"\n687\t+)\n688\t+\n689\t+// IssueURL is the browser URL of issue n; it is built from the integer only.\n690\t+func IssueURL(repo string, n int) string {\n691\t+\treturn fmt.Sprintf(\"https://github.com/%s/issues/%d\", repo, n)\n692\t+}\n693\t+\n694\t+// OpenBrowser opens url with the platform opener, no shell, errors ignored.\n695\t+func OpenBrowser(url string) error {\n696\t+\tname := \"xdg-open\"\n697\t+\tif runtime.GOOS == \"darwin\" {\n698\t+\t\tname = \"open\"\n699\t+\t}\n700\t+\tcmd := exec.Command(name, url)\n701\t+\tif err := cmd.Start(); err != nil {\n702\t+\t\treturn err\n703\t+\t}\n704\t+\tgo func() { _ = cmd.Wait() }()\n705\t+\treturn nil\n706\t+}\n707\t+\n708\t+func (m Model) handleKey(k tea.KeyPressMsg) (Model, tea.Cmd) {\n709\t+\tkey := k.String()\n710\t+\tif key == \"ctrl+c\" {\n711\t+\t\treturn m, tea.Quit\n712\t+\t}\n713\t+\tif m.confirmQuit {\n714\t+\t\tif key == \"y\" || key == \"enter\" {\n715\t+\t\t\treturn m, tea.Quit\n716\t+\t\t}\n717\t+\t\tm.confirmQuit = false\n718\t+\t\treturn m, nil\n719\t+\t}\n720\t+\tswitch key {\n721\t+\tcase \"?\":\n722\t+\t\tm.help = !m.help\n723\t+\tcase \"j\", \"down\":\n724\t+\t\tm.move(1)\n725\t+\tcase \"k\", \"up\":\n726\t+\t\tm.move(-1)\n727\t+\tcase \"o\":\n728\t+\t\tif m.selected >= 0 && m.selected < len(m.snap.Issues) && m.open != nil {\n729\t+\t\t\tif n := m.snap.Issues[m.selected].Issue; n > 0 {\n730\t+\t\t\t\t_ = m.open(IssueURL(m.Repo, n))\n731\t+\t\t\t}\n732\t+\t\t}\n733\t+\tcase \"q\":\n734\t+\t\tm.confirmQuit = true\n735\t+\t}\n736\t+\treturn m, nil\n737\t+}\n738\t+\n739\t+func (m *Model) move(d int) {\n740\t+\tn := len(m.snap.Issues)\n741\t+\tif n == 0 {\n742\t+\t\tm.selected = 0\n743\t+\t\treturn\n744\t+\t}\n745\t+\tm.selected += d\n746\t+\tif m.selected < 0 {\n747\t+\t\tm.selected = 0\n748\t+\t}\n749\t+\tif m.selected > n-1 {\n750\t+\t\tm.selected = n - 1\n751\t+\t}\n752\t+}\n753\tdiff --git a/internal/ui/model.go b/internal/ui/model.go\n754\tnew file mode 100644\n755\tindex 0000000..31a2450\n756\t--- /dev/null\n757\t+++ b/internal/ui/model.go\n758\t@@ -0,0 +1,73 @@\n759\t+package ui\n760\t+\n761\t+import (\n762\t+\t\"context\"\n763\t+\t\"time\"\n764\t+\n765\t+\ttea \"charm.land/bubbletea/v2\"\n766\t+\n767\t+\t\"github.com/albertcbrown/ard/internal/snapshot\"\n768\t+)\n769\t+\n770\t+// Model is the Bubble Tea model. It is read-only: it takes snapshots and\n771\t+// draws them.\n772\t+type Model struct {\n773\t+\tRepo    string // owner/repo\n774\t+\tLogPath string // shown in the header\n775\t+\n776\t+\ttake func(context.Context) snapshot.Snapshot\n777\t+\topen func(url string) error\n778\t+\n779\t+\tsnap          snapshot.Snapshot\n780\t+\twidth, height int\n781\t+\tselected      int\n782\t+\thelp          bool\n783\t+\tconfirmQuit   bool\n784\t+}\n785\t+\n786\t+type tickMsg struct{}\n787\t+type snapMsg snapshot.Snapshot\n788\t+\n789\t+// RefreshEvery is the redraw interval.\n790\t+const RefreshEvery = time.Second\n791\t+\n792\t+// New returns a Model. take must make no GitHub call; open may be nil.\n793\t+func New(repo, logPath string, take func(context.Context) snapshot.Snapshot, open func(string) error) Model {\n794\t+\treturn Model{Repo: repo, LogPath: logPath, take: take, open: open, width: 80, height: 24}\n795\t+}\n796\t+\n797\t+func (m Model) tick() tea.Cmd {\n798\t+\treturn tea.Tick(RefreshEvery, func(time.Time) tea.Msg { return tickMsg{} })\n799\t+}\n800\t+\n801\t+func (m Model) fetch() tea.Cmd {\n802\t+\ttake := m.take\n803\t+\treturn func() tea.Msg { return snapMsg(take(context.Background())) }\n804\t+}\n805\t+\n806\t+// Init takes the first snapshot at once.\n807\t+func (m Model) Init() tea.Cmd { return m.fetch() }\n808\t+\n809\t+// Update implements tea.Model.\n810\t+func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {\n811\t+\tswitch msg := msg.(type) {\n812\t+\tcase tea.WindowSizeMsg:\n813\t+\t\tm.width, m.height = msg.Width, msg.Height\n814\t+\tcase tickMsg:\n815\t+\t\treturn m, m.fetch()\n816\t+\tcase snapMsg:\n817\t+\t\tm.snap = snapshot.Snapshot(msg)\n818\t+\t\tm.move(0)\n819\t+\t\treturn m, m.tick()\n820\t+\tcase tea.KeyPressMsg:\n821\t+\t\treturn m.handleKey(msg)\n822\t+\t}\n823\t+\treturn m, nil\n824\t+}\n825\t+\n826\t+// View implements tea.Model.\n827\t+func (m Model) View() tea.View {\n828\t+\tv := tea.NewView(Render(m))\n829\t+\tv.AltScreen = true\n830\t+\treturn v\n831\t+}\n832\tdiff --git a/internal/ui/sanitize.go b/internal/ui/sanitize.go\n833\tnew file mode 100644\n834\tindex 0000000..0d6cd09\n835\t--- /dev/null\n836\t+++ b/internal/ui/sanitize.go\n837\t@@ -0,0 +1,63 @@\n838\t+// Package ui is the read-only terminal UI of `ard serve` (the command\n839\t+// center). It draws a snapshot.Snapshot; it never calls GitHub.\n840\t+package ui\n841\t+\n842\t+import (\n843\t+\t\"strings\"\n844\t+\t\"unicode\"\n845\t+\t\"unicode/utf8\"\n846\t+\n847\t+\t\"github.com/charmbracelet/x/ansi\"\n848\t+)\n849\t+\n850\t+// Clean makes an untrusted string safe to draw: escape sequences (CSI, OSC,\n851\t+// DCS and the like) are dropped whole, other C0/C1 controls, DEL, bidi\n852\t+// overrides and invalid UTF-8 are removed, and whitespace controls become one\n853\t+// space.\n854\t+func Clean(s string) string {\n855\t+\t// Drop whole escape sequences first, so \"\\x1b[31m\" leaves no \"[31m\".\n856\t+\ts = stripSequences(s)\n857\t+\tvar b strings.Builder\n858\t+\tfor len(s) > 0 {\n859\t+\t\tr, n := utf8.DecodeRuneInString(s)\n860\t+\t\ts = s[n:]\n861\t+\t\tswitch {\n862\t+\t\tcase r == utf8.RuneError && n <= 1:\n863\t+\t\t\tcontinue\n864\t+\t\tcase r == '\\n' || r == '\\r' || r == '\\t':\n865\t+\t\t\tb.WriteByte(' ')\n866\t+\t\tcase r < 0x20 || r == 0x7f || (r >= 0x80 && r <= 0x9f):\n867\t+\t\t\tcontinue\n868\t+\t\tcase isBidi(r):\n869\t+\t\t\tcontinue\n870\t+\t\tcase !unicode.IsPrint(r) && r != ' ':\n871\t+\t\t\tcontinue\n872\t+\t\tdefault:\n873\t+\t\t\tb.WriteRune(r)\n874\t+\t\t}\n875\t+\t}\n876\t+\treturn b.String()\n877\t+}\n878\t+\n879\t+func isBidi(r rune) bool {\n880\t+\treturn (r >= 0x202a && r <= 0x202e) || (r >= 0x2066 && r <= 0x2069) || r == 0x200e || r == 0x200f || r == 0x061c\n881\t+}\n882\t+\n883\t+// stripSequences removes ESC and C1-introduced sequences using the ansi\n884\t+// parser. A lone C1 introducer (U+009B and friends) is handled by Clean.\n885\t+func stripSequences(s string) string {\n886\t+\t// ansi.Strip handles 7-bit ESC sequences. The 8-bit C1 forms are valid\n887\t+\t// UTF-8 only as U+0080..U+009F runes; Clean removes those runes, and the\n888\t+\t// text after them is plain text.\n889\t+\treturn ansi.Strip(s)\n890\t+}\n891\t+\n892\t+// Trunc cleans s and cuts it to at most width display cells, ending with an\n893\t+// ellipsis when it was cut.\n894\t+func Trunc(s string, width int) string {\n895\t+\ts = Clean(s)\n896\t+\tif width <= 0 {\n897\t+\t\treturn \"\"\n898\t+\t}\n899\t+\treturn ansi.Truncate(s, width, \"…\")\n900\t+}\n901\tdiff --git a/internal/ui/testdata/160x50.golden b/internal/ui/testdata/160x50.golden\n902\tnew file mode 100644\n903\tindex 0000000..19dc895\n904\t--- /dev/null\n905\t+++ b/internal/ui/testdata/160x50.golden\n906\t@@ -0,0 +1,50 @@\n907\t+ard serve  o/r\n908\t+2026-11-25 12:00:00Z  pool 2/4  spend $3.50 of $20.00\n909\t+logs: /home/u/.ard/logs/o/r/serve.log\n910\t+Needs you\n911\t+p