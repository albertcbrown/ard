 r <= 0x9f):\n+\t\t\tcontinue\n+\t\tcase isBidi(r):\n+\t\t\tcontinue\n+\t\tcase !unicode.IsPrint(r) && r != ' ':\n+\t\t\tcontinue\n+\t\tdefault:\n+\t\t\tb.WriteRune(r)\n+\t\t}\n+\t}\n+\treturn b.String()\n+}\n+\n+func isBidi(r rune) bool {\n+\treturn (r >= 0x202a && r <= 0x202e) || (r >= 0x2066 && r <= 0x2069) || r == 0x200e || r == 0x200f || r == 0x061c\n+}\n+\n+// stripSequences removes ESC and C1-introduced sequences using the ansi\n+// parser. A lone C1 introducer (U+009B and friends) is handled by Clean.\n+func stripSequences(s string) string {\n+\t// ansi.Strip handles 7-bit ESC sequences. The 8-bit C1 forms are valid\n+\t// UTF-8 only as U+0080..U+009F runes; Clean removes those runes, and the\n+\t// text after them is plain text.\n+\treturn ansi.Strip(s)\n+}\n+\n+// Trunc cleans s and cuts it to at most width display cells, ending with an\n+// ellipsis when it was cut.\n+func Trunc(s string, width int) string {\n+\ts = Clean(s)\n+\tif width <= 0 {\n+\t\treturn \"\"\n+\t}\n+\treturn ansi.Truncate(s, width, \"…\")\n+}\ndiff --git a/internal/ui/testdata/160x50.golden b/internal/ui/testdata/160x50.golden\nnew file mode 100644\nindex 0000000..19dc895\n--- /dev/null\n+++ b/internal/ui/testdata/160x50.golden\n@@ -0,0 +1,50 @@\n+ard serve  o/r\n+2026-11-25 12:00:00Z  pool 2/4  spend $3.50 of $20.00\n+logs: /home/u/.ard/logs/o/r/serve.log\n+Needs you\n+paused workers: label \n+limit opus until 14:00Z\n+error state: boom\n+Running (1)\n+#414   worker:engineer 5m00s/1h00m $1.25\n+Waiting\n+worker:engineer 3 slot oldest 1m30s\n+Limits\n+5h  42% allowed resets 13:00Z\n+Issues (page 1/2)\n+#1     triage:engineer done  jobs 1  $1.25\n+#2     triage:engineer done  jobs 1  $1.25\n+#3     triage:engineer done  jobs 1  $1.25\n+#4     triage:engineer done  jobs 1  $1.25\n+#5     triage:engineer done  jobs 1  $1.25\n+#6     triage:engineer done  jobs 1  $1.25\n+#7     triage:engineer done  jobs 1  $1.25\n+#8     triage:engineer done  jobs 1  $1.25\n+#9     triage:engineer done  