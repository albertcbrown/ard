ready has the starter files\")\ninternal/initcmd/plan.go:109:func changed(ops []op) []committer.InitFile {\ninternal/initcmd/plan.go-110-\tvar out []committer.InitFile\ninternal/initcmd/plan.go-111-\tfor _, o := range ops {\ninternal/initcmd/plan.go-112-\t\tif o.Act != actUnchanged {\ninternal/initcmd/plan.go-113-\t\t\tout = append(out, o.File)\ninternal/initcmd/plan.go-114-\t\t}\ninternal/initcmd/plan.go-115-\t}\ninternal/initcmd/plan.go-116-\treturn out\ninternal/initcmd/plan.go-117-}\ninternal/initcmd/plan.go-118-\ninternal/initcmd/plan.go-119-// overlay copies existing (files and directories) into a MapFS and lays files\ninternal/initcmd/plan.go-120-// on top, so config validation sees exactly the tree the PR would produce.\ninternal/initcmd/plan.go-121-// Directories are copied as well as files: an empty role directory on main\ninternal/initcmd/plan.go-122-// must still fail validation.\ninternal/initcmd/plan.go-123-func overlay(existing fs.FS, files []committer.InitFile) (fstest.MapFS, error) {\ninternal/initcmd/plan.go-124-\tm := fstest.MapFS{}\n\t// WalkDir sorts by entry name, so \"trufflehog/\" would precede \"trufflehog-history/\".\n\tslices.SortFunc(files, func(a, b committer.InitFile) int { return strings.Compare(a.Path, b.Path) })\n\treturn files, nil\n}\n\n// plan compares files with existing (main's config tree) and assigns each a\n// create, unchanged or overwrite action. A context doc (ContextPaths) that\n// exists on main in any form is unchanged, whatever force is. A file that differs without force is\n// a conflict; the error names every such path. A different exec bit counts as\n// a difference.\nfunc plan(existing fs.FS, files []committer.InitFile, force bool) ([]op, error) {\n\tops := make([]op, 0, len(files))\n\tvar conflicts []string\n\tfor _, f := range files {\n\t\to := op{File: f, Act: actCreate}\n\t\tfi, err := fs.Stat(existing, f.Path)\n\t\tswitch {\n\t\tcase err == nil && slices.Contains(ContextPaths(), f.Path):\n\t\t\t// create-if-absent: present in any form is left alone\n\t\t\to.Act = actUnchanged\n\t\tcase err != nil:\n\t\t\t// absent on main\n\t\tcase fi.IsDir():\n\t\t\treturn nil, fmt.Errorf(\"%s is a directory on main\", f.Path)\n\t\tdefault:\n\t\t\thave, err := fs.ReadFile(existing, f.Path)\n\t\t\tif err != nil {\n\t\t\t\treturn nil, fmt.Errorf(\"read %s from main: %w\", f.Path, err)\n\t\t\t}\n\t\t\thaveExec := fi.Mode()&0o111 != 0\n\t\t\tif bytes.Equal(have, f.Data) && haveExec == f.Exec {\n\t\t\t\to.Act = actUnchanged\n\t\t\t} else {\n\t\t\t\to.Act = actOverwrite\n\t\t\t\tif !force {\n\t\t\t\t\tconflicts = append(conflicts, f.Path)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tops = append(ops, o)\n\t}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Hw92srqYwbqj9kqx2LmQko","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
