s the same TruffleHog binary. To opt out, delete `.ard/scanners/trufflehog-history/` and its `scanners/trufflehog-history` line under `overrides:` in `.ard/config.yaml` before merging.\\n\")\n\tb.WriteString(\"\\n## Follow-up the App cannot do\\n\\n\")\n\tb.WriteString(\"ard's GitHub App has no permission to write `.github/`, so do this by hand:\\n\\n\")\n\tb.WriteString(\"1. Copy `.github/workflows/bot-commits.yml` from the ard repository into this repository.\\n\")\n\tb.WriteString(\"2. Set the repository variable `ARD_BOT_LOGIN` to the App's `<slug>[bot]` login.\\n\")\n\tb.WriteString(\"3. Optionally set the repository variable `ARD_BOT_CHECK_SINCE`.\\n\")\n\treturn b.String()\n}\npackage committer\n\nimport \"testing\"\n\nfunc TestCheckCodePath(t *testing.T) {\n\trefused := []string{\n\t\t\".github/workflows/ci.yml\", \".github/CODEOWNERS\", \".GitHub/x\",\n\t\t\".ard/config.yaml\", \".ard/workers/engineer/prompt.txt\", \".ard/12/worker-engineer.md\", \".ARD/Config.yaml\",\n\t\t\".ard-input/12/issue.md\", \"a/.git/hooks/x\", \"a/.GIT/x\", \".gitmodules\", \"sub/.gitmodules\", \".gitattributes\", \"sub/.gitattributes\", \"a/.GitAttributes\",\n\t\t\".\", \"..\", \"../x\", \"a/../../x\", \"../../etc/passwd\", \".git\\u200c/x\", \".github\\u200b/x\", \"a\\ufffd\", \"./a\", \"a//b\", \"/abs\", \"a\\\\b\", \"a\\x01b\", \"\", \".github\", \".ard\",\n\t\t// secret-shaped\n\t\t\".env\", \"config/.env.prod\", \"certs/server.pem\", \"id_ed25519.pub\", \".aws/credentials\",\n\t\t\"x/.docker/config.json\", \"service-account-prod.json\", \"a/.NPMRC\", \"k.p12\",\n\t}\n\tfor _, p := range refused {\n\t\tif err := CheckCodePath(12, p); err == nil {\n\t\t\tt.Errorf(\"%q accepted\", p)\n\t\t}\n\t}\n\tallowed := []string{\n\t\t\".env.example\", \"src/env.go\", \"docs/github/x.md\", \"docs/.github/x\",\n\t\t\"internal/redact/rules.go\", \"keys.go\", \"service-account.go\", \"a.txt\", \"dir/.gitignore\", \".gitattributes.md\", \"docs/gitattributes.txt\",\n\t}\n\tfor _, p := range al