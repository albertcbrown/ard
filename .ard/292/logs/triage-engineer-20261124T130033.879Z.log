{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KduAau4zA44vCPzh5UuW81","type":"tool_result","content":"// Package roles holds the starter .ard/ tree that `ard init` (#27) proposes\n// to a target repo. Paths in FS are relative to .ard/ (for example\n// \"config.yaml\" or \"scanners/cve/scan\"). embed.FS reports every file as 0444,\n// so the writer must commit files named in ExecutableNames as 100755.\npackage roles\n\nimport \"embed\"\n\n// FS is the starter .ard/ tree `ard init` proposes: config.yaml plus the role\n// directories (scanners/cve, scanners/lts, scanners/docs, scanners/error-codes, scanners/lint, scanners/missing-tests, scanners/trufflehog, scanners/trufflehog-history, triage/lead, triage/engineer, triage/product-manager, triage/architect, triage/designer, triage/documentation-planner, workers/engineer, reviewers/eng-review, reviewers/license-review, reviewers/product-manager-review and reviewers/security-review); paths are relative to .ard/.\n//\n// scanners/missing-tests is left out until its scan driver exists; re-add it when wiring it in.\n//\n//go:embed config.yaml reviewers scanners/cve scanners/docs scanners/error-codes scanners/lint scanners/lts scanners/missing-tests scanners/trufflehog scanners/trufflehog-history triage workers\nvar FS embed.FS\n\n// ExecutableNames lists base names that must be written 0755.\nvar ExecutableNames = []string{\"scan\"}\nfunc TestFSContents(t *testing.T) {\n\tvar got []string\n\terr := fs.WalkDir(FS, \".\", func(p string, d fs.DirEntry, err error) error {\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif !d.IsDir() {\n\t\t\tgot = append(got, p)\n\t\t}\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsort.Strings(got)\n\twant := []string{\"config.yaml\", \"reviewers/eng-review/prompt.txt\", \"reviewers/license-review/allowlist.txt\", \"reviewers/license-review/prompt.txt\", \"reviewers/product-manager-review/prompt.txt\", \"reviewers/security-review/prompt.txt\", \"scanners/cve/Dockerfile\", \"scanners/cve/merge.jq\", \"scanners/cve/scan\", \"scanners/docs/Dockerfile\", \"scanners/docs/docscan.go\", \"scanners/docs/scan\", \"scanners/error-codes/Dockerfile\", \"scanners/error-codes/errcodes.jq\", \"scanners/error-codes/scan\", \"scanners/lint/Dockerfile\", \"scanners/lint/normalize.jq\", \"scanners/lint/scan\", \"scanners/lts/Dockerfile\", \"scanners/lts/eol.jq\", \"scanners/lts/products.json\", \"scanners/lts/refs.jq\", \"scanners/lts/scan\", \"scanners/missing-tests/Dockerfile\", \"scanners/missing-tests/missingtests.go\", \"scanners/missing-tests/scan\", \"scanners/trufflehog-history/Dockerfile\", \"scanners/trufflehog-history/exclude-paths\", \"scanners/trufflehog-history/findings.jq\", \"scanners/trufflehog-history/history\", \"scanners/trufflehog-history/scan\", \"scanners/trufflehog/Dockerfile\", \"scanners/trufflehog/exclude-paths\", \"scanners/trufflehog/findings.jq\", \"scanners/trufflehog/scan\", \"triage/architect/prompt.txt\", \"triage/designer/prompt.txt\", \"triage/documentation-planner/prompt.txt\", \"triage/engineer/prompt.txt\", \"triage/lead/prompt.txt\", \"triage/product-manager/prompt.txt\", \"workers/engineer/prompt.txt\"}\n\tif strings.Join(got, \",\") != strings.Join(want, \",\") {\n\t\tt.Fatalf(\"embedded files = %v, want %v\", got, want)\n\t}\n\tfor _, p := range got {\n\t\tif strings.HasSuffix(p, \"_test.go\") || strings.Contains(p, \"testdata\") {\n\t\t\tt.Errorf(\"%s must not be embedded: ard init would copy it into target repos\", p)\n\t\t}\n\t}\n}\n\n// embed.FS reports 0444 for everything, so the exec bit must be checked on disk\n// to catch a mode lost in git.\nfunc TestScanIsExecutableOnDisk(t *testing.T) {\n\tfor _, p := range []string{\"scanners/cve/scan\", \"scanners/docs/scan\", \"scanners/error-codes/scan\", \"scanners/lint/scan\", \"scanners/missing-tests/scan\", \"scanners/trufflehog/scan\", \"scanners/trufflehog-history/scan\", \"scanners/lts/scan\"} {\n\t\tfi, err := os.Stat(p)\npackage committer\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/effects\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n)\n\n// InitBranch is the only branch Init commits to.\nconst InitBranch = \"ard-init\"\n\n// InitMessage is the fixed commit message. It has no [skip ci], because CI\n// must run on the PR.\nconst InitMessage = \"ard(init): add starter .ard/ configuration\"\n\n// InitFile is one starter file. Exec commits it as 100755.\ntype InitFile struct {\n\tPath string // canonical repo-relative slash path; see CheckInitPath\n\tData []byte\n\tExec bool\n}\n\nvar initPathRe = regexp.MustCompile(`^\\.ard/(?:config\\.yaml|(?:scanners|triage|workers|reviewers)/([a-z0-9][a-z0-9-]*)/[^/]+(?:/[^/]+)*)$`)\n\n// CheckInitPath reports why p may not be proposed by ard init, or nil. It\n// accepts exactly .ard/config.yaml and files under\n// .ard/{scanners,triage,workers,reviewers}/<role>/, where <role> matches the\n// role-name rule and is not all digits. It applies CheckPath's checks for\n// empty, canonical, backslash, control characters and .git segments. It\n// rejects .ard/<issue#>/ and everything outside .ard/.\nfunc CheckInitPath(p string) error {\n\tif p == \"\" {\n\t\treturn reason(\"empty path\")\n\t}\n\tfor _, r := range p {\n\t\tif r == '\\\\' || r < 0x20 || r == 0x7f {\n\t\t\treturn reason(\"backslash or control character\")\n\t\t}\n\t}\n\tif path.Clean(p) != p {\n\t\treturn reason(\"not canonical\")\n\t}\n\tfor _, seg := range strings.Split(p, \"/\") {\n\t\tif strings.EqualFold(seg, \".git\") {\n\t\t\treturn reason(\"contains .git\")\n\t\t}\n\t}\n\tm := initPathRe.FindStringSubmatch(p)\n\tif m == nil {\n\t\treturn reason(\"not .ard/config.yaml or a file under a role directory\")\n\t}\n\tif m[1] != \"\" && strings.Trim(m[1], \"0123456789\") == \"\" {\n\t\treturn reason(\"numeric role name\")\n\t}\n\treturn nil\n}\n\n// Init proposes the starter tree on InitBranch, cut from the base branch\n// (cfg.Branch, default \"main\"). Each Propose is one attempt: there is no\n// retry loop and no force push. It is a separate lane from the main\n// committer, which still writes only .ard/<issue#>/.\ntype Init struct {\n\tc    *core\n\tbase string\n\twt   string\n}\n\n// NewInit validates cfg and checks the git version the way NewMain does.\n// cfg.Bot is required unless fx.DryRun().\nfunc NewInit(ctx context.Context, cfg Config, fx Effects, g *gitx.Git) (*Init, error) {\n\tc, err := newCore(cfg, fx, g, false)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tmajor, minor, err := c.g.Version(ctx)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif major < 2 || (major == 2 && minor < 32) {\n\t\treturn nil, fmt.Errorf(\"git %d.%d is too old: 2.32 or later is required\", major, minor)\n\t}\n\tbase := cfg.Branch\n\tif base == \"\" {\n\t\tbase = \"main\"\n\t}\n\treturn &Init{c: c, base: base, wt: filepath.Join(cfg.WorkDir, \"committer-init\")}, nil\n}\n\n// Base fetches the base branch into refs/ard/upstream/<base> and returns its\n// SHA. It returns ErrInitExists if InitBranch exists on the remote, and\n// ErrBranchGone (naming the base) if the base branch does not exist.\nfunc (i *Init) Base(ctx context.Context) (string, error) {\n\tcfg := i.c.cfg\n\tspec := \"+refs/heads/\" + i.base + \":\" + upstreamRef(i.base)\n\tif err := i.c.g.FetchRef(ctx, cfg.RepoDir, cfg.RemoteURL, spec, cfg.Token); err != nil {\n\t\tif errors.Is(err, gitx.ErrRefNotFound) {\n\t\t\treturn \"\", fmt.Errorf(\"%w: %s\", ErrBranchGone, i.base)\n\t\t}\n\t\treturn \"\", err\n\t}\n\tspec = \"+refs/heads/\" + InitBranch + \":\" + upstreamRef(InitBranch)\n\tswitch err := i.c.g.FetchRef(ctx, cfg.RepoDir, cfg.RemoteURL, spec, cfg.Token); {\n\tcase err == nil:\n\t\treturn \"\", ErrInitExists\n\tcase !errors.Is(err, gitx.ErrRefNotFound):\n\t\treturn \"\", err\n\t}\n\treturn i.c.g.RevParse(ctx, cfg.RepoDir, upstreamRef(i.base))\n}\n\n// Propose commits files on top of base and pushes HEAD:refs/heads/ard-init as\n// a push whose lease expects the ref to be absent (all-zero SHA), so it\n// creates the branch and never updates an existing one. A non-fast-forward or stale-lease rejection returns\n// ErrInitExists. If every file matches base, it returns Result{NoOp: true}\n// and pushes nothing. The worktree is removed afterwards.\nfunc (i *Init) Propose(ctx context.Context, base string, files []InitFile) (res Result, err error) {\n\tdefer func() {\n\t\tattrs := []any{\"branch\", InitBranch, \"base\", base, \"files\", len(files)}\n\t\tif err != nil {\n\t\t\ti.c.log.WarnContext(ctx, \"committer.init_failed\", append(attrs, \"err\", err.Error())...)\n\t\t\treturn\n\t\t}\n\t\ti.c.log.InfoContext(ctx, \"committer.init\", append(attrs, \"sha\", res.SHA, \"noop\", res.NoOp, \"synthetic\", res.Synthetic)...)\n\t}()\n\tdeclared, wantExec, err := validateInit(files)\n\tif err != nil {\n\t\treturn Result{}, err\n\t}\n\tif err := os.MkdirAll(i.c.cfg.WorkDir, 0o755); err != nil {\n\t\treturn Result{}, fmt.Errorf(\"mkdir workdir: %w\", err)\n\t}\n\tg, repo := i.c.g, i.c.cfg.RepoDir\n\tif err := g.WorktreeRemove(ctx, repo, i.wt); err != nil {\n\t\treturn Result{}, err\n\t}\n\tif err := g.WorktreeAdd(ctx, repo, i.wt, base); err != nil {\n\t\treturn Result{}, err\n\t}\n\tdefer func() {\n\t\tif rerr := g.WorktreeRemove(context.WithoutCancel(ctx), repo, i.wt); rerr != nil {\n\t\t\ti.c.log.WarnContext(ctx, \"committer.init_cleanup_failed\", \"err\", rerr.Error())\n\t\t}\n\t}()\n\n\tvar execPaths []string\n\tfor _, f := range files {\n\t\tif err := checkParents(i.wt, f.Path); err != nil {\n\t\t\treturn Result{}, err\n\t\t}\n\t\tfull := filepath.Join(i.wt, filepath.FromSlash(f.Path))\n\t\tif err := os.MkdirAll(filepath.Dir(full), 0o755); err != nil {\n\t\t\treturn Result{}, fmt.Errorf(\"mkdir for %s: %w\", f.Path, err)\n\t\t}\n\t\tif err := os.WriteFile(full, f.Data, 0o644); err != nil {\n\t\t\treturn Result{}, fmt.Errorf(\"write %s: %w\", f.Path, err)\n\t\t}\n\t\tif f.Exec {\n\t\t\tif err := os.Chmod(full, 0o755); err != nil {\n\t\t\t\treturn Result{}, fmt.Errorf(\"chmod %s: %w\", f.Path, err)\n\t\t\t}\n\t\t\texecPaths = append(execPaths, f.Path)\n\t\t}\n\t}\n\tif err := g.AddForce(ctx, i.wt, declared...); err != nil {\n\t\treturn Result{}, err\n\t}\n\tif len(execPaths) > 0 {\n\t\tif err := g.SetExec(ctx, i.wt, execPaths...); err != nil {\n\t\t\treturn Result{}, err\n\t\t}\n\t}\n\tchanges, err := g.StagedChanges(ctx, i.wt)\n\tif err != nil {\n\t\treturn Result{}, err\n\t}\n\tif err := CheckStaged(declared, changes); err != nil {\n\t\treturn Result{}, err\n\t}\n\tge := &GuardError{}\n\tfor _, c := range changes {\n\t\tif want := modeOf(wantExec[c.Path]); c.NewMode != want {\n\t\t\tge.add(c.Path, fmt.Sprintf(\"staged mode %s, want %s\", c.NewMode, want))\n\t\t}\n\t}\n\tif len(ge.Paths) > 0 {\n\t\treturn Result{}, ge\n\t}\n\tif len(changes) == 0 {\n\t\treturn Result{SHA: base, NoOp: true}, nil\n\t}\n\tcr, err := i.c.fx.Commit(ctx, effects.CommitOp{Dir: i.wt, Message: InitMessage, Author: i.c.author})\n\tif errors.Is(err, effects.ErrNothingToCommit) {\n\t\treturn Result{SHA: base, NoOp: true}, nil\n\t}\n\tif err != nil {\n\t\treturn Result{}, err\n\t}\n\terr = i.c.fx.Push(ctx, effects.PushOp{Dir: i.wt, Remote: i.c.cfg.RemoteURL, Ref: \"HEAD:refs/heads/\" + InitBranch,\n\t\tForceWithLease: strings.Repeat(\"0\", len(base)), Token: i.c.cfg.Token})\n\tswitch {\n\tcase errors.Is(err, effects.ErrNonFastForward), errors.Is(err, effects.ErrStaleLease):\n\t\treturn Result{}, fmt.Errorf(\"%w: %v\", ErrInitExists, err)\n\tcase err != nil:\n\t\treturn Result{}, err\n\t}\n\treturn Result{SHA: cr.SHA, Synthetic: cr.Synthetic, Attempts: 1}, nil\n}\n\nfunc modeOf(exec bool) string {\n\tif exec {\n\t\treturn \"100755\"\n\t}\n\treturn \"100644\"\n}\n\n// validateInit checks the file set and returns its sorted paths and the\n// expected exec bit of each.\nfunc validateInit(files []InitFile) (declared []string, wantExec map[string]bool, err error) {\n\tswitch {\n\tcase len(files) == 0:\n\t\treturn nil, nil, fmt.Errorf(\"%w: no files\", ErrInvalid)\n\tcase len(files) > MaxFiles:\n\t\treturn nil, nil, fmt.Errorf(\"%w: %d files, max %d\", ErrInvalid, len(files), MaxFiles)\n\t}\n\tge := &GuardError{}\n\twantExec = make(map[string]bool, len(files))\n\tfor _, f := range files {\n\t\tif perr := CheckInitPath(f.Path); perr != nil {\n\t\t\tge.add(f.Path, perr.Error())\n\t\t\tcontinue\n\t\t}\n\t\tif _, dup := wantExec[f.Path]; dup {\n\t\t\treturn nil, nil, fmt.Errorf(\"%w: duplicate path %q\", ErrInvalid, f.Path)\n\t\t}\n\t\tif len(f.Data) > MaxFileBytes {\n\t\t\tge.add(f.Path, \"larger than 1 MiB\")\n\t\t\tcontinue\n\t\t}\n\t\twantExec[f.Path] = f.Exec\n\t\tdeclared = append(declared, f.Path)\n\t}\n\tif len(ge.Paths) > 0 {\n\t\treturn nil, nil, ge\n\t}\n\tsort.Strings(declared)\n\treturn declared, wantExec, nil\n}\npackage config\n\nimport (\n\t\"errors\"\n\t\"io/fs\"\n\n\t\"gopkg.in/yaml.v3\"\n)\n\n// SourcePaths lists the repo-relative paths a config load reads: the config\n// file and the four role-directory trees. It is what a snapshot of a commit\n// must contain. The .ard/<issue#>/ directories, with their logs, are not in\n// it. The list is built from kindDir and kindOrder so it cannot drift from\n// discover.\nfunc SourcePaths() []string {\n\tpaths := []string{\".ard/config.yaml\"}\n\tfor _, k := range kindOrder {\n\t\tpaths = append(paths, \".ard/\"+kindDir[k])\n\t}\n\treturn paths\n}\n\n// SharedSourcePaths lists the role-directory trees a shared roles repo\n// contributes: SourcePaths without the config file.\nfunc SharedSourcePaths() []string { return SourcePaths()[1:] }\n\n// SharedRoles reads only the roles_repo key of the config file in fsys. A\n// missing file or an unset key returns nil, nil. The repo and ref are not\n// validated here; config.Load does that.\nfunc SharedRoles(fsys fs.FS) (*Sidecar, error) {\n\tdata, err := fs.ReadFile(fsys, \".ard/config.yaml\")\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn nil, nil\n\t\t}\n\t\treturn nil, err\n\t}\n\tvar v struct {\n\t\tRolesRepo *struct {\n\t\t\tRepo string `yaml:\"repo\"`\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: identify github user: %w\", err)\n\t}\n\n\ttmp, err := os.MkdirTemp(\"\", \"ard-init-\")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tdefer os.RemoveAll(tmp)\n\n\t// 5. Fetch main; refuse while ard-init exists.\n\tin, err := committer.NewInit(ctx, committer.Config{\n\t\tRepoDir: root, WorkDir: filepath.Join(tmp, \"work\"), RemoteURL: d.RemoteURL,\n\t\tBot: id, Token: d.Token, Log: e.Log,\n\t}, d.Effects, nil)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tbase, err := in.Base(ctx)\n\tswitch {\n\tcase errors.Is(err, committer.ErrInitExists):\n\t\treturn initExistsErr(ctx, d)\n\tcase errors.Is(err, committer.ErrBranchGone):\n\t\treturn fmt.Errorf(\"ard init: %s has no main branch; push an initial commit first\", d.Repo)\n\tcase err != nil:\n\t\treturn fmt.Errorf(\"ard init: fetch main: %w\", err)\n\t}\n\n\t// 6. Plan against main, then validate the result.\n\tfiles, err := starter()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tsnap := filepath.Join(tmp, \"main\")\n\tif err := gitx.New(\"\").ExportPaths(ctx, root, base, snap, config.SourcePaths()...); err != nil {\n\t\treturn fmt.Errorf(\"ard init: read main's .ard/: %w\", err)\n\t}\n\texisting := os.DirFS(snap)\n\tops, err := plan(existing, files, o.Force)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tmerged, err := overlay(existing, files)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tres, err := config.LoadFS(merged, root)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: the resulting configuration is invalid, nothing was written:\\n%w\", err)\n\t}\n\twant, err := labels.Desired(labels.SpecFrom(res))\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\n\t// 7. Labels first: a failure leaves nothing pushed, so a rerun is clean.\n\trep, err := labelsync.Sync(ctx, d.Reader, d.Effects, want, e.Log)\n\tif err != nil && rep.Failed == nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tlabelsync.Print(e.Stdout, rep, e.DryRun)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\n\t// 8. Propose.\n\ttoWrite := changed(ops)\n\tvar pr github.PullRequest\n\tif len(toWrite) > 0 {\n\t\tpres, err := in.Propose(ctx, base, toWrite)\n\t\tswitch {\n\t\tcase errors.Is(err, committer.ErrInitExists):\n\t\t\treturn initExistsErr(ctx, d)\n\t\tcase err != nil:\n\t\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t\tcase pres.NoOp:\n\t\t\ttoWrite = nil\n\t\t}\n\t}\n\tif len(toWrite) == 0 {\n\t\tfmt.Fprintln(e.Stdout, \"nothing to propose: main already has the starter files\")\n\t\te.Log.InfoContext(ctx, \"init.done\", \"repo\", d.Repo.String(), \"base\", base, \"files\", 0, \"pr\", 0, \"dry_run\", e.DryRun)\n\t\treturn nil\n\t}\n\tprintOps(e, ops)\n\n\t// 9. Open the PR.\n\tpr, err = d.Effects.CreatePR(ctx, github.NewPR{\n\t\tTitle: prTitle, Body: initBody(ops, res), Head: committer.InitBranch, Base: \"main\",\n\t})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: branch %s pushed but opening the PR failed: %w; open it by hand, or delete the branch and rerun\", committer.InitBranch, err)\n\t}\n\n\t// 10. Report.\n\tif e.DryRun {\n\t\tfmt.Fprintf(e.Stdout, \"dry-run: would open a PR from %s\\n\", committer.InitBranch)\n\t} else {\n\t\tfmt.Fprintf(e.Stdout, \"opened PR #%d: %s\\n\", pr.Number, pr.URL)\n\t}\n\te.Log.InfoContext(ctx, \"init.done\", \"repo\", d.Repo.String(), \"base\", base, \"files\", len(toWrite), \"pr\", pr.Number, \"dry_run\", e.DryRun)\n\treturn nil\n}\n\n// printOps writes one line per file the PR adds or overwrites.\nfunc printOps(e *cli.Env, ops []op) {\n\tfor _, o := range ops {\n\t\tif o.Act == actUnchanged {\n\t\t\tcontinue\n\t\t}\n\t\tverb := string(o.Act)\n\t\tif e.DryRun {\n\t\t\tverb = \"would \" + verb\n\t\t} else {\n\t\t\tverb += \" \"\n\t\t}\n\t\tmode := \"\"\n\t\tif o.File.Exec {\n\t\t\tmode = \" (0755)\"\n\t\t}\n\t\tfmt.Fprintf(e.Stdout, \"%s %s%s\\n\", verb, o.File.Path, mode)\n\t}\n}\n\n// initExistsErr is the refusal when ard-init is already on the remote. It\n// names the open PR when there is one.\nfunc initExistsErr(ctx context.Context, d deps) error {\n\tmsg := \"ard init: branch ard-init already exists on the remote\"\n\tif prs, err := d.Reader.ListPRs(ctx, github.ListPRsOpts{Head: committer.InitBranch, State: github.StateOpen}); err == nil && len(prs) > 0 {\n\t\tmsg += fmt.Sprintf(\" (open PR #%d)\", prs[0].Number)\n\t}\n\treturn errors.New(strings.TrimSpace(msg) + \"; merge or close it and delete the branch, then rerun\")\n}\n\t\t\tm[rel+\"/\"] = \"\"\n\t\t\treturn nil\n\t\t}\n\t\tb, err := os.ReadFile(p)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tm[rel] = string(b)\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn m\n}\n\nvar starterTree = []string{\".ard/config.yaml\", \".ard/reviewers/eng-review/prompt.txt\", \".ard/reviewers/license-review/allowlist.txt\", \".ard/reviewers/license-review/prompt.txt\", \".ard/reviewers/product-manager-review/prompt.txt\", \".ard/reviewers/security-review/prompt.txt\", \".ard/scanners/cve/Dockerfile\", \".ard/scanners/cve/merge.jq\", \".ard/scanners/cve/scan\", \".ard/scanners/docs/Dockerfile\", \".ard/scanners/docs/docscan.go\", \".ard/scanners/docs/scan\", \".ard/scanners/error-codes/Dockerfile\", \".ard/scanners/error-codes/errcodes.jq\", \".ard/scanners/error-codes/scan\", \".ard/scanners/lint/Dockerfile\", \".ard/scanners/lint/normalize.jq\", \".ard/scanners/lint/scan\", \".ard/scanners/lts/Dockerfile\", \".ard/scanners/lts/eol.jq\", \".ard/scanners/lts/products.json\", \".ard/scanners/lts/refs.jq\", \".ard/scanners/lts/scan\", \".ard/scanners/missing-tests/Dockerfile\", \".ard/scanners/missing-tests/missingtests.go\", \".ard/scanners/missing-tests/scan\", \".ard/scanners/trufflehog-history/Dockerfile\", \".ard/scanners/trufflehog-history/exclude-paths\", \".ard/scanners/trufflehog-history/findings.jq\", \".ard/scanners/trufflehog-history/history\", \".ard/scanners/trufflehog-history/scan\", \".ard/scanners/trufflehog/Dockerfile\", \".ard/scanners/trufflehog/exclude-paths\", \".ard/scanners/trufflehog/findings.jq\", \".ard/scanners/trufflehog/scan\", \".ard/triage/architect/prompt.txt\", \".ard/triage/designer/prompt.txt\", \".ard/triage/documentation-planner/prompt.txt\", \".ard/triage/engineer/prompt.txt\", \".ard/triage/lead/prompt.txt\", \".ard/triage/product-manager/prompt.txt\", \".ard/workers/engineer/prompt.txt\"}\n\nfunc TestInitOpensPR(t *testing.T) {\n\th := newHarness(t)\n\tbefore := snapshot(t, h.clone)\n\tout, err := h.run(t, false, false)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif got := h.tree(t, \"ard-init\"); !reflect.DeepEqual(got, starterTree) {\n\t\tt.Errorf(\"ard-init tree = %v, want %v\", got, starterTree)\n\t}\n\tif got := strings.TrimSpace(gittest.Run(t, h.bare, \"ls-tree\", \"-r\", \"ard-init\", \"--\", \".ard/scanners/cve/scan\")); !strings.HasPrefix(got, \"100755 \") {\n\t\tt.Errorf(\"scan = %q, want mode 100755\", got)\n\t}\n\tif got := strings.TrimSpace(gittest.Run(t, h.bare, \"ls-tree\", \"-r\", \"ard-init\", \"--\", \".ard/scanners/docs/scan\")); !strings.HasPrefix(got, \"100755 \") {\n\t\tt.Errorf(\"docs scan = %q, want mode 100755\", got)\n\t}\n\tif got := strings.TrimSpace(gittest.Run(t, h.bare, \"ls-tree\", \"-r\", \"ard-init\", \"--\", \".ard/scanners/lint/scan\")); !strings.HasPrefix(got, \"100755 \") {\n\t\tt.Errorf(\"lint scan = %q, want mode 100755\", got)\n\t}\n\tif !reflect.DeepEqual(snapshot(t, h.clone), before) {\n\t\tt.Error(\"the working tree changed\")\n\t}\n\tif n := strings.TrimSpace(gittest.Run(t, h.bare, \"rev-list\", \"--count\", \"main\")); n != \"1\" {\n\t\tt.Errorf(\"main has %s commits, want 1\", n)\n\t}\n\n\t// Done when: ard config check passes on the proposed branch.\n\tgittest.Run(t, h.clone, \"fetch\", \"-q\", \"origin\", \"+refs/heads/ard-init:refs/ard/upstream/ard-init\")\n\tce := &cli.Env{Globals: cli.Globals{ConfigPath: filepath.Join(h.clone, \".ard\", \"config.yaml\")}, Log: quiet, Stdout: io.Discard, Stderr: &bytes.Buffer{}}\n\tif err := configcmd.Check(context.Background(), ce, cli.ConfigCheckOpts{Ref: \"refs/ard/upstream/ard-init\"}); err != nil {\n\t\tt.Fatalf(\"config check on ard-init: %v\", err)\n\t}\n\tcres, err := loadStarter(t, nil)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif cres.Intake != (config.Intake{Mode: config.IntakeLabel}) {\n\t\tt.Errorf(\"intake = %+v\", cres.Intake)\n\t}\n\tcve, _ := cres.Role(config.KindScanner, \"cve\")\n\tif cve.Every != 6*time.Hour || cve.MaxOpen != 10 || cve.GroupSize != 1 || !cve.Autoclose {\n\t\tt.Errorf(\"cve = %+v\", cve)\n\t}\n\tdocs, _ := cres.Role(config.KindScanner, \"docs\")\n\tif docs.Every != 72*time.Hour || docs.MaxOpen != 3 || docs.GroupSize != 10 || !docs.Autoclose {\n\t\tt.Errorf(\"docs = %+v\", docs)\n\t}\n\tlint, ok := cres.Role(config.KindScanner, \"lint\")\n\tif !ok || lint.Every != 24*time.Hour || lint.MaxOpen != 3 || lint.GroupSize != 20 || !lint.Autoclose {\n\t\tt.Errorf(\"lint = %+v\", lint)\n\t}\n\n\tprs, err := h.fake.ListPRs(context.Background(), github.ListPRsOpts{})\n# ard configuration, proposed by `ard init`. Edit freely; this file is yours.\n# Anything unset takes its built-in default (docs/proposal.md, Configuration).\n# Validate with `ard config check`. ard serve reads this file from origin/main.\n\n# label: only issues a maintainer labels for triage enter the pipeline.\n# all: every human-filed issue enters.\nintake: { mode: label }\n\nmerge:\n  # A PR touching any of these waits for a human approval. There is no\n  # built-in list: removing an entry removes its gate. An entry ending in /\n  # is a directory prefix; anything else is a glob (quote globs starting with *).\n  protected_paths:\n    - .github/\n    - .ard/config.yaml\n    - .ard/scanners/\n    - .ard/triage/\n    - .ard/workers/\n    - .ard/reviewers/\n    - \"**/CODEOWNERS\"\n    # Agent instructions a PR could plant to steer later agents.\n    - CLAUDE.md\n    - \"**/CLAUDE.md\"\n    - AGENTS.md\n    - \"**/AGENTS.md\"\n    - .claude/\n    - .mcp.json\n    # Linter config a PR could weaken: disabling a linter silently autocloses its issues.\n    - \"**/.golangci.yml\"\n    - \"**/.golangci.yaml\"\n    - \"**/.golangci.toml\"\n    - \"**/.golangci.json\"\n\noverrides:\n  scanners/cve: { every: 6h, max_open: 10, group_size: 1, autoclose: true }\n  scanners/lts: { every: 7d, max_open: 5, group_size: 1, autoclose: true }\n  scanners/docs: { every: 3d, max_open: 3, group_size: 10, autoclose: true }\n  scanners/error-codes: { every: 24h, group_size: 20, autoclose: true }\n  scanners/missing-tests: { every: 24h, max_open: 5, group_size: 10, autoclose: true }\n  # needs a human-made `baseline` next to `scan`; see its Dockerfile\nconfig.yaml\ncve_docker_integration_test.go\ncve_integration_test.go\ncve_test.go\ndocs_docker_integration_test.go\ndocs_test.go\neng_review_test.go\nengineer_test.go\nerrcodes_integration_test.go\nerrcodes_test.go\nlead_test.go\nlicense_review_integration_test.go\nlicense_review_test.go\nlint_docker_integration_test.go\nlint_integration_test.go\nlint_scan_test.go\nlint_test.go\nlts_integration_test.go\nlts_test.go\nmissing_tests_integration_test.go\nmissing_tests_test.go\npm_review_test.go\nreviewers\nroles.go\nroles_test.go\nscanner_guard_test.go\nscanners\nsecurity_review_test.go\ntestdata\ntriage\ntriage_roles_test.go\ntrufflehog_docker_integration_test.go\ntrufflehog_history_test.go\ntrufflehog_integration_test.go\ntrufflehog_test.go\nworker_engineer_test.go\nworkers\n14:  protected_paths:\n15-    - .github/\n16-    - .ard/config.yaml\n17-    - .ard/scanners/\n18-    - .ard/triage/\n19-    - .ard/workers/\n20-    - .ard/reviewers/\n21-    - \"**/CODEOWNERS\"\n22-    # Agent instructions a PR could plant to steer later agents.","is_error":false}]},"parent_tool_use_id":null,"session_id":"32577055-79a4-404e-b110-45dd1c721f9c","uuid":"2d2ea843-0111-484d-8df0-c8df9aef8fd3","timestamp":"2026-11-24T13:00:39.443Z","tool_use_result":{"stdout":"// Package roles holds the starter .ard/ tree that `ard init` (#27) proposes\n// to a target repo. Paths in FS are relative to .ard/ (for example\n// \"config.yaml\" or \"scanners/cve/scan\"). embed.FS reports every file as 0444,\n// so the writer must commit files named in ExecutableNames as 100755.\npackage roles\n\nimport \"embed\"\n\n// FS is the starter .ard/ tree `ard init` proposes: config.yaml plus the role\n// directories (scanners/cve, scanners/lts, scanners/docs, scanners/error-codes, scanners/lint, scanners/missing-tests, scanners/trufflehog, scanners/trufflehog-history, triage/lead, triage/engineer, triage/product-manager, triage/architect, triage/designer, triage/documentation-planner, workers/engineer, reviewers/eng-review, reviewers/license-review, reviewers/product-manager-review and reviewers/security-review); paths are relative to .ard/.\n//\n// scanners/missing-tests is left out until its scan driver exists; re-add it when wiring it in.\n//\n//go:embed config.yaml reviewers scanners/cve scanners/docs scanners/error-codes scanners/lint scanners/lts scanners/missing-tests scanners/trufflehog scanners/trufflehog-history triage workers\nvar FS embed.FS\n\n// ExecutableNames lists base names that must be written 0755.\nvar ExecutableNames = []string{\"scan\"}\nfunc TestFSContents(t *testing.T) {\n\tvar got []string\n\terr := fs.WalkDir(FS, \".\", func(p string, d fs.DirEntry, err error) error {\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif !d.IsDir() {\n\t\t\tgot = append(got, p)\n\t\t}\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsort.Strings(got)\n\twant := []string{\"config.yaml\", \"reviewers/eng-review/prompt.txt\", \"reviewers/license-review/allowlist.txt\", \"reviewers/license-review/prompt.txt\", \"reviewers/product-manager-review/prompt.txt\", \"reviewers/security-review/prompt.txt\", \"scanners/cve/Dockerfile\", \"scanners/cve/merge.jq\", \"scanners/cve/scan\", \"scanners/docs/Dockerfile\", \"scanners/docs/docscan.go\", \"scanners/docs/scan\", \"scanners/error-codes/Dockerfile\", \"scanners/error-codes/errcodes.jq\", \"scanners/error-codes/scan\", \"scanners/lint/Dockerfile\", \"scanners/lint/normalize.jq\", \"scanners/lint/scan\", \"scanners/lts/Dockerfile\", \"scanners/lts/eol.jq\", \"scanners/lts/products.json\", \"scanners/lts/refs.jq\", \"scanners/lts/scan\", \"scanners/missing-tests/Dockerfile\", \"scanners/missing-tests/missingtests.go\", \"scanners/missing-tests/scan\", \"scanners/trufflehog-history/Dockerfile\", \"scanners/trufflehog-history/exclude-paths\", \"scanners/trufflehog-history/findings.jq\", \"scanners/trufflehog-history/history\", \"scanners/trufflehog-history/scan\", \"scanners/trufflehog/Dockerfile\", \"scanners/trufflehog/exclude-paths\", \"scanners/trufflehog/findings.jq\", \"scanners/trufflehog/scan\", \"triage/architect/prompt.txt\", \"triage/designer/prompt.txt\", \"triage/documentation-planner/prompt.txt\", \"triage/engineer/prompt.txt\", \"triage/lead/prompt.txt\", \"triage/product-manager/prompt.txt\", \"workers/engineer/prompt.txt\"}\n\tif strings.Join(got, \",\") != strings.Join(want, \",\") {\n\t\tt.Fatalf(\"embedded files = %v, want %v\", got, want)\n\t}\n\tfor _, p := range got {\n\t\tif strings.HasSuffix(p, \"_test.go\") || strings.Contains(p, \"testdata\") {\n\t\t\tt.Errorf(\"%s must not be embedded: ard init would copy it into target repos\", p)\n\t\t}\n\t}\n}\n\n// embed.FS reports 0444 for everything, so the exec bit must be checked on disk\n// to catch a mode lost in git.\nfunc TestScanIsExecutableOnDisk(t *testing.T) {\n\tfor _, p := range []string{\"scanners/cve/scan\", \"scanners/docs/scan\", \"scanners/error-codes/scan\", \"scanners/lint/scan\", \"scanners/missing-tests/scan\", \"scanners/trufflehog/scan\", \"scanners/trufflehog-history/scan\", \"scanners/lts/scan\"} {\n\t\tfi, err := os.Stat(p)\npackage committer\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/effects\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n)\n\n// InitBranch is the only branch Init commits to.\nconst InitBranch = \"ard-init\"\n\n// InitMessage is the fixed commit message. It has no [skip ci], because CI\n// must run on the PR.\nconst InitMessage = \"ard(init): add starter .ard/ configuration\"\n\n// InitFile is one starter file. Exec commits it as 100755.\ntype InitFile struct {\n\tPath string // canonical repo-relative slash path; see CheckInitPath\n\tData []byte\n\tExec bool\n}\n\nvar initPathRe = regexp.MustCompile(`^\\.ard/(?:config\\.yaml|(?:scanners|triage|workers|reviewers)/([a-z0-9][a-z0-9-]*)/[^/]+(?:/[^/]+)*)$`)\n\n// CheckInitPath reports why p may not be proposed by ard init, or nil. It\n// accepts exactly .ard/config.yaml and files under\n// .ard/{scanners,triage,workers,reviewers}/<role>/, where <role> matches the\n// role-name rule and is not all digits. It applies CheckPath's checks for\n// empty, canonical, backslash, control characters and .git segments. It\n// rejects .ard/<issue#>/ and everything outside .ard/.\nfunc CheckInitPath(p string) error {\n\tif p == \"\" {\n\t\treturn reason(\"empty path\")\n\t}\n\tfor _, r := range p {\n\t\tif r == '\\\\' || r < 0x20 || r == 0x7f {\n\t\t\treturn reason(\"backslash or control character\")\n\t\t}\n\t}\n\tif path.Clean(p) != p {\n\t\treturn reason(\"not canonical\")\n\t}\n\tfor _, seg := range strings.Split(p, \"/\") {\n\t\tif strings.EqualFold(seg, \".git\") {\n\t\t\treturn reason(\"contains .git\")\n\t\t}\n\t}\n\tm := initPathRe.FindStringSubmatch(p)\n\tif m == nil {\n\t\treturn reason(\"not .ard/config.yaml or a file under a role directory\")\n\t}\n\tif m[1] != \"\" && strings.Trim(m[1], \"0123456789\") == \"\" {\n\t\treturn reason(\"numeric role name\")\n\t}\n\treturn nil\n}\n\n// Init proposes the starter tree on InitBranch, cut from the base branch\n// (cfg.Branch, default \"main\"). Each Propose is one attempt: there is no\n// retry loop and no force push. It is a separate lane from the main\n// committer, which still writes only .ard/<issue#>/.\ntype Init struct {\n\tc    *core\n\tbase string\n\twt   string\n}\n\n// NewInit validates cfg and checks the git version the way NewMain does.\n// cfg.Bot is required unless fx.DryRun().\nfunc NewInit(ctx context.Context, cfg Config, fx Effects, g *gitx.Git) (*Init, error) {\n\tc, err := newCore(cfg, fx, g, false)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tmajor, minor, err := c.g.Version(ctx)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif major < 2 || (major == 2 && minor < 32) {\n\t\treturn nil, fmt.Errorf(\"git %d.%d is too old: 2.32 or later is required\", major, minor)\n\t}\n\tbase := cfg.Branch\n\tif base == \"\" {\n\t\tbase = \"main\"\n\t}\n\treturn &Init{c: c, base: base, wt: filepath.Join(cfg.WorkDir, \"committer-init\")}, nil\n}\n\n// Base fetches the base branch into refs/ard/upstream/<base> and returns its\n// SHA. It returns ErrInitExists if InitBranch exists on the remote, and\n// ErrBranchGone (naming the base) if the base branch does not exist.\nfunc (i *Init) Base(ctx context.Context) (string, error) {\n\tcfg := i.c.cfg\n\tspec := \"+refs/heads/\" + i.base + \":\" + upstreamRef(i.base)\n\tif err := i.c.g.FetchRef(ctx, cfg.RepoDir, cfg.RemoteURL, spec, cfg.Token); err != nil {\n\t\tif errors.Is(err, gitx.ErrRefNotFound) {\n\t\t\treturn \"\", fmt.Errorf(\"%w: %s\", ErrBranchGone, i.base)\n\t\t}\n\t\treturn \"\", err\n\t}\n\tspec = \"+refs/heads/\" + InitBranch + \":\" + upstreamRef(InitBranch)\n\tswitch err := i.c.g.FetchRef(ctx, cfg.RepoDir, cfg.RemoteURL, spec, cfg.Token); {\n\tcase err == nil:\n\t\treturn \"\", ErrInitExists\n\tcase !errors.Is(err, gitx.ErrRefNotFound):\n\t\treturn \"\", err\n\t}\n\treturn i.c.g.RevParse(ctx, cfg.RepoDir, upstreamRef(i.base))\n}\n\n// Propose commits files on top of base and pushes HEAD:refs/heads/ard-init as\n// a push whose lease expects the ref to be absent (all-zero SHA), so it\n// creates the branch and never updates an existing one. A non-fast-forward or stale-lease rejection returns\n// ErrInitExists. If every file matches base, it returns Result{NoOp: true}\n// and pushes nothing. The worktree is removed afterwards.\nfunc (i *Init) Propose(ctx context.Context, base string, files []InitFile) (res Result, err error) {\n\tdefer func() {\n\t\tattrs := []any{\"branch\", InitBranch, \"base\", base, \"files\", len(files)}\n\t\tif err != nil {\n\t\t\ti.c.log.WarnContext(ctx, \"committer.init_failed\", append(attrs, \"err\", err.Error())...)\n\t\t\treturn\n\t\t}\n\t\ti.c.log.InfoContext(ctx, \"committer.init\", append(attrs, \"sha\", res.SHA, \"noop\", res.NoOp, \"synthetic\", res.Synthetic)...)\n\t}()\n\tdeclared, wantExec, err := validateInit(files)\n\tif err != nil {\n\t\treturn Result{}, err\n\t}\n\tif err := os.MkdirAll(i.c.cfg.WorkDir, 0o755); err != nil {\n\t\treturn Result{}, fmt.Errorf(\"mkdir workdir: %w\", err)\n\t}\n\tg, repo := i.c.g, i.c.cfg.RepoDir\n\tif err := g.WorktreeRemove(ctx, repo, i.wt); err != nil {\n\t\treturn Result{}, err\n\t}\n\tif err := g.WorktreeAdd(ctx, repo, i.wt, base); err != nil {\n\t\treturn Result{}, err\n\t}\n\tdefer func() {\n\t\tif rerr := g.WorktreeRemove(context.WithoutCancel(ctx), repo, i.wt); rerr != nil {\n\t\t\ti.c.log.WarnContext(ctx, \"committer.init_cleanup_failed\", \"err\", rerr.Error())\n\t\t}\n\t}()\n\n\tvar execPaths []string\n\tfor _, f := range files {\n\t\tif err := checkParents(i.wt, f.Path); err != nil {\n\t\t\treturn Result{}, err\n\t\t}\n\t\tfull := filepath.Join(i.wt, filepath.FromSlash(f.Path))\n\t\tif err := os.MkdirAll(filepath.Dir(full), 0o755); err != nil {\n\t\t\treturn Result{}, fmt.Errorf(\"mkdir for %s: %w\", f.Path, err)\n\t\t}\n\t\tif err := os.WriteFile(full, f.Data, 0o644); err != nil {\n\t\t\treturn Result{}, fmt.Errorf(\"write %s: %w\", f.Path, err)\n\t\t}\n\t\tif f.Exec {\n\t\t\tif err := os.Chmod(full, 0o755); err != nil {\n\t\t\t\treturn Result{}, fmt.Errorf(\"chmod %s: %w\", f.Path, err)\n\t\t\t}\n\t\t\texecPaths = append(execPaths, f.Path)\n\t\t}\n\t}\n\tif err := g.AddForce(ctx, i.wt, declared...); err != nil {\n\t\treturn Result{}, err\n\t}\n\tif len(execPaths) > 0 {\n\t\tif err := g.SetExec(ctx, i.wt, execPaths...); err != nil {\n\t\t\treturn Result{}, err\n\t\t}\n\t}\n\tchanges, err := g.StagedChanges(ctx, i.wt)\n\tif err != nil {\n\t\treturn Result{}, err\n\t}\n\tif err := CheckStaged(declared, changes); err != nil {\n\t\treturn Result{}, err\n\t}\n\tge := &GuardError{}\n\tfor _, c := range changes {\n\t\tif want := modeOf(wantExec[c.Path]); c.NewMode != want {\n\t\t\tge.add(c.Path, fmt.Sprintf(\"staged mode %s, want %s\", c.NewMode, want))\n\t\t}\n\t}\n\tif len(ge.Paths) > 0 {\n\t\treturn Result{}, ge\n\t}\n\tif len(changes) == 0 {\n\t\treturn Result{SHA: base, NoOp: true}, nil\n\t}\n\tcr, err := i.c.fx.Commit(ctx, effects.CommitOp{Dir: i.wt, Message: InitMessage, Author: i.c.author})\n\tif errors.Is(err, effects.ErrNothingToCommit) {\n\t\treturn Result{SHA: base, NoOp: true}, nil\n\t}\n\tif err != nil {\n\t\treturn Result{}, err\n\t}\n\terr = i.c.fx.Push(ctx, effects.PushOp{Dir: i.wt, Remote: i.c.cfg.RemoteURL, Ref: \"HEAD:refs/heads/\" + InitBranch,\n\t\tForceWithLease: strings.Repeat(\"0\", len(base)), Token: i.c.cfg.Token})\n\tswitch {\n\tcase errors.Is(err, effects.ErrNonFastForward), errors.Is(err, effects.ErrStaleLease):\n\t\treturn Result{}, fmt.Errorf(\"%w: %v\", ErrInitExists, err)\n\tcase err != nil:\n\t\treturn Result{}, err\n\t}\n\treturn Result{SHA: cr.SHA, Synthetic: cr.Synthetic, Attempts: 1}, nil\n}\n\nfunc modeOf(exec bool) string {\n\tif exec {\n\t\treturn \"100755\"\n\t}\n\treturn \"100644\"\n}\n\n// validateInit checks the file set and returns its sorted paths and the\n// expected exec bit of each.\nfunc validateInit(files []InitFile) (declared []string, wantExec map[string]bool, err error) {\n\tswitch {\n\tcase len(files) == 0:\n\t\treturn nil, nil, fmt.Errorf(\"%w: no files\", ErrInvalid)\n\tcase len(files) > MaxFiles:\n\t\treturn nil, nil, fmt.Errorf(\"%w: %d files, max %d\", ErrInvalid, len(files), MaxFiles)\n\t}\n\tge := &GuardError{}\n\twantExec = make(map[string]bool, len(files))\n\tfor _, f := range files {\n\t\tif perr := CheckInitPath(f.Path); perr != nil {\n\t\t\tge.add(f.Path, perr.Error())\n\t\t\tcontinue\n\t\t}\n\t\tif _, dup := wantExec[f.Path]; dup {\n\t\t\treturn nil, nil, fmt.Errorf(\"%w: duplicate path %q\", ErrInvalid, f.Path)\n\t\t}\n\t\tif len(f.Data) > MaxFileBytes {\n\t\t\tge.add(f.Path, \"larger than 1 MiB\")\n\t\t\tcontinue\n\t\t}\n\t\twantExec[f.Path] = f.Exec\n\t\tdeclared = append(declared, f.Path)\n\t}\n\tif len(ge.Paths) > 0 {\n\t\treturn nil, nil, ge\n\t}\n\tsort.Strings(declared)\n\treturn declared, wantExec, nil\n}\npackage config\n\nimport (\n\t\"errors\"\n\t\"io/fs\"\n\n\t\"gopkg.in/yaml.v3\"\n)\n\n// SourcePaths lists the repo-relative paths a config load reads: the config\n// file and the four role-directory trees. It is what a snapshot of a commit\n// must contain. The .ard/<issue#>/ directories, with their logs, are not in\n// it. The list is built from kindDir and kindOrder so it cannot drift from\n// discover.\nfunc SourcePaths() []string {\n\tpaths := []string{\".ard/config.yaml\"}\n\tfor _, k := range kindOrder {\n\t\tpaths = append(paths, \".ard/\"+kindDir[k])\n\t}\n\treturn paths\n}\n\n// SharedSourcePaths lists the role-directory trees a shared roles repo\n// contributes: SourcePaths without the config file.\nfunc SharedSourcePaths() []string { return SourcePaths()[1:] }\n\n// SharedRoles reads only the roles_repo key of the config file in fsys. A\n// missing file or an unset key returns nil, nil. The repo and ref are not\n// validated here; config.Load does that.\nfunc SharedRoles(fsys fs.FS) (*Sidecar, error) {\n\tdata, err := fs.ReadFile(fsys, \".ard/config.yaml\")\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn nil, nil\n\t\t}\n\t\treturn nil, err\n\t}\n\tvar v struct {\n\t\tRolesRepo *struct {\n\t\t\tRepo string `yaml:\"repo\"`\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: identify github user: %w\", err)\n\t}\n\n\ttmp, err := os.MkdirTemp(\"\", \"ard-init-\")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tdefer os.RemoveAll(tmp)\n\n\t// 5. Fetch main; refuse while ard-init exists.\n\tin, err := committer.NewInit(ctx, committer.Config{\n\t\tRepoDir: root, WorkDir: filepath.Join(tmp, \"work\"), RemoteURL: d.RemoteURL,\n\t\tBot: id, Token: d.Token, Log: e.Log,\n\t}, d.Effects, nil)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tbase, err := in.Base(ctx)\n\tswitch {\n\tcase errors.Is(err, committer.ErrInitExists):\n\t\treturn initExistsErr(ctx, d)\n\tcase errors.Is(err, committer.ErrBranchGone):\n\t\treturn fmt.Errorf(\"ard init: %s has no main branch; push an initial commit first\", d.Repo)\n\tcase err != nil:\n\t\treturn fmt.Errorf(\"ard init: fetch main: %w\", err)\n\t}\n\n\t// 6. Plan against main, then validate the result.\n\tfiles, err := starter()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tsnap := filepath.Join(tmp, \"main\")\n\tif err := gitx.New(\"\").ExportPaths(ctx, root, base, snap, config.SourcePaths()...); err != nil {\n\t\treturn fmt.Errorf(\"ard init: read main's .ard/: %w\", err)\n\t}\n\texisting := os.DirFS(snap)\n\tops, err := plan(existing, files, o.Force)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tmerged, err := overlay(existing, files)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tres, err := config.LoadFS(merged, root)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: the resulting configuration is invalid, nothing was written:\\n%w\", err)\n\t}\n\twant, err := labels.Desired(labels.SpecFrom(res))\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\n\t// 7. Labels first: a failure leaves nothing pushed, so a rerun is clean.\n\trep, err := labelsync.Sync(ctx, d.Reader, d.Effects, want, e.Log)\n\tif err != nil && rep.Failed == nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\tlabelsync.Print(e.Stdout, rep, e.DryRun)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t}\n\n\t// 8. Propose.\n\ttoWrite := changed(ops)\n\tvar pr github.PullRequest\n\tif len(toWrite) > 0 {\n\t\tpres, err := in.Propose(ctx, base, toWrite)\n\t\tswitch {\n\t\tcase errors.Is(err, committer.ErrInitExists):\n\t\t\treturn initExistsErr(ctx, d)\n\t\tcase err != nil:\n\t\t\treturn fmt.Errorf(\"ard init: %w\", err)\n\t\tcase pres.NoOp:\n\t\t\ttoWrite = nil\n\t\t}\n\t}\n\tif len(toWrite) == 0 {\n\t\tfmt.Fprintln(e.Stdout, \"nothing to propose: main already has the starter files\")\n\t\te.Log.InfoContext(ctx, \"init.done\", \"repo\", d.Repo.String(), \"base\", base, \"files\", 0, \"pr\", 0, \"dry_run\", e.DryRun)\n\t\treturn nil\n\t}\n\tprintOps(e, ops)\n\n\t// 9. Open the PR.\n\tpr, err = d.Effects.CreatePR(ctx, github.NewPR{\n\t\tTitle: prTitle, Body: initBody(ops, res), Head: committer.InitBranch, Base: \"main\",\n\t})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard init: branch %s pushed but opening the PR failed: %w; open it by hand, or delete the branch and rerun\", committer.InitBranch, err)\n\t}\n\n\t// 10. Report.\n\tif e.DryRun {\n\t\tfmt.Fprintf(e.Stdout, \"dry-run: would open a PR from %s\\n\", committer.InitBranch)\n\t} else {\n\t\tfmt.Fprintf(e.Stdout, \"opened PR #%d: %s\\n\", pr.Number, pr.URL)\n\t}\n\te.Log.InfoContext(ctx, \"init.done\", \"repo\", d.Repo.String(), \"base\", base, \"files\", len(toWrite), \"pr\", pr.Number, \"dry_run\", e.DryRun)\n\treturn nil\n}\n\n// printOps writes one line per file the PR adds or overwrites.\nfunc printOps(e *cli.Env, ops []op) {\n\tfor _, o := range ops {\n\t\tif o.Act == actUnchanged {\n\t\t\tcontinue\n\t\t}\n\t\tverb := string(o.Act)\n\t\tif e.DryRun {\n\t\t\tverb = \"would \" + verb\n\t\t} else {\n\t\t\tverb += \" \"\n\t\t}\n\t\tmode := \"\"\n\t\tif o.File.Exec {\n\t\t\tmode = \" (0755)\"\n\t\t}\n\t\tfmt.Fprintf(e.Stdout, \"%s %s%s\\n\", verb, o.File.Path, mode)\n\t}\n}\n\n// initExistsErr is the refusal when ard-init is already on the remote. It\n// names the open PR when there is one.\nfunc initExistsErr(ctx context.Context, d deps) error {\n\tmsg := \"ard init: branch ard-init already exists on the remote\"\n\tif prs, err := d.Reader.ListPRs(ctx, github.ListPRsOpts{Head: committer.InitBranch, State: github.StateOpen}); err == nil && len(prs) > 0 {\n\t\tmsg += fmt.Sprintf(\" (open PR #%d)\", prs[0].Number)\n\t}\n\treturn errors.New(strings.TrimSpace(msg) + \"; merge or close it and delete the branch, then rerun\")\n}\n\t\t\tm[rel+\"/\"] = \"\"\n\t\t\treturn nil\n\t\t}\n\t\tb, err := os.ReadFile(p)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tm[rel] = string(b)\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn m\n}\n\nvar starterTree = []string{\".ard/config.yaml\", \".ard/reviewers/eng-review/prompt.txt\", \".ard/reviewers/license-review/allowlist.txt\", \".ard/reviewers/license-review/prompt.txt\", \".ard/reviewers/product-manager-review/prompt.txt\", \".ard/reviewers/security-review/prompt.txt\", \".ard/scanners/cve/Dockerfile\", \".ard/scanners/cve/merge.jq\", \".ard/scanners/cve/scan\", \".ard/scanners/docs/Dockerfile\", \".ard/scanners/docs/docscan.go\", \".ard/scanners/docs/scan\", \".ard/scanners/error-codes/Dockerfile\", \".ard/scanners/error-codes/errcodes.jq\", \".ard/scanners/error-codes/scan\", \".ard/scanners/lint/Dockerfile\", \".ard/scanners/lint/normalize.jq\", \".ard/scanners/lint/scan\", \".ard/scanners/lts/Dockerfile\", \".ard/scanners/lts/eol.jq\", \".ard/scanners/lts/products.json\", \".ard/scanners/lts/refs.jq\", \".ard/scanners/lts/scan\", \".ard/scanners/missing-tests/Dockerfile\", \".ard/scanners/missing-tests/missingtests.go\", \".ard/scanners/missing-tests/scan\", \".ard/scanners/trufflehog-history/Dockerfile\", \".ard/scanners/trufflehog-history/exclude-paths\", \".ard/scanners/trufflehog-history/findings.jq\", \".ard/scanners/trufflehog-history/history\", \".ard/scanners/trufflehog-history/scan\", \".ard/scanners/trufflehog/Dockerfile\", \".ard/scanners/trufflehog/exclude-paths\", \".ard/scanners/trufflehog/findings.jq\", \".ard/scanners/trufflehog/scan\", \".ard/triage/architect/prompt.txt\", \".ard/triage/designer/prompt.txt\", \".ard/triage/documentation-planner/prompt.txt\", \".ard/triage/engineer/prompt.txt\", \".ard/triage/lead/prompt.txt\", \".ard/triage/product-manager/prompt.txt\", \".ard/workers/engineer/prompt.txt\"}\n\nfunc TestInitOpensPR(t *testing.T) {\n\th := newHarness(t)\n\tbefore := snapshot(t, h.clone)\n\tout, err := h.run(t, false, false)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif got := h.tree(t, \"ard-init\"); !reflect.DeepEqual(got, starterTree) {\n\t\tt.Errorf(\"ard-init tree = %v, want %v\", got, starterTree)\n\t}\n\tif got := strings.TrimSpace(gittest.Run(t, h.bare, \"ls-tree\", \"-r\", \"ard-init\", \"--\", \".ard/scanners/cve/scan\")); !strings.HasPrefix(got, \"100755 \") {\n\t\tt.Errorf(\"scan = %q, want mode 100755\", got)\n\t}\n\tif got := strings.TrimSpace(gittest.Run(t, h.bare, \"ls-tree\", \"-r\", \"ard-init\", \"--\", \".ard/scanners/docs/scan\")); !strings.HasPrefix(got, \"100755 \") {\n\t\tt.Errorf(\"docs scan = %q, want mode 100755\", got)\n\t}\n\tif got := strings.TrimSpace(gittest.Run(t, h.bare, \"ls-tree\", \"-r\", \"ard-init\", \"--\", \".ard/scanners/lint/scan\")); !strings.HasPrefix(got, \"100755 \") {\n\t\tt.Errorf(\"lint scan = %q, want mode 100755\", got)\n\t}\n\tif !reflect.DeepEqual(snapshot(t, h.clone), before) {\n\t\tt.Error(\"the working tree changed\")\n\t}\n\tif n := strings.TrimSpace(gittest.Run(t, h.bare, \"rev-list\", \"--count\", \"main\")); n != \"1\" {\n\t\tt.Errorf(\"main has %s commits, want 1\", n)\n\t}\n\n\t// Done when: ard config check passes on the proposed branch.\n\tgittest.Run(t, h.clone, \"fetch\", \"-q\", \"origin\", \"+refs/heads/ard-init:refs/ard/upstream/ard-init\")\n\tce := &cli.Env{Globals: cli.Globals{ConfigPath: filepath.Join(h.clone, \".ard\", \"config.yaml\")}, Log: quiet, Stdout: io.Discard, Stderr: &bytes.Buffer{}}\n\tif err := configcmd.Check(context.Background(), ce, cli.ConfigCheckOpts{Ref: \"refs/ard/upstream/ard-init\"}); err != nil {\n\t\tt.Fatalf(\"config check on ard-init: %v\", err)\n\t}\n\tcres, err := loadStarter(t, nil)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif cres.Intake != (config.Intake{Mode: config.IntakeLabel}) {\n\t\tt.Errorf(\"intake = %+v\", cres.Intake)\n\t}\n\tcve, _ := cres.Role(config.KindScanner, \"cve\")\n\tif cve.Every != 6*time.Hour || cve.MaxOpen != 10 || cve.GroupSize != 1 || !cve.Autoclose {\n\t\tt.Errorf(\"cve = %+v\", cve)\n\t}\n\tdocs, _ := cres.Role(config.KindScanner, \"docs\")\n\tif docs.Every != 72*time.Hour || docs.MaxOpen != 3 || docs.GroupSize != 10 || !docs.Autoclose {\n\t\tt.Errorf(\"docs = %+v\", docs)\n\t}\n\tlint, ok := cres.Role(config.KindScanner, \"lint\")\n\tif !ok || lint.Every != 24*time.Hour || lint.MaxOpen != 3 || lint.GroupSize != 20 || !lint.Autoclose {\n\t\tt.Errorf(\"lint = %+v\", lint)\n\t}\n\n\tprs, err := h.fake.ListPRs(context.Background(), github.ListPRsOpts{})\n# ard configuration, proposed by `ard init`. Edit freely; this file is yours.\n# Anything unset takes its built-in default (docs/proposal.md, Configuration).\n# Validate with `ard config check`. ard serve reads this file from origin/main.\n\n# label: only issues a maintainer labels for triage enter the pipeline.\n# all: every human-filed issue enters.\nintake: { mode: label }\n\nmerge:\n  # A PR touching any of these waits for a human approval. There is no\n  # built-in list: removing an entry removes its gate. An entry ending in /\n  # is a directory prefix; anything else is a glob (quote globs starting with *).\n  protected_paths:\n    - .github/\n    - .ard/config.yaml\n    - .ard/scanners/\n    - .ard/triage/\n    - .ard/workers/\n    - .ard/reviewers/\n    - \"**/CODEOWNERS\"\n    # Agent instructions a PR could plant to steer later agents.\n    - CLAUDE.md\n    - \"**/CLAUDE.md\"\n    - AGENTS.md\n    - \"**/AGENTS.md\"\n    - .claude/\n    - .mcp.json\n    # Linter config a PR could weaken: disabling a linter silently autocloses its issues.\n    - \"**/.golangci.yml\"\n    - \"**/.golangci.yaml\"\n    - \"**/.golangci.toml\"\n    - \"**/.golangci.json\"\n\noverrides:\n  scanners/cve: { every: 6h, max_open: 10, group_size: 1, autoclose: true }\n  scanners/lts: { every: 7d, max_open: 5, group_size: 1, autoclose: true }\n  scanners/docs: { every: 3d, max_open: 3, group_size: 10, autoclose: true }\n  scanners/error-codes: { every: 24h, group_size: 20, autoclose: true }\n  scanners/missing-tests: { every: 24h, max_open: 5, group_size: 10, autoclose: true }\n  # needs a human-made `baseline` next to `scan`; see its Dockerfile\nconfig.yaml\ncve_docker_integration_test.go\ncve_integration_test.go\ncve_test.go\ndocs_docker_integration_test.go\ndocs_test.go\neng_review_test.go\nengineer_test.go\nerrcodes_integration_test.go\nerrcodes_test.go\nlead_test.go\nlicense_review_integration_test.go\nlicense_review_test.go\nlint_docker_integration_test.go\nlint_integration_test.go\nlint_scan_test.go\nlint_test.go\nlts_integration_test.go\nlts_test.go\nmissing_tests_integration_test.go\nmissing_tests_test.go\npm_review_test.go\nreviewers\nroles.go\nroles_test.go\nscanner_guard_test.go\nscanners\nsecurity_review_test.go\ntestdata\ntriage\ntriage_roles_test.go\ntrufflehog_docker_integration_test.go\ntrufflehog_history_test.go\ntrufflehog_integration_test.go\ntrufflehog_test.go\nworker_engineer_test.go\nworkers\n14:  protected_paths:\n15-    - .github/\n16-    - .ard/config.yaml\n17-    - .ard/scanners/\n18-    - .ard/triage/\n19-    - .ard/workers/\n20-    - .ard/reviewers/\n21-    - \"**/CODEOWNERS\"\n22-    # Agent instructions a PR could plant to steer later agents.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01KduAau4zA44vCPzh5UuW81","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
