een competing changes. -->\n+\n+# Roadmap\n+\n+<!-- Near-term priorities, most important first. -->\n+\n+# Out of scope\n+\n+<!-- Directions the project will not take. -->\ndiff --git a/internal/roles/config.yaml b/internal/roles/config.yaml\nindex 69c1160..c0ff96d 100644\n--- a/internal/roles/config.yaml\n+++ b/internal/roles/config.yaml\n@@ -17,6 +17,10 @@ merge:\n     - .ard/triage/\n     - .ard/workers/\n     - .ard/reviewers/\n+    # Repo context docs every agent reads; a PR could plant instructions in them.\n+    - .ard/PRODUCT.md\n+    - .ard/VISION.md\n+    - .ard/TECH_STACK.md\n     - \"**/CODEOWNERS\"\n     # Agent instructions a PR could plant to steer later agents.\n     - CLAUDE.md\ndiff --git a/internal/roles/context_test.go b/internal/roles/context_test.go\nnew file mode 100644\nindex 0000000..0e31cfe\n--- /dev/null\n+++ b/internal/roles/context_test.go\n@@ -0,0 +1,45 @@\n+package roles\n+\n+import (\n+\t\"regexp\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+var htmlComment = regexp.MustCompile(`(?s)<!--.*?-->`)\n+\n+// onlyHeadings reports the first line that is neither blank nor a heading once\n+// HTML comments are removed.\n+func onlyHeadings(s string) (string, bool) {\n+\tfor _, l := range strings.Split(htmlComment.ReplaceAllString(s, \"\"), \"\\n\") {\n+\t\tif t := strings.TrimSpace(l); t != \"\" && !strings.HasPrefix(t, \"#\") {\n+\t\t\treturn l, false\n+\t\t}\n+\t}\n+\treturn \"\", true\n+}\n+\n+func TestContextTemplates(t *testing.T) {\n+\tfor _, name := range []string{\"PRODUCT.md\", \"VISION.md\", \"TECH_STACK.md\"} {\n+\t\tb, err := FS.ReadFile(name)\n+\t\tif err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\ts := string(b)\n+\t\tif l, ok := onlyHeadings(s); !ok {\n+\t\t\tt.Errorf(\"%s has a prose line outside comments: %q\", name, l)\n+\t\t}\n+\t\tif !strings.Contains(s, \"\\nLast reviewed: YYYY-MM-DD\\n\") {\n+\t\t\tt.Errorf(\"%s lacks the Last reviewed line\", name)\n+\t\t}\n+\t\tif !strings.Contains(s, \"150 lines\") {\n+\t\t\tt.Errorf(\"%s lacks the size guidance\", name)\n+\t\t}\n+\t\tif !strings.Contains(s, \"\\n# \") {\n+\t\t\tt.Errorf(\"%s has no headings\", name)\n+\t\t}\n+\t}\n+\tif _, ok := onlyHeadings(\"# A\\n\\nsome prose\\n\"); ok {\n+\t\tt.Error(\"prose line not detected\")\n+\t}\n+}\ndiff --git a/internal/roles/roles.go b/internal/roles/roles.go\nindex bb0ac16..ffef3aa 100644\n--- a/internal/roles/roles.go\n+++ b/internal/roles/roles.go\n@@ -6,12 +6,12 @@ package roles\n \n import \"embed\"\n \n-// FS is the starter .ard/ tree `ard init` proposes: config.yaml plus the role\n+// FS is the starter .ard/ tree `ard init` proposes: config.yaml, the repo context templates PRODUCT.md, VISION.md and TECH_STACK.md, plus the role\n // directories (scanners/cve, scanners/lts, scanners/docs, scanners/error-codes, scanners/lint, scanners/missing-tests, scanners/trufflehog, scanners/trufflehog-history, triage/lead, triage/engineer, triage/product-manager, triage/architect, triage/designer, triage/documentation-planner, workers/engineer, reviewers/eng-review, reviewers/license-review, reviewers/product-manager-review and reviewers/security-review); paths are relative to .ard/.\n //\n // scanners/missing-tests is left out until its scan driver exists; re-add it when wiring it in.\n //\n-//go:embed config.yaml reviewers scanners/cve scanners/docs scanners/error-codes scanners/lint scanners/lts scanners/missing-tests scanners/trufflehog scanners/trufflehog-history triage workers\n+//go:embed config.yaml PRODUCT.md VISION.md TECH_STACK.md reviewers scanners/cve scanners/docs scanners/error-codes scanners/lint scanners/lts scanners/missing-tests scanners/trufflehog scanners/trufflehog-history triage workers\n var FS embed.FS\n \n // ExecutableNames lists base names that must be written 0755.\ndiff --git a/internal/roles/roles_test.go b/internal/roles/roles_test.go\nindex 3c82690..23eba8a 100644\n--- a/internal/roles/roles_test.go\n+++ b/internal/roles/roles_test.go\n@@ -32,7 +32,7 @@ func TestFSContents(t *t