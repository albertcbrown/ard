\t+\tTimeout time.Duration // default DefaultGitleaksTimeout\n438\t+}\n439\t+\n440\t+type gitleaks struct{ o GitleaksOptions }\n441\t+\n442\t+// Gitleaks returns a Scanner that runs a gitleaks binary over the scanned\n443\t+// bytes (detect --no-git). It fails closed: a missing binary, an error exit,\n444\t+// a timeout or an unreadable report is an error. Findings carry only the\n445\t+// rule, line and column, never the matched text.\n446\t+func Gitleaks(o GitleaksOptions) Scanner {\n447\t+\tif o.Path == \"\" {\n448\t+\t\to.Path = \"gitleaks\"\n449\t+\t}\n450\t+\tif o.Timeout <= 0 {\n451\t+\t\to.Timeout = DefaultGitleaksTimeout\n452\t+\t}\n453\t+\treturn gitleaks{o}\n454\t+}\n455\t+\n456\t+type gitleaksReport struct {\n457\t+\tRuleID      string `json:\"RuleID\"`\n458\t+\tStartLine   int    `json:\"StartLine\"`\n459\t+\tStartColumn int    `json:\"StartColumn\"`\n460\t+}\n461\t+\n462\t+func (g gitleaks) Scan(ctx context.Context, r io.Reader) ([]Finding, error) {\n463\t+\tbin, err := exec.LookPath(g.o.Path)\n464\t+\tif err != nil {\n465\t+\t\treturn nil, fmt.Errorf(\"gitleaks: binary not found: %w\", err)\n466\t+\t}\n467\t+\tdir, err := os.MkdirTemp(\"\", \"ard-gitleaks-*\")\n468\t+\tif err != nil {\n469\t+\t\treturn nil, fmt.Errorf(\"gitleaks: temp dir: %w\", err)\n470\t+\t}\n471\t+\tdefer os.RemoveAll(dir)\n472\t+\tif err := os.Chmod(dir, 0o700); err != nil {\n473\t+\t\treturn nil, fmt.Errorf(\"gitleaks: temp dir: %w\", err)\n474\t+\t}\n475\t+\tsrc := filepath.Join(dir, \"input.log\")\n476\t+\treport := filepath.Join(dir, \"report.json\")\n477\t+\tf, err := os.OpenFile(src, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)\n478\t+\tif err != nil {\n479\t+\t\treturn nil, fmt.Errorf(\"gitleaks: write input: %w\", err)\n480\t+\t}\n481\t+\tif _, err := io.Copy(f, r); err != nil {\n482\t+\t\tf.Close()\n483\t+\t\treturn nil, fmt.Errorf(\"gitleaks: write input: %w\", err)\n484\t+\t}\n485\t+\tif err := f.Close(); err != nil {\n486\t+\t\treturn nil, fmt.Errorf(\"gitleaks: write input: %w\", err)\n487\t+\t}\n488\t+\n489\t+\tctx, cancel := context.WithTimeout(ctx, g.o.Timeout)\n490\t+\tdefer cancel()\n491\t+\tcmd := exec.CommandContext(ctx, bin, \"detect\", \"--no-git\", \"--no-banner\", \"--redact\",\n492\t+\t\t\"--exit-code\", fmt.Sprint(gitleaksLeakExit), \"--source\", src,\n493\t+\t\t\"--report-format\", \"json\", \"--report-path\", report)\n494\t+\tcmd.Dir = dir\n495\t+\tcmd.Env = []string{\"PATH=\" + os.Getenv(\"PATH\"), \"HOME=\" + dir}\n496\t+\t// Output is discarded: it may echo scanned content.\n497\t+\tcmd.Stdout, cmd.Stderr = io.Discard, io.Discard\n498\t+\tcode := 0\n499\t+\tif err := cmd.Run(); err != nil {\n500\t+\t\tvar ee *exec.ExitError\n501\t+\t\tif ctx.Err() != nil {\n502\t+\t\t\treturn nil, fmt.Errorf(\"gitleaks: %w\", ctx.Err())\n503\t+\t\t}\n504\t+\t\tif !errors.As(err, &ee) {\n505\t+\t\t\treturn nil, fmt.Errorf(\"gitleaks: run: %w\", err)\n506\t+\t\t}\n507\t+\t\tcode = ee.ExitCode()\n508\t+\t}\n509\t+\tif code != 0 && code != gitleaksLeakExit {\n510\t+\t\treturn nil, fmt.Errorf(\"gitleaks: exit status %d\", code)\n511\t+\t}\n512\t+\tdata, err := os.ReadFile(report)\n513\t+\tif err != nil {\n514\t+\t\treturn nil, fmt.Errorf(\"gitleaks: read report: %w\", err)\n515\t+\t}\n516\t+\tvar recs []gitleaksReport\n517\t+\tif err := json.Unmarshal(bytes.TrimSpace(data), &recs); err != nil {\n518\t+\t\treturn nil, errors.New(\"gitleaks: report is not valid JSON\")\n519\t+\t}\n520\t+\tif code == 0 && len(recs) > 0 {\n521\t+\t\treturn nil, errors.New(\"gitleaks: report has findings but exit status 0\")\n522\t+\t}\n523\t+\tif code == gitleaksLeakExit && len(recs) == 0 {\n524\t+\t\treturn nil, errors.New(\"gitleaks: leak exit status with an empty report\")\n525\t+\t}\n526\t+\tvar out []Finding\n527\t+\tfor _, rec := range recs {\n528\t+\t\tout = append(out, Finding{Rule: \"gitleaks:\" + rec.RuleID, Line: rec.StartLine, Col: rec.StartColumn})\n529\t+\t}\n530\t+\treturn out, nil\n531\t+}\n532\tdiff --git a/internal/redact/gitleaks_integration_test.go b/internal/redact/gitleaks_integration_test.go\n533\tnew file mode 100644\n534\tindex 0000000..0ad0175\n535\t--- /dev/null\n536\t+++ b/internal/redact/gitleaks_integration_test.go\n537\t@@ -0,0 +1,38 @@\n538\t+package redact\n539\t+\n540\t+import (\n541\t+\t\"context\"\n542\t+\t\"os\"\n543\t+\t\"os/exec\"\n544\t+\t\"strings\"\n545\t+\t\"testing\"\n546\t+)\n547\t+\n548\t+// PinnedGitleaksVersion is the gitleaks release the integration test and\n549\t+// production are expected to use.\n550\t+const PinnedGitleaksVersion = \"8.28.0\"\n551\t+\n552\t+// TestGitleaksReal runs the real pinned binary named by ARD_GITLEAKS_BIN.\n553\t+func TestGitleaksReal(t *testing.T) {\n554\t+\tbin := os.Getenv(\"ARD_GITLEAKS_BIN\")\n555\t+\tif bin == \"\" {\n556\t+\t\tt.Skip(\"ARD_GITLEAKS_BIN not set\")\n557\t+\t}\n558\t+\tout, err := exec.Command(bin, \"version\").Output()\n559\t+\tif err != nil {\n560\t+\t\tt.Fatal(err)\n561\t+\t}\n562\t+\tif got := strings.TrimPrefix(strings.TrimSpace(string(out)), \"v\"); got != PinnedGitleaksVersion {\n563\t+\t\tt.Fatalf(\"gitleaks version %q, want pinned %q\", got, PinnedGitleaksVersion)\n564\t+\t}\n565\t+\ts := Gitleaks(GitleaksOptions{Path: bin})\n566\t+\tplanted := \"ok\\ntoken = \" + plantedTokens()[\"aws-access-key\"] + \"\\naws_secret_access_key = \" + randStr(21, 40) + \"\\n\"\n567\t+\tgot, err := s.Scan(context.Background(), strings.NewReader(planted))\n568\t+\tif err != nil || len(got) == 0 {\n569\t+\t\tt.Errorf(\"planted: got %+v, %v; want a finding\", got, err)\n570\t+\t}\n571\t+\tgot, err = s.Scan(context.Background(), strings.NewReader(\"build ok\\nall tests passed\\n\"))\n572\t+\tif err != nil || len(got) != 0 {\n573\t+\t\tt.Errorf(\"plain: got %+v, %v; want clean\", got, err)\n574\t+\t}\n575\t+}\n576\tdiff --git a/internal/redact/gitleaks_test.go b/internal/redact/gitleaks_test.go\n577\tnew file mode 100644\n578\tindex 0000000..5031478\n579\t--- /dev/null\n580\t+++ b/internal/redact/gitleaks_test.go\n581\t@@ -0,0 +1,197 @@\n582\t+package redact\n583\t+\n584\t+import (\n585\t+\t\"bytes\"\n586\t+\t\"context\"\n587\t+\t\"io\"\n588\t+\t\"os\"\n589\t+\t\"path/filepath\"\n590\t+\t\"runtime\"\n591\t+\t\"strings\"\n592\t+\t\"testing\"\n593\t+\t\"time\"\n594\t+)\n595\t+\n596\t+// fakeGitleaks writes a shell script that stands in for gitleaks. body runs\n597\t+// with $report set to the --report-path argument and $src to --source.\n598\t+func fakeGitleaks(t *testing.T, body string) string {\n599\t+\tt.Helper()\n600\t+\tif runtime.GOOS == \"windows\" {\n601\t+\t\tt.Skip(\"shell script fake\")\n602\t+\t}\n603\t+\tscript := `#!/bin/sh\n604\t+all=\"$*\"; report=\"\"; src=\"\"\n605\t+while [ $# -gt 0 ]; do\n606\t+  case \"$1\" in\n607\t+    --report-path) report=\"$2\"; shift;;\n608\t+    --source) src=\"$2\"; shift;;\n609\t+  esac\n610\t+  shift\n611\t+done\n612\t+` + body + \"\\n\"\n613\t+\tp := filepath.Join(t.TempDir(), \"gitleaks\")\n614\t+\tif err := os.WriteFile(p, []byte(script), 0o755); err != nil {\n615\t+\t\tt.Fatal(err)\n616\t+\t}\n617\t+\treturn p\n618\t+}\n619\t+\n620\t+func scanWith(t *testing.T, path, in string) ([]Finding, error) {\n621\t+\tt.Helper()\n622\t+\treturn Gitleaks(GitleaksOptions{Path: path}).Scan(context.Background(), strings.NewReader(in))\n623\t+}\n624\t+\n625\t+func TestGitleaksHit(t *testing.T) {\n626\t+\tp := fakeGitleaks(t, `echo '[{\"RuleID\":\"aws-access-token\",\"StartLine\":3,\"StartColumn\":7,\"Match\":\"SECRETTEXT\",\"Secret\":\"SECRETTEXT\"}]' > \"$report\"; exit 2`)\n627\t+\tgot, err := scanWith(t, p, \"a\\nb\\nc\\n\")\n628\t+\tif err != nil {\n629\t+\t\tt.Fatal(err)\n630\t+\t}\n631\t+\twant := Finding{Rule: \"gitleaks:aws-access-token\", Line: 3, Col: 7}\n632\t+\tif len(got) != 1 || got[0] != want {\n633\t+\t\tt.Errorf(\"findings = %+v, want [%+v]\", got, want)\n634\t+\t}\n635\t+}\n636\t+\n637\t+func TestGitleaksClean(t *testing.T) {\n638\t+\tp := fakeGitleaks(t, `echo '[]' > \"$report\"; exit 0`)\n639\t+\tgot, err := scanWith(t, p, \"hello\\n\")\n640\t+\tif err != nil || len(got) != 0 {\n641\t+\t\tt.Errorf(\"got %+v, %v; want clean\", got, err)\n642\t+\t}\n643\t+}\n644\t+\n645\t+func TestGitleaksMissingBinary(t *testing.T) {\n646\t+\tgot, err := scanWith(t, filepath.Join(t.TempDir(), \"nope\"), \"x\")\n647\t+\tif err == nil || got != nil {\n648\t+\t\tt.Errorf(\"got %+v, %v; want error\", got, err)\n649\t+\t}\n650\t+}\n651\t+\n652\t+func TestGitleaksErrorExit(t *testing.T) {\n653\t+\tp := fakeGitleaks(t, `echo \"LEAKED-STDERR-TEXT\" >&2; exit 1`)\n654\t+\tgot, err := scanWith(t, p, \"x\")\n655\t+\tif err == nil || got != nil {\n656\t+\t\tt.Fatalf(\"got %+v, %v; want error\", got, err)\n657\t+\t}\n658\t+\tif strings.Contains(err.Error(), \"LEAKED-STDERR-TEXT\") {\n659\t+\t\tt.Errorf(\"error echoes stderr: %v\", err)\n660\t+\t}\n661\t+}\n662\t+\n663\t+func TestGitleaksBadReport(t *testing.T) {\n664\t+\tfor name, body := range map[string]string{\n665\t+\t\t\"garbage with exit 0\":    `echo 'not json' > \"$report\"; exit 0`,\n666\t+\t\t\"empty report, exit 2\":   `echo '[]' > \"$report\"; exit 2`,\n667\t+\t\t\"no report, exit 0\":      `exit 0`,\n668\t+\t\t\"findings with exit 0\":   `echo '[{\"RuleID\":\"x\",\"StartLine\":1,\"StartColumn\":1}]' > \"$report\"; exit 0`,\n669\t+\t\t\"garbage report, exit 2\": `echo '{' > \"$report\"; exit 2`,\n670\t+\t} {\n671\t+\t\tt.Run(name, func(t *testing.T) {\n672\t+\t\t\tgot, err := scanWith(t, fakeGitleaks(t, body), \"x\")\n673\t+\t\t\tif err == nil || got != nil {\n674\t+\t\t\t\tt.Errorf(\"got %+v, %v; want error\", got, err)\n675\t+\t\t\t}\n676\t+\t\t})\n677\t+\t}\n678\t+}\n679\t+\n680\t+func TestGitleaksTimeoutAndCancel(t *testing.T) {\n681\t+\tp := fakeGitleaks(t, `sleep 5`)\n682\t+\tstart := time.Now()\n683\t+\t_, err := Gitleaks(GitleaksOptions{Path: p, Timeout: 100 * time.Millisecond}).Scan(context.Background(), strings.NewReader(\"x\"))\n684\t+\tif err == nil {\n685\t+\t\tt.Error(\"timeout: want error\")\n686\t+\t}\n687\t+\tctx, cancel := context.WithCancel(context.Background())\n688\t+\tcancel()\n689\t+\tif _, err := Gitleaks(GitleaksOptions{Path: p}).Scan(ctx, strings.NewReader(\"x\")); err == nil {\n690\t+\t\tt.Error(\"cancelled: want error\")\n691\t+\t}\n692\t+\tif time.Since(start) > 4*time.Second {\n693\t+\t\tt.Error(\"fake was not killed\")\n694\t+\t}\n695\t+}\n696\t+\n697\t+func TestGitleaksArgs(t *testing.T) {\n698\t+\tout := t.TempDir()\n699\t+\tp := fakeGitleaks(t, `echo \"$all\" > `+out+`/argv; cp \"$src\" `+out+`/input; echo \"$src\" > `+out+`/srcpath; echo '[]' > \"$report\"`)\n700\t+\tif _, err := scanWith(t, p, \"redacted bytes\\n\"); err != nil {\n701\t+\t\tt.Fatal(err)\n702\t+\t}\n703\t+\targv, _ := os.ReadFile(filepath.Join(out, \"argv\"))\n704\t+\tfor _, w := range []string{\"detect\", \"--no-git\", \"--report-format json\"} {\n705\t+\t\tif !strings.Contains(string(argv), w) {\n706\t+\t\t\tt.Errorf(\"argv %q lacks %q\", argv, w)\n707\t+\t\t}\n708\t+\t}\n709\t+\tin, _ := os.ReadFile(filepath.Join(out, \"input\"))\n710\t+\tif !bytes.Equal(in, []byte(\"redacted bytes\\n\")) {\n711\t+\t\tt.Errorf(\"input = %q\", in)\n712\t+\t}\n713\t+\tsrc, _ := os.ReadFile(filepath.Join(out, \"srcpath\"))\n714\t+\tif _, err := os.Stat(filepath.Dir(strings.TrimSpace(string(src)))); !os.IsNotExist(err) {\n715\t+\t\tt.Errorf(\"temp dir left behind: %v\", err)\n716\t+\t}\n717\t+}\n718\t+\n719\t+type fixedScanner struct {\n720\t+\tf   []Finding\n721\t+\terr error\n722\t+}\n723\t+\n724\t+func (s fixedScanner) Scan(context.Context, io.Reader) ([]Finding, error) { return s.f, s.err }\n725\t+\n726\t+func TestMulti(t *testing.T) {\n727\t+\thit := Finding{Rule: \"builtin\", Line: 1, Col: 1}\n728\t+\tgot, err := Multi(fixedScanner{f: []Finding{hit}}, fixedScanner{}).Scan(context.Background(), strings.NewReader(\"x\"))\n729\t+\tif err != nil || len(got) != 1 || got[0] != hit {\n730\t+\t\tt.Errorf(\"got %+v, %v\", got, err)\n731\t+\t}\n732\t+\tfor _, ss := range [][]Scanner{\n733\t+\t\t{fixedScanner{f: []Finding{hit}}, fixedScanner{err: os.ErrInvalid}},\n734\t+\t\t{fixedScanner{err: os.ErrInvalid}, fixedScanner{}},\n735\t+\t} {\n736\t+\t\tgot, err := Multi(ss...).Scan(context.Background(), strings.NewReader(\"x\"))\n737\t+\t\tif err == nil || got != nil {\n738\t+\t\t\tt.Errorf(\"got %+v, %v; want error\", got, err)\n739\t+\t\t}\n740\t+\t}\n741\t+}\n742\t+\n743\t+func TestLogWithGitleaks(t *testing.T) {\n744\t+\twrite := func(t *testing.T) (string, string) {\n745\t+\t\td := t.TempDir()\n746\t+\t\tsrc := filepath.Join(d, \"in.log\")\n747\t+\t\tif err := os.WriteFile(src, []byte(\"plain log\\n\"), 0o600); err != nil {\n748\t+\t\t\tt.Fatal(err)\n749\t+\t\t}\n750\t+\t\treturn src, filepath.Join(d, \"out.log\")\n751\t+\t}\n752\t+\tt.Run(\"hit\", func(t *testing.T) {\n753\t+\t\tp := fakeGitleaks(t, `echo '[{\"RuleID\":\"r\",\"StartLine\":1,\"StartColumn\":1}]' > \"$report\"; exit 2`)\n754\t+\t\tr, err := New(nil, Options{Scanner: Multi(Builtin(), Gitleaks(GitleaksOptions{Path: p}))})\n755\t+\t\tif err != nil {\n756\t+\t\t\tt.Fatal(err)\n757\t+\t\t}\n758\t+\t\tsrc, dst := write(t)\n759\t+\t\tres, err := r.Log(context.Background(), src, dst)\n760\t+\t\tif err != nil || !res.Flagged || res.Clean != nil {\n761\t+\t\t\tt.Errorf(\"res = %+v, err = %v; want flagged\", res, err)\n762\t+\t\t}\n763\t+\t})\n764\t+\tt.Run(\"error\", func(t *testing.T) {\n765\t+\t\tp := fakeGitleaks(t, `exit 1`)\n766\t+\t\tr, err := New(nil, Options{Scanner: Multi(Builtin(), Gitleaks(GitleaksOptions{Path: p}))})\n767\t+\t\tif err != nil {\n768\t+\t\t\tt.Fatal(err)\n769\t+\t\t}\n770\t+\t\tsrc, dst := write(t)\n771\t+\t\tif _, err := r.Log(context.Background(), src, dst); err == nil {\n772\t+\t\t\tt.Error(\"want error\")\n773\t+\t\t}\n774\t+\t\tif ents, _ := os.ReadDir(filepath.Dir(dst)); len(ents) != 1 {\n775\t+\t\t\tt.Errorf(\"leftover files: %v\", ents)\n776\t+\t\t}\n777\t+\t})\n778\t+}\n779\tdiff --git a/internal/redact/multi.go b/internal/redact/multi.go\n780\tnew file mode 100644\n781\tindex 0000000..6cd793e\n782\t--- /dev/null\n783\t+++ b/internal/redact/multi.go\n784\t@@ -0,0 +1,52 @@\n785\t+package redact\n786\t+\n787\t+import (\n788\t+\t\"bytes\"\n789\t+\t\"context\"\n790\t+\t\"fmt\"\n791\t+\t\"io\"\n792\t+)\n793\t+\n794\t+type multi []Scanner\n795\t+\n796\t+// Multi returns a Scanner that runs each scanner in order over the same\n797\t+// bytes and concatenates their findings. The first error fails the scan and\n798\t+// no findings are returned.\n799\t+func Multi(scanners ...Scanner) Scanner { return multi(scanners) }\n800\t+\n801\t+func (m multi) Scan(ctx context.Context, r io.Reader) ([]Finding, error) {\n802\t+\tif len(m) == 0 {\n803\t+\t\treturn nil, nil\n804\t+\t}\n805\t+\tif len(m) == 1 {\n806\t+\t\treturn m[0].Scan(ctx, r)\n807\t+\t}\n808\t+\t// Each scanner needs the whole input: rewind a seekable reader, else\n809\t+\t// hold the bytes in memory.\n810\t+\tvar open func() (io.Reader, error)\n811\t+\tif rs, ok := r.(io.ReadSeeker); ok {\n812\t+\t\topen = func() (io.Reader, error) { _, err := rs.Seek(0, io.SeekStart); return rs, err }\n813\t+\t} else {\n814\t+\t\tdata, err := io.ReadAll(r)\n815\t+\t\tif err != nil {\n816\t+\t\t\treturn nil, fmt.Errorf(\"scan: %w\", err)\n817\t+\t\t}\n818\t+\t\topen = func() (io.Reader, error) { return bytes.NewReader(data), nil }\n819\t+\t}\n820\t+\tvar out []Finding\n821\t+\tfor _, s := range m {\n822\t+\t\tif err := ctx.Err(); err != nil {\n823\t+\t\t\treturn nil, fmt.Errorf(\"scan: %w\", err)\n824\t+\t\t}\n825\t+\t\tin, err := open()\n826\t+\t\tif err != nil {\n827\t+\t\t\treturn nil, fmt.Errorf(\"scan: %w\", err)\n828\t+\t\t}\n829\t+\t\tf, err := s.Scan(ctx, in)\n830\t+\t\tif err != nil {\n831\t+\t\t\treturn nil, err\n832\t+\t\t}\n833\t+\t\tout = append(out, f...)\n834\t+\t}\n835\t+\treturn out, nil\n836\t+}\n837\tdiff --git a/internal/servecmd/reaping.go b/internal/servecmd/reaping.go\n838\tindex 4295467..6ebf924 100644\n839\t--- a/internal/servecmd/reaping.go\n840\t+++ b/internal/servecmd/reaping.go\n841\t@@ -18,6 +18,7 @@ import (\n842\t \t\"github.com/albertcbrown/ard/internal/limits\"\n843\t \t\"github.com/albertcbrown/ard/internal/pool\"\n844\t \t\"github.com/albertcbrown/ard/internal/reaper\"\n845\t+\t\"github.com/albertcbrown/ard/internal/redact\"\n846\t \t\"github.com/albertcbrown/ard/internal/state\"\n847\t )\n848\t \n849\t@@ -32,6 +33,16 @@ func (c cfgRoles) Role(k config.Kind, name string) (config.Role, bool) {\n850\t \treturn cfg.Role(k, name)\n851\t }\n852\t \n853\t+// gitleaksOptions reports whether the optional gitleaks pass is enabled in the\n854\t+// latest loaded config, and which binary to run.\n855\t+func (w *wiring) gitleaksOptions() (redact.GitleaksOptions, bool) {\n856\t+\tcfg := w.cfg.Load()\n857\t+\tif cfg == nil || !cfg.Redact.Gitleaks.Enabled {\n858\t+\t\treturn redact.GitleaksOptions{}, false\n859\t+\t}\n860\t+\treturn redact.GitleaksOptions{Path: cfg.Redact.Gitleaks.Path}, true\n861\t+}\n862\t+\n863\t // closer returns the one *closeout.Closer of this process. The triage, worker\n864\t // and reviewer loops and the Reaper share it: its per-job busy lock only\n865\t // serialises close-outs within one instance.\n866\t@@ -50,7 +61,7 @@ func (w *wiring) closer() *closeout.Closer {\n867\t \t\tRoles: cfgRoles{w},\n868\t \t\t// The job's model credentials are in the controller's environment.\n869\t \t\t// Host paths are replaced by placeholders in the same pass.\n870\t-\t\tNewRedactor: closeout.JobRedactor(os.Environ, w.hostPaths()),\n871\t+\t\tNewRedactor: closeout.JobRedactor(os.Environ, w.hostPaths(), w.gitleaksOptions),\n872\t \t\t// Job worktrees belong to the agent: git runs in the controller's own\n873\t \t\t// clone (w.Root) and never trusts a worktree's .git, index or config.\n874\t \t\tChanged: func(ctx context.Context, worktree, base string, paths ...string) ([]gitx.PathChange, error) {\n875\t"}]},"parent_tool_use_id":null,"session_id":"effc0a4e-11f8-448d-b171-71d60609e292","uuid":"c73fd571-cde7-40f1-bd0a-884ed5c36ca5","timestamp":"2026-11-23T13:40:08.086Z","tool_use_result