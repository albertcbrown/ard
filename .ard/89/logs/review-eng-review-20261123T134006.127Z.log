     rawStale\n \thaveStale       bool\n+\tgitleaksEnabled *bool // redact.gitleaks.enabled\n+\tgitleaksPath    *string\n \tsidecars        map[string]rawSidecar\n \toverrides       []rawOverrideRef\n }\n@@ -123,6 +125,8 @@ func parseConfigDoc(doc *yaml.Node, cfgPath string) (rawConfig, Errors) {\n \t\t\terrs = append(errs, raw.parseMerge(value, cfgPath)...)\n \t\tcase \"stale\":\n \t\t\terrs = append(errs, raw.parseStale(value, cfgPath)...)\n+\t\tcase \"redact\":\n+\t\t\terrs = append(errs, raw.parseRedact(value, cfgPath)...)\n \t\tcase \"sidecars\":\n \t\t\terrs = append(errs, raw.parseSidecars(value, cfgPath)...)\n \t\tcase \"overrides\":\n@@ -261,6 +265,42 @@ func (raw *rawConfig) parseStale(n *yaml.Node, file string) Errors {\n \treturn errs\n }\n \n+func (raw *rawConfig) parseRedact(n *yaml.Node, file string) Errors {\n+\tvar errs Errors\n+\tif n.Tag == \"!!null\" {\n+\t\treturn nil\n+\t}\n+\tif n.Kind != yaml.MappingNode {\n+\t\treturn Errors{{File: file, Key: \"redact\", Msg: \"must be a mapping\"}}\n+\t}\n+\tfor i := 0; i < len(n.Content); i += 2 {\n+\t\tkey, value := n.Content[i], n.Content[i+1]\n+\t\tif key.Value != \"gitleaks\" {\n+\t\t\terrs = append(errs, &Error{File: file, Key: \"redact.\" + key.Value, Msg: \"unknown key (want gitleaks)\"})\n+\t\t\tcontinue\n+\t\t}\n+\t\tif value.Tag == \"!!null\" {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif value.Kind != yaml.MappingNode {\n+\t\t\terrs = append(errs, &Error{File: file, Key: \"redact.gitleaks\", Msg: \"must be a mapping\"})\n+\t\t\tcontinue\n+\t\t}\n+\t\tfor j := 0; j < len(value.Content); j += 2 {\n+\t\t\tk, v := value.Content[j], value.Content[j+1]\n+\t\t\tswitch k.Value {\n+\t\t\tcase \"enabled\":\n+\t\t\t\terrs = append(errs, decodeValue(v, file, \"redact.gitleaks.enabled\", &raw.gitleaksEnabled)...)\n+\t\t\tcase \"path\":\n+\t\t\t\terrs = append(errs, decodeValue(v, file, \"redact.gitleaks.path\", &raw.gitleaksPath)...)\n+\t\t\tdefault:\n+\t\t\t\terrs = append(errs, &Error{File: file, Key: \"redact.gitleaks.\" + k.Value, Msg: \"unknown key (want enabled or path)\"})\n+\t\t\t}\n+\t\t}\n+\t}\n+\treturn errs\n+}\n+\n func (raw *rawConfig) parseSidecars(n *yaml.Node, file string) Errors {\n \tvar errs Errors\n \tif n.Tag == \"!!null\" {\ndiff --git a/internal/config/render.go b/internal/config/render.go\nindex f6eb1d2..e2abb36 100644\n--- a/internal/config/render.go\n+++ b/internal/config/render.go\n@@ -33,6 +33,7 @@ type resolvedYAML struct {\n \tIntake          intakeYAML             `yaml:\"intake\"`\n \tProtectedPaths  []string               `yaml:\"protected_paths,omitempty\"`\n \tStale           staleYAML              `yaml:\"stale\"`\n+\tRedact          redactYAML             `yaml:\"redact\"`\n \tSidecars        map[string]sidecarYAML `yaml:\"sidecars,omitempty\"`\n \tRoles           []roleYAML             `yaml:\"roles,omitempty\"`\n }\n@@ -55,6 +56,15 @@ type staleYAML struct {\n \tSuppressFor Duration `yaml:\"suppress_for\"`\n }\n \n+type redactYAML struct {\n+\tGitleaks gitleaksYAML `yaml:\"gitleaks\"`\n+}\n+\n+type gitleaksYAML struct {\n+\tEnabled bool   `yaml:\"enabled\"`\n+\tPath    string `yaml:\"path\"`\n+}\n+\n type sidecarYAML struct {\n \tRepo string `yaml:\"repo\"`\n \tRef  string `yaml:\"ref\"`\n@@ -123,6 +133,7 @@ func (r *Resolved) render() resolvedYAML {\n \t\t\tInactiveFor: r.Stale.InactiveFor,\n \t\t\tSuppressFor: r.Stale.SuppressFor,\n \t\t},\n+\t\tRedact:   redactYAML{Gitleaks: gitleaksYAML{Enabled: r.Redact.Gitleaks.Enabled, Path: r.Redact.Gitleaks.Path}},\n \t\tSidecars: map[string]sidecarYAML{},\n \t}\n \tfor name, sc := range r.Sidecars {\ndiff --git a/internal/config/testdata/resolved.golden b/internal/config/testdata/resolved.golden\nindex 0c4d4e7..6204bbd 100644\n--- a/internal/config/testdata/resolved.golden\n+++ b/internal/config/testdata/resolved.golden\n@@ -20,6 +20,10 @@ protected_paths:\n stale:\n   inactive_for: 30d\n   suppress_for: 90d\n+redact:\n+  gitleaks:\n+    enabled: false\n+    path: gitleaks\n sidecars:\n   vpe-specs:\n     repo: acme/specs\ndiff --git a/internal/config/types.go b/internal/config/types.go\nindex 9b23924..e658f17 100644\n--- a/internal/config/types.go\n+++ b/internal/config/types.go\n@@ -50,6 +50,17 @@ type Stale struct {\n \tSuppressFor Duration // default 90d\n }\n \n+// Redact configures optional extra passes of the close-out secret scan.\n+type Redact struct {\n+\tGitleaks Gitleaks\n+}\n+\n+// Gitleaks configures the optional, fail-closed gitleaks pass.\n+type Gitleaks struct {\n+\tEnabled bool   // default false\n+\tPath    string // default \"gitleaks\"; absolute path or a name on PATH\n+}\n+\n // IntakeMode says which human-filed issues may enter triage (decided, #2).\n type IntakeMode string\n \n@@ -154,6 +165,7 @@ type Resolved struct {\n \tIntake         Intake\n \tProtectedPaths []string // merge.protected_paths: \"dir/\" = directory prefix, else doublestar glob; see Protected\n \tStale          Stale\n+\tRedact         Redact\n \tSidecars       map[string]Sidecar\n \tRoles          []Role // sorted by Kind then Name\n }\ndiff --git a/internal/redact/gitleaks.go b/internal/redact/gitleaks.go\nnew file mode 100644\nindex 0000000..80ea446\n--- /dev/null\n+++ b/internal/redact/gitleaks.go\n@@ -0,0 +1,120 @@\n+package redact\n+\n+import (\n+\t\"bytes\"\n+\t\"context\"\n+\t\"encoding/json\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"io\"\n+\t\"os\"\n+\t\"os/exec\"\n+\t\"path/filepath\"\n+\t\"time\"\n+)\n+\n+// DefaultGitleaksTimeout bounds one gitleaks run.\n+const DefaultGitleaksTimeout = 2 * time.Minute\n+\n+// gitleaksLeakExit is the exit code requested for \"leaks found\", so it is\n+// told apart from gitleaks' own error exit (1).\n+const gitleaksLeakExit = 2\n+\n+// GitleaksOptions configure the gitleaks Scanner.\n+type GitleaksOptions struct {\n+\tPath    string        // binary: absolute path or a name on PATH; default \"gitleaks\"\n+\tTimeout time.Duration // default DefaultGitleaksTimeout\n+}\n+\n+type gitleaks struct{ o GitleaksOptions }\n+\n+// Gitleaks returns a Scanner that runs a gitleaks binary over the scanned\n+// bytes (detect --no-git). It fails closed: a missing binary, an error exit,\n+// a timeout or an unreadable report is an error. Findings carry only the\n+// rule, line and column, never the matched text.\n+func Gitleaks(o GitleaksOptions) Scanner {\n+\tif o.Path == \"\" {\n+\t\to.Path = \"gitleaks\"\n+\t}\n+\tif o.Timeout <= 0 {\n+\t\to.Timeout = DefaultGitleaksTimeout\n+\t}\n+\treturn gitleaks{o}\n+}\n+\n+type gitleaksReport struct {\n+\tRuleID      string `json:\"RuleID\"`\n+\tStartLine   int    `json:\"StartLine\"`\n+\tStartColumn int    `json:\"StartColumn\"`\n+}\n+\n+func (g gitleaks) Scan(ctx context.Context, r io.Reader) ([]Finding, error) {\n+\tbin, err := exec.LookPath(g.o.Path)\n+\tif err != nil {\n+\t\treturn nil, fmt.Errorf(\"gitleaks: binary not found: %w\", err)\n+\t}\n+\tdir, err := os.MkdirTemp(\"\", \"ard-gitleaks-*\")\n+\tif err != nil {\n+\t\treturn nil, fmt.Errorf(\"gitleaks: temp dir: %w\", err)\n+\t}\n+\tdefer os.RemoveAll(dir)\n+\tif err := os.Chmod(dir, 0o700); err != nil {\n+\t\treturn nil, fmt.Errorf(\"gitleaks: temp dir: %w\", err)\n+\t}\n+\tsrc := filepath.Join(dir, \"input.log\")\n+\treport := filepath.Join(dir, \"report.json\")\n+\tf, err := os.OpenFile(src, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)\n+\tif err != nil {\n+\t\treturn nil, fmt.Errorf(\"gitleaks: write input: %w\", err)\n+\t}\n+\tif _, err := io.Copy(f, r); err != nil {\n+\t\tf.Close()\n+\t\treturn nil, fmt.Errorf(\"gitleaks: write input: %w\", err)\n+\t}\n+\tif err := f.Close(); err != nil {\n+\t\treturn nil, fmt.Errorf(\"gitleaks: write input: %w\", err)\n+\t}\n+\n+\tctx, cancel := context.WithTimeout(ctx, g.o.Timeout)\n+\tdefer cancel()\n+\tcmd := exec.CommandContext(ctx, bin, \"detect\", \"--no-git\", \"--no-banner\", \"--redact\",\n+\t\t\"--exit-code\", fmt.Sprint(gitleaksLeakExit), \"--source\", src,\n+\t\t\"--report-format\", \"json\", \"--report-path\", report)\n+\tcmd.Dir = dir\n+\tcmd.Env = []string{\"PATH=\" + os.Getenv(\"PATH\"), \"HOME=\" + dir}\n+\t// Output is discarded: it may echo scanned content.\n+\tcmd.Stdout, cmd.Stderr = io.Discard, io.Discard\n+\tcode := 0\n+\tif err := cmd.Run(); err != nil {\n+\t\tvar ee *exec.ExitError\n+\t\tif ctx.Err() != nil {\n+\t\t\treturn nil, fmt.Errorf(\"gitleaks: %w\", ctx.Err())\n+\t\t}\n+\t\tif !errors.As(err, &ee) {\n+\t\t\treturn nil, fmt.Errorf(\"gitleaks: run: %w\", err)\n+\t\t}\n+\t\tcode = ee.ExitCode()\n+\t}\n+\tif code != 0 && code != gitleaksLeakExit {\n+\t\treturn nil, fmt.Errorf(\"gitleaks: exit status %d\", code)\n+\t}\n+\tdata, err := os.ReadFile(report)\n+\tif err != nil {\n+\t\treturn nil, fmt.Errorf(\"gitleaks: read report: %w\", err)\n+\t}\n+\tvar recs []gitleaksReport\n+\tif err := json.Unmarshal(bytes.TrimSpace(data), &recs); err != nil {\n+\t\treturn nil, errors.New(\"gitleaks: report is not valid JSON\")\n+\t}\n+\tif code == 0 && len(recs) > 0 {\n+\t\treturn nil, errors.New(\"gitleaks: report has findings but exit status 0\")\n+\t}\n+\tif code == gitleaksLeakExit && len(recs) == 0 {\n+\t\treturn nil, errors.New(\"gitleaks: leak exit status with an empty report\")\n+\t}\n+\tvar out []Finding\n+\tfor _, rec := range recs {\n+\t\tout = append(out, Finding{Rule: \"gitleaks:\" + rec.RuleID, Line: rec.StartLine, Col: rec.StartColumn})\n+\t}\n+\treturn out, nil\n+}\ndiff --git a/internal/redact/gitleaks_integration_test.go b/internal/redact/gitleaks_integration_test.go\nnew file mode 100644\nindex 0000000..0ad0175\n--- /dev/null\n+++ b/internal/redact/gitleaks_integration_test.go\n@@ -0,0 +1,38 @@\n+package redact\n+\n+import (\n+\t\"context\"\n+\t\"os\"\n+\t\"os/exec\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+// PinnedGitleaksVersion is the gitleaks release the integration test and\n+// production are expected to use.\n+const PinnedGitleaksVersion = \"8.28.0\"\n+\n+// TestGitleaksReal runs the real pinned binary named by ARD_GITLEAKS_BIN.\n+func TestGitleaksReal(t *testing.T) {\n+\tbin := os.Getenv(\"ARD_GITLEAKS_BIN\")\n+\tif bin == \"\" {\n+\t\tt.Skip(\"ARD_GITLEAKS_BIN not set\")\n+\t}\n+\tout, err := exec.Command(bin, \"version\").Output()\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif got := strings.TrimPrefix(strings.TrimSpace(string(out)), \"v\"); got != PinnedGitleaksVersion {\n+\t\tt.Fatalf(\"gitleaks version %q, want pinned %q\", got, PinnedGitleaksVersion)\n+\t}\n+\ts := Gitleaks(GitleaksOptions{Path: bin})\n+\tplanted := \"ok\\ntoken = \" + plantedTokens()[\"aws-access-key\"] + \"\\naws_secret_access_key = \" + randStr(21, 40) + \"\\n\"\n+\tgot, err := s.Scan(context.Background(), strings.NewReader(planted))\n+\tif err != nil || len(got) == 0 {\n+\t\tt.Errorf(\"planted: got %+v, %v; want a finding\", got, err)\n+\t}\n+\tgot, err = s.Scan(context.Background(), strings.NewReader(\"build ok\\nall tests passed\\n\"))\n+\tif err != nil || len(got) != 0 {\n+\t\tt.Errorf(\"plain: got %+v, %v; want clean\", got, err)\n+\t}\n+}\ndiff --git a/internal/redact/gitleaks_test.go b/internal/redact/gitleaks_test.go\nnew file mode 100644\nindex 0000000..5031478\n--- /dev/null\n+++ b/internal/redact/gitleaks_test.go\n@@ -0,0 +1,197 @@\n+package redact\n+\n+import (\n+\t\"bytes\"\n+\t\"context\"\n+\t\"io\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"runtime\"\n+\t\"strings\"\n+\t\"testing\"\n+\t\"time\"\n+)\n+\n+// fakeGitleaks writes a shell script that stands in for gitleaks. body runs\n+// with $report set to the --report-path argument and $src to --source.\n+func fakeGitleaks(t *testing.T, body string) string {\n+\tt.Helper()\n+\tif runtime.GOOS == \"windows\" {\n+\t\tt.Skip(\"shell script fake\")\n+\t}\n+\tscript := `#!/bin/sh\n+all=\"$*\"; report=\"\"; src=\"\"\n+while [ $# -gt 0 ]; do\n+  case \"$1\" in\n+    --report-path) report=\"$2\"; shift;;\n+    --source) src=\"$2\"; shift;;\n+  esac\n+  shift\n+done\n+` + body + \"\\n\"\n+\tp := filepath.Join(t.TempDir(), \"gitleaks\")\n+\tif err := os.WriteFile(p, []byte(script), 0o755); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\treturn p\n+}\n+\n+func scanWith(t *testing.T, path, in string) ([]Finding, error) {\n+\tt.Helper()\n+\treturn Gitleaks(GitleaksOptions{Path: path}).Scan(context.Background(), strings.NewReader(in))\n+}\n+\n+func TestGitleaksHit(t *testing.T) {\n+\tp := fakeGitleaks(t, `echo '[{\"RuleID\":\"aws-access-token\",\"StartLine\":3,\"StartColumn\":7,\"Match\":\"SECRETTEXT\",\"Secret\":\"SECRETTEXT\"}]' > \"$report\"; exit 2`)\n+\tgot, err := scanWith(t, p, \"a\\nb\\nc\\n\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\twant := Finding{Rule: \"gitleaks:aws-access-token\", Line: 3, Col: 7}\n+\tif len(got) != 1 || got[0] != want {\n+\t\tt.Errorf(\"findings = %+v, want [%+v]\", got, want)\n+\t}\n+}\n+\n+func TestGitleaksClean(t *testing.T) {\n+\tp := fakeGitleaks(t, `echo '[]' > \"$report\"; exit 0`)\n+\tgot, err := scanWith(t, p, \"hello\\n\")\n+\tif err != nil || len(got) != 0 {\n+\t\tt.Errorf(\"got %+v, %v; want clean\", got, err)\n+\t}\n+}\n+\n+func TestGitleaksMissingBinary(t *testing.T) {\n+\tgot, err := scanWith(t, filepath.Join(t.TempDir(), \"nope\"), \"x\")\n+\tif err == nil || got != nil {\n+\t\tt.Errorf(\"got %+v, %v; want error\", got, err)\n+\t}\n+}\n+\n+func TestGitleaksErrorExit(t *testing.T) {\n+\tp := fakeGitleaks(t, `echo \"LEAKED-STDERR-TEXT\" >&2; exit 1`)\n+\tgot, err := scanWith(t, p, \"x\")\n+\tif err == nil || got != nil {\n+\t\tt.Fatalf(\"got %+v, %v; want error\", got, err)\n+\t}\n+\tif strings.Contains(err.Error(), \"LEAKED-STDERR-TEXT\") {\n+\t\tt.Errorf(\"error echoes stderr: %v\", err)\n+\t}\n+}\n+\n+func TestGitleaksBadReport(t *testing.T) {\n+\tfor name, body := range map[string]string{\n+\t\t\"garbage with exit 0\":    `echo 'not json' > \"$report\"; exit 0`,\n+\t\t\"empty report, exit 2\":   `echo '[]' > \"$report\"; exit 2`,\n+\t\t\"no report, exit 0\":      `exit 0`,\n+\t\t\"findings with exit 0\":   `echo '[{\"RuleID\":\"x\",\"StartLine\":1,\"StartColumn\":1}]' > \"$report\"; exit 0`,\n+\t\t\"garbage report, exit 2\": `echo '{' > \"$report\"; exit 2`,\n+\t} {\n+\t\tt.Run(name, func(t *testing.T) {\n+\t\t\tgot, err := scanWith(t, fakeGitleaks(t, body), \"x\")\n+\t\t\tif err == nil || got != nil {\n+\t\t\t\tt.Errorf(\"got %+v, %v; want error\", got, err)\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+func TestGitleaksTimeoutAndCancel(t *testing.T) {\n+\tp := fakeGitleaks(t, `sleep 5`)\n+\tstart := time.Now()\n+\t_, err := Gitleaks(GitleaksOptions{Path: p, Timeout: 100 * time.Millisecond}).Scan(context.Background(), strings.NewReader(\"x\"))\n+\tif err == nil {\n+\t\tt.Error(\"timeout: want error\")\n+\t}\n+\tctx, cancel := context.WithCancel(context.Background())\n+\tcancel()\n+\tif _, err := Gitleaks(GitleaksOptions{Path: p}).Scan(ctx, strings.NewReader(\"x\")); err == nil {\n+\t\tt.Error(\"cancelled: want error\")\n+\t}\n+\tif time.Since(start) > 4*time.Second {\n+\t\tt.Error(\"fake was not killed\")\n+\t}\n+}\n+\n+func TestGitleaksArgs(t *testing.T) {\n+\tout := t.TempDir()\n+\tp := fakeGitleaks(t, `echo \"$all\" > `+out+`/argv; cp \"$src\" `+out+`/input; echo \"$src\" > `+out+`/srcpath; echo '[]' > \"$report\"`)\n+\tif _, err := scanWith(t, p, \"redacted bytes\\n\"); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\targv, _ := os.ReadFile(filepath.Join(out, \"argv\"))\n+\tfor _, w := range []string{\"detect\", \"--no-git\", \"--report-format json\"} {\n+\t\tif !strings.Contains(string(argv), w) {\n+\t\t\tt.Errorf(\"argv %q lacks %q\", argv, w)\n+\t\t}\n+\t}\n+\tin, _ := os.ReadFile(filepath.Join(out, \"input\"))\n+\tif !bytes.Equal(in, []byte(\"redacted bytes\\n\")) {\n+\t\tt.Errorf(\"input = %q\", in)\n+\t}\n+\tsrc, _ := os.ReadFile(filepath.Join(out, \"srcpath\"))\n+\tif _, err := os.Stat(filepath.Dir(strings.TrimSpace(string(src)))); !os.IsNotExist(err) {\n+\t\tt.Errorf(\"temp dir left behind: %v\", err)\n+\t}\n+}\n+\n+type fixedScanner struct {\n+\tf   []Finding\n+\terr error\n+}\n+\n+func (s fixedScanner) Scan(context.Context, io.Reader) ([]Finding, error) { return s.f, s.err }\n+\n+func TestMulti(t *testing.T) {\n+\thit := Finding{Rule: \"builtin\", Line: 1, Col: 1}\n+\tgot, err := Multi(fixedScanner{f: []Finding{hit}}, fixedScanner{}).Scan(context.Background(), strings.NewReader(\"x\"))\n+\tif err != nil || len(got) != 1 || got[0] != hit {\n+\t\tt.Errorf(\"got %+v, %v\", got, err)\n+\t}\n+\tfor _, ss := range [][]Scanner{\n+\t\t{fixedScanner{f: []Finding{hit}}, fixedScanner{err: os.ErrInvalid}},\n+\t\t{fixedScanner{err: os.ErrInvalid}, fixedScanner{}},\n+\t} {\n+\t\tgot, err := Multi(ss...).Scan(context.Background(), strings.NewReader(\"x\"))\n+\t\tif err == nil || got != nil {\n+\t\t\tt.Errorf(\"got %+v, %v; want error\", got, err)\n+\t\t}\n+\t}\n+}\n+\n+func TestLogWithGitleaks(t *testing.T) {\n+\twrite := func(t *testing.T) (string, string) {\n+\t\td := t.TempDir()\n+\t\tsrc := filepath.Join(d, \"in.log\")\n+\t\tif err := os.WriteFile(src, []byte(\"plain log\\n\"), 0o600); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\treturn src, filepath.Join(d, \"out.log\")\n+\t}\n+\tt.Run(\"hit\", func(t *testing.T) {\n+\t\tp := fakeGitleaks(t, `echo '[{\"RuleID\":\"r\",\"StartLine\":1,\"StartColumn\":1}]' > \"$report\"; exit 2`)\n+\t\tr, err := New(nil, Options{Scanner: Multi(Builtin(), Gitleaks(GitleaksOptions{Path: p}))})\n+\t\tif err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tsrc, dst := write(t)\n+\t\tres, err := r.Log(context.Background(), src, dst)\n+\t\tif err != nil || !res.Flagged || res.Clean != nil {\n+\t\t\tt.Errorf(\"res = %+v, err = %v; want flagged\", res, err)\n+\t\t}\n+\t})\n+\tt.Run(\"error\", func(t *testing.T) {\n+\t\tp := fakeGitleaks(t, `exit 1`)\n+\t\tr, err := New(nil, Options{Scanner: Multi(Builtin(), Gitleaks(GitleaksOptions{Path: p}))})\n+\t\tif err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tsrc, dst := write(t)\n+\t\tif _, err := r.Log(context.Background(), src, dst); err == nil {\n+\t\t\tt.Error(\"want error\")\n+\t\t}\n+\t\tif ents, _ := os.ReadDir(filepath.Dir(dst)); len(ents) != 1 {\n+\t\t\tt.Errorf(\"leftover files: %v\", ents)\n+\t\t}\n+\t})\n+}\ndiff --git a/internal/redact/multi.go b/internal/redact/multi.go\nnew file mode 100644\nindex 0000000..6cd793e\n--- /dev/null\n+++ b/internal/redact/multi.go\n@@ -0,0 +1,52 @@\n+package redact\n+\n+import (\n+\t\"bytes\"\n+\t\"context\"\n+\t\"fmt\"\n+\t\"io\"\n+)\n+\n+type multi []Scanner\n+\n+// Multi returns a Scanner that runs each scanner in order over the same\n+// bytes and concatenates their findings. The first error fails the scan and\n+// no findings are returned.\n+func Multi(scanners ...Scanner) Scanner { return multi(scanners) }\n+\n+func (m multi) Scan(ctx context.Context, r io.Reader) ([]Finding, error) {\n+\tif len(m) == 0 {\n+\t\treturn nil, nil\n+\t}\n+\tif len(m) == 1 {\n+\t\treturn m[0].Scan(ctx, r)\n+\t}\n+\t// Each scanner needs the whole input: rewind a seekable reader, else\n+\t// hold the bytes in memory.\n+\tvar open func() (io.Reader, error)\n+\tif rs, ok := r.(io.ReadSeeker); ok {\n+\t\topen = func() (io.Reader, error) { _, err := rs.Seek(0, io.SeekStart); return rs, err }\n+\t} else {\n+\t\tdata, err := io.ReadAll(r)\n+\t\tif err != nil {\n+\t\t\treturn nil, fmt.Errorf(\"scan: %w\", err)\n+\t\t}\n+\t\topen = func() (io.Reader, error) { return bytes.NewReader(data), nil }\n+\t}\n+\tvar out []Finding\n+\tfor _, s := range m {\n+\t\tif err := ctx.Err(); err != nil {\n+\t\t\treturn nil, fmt.Errorf(\"scan: %w\", err)\n+\t\t}\n+\t\tin, err := open()\n+\t\tif err != nil {\n+\t\t\treturn nil, fmt.Errorf(\"scan: %w\", err)\n+\t\t}\n+\t\tf, err := s.Scan(ctx, in)\n+\t\tif err != nil {\n+\t\t\treturn nil, err\n+\t\t}\n+\t\tout = append(out, f...)\n+\t}\n+\treturn out, nil\n+}\ndiff --git a/internal/servecmd/reaping.go b/internal/servecmd/reaping.go\nindex 4295467..6ebf924 100644\n--- a/internal/servecmd/reaping.go\n+++ b/internal/servecmd/reaping.go\n@@ -18,6 +18,7 @@ import (\n \t\"github.com/albertcbrown/ard/internal/limits\"\n \t\"github.com/albertcbrown/ard/internal/pool\"\n \t\"github.com/albertcbrown/ard/internal/reaper\"\n+\t\"github.com/albertcbrown/ard/internal/redact\"\n \t\"github.com/albertcbrown/ard/internal/state\"\n )\n \n@@ -32,6 +33,16 @@ func (c cfgRoles) Role(k config.Kind, name string) (config.Role, bool) {\n \treturn cfg.Role(k, name)\n }\n \n+// gitleaksOptions reports whether the optional gitleaks pass is enabled in the\n+// latest loaded config, and which binary to run.\n+func (w *wiring) gitleaksOptions() (redact.GitleaksOptions, bool) {\n+\tcfg := w.cfg.Load()\n+\tif cfg == nil || !cfg.Redact.Gitleaks.Enabled {\n+\t\treturn redact.GitleaksOptions{}, false\n+\t}\n+\treturn redact.GitleaksOptions{Path: cfg.Redact.Gitleaks.Path}, true\n+}\n+\n // closer returns the one *closeout.Closer of this process. The triage, worker\n // and reviewer loops and the Reaper share it: its per-job busy lock only\n // serialises close-outs within one instance.\n@@ -50,7 +61,7 @@ func (w *wiring) closer() *closeout.Closer {\n \t\tRoles: cfgRoles{w},\n \t\t// The job's model credentials are in the controller's environment.\n \t\t// Host paths are replaced by placeholders in the same pass.\n-\t\tNewRedactor: closeout.JobRedactor(os.Environ, w.hostPaths()),\n+\t\tNewRedactor: closeout.JobRedactor(os.Environ, w.hostPaths(), w.gitleaksOptions),\n \t\t// Job worktrees belong to the agent: git runs in the controller's own\n \t\t// clone (w.Root) and never trusts a worktree's .git, index or config.\n \t\tChanged: func(ctx context.Context, worktree, base string, paths ...string) ([]gitx.PathChange, error) {\n","numLines":875,"startLine":1,"totalLines":875}},"tool_result_meta":[{"id":"toolu_01NcpbSu3PzwH7hLokAFMb8M","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
