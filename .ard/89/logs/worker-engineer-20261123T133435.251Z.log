ine\":1,\"StartColumn\":1}]' > \"$report\"; exit 2`)\n\t\tr, err := New(nil, Options{Scanner: Multi(Builtin(), Gitleaks(GitleaksOptions{Path: p}))})\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tsrc, dst := write(t)\n\t\tres, err := r.Log(context.Background(), src, dst)\n\t\tif err != nil || !res.Flagged || res.Clean != nil {\n\t\t\tt.Errorf(\"res = %+v, err = %v; want flagged\", res, err)\n\t\t}\n\t})\n\tt.Run(\"error\", func(t *testing.T) {\n\t\tp := fakeGitleaks(t, `exit 1`)\n\t\tr, err := New(nil, Options{Scanner: Multi(Builtin(), Gitleaks(GitleaksOptions{Path: p}))})\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tsrc, dst := write(t)\n\t\tif _, err := r.Log(context.Background(), src, dst); err == nil {\n\t\t\tt.Error(\"want error\")\n\t\t}\n\t\tif ents, _ := os.ReadDir(filepath.Dir(dst)); len(ents) != 1 {\n\t\t\tt.Errorf(\"leftover files: %v\", ents)\n\t\t}\n\t})\n}\nE\nsed -i 's/io_Reader/io.Reader/; s/^\t\"context\"$/\t\"context\"\\n\t\"io\"/' gitleaks_test.go\ncat > gitleaks_integration_test.go <<'E'\npackage redact\n\nimport (\n\t\"context\"\n\t\"os\"\n\t\"os/exec\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// PinnedGitleaksVersion is the gitleaks release the integration test and\n// production are expected to use.\nconst PinnedGitleaksVersion = \"8.28.0\"\n\n// TestGitleaksReal runs the real pinned binary named by ARD_GITLEAKS_BIN.\nfunc TestGitleaksReal(t *testing.T) {\n\tbin := os.Getenv(\"ARD_GITLEAKS_BIN\")\n\tif bin == \"\" {\n\t\tt.Skip(\"ARD_GITLEAKS_BIN not set\")\n\t}\n\tout, err := exec.Command(bin, \"version\").Output()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif got := strings.TrimPrefix(strings.TrimSpace(string(out)), \"v\"); got != PinnedGitleaksVersion {\n\t\tt.Fatalf(\"gitleaks version %q, want pinned %q\", got, PinnedGitleaksVersion)\n\t}\n\ts := Gitleaks(GitleaksOptions{Path: bin})\n\tplanted := \"ok\\ntoken = \" + plantedTokens()[\"aws-access-key\"] + \"\\naws_secret_access_key = \" + randStr(21, 40) + \"\\n\"\n\tgot, err := s