{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H9FMvpGcs476w3VXL9G18A","type":"tool_result","content":"\tTriage    Duration // default 15m\n\tWorkers   Duration // default 5m\n\tReviewers Duration // default 5m\n\tMerger    Duration // default 5m\n}\n\n// Stale configures the built-in stale-issue closer (#25); the schema lives\n// here so config files can carry it before that issue lands.\ntype Stale struct {\n\tInactiveFor Duration // default 30d\n\tSuppressFor Duration // default 90d\n}\n\n// IntakeMode says which human-filed issues may enter triage (decided, #2).\ntype IntakeMode string\n\nconst (\n\tIntakeAll   IntakeMode = \"all\"   // every human-filed issue\n\tIntakeLabel IntakeMode = \"label\" // only issues an authorised actor labelled\n)\n\n\tExecutor        string  // \"local\" or \"k8s\"\n\tAgent           string  // default agent CLI\n\tRequireApproval bool    // default true\n\tBudgetUSDPerDay float64 // whole-repo daily cap; default 50\n\tMaxBudgetUSD    float64 // default per-job cap; default 5\n\tGlobalMaxOpen   int     // open scanner issues across all scanners; default 30\n\tPaused          bool\n\n\tIntervals      Intervals\n\tIntake         Intake\n\tProtectedPaths []string // merge.protected_paths: \"dir/\" = directory prefix, else doublestar glob; see Protected\n\tStale          Stale\n\tSidecars       map[string]Sidecar\n\tRoles          []Role // sorted by Kind then Name\n}\n\n// Role returns the role of the given kind and name.\nfunc (r *Resolved) Role(k Kind, name string) (Role, bool) {\n\tfor _, role := range r.Roles {\n\t\tif role.Kind == k && role.Name == name {\n\t\t\treturn role, true\n\t\tMaxBudgetUSD:    defaultMaxBudgetUSD,\n\t\tGlobalMaxOpen:   defaultGlobalMaxOpen,\n\t\tIntervals: Intervals{\n\t\t\tScanners:  defaultIntervalScanners,\n\t\t\tTriage:    defaultIntervalTriage,\n\t\t\tWorkers:   defaultIntervalWorkers,\n\t\t\tReviewers: defaultIntervalReviewers,\n\t\t\tMerger:    defaultIntervalMerger,\n\t\t},\n\t\tIntake: Intake{Mode: defaultIntakeMode},\n\t\tStale: Stale{\n\t\t\tInactiveFor: defaultStaleInactiveFor,\n\t\t\tSuppressFor: defaultStaleSuppressFor,\n\t\t},\n\t\tSidecars: map[string]Sidecar{},\n\t}\n}\n\n// applyGlobals merges the raw global config into res, collecting errors.\n// Called once per load, after parseConfigFile and before roles are built.\nfunc applyGlobals(res *Resolved, raw rawConfig, cfgPath string) Errors {\n\t\tfor i, p := range raw.protectedPaths {\n\t\t\tnorm, err := normaliseProtectedPath(p)\n\t\t\tif err != nil {\n\t\t\t\terrs = append(errs, &Error{File: cfgPath, Key: fmt.Sprintf(\"merge.protected_paths[%d]\", i), Msg: err.Error()})\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tres.ProtectedPaths = append(res.ProtectedPaths, norm)\n\t\t}\n\t}\n\n\tif raw.stale.inactiveFor != nil {\n\t\tres.Stale.InactiveFor = *raw.stale.inactiveFor\n\t}\n\tif raw.stale.suppressFor != nil {\n\t\tres.Stale.SuppressFor = *raw.stale.suppressFor\n\t}\n\n\tfor name, sc := range raw.sidecars {\n\t\tkey := \"sidecars.\" + name\n\t\tif name == \"\" || strings.ContainsAny(name, \"/ \\t\") {\n\t\t\terrs = append(errs, &Error{File: cfgPath, Key: key, Msg: \"sidecar name must be a simple key\"})\n\tagent           *string\n\trequireApproval *bool\n\tbudgetUSDPerDay *float64\n\tmaxBudgetUSD    *float64\n\tglobalMaxOpen   *int\n\tpaused          *bool\n\tintervals       rawIntervals\n\tintake          rawIntake\n\tprotectedPaths  []string // merge.protected_paths\n\thaveMerge       bool\n\tstale           rawStale\n\thaveStale       bool\n\tsidecars        map[string]rawSidecar\n\toverrides       []rawOverrideRef\n}\n\n// rawIntervals keeps every interval optional so defaults can tell \"unset\"\n// apart from an explicit value.\ntype rawIntervals struct {\n\tscanners, triage, workers, reviewers, merger *Duration\n}\n\n// rawIntake keeps both keys optional so defaults can tell \"unset\" apart\n// from an explicit value (an explicit empty label is an error).\ntype rawIntake struct {\n\tmode, label *string\n}\n\ntype rawStale struct {\n\tinactiveFor, suppressFor *Duration\n}\n\ntype rawSidecar struct {\n\trepo *string\n\tref  *string\n}\n\n// rawOverrideRef is one overrides entry kept as its YAML node; entries are\n// validated and merged once the role directories are known.\ntype rawOverrideRef struct {\n\tkey   string // \"scanners/cve\"\n\t\tcase \"budget_usd_per_day\":\n\t\t\terrs = append(errs, decodeValue(value, cfgPath, name, &raw.budgetUSDPerDay)...)\n\t\tcase \"max_budget_usd\":\n\t\t\terrs = append(errs, decodeValue(value, cfgPath, name, &raw.maxBudgetUSD)...)\n\t\tcase \"global_max_open\":\n\t\t\terrs = append(errs, decodeValue(value, cfgPath, name, &raw.globalMaxOpen)...)\n\t\tcase \"paused\":\n\t\t\terrs = append(errs, decodeValue(value, cfgPath, name, &raw.paused)...)\n\t\tcase \"intervals\":\n\t\t\terrs = append(errs, raw.intervals.parse(value, cfgPath, \"intervals\")...)\n\t\tcase \"intake\":\n\t\t\terrs = append(errs, raw.parseIntake(value, cfgPath)...)\n\t\tcase \"merge\":\n\t\t\terrs = append(errs, raw.parseMerge(value, cfgPath)...)\n\t\tcase \"stale\":\n\t\t\terrs = append(errs, raw.parseStale(value, cfgPath)...)\n\t\tcase \"sidecars\":\n\t\t\terrs = append(errs, raw.parseSidecars(value, cfgPath)...)\n\t\tcase \"overrides\":\n\t\t\terrs = append(errs, raw.parseOverrides(value, cfgPath)...)\n\t\tdefault:\n\t\t\terrs = append(errs, &Error{File: cfgPath, Key: name, Msg: \"unknown key\"})\n\t\t}\n\t}\n\treturn raw, errs\n}\n\t\t\terrs = append(errs, &Error{File: file, Key: \"intake.\" + key.Value, Msg: \"unknown key (want mode or label)\"})\n\t\t}\n\t}\n\treturn errs\n}\n\nfunc (raw *rawConfig) parseStale(n *yaml.Node, file string) Errors {\n\traw.haveStale = true\n\tvar errs Errors\n\tif n.Tag == \"!!null\" {\n\t\treturn nil\n\t}\n\tif n.Kind != yaml.MappingNode {\n\t\treturn Errors{{File: file, Key: \"stale\", Msg: \"must be a mapping\"}}\n\t}\n\tfor i := 0; i < len(n.Content); i += 2 {\n\t\tkey, value := n.Content[i], n.