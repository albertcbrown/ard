= e.labels(7); l[\"ard:needs-human\"] != c.flagged {\n\t\t\t\tt.Errorf(\"needs-human = %v, want %v (labels %v)\", l[\"ard:needs-human\"], c.flagged, l)\n\t\t\t}\n\t\t})\n\t}\n\t// Enabled but the binary is missing: fail closed.\n\te := newEnv(t)\n\tmissing := filepath.Join(t.TempDir(), \"nope\")\n\te.d.NewRedactor = JobRedactor(func() []string { return nil }, HostPaths{}, func() (redact.GitleaksOptions, bool) {\n\t\treturn redact.GitleaksOptions{Path: missing}, true\n\t})\n\te.write(\".ard/7/triage-lead.md\", roleFile(\"lead\", \"done\"))\n\tj := e.claim(StageTriage, \"lead\")\n\tif err := os.WriteFile(j.LogPath, []byte(\"plain log\\n\"), 0o600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err := New(e.d).Run(context.Background(), j); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif l := e.labels(7); !l[\"ard:needs-human\"] || l[\"ard:triage:lead:done\"] {\n\t\tt.Errorf(\"labels = %v\", l)\n\t}\n}\nE\ngo test ./internal/closeout ./internal/servecmd ./internal/config ./internal/redact 2>&1 | grep -v INFO | tail -20; grep -n \"Guardrails\\|All agent output is committed\" docs/proposal.md | head"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":878,"cache_read_input_tokens":50604,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":878},"output_tokens":45,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e9d6c479-cc3e-4248-8d96-c556a2a58c6d","uuid":"b058e647-99e5-4394-8899-dbfc9c2023fe","timestamp":"2026-11-23T13:36:30.325Z","request_id":"req_011ChKx1SUDagpoeViHCwCzz"}
