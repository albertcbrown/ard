{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YKTPoxyNgv4uPdZU88BT4s","type":"tool_result","content":"87:// When gates a reviewer: a nil When means the reviewer runs on every PR.\n89:type When struct {\n130:\tWhen *When\n57:\twhen                         *rawWhen\n61:type rawWhen struct {\n77:\tKindReviewer: {\"when\": true},\n274:\t\tcase \"when\":\n275:\t\t\tw, whenErrs := parseWhen(value, cfgPath, fkey)\n276:\t\t\terrs = append(errs, whenErrs...)\n278:\t\t\t\tov.when = &w\n310:func parseWhen(n *yaml.Node, cfgPath, keyRef string) (rawWhen, Errors) {\n311:\tvar w rawWhen\n405:\tif ov.when != nil {\n406:\t\twhen := &When{Triage: ov.when.triage}\n407:\t\tfor i, p := range ov.when.paths {\n410:\t\t\t\t*errs = append(*errs, &Error{File: cfgPath, Key: fmt.Sprintf(\"%s.when.paths[%d]\", keyRef, i), Msg: err.Error()})\n413:\t\t\twhen.Paths = append(when.Paths, norm)\n415:\t\tfor _, dep := range ov.when.triage {\n417:\t\t\t\t*errs = append(*errs, &Error{File: cfgPath, Key: keyRef + \".when.triage\", Msg: fmt.Sprintf(\"no such triage role %q\", dep)})\n420:\t\trole.When = when\npackage config\n\nimport (\n\t\"fmt\"\n\t\"path\"\n\t\"strings\"\n\t\"unicode\"\n\n\t\"github.com/bmatcuk/doublestar/v4\"\n)\n\n// normaliseProtectedPath validates one merge.protected_paths entry and\n// returns its canonical form. An entry ending in \"/\" is a literal directory\n// prefix and keeps exactly one trailing \"/\"; any other entry is a doublestar\n// glob, path-cleaned.\nfunc normaliseProtectedPath(p string) (string, error) {\n\tif strings.TrimSpace(p) != p || strings.IndexFunc(p, badRune) >= 0 {\n\t\treturn \"\", fmt.Errorf(\"path %q has leading/trailing whitespace or control characters\", p)\n\t}\n\tprefix := strings.HasSuffix(p, \"/\")\n\tclean, err := normaliseRelPath(p)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tif clean == \".\" {\n\t\treturn \"\", fmt.Errorf(\"path %q names the whole repo; use %q to protect everything\", p, \"**\")\n\t}\n\tif prefix {\n\t\tif strings.ContainsAny(clean, \"*?[{\\\\\") {\n\t\t\treturn \"\", fmt.Errorf(\"prefix %q contains glob characters; write it as a glob such as %q\", p, clean+\"/**\")\n\t\t}\n\t\treturn clean + \"/\", nil\n\t}\n\tif !doublestar.ValidatePattern(clean) {\n\t\treturn \"\", fmt.Errorf(\"invalid glob %q\", p)\n\t}\n\treturn clean, nil\n}\n\n// Protected reports whether the repo-relative, slash-separated path p is\n// covered by merge.protected_paths. The merger must call it for every\n// changed file's path and, for a rename, its previous path too.\nfunc (r *Resolved) Protected(p string) bool {\n\t_, ok := r.ProtectedBy(p)\n\treturn ok\n}\n\n// ProtectedBy is Protected plus the entry that matched (first in config\n// order). A malformed p (empty, absolute, or escaping the repo after\n// path.Clean) is reported as protected with pattern \"\": the check fails\n// closed.\n//\n// Matching is case-insensitive (macOS file systems are, so `Claude.md` is `CLAUDE.md`) and anchored at the repo root. An entry ending\n// in \"/\" matches that directory (and the bare name, in case a file or\n// submodule replaces it) on a directory boundary; any other entry is a\n// doublestar glob where \"*\" stays within one segment and \"**\" crosses them.\nfunc (r *Resolved) ProtectedBy(p string) (pattern string, ok bool) {\n\tif p == \"\" || strings.HasPrefix(p, \"/\") {\n\t\treturn \"\", true\n\t}\n\t// GitHub only reports canonical paths; anything else is malformed.\n\tif path.Clean(p) != p || strings.Contains(p, \"\\\\\") || strings.IndexFunc(p, unicode.IsControl) >= 0 {\n\t\treturn \"\", true\n\t}\n\tif p == \".\" || p == \"..\" || strings.HasPrefix(p, \"../\") {\n\t\treturn \"\", true\n\t}\n\tfor _, e := range r.ProtectedPaths {\n\t\tif matchProtected(e, p) {\n\t\t\treturn e, true\n\t\t}\n\t}\n\treturn \"\", false\n}\n\n// matchProtected matches one canonical entry against a cleaned path.\nfunc matchProtected(entry, q string) bool {\n\tentry, q = strings.ToLower(entry), strings.ToLower(q)\n\tif strings.HasSuffix(entry, \"/\") {\n\t\treturn strings.HasPrefix(q, entry) || q == strings.TrimSuffix(entry, \"/\")\n681:// reviewers lists the reviewer roles to request on the PR: the role's\n682:// reviewers, or every reviewer role when none are set, then the reviewers\n684:func (jb *job) reviewers(ctx context.Context) []string {\n686:\tif len(jb.role.Reviewers) > 0 {\n687:\t\tnames = append(names, jb.role.Reviewers...)\n718:\tres.Reviewers = jb.reviewers(ctx)\n749:\tjb.log.Info(\"worker.pr\", \"pr\", pr.Number, \"tests\", string(res.Tests), \"reviewers\", len(res.Reviewers))\n     825 internal/worker/run.go","is_error":false}]},"parent_tool_use_id":null,"session_id":"0f5885f6-4319-4aab-8f24-9f470a446d4a","uuid":"a5fbd3aa-7e3e-4341-9020-07db9fd4cee7","timestamp":"2026-11-23T15:34:50.472Z","tool_use_result":{"stdout":"87:// When gates a reviewer: a nil When means the reviewer runs on every PR.\n89:type When struct {\n130:\tWhen *When\n57:\twhen                         *rawWhen\n61:type rawWhen struct {\n77:\tKindReviewer: {\"when\": true},\n274:\t\tcase \"when\":\n275:\t\t\tw, whenErrs := parseWhen(value, cfgPath, fkey)\n276:\t\t\terrs = append(errs, whenErrs...)\n278:\t\t\t\tov.when = &w\n310:func parseWhen(n *yaml.Node, cfgPath, keyRef string) (rawWhen, Errors) {\n311:\tvar w rawWhen\n405:\tif ov.when != nil {\n406:\t\twhen := &When{Triage: ov.when.triage}\n407:\t\tfor i, p := range ov.when.paths {\n410:\t\t\t\t*errs = append(*errs, &Error{File: cfgPath, Key: fmt.Sprintf(\"%s.when.paths[%d]\", keyRef, i), Msg: err.Error()})\n413:\t\t\twhen.Paths = append(when.Paths, norm)\n415:\t\tfor _, dep := range ov.when.triage {\n417:\t\t\t\t*errs = append(*errs, &Error{File: cfgPath, Key: keyRef + \".when.triage\", Msg: fmt.Sprintf(\"no such triage role %q\", dep)})\n420:\t\trole.When = when\npackage config\n\nimport (\n\t\"fmt\"\n\t\"path\"\n\t\"strings\"\n\t\"unicode\"\n\n\t\"github.com/bmatcuk/doublestar/v4\"\n)\n\n// normaliseProtectedPath validates one me