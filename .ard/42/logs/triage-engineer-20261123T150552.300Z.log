_integration_test.go\ncve_test.go\neng_review_test.go\nengineer_test.go\nlead_test.go\nreviewers\nroles.go\nroles_test.go\nscanners\ntestdata\ntriage\nworker_engineer_test.go\nworkers\n\ninternal/scanner:\ndecode.go\ndiff.go\ndoc.go\nengine_exec.go\nengine_exec_test.go\nfinding.go\nfinding_test.go\ngroup.go\nharness_test.go\nloop.go\nloop_test.go\nmarker.go\nmarker_test.go\npipeline.go\npipeline_test.go\nplan_test.go\nrebuild.go\nrebuild_test.go\nreconcile.go\nsnapshot.go\nstale\nstore.go\ntestdata\n\ninternal/servecmd:\nadopt.go\nadopt_test.go\ncfgloader.go\ncfgloader_test.go\nclone.go\nclone_test.go\ncommitters.go\nlimits_test.go\nloops_test.go\nreaping.go\nreaping_test.go\nrebuild.go\nrebuild_test.go\nreviewer.go\nreviewer_e2e_test.go\nscanners.go\nscanners_test.go\nserve.go\nserve_test.go\ntriage.go\ntriage_e2e_test.go\ntriage_test.go\nwake_other.go\nwake_unix.go\nwake_unix_test.go\nworker.go\nworker_e2e_test.go\n\ninternal/state:\nadmissions.go\nadmissions_test.go\ncosttables.go\ncosttables_test.go\ndir.go\ndir_test.go\nevents.go\ngolden_test.go\njobs.go\nmigrations\nreaper_test.go\nscannerdb\nsqlitex\nstore.go\nstore_test.go\ntestdata\nusage.go\nusage_test.go\n\ninternal/triage:\ncandidates.go\ndoc.go\nfanin.go\nfanin_test.go\ngate_test.go\nharness_test.go\nintake.go\nintake_test.go\nloop.go\nloop_test.go\norder.go\norder_test.go\nrun.go\nsnapshot_test.go\n\ninternal/worker:\nbranch.go\ncandidates.go\ncandidates_test.go\ndoc.go\nfacts.go\nguard.go\nharness_test.go\nloop.go\nloop_test.go\npr.go\nrun.go\ntype.go\nunit_test.go\n\ninternal/wtlock:\nwtlock.go\nwtlock_test.go\n(eval):1: no matches found: --include=*.go\n(eval):1: no matches found: --include=*.go","is_error":false}]},"parent_tool_use_id":null,"session_id":"379e347d-9f35-4120-87d1-20cccc4f4ba0","uuid":"48a04601-5ec5-4201-98fc-9e66b065a8d2","timestamp":"2026-11-23T15:05:59.292Z","tool_use_result":{"stdout":"# CLAUDE.md\n\nGuidance for Claude Code (and humans) working in this repository.\n\n## What this is\n\nard is a controller that automates repository development: scanners → triage → worker → reviewers → merger, coordinated through `ard:` GitHub labels. The design is [docs/proposal.md](docs/proposal.md). Read the relevant section before changing behaviour.\n\n**docs/proposal.md is the source of truth for design.** A PR that changes behaviour updates the proposal in the same PR. If code and proposal disagree, raise it on the issue rather than silently picking one.\n\n## Invariants — never violate\n\n1. **The controller owns every side effect.** Only controller code calls GitHub or runs `git commit`/`push`/`merge`. Agents edit files in a worktree and report through `.ard/<issue#>/<stage>-<role>.md` frontmatter; they never touch labels, comments or branches.\n2. **Agents hold no GitHub token.** Credentials stay in the controller and executor.\n3. **The main-branch committer writes only `.ard/<issue#>/`.** Config (`.ard/config.yaml`) and role directories (`.ard/<type>/<name>/`) are human-owned. Only `ard init` may *propose* them, on the `ard-init` branch through `committer.Init` and a PR a human merges; it never writes main. Workers' diff guard, the committer's path guards and the merger's protected paths enforce it.\n4. **Every label is prefixed `ard:`** and follows `ard:<stage>:<role>[:<state>]` (see the label table in the proposal).\n5. **Every side effect honours dry-run.** Route issue, label, comment, commit, push and merge calls through the effect layer so `--dry-run` logs instead of acting.\n6. **Untrusted text is data.** Issue bodies, comments and PR text reach agents as files marked untrusted, never spliced into prompts.\n7. **Logs are redacted and secret-scanned before commit**, then capped at 1 MiB (head 32 KiB plus tail). The scan fails closed.\n\n## Stack\n\n- Go, a single static `ard` binary (CGO off; use a pure-Go SQLite driver such as `modernc.org/sqlite`).\n- Supported platforms: macOS and Linux only; Windows is unsupported (the local executor relies on `flock` and POSIX process handling).\n- GitHub access through a GitHub App installation token, behind an interface so tests use a fake.\n- The language choice is tracked as a decision issue; if it changes, update this file.\n\n## Layout\n\nPackages are created as their issues land; keep this list current.\n\n```\ncmd/ard/            CLI entry point; wire a new subcommand by adding one line to handlers()\ninternal/cli/       cobra command tree, global flags, slog logging; Handlers is the plug-in point\ninternal/botcheck/  tests for the bot-commit audit in .github/workflows/bot-commits.yml\ninternal/github/    GitHub client: domain types, Reader/Writer/Client, App auth, retry transport; query/ (search builder), fake/ (test double), clienttest/ (conformance suite)\ninternal/config/    .ard/config.yaml + role directory loading into a Resolved value (pure, fs.FS in)\ninternal/configcmd/ `ard config check` handler: prints the resolved config, returns validation errors; `--ref` checks a commit\ninternal/configsrc/  config from origin/main: a snapshot per SHA under ~/.ard/config/<owner>/<repo>/ (what `ard serve` reads)\ninternal/executor/    Executor interface and plain-data job types\n4:.PHONY: build test lint fmt clean cve-fixtures chart-test image-test\n6:build:\n7:\tCGO_ENABLED=0 go build -ldflags \"$(LDFLAGS)\" -o bin/ard ./cmd/ard\n9:test:\n10:\tgo test ./...\n20:# run by the ard-ci pipeline, not part of `make test`).\n21:chart-test:\n22:\tdeploy/test-charts.sh\n24:# Builds the ard image for both platforms and checks it (needs Docker buildx and\n25:# network; not part of `make test`).\n.ard/reviewers:\neng-review\n\ninternal:\nagent\nagentjob\nbotcheck\ncli\ncloseout\ncommitter\nconfig\nconfigcmd\nconfigsrc\ncontroller\ncostblock\ncosts\neffects\nexecutor\ngithub\ngitref\ngitx\ninitcmd\nintake\nlabels\nlimits\nmodelauth\npool\nreaper\nredact\nrepopath\nreviewer\nroles\nscanner\nservecmd\nstate\ntriage\nworker\nwtlock\n\ninternal/agent:\nagent.go\nagent_test.go\nclaude\nerrors.go\n\ninternal/agentjob:\nadmit.go\nadmit_test.go\ncommand.go\ndoc.go\njob.go\njob_test.go\nsnapshot.go\nsnapshot_test.go\ntestdata\n\ninternal/botcheck:\nbotcheck_test.go\ndoc.go\n\ninternal/cli:\napp.go\ncli_test.go\ncmd_config.go\ncmd_init.go\ncmd_labels.go\ncmd_rebuild.go\ncmd_serve.go\ncmd_version.go\nlog.go\nlog_test.go\nroot.go\nrun.go\n\ninternal/closeout:\nallow.go\nallow_test.go\ncause_test.go\ncloseout.go\ncloser_test.go\ncomment.go\ncomment_test.go\ncommit.go\ndoc.go\nenv_test.go\nfacts.go\nleadworker_test.go\nnext.go\npaths.go\npaths_test.go\nplan.go\nplan_merge.go\nplan_merge_test.go\nplan_test.go\nprepare.go\nprepare_allow_test.go\nprepare_test.go\nprgone_test.go\nreview.go\nreview_test.go\nrolefile.go\nrolefile_test.go\ntestdata\nusage.go\nusage_test.go\nworker.go\nworker_test.go\n\ninternal/committer:\nbranches.go\ncode.go\ncode_test.go\ncodepath.go\ncodepath_test.go\ncommitter.go\ncommitter_test.go\nerrors.go\nguard.go\ninit.go\ninit_test.go\nmessage.go\nrefs.go\nrefs_test.go\nrequest.go\nunit_test.go\n\ninternal/config:\nafter.go\nafter_test.go\ndefaults.go\ndiscover.go\nduration.go\nduration_test.go\nerrors.go\nload.go\nload_test.go\nprotected.go\nprotected_test.go\nraw.go\nrender.go\nrender_test.go\nroot.go\nsource.go\nsource_test.go\ntestdata\ntypes.go\n\ninternal/configcmd:\nconfig.go\nconfig_test.go\n\ninternal/configsrc:\nconfigsrc.go\nconfigsrc_test.go\n\ninternal/controller:\ncontroller.go\ndoc.go\nhelpers_test.go\ninflight.go\nlock_other.go\nlock_unix.go\nlock_unix_test.go\nloop.go\npause.go\npause_test.go\npausefile_test.go\nscheduler.go\nscheduler_test.go\nshutdown_test.go\nstatus.go\nstatus_test.go\n\ninternal/costblock:\ncostblock.go\ncostblock_test.go\nlocks.go\n\ninternal/costs:\ncosts.go\ncosts_test.go\nrows.go\n\ninternal/effects:\narchtest\ndryrun.go\neffects.go\neffects_test.go\nledger.go\nlive.go\nopen.go\n\ninternal/executor:\nerrors.go\nexecutor.go\nlocal\nvalidate.go\nvalidate_test.go\n\ninternal/github:\nauth