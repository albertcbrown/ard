text.Background(), github.ListPRsOpts{})\n\tif err != nil || len(prs) != 1 {\n\t\tt.Fatalf(\"prs = %v, %v\", prs, err)\n\t}\n\tpr := prs[0]\n\tif pr.HeadRef != \"ard-init\" || pr.BaseRef != \"main\" || pr.Draft {\n\t\tt.Errorf(\"pr = %+v\", pr)\n\t}\n\tfor _, s := range []string{\"bot-commits.yml\", \"ARD_BOT_LOGIN\", \"Squash and merge\", \".ard/scanners/cve/scan\", \".ard/scanners/error-codes/Dockerfile\", \".ard/scanners/error-codes/errcodes.jq\", \".ard/scanners/error-codes/scan\", \".ard/triage/lead/prompt.txt\", \".ard/triage/engineer/prompt.txt\", \".ard/workers/engineer/prompt.txt\", \".ard/reviewers/eng-review/prompt.txt\", \".ard/reviewers/security-review/prompt.txt\"} {\n\t\tif !strings.Contains(pr.Body, s) {\n\t\t\tt.Errorf(\"PR body lacks %q:\\n%s\", s, pr.Body)\n\t\t}\n\t}\n\tif strings.Contains(pr.Body, \"@\") || strings.Contains(strings.ToLower(pr.Body), \"closes\") {\n\t\tt.Errorf(\"PR body has a mention or closing keyword:\\n%s\", pr.Body)\n\t}\n\thave, err := h.fake.ListLabels(context.Background())\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfound := false\n\tfor _, l := range have {\n\t\tfound = found || l.Name == labels.Scanner(\"cve\")\n\t}\n\tif !found {\n\t\tt.Errorf(\"label %s missing: %v\", labels.Scanner(\"cve\"), have)\n\t}\n\tfoundDocs := false\n\tfor _, l := range have {\n\t\tfoundDocs = foundDocs || l.Name == labels.Scanner(\"docs\")\n\t}\n\tif !foundDocs {\n\t\tt.Errorf(\"label %s missing: %v\", labels.Scanner(\"docs\"), have)\n\t}\n\tnames := map[string]bool{}\n\tfor _, l := range have {\n\t\tnames[l.Name] = true\n\t}\n\tfor _, want := range []string{labels.Running(labels.StageTriage, \"lead\"), labels.Done(labels.StageTriage, \"lead\"), \"ard:triage:engineer\", labels.Running(labels.StageTriage, \"engineer\"), labels.Done(labels.StageTriage, \"engineer\"), labels.Request(labels.StageWorker, \"engineer\"), labels.Running(labels.StageWorker, \"engineer\"), labels.Done(labels.StageWorker, \"engineer\"), labels.Request(labels.StageRevi