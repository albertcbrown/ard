/typecheck/nolint.jsonl     |   0\n94\t internal/roles/testdata/lint/typecheck/want.err    |   1 +\n95\t .../roles/testdata/lint/untrusted_text/baseline    |   0\n96\t .../roles/testdata/lint/untrusted_text/gl.jsonl    |   1 +\n97\t .../testdata/lint/untrusted_text/nolint.jsonl      |   0\n98\t .../roles/testdata/lint/untrusted_text/want.jsonl  |   1 +\n99\t 91 files changed, 1361 insertions(+), 14 deletions(-)\n100\t\n101\tdiff --git a/Makefile b/Makefile\n102\tindex 1dd6ab8..7c4f294 100644\n103\t--- a/Makefile\n104\t+++ b/Makefile\n105\t@@ -1,7 +1,7 @@\n106\t VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)\n107\t LDFLAGS := -s -w -X main.version=$(VERSION)\n108\t \n109\t-.PHONY: build test lint fmt clean cve-fixtures chart-test image-test\n110\t+.PHONY: build test lint fmt clean cve-fixtures lint-scanner-fixtures chart-test image-test\n111\t \n112\t build:\n113\t \tCGO_ENABLED=0 go build -ldflags \"$(LDFLAGS)\" -o bin/ard ./cmd/ard\n114\t@@ -33,5 +33,12 @@ cve-fixtures:\n115\t \tdocker run --rm --user \"$$(id -u):$$(id -g)\" -e HOME=/tmp \\\n116\t \t  -v \"$$PWD/internal/roles:/roles\" -w /roles ard-cve-fixtures sh testdata/cve/regen.sh\n117\t \n118\t+# Regenerates the real lint scanner fixtures in the pinned image (see\n119\t+# internal/roles/testdata/lint/regen.sh). Needs Docker; not part of `make test`.\n120\t+lint-scanner-fixtures:\n121\t+\tdocker build -t ard-lint-fixtures internal/roles/scanners/lint\n122\t+\tdocker run --rm --user \"$$(id -u):$$(id -g)\" -e HOME=/tmp \\\n123\t+\t  -v \"$$PWD/internal/roles:/roles\" -w /roles ard-lint-fixtures sh testdata/lint/regen.sh\n124\t+\n125\t clean:\n126\t \trm -rf bin\n127\tdiff --git a/docs/layout.md b/docs/layout.md\n128\tindex 73cdede..8bf9f35 100644\n129\t--- a/docs/layout.md\n130\t+++ b/docs/layout.md\n131\t@@ -24,7 +24,7 @@ internal/agentjob/          helpers the agent loops share: untrusted-input snaps\n132\t internal/worker/            the worker loop: claim, agent/test/fix steps, diff guard, code-lane push, draft PR, FinishWith\n133\t internal/servecmd/          `ard serve` and `ard rebuild-state`: dependency wiring (lock, state, effects, pool adoption, controller); registerLoops takes one line per loop\n134\t internal/redact/            log redaction (secrets and host paths), secret scan and 1 MiB cap (leaf library; close-out commits only LogResult.Clean)\n135\t-internal/roles/             starter .ard/ tree (config.yaml, role dirs) embedded for ard init (scanners/cve, scanners/docs, scanners/error-codes, scanners/trufflehog, triage/lead, triage/engineer, workers/engineer, reviewers/eng-review, reviewers/license-review, reviewers/security-review)\n136\t+internal/roles/             starter .ard/ tree (config.yaml, role dirs) embedded for ard init (scanners/cve, scanners/docs, scanners/error-codes, scanners/lint, scanners/trufflehog, triage/lead, triage/engineer, workers/engineer, reviewers/eng-review, reviewers/license-review, reviewers/security-review)\n137\t internal/pool/              slot arbiter for max_pods (stdlib only, no I/O): priority classes, per-issue triage cap\n138\t internal/effects/           the only writer: Effects interface, Live and DryRun (JSONL ledger), Open factory; archtest/ enforces \"only effects writes\"\n139\t internal/gitx/              git CLI wrapper (Commit, Push, StagedPaths, FileAt); gittest/ builds bare-repo fixtures; Commit/Push are for internal/effects only\n140\tdiff --git a/docs/proposal.md b/docs/proposal.md\n141\tindex afd029c..852a0c7 100644\n142\t--- a/docs/proposal.md\n143\t+++ b/docs/proposal.md\n144\t@@ -209,7 +209,7 @@ A scanner is a directory, `.ard/scanners/<name>/`, holding either an executable\n145\t | --- | --- | --- | --- | --- |\n146\t | cve | osv-scanner and govulncheck (trivy and the Dependabot alerts API later) | 6 h | 1 | yes |\n147\t | lts | endoflife.date + manifests: go.mod, package.json, Dockerfile `FROM`, Helm charts | 7 d | 1 per component | yes |\n148\t-| lint | repo linters, findings beyond a committed baseline | 24 h | 20 per rule and directory | yes |\n149\t+| lint | golangci-lint per Go module (the repo's config, or the role's `golangci.yml`), plus `//nolint` directives, minus the role directory's `baseline` | 24 h | 20 per rule and directory | yes |\n150\t | error-codes | pattern match over source, registry and docs files (`sh` + `jq`) | 24 h | 20 | yes |\n151\t | trufflehog | leaked-credential scan of the current commit (`sh` + `jq` + TruffleHog) | 24 h | 1 | yes |\n152\t | missing-tests | coverage report plus exported functions with no test | 24 h | 10 per package | yes |\n153\t@@ -220,6 +220,8 @@ A scanner is a directory, `.ard/scanners/<name>/`, holding either an executable\n154\t \n155\t **The cve scanner** (`scanners/cve`, a `sh` script plus one `jq` program, no build step) merges osv-scanner (all ecosystems) and govulncheck (Go reachability). Its fingerprint is `osv:<advisory>:<manifest>:<package>`, where the advisory is the smallest `GHSA-` id of the vulnerability, else the smallest `CVE-` id, else the smallest id, so one vulnerability reported under `GO-`, `GHSA-` and `CVE-` ids is one finding. Severity is `critical|high|medium|low`, from the CVSS score, else the database severity, else `medium`; a vulnerability govulncheck finds unreachable is capped at `medium`. Manifests under `testdata/`, `vendor/` and `node_modules/` are skipped. It fails closed: if a Go module cannot be analysed, the run fails and files nothing, unless a human adds a `no-govulncheck` file to the role directory, which skips govulncheck and reports reachability as unknown. Each Go module is analysed with the image's Go toolchain unless its `go` directive, or a `toolchain` line, needs a newer one. Then the scanner lets Go pick that toolchain (`GOTOOLCHAIN=auto` rules: the `toolchain` line if present, else the `go` directive's minimum version), downloads it from the Go module proxy (checksum-verified; scanner jobs have egress) into its temp dir, rebuilds the same govulncheck version with it, and scans with both. The image sets `TMPDIR=/var/tmp` because the executor's `/tmp` is noexec. If the temp dir is noexec, or the toolchain cannot be downloaded or built, the run fails closed and names the reason. Findings from such a module say which toolchain was scanned (`Go toolchain:` line), and standard-library findings are measured against it (for `go 1.27`, `go1.27.0`), not against the image's Go. The Dependabot alerts API is not wrapped, because a scanner holds no token.\n156\t \n157\t+**The lint scanner** (`scanners/lint`, a `sh` script, one `jq` program and a Dockerfile that builds golangci-lint v2 with the image's Go) is Go only in v1; other ecosystems are follow-ups. It runs golangci-lint once per `go.mod` (pruning `.git`, `vendor`, `node_modules` and `testdata`) with the repo's own config, or a human-owned `golangci.yml` in the role directory when present. These flags are always forced after any config, because findings that vanish are autoclosed: `--max-issues-per-linter=0 --max-same-issues=0` (no truncation), `--new=false --new-from-rev= --new-from-merge-base= --new-from-patch=` (a repo config asking for \"new issues only\" would report nothing on a clean checkout), `--issues-exit-code=0 --fix=false --path-mode=abs`, plus JSON output to a temp file. It fails closed: a golangci-lint exit other than 0, a `typecheck` issue (a compile error), a module needing a newer Go than the image's (`GOTOOLCHAIN=local`; toolchain switching is a follow-up), a path outside the repository or with a control character, a malformed baseline, and a missing `baseline` file all exit non-zero with no output. Because the image builds golangci-lint with `CGO_ENABLED=0`, a repo config's `goplugin` custom linter cannot load and fails the run. The fingerprint is `lint:<rule>:<path>:<msg>`. `<rule>` is the linter plus `/<code>` for a check code (`staticcheck/SA4000`, `gosec/G104`), or for `govet` and `revive` an analyzer name (`govet/printf`). `<msg>` drops the code, control characters and repeated whitespace, and replaces every standalone number with `N`, so line numbers and \"complexity 31\" versus \"32\" never move a fingerprint; a fingerprint over 512 bytes has its message cut by runes. Identical fingerprints in one file collapse into one finding listing every line; the known gap is that a new occurrence of an identical message in the same file is hidden while the old one is open or baselined (a count-aware baseline is a follow-up). The group is `<rule>:<directory>`, so with `group_size: 20` issues are 20 per rule and directory. Severity has two levels: `medium` for `govet`, `staticcheck/SA*`, `gosec*`, `bodyclose`, `nilerr`, `nilnesserr`, `rowserrcheck`, `sqlclosecheck` and `durationcheck`, `low` for everything else; golangci-lint's own severity is ignored. Messages, source lines and paths are untrusted: they are rendered only inside `text` fences with ``` neutralised, and inline code spans have backticks replaced. Every `//nolint` directive in a `.go` file is itself a finding (rule `nolint`, group `nolint:<directory>`, `low`), so a worker cannot close a lint issue by suppressing it; for the same reason the starter protects `**/.golangci.{yml,yaml,toml,json}`. The baseline is the human-owned file `baseline` in the role directory (a protected path, so no agent can baseline a finding): `#` comments and blank lines are ignored, every other line is one fingerprint, and a finding whose fingerprint is listed is dropped. `ard init` does not ship one, so the scanner records a failure every 24 h until a human commits it; an empty file means no baseline. `scan --baseline` prints a baseline of all current findings (ignoring any existing one), and the exact Docker command is in the Dockerfile's header; the run logs how many baseline entries are unused. Baselining a finding that is open closes its issue as \"No longer detected\" (completed); to suppress it instead, close the issue as not planned. A golangci-lint version bump can change message text and so every fingerprint: bump the version and regenerate every repo's `baseline` in the same human PR.\n158\t+\n159\t **The error-codes scanner** (`scanners/error-codes`, a `sh` script plus one `jq` program, pattern match over source, registry and docs files) reads a human-owned `codes.json` in its role directory; nothing ships one, because error-code conventions are specific to each repository. Keys: `pattern` (required, a regex of at most 512 characters, wrapped so `E1001` does not match inside `XE10011`; it must not match the empty string), `registry` (required, a list of path patterns), `entry` (optional: a registry line must also match it to define a code), `docs` (optional; unset turns the undocumented check off), `sources` (optional, default every text file) and `exclude`. A path pattern ending in `/` is a directory prefix from the root, one without `/` matches the base name, and any other is a glob on the whole path (`*` and `?` stop at `/`, `**` does not). Unknown keys, wrong types and lists over 100 entries are errors. Codes found in registry files (on `entry` lines) are R, codes anywhere in docs files are D, codes in every other text file are S. Findings: `error-codes:duplicated:<code>` (high, group `duplicate codes`: a code on two or more distinct registry lines), `error-codes:unregistered:<code>` (medium, group `unregistered codes`: in S, not in R) and `error-codes:undocumented:<code>` (low, group `undocumented codes`: in R, not in D, only when `docs` is set). Fingerprints use the code alone, so moving a use never churns an issue. `.git`, `.ard`, `vendor`, `node_modules`, `testdata`, symlinks, binary files, files of about 1 MiB or more and lines over 16 KiB are skipped. A finding carries only the code and repo-relative `path:line` locations, never line text, and codes outside `[A-Za-z0-9_.:/+=-]{1,128}` are dropped with a stderr count. Because the scanner is `autoclose`, it fails the run rather than see less: an invalid `codes.json`, a `registry` or `docs` that matches no file, a file in both, an unreadable file, a failing tool or more than 5,000 findings all exit non-zero with no output. With no `codes.json` it logs `not configured` and succeeds with no findings, so deleting `codes.json` closes its open issues as \"No longer detected\". ard does not run it on itself until ard has error codes.\n160\t \n161\t **The trufflehog scanner** (`scanners/trufflehog`, a `sh` script plus one `jq` program) runs `trufflehog filesystem . --json --no-update --no-color --no-verification --no-ignore-tag --fail-on-scan-errors --concurrency=2` on the current commit. It never verifies a credential against a provider. Only the detector name, file, line and a hash of the secret leave the scan: `Raw`, `RawV2`, `Redacted`, `SecretParts`, `ExtraData` and `StructuredData` stay in pipes inside `scan`. The fingerprint is `trufflehog:` plus the first 16 hex digits of SHA-256 over `ard-trufflehog-v1`, a NUL byte and the base64 of the secret (an unsalted hash, so one value gives one issue wherever it appears). The scan fails closed: a non-zero trufflehog exit, a missing `finished scanning` summary, zero chunks on a non-empty tree, or a result count that differs from the summary produces no findings, so nothing is autoclosed on a partial run. `exclude-paths` (regexes; `.git` is always excluded) and `allow` (one fingerprint per line) are human-owned; a bad `allow` entry fails the run. Findings use `route: needs-human`, severity high, and carry a runbook that says to rotate the credential first. `commit` is the scanned SHA, recorded in `.ard/<n>/issue.md`; history is not scanned. TruffleHog is AGPL-3.0: it is installed by the role's Dockerfile and is not in the published `ard` image.\n162\t@@ -375,7 +377,7 @@ Only ready (non-draft) PRs the App opened on `worker/<role>-<issue#>-<slug>` wit\n163\t   - when the rules are readable and name required checks, each must be completed with `success`, `neutral` or `skipped` on the head (the latest run per name; a rerun in flight hides the old result), or have a latest commit status `success`. Missing or running checks wait; a red one (failure, cancelled, timed out, action required) gets `ard:needs-human` and one comment naming the checks, until #41 adds fix rounds\n164\t   - when the rules are unavailable (a free-plan private repository answers 403 \"upgrade\", or 404) or no required checks apply, there is no list to go by: if the head has no check runs and no commit statuses the merger merges on reviews alone, but only after a grace period since it first saw the head (at least one tick and two minutes), so CI that has not queued yet is not missed; if it has either, every latest run and status per name must be green (a pending status waits)\n165\t   - when the rules cannot be read (a 5xx, a network error, a permissions 403), nothing merges that tick. Rule types ard does not evaluate (`workflows`, `code_scanning`, `required_deployments`) are logged at warn\n166\t-- the diff touches no protected path; the list comes only from `merge.protected_paths`, with no floor in code (decided, #3), so a human who empties the list removes the gate. `ard init` proposes the defaults `.github/`, `.ard/config.yaml`, the four role trees (`.ard/scanners/`, `.ard/triage/`, `.ard/workers/`, `.ard/reviewers/`), `**/CODEOWNERS`, and the agent instructions a PR could plant to steer later agents: `CLAUDE.md`, `**/CLAUDE.md`, `AGENTS.md`, `**/AGENTS.md`, `.claude/` and `.mcp.json` (13 entries; `**/X` already matches a root `X`, the bare entries are kept for clarity). An entry ending in `/` is a directory prefix; any other entry is a doublestar glob. Matching is case-insensitive on the repo-relative path (macOS file systems are, so `Claude.md` and `.Claude/x` are protected). A prefix matches on a directory boundary (`.github/` matches `.github` and `.github/x`, never `.githubx`). A glob follows doublestar: `*` stays within one path segment and `**` crosses them, so a bare `CODEOWNERS` would match only the root file. Quote globs that start with `*` in YAML. The merger checks both names of a renamed file; a malformed path counts as protected. A PR that touches one gets `ard:needs-approval` and merges on the next poll once a person with write access approves the current head with a GitHub review (below).\n167\t+- the diff touches no protected path; the list comes only from `merge.protected_paths`, with no floor in code (decided, #3), so a human who empties the list removes the gate. `ard init` proposes the defaults `.github/`, `.ard/config.yaml`, the four role trees (`.ard/scanners/`, `.ard/triage/`, `.ard/workers/`, `.ard/reviewers/`), `**/CODEOWNERS`, and the agent instructions a PR could plant to steer later agents: `CLAUDE.md`, `**/CLAUDE.md`, `AGENTS.md`, `**/AGENTS.md`, `.claude/` and `.mcp.json`, and the linter config a PR could weaken, `**/.golangci.yml`, `**/.golangci.yaml`, `**/.golangci.toml` and `**/.golangci.json` (17 entries; `**/X` already matches a root `X`, the bare entries are kept for clarity). An entry ending in `/` is a directory prefix; any other entry is a doublestar glob. Matching is case-insensitive on the repo-relative path (macOS file systems are, so `Claude.md` and `.Claude/x` are protected). A prefix matches on a directory boundary (`.github/` matches `.github` and `.github/x`, never `.githubx`). A glob follows doublestar: `*` stays within one path segment and `**` crosses them, so a bare `CODEOWNERS` would match only the root file. Quote globs that start with `*` in YAML. The merger checks both names of a renamed file; a malformed path counts as protected. A PR that touches one gets `ard:needs-approval` and merges on the next poll once a person with write access approves the current head with a GitHub review (below).\n168\t \n169\t A protected path needs a GitHub review in state `APPROVED`, from a user who is not an App and has write, maintain or admin permission, that stands at a commit the current head still covers (the same rule as for reviews). A later `CHANGES_REQUESTED` or `DISMISSED` review by the same person voids it, a plain comment does not. A triage user cannot push or merge on GitHub, so their approval does not authorise a change to `.github/`, config or agent instructions. The label is not the approval: `ard:needs-approval` is informational, the merger adds it and posts one comment per head, and removing it changes nothing.\n170\t \n171\t@@ -415,7 +417,7 @@ paused: false\n172\t intervals: { scanners: 4h, triage: 15m, workers: 5m, reviewers: 5m, merger: 5m }\n173\t intake: { mode: label }     # mode: all | label; label (label mode only) defaults to ard:pending, must start with ard: and must not be one of ard's own labels\n174\t merge:                       # defaults written by `ard init`; the list is the only source (no floor in code)\n175\t-  protected_paths: [.github/, .ard/config.yaml, .ard/scanners/, .ard/triage/, .ard/workers/, .ard/reviewers/, \"**/CODEOWNERS\", CLAUDE.md, \"**/CLAUDE.md\", AGENTS.md, \"**/AGENTS.md\", .claude/, .mcp.json]\n176\t+  protected_paths: [.github/, .ard/config.yaml, .ard/scanners/, .ard/triage/, .ard/workers/, .ard/reviewers/, \"**/CODEOWNERS\", CLAUDE.md, \"**/CLAUDE.md\", AGENTS.md, \"**/AGENTS.md\", .claude/, .mcp.json, \"**/.golangci.yml\", \"**/.golangci.yaml\", \"**/.golangci.toml\", \"**/.golangci.json\"]\n177\t stale: { inactive_for: 30d, suppress_for: 90d }\n178\t \n179\t sidecars:\n180\t@@ -439,7 +441,7 @@ overrides:                   # only what differs from convention\n181\t \n182\t Scanners also take `route` (`pending`, `none` or `needs-human`). Anything unset takes its default: intake in `label` mode with `ard:pending`, scanners every 4 h with `max_open` 5 and `group_size` 10, triage every 15 min, a 30-minute job timeout, `make test`, 2 test-fix attempts, 3 review rounds and worker diff thresholds of 1,000 lines (warn) and 2,000 lines (hold). Durations accept `m`, `h` and `d`. A sidecar `repo` must be `owner/name` and its `ref` a valid git ref name (no `:`, leading `-`, `..` or spaces; an abbreviated SHA is rejected, use all 40 characters); `ard config check` reports the file and key. A worker's `timeout` and `max_budget_usd` cover the whole job (every step), and `tests: \"\"` disables its test step. Per-role keys are `every`, `max_open`, `group_size`, `autoclose`, `timeout`, `agent`, `model`, `max_budget_usd`, `budget_usd_per_day` (that role's own daily cap in USD; unset or 0 means only the repo cap applies), `sidecar`, `after`, `plan_section`, `tests`, `max_test_fixes`, `max_review_rounds`, `diff_warn_lines` and `diff_max_lines` (worker roles; positive integers, warn no more than max; above warn the PR proceeds with a note, above max it is held), `reviewers` and `when` (`paths`, or `triage` roles that ran; at least one is required). `ard config check` warns when every reviewer has a `when:` rule, because a PR matching none gets no review and stays a draft. `plan_section` is for triage roles: the `## <heading>` of `plan.md` the role owns (one line, no leading `#`, unique across triage roles). The starter roles default to Requirements (product-manager), Design (architect), UX (designer), Docs (documentation-planner) and Implementation (engineer), and a value in `config.yaml` overrides that; a triage role with none may write only its own role file. There are no per-role config files: `ard init` writes a role's starting overrides into `config.yaml` for the roles it ships. Once a second repo adopts ard, role directories can move to a shared roles repo pinned by ref, like a sidecar; a repo's own directory of the same name wins. `after` names triage roles, with no self-reference and no cycles.\n183\t \n184\t-**`ard init` proposes the starter `.ard/` as a PR (decided, #27).** It builds `config.yaml` and the starter roles in memory (today `scanners/cve`, `scanners/docs`, `scanners/error-codes`, `scanners/trufflehog`, `triage/lead`, `triage/engineer`, `workers/engineer`, `reviewers/eng-review`, `reviewers/license-review` and `reviewers/security-review`; `intake: {mode: label}`, the protected-path defaults above, and the cve, docs, error-codes, lead, engineer, worker, eng-review, security-review and license-review overrides), compares them with `main`, commits them on a new branch `ard-init` cut from `main` through the effect layer and a narrow committer lane, pushes it and opens a PR. It writes nothing to the local working tree or to `main`, and `scan` is committed `100755`. Files that already exist on `main` with different contents are a conflict naming the paths; `--force` proposes overwriting them, and init never deletes anything. It refuses while `ard-init` exists on the remote, whatever its PR's state, so it never force-pushes over or stacks commits on a human's edits: merge or close the PR, delete the branch and rerun. If `main` already has every starter file it prints `nothing to propose`. It syncs the label catalogue first (like `ard labels sync`), so a failure leaves nothing pushed. With `--dry-run` the commit, push and PR are logged to the ledger instead of acting. A missing repo, credentials or `main` branch exits 1 with nothing written, and `ARD_GITHUB_TOKEN` auth is refused outside `--dry-run`. The PR body carries the one step the App cannot do: copy `.github/workflows/bot-commits.yml` and set the repository variable `ARD_BOT_LOGIN` (optionally `ARD_BOT_CHECK_SINCE`). It also says to merge with **Squash and merge** or **Create a merge commit**, never a fast-forward from the command line, which would put the bot's commit on main's first-parent history. **Rebase and merge** is also safe: the scratch-repo run (#85) showed GitHub records the merging human as committer of a rebase-merged commit (the bot stays the author), and the bot-commit check keys on committer, so it does not flag it. The body still names only the two merges above.\n185\t+**`ard init` proposes the starter `.ard/` as a PR (decided, #27).** It builds `config.yaml` and the starter roles in memory (today `scanners/cve`, `scanners/docs`, `scanners/error-codes`, `scanners/lint`, `scanners/trufflehog`, `triage/lead`, `triage/engineer`, `workers/engineer`, `reviewers/eng-review`, `reviewers/license-review` and `reviewers/security-review`; `intake: {mode: label}`, the protected-path defaults above, and the cve, docs, error-codes, lint, lead, engineer, worker, eng-review, security-review and license-review overrides), compares them with `main`, commits them on a new branch `ard-init` cut from `main` through the effect layer and a narrow committer lane, pushes it and opens a PR. It writes nothing to the local working tree or to `main`, and `scan` is committed `100755`. Files that already exist on `main` with different contents are a conflict naming the paths; `--force` proposes overwriting them, and init never deletes anything. It refuses while `ard-init` exists on the remote, whatever its PR's state, so it never force-pushes over or stacks commits on a human's edits: merge or close the PR, delete the branch and rerun. If `main` already has every starter file it prints `nothing to propose`. It syncs the label catalogue first (like `ard labels sync`), so a failure leaves nothing pushed. With `--dry-run` the commit, push and PR are logged to the ledger instead of acting. A missing repo, credentials or `main` branch exits 1 with nothing written, and `ARD_GITHUB_TOKEN` auth is refused outside `--dry-run`. The PR body carries the one step the App cannot do: copy `.github/workflows/bot-commits.yml` and set the repository variable `ARD_BOT_LOGIN` (optionally `ARD_BOT_CHECK_SINCE`). When the lint scanner is among the files, it also says the scanner fails until `.ard/scanners/lint/baseline` is committed. It also says to merge with **Squash and merge** or **Create a merge commit**, never a fast-forward from the command line, which would put the bot's commit on main's first-parent history. **Rebase and merge** is also safe: the scratch-repo run (#85) showed GitHub records the merging human as committer of a rebase-merged commit (the bot stays the author), and the bot-commit check keys on committer, so it does not flag it. The body still names only the two merges above.\n186\t \n187\t **Where `ard serve` reads config (decided, #87).** After each fetch into its own clone (`~/.ard/repos/<owner>/<repo>.git`, see Local-executor details) `ard serve` resolves `origin/main` to a SHA and reads `config.yaml` and the role directories from that commit, not from the working tree. It exports them into a snapshot at `~/.ard/config/<owner>/<repo>/<sha>/`, kept 24 hours after a newer SHA replaces it, because roles run from a host path: a role directory, its `Dockerfile` and the scan worktree must all describe the one commit the tick's jobs use. Editing the host's working tree therefore changes nothing on a running controller, with one exception: a local `paused: true` is honoured (see the kill switch), and only that key is read locally. A merged change applies on the next tick without a pull. Symlinks and submodules under the role directories are rejected, and a config that cannot be fetched or does not validate counts as paused. If `origin/main` cannot be loaded at startup, `ard serve` starts paused instead of exiting, posts the load error to the status issue once per distinct error, and retries every tick; no loop runs until a config has loaded. `ard config check` validates the working tree, for authoring; `ard config check --ref <ref>` validates a commit of the local checkout (for example `--ref origin/main` after `git fetch`) without fetching.\n188\t \n189\tdiff --git a/internal/initcmd/body.go b/internal/initcmd/body.go\n190\tindex 6a5ccd0..6cab8bc 100644\n191\t--- a/internal/initcmd/body.go\n192\t+++ b/internal/initcmd/body.go\n193\t@@ -30,6 +30,12 @@ func initBody(ops []op, res *config.Resolved) string {\n194\t \tb.WriteString(\"\\n## Before you merge\\n\\n\")\n195\t \tb.WriteString(\"- Nothing takes effect until this is merged: ard serve reads its configuration from origin/main.\\n\")\n196\t \tb.WriteString(\"- Merge with **Squash and merge** (recommended); **Create a merge commit** is also safe. Never fast-forward this branch into main from the command line: the bot-commit check reads main's first-parent history and would fail on the bot's commit.\\n\")\n197\t+\tfor _, o := range ops {\n198\t+\t\tif o.File.Path == \".ard/scanners/lint/scan\" {\n199\t+\t\t\tb.WriteString(\"- The lint scanner fails until you commit `.ard/scanners/lint/baseline`: run the command in `.ard/scanners/lint/Dockerfile`'s header (an empty file means no baseline).\\n\")\n200\t+\t\t\tbreak\n201\t+\t\t}\n202\t+\t}\n203\t \tb.WriteString(\"- `scanners/trufflehog` is included. It files leaked-credential issues for a human (never for an agent) and needs a TruffleHog binary (AGPL-3.0; it is installed by the role's Dockerfile or taken from the host, and is not in the ard image). To opt out, delete `.ard/scanners/trufflehog/` and its `scanners/trufflehog` line under `overrides:` in `.ard/config.yaml` before merging.\\n\")\n204\t \tb.WriteString(\"\\n## Follow-up the App cannot do\\n\\n\")\n205\t \tb.WriteString(\"ard's GitHub App has no permission to write `.github/`, so do this by hand:\\n\\n\")\n206\tdiff --git a/internal/initcmd/initcmd_test.go b/internal/initcmd/initcmd_test.go\n207\tindex 41e2e08..226db4e 100644\n208\t--- a/internal/initcmd/initcmd_test.go\n209\t+++ b/internal/initcmd/initcmd_test.go\n210\t@@ -143,7 +143,7 @@ func snapshot(t *testing.T, dir string) map[string]string {\n211\t \treturn m\n212\t }\n213\t \n214\t-var starterTree = []string{\".ard/config.yaml\", \".ard/reviewers/eng-review/prompt.txt\", \".ard/reviewers/license-review/allowlist.txt\", \".ard/reviewers/license-review/prompt.txt\", \".ard/reviewers/security-review/prompt.txt\", \".ard/scanners/cve/Dockerfile\", \".ard/scanners/cve/merge.jq\", \".ard/scanners/cve/scan\", \".ard/scanners/docs/Dockerfile\", \".