g) (stdout, std\n \treturn so.String(), se.String(), code\n }\n \n-// scanRunArgs mirrors the executor's runArgv for a read-only scanner job.\n+// scanRunArgs mirrors the executor's runArgv for a read-only scanner job. It is\n+// shared by the cve and lint Docker integration tests.\n // Keep in sync with internal/executor/local/docker.go runArgv.\n func scanRunArgs(image, repo, roleDir string, extraEnv ...string) []string {\n \ta := []string{\"run\", \"--rm\", \"--init\",\ndiff --git a/internal/roles/lint_docker_integration_test.go b/internal/roles/lint_docker_integration_test.go\nnew file mode 100644\nindex 0000000..042649f\n--- /dev/null\n+++ b/internal/roles/lint_docker_integration_test.go\n@@ -0,0 +1,54 @@\n+//go:build integration\n+\n+package roles\n+\n+import (\n+\t\"fmt\"\n+\t\"os\"\n+\t\"os/exec\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+\t\"time\"\n+)\n+\n+// TestIntegrationLintDocker builds scanners/lint and runs the role under the\n+// executor's container flags against a go 1.27 module (findings) and a go 1.99\n+// module (exit 1 with the newer-Go message). Needs Docker and network.\n+func TestIntegrationLintDocker(t *testing.T) {\n+\tif _, err := exec.LookPath(\"docker\"); err != nil {\n+\t\tt.Skip(\"docker not on PATH\")\n+\t}\n+\tif _, _, code := dockerOut(t, 30*time.Second, \"info\"); code != 0 {\n+\t\tt.Skip(\"docker daemon not available\")\n+\t}\n+\ttag := fmt.Sprintf(\"ard-lint-it:%d\", time.Now().UnixNano())\n+\tif _, se, code := dockerOut(t, 20*time.Minute, \"build\", \"-q\", \"-t\", tag, \"scanners/lint\"); code != 0 {\n+\t\tt.Fatalf(\"docker build: %s\", se)\n+\t}\n+\tt.Cleanup(func() { dockerOut(t, time.Minute, \"image\", \"rm\", tag) })\n+\trole := lintRoleCopy(t, strp(\"\"))\n+\n+\trepo := t.TempDir()\n+\tlintFixtureModule(t, repo)\n+\tif err := os.WriteFile(filepath.Join(repo, \"go.mod\"), []byte(\"module example.com/lintfixture\\n\\ngo 1.27\\n\"), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tout, se, code := dockerOut(t, 20*time.Minute, scanRunArgs(tag, repo, role)...)\n+\tif code != 0 {\n+\t\tt.Fatalf(\"exit %d\\n%s\", code, se)\n+\t}\n+\tfor _, w := range []string{\"lint:errcheck:main.go:\", \"lint:govet/printf:main.go:\", \"lint:unused:main.go:\", \"lint:nolint:main.go:\"} {\n+\t\tif !strings.Contains(out, w) {\n+\t\t\tt.Errorf(\"missing %s in:\\n%s\", w, out)\n+\t\t}\n+\t}\n+\n+\tif err := os.WriteFile(filepath.Join(repo, \"go.mod\"), []byte(\"module example.com/lintfixture\\n\\ngo 1.99\\n\"), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tout, se, code = dockerOut(t, 20*time.Minute, scanRunArgs(tag, repo, role)...)\n+\tif code != 1 || out != \"\" || !strings.Contains(se, \"go.mod needs a newer Go than the image's\") {\n+\t\tt.Fatalf(\"go 1.99: exit %d stdout %q\\n%s\", code, out, se)\n+\t}\n+}\ndiff --git a/internal/roles/lint_integration_test.go b/internal/roles/lint_integration_test.go\nnew file mode 100644\nindex 0000000..3fbbad2\n--- /dev/null\n+++ b/internal/roles/lint_integration_test.go\n@@ -0,0 +1,129 @@\n+//go:build integration\n+\n+package roles\n+\n+import (\n+\t\"bytes\"\n+\t\"os\"\n+\t\"os/exec\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+// lintRoleCopy copies scanners/lint into a temp role directory with the given\n+// baseline (nil: none), the way a repo would carry it.\n+func lintRoleCopy(t *testing.T, baseline *string) string {\n+\tt.Helper()\n+\trole := t.TempDir()\n+\tfor _, n := range []string{\"scan\", \"normalize.jq\"} {\n+\t\tb, err := os.ReadFile(filepath.Join(\"scanners\", \"lint\", n))\n+\t\tif err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tif err := os.WriteFile(filepath.Join(role, n), b, 0o755); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\tif baseline != nil {\n+\t\tif err := os.WriteFile(filepath.Join(role, \"baseline\"), []byte(*baseline), 0o644); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\treturn role\n+}\n+\n+func lintFixtureModule(t *testing.T, repo string) {\n+\tt.Helper()\n+\tfiles := map[string]string{\n+\t\t\"go.mod\": \"module example.com/lintfixture\\n\\ngo 1.21\\n\",\n+\t\t\"main.go\": `package main\n+\n+import (\n+\t\"fmt\"\n+\t\"os\"\n+)\n+\n+func unusedHelper() {}\n+\n+func main() {\n+\tos.Remove(\"a\")\n+\tfmt.Printf(\"%d\\n\", \"x\")\n+\tos.Remove(\"b\") //nolint:errcheck\n+}\n+`,\n+\t\t// issues.new would hide everything in a clean checkout; the forced flags win.\n+\t\t\".golangci.yml\": \"version: \\\"2\\\"\\nissues:\\n  new: true\\n\",\n+\t}\n+\tfor n, s := range files {\n+\t\tif err := os.WriteFile(filepath.Join(repo, n), []byte(s), 0o644); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+}\n+\n+func runLintHost(t *testing.T, repo, role string, args ...string) (string, string, int) {\n+\tt.Helper()\n+\tcmd := exec.Command(\"sh\", append([]string{filepath.Join(role, \"scan\")}, args...)...)\n+\tcmd.Dir = repo\n+\tvar so, se bytes.Buffer\n+\tcmd.Stdout, cmd.Stderr = &so, &se\n+\tcode := 0\n+\tif err := cmd.Run(); err != nil {\n+\t\tee, ok := err.(*exec.ExitError)\n+\t\tif !ok {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tcode = ee.ExitCode()\n+\t}\n+\treturn so.String(), se.String(), code\n+}\n+\n+// TestIntegrationLintHost runs the real scan with the host's golangci-lint and\n+// go: findings appear, a generated baseline silences them, and one new\n+// unchecked call is exactly one new finding.\n+func TestIntegrationLintHost(t *testing.T) {\n+\tneedTools(t, \"golangci-lint\", \"go\", \"jq\", \"sh\")\n+\trepo := t.TempDir()\n+\tlintFixtureModule(t, repo)\n+\trole := lintRoleCopy(t, strp(\"\"))\n+\n+\tout, se, code := runLintHost(t, repo, role)\n+\tif code != 0 {\n+\t\tt.Fatalf(\"exit %d\\n%s\", code, se)\n+\t}\n+\tfor _, w := range []string{\"lint:errcheck:main.go:\", \"lint:govet/printf:main.go:\", \"lint:unused:main.go:\", \"lint:nolint:main.go:\"} {\n+\t\tif !strings.Contains(out, w) {\n+\t\t\tt.Errorf(\"missing %s in:\\n%s\", w, out)\n+\t\t}\n+\t}\n+\n+\tbase, se, code := runLintHost(t, repo, role, \"--baseline\")\n+\tif code != 0 {\n+\t\tt.Fatalf(\"--baseline exit %d\\n%s\", code, se)\n+\t}\n+\tif err := os.WriteFile(filepath.Join(role, \"baseline\"), []byte(base), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif out, se, code = runLintHost(t, repo, role); code != 0 || out != \"\" {\n+\t\tt.Fatalf(\"with baseline: exit %d stdout %q\\n%s\", code, out, se)\n+\t}\n+\n+\t// One new unchecked call with a message the baseline lacks (an identical\n+\t// message in the same file would collapse into a baselined finding).\n+\tsrc, err := os.ReadFile(filepath.Join(repo, \"main.go\"))\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tsrc = bytes.Replace(src, []byte(\"func unusedHelper() {}\"), []byte(\"func unusedHelper() { os.Setenv(\\\"a\\\", \\\"b\\\") }\"), 1)\n+\tif err := os.WriteFile(filepath.Join(repo, \"main.go\"), src, 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tout, se, code = runLintHost(t, repo, role)\n+\tif code != 0 {\n+\t\tt.Fatalf(\"exit %d\\n%s\", code, se)\n+\t}\n+\tif lines := strings.Split(strings.TrimSpace(out), \"\\n\"); len(lines) != 1 || !strings.Contains(out, \"lint:errcheck:main.go:Error return value of `os.Setenv`\") {\n+\t\tt.Fatalf(\"want exactly the new finding, got:\\n%s\", out)\n+\t}\n+}\ndiff --git a/internal/roles/lint_scan_test.go b/internal/roles/lint_scan_test.go\nnew file mode 100644\nindex 0000000..d58c3a0\n--- /dev/null\n+++ b/internal/roles/lint_scan_test.go\n@@ -0,0 +1,315 @@\n+package roles\n+\n+import (\n+\t\"bytes\"\n+\t\"encoding/json\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"io/fs\"\n+\t\"os\"\n+\t\"os/exec\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+const stubGolangci = `#!/bin/sh\n+if [ \"$1\" = version ]; then echo 2.15.0; exit 0; fi\n+echo \"cwd=$PWD argv=$*\" >> \"$STUB_DIR/calls.log\"\n+out=\n+for a in \"$@\"; do\n+  case $a in --output.json.path=*) out=${a#--output.json.path=} ;; esac\n+done\n+[ -z \"$out\" ] || cp \"$STUB_DIR/report.json\" \"$out\"\n+[ ! -f \"$STUB_DIR/stderr.txt\" ] || cat \"$STUB_DIR/stderr.txt\" >&2\n+exit \"$(cat \"$STUB_DIR/rc\" 2>/dev/null || echo 0)\"\n+`\n+\n+const stubGo = `#!/bin/sh\n+if [ \"$1\" = env ] && [ \"$2\" = GOVERSION ]; then echo go1.27.4; exit 0; fi\n+echo \"unexpected go call: $*\" >&2\n+exit 1\n+`\n+\n+type lintScanOpts struct {\n+\tbaseline    *string // nil: no baseline file\n+\troleConfig  bool\n+\tnoGolangci  bool\n+\tmodules     []string // go.mod directories; \".\" is the root\n+\tissues      []map[string]any\n+\trc          int\n+\tgolangciErr string\n+\tfiles       map[string]string // extra repo files\n+\targs        []string\n+}\n+\n+type lintScanResult struct {\n+\tstdout, stderr string\n+\tcode           int\n+\tcalls          []string\n+\trepo           string\n+\trole           string\n+}\n+\n+func runLintScan(t *testing.T, o lintScanOpts) lintScanResult {\n+\tt.Helper()\n+\tneedTools(t, \"sh\", \"jq\", \"find\", \"grep\")\n+\tjqPath, _ := exec.LookPath(\"jq\")\n+\tjqPath, _ = filepath.EvalSymlinks(jqPath)\n+\tbase, _ := filepath.EvalSymlinks(t.TempDir())\n+\trole, repo, stub, tmp := filepath.Join(base, \"role\"), filepath.Join(base, \"repo\"), filepath.Join(base, \"stub\"), filepath.Join(base, \"tmp\")\n+\tfor _, d := range []string{role, repo, stub, tmp} {\n+\t\tif err := os.MkdirAll(d, 0o755); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\twrite := func(p, s string, mode os.FileMode) {\n+\t\tt.Helper()\n+\t\tif err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tif err := os.WriteFile(p, []byte(s), mode); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\tfor _, n := range []string{\"scan\", \"normalize.jq\"} {\n+\t\tb, err := os.ReadFile(filepath.Join(\"scanners\", \"lint\", n))\n+\t\tif err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\twrite(filepath.Join(role, n), string(b), 0o755)\n+\t}\n+\tif o.baseline != nil {\n+\t\twrite(filepath.Join(role, \"baseline\"), *o.baseline, 0o644)\n+\t}\n+\tif o.roleConfig {\n+\t\twrite(filepath.Join(role, \"golangci.yml\"), \"version: \\\"2\\\"\\n\", 0o644)\n+\t}\n+\tif !o.noGolangci {\n+\t\twrite(filepath.Join(stub, \"golangci-lint\"), stubGolangci, 0o755)\n+\t}\n+\twrite(filepath.Join(stub, \"go\"), stubGo, 0o755)\n+\tif err := os.Symlink(jqPath, filepath.Join(stub, \"jq\")); err != nil {\n+\t\tt.Fatal(err)\n+\t}","numLines":598,"startLine":1,"totalLines":2061,"truncatedByTokenCap":true}},"tool_result_meta":[{"id":"toolu_01SHpMtpmH3NSHwpAQqrbGeZ","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
