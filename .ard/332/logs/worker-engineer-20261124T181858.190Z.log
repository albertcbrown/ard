{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SAS95y8F8Xx8wjeX5rxsfZ","type":"tool_result","content":"type Git interface {\n\tFetchRef(ctx context.Context, repoDir, url, refspec string, token gitx.TokenFunc) error\n\tRevParse(ctx context.Context, dir, ref string) (string, error)\n\tMergeBase(ctx context.Context, repoDir, a, b string) (string, error)\n\tDiff(ctx context.Context, repoDir, from, to string, maxBytes int64, exclude ...string) ([]byte, bool, error)\n\tAddedLinesBetween(ctx context.Context, repoDir, from, to string, exclude ...string) (map[string][]gitx.LineRange, error)\n\tCodeChanged(ctx context.Context, repoDir, from, to string, exclude ...string) ([]string, error)\n\tFileAt(ctx context.Context, dir, rev, path string, maxBytes int64) ([]byte, bool, error)\n}\n\n// Offerer is *pool.Pool.\ntype Offerer interface {\n\tOffer(loop string, ttl time.Duration, cands []pool.Candidate) []pool.Decision\n}\n\n// Deps are the loop's collaborators. Executor, Finisher and Parse must be the\n\tCloseoutsOf(ctx context.Context, issue int, stage string) ([]state.Job, error)\n}\n\n// Git is the read side of *gitx.Git, run against the controller's clone only.\ntype Git interface {\n\tFetchRef(ctx context.Context, repoDir, url, refspec string, token gitx.TokenFunc) error\n\tRevParse(ctx context.Context, dir, ref string) (string, error)\n\tCodeChanged(ctx context.Context, repoDir, from, to string, exclude ...string) ([]string, error)\n}\n\n// Deps are the loop's collaborators.\ntype Deps struct {\n\tReader  Reader\n\tEffects Effects\n\tStore   Store\n\tGit     Git\n\tRunningJobs(ctx context.Context) ([]state.Job, error)\n\tAppendEvent(ctx context.Context, e state.Event) error\n\tEvents(ctx context.Context, f state.EventFilter) ([]state.Event, error)\n}\n\n// Git is the read side of *gitx.Git, run against the controller's clone only.\n// It has no Commit or Push: only internal/effects may call those.\ntype Git interface {\n\tFetchRef(ctx context.Context, repoDir, url, refspec string, token gitx.TokenFunc) error\n\tRevParse(ctx context.Context, dir, ref string) (string, error)\n\tMergeBaseAll(ctx context.Context, repoDir, a, b string) ([]string, error)\n\tCodeChanged(ctx context.Context, repoDir, from, to string, exclude ...string) ([]string, error)\n}\n\n// Deps are the loop's collaborators.\ntype Deps struct {\n\tReader  Reader\n\tEffects Effects\n\tStore   Store\n\tGit     Git\n\n\n// CodeChanged lists the paths that differ between commits from and to, leaving\n// out the exclude prefixes. A moved PR head whose only new commits touch an\n// excluded prefix (the .ard/ close-out commits) gives none.\nfunc (g *Git) CodeChanged(ctx context.Context, repoDir, from, to string, exclude ...string) ([]string, error) {\n\targs, err := diffArgs(gitDirOf(repoDir), from, to, exclude, \"--name-only\", \"-z\", \"--no-renames\")\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tout, _, err := g.run(ctx, repoDir, []string{\"GIT_ATTR_SOURCE=\" + emptyTree, \"GIT_OPTIONAL_LOCKS=0\"}, \"\", nil, args...)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"gitx: code changed %.12s %.12s: %w\", from, to, err)\n\t}\n\tvar ps []string\n\tfor _, p := range strings.Split(out, \"\\x00\") {\n\t\tif p != \"\" {\n\t\t\tps = append(ps, p)\n\t\t}\n\t}\n\treturn ps, nil\n}\n\n\t// e. Every requested review passed (by its close-out record, not the label)\n\t// at a head that still covers this one.\n\tfor _, role := range v.Roles {\n\t\treviewed, passed, err := closeout.ReviewPassed(ctx, d.Store, issue, n, role)\n\t\tif err != nil {\n\t\t\tt.fail(n, \"review_record\", err)\n\t\t\treturn false\n\t\t}\n\t\tif !passed {\n\t\t\tt.log.Info(\"merge.reviews_stale\", \"pr\", n, \"issue\", issue, \"role\", role, \"reason\", \"no passing close-out record\",\n\t\t\t\t\"hint\", \"the review has not passed on this PR; it re-runs when the role label is requested\")\n\t\t\treturn false\n\t\t}\n\t\tok, broken, err := prgate.Covers(ctx, d.Git, d.RepoDir, reviewed, head, base, issue)\n\t\tif err != nil {\n\t\t\tt.fail(n, \"review_cover\", err)\n\t\t\treturn false\n\t\t}\n\t\tif !ok {\n\t\t\tt.log.Info(\"merge.reviews_stale\", \"pr\", n, \"issue\", issue, \"role\", role, \"reviewed\", reviewed, \"head\", head, \"paths\", len(broken),\n\t\t\t\t\"hint\", \"the merger re-requests this review once per head\")\n\t\t\tt.rerequestReview(ctx, pr, issue, role, reviewed, head)\n\t\t\treturn false\n\t\t}\n\t}\n\n\t// f. Closing reference and trailer.\n\tif !closingRef(pr.Body, issue) {\n\t\treturn t.needsHuman(ctx, pr, \"no_closing_ref\", \"\")\n\t}\n\tjobIDs, err := t.workerJobs(ctx, issue, pr.HeadRef)\n\tif err != nil {\n\t\tt.fail(n, \"worker_jobs\", err)\n\t\treturn false\n\t}\n\nfunc (t *tick) hasApproval(ctx context.Context, pr github.PullRequest, head, base string, issue int) (bool, error) {\n\td := t.l.d\n\treviews, err := d.Reader.ListReviews(ctx, pr.Number)\n\tif err != nil {\n\t\treturn false, err\n\t}\n\treturn approved(ctx, reviews, approvalCheck{\n\t\tself:       t.self,\n\t\tpermission: d.Reader.GetPermission,\n\t\tcovers: func(ctx context.Context, at string) (bool, error) {\n\t\t\t// An approval given at a commit the clone does not have (a\n\t\t\t// force-pushed tip) cannot be compared: it is not covered.\n\t\t\tok, _, err := prgate.Covers(ctx, d.Git, d.RepoDir, at, head, base, issue)\n\t\t\tif err != nil {\n\t\t\t\tt.log.Debug(\"merge.approval_not_comparable\", \"pr\", pr.Number, \"at\", at, \"error\", err)\n\t\t\t\treturn false, nil\n\t\t\t}\n\t\t\treturn ok, nil\n\t\t},\n\t})\n}\n\n// needApproval labels the PR and posts one comment per head.\nfunc (t *tick) needApproval(ctx context.Context, pr github.PullRequest, head string, patterns []string) {\n\td := t.l.d\n\tt.log.Info(\"merge.needs_approval\", \"pr\", pr.Number, \"head\", head, \"patterns\", strings.Join(patterns, \",\"))\n\tvar list []string\n\tfor _, p := range patterns {\n\t\tlist = append(list, \"`\"+strings.ReplaceAll(p, \"`\", \"'\")+\"`\")\n\t}\n\t\tif go