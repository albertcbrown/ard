 != nil {\n81\t+\t\t\tt.Fatal(err)\n82\t+\t\t}\n83\t+\t\trun(\"add\", \"f.txt\")\n84\t+\t}\n85\t+\twrite(body(\"a\", \"z\"))\n86\t+\trun(\"commit\", \"-q\", \"-m\", \"one\")\n87\t+\tc1 := run(\"rev-parse\", \"HEAD\")\n88\t+\twrite(body(\"a\", \"Z\"))\n89\t+\trun(\"commit\", \"-q\", \"-m\", \"two\")\n90\t+\tc2 := run(\"rev-parse\", \"HEAD\")\n91\t+\twrite(body(\"A\", \"Z\"))\n92\t+\trun(\"commit\", \"-q\", \"-m\", \"three\")\n93\t+\tc3 := run(\"rev-parse\", \"HEAD\")\n94\t+\t// The same change to the last line at shifted offsets.\n95\t+\twrite([]byte(\"new\\nnew\\n\" + string(body(\"A\", \"Z\"))))\n96\t+\trun(\"commit\", \"-q\", \"-m\", \"shift\")\n97\t+\tc4 := run(\"rev-parse\", \"HEAD\")\n98\t+\twrite([]byte(\"new\\nnew\\n\" + string(body(\"A\", \"Q\"))))\n99\t+\trun(\"commit\", \"-q\", \"-m\", \"other\")\n100\t+\tc5 := run(\"rev-parse\", \"HEAD\")\n101\t+\n102\t+\ta, err := g.PatchID(ctx, dir, c1, c2, \"f.txt\")\n103\t+\tif err != nil {\n104\t+\t\tt.Fatal(err)\n105\t+\t}\n106\t+\tif b, err := g.PatchID(ctx, dir, c1, c2, \"f.txt\"); err != nil || a != b {\n107\t+\t\tt.Fatalf(\"same diff: %q %q %v\", a, b, err)\n108\t+\t}\n109\t+\tif b, err := g.PatchID(ctx, dir, c3, c4, \"f.txt\"); err != nil || a == b {\n110\t+\t\tt.Fatalf(\"different diff must differ: %q %q %v\", a, b, err)\n111\t+\t}\n112\t+\tif b, err := g.PatchID(ctx, dir, c4, c5, \"f.txt\"); err != nil || a == b {\n113\t+\t\tt.Fatalf(\"changed line must differ: %q %q %v\", a, b, err)\n114\t+\t}\n115\t+\tif _, err := g.PatchID(ctx, dir, c1, c1, \"f.txt\"); err == nil {\n116\t+\t\tt.Error(\"empty diff: want error\")\n117\t+\t}\n118\t+\tif _, err := g.PatchID(ctx, dir, c1, \"nope\", \"f.txt\"); err == nil {\n119\t+\t\tt.Error(\"bad rev: want error\")\n120\t+\t}\n121\t+\tps, err := g.Parents(ctx, dir, c2)\n122\t+\tif err != nil || len(ps) != 1 || ps[0] != c1 {\n123\t+\t\tt.Fatalf(\"parents = %v %v\", ps, err)\n124\t+\t}\n125\t+\tif _, err := g.Parents(ctx, dir, \"nope\"); err == nil {\n126\t+\t\tt.Error(\"parents of bad rev: want error\")\n127\t+\t}\n128\t+}\n129\tdiff --git a/internal/merger/loop.go b/internal/merger/loop.go\n130\tindex b73889d..a5c76fd 100644\n131\t--- a/internal/merger/loop.go\n132\t+++ b/internal/merger/loop.go\n133\t@@ -64,6 +64,9 @@ type Git interface {\n134\t \tFetchRef(ctx context.Context, repoDir, url, refspec string, token gitx.TokenFunc) error\n135\t \tRevParse(ctx context.Context, dir, ref string) (string, error)\n136\t \tMergeBaseAll(ctx context.Context, repoDir, a, b string) ([]string, error)\n137\t+\tMergeBase(ctx context.Context, repoDir, a, b string) (string, error)\n138\t+\tParents(ctx context.Context, repoDir, rev string) ([]string, error)\n139\t+\tPatchID(ctx context.Context, repoDir, from, to, path string) (string, error)\n140\t \tCodeChanged(ctx context.Context, repoDir, from, to string, exclude ...string) ([]string, error)\n141\t }\n142\t \n143\tdiff --git a/internal/merger/loop_test.go b/internal/merger/loop_test.go\n144\tindex f8c5415..b777b7a 100644\n145\t--- a/internal/merger/loop_test.go\n146\t+++ b/internal/merger/loop_test.go\n147\t@@ -819,3 +819,69 @@ func TestNoPassingRecordNotRerequested(t *testing.T) {\n148\t \t\tt.Fatalf(\"log:\\n%s\", out)\n149\t \t}\n150\t }\n151\t+\n152\t+// sharedBody returns a 20-line file whose first and last lines can differ.\n153\t+func sharedBody(first, last string) string {\n154\t+\tlines := []string{first}\n155\t+\tfor i := 1; i < 19; i++ {\n156\t+\t\tlines = append(lines, \"line \"+strconv.Itoa(i))\n157\t+\t}\n158\t+\treturn strings.Join(append(lines, last), \"\\n\") + \"\\n\"\n159\t+}\n160\t+\n161\t+func TestPatchEqualSharedFileKeepsReviewCovered(t *testing.T) {\n162\t+\tsetup := func(t *testing.T, protected bool) (*harness, pr) {\n163\t+\t\th := newHarness(t)\n164\t+\t\th.commit(\"main\", \"shared.md\", sharedBody(\"a\", \"z\"))\n165\t+\t\tpath := \"shared.md\"\n166\t+\t\tif protected {\n167\t+\t\t\tpath = \".github/shared.md\"\n168\t+\t\t\th.commit(\"main\", path, sharedBody(\"a\", \"z\"))\n