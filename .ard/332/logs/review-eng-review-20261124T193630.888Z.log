 base string, issue int) (bool, []string, error) {\n+\tc, err := cover(ctx, g, nil, repoDir, reviewed, head, base, issue)\n+\treturn c.OK, c.Broken, err\n+}\n+\n+// PatchGit is the part of *gitx.Git CoversDetail adds to Git.\n+type PatchGit interface {\n+\tGit\n+\tMergeBase(ctx context.Context, repoDir, a, b string) (string, error)\n+\tParents(ctx context.Context, repoDir, rev string) ([]string, error)\n+\tPatchID(ctx context.Context, repoDir, from, to, path string) (string, error)\n+}\n+\n+// Cover is the outcome of CoversDetail.\n+type Cover struct {\n+\tOK         bool\n+\tBroken     []string // paths that break the cover\n+\tPatchEqual []string // paths both sides changed whose PR patch is unchanged\n+}\n+\n+// CoversDetail is Covers with one more rule for base != \"\": a path both the PR\n+// and main changed is still covered when the PR's own patch to it (stable\n+// patch id of the diff from the merge base) is the same before and after the\n+// update. That needs head to reach reviewed along first parents through\n+// two-parent merges only (update-branch merges). Any git error fails closed.\n+func CoversDetail(ctx context.Context, g PatchGit, repoDir, reviewed, head, base string, issue int) (Cover, error) {\n+\treturn cover(ctx, g, g, repoDir, reviewed, head, base, issue)\n+}\n+\n+// maxChain caps the update-branch merges walked from head back to reviewed.\n+const maxChain = 100\n+\n+// firstUpdateMerge walks first parents from head to reviewed. It returns the\n+// merge whose first parent is reviewed, or \"\" when head is not reached only\n+// through two-parent merges.\n+func firstUpdateMerge(ctx context.Context, g PatchGit, repoDir, reviewed, head string) (string, error) {\n+\tcur := head\n+\tfor i := 0; i < maxChain; i++ {\n+\t\tps, err := g.Parents(ctx, repoDir, cur)\n+\t\tif err != nil {\n+\t\t\treturn \"\", err\n+\t\t}\n+\t\tif len(ps) != 2 {\n+\t\t\treturn \"\", nil\n+\t\t}\n+\t\tif ps[0] == reviewed {\n+\t\t\treturn ps[1], nil\n+\t\t}\n+\t\tcur = ps[0]\n+\t}\n+\treturn \"\", nil\n+}\n+\n+func cover(ctx context.Context, g Git, pg PatchGit, repoDir, reviewed, head, base string, issue int) (Cover, error) {\n \tif reviewed == \"\" || head == \"\" {\n-\t\treturn false, nil, nil\n+\t\treturn Cover{}, nil\n \t}\n \tif reviewed == head {\n-\t\treturn true, nil, nil\n+\t\treturn Cover{OK: true}, nil\n \t}\n \tsince, err := g.CodeChanged(ctx, repoDir, reviewed, head)\n \tif err != nil {\n-\t\treturn false, nil, err\n+\t\treturn Cover{}, err\n \t}\n \tsince = dropIssuePaths(since, issue)\n \tif len(since) == 0 {\n-\t\treturn true, nil, nil\n+\t\treturn Cover{OK: true}, nil\n \t}\n \tif base == \"\" {\n-\t\treturn false, since, nil\n+\t\treturn Cover{Broken: since}, nil\n \t}\n \town, err := g.CodeChanged(ctx, repoDir, base, head)\n \tif err != nil {\n-\t\treturn false, nil, err\n+\t\treturn Cover{}, err\n \t}\n \townSet := make(map[string]bool, len(own))\n \tfor _, p := range own {\n@@ -134,7 +187,38 @@ func Covers(ctx context.Context, g Git, repoDir, reviewed, head, base string, is\n \t\t\tbroken = append(broken, p)\n \t\t}\n \t}\n-\treturn len(broken) == 0, broken, nil\n+\tif len(broken) == 0 || pg == nil {\n+\t\treturn Cover{OK: len(broken) == 0, Broken: broken}, nil\n+\t}\n+\tsecond, err := firstUpdateMerge(ctx, pg, repoDir, reviewed, head)\n+\tif err != nil {\n+\t\treturn Cover{}, err\n+\t}\n+\tif second == \"\" {\n+\t\treturn Cover{Broken: broken}, nil\n+\t}\n+\toldBase, err := pg.MergeBase(ctx, repoDir, reviewed, second)\n+\tif err != nil {\n+\t\treturn Cover{}, err\n+\t}\n+\tvar c Cover\n+\tfor _, p := range broken {\n+\t\ta, err := pg.PatchID(ctx, repoDir, oldBase, reviewed, p)\n+\t\tif err != nil {\n+\t\t\treturn Cover{}, err\n+\t\t}\n+\t\tb, err := pg.PatchID(ctx, repoDir, base, head, p)\n+\t\tif err != nil {\n+\t\t\treturn Cover{}, err\n+\t\t}\n+\t\tif a == b {\n+\t\t\tc.PatchEqual = append(c.PatchEqual, p)\n+\t\t} else {\n+\t\t\tc.Broken = append(c.Broken, p)\n+\t\t}\n+\t}\n+\tc.OK = len(c.Broken) == 0\n+\treturn c, nil\n }\n \n func dropIssuePaths(paths []string, issue int) []string {\ndiff --git a/internal/prgate/prgate_test.go b/internal/prgate/prgate_test.go\nindex 2462eaf..b26f1cc 100644\n--- a/internal/prgate/prgate_test.go\n+++ b/internal/prgate/prgate_test.go\n@@ -240,3 +240,163 @@ func TestReviewedHeads(t *testing.T) {\n \t\tt.Errorf(\"got %v, want %v\", got, want)\n \t}\n }\n+\n+// patchRepo builds a PR branch that edited a 40-line file, reviewed, with main\n+// editing the other end of the file (or the same line when conflict is set).\n+type patchRepo struct {\n+\tt   *testing.T\n+\tdir string\n+\trun func(args ...string) string\n+\tput func(path, body string)\n+}\n+\n+func newPatchRepo(t *testing.T) *patchRepo {\n+\t_, dir := gittest.NewRemote(t)\n+\tr := &patchRepo{t: t, dir: dir}\n+\tr.run = func(args ...string) string { return strings.TrimSpace(gittest.Run(t, dir, args...)) }\n+\tr.put = func(path, body string) {\n+\t\tt.Helper()\n+\t\tif err := os.WriteFile(filepath.Join(dir, path), []byte(body), 0o644); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tr.run(\"add\", path)\n+\t}\n+\treturn r\n+}\n+\n+func docBody(first, last string) string {\n+\tvar sb strings.Builder\n+\tsb.WriteString(first + \"\\n\")\n+\tfor i := 0; i < 30; i++ {\n+\t\tsb.WriteString(\"line\\n\")\n+\t}\n+\tsb.WriteString(last + \"\\n\")\n+\treturn sb.String()\n+}\n+\n+// setup returns the reviewed SHA; the PR edits the last line, main is left on\n+// the main branch checked out.\n+func (r *patchRepo) setup() string {\n+\tr.put(\"doc.md\", docBody(\"a\", \"z\"))\n+\tr.run(\"commit\", \"-q\", \"-m\", \"base\")\n+\tr.run(\"checkout\", \"-q\", \"-b\", \"worker/eng-1-x\")\n+\tr.put(\"doc.md\", docBody(\"a\", \"PR\"))\n+\tr.run(\"commit\", \"-q\", \"-m\", \"pr\")\n+\treviewed := r.run(\"rev-parse\", \"HEAD\")\n+\tr.run(\"checkout\", \"-q\", \"main\")\n+\treturn reviewed\n+}\n+\n+func (r *patchRepo) mainEdit(first string) {\n+\tr.run(\"checkout\", \"-q\", \"main\")\n+\tbody, _ := os.ReadFile(filepath.Join(r.dir, \"doc.md\"))\n+\tlines := strings.SplitN(string(body), \"\\n\", 2)\n+\tr.put(\"doc.md\", first+\"\\n\"+lines[1])\n+\tr.run(\"commit\", \"-q\", \"-m\", \"main edit\")\n+}\n+\n+func (r *patchRepo) cover(reviewed string) (Cover, error) {\n+\thead := r.run(\"rev-parse\", \"HEAD\")\n+\tbase := r.run(\"merge-base\", \"main\", head)\n+\treturn CoversDetail(context.Background(), gitx.New(\"\"), r.dir, reviewed, head, base, 1)\n+}\n+\n+func TestCoversPatchEqualSharedFile(t *testing.T) {\n+\tr := newPatchRepo(t)\n+\treviewed := r.setup()\n+\tr.mainEdit(\"main1\")\n+\tr.run(\"checkout\", \"-q\", \"worker/eng-1-x\")\n+\tr.run(\"merge\", \"-q\", \"--no-edit\", \"main\")\n+\tc, err := r.cover(reviewed)\n+\tif err != nil || !c.OK || !reflect.DeepEqual(c.PatchEqual, []string{\"doc.md\"}) {\n+\t\tt.Fatalf(\"got %+v %v, want covered by patch id\", c, err)\n+\t}\n+\t// A second clean update-branch merge.\n+\tr.mainEdit(\"main2\")\n+\tr.run(\"checkout\", \"-q\", \"worker/eng-1-x\")\n+\tr.run(\"merge\", \"-q\", \"--no-edit\", \"main\")\n+\tif c, err = r.cover(reviewed); err != nil || !c.OK {\n+\t\tt.Fatalf(\"chain of merges: %+v %v\", c, err)\n+\t}\n+\t// The PR changes the file again after the clean merge.\n+\tr.put(\"doc.md\", docBody(\"main2\", \"PR2\"))\n+\tr.run(\"commit\", \"-q\", \"-m\", \"again\")\n+\tif c, err = r.cover(reviewed); err != nil || c.OK || !reflect.DeepEqual(c.Broken, []string{\"doc.md\"}) {\n+\t\tt.Fatalf(\"pr changes again: %+v %v\", c, err)\n+\t}\n+}\n+\n+func TestCoversConflictResolved(t *testing.T) {\n+\tr := newPatchRepo(t)\n+\treviewed := r.setup()\n+\tr.run(\"checkout\", \"-q\", \"main\")\n+\tr.put(\"doc.md\", docBody(\"a\", \"MAIN\"))\n+\tr.run(\"commit\", \"-q\", \"-m\", \"main edit\")\n+\tr.run(\"checkout\", \"-q\", \"worker/eng-1-x\")\n+\tr.run(\"merge\", \"-q\", \"--no-commit\", \"--no-ff\", \"-s\", \"ours\", \"main\") // stands in for a conflicting merge\n+\tr.put(\"doc.md\", docBody(\"a\", \"RESOLVED\"))\n+\tr.run(\"commit\", \"-q\", \"-m\", \"merge resolved\")\n+\tc, err := r.cover(reviewed)\n+\tif err != nil || c.OK || !reflect.DeepEqual(c.Broken, []string{\"doc.md\"}) {\n+\t\tt.Fatalf(\"conflict resolved: %+v %v\", c, err)\n+\t}\n+}\n+\n+func TestCoversHandEditInMerge(t *testing.T) {\n+\tr := newPatchRepo(t)\n+\treviewed := r.setup()\n+\tr.mainEdit(\"main1\")\n+\tr.run(\"checkout\", \"-q\", \"worker/eng-1-x\")\n+\tr.run(\"merge\", \"-q\", \"--no-commit\", \"--no-ff\", \"main\")\n+\tr.put(\"doc.md\", docBody(\"main1\", \"HAND\"))\n+\tr.run(\"commit\", \"-q\", \"-m\", \"merge with edit\")\n+\tc, err := r.cover(reviewed)\n+\tif err != nil || c.OK || !reflect.DeepEqual(c.Broken, []string{\"doc.md\"}) {\n+\t\tt.Fatalf(\"hand edit: %+v %v\", c, err)\n+\t}\n+}\n+\n+type errPatchGit struct {\n+\tGit\n+\tmbErr, parErr, patchErr error\n+}\n+\n+func (g errPatchGit) MergeBase(context.Context, string, string, string) (string, error) {\n+\treturn \"ob\", g.mbErr\n+}\n+func (g errPatchGit) Parents(context.Context, string, string) ([]string, error) {\n+\treturn []string{\"rev\", \"main\"}, g.parErr\n+}\n+func (g errPatchGit) PatchID(context.Context, string, string, string, string) (string, error) {\n+\treturn \"id\", g.patchErr\n+}\n+\n+func TestCoversPatchGitError(t *testing.T) {\n+\tboom := errors.New(\"boom\")\n+\tfg := fakeGit{diffs: map[[2]string][]string{\n+\t\t{\"rev\", \"head\"}:  {\"doc.md\"},\n+\t\t{\"base\", \"head\"}: {\"doc.md\"},\n+\t}}\n+\tfor name, g := range map[string]errPatchGit{\n+\t\t\"ok\":      {Git: fg},\n+\t\t\"mb\":      {Git: fg, mbErr: boom},\n+\t\t\"parents\": {Git: fg, parErr: boom},\n+\t\t\"patch\":   {Git: fg, patchErr: boom},\n+\t} {\n+\t\tc, err := CoversDetail(context.Background(), g, \"\", \"rev\", \"head\", \"base\", 1)\n+\t\tif name == \"ok\" {\n+\t\t\tif err != nil || !c.OK {\n+\t\t\t\tt.Errorf(\"%s: %+v %v\", name, c, err)\n+\t\t\t}\n+\t\t\tcontinue\n+\t\t}\n+\t\tif err != boom || c.OK {\n+\t\t\tt.Errorf(\"%s: %+v %v, want boom and not covered\", name, c, err)\n+\t\t}\n+\t}\n+\t// base \"\" never uses the rule.\n+\tc, err := CoversDetail(context.Background(), errPatchGit{Git: fg, patchErr: boom}, \"\", \"rev\", \"head\", \"\", 1)\n+\tif err != nil || c.OK || len(c.PatchEqual) != 0 {\n+\t\tt.Errorf(\"base empty: %+v %v\", c, err)\n+\t}\n+}\n","numLines":569,"startLine":1,"totalLines":569}},"tool_result_meta":[{"id":"toolu_01FA1xj78yrGZqDw5qGaBzvF","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
