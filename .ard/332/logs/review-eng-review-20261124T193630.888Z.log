6dd2631\n\n docs/proposal.md               |   2 +-\n internal/gitx/inspect.go       |  36 ++++++++++\n internal/gitx/inspect_test.go  |  59 +++++++++++++++\n internal/merger/loop.go        |   3 +\n internal/merger/loop_test.go   |  66 +++++++++++++++++\n internal/merger/merge.go       |  15 ++--\n internal/prgate/prgate.go      |  98 +++++++++++++++++++++++--\n internal/prgate/prgate_test.go | 160 +++++++++++++++++++++++++++++++++++++++++\n 8 files changed, 427 insertions(+), 12 deletions(-)\n\ndiff --git a/docs/proposal.md b/docs/proposal.md\nindex f0eb702..36c06b2 100644\n--- a/docs/proposal.md\n+++ b/docs/proposal.md\n@@ -377,7 +377,7 @@ The merger is controller code, not an agent, and takes no job slot. Every 5 minu\n \n Only ready (non-draft) PRs the App opened on `worker/<role>-<issue#>-<slug>` with base `main` are candidates. The reviewer loop marks a PR ready, but the merger re-checks everything itself and never trusts the draft flag, because a person can mark a PR ready by hand. A PR merges when all of these hold:\n \n-- every requested `ard:review:<role>` is `:done` and none is `:changes` or `:running` (any `ard:review:*:changes` or `:running` label blocks, configured role or not), and each review is proven by the newest close-out record of that role on this PR (outcome done, head not moved), not by the label, which a person with triage access can add, and stands at a head that still covers the current one. The head rule is shared with the reviewer's mark-ready (`internal/prgate`): a head is covered when no path outside `.ard/<issue#>/` changed since the reviewed commit, or, for the merger, when every such path came from `main` (an update-branch merge does not invalidate a review, but a path both the PR and `main` changed since the review does). A review made stale by code that changed since it is re-requested once per head: the merger removes `ard:review:<role>:done` (the reviewer then claims the role again at the current head), records a `review_rerequest` event for that PR and head, and logs `merge.review_rerequested`. A head that moved only by an update-branch merge from `main` is still covered and triggers nothing. Under dry-run it logs `merge.would_rerequest` and writes only to the ledger, with no event\n+- every requested `ard:review:<role>` is `:done` and none is `:changes` or `:running` (any `ard:review:*:changes` or `:running` label blocks, configured role or not), and each review is proven by the newest close-out record of that role on this PR (outcome done, head not moved), not by the label, which a person with triage access can add, and stands at a head that still covers the current one. The head rule is shared with the reviewer's mark-ready (`internal/prgate`): a head is covered when no path outside `.ard/<issue#>/` changed since the reviewed commit, or, for the merger, when every such path came from `main` (an update-branch merge does not invalidate a review, but a path both the PR and `main` changed since the review does, unless the PR's own patch to that path is unchanged: the stable patch id of the diff from the merge base is identical before and after the update, the head reaches the reviewed commit along first parents through two-parent merges only, and no git step failed. A conflict resolution, a hand edit or a later PR commit changes the patch and breaks the cover, and any git error is not covered. The merger logs the paths covered this way as `merge.cover_patch_equal`; the reviewer's mark-ready and reviewfix landing keep the plain rule). A review made stale by code that changed since it is re-requested once per head: the merger removes `ard:review:<role>:done` (the reviewer then claims the role again at the current head), records a `review_rerequest` event for that PR and head, and logs `merge.review_rerequested`. A head that moved only by an update-branch merge from `main` is still covered and triggers nothing. Under dry-run it logs `merge.would_rerequest` and writes only to the ledger, with no event\n - it carries none of `ard:hold`, `ard:needs-human`, `ard:tests:failed` or `ard:executor:failed`, its issue is open and carries neither `ard:hold` nor `ard:needs-human`, and no worker or review job of the issue is running\n - the first line of the PR body is exactly `Closes #<issue>` (what the worker writes; it is what closes the issue) and the state records a worker job of the issue on this branch (its id is the `Ard-Job` trailer). Otherwise the PR gets `ard:needs-human`\n - GitHub has computed that the branch does not conflict with `main`. Only a computed `mergeable: false` or `mergeable_state: dirty` is a conflict: it gets `ard:needs-human` and one comment, and a follow-up to #41 will turn this into a rebase round (`reviewfix.RequestRound`) that counts toward `max_review_rounds`. A `mergeable` that is still null or unknown, and a 405 \"not mergeable\" from the merge call, mean GitHub is still computing: the merger retries next tick and never labels\ndiff --git a/internal/gitx/inspect.go b/internal/gitx/inspect.go\nindex 9ad7501..e9a3027 100644\n--- a/internal/gitx/inspect.go\n+++ b/internal/gitx/inspect.go\n@@ -69,3 +69,39 @@ func (g *Git) MergeBase(ctx context.Context, repoDir, a, b string) (string, erro\n \t}\n \treturn strings.TrimSpace(out), nil\n }\n+\n+// Parents returns the parent commits of rev (none for a root commit).\n+func (g *Git) Parents(ctx context.Context, repoDir, rev string) ([]string, error) {\n+\tout, _, err := g.run(ctx, repoDir, nil, \"\", nil, \"--git-dir=\"+gitDirOf(repoDir), \"rev-list\", \"--parents\", \"-n\", \"1\", rev)\n+\tif err != nil {\n+\t\treturn nil, fmt.Errorf(\"gitx: parents %.12s: %w\", rev, err)\n+\t}\n+\tf := strings.Fields(out)\n+\tif len(f) == 0 {\n+\t\treturn nil, fmt.Errorf(\"gitx: parents %.12s: no output\", rev)\n+\t}\n+\treturn f[1:], nil\n+}\n+\n+// PatchID returns the stable patch id (git patch-id --stable) of the change to\n+// path between commits from and to. An empty diff is an error: there is\n+// nothing to compare.\n+func (g *Git) PatchID(ctx context.Context, repoDir, from, to, path string) (string, error) {\n+\tenv := []string{\"GIT_ATTR_SOURCE=\" + emptyTree, \"GIT_OPTIONAL_LOCKS=0\"}\n+\tdiff, _, err := g.run(ctx, repoDir, env, \"\", nil, \"--git-dir=\"+gitDirOf(repoDir), \"diff\", \"--no-ext-diff\", \"--no-textconv\", \"--no-renames\", from, to, \"--\", path)\n+\tif err != nil {\n+\t\treturn \"\", fmt.Errorf(\"gitx: patch diff %.12s %.12s: %w\", from, to, err)\n+\t}\n+\tif strings.TrimSpace(diff) == \"\" {\n+\t\treturn \"\", fmt.Errorf(\"gitx: patch id %.12s %.12s %s: empty diff\", from, to, path)\n+\t}\n+\tout, _, err := g.run(ctx, repoDir, nil, diff, nil, \"--git-dir=\"+gitDirOf(repoDir), \"patch-id\", \"--stable\")\n+\tif err != nil {\n+\t\treturn \"\", fmt.Errorf(\"gitx: patch-id: %w\", err)\n+\t}\n+\tf := strings.Fields(out)\n+\tif len(f) == 0 {\n+\t\treturn \"\", fmt.Errorf(\"gitx: patch-id %.12s %.12s %s: no output\", from, to, path)\n+\t}\n+\treturn f[0], nil\n+}\ndiff --git a/internal/gitx/inspect_test.go b/internal/gitx/inspect_test.go\nindex 26b6a71..0d4e9be 100644\n--- a/internal/gitx/inspect_test.go\n+++ b/internal/gitx/inspect_test.go\n@@ -469,3 +469,62 @@ func TestChangedPathsRenames(t *testing.T) {\n \t\tt.Errorf(\"paths = %v, want %v\", got, want)\n \t}\n }\n+\n+func TestPatchIDAndParents(t *testing.T) {\n+\t_, dir := gittest.NewRemote(t)\n+\tg := New(\"\")\n+\tctx := context.Background()\n+\trun := func(args ...string) string { return strings.TrimSpace(gittest.Run(t, dir, args...)) }\n+\tbody := func(first, last string) []byte {\n+\t\treturn []byte(first + \"\\n\" + strings.Repeat(\"x\\n\", 30) + last + \"\\n\")\n+\t}\n+\twrite := func(b []byte) {\n+\t\tif err := os.WriteFile(filepath.Join(dir, \"f.txt\"), b, 0o644); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\trun(\"add\", \"f.txt\")\n+\t}\n+\twrite(body(\"a\", \"z\"))\n+\trun(\"commit\", \"-q\", \"-m\", \"one\")\n+\tc1 := run(\"rev-parse\", \"HEAD\")\n+\twrite(body(\"a\", \"Z\"))\n+\trun(\"commit\", \"-q\", \"-m\", \"two\")\n+\tc2 := run(\"rev-parse\", \"HEAD\")\n+\twrite(body(\"A\", \"Z\"))\n+\trun(\"commit\", \"-q\", \"-m\", \"three\")\n+\tc3 := run(\"rev-parse\", \"HEAD\")\n+\t// The same change to the last line at shifted offsets.\n+\twrite([]byte(\"new\\nnew\\n\" + string(body(\"A\", \"Z\"))))\n+\trun(\"commit\", \"-q\", \"-m\", \"shift\")\n+\tc4 := run(\"rev-parse\", \"HEAD\")\n+\twrite([]byte(\"new\\nnew\\n\" + string(body(\"A\", \"Q\"))))\n+\trun(\"commit\", \"-q\", \"-m\", \"other\")\n+\tc5 := run(\"rev-parse\", \"HEAD\")\n+\n+\ta, err := g.PatchID(ctx, dir, c1, c2, \"f.txt\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif b, err := g.PatchID(ctx, dir, c1, c2, \"f.txt\"); err != nil || a != b {\n+\t\tt.Fatalf(\"same diff: %q %q %v\", a, b, err)\n+\t}\n+\tif b, err := g.PatchID(ctx, dir, c3, c4, \"f.txt\"); err != nil || a == b {\n+\t\tt.Fatalf(\"different diff must differ: %q %q %v\", a, b, err)\n+\t}\n+\tif b, err := g.PatchID(ctx, dir, c4, c5, \"f.txt\"); err != nil || a == b {\n+\t\tt.Fatalf(\"changed line must differ: %q %q %v\", a, b, err)\n+\t}\n+\tif _, err := g.PatchID(ctx, dir, c1, c1, \"f.txt\"); err == nil {\n+\t\tt.Error(\"empty diff: want error\")\n+\t}\n+\tif _, err := g.PatchID(ctx, dir, c1, \"nope\", \"f.txt\"); err == nil {\n+\t\tt.Error(\"bad rev: want error\")\n+\t}\n+\tps, err := g.Parents(ctx, dir, c2)\n+\tif err != nil || len(ps) != 1 || ps[0] != c1 {\n+\t\tt.Fatalf(\"parents = %v %v\", ps, err)\n+\t}\n+\tif _, err := g.Parents(ctx, dir, \"nope\"); err == nil {\n+\t\tt.Error(\"parents of bad rev: want error\")\n+\t}\n+}\ndiff --git a/internal/merger/loop.go b/internal/merger/loop.go\nindex e3cb89d..638d1b6 100644\n--- a/internal/merger/loop.go\n+++ b/internal/merger/loop.go\n@@ -63,6 +63,9 @@ type Git interface {\n \tFetchRef(ctx context.Context, repoDir, url, refspec string, token gitx.TokenFunc) error\n \tRevParse(ctx context.Context, dir, ref string) (string, error)\n \tMergeBaseAll(ctx context.Context, 