mit\", \"-q\", \"-m\", \"merge with edit\")\n\t\th.git(\"push\", \"-q\", \"-f\", h.bare, p.branch)\n\t\th.gh.SetHeadSHA(p.n, h.git(\"rev-parse\", \"HEAD\"))\n\t\th.settle()\n\t\tout := h.mustTick()\n\t\tif h.merged(p.n) || h.rerequests() != 1 || strings.Contains(out, \"merge.cover_patch_equal\") {\n\t\t\tt.Fatalf(\"merged = %v rerequests = %d\\n%s\", h.merged(p.n), h.rerequests(), out)\n\t\t}\n\t})\n\tt.Run(\"approval check\", func(t *testing.T) {\n\t\th, p := setup(t, true)\n\t\th.gh.SetPermission(\"alice\", github.Permission{Level: \"write\", Role: \"write\"})\n\t\th.gh.SeedReview(p.n, github.Review{Author: \"alice\", State: \"APPROVED\", CommitSHA: p.head})\n\t\th.updateBranch(p.n, p.branch)\n\t\th.settle()\n\t\th.mustTick()\n\t\th.now = h.now.Add(3 * time.Minute)\n\t\th.mustTick()\n\t\tif !h.merged(p.n) || !strings.Contains(h.logs.String(), \"merge.cover_patch_equal\") {\n\t\t\tt.Fatalf(\"merged = %v labels %v\\n%s\", h.merged(p.n), h.labelsOf(p.n), h.logs.String())\n\t\t}\n\t})\n}\nEOF\ngofmt -l .; go test . 2>&1 | tail -30"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1746,"cache_read_input_tokens":21708,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1746},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"867f6124-c726-4d6f-90ba-727b8e99dcca","uuid":"05636948-861f-4186-bff1-fd924a06c7f2","timestamp":"2026-11-24T18:49:32.090Z","request_id":"req_011ChNFgVFE8ox3ikU9qtzgs"}
