he copy embedded in ard; \" + workflowFix)\n\t}\n\treturn Row{Name: workflowName, Status: StatusOK, Detail: \"matches the copy embedded in ard\"}\n}\n\n// botLoginRow is the result of the ARD_BOT_LOGIN check: the row, the value\n// to write (empty when nothing is to be written) and whether the existing\n// value differs and so needs confirmation.\ntype botLogin struct {\n\trow     Row\n\twant    string\n\treplace bool\n}\n\nfunc setCmd(d Deps, want string) string {\n\treturn fmt.Sprintf(\"gh variable set %s -R %s --body %s\", botLoginVar, d.Repo, want)\n}\nEOF\ngrep -n \"func (g \\*Git) FileAt\" -B6 -A25 internal/gitx/local.go"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":152,"cache_read_input_tokens":48222,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":152},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c27803e8-8eaa-4bd3-a933-2e231528c769","uuid":"c5416c30-a47b-435e-8683-3851a72f9965","timestamp":"2026-11-26T08:50:24.381Z","request_id":"req_011ChRFcqG9spzgno18m9pVx"}
