n \"\", err\n\t\t}\n\t\treturn ta.Value, nil\n\t}\n}\n\n// confirm asks a yes/no question on a terminal. Without a terminal it\n// answers no, so a run never blocks or overwrites silently.\nfunc confirm(in *os.File, out io.Writer) func(string) (bool, error) {\n\treturn func(prompt string) (bool, error) {\n\t\tfi, err := in.Stat()\n\t\tif err != nil || fi.Mode()&os.ModeCharDevice == 0 {\n\t\t\treturn false, nil\n\t\t}\n\t\tfmt.Fprintf(out, \"%s [y/N] \", prompt)\n\t\tline, err := bufio.NewReader(in).ReadString('\\\\n')\n\t\tif err != nil && line == \"\" {\n\t\t\treturn false, err\n\t\t}\n\t\ta := strings.ToLower(strings.TrimSpace(line))\n\t\treturn a == \"y\" || a == \"yes\", nil\n\t}\n}\n'''\ns=s.replace('import (\\n\\t\"context\"','import (\\n\\t\"bufio\"\\n\\t\"context\"').replace('\\t\"fmt\"\\n','\\t\"fmt\"\\n\\t\"io\"\\n',1).replace('\\t\"os\"\\n','\\t\"os\"\\n\\t\"os/exec\"\\n',1)\nopen(p,'w').write(s)\n\np='internal/cli/app.go'\ns=open(p).read()\ns=s.replace(\"\tForce       bool   // --force: overwrite an existing key file\\n\",\"\tForce       bool   // --force: overwrite an existing key file\\n\tPrintWorkflow bool // --print-workflow: print the embedded bot-commits workflow and exit\\n\")\nopen(p,'w').write(s)\np='internal/cli/cmd_setup.go'\ns=open(p).read()\ns=s.replace(\"\"\"\t\t\t\tif o.CreateGHApp && o.Check {\"\"\",\"\"\"\t\t\t\tif o.PrintWorkflow && (o.Check || o.CreateGHApp || o.AppName != \"\" || o.KeyFile != \"\" || o.Force) {\n\t\t\t\t\treturn fmt.Errorf(\"setup: --print-workflow cannot be combined with other flags\")\n\t\t\t\t}\n\t\t\t\tif o.CreateGHApp && o.Check {\"\"\")\ns=s.replace(\"\"\"\tf.BoolVar(&o.Force\"\"\",\"\"\"\tf.BoolVar(&o.PrintWorkflow, \"print-workflow\", false, \"print the bot-commits workflow embedded in ard and exit\")\n\tf.BoolVar(&o.Force\"\"\")\nopen(p,'w').write(s)\nEOF\ngofmt -w internal/setupcmd internal/cli/app.go; go build ./... 2>&1 | grep -v downloading; go test ./internal/setupcmd ./internal/cli ./internal/effects/..