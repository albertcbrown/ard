able\", 0, err, \"repo\", repo)\n\t}\n\tif !varNameRE.MatchString(name) {\n\t\treturn l.done(ctx, \"SetRepoVariable\", 0, fmt.Errorf(\"invalid variable name %q\", name), \"repo\", repo)\n\t}\n\tif l.operatorToken == nil {\n\t\treturn l.done(ctx, \"SetRepoVariable\", 0, ErrNoOperatorToken, \"repo\", repo, \"name\", name)\n\t}\n\ttok, err := l.operatorToken(ctx)\n\tif err != nil || tok == \"\" {\n\t\treturn l.done(ctx, \"SetRepoVariable\", 0, ErrNoOperatorToken, \"repo\", repo, \"name\", name)\n\t}\n\tcfg := l.ghCfg\n\tcfg.Repo = github.Repo{Owner: owner, Name: rname}\n\tcfg.Auth = github.NewTokenAuth(tok)\n\tcfg.ReadOnly = false\n\tc, err := github.New(cfg)\n\tif err != nil {\n\t\treturn l.done(ctx, \"SetRepoVariable\", 0, err, \"repo\", repo, \"name\", name)\n\t}\n\treturn l.done(ctx, \"SetRepoVariable\", 0, c.SetVariable(ctx, name, value), \"repo\", repo, \"name\", name, \"value_len\", len(value))\n}\n\n// SetRepoVariable records the call and writes nothing.\nfunc (d *DryRun) SetRepoVariable(ctx context.Context, repo, name, value string) error {\n\t_, err := d.emit(ctx, \"SetRepoVariable\", repo, map[string]any{\"name\": name, \"value\": value}, false, nil)\n\treturn err\n}\nEOF\npython3 - <<'EOF'\nimport re\np='internal/effects/effects.go'\ns=open(p).read()\ns=s.replace(\"\"\"\t// DryRun reports\"\"\",\"\"\"\t// SetRepoVariable creates or updates an Actions variable of repo\n\t// (owner/name) with the operator's token (Options.OperatorToken). Like\n\t// ApproveIssue it is outside github.Writer, so the App client cannot reach\n\t// it. ErrNoOperatorToken means no token was available.\n\tSetRepoVariable(ctx context.Context, repo, name, value string) error\n\t// DryRun reports\"\"\")\nopen(p,'w').write(s)\np='internal/effects/live.go'\ns=open(p).read()\ns=s.replace(\"\tlog *slog.Logger\\n}\",\"\tlog *slog.Logger\\n\\n\toperatorToken func(ctx context.Context) (string, error)\\n\tghCfg         github.Config // base URL and transport for operator-token calls\\n}\",1)\ns=s.replace(\"func (l *Live) DryRun()\",\"\"\"// WithOperator sets how SetRepoVariable gets the operator's token and the\n// client settings (base URL) it uses. It returns l.\nfunc (l *Live) WithOperator(tok func(ctx context.Context) (string, error), cfg github.Config) *Live {\n\tl.operatorToken, l.ghCfg = tok, cfg\n\treturn l\n}\n\nfunc (l *Live) DryRun()\"\"\",1)\nopen(p,'w').write(s)\np='internal/effects/open.go'\ns=open(p).read()\ns=s.replace(\"\tRedact \",\"\t// OperatorToken returns the operator's own token for SetRepoVariable. It\\n\t// is called only then and never stored.\\n\tOperatorToken func(ctx context.Context) (string, error)\\n\tRedact \",1)\ns=s.replace(\"return NewLive(client, g, o.Log), readOnly\",\"return NewLive(client, g, o.Log).WithOperator(o.OperatorToken, o.GitHub), readOnly\")\nopen(p,'w').write(s)\nEOF\ngofmt -l internal; go build ./... 2>&1 | head -20"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2811,"cache_read_input_tokens":42448,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2811},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c27803e8-8eaa-4bd3-a933-2e231528c769","uuid":"e3074212-7c43-4fd7-b595-5a8d8415f874","timestamp":"2026-11-26T08:49:55.925Z","request_id":"req_011ChRFaHRvUMTuU2Y1MMeHb"}
