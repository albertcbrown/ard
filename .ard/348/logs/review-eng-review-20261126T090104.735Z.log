{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018kzKmH3nqKrvnsouCqfoWr","type":"tool_result","content":"package effects\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"regexp\"\n\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/repopath\"\n)\n\n// ErrNoOperatorToken is returned by SetRepoVariable when the operator's token\n// is not available. The App cannot write Actions variables.\nvar ErrNoOperatorToken = errors.New(\"effects: no operator token to write a repository variable; \" +\n\t\"set ARD_GITHUB_TOKEN to a personal access token or run: gh auth login\")\n\nvar varNameRE = regexp.MustCompile(`^[A-Z][A-Z0-9_]*$`)\n\n// SetRepoVariable creates or updates an Actions variable of repo\n// (owner/name) with the operator's token. The token is read once per call,\n// held in memory, and never logged.\nfunc (l *Live) SetRepoVariable(ctx context.Context, repo, name, value string) error {\n\towner, rname, err := repopath.Parts(repo)\n\tif err != nil {\n\t\treturn l.done(ctx, \"SetRepoVariable\", 0, err, \"repo\", repo)\n\t}\n\tif !varNameRE.MatchString(name) {\n\t\treturn l.done(ctx, \"SetRepoVariable\", 0, fmt.Errorf(\"invalid variable name %q\", name), \"repo\", repo)\n\t}\n\tif l.operatorToken == nil {\n\t\treturn l.done(ctx, \"SetRepoVariable\", 0, ErrNoOperatorToken, \"repo\", repo, \"name\", name)\n\t}\n\ttok, err := l.operatorToken(ctx)\n\tif err != nil || tok == \"\" {\n\t\treturn l.done(ctx, \"SetRepoVariable\", 0, ErrNoOperatorToken, \"repo\", repo, \"name\", name)\n\t}\n\tcfg := l.ghCfg\n\tcfg.Repo = github.Repo{Owner: owner, Name: rname}\n\tcfg.Auth = github.NewTokenAuth(tok)\n\tcfg.ReadOnly = false\n\tc, err := github.New(cfg)\n\tif err != nil {\n\t\treturn l.done(ctx, \"SetRepoVariable\", 0, err, \"repo\", repo, \"name\", name)\n\t}\n\treturn l.done(ctx, \"SetRepoVariable\", 0, c.SetVariable(ctx, name, value), \"repo\", repo, \"name\", name, \"value_len\", len(value))\n}\n\n// SetRepoVariable records the call and writes nothing.\nfunc (d *DryRun) SetRepoVariable(ctx context.Context, repo, name, value string) error {\n\t_, err := d.emit(ctx, \"SetRepoVariable\", repo, map[string]any{\"name\": name, \"value\": value}, false, nil)\n\treturn err\n}\npackage setupcmd\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/effects\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n)\n\nconst botLoginVar = \"ARD_BOT_LOGIN\"\n\n// VariableWriter writes repository variables with the operator's token. The\n// effect layer implements it.\ntype VariableWriter interface {\n\tSetRepoVariable(ctx context.Context, repo, name, value string) error\n}\n\n// botLogin is the state of the ARD_BOT_LOGIN check.\ntype botLogin struct {\n\trow     Row\n\twant    string // the App's login; empty when it cannot be derived\n\treplace bool   // a different value exists and needs confirmation\n}\n\nfunc (d Deps) setCmd(want string) string {\n\treturn fmt.Sprintf(\"gh variable set %s -R %s --body %s\", botLoginVar, d.Repo, want)\n}\n\n// checkBotLogin compares ARD_BOT_LOGIN with the App's login. The wanted\n// value comes only from the authenticated identity, never from config.\nfunc checkBotLogin(ctx context.Context, d Deps) (botLogin, error) {\n\tmanual := func(detail string) botLogin {\n\t\treturn botLogin{row: Row{Name: botLoginVar, Status: StatusManual, Detail: detail}}\n\t}\n\tid, err := d.Policy.Identity(ctx)\n\tif err != nil {\n\t\treturn botLogin{}, fmt.Errorf(\"setup: identity: %w\", err)\n\t}\n\tif !strings.HasSuffix(id.Login, \"[bot]\") || id.Login == \"[bot]\" {\n\t\treturn manual(\"ard is not running as a GitHub App; \" + botLoginVar + \" needs the App's <slug>[bot] login\"), nil\n\t}\n\twant := id.Login\n\thave, found, err := d.Policy.GetVariable(ctx, botLoginVar)\n\tif err != nil {\n\t\tif errors.Is(err, github.ErrForbidden) || errors.Is(err, github.ErrNotFound) {\n\t\t\treturn manual(\"cannot read the variable; run: \" + d.setCmd(want)), nil\n\t\t}\n\t\treturn botLogin{}, fmt.Errorf(\"setup: read %s: %w\", botLoginVar, err)\n\t}\n\thave = strings.TrimSpace(have)\n\tswitch {\n\tcase !found || have == \"\":\n\t\treturn botLogin{row: Row{Name: botLoginVar, Status: StatusDrift, Detail: \"not set; will set to \" + want}, want: want}, nil\n\tcase have == want:\n\t\treturn botLogin{row: Row{Name: botLoginVar, Status: StatusOK, Detail: want}, want: want}, nil\n\t}\n\treturn botLogin{row: Row{Name: botLoginVar, Status: StatusDrift, Detail: fmt.Sprintf(\"is %s, App is %s\", have, want)}, want: want, replace: true}, nil\n}\n\n// applyBotLogin writes the variable. A different existing value is replaced\n// only when Confirm says yes. Failures become manual rows, never aborts.\nfunc applyBotLogin(ctx context.Context, d Deps, b botLogin) Row {\n\tmanual := func(why string) Row {\n\t\treturn Row{Name: botLoginVar, Status: StatusManual, Detail: why + \"; run: \" + d.setCmd(b.want)}\n\t}\n\tif d.Variables == nil {\n\t\treturn manual(\"no operator token available\")\n\t}\n\tif b.replace {\n\t\tok := false\n\t\tif d.Confirm != nil {\n\t\t\tvar err error\n\t\t\tok, err = d.Confirm(fmt.Sprintf(\"%s on %s is set to a different value (%s). Replace it with the App's login?\", botLoginVar, d.Repo, b.row.Detail))\n\t\t\tif err != nil {\n\t\t\t\tok = false\n\t\t\t}\n\t\t}\n\t\tif !ok {\n\t\t\treturn manual(b.row.Detail + \"; not replaced without confirmation\")\n\t\t}\n\t}\n\tif err := d.Variables.SetRepoVariable(ctx, d.Repo.String(), botLoginVar, b.want); err != nil {\n\t\tif errors.Is(err, effects.ErrNoOperatorToken) {\n\t\t\treturn manual(\"no operator token available (set ARD_GITHUB_TOKEN or run gh auth login)\")\n\t\t}\n\t\treturn manual(\"could not set the variable\")\n\t}\n\tr := Row{Name: botLoginVar, Status: StatusChanged, Detail: \"set to \" + b.want}\n\tif d.DryRun {\n\t\tr.Detail = \"would set to \" + b.want\n\t}\n\treturn r\n}\npackage setupcmd\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t_ \"embed\"\n\t\"io\"\n)\n\n// botCommitsWorkflow is a copy of .github/workflows/bot-commits.yml; a test\n// keeps the two equal. Setup prints it for a human to commit and never\n// commits or writes it.\n//\n//go:embed workflow/bot-commits.yml\nvar botCommitsWorkflow []byte\n\nconst (\n\tworkflowPath = \".github/workflows/bot-commits.yml\"\n\tworkflowName = \"workflow\"\n)\n\n// PrintWorkflow writes the embedded bot-commits workflow to w.\nfunc PrintWorkflow(w io.Writer) error {\n\t_, err := w.Write(botCommitsWorkflow)\n\treturn err\n}\n\nconst workflowFix = \"commit \" + workflowPath + \": run ard setup --print-workflow > \" + workflowPath + \", then open a PR\"\n\n// checkWorkflow compares the workflow on origin/main with the embedded copy.\n// It never fails: every problem is a manual row.\nfunc checkWorkflow(ctx context.Context, at func(ctx context.Context) ([]byte, bool, error)) Row {\n\tmanual := func(detail string) Row { return Row{Name: workflowName, Status: StatusManual, Detail: detail} }\n\tgot, found, err := at(ctx)\n\tswitch {\n\tcase err != nil:\n\t\treturn manual(\"could not read \" + workflowPath + \" on origin/main (fetch first?): \" + err.Error() + \"; \" + workflowFix)\n\tcase !found:\n\t\treturn manual(workflowPath + \" is not on origin/main; \" + workflowFix)\n\t}\n\tnorm := func(b []byte) []byte { return bytes.ReplaceAll(b, []byte(\"\\r\\n\"), []byte(\"\\n\")) }\n\tif !bytes.Equal(norm(got), norm(botCommitsWorkflow)) {\n\t\treturn manual(workflowPath + \" on origin/main differs from the copy embedded in ard; \" + workflowFix)\n\t}\n\treturn Row{Name: workflowName, Status: StatusOK, Detail: \"matches the copy embedded in ard\"}\n}\npackage setupcmd\n\nimport (\n\t\"bufio\"\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/cli\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/effects\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n\t\"github.com/albertcbrown/ard/internal/labels/labelsync\"\n)\n\n// Command is the handler behind `ard setup`. The config is loaded and\n// validated before any GitHub client exists.\nfunc Command(ctx context.Context, e *cli.Env, o cli.SetupOpts) error {\n\tif o.PrintWorkflow {\n\t\t// Nothing else may reach stdout, so a redirect to a file is clean.\n\t\treturn PrintWorkflow(e.Stdout)\n\t}\n\troot, err := config.RepoRoot(e.ConfigPath)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"setup: %w\", err)\n\t}\n\tres, err := config.Load(root)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"setup: %w\", err)\n\t}\n\twant, err := labels.Desired(labels.SpecFrom(res))\n\tif err != nil {\n\t\treturn err\n\t}\n\trepo, err := labelsync.ResolveRepo(ctx, e, root)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif o.CreateGHApp {\n\t\tif err := CreateApp(ctx, e, repo, CreateAppOpts{Name: o.AppName, KeyPath: o.KeyFile, Force: o.Force}); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif e.DryRun {\n\t\t\treturn nil\n\t\t}\n\t}\n\tauth, err := github.AuthFromEnv(os.Getenv, os.ReadFile)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"setup: %w\", err)\n\t}\n\tdry := e.DryRun && !o.Check\n\tfx, rd, err := effects.Open(ctx, effects.Options{\n\t\tDryRun:        dry,\n\t\tGitHub:        github.Config{Repo: repo, Auth: auth, Log: e.Log},\n\t\tOperatorToken: operatorToken(auth, e),\n\t\tLog:           e.Log,\n\t})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"setup: %w\", err)\n\t}\n\td := Deps{\n\t\tReader:      rd,\n\t\tPolicy:      rd,\n\t\tRepo:        repo,\n\t\tWriter:      fx,\n\t\tDesired:     want,\n\t\tPermissions: func(ctx context.Context) Row { return CheckPermissions(ctx, rd, repo) },\n\t\tLocalVsMain: func(ctx context.Context) (string, error) { return LocalVsMain(ctx, root) },\n\t\tVariables:   fx,\n\t\tConfirm:     confirm(os.Stdin, os.Stderr),\n\t\tWorkflowAt: func(ctx context.Context) ([]byte, bool, error) {\n\t\t\tg := gitx.New(\"\")\n\t\t\tif _, err := g.RevParse(ctx, root, \"origin/main\"); err != nil {\n\t\t\t\treturn nil, false, errors.New(\"origin/main not found\")\n\t\t\t}\n\t\t\treturn g.FileAt(ctx, root, \"origin/main\", workflowPath, 1<<20)\n\t\t},\n\t\tDryRun: dry,\n\t\tLog:    e.Log,\n\t}\n\treturn execute(ctx, e, d, o)\n}\n\n// execute runs setup with the given dependencies and maps the report to\n// the command's outcome: exit 2 on drift under --check, an error when\n// manual steps are needed.\nfunc execute(ctx context.Context, e *cli.Env, d Deps, o cli.SetupOpts) error {\n\trep, err := Run(ctx, d, Opts{Check: o.Check}, e.Stdout)\n\tPrint(e.Stdout, rep, d.DryRun)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif o.Check && rep.HasDrift() {\n\t\treturn &cli.ExitError{Code: 2, Err: errors.New(\"setup: drift\")}\n\t}\n\tif !rep.Green() {\n\t\treturn errors.New(\"setup: manual steps needed\")\n\t}\n\treturn nil\n}\n\n// LocalVsMain returns a warning when ./.ard/ in the worktree differs from\n// origin/main, which is what ard serve reads. It never fails the run.\nfunc LocalVsMain(ctx context.Context, root string) (string, error) {\n\tg := gitx.New(\"\")\n\tif _, err := g.RevParse(ctx, root, \"origin/main\"); err != nil {\n\t\treturn \"origin/main not found; cannot compare ./.ard/ with what ard serve reads\", nil\n\t}\n\tch, err := g.ChangedSince(ctx, root, root, \"origin/main\", \".ard/\")\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tif len(ch) > 0 {\n\t\treturn \"./.ard/ differs from origin/main (ard serve reads origin/main)\", nil\n\t}\n\treturn \"\", nil\n}\n\n// CheckPermissions is the permission check shared by `ard setup` and\n// `ard init`. Until the full check (#302) lands it only verifies that the\n// repository is readable with the configured credentials.\nfunc CheckPermissions(ctx context.Context, r labelsync.Reader, repo github.Repo) Row {\n\tif _, err := r.ListLabels(ctx); err != nil {\n\t\treturn Row{Status: StatusManual, Detail: \"check ARD_GITHUB_* credentials and that the App is installed on \" + repo.String() + \" with the permissions in AppPermissions (never \" + strings.Join(ForbiddenPermissions, \", \") + \")\"}\n\t}\n\treturn Row{Status: StatusOK, Detail: \"repository reachable\"}\n}\n\n// operatorToken returns the func that yields the operator's own token: the\n// PAT from ARD_GITHUB_TOKEN when that is the configured auth, otherwise the\n// gh CLI's token. It is read only when a variable is written, held in memory\n// and never logged.\nfunc operatorToken(auth github.Auth, e *cli.Env) func(ctx context.Context) (string, error) {\n\treturn func(ctx context.Context) (string, error) {\n3:## Implementation\n4-\n5-### Steps\n6-\n7-1. **New `internal/effects` method `SetRepoVariable`.** In `internal/effects/effects.go` add to `Effects`: `SetRepoVariable(ctx context.Context, repo, name, value string) error` (new). Put it beside `ApproveIssue`, not in `github.Writer`, so the App client can never reach it (the App cannot write variables). Implement in a new `internal/effects/variable.go`: `(*Live).SetRepoVariable` validates `repo` with `repopath.Parts`, and a `name` matching `^[A-Z][A-Z0-9_]*$`, then creates or updates the Actions variable (PATCH `repos/{o}/{r}/actions/variables/{name}`, falling back to POST on 404) using the operator token, through go-github (`Actions.CreateRepoVariable` / `UpdateRepoVariable`) on a client built from the token. `(*DryRun).SetRepoVariable` calls `d.emit(ctx, \"SetRepoVariable\", repo, map[string]any{\"name\": name, \"value\": value}, false, nil)` and does nothing else. Log through `l.done`, never the token. Update every other `Effects` implementation or fake (`grep -rn \"ApproveIssue\" internal` shows them; also `internal/effects/archtest` if it lists methods) so the build passes.\n8-2. **Operator token plumbing.** Add `OperatorToken func(ctx context.Context) (string, error)` to `effects.Options` (`internal/effects/open.go`) and a matching field on `Live` (set via a new option or setter next to `NewLive`). `Live.SetRepoVariable` calls it only when invoked, so the token is read once, held in memory, never logged or stored. When it is nil or fails, return a new exported `effects.ErrNoOperatorToken` with a message naming `ARD_GITHUB_TOKEN` (PAT) and `gh auth login`. In `internal/setupcmd/cmd.go` `Command`, build the func from the existing `github.GhFallback` (`internal/github/ghcli.go`, uses `gh auth token --hostname github.com`) or a PAT `TokenAuth` from `github.AuthFromEnv` when the configured auth is a PAT. Reuse what #302 already put in `internal/github/auth.go`; do not add a second token reader. If the configured auth is the App, use the gh fallback.\n9-3. **Embedded workflow.** New directory `internal/setupcmd/workflow/` (new) with `bot-commits.yml`, a byte-for-byte copy of `.github/workflows/bot-commits.yml` (copying into a new path is allowed; do not edit `.github/`). New `internal/setupcmd/workflow.go`: `//go:embed workflow/bot-commits.yml` into `var botCommitsWorkflow []byte`, `const workflowPath = \".github/workflows/bot-commits.yml\"`, and `PrintWorkflow(w io.Writer) error` writing the bytes.\n10-4. **Workflow check row.** In `workflow.go` add `func checkWorkflow(ctx, fileAt func(ctx, rev, path string) ([]byte, bool, error)) Row` (name `workflow`). Absent on `origin/main` gives `StatusManual` with detail `commit .github/workflows/bot-commits.yml: run ard setup --print-workflow > .github/workflows/bot-commits.yml, then open a PR`. Different bytes (compare after normalising CRLF to LF) gives `StatusManual`, with the same fix and \"differs from the copy embedded in ard\". Equal gives `StatusOK`. If `origin/main` does not exist, give a `StatusManual` row saying it could not be checked (fetch first), never a hard failure. Add `Deps.WorkflowAt func(ctx context.Context) ([]byte, bool, error)` (new) in `internal/setupcmd/setup.go`; wire it in `cmd.go` with `gitx.New(\"\").FileAt(ctx, root, \"origin/main\", workflowPath, 1<<20)` (`internal/gitx/local.go`). Append the row in `Run` after the policy rows, before the label step, only when `WorkflowAt != nil`. Setup never commits and never writes `.github/`.\n11-5. **ARD_BOT_LOGIN row and apply.** In `internal/setupcmd/setup.go` add `Deps.Variables VariableWriter` (new interface `SetRepoVariable(ctx, repo, name, value string) error`) and `Deps.Confirm func(prompt string) (bool, error)` (new). Add `botLoginVar = \"ARD_BOT_LOGIN\"` in `policy.go`. New `botLoginRow` in `workflow.go` or a new `botlogin.go`: want is `id.Login`, taken from `Policy.Identity` (already used in `policyRows`; make sure it ends in `[bot]`, otherwise a `StatusManual` row \"ard is not running as a GitHub App; ARD_BOT_LOGIN needs the App's <slug>[bot] login\"). Never read config for it. Read the current value with `Policy.GetVariable`. Absent gives `StatusDrift` (\"not set; will set to <want>\"). Equal gives ok. Different gives `StatusDrift` (\"is <have>, App is <want>\"). Soft errors (`ErrForbidden`, `ErrNotFound`) give a manual row with `gh variable set ARD_BOT_LOGIN -R <repo> --body <want>`. Apply, in `Run`, after the checks, only when not `Check`, not blocked, and the row is drift: absent, call `SetRepoVariable`; different, call `Confirm` first and skip with a `StatusManual` row (fix command in detail) when it answers no or is nil. Under dry-run the writer logs only and the row says \"would set\". `ErrNoOperatorToken` or a write error becomes a manual row with the `gh variable set` command, not an abort. Set the variable before the labels so a label failure does not hide it.\n12-6. **Confirmation prompt.** In `cmd.go` build `Confirm` from `e.Stdin` if `cli.Env` has it (check `internal/cli/app.go`; if it has no stdin or the input is not a terminal, return false so the run never blocks or overwrites silently). Add `--yes` only if the existing `cli.Env` has no prompt helper to reuse; otherwise keep to the flags in step 7.\n13-7. **`--print-workflow` flag.** In `internal/cli/app.go` add `PrintWorkflow bool` to `SetupOpts`. In `internal/cli/cmd_setup.go` register `f.BoolVar(&o.PrintWorkflow, \"print-workflow\", false, \"print the bot-commits workflow embedded in ard and exit\")`; reject combinations with `--check`, `--create-gh-app` and the App flags. In `setupcmd.Command` handle it first, before config load, repo resolution or any credentials: `return PrintWorkflow(e.Stdout)`. Nothing else may be written to stdout in that mode, so a redirect to a file is clean.\n14-8. **Docs.** Update `docs/proposal.md` paragraph \"`ard setup` applies `.ard/` to GitHub\" (add the `--print-workflow` flag, confirm-before-overwrite and the manual rows), `docs/runbooks/onboard-repo.md` (steps 49 and 50: use `ard setup --print-workflow` and let setup set the variable), `docs/site/getting-started.md` line 61, and `internal/initcmd/body.go` lines 64 to 65 only if the wording should mention `ard setup`. If you change `body.go`, update the matching string checks in `internal/initcmd/initcmd_test.go`. Add the `workflow/` directory to `docs/layout.md` under `internal/setupcmd/`.\n15-\n16-### Network inputs\n17-\n18-None.\n19-\n20-### Test plan\n21-\n22-Command: `make lint test` (`go vet`, gofmt check, `go test ./...`). No network; use the GitHub fake (`internal/github/fake`) and fake writers.\n23-\n24-- `internal/setupcmd/setup_test.go`:\n25-  - `TestBotLoginAbsentIsSet`: no variable, identity `ard-x[bot]`; expect one `SetRepoVariable(\"ARD_BOT_LOGIN\",\"ard-x[bot]\")` and a `changed` row.\n26-  - `TestBotLoginEqualNoWrite`: same value; expect ok and no write.\n27-  - `TestBotLoginDifferentAsksFirst`: different value, `Confirm` returns true; expect one write. With false or nil `Confirm`: no write, manual row with the `gh variable set` command.\n28-  - `TestBotLoginCheckOnly`: `--check` with drift: no write, `HasDrift` true.\n29-  - `TestBotLoginDryRun`: dry-run writer logs, row says would set.\n30-  - `TestBotLoginNotABot`: id