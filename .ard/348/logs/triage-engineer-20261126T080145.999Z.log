{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MTo5yHZriQgLqxY1by3fTR","type":"tool_result","content":"package cli\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\n\t\"github.com/spf13/cobra\"\n)\n\nfunc newSetup(app *App) *cobra.Command {\n\tvar o SetupOpts\n\tcmd := &cobra.Command{\n\t\tUse:   \"setup\",\n\t\tShort: \"Check the repository setup, then apply the fixes (exit 2 on drift with --check)\",\n\t\tArgs:  cobra.NoArgs,\n\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n\t\t\treturn app.run(cmd, func(ctx context.Context, e *Env) error {\n\t\t\t\tif o.CreateGHApp && o.Check {\n\t\t\t\t\treturn fmt.Errorf(\"setup: --create-gh-app cannot be combined with --check\")\n\t\t\t\t}\n\t\t\t\tif !o.CreateGHApp && (o.AppName != \"\" || o.KeyFile != \"\" || o.Force) {\n\t\t\t\t\treturn fmt.Errorf(\"setup: --app-name, --key-file and --force need --create-gh-app\")\n\t\t\t\t}\n\t\t\t\tif app.Handlers.Setup == nil {\n\t\t\t\t\treturn notImpl(cmd.CommandPath(), \"#346\")\n\t\t\t\t}\n\t\t\t\treturn app.Handlers.Setup(ctx, e, o)\n\t\t\t})\n\t\t},\n\t}\n\tf := cmd.Flags()\n\tf.BoolVar(&o.Check, \"check\", false, \"report only; exit 2 when anything has drifted\")\n\tf.BoolVar(&o.CreateGHApp, \"create-gh-app\", false, \"create ard's GitHub App with the manifest flow, then run the checks\")\n\tf.StringVar(&o.AppName, \"app-name\", \"\", \"App name for --create-gh-app (default ard-<owner>-<repo>)\")\n\tf.StringVar(&o.KeyFile, \"key-file\", \"\", \"private key path for --create-gh-app (default ~/.ard/keys/<slug>.pem)\")\n\tf.BoolVar(&o.Force, \"force\", false, \"overwrite an existing key file\")\n\treturn cmd\n}\n\tVersion string\n\t// PR opens the ard-init PR instead of writing the local tree.\n\tPR bool\n}\n\n// SetupOpts is the parsed flag set of `ard setup`.\ntype SetupOpts struct {\n\tCheck       bool\n\tCreateGHApp bool   // --create-gh-app: create the App with the manifest flow\n\tAppName     string // --app-name\n\tKeyFile     string // --key-file\n\tForce       bool   // --force: overwrite an existing key file\n}\n\n// JobPreOpts is the parsed flag set of `ard job-pre`.\ntype JobPreOpts struct {\n\tDeadline time.Time\n\t// GitBase is the git host URL, default https://github.com.\n\tGitBase string\n}\n\npackage effects\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os/exec\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/labels\"\n\t\"github.com/albertcbrown/ard/internal/repopath\"\n)\n\n// ErrGHUnavailable is returned by ApproveIssue when the gh CLI is not on PATH\n// or is not logged in. Callers fall back to showing the issue URL.\nvar ErrGHUnavailable = errors.New(\"effects: gh is missing or not logged in\")\n\n// ghPath finds the gh binary. A variable for tests.\nvar ghPath = exec.LookPath\n\n// ApproveIssue adds ard:approved through the operator's own gh, so the label\n// event carries the operator's identity and the gate checks their permission.\n// ard never reads the operator's token, and the GitHub App client is not used.\nfunc (l *Live) ApproveIssue(ctx context.Context, repo string, n int) error {\n\tif err := bad(\"ApproveIssue\", n); err != nil {\n\t\treturn err\n\t}\n\tif _, _, err := repopath.Parts(repo); err != nil {\n\t\treturn l.done(ctx, \"ApproveIssue\", n, err, \"repo\", repo)\n\t}\n\tpath, err := ghPath(\"gh\")\n\tif err != nil {\n\t\treturn l.done(ctx, \"ApproveIssue\", n, ErrGHUnavailable, \"repo\", repo)\n\t}\n\tcmd := exec.CommandContext(ctx, path, \"issue\", \"edit\", strconv.Itoa(n), \"--add-label\", labels.Approved, \"-R\", repo)\n\tvar stderr bytes.Buffer\n\tcmd.Stderr = &stderr\n\tif err := cmd.Run(); err != nil {\n\t\tmsg := strings.TrimSpace(stderr.String())\n\t\tlow := strings.ToLower(msg)\n\t\tif strings.Contains(low, \"gh auth login\") || strings.Contains(low, \"not logged in\") || strings.Contains(low, \"authentication\") {\n\t\t\terr = ErrGHUnavailable\n\t\t} else {\n\t\t\tif len(msg) > 300 {\n\t\t\t\tmsg = msg[:300]\n\t\t\t}\n\t\t\terr = fmt.Errorf(\"gh issue edit: %w: %s\", err, msg)\n\t\t}\n\t\treturn l.done(ctx, \"ApproveIssue\", n, err, \"repo\", repo)\n\t}\n\treturn l.done(ctx, \"ApproveIssue\", n, nil, \"repo\", repo)\n}\n\n// ApproveIssue records the call and runs nothing.\nfunc (d *DryRun) ApproveIssue(ctx context.Context, repo string, n int) error {\n\t_, err := d.emit(ctx, \"ApproveIssue\", repo, map[string]any{\"issue\": n, \"label\": labels.Approved}, false, nil)\n\treturn err\n}\nfunc (h *HTTP) GetMergeSettings(ctx context.Context) (MergeSettings, error) {\n\trepo, _, err := h.gh.Repositories.Get(ctx, h.o(), h.r())\n\tif err != nil {\n\t\treturn MergeSettings{}, h.fail(ctx, \"get repository\", 0, err)\n\t}\n\treturn MergeSettings{AllowRebaseMerge: repo.GetAllowRebaseMerge(), AllowSquashMerge: repo.GetAllowSquashMerge(), AllowMergeCommit: repo.GetAllowMergeCommit()}, nil\n}\n\nfunc (h *HTTP) GetVariable(ctx context.Context, name string) (string, bool, error) {\n\tv, _, err := h.gh.Actions.GetRepoVariable(ctx, h.o(), h.r(), name)\n\tif err != nil {\n\t\terr = h.fail(ctx, \"get variable \"+name, 0, err)\n\t\tif errors.Is(err, ErrNotFound) {\n\t\t\treturn \"\", false, nil\n\t\t}\n\t\treturn \"\", false, err\n\t}\n\treturn v.Value, true, nil\n}\n\n// ---- Writer ----\n\nfunc (h *HTTP) CreateIssue(ctx context.Context, in NewIssue) (Issue, error) {\n\treq := &gogh.IssueRequest{Title: &in.Title, Body: &in.Body}\n\tif len(in.Labels) > 0 {\n\t\treq.Labels = &in.Labels\n\t}\n\ti, _, err := h.gh.Issues.Create(ctx, h.o(), h.r(), req)\n\tif err != nil {\n\t\treturn Issue{}, h.fail(ctx, \"create issue\", 0, err)\n\t}\n\tErrGhNotLoggedIn = errors.New(\"no GitHub credentials: gh is installed but not logged in; run: \" + GhLoginCommand)\n)\n\n// RunFunc runs a command and returns its stdout. Stderr is dropped: it may\n// echo a token.\ntype RunFunc func(ctx context.Context, name string, args ...string) ([]byte, error)\n\n// ExecRun is the RunFunc backed by os/exec.\nfunc ExecRun(ctx context.Context, name string, args ...string) ([]byte, error) {\n\treturn exec.CommandContext(ctx, name, args...).Output()\n}\n\n// GhFallback reads the gh CLI's token for this session. lookPath and run are\n// seams for tests. The token is returned in memory only; errors never carry\n// it or gh's stderr.\nfunc GhFallback(ctx context.Context, lookPath func(string) (string, error), run RunFunc, out io.Writer) (*TokenAuth, error) {\n\tgh, err := lookPath(\"gh\")\n\tif err != nil {\n\t\treturn nil, ErrNoGh\n\t}\n\tif _, err := run(ctx, gh, \"auth\", \"status\", \"--hostname\", \"github.com\"); err != nil {\n\t\tif ctx.Err() != nil {\n\t\t\treturn nil, ctx.Err()\n\t\t}\n\t\treturn nil, ErrGhNotLoggedIn\n\t}\n\tfmt.Fprintln(out, \"ard: no GitHub credentials set; using the gh token for this session (running: gh auth token --hostname github.com). It is kept in memory only.\")\n\tb, err := run(ctx, gh, \"auth\", \"token\", \"--hostname\", \"github.com\")\n\tif err != nil {\n\t\treturn nil, errors.New(\"github: gh auth token failed\")\n\t}\n\ttok := strings.TrimSpace(string(b))\n\tif tok == \"\" {\n\t\treturn nil, errors.New(\"github: gh auth token printed no token\")\n\t}\n\treturn &TokenAuth{Value: tok, Source: \"gh\"}, nil\n}\n\tmode, typ, obj := f[0], f[1], f[2]\n\tif typ != \"blob\" || (mode != \"100644\" && mode != \"100755\") {\n\t\treturn nil, false, fmt.Errorf(\"gitx: file %s at %.12s: not a regular file (mode %s %s)\", path, rev, mode, typ)\n\t}\n\tsize, perr := strconv.ParseInt(f[3], 10, 64)\n\tif perr != nil {\n\t\treturn nil, false, fmt.Errorf(\"gitx: file %s at %.12s: bad size in %q\", path, rev, recs[0])\n\t}\n\tif size > maxBytes {\n\t\treturn nil, false, fmt.Errorf(\"gitx: file %s at %.12s: %d bytes, max %d\", path, rev, size, maxBytes)\n\t}\n\tblob, _, err := g.run(ctx, dir, nil, \"\", nil, \"--git-dir=\"+gitDirOf(dir), \"cat-file\", \"blob\", obj)\n\tif err != nil {\n\t\treturn nil, false, fmt.Errorf(\"gitx: file %s at %.12s: %w\", path, rev, err)\n\t}\n\treturn