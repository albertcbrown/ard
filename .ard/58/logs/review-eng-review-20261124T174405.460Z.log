s string\n+\t\tvar n int\n+\t\tif err := rows.Scan(&k.Stage, &k.Role, &status, &n); err != nil {\n+\t\t\treturn nil, fmt.Errorf(\"count ended jobs: %w\", err)\n+\t\t}\n+\t\tc := out[k]\n+\t\tif status == string(StatusFailed) {\n+\t\t\tc.Failed += n\n+\t\t} else {\n+\t\t\tc.Done += n\n+\t\t}\n+\t\tout[k] = c\n+\t}\n+\tif err := rows.Err(); err != nil {\n+\t\treturn nil, fmt.Errorf(\"count ended jobs: %w\", err)\n+\t}\n+\treturn out, nil\n+}\n+\n func collectJobs(rows *sql.Rows, what string) ([]Job, error) {\n \tdefer rows.Close()\n \tvar out []Job\ndiff --git a/internal/state/reaper_test.go b/internal/state/reaper_test.go\nindex bf98885..312d943 100644\n--- a/internal/state/reaper_test.go\n+++ b/internal/state/reaper_test.go\n@@ -342,3 +342,35 @@ func TestLimitStopLinkage(t *testing.T) {\n \t\t}\n \t})\n }\n+\n+func TestCountEndedSince(t *testing.T) {\n+\tctx := tctx(t)\n+\ts, c := newStoreClock(t, t.TempDir())\n+\tstart := c.t\n+\ta := claim(t, s, \"eng\", 1)\n+\tif err := s.Complete(ctx, a.ID, nil); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tb := claim(t, s, \"eng\", 2)\n+\tif err := s.Fail(ctx, b.ID, \"x\", time.Time{}); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tclaim(t, s, \"eng\", 3) // running: excluded\n+\tc.add(time.Hour)\n+\td := claim(t, s, \"eng\", 4)\n+\tif err := s.Complete(ctx, d.ID, nil); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tgot, err := s.CountEndedSince(ctx, start, start.Add(time.Hour))\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tvar total JobCounts\n+\tfor _, n := range got {\n+\t\ttotal.Done += n.Done\n+\t\ttotal.Failed += n.Failed\n+\t}\n+\tif total != (JobCounts{Done: 1, Failed: 1}) {\n+\t\tt.Errorf(\"counts = %+v, want 1 done 1 failed (the job ending at until is excluded)\", got)\n+\t}\n+}\ndiff --git a/internal/state/usage.go b/internal/state/usage.go\nindex b453d23..ff6662a 100644\n--- a/internal/state/usage.go\n+++ b/internal/state/usage.go\n@@ -210,9 +210,23 @@ type RoleKey struct{ Stage, Role string }\n // SpendSince sums step usage