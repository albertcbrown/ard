'+i)), StepUsage{CostUSD: fp(float64(int(1) << i))}); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\t_, repo, err := s.SpendBetween(ctx, day, day.Add(24*time.Hour))\n+\tif err != nil || repo.USD != 6 {\n+\t\tt.Errorf(\"between = %+v, %v; want 6 (bounds [from, to))\", repo, err)\n+\t}\n+\tif _, since, _ := s.SpendSince(ctx, day); since.USD != 14 {\n+\t\tt.Errorf(\"since = %+v, want 14\", since)\n+\t}\n+}\n","numLines":726,"startLine":1,"totalLines":726}},"tool_result_meta":[{"id":"toolu_018q8NjnfXJnpkQRxQCicNWn","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
