{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011ChMoY1DkUVjiCuDM2iTsA","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LsLUycDJRAjW84B3Lmc3y5","name":"Bash","input":{"command":"mkdir -p internal/digest && cd internal/digest && cat > digest.go <<'E'\n// Package digest posts the daily status-issue digest: queue depth by label,\n// jobs run, failures and spend for the previous UTC day.\npackage digest\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// Name is the digest loop's name, as --loops spells it.\nconst Name = \"digest\"\n\n// Store is the part of *state.Store the loop uses.\ntype Store interface {\n\tAppendEvent(ctx context.Context, e state.Event) error\n\tEvents(ctx context.Context, f state.EventFilter) ([]state.Event, error)\n\tCountEndedSince(ctx context.Context, since, until time.Time) (map[state.RoleKey]state.JobCounts, error)\n\tSpendBetween(ctx context.Context, from, to time.Time) (map[state.RoleKey]state.Spend, state.Spend, error)\n}\n\n// Reader lists issues for the queue depth.\ntype Reader interface {\n\tListIssues(ctx context.Context, o github.ListIssuesOpts) ([]github.Issue, error)\n}\n\n// Effects is the part of effects.Effects the loop uses.\ntype Effects interface {\n\tCreateComment(ctx context.Context, n int, body string) (github.Comment, error)\n\tDryRun() bool\n}\n\n// Deps are the loop's collaborators. StatusIssue returns 0 until the status\n// issue is known. Now nil means time.Now; Log nil means slog.Default.\ntype Deps struct {\n\tStore       Store\n\tReader      Reader\n\tEffects     Effects\n\tStatusIssue func() int\n\tLog         *slog.Logger\n\tNow         func() time.Time\n}\n\n// Loop posts one digest comment per UTC day. The digest event written after\n// the comment is the marker that keeps a restart from posting it again.\ntype Loop struct {\n\td  Deps\n\tmu sync.Mutex\n}\n\n// NewLoop builds the digest loop.\nfunc NewLoop(d Deps) *Loop {\n\tif d.Now == nil {\n\t\td.Now = time.Now\n\t}\n\tif d.Log == nil {\n\t\td.Log = slog.Default()\n\t}\n\treturn &Loop{d: d}\n}\n\n// Name implements controller.Loop.\nfunc (*Loop) Name() string { return Name }\n\n// Interval implements controller.Loop.\nfunc (*Loop) Interval(*config.Resolved) time.Duration { return 10 * time.Minute }\n\n// Claims is false: the digest is bookkeeping and runs while paused.\nfunc (*Loop) Claims() bool { return false }\n\nvar _ controller.Loop = (*Loop)(nil)\n\n// Tick posts today's digest when it is not yet posted.\nfunc (l *Loop) Tick(ctx context.Context, _ controller.Env) error {\n\tl.mu.Lock()\n\tdefer l.mu.Unlock()\n\tissue := l.d.StatusIssue()\n\tif issue == 0 {\n\t\treturn nil\n\t}\n\tnow := l.d.Now().UTC()\n\ttoday := time.Date(now.Year(), now.Month(), now.Day(), 0, 0, 0, 0, time.UTC)\n\tfrom := today.Add(-24 * time.Hour)\n\tday := from.Format(\"2006-01-02\")\n\n\tevs, err := l.d.Store.Events(ctx, state.EventFilter{Kind: state.EventDigest, Since: today})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"digest: read events: %w\", err)\n\t}\n\tfor _, e := range evs {\n\t\tvar d struct {\n\t\t\tDay string `json:\"day\"`\n\t\t}\n\t\tif json.Unmarshal(e.Data, &d) == nil && d.Day == day {\n\t\t\treturn nil\n\t\t}\n\t}\n\n\tissues, err := l.d.Reader.ListIssues(ctx, github.ListIssuesOpts{State: github.StateOpen})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"digest: list issues: %w\", err)\n\t}\n\tqueue := map[string]int{}\n\tfor _, is := range issues {\n\t\tif is.IsPR {\n\t\t\tcontinue\n\t\t}\n\t\tfor _, lb := range is.Labels {\n\t\t\tif strings.HasPrefix(lb, labels.Prefix) {\n\t\t\t\tqueue[lb]++\n\t\t\t}\n\t\t}\n\t}\n\tjobs, err := l.d.Store.CountEndedSince(ctx, from, today)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"digest: count jobs: %w\", err)\n\t}\n\tperSpend, spend, err := l.d.Store.SpendBetween(ctx, from, today)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"digest: read spend: %w\", err)\n\t}\n\tdata := Data{Day: day, Queue: queue, Jobs: jobs, Spend: perSpend, Total: spend}\n\tif l.d.Effects.DryRun() {\n\t\tl.d.Log.Info(\"digest.notice\", \"day\", day)\n\t\treturn nil\n\t}\n\tif _, err := l.d.Effects.CreateComment(ctx, issue, Render(data)); err != nil {\n\t\tl.d.Log.Error(\"digest.post_failed\", \"day\", day, \"error\", err)\n\t\treturn nil\n\t}\n\tnJobs, nFail := data.counts()\n\tev, _ := json.Marshal(map[string]any{\n\t\t\"day\": day, \"jobs\": nJobs, \"failures\": nFail, \"spend_usd\": spend.USD, \"unpriced\": spend.Unpriced,\n\t})\n\tif err := l.d.Store.AppendEvent(ctx, state.Event{At: l.d.Now(), Kind: state.EventDigest, Data: ev}); err != nil {\n\t\tl.d.Log.Error(\"digest.unrecorded\", \"day\", day, \"error\", err)\n\t}\n\treturn nil\n}\nE\ncat > render.go <<'E'\npackage digest\n\nimport (\n\t\"fmt\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// Data is what one digest reports. Day is the UTC day covered (2006-01-02).\ntype Data struct {\n\tDay   string\n\tQueue map[string]int\n\tJobs  map[state.RoleKey]state.JobCounts\n\tSpend map[state.RoleKey]state.Spend\n\tTotal state.Spend\n}\n\nfunc (d Data) counts() (jobs, failed int) {\n\tfor _, c := range d.Jobs {\n\t\tjobs += c.Done + c.Failed\n\t\tfailed += c.Failed\n\t}\n\treturn\n}\n\nvar safeName = regexp.MustCompile(`^[a-z0-9._/:-]+$`)\n\nfunc safe(s string) string {\n\tif safeName.MatchString(s) {\n\t\treturn s\n\t}\n\treturn \"?\"\n}\n\n// Render is the digest comment. It holds only numbers, the day and label and\n// role names; no agent text, no issue titles and no \"@\".\nfunc Render(d Data) string {\n\tvar b strings.Builder\n\tfmt.Fprintf(&b, \"<!-- ard:digest day=%s -->\\n\", safe(d.Day))\n\tfmt.Fprintf(&b, \"**ard · daily digest for %s (UTC)**\\n\\n\", safe(d.Day))\n\n\tb.WriteString(\"**Queue depth** (open issues by label)\\n\\n\")\n\tif len(d.Queue) == 0 {\n\t\tb.WriteString(\"No open issue carries an `ard:` label.\\n\")\n\t} else {\n\t\tb.WriteString(\"| Label | Issues |\\n|---|---|\\n\")\n\t\tnames := make([]string, 0, len(d.Queue))\n\t\tfor n := range d.Queue {\n\t\t\tnames = append(names, n)\n\t\t}\n\t\tsort.Strings(names)\n\t\tfor _, n := range names {\n\t\t\tfmt.Fprintf(&b, \"| `%s` | %d |\\n\", safe(n), d.Queue[n])\n\t\t}\n\t}\n\n\tjobs, failed := d.counts()\n\tfmt.Fprintf(&b, \"\\n**Jobs run:** %d\\n\\n**Failures:** %d\\n\", jobs, failed)\n\tkeys := make([]state.RoleKey, 0, len(d.Jobs))\n\tfor k, c := range d.Jobs {\n\t\tif c.Failed > 0 {\n\t\t\tkeys = append(keys, k)\n\t\t}\n\t}\n\tsort.Slice(keys, func(i, j int) bool {\n\t\tif keys[i].Stage != keys[j].Stage {\n\t\t\treturn keys[i].Stage < keys[j].Stage\n\t\t}\n\t\treturn keys[i].Role < keys[j].Role\n\t})\n\tif len(keys) > 0 {\n\t\tb.WriteString(\"\\n| Role | Failed |\\n|---|---|\\n\")\n\t\tfor _, k := range keys {\n\t\t\tfmt.Fprintf(&b, \"| %s/%s | %d |\\n\", safe(k.Stage), safe(k.Role), d.Jobs[k].Failed)\n\t\t}\n\t}\n\n\tfmt.Fprintf(&b, \"\\n**Spend:** $%.2f\", d.Total.USD)\n\tif d.Total.Unpriced > 0 {\n\t\tfmt.Fprintf(&b, \" (%d steps reported no cost and count as $0)\", d.Total.Unpriced)\n\t}\n\tb.WriteString(\"\\n\\nOn a subscription the dollar figure is an estimate.\\n\")\n\treturn b.String()\n}\nE\ncat > digest_test.go <<'E'\npackage digest\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\ntype fakeStore struct {\n\tevents     []state.Event\n\tfrom, to   time.Time\n\tjobs       map[state.RoleKey]state.JobCounts\n\tspend      state.Spend\n}\n\nfunc (f *fakeStore) AppendEvent(_ context.Context, e state.Event) error {\n\tf.events = append(f.events, e)\n\treturn nil\n}\n\nfunc (f *fakeStore) Events(_ context.Context, fl state.EventFilter) ([]state.Event, error) {\n\tvar out []state.Event\n\tfor _, e := range f.events {\n\t\tif e.Kind == fl.Kind && !e.At.Before(fl.Since) {\n\t\t\tout = append(out, e)\n\t\t}\n\t}\n\treturn out, nil\n}\n\nfunc (f *fakeStore) CountEndedSince(_ context.Context, from, to time.Time) (map[state.RoleKey]state.JobCounts, error) {\n\tf.from, f.to = from, to\n\treturn f.jobs, nil\n}\n\nfunc (f *fakeStore) SpendBetween(context.Context, time.Time, time.Time) (map[state.RoleKey]state.Spend, state.Spend, error) {\n\treturn nil, f.spend, nil\n}\n\ntype fakeReader struct {\n\tissues []github.Issue\n\terr    error\n}\n\nfunc (r fakeReader) ListIssues(context.Context, github.ListIssuesOpts) ([]github.Issue, error) {\n\treturn r.issues, r.err\n}\n\ntype fakeEffects struct {\n\tbodies []string\n\terr    error\n\tdry    bool\n}\n\nfunc (e *fakeEffects) CreateComment(_ context.Context, _ int, body string) (github.Comment, error) {\n\tif e.err != nil {\n\t\treturn github.Comment{}, e.err\n\t}\n\te.bodies = append(e.bodies, body)\n\treturn github.Comment{}, nil\n}\nfunc (e *fakeEffects) DryRun() bool { return e.dry }\n\nfunc setup(now *time.Time) (*Loop, *fakeStore, *fakeEffects, *fakeReader) {\n\tst := &fakeStore{}\n\tfx := &fakeEffects{}\n\trd := &fakeReader{}\n\tl := NewLoop(Deps{Store: st, Reader: rd, Effects: fx, StatusIssue: func() int { return 1 }, Now: func() time.Time { return *now }})\n\treturn l, st, fx, rd\n}\n\nvar noon = time.Date(2026, 3, 5, 12, 0, 0, 0, time.UTC)\n\nfunc TestTickPostsOnce(t *testing.T) {\n\tnow := noon\n\tl, st, fx, _ := setup(&now)\n\tfor i := 0; i < 2; i++ {\n\t\tif err := l.Tick(context.Background(), controllerEnv()); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tif len(fx.bodies) != 1 || len(st.events) != 1 {\n\t\tt.Fatalf(\"posts = %d, events = %d; want 1, 1\", len(fx.bodies), len(st.events))\n\t}\n\tif !strings.Contains(fx.bodies[0], \"day=2026-03-04\") {\n\t\tt.Errorf(\"body = %q\", fx.bodies[0])\n\t}\n\t// Restart: a new loop over the same store posts nothing; the next day posts.\n\tl2 := NewLoop(l.d)\n\t_ = l2.Tick(context.Background(), controllerEnv())\n\tif len(fx.bodies) != 1 {\n\t\tt.Errorf(\"restart reposted\")\n\t}\n\tnow = noon.Add(24 * time.Hour)\n\t_ = l2.Tick(context.Background(), controllerEnv())\n\tif len(fx.bodies) != 2 {\n\t\tt.Errorf(\"next day posts = %d, want 2\", len(fx.bodies))\n\t}\n}\n\nfunc TestTickNoStatusIssue(t *testing.T) {\n\tnow := noon\n\tl, st, fx, _ := setup(&now)\n\tl.d.StatusIssue = func() int { return 0 }\n\t_ = l.Tick(context.Background(), controllerEnv())\n\tif len(fx.bodies)+len(st.events) != 0 {\n\t\tt.Error(\"posted without a status issue\")\n\t}\n}\n\nfunc TestTickPostFailsNoEvent(t *testing.T) {\n\tnow := noon\n\tl, st, fx, _ := setup(&now)\n\tfx.err = errors.New(\"boom\")\n\t_ = l.Tick(context.Background(), controllerEnv())\n\tif len(st.events) != 0 {\n\t\tt.Fatal(\"event stored after a failed post\")\n\t}\n\tfx.err = nil\n\t_ = l.Tick(context.Background(), controllerEnv())\n\tif len(fx.bodies) != 1 {\n\t\tt.Error(\"no retry\")\n\t}\n}\n\nfunc TestTickDryRun(t *testing.T) {\n\tnow := noon\n\tl, st, fx, _ := setup(&now)\n\tfx.dry = true\n\t_ = l.Tick(context.Background(), controllerEnv())\n\tif len(fx.bodies)+len(st.events) != 0 {\n\t\tt.Error(\"dry run posted or stored\")\n\t}\n}\n\nfunc TestTickReaderError(t *testing.T) {\n\tnow := noon\n\tl, _, fx, rd := setup(&now)\n\trd.err = errors.New(\"api\")\n\tif err := l.Tick(context.Background(), controllerEnv()); err == nil || len(fx.bodies) != 0 {\n\t\tt.Errorf(\"err = %v, posts = %d\", err, len(fx.bodies))\n\t}\n}\n\nfunc TestWindowPreviousDay(t *testing.T) {\n\tnow := noon\n\tl, st, _, _ := setup(&now)\n\t_ = l.Tick(context.Background(), controllerEnv())\n\tif !st.from.Equal(time.Date(2026, 3, 4, 0, 0, 0, 0, time.UTC)) || !st.to.Equal(time.Date(2026, 3, 5, 0, 0, 0, 0, time.UTC)) {\n\t\tt.Errorf(\"window = [%v, %v)\", st.from, st.to)\n\t}\n}\n\nfunc TestQueueDepthByLabel(t *testing.T) {\n\tnow := noon\n\tl, _, fx, rd := setup(&now)\n\trd.issues = []github.Issue{\n\t\t{Number: 2, Labels: []string{\"ard:pending\", \"bug\"}},\n\t\t{Number: 3, Labels: []string{\"ard:pending\", \"ard:hold\"}},\n\t\t{Number: 4, IsPR: true, Labels: []string{\"ard:hold\"}},\n\t}\n\t_ = l.Tick(context.Background(), controllerEnv())\n\tb := fx.bodies[0]\n\tif !strings.Contains(b, \"| `ard:pending` | 2 |\") || !strings.Contains(b, \"| `ard:hold` | 1 |\") || strings.Contains(b, \"bug\") {\n\t\tt.Errorf(\"body = %s\", b)\n\t}\n}\n\nfunc TestRenderZeroAndUnsafe(t *testing.T) {\n\tzero := Render(Data{Day: \"2026-03-04\"})\n\tfor _, want := range []string{\"<!-- ard:digest day=2026-03-04 -->\", \"**Jobs run:** 0\", \"**Failures:** 0\", \"**Spend:** $0.00\"} {\n\t\tif !strings.Contains(zero, want) {\n\t\t\tt.Errorf(\"zero digest lacks %q:\\n%s\", want, zero)\n\t\t}\n\t}\n\td := Data{\n\t\tDay:   \"2026-03-04\",\n\t\tQueue: map[string]int{\"ard:x @evil\": 1},\n\t\tJobs:  map[state.RoleKey]state.JobCounts{{Stage: \"worker\", Role: \"Bad Role@x\"}: {Done: 1, Failed: 2}},\n\t\tTotal: state.Spend{USD: 1.5, Unpriced: 2},\n\t}\n\tout := Render(d)\n\tif strings.Contains(out, \"@\") || !strings.Contains(out, \"worker/? | 2\") || !strings.Contains(out, \"2 steps reported no cost\") || !strings.Contains(out, \"**Jobs run:** 3\") {\n\t\tt.Errorf(\"render:\\n%s\", out)\n\t}\n}\n\nfunc TestIntervalAndClaims(t *testing.T) {\n\tl := NewLoop(Deps{})\n\tif l.Claims() || l.Name() != \"digest\" || l.Interval(nil) != 10*time.Minute {\n\t\tt.Error(\"loop identity\")\n\t}\n}\nE\ngrep -n \"type Env\" -A8 ../controller/*.go | head -12"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":258,"cache_read_input_tokens":34643,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":258},"output_tokens":8,"service_tier":"stand