er filing and autoclose, stale closes, merges); such loops are\n722-\t// skipped while the controller is paused. The Reaper and the costs loop (bookkeeping about work already done) return false.\n723-\tClaims() bool\n724-\t// Tick runs one poll. It must return promptly once ctx is done.\n725-\tTick(ctx context.Context, env Env) error\n726-}","is_error":false}]},"parent_tool_use_id":null,"session_id":"746d7279-743d-4686-bfb4-966dd6bdb311","uuid":"5cb3d7cd-04f9-47df-91b9-831eecac1318","timestamp":"2026-11-24T12:44:13.787Z","tool_use_result":{"stdout":"package budget\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"regexp\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/controller\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// Name is the notice loop's name, as --loops spells it.\nconst Name = \"budget\"\n\n// Capper lists the caps reached today; *Gate satisfies it.\ntype Capper interface {\n\tCapped(ctx context.Context) ([]Cap, time.Time, error)\n}\n\n// EventStore is the part of *state.Store the loop uses.\ntype EventStore interface {\n\tAppendEvent(ctx context.Context, e state.Event) error\n\tEvents(ctx context.Context, f state.EventFilter) ([]state.Event, error)\n}\n\n// Effects is the part of effects.Effects the loop uses.\ntype Effects interface {\n\tCreateComment(ctx context.Context, n int, body string) (github.Comment, error)\n\tDryRun() bool\n}\n\n// Deps are the loop's collaborators. StatusIssue returns 0 until the status\n// issue is known. Now nil means time.Now; Log nil means slog.Default.\ntype Deps struct {\n\tGate        Capper\n\tStore       EventStore\n\tEffects     Effects\n\tStatusIssue func() int\n\tLog         *slog.Logger\n\tNow         func() time.Time\n}\n\n// Loop posts one status-issue comment per reached cap and UTC day. A\n// budget_capped event written after the comment is the record for #58 and the\n// marker that keeps a restart from posting the notice again.\ntype Loop struct {\n\td  Deps\n\tmu sync.Mutex\n}\n\n// NewLoop builds the notice loop.\nfunc NewLoop(d Deps) *Loop {\n\tif d.Now == nil {\n\t\td.Now = time.Now\n\t}\n\tif d.Log == nil {\n\t\td.Log = slog.Default()\n\t}\n\treturn &Loop{d: d}\n}\n\n// Name implements controller.Loop.\nfunc (*Loop) Name() string { return Name }\n\n// Interval implements controller.Loop.\nfunc (*Loop) Interval(*config.Resolved) time.Duration { return time.Minute }\n\n// Claims is false: the notice is bookkeeping about work already done.\nfunc (*Loop) Claims() bool { return false }\n\nvar _ controller.Loop = (*Loop)(nil)\n\ntype noticeKey struct{ scope, stage, role, day string }\n\n// Tick posts the notices that are due.\nfunc (l *Loop) Tick(ctx context.Context, _ controller.Env) error {\n\tl.mu.Lock()\n\tdefer l.mu.Unlock()\n\tissue := l.d.StatusIssue()\n\tif issue == 0 {\n\t\treturn nil\n\t}\n\tcaps, dayStart, err := l.d.Gate.Capped(ctx)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"budget: read spend: %w\", err)\n\t}\n\tif len(caps) == 0 {\n\t\treturn nil\n\t}\n\tday := dayStart.Format(\"2006-01-02\")\n\tevs, err := l.d.Store.Events(ctx, state.EventFilter{Kind: state.EventBudgetCapped, Since: dayStart})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"budget: read events: %w\", err)\n\t}\n\tdone := map[noticeKey]bool{}\n\tfor _, e := range evs {\n\t\tvar d struct {\n\t\t\tScope string `json:\"scope\"`\n\t\t\tDay   string `json:\"day\"`\n\t\t}\n\t\tif json.Unmarshal(e.Data, &d) == nil {\n\t\t\tdone[noticeKey{d.Scope, e.Stage, e.Role, d.Day}] = true\n\t\t}\n\t}\n\tfor _, c := range caps {\n\t\tif done[noticeKey{c.Scope, c.Stage, c.Role, day}] {\n\t\t\tcontinue\n\t\t}\n\t\tif _, err := l.d.Effects.CreateComment(ctx, issue, Render(c, day)); err != nil {\n\t\t\tl.d.Log.Error(\"budget.notice_failed\", \"scope\", c.Scope, \"stage\", c.Stage, \"role\", c.Role, \"error\", err)\n\t\t\tcontinue\n\t\t}\n\t\tdata, _ := json.Marshal(map[string]any{\n\t\t\t\"scope\": c.Scope, \"stage\": c.Stage, \"role\": c.Role, \"day\": day,\n\t\t\t\"spent_usd\": c.Spent.USD, \"cap_usd\": c.Limit, \"unpriced\": c.Spent.Unpriced,\n\t\t})\n\t\tev := state.Event{At: l.d.Now(), Kind: state.EventBudgetCapped, Stage: c.Stage, Role: c.Role, Data: data}\n\t\tif err := l.d.Store.AppendEvent(ctx, ev); err != nil {\n\t\t\tl.d.Log.Error(\"budget.notice_unrecorded\", \"scope\", c.Scope, \"stage\", c.Stage, \"role\", c.Role, \"error\", err)\n\t\t}\n\t}\n\treturn nil\n}\n\nvar safeName = regexp.MustCompile(`^[a-z0-9._/-]+$`)\n\nfunc safe(s string) string {\n\tif safeName.MatchString(s) {\n\t\treturn s\n\t}\n\treturn \"?\"\n}\n\n// Render is the comment for c on the UTC day (2006-01-02). It holds only\n// numbers, the day and config names; no agent text and no \"@\".\nfunc Render(c Cap, day string) string {\n\tvar b strings.Builder\n\twhat := \"The repo's daily budget\"\n\twhere := \"the repo-wide `budget_usd_per_day`\"\n\tscope := \"repo\"\n\tif c.Scope == \"role\" {\n\t\tstage, role := safe(c.Stage), safe(c.Role)\n\t\twhat = fmt.Sprintf(\"The daily budget of %s role `%s`\", stage, role)\n\t\twhere = fmt.Sprintf(\"`budget_usd_per_day` of role `%s` (or the repo-wide value)\", role)\n\t\tscope = \"role \" + stage + \"/\" + role\n\t}\n\tfmt.Fprintf(&b, \"<!-- ard:budget scope=%s day=%s -->\\n\", strings.ReplaceAll(scope, \" \", \"-\"), day)\n\tfmt.Fprintf(&b, \"**ard · daily budget reached**\\n\\n\")\n\tfmt.Fprintf(&b, \"%s is reached for %s (UTC): $%.2f of $%.2f spent.\", what, day, c.Spent.USD, c.Limit)\n\tif c.Spent.Unpriced > 0 {\n\t\tfmt.Fprintf(&b, \" %d steps reported no cost and count as $0.\", c.Spent.Unpriced)\n\t}\n\tb.WriteString(\"\\n\\nNo new jobs start under this cap; running jobs finish. On a subscription the dollar figure is an estimate.\\n\\n\")\n\tfmt.Fprintf(&b, \"To raise the cap, change %s in `.ard/config.yaml` through a reviewed pull request. The cap clears at 00:00 UTC.\\n\", where)\n\treturn b.String()\n}\npackage state\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/state/sqlitex\"\n)\n\n// Event kinds.\nconst (\n\tEventClaim    = \"claim\"\n\tEventCloseout = \"closeout\"\n\tEventFailure  = \"failure\"\n\tEventRetry    = \"retry\"\n\t// EventUsageLimit: a job stopped at a usage limit. It is not a failure.\n\tEventUsageLimit = \"usage_limit\"\n\t// EventKill: the Reaper is about to kill a running job; data has the reason.\n\tEventKill      = \"kill\"\n\tEventTickError = \"tick_error\"\n\t// EventHostUntrusted: a host-mode job of a role that reads untrusted\n\t// input started. Stage, role, job and issue are in their columns.\n\tEventHostUntrusted = \"host_untrusted\"\n\t// EventGate: the triage fan-in gate acted; data has verdict, reason and worker.\n\tEventGate = \"gate\"\n\t// EventMerge: the merger squash-merged a PR; data has pr, head and merge_sha.\n\tEventMerge = \"merge\"\n\t// EventReviewRound: a review fix round changed phase; data has round, phase, reason, pr, head, worker and roles.\n\tEventReviewRound = \"review_round\"\n\t// EventReviewRerequest: the merger removed a stale :done review label so the\n\t// review re-runs; data has pr, head and reviewed. Stage is review and role\n\t// is the reviewer role. One per head: it stops the merger from looping.\n\tEventReviewRerequest = \"review_rerequest\"\n\t// EventBudgetCapped: the budget loop posted the status-issue notice for a\n\t// reached daily cap; data has scope (\"repo\" or \"role\"), stage, role, day\n\t// (2006-01-02, UTC), spent_usd, cap_usd and unpriced. It is also the\n\t// marker that stops a second notice for the same scope and day.\n\tEventBudgetCapped = \"budget_capped\"\n)\n\n// Event is one row of the append-only event log. Data holds structured fields\n// only: never log text, issue bodies or secrets.\ntype Event struct {\n\tID    int64\n\tAt    time.Time\n\tKind  string\n\tJobID string\n\tIssue int\n\tStage string\n\tRole  string\n\tData  json.RawMessage\n}\n\n// EventFilter selects events; zero values are unbounded.\ntype EventFilter struct {\n\tSince, Until time.Time\n\tKind         string\n\tIssue        int    // 0 = any\n\tStage, Role  string // \"\" = any\n\tLimit        int\n}\n\ntype execer interface {\n\tExecContext(ctx context.Context, q string, args ...any) (sql.Result, error)\n}\n\nfunc insertEvent(ctx context.Context, x execer, e Event) error {\n\tif len(e.Data) > 0 && !json.Valid(e.Data) {\n\t\treturn fmt.Errorf(\"event %s: data is not valid JSON\", e.Kind)\n\t}\n\tvar data any\n\tif len(e.Data) > 0 {\n\t\tdata = string(e.Data)\n\t}\n\tvar job, stage, role any\n\tif e.JobID != \"\" {\n\t\tjob = e.JobID\n\t}\n\tif e.Stage != \"\" {\n\t\tstage = e.Stage\n\t}\n\tif e.Role != \"\" {\n\t\trole = e.Role\n\t}\n\tvar issue any\n\tif e.Issue != 0 {\n\t\tissue = e.Issue\n\t}\n\tif _, err := x.ExecContext(ctx, `INSERT INTO events(ts, kind, job_id, issue, stage, role, data)\n\t\tVALUES(?,?,?,?,?,?,?)`, e.At.Unix(), e.Kind, job, issue, stage, role, data); err != nil {\n\t\treturn fmt.Errorf(\"append event %s: %w\", e.Kind, err)\n\t}\n\treturn nil\n}\n\n// AppendEvent appends e; a zero At means now.\nfunc (s *Store) AppendEvent(ctx context.Context, e Event) error {\n\tif e.Kind == \"\" {\n\t\treturn fmt.Errorf(\"append event: empty kind\")\n\t}\n\tif e.At.IsZero() {\n\t\te.At = s.now()\n\t}\n\treturn insertEvent(ctx, s.db, e)\n}\n\n// Events returns matching events in ascending id order.\nfunc (s *Store) Events(ctx context.Context, f EventFilter) ([]Event, error) {\n\tq := `SELECT id, ts, kind, job_id, issue, stage, role, data FROM events WHERE 1=1`\n\tvar args []any\n\tif !f.Since.IsZero() {\n\t\tq += ` AND ts >= ?`\n\t\targs = append(args, f.Since.Unix())\n\t}\n\tif !f.Until.IsZero() {\n\t\tq += ` AND ts <= ?`\n\t\targs = append(args, f.Until.Unix())\n\t}\n\tif f.Kind != \"\" {\n\t\tq += ` AND kind = ?`\n\t\targs = append(args, f.Kind)\n\t}\n\tif f.Issue != 0 {\n\t\tq += ` AND issue = ?`\n\t\targs = append(args, f.Issue)\n\t}\n\tif f.Stage != \"\" {\n\t\tq += ` AND stage = ?`\n\t\targs = append(args, f.Stage)\n\t}\n\tif f.Role != \"\" {\n\t\tq += ` AND role = ?`\n\t\targs = append(args, f.Role)\n\t}\n\tq += ` ORDER BY id`\n\tif f.Limit > 0 {\n\t\tq += ` LIMIT ?`\n\t}\n\treturn out, nil\n}\n\n// Spend is money spent over a period: USD sums the priced steps; Unpriced\n// counts steps that reported no cost (they add nothing to USD).\ntype Spend struct {\n\tUSD      float64\n\tUnpriced int\n}\n\n// RoleKey names a role in spend totals. The stage is part of the key because\n// a role name can be shared by a triage role and a worker role.\ntype RoleKey struct{ Stage, Role string }\n\n// SpendSince sums step usage recorded at or after dayStart, per (stage, role)\n// and for the whole repo.\nfunc (s *Store) SpendSince(ctx context.Context, dayStart time.Time) (map[RoleKey]Spend, Spend, error) {\n\trows, err := s.db.QueryContext(ctx, `SELECT j.stage, j.role, COALESCE(SUM(u.cost_usd), 0), COALESCE(SUM(u.cost_usd IS NULL), 0)\n\t\tFROM step_usage u JOIN jobs j ON j.id = u.job_id\n\t\tWHERE u.recorded_at >= ? GROUP BY j.stage, j.role`, dayStart.Unix())\n\tif err != nil {\n\t\treturn nil, Spend{}, fmt.Errorf(\"spend since %s: %w\", dayStart.UTC().Format(time.RFC3339), err)\n\t}\n\tdefer rows.Close()\n\tper := map[RoleKey]Spend{}\n\tvar repo Spend\n\tfor rows.Next() {\n\t\tvar k RoleKey\n\t\tvar sp Spend\n\t\tif err := rows.Scan(&k.Stage, &k.Role, &sp.USD, &sp.Unpriced); err != nil {\n\t\t\treturn nil, Spend{}, fmt.Errorf(\"spend since: %w\", err)\n\t\t}\n\t\tper[k] = sp\n\t\trepo.USD += sp.USD\n\t\trepo.Unpriced += sp.Unpriced\n\t}\n\tif err := rows.Err(); err != nil {\n\t\treturn nil, Spend{}, fmt.Errorf(\"spend since: %w\", err)\n\t}\n\treturn per, repo, nil\n}\nstate/admissions.go:45:func (s *Store) Admission(ctx context.Context, issue int) (Admission, error) {\nstate/admissions.go:67:func (s *Store)