 \"256\", \"1 MiB\", \"symlink\", \"binary\", \"at run time\",\n \t\t\"## Changes\", \"## Testing\", \"## Open issues\", \"environment variable\",\n \t} {\n \t\tif !strings.Contains(p, want) {\ndiff --git a/internal/roles/workers/engineer/prompt.txt b/internal/roles/workers/engineer/prompt.txt\nindex a7ef1a0..4e15fc4 100644\n--- a/internal/roles/workers/engineer/prompt.txt\n+++ b/internal/roles/workers/engineer/prompt.txt\n@@ -56,7 +56,7 @@ The controller checks your whole diff before anything leaves the host. Any\n of these holds the change for a human, and nothing is pushed:\n \n - any change under .github/, under .ard/ (except your report) or under\n-  .ard-input/, any path with a .git segment, and .gitmodules;\n+  .ard-input/, any path with a .git segment, .gitmodules and .gitattributes;\n - secret-shaped file names: .env (.env.example, .env.sample and\n   .env.template are fine), .netrc, .npmrc, .pypirc, credentials files,\n   id_rsa and other SSH keys, and names ending in .pem, .key, .p12, .pfx,\ndiff --git a/internal/worker/unit_test.go b/internal/worker/unit_test.go\nindex f210002..b6c7ebe 100644\n--- a/internal/worker/unit_test.go\n+++ b/internal/worker/unit_test.go\n@@ -84,7 +84,7 @@ func TestCheck(t *testing.T) {\n \tfor i := range many {\n \t\tmany[i] = rc(\"f\" + strings.Repeat(\"x\", i%5) + string(rune('a'+i%26)) + strings.Repeat(\"y\", i/26))\n \t}\n-\trejects := []Change{rc(\"a\"), rc(\".github/CODEOWNERS\"), rc(\".github/workflows/x.yml\"), rc(\".ard/config.yaml\"), rc(\".ard/workers/x/prompt.txt\"), rc(\".ard/8/plan.md\"), rc(\".env\"), rc(\"x/.git/config\"), rc(\".gitmodules\")}\n+\trejects := []Change{rc(\"a\"), rc(\".github/CODEOWNERS\"), rc(\".github/workflows/x.yml\"), rc(\".ard/config.yaml\"), rc(\".ard/workers/x/prompt.txt\"), rc(\".ard/8/plan.md\"), rc(\".env\"), rc(\"x/.git/config\"), rc(\".gitmodules\"), rc(\".gitattributes\")}\n \n \ttests := []struct {\n \t\tname    string\n@@ -119,7 +119,7 @@ func TestCheck(t *testing.T) {\n \t\t{\"no 