ectory of the same kind and name in this repository wins whole, never file by file. `overrides` apply to shared roles too. `ard serve` re-reads the key with the rest of the config. If the shared repository cannot be fetched, or a shared role is invalid, the config fails to load and the controller counts as paused. Trust: the key lives in `.ard/config.yaml`, a protected path, but a branch or tag in the shared repository can change the prompts agents run without a PR here, so pin a full commit SHA.\n+\n ```\n .ard/\n ├── config.yaml          # global settings and overrides only\ndiff --git a/internal/config/defaults.go b/internal/config/defaults.go\nindex 252f79d..5e68da0 100644\n--- a/internal/config/defaults.go\n+++ b/internal/config/defaults.go\n@@ -208,6 +208,23 @@ func applyGlobals(res *Resolved, raw rawConfig, cfgPath string) Errors {\n \t\tres.Sidecars[name] = entry\n \t}\n \n+\tif rr := raw.rolesRepo; rr != nil {\n+\t\tentry := Sidecar{} // empty Ref follows the shared repo's default branch\n+\t\tif rr.repo != nil {\n+\t\t\tentry.Repo = *rr.repo\n+\t\t}\n+\t\tif rr.ref != nil {\n+\t\t\tentry.Ref = *rr.ref\n+\t\t}\n+\t\tif _, _, err := repopath.Parts(entry.Repo); err != nil {\n+\t\t\terrs = append(errs, &Error{File: cfgPath, Key: \"roles_repo.repo\", Msg: fmt.Sprintf(\"must be %q, got %q\", \"owner/name\", entry.Repo)})\n+\t\t}\n+\t\tif err := gitref.Check(entry.Ref); entry.Ref != \"\" && err != nil {\n+\t\t\terrs = append(errs, &Error{File: cfgPath, Key: \"roles_repo.ref\", Msg: fmt.Sprintf(\"invalid ref %q: %v\", entry.Ref, err)})\n+\t\t}\n+\t\tres.RolesRepo = &entry\n+\t}\n+\n \treturn errs\n }\n \ndiff --git a/internal/config/load_test.go b/internal/config/load_test.go\nindex 52f9922..5541406 100644\n--- a/internal/config/load_test.go\n+++ b/internal/config/load_test.go\n@@ -703,6 +703,26 @@ func TestLoadErrors(t *testing.T) {\n \t\t\tyaml: \"sidecars: {specs: {repo: a/b, url: x}}\\n\",\n \t\t\twant: []wantErr{{\".ard/config.yaml\", \"sidecars.specs.url\", 