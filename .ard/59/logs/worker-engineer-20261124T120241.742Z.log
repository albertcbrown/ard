{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014WH4KmfBWG9XAHscpjinyW","type":"tool_result","content":"// Package configsrc loads the controller's configuration from the tip of the\n// default branch on the remote, not from a working tree (decision #87). Each\n// load fetches the branch, resolves it to a SHA and materialises the config\n// file and role directories at that SHA into a snapshot directory on disk,\n// because roles run from a host path: the config, the role directories and\n// the scan worktree all have to describe the same commit.\npackage configsrc\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n)\n\n// DefaultKeep is how long a snapshot of a superseded SHA is kept. It is far\n// beyond any job timeout, so a running host-mode job keeps its role directory.\nconst DefaultKeep = 24 * time.Hour\n\n// Git is the slice of gitx the source needs; *gitx.Git satisfies it.\ntype Git interface {\n\tFetchRef(ctx context.Context, repoDir, url, refspec string, token gitx.TokenFunc) error\n\tRevParse(ctx context.Context, dir, ref string) (string, error)\n\tExportPaths(ctx context.Context, repoDir, sha, dest string, paths ...string) error\n}\n\n// Options configure a Source.\ntype Options struct {\n\tGit       Git\n\tRepoDir   string // absolute; the controller's clone (the object store)\n\tRemoteURL string\n\tToken     gitx.TokenFunc // nil in tests\n\tBranch    string         // default \"main\"\n\tCacheDir  string         // absolute; snapshots go in CacheDir/<sha>\n\tKeep      time.Duration  // snapshot retention; default DefaultKeep\n\tNow       func() time.Time\n\tLog       *slog.Logger\n}\n\n// Source loads config from the tip of a branch on the remote. It is safe for\n// concurrent use; calls are serialised.\ntype Source struct {\n\to Options\n\n\tmu  sync.Mutex\n\tsha string\n\tres *config.Resolved\n}\n\n// New validates o, creates the cache directory and removes the partial\n// snapshots a crashed run left behind.\nfunc New(o Options) (*Source, error) {\n\tswitch {\n\tcase o.Git == nil:\n\t\treturn nil, errors.New(\"configsrc: nil Git\")\n\tcase !filepath.IsAbs(o.RepoDir):\n\t\treturn nil, fmt.Errorf(\"configsrc: RepoDir %q is not absolute\", o.RepoDir)\n\tcase !filepath.IsAbs(o.CacheDir):\n\t\treturn nil, fmt.Errorf(\"configsrc: CacheDir %q is not absolute\", o.CacheDir)\n\tcase o.RemoteURL == \"\":\n\t\treturn nil, errors.New(\"configsrc: empty RemoteURL\")\n\t}\n\tif o.Branch == \"\" {\n\t\to.Branch = \"main\"\n\t}\n\tif o.Keep <= 0 {\n\t\to.Keep = DefaultKeep\n\t}\n\tif o.Now == nil {\n\t\to.Now = time.Now\n\t}\n\tif o.Log == nil {\n\t\to.Log = slog.Default()\n\t}\n\tif err := os.MkdirAll(o.CacheDir, 0o700); err != nil {\n\t\treturn nil, fmt.Errorf(\"configsrc: %w\", err)\n\t}\n\tents, err := os.ReadDir(o.CacheDir)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"configsrc: %w\", err)\n\t}\n\tfor _, e := range ents {\n\t\tif strings.Contains(e.Name(), \".tmp-\") {\n\t\t\t_ = os.RemoveAll(filepath.Join(o.CacheDir, e.Name()))\n\t\t}\n\t}\n\treturn &Source{o: o}, nil\n}\n\n// Load fetches the branch into refs/ard/config/<branch> in RepoDir, resolves\n// it to a SHA and returns the config at that SHA, with Resolved.Repo set to\n// the snapshot directory CacheDir/<sha> and Resolved.SHA to the SHA. An\n// unchanged SHA returns the cached *Resolved without exporting again. Any\n// error (fetch, resolve, export, validation) returns (nil, err); callers\n// treat it as paused. The fetch is a read, so it runs under --dry-run too.\nfunc (s *Source) Load(ctx context.Context) (*config.Resolved, error) {\n\ts.mu.Lock()\n\tdefer s.mu.Unlock()\n\to := s.o\n\n\tref := \"refs/ard/config/\" + o.Branch\n\tif err := o.Git.FetchRef(ctx, o.RepoDir, o.RemoteURL, \"+refs/heads/\"+o.Branch+\":\"+ref, o.Token); err != nil {\n\t\treturn nil, fmt.Errorf(\"config source: fetch %s: %w\", o.Branch, err)\n\t}\n\tsha, err := o.Git.RevParse(ctx, o.RepoDir, ref)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"config source: resolve %s: %w\", o.Branch, err)\n\t}\n\tif s.res != nil && s.sha == sha {\n\t\treturn s.res, nil\n\t}\n\n\tsnap := filepath.Join(o.CacheDir, sha)\n\tfresh := false\n\tif _, err := os.Stat(snap); errors.Is(err, os.ErrNotExist) {\n\t\tif err := s.export(ctx, sha, snap); err != nil {\n\t\t\treturn nil, fmt.Errorf(\"config at %.12s: %w\", sha, err)\n\t\t}\n\t\tfresh = true\n\t} else if err != nil {\n\t\treturn nil, fmt.Errorf(\"config at %.12s: %w\", sha, err)\n\t}\n\tres, err := config.Load(snap)\n\tif err != nil {\n\t\t// Wrap, so errors.As(err, &config.Errors{}) still works.\n\t\treturn nil, fmt.Errorf(\"config at %.12s: %w\", sha, err)\n\t}\n\tres.SHA = sha\n\t// The superseded snapshot may still be a running job's role directory:\n\t// stamp it so retention counts from now, not from when it was exported.\n\tprev := s.res\n\tif s.sha != \"\" && s.sha != sha {\n\t\tnow := s.o.Now()\n\t\tif err := os.Chtimes(filepath.Join(o.CacheDir, s.sha), now, now); err != nil {\n\t\t\to.Log.Warn(\"configsrc.stamp_failed\", \"sha\", s.sha, \"error\", err)\n\t\t}\n\t}\n\ts.sha, s.res = sha, res\n\tif fresh {\n\t\t// A job can run as long as its role's timeout, which may exceed Keep.\n\t\tkeep := max(o.Keep, longestTimeout(prev, res)+time.Hour)\n\t\ts.prune(sha, keep)\n\t}\n\treturn res, nil\n}\n\n// export writes the source paths at sha into snap through a temporary\n// directory, so a crash never leaves a half-written snapshot under its final\n// name.\nfunc (s *Source) export(ctx context.Context, sha, snap string) error {\n\t// A fixed name keeps error text stable across ticks (the status issue gets\n\t// one comment per distinct error). s.mu and the leader lock serialise use.\n\ttmp := snap + \".tmp-export\"\n\t_ = os.RemoveAll(tmp)\n\tif err := s.o.Git.ExportPaths(ctx, s.o.RepoDir, sha, tmp, config.SourcePaths()...); err != nil {\n\t\treturn err\n\t}\n\tif err := os.Rename(tmp, snap); err != nil {\n\t\t_ = os.RemoveAll(tmp)\n\t\treturn fmt.Errorf(\"publish snapshot: %w\", err)\n\t}\n\treturn nil\n}\n\n// prune removes the snapshots other than current that were last current (or\n// exported) more than Keep ago, judged by directory modification time.\nfunc (s *Source) prune(current string, keep time.Duration) {\n\tents, err := os.ReadDir(s.o.CacheDir)\n\tif err != nil {\n\t\ts.o.Log.Warn(\"configsrc.prune_failed\", \"error\", err)\n\t\treturn\n\t}\n\tcutoff := s.o.Now().Add(-keep)\n\tfor _, e := range ents {\n\t\tif !e.IsDir() || e.Name() == current || strings.Contains(e.Name(), \".tmp-\") {\n\t\t\tcontinue\n\t\t}\n\t\tinfo, err := e.Info()\n\t\tif err != nil || !info.ModTime().Before(cutoff) {\n\t\t\tcontinue\n\t\t}\n\t\tif err := os.RemoveAll(filepath.Join(s.o.CacheDir, e.Name())); err != nil {\n\t\t\ts.o.Log.Warn(\"configsrc.prune_failed\", \"snapshot\", e.Name(), \"error\", err)\n\t\t}\n\t}\n}\n\n// longestTimeout is the largest role timeout across the configs; nil is skipped.\nfunc longestTimeout(rs ...*config.Resolved) time.Duration {\n\tvar d time.Duration\n\tfor _, r := range rs {\n\t\tif r == nil {\n\t\t\tcontinue\n\t\t}\n\t\tfor _, role := range r.Roles {\n\t\t\td = max(d, role.Timeout)\n\t\t}\n\t}\n\treturn d\n}\npackage config\n\nimport (\n\t\"errors\"\n\t\"io/fs\"\n\n\t\"gopkg.in/yaml.v3\"\n)\n\n// SourcePaths lists the repo-relative paths a config load reads: the config\n// file and the four role-directory trees. It is what a snapshot of a commit\n// must contain. The .ard/<issue#>/ directories, with their logs, are not in\n// it. The list is built from kindDir and kindOrder so it cannot drift from\n// discover.\nfunc SourcePaths() []string {\n\tpaths := []string{\".ard/config.yaml\"}\n\tfor _, k := range kindOrder {\n\t\tpaths = append(paths, \".ard/\"+kindDir[k])\n\t}\n\treturn paths\n}\n\n// LocalPaused reports whether the config file in fsys (a working tree) says\n// `paused: true`. It reads only that key, and it never fails closed: a file\n// that is missing, unreadable or not valid YAML reports false with the error\n// (nil for a missing file), so the caller can log it. Every other setting\n// comes from the commit the controller runs from.\nfunc LocalPaused(fsys fs.FS) (bool, error) {\n\tdata, err := fs.ReadFile(fsys, \".ard/config.yaml\")\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn false, nil\n\t\t}\n\t\treturn false, err\n\t}\n\tvar v struct {\n\t\tPaused bool `yaml:\"paused\"`\n\t}\n\tif err := yaml.Unmarshal(data, &v); err != nil {\n\t\treturn false, err\n\t}\n\treturn v.Paused, nil\n}\ninternal/config/defaults.go:47:\tdefaultSidecarRef = \"main\"\ninternal/config/defaults.go:78:\t\tSidecars: map[string]Sidecar{},\ninternal/config/defaults.go:190:\tfor name, sc := range raw.sidecars {\ninternal/config/defaults.go:191:\t\tkey := \"sidecars.\" + name\ninternal/config/defaults.go:193:\t\t\terrs = append(errs, &Error{File: cfgPath, Key: key, Msg: \"sidecar name must be a simple key\"})\ninternal/config/defaults.go:195:\t\tentry := Sidecar{Ref: defaultSidecarRef}\ninternal/config/defaults.go:208:\t\tres.Sidecars[name] = entry\ninternal/config/load.go:50:\tagent, model, sidecar, tests *string\ninternal/config/load.go:71:\t\"agent\": true, \"model\": true, \"timeout\": true, \"sidecar\": true,\ninternal/config/load.go:83:// into the discovered roles, and cross-references role names and sidecar\ninternal/config/load.go:245:\t\tcase \"sidecar\":\ninternal/config/load.go:246:\t\t\terrs = append(errs, decodeValue(value, cfgPath, fkey, &ov.sidecar)...)\ninternal/config/load.go:377:// discovered roles and the sidecars map.\ninternal/config/load.go:385:\tif ov.sidecar != nil {\ninternal/config/load.go:386:\t\tif _, ok := res.Sidecars[*ov.sidecar]; !ok {\ninternal/config/load.go:387:\t\t\t*errs = append(*errs, &Error{File: cfgPath, Key: keyRef + \".sidecar\", Msg: fmt.Sprintf(\"no such sidecar (define it under the top-level sidecars key), got %q\", *ov.sidecar)})\ninternal/config/load.go:389:\t\trole.Sidecar = *ov.sidecar\ninternal/config/raw.go:35:\tsidecars               map[string]rawSidecar\ninternal/config/raw.go:55:type rawSidecar struct {\ninternal/config/raw.go:131:\t\tcase \"sidecars\":\ninternal/config/raw.go:132:\t\t\terrs = append(errs, raw.parseSidecars(value, cfgPath)...)\ninternal/config/raw.go:307:func (raw *rawConfig) parseSidecars(n *yaml.Node, file string) Errors {\ninternal/config/raw.go:313:\t\treturn Errors{{File: file, Key: \"sidecars\", Msg: \"must be a mapping of sidecar name to repo settings\"}}\ninternal/config/raw.go:315:\traw.sidecars = map[string]rawSidecar{}\ninternal/config/raw.go:318:\t\tkey := \"sidecars.\" + name\ninternal/config/raw.go:323:\t\tvar sc rawSidecar\ninternal/config/raw.go:335:\t\traw.sidecars[name] = sc\ninternal/config/render.go:37:\tSidecars        map[string]sidecarYAML `yaml:\"sidecars,omitempty\"`\ninternal/config/render.go:70:type sidecarYAML struct {\ninternal/config/render.go:87:\tSidecar string   `yaml:\"sidecar,omitempty\"`\ninternal/config/render.go:142:\t\tSidecars: map[string]sidecarYAML{},\ninternal/config/render.go:144:\tfor name, sc := range r.Sidecars {\ninternal/config/render.go:145:\t\tout.Sidecars[name] = sidecarYAML{Repo: sc.Repo, Ref: sc.Ref}\ninternal/config/render.go:159:\t\t\tSidecar:         role.Sidecar,\ninternal/config/types.go:97:// Sidecar is a read-only companion repo mounted into a role's job.\ninternal/config/types.go:98:type Sidecar struct {\ninternal/config/types.go:124:\tSidecar string        // key in Resolved.Sidecars; \"\" = none\ninternal/config/types.go:195:\tSidecars       map[string]Sidecar\ninternal/config/types.go:236:// SidecarFor returns the sidecar the role mounts; ok is false when it has none.\ninternal/config/types.go:237:// Loops set executor.Sidecar.Name from role.Sidecar so errors name the key.\n\t}\n\n\tlog := e.Log\n\t// The controller's own bare clone: every config fetch, committer lane and\n\t// executor worktree uses it, never the operator's checkout (#113).\n\tclone, err := openClone(ctx, gitx.New(\"\"), home, repo, d.RemoteURL, d.Token, log)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard serve: %w\", err)\n\t}\n\t// Config comes from origin/main, not from the working tree (#87): a merged\n\t// change applies on the next tick without a pull, and every job of a tick\n\t// runs against one commit.\n\tcacheDir, err := repopath.Join(filepath.Join(home, \".ard\", \"config\"), repo.String())\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard serve: %w\", err)\n\t}\n\tsrc, err := configsrc.New(configsrc.Options{\n\t\tGit: gitx.New(\"\"), RepoDir: clone, RemoteURL: d.RemoteURL, Token: d.Token,\n\t\tCacheDir: cacheDir, Log: log,\n\t})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard serve: %w\", err)\n\t}\n\tgate := controller.NewPauseGate(d.Reader, log)\n\t// root is the operator's checkout: read only (origin fallback, local paused). ard never writes to it (#113).\n\tgate.SetLocalConfig(root)\n\tpausePath, err := controller.PauseFilePath(home, repo.Owner, repo.Name)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard serve: %w\", err)\n\t}\n\tgate.SetPauseFile(pausePath)\n\t// Make `touch ~/.ard/pause/<owner>/<repo>` work on a fresh host.\n\tif err := os.MkdirAll(filepath.Dir(pausePath), 0o700); err != nil {\n\t\tlog.Warn(\"serve.pause_dir_failed\", \"path\", filepath.Dir(pausePath), \"error\", err)\n\t}\n\n\tw := &wiring{\n\t\tLog: log, Reader: d.Reader, Effects: d.Effects, Store: store, MaxPods: config.DefaultMaxPods,\n\t\tRepo: repo, Root: clone, Home: home, RemoteURL: d.RemoteURL, Token: d.Token, Scanners: scanners, Model: d.Model,\n\t\tStateDir: stateDir, Started: time.Now(),\n\t}\n     332 internal/configsrc/configsrc_test.go","is_error":false}]},"parent_tool_use_id":null,"session_id":"ca5cf25b-3e4f-4ffa-a661-8e00b2ab0e60","uuid":"46ef5dd4-f625-4dee-9a31-e428e6b259da","timestamp":"2026-11-24T12:02:45.284Z","tool_use_result":{"stdout":"// Package configsrc loads the controller's configuration from the tip of the\n// default branch on the remote, not from a working tree (decision #87). Each\n// load fetches the branch, resolves it to a SHA and materialises the config\n// file and role directories at that SHA into a snapshot directory on disk,\n// because roles run from a host path: the config, the role directories and\n// the scan worktree all have to describe the same commit.\npackage configsrc\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n)\n\n// DefaultKeep is how long a snapshot of a superseded SHA is kept. It is far\n// beyond any job timeout, so a running host-mode job keeps its role directory.\nconst DefaultKeep = 24 * time.Hour\n\n// Git is the slice of gitx the source needs; *gitx.Git satisfies it.\ntype Git interface {\n\tFetchRef(ctx context.Context, repoDir, url, refspec string, token gitx.TokenFunc) error\n\tRevParse(ctx context.Context, dir, ref string) (string, error)\n\tExportPaths(ctx context.Context, repoDir, sha, dest string, paths ...string) error\n}\n\n// Options configure a Source.\ntype Options struct {\n\tGit       Git\n\tRepoDir   string // absolute; the controller's clone (the object store)\n\tRemoteURL string\n\tToken     gitx.TokenFunc // nil in tests\n\tBranch    string         // default \"main\"\n\tCacheDir  string         // absolute; snapshots go in CacheDir/<sha>\n\tKeep      time.Duration  // snapshot retention; default DefaultKeep\n\tNow       func() time.Time\n\tLog       *slog.Logger\n}\n\n// Source loads config from the tip of a branch on the remote. It is safe for\n// concurrent use; calls are serialised.\ntype Source struct {\n\to Options\n\n\tmu  sync.Mutex\n\tsha string\n\tres *config.Resolved\n}\n\n// New validates o, creates the cache directory and removes the partial\n// snapshots a crashed run left behind.\nfunc New(o Options) (*Source, error) {\n\tswitch {\n\tcase o.Git == nil:\n\t\treturn nil, errors.New(\"configsrc: nil Git\")\n\tcase !filepath.IsAbs(o.RepoDir):\n\t\treturn nil, fmt.Errorf(\"configsrc: RepoDir %q is not absolute\", o.RepoDir)\n\tcase !filepath.IsAbs(o.CacheDir):\n\t\treturn nil, fmt.Errorf(\"configsrc: CacheDir %q is not absolute\", o.CacheDir)\n\tcase o.RemoteURL == \"\":\n\t\treturn nil, errors.New(\"configsrc: empty RemoteURL\")\n\t}\n\tif o.Branch == \"\" {\n\t\to.Branch = \"main\"\n\t}\n\tif o.Keep <= 0 {\n\t\to.Keep = DefaultKeep\n\t}\n\tif o.Now == nil {\n\t\to.Now = time.Now\n\t}\n\tif o.Log == nil {\n\t\to.Log = slog.Default()\n\t}\n\tif err := os.MkdirAll(o.CacheDir, 0o700); err != nil {\n\t\treturn nil, fmt.Errorf(\"configsrc: %w\", err)\n\t}\n\tents, err := os.ReadDir(o.CacheDir)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"configsrc: %w\", err)\n\t}\n\tfor _, e := range ents {\n\t\tif strings.Contains(e.Name(), \".tmp-\") {\n\t\t\t_ = os.RemoveAll(filepath.Join(o.CacheDir, e.Name()))\n\t\t}\n\t}\n\treturn &Source{o: o}, nil\n}\n\n// Load fetches the branch into refs/ard/config/<branch> in RepoDir, resolves\n// it to a SHA and returns the config at that SHA, with Resolved.Repo set to\n// the snapshot directory CacheDir/<sha> and Resolved.SHA to the SHA. An\n// unchanged SHA returns the cached *Resolved without exporting again. Any\n// error (fetch, resolve, export, validation) returns (nil, err); callers\n// treat it as paused. The fetch is a read, so it runs under --dry-run too.\nfunc (s *Source) Load(ctx context.Context) (*config.Resolved, error) {\n\ts.mu.Lock()\n\tdefer s.mu.Unlock()\n\to := s.o\n\n\tref := \"refs/ard/config/\" + o.Branch\n\tif err := o.Git.FetchRef(ctx, o.RepoDir, o.RemoteURL, \"+refs/heads/\"+o.Branch+\":\"+ref, o.Token); err != nil {\n\t\treturn nil, fmt.Errorf(\"config source: fetch %s: %w\", o.Branch, err)\n\t}\n\tsha, err := o.Git.RevParse(ctx, o.RepoDir, ref)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"config source: resolve %s: %w\", o.Branch, err)\n\t}\n\tif s.res != nil && s.sha == sha {\n\t\treturn s.res, nil\n\t}\n\n\tsnap := filepath.Join(o.CacheDir, sha)\n\tfresh := false\n\tif _, err := os.Stat(snap); errors.Is(err, os.ErrNotExist) {\n\t\tif err := s.export(ctx, sha, snap); err != nil {\n\t\t\treturn nil, fmt.Errorf(\"config at %.12s: %w\", sha, err)\n\t\t}\n\t\tfresh = true\n\t} else if err != nil {\n\t\treturn nil, fmt.Errorf(\"config at %.12s: %w\", sha, err)\n\t}\n\tres, err := config.Load(snap)\n\tif err != nil {\n\t\t// Wrap, so errors.As(err, &config.Errors{}) still works.\n\t\treturn nil, fmt.Errorf(\"config at %.12s: %w\", sha, err)\n\t}\n\tres.SHA = sha\n\t// The superseded snapshot may still be a running job's role directory:\n\t// stamp it so retention counts from now, not from when it was exported.\n\tprev := s.res\n\tif s.sha != \"\" && s.sha != sha {\n\t\tnow := s.o.Now()\n\t\tif err := os.Chtimes(filepath.Join(o.CacheDir, s.sha), now, now); err != nil {\n\t\t\to.Log.Warn(\"configsrc.stamp_failed\", \"sha\", s.sha, \"error\", err)\n\t\t}\n\t}\n\ts.sha, s.res = sha, res\n\tif fresh {\n\t\t// A job can run as long as its role's timeout, which may exceed Keep.\n\t\tkeep := max(o.Keep, longestTimeout(prev, res)+time.Hour)\n\t\ts.prune(sha, keep)\n\t}\n\treturn res, nil\n}\n\n// export writes the source paths at sha into snap through a temporary\n// directory, so a crash never leaves a half-written snapshot under its final\n// name.\nfunc (s *Source) export(ctx context.Context, sha, snap string) error {\n\t// A fixed name keeps error text stable across ticks (the status issue gets\n\t// one comment per distinct error). s.mu and the leader lock serialise use.\n\ttmp := snap + \".tmp-export\"\n\t_ = os.RemoveAll(tmp)\n\tif err := s.o.Git.ExportPaths(ctx, s.o.RepoDir, sha, tmp, config.SourcePaths()...); err != nil {\n\t\treturn err\n\t}\n\tif err := os.Rename(tmp, snap); err != nil {\n\t\t_ = os.RemoveAll(tmp)\n\t\treturn fmt.Errorf(\"publish snapshot: %w\", err)\n\t}\n\treturn nil\n}\n\n// prune removes the snapshots other than current that were last current (or\n// exported) more than Keep ago, judged by directory modification time.\nfunc (s *Source) prune(current string, keep time.Duration) {\n\tents, err := os.ReadDir(s.o.CacheDir)\n\tif err != nil {\n\t\ts.o.Log.Warn(\"configsrc.prune_failed\", \"error\", err)\n\t\treturn\n\t}\n\tcutoff := s.o.Now().Add(-keep)\n\tfor _, e := range ents {\n\t\tif !e.IsDir() || e.Name() == current || strings.Contains(e.Name(), \".tmp-\") {\n\t\t\tcontinue\n\t\t}\n\t\tinfo, err := e.Info()\n\t\tif err != nil || !info.ModTime().Before(cutoff) {\n\t\t\tcontinue\n\t\t}\n\t\tif err := os.RemoveAll(filepath.Join(s.o.CacheDir, e.Name())); err != nil {\n\t\t\ts.o.Log.Warn(\"configsrc.prune_failed\", \"snapshot\", e.Name(), \"error\", err)\n\t\t}\n\t}\n}\n\n// longestTimeout is the largest role timeout across the configs; nil is skipped.\nfunc longestTimeout(rs ...*config.Resolved) time.Duration {\n\tvar d time.Duration\n\tfor _, r := range rs {\n\t\tif r == nil {\n\t\t\tcontinue\n\t\t}\n\t\tfor _, role := range r.Roles {\n\t\t\td = max(d, role.Timeout)\n\t\t}\n\t}\n\treturn d\n}\npackage config\n\nimport (\n\t\"errors\"\n\t\"io/fs\"\n\n\t\"gopkg.in/yaml.v3\"\n)\n\n// SourcePaths lists the repo-relative paths a config load reads: the config\n// file and the four role-directory trees. It is what a snapshot of a commit\n// must contain. The .ard/<issue#>/ directories, with their logs, are not in\n// it. The list is built from kindDir and kindOrder so it cannot drift from\n// discover.\nfunc SourcePaths() []string {\n\tpaths := []string{\".ard/config.yaml\"}\n\tfor _, k := range kindOrder {\n\t\tpaths = append(paths, \".ard/\"+kindDir[k])\n\t}\n\treturn paths\n}\n\n// LocalPaused reports whether the config file in fsys (a working tree) says\n// `paused: true`. It reads only that key, and it never fails closed: a file\n// that is missing, unreadable or not valid YAML reports false with the error\n// (nil for a missing file), so the caller can log it. Every other setting\n// comes from the commit the controller runs from.\nfunc LocalPaused(fsys fs.FS) (bool, error) {\n\tdata, err := fs.ReadFile(fsys, \".ard/config.yaml\")\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn false, nil\n\t\t}\n\t\treturn false, err\n\t}\n\tvar v struct {\n\t\tPaused bool `yaml:\"paused\"`\n\t}\n\tif err := yaml.Unmarshal(data, &v); err != nil {\n\t\treturn false, err\n\t}\n\treturn v.Paused, nil\n}\ninternal/config/defaults.go:47:\tdefaultSidecarRef = \"main\"\ninternal/config/defaults.go:78:\t\tSidecars: map[string]Sidecar{},\ninternal/config/defaults.go:190:\tfor name, sc := range raw.sidecars {\ninternal/config/defaults.go:191:\t\tkey := \"sidecars.\" + name\ninternal/config/defaults.go:193:\t\t\terrs = append(errs, &Error{File: cfgPath, Key: key, Msg: \"sidecar name must be a simple key\"})\ninternal/config/defaults.go:195:\t\tentry := Sidecar{Ref: defaultSidecarRef}\ninternal/config/defaults.go:208:\t\tres.Sidecars[name] = entry\ninternal/config/load.go:50:\tagent, model, sidecar, tests *string\ninternal/config/load.go:71:\t\"agent\": true, \"model\": true, \"timeout\": true, \"sidecar\": true,\ninternal/config/load.go:83:// into the discovered roles, and cross-references role names and sidecar\ninternal/config/load.go:245:\t\tcase \"sidecar\":\ninternal/config/load.go:246:\t\t\terrs = append(errs, decodeValue(value, cfgPath, fkey, &ov.sidecar)...)\ninternal/config/load.go:377:// discovered roles and the sidecars map.\ninternal/config/load.go:385:\tif ov.sidecar != nil {\ninternal/config/load.go:386:\t\tif _, ok := res.Sidecars[*ov.sidecar]; !ok {\ninternal/config/load.go:387:\t\t\t*errs = append(*errs, &Error{File: cfgPath, Key: keyRef + \".sidecar\", Msg: fmt.Sprintf(\"no such sidecar (define it under the top-level sidecars key), got %q\", *ov.sidecar)})\ninternal/config/load.go:389:\t\trole.Sidecar = *ov.sidecar\ninternal/config/raw.go:35:\tsidecars               map[string]rawSidecar\ninternal/config/raw.go:55:type rawSidecar struct {\ninternal/config/raw.go:131:\t\tcase \"sidecars\":\ninternal/config/raw.go:132:\t\t\terrs = append(errs, raw.parseSidecars(value, cfgPath)...)\ninternal/config/raw.go:307:func (raw *rawConfig) parseSidecars(n *yaml.Node, file string) Errors {\ninternal/config/raw.go:313:\t\treturn Errors{{File: file, Key: \"sidecars\", Msg: \"must be a mapping of sidecar name to repo settings\"}}\ninternal/config/raw.go:315:\traw.sidecars = map[string]rawSidecar{}\ninternal/config/raw.go:318:\t\tkey := \"sidecars.\" + name\ninternal/config/raw.go:323:\t\tvar sc rawSidecar\ninternal/config/raw.go:335:\t\traw.sidecars[name] = sc\ninternal/config/render.go:37:\tSidecars        map[string]sidecarYAML `yaml:\"sidecars,omitempty\"`\ninternal/config/render.go:70:type sidecarYAML struct {\ninternal/config/render.go:87:\tSidecar string   `yaml:\"sidecar,omitempty\"`\ninternal/config/render.go:142:\t\tSidecars: map[string]sidecarYAML{},\ninternal/config/render.go:144:\tfor name, sc := range r.Sidecars {\ninternal/config/render.go:145:\t\tout.Sidecars[name] = sidecarYAML{Repo: sc.Repo, Ref: sc.Ref}\ninternal/config/render.go:159:\t\t\tSidecar:         role.Sidecar,\ninternal/config/types.go:97:// Sidecar is a read-only companion repo mounted into a role's job.\ninternal/config/types.go:98:type Sidecar struct {\ninternal/config/types.go:124:\tSidecar string        // key in Resolved.Sidecars; \"\" = none\ninternal/config/types.go:195:\tSidecars       map[string]Sidecar\ninternal/config/types.go:236:// SidecarFor returns the sidecar the role mounts; ok is false when it has none.\ninternal/config/types.go:237:// Loops set executor.Sidecar.Name from role.Sidecar so errors name the key.\n\t}\n\n\tlog := e.Log\n\t// The controller's own bare clone: every config fetch, committer lane and\n\t// executor worktree uses it, never the operator's checkout (#113).\n\tclone, err := openClone(ctx, gitx.New(\"\"), home, repo, d.RemoteURL, d.Token, log)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard serve: %w\", err)\n\t}\n\t// Config comes from origin/main, not from the working tree (#87): a merged\n\t// change applies on the next tick without a pull, and every job of a tick\n\t// runs against one commit.\n\tcacheDir, err := repopath.Join(filepath.Join(home, \".ard\", \"config\"), repo.String())\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard serve: %w\", err)\n\t}\n\tsrc, err := configsrc.New(configsrc.Options{\n\t\tGit: gitx.New(\"\"), RepoDir: clone, RemoteURL: d.RemoteURL, Token: d.Token,\n\t\tCacheDir: cacheDir, Log: log,\n\t})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard serve: %w\", err)\n\t}\n\tgate := controller.NewPauseGate(d.Reader, log)\n\t// root is the operator's checkout: read only (origin fallback, local paused). ard never writes to it (#113).\n\tgate.SetLocalConfig(root)\n\tpausePath, err := controller.PauseFilePath(home, repo.Owner, repo.Name)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"ard serve: %w\", err)\n\t}\n\tgate.SetPauseFile(pausePath)\n\t// Make `touch ~/.ard/pause/<owner>/<repo>` work on a fresh host.\n\tif err := os.MkdirAll(filepath.Dir(pausePath), 0o700); err != nil {\n\t\tlog.Warn(\"serve.pause_dir_failed\", \"path\", filepath.Dir(pausePath), \"error\", err)\n\t}\n\n\tw := &wiring{\n\t\tLog: log, Reader: d.Reader, Effects: d.Effects, Store: store, MaxPods: config.DefaultMaxPods,\n\t\tRepo: repo, Root: clone, Home: home, RemoteURL: d.RemoteURL, Token: d.Token, Scanners: scanners, Model: d.Model,\n\t\tStateDir: stateDir, Started: time.Now(),\n\t}\n     332 internal/configsrc/configsrc_test.go","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_014WH4KmfBWG9XAHscpjinyW","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011ChMigENAhyn4o52Gb41k9","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GL4A7jcWzh4V3ir2EPeMkY","name":"Bash","input":{"command":"sed -n 90,110p internal/config/types.go; sed -n 185,200p internal/config/types.go; sed -n 20,70p internal/config/raw.go; sed -n 100,140p internal/config/raw.go; sed -n 300,375p internal/config/raw.go; grep -n \"Sidecar\" internal/config/defaults.go | head; sed -n 1,80p internal/configsrc/configsrc_test.go; grep -n \"func (g \\*Git) \\(InitBare\\|FetchShallow\\|ExportPaths\\|FetchRef\\)\" -A12 internal/gitx/*.go | head -90"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6048,"cache_read_input_tokens":15088,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6048},"output_tokens":20,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ca5cf25b-3e4f-4ffa-a661-8e00b2ab0e60","uuid":"a91d95fa-ffb4-42b6-959e-6f3cde727283","timestamp":"2026-11-24T12:02:47.167Z","request_id":"req_011ChMigEDyuBfWR51ojELVb"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GL4A7jcWzh4V3ir2EPeMkY","type":"tool_result","content":"// spell because package labels owns every ard: literal. Consumers resolve it\n// with intake.Label; nothing else reads Label directly.\ntype Intake struct {\n\tMode  IntakeMode // default IntakeLabel\n\tLabel string     // label mode only; \"\" = the lead's request label\n}\n\n// Sidecar is a read-only companion repo mounted into a role's job.\ntype Sidecar struct {\n\tRepo string // \"owner/name\"\n\tRef  string // branch, tag or full 40-hex SHA; default \"main\"\n}\n\n// When gates a reviewer: a nil When means the reviewer runs on every PR.\n// See Matches for the semantics.\ntype When struct {\n\tPaths  []string // run only when the diff touches one of these paths\n\tTriage []string // run only when one of these triage roles ran\n}\n\n// Role is one discovered role directory plus its resolved settings.\n\tBudgetUSDPerDay float64 // whole-repo daily cap; default 50\n\tMaxBudgetUSD    float64 // default per-job cap; default 5\n\tGlobalMaxOpen   int     // open scanner issues across all scanners; default 30\n\tPaused          bool\n\n\tIntervals      Intervals\n\tIntake         Intake\n\tProtectedPaths []string // merge.protected_paths: \"dir/\" = directory prefix, else doublestar glob; see Protected\n\tStale          Stale\n\tRedact         Redact\n\tSidecars       map[string]Sidecar\n\tRoles          []Role // sorted by Kind then Name\n}\n\n// Role returns the role of the given kind and name.\nfunc (r *Resolved) Role(k Kind, name string) (Role, bool) {\n\tagent                  *string\n\trequireApproval        *bool\n\tbudgetUSDPerDay        *float64\n\tmaxBudgetUSD           *float64\n\tglobalMaxOpen          *int\n\tpaused                 *bool\n\tintervals              rawIntervals\n\tintake                 rawIntake\n\tprotectedPaths         []string // merge.protected_paths\n\thaveMerge              bool\n\tstale                