Sprintf(\"cannot stat: %v\", err)})\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tfiles[relName] = info\n\t\t\textras[relName] = true\n\t\t}\n\t\treturn true\n\t}\n\tif !walk(\".\") {\n\t\treturn Role{}, false\n\t}\n\n\tpromptInfo, hasPrompt := files[\"prompt.txt\"]\n\tscanInfo, hasScan := files[\"scan\"]\n\tif _, hasDockerfile := files[\"Dockerfile\"]; hasDockerfile {\n\t\trole.Dockerfile = dir + \"/Dockerfile\"\n\t\tdelete(extras, \"Dockerfile\")\n\t}\n\n\tswitch kind {\n\tcase KindScanner:\n\t\tswitch {\n\t\tcase hasPrompt && hasScan:\n\t\t\t*errs = append(*errs, &Error{File: dir, Msg: \"has both scan and prompt.txt; a scanner is exactly one of them\"})\n\t\t\treturn Role{}, false\n\t\tcase hasScan:\n\t\t\tif !isExecutable(scanInfo) {\n\t\t\t\t*errs = append(*errs, &Error{File: dir, Key: \"scan\", Msg: \"must be executable (chmod +x) for a deterministic scanner\"})\n\t\t\t\treturn Role{}, false\n\t\t\t}\n\t\t\trole.ScanPath = dir + \"/scan\"\n\t\t\tdelete(extras, \"scan\")\n\t\tcase hasPrompt:\n\t\t\tif !nonEmpty(promptInfo) {\n\t\t\t\t*errs = append(*errs, &Error{File: dir, Key: \"prompt.txt\", Msg: \"must not be empty\"})\n\t\t\t\treturn Role{}, false\n\t\t\t}\n\t\t\trole.PromptPath = dir + \"/prompt.txt\"\n\t\t\tdelete(extras, \"prompt.txt\")\n\t\tdefault:\n\t\t\t*errs = append(*errs, &Error{File: dir, Msg: \"needs an executable scan or a prompt.txt\"})\n\t\t\treturn Role{}, false\n\t\t}\n\tdefault:\n\t\tif hasScan {\n\t\t\t*errs = append(*errs, &Error{File: dir, Key: \"scan\", Msg: \"only scanners may have a scan script\"})\n\t\t\treturn Role{}, false\n\t\t}\n\t\tif !hasPrompt {\n\t\t\t*errs = append(*errs, &Error{File: dir, Msg: \"needs a prompt.txt\"})\n\t\t\treturn Role{}, false\n\t\t}\n\t\tif !nonEmpty(promptInfo) {\n\t\t\t*errs = append(*errs, &Error{File: dir, Key: \"prompt.txt\", Msg: \"must not be empty\"})\n\t\t\treturn Role{}, false\n\t\t}\n\t\trole.PromptPath = dir + \"/prompt.txt\"\n\t\tdelete(extras, \"prompt.txt\")\n\t}\n\n\tfor rel := range extras {\n\t\trole.Extra = append(role.Extra, rel)\n\t}\n\tsort.Strings(role.Extra)\n\treturn role, true\n}\n\nfunc isExecutable(info fs.FileInfo) bool { return info.Mode().Perm()&0o111 != 0 }\n\nfunc nonEmpty(info fs.FileInfo) bool { return info.Size() > 0 }\npackage config\n\nimport (\n\t\"errors\"\n\t\"io/fs\"\n\n\t\"gopkg.in/yaml.v3\"\n)\n\n// SourcePaths lists the repo-relative paths a config load reads: the config\n// file and the four role-directory trees. It is what a snapshot of a commit\n// must contain. The .ard/<issue#>/ directories, with their logs, are not in\n// it. The list is built from kindDir and kindOrder so it cannot drift from\n// discover.\nfunc SourcePaths() []string {\n\tpaths := []string{\".ard/config.yaml\"}\n\tfor _, k := range kindOrder {\n\t\tpaths = append(paths, \".ard/\"+kindDir[k])\n\t}\n\treturn paths\n}\n\n// LocalPaused reports whether the config file in fsys (a working tree) says\n// `paused: true`. It reads only that key, and it never fails closed: a file\n// that is missing, unreadable or not valid YAML reports false with the error\n// (nil for a missing file), so the caller can log it. Every other setting\n// comes from the commit the controller runs from.\nfunc LocalPaused(fsys fs.FS) (bool, error) {\n\tdata, err := fs.ReadFile(fsys, \".ard/config.yaml\")\n\tif err != nil {\n\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\treturn false, nil\n\t\t}\n\t\treturn false, err\n\t}\n\tvar v struct {\n\t\tPaused bool `yaml:\"paused\"`\n\t}\n\tif err := yaml.Unmarshal(data, &v); err != nil {\n\t\treturn false, err\n\t}\n\treturn v.Paused, nil\n}\nconfig/types.go:97:// Sidecar is a read-only companion repo mounted into a role's job.\nconfig/types.go:98:type Sidecar struct {\nconfig/types.go:124:\tSidecar string        // key in Resolved.Sidecars; \"\" = none\nconfig/types.go:195:\tSidecars       map[string]Sidecar\nconfig/types.go:236:// SidecarFor returns the sidecar the role mounts; ok is false when it has none.\nconfig/types.go:237:// Loops set