ng) (string, error) {\n\tif configPath == \"\" {\n\t\treturn \".\", nil\n\t}\n\tabs, err := filepath.Abs(configPath)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"resolving --config: %w\", err)\n\t}\n\tdir := filepath.Dir(abs)\n\tif filepath.Base(dir) == \".ard\" {\n\t\treturn filepath.Dir(dir), nil\n\t}\n\treturn dir, nil\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01XR5GcUVR5FXDXrpCzrePnc","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
