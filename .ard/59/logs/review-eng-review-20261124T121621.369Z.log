rrNotExist) {\n342\t-\t\tif err := s.export(ctx, sha, snap); err != nil {\n343\t-\t\t\treturn nil, fmt.Errorf(\"config at %.12s: %w\", sha, err)\n344\t-\t\t}\n345\t-\t\tfresh = true\n346\t-\t} else if err != nil {\n347\t+\tname, fresh, rsha, err := s.publish(ctx, sha)\n348\t+\tif err != nil {\n349\t \t\treturn nil, fmt.Errorf(\"config at %.12s: %w\", sha, err)\n350\t \t}\n351\t+\tsnap := filepath.Join(o.CacheDir, name)\n352\t \tres, err := config.Load(snap)\n353\t \tif err != nil {\n354\t \t\t// Wrap, so errors.As(err, &config.Errors{}) still works.\n355\t \t\treturn nil, fmt.Errorf(\"config at %.12s: %w\", sha, err)\n356\t \t}\n357\t \tres.SHA = sha\n358\t+\tres.RolesSHA = rsha\n359\t \t// The superseded snapshot may still be a running job's role directory:\n360\t \t// stamp it so retention counts from now, not from when it was exported.\n361\t \tprev := s.res\n362\t-\tif s.sha != \"\" && s.sha != sha {\n363\t+\tif s.snap != \"\" && s.snap != name {\n364\t \t\tnow := s.o.Now()\n365\t-\t\tif err := os.Chtimes(filepath.Join(o.CacheDir, s.sha), now, now); err != nil {\n366\t-\t\t\to.Log.Warn(\"configsrc.stamp_failed\", \"sha\", s.sha, \"error\", err)\n367\t+\t\tif err := os.Chtimes(filepath.Join(o.CacheDir, s.snap), now, now); err != nil {\n368\t+\t\t\to.Log.Warn(\"configsrc.stamp_failed\", \"sha\", s.snap, \"error\", err)\n369\t \t\t}\n370\t \t}\n371\t+\ts.snap = name\n372\t \ts.sha, s.res = sha, res\n373\t \tif fresh {\n374\t \t\t// A job can run as long as its role's timeout, which may exceed Keep.\n375\t \t\tkeep := max(o.Keep, longestTimeout(prev, res)+time.Hour)\n376\t-\t\ts.prune(sha, keep)\n377\t+\t\ts.prune(name, keep)\n378\t \t}\n379\t \treturn res, nil\n380\t }\n381\t \n382\t-// export writes the source paths at sha into snap through a temporary\n383\t-// directory, so a crash never leaves a half-written snapshot under its final\n384\t-// name.\n385\t-func (s *Source) export(ctx context.Context, sha, snap string) error {\n386\t+// publish makes the snapshot