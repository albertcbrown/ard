426\t+\tif _, err := os.Stat(final); err == nil {\n427\t+\t\tdiscard()\n428\t+\t\treturn name, false, rsha, nil\n429\t+\t}\n430\t+\tif err := s.mergeShared(ctx, rsha, tmp); err != nil {\n431\t+\t\tdiscard()\n432\t+\t\treturn \"\", false, \"\", err\n433\t+\t}\n434\t+\tif _, err := config.Load(tmp); err != nil {\n435\t+\t\tdiscard()\n436\t+\t\treturn \"\", false, \"\", err\n437\t+\t}\n438\t+\tif err := os.Rename(tmp, final); err != nil {\n439\t+\t\tdiscard()\n440\t+\t\treturn \"\", false, \"\", fmt.Errorf(\"publish snapshot: %w\", err)\n441\t+\t}\n442\t+\treturn name, true, rsha, nil\n443\t+}\n444\t+\n445\t+// fetchShared fetches the pinned ref of the shared roles repo into SharedDir\n446\t+// and returns its commit SHA.\n447\t+func (s *Source) fetchShared(ctx context.Context, rr config.Sidecar) (string, error) {\n448\t+\to := s.o\n449\t+\twrap := func(err error) error {\n450\t+\t\treturn fmt.Errorf(\"roles_repo %s@%s: %w\", rr.Repo, rr.Ref, err)\n451\t+\t}\n452\t+\tif !filepath.IsAbs(o.SharedDir) {\n453\t+\t\treturn \"\", wrap(errors.New(\"no absolute SharedDir configured\"))\n454\t+\t}\n455\t+\tif _, err := os.Stat(filepath.Join(o.SharedDir, \"HEAD\")); err != nil {\n456\t+\t\tif err := o.Git.InitBare(ctx, o.SharedDir); err != nil {\n457\t+\t\t\treturn \"\", wrap(err)\n458\t+\t\t}\n459\t+\t}\n460\t+\tconst local = \"refs/ard/roles\"\n461\t+\tif err := o.Git.FetchShallow(ctx, o.SharedDir, o.SharedURL(rr.Repo), \"+\"+rr.Ref+\":\"+local, o.Token); err != nil {\n462\t+\t\treturn \"\", wrap(err)\n463\t+\t}\n464\t+\trsha, err := o.Git.RevParse(ctx, o.SharedDir, local)\n465\t+\tif err != nil {\n466\t+\t\treturn \"\", wrap(err)\n467\t+\t}\n468\t+\tif gitref.IsSHA(rr.Ref) && rsha != rr.Ref {\n469\t+\t\treturn \"\", wrap(fmt.Errorf(\"fetched %s, want %s\", rsha, rr.Ref))\n470\t+\t}\n471\t+\treturn rsha, nil\n472\t+}\n473\t+\n474\t+// mergeShared copies each role directory of the shared commit rsha into dir\n475\t+// unless dir already has a directory of that kind and name: the local\n476\t+// directory wins whole, never file by file.\n477\t+func (s *Source) mergeShared(ctx context.Context, rsha, dir string) error {\n478\t+\tex := filepath.Join(s.o.CacheDir, filepath.Base(dir)+\"-shared\")\n479\t+\t_ = os.RemoveAll(ex)\n480\t+\tdefer os.RemoveAll(ex)\n481\t+\tif err := s.o.Git.ExportPaths(ctx, s.o.SharedDir, rsha, ex, config.SharedSourcePaths()...); err != nil {\n482\t+\t\treturn fmt.Errorf(\"roles_repo: %w\", err)\n483\t+\t}\n484\t+\tkinds, err := os.ReadDir(filepath.Join(ex, \".ard\"))\n485\t+\tif errors.Is(err, os.ErrNotExist) {\n486\t+\t\treturn nil\n487\t+\t} else if err != nil {\n488\t \t\treturn err\n489\t \t}\n490\t-\tif err := os.Rename(tmp, snap); err != nil {\n491\t-\t\t_ = os.RemoveAll(tmp)\n492\t-\t\treturn fmt.Errorf(\"publish snapshot: %w\", err)\n493\t+\tfor _, k := range kinds {\n494\t+\t\troles, err := os.ReadDir(filepath.Join(ex, \".ard\", k.Name()))\n495\t+\t\tif err != nil {\n496\t+\t\t\tcontinue // a file, not a tree\n497\t+\t\t}\n498\t+\t\tfor _, r := range roles {\n499\t+\t\t\tdst := filepath.Join(dir, \".ard\", k.Name(), r.Name())\n500\t+\t\t\tif _, err := os.Lstat(dst); err == nil {\n501\t+\t\t\t\tcontinue\n502\t+\t\t\t}\n503\t+\t\t\tif err := os.MkdirAll(filepath.Dir(dst), 0o755); err != nil {\n504\t+\t\t\t\treturn err\n505\t+\t\t\t}\n506\t+\t\t\tif err := os.Rename(filepath.Join(ex, \".ard\", k.Name(), r.Name()), dst); err != nil {\n507\t+\t\t\t\treturn err\n508\t+\t\t\t}\n509\t+\t\t}\n510\t \t}\n511\t \treturn nil\n512\t }\n513\tdiff --git a/internal/configsrc/shared_test.go b/internal/configsrc/shared_test.go\n514\tnew file mode 100644\n515\tindex 0000000..2c95d0b\n516\t--- /dev/null\n517\t+++ b/internal/configsrc/shared_test.go\n518\t@@ -0,0 +1,267 @@\n519\t+package configsrc\n520\t+\n521\t+import (\n522\t+\t\"context\"\n523\t+\t\"io\"\n524\t+\t\"log/slog\"\n525\t+\t\"os\"\n526\t+\t\"path/filepath\"\n527\t+\t\"strings\"\n528\t+\t\"testing\"\n529\t+\n530\t+\t\"github.com/albertcbrown/ard/internal/config\"\n5