bels.StageTriage, \"engineer\")) || e.has(worker) {\n\t\tt.Fatalf(\"after the engineer: labels %v comments %+v\", e.labels(), e.comments())\n\t}\n\te.tick() // triage is done: ask for approval\n\tif e.has(worker) {\n\t\tt.Fatalf(\"worker started without approval: %v\", e.labels())\n\t}\n\tasked := 0\n\tfor _, c := range e.comments() {\n\t\tif strings.Contains(c.Body, \"ready for approval\") {\n\t\t\tasked++\n\t\t}\n\t}\n\tif asked != 1 {\n\t\tt.Fatalf(\"approval comments = %d\", asked)\n\t}\n\ttime.Sleep(1100 * time.Millisecond) // the approval must come after the last :done, at second resolution\n\tif err := e.gh.As(\"maint\").AddLabels(context.Background(), e.issueN, labels.Approved); err != nil {\n\t\tt.Fatal(err)\n\t}\n\te.tick()\n\tif !e.has(worker) {\n\t\tt.Fatalf(\"worker not started after approval: %v\", e.labels())\n\t}\n}\npackage servecmd\n\n\n)\n\n// A fake claude for the reviewer. It checks that the diff reached it, writes\n// its role file (a blocking finding on an added line, one on a file the PR did\n// not touch) and leaks the token on stderr. It also tries to edit code, which\n// close-out must never collect.\nconst reviewerAgent = `#!/bin/sh\nfor d in .ard-input/*; do n=${d##*/}; done\ntest -n \"$CLAUDE_CODE_OAUTH_TOKEN\" || exit 4\ngrep -q 'hello.go' \".ard-input/$n/diff.patch\" || exit 5\ngrep -q 'It is broken' \".ard-input/$n/issue.md\" || exit 6\necho \"using token $CLAUDE_CODE_OAUTH_TOKEN\" >&2\necho tampered > hello.go\nmkdir -p \".ard/$n\"\ncat > \".ard/$n/review-eng-review.md\" <<'EOF2'\n---\nrole: eng-review\nstatus: done\nattempt: 1\nverdict: changes\nfindings:\n  - file: hello.go\n    line: 2\n    severity: high\n    blocking: true\n    message: The function ignores its argument.\n  - file: README.md\n    line: 1\n    severity: low\n    message: The readme is stale.\n---\nOne blocking problem.\nEOF2\ntriage_e2e_test.go:306:func itoa(n int) string { return strconv.Itoa(n) }","is_error":false}]},"parent_tool_use_id":null,"session_id":"611