{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F2XVoAvh9rCk2VE5adSoTs","type":"tool_result","content":")\n\n// Identity is a git author/committer identity.\ntype Identity struct{ Name, Email string }\n\nvar (\n\t// ErrNothingToCommit means the index matches HEAD. Callers treat it as a\n\t// no-op, not a failure.\n\tErrNothingToCommit = errors.New(\"gitx: nothing to commit\")\n\t// ErrNonFastForward means the remote ref moved and the push was rejected.\n\tErrNonFastForward = errors.New(\"gitx: push rejected: non-fast-forward\")\n\t// ErrStaleLease means a --force-with-lease expectation did not hold.\n\tErrStaleLease = errors.New(\"gitx: push rejected: stale lease\")\n)\n\n// Git runs the git binary.\ntype Git struct{ bin string }\n\n// New returns a Git using bin, or \"git\" when bin is empty.\nfunc New(bin string) *Git {\n\tif bin == \"\" {\n\t\tbin = \"git\"\n\t}\n\treturn &Git{bin: bin}\n}\n\n// runError carries stderr (already scrubbed) from a failed git command.\ntype runError struct {\n\targs   []string\n\tstderr string\n\terr    error\n\t\t\"GIT_AUTHOR_NAME=\" + op.Author.Name, \"GIT_AUTHOR_EMAIL=\" + op.Author.Email,\n\t\t\"GIT_COMMITTER_NAME=\" + op.Author.Name, \"GIT_COMMITTER_EMAIL=\" + op.Author.Email,\n\t}\n\t// Hooks are disabled and signing is off so a commit never depends on the\n\t// host's git configuration.\n\t_, _, err := g.run(ctx, op.Dir, env, op.Message, nil,\n\t\t\"-c\", \"core.hooksPath=/dev/null\", \"-c\", \"commit.gpgsign=false\",\n\t\t\"commit\", \"--quiet\", \"-F\", \"-\")\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"gitx: commit in %s: %w\", op.Dir, err)\n\t}\n\treturn g.RevParse(ctx, op.Dir, \"HEAD\")\n}\n\n// Push pushes op.Ref. Typed errors: ErrNonFastForward, ErrStaleLease.\nfunc (g *Git) Push(ctx context.Context, op PushOp) error {\n\targs := []string{\"push\", \"--porcelain\"}\n\tif op.ForceWithLease != \"\" {\n\t\tdst := op.Ref\n\t\tif i := strings.LastIndex(dst, \":\"); i >= 0 {\n\t\t\tdst = dst[i+1:]\n\t\t}\n\t\targs = append(args, \"--force-with-lease=\"+dst+\":\"+op.ForceWithLease)\n\t}\n\targs = append(args, op.Remote, op.Ref)\n\tvar env, secrets []string\n\tif op.Token != nil {\n\t\ttok, err := op.Token(ctx)\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"gitx: push token: %w\", err)\n\t\t}\n\t\tenv = pushEnv(tok, op.Remote)\n\t\tsecrets = []string{tok}\n\t}\n\tstdout, stderr, err := g.run(ctx, op.Dir, env, \"\", secrets, args...)\n\tif err == nil {\n\t\treturn nil\n\t}\n\tstderr = stdout + stderr // --porcelain reports rejections on stdout\n\tswitch {\n\tcase strings.Contains(stderr, \"stale info\"):\n\t\treturn fmt.Errorf(\"gitx: push %s: %w\", op.Ref, ErrStaleLease)\n\tcase strings.Contains(stderr, \"non-fast-forward\"), strings.Contains(stderr, \"fetch first\"):\n\t\treturn fmt.Errorf(\"gitx: push %s: %w\", op.Ref, ErrNonFastForward)\n\t}\n\treturn fmt.Errorf(\"gitx: push %s: %w\", op.Ref, err)\n}\n\n// pushEnv passes the credential to git through the environment (never argv,\n// which is visible in the process list).\nfunc pushEnv(token, remote string) []string {\n\tcred := base64.StdEncoding.EncodeToString([]byte(\"x-access-token:\" + token))\n\treturn []string{\n\t\t\"GIT_CONFIG_COUNT=1\",\n\t\t\"GIT_CONFIG_KEY_0=\" + headerKey(remote),\n\t\t\"GIT_CONFIG_VALUE_0=Authorization: Basic \" + cred,\n\t}\n}\n\n// scrub removes each secret, and its base64 forms, from s.\nfunc scrub(s string, secrets ...string) string {\n\tfor _, sec := range secrets {\n\t\tif sec == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tfor _, form := range []string{\n\t\t\tbase64.StdEncoding.EncodeToString([]byte(\"x-access-token:\" + sec)),\n\t\t\tbase64.StdEncoding.EncodeToString([]byte(sec)),\n\t\t\tsec,\n\t\t} {\n\t\t\ts = strings.ReplaceAll(s, form, \"[REDACTED]\")\n\t\t}\n\t}\n\treturn s\n}\n\n// headerKey scopes the auth header to the remote's scheme and host, so a\n// redirect to another host never receives the credential.\nfunc headerKey(remote string) string {\n\tu, err := url.Parse(remote)\n\tif err != nil || u.Host == \"\" {\n\t\treturn \"http.extraheader\"\n\t}\n\treturn \"http.\" + u.Scheme + \"://\" + u.Host + \"/.extraheader\"\n}\n// ref that does not exist returns ErrRefNotFound.\nfunc (g *Git) FetchRef(ctx context.Context, repoDir, url, refspec string, token TokenFunc) error {\n\treturn g.fetch(ctx, repoDir, url, refspec, token, false)\n}\n\n// FetchShallow is FetchRef with --depth=1 and -c gc.auto=0 (no detached\n// gc --auto is left running, and cache hits stay deterministic). A remote ref\n// that does not exist (\"couldn't find remote ref\") or a SHA the remote does\n// not have (\"not our ref\") returns ErrRefNotFound.\nfunc (g *Git) FetchShallow(ctx context.Context, repoDir, url, refspec string, token TokenFunc) error {\n\treturn g.fetch(ctx, repoDir, url, refspec, token, true)\n}\n\nfunc (g *Git) fetch(ctx context.Context, repoDir, url, refspec string, token TokenFunc, shallow bool) error {\n\tvar env, secrets []string\n\tif token != nil {\n\t\ttok, err := token(ctx)\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"gitx: fetch token: %w\", err)\n\t\t}\n\t\tenv, secrets = pushEnv(tok, url), []string{tok}\n\t}\n\targs := []string{\"fetch\", \"--no-tags\", \"--no-write-fetch-head\", \"--quiet\"}\n\tif shallow {\n\t\targs = []string{\"-c\", \"gc.auto=0\", \"fetch\", \"--depth=1\", \"--no-tags\", \"--no-write-fetch-head\", \"--quiet\"}\n\t}\n\t_, stderr, err := g.run(ctx, repoDir, env, \"\", secrets, append(args, url, refspec)...)\n\tif err != nil {\n\t\tif cerr := classifyFetch(stderr, shallow); cerr != nil {\n\t\t\treturn fmt.Errorf(\"gitx: fetch %s: %w\", refspec, cerr)\n\t\t}\n\t\treturn fmt.Errorf(\"gitx: fetch %s: %w\", refspec, err)\n\t}\n\treturn nil\n}\n\n// classifyFetch maps git's stderr to a typed cause, or nil when it is none\n// of them.\nfunc classifyFetch(stderr string, shallow bool) error {\n\tif shallow {\n\t\tfor _, m := range []string{\"Repository not found\", \"returned error: 403\", \"returned error: 404\"} {