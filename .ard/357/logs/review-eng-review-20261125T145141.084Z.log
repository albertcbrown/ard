"committer.retry\"); n != 1 || !strings.Contains(buf.String(), \"reason=transient\") {\n396\t+\t\tt.Fatalf(\"log:\\n%s\", buf)\n397\t+\t}\n398\t+}\n399\t+\n400\t+func TestTransientPushLanded(t *testing.T) {\n401\t+\te := newEnv(t)\n402\t+\tbefore := e.head(t, \"main\")\n403\t+\tf := &flaky{Effects: e.live(), fail: 1, landed: true}\n404\t+\tc := e.main(t, f)\n405\t+\tres, err := c.Commit(context.Background(), req(12, \"issue.md\", \"mine\"))\n406\t+\tif err != nil || res.NoOp {\n407\t+\t\tt.Fatalf(\"res %+v err %v\", res, err)\n408\t+\t}\n409\t+\tif got := e.head(t, \"main\"); got != res.SHA {\n410\t+\t\tt.Fatalf(\"main %s, result %s\", got, res.SHA)\n411\t+\t}\n412\t+\tif n := strings.TrimSpace(gittest.Run(t, e.bare, \"rev-list\", \"--count\", before+\"..main\")); n != \"1\" {\n413\t+\t\tt.Fatalf(\"%s new commits, want 1\", n)\n414\t+\t}\n415\t+\tif f.pushes != 1 {\n416\t+\t\tt.Fatalf(\"pushes = %d\", f.pushes)\n417\t+\t}\n418\t+}\n419\t+\n420\t+func TestTransientExhausted(t *testing.T) {\n421\t+\te := newEnv(t)\n422\t+\tf := &flaky{Effects: e.live(), fail: 1000}\n423\t+\tc := e.main(t, f)\n424\t+\t_, err := c.Commit(context.Background(), req(12, \"issue.md\", \"mine\"))\n425\t+\tif !errors.Is(err, ErrTransient) || !errors.Is(err, effects.ErrTransient) {\n426\t+\t\tt.Fatalf(\"err = %v\", err)\n427\t+\t}\n428\t+\tif f.pushes != maxTransient+1 {\n429\t+\t\tt.Fatalf(\"pushes = %d, want %d\", f.pushes, maxTransient+1)\n430\t+\t}\n431\t+}\n432\t+\n433\t+func TestTransientIndependentOfRejections(t *testing.T) {\n434\t+\te := newEnv(t)\n435\t+\tr := &racer{Effects: &flaky{Effects: e.live(), fail: 3}, e: e, t: t, k: 2, path: \"other/file\"}\n436\t+\tc := e.main(t, r)\n437\t+\tres, err := c.Commit(context.Background(), req(12, \"issue.md\", \"mine\"))\n438\t+\tif err != nil {\n439\t+\t\tt.Fatalf(\"res %+v err %v\", res, err)\n440\t+\t}\n441\t+\tif got := e.head(t, \"main\"); got != res.SHA {\n442\t+\t\tt.Fatalf(\"main %s, result %s\", got, res.SHA)\n443\t+\t}\n444\t+}\n445\t+\n446\t+func TestTransientCancelledInBackoff(t *testing.T) {\n447\t+\te := newEnv(t)\n448\t+\te.cfg.Backoff = func(int) time.Duration { return time.Hour }\n449\t+\tc := e.main(t, &flaky{Effects: e.live(), fail: 1000})\n450\t+\tctx, cancel := context.WithTimeout(context.Background(), 200*time.Millisecond)\n451\t+\tdefer cancel()\n452\t+\t_, err := c.Commit(ctx, req(12, \"issue.md\", \"mine\"))\n453\t+\tif !errors.Is(err, context.DeadlineExceeded) || errors.Is(err, ErrTransient) {\n454\t+\t\tt.Fatalf(\"err = %v\", err)\n455\t+\t}\n456\t+}\n457\t+\n458\t+func TestTransientBackoffJitter(t *testing.T) {\n459\t+\tc := &core{}\n460\t+\tfor n := 1; n <= maxTransient; n++ {\n461\t+\t\tbase := time.Second << (n - 1)\n462\t+\t\tfor i := 0; i < 50; i++ {\n463\t+\t\t\td := c.transientBackoff(n)\n464\t+\t\t\tif d < base*3/4 || d > base*5/4 {\n465\t+\t\t\t\tt.Fatalf(\"backoff(%d) = %v outside ±25%% of %v\", n, d, base)\n466\t+\t\t\t}\n467\t+\t\t}\n468\t+\t}\n469\t+}\n470\t+\n471\t+func TestTransientCodeLane(t *testing.T) {\n472\t+\tfor _, landed := range []bool{false, true} {\n473\t+\t\tt.Run(fmt.Sprint(\"landed=\", landed), func(t *testing.T) {\n474\t+\t\t\tf := &flaky{fail: 1, landed: landed}\n475\t+\t\t\tc := newCodeEnv(t, nil)\n476\t+\t\t\tf.Effects = c.env.live()\n477\t+\t\t\tc.b = NewBranches(c.cfg, f, c.g)\n478\t+\t\t\tt.Cleanup(func() { _ = c.b.Close(context.Background()) })\n479\t+\t\t\tr := c.req(CodeFile{Path: \"new.go\", Src: c.srcFile(t, \"new.go\", \"package x\\n\")})\n480\t+\t\t\tr.Create = true\n481\t+\t\t\tres, err := c.b.CommitCode(context.Background(), brName, r)\n482\t+\t\t\tif err != nil {\n483\t+\t\t\t\tt.Fatal(err)\n484\t+\t\t\t}\n485\t+\t\t\tif got := c.head(t, brName); got != res.SHA {\n486\t+\t\t\t\tt.Fatalf(\"branch %s, result %s\", got, res.SHA)\n487\t+\t\t\t}\n488\t+\t\t\tif n := strings.TrimSpace(gittest.Run(t, c.bare, \"rev-list\", \"--count\", c.base+\"..\"+brName)); n != \"1\" {\n489\t+\t\t\t\tt.Fatalf(\"ahead by %s\", n)\n490\t+\t\t\t}\n491\t+\t\t})\n492\t+\t}\n493\t+}\n494\t+\n495\t+func TestTransientInitLane(t *testing.T) {\n496\t+\tfor _, landed := range []bool{false, true} {\n497\t+\t\tt.Run(fmt.Sprint(\"landed=\", landed), func(t *testing.T) {\n498\t+\t\t\te := newEnv(t)\n499\t+\t\t\ti := e.init(t, &flaky{Effects: e.live(), fail: 1, landed: landed})\n500\t+\t\t\tbase, err := i.Base(context.Background())\n501\t+\t\t\tif err != nil {\n502\t+\t\t\t\tt.Fatal(err)\n503\t+\t\t\t}\n504\t+\t\t\tres, err := i.Propose(context.Background(), base, starterFiles)\n505\t+\t\t\tif err != nil {\n506\t+\t\t\t\tt.Fatal(err)\n507\t+\t\t\t}\n508\t+\t\t\tif got := e.head(t, InitBranch); got != res.SHA {\n509\t+\t\t\t\tt.Fatalf(\"remote %s, result %s\", got, res.SHA)\n510\t+\t\t\t}\n511\t+\t\t})\n512\t+\t}\n513\t+}\n514\tdiff --git a/internal/effects/effects.go b/internal/effects/effects.go\n515\tindex 3be0a5d..947f441 100644\n516\t--- a/internal/effects/effects.go\n517\t+++ b/internal/effects/effects.go\n518\t@@ -32,6 +32,7 @@ var (\n519\t \tErrNothingToCommit = gitx.ErrNothingToCommit\n520\t \tErrNonFastForward  = gitx.ErrNonFastForward\n521\t \tErrStaleLease      = gitx.ErrStaleLease\n522\t+\tErrTransient       = gitx.ErrTransient\n523\t )\n524\t \n525\t // ErrSyntheticTarget is returned by Live when asked to act on a dry-run\n526\tdiff --git a/internal/github/auth.go b/internal/github/auth.go\n527\tindex 46fe553..2e43042 100644\n528\t--- a/internal/github/auth.go\n529\t+++ b/internal/github/auth.go\n530\t@@ -8,6 +8,7 @@ import (\n531\t \t\"errors\"\n532\t \t\"fmt\"\n533\t \t\"io\"\n534\t+\t\"net\"\n535\t \t\"net/http\"\n536\t \t\"net/url\"\n537\t \t\"strconv\"\n538\t@@ -15,6 +16,7 @@ import (\n539\t \t\"sync\"\n540\t \n541\t \t\"github.com/bradleyfalzon/ghinstallation/v2\"\n542\t+\tgogh \"github.com/google/go-github/v88/github\"\n543\t )\n544\t \n545\t // EnvNames lists every environment variable that carries GitHub credentials.\n546\t@@ -316,3 +318,25 @@ func (a *AppAuth) DiscoverInstallation(ctx context.Context, repo R