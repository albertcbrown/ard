, repoDir, url, refspec string, token Tok\n \tif token != nil {\n \t\ttok, err := token(ctx)\n \t\tif err != nil {\n+\t\t\tif ctx.Err() == nil && tokenTransient(err) {\n+\t\t\t\treturn fmt.Errorf(\"gitx: fetch token: %w: %v\", ErrTransient, err)\n+\t\t\t}\n \t\t\treturn fmt.Errorf(\"gitx: fetch token: %w\", err)\n \t\t}\n \t\tenv, secrets = pushEnv(tok, url), []string{tok}\n@@ -169,6 +172,11 @@ func classifyFetch(stderr string, shallow bool) error {\n \tif strings.Contains(stderr, \"couldn't find remote ref\") || (shallow && strings.Contains(stderr, \"not our ref\")) {\n \t\treturn ErrRefNotFound\n \t}\n+\t// Only FetchRef: the shallow callers already treat other failures as\n+\t// theirs to decide.\n+\tif !shallow && classifyTransient(stderr) {\n+\t\treturn ErrTransient\n+\t}\n \treturn nil\n }\n \ndiff --git a/internal/gitx/transient_test.go b/internal/gitx/transient_test.go\nnew file mode 100644\nindex 0000000..ce7db49\n--- /dev/null\n+++ b/internal/gitx/transient_test.go\n@@ -0,0 +1,62 @@\n+package gitx\n+\n+import (\n+\t\"context\"\n+\t\"errors\"\n+\t\"net\"\n+\t\"testing\"\n+)\n+\n+func TestClassifyTransient(t *testing.T) {\n+\tfor _, tc := range []struct {\n+\t\tstderr string\n+\t\twant   bool\n+\t}{\n+\t\t{\"remote: Internal Server Error\", true},\n+\t\t{\"fatal: unable to access 'x': The requested URL returned error: 502\", true},\n+\t\t{\"fatal: unable to access 'x': Could not resolve host: github.com\", true},\n+\t\t{\"error: RPC failed; curl 56 Connection reset by peer\", true},\n+\t\t{\"fatal: the remote end hung up unexpectedly\\nfatal: early EOF\", true},\n+\t\t{\"fatal: unable to access 'x': Failed to connect to github.com port 443\", true},\n+\t\t{\"error: failed to push some refs (stale info)\", false},\n+\t\t{\"The requested URL returned error: 403\", false},\n+\t\t{\"remote: error: GH006: Protected branch update failed\", false},\n+\t} {\n+\t\tif got := classifyTransient(tc.stderr); got != tc.want {\n+\t\t\tt.Errorf(\"classifyTransient(%q) = %v, want %v\", tc.stderr, got, tc.want)\n+\t\t}\n+\t}\n+}\n+\n+func TestClassifyFetchTransient(t *testing.T) {\n+\tif err := classifyFetch(\"fatal: couldn't find remote ref x\", false); !errors.Is(err, ErrRefNotFound) {\n+\t\tt.Errorf(\"ref not found: %v\", err)\n+\t}\n+\tif err := classifyFetch(\"error: RPC failed; early EOF\", false); !errors.Is(err, ErrTransient) {\n+\t\tt.Errorf(\"transient: %v\", err)\n+\t}\n+\tif err := classifyFetch(\"returned error: 403\", true); !errors.Is(err, ErrRepoAccess) {\n+\t\tt.Errorf(\"403: %v\", err)\n+\t}\n+}\n+\n+func TestTokenTransient(t *testing.T) {\n+\tif !tokenTransient(&net.DNSError{Err: \"no such host\", Name: \"api.github.com\"}) {\n+\t\tt.Error(\"DNS error should be transient\")\n+\t}\n+\tif tokenTransient(errors.New(\"bad key\")) {\n+\t\tt.Error(\"plain error should not be transient\")\n+\t}\n+\tg := New(\"\")\n+\ttok := func(context.Context) (string, error) {\n+\t\treturn \"\", &net.DNSError{Err: \"no such host\", Name: \"api.github.com\"}\n+\t}\n+\terr := g.Push(context.Background(), PushOp{Dir: t.TempDir(), Remote: \"x\", Ref: \"HEAD:refs/heads/x\", Token: tok})\n+\tif !errors.Is(err, ErrTransient) {\n+\t\tt.Errorf(\"Push err = %v\", err)\n+\t}\n+\terr = g.FetchRef(context.Background(), t.TempDir(), \"x\", \"+a:b\", tok)\n+\tif !errors.Is(err, ErrTransient) {\n+\t\tt.Errorf(\"FetchRef err = %v\", err)\n+\t}\n+}\ndiff --git a/internal/gitx/write.go b/internal/gitx/write.go\nindex d8fdced..2993141 100644\n--- a/internal/gitx/write.go\n+++ b/internal/gitx/write.go\n@@ -6,6 +6,8 @@ import (\n \t\"fmt\"\n \t\"net/url\"\n \t\"strings\"\n+\n+\t\"github.com/albertcbrown/ard/internal/github\"\n )\n \n // CommitOp commits what is already staged in Dir.\n@@ -51,7 +53,8 @@ func (g *Git) Commit(ctx context.Context, op CommitOp) (string, error) {\n \treturn g.RevParse(ctx, op.Dir, \"HEAD\")\n }\n \n-// Push pushes op.Ref. Typed errors: ErrNonFastForward, ErrStaleLease.\n+// Push pushes op.Ref. Typed errors: ErrNonFastForward, ErrStaleLease and\n+// ErrTransient (the push may have landed).\n func (g *Git) Push(ctx context.Context, op PushOp) error {\n \targs := []string{\"push\", \"--porcelain\"}\n \tif op.ForceWithLease != \"\" {\n@@ -66,6 +69,9 @@ func (g *Git) Push(ctx context.Context, op PushOp) error {\n \tif op.Token != nil {\n \t\ttok, err := op.Token(ctx)\n \t\tif err != nil {\n+\t\t\tif ctx.Err() == nil && tokenTransient(err) {\n+\t\t\t\treturn fmt.Errorf(\"gitx: push token: %w: %v\", ErrTransient, err)\n+\t\t\t}\n \t\t\treturn fmt.Errorf(\"gitx: push token: %w\", err)\n \t\t}\n \t\tenv = pushEnv(tok, op.Remote)\n@@ -81,10 +87,42 @@ func (g *Git) Push(ctx context.Context, op PushOp) error {\n \t\treturn fmt.Errorf(\"gitx: push %s: %w\", op.Ref, ErrStaleLease)\n \tcase strings.Contains(stderr, \"non-fast-forward\"), strings.Contains(stderr, \"fetch first\"):\n \t\treturn fmt.Errorf(\"gitx: push %s: %w\", op.Ref, ErrNonFastForward)\n+\tcase classifyTransient(stderr):\n+\t\treturn fmt.Errorf(\"gitx: push %s: %w: %v\", op.Ref, ErrTransient, err)\n \t}\n \treturn fmt.Errorf(\"gitx: push %s: %w\", op.Ref, err)\n }\n \n+// transientMarkers are git messages (matched case-insensitively) that name a\n+// failure likely to pass on its own.\n+var transientMarkers = []string{\n+\t\"remote: internal server error\",\n+\t\"returned error: 500\", \"returned error: 502\", \"returned error: 503\", \"returned error: 504\",\n+\t\"could not resolve host\",\n+\t\"connection reset\",\n+\t\"operation timed out\",\n+\t\"connection timed out\",\n+\t\"failed to connect\",\n+\t\"ssl_read\",\n+\t\"early eof\",\n+\t\"rpc failed\",\n+}\n+\n+// classifyTransient reports whether git's stderr names a transient failure.\n+func classifyTransient(stderr string) bool {\n+\ts := strings.ToLower(stderr)\n+\tfor _, m := range transientMarkers {\n+\t\tif strings.Contains(s, m) {\n+\t\t\treturn true\n+\t\t}\n+\t}\n+\treturn false\n+}\n+\n+// tokenTransient reports whether a token mint or refresh error comes from the\n+// network or a 5xx, not from a refusal.\n+func tokenTransient(err error) bool { return github.IsTransientToken(err) }\n+\n // pushEnv passes the credential to git through the environment (never argv,\n // which is visible in the process list).\n func pushEnv(token, remote string) []string {\ndiff --git a/internal/reaper/doc.go b/internal/reaper/doc.go\nindex f0a1b38..f7208e2 100644\n--- a/internal/reaper/doc.go\n+++ b/internal/reaper/doc.go\n@@ -48,7 +48,7 @@\n // # Retries\n //\n // Every retry, automatic or human, is a new job with its own id. A named\n-// transient cause (rate_limit, clone_failed, controller_restart) hands off to\n+// transient cause (rate_limit, clone_failed, push_transient, controller_restart) hands off to\n // one automatic retry: the failed job gets no ard:executor:failed, keeps its\n // request label, and the next claim is linked to it through retry_of. An\n // automatic retry that fails again is marked failed.\ndiff --git a/internal/worker/run.go b/internal/worker/run.go\nindex 3df6464..5158b33 100644\n--- a/internal/worker/run.go\n+++ b/internal/worker/run.go\n@@ -641,6 +641,10 @@ func (jb *job) push(ctx context.Context, s step, v Verdict) (string, bool) {\n \t\t\tkind = \"guard\"\n \t\t}\n \t\tjb.log.Error(\"worker.push_failed\", \"kind\", kind, \"error\", err)\n+\t\tif errors.Is(err, committer.ErrTransient) {\n+\t\t\tjb.finishWithPR(ctx, s, \"\", jb.cause(closeout.CausePushTransient, \"could not push the branch: remote unavailable after retries\", !jb.pushed))\n+\t\t\treturn \"\", false\n+\t\t}\n \t\tjb.finishWithPR(ctx, s, \"\", jb.cause(closeout.CauseNoProcess, \"could not push the branch: \"+kind, false))\n \t\treturn \"\", false\n \t}\n","numLines":785,"startLine":1,"totalLines":785}},"tool_result_meta":[{"id":"toolu_01MdikJjzqk3buL2rtnQeuQG","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
