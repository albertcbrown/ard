nds on the\n44\t\t// host's git configuration.\n45\t\t_, _, err := g.run(ctx, op.Dir, env, op.Message, nil,\n46\t\t\t\"-c\", \"core.hooksPath=/dev/null\", \"-c\", \"commit.gpgsign=false\",\n47\t\t\t\"commit\", \"--quiet\", \"-F\", \"-\")\n48\t\tif err != nil {\n49\t\t\treturn \"\", fmt.Errorf(\"gitx: commit in %s: %w\", op.Dir, err)\n50\t\t}\n51\t\treturn g.RevParse(ctx, op.Dir, \"HEAD\")\n52\t}\n53\t\n54\t// Push pushes op.Ref. Typed errors: ErrNonFastForward, ErrStaleLease.\n55\tfunc (g *Git) Push(ctx context.Context, op PushOp) error {\n56\t\targs := []string{\"push\", \"--porcelain\"}\n57\t\tif op.ForceWithLease != \"\" {\n58\t\t\tdst := op.Ref\n59\t\t\tif i := strings.LastIndex(dst, \":\"); i >= 0 {\n60\t\t\t\tdst = dst[i+1:]\n61\t\t\t}\n62\t\t\targs = append(args, \"--force-with-lease=\"+dst+\":\"+op.ForceWithLease)\n63\t\t}\n64\t\targs = append(args, op.Remote, op.Ref)\n65\t\tvar env, secrets []string\n66\t\tif op.Token != nil {\n67\t\t\ttok, err := op.Token(ctx)\n68\t\t\tif err != nil {\n69\t\t\t\treturn fmt.Errorf(\"gitx: push token: %w\", err)\n70\t\t\t}\n71\t\t\tenv = pushEnv(tok, op.Remote)\n72\t\t\tsecrets = []string{tok}\n73\t\t}\n74\t\tstdout, stderr, err := g.run(ctx, op.Dir, env, \"\", secrets, args...)\n75\t\tif err == nil {\n76\t\t\treturn nil\n77\t\t}\n78\t\tstderr = stdout + stderr // --porcelain reports rejections on stdout\n79\t\tswitch {\n80\t\tcase strings.Contains(stderr, \"stale info\"):\n81\t\t\treturn fmt.Errorf(\"gitx: push %s: %w\", op.Ref, ErrStaleLease)\n82\t\tcase strings.Contains(stderr, \"non-fast-forward\"), strings.Contains(stderr, \"fetch first\"):\n83\t\t\treturn fmt.Errorf(\"gitx: push %s: %w\", op.Ref, ErrNonFastForward)\n84\t\t}\n85\t\treturn fmt.Errorf(\"gitx: push %s: %w\", op.Ref, err)\n86\t}\n87\t\n88\t// pushEnv passes the credential to git through the environment (never argv,\n89\t// which is visible in the process list).\n90\tfunc pushEnv(token, remote string) []string {\n91\t\tcred := base64.StdEncoding.EncodeToString([]byte(\"x-access-token:\" + token))\n92\t\treturn []string{\n93\t\t\t\"GIT_CONFIG_COUNT=1\",\n94\t\t\t\"GIT_CONFIG_KEY_0=\" + headerKey(remote),\n95\t\t\t\"GIT_CONFIG_VALUE_0=Authorization: Basic \" + cred,\n96\t\t}\n97\t}\n98\t\n99\t// scrub removes each secret, and its base64 forms, from s.\n100\tfunc scrub(s string, secrets ...string) string {\n101\t\tfor _, sec := range secrets {\n102\t\t\tif sec == \"\" {\n103\t\t\t\tcontinue\n104\t\t\t}\n105\t\t\tfor _, form := range []string{\n106\t\t\t\tbase64.StdEncoding.EncodeToString([]byte(\"x-access-token:\" + sec)),\n107\t\t\t\tbase64.StdEncoding.EncodeToString([]byte(sec)),\n108\t\t\t\tsec,\n109\t\t\t} {\n110\t\t\t\ts = strings.ReplaceAll(s, form, \"[REDACTED]\")\n111\t\t\t}\n112\t\t}\n113\t\treturn s\n114\t}\n115\t\n116\t// headerKey scopes the auth header to the remote's scheme and host, so a\n117\t// redirect to another host never receives the credential.\n118\tfunc headerKey(remote string) string {\n119\t\tu, err := url.Parse(remote)\n120\t\tif err != nil || u.Host == \"\" {\n121\t\t\treturn \"http.extraheader\"\n122\t\t}\n123\t\treturn \"http.\" + u.Scheme + \"://\" + u.Host + \"/.extraheader\"\n124\t}\n125\t"}]},"parent_tool_use_id":null,"session_id":"cd4174be-0d64-42bc-be31-66fe45c96d64","uuid":"634fa969-37a2-4276-a01f-077032032724","timestamp":"2026-11-24T23:47:26.589Z","tool_use_result":{"type":"text","file":{"filePath":"/work/internal/gitx/write.go","content":"package gitx\n\nimport (\n\t\"context\"\n\t\"encoding/base64\"\n\t\"fmt\"\n\t\"net/url\"\n\t\"strings\"\n)\n\n// CommitOp commits what is already staged in Dir.\ntype CommitOp struct {\n\tDir     string   // worktree; callers stage first\n\tMessage string   // full message including trailers\n\tAuthor  Identity // used as author and committer; never global config\n}\n\n// TokenFunc mints a push credential. It is called once per push.\ntype TokenFunc func(ctx context.Context) (string, error)\n\n// PushOp pushes Ref to Remote.\ntype PushOp struct {\n\tDir, Remote, Ref string    // Ref is a refspec such as \"HEAD:refs/heads/main\"\n\tForceWithLease   string    // expected remote SHA of the destination ref; \"\" = normal push\n\tToken            TokenFunc // nil = no auth header (file remotes in tests)\n}\n\n// Commit commits the staged index and returns the new HEAD SHA. It returns\n// ErrNothingToCommit when the index is identical to HEAD.\nfunc (g *Git) Commit(ctx context.Context, op CommitOp) (string, error) {\n\tif op.Author.Name == \"\" || op.Author.Email == \"\" {\n\t\treturn \"\", fmt.Errorf(\"gitx: commit in %s: author name and email are required\", op.Dir)\n\t}\n\tif _, _, err := g.run(ctx, op.Dir, nil, \"\", nil, \"diff\", \"--cached\", \"--quiet\"); err == nil {\n\t\treturn \"\", ErrNothingToCommit\n\t} else if !isExit(err, 1) {\n\t\treturn \"\", fmt.Errorf(\"gitx: check index in %s: %w\", op.Dir, err)\n\t}\n\tenv := []string{\n\t\t\"GIT_AUTHOR_NAME=\" + op.Author.Name, \"GIT_AUTHOR_EMAIL=\" + op.Author.Email,\n\t\t\"GIT_COMMITTER_NAME=\" + op.Author.Name, \"GIT_COMMITTER_EMAIL=\" + op.Author.Email,\n\t}\n\t// Hooks are disabled and signing is off so a commit never depends on the\n\t// host's git configuration.\n\t_, _, err := g.run(ctx, op.Dir, env, op.Message, nil,\n\t\t\"-c\", \"core.hooksPath=/dev/null\", \"-c\", \"commit.gpgsign=false\",\n\t\t\"commit\", \"--quiet\", \"-F\", \"-\")\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"gitx: commit in %s: %w\", op.Dir, err)\n\t}\n\treturn g.RevParse(ctx, op.Dir, \"HEAD\")\n}\n\n// Push pushes op.Ref. Typed errors: ErrNonFastForward, ErrStaleLease.\nfunc (g *Git) Push(ctx context.Context, op PushOp) error {\n\targs := []string{\"push\", \"--porcelain\"}\n\tif op.ForceWithLease != \"\" {\n\t\tdst := op.Ref\n\t\tif i := strings.LastIndex(dst, \":\"); i >= 0 {\n\t\t\tdst = dst[i+1:]\n\t\t}\n\t\targs = append(args, \"--force-with-lease=\"+dst+\":\"+op.ForceWithLease)\n\t}\n\targs = append(args, op.Remote, op.Ref)\n\tvar env, secrets []string\n\tif op.Token != nil {\n\t\ttok, err := op.Token(ctx)\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"gitx: push token: %w\", err)\n\t\t}\n\t\tenv = pushEnv(tok, op.Remote)\n\t\tsecrets = []string{tok}\n\t}\n\tstdout, stderr, err := g.run(ctx, op.Dir, env, \"\", secrets, args...)\n\tif err == nil {\n\t\treturn nil\n\t}\n\tstderr = stdout + stderr // --porcelain reports rejections on stdout\n\tswitch {\n\tcase strings.Contains(stderr, \"stale info\"):\n\t\treturn fmt.Errorf(\"gitx: push %s: %w\", op.Ref, ErrStaleLease)\n\tcase strings.Contains(stderr, \"non-fast-forward\"), strings.Contains(stderr, \"fetch first\"):\n\t\treturn fmt.Errorf(\"gitx: push %s: %w\", op.Ref, ErrNonFastForward)\n\t}\n\treturn fmt.Errorf(\"gitx: push %s: %w\", op.Ref, err)\n}\n\n// pushEnv passes the credential to git through the environment (never argv,\n// which is visible in the process list).\nfunc pushEnv(token, remote string) []string {\n\tcred := base64.StdEncoding.EncodeToString([]byte(\"x-access-token:\" + token))\n\treturn []string{\n\t\t\"GIT_CONFIG_COUNT=1\",\n\t\t\"GIT_CONFIG_KEY_0=\" + headerKey(remote),\n\t\t\"GIT_CONFIG_VALUE_0=Authorization: Basic \" + cred,\n\t}\n}\n\n// scrub removes each secret, and its base64 forms, from s.\nfunc scrub(s string, secrets ...string) string {\n\tfor _, sec := range secrets {\n\t\tif sec == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tfor _, form := range []string{\n\t\t\tbase64.StdEncoding.EncodeToString([]byte(\"x-access-token:\" + sec)),\n\t\t\tbase64.StdEncoding.EncodeToString([]byte(sec)),\n\t\t\tsec,\n\t\t} {\n\t\t\ts = strings.ReplaceAll(s, form, \"[REDACTED]\")\n\t\t}\n\t}\n\treturn s\n}\n\n// headerKey scopes the auth header to the remote's scheme and host, so a\n// redirect to another host never receives the credential.\nfunc headerKey(remote string) string {\n\tu, err := url.Parse(remote)\n\tif err != nil || u.Host == \"\" {\n\t\treturn \"http.extraheader\"\n\t}\n\treturn \"http.\" + u.Scheme + \"://\" + u.Host + \"/.extraheader\"\n}\n","numLines":125,"