{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LhV4ExBWphG3BM25xRgzq3","type":"tool_result","content":"150\t\t}\n151\t\tissue := req.Issue\n152\t\tdry := l.fx.DryRun()\n153\t\tswitch {\n154\t\tcase issue < 0 && dry:\n155\t\t\tissue = -issue\n156\t\tcase issue <= 0:\n157\t\t\treturn Result{}, fmt.Errorf(\"commit issue %d: %w: issue must be positive\", req.Issue, &GuardError{Paths: []string{\"\"}, Reasons: []string{\"non-positive issue\"}})\n158\t\t}\n159\t\tsnap, err := snapshot(req, issue)\n160\t\tif err != nil {\n161\t\t\treturn Result{}, fmt.Errorf(\"commit issue %d (%s:%s): %w\", req.Issue, req.Stage, req.Role, err)\n162\t\t}\n163\t\tmsg, err := Message(req.Stage, req.Role, issue, req.Summary, req.JobID, l.skipCI)\n164\t\tif err != nil {\n165\t\t\treturn Result{}, fmt.Errorf(\"commit issue %d (%s:%s): %w\", req.Issue, req.Stage, req.Role, err)\n166\t\t}\n167\t\tstart := time.Now()\n168\t\tdefer func() {\n169\t\t\tattrs := []any{\"issue\", req.Issue, \"stage\", req.Stage, \"role\", req.Role, \"branch\", l.branch, \"job\", req.JobID,\n170\t\t\t\t\"files\", len(snap.Files), \"duration\", time.Since(start).String()}\n171\t\t\tif err != nil {\n172\t\t\t\tl.log.WarnContext(ctx, \"committer.failed\", append(attrs, \"err\", err.Error())...)\n173\t\t\t\treturn\n174\t\t\t}\n175\t\t\tl.log.InfoContext(ctx, \"committer.commit\", append(attrs, \"sha\", res.SHA, \"noop\", res.NoOp, \"synthetic\", res.Synthetic, \"attempts\", res.Attempts)...)\n176\t\t}()\n177\t\tif req.Issue < 0 { // synthetic issue: validated, nothing touches git\n178\t\t\treturn Result{SHA: strings.Repeat(\"0\", 40), Synthetic: true}, nil\n179\t\t}\n180\t\n181\t\tselect {\n182\t\tcase l.sem <- struct{}{}:\n183\t\tcase <-ctx.Done():\n184\t\t\treturn Result{}, fmt.Errorf(\"commit issue %d: %w\", req.Issue, ctx.Err())\n185\t\t}\n186\t\tdefer func() { <-l.sem }()\n187\t\tif l.isClosed() {\n188\t\t\treturn Result{}, ErrClosed\n189\t\t}\n190\t\tres, err = l.run(ctx, snapOf(snap, msg))\n