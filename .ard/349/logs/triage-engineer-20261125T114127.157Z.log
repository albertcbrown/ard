{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014TCfQuB5dEiHLBFgFeNMKE","type":"tool_result","content":"package initcmd\n\nimport (\n\t\"fmt\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n)\n\n// initBody is the PR description. It is fixed text built from the file list\n// and the validated protected paths, with no issue or comment text in it.\nfunc initBody(pl Result, res *config.Resolved) string {\n\tvar b strings.Builder\n\tb.WriteString(\"This PR adds the starter `.ard/` directory proposed by `ard init`.\\n\\n\")\n\tb.WriteString(\"## Files\\n\\n\")\n\tops := pl.Ops\n\tfor _, o := range ops {\n\t\tif o.Act == actUnchanged || o.Act == actEdited {\n\t\t\tcontinue\n\t\t}\n\t\tmode := \"\"\n\t\tif o.File.Exec {\n\t\t\tmode = \" (executable)\"\n\t\t}\n\t\tfmt.Fprintf(&b, \"- %s `%s`%s\\n\", o.Act, o.File.Path, mode)\n\t}\n\tfmt.Fprintf(&b, \"- add or update `%s`, the hashes of the starter files written\\n\", LockPath)\n\tvar edited []string\n\tfor _, o := range ops {\n\t\tif o.Act == actEdited {\n\t\t\tedited = append(edited, o.File.Path)\n\t\t}\n\t}\n\tif len(edited) > 0 {\n\t\tb.WriteString(\"\\n## Edited files left alone\\n\\nThese differ from both the starter and the last `ard init`, so they are not changed. Run `ard init` locally to see the diffs.\\n\\n\")\n\t\tfor _, p := range edited {\n\t\t\tfmt.Fprintf(&b, \"- `%s`\\n\", p)\n\t\t}\n\t}\n\tif len(pl.Dropped) > 0 {\n\t\tb.WriteString(\"\\n## No longer in the starter\\n\\nLeft in place; delete by hand if unwanted.\\n\\n\")\n\t\tfor _, p := range pl.Dropped {\n\t\t\tfmt.Fprintf(&b, \"- `%s`\\n\", p)\n\t\t}\n\t}\n\tb.WriteString(\"\\n## Protected paths\\n\\nA pull request touching any of these waits for a human approval:\\n\\n\")\n\tfor _, p := range res.ProtectedPaths {\n\t\tfmt.Fprintf(&b, \"- `%s`\\n\", p)\n\t}\n\tb.WriteString(\"\\n## Before you merge\\n\\n\")\n\tb.WriteString(\"- Nothing takes effect until this is merged: ard serve reads its configuration from origin/main.\\n\")\n\tb.WriteString(\"- Merge with **Squash and merge** (recommended); **Create a merge commit** is also safe. Never fast-forward this branch into main from the command line: the bot-commit check reads main's first-parent history and would fail on the bot's commit.\\n\")\n\tb.WriteString(\"- If this repository already has an `.ard/config.yaml`, this PR does not edit it: add `.ard/PRODUCT.md`, `.ard/VISION.md` and `.ard/TECH_STACK.md` to `merge.protected_paths` yourself, so a PR cannot change them without a human approval.\\n\")\n\tfor _, o := range ops {\n\t\tif o.File.Path == \".ard/scanners/lint/scan\" {\n\t\t\tb.WriteString(\"- The lint scanner fails until you commit `.ard/scanners/lint/baseline`: run the command in `.ard/scanners/lint/Dockerfile`'s header (an empty file means no baseline).\\n\")\n\t\t\tbreak\n\t\t}\n\t}\n\tb.WriteString(\"- `scanners/trufflehog` is included. It files leaked-credential issues for a human (never for an agent) and needs a TruffleHog binary (AGPL-3.0; it is installed by the role's Dockerfile or taken from the host, and is not in the ard image). To opt out, delete `.ard/scanners/trufflehog/` and its `scanners/trufflehog` line under `overrides:` in `.ard/config.yaml` before merging.\\n\")\nbody.go\ninitcmd.go\ninitcmd_test.go\nlocal.go\nlocal_test.go\nlock.go\nplan.go\nplan_test.go\ninternal/cli/app.go:55:// InitOpts is the parsed flag set of `ard init`.\ninternal/cli/app.go:57:\t// Version is the ard build version, recorded in .ard/ard-init.lock.\ninternal/cli/app.go:59:\t// PR opens the ard-init PR instead of writing the local tree.\ninternal/cli/app.go:63:// SetupOpts is the parsed flag set of `ard setup`.\ninternal/cli/cmd_init.go:12:\t\tUse:   \"init\",\ninternal/cli/cmd_init.go:24:\tcmd.Flags().BoolVar(&pr, \"pr\", false, \"open a PR from branch ard-init instead of writing the local tree\")\ninternal/cli/cmd_labels.go:17:\t\tShort: \"Create or update the ard: labels (alias of ard setup, labels only)\",\ninternal/cli/cmd_setup.go:12:\t\tUse:   \"setup\",\ninternal/cli/cmd_setup.go:13:\t\tShort: \"Check the repository setup, then apply the fixes (exit 2 on drift with --check)\",\ninternal/cli/root.go:28:\t\t\treturn app.setup(cmd)\ninternal/cli/root.go:55:// setup validates the global flags and builds the Env handlers receive.\ninternal/cli/root.go:56:func (a *App) setup(cmd *cobra.Command) error {\ninternal/setupcmd/setup.go:66:\tperm := Row{Name: permName, Status: StatusOK}\ninternal/setupcmd/setup.go:71:\trep := Report{Rows: []Row{perm}}\ninternal/setupcmd/setup.go:90:\trow := Row{Name: labelName, Status: StatusOK}\ninternal/setupcmd/setup.go:111:\trow = Row{Name: labelName, Status: StatusChanged}\ninternal/setupcmd/setup.go:119:\t\trow = Row{Name: labelName, Status: StatusManual, Detail: \"create or update these labels by hand: \" + strings.Join(names, \", \")}\ninternal/setupcmd/setup.go:133:\tmanual := func(name, detail string) Row { return Row{Name: name, Status: StatusManual, Detail: detail} }\ninternal/setupcmd/policy.go:79:\t\treturn Row{Name: rulesetName, Status: StatusOK, Detail: policyBranch + \" requires a pull request; only the ard App bypasses\"}\ninternal/setupcmd/policy.go:81:\treturn Row{Name: rulesetName, Status: StatusDrift, Detail: strings.Join(problems, \"; \") + \". Fix in \" + rulesURL(repo)}\ninternal/setupcmd/policy.go:93:\t\treturn Row{Name: appPermName, Status: StatusOK, Detail: \"no workflows or administration permission\"}\ninternal/setupcmd/policy.go:95:\treturn Row{Name: appPermName, Status: StatusDrift, Detail: \"the App has the \" + strings.Join(bad, \", \") + \" permission; remove it in \" + installURL(repo)}\ninternal/setupcmd/policy.go:101:\t\treturn Row{Name: mergeName, Status: StatusDrift, Detail: fmt.Sprintf(\"allow_rebase_merge is on while %s is on; run: gh api -X PATCH repos/%s -F allow_rebase_merge=false\", policyVersioning, repo)}\ninternal/setupcmd/policy.go:103:\treturn Row{Name: mergeName, Status: StatusOK, Detail: \"merge se