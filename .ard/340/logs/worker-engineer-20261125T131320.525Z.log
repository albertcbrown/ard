tor.Gone, executor.EndNoResult, 0},\n\t\t{\"pod gone not held\", started, obs{podErr: api.ErrNotFound}, executor.Gone, executor.EndNoResult, 0},\n\t} {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tst := mapStatus(tc.h, tc.o)\n\t\t\tif st.State != tc.state || st.End != tc.end || st.ExitCode != tc.exit {\n\t\t\t\tt.Errorf(\"got %+v, want state %s end %q exit %d\", st, tc.state, tc.end, tc.exit)\n\t\t\t}\n\t\t\tif st.Alive != (tc.state == executor.Running || tc.state == executor.Orphaned) {\n\t\t\t\tt.Errorf(\"alive = %v\", st.Alive)\n\t\t\t}\n\t\t})\n\t}\n}\nEOF\ngo test . 2>&1 | tail -20"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5450,"cache_read_input_tokens":86652,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5450},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"caaac10a-be20-4f28-971a-a15b2700a532","uuid":"50d947fc-e511-4c6b-994f-a9d932ff48b5","timestamp":"2026-11-25T13:17:50.423Z","request_id":"req_011ChPiBNCAUobThKeXZwWcB"}
