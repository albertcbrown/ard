{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X4pC9N9aqN1TXYGrZEZSPS","type":"tool_result","content":"package api\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"time\"\n)\n\n// ErrNotFound is returned for a 404.\nvar ErrNotFound = errors.New(\"kube: not found\")\n\n// ErrConflict is returned for a 409.\nvar ErrConflict = errors.New(\"kube: conflict\")\n\n// StatusError is any other non-2xx API answer.\ntype StatusError struct {\n\tCode    int\n\tReason  string\n\tMessage string\n}\n\nfunc (e *StatusError) Error() string {\n\treturn fmt.Sprintf(\"kube: status %d %s: %s\", e.Code, e.Reason, e.Message)\n}\n\n// Client is the few Kubernetes endpoints ard uses. There is deliberately no\n// pods/exec, no Secret get or list and no patch.\ntype Client interface {\n\tCreatePod(ctx context.Context, ns string, p *Pod) (*Pod, error)\n\t// GetPod returns ErrNotFound when the pod does not exist.\n\tGetPod(ctx context.Context, ns, name string) (*Pod, error)\n\tListPods(ctx context.Context, ns, labelSelector string) ([]Pod, error)\n\t// DeletePod uses background propagation; a missing pod is not an error.\n\tDeletePod(ctx context.Context, ns, name string, graceSec int64) error\n\t// PodLogs follows the container log with timestamps. A zero sinceTime\n\t// starts at the beginning.\n\tPodLogs(ctx context.Context, ns, name, container string, sinceTime time.Time) (io.ReadCloser, error)\n\t// CreateSecret returns ErrConflict when the Secret exists.\n\tCreateSecret(ctx context.Context, ns string, s *Secret) error\n\t// DeleteSecret treats a missing Secret as success.\n\tDeleteSecret(ctx context.Context, ns, name string) error\n\tListEvents(ctx context.Context, ns, fieldSelector string) ([]Event, error)\n}\n// Package api is a minimal Kubernetes REST layer: only the JSON fields ard\n// sets or reads, a Client interface, and an in-cluster implementation.\n// It uses the standard library only (no client-go).\npackage api\n\nimport \"time\"\n\n// ObjectMeta is the metadata common to every object.\ntype ObjectMeta struct {\n\tName              string            `json:\"name,omitempty\"`\n\tNamespace         string            `json:\"namespace,omitempty\"`\n\tUID               string            `json:\"uid,omitempty\"`\n\tLabels            map[string]string `json:\"labels,omitempty\"`\n\tAnnotations       map[string]string `json:\"annotations,omitempty\"`\n\tOwnerReferences   []OwnerReference  `json:\"ownerReferences,omitempty\"`\n\tCreationTimestamp time.Time         `json:\"creationTimestamp,omitzero\"`\n}\n\n// OwnerReference links an object to its owner.\ntype OwnerReference struct {\n\tAPIVersion string `json:\"apiVersion,omitempty\"`\n\tKind       string `json:\"kind,omitempty\"`\n\tName       string `json:\"name,omitempty\"`\n\tUID        string `json:\"uid,omitempty\"`\n}\n\n// Pod is a v1 Pod.\ntype Pod struct {\n\tMeta   ObjectMeta `json:\"metadata\"`\n\tSpec   PodSpec    `json:\"spec\"`\n\tStatus PodStatus  `json:\"status,omitzero\"`\n}\n\n// PodSpec is the part of the pod spec ard sets.\ntype PodSpec struct {\n\tInitContainers                []Container         `json:\"initContainers,omitempty\"`\n\tContainers                    []Container         `json:\"containers,omitempty\"`\n\tVolumes                       []Volume            `json:\"volumes,omitempty\"`\n\tRestartPolicy                 string              `json:\"restartPolicy,omitempty\"`\n\tActiveDeadlineSeconds         *int64              `json:\"activeDeadlineSeconds,omitempty\"`\n\tTerminationGracePeriodSeconds *int64              `json:\"terminationGracePeriodSeconds,omitempty\"`\n\tAutomountServiceAccountToken  *bool               `json:\"automountServiceAccountToken,omitempty\"`\n\tEnableServiceLinks            *bool               `json:\"enableServiceLinks,omitempty\"`\n\tServiceAccountName            string              `json:\"serviceAccountName,omitempty\"`\n\tSecurityContext               *PodSecurityContext `json:\"securityContext,omitempty\"`\n\tShareProcessNamespace         *bool               `json:\"shareProcessNamespace,omitempty\"`\n}\n\n// Container is a v1 Container.\ntype Container struct {\n\tName                     string               `json:\"name\"`\n\tImage                    string               `json:\"image,omitempty\"`\n\tImagePullPolicy          string               `json:\"imagePullPolicy,omitempty\"`\n\tTerminationMessagePolicy string               `json:\"terminationMessagePolicy,omitempty\"`\n\tCommand                  []string             `json:\"command,omitempty\"`\n\tArgs                     []string             `json:\"args,omitempty\"`\n\tEnv                      []EnvVar             `json:\"env,omitempty\"`\n\tPorts                    []ContainerPort      `json:\"ports,omitempty\"`\n\tVolumeMounts             []VolumeMount        `json:\"volumeMounts,omitempty\"`\n\tResources                ResourceRequirements `json:\"resources,omitzero\"`\n\tSecurityContext          *SecurityContext     `json:\"securityContext,omitempty\"`\n\tWorkingDir               string               `json:\"workingDir,omitempty\"`\n\t// RestartPolicy \"Always\" on an init container makes it a native sidecar.\n\tRestartPolicy *string `json:\"restartPolicy,omitempty\"`\n}\n\n// ContainerPort declares a container port.\ntype ContainerPort struct {\n\tName          string `json:\"name,omitempty\"`\n\tContainerPort int32  `json:\"containerPort\"`\n\tProtocol      string `json:\"protocol,omitempty\"`\n}\n\n// EnvVar is an environment variable, literal or from a Secret.\ntype EnvVar struct {\n\tName      string        `json:\"name\"`\n\tValue     string        `json:\"value,omitempty\"`\n\tValueFrom *EnvVarSource `json:\"valueFrom,omitempty\"`\n}\n\n// EnvVarSource is where an EnvVar value comes from.\ntype EnvVarSource struct {\n\tSecretKeyRef *SecretKeySelector `json:\"secretKeyRef,omitempty\"`\n}\n\n// SecretKeySelector names one key of a Secret.\ntype SecretKeySelector struct {\n\tName string `json:\"name\"`\n\tKey  string `json:\"key\"`\n}\n\n// VolumeMount mounts a volume into a container.\ntype VolumeMount struct {\n\tName      string `json:\"name\"`\n\tMountPath string `json:\"mountPath\"`\n\tSubPath   string `json:\"subPath,omitempty\"`\n\tReadOnly  bool   `json:\"readOnly,omitempty\"`\n}\n\n// Volume is a pod volume: an emptyDir or a Secret.\ntype Volume struct {\n\tName     string                `json:\"name\"`\n\tEmptyDir *EmptyDirVolumeSource `json:\"emptyDir,omitempty\"`\n\tSecret   *SecretVolumeSource   `json:\"secret,omitempty\"`\n}\n\n// EmptyDirVolumeSource is an emptyDir volume.\ntype EmptyDirVolumeSource struct {\n\tSizeLimit string `json:\"sizeLimit,omitempty\"`\n}\n\n// SecretVolumeSource projects a Secret as files.\ntype SecretVolumeSource struct {\n\tSecretName  string      `json:\"secretName\"`\n\tItems       []KeyToPath `json:\"items,omitempty\"`\n\tDefaultMode *int32      `json:\"defaultMode,omitempty\"`\n}\n\n// KeyToPath maps a Secret key to a file path.\ntype KeyToPath struct {\n\tKey  string `json:\"key\"`\n\tPath string `json:\"path\"`\n\tMode *int32 `json:\"mode,omitempty\"`\n}\n\n// SecurityContext is the container security context.\ntype SecurityContext struct {\n\tRunAsUser                *int64          `json:\"runAsUser,omitempty\"`\n\tRunAsGroup               *int64          `json:\"runAsGroup,omitempty\"`\n\tRunAsNonRoot             *bool           `json:\"runAsNonRoot,omitempty\"`\n\tAllowPrivilegeEscalation *bool           `json:\"allowPrivilegeEscalation,omitempty\"`\n\tReadOnlyRootFilesystem   *bool           `json:\"readOnlyRootFilesystem,omitempty\"`\n\tCapabilities             *Capabilities   `json:\"capabilities,omitempty\"`\n\tSeccompProfile           *SeccompProfile `json:\"seccompProfile,omitempty\"`\n}\n\n// PodSecurityContext is the pod-level security context.\ntype PodSecurityContext struct {\n\tRunAsUser      *int64          `json:\"runAsUser,omitempty\"`\n\tRunAsGroup     *int64          `json:\"runAsGroup,omitempty\"`\n\tRunAsNonRoot   *bool           `json:\"runAsNonRoot,omitempty\"`\n\tFSGroup        *int64          `json:\"fsGroup,omitempty\"`\n\tSeccompProfile *SeccompProfile `json:\"seccompProfile,omitempty\"`\n}\n\n// Capabilities lists Linux capabilities to drop.\ntype Capabilities struct {\n\tDrop []string `json:\"drop,omitempty\"`\n}\n\n// SeccompProfile selects a seccomp profile type.\ntype SeccompProfile struct {\n\tType string `json:\"type\"`\n}\n\n// ResourceRequirements are requests and limits by resource name.\ntype ResourceRequirements struct {\n\tRequests map[string]string `json:\"requests,omitempty\"`\n\tLimits   map[string]string `json:\"limits,omitempty\"`\n}\n\n// PodStatus is the observed pod state.\ntype PodStatus struct {\n\tPhase                 string            `json:\"phase,omitempty\"`\n\tReason                string            `json:\"reason,omitempty\"`\n\tMessage               string            `json:\"message,omitempty\"`\n\tPodIP                 string            `json:\"podIP,omitempty\"`\n\tInitContainerStatuses []ContainerStatus `json:\"initContainerStatuses,omitempty\"`\n\tContainerStatuses     []ContainerStatus `json:\"containerStatuses,omitempty\"`\n}\n\n// ContainerStatus is one container's observed state.\ntype ContainerStatus struct {\n\tName         string         `json:\"name\"`\n\tState        ContainerState `json:\"state,omitzero\"`\n\tRestartCount int32          `json:\"restartCount,omitempty\"`\n}\n\n// ContainerState is exactly one of Waiting, Running or Terminated.\ntype ContainerState struct {\n\tWaiting    *StateWaiting    `json:\"waiting,omitempty\"`\n\tRunning    *StateRunning    `json:\"running,omitempty\"`\n\tTerminated *StateTerminated `json:\"terminated,omitempty\"`\n}\n\n// StateWaiting is a waiting container.\ntype StateWaiting struct {\n\tReason  string `json:\"reason,omitempty\"`\n\tMessage string `json:\"message,omitempty\"`\n}\n\n// StateRunning is a running container.\ntype StateRunning struct {\n\tStartedAt time.Time `json:\"startedAt,omitzero\"`\n}\n\n// StateTerminated is a terminated container.\ntype StateTerminated struct {\n\tExitCode   int32     `json:\"exitCode\"`\n\tSignal     int32     `json:\"signal,omitempty\"`\n\tReason     string    `json:\"reason,omitempty\"`\n\tMessage    string    `json:\"message,omitempty\"`\n\tStartedAt  time.Time `json:\"startedAt,omitzero\"`\n\tFinishedAt time.Time `json:\"finishedAt,omitzero\"`\n}\n\n// Secret is a v1 Secret; Data is base64 on the wire, which encoding/json\n// does for []byte.\ntype Secret struct {\n\tMeta ObjectMeta        `json:\"metadata\"`\n\tType string            `json:\"type,omitempty\"`\n\tData map[string][]byte `json:\"data,omitempty\"`\n}\n\n// ObjectReference identifies the object an Event is about.\ntype ObjectReference struct {\n\tName string `json:\"name,omitempty\"`\n\tUID  string `json:\"uid,omitempty\"`\n}\n\n// Event is a v1 Event.\ntype Event struct {\n\tMeta           ObjectMeta      `json:\"metadata\"`\n\tInvolvedObject ObjectReference `json:\"involvedObject,omitzero\"`\n\tReason         string          `json:\"reason,omitempty\"`\n\tMessage        string          `json:\"message,omitempty\"`\n\tType           string          `json:\"type,omitempty\"`\n\tLastTimestamp  time.Time       `json:\"lastTimestamp,omitzero\"`\n}\n\n// Status is the body of an API error response.\ntype Status struct {\n\tCode    int    `json:\"code,omitempty\"`\n\tReason  string `json:\"reason,omitempty\"`\n\tMessage string `json:\"message,omitempty\"`\n}\n// Package jobpod is the single contract between the controller and a job pod\n// of the Kubernetes executor: paths, Secret items, the input manifest, the\n// result route and key helpers. The executor (#317) and the pod side (#316)\n// both import it and never each other. It imports only executor and gitref.\npackage jobpod\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/executor\"\n)\n\n// Containers.\nconst (\n\tContainerPre   = \"pre\"\n\tContainerAgent = \"agent\"\n\tContainerPost  = \"post\"\n)\n\n// Users and groups.\nconst (\n\tAgentUID   = 65532\n\tSidecarUID = 65533 // pre and post\n\tGID        = 65532 // fsGroup\n)\n\n// Volume mount paths.\nconst (\n\tMountWork   = \"/work\"    // tree without .git: pre rw, agent rw or ro, post ro\n\tMountJob    = \"/job\"     // pre and agent\n\tMountOut    = \"/out\"     // agent rw, post ro\n\tMountCtl    = \"/ctl\"     // pre only: git dirs and pre's HOME\n\tMountBin    = \"/ard-bin\" // pre rw, agent ro\n\tMountTmp    = \"/tmp\"     // agent only\n\tAgentBin    = \"/ard-bin/ard\"\n\tJobHome     = \"/job/home\"\n\tJobRole     = \"/job/role\"\n\tJobSidecar  = \"/job/sidecar\"\n\tJobHistory  = \"/job/history\"\n\tAgentConfig = \"/job/home/.claude\"\n)\n\n// Volume names.\nconst (\n\tVolWork = \"work\"\n\tVolJob  = \"job\"\n\tVolOut  = \"out\"\n\tVolCtl  = \"ctl\"\n\tVolBin  = \"ard-bin\"\n\tVolTmp  = \"tmp\"\n)\n\n// AgentPaths is the agent's view of the job, as executor.Paths.\nfunc AgentPaths() executor.Paths {\n\treturn executor.Paths{\n\t\tWork:      MountWork,\n\t\tRole:      JobRole,\n\t\tSidecar:   JobSidecar,\n\t\tConfigDir: AgentConfig,\n\t\tHistory:   JobHistory,\n\t}\n}\n\n// Agent environment.\nconst (\n\tAgentHome   = JobHome\n\tAgentTmpdir = \"/tmp\"\n)\n\n// Per-job Secret items. The model credential is stored under its env name.\nconst (\n\tItemManifest  = \"manifest.json\"\n\tItemGitAccess = \"token\"      // pre only\n\tItemResultKey = \"result-key\" // post only\n\tPreSecretDir  = \"/var/run/ard/pre\"\n\tPostSecretDir = \"/var/run/ard/post\"\n\tSecretMode    = 0o440\n)\n\n// ModelEnv lists the env names a model credential may have.\nvar ModelEnv = []string{\"ANTHROPIC_API_KEY\", \"CLAUDE_CODE_OAUTH_TOKEN\"}\n\n// Result route served by the post container.\nconst (\n\tResultPort     = 8080\n\tResultPortName = \"ard-result\"\n\tResultPath     = \"/v1/result\"\n\tRootWork       = \"work\"\n\tRootOut        = \"out\"\n\tStdoutName     = \"stdout\"\n\tDoneName       = \"done\" // marker in /out, never packed\n)\n\n// Pre exit codes: 3 means a retry cannot help, 1 is transient. A short reason\n// goes to /dev/termination-log.\nconst (\n\tExitPermanent = 3\n\tExitTransient = 1\n)\n\n// Labels.\nconst (\n\tlabelPrefix    = \"ard.albertcbrown/\"\n\tLabelPartOf    = \"app.kubernetes.io/part-of\"\n\tLabelComponent = \"app.kubernetes.io/component\"\n\tLabelInstance  = \"app.kubernetes.io/instance\"\n\tLabelRepo      = labelPrefix + \"repo\"\n\tLabelNetwork   = labelPrefix + \"network\"\n\tLabelJob       = labelPrefix + \"job\"\n\tLabelIssue     = labelPrefix + \"issue\"\n\tLabelStage     = labelPrefix + \"stage\"\n\tLabelRole      = labelPrefix + \"role\"\n\n\tComponentJob = \"ard-job\"\n)\n\n// Pod naming.\nconst (\n\tpodPrefix = \"ard-job-\"\n\t// MaxJobID is the longest job id whose pod name fits 63 characters.\n\tMaxJobID = 63 - len(podPrefix)\n)\n\n// PodName is the pod and Secret name of a job. ULIDs are case-insensitive;\n// names are lowercase.\nfunc PodName(id string) string { return podPrefix + strings.ToLower(id) }\n\n// RepoLabel is a label value for owner/name: 16 hex of the sha256 of the\n// lowercased repo.\nfunc RepoLabel(repo string) string {\n\tsum := sha256.Sum256([]byte(strings.ToLower(repo)))\n\treturn hex.EncodeToString(sum[:8])\n}\n\n// LabelValue returns s as a valid label value of at most 63 characters. A\n// value that does not fit is cut and given a short hash of the whole.\nfunc LabelValue(s string) string {\n\tclean := func(in string) string {\n\t\tb := []byte(in)\n\t\tfor i, c := range b {\n\t\t\tswitch {\n\t\t\tcase c >= 'a' && c <= 'z', c >= 'A' && c <= 'Z', c >= '0' && c <= '9', c == '-', c == '_', c == '.':\n\t\t\tdefault:\n\t\t\t\tb[i] = '_'\n\t\t\t}\n\t\t}\n\t\treturn strings.Trim(string(b), \"-_.\")\n\t}\n\tv := clean(s)\n\tif v == s && len(v) <= 63 {\n\t\treturn v\n\t}\n\tsum := sha256.Sum256([]byte(s))\n\th := hex.EncodeToString(sum[:4])\n\tif len(v) > 63-9 {\n\t\tv = v[:63-9]\n\t}\n\tv = strings.Trim(v, \"-_.\")\n\tif v == \"\" {\n\t\treturn h\n\t}\n\treturn v + \"-\" + h\n}\npackage jobpod\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"path\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/executor\"\n\t\"github.com/albertcbrown/ard/internal/gitref\"\n)\n\n// ManifestVersion is the only manifest version this package reads.\nconst ManifestVersion = 1\n\n// MaxManifestBytes caps the encoded manifest. The cap is on the JSON, because\n// base64 grows inputs by a third and a Secret is limited to 1 MiB.\nconst MaxManifestBytes = 768 << 10\n\n// ErrTooLarge means the encoded manifest is over MaxManifestBytes.\nvar ErrTooLarge = errors.New(\"jobpod: manifest exceeds the size cap\")\n\n// Source names a tree at a commit.\ntype Source struct {\n\tRepo string // owner/name\n\tSHA  string // 40-hex\n\tPath string // directory within the repo; unused for sidecars\n}\n\n// Manifest tells the pre container what to fetch and place.\ntype Manifest struct {\n\tV        int\n\tRepo     string // owner/name\n\tBaseSHA  string\n\tHistory  bool\n\tReadOnly bool\n\tRole     Source  // role dir at the config commit\n\tSidecar  *Source // pinned SHA\n\tScrub    []string\n\tInputs   []executor.File\n}\n\n// Encode validates and encodes m, refusing more than MaxManifestBytes.\nfunc Encode(m Manifest) ([]byte, error) {\n\tif err := m.validate(); err != nil {\n\t\treturn nil, err\n\t}\n\tb, err := json.Marshal(m)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif len(b) > MaxManifestBytes {\n\t\treturn nil, fmt.Errorf(\"%w: %d > %d bytes\", ErrTooLarge, len(b), MaxManifestBytes)\n\t}\n\treturn b, nil\n}\n\n// Decode parses and validates a manifest. Unknown fields are refused.\nfunc Decode(b []byte) (Manifest, error) {\n\tvar m Manifest\n\tif len(b) > MaxManifestBytes {\n\t\treturn m, ErrTooLarge\n\t}\n\tdec := json.NewDecoder(bytes.NewReader(b))\n\tdec.DisallowUnknownFields()\n\tif err := dec.Decode(&m); err != nil {\n\t\treturn Manifest{}, fmt.Errorf(\"jobpod: manifest: %w\", err)\n\t}\n\tif err := m.validate(); err != nil {\n\t\treturn Manifest{}, err\n\t}\n\treturn m, nil\n}\n\nfunc (m Manifest) validate() error {\n\tif m.V != ManifestVersion {\n\t\treturn fmt.Errorf(\"jobpod: manifest version %d, want %d\", m.V, ManifestVersion)\n\t}\n\tif !validRepo(m.Repo) {\n\t\treturn fmt.Errorf(\"jobpod: bad repo %q\", m.Repo)\n\t}\n\tif !gitref.IsSHA(m.BaseSHA) {\n\t\treturn errors.New(\"jobpod: base sha is not a 40-hex commit\")\n\t}\n\tif err := m.Role.validate(\"role\", true); err != nil {\n\t\treturn err\n\t}\n\tif m.Sidecar != nil {\n\t\tif err := m.Sidecar.validate(\"sidecar\", false); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\tfor _, p := range m.Scrub {\n\t\tif !cleanRel(p) {\n\t\t\treturn fmt.Errorf(\"jobpod: scrub path %q is not a clean relative path\", p)\n\t\t}\n\t}\n\tfor _, f := range m.Inputs {\n\t\tif !cleanRel(f.Path) {\n\t\t\treturn fmt.Errorf(\"jobpod: input path %q is not a clean relative path\", f.Path)\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc (s Source) validate(what string, needPath bool) error {\n\tif !validRepo(s.Repo) {\n\t\treturn fmt.Errorf(\"jobpod: %s: bad repo %q\", what, s.Repo)\n\t}\n\tif !gitref.IsSHA(s.SHA) {\n\t\treturn fmt.Errorf(\"jobpod: %s: sha is not a 40-hex commit\", what)\n\t}\n\tif needPath && !cleanRel(s.Path) {\n\t\treturn fmt.Errorf(\"jobpod: %s: path %q is not a clean relative path\", what, s.Path)\n\t}\n\treturn nil\n}\n\nfunc validRepo(r string) bool {\n\to, n, ok := strings.Cut(r, \"/\")\n\treturn ok && o != \"\" && n != \"\" && !strings.Contains(n, \"/\") &&\n\t\t!strings.ContainsAny(r, \" \\t\\n\\\\:\") && o != \"..\" && n != \"..\" && o != \".\" && n != \".\"\n}\n\n// cleanRel reports whether p is a non-empty, relative, already-clean path.\nfunc cleanRel(p string) bool {\n\tif p == \"\" || strings.HasPrefix(p, \"/\") || strings.Contains(p, \"\\\\\") || strings.ContainsRune(p, 0) {\n\t\treturn false\n\t}\n\treturn path.Clean(p) == p && p != \".\" && p != \"..\" && !strings.HasPrefix(p, \"../\")\n}\npackage jobpod\n\nimport (\n\t\"crypto/rand\"\n\t\"crypto/sha256\"\n\t\"crypto/subtle\"\n\t\"encoding/base64\"\n\t\"fmt\"\n\t\"slices\"\n)\n\n// NewKey returns a fresh 32-byte result key as raw base64url.\nfunc NewKey() (string, error) {\n\tb := make([]byte, 32)\n\tif _, err := rand.Read(b); err != nil {\n\t\treturn \"\", fmt.Errorf(\"jobpod: key: %w\", err)\n\t}\n\treturn base64.RawURLEncoding.EncodeToString(b), nil\n}\n\n// SecretData builds the per-job Secret's items. modelName must be one of\n// ModelEnv.\nfunc SecretData(manifest []byte, gitToken, resultKey, modelName, modelValue string) (map[string][]byte, error) {\n\tif !slices.Contains(ModelEnv, modelName) {\n\t\treturn nil, fmt.Errorf(\"jobpod: %q is not an allowed model credential name\", modelName)\n\t}\n\treturn map[string][]byte{\n\t\tItemManifest:  manifest,\n\t\tItemGitAccess: []byte(gitToken),\n\t\tItemResultKey: []byte(resultKey),\n\t\tmodelName:     []byte(modelValue),\n\t}, nil\n}\n\n// KeyMatches compares keys in constant time, whatever their lengths.\nfunc KeyMatches(got, want string) bool {\n\ta, b := sha256.Sum256([]byte(got)), sha256.Sum256([]byte(want))\n\treturn subtle.ConstantTimeCompare(a[:], b[:]) == 1\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"caaac10a-be20-4f28-971a-a15b2700a532","uuid":"f5a8b98d-e838-41e3-87cb-f792c4ea8d94","timestamp":"2026-11-25T13:13:28.194Z","tool_use_result":{"stdout":"package api\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"time\"\n)\n\n// ErrNotFound is returned for a 404.\nvar ErrNotFound = errors.New(\"kube: not found\")\n\n// ErrConflict is returned for a 409.\nvar ErrConflict = errors.New(\"kube: conflict\")\n\n// StatusError is any other non-2xx API answer.\ntype StatusError struct {\n\tCode    int\n\tReason  string\n\tMessage string\n}\n\nfunc (e *StatusError) Error() string {\n\treturn fmt.Sprintf(\"kube: status %d %s: %s\", e.Code, e.Reason, e.Message)\n}\n\n// Client is the few Kubernetes endpoints ard uses. There is deliberately no\n// pods/exec, no Secret get or list and no patch.\ntype Client interface {\n\tCreatePod(ctx context.Context, ns string, p *Pod) (*Pod, error)\n\t// GetPod returns ErrNotFound when the pod does not exist.\n\tGetPod(ctx context.Context, ns, name string) (*Pod, error)\n\tListPods(ctx context.Context, ns, labelSelector string) ([]Pod, error)\n\t// DeletePod uses background propagation; a missing pod is not an error.\n\tDeletePod(ctx context.Context, ns, name string, graceSec int64) error\n\t// PodLogs follows the container log with timestamps. A zero sinceTime\n\t// starts at the beginning.\n\tPodLogs(ctx context.Context, ns, name, container string, sinceTime time.Time) (io.ReadCloser, error)\n\t// CreateSecret returns ErrConflict when the Secret exists.\n\tCreateSecret(ctx context.Context, ns string, s *Secret) error\n\t// DeleteSecret treats a missing Secret as success.\n\tDeleteSecret(ctx context.Context, ns, name string) error\n\tListEvents(ctx context.Context, ns, fieldSelector string) ([]Event, error)\n}\n// Package api is a minimal Kubernetes REST layer: only the JSON fields ard\n// sets or reads, a Client interface, and an in-cluster implementation.\n// It uses the standard library only (no client-go).\npackage api\n\nimport \"time\"\n\n// ObjectMeta is the metadata common to every object.\ntype ObjectMeta struct {\n\tName              string            `json:\"name,omitempty\"`\n\tNamespace         string            `json:\"namespace,omitempty\"`\n\tUID               string            `json:\"uid,omitempty\"`\n\tLabels            map[string]string `json:\"labels,omitempty\"`\n\tAnnotations       map[string]string `json:\"annotations,omitempty\"`\n\tOwnerReferences   []OwnerReference  `json:\"ownerReferences,omitempty\"`\n\tCreationTimestamp time.Time         `json:\"creationTimestamp,omitzero\"`\n}\n\n// OwnerReference links an object to its owner.\ntype OwnerReference struct {\n\tAPIVersion string `json:\"apiVersion,omitempty\"`\n\tKind       string `json:\"kind,omitempty\"`\n\tName       string `json:\"name,omitempty\"`\n\tUID        string `json:\"uid,omitempty\"`\n}\n\n// Pod is a v1 Pod.\ntype Pod struct {\n\tMeta   ObjectMeta `json:\"metadata\"`\n\tSpec   PodSpec    `json:\"spec\"`\n\tStatus PodStatus  `json:\"status,omitzero\"`\n}\n\n// PodSpec is the part of the pod spec ard sets.\ntype PodSpec struct {\n\tInitContainers                []Container         `json:\"initContainers,omitempty\"`\n\tContainers                    []Container         `json:\"containers,omitempty\"`\n\tVolumes                       []Volume            `json:\"volumes,omitempty\"`\n\tRestartPolicy                 string              `json:\"restartPolicy,omitempty\"`\n\tActiveDeadlineSeconds         *int64              `json:\"activeDeadlineSeconds,omitempty\"`\n\tTerminationGracePeriodSeconds *int64              `json:\"terminationGracePeriodSeconds,omitempty\"`\n\tAutomountServiceAccountToken  *bool               `json:\"automountServiceAccountToken,omitempty\"`\n\tEnableServiceLinks            *bool               `json:\"enableServiceLinks,omitempty\"`\n\tServiceAccountName            string              `json:\"serviceAccountName,omitempty\"`\n\tSecurityContext               *PodSecurityContext `json:\"securityContext,omitempty\"`\n\tShareProcessNamespace         *bool               `json:\"shareProcessNamespace,omitempty\"`\n}\n\n// Container is a v1 Container.\ntype Container struct {\n\tName                     string               `json:\"name\"`\n\tImage                    string               `json:\"image,omitempty\"`\n\tImagePullPolicy          string               `json:\"imagePullPolicy,omitempty\"`\n\tTerminationMessagePolicy string               `json:\"terminationMessagePolicy,omitempty\"`\n\tCommand                  []string             `json:\"command,omitempty\"`\n\tArgs                     []string             `json:\"args,omitempty\"`\n\tEnv                      []EnvVar             `json:\"env,omitempty\"`\n\tPorts                    []ContainerPort      `json:\"ports,omitempty\"`\n\tVolumeMounts             []VolumeMount        `json:\"volumeMounts,omitempty\"`\n\tResources                ResourceRequirements `json:\"resources,omitzero\"`\n\tSecurityContext          *SecurityContext     `json:\"securityContext,omitempty\"`\n\tWorkingDir               string               `json:\"workingDir,omitempty\"`\n\t// RestartPolicy \"Always\" on an init container makes it a native sidecar.\n\tRestartPolicy *string `json:\"restartPolicy,omitempty\"`\n}\n\n// ContainerPort declares a container port.\ntype ContainerPort struct {\n\tName          string `json:\"name,omitempty\"`\n\tContainerPort int32  `json:\"containerPort\"`\n\tProtocol      string `json:\"protocol,omitempty\"`\n}\n\n// EnvVar is an environment variable, literal or from a Secret.\ntype EnvVar struct {\n\tName      string        `json:\"name\"`\n\tValue     string        `json:\"value,omitempty\"`\n\tValueFrom *EnvVarSource `json:\"valueFrom,omitempty\"`\n}\n\n// EnvVarSource is where an EnvVar value comes from.\ntype EnvVarSource struct {\n\tSecretKeyRef *SecretKeySelector `json:\"secretKeyRef,omitempty\"`\n}\n\n// SecretKeySelector names one key of a Secret.\ntype SecretKeySelector struct {\n\tName string `json:\"name\"`\n\tKey  string `json:\"key\"`\n}\n\n// VolumeMount mounts a volume into a container.\ntype VolumeMount struct {\n\tName      string `json:\"name\"`\n\tMountPath string `json:\"mountPath\"`\n\tSubPath   string `json:\"subPath,omitempty\"`\n\tReadOnly  bool   `json:\"readOnly,omitempty\"`\n}\n\n// Volume is a pod volume: an emptyDir or a Secret.\ntype Volume struct {\n\tName     string                `json:\"name\"`\n\tEmptyDir *EmptyDirVolumeSource `json:\"emptyDir,omitempty\"`\n\tSecret   *SecretVolumeSource   `json:\"secret,omitempty\"`\n}\n\n// EmptyDirVolumeSource is an emptyDir volume.\ntype EmptyDirVolumeSource struct {\n\tSizeLimit string `json:\"sizeLimit,omitempty\"`\n}\n\n// SecretVolumeSource projects a Secret as files.\ntype SecretVolumeSource struct {\n\tSecretName  string      `json:\"secretName\"`\n\tItems       []KeyToPath `json:\"items,omitempty\"`\n\tDefaultMode *int32      `json:\"defaultMode,omitempty\"`\n}\n\n// KeyToPath maps a Secret key to a file path.\ntype KeyToPath struct {\n\tKey  string `json:\"key\"`\n\tPath string `json:\"path\"`\n\tMode *int32 `json:\"mode,omitempty\"`\n}\n\n// SecurityContext is the container security context.\ntype SecurityContext struct {\n\tRunAsUser                *int64          `json:\"runAsUser,omitempty\"`\n\tRunAsGroup               *int64          `json:\"runAsGroup,omitempty\"`\n\tRunAsNonRoot             *bool           `json:\"runAsNonRoot,omitempty\"`\n\tAllowPrivilegeEscalation *bool           `json:\"allowPrivilegeEscalation,omitempty\"`\n\tReadOnlyRootFilesystem   *bool           `json:\"readOnlyRootFilesystem,omitempty\"`\n\tCapabilities             *Capabilities   `json:\"capabilities,omitempty\"`\n\tSeccompProfile           *SeccompProfile `json:\"seccompProfile,omitempty\"`\n}\n\n// PodSecurityContext is the pod-level security context.\ntype PodSecurityContext struct {\n\tRunAsUser      *int64          `json:\"runAsUser,omitempty\"`\n\tRunAsGroup     *int64          `json:\"runAsGroup,omitempty\"`\n\tRunAsNonRoot   *bool           `json:\"runAsNonRoot,omitempty\"`\n\tFSGroup        *int64          `json:\"fsGroup,omitempty\"`\n\tSeccompProfile *SeccompProfile `json:\"seccompProfile,omitempty\"`\n}\n\n// Capabilities lists Linux capabilities to drop.\ntype Capabilities struct {\n\tDrop []string `json:\"drop,omitempty\"`\n}\n\n// SeccompProfile selects a seccomp profile type.\ntype SeccompProfile struct {\n\tType string `json:\"type\"`\n}\n\n// ResourceRequirements are requests and limits by resource name.\ntype ResourceRequirements struct {\n\tRequests map[string]string `json:\"requests,omitempty\"`\n\tLimits   map[string]string `json:\"limits,omitempty\"`\n}\n\n// PodStatus is the observed pod state.\ntype PodStatus struct {\n\tPhase                 string            `json:\"phase,omitempty\"`\n\tReason                string            `json:\"reason,omitempty\"`\n\tMessage               string            `json:\"message,omitempty\"`\n\tPodIP                 string            `json:\"podIP,omitempty\"`\n\tInitContainerStatuses []ContainerStatus `json:\"initContainerStatuses,omitempty\"`\n\tContainerStatuses     []ContainerStatus `json:\"containerStatuses,omitempty\"`\n}\n\n// ContainerStatus is one container's observed state.\ntype ContainerStatus struct {\n\tName         string         `json:\"name\"`\n\tState        ContainerState `json:\"state,omitzero\"`\n\tRestartCount int32          `json:\"restartCount,omitempty\"`\n}\n\n// ContainerState is exactly one of Waiting, Running or Terminated.\ntype ContainerState struct {\n\tWaiting    *StateWaiting    `json:\"waiting,omitempty\"`\n\tRunning    *StateRunning    `json:\"running,omitempty\"`\n\tTerminated *StateTerminated `json:\"terminated,omitempty\"`\n}\n\n// StateWaiting is a waiting container.\ntype StateWaiting struct {\n\tReason  string `json:\"reason,omitempty\"`\n\tMessage string `json:\"message,omitempty\"`\n}\n\n// StateRunning is a running container.\ntype StateRunning struct {\n\tStartedAt time.Time `json:\"startedAt,omitzero\"`\n}\n\n// StateTerminated is a terminated container.\ntype StateTerminated struct {\n\tExitCode   int32     `json:\"exitCode\"`\n\tSignal     int32     `json:\"signal,omitempty\"`\n\tReason     string    `json:\"reason,omitempty\"`\n\tMessage    string    `json:\"message,omitempty\"`\n\tStartedAt  time.Time `json:\"startedAt,omitzero\"`\n\tFinishedAt time.Time `json:\"finishedAt,omitzero\"`\n}\n\n// Secret is a v1 Secret; Data is base64 on the wire, which encoding/json\n// does for []byte.\ntype Secret struct {\n\tMeta ObjectMeta        `json:\"metadata\"`\n\tType string            `json:\"type,omitempty\"`\n\tData map[string][]byte `json:\"data,omitempty\"`\n}\n\n// ObjectReference identifies the object an Event is about.\ntype ObjectReference struct {\n\tName string `json:\"name,omitempty\"`\n\tUID  string `json:\"uid,omitempty\"`\n}\n\n// Event is a v1 Event.\ntype Event struct {\n\tMeta           ObjectMeta      `json:\"metadata\"`\n\tInvolvedObject ObjectReference `json:\"involvedObject,omitzero\"`\n\tReason         string          `json:\"reason,omitempty\"`\n\tMessage        string          `json:\"message,omitempty\"`\n\tType           string          `json:\"type,omitempty\"`\n\tLastTimestamp  time.Time       `json:\"lastTimestamp,omitzero\"`\n}\n\n// Status is the body of an API error response.\ntype Status struct {\n\tCode    int    `json:\"code,omitempty\"`\n\tReason  string `json:\"reason,omitempty\"`\n\tMessage string `json:\"message,omitempty\"`\n}\n// Package jobpod is the single contract between the controller and a job pod\n// of the Kubernetes executor: paths, Secret items, the input manifest, the\n// result route and key helpers. The executor (#317) and the pod side (#316)\n// both import it and never each other. It imports only executor and gitref.\npackage jobpod\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/executor\"\n)\n\n// Containers.\nconst (\n\tContainerPre   = \"pre\"\n\tContainerAgent = \"agent\"\n\tContainerPost  = \"post\"\n)\n\n// Users and groups.\nconst (\n\tAgentUID   = 65532\n\tSidecarUID = 65533 // pre and post\n\tGID        = 65532 // fsGroup\n)\n\n// Volume mount paths.\nconst (\n\tMountWork   = \"/work\"    // tree without .git: pre rw, agent rw or ro, post ro\n\tMountJob    = \"/job\"     // pre and agent\n\tMountOut    = \"/out\"     // agent rw, post ro\n\tMountCtl    = \"/ctl\"     // pre only: git dirs and pre's HOME\n\tMountBin    = \"/ard-bin\" // pre rw, agent ro\n\tMountTmp    = \"/tmp\"     // agent only\n\tAgentBin    = \"/ard-bin/ard\"\n\tJobHome     = \"/job/home\"\n\tJobRole     = \"/job/role\"\n\tJobSidecar  = \"/job/sidecar\"\n\tJobHistory  = \"/job/history\"\n\tAgentConfig = \"/job/home/.claude\"\n)\n\n// Volume names.\nconst (\n\tVolWork = \"work\"\n\tVolJob  = \"job\"\n\tVolOut  = \"out\"\n\tVolCtl  = \"ctl\"\n\tVolBin  = \"ard-bin\"\n\tVolTmp  = \"tmp\"\n)\n\n// AgentPaths is the agent's view of the job, as executor.Paths.\nfunc AgentPaths() executor.Paths {\n\treturn executor.Paths{\n\t\tWork:      MountWork,\n\t\tRole:      JobRole,\n\t\tSidecar:   JobSidecar,\n\t\tConfigDir: AgentConfig,\n\t\tHistory:   JobHistory,\n\t}\n}\n\n// Agent environment.\nconst (\n\tAgentHome   = JobHome\n\tAgentTmpdir = \"/tmp\"\n)\n\n// Per-job Secret items. The model credential is stored under its env name.\nconst (\n\tItemManifest  = \"manifest.json\"\n\tItemGitAccess = \"token\"      // pre only\n\tItemResultKey = \"result-key\" // post only\n\tPreSecretDir  = \"/var/run/ard/pre\"\n\tPostSecretDir = \"/var/run/ard/post\"\n\tSecretMode    = 0o440\n)\n\n// ModelEnv lists the env names a model credential may have.\nvar ModelEnv = []string{\"ANTHROPIC_API_KEY\", \"CLAUDE_CODE_OAUTH_TOKEN\"}\n\n// Result route served by the post container.\nconst (\n\tResultPort     = 8080\n\tResultPortName = \"ard-result\"\n\tResultPath     = \"/v1/result\"\n\tRootWork       = \"work\"\n\tRootOut        = \"out\"\n\tStdoutName     = \"stdout\"\n\tDoneName       = \"done\" // marker in /out, never packed\n)\n\n// Pre exit codes: 3 means a retry cannot help, 1 is transient. A short reason\n// goes to /dev/termination-log.\nconst (\n\tExitPermanent = 3\n\tExitTransient = 1\n)\n\n// Labels.\nconst (\n\tlabelPrefix    = \"ard.albertcbrown/\"\n\tLabelPartOf    = \"app.kubernetes.io/part-of\"\n\tLabelComponent = \"app.kubernetes.io/component\"\n\tLabelInstance  = \"app.kubernetes.io/instance\"\n\tLabelRepo      = labelPrefix + \"repo\"\n\tLabelNetwork   = labelPrefix + \"network\"\n\tLabelJob       = labelPrefix + \"job\"\n\tLabelIssue     = labelPrefix + \"issue\"\n\tLabelStage     = labelPrefix + \"stage\"\n\tLabelRole      = labelPrefix + \"role\"\n\n\tComponentJob = \"ard-job\"\n)\n\n// Pod naming.\nconst (\n\tpodPrefix = \"ard-job-\"\n\t// MaxJobID is the longest job id whose pod name fits 63 characters.\n\tMaxJobID = 63 - len(podPrefix)\n)\n\n// PodName is the pod and Secret name of a job. ULIDs are case-insensitive;\n// names are lowercase.\nfunc PodName(id string) string { return podPrefix + strings.ToLower(id) }\n\n// RepoLabel is a label value for owner/name: 16 hex of the sha256 of the\n// lowercased repo.\nfunc RepoLabel(repo string) string {\n\tsum := sha256.Sum256([]byte(strings.ToLower(repo)))\n\treturn hex.EncodeToString(sum[:8])\n}\n\n// LabelValue returns s as a valid label value of at most 63 characters. A\n// value that does not fit is cut and given a short hash of the whole.\nfunc LabelValue(s string) string {\n\tclean := func(in string) string {\n\t\tb := []byte(in)\n\t\tfor i, c := range b {\n\t\t\tswitch {\n\t\t\tcase c >= 'a' && c <= 'z', c >= 'A' && c <= 'Z', c >= '0' && c <= '9', c == '-', c == '_', c == '.':\n\t\t\tdefault:\n\t\t\t\tb[i] = '_'\n\t\t\t}\n\t\t}\n\t\treturn strings.Trim(string(b), \"-_.\")\n\t}\n\tv := clean(s)\n\tif v == s && len(v) <= 63 {\n\t\treturn v\n\t}\n\tsum := sha256.Sum256([]byte(s))\n\th := hex.EncodeToString(sum[:4])\n\tif len(v) > 63-9 {\n\t\tv = v[:63-9]\n\t}\n\tv = strings.Trim(v, \"-_.\")\n\tif v == \"\" {\n\t\treturn h\n\t}\n\treturn v + \"-\" + h\n}\npackage jobpod\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"path\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/executor\"\n\t\"github.com/albertcbrown/ard/internal/gitref\"\n)\n\n// ManifestVersion is the only manifest version this package reads.\nconst ManifestVersion = 1\n\n// MaxManifestBytes caps the encoded manifest. The cap is on the JSON, because\n// base64 grows inputs by a third and a Secret is limited to 1 MiB.\nconst MaxManifestBytes = 768 << 10\n\n// ErrTooLarge means the encoded manifest is over MaxManifestBytes.\nvar ErrTooLarge = errors.New(\"jobpod: manifest exceeds the size cap\")\n\n// Source names a tree at a commit.\ntype Source struct {\n\tRepo string // owner/name\n\tSHA  string // 40-hex\n\tPath string // directory within the repo; unused for sidecars\n}\n\n// Manifest tells the pre container what to fetch and place.\ntype Manifest struct {\n\tV        int\n\tRepo     string // owner/name\n\tBaseSHA  string\n\tHistory  bool\n\tReadOnly bool\n\tRole     Source  // role dir at the config commit\n\tSidecar  *Source // pinned SHA\n\tScrub    []string\n\tInputs   []executor.File\n}\n\n// Encode validates and encodes m, refusing more than MaxManifestBytes.\nfunc Encode(m Manifest) ([]byte, error) {\n\tif err := m.validate(); err != nil {\n\t\treturn nil, err\n\t}\n\tb, err := json.Marshal(m)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif len(b) > MaxManifestBytes {\n\t\treturn nil, fmt.Errorf(\"%w: %d > %d bytes\", ErrTooLarge, len(b), MaxManifestBytes)\n\t}\n\treturn b, nil\n}\n\n// Decode parses and validates a manifest. Unknown fields are refused.\nfunc Decode(b []byte) (Manifest, error) {\n\tvar m Manifest\n\tif len(b) > MaxManifestBytes {\n\t\treturn m, ErrTooLarge\n\t}\n\tdec := json.NewDecoder(bytes.NewReader(b))\n\tdec.DisallowUnknownFields()\n\tif err := dec.Decode(&m); err != nil {\n\t\treturn Manifest{}, fmt.Errorf(\"jobpod: manifest: %w\", err)\n\t}\n\tif err := m.validate(); err != nil {\n\t\treturn Manifest{}, err\n\t}\n\treturn m, nil\n}\n\nfunc (m Manifest) validate() error {\n\tif m.V != ManifestVersion {\n\t\treturn fmt.Errorf(\"jobpod: manifest version %d, want %d\", m.V, ManifestVersion)\n\t}\n\tif !validRepo(m.Repo) {\n\t\treturn fmt.Errorf(\"jobpod: bad repo %q\", m.Repo)\n\t}\n\tif !gitref.IsSHA(m.BaseSHA) {\n\t\treturn errors.New(\"jobpod: base sha is not a 40-hex commit\")\n\t}\n\tif err := m.Role.validate(\"role\", true); err != nil {\n\t\treturn err\n\t}\n\tif m.Sidecar != nil {\n\t\tif err := m.Sidecar.validate(\"sidecar\", false); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\tfor _, p := range m.Scrub {\n\t\tif !cleanRel(p) {\n\t\t\treturn fmt.Errorf(\"jobpod: scrub path %q is not a clean relative path\", p)\n\t\t}\n\t}\n\tfor _, f := range m.Inputs {\n\t\tif !cleanRel(f.Path) {\n\t\t\treturn fmt.Errorf(\"jobpod: input path %q is not a clean relative path\", f.Path)\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc (s Source) validate(what string, needPath bool) error {\n\tif !validRepo(s.Repo) {\n\t\treturn fmt.Errorf(\"jobpod: %s: bad repo %q\", what, s.Repo)\n\t}\n\tif !gitref.IsSHA(s.SHA) {\n\t\treturn fmt.Errorf(\"jobpod: %s: sha is not a 40-hex commit\", what)\n\t}\n\tif needPath && !cleanRel(s.Path) {\n\t\treturn fmt.Errorf(\"jobpod: %s: path %q is not a clean relative path\", what, s.Path)\n\t}\n\treturn nil\n}\n\nfunc validRepo(r string) bool {\n\to, n, ok := strings.Cut(r, \"/\")\n\treturn ok && o != \"\" && n != \"\" && !strings.Contains(n, \"/\") &&\n\t\t!strings.ContainsAny(r, \" \\t\\n\\\\:\") && o != \"..\" && n != \"..\" && o != \".\" && n != \".\"\n}\n\n// cleanRel reports whether p is a non-empty, relative, already-clean path.\nfunc cleanRel(p string) bool {\n\tif p == \"\" || strings.HasPrefix(p, \"/\") || strings.Contains(p, \"\\\\\") || strings.ContainsRune(p, 0) {\n\t\treturn false\n\t}\n\treturn path.Clean(p) == p && p != \".\" && p != \"..\" && !strings.HasPrefix(p, \"../\")\n}\npackage jobpod\n\nimport (\n\t\"crypto/rand\"\n\t\"crypto/sha256\"\n\t\"crypto/subtle\"\n\t\"encoding/base64\"\n\t\"fmt\"\n\t\"slices\"\n)\n\n// NewKey returns a fresh 32-byte result key as raw base64url.\nfunc NewKey() (string, error) {\n\tb := make([]byte, 32)\n\tif _, err := rand.Read(b); err != nil {\n\t\treturn \"\", fmt.Errorf(\"jobpod: key: %w\", err)\n\t}\n\treturn base64.RawURLEncoding.EncodeToString(b), nil\n}\n\n// SecretData builds the per-job Secre