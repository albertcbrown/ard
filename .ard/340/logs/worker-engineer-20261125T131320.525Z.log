{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015GduqMRhdr9BRx7XEsUTEo","type":"tool_result","content":"package workspace\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"path/filepath\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n)\n\n// Git is the small slice of git the workspace needs for worktrees.\ntype Git interface {\n\tRevParse(ctx context.Context, repo, rev string) (string, error)\n\t// WorktreeAdd creates a detached worktree at dir, at sha.\n\tWorktreeAdd(ctx context.Context, repo, dir, sha string) error\n\tWorktreeRemove(ctx context.Context, repo, dir string, force bool) error\n\tWorktreePrune(ctx context.Context, repo string) error\n}\n\n// Options configures a Workspace.\ntype Options struct {\n\tRoot string // absolute; required\n\tGit  Git    // required: the worktree runner\n\n\tSidecarGit     SidecarGit               // default gitx.New(\"\")\n\tSidecarURL     func(repo string) string // default https://github.com/<repo>.git\n\tSidecarToken   gitx.TokenFunc           // nil = no auth header\n\tSidecarTimeout time.Duration            // init + fetch + export bound; default 2m\n\n\t// CloneDir, if set, is the only repository Remove runs git worktree\n\t// admin in. A handle whose RepoDir differs (stored before #113, when\n\t// RepoDir was the operator's checkout) has its worktree made writable and\n\t// removed with os.RemoveAll, with no git call, and one\n\t// executor.cleanup_foreign_repo Info log. \"\" = always use h.RepoDir.\n\tCloneDir string\n\n\tNow func() time.Time\n\tLog *slog.Logger\n}\n\n// Workspace builds and removes job directories under Root.\ntype Workspace struct {\n\troot           string\n\tgit            Git\n\tsgit           SidecarGit\n\tsidecarURL     func(repo string) string\n\tsidecarToken   gitx.TokenFunc\n\tsidecarTimeout time.Duration\n\tcloneDir       string\n\tnow            func() time.Time\n\tlog            *slog.Logger\n\n\tmu           sync.Mutex\n\tsidecarLocks map[string]chan struct{} // per cache dir, 1-buffer slot; guarded by mu\n}\n\n// New returns a Workspace with defaults applied.\nfunc New(o Options) (*Workspace, error) {\n\tif !filepath.IsAbs(o.Root) {\n\t\treturn nil, fmt.Errorf(\"root %q is not absolute\", o.Root)\n\t}\n\tif o.Git == nil {\n\t\treturn nil, fmt.Errorf(\"workspace: no git runner\")\n\t}\n\tif o.Now == nil {\n\t\to.Now = time.Now\n\t}\n\tif o.Log == nil {\n\t\to.Log = slog.Default()\n\t}\n\tif o.SidecarGit == nil {\n\t\to.SidecarGit = gitx.New(\"\")\n\t}\n\tif o.SidecarURL == nil {\n\t\to.SidecarURL = defaultSidecarURL\n\t}\n\tif o.SidecarTimeout <= 0 {\n\t\to.SidecarTimeout = defaultSidecarTimeout\n\t}\n\treturn &Workspace{root: o.Root, git: o.Git, sgit: o.SidecarGit, sidecarURL: o.SidecarURL,\n\t\tsidecarToken: o.SidecarToken, sidecarTimeout: o.SidecarTimeout, cloneDir: cleanDir(o.CloneDir),\n\t\tnow: o.Now, log: o.Log, sidecarLocks: map[string]chan struct{}{}}, nil\n}\n\n// cleanDir is filepath.Clean, but keeps \"\" as \"\".\nfunc cleanDir(p string) string {\n\tif p == \"\" {\n\t\treturn \"\"\n\t}\n\treturn filepath.Clean(p)\n}\npackage workspace\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/executor\"\n)\n\n// Remove deletes the worktree and home of h and prunes git's registration.\nfunc (w *Workspace) Remove(ctx context.Context, h executor.Handle) error {\n\tvar errs []error\n\tforeign := w.cloneDir != \"\" && filepath.Clean(h.RepoDir) != w.cloneDir\n\tif _, err := os.Stat(h.Worktree); err == nil {\n\t\tChmodWritable(h.Worktree)\n\t\tif foreign {\n\t\t\t// Stored before #113: RepoDir is the operator's checkout, where\n\t\t\t// ard never runs git. The registration there dangles until the\n\t\t\t// operator's own `git worktree prune`.\n\t\t\tw.log.Info(\"executor.cleanup_foreign_repo\", \"job\", h.JobID, \"repo_dir\", h.RepoDir, \"clone\", w.cloneDir)\n\t\t\tif err := RemoveAllWritable(h.Worktree); err != nil {\n\t\t\t\terrs = append(errs, err)\n\t\t\t}\n\t\t} else if err := w.git.WorktreeRemove(context.WithoutCancel(ctx), h.RepoDir, h.Worktree, true); err != nil {\n\t\t\terrs = append(errs, err)\n\t\t\tRemoveAllWritable(h.Worktree)\n\t\t}\n\t}\n\t// Home holds a-w trees (sidecar, Go module cache); derived from Home, not h.SidecarDir\n\tif err := RemoveAllWritable(h.Home); err != nil {\n\t\terrs = append(errs, err)\n\t}\n\tif !foreign {\n\t\tif err := w.git.WorktreePrune(context.WithoutCancel(ctx), h.RepoDir); err != nil {\n\t\t\terrs = append(errs, err)\n\t\t}\n\t}\n\treturn errors.Join(errs...)\n}\n\n// Prune deletes host log files older than olderThan, then empty dirs.\nfunc (w *Workspace) Prune(ctx context.Context, olderThan time.Duration) error {\n\tcutoff := w.now().Add(-olderThan)\n\tdir := filepath.Join(w.root, \"logs\")\n\tvar dirs []string\n\terr := filepath.WalkDir(dir, func(p string, d fs.DirEntry, err error) error {\n\t\tif err != nil {\n\t\t\tif errors.Is(err, fs.ErrNotExist) {\n\t\t\t\treturn nil\n\t\t\t}\n\t\t\treturn err\n\t\t}\n\t\tif d.IsDir() {\n\t\t\tdirs = append(dirs, p)\n\t\t\treturn nil\n\t\t}\n\t\tif st, e := d.Info(); e == nil && st.ModTime().Before(cutoff) {\n\t\t\treturn os.Remove(p)\n\t\t}\n\t\treturn nil\n\t})\n\tfor i := len(dirs) - 1; i > 0; i-- { // deepest first, keep logs/ itself\n\t\tos.Remove(dirs[i]) // fails harmlessly when not empty\n\t}\n\tif err != nil {\n\t\treturn fmt.Errorf(\"prune logs: %w\", err)\n\t}\n\treturn nil\n}\npackage workspace\n\nimport (\n\t\"fmt\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/repopath\"\n)\n\n// repoDir is <root>/<kind>/<owner>/<repo>, lowercased and validated.\nfunc (w *Workspace) repoDir(kind, repo string) (string, error) {\n\treturn repopath.Join(filepath.Join(w.root, kind), repo)\n}\n\n// WorktreePath is where a job's worktree lives.\nfunc (w *Workspace) WorktreePath(repo, jobID string) (string, error) {\n\td, err := w.repoDir(\"work\", repo)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\treturn filepath.Join(d, jobID), nil\n}\n\n// HomePath is where a job's home lives.\nfunc (w *Workspace) HomePath(repo, jobID string) (string, error) {\n\td, err := w.repoDir(\"work\", repo)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\treturn filepath.Join(d, jobID+\".home\"), nil\n}\n\n// LogDir is the directory holding a job's log files.\nfunc (w *Workspace) LogDir(repo string, issue int) (string, error) {\n\tseg := \"noissue\"\n\tif issue > 0 {\n\t\tseg = strconv.Itoa(issue)\n\t}\n\td, err := w.repoDir(\"logs\", repo)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\treturn filepath.Join(d, seg), nil\n}\n\n// LogBase is the log file basename (no extension), e.g.\n// \"worker-go-dev-20261121T101500.000Z\". The close-out commit uses the same name.\nfunc LogBase(stage, role string, ts time.Time) string {\n\treturn fmt.Sprintf(\"%s-%s-%s\", stage, role, ts.UTC().Format(\"20060102T150405.000Z\"))\n}\npackage workspace\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\n\t\"github.com/albertcbrown/ard/internal/executor\"\n)\n\n// Prepare creates the worktree, writes inputs, makes the home and config dir,\n// exports the sidecar and creates the log files. It returns a host Handle\n// (Kind \"host\"); a caller that runs Docker adjusts it. On error it removes\n// everything it made.\nfunc (w *Workspace) Prepare(ctx context.Context, j executor.Job) (h executor.Handle, err error) {\n\tif err := j.Validate(); err != nil {\n\t\treturn h, err\n\t}\n\twt, err := w.WorktreePath(j.Repo, j.ID)\n\tif err != nil {\n\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, err)\n\t}\n\tif _, err := os.Lstat(wt); err == nil {\n\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, executor.ErrExists)\n\t}\n\tsha, err := w.git.RevParse(ctx, j.RepoDir, j.Ref)\n\tif err != nil {\n\t\treturn h, fmt.Errorf(\"resolve ref %q: %w: %w\", j.Ref, executor.ErrClone, err)\n\t}\n\tnow := w.now().UT