n+\tdefer e.mu.Unlock()\n+\tvar out []string\n+\tfor _, lj := range e.live {\n+\t\tif lj.token != \"\" && !lj.tokenGone {\n+\t\t\tout = append(out, lj.token)\n+\t\t}\n+\t}\n+\treturn out\n+}\n+\n+// Sweep deletes this repo's job pods and Secrets whose job keep rejects. It\n+// touches only objects labelled for Options.Repo.\n+func (e *Executor) Sweep(ctx context.Context, keep func(id string) bool) error {\n+\tsel := jobpod.LabelPartOf + \"=ard,\" + jobpod.LabelComponent + \"=\" + jobpod.ComponentJob +\n+\t\t\",\" + jobpod.LabelInstance + \"=\" + jobpod.LabelValue(e.o.Instance) + \",\" + jobpod.LabelRepo + \"=\" + jobpod.RepoLabel(e.o.Repo)\n+\tpods, err := e.o.Client.ListPods(ctx, e.o.Namespace, sel)\n+\tif err != nil {\n+\t\treturn fmt.Errorf(\"sweep: %w\", err)\n+\t}\n+\tvar errs []error\n+\tfor _, p := range pods {\n+\t\tif keep(p.Meta.Labels[jobpod.LabelJob]) {\n+\t\t\tcontinue\n+\t\t}\n+\t\terrs = append(errs, e.o.Client.DeletePod(ctx, e.o.Namespace, p.Meta.Name, 30),\n+\t\t\te.o.Client.DeleteSecret(ctx, e.o.Namespace, p.Meta.Name))\n+\t}\n+\treturn errors.Join(errs...)\n+}\ndiff --git a/internal/executor/kube/kube_test.go b/internal/executor/kube/kube_test.go\nnew file mode 100644\nindex 0000000..282ea94\n--- /dev/null\n+++ b/internal/executor/kube/kube_test.go\n@@ -0,0 +1,472 @@\n+//go:build unix\n+\n+package kube\n+\n+import (\n+\t\"context\"\n+\t\"errors\"\n+\t\"io\"\n+\t\"net/http\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"sync/atomic\"\n+\t\"testing\"\n+\t\"time\"\n+\n+\t\"github.com/albertcbrown/ard/internal/executor\"\n+\t\"github.com/albertcbrown/ard/internal/executor/kube/api\"\n+\t\"github.com/albertcbrown/ard/internal/jobpod\"\n+)\n+\n+func readFile(t *testing.T, p string) string {\n+\tt.Helper()\n+\tb, err := os.ReadFile(p)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\treturn string(b)\n+}\n+\n+func TestLifecycle(t *testing.T) {\n+\te := newEnv(t, nil)\n+\tctx := context.Background()\n+\th, err := e.ex.Prepare(ctx, testJob(\"01HAAAAAAAAAAAAAAAAAAAAAAA\"))\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif h.Kind != Kind || h.Container != jobpod.PodName(h.JobID) || h.View.Work != jobpod.MountWork || h.Image != \"agent@sha256:aa\" {\n+\t\tt.Errorf(\"handle %+v\", h)\n+\t}\n+\tif st, _ := e.ex.Status(ctx, h); st.State != executor.Prepared {\n+\t\tt.Errorf(\"before start: %+v\", st)\n+\t}\n+\tif h, err = e.ex.Start(ctx, h, testCmd()); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif want := h.StartedAt.Add(5*time.Minute + 20*time.Minute); !h.Deadline.Equal(want) {\n+\t\tt.Errorf(\"deadline %v, want %v\", h.Deadline, want)\n+\t}\n+\tif len(e.tok.minted) != 1 || len(e.tok.minted[0]) != 1 || e.tok.minted[0][0].Name != \"r\" {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/ard-home/.claude/projects/-Users-al--ard-work-albertcbrown-ard-01M89E5S36P3ZNXZ7TDP0Q8P81/2931b22a-7d6f-4d06-987b-dd069b6b76f4/tool-results/becqxcuz1.txt","persistedOutputSize":30753},"tool_result_meta":[{"id":"toolu_01CrtHKkLeNXTCKJHNDbXeqy","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
