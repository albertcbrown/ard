\t}\n+\tt.minted = append(t.minted, r)\n+\treturn github.ScopedToken{Value: \"tok-\" + string(rune('a'+len(t.minted)))}, nil\n+}\n+\n+func (t *tokens) RevokeToken(_ context.Context, v string) error {\n+\tt.mu.Lock()\n+\tdefer t.mu.Unlock()\n+\tt.revoked = append(t.revoked, v)\n+\treturn nil\n+}\n+\n+func (t *tokens) nRevoked() int {\n+\tt.mu.Lock()\n+\tdefer t.mu.Unlock()\n+\treturn len(t.revoked)\n+}\n+\n+// gitStub is a workspace.Git whose worktrees are plain directories with a .git file.\n+type gitStub struct{ pruned int }\n+\n+func (g *gitStub) RevParse(context.Context, string, string) (string, error) { return sha40, nil }\n+func (g *gitStub) WorktreeAdd(_ context.Context, _, dir, _ string) error {\n+\tif err := os.MkdirAll(dir, 0o755); err != nil {\n+\t\treturn err\n+\t}\n+\treturn os.WriteFile(filepath.Join(dir, \".git\"), []byte(\"gitdir: /repo/.git/worktrees/x\\n\"), 0o644)\n+}\n+func (g *gitStub) WorktreeRemove(_ context.Context, _, dir string, _ bool) error {\n+\treturn os.RemoveAll(dir)\n+}\n+func (g *gitStub) WorktreePrune(context.Context, string) error { g.pruned++; return nil }\n+\n+// rewrite sends every request to the test server, whatever its URL says.\n+type rewrite struct {\n+\tto   *url.URL\n+\tmu   sync.Mutex\n+\tseen []string\n+}\n+\n+func (r *rewrite) RoundTrip(q *http.Request) (*http.Response, error) {\n+\tr.mu.Lock()\n+\tr.seen = append(r.seen, q.URL.Host)\n+\tr.mu.Unlock()\n+\tq = q.Clone(q.Context())\n+\tq.URL.Scheme, q.URL.Host = r.to.Scheme, r.to.Host\n+\treturn http.DefaultTransport.RoundTrip(q)\n+}\n+\n+type env struct {\n+\tt    *testing.T\n+\tfake *fake.Fake\n+\ttok  *tokens\n+\tgit  *gitStub\n+\tws   *workspace.Workspace\n+\tex   *Executor\n+\tsrv  *httptest.Server\n+\trt   *rewrite\n+\t// started counts start calls. Each later job gets its own issue so two\n+\t// jobs prepared in the same millisecond never share a log file name\n+\t// (<stage>-<role>-<timestamp>.log, created with O_EXCL).\n+\tstarted int\n+\n+\tmu     sync.Mutex\n+\tclock  time.Time\n+\thandle http.HandlerFunc // result server behaviour\n+}\n+\n+func (e *env) now() time.Time {\n+\te.mu.Lock()\n+\tdefer e.mu.Unlock()\n+\treturn e.clock\n+}\n+\n+func (e *env) advance(d time.Duration) {\n+\te.mu.Lock()\n+\te.clock = e.clock.Add(d)\n+\te.mu.Unlock()\n+}\n+\n+func newEnv(t *testing.T, mut func(*Options)) *env {\n+\tt.Helper()\n+\te := &env{t: t, fake: fake.New(), tok: &tokens{}, git: &gitStub{}, clock: time.Date(2026, 11, 25, 12, 0, 0, 0, time.UTC)}\n+\te.srv = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n+\t\te.mu.Lock()\n+\t\th := e.handle\n+\t\te.mu.Unlock()\n+\t\tif h == nil {\n+\t\t\thttp.Error(w, \"unset\", 500)\n+\t\t\treturn\n+\t\t}\n+\t\th(w, r)\n+\t}))\n+\tt.Cleanup(e.srv.Close)\n+\tu, _ := url.Parse(e.srv.URL)\n+\te.rt = &rewrite{to: u}\n+\tws, err := workspace.New(workspace.Options{Root: t.TempDir(), Git: e.git})\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\te.ws = ws\n+\to := Options{Client: e.fake, Tokens: e.tok, WS: ws, Namespace: ns, Repo: \"o/r\", Instance: \"ard-test\",\n+\t\tAgentImage: \"agent@sha256:aa\", PodImage: \"ard@sha256:bb\",\n+\t\tPolicy:       executor.EnvPolicy{AllowEnv: map[string]bool{envName: true}, AllowFixed: map[string]bool{\"CLAUDE_CONFIG_DIR\": true}},\n+\t\tConfigDirEnv: \"CLAUDE_CONFIG_DIR\",\n+\t\tHTTP:         &http.Client{Transport: e.rt, Timeout: 5 * time.Second},\n+\t\tNow:          e.now, Log: slog.New(slog.NewTextHandler(io.Discard, nil)), Poll: 5 * time.Millisecond, PendingTimeout: time.Minute}\n+\tif mut != nil {\n+\t\tmut(&o)\n+\t}\n+\tif e.ex, err = New(o); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tt.Cleanup(func() { // stop watchers before the temp dir goes\n+\t\te.ex.mu.Lock()\n+\t\tvar all []*liveJob\n+\t\tfor _, lj := range e.ex.live {\n+\t\t\tall = append(all, lj)\n+\t\t}\n+\t\te.ex.mu.Unlock()\n+\t\tfor _, lj := range all {\n+\t\t\tif lj.stop != nil {\n+\t\t\t\tlj.stop()\n+\t\t\t}\n+\t\t\tlj.wg.Wait()\n+\t\t}\n+\t})\n+\treturn e\n+}\n+\n+func testJob(id string) executor.Job {\n+\treturn executor.Job{ID: id, Repo: \"o/r\", Issue: 7, Stage: \"worker\", Role: \"dev\", RepoDir: \"/repo\", Ref: \"HEAD\",\n+\t\tRoleDir: \"/role\", Timeout: 20 * time.Minute, RoleSource: executor.RoleSource{SHA: sha40, Path: \".ard/roles/dev\"},\n+\t\tInputs: []executor.File{{Path: \".ard/7/issue.md\", Data: []byte(\"hi\")}}}\n+}\n+\n+func testCmd() executor.Command {\n+\treturn executor.Command{Path: \"claude\", Args: []string{\"-p\"}, Env: []string{envName + \"=sk-secret\"},\n+\t\tFixed: []string{\"CLAUDE_CONFIG_DIR=\" + jobpod.AgentConfig}}\n+}\n+\n+func (e *env) start(id string) executor.Handle {\n+\te.t.Helper()\n+\tctx := context.Background()\n+\tj := testJob(id)\n+\tif e.started > 0 {\n+\t\tj.Issue += e.started\n+\t\tj.Inputs = []executor.File{{Path: fmt.Sprintf(\".ard/%d/issue.md\", j.Issue), Data: []byte(\"hi\")}}\n+\t}\n+\te.started++\n+\th, err := e.ex.Prepare(ctx, j)\n+\tif err != nil {\n+\t\te.t.Fatal(err)\n+\t}\n+\tif h, err = e.ex.Start(ctx, h, testCmd()); err != nil {\n+\t\te.t.Fatal(err)\n+\t}\n+\treturn h\n+}\n+\n+func (e *env) key(h executor.Handle) string {\n+\ts, ok := e.fake.Secret(ns, jobpod.PodName(h.JobID))\n+\tif !ok {\n+\t\te.t.Fatal(\"no secret\")\n+\t}\n+\treturn string(s.Data[jobpod.ItemResultKey])\n+}\n+\n+func (e *env) preDone(h executor.Handle, code int32, msg string) {\n+\terr := e.fake.SetInitContainer(ns, jobpod.PodName(h.JobID), \"pre\",\n+\t\tapi.ContainerState{Terminated: &api.StateTerminated{ExitCode: code, Message: msg}})\n+\tif err != nil {\n+\t\te.t.Fatal(err)\n+\t}\n+}\n+\n+func (e *env) agentDone(h executor.Handle, code, sig int32) {\n+\tn := jobpod.PodName(h.JobID)\n+\te.fake.SetPodIP(ns, n, podIP)\n+\terr := e.fake.SetContainer(ns, n, \"agent\", api.ContainerState{Terminated: &api.StateTerminated{\n+\t\tExitCode: code, Signal: sig, FinishedAt: e.now()}})\n+\tif err != nil {\n+\t\te.t.Fatal(err)\n+\t}\n+}\n+\n+func (e *env) serve(h http.HandlerFunc) {\n+\te.mu.Lock()\n+\te.handle = h\n+\te.mu.Unlock()\n+}\n+\n+// waitTerminal polls Status until the state is terminal.\n+func (e *env) waitTerminal(h executor.Handle) executor.Status {\n+\te.t.Helper()\n+\tctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)\n+\tdefer cancel()\n+\tst, err := executor.WaitFor(ctx, e.ex, h, 5*time.Millisecond)\n+\tif err != nil {\n+\t\te.t.Fatalf(\"wait: %v (last %+v)\", err, st)\n+\t}\n+\treturn st\n+}\n+\n+func tarGz(t *testing.T, files map[string]string) []byte {\n+\tt.Helper()\n+\tvar b bytes.Buffer\n+\tgz := gzip.NewWriter(&b)\n+\ttw := tar.NewWriter(gz)\n+\tfor name, data := range files {\n+\t\tif err := tw.WriteHeader(&tar.Header{Name: name, Mode: 0o644, Size: int64(len(data)), Typeflag: tar.TypeReg}); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tio.WriteString(tw, data)\n+\t}\n+\ttw.Close()\n+\tgz.Close()\n+\treturn b.Bytes()\n+}\n+\n+func okResult(t *testing.T) []byte {\n+\treturn tarGz(t, map[string]string{\"work/out.txt\": \"result\", \"out/stdout\": \"agent said hi\\n\"})\n+}\ndiff --git a/internal/executor/kube/kube.go b/internal/executor/kube/kube.go\nnew file mode 100644\nindex 0000000..0bb5534\n--- /dev/null\n+++ b/internal/executor/kube/kube.go\n@@ -0,0 +1,419 @@\n+// Package kube is the Kubernetes executor: it runs one agent job as a pod\n+// (init container pre, agent, result server post), watches it through the API,\n+// pulls the result back and removes everything again. The pod side is\n+// internal/jobpod's contract; the API is the minimal client in api/.\n+package kube\n+\n+import (\n+\t\"context\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"io\"\n+\t\"log/slog\"\n+\t\"net/http\"\n+\t\"os\"\n+\t\"strings\"\n+\t\"sync\"\n+\t\"sync/atomic\"\n+\t\"time\"\n+\n+\t\"github.com/albertcbrown/ard/internal/executor\"\n+\t\"github.com/albertcbrown/ard/internal/executor/kube/api\"\n+\t\"github.com/albertcbrown/ard/internal/executor/workspace\"\n+\t\"github.com/albertcbrown/ard/internal/github\"\n+\t\"github.com/albertcbrown/ard/internal/jobpod\"\n+\t\"github.com/albertcbrown/ard/internal/tarball\"\n+)\n+\n+// Kind is the Handle.Kind of a job this executor runs.\n+const Kind = \"k8s\"\n+\n+// Tokens mints and revokes the read token the pre container clones with.\n+type Tokens interface {\n+\tMintReadToken(ctx context.Context, repos []github.Repo) (github.ScopedToken, error)\n+\tRevokeToken(ctx context.Context, token string) error\n+}\n+\n+// Options configures an Executor.\n+type Options struct {\n+\tClient                 api.Client\n+\tTokens                 Tokens\n+\tWS                     *workspace.Workspace\n+\tNamespace              string\n+\tInstance               string // app.kubernetes.io/instance label value\n+\tRepo                   string // owner/name this executor serves; Sweep selects on it\n+\tAgentImage, PodImage   string\n+\tGitBase                string // default https://github.com\n+\tResources              Resources\n+\tLimits                 tarball.Limits\n+\tPreBudget, ResultGrace time.Duration // defaults 5m and 2m\n+\tPolicy                 executor.EnvPolicy\n+\tConfigDirEnv           string // env name whose Fixed value must be the pod config dir\n+\tHTTP                   *http.Client\n+\tNow                    func() time.Time\n+\tLog                    *slog.Logger\n+\n+\t// Poll is the watcher interval (default 2s); PendingTimeout is how long a\n+\t// pod may stay unscheduled (default 5m). Tests shorten both.\n+\tPoll, PendingTimeout time.Duration\n+}\n+\n+type liveJob struct {\n+\tmanifest []byte\n+\trepo     string // owner/name of the job's repository\n+\tstarted  bool\n+\tuid      string\n+\tkey      string // result key, in memory only\n+\tstop     context.CancelFunc\n+\twg       sync.WaitGroup // the watcher and the log follower\n+\t// agentEnded is set once the agent container is seen terminated or the\n+\t// job is finished; the log follower drains once more after it.\n+\tagentEnded atomic.Bool\n+\ttoken      string\n+\ttokenGone  bool\n+}\n+\n+// Executor implements executor.Executor on Kubernetes.\n+type Executor struct {\n+\to    Options\n+\tmu   sync.Mutex\n+\tlive map[string]*liveJob\n+}\n+\n+var _ executor.Executor = (*Executor)(nil)\n+\n+// New validates o and applies defaults.\n+func New(o Options) (*Executor, error) {\n+\tswitch {\n+\tcase o.Client == nil, o.Tokens == nil, o.WS == nil:\n+\t\treturn nil, errors.New(\"kube: Client, Tokens and WS are required\")\n+\tcase o.Namespace == \"\", o.Repo == \"\", o.AgentImage == \"\", o.PodImage == \"\", o.Instance == \"\":\n+\t\treturn nil, errors.New(\"kube: Namespace, Repo, Instance, AgentImage and PodImage are required\")\n+\t}\n+\tif o.GitBase == \"\" {\n+\t\to.GitBase = \"https://github.com\"\n+\t}\n+\tif o.PreBudget <= 0 {\n+\t\to.PreBudget = 5 * time.Minute\n+\t}\n+\tif o.ResultGrace <= 0 {\n+\t\to.ResultGrace = 2 * time.Minute\n+\t}\n+\tif o.Poll <= 0 {\n+\t\to.Poll = 2 * time.Second\n+\t}\n+\tif o.PendingTimeout <= 0 {\n+\t\to.PendingTimeout = 5 * time.Minute\n+\t}\n+\tif o.Limits == (tarball.Limits{}) {\n+\t\to.Limits = tarball.DefaultLimits()\n+\t}\n+\tif o.Resources.Work == 0 {\n+\t\to.Resources = DefaultResources()\n+\t}\n+\tif o.HTTP == nil {\n+\t\to.HTTP = &http.Client{Timeout: 10 * time.Minute}\n+\t}\n+\tif o.Now == nil {\n+\t\to.Now = time.Now\n+\t}\n+\tif o.Log == nil {\n+\t\to.Log = slog.Default()\n+\t}\n+\treturn &Executor{o: o, live: map[string]*liveJob{}}, nil\n+}\n+\n+func (e *Executor) get(id string) *liveJob {\n+\te.mu.Lock()\n+\tdefer e.mu.Unlock()\n+\treturn e.live[id]\n+}\n+\n+// Prepare lays out the worktree and encodes the manifest. It starts nothing.\n+func (e *Executor) Prepare(ctx context.Context, j executor.Job) (executor.Handle, error) {\n+\tif len(j.ID) > jobpod.MaxJobID {\n+\t\treturn executor.Handle{}, fmt.Errorf(\"%w: id %q is too long for a pod name\", executor.ErrInvalidJob, j.ID)\n+\t}\n+\tif j.RoleSource.SHA == \"\" || j.RoleSource.Path == \"\" {\n+\t\treturn executor.Handle{}, fmt.Errorf(\"%w: no role source (a config without a commit cannot run on Kubernetes)\", executor.ErrInvalidJob)\n+\t}\n+\th, err := e.o.WS.Prepare(ctx, j)\n+\tif err != nil {\n+\t\treturn executor.Handle{}, err\n+\t}\n+\tif j.Dockerfile != \"\" {\n+\t\te.o.Log.Info(\"kube.dockerfile_ignored\", \"job\", j.ID, \"dockerfile\", j.Dockerfile)\n+\t}\n+\th.Kind, h.Container, h.Image = Kind, jobpod.PodName(j.ID), e.o.AgentImage\n+\th.View = jobpod.AgentPaths()\n+\tif h.SidecarDir == \"\" {\n+\t\th.View.Sidecar = \"\"\n+\t}\n+\tif h.HistoryDir == \"\" {\n+\t\th.View.History = \"\"\n+\t}\n+\tm := jobpod.Manifest{V: jobpod.ManifestVersion, Repo: j.Repo, BaseSHA: h.BaseSHA,\n+\t\tHistory: j.History, ReadOnly: j.ReadOnly,\n+\t\tRole:  jobpod.Source{Repo: j.Repo, SHA: j.RoleSource.SHA, Path: j.RoleSource.Path},\n+\t\tScrub: j.Scrub, Inputs: j.Inputs}\n+\tif h.SidecarDir != \"\" {\n+\t\tm.Sidecar = &jobpod.Source{Repo: h.Sidecar.Repo, SHA: h.SidecarSHA}\n+\t}\n+\tb, err := jobpod.Encode(m)\n+\tif err != nil {\n+\t\te.o.WS.Discard(context.WithoutCancel(ctx), h)\n+\t\tif errors.Is(err, jobpod.ErrTooLarge) {\n+\t\t\treturn executor.Handle{}, fmt.Errorf(\"%w: %w\", executor.ErrInputsTooLarge, err)\n+\t\t}\n+\t\treturn executor.Handle{}, fmt.Errorf(\"%w: %w\", executor.ErrInvalidJob, err)\n+\t}\n+\te.mu.Lock()\n+\te.live[j.ID] = &liveJob{manifest: b, repo: j.Repo}\n+\te.mu.Unlock()\n+\treturn h, nil\n+}\n+\n+// Start creates the pod and its Secret and starts the watcher and the log\n+// follower. ctx bounds only the API calls.\n+func (e *Executor) Start(ctx context.Context, h executor.Handle, c executor.Command) (executor.Handle, error) {\n+\tif h.Kind != Kind {\n+\t\treturn h, fmt.Errorf(\"%w: handle kind %q\", executor.ErrInvalidJob, h.Kind)\n+\t}\n+\tif c.Stdin != nil {\n+\t\treturn h, fmt.Errorf(\"%w: stdin is not supported on Kubernetes\", executor.ErrInvalidJob)\n+\t}\n+\tif err := e.o.Policy.CheckEnv(c.Env); err != nil {\n+\t\treturn h, err\n+\t}\n+\tif err := e.o.Policy.CheckFixed(c.Fixed); err != nil {\n+\t\treturn h, err\n+\t}\n+\tfor _, kv := range c.Fixed {\n+\t\tif n, v, _ := strings.Cut(kv, \"=\"); e.o.ConfigDirEnv != \"\" && n == e.o.ConfigDirEnv && v != jobpod.AgentConfig {\n+\t\t\treturn h, fmt.Errorf(\"%w: %s must be %s\", executor.ErrForbiddenEnv, n, jobpod.AgentConfig)\n+\t\t}\n+\t}\n+\te.mu.Lock()\n+\tlj := e.live[h.JobID]\n+\tif lj != nil && lj.started {\n+\t\te.mu.Unlock()\n+\t\treturn h, executor.ErrAlreadyStarted\n+\t}\n+\te.mu.Unlock()\n+\tif lj == nil {\n+\t\treturn h, executor.ErrNotPrepared\n+\t}\n+\tnow := e.o.Now().UTC()\n+\th.StartedAt = now\n+\th.Deadline = now.Add(e.o.PreBudget + h.Timeout)\n+\n+\trepos, err := githubRepos(lj.repo, h)\n+\tif err != nil {\n+\t\treturn h, err\n+\t}\n+\ttok, err := e.o.Tokens.MintReadToken(ctx, repos)\n+\tif err != nil {\n+\t\treturn h, fmt.Errorf(\"mint read token: %w\", err)\n+\t}\n+\trevoke := func() { e.o.Tokens.RevokeToken(context.WithoutCancel(ctx), tok.Value) }\n+\tkey, err := jobpod.NewKey()\n+\tif err != nil {\n+\t\trevoke()\n+\t\treturn h, err\n+\t}\n+\tpod := buildPod(h, c, e.o)\n+\tcreated, err := e.o.Client.CreatePod(ctx, e.o.Namespace, pod)\n+\tif err != nil {\n+\t\trevoke()\n+\t\treturn h, fmt.Errorf(\"create pod: %w\", err)\n+\t}\n+\tsec, err := buildSecret(h, c, lj.manifest, tok.Value, key, created.Meta.UID)\n+\tif err == nil {\n+\t\terr = e.o.Client.CreateSecret(ctx, e.o.Namespace, sec)\n+\t}\n+\tif err != nil {\n+\t\te.o.Client.DeletePod(context.WithoutCancel(ctx), e.o.Namespace, pod.Meta.Name, 0)\n+\t\trevoke()\n+\t\treturn h, fmt.Errorf(\"create secret: %w\", err)\n+\t}\n+\twctx, stop := context.WithCancel(context.Background())\n+\te.mu.Lock()\n+\tlj.started, lj.uid, lj.key, lj.token, lj.stop = true, created.Meta.UID, key, tok.Value, stop\n+\tlj.wg.Add(2)\n+\te.mu.Unlock()\n+\tgo func() {\n+\t\tdefer lj.wg.Done()\n+\t\te.watch(wctx, h, lj)\n+\t}()\n+\tgo func() {\n+\t\tdefer lj.wg.Done()\n+\t\te.followLogs(wctx, h, lj)\n+\t}()\n+\treturn h, nil\n+}\n+\n+func githubRepos(repo string, h executor.Handle) ([]github.Repo, error) {\n+\tvar out []github.Repo\n+\tfor _, r := range []string{repo, h.Sidecar.Repo} {\n+\t\tif r == \"\" {\n+\t\t\tcontinue\n+\t\t}\n+\t\to, n, ok := strings.Cut(r, \"/\")\n+\t\tif !ok {\n+\t\t\treturn nil, fmt.Errorf(\"%w: repo %q\", executor.ErrInvalidJob, r)\n+\t\t}\n+\t\tout = append(out, github.Repo{Owner: o, Name: n})\n+\t}\n+\treturn out, nil\n+}\n+\n+// Status reports the job's state from the controller's files and the pod.\n+func (e *Executor) Status(ctx context.Context, h executor.Handle) (executor.Status, error) {\n+\to := obs{now: e.o.Now()}\n+\tif h.Kind == Kind && !h.StartedAt.IsZero() {\n+\t\td, err := readDone(h)\n+\t\tif err != nil {\n+\t\t\treturn executor.Status{}, err\n+\t\t}\n+\t\to.done = d\n+\t\tif d == nil {\n+\t\t\to.pod, o.podErr = e.o.Client.GetPod(ctx, e.o.Namespace, jobpod.PodName(h.JobID))\n+\t\t}\n+\t}\n+\tif lj := e.get(h.JobID); lj != nil {\n+\t\te.mu.Lock()\n+\t\to.held = lj.started\n+\t\te.mu.Unlock()\n+\t\tif o.held && errors.Is(o.podErr, api.ErrNotFound) {\n+\t\t\t// The watcher sees the same and writes the marker with the real\n+\t\t\t// reason within one poll; do not report Gone before it has.\n+\t\t\to.podErr = nil\n+\t\t}\n+\t}\n+\tif _, err := os.Stat(h.Worktree); err == nil {\n+\t\to.wtExists = true\n+\t}\n+\tif st, err := os.Stat(h.LogPath); err == nil {\n+\t\to.lastOut = st.ModTime()\n+\t}\n+\treturn mapStatus(h, o), nil\n+}\n+\n+// Logs reads the local log files, which the follower and the result pull fill.\n+func (e *Executor) Logs(ctx context.Context, h executor.Handle, o executor.LogsOptions) (io.ReadCloser, error) {\n+\tp := h.LogPath\n+\tif o.Stream == executor.Stdout {\n+\t\tp = h.StdoutPath\n+\t}\n+\tb, err := os.ReadFile(p)\n+\tif err != nil {\n+\t\treturn nil, fmt.Errorf(\"open log: %w\", err)\n+\t}\n+\tif o.TailLines > 0 {\n+\t\tlines := strings.SplitAfter(string(b), \"\\n\")\n+\t\tif len(lines) > 0 && lines[len(lines)-1] == \"\" {\n+\t\t\tlines = lines[:len(lines)-1]\n+\t\t}\n+\t\tif len(