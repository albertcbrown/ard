gh the API,\n427\t+// pulls the result back and removes everything again. The pod side is\n428\t+// internal/jobpod's contract; the API is the minimal client in api/.\n429\t+package kube\n430\t+\n431\t+import (\n432\t+\t\"context\"\n433\t+\t\"errors\"\n434\t+\t\"fmt\"\n435\t+\t\"io\"\n436\t+\t\"log/slog\"\n437\t+\t\"net/http\"\n438\t+\t\"os\"\n439\t+\t\"strings\"\n440\t+\t\"sync\"\n441\t+\t\"sync/atomic\"\n442\t+\t\"time\"\n443\t+\n444\t+\t\"github.com/albertcbrown/ard/internal/executor\"\n445\t+\t\"github.com/albertcbrown/ard/internal/executor/kube/api\"\n446\t+\t\"github.com/albertcbrown/ard/internal/executor/workspace\"\n447\t+\t\"github.com/albertcbrown/ard/internal/github\"\n448\t+\t\"github.com/albertcbrown/ard/internal/jobpod\"\n449\t+\t\"github.com/albertcbrown/ard/internal/tarball\"\n450\t+)\n451\t+\n452\t+// Kind is the Handle.Kind of a job this executor runs.\n453\t+const Kind = \"k8s\"\n454\t+\n455\t+// Tokens mints and revokes the read token the pre container clones with.\n456\t+type Tokens interface {\n457\t+\tMintReadToken(ctx context.Context, repos []github.Repo) (github.ScopedToken, error)\n458\t+\tRevokeToken(ctx context.Context, token string) error\n459\t+}\n460\t+\n461\t+// Options configures an Executor.\n462\t+type Options struct {\n463\t+\tClient                 api.Client\n464\t+\tTokens                 Tokens\n465\t+\tWS                     *workspace.Workspace\n466\t+\tNamespace              string\n467\t+\tInstance               string // app.kubernetes.io/instance label value\n468\t+\tRepo                   string // owner/name this executor serves; Sweep selects on it\n469\t+\tAgentImage, PodImage   string\n470\t+\tGitBase                string // default https://github.com\n471\t+\tResources              Resources\n472\t+\tLimits                 tarball.Limits\n473\t+\tPreBudget, ResultGrace time.Duration // defaults 5m and 2m\n474\t+\tPolicy                 executor.EnvPolicy\n475\t+\tConfigDirEnv           string // env name whose Fixed value must be the pod config dir\n476\t+\tHTTP                   *http.Client\n477\t+\tNow                    func() time.Time\n478\t+\tLog                    *slog.Logger\n479\t+\n480\t+\t// Poll is the watcher interval (default 2s); PendingTimeout is how long a\n481\t+\t// pod may stay unscheduled (default 5m). Tests shorten both.\n482\t+\tPoll, PendingTimeout time.Duration\n483\t+}\n484\t+\n485\t+type liveJob struct {\n486\t+\tmanifest []byte\n487\t+\trepo     string // owner/name of the job's repository\n488\t+\tstarted  bool\n489\t+\tuid      string\n490\t+\tkey      string // result key, in memory only\n491\t+\tstop     context.CancelFunc\n492\t+\twg       sync.WaitGroup // the watcher and the log follower\n493\t+\t// agentEnded is set once the agent container is seen terminated or the\n494\t+\t// job is finished; the log follower drains once more after it.\n495\t+\tagentEnded atomic.Bool\n496\t+\ttoken      string\n497\t+\ttokenGone  bool\n498\t+}\n499\t+\n500\t+// Executor implements executor.Executor on Kubernetes.\n501\t+type Executor struct {\n502\t+\to    Options\n503\t+\tmu   sync.Mutex\n504\t+\tlive map[string]*liveJob\n505\t+}\n506\t+\n507\t+var _ executor.Executor = (*Executor)(nil)\n508\t+\n509\t+// New validates o and applies defaults.\n510\t+func New(o Options) (*Executor, error) {\n511\t+\tswitch {\n512\t+\tcase o.Client == nil, o.Tokens == nil, o.WS == nil:\n513\t+\t\treturn nil, errors.New(\"kube: Client, Tokens and WS are required\")\n514\t+\tcase o.Namespace == \"\", o.Repo == \"\", o.AgentImage == \"\", o.PodImage == \"\", o.Instance == \"\":\n515\t+\t\treturn nil, errors.New(\"kube: Namespace, Repo, Instance, AgentImage and PodImage are required\")\n516\t+\t}\n517\t+\tif o.GitBase == \"\" {\n518\t+\t\to.GitBase = \"https://github.com\"\n519\t+\t}\n520\t+\tif o.PreBudget <= 0 {\n521\t+\t\to.PreBudget = 5 * time.Minute\n522\t+\t}\n523\t+\tif o.ResultGrace <= 0 {\n524\t+\t\to.ResultGrace = 2 * time.Minute\n525\t+\t}\n526\t+\tif o.Poll <= 0 {\n527\t+\t\to.Poll = 2 * time.Second\n528\t+\t}\n529\t+\tif o.PendingTimeout <= 0 {\n530\t+\t\to.PendingTimeout = 5 * time.Minute\n531\t+\t}\n532\t+\tif o.Limits == (tarball.Limits{}) {\n533\t+\t\to.Limits = tarball.DefaultLimits()\n534\t+\t}\n535\t+\tif o.Resources.Work == 0 {\n536\t+\t\to.Resources = DefaultResources()\n537\t+\t}\n538\t+\tif o.HTTP == nil {\n539\t+\t\to.HTTP = &http.Client{Timeout: 10 * time.Minute}\n540\t+\t}\n541\t+\tif o.Now == nil {\n542\t+\t\to.Now = time.Now\n543\t+\t}\n544\t+\tif o.Log == nil {\n545\t+\t\to.Log = slog.Default()\n546\t+\t}\n547\t+\treturn &Executor{o: o, live: map[string]*liveJob{}}, nil\n548\t+}\n549\t+\n550\t+func (e *Executor) get(id string) *liveJob {\n551\t+\te.mu.Lock()\n552\t+\tdefer e.mu.Unlock()\n553\t+\treturn e.live[id]\n554\t+}\n555\t+\n556\t+// Prepare lays out the worktree and encodes the manifest. It starts nothing.\n557\t+func (e *Executor) Prepare(ctx context.Context, j executor.Job) (executor.Handle, error) {\n558\t+\tif len(j.ID) > jobpod.MaxJobID {\n559\t+\t\treturn executor.Handle{}, fmt.Errorf(\"%w: id %q is too long for a pod name\", executor.ErrInvalidJob, j.ID)\n560\t+\t}\n561\t+\tif j.RoleSource.SHA == \"\" || j.RoleSource.Path == \"\" {\n562\t+\t\treturn executor.Handle{}, fmt.Errorf(\"%w: no role source (a config without a commit cannot run on Kubernetes)\", executor.ErrInvalidJob)\n563\t+\t}\n564\t+\th, err := e.o.WS.Prepare(ctx, j)\n565\t+\tif err != nil {\n566\t+\t\treturn executor.Handle{}, err\n567\t+\t}\n568\t+\tif j.Dockerfile != \"\" {\n569\t+\t\te.o.Log.Info(\"kube.dockerfile_ignored\", \"job\", j.ID, \"dockerfile\", j.Dockerfile)\n570\t+\t}\n571\t+\th.Kind, h.Container, h.Image = Kind, jobpod.PodName(j.ID), e.o.AgentImage\n572\t+\th.View = jobpod.AgentPaths()\n573\t+\tif h.SidecarDir == \"\" {\n574\t+\t\th.View.Sidecar = \"\"\n575\t+\t}\n576\t+\tif h.HistoryDir == \"\" {\n577\t+\t\th.View.History = \"\"\n578\t+\t}\n579\t+\tm := jobpod.Manifest{V: jobpod.ManifestVersion, Repo: j.Repo, BaseSHA: h.BaseSHA,\n580\t+\t\tHistory: j.History, ReadOnly: j.ReadOnly,\n581\t+\t\tRole:  jobpod.Source{Repo: j.Repo, SHA: j.RoleSource.SHA, Path: j.RoleSource.Path},\n582\t+\t\tScrub: j.Scrub, Inputs: j.Inputs}\n583\t+\tif h.SidecarDir != \"\" {\n584\t+\t\tm.Sidecar = &jobpod.Source{Repo: h.Sidecar.Repo, SHA: h.SidecarSHA}\n585\t+\t}\n586\t+\tb, err := jobpod.Encode(m)\n587\t+\tif err != nil {\n588\t+\t\te.o.WS.Discard(context.WithoutCancel(ctx), h)\n589\t+\t\tif errors.Is(err, jobpod.ErrTooLarge) {\n590\t+\t\t\treturn executor.Handle{}, fmt.Errorf(\"%w: %w\", executor.ErrInputsTooLarge, err)\n591\t+\t\t}\n592\t+\t\treturn executor.Handle{}, fmt.Errorf(\"%w: %w\", executor.ErrInvalidJob, err)\n593\t+\t}\n594\t+\te.mu.Lock()\n595\t+\te.live[j.ID] = &liveJob{manifest: b, repo: j.Repo}\n596\t+\te.mu.Unlock()\n597\t+\treturn h, nil\n598\t+}\n599\t+\n600\t+// Start creates the pod and its Secret and starts the watcher and the log\n601\t+// follower. ctx bounds only the API calls.\n602\t+func (e *Executor) Start(ctx context.Context, h executor.Handle, c executor.Command) (executor.Handle, error) {\n603\t+\tif h.Kind != Kind {\n604\t+\t\treturn h, fmt.Errorf(\"%w: handle kind %q\", executor.ErrInvalidJob, h.Kind)\n605\t+\t}\n606\t+\tif c.Stdin != nil {\n607\t+\t\treturn h, fmt.Errorf(\"%w: stdin is not supported on Kubernetes\", executor.ErrInvalidJob)\n608\t+\t}\n609\t+\tif err := e.o.Policy.CheckEnv(c.Env); err != nil {\n610\t+\t\treturn h, err\n611\t+\t}\n612\t+\tif err := e.o.Policy.CheckFixed(c.Fixed); err != nil {\n613\t+\t\treturn h, err\n614\t+\t}\n615\t+\tfor _, kv := range c.Fixed {\n616\t+\t\tif n, v, _ := strings.Cut(kv, \"=\"); e.o.ConfigDirEnv != \"\" && n == e.o.ConfigDirEnv && v != jobpod.AgentConfig {\n617\t+\t\t\treturn h, fmt.Errorf(\"%w: %s must be %s\", executor.ErrForbiddenEnv, n, jobpod.AgentConfig)\n618\t+\t\t}\n619\t+\t}\n620\t+\te.mu.Lock()\n621\t+\tlj := e.live[h.JobID]\n622\t+\tif lj != nil && lj.started {\n623\t+\t\te.mu.Unlock()\n624\t+\t\tret