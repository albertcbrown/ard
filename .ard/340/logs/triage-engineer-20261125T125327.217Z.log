{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TPrtfFMaUzB85pLWzCY3TT","type":"tool_result","content":"// Package jobpod is the single contract between the controller and a job pod\n// of the Kubernetes executor: paths, Secret items, the input manifest, the\n// result route and key helpers. The executor (#317) and the pod side (#316)\n// both import it and never each other. It imports only executor and gitref.\npackage jobpod\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/executor\"\n)\n\n// Containers.\nconst (\n\tContainerPre   = \"pre\"\n\tContainerAgent = \"agent\"\n\tContainerPost  = \"post\"\n)\n\n// Users and groups.\nconst (\n\tAgentUID   = 65532\n\tSidecarUID = 65533 // pre and post\n\tGID        = 65532 // fsGroup\n)\n\n// Volume mount paths.\nconst (\n\tMountWork   = \"/work\"    // tree without .git: pre rw, agent rw or ro, post ro\n\tMountJob    = \"/job\"     // pre and agent\n\tMountOut    = \"/out\"     // agent rw, post ro\n\tMountCtl    = \"/ctl\"     // pre only: git dirs and pre's HOME\n\tMountBin    = \"/ard-bin\" // pre rw, agent ro\n\tMountTmp    = \"/tmp\"     // agent only\n\tAgentBin    = \"/ard-bin/ard\"\n\tJobHome     = \"/job/home\"\n\tJobRole     = \"/job/role\"\n\tJobSidecar  = \"/job/sidecar\"\n\tJobHistory  = \"/job/history\"\n\tAgentConfig = \"/job/home/.claude\"\n)\n\n// Volume names.\nconst (\n\tVolWork = \"work\"\n\tVolJob  = \"job\"\n\tVolOut  = \"out\"\n\tVolCtl  = \"ctl\"\n\tVolBin  = \"ard-bin\"\n\tVolTmp  = \"tmp\"\n)\n\n// AgentPaths is the agent's view of the job, as executor.Paths.\nfunc AgentPaths() executor.Paths {\n\treturn executor.Paths{\n\t\tWork:      MountWork,\n\t\tRole:      JobRole,\n\t\tSidecar:   JobSidecar,\n\t\tConfigDir: AgentConfig,\n\t\tHistory:   JobHistory,\n\t}\n}\n\n// Agent environment.\nconst (\n\tAgentHome   = JobHome\n\tAgentTmpdir = \"/tmp\"\n)\n\n// Per-job Secret items. The model credential is stored under its env name.\nconst (\n\tItemManifest  = \"manifest.json\"\n\tItemGitAccess = \"token\"      // pre only\n\tItemResultKey = \"result-key\" // post only\n\tPreSecretDir  = \"/var/run/ard/pre\"\n\tPostSecretDir = \"/var/run/ard/post\"\n\tSecretMode    = 0o440\n)\n\n// ModelEnv lists the env names a model credential may have.\nvar ModelEnv = []string{\"ANTHROPIC_API_KEY\", \"CLAUDE_CODE_OAUTH_TOKEN\"}\n\n// Result route served by the post container.\nconst (\n\tResultPort     = 8080\n\tResultPortName = \"ard-result\"\n\tResultPath     = \"/v1/result\"\n\tRootWork       = \"work\"\n\tRootOut        = \"out\"\n\tStdoutName     = \"stdout\"\n\tDoneName       = \"done\" // marker in /out, never packed\n)\n\n// Pre exit codes: 3 means a retry cannot help, 1 is transient. A short reason\n// goes to /dev/termination-log.\nconst (\n\tExitPermanent = 3\n\tExitTransient = 1\n)\n\n// Labels.\nconst (\n\tlabelPrefix    = \"ard.albertcbrown/\"\n\tLabelPartOf    = \"app.kubernetes.io/part-of\"\n\tLabelComponent = \"app.kubernetes.io/component\"\n\tLabelInstance  = \"app.kubernetes.io/instance\"\n\tLabelRepo      = labelPrefix + \"repo\"\n\tLabelNetwork   = labelPrefix + \"network\"\n\tLabelJob       = labelPrefix + \"job\"\n\tLabelIssue     = labelPrefix + \"issue\"\n\tLabelStage     = labelPrefix + \"stage\"\n\tLabelRole      = labelPrefix + \"role\"\n\n\tComponentJob = \"ard-job\"\n)\n\n// Pod naming.\nconst (\n\tpodPrefix = \"ard-job-\"\n\t// MaxJobID is the longest job id whose pod name fits 63 characters.\n\tMaxJobID = 63 - len(podPrefix)\n)\n\n// PodName is the pod and Secret name of a job. ULIDs are case-insensitive;\n// names are lowercase.\nfunc PodName(id string) string { return podPrefix + strings.ToLower(id) }\n\n// RepoLabel is a label value for owner/name: 16 hex of the sha256 of the\n// lowercased repo.\nfunc RepoLabel(repo string) string {\n\tsum := sha256.Sum256([]byte(strings.ToLower(repo)))\n\treturn hex.EncodeToString(sum[:8])\n}\n\n// LabelValue returns s as a valid label value of at most 63 characters. A\n// value that does not fit is cut and given a short hash of the whole.\nfunc LabelValue(s string) string {\n\tclean := func(in string) string {\n\t\tb := []byte(in)\n\t\tfor i, c := range b {\n\t\t\tswitch {\n\t\t\tcase c >= 'a' && c <= 'z', c >= 'A' && c <= 'Z', c >= '0' && c <= '9', c == '-', c == '_', c == '.':\n\t\t\tdefault:\n\t\t\t\tb[i] = '_'\n\t\t\t}\n\t\t}\n\t\treturn strings.Trim(string(b), \"-_.\")\n\t}\n\tv := clean(s)\n\tif v == s && len(v) <= 63 {\n\t\treturn v\n\t}\n\tsum := sha256.Sum256([]byte(s))\n\th := hex.EncodeToString(sum[:4])\n\tif len(v) > 63-9 {\n\t\tv = v[:63-9]\n\t}\n\tv = strings.Trim(v, \"-_.\")\n30:type Client interface {\n31-\tCreatePod(ctx context.Context, ns string, p *Pod) (*Pod, error)\n32-\t// GetPod returns ErrNotFound when the pod does not exist.\n33-\tGetPod(ctx context.Context, ns, name string) (*Pod, error)\n34-\tListPods(ctx context.Context, ns, labelSelector string) ([]Pod, error)\n35-\t// DeletePod uses background propagation; a missing pod is not an error.\n36-\tDeletePod(ctx context.Context, ns, name string, graceSec int64) error\n37-\t// PodLogs follows the container log with timestamps. A zero sinceTime\n38-\t// starts at the beginning.\n39-\tPodLogs(ctx context.Context, ns, name, container string, sinceTime time.Time) (io.ReadCloser, error)\n40-\t// CreateSecret returns ErrConflict when the Secret exists.\n41-\tCreateSecret(ctx context.Context, ns string, s *Secret) error\n42-\t// DeleteSecret treats a missing Secret as success.\n43-\tDeleteSecret(ctx context.Context, ns, name string) error\n44-\tListEvents(ctx context.Context, ns, fieldSelector string) ([]Event, error)\n45-}\nfake.go\nfake_test.go\n9:test:\n10-\tgo test ./...\n11-\n12:lint:\n13-\tgo vet ./...\n14-\t@out=\"$$(gofmt -l .)\"; if [ -n \"$$out\" ]; then echo \"gofmt needed:\"; echo \"$$out\"; exit 1; fi\n15-\n16-fmt:\n--\n55:lint-scanner-fixtures:\n56-\tdocker build -t ard-lint-fixtures internal/roles/s