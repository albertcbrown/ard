etic issues are not on GitHub, so\n// a crash or failed save between a synthetic CreateIssue and recording its\n// rows would re-file the finding on the next run, and Gate 1 counts exactly\n// that duplicate in the ledger. Rows are adopted from the ledger's CreateIssue\n// records for this scanner that are negative, not closed later, and not\n// already in the database.\nfunc (p *Pipeline) adoptLedger(ctx context.Context, store Store, snap *Snapshot, role config.Role, now time.Time, sha string) error {\n\tli, ok := p.Effects.(ledgerIssues)\n\tif !ok {\n\t\treturn nil\n\t}\n\tissues, err := li.Issues()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"read dry-run ledger: %w\", err)\n\t}\n\tvar rows []Row\n\tfor _, is := range issues {\n\t\tif is.Closed || is.Number >= 0 || !hasLabel(is.Labels, labels.Scanner(role.Name)) {\n\t\t\tcontinue\n\t\t}\n\t\tparsed := ParseBody(is.Body)\n\t\tfor _, l := range parsed.Lines {\n\t\t\tif _, has := snap.Rows[l.Fingerprint]; has {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tr := Row{\n\t\t\t\tFingerprint: l.Fingerprint, Issue: is.Number, Status: StatusOpen, Severity: string(l.Severity),\n\t\t\t\tGroup: parsed.Group, FirstSeen: now, LastSeen: now, LastSHA: sha,\n\t\t\t}\n\t\t\tif l.Checked {\n\t\t\t\tr.Status = StatusGone\n\t\t\t}\n\t\t\trows = append(rows, r)\n\t\t}\n\t}\n\tif len(rows) == 0 {\n\t\treturn nil\n\t}\n\tp.log().Info(\"scanner.adopt_ledger\", \"scanner\", role.Name, \"rows\", len(rows))\n\treturn p.apply(ctx, store, snap, Batch{PutFindings: rows})\n}\n\n// fitItems returns how many of items can be added to a body without it\n// passing MaxBodyChars. The checklist is never trimmed, so the lines are what\n// is bounded: a group_size past what fits would make the create or update\n// fail on every run. Details are trimmed by RenderBody and are not counted.\nfunc fitItems(prevBody string, existing []Line, scanner, group string, items []Item) int {\n\tsize := len(RenderBody(prevBody, Parsed{Scanner: scanner, Group: group, Lines: existing}, nil))\n\tn := 0\n\tfor _, it := range items {\n\t\tsize += len(FormatLine(lineFor(it))) + 1\n\t\tif size > MaxBodyChars {\n\t\t\tbreak\n\t\t}\n\t\tn++\n\t}\n\treturn n\n}\npackage redact\n\nimport (\n\t\"bufio\"\n\t\"bytes\"\n\t\"context\"\n\t\"fmt\"\n\t\"io\"\n)\n\n// Finding is one scanner hit. It never carries the matched text.\ntype Finding struct {\n\tRule string // rule ID, e.g. \"github-token\"\n\tLine int    // 1-based line in the scanned stream\n\tCol  int    // 1-based byte column\n}\n\n// Scanner looks for secrets in a stream. Implementations must fail closed:\n// return an error rather than a partial verdict.\ntype Scanner interface {\n\tScan(ctx context.Context, r io.Reader) ([]Finding, error)\n}\n\nconst (\n\tscanWindow     = 1 << 20\n\tscanOverlap    = 4 << 10\n\tmaxScanReports = 10000\n)\n\ntype builtin struct{}\n\n// Builtin returns the in-repo pattern scanner. It stores at most 10000\n// findings per scan.\nfunc Builtin() Scanner { return builtin{} }\n\nfunc (builtin) Scan(ctx context.Context, r io.Reader) ([]Finding, error) {\n\tvar out []Finding\n\ttype key struct {\n\t\trule      string\n\t\tline, col int\n\t}\n\tseen := map[key]bool{}\n\temit := func(f Finding) {\n\t\tk := key{f.Rule, f.Line, f.Col}\n\t\tif !seen[k] && len(out) < maxScanReports {\n\t\t\tseen[k] = true\n\t\t\tout = append(out, f)\n\t\t}\n\t}\n\n\tbr := bufio.NewReaderSize(r, scanWindow)\n\tline, consumed, iter := 1, 0, 0\n\tvar carry []byte\n\tfor {\n\t\titer++\n\t\tif iter%1000 == 0 || carry != nil {\n\t\t\tif err := ctx.Err(); err != nil {\n\t\t\t\treturn nil, fmt.Errorf(\"scan: %w\", err)\n\t\t\t}\n\t\t}\n\t\tfrag, err := br.ReadSlice('\\n')\n\t\tif err != nil && err != bufio.ErrBufferFull && err != io.EOF {\n\t\t\treturn nil, fmt.Errorf(\"scan: read: %w\", err)\n\t\t}\n\t\tlong := err == bufio.ErrBufferFull\n\t\tdata, base := frag, consumed\n\t\tif carry != nil {\n\t\t\tdata = append(append([]byte(nil), carry...), frag...)\n\t\t\tbase = consumed - len(carry)\n\t\t}\n\t\tif len(data) > 0 {\n\t\t\tscanLine(bytes.TrimRight(data, \"\\r\\n\"), line, base, emit)\n\t\t}\n\t\tconsumed += len(frag)\n\t\tif long {\n\t\t\tfrom := len(data) - scanOverlap\n\t\t\tif from < 0 {\n\t\t\t\tfrom = 0\n\t\t\t}\n\t\t\tcarry = append([]byte(nil), data[from:]...)\n\t\t\tcontinue\n\t\t}\n\t\tcarry, consumed = nil, 0\n\t\tif err == io.EOF {\n\t\t\treturn out, nil\n\t\t}\n\t\tline++\n\t}\n}\n\nfunc scanLine(data []byte, line, base int, emit func(Finding)) {\n\tfor i := range rules {\n\t\tru := &rules[i]\n\t\tif ru.generic {\n\t\t\tif bytes.IndexByte(data, ':') < 0 && bytes.IndexByte(data, '=') < 0 {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tfor _, m := range ru.re.FindAllSubmatchIndex(data, -1) {\n\t\t\t\tv := data[m[2]:m[3]]\n\t\t\t\tif placeholder(v) || entropy(v) < entropyThreshold {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\temit(Finding{ru.id, line, base + m[0] + 1})\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\thit := false\n\t\tfor _, k := range ru.kw {\n\t\t\tif bytes.Contains(data, k) {\n\t\t\t\thit = true\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif !hit {\n\t\t\tcontinue\n\t\t}\n\t\tfor _, m := range ru.re.FindAllIndex(data, -1) {\n\t\t\temit(Finding{ru.id, line, base + m[0] + 1})\n\t\t}\n\t}\n}\npackage redact\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"time\"\n)\n\n// DefaultGitleaksTimeout bounds one gitleaks run.\nconst DefaultGitleaksTimeout = 2 * time.Minute\n\n// gitleaksLeakExit is the exit code requested for \"leaks found\", so it is\n// told apart from gitleaks' own error exit (1).\nconst gitleaksLeakExit = 2\n\n// GitleaksOptions configure the gitleaks Scanner.\ntype GitleaksOptions struct {\n\tPath    string        // binary: absolute path or a name on PATH; default \"gitleaks\"\n\tTimeout time.Duration // default DefaultGitleaksTimeout\n}\n\ntype gitleaks struct{ o GitleaksOptions }\n\n// Gitleaks returns a Scanner that runs a gitleaks binary over the scanned\n// bytes (detect --no-git). It fails closed: a missing binary, an error exit,\n// a timeout or an unreadable report is an error. Findings carry only the\n// rule, line and column, never the matched text.\n// gitleaksWaitDelay is how long Scan waits for the output pipes after the scanner was killed (exec.Cmd.WaitDelay).\nconst gitleaksWaitDelay = time.Second\n\nfunc Gitleaks(o GitleaksOptions) Scanner {\n\tif o.Path == \"\" {\n\t\to.Path = \"gitleaks\"\n\t}\n\tif o.Timeout <= 0 {\n\t\to.Timeout = DefaultGitleaksTimeout\n\t}\n\treturn gitleaks{o}\n}\n\ntype gitleaksReport struct {\n\tRuleID      string `json:\"RuleID\"`\n\tStartLine   int    `json:\"StartLine\"`\n\tStartColumn int    `json:\"StartColumn\"`\n}\n\nfunc (g gitleaks) Scan(ctx context.Context, r io.Reader) ([]Finding, error) {\n\tbin, err := exec.LookPath(g.o.Path)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"gitleaks: binary not found: %w\", err)\n\t}\n\tdir, err := os.MkdirTemp(\"\", \"ard-gitleaks-*\")\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"gitleaks: temp dir: %w\", err)\n\t}\n\tdefer os.RemoveAll(dir)\n\tif err := os.Chmod(dir, 0o700); err != nil {\n\t\treturn nil, fmt.Errorf(\"gitleaks: temp dir: %w\", err)\n\t}\n\tsrc := filepath.Join(dir, \"input.log\")\n\treport := filepath.Join(dir, \"report.json\")\n\tf, err := os.OpenFile(src, os.O_WRONLY|o","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/ard-home/.claude/projects/-Users-al--ard-work-albertcbrown-ard-01M84P6JAE3S4TBAYVEGX3SR5Y/e9bdee9d-1c29-4172-8371-73697e2dc286/tool-results/by7895rsx.txt","persistedOutputSize":33279},"tool_result_meta":[{"id":"toolu_01N48gUBBpNEzVYPJEv7fiWV","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
