, nil))\n\tn := 0\n\tfor _, it := range items {\n\t\tsize += len(FormatLine(lineFor(it))) + 1\n\t\tif size > MaxBodyChars {\n\t\t\tbreak\n\t\t}\n\t\tn++\n\t}\n\treturn n\n}\npackage redact\n\nimport (\n\t\"bufio\"\n\t\"bytes\"\n\t\"context\"\n\t\"fmt\"\n\t\"io\"\n)\n\n// Finding is one scanner hit. It never carries the matched text.\ntype Finding struct {\n\tRule string // rule ID, e.g. \"github-token\"\n\tLine int    // 1-based line in the scanned stream\n\tCol  int    // 1-based byte column\n}\n\n// Scanner looks for secrets in a stream. Implementations must fail closed:\n// return an error rather than a partial verdict.\ntype Scanner interface {\n\tScan(ctx context.Context, r io.Reader) ([]Finding, error)\n}\n\nconst (\n\tscanWindow     = 1 << 20\n\tscanOverlap    = 4 << 10\n\tmaxScanReports = 10000\n)\n\ntype builtin struct{}\n\n// Builtin returns the in-repo pattern scanner. It stores at most 10000\n// findings per scan.\nfunc Builtin() Scanner { return builtin{} }\n\n\tdefaultFindings        = 100\n)\n\n// ErrBadOptions is returned by New for inconsistent cap options.\nvar ErrBadOptions = errors.New(\"redact: bad options\")\n\n// Options tune a Redactor. Zero values select the defaults.\ntype Options struct {\n\tMaxBytes    int64   // default DefaultMaxBytes (1 MiB)\n\tHeadBytes   int64   // default DefaultHeadBytes (32 KiB)\n\tScanner     Scanner // default Builtin()\n\tMaxFindings int     // default 100; extra hits are counted, not stored\n}\n\n// Redactor is immutable after New and safe for concurrent use.\ntype Redactor struct {\n\tsecrets *Secrets\n\topts    Options\n\tchunk   int\n\topen    func(string) (io.ReadCloser, error) // test hook; default os.Open\n}\n\n// New returns a Redactor for the given known values.\nfunc New(s *Secrets, o Options) (*Redactor, error) {\n\tif s == nil {\n\t\ts = NewSecrets()\n\t}\n\tif o.MaxBytes == 0 {\n\t\to.MaxBytes = DefaultMaxBytes\n\t}\n\tif o.HeadBytes == 0 {\n\t\to.HeadBytes = DefaultHeadBytes\n\t}\n\tif o.Scanner =