on {\n\t\t\t\to.Scanner = redact.Multi(redact.Builtin(), redact.Gitleaks(gl))\n\t\t\t}\n\t\t}\n\t\treturn redact.New(s, o)\n\t}\n}\n\n// Redact configures optional extra passes of the close-out secret scan.\ntype Redact struct {\n\tGitleaks Gitleaks\n}\n\n// Gitleaks configures the optional, fail-closed gitleaks pass.\ntype Gitleaks struct {\n\tEnabled bool   // default false\n\tPath    string // default \"gitleaks\"; absolute path or a name on PATH\n}\n\n// IntakeMode says which human-filed issues may enter triage (decided, #2).\ntype IntakeMode string\n\nconst (\n\tIntakeAll   IntakeMode = \"all\"   // every human-filed issue\n\tIntakeLabel IntakeMode = \"label\" // only issues an authorised actor labelled\n)\n\n// Intake is the intake setting. Label is \"\" unless config.yaml sets it; \"\"\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// precheck applies every rule that needs no timeline, in order; the first\n// match wins.\nfunc precheck(is github.Issue, in inputs) reason {\n\tif _, ok := scannerOf(is, in.scanners); !ok || is.IsPR || is.State != github.StateOpen || !hasLabel(is, labels.Pending) {\n\t\treturn reasonNotCand\n\t}\n\tswitch {\n\tcase hasLabel(is, labels.Hold):\n\t\treturn reasonHold\n\tcase hasLabel(is, labels.NeedsHuman):\n\t\treturn reasonNeedsHuman\n\tcase running(is):\n\t\treturn reasonRunning\n\tcase is.Author != in.bot:\n\t\treturn reasonHumanAuthor\n\tcase in.now.Sub(is.CreatedAt) < in.inactiveFor:\n\t\treturn reasonTooNew\n\t}\n\treturn reasonClose\n}\ninternal/effects/live.go:84:\treturn l.done(ctx, \"AddLabels\", n, l.w.AddLabels(ctx, n, labels...), \"labels\", labels)\nboth_tools\ncve_only\nempty\nexcluded_manifests\ngv_only\nnested_module\nnot_called\nosv_only\nregen.sh\nscoped_npm\n(eval):1: no matches found: --include=*.go\n\n// applyRoleDefaults sets the per-role values that come from convention and\n// the global config before any override.\nfunc applyRoleDefaults(res *Resolved, role *Role) {\n\trole.Agent = res.Agent\n\trole.