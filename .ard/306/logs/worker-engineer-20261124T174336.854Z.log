args: [\"-dr\", \"com.apple.quarantine\", \"#{staged_path}/ard\"]\nEOF\ncat > deploy/test-release.sh <<'EOF'\n#!/usr/bin/env bash\n# Local release check (make release-check): validates .goreleaser.yaml, builds a\n# snapshot of all four targets and checks the artifacts and the generated cask.\n#   - goreleaser check; goreleaser release --snapshot --clean --skip=publish\n#   - ard binary for darwin/linux x arm64/amd64 and checksums.txt in dist/\n#   - `ard version` of the host binary prints the injected tag (dist/metadata.json)\n#   - the cask has no :no_check and only github.com/albertcbrown/ard/releases URLs\n#   - brew audit --cask runs only when brew exists; a snapshot cask is audited from\n#     a path, which brew may refuse outside a tap, so that step is a warning-free\n#     skip when brew is absent and is not run in CI.\n# Needs goreleaser v2 and python3. Exit 0 ok, 1 a check failed, 2 tooling.\nset -euo pipefail\n\nROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\ncd \"$ROOT\"\nfor t in goreleaser python3; do\n  command -v \"$t\" >/dev/null 2>&1 || { echo \"ERROR: $t is required (goreleaser: https://goreleaser.com/install/)\" >&2; exit 2; }\ndone\n# The tap token is only read when publishing; a placeholder keeps templates rendering.\nexport TAP_GITHUB_TOKEN=\"${TAP_GITHUB_TOKEN:-snapshot-placeholder}\"\n\nfail() { echo \"FAIL: $1\" >&2; exit 1; }\n\ngoreleaser check\ngoreleaser release --snapshot --clean --skip=publish\n\n[ -f dist/checksums.txt ] || fail \"dist/checksums.txt missing\"\n\npython3 -I - <<'PY' || exit 1\nimport json, sys\narts = json.load(open(\"dist/artifacts.json\"))\nhave = {(a[\"goos\"], a[\"goarch\"]) for a in arts if a.get(\"type\") == \"Binary\"}\nwant = {(o, a) for o in (\"darwin\", \"linux\") for a in (\"arm64\", \"amd64\")}\nmissing = sorted(want - have)\nif missing:\n    print(\"FAIL: missing build targets:\", missing, file=sys.stderr)\n    sys.exit(1)\nPY\n\ntag=\"$(python3 -I -c 'import json; print(json.load(open(\"dist/metadata.json\"))[\"tag\"])')\"\nos=\"$(uname -s | tr '[:upper:]' '[:lower:]')\"\narch=\"$(uname -m)\"\ncase \"$arch\" in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; esac\nbin=\"$(python3 -I - \"$os\" \"$arch\" <<'PY'\nimport json, sys\nos_, arch = sys.argv[1:3]\nfor a in json.load(open(\"dist/artifacts.json\")):\n    if a.get(\"type\") == \"Binary\" and a[\"goos\"] == os_ and a[\"goarch\"] == arch:\n        print(a[\"path\"]); break\nPY\n)\"\n[ -n \"$bin\" ] && [ -x \"$bin\" ] || fail \"no host binary for $os/$arch in dist/\"\ngot=\"$(\"$bin\" version)\"\n[ \"$got\" = \"ard $tag\" ] || fail \"ard version printed '$got', want 'ard $tag'\"\necho \"PASS: ard version = $got\"\n\ncask=dist/homebrew/Casks/ard.rb\n[ -f \"$cask\" ] || fail \"generated cask $cask missing\"\n! grep -q ':no_check' \"$cask\" || fail \"cask uses :no_check\"\nbad=\"$(grep -oE 'https?://[^\" ]+' \"$cask\" | grep -v '^https://github.com/albertcbrown/ard/releases/' | grep -v '^https://github.com/albertcbrown/ard$' || true)\"\n[ -z \"$bad\" ] || fail \"cask has URLs outside the release: $bad\"\necho \"PASS: cask has sha256 only and release URLs only\"\n\nif command -v brew >/dev/null 2>&1; then\n  brew audit --cask \"$cask\" || fail \"brew audit --cask\"\nelse\n  echo \"SKIP: brew not installed, cask not audited\"\nfi\nEOF\nchmod +x deploy/test-release.sh\npython3 - <<'EOF'\np='Makefile'\ns=open(p).read()\ns=s.replace(\"agent-image-test docs-check\",\"agent-image-test docs-check release-check\")\ns=s.replace(\"clean:\\n\",\"\"\"# Validates .goreleaser.yaml and builds a snapshot release of all four targets\n# (needs goreleaser v2 and python3; not part of `make test`).\nrelease-check:\n\tdeploy/test-release.sh\n\nclean:\n\"\"\")\nopen(p,'w').write(s)\np='docs/layout.md'\ns=open(p).read()\ns=s.replace(\"deploy/test-*.sh            chart, image and repo checks for the above (`make chart-test`, `make image-test`)\\n\",\"deploy/test-*.sh            chart, image and repo checks for the above (`make chart-test`, `make image-test`); test-release.sh is `make release-check`\\n.goreleaser.yaml            GoReleaser v2 config: four-target archives, checksums and the Homebrew cask (checked by `make release-check`)\\n\")\nopen(p,'w').write(s)\nEOF\nsed -i '' 's/a snapshot cask is audited from$/the cask is audited from/;s/#     a path, which brew may refuse outside a tap, so that step is a warning-free/#     a path, which brew may refuse outside a tap; that step is skipped when/;s/#     skip when brew is absent and is not run in CI\\./#     brew is absent and is not run in CI./' deploy/test-release.sh\nsed -n 8,12p deploy/test-release.sh; bash -n deploy/test-release.sh; make test 2>&1 | tail -5; git -c core.excludesFile=/dev/null status --porcelain --untracked-files=all"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":268,"cache_read_input_tokens":20518,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":268},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"7a342e3f-9310-4f96-a696-99f16f4986e4","uuid":"01c4e848-88b6-4881-af83-1f23f82559a5","timestamp":"2026-11-24T17:44:01.238Z","request_id":"req_011ChNAgNdXcDZhFgR6izEZx"}
