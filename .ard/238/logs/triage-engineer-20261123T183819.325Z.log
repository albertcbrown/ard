g) limitsBook(ctx context.Context) (*limits.Book, error) {\n\tw.initMu.Lock()\n\tdefer w.initMu.Unlock()\n\tif w.lim != nil {\n\t\treturn w.lim, nil\n\t}\n\tb, err := limits.Open(ctx, w.Store, time.Now, w.Log)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"serve: %w\", err)\n\t}\n\tw.lim = b\n\treturn b, nil\n}\n\n// limitedFor is the pool's Options.Limited: when a candidate may next start\n// given the usage limits recorded so far. Deterministic scanners use no model\n// and are never limited. A role missing from the config is never offered, so","is_error":false}]},"parent_tool_use_id":null,"session_id":"97eea5e6-0b48-4970-80c9-c4184e55acd8","uuid":"fdbbbb06-53d0-435a-b4b3-74b6e325ef79","timestamp":"2026-11-23T18:38:31.616Z","tool_use_result":{"stdout":"36:// Auth names which model credential the job receives. Adapters map it to\n38:type Auth string\n42:\tAuthAPIKey     Auth = \"api_key\"\n43:\tAuthOAuthToken Auth = \"oauth_token\"\n60:\tAuth         Auth     // required; AuthAPIKey or AuthOAuthToken\n227:\tif s.Auth != AuthAPIKey && s.Auth != AuthOAuthToken {\n228:\t\treturn invalid(\"Auth\", fmt.Sprintf(\"%q\", s.Auth))\nCAPTURE.md\nreal_auth_bad_token.jsonl\nreal_auth_bad_token.meta.json\nreal_auth_none.jsonl\nreal_auth_none.meta.json\nreal_budget_exceeded.jsonl\nreal_budget_exceeded.meta.json\nreal_error_max_turns.jsonl\nreal_error_max_turns.meta.json\nreal_success.jsonl\nreal_success.meta.json\nsynthetic_agent_quotes_limit.jsonl\nsynthetic_api_retry_killed.jsonl\nsynthetic_api_retry_recovered.jsonl\nsynthetic_credits_required.jsonl\nsynthetic_limit_opus_text.jsonl\nsynthetic_limit_rejected_event.jsonl\nsynthetic_limit_resets_ms.jsonl\nsynthetic_limit_warning_only.jsonl\nsynthetic_throttle_not_usage_limit.jsonl\n// lazyLimits is the Finisher's LimitRecorder. The book opens on first use (the\n// closeout-resume hook opens it at startup and fails serve on a read error), so\n// building the Finisher needs no state store.\ntype lazyLimits struct{ w *wiring }\n\nfunc (l lazyLimits) Exhaust(ctx context.Context, family string, resetsAt time.Time) (time.Time, error) {\n\tb, err := l.w.limitsBook(ctx)\n\tif err != nil {\n\t\treturn time.Time{}, err\n\t}\n\treturn b.Exhaust(ctx, family, resetsAt)\n}\n\nfunc (l lazyLimits) Succeeded(ctx context.Context, family string) error {\n\tb, err := l.w.limitsBook(ctx)\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn b.Succeeded(ctx, family)\n}\n\n// limitsBook returns the one limits book of this process, opened on first use.\n// An open error is a real store read failure (a corrupt value only logs), so\n// it is returned and not cached.\nfunc (w *wiring) limitsBook(ctx context.Context) (*limits.Book, error) {\n\tw.initMu.Lock()\n\tdefer w.initMu.Unlock()\n\tif w.lim != nil {\n\t\treturn w.lim, nil\n\t}\n\tb, err := limits.Open(ctx, w.Store, time.Now, w.Log)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"serve: %w\", err)\n\t}\n\tw.lim = b\n\treturn b, nil\n}\n\n// limitedFor is the pool's Options.Limited: when a candidate may next start\n// given the usage limits recorded so far. Deterministic scanners use no model\n// and are never limited. A role missing from the config is never offered, so","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01KP6Pgrr2TDMqp2objucSrU","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011ChLM3p5EF9kBkZYRoEvi6","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01RJeBDr1dVxhpoxHkU6U2Su","name":"Bash","input":{"command":"mkdir -p .ard/238 && cat > .ard/238/plan.md <<'EOF'\n# Plan for #238\n\n## Implementation\n\n### Steps\n1. `internal/agent/agent.go` (new type, new field): add `type Window struct { Type string; Utilization float64; Status string; ResetsAt time.Time }` (Type is the raw window name, e.g. `five_hour`, `seven_day`; `ResetsAt` UTC, zero when absent; utilization as a 0–1 or percent value exactly as the stream reports, documented on the field). Add `Windows []Window` to `Result`, with a comment that it is set whenever the stream carried readings, also with `ErrNoResult`. Reason: the adapter-neutral carrier. Builds as-is.\n2. `internal/agent/claude/parse.go`: extend `rateLimitEvent.Info` with `UnifiedWindows` as `json.RawMessage` (raw, so a malformed value never drops the event or counts a skipped line). In the `rate_limit_event` case, after `lim.rateLimitEvent(e)`, call new `readWindows(raw) []agent.Window`, accepting a JSON object keyed by window name (and tolerating an array of objects with a type field). Reuse `resetTime` for reset times. Keep the last reading per window type (later events overwrite earlier), sort by Type for determinism, and set `res.Windows` before the final `switch`, so the `ErrNoResult` return carries them. Ignore unknown fields and negative or NaN values. Do not touch `limitAcc` classification. Read only the CLI-emitted event type, never agent text.\n3. `internal/limits/readings.go` (new): `type Reading struct { Window string; Utilization float64; Status string; ResetsAt, ObservedAt time.Time }`. Add `(*Book).Observe(ctx context.Context, ws []agent.Window) error` and `(*Book).Readings() []Reading`. Observe keeps the latest reading per window under `b.mu`, stamped with `b.now()`, and persists under a new meta key `limits.readings` (a separate key from `limits.exhausted`, so the Exhaust path is untouched). On a persist error, leave memory unchanged and return the error. `Open` loads the key; a malformed value logs WARN `limits.corrupt` and starts empty. Readings returns a copy sorted by Window. An empty `ws` is a no-op. Observe logs INFO `limits.reading` (window, utilization, status, resets_at) per window. limits importing agent must not create a cycle (check with `go build`).\n4. `internal/servecmd/observe.go` (new): `func observing(next reaper.ParseFunc, book func(context.Context) (*limits.Book, error), auth agent.Auth, log *slog.Logger) reaper.ParseFunc`. Call `next`; if `auth == agent.AuthOAuthToken` and `len(res.Windows) > 0`, call `Observe`. If the book or Observe errors, log WARN `limits.observe_failed` and return the original `(res, err)` unchanged. Record on any returned err, including `ErrNoResult` (the inner closure converts it to nil already, but the wrapper must not depend on that). API-key runs record nothing.\n5. `internal/servecmd/reaping.go`: in `reaperParts` and the worker, triage and reviewer wiring where `w.parseFunc()` is called (`reaping.go:115`, `triage.go:33`, `worker.go:49`, `reviewer.go:34`), wrap it once: rename the current body to `rawParseFunc` and make `parseFunc()` return `observing(w.rawParseFunc(), w.limitsBook, w.Model.Auth, w.Log)`. This gives one call-site change, since every caller already uses `parseFunc()`. Confirm the Reaper's test-step path from #234 is not wrapped, since the test step must not be classified or recorded. Check how the worker test step parses.\n6. `docs/proposal.md`: update the adapter paragraph in \"Executors and the Reaper\" (the line beginning \"**Agent CLIs plug in through adapters.**\"): state that the adapter also reads `rate_limit_info.unifiedWindows` from every `rate_limit_event` into `Result.Windows`, that the controller records the readings for OAuth steps only (including killed steps with no result), logs them as `limits.reading`, and that nothing is gated on them yet (#63).\n7. Fixtures: add `internal/agent/claude/testdata/synthetic_windows.jsonl` (clearly named synthetic) holding both windows.\n\n### Test plan\nCommand: `go test ./...` (and `go vet ./...`).\n- `internal/agent/claude/parse_test.go` (or new `windows_test.go`): `TestParseWindows` (fixture with five_hour and seven_day gives two sorted windows); `TestParseWindowsLastWins`; `TestParseWindowsMalformed` (bad `unifiedWindows` gives no windows, no SkippedLines, result intact); `TestParseWindowsNoResult` (stream killed before the result gives `ErrNoResult` and Windows set); `TestParseWindowsMillis` (reset time in ms); the existing limit tests must still pass.\n- `internal/limits/readings_test.go`: Observe stores and Readings returns sorted copies; a later Observe overwrites; a reopen from the same Meta restores them; a persist error leaves memory unchanged; corrupt value logs `limits.corrupt`; an empty input is a no-op; Exhaust and Readings do not disturb each other.\n- `internal/servecmd/observe_test.go`: OAuth step with windows is recorded and logs `limits.reading`; API-key step is not recorded; Observe error (a failing Meta) still returns the result and a nil error; the inner `ErrNoResult` return still records windows and returns the same error; no windows is a no-op.\n\n### Risk\nLow. No gating; Observe errors are swallowed and logged. Public interface change is additive (`agent.Result.Windows`, `agent.Window`). One new meta key, no migration. Not security-sensitive beyond the existing rule that text is read only from CLI-emitted events. Concurrency: `Book.mu` guards Observe, as in Exhaust. No `merge.protected_paths` touched (docs/proposal.md is not protected).\n\n### Size\nM (about 300 lines including tests, near the issue's estimate of 600 with fixtures and docs). Files: `internal/agent/agent.go`, `internal/agent/claude/parse.go`, `internal/agent/claude/testdata/synthetic_windows.jsonl` (new), `internal/agent/claude/windows_test.go` (new), `internal/limits/readings.go` (new), `internal/limits/readings_test.go` (new), `internal/servecmd/observe.go` (new), `internal/servecmd/observe_test.go` (new), `internal/servecmd/reaping.go`, `docs/proposal.md`.\nEOF\ncat > .ard/238/triage-engineer.md <<'EOF'\n---\nrole: engineer\nstatus: done\nattempt: 1\n---\nAdds a Window type and Result.Windows, parses the unified windows from every rate-limit event, and stores them in a new readings book in internal/limits. An observing parse wrapper in servecmd records and logs them for OAuth steps only, and the proposal paragraph is updated. Size M, risk low because nothing is gated and observe errors are only logged.\n\n## Open issues\n- The repository has no capture of the unifiedWindows payload, so its exact shape (object keyed by window or array, utilization scale) is assumed. The worker should parse tolerantly and a human should check a real capture.\n- Two done-when items need a person: ticking the spike box on the parent issue, and watching a few days of real runs.\nEOF"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1275,"cache_read_input_tokens":30704,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1275},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"97eea5e6-0b48-4970-80c9-c4184e55acd8","uuid":"f9a83065-692d-4f2c-b7a1-f9c51defb645","timestamp":"2026-11-23T18:38:50.395Z","request_id":"req_011ChLM3owYWsbao5mfQgah7"}
