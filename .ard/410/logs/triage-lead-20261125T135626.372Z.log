{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LZSEoLhFcMA8DPj8iN9Axi","type":"tool_result","content":"\tr.rt.sleep = func(ctx context.Context, d time.Duration) error { cancel(); return ctx.Err() }\n\t_, err := r.do(t, ctx, \"GET\", \"/x\", \"\")\n\tif !errors.Is(err, context.Canceled) {\n\t\tt.Errorf(\"err = %v, want context.Canceled\", err)\n\t}\n\tif IsTransient(err) {\n\t\tt.Error(\"cancellation must not be transient\")\n\t}\n}\n\nfunc TestRetryTransportSearchSpacing(t *testing.T) {\n\tr := newRig(t, time.Minute, status(200))\n\tr.rt.search = rate.NewLimiter(rate.Every(100*time.Millisecond), 5)\n\tstart := time.Now()\n\tfor i := 0; i < 5; i++ {\n\t\tresp, err := r.do(t, context.Background(), \"GET\", \"/search/issues\", \"\")\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tresp.Body.Close()\n\t}\n\tif time.Since(start) > 80*time.Millisecond {\n\t\tt.Errorf(\"burst of 5 was throttled: %v\", time.Since(start))\n\t}\n\tbefore := time.Now()\n\tresp, err := r.do(t, context.Background(), \"GET\", \"/search/issues\", \"\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tresp.Body.Close()\n\tif d := time.Since(before); d < 60*time.Millisecond {\n\t\tt.Errorf(\"sixth search did not wait: %v\", d)\n\t}\n\t// non-search requests are not limited\n\tbefore = time.Now()\n\tresp, _ = r.do(t, context.Background(), \"GET\", \"/repos/o/r\", \"\")\n\tresp.Body.Close()\n\tif time.Since(before) > 50*time.Millisecond {\n\t\tt.Error(\"non-search request was throttled\")\n\t}\n}\n\nfunc TestReadOnlyTransport(t *testing.T) {\n\tvar hits int\n\tsrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { hits++ }))\n\tdefer srv.Close()\n\tc := &http.Client{Transport: readOnlyTransport{next: http.DefaultTransport}}\n\tfor _, m := range []string{\"POST\", \"PATCH\", \"PUT\", \"DELETE\", \"HEAD\", \"OPTIONS\"} {\n\t\treq, _ := http.NewRequest(m, srv.URL+\"/graphql\", strings.NewReader(\"{}\"))\n\t\tif _, err := c.Do(req); !errors.Is(err, ErrReadOnly) {\n\t\t\tt.Errorf(\"%s: err = %v, want ErrReadOnly\", m, err)\n\t\t}\n\t}\n\tif hits != 0 {\n\t\tt.Errorf(\"server saw %d requests\", hits)\n\t}\n\tresp, err := c.Get(srv.URL)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tresp.Body.Close()\n\tif hits != 1 {\n\t\tt.Errorf(\"GET hits = %d\", hits)\n\t}\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"b4a6050c-db88-431b-a8c4-540c409a4fe2","uuid":"5f595d42-0c6e-45f6-8bb5-cc976bc33ef9","timestamp":"2026-11-25T13:56:32.034Z","tool_use_result":{"stdout":"\tr.rt.sleep = func(ctx context.Context, d time.Duration) error { cancel(); return ctx.Err() }\n\t_, err := r.do(t, ctx, \"GET\", \"/x\", \"\")\n\tif !errors.Is(err, context.Canceled) {\n\t\tt.Errorf(\"err = %v, want context.Canceled\", err)\n\t}\n\tif IsTransient(err) {\n\t\tt.Error(\"cancellation must not be transient\")\n\t}\n}\n\nfunc TestRetryTransportSearchSpacing(t *testing.T) {\n\tr := newRig(t, time.Minute, status(200))\n\tr.rt.search = rate.NewLimiter(rate.Every(100*time.Millisecond), 5)\n\tstart := time.Now()\n\tfor i := 0; i < 5; i++ {\n\t\tresp, err := r.do(t, context.Background(), \"GET\", \"/search/issues\", \"\")\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tresp.Body.Close()\n\t}\n\tif time.Since(start) > 80*time.Millisecond {\n\t\tt.Errorf(\"burst of 5 was throttled: %v\", time.Since(start))\n\t}\n\tbefore := time.Now()\n\tresp, err := r.do(t, context.Background(), \"GET\", \"/search/issues\", \"\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tresp.Body.Close()\n\tif d := time.Since(before); d < 60*time.Millisecond {\n\t\tt.Errorf(\"sixth search did not wait: %v\", d)\n\t}\n\t// non-search requests are not limited\n\tbefore = time.Now()\n\tresp, _ = r.do(t, context.Background(), \"GET\", \"/repos/o/r\", \"\")\n\tresp.Body.Close()\n\tif time.Since(before) > 50*time.Millisecond {\n\t\tt.Error(\"non-search request was throttled\")\n\t}\n}\n\nfunc TestReadOnlyTransport(t *testing.T) {\n\tvar hits int\n\tsrv := httptest.