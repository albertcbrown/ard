{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JByh9q7g1BBLZMUr9kt19c","type":"tool_result","content":"**One committer for main.** Close-outs never push. They hand a file set to the controller's committer, which keeps its own clean worktree of `main`, commits as `ard[bot]` with `ard(<stage>:<role>): #<issue> <summary> [skip ci]`, re-applies its snapshot on the fetched head, pushes with a lease, and retries up to 3 times (re-applying the whole-file snapshot is the rebase; if upstream changed one of its paths the request fails with a conflict instead of overwriting). A replay of an unchanged tree is a no-op that returns the upstream head. It refuses any change outside the `.ard/<issue#>/` directo\n\nfunc TestWorktreeLockKey(t *testing.T) {\n\tctx := context.Background()\n\tg := New(\"\")\n\t_, clone := gittest.NewRemote(t)\n\t_, other := gittest.NewRemote(t)\n\tlinked := filepath.Join(t.TempDir(), \"linked\")\n\tgittest.Run(t, clone, \"worktree\", \"add\", \"--detach\", linked, \"HEAD\")\n\n\tunlock, err := g.worktreeLock(ctx, clone)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer unlock()\n\tshort, cancel := context.WithTimeout(ctx, 50*time.Millisecond)\n\tdefer cancel()\n\tif _, err := g.worktreeLock(short, linked); !errors.Is(err, context.DeadlineExceeded) {\n\t\tt.Fatalf(\"linked worktree err = %v, want DeadlineExceeded\", err)\n\t}\n\tu2, err := g.worktreeLock(ctx, other)\n\tif err != nil {\n\t\tt.Fatalf(\"unrelated clone blocked: %v\", err)\n\t}\n\tu2()\n}\n\n20:func stage(t *testing.T, dir, name, content string) {\n28:func TestCommit(t *testing.T) {\n68:func TestPush(t *testing.T) {\n148:func TestPushEnv(t *testing.T) {\n157:func TestScrub(t *testing.T) {\n172:func TestRevParseError(t *testing.T) {\n179:func TestChangedSince(t *testing.T) {\n225:func TestRemoteURL(t *testing.T) {\n240:func TestHooksNeverRun(t *testing.T) {\n268:func TestHeaderKey(t *testing.T) {\n281:func worktreeCount(t *testing.T, dir string) int {\n292:func TestWorktreeAdminConcurrent(t *testing.T) {\n321:func TestWorktreeLockKey(t *testing.T) {\n346:func TestWorktreeRemoveRunsWhenCancelled(t *testing.T) {\n366:func TestSetExec(t *testing.T) {\n392:func TestIsBareRepo(t *testing.T) {\n422:func TestSetConfig(t *testing.T) {\n439:func TestRunDisablesAutoGC(t *testing.T) {\n456:func TestWorktreeAdminWithAutoGC(t *testing.T) {\n500:func TestIsAncestorAndParents(t *testing.T) {","is_error":false}]},"parent_tool_use_id":null,"session_id":"e208eb5f-d25d-4e32-abd6-d040c1d77682","uuid":"c8d98e91-0a80-4bf7-82fa-8d98e6c15508","timestamp":"2026-11-25T14:05:18.184Z","tool_use_result":{"stdout":"**One committer for main.** Close-outs never push. They hand a file set to the controller's committer, which keeps its own clean worktree of `main`, commits as `ard[bot]` with `ard(<stage>:<role>): #<issue> <summary> [skip ci]`, re-applies its snapshot on the fetched head, pushes with a lease, and retries up to 3 times (re-applying the whole-file snapshot is the rebase; if upstream changed one of its paths the request fails with a conflict instead of overwriting). A replay of an unchanged tree is a no-op that returns the upstream head. It refuses any change outside the `.ard/<issue#>/` directo\n\nfunc TestWorktreeLockKey(t *testing.T) {\n\tctx := context.Background()\n\tg := New(\"\")\n\t_, clone := gittest.NewRemote(t)\n\t_, other := gittest.NewRemote(t)\n\tlinked := filepath.Join(t.TempDir(), \"linked\")\n\tgittest.Run(t, clone, \"worktree\", \"add\", \"--detach\", linked, \"HEAD\")\n\n\tunlock, err := g.worktreeLock(ctx, clone)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer unlock()\n\tshort, cancel := context.WithTimeout(ctx, 50*time.Millisecond)\n\tdefer cancel()\n\tif _, err := g.worktreeLock(short, linked); !errors.Is(err, context.DeadlineExceeded) {\n\t\tt.Fatalf(\"linked worktree err = %v, want DeadlineExceeded\", err)\n\t}\n\tu2, err := g.worktreeLock(ctx, other)\n\tif err != nil {\n\t\tt.Fatalf(\"unrelated clone blocked: %v\", err)\n\t}\n\tu2()\n}\n\n20:func stage(t *testing.T, dir, name, content string) {\n28:func TestCommit(t *testing.T) {\n68:func TestPush(t *testing.T) {\n148:func TestPushEnv(t *testing.T) {\n157:func TestScrub(t *testing.T) {\n172:func TestRevParseError(t *testing.T) {\n179:func TestChangedSince(t *testing.T) {\n225:func TestRemoteURL(t *testing.T) {\n240:func TestHooksNeverRun(t *testing.T) {\n268:func TestHeaderKey(t *testing.T) {\n281:func worktreeCount(t *testing.T, dir string) int {\n292:func TestWorktreeAdminConcurrent(t *testing.T) {\n321:func TestWorktreeLockKey(t *testing.T) {\n346:func TestWorktreeRemoveRunsWhenCancelled(t *testing.T) {\n366:func TestSetExec(t *testing.T) {\n392:func TestIsBareRepo(t *testing.T) {\n422:func TestSetConfig(t *testing.T) {\n439:func TestRunDisablesAutoGC(t *testing.T) {\n456:func TestWorktreeAdminWithAutoGC(t *testing.T) {\n500:func TestIsAncestorAndParents(t *testing.T) {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01JByh9q7g1BBLZMUr9kt19c","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
