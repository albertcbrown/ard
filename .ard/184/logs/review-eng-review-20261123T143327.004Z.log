 or closed before this review finished, so nothing was committed and the job is recorded as stale.\")\n+\t}\n \tif len(notes) > 0 {\n \t\tb.WriteString(\"\\n\" + strings.Join(notes, \"\\n\") + \"\\n\")\n \t}\ndiff --git a/internal/servecmd/reaping.go b/internal/servecmd/reaping.go\nindex 6ebf924..cb2a6f1 100644\n--- a/internal/servecmd/reaping.go\n+++ b/internal/servecmd/reaping.go\n@@ -14,6 +14,7 @@ import (\n \t\"github.com/albertcbrown/ard/internal/config\"\n \t\"github.com/albertcbrown/ard/internal/controller\"\n \t\"github.com/albertcbrown/ard/internal/executor\"\n+\t\"github.com/albertcbrown/ard/internal/github\"\n \t\"github.com/albertcbrown/ard/internal/gitx\"\n \t\"github.com/albertcbrown/ard/internal/limits\"\n \t\"github.com/albertcbrown/ard/internal/pool\"\n@@ -56,6 +57,10 @@ func (w *wiring) closer() *closeout.Closer {\n \tif w.StateDir == \"\" {\n \t\tstaging = filepath.Join(w.ardRoot(), \"closeout\")\n \t}\n+\tvar getPR func(context.Context, int) (github.PullRequest, error)\n+\tif w.Reader != nil {\n+\t\tgetPR = w.Reader.GetPR\n+\t}\n \tw.cl = closeout.New(closeout.Deps{\n \t\tEffects: w.Effects, Comments: w.Reader, Committer: closeoutCommitter{w}, Store: w.Store,\n \t\tRoles: cfgRoles{w},\n@@ -70,6 +75,7 @@ func (w *wiring) closer() *closeout.Closer {\n \t\tBaseFile: func(ctx context.Context, _, rev, path string, maxBytes int64) ([]byte, bool, error) {\n \t\t\treturn gitx.New(\"\").FileAt(ctx, w.Root, rev, path, maxBytes)\n \t\t},\n+\t\tPR:         getPR,\n \t\tRepo:       w.Repo,\n \t\tStagingDir: staging,\n \t\tLog:        w.Log,\ncosts\nlogs\nplan.md\ntriage-engineer.md\ntriage-lead.md\nworker-engineer.md","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01BHWh9qrMaVxpTBcaFwduZq","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
