{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017kjAEA1znJ1yBBUqAxox4d","type":"tool_result","content":"\t\t}\n\t\tif !c.acquire(rec.Job.ID) {\n\t\t\tc.d.log().Info(\"closeout.resume skipped: in flight\", \"job\", rec.Job.ID)\n\t\t\tcontinue\n\t\t}\n\t\tc.d.log().Info(\"closeout.resume\", \"job\", rec.Job.ID, \"issue\", rec.Job.Issue, \"phase\", rec.Phase)\n\t\t_, err = c.advance(ctx, rec)\n\t\tc.release(rec.Job.ID)\n\t\tif err != nil {\n\t\t\terrs = append(errs, err)\n\t\t}\n\t}\n\treturn errors.Join(errs...)\n}\n\nfunc decode(sj state.Job) (Record, error) {\n\tvar rec Record\n\tif err := json.Unmarshal(sj.CloseoutPlan, &rec); err != nil {\n\t\treturn Record{}, fmt.Errorf(\"closeout job %s: decode record: %w\", sj.ID, err)\n\t}\n\tif rec.Version != recordVersion {\n\t\treturn Record{}, fmt.Errorf(\"closeout job %s: record version %d, want %d\", sj.ID, rec.Version, recordVersion)\n\t}\n\treturn rec, nil\n}\n\nfunc (c *Closer) save(ctx context.Context, rec Record) error {\n\tb, err := json.Marshal(rec)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"closeout job %s: encode record: %w\", rec.Job.ID, err)\n\t}\n\tif err := c.d.Store.SetCloseout(ctx, rec.Job.ID, string(rec.Phase), b); err != nil {\n\t\treturn fmt.Errorf(\"closeout job %s phase %s: save: %w\", rec.Job.ID, rec.Phase, err)\n\t}\n\treturn nil\n}\n\nfunc (c *Closer) fail(rec Record, err error) error {\n\terr = fmt.Errorf(\"closeout job %s phase %s: %w\", rec.Job.ID, rec.Phase, err)\n\tc.d.log().Error(\"closeout failed\", \"job\", rec.Job.ID, \"issue\", rec.Job.Issue, \"phase\", rec.Phase, \"error\", err)\n\treturn err\n}\n\n// advance runs the steps after rec.Phase.\nfunc (c *Closer) advance(ctx context.Context, rec Record) (Outcome, error) {\n\tif rec.Phase == PhaseClosed {\n\t\treturn rec.Plan.Outcome, nil\n\t}\n\tif rec.Phase == PhasePrepared {\n\t\tif err := c.commit(ctx, &rec); err != nil {\n\t\t\treturn \"\", c.fail(rec, err)\n\t\t}\n\t\trec.Phase = PhaseCommitted\n\t\tif err := c.save(ctx, rec); err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t}\n\tif rec.Phase == PhaseCommitted {\n\t\tif err := c.request(ctx, rec); err != nil {\n\t\t\treturn \"\", c.fail(rec, err)\n\t\t}\n\t\trec.Phase = PhaseRequested\n\t\tif err := c.save(ctx, rec); err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t}\n\tif rec.Phase == PhaseRequested {\n\t\tif err := c.comment(ctx, &rec); err != nil {\n\t\t\treturn \"\", c.fail(rec, err)\n\t\t}\n\t\trec.Phase = PhaseCommented\n\t\tif err := c.save(ctx, rec); err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t}\n\tif err := c.finish(ctx, rec); err != nil {\n\t\treturn \"\", c.fail(rec, err)\n\t}\n\trec.Phase = PhaseClosed\n\tif err := c.save(ctx, rec); err != nil {\n\t\treturn \"\", err\n\t}\n\tif err := os.RemoveAll(filepath.Join(c.d.StagingDir, rec.Job.ID)); err != nil {\n\t\tc.d.log().Warn(\"closeout: remove staging\", \"job\", rec.Job.ID, \"error\", err)\n\t}\n\tif rec.Synthetic || c.d.Effects.DryRun() {\n\t\tc.d.log().Info(\"closeout: raw log kept (dry-run)\", \"job\", rec.Job.ID)\n\t} else {\n\t\tc.dropRawLog(rec)\n\t}\n\treturn rec.Plan.Outcome, nil\n}\n\n// commit hands the staged files to the committer. A permanent error (the\n// committer already retried) turns the job into a failure with no files.\nfunc (c *Closer) commit(ctx context.Context, rec *Record) error {\n\tp := &rec.Plan\n\tif len(p.Files) == 0 {\n\t\treturn nil\n\t}\n\treq := committer.Request{Issue: rec.Job.Issue, Stage: rec.Job.Stage, Role: rec.Job.Role,\n\t\tSummary: commitSummary(*p), JobID: rec.Job.ID}\n\tsec := sectionOf(c.d.Roles, rec.Job.Stage, rec.Job.Role)\n\tplanPath := fmt.Sprintf(\".ard/%d/plan.md\", rec.Job.Issue)\n\tfor _, f := range p.Files {\n\t\tcf := committer.File{Path: f.Path, Delete: f.Delete}\n\t\tif !f.Delete {\n\t\t\tcf.Src = f.Staged\n\t\t\tif sec != \"\" && f.Path == planPath && rec.Job.Branch == \"\" {\n\t\t\t\tcf.Merge = mergeOwnSection(sec)\n\t\t\t}\n\t\t}\n\t\treq.Files = append(req.Files, cf)\n\t}\n\tres, err := c.d.Committer.Commit(ctx, rec.Job.Branch, req)\n\tswitch {\n\tcase err == nil:\n\t\trec.SHA, rec.Synthetic = res.SHA, res.Synthetic\n\t\treturn nil\n\tcase errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded):\n\t\treturn err\n\t}\n\tc.d.log().Warn(\"closeout: commit failed\", \"job\", rec.Job.ID, \"error\", err)\n\tif p.Outcome == OutcomeRetry || p.Outcome == OutcomeLimited {\n\t\t// The log is evidence, not the result: a retry or a limit stop must\n\t\t// not turn into a failure because it could not be committed (a worker\n\t\t// that stopped before its first push has no branch to commit to).\n\t\tp.Files, p.LogPath = nil, \"\"\n\t\tp.Reason += \"; log not committed: \" + err.Error()\n\t\treturn nil\n\t}\n\ttail, tailWithheld, keep := p.Tail, p.TailWithheld, p.KeepUntil\n\tif errors.Is(err, committer.ErrMerge) {\n\t\t*p = needsHumanPlan(rec.Job, p.Status, \"plan.md conflict: \"+err.Error())\n\t} else {\n\t\t*p = failedPlan(rec.Job, \"commit failed: \"+err.Error(), p.LogWithheld)\n\t}\n\tp.Tail, p.TailWithheld, p.KeepUntil = tail, tailWithheld, keep\n\treturn nil\n}\n\nfunc commitSummary(p Plan) string {\n\tfor _, s := range []string{p.Summary, p.Reason} {\n\t\tif l := strings.TrimSpace(strings.SplitN(strings.TrimSpace(s), \"\\n\", 2)[0]); l != \"\" {\n\t\t\treturn l\n\t\t}\n\t}\n\treturn \"close-out \" + string(p.Outcome)\n}\n\n// request applies the next labels, grouped by target number.\nfunc (c *Closer) request(ctx context.Context, rec Record) error {\n\treturn c.addGrouped(ctx, rec.Plan.Requests)\n}\n\nfunc (c *Closer) addGrouped(ctx context.Context, ls []Label) error {\n\tvar order []int\n\tby := map[int][]string{}\n\tfor _, l := range ls {\n\t\tif _, ok := by[l.Number]; !ok {\n\t\t\torder = append(order, l.Number)\n\t\t}\n\t\tby[l.Number] = append(by[l.Number], l.Name)\n\t}\n\tfor _, n := range order {\n\t\tif err := c.d.Effects.AddLabels(ctx, n, by[n]...); err != nil {\n\t\t\treturn fmt.Errorf(\"add labels on #%d: %w\", n, err)\n\t\t}\n\t}\n\treturn nil\n}\n\n// comment posts the summary once; the marker makes a replay find it.\nfunc (c *Closer) comment(ctx context.Context, rec *Record) error {\n\tif rec.Plan.Review != nil {\n\t\treturn c.postReview(ctx, rec)\n\t}\n\tn := rec.Job.target()\n\tif n > 0 && c.d.Comments != nil {\n\t\tcs, err := c.d.Comments.ListComments(ctx, n, time.Time{})\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"list comments on #%d: %w\", n, err)\n\t\t}\n\t\tfor _, cm := range cs {\n\t\t\tif strings.HasPrefix(cm.Body, markerFor(rec.Job.ID)) {\n\t\t\t\trec.CommentID = cm.ID\n\t\t\t\treturn nil\n\t\t\t}\n\t\t}\n\t}\n\tcm, err := c.d.Effects.CreateComment(ctx, n, RenderComment(*rec, c.d.Repo, c.d.Effects.DryRun()))\n\tif err != nil {\n\t\treturn fmt.Errorf(\"comment on #%d: %w\", n, err)\n\t}\n\trec.CommentID = cm.ID\n\treturn nil\n}\n\n// postReview posts a review job's summary and findings once: one PR review\n// with inline comments, else (GitHub answers 422: a line or the commit is not\n// in the PR) one review with every finding in its body, else a plain comment.\n// A 422 created nothing, so a replay walks the same chain. Any other error is\n// returned and the close-out stays resumable. The marker in the body makes a\n// replay after a crash find an earlier post.\nfunc (c *Closer) postReview(ctx context.Context, rec *Record) error {\n\tj, rp := rec.Job, rec.Plan.Review\n\tn := j.target()\n\tif n > 0 && c.d.Comments != nil {\n\t\trs, err := c.d.Comments.ListReviews(ctx, n)\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"list reviews on #%d: %w\", n, err)\n\t\t}\n\t\tfor _, r := range rs {\n\t\t\tif strings.HasPrefix(r.Body, markerFor(j.ID)) {\n\t\t\t\trec.CommentID, rec.ReviewMode = r.ID, ReviewFound\n\t\t\t\treturn nil\n\t\t\t}\n\t\t}\n\t\tcs, err := c.d.Comments.ListComments(ctx, n, time.Time{})\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"list comments on #%d: %w\", n, err)\n\t\t}\n\t\tfor _, cm := range cs {\n\t\t\tif strings.HasPrefix(cm.Body, markerFor(j.ID)) {\n\t\t\t\trec.CommentID, rec.ReviewMode = cm.ID, ReviewFound\n\t\t\t\treturn nil\n\t\t\t}\n\t\t}\n\t}\n\tdry := c.d.Effects.DryRun()\n\trejected := func(err error) bool {\n\t\tvar he *github.HTTPError\n\t\treturn errors.As(err, &he) && he.Status == 422\n\t}\n\tinline := inlineComments(rp)\n\tif len(inline) > 0 {\n\t\trid, err := c.d.Effects.CreateReview(ctx, n, github.ReviewInput{CommitSHA: rp.CommitSHA,\n\t\t\tBody: RenderReview(*rec, c.d.Repo, dry, false), Comments: inline})\n\t\tif err == nil {\n\t\t\trec.CommentID, rec.ReviewMode = rid, ReviewInline\n\t\t\treturn nil\n\t\t}\n\t\tif !rejected(err) {\n\t\t\treturn fmt.Errorf(\"review on #%d: %w\", n, err)\n\t\t}\n\t\tc.d.log().Warn(\"closeout.review_inline_rejected\", \"job\", j.ID, \"pr\", n, \"error\", err)\n\t}\n\tbody := RenderReview(*rec, c.d.Repo, dry, len(inline) > 0)\n\trid, err := c.d.Effects.CreateReview(ctx, n, github.ReviewInput{CommitSHA: rp.CommitSHA, Body: body})\n\tif err == nil {\n\t\trec.CommentID, rec.ReviewMode = rid, ReviewBody\n\t\treturn nil\n\t}\n\tif !rejected(err) {\n\t\treturn fmt.Errorf(\"review on #%d: %w\", n, err)\n\t}\n\tc.d.log().Warn(\"closeout.review_rejected\", \"job\", j.ID, \"pr\", n, \"error\", err)\n\tcm, err := c.d.Effects.CreateComment(ctx, n, body)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"comment on #%d: %w\", n, err)\n\t}\n\trec.CommentID, rec.ReviewMode = cm.ID, ReviewComment\n\treturn nil\n}\n\n// finish swaps the labels (\":running\" is removed last, so it marks the commit\n// point) and closes the job in state.\nfunc (c *Closer) finish(ctx context.Context, rec Record) error {\n\tp := rec.Plan\n\tif err := c.addGrouped(ctx, p.Terminal); err != nil {\n\t\treturn err\n\t}\n\tfor _, l := range p.Remove {\n\t\tif err := c.d.Effects.RemoveLabel(ctx, l.Number, l.Name); err != nil {\n\t\t\treturn fmt.Errorf(\"remove %s on #%d: %w\", l.Name, l.Number, err)\n\t\t}\n\t}\n\tvar cost *float64\n\tif rec.Job.CostUSD > 0 {\n\t\tv := rec.Job.CostUSD\n\t\tcost = &v\n\t}\n\tkeep := p.KeepUntil\n\tif keep.IsZero() {\n\t\tkeep = c.d.now().Add(failedKeep)\n\t}\n\tvar err error\n\tswitch p.Outcome {\n\tcase OutcomeFailed:\n\t\terr = c.d.Store.Fail(ctx, rec.Job.ID, clip(p.Reason, maxReasonRunes), keep)\n\tcase OutcomeRetry:\n\t\terr = c.d.Store.FailRetry(ctx, rec.Job.ID, clip(p.Reason, maxReasonRunes), keep)\n\tcase OutcomeLimited:\n\t\terr = c.d.Store.FailLimited(ctx, rec.Job.ID, clip(p.Reason, maxReasonRunes), keep)\n\tdefault:\n\t\terr = c.d.Store.Complete(ctx, rec.Job.ID, cost)\n\t}\n\tif err != nil {\n\t\treturn fmt.Errorf(\"close job in state: %w\", err)\n\t}\n\treturn nil\n}\n\n// dropRawLog deletes the unredacted host log once its redacted copy has been\n// committed. It is kept, and the keep is logged, when redaction failed or the\n// scan flagged it (so a human can inspect it) or when the commit did not\n// carry it.\nfunc (c *Closer) dropRawLog(rec Record) {\n\tj := rec.Job\n\tcommitted := map[string]bool{}\n\tfor _, p := range rec.Plan.ExtraLogPaths {\n\t\tcommitted[p] = true\n\t}\n\tdrop := func(path string, ok bool) {\n\t\tif !ok {\n\t\t\tc.d.log().Warn(\"closeout: raw log kept\", \"job\", j.ID, \"path\", path, \"withheld\", rec.Plan.LogWithheld)\n\t\t\treturn\n\t\t}\n\t\tif err := os.Remove(path); err != nil && !errors.Is(err, os.ErrNotExist) {\n\t\t\tc.d.log().Warn(\"closeout: remove raw log\", \"job\", j.ID, \"path\", path, \"error\", err)\n\t\t}\n\t}\n\tif j.LogPath != \"\" {\n\t\tdrop(j.LogPath, rec.Plan.LogPath != \"\")\n\t}\n\tfor _, extra := range j.ExtraLogs {\n\t\tcp, err := redact.CommitPath(rec.Job.Issue, extra)\n\t\tdrop(extra, err == nil && committed[cp])\n\t}\n}\npackage closeout\n\nimport (\n\t\"fmt\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/labels\"\n)\n\n// Outcome is what close-out decided about a job.\ntype Outcome string\n\nconst (\n\tOutcomeDone       Outcome = \"done\"\n\tOutcomeChanges    Outcome = \"changes\"\n\tOutcomeNeedsHuman Outcome = \"needs-human\"\n\tOutcomeFailed     Outcome = \"failed\"\n\t// OutcomeStale is a review whose verdict was approve but whose PR gained\n\t// code after the reviewed commit. The review is posted, no pass label is\n\t// set and the request label stays, so the review runs again.\n\tOutcomeStale Outcome = \"stale\"\n\t// OutcomeRetry is a failure with a named transient cause. The job hands\n\t// off to one automatic retry: it gets no ard:executor:failed and keeps its\n\t// request label, so the next claim runs it again as a new job.\n\tOutcomeRetry Outcome = \"retry\"\n\t// OutcomeLimited is a stop at a subscription usage limit. Its labels are\n\t// those of OutcomeRetry: no ard:executor:failed, the request label stays,\n\t// and the issue is claimed again once the pool's pause for the limit ends.\n\t// It neither uses up nor grants the automatic retry.\n\tOutcomeLimited Outcome = \"usage-limit\"\n)\n\n// Label is a label name with the issue or PR number it goes on.\ntype Label struct {\n\tNumber int\n\tName   string\n}\n\n// FileRef is one file of the commit set. Staged is the host path of the\n// cleaned bytes; Resume reads only that, never the worktree.\ntype FileRef struct {\n\tPath   string // repo-relative, slash form: .ard/<n>/<stage>-<role>.md\n\tStaged string\n\tDelete bool\n}\n\n// Plan is everything close-out will do, decided before any side effect.\ntype Plan struct {\n\tOutcome     Outcome\n\tStatus      string // raw status of the role file, for the comment header\n\tReason      string // failure or withhold reason; never secret text\n\tRequests    []Label\n\tTerminal    []Label // added in order\n\tRemove      []Label // removed in order; Running is last\n\tDeferred    []NextReq\n\tWorker      string // the lead's validated worker choice, for the Phase 1 gate\n\tSkipped     []Skip\n\tFiles       []FileRef\n\tLogWithheld bool\n\tLogPath     string // committed log path when it is in Files\n\t// ExtraLogPaths are the committed paths of Job.ExtraLogs, in order.\n\tExtraLogPaths []string\n\tSummary       string // redacted role file summary, for the comment\n\t// Review is set for a review that reached a verdict: close-out posts one\n\t// PR review instead of a plain comment.\n\tReview   *ReviewPlan\n\tRolePath string // committed role file path, \"\" when none\n\n\t// Tail is the last lines of the redacted log, for a failed or retry\n\t// comment. It is \"\" when there is no log, when the log was withheld, or\n\t// when the tail did not pass a second redaction (TailWithheld).\n\tTail         string\n\tTailWithheld bool\n\t// KeepUntil is when the resources of a failed or retry job may be removed\n\t// (zero on records from before the Reaper: close-out then uses 24 h).\n\tKeepUntil time.Time\n}\n\n// target returns the number labels for this job go on: the PR for a review,\n// the issue otherwise.\nfunc (j Job) target() int {\n\tif j.Stage == StageReview {\n\t\treturn j.PR\n\t}\n\treturn j.Issue\n}\n\n// Build maps a validated role file to a plan, with no files. It is pure.\nfunc Build(j Job, rf RoleFile, rs RoleSet) Plan {\n\tp := Plan{Status: rf.Status}\n\tn := j.target()\n\trun := Label{n, labels.Running(labels.Stage(j.Stage), j.Role)}\n\tswitch {\n\tcase rf.Status != StatusDone:\n\t\tp.Outcome = OutcomeNeedsHuman\n\t\tp.Terminal = []Label{{n, labels.NeedsHuman}}\n\t\tp.Remove = []Label{run}\n\tcase j.Stage == StageReview && rf.Verdict == VerdictChanges:\n\t\tp.Outcome = OutcomeChanges\n\t\tp.Terminal = []Label{{n, labels.Changes(j.Role)}}\n\t\tp.Remove = []Label{{n, labels.Done(labels.Stage(j.Stage), j.Role)}, run}\n\tcase j.Stage == StageReview && rf.Verdict == VerdictApprove && (j.Review == nil || j.Review.HeadMoved):\n\t\t// An approve of a head that has since gained code is not a pass. With\n\t\t// no review context (a Reaper close-out after a restart) the head is\n\t\t// unknown, so it is treated as moved.\n\t\tp.Outcome = OutcomeStale\n\t\tp.Remove = []Label{run}\n\tcase j.Stage == StageWorker:\n\t\tp = buildWorker(j, rf, rs)\n\tdefault:\n\t\tp.Outcome = OutcomeDone\n\t\tp.Terminal = []Label{{n, labels.Done(labels.Stage(j.Stage), j.Role)}}\n\t\tif j.Stage == StageReview {\n\t\t\tp.Remove = append(p.Remove, Label{n, labels.Changes(j.Role)})\n\t\t}\n\t\tif j.Stage == StageTriage && j.Role == \"lead\" {\n\t\t\tp.Remove = append(p.Remove, Label{n, labels.Pending})\n\t\t}\n\t\tp.Remove = append(p.Remove, run)\n\t\tnow, deferred, skipped := resolveNext(j, rf.Next, rs)\n\t\tp.Deferred, p.Skipped = deferred, skipped\n\t\tfor _, r := range now {\n\t\t\tnum := j.Issue\n\t\t\tif r.Stage == StageReview {\n\t\t\t\tnum = j.PR\n\t\t\t}\n\t\t\tp.Requests = append(p.Requests, Label{num, labels.Request(labels.Stage(r.Stage), r.Role)})\n\t\t}\n\t\tif rf.Worker != \"\" {\n\t\t\tif hasRole(rs, StageWorker, rf.Worker) {\n\t\t\t\tp.Worker = rf.Worker\n\t\t\t} else {\n\t\t\t\tp.Skipped = append(p.Skipped, Skip{\"worker:\" + clip(rf.Worker, 60), \"no such role\"})\n\t\t\t}\n\t\t}\n\t}\n\treturn p\n}\n\n// failedPlan is the plan for a job that did not produce a usable result.\nfunc failedPlan(j Job, reason string, logWithheld bool) Plan {\n\tn := j.target()\n\tp := Plan{Outcome: OutcomeFailed, Reason: reason, LogWithheld: logWithheld,\n\t\tTerminal: []Label{{n, labels.ExecutorFailed}},\n\t\tRemove:   []Label{{n, labels.Running(labels.Stage(j.Stage), j.Role)}}}\n\tif logWithheld {\n\t\tp.Terminal = append(p.Terminal, Label{n, labels.NeedsHuman})\n\t}\n\treturn p\n}\n\n// retryPlan is the plan for a job that failed for a transient cause and hands\n// off to one automatic retry. It removes only :running and leaves the request\n// label alone: a human who removed it to cancel stays cancelled.\nfunc retryPlan(j Job, reason string) Plan {\n\tn := j.target()\n\tst := labels.Stage(j.Stage)\n\treturn Plan{Outcome: OutcomeRetry, Reason: reason,\n\t\tRemove: []Label{{n, labels.Running(st, j.Role)}}}\n}\n\n// limitedPlan is the plan for a job that stopped at a usage limit. It has\n// retryPlan's labels: it removes only :running, leaves the request label alone\n// and adds no terminal label. What differs is the state change (FailLimited)\n// and that it does not touch the automatic retry.\nfunc limitedPlan(j Job, reason string) Plan {\n\tp := retryPlan(j, reason)\n\tp.Outcome = OutcomeLimited\n\treturn p\n}\n\n// needsHumanPlan is the plan for a job held back by the secret scan.\nfunc needsHumanPlan(j Job, status, reason string) Plan {\n\tn := j.target()\n\treturn Plan{Outcome: OutcomeNeedsHuman, Status: status, Reason: reason, LogWithheld: false,\n\t\tTerminal: []Label{{n, labels.NeedsHuman}},\n\t\tRemove:   []Label{{n, labels.Running(labels.Stage(j.Stage), j.Role)}}}\n}\n\nfunc (j Job) validate() error {\n\tswitch j.Stage {\n\tcase StageTriage, StageWorker, StageReview:\n\tdefault:\n\t\treturn fmt.Errorf(\"closeout job %s: stage %q is not triage, worker or review\", j.ID, j.Stage)\n\t}\n\tif j.ID == \"\" || j.Role == \"\" || j.Issue == 0 {\n\t\treturn fmt.Errorf(\"closeout job %q: id, role and issue are required\", j.ID)\n\t}\n\tif j.Cause.Kind != \"\" {\n\t\t// A job that ended for a known cause commits only its log: it needs\n\t\t// neither a base commit nor a branch (an empty branch puts the log on\n\t\t// main under .ard/<issue#>/logs/).\n\t\treturn nil\n\t}\n\tif j.ExitCode == 0 && j.BaseSHA == \"\" {\n\t\treturn fmt.Errorf(\"closeout job %s: BaseSHA is required to find the changed files\", j.ID)\n\t}\n\tif j.Stage == StageReview && j.PR == 0 {\n\t\treturn fmt.Errorf(\"closeout job %s: a review needs a PR\", j.ID)\n\t}\n\t// A worker that stops before its first push has no branch: its role file\n\t// and log go to main, as triage's do.\n\tif j.Stage == StageReview && j.Branch == \"\" {\n\t\treturn fmt.Errorf(\"closeout job %s: a review job needs a branch\", j.ID)\n\t}\n\treturn nil\n}\npackage closeout\n\nimport (\n\t\"fmt\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n)\n\nconst (\n\tmaxInlineRunes   = 2000\n\tmaxBulletRunes   = 300\n\tmaxReviewRunes   = 60000\n\treviewFooterRoom = 2000 // runes kept free for the closing lines\n)\n\n// Review modes: how the review reached GitHub.\nconst (\n\tReviewInline  = \"inline\"  // one PR review with inline comments\n\tReviewBody    = \"body\"    // a PR review with every finding in its body\n\tReviewComment = \"comment\" // a plain PR comment (GitHub took no review)\n\tReviewFound   = \"found\"   // an earlier post was found; nothing was posted\n)\n\n// ReviewContext is what the reviewer loop knows that the role file cannot say.\n// Added is used by Prepare only and is not persisted: the plan keeps the\n// decided placement.\ntype ReviewContext struct {\n\t// MergeBase is the commit the diff was taken against.\n\tMergeBase string\n\t// Added is, per path, the head-side line ranges the PR added.\n\tAdded map[string][]gitx.LineRange `json:\"-\"`\n\t// HeadMoved is set when the PR gained code (anything outside .ard/) after\n\t// the commit the review pinned. An approve is then not a pass: the review\n\t// is posted but no label says done, so the request stays and runs again.\n\tHeadMoved bool\n}\n\n// ReviewPlan is the PR review close-out posts for a review job that reached a\n// verdict.\ntype ReviewPlan struct {\n\tCommitSHA string // the pinned commit the agent reviewed\n\tVerdict   string // after any downgrade\n\t// Downgraded: the role file said approve but carried a blocking finding.\n\tDowngraded bool\n\tHeadMoved  bool\n\tInline     []Finding // on lines the PR added: posted as inline comments\n\tOther      []Finding // everything else: listed in the review body\n\t// NoLines: the added lines were not known (a Reaper close-out after a\n\t// restart), so every finding is in Other.\n\tNoLines bool\n}\n\n// reviewPlan splits the findings of a review by whether their line is one the\n// PR added.\nfunc reviewPlan(j Job, verdict string, downgraded bool, fs []Finding) *ReviewPlan {\n\trp := &ReviewPlan{CommitSHA: j.BaseSHA, Verdict: verdict, Downgraded: downgraded}\n\tif j.Review == nil {\n\t\trp.NoLines, rp.HeadMoved = true, true\n\t\trp.Other = append(rp.Other, fs...)\n\t\treturn rp\n\t}\n\trp.HeadMoved = j.Review.HeadMoved\n\tfor _, f := range fs {\n\t\tif f.Line > 0 && inRanges(f.Line, j.Review.Added[f.File]) {\n\t\t\trp.Inline = append(rp.Inline, f)\n\t\t} else {\n\t\t\trp.Other = append(rp.Other, f)\n\t\t}\n\t}\n\treturn rp\n}\n\nfunc inRanges(line int, rs []gitx.LineRange) bool {\n\tfor _, r := range rs {\n\t\tif line >= r.From && line <= r.To {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc findingTag(f Finding) string {\n\tb := \"non-blocking\"\n\tif f.Blocking {\n\t\tb = \"blocking\"\n\t}\n\treturn fmt.Sprintf(\"**%s · %s**\", f.Severity, b)\n}\n\n// inlineBody is the text of one inline comment.\nfunc inlineBody(f Finding) string {\n\treturn findingTag(f) + \"\\n\\n\" + sanitize(cutRunes(f.Message, maxInlineRunes))\n}\n\nfunc cutRunes(s string, n int) string {\n\tif r := []rune(s); len(r) > n {\n\t\treturn string(r[:n-1]) + \"…\"\n\t}\n\treturn s\n}\n\nfunc bullet(f Finding) string {\n\tloc := f.File\n\tif f.Line > 0 {\n\t\tloc = fmt.Sprintf(\"%s:%d\", f.File, f.Line)\n\t}\n\tfirst := strings.TrimSpace(strings.SplitN(strings.TrimSpace(f.Message), \"\\n\", 2)[0])\n\treturn fmt.Sprintf(\"- %s %s %s\", findingTag(f), codeSpan(loc, 340), sanitize(cutRunes(first, maxBulletRunes)))\n}\n\n// inlineComments builds the inline comments of a review plan.\nfunc inlineComments(rp *ReviewPlan) []github.InlineComment {\n\tout := make([]github.InlineComment, 0, len(rp.Inline))\n\tfor _, f := range rp.Inline {\n\t\tout = append(out, github.InlineComment{Path: f.File, Line: f.Line, Side: \"RIGHT\", Body: inlineBody(f)})\n\t}\n\treturn out\n}\n\n// RenderReview builds the body of the PR review (or of the plain comment that\n// replaces it). With allInBody every finding is listed in the body, for the\n// fallbacks that carry no inline comments. The body is at most 60,000 runes.\nfunc RenderReview(r Record, repo github.Repo, dryRun, allInBody bool) string {\n\tj, p := r.Job, r.Plan\n\trp := p.Review\n\tvar b strings.Builder\n\tb.WriteString(marker(j.ID, j.Attempt) + \"\\n\")\n\tfmt.Fprintf(&b, \"**ard · review:%s · %s**\\n\", j.Role, rp.Verdict)\n\tif s := strings.TrimSpace(p.Summary); s != \"\" {\n\t\tb.WriteString(\"\\n\" + sanitize(cutSummary(s)) + \"\\n\")\n\t}\n\tvar notes []string\n\tif rp.Downgraded {\n\t\tnotes = append(notes, \"The review approved but listed a blocking finding, so ard treats it as changes requested.\")\n\t}\n\tif rp.HeadMoved {\n\t\tnotes = append(notes, \"The branch gained code after this commit was reviewed. The review stays requested and runs again on the new head.\")\n\t}\n\tif len(notes) > 0 {\n\t\tb.WriteString(\"\\n\" + strings.Join(notes, \"\\n\") + \"\\n\")\n\t}\n\tlist, heading := rp.Other, \"Findings outside the changed lines:\"\n\tswitch {\n\tcase allInBody:\n\t\tlist = append(append([]Finding(nil), rp.Inline...), rp.Other...)\n\t\theading = \"Findings:\"\n\tcase rp.NoLines:\n\t\theading = \"Findings (line placement unavailable):\"\n\t}\n\tif len(list) > 0 {\n\t\tb.WriteString(\"\\n\" + heading + \"\\n\")\n\t\tused := len([]rune(b.String()))\n\t\tfor i, f := range list {\n\t\t\tline := bullet(f)\n\t\t\tif used+len([]rune(line))+1 > maxReviewRunes-reviewFooterRoom {\n\t\t\t\tfmt.Fprintf(&b, \"- … and %d more in the committed file\\n\", len(list)-i)\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tb.WriteString(line + \"\\n\")\n\t\t\tused += len([]rune(line)) + 1\n\t\t}\n\t}\n\tvar lines []string\n\tif sha := rp.CommitSHA; sha != \"\" {\n\t\tif len(sha) > 12 {\n\t\t\tsha = sha[:12]\n\t\t}\n\t\tlines = append(lines, fmt.Sprintf(\"Reviewed commit `%s`\", sha))\n\t}\n\tif out := outputLine(r, repo, dryRun); out != \"\" {\n\t\tlines = append(lines, out)\n\t}\n\tif len(lines) > 0 {\n\t\tb.WriteString(\"\\n\" + strings.Join(lines, \"\\n\") + \"\\n\")\n\t}\n\treturn b.String()\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"ba70a651-ea4a-4861-a970-006d1e1f371d","uuid":"01cc0e05-b94b-4f35-84df-f986697760cb","timestamp":"2026-11-23T14:24:56.074Z","tool_use_result":{"stdout":"\t\t}\n\t\tif !c.acquire(rec.Job.ID) {\n\t\t\tc.d.log().Info(\"closeout.resume skipped: in flight\", \"job\", rec.Job.ID)\n\t\t\tcontinue\n\t\t}\n\t\tc.d.log().Info(\"closeout.resume\", \"job\", rec.Job.ID, \"issue\", rec.Job.Issue, \"phase\", rec.Phase)\n\t\t_, err = c.advance(ctx, rec)\n\t\tc.release(rec.Job.ID)\n\t\tif err != nil {\n\t\t\terrs = append(errs, err)\n\t\t}\n\t}\n\treturn errors.Join(errs...)\n}\n\nfunc decode(sj state.Job) (Record, error) {\n\tvar rec Record\n\tif err := json.Unmarshal(sj.CloseoutPlan, &rec); err != nil {\n\t\treturn Record{}, fmt.Errorf(\"closeout job %s: decode record: %w\", sj.ID, err)\n\t}\n\tif rec.Version != recordVersion {\n\t\treturn Record{}, fmt.Errorf(\"closeout job %s: record version %d, want %d\", sj.ID, rec.Version, recordVersion)\n\t}\n\treturn rec, nil\n}\n\nfunc (c *Closer) save(ctx context.Context, rec Record) error {\n\tb, err := json.Marshal(rec)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"closeout job %s: encode record: %w\", rec.Job.ID, err)\n\t}\n\tif err := c.d.Store.SetCloseout(ctx, rec.Job.ID, string(rec.Phase), b); err != nil {\n\t\treturn fmt.Errorf(\"closeout job %s phase %s: save: %w\", rec.Job.ID, rec.Phase, err)\n\t}\n\treturn nil\n}\n\nfunc (c *Closer) fail(rec Record, err error) error {\n\terr = fmt.Errorf(\"closeout job %s phase %s: %w\", rec.Job.ID, rec.Phase, err)\n\tc.d.log().Error(\"closeout failed\", \"job\", rec.Job.ID, \"issue\", rec.Job.Issue, \"phase\", rec.Phase, \"error\", err)\n\treturn err\n}\n\n// advance runs the steps after rec.Phase.\nfunc (c *Closer) advance(ctx context.Context, rec Record) (Outcome, error) {\n\tif rec.Phase == PhaseClosed {\n\t\treturn rec.Plan.Outcome, nil\n\t}\n\tif rec.Phase == PhasePrepared {\n\t\tif err := c.commit(ctx, &rec); err != nil {\n\t\t\treturn \"\", c.fail(rec, err)\n\t\t}\n\t\trec.Phase = PhaseCommitted\n\t\tif err := c.save(ctx, rec); err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t}\n\tif rec.Phase == PhaseCommitted {\n\t\tif err := c.request(ctx, rec); err != nil {\n\t\t\treturn \"\", c.fail(rec, err)\n\t\t}\n\t\trec.Phase = PhaseRequested\n\t\tif err := c.save(ctx, rec); err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t}\n\tif rec.Phase == PhaseRequested {\n\t\tif err := c.comment(ctx, &rec); err != nil {\n\t\t\treturn \"\", c.fail(rec, err)\n\t\t}\n\t\trec.Phase = PhaseCommented\n\t\tif err := c.save(ctx, rec); err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t}\n\tif err := c.finish(ctx, rec); err != nil {\n\t\treturn \"\", c.fail(rec, err)\n\t}\n\trec.Phase = PhaseClosed\n\tif err := c.save(ctx, rec); err != nil {\n\t\treturn \"\", err\n\t}\n\tif err := os.RemoveAll(filepath.Join(c.d.StagingDir, rec.Job.ID)); err != nil {\n\t\tc.d.log().Warn(\"closeout: remove staging\", \"job\", rec.Job.ID, \"error\", err)\n\t}\n\tif rec.Synthetic || c.d.Effects.DryRun() {\n\t\tc.d.log().Info(\"closeout: raw log kept (dry-run)\", \"job\", rec.Job.ID)\n\t} else {\n\t\tc.dropRawLog(rec)\n\t}\n\treturn rec.Plan.Outcome, nil\n}\n\n// commit hands the staged files to the committer. A permanent error (the\n// committer already retried) turns the job into a failure with no files.\nfunc (c *Closer) commit(ctx context.Context, rec *Record) error {\n\tp := &rec.Plan\n\tif len(p.Files) == 0 {\n\t\treturn nil\n\t}\n\treq := committer.Request{Issue: rec.Job.Issue, Stage: rec.Job.Stage, Role: rec.Job.Role,\n\t\tSummary: commitSummary(*p), JobID: rec.Job.ID}\n\tsec := sectionOf(c.d.Roles, rec.Job.Stage, rec.Job.Role)\n\tplanPath := fmt.Sprintf(\".ard/%d/plan.md\", rec.Job.Issue)\n\tfor _, f := range p.Files {\n\t\tcf := committer.File{Path: f.Path, Delete: f.Delete}\n\t\tif !f.Delete {\n\t\t\tcf.Src = f.Staged\n\t\t\tif sec != \"\" && f.Path == planPath && rec.Job.Branch == \"\" {\n\t\t\t\tcf.Merge = mergeOwnSection(sec)\n\t\t\t}\n\t\t}\n\t\treq.Files = append(req.Files, cf)\n\t}\n\tres, err := c.d.Committer.Commit(ctx, rec.Job.Branch, req)\n\tswitch {\n\tcase err == nil:\n\t\trec.SHA, rec.Synthetic = res.SHA, res.Synthetic\n\t\treturn nil\n\tcase errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded):\n\t\treturn err\n\t}\n\tc.d.log().Warn(\"closeout: commit failed\", \"job\", rec.Job.ID, \"error\", err)\n\tif p.Outcome == OutcomeRetry || p.Outcome == OutcomeLimited {\n\t\t// The log is evidence, not the result: a retry or a limit stop must\n\t\t// not turn into a failure because it could not be committed (a worker\n\t\t// that stopped before its first push has no branch to commit to).\n\t\tp.Files, p.LogPath = nil, \"\"\n\t\tp.Reason += \"; log not committed: \" + err.Error()\n\t\treturn nil\n\t}\n\ttail, tailWithheld, keep := p.Tail, p.TailWithheld, p.KeepUntil\n\tif errors.Is(err, committer.ErrMerge) {\n\t\t*p = needsHumanPlan(rec.Job, p.Status, \"plan.md conflict: \"+err.Error())\n\t} else {\n\t\t*p = failedPlan(rec.Job, \"commit failed: \"+err.Error(), p.LogWithheld)\n\t}\n\tp.Tail, p.TailWithheld, p.KeepUntil = tail, tailWithheld, keep\n\treturn nil\n}\n\nfunc commitSummary(p Plan) string {\n\tfor _, s := range []string{p.Summary, p.Reason} {\n\t\tif l := strings.TrimSpace(strings.SplitN(strings.TrimSpace(s), \"\\n\", 2)[0]); l != \"\" {\n\t\t\treturn l\n\t\t}\n\t}\n\treturn \"close-out \" + string(p.Outcome)\n}\n\n// request applies the next labels, grouped by target number.\nfunc (c *Closer) request(ctx context.Context, rec Record) error {\n\treturn c.addGrouped(ctx, rec.Plan.Requests)\n}\n\nfunc (c *Closer) addGrouped(ctx context.Context, ls []Label) error {\n\tvar order []int\n\tby := map[int][]string{}\n\tfor _, l := range ls {\n\t\tif _, ok := by[l.Number]; !ok {\n\t\t\torder = append(order, l.Number)\n\t\t}\n\t\tby[l.Number] = append(by[l.Number], l.Name)\n\t}\n\tfor _, n := range order {\n\t\tif err := c.d.Effects.AddLabels(ctx, n, by[n]...); err != nil {\n\t\t\treturn fmt.Errorf(\"add labels on #%d: %w\", n, err)\n\t\t}\n\t}\n\treturn nil\n}\n\n// comment posts the summary once; the marker makes a replay find it.\nfunc (c *Closer) comment(ctx context.Context, rec *Record) error {\n\tif rec.Plan.Review != nil {\n\t\treturn c.postReview(ctx, rec)\n\t}\n\tn := rec.Job.target()\n\tif n > 0 && c.d.Comments != nil {\n\t\tcs, err := c.d.Comments.ListComments(ctx, n, time.Time{})\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"list comments on #%d: %w\", n, err)\n\t\t}\n\t\tfor _, cm := range cs {\n\t\t\tif strings.HasPrefix(cm.Body, markerFor(rec.Job.ID)) {\n\t\t\t\trec.CommentID = cm.ID\n\t\t\t\treturn nil\n\t\t\t}\n\t\t}\n\t}\n\tcm, err := c.d.Effects.CreateComment(ctx, n, RenderComment(*rec, c.d.Repo, c.d.Effects.DryRun()))\n\tif err != nil {\n\t\treturn fmt.Errorf(\"comment on #%d: %w\", n, err)\n\t}\n\trec.CommentID = cm.ID\n\treturn nil\n}\n\n// postReview posts a review job's summary and findings once: one PR review\n// with inline comments, else (GitHub answers 422: a line or the commit is not\n// in the PR) one review with every finding in its body, else a plain comment.\n// A 422 created nothing, so a replay walks the same chain. Any other error is\n// returned and the close-out stays resumable. The marker in the body makes a\n// replay after a crash find an earlier post.\nfunc (c *Closer) postReview(ctx context.Context, rec *Record) error {\n\tj, rp := rec.Job, rec.Plan.Review\n\tn := j.target()\n\tif n > 0 && c.d.Comments != nil {\n\t\trs, err := c.d.Comments.ListReviews(ctx, n)\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"list reviews on #%d: %w\", n, err)\n\t\t}\n\t\tfor _, r := range rs {\n\t\t\tif strings.HasPrefix(r.Body, markerFor(j.ID)) {\n\t\t\t\trec.CommentID, rec.ReviewMode = r.ID, ReviewFound\n\t\t\t\treturn nil\n\t\t\t}\n\t\t}\n\t\tcs, err := c.d.Comments.ListComments(ctx, n, time.Time{})\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"list comments on #%d: %w\", n, err)\n\t\t}\n\t\tfor _, cm := range cs {\n\t\t\tif strings.HasPrefix(cm.Body, markerFor(j.ID)) {\n\t\t\t\trec.CommentID, rec.ReviewMode = cm.ID, ReviewFound\n\t\t\t\treturn nil\n\t\t\t}\n\t\t}\n\t}\n\tdry := c.d.Effects.DryRun()\n\trejected := func(err error) bool {\n\t\tvar he *github.HTTPError\n\t\treturn errors.As(err, &he) && he.Status == 422\n\t}\n\tinline := inlineComments(rp)\n\tif len(inline) > 0 {\n\t\trid, err := c.d.Effects.CreateReview(ctx, n, github.ReviewInput{CommitSHA: rp.CommitSHA,\n\t\t\tBody: RenderReview(*rec, c.d.Repo, dry, false), Comments: inline})\n\t\tif err == nil {\n\t\t\trec.CommentID, rec.ReviewMode = rid, ReviewInline\n\t\t\treturn nil\n\t\t}\n\t\tif !rejected(err) {\n\t\t\treturn fmt.Errorf(\"review on #%d: %w\", n, err)\n\t\t}\n\t\tc.d.log().Warn(\"closeout.review_inline_rejected\", \"job\", j.ID, \"pr\", n, \"error\", err)\n\t}\n\tbody := RenderReview(*rec, c.d.Repo, dry, len(inline) > 0)\n\trid, err := c.d.Effects.CreateReview(ctx, n, github.ReviewInput{CommitSHA: rp.CommitSHA, Body: body})\n\tif err == nil {\n\t\trec.CommentID, rec.ReviewMode = rid, ReviewBody\n\t\treturn nil\n\t}\n\tif !rejected(err) {\n\t\treturn fmt.Errorf(\"review on #%d: %w\", n, err)\n\t}\n\tc.d.log().Warn(\"closeout.review_rejected\", \"job\", j.ID, \"pr\", n, \"error\", err)\n\tcm, err := c.d.Effects.CreateComment(ctx, n, body)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"comment on #%d: %w\", n, err)\n\t}\n\trec.CommentID, rec.ReviewMode = cm.ID, ReviewComment\n\treturn nil\n}\n\n// finish swaps the labels (\":running\" is removed last, so it marks the commit\n// point) and closes the job in state.\nfunc (c *Closer) finish(ctx context.Context, rec Record) error {\n\tp := rec.Plan\n\tif err := c.addGrouped(ctx, p.Terminal); err != nil {\n\t\treturn err\n\t}\n\tfor _, l := range p.Remove {\n\t\tif err := c.d.Effects.RemoveLabel(ctx, l.Number, l.Name); err != nil {\n\t\t\treturn fmt.Errorf(\"remove %s on #%d: %w\", l.Name, l.Number, err)\n\t\t}\n\t}\n\tvar cost *float64\n\tif rec.Job.CostUSD > 0 {\n\t\tv := rec.Job.CostUSD\n\t\tcost = &v\n\t}\n\tkeep := p.KeepUntil\n\tif keep.IsZero() {\n\t\tkeep = c.d.now().Add(failedKeep)\n\t}\n\tvar err error\n\tswitch p.Outcome {\n\tcase OutcomeFailed:\n\t\terr = c.d.Store.Fail(ctx, rec.Job.ID, clip(p.Reason, maxReasonRunes), keep)\n\tcase OutcomeRetry:\n\t\terr = c.d.Store.FailRetry(ctx, rec.Job.ID, clip(p.Reason, maxReasonRunes), keep)\n\tcase OutcomeLimited:\n\t\terr = c.d.Store.FailLimited(ctx, rec.Job.ID, clip(p.Reason, maxReasonRunes), keep)\n\tdefault:\n\t\terr = c.d.Store.Complete(ctx, rec.Job.ID, cost)\n\t}\n\tif err != nil {\n\t\treturn fmt.Errorf(\"close job in state: %w\", err)\n\t}\n\treturn nil\n}\n\n// dropRawLog deletes the unredacted host log once its redacted copy has been\n// committed. It is kept, and the keep is logged, when redaction failed or the\n// scan flagged it (so a human can inspect it) or when the commit did not\n// carry it.\nfunc (c *Closer) dropRawLog(rec Record) {\n\tj := rec.Job\n\tcommitted := map[string]bool{}\n\tfor _, p := range rec.Plan.ExtraLogPaths {\n\t\tcommitted[p] = true\n\t}\n\tdrop := func(path string, ok bool) {\n\t\tif !ok {\n\t\t\tc.d.log().Warn(\"closeout: raw log kept\", \"job\", j.ID, \"path\", path, \"withheld\", rec.Plan.LogWithheld)\n\t\t\treturn\n\t\t}\n\t\tif err := os.Remove(path); err != nil && !errors.Is(err, os.ErrNotExist) {\n\t\t\tc.d.log().Warn(\"closeout: remove raw log\", \"job\", j.ID, \"path\", path, \"error\", err)\n\t\t}\n\t}\n\tif j.LogPath != \"\" {\n\t\tdrop(j.LogPath, rec.Plan.LogPath != \"\")\n\t}\n\tfor _, extra := range j.ExtraLogs {\n\t\tcp, err := redact.CommitPath(rec.Job.Issue, extra)\n\t\tdrop(extra, err == nil && committed[cp])\n\t}\n}\npackage closeout\n\nimport (\n\t\"fmt\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/labels\"\n)\n\n// Outcome is what close-out decided about a job.\ntype Outcome string\n\nconst (\n\tOutcomeDone       Outcome = \"done\"\n\tOutcomeChanges    Outcome = \"changes\"\n\tOutcomeNeedsHuman Outcome = \"needs-human\"\n\tOutcomeFailed     Outcome = \"failed\"\n\t// OutcomeStale is a review whose verdict was approve but whose PR gained\n\t// code after the reviewed commit. The review is posted, no pass label is\n\t// set and the request label stays, so the review runs again.\n\tOutcomeStale Outcome = \"stale\"\n\t// OutcomeRetry is a failure with a named transient cause. The job hands\n\t// off to one automatic retry: it gets no ard:executor:failed and keeps its\n\t// request label, so the next claim runs it again as a new job.\n\tOutcomeRetry Outcome = \"retry\"\n\t// OutcomeLimited is a stop at a subscription usage limit. Its labels are\n\t// those of OutcomeRetry: no ard:executor:failed, the request label stays,\n\t// and the issue is claimed again once the pool's pause for the limit ends.\n\t// It neither uses up nor grants the automatic retry.\n\tOutcomeLimited Outcome = \"usage-limit\"\n)\n\n// Label is a label name with the issue or PR number it goes on.\ntype Label struct {\n\tNumber int\n\tName   string\n}\n\n// FileRef is one file of the commit set. Staged is the host path of the\n// cleaned bytes; Resume reads only that, never the worktree.\ntype FileRef struct {\n\tPath   string // repo-relative, slash form: .ard/<n>/<stage>-<role>.md\n\tStaged string\n\tDelete bool\n}\n\n// Plan is everything close-out will do, decided before any side effect.\ntype Plan struct {\n\tOutcome     Outcome\n\tStatus      string // raw status of the role file, for the comment header\n\tReason      string // failure or withhold reason; never secret text\n\tRequests    []Label\n\tTerminal    []Label // added in order\n\tRemove      []Label // removed in order; Running is last\n\tDeferred    []NextReq\n\tWorker      string // the lead's validated worker choice, for the Phase 1 gate\n\tSkipped     []Skip\n\tFiles       []FileRef\n\tLogWithheld bool\n\tLogPath     string // committed log path when it is in Files\n\t// ExtraLogPaths are the committed paths of Job.ExtraLogs, in order.\n\tExtraLogPaths []string\n\tSummary       string // redacted role file summary, for the comment\n\t// Review is set for a review that reached a verdict: close-out posts one\n\t// PR review instead of a plain comment.\n\tReview   *ReviewPlan\n\tRolePath string // committed role file path, \"\" when none\n\n\t// Tail is the last lines of the redacted log, for a failed or retry\n\t// comment. It is \"\" when there is no log, when the log was withheld, or\n\t// when the tail did not pass a second redaction (TailWithheld).\n\tTail         string\n\tTailWithheld bool\n\t// KeepUntil is when the resources of a failed or retry job may be removed\n\t// (zero on records from before the Reaper: close-out then uses 24 h).\n\tKeepUntil time.Time\n}\n\n// target returns the number labels for this job go on: the PR for a review,\n// the issue otherwise.\nfunc (j Job) target() int {\n\tif j.Stage == StageReview {\n\t\treturn j.PR\n\t}\n\treturn j.Issue\n}\n\n// Build maps a validated role file to a plan, with no files. It is pure.\nfunc Build(j Job, rf RoleFile, rs RoleSet) Plan {\n\tp := Plan{Status: rf.Status}\n\tn := j.target()\n\trun := Label{n, labels.Running(labels.Stage(j.Stage), j.Role)}\n\tswitch {\n\tcase rf.Status != StatusDone:\n\t\tp.Outcome = OutcomeNeedsHuman\n\t\tp.Terminal = []Label{{n, labels.NeedsHuman}}\n\t\tp.Remove = []Label{run}\n\tcase j.Stage == StageReview && rf.Verdict == VerdictChanges:\n\t\tp.Outcome = OutcomeChanges\n\t\tp.Terminal = []Label{{n, labels.Changes(j.Role)}}\n\t\tp.Remove = []Label{{n, labels.Done(labels.Stage(j.Stage), j.Role)}, run}\n\tcase j.Stage == StageReview && rf.Verdict == VerdictApprove && (j.Review == nil || j.Review.HeadMoved):\n\t\t// An approve of a head that has since gained code is not a pass. With\n\t\t// no review context (a Reaper close-out after a restart) the head is\n\t\t// unknown, so it is treated as moved.\n\t\tp.Outcome = OutcomeStale\n\t\tp.Remove = []Label{run}\n\tcase j.Stage == StageWorker:\n\t\tp = buildWorker(j, rf, rs)\n\tdefault:\n\t\tp.Outcome = OutcomeDone\n\t\tp.Terminal = []Label{{n, labels.Done(labels.Stage(j.Stage), j.Role)}}\n\t\tif j.Stage == StageReview {\n\t\t\tp.Remove = append(p.Remove, Label{n, labels.Changes(j.Role)})\n\t\t}\n\t\tif j.Stage == StageTriage && j.Role == \"lead\" {\n\t\t\tp.Remove = append(p.Remove, Label{n, labels.Pending})\n\t\t}\n\t\tp.Remove = append(p.Remove, run)\n\t\tnow, deferred, skipped := resolveNext(j, rf.Next, rs)\n\t\tp.Deferred, p.Skipped = deferred, skipped\n\t\tfor _, r := range now {\n\t\t\tnum := j.Issue\n\t\t\tif r.Stage == StageReview {\n\t\t\t\tnum = j.PR\n\t\t\t}\n\t\t\tp.Requests = append(p.Requests, Label{num, labels.Request(labels.Stage(r.Stage), r.Role)})\n\t\t}\n\t\tif rf.Worker != \"\" {\n\t\t\tif hasRole(rs, StageWorker, rf.Worker) {\n\t\t\t\tp.Worker = rf.Worker\n\t\t\t} else {\n\t\t\t\tp.Skipped = append(p.Skipped, Skip{\"worker:\" + clip(rf.Worker, 60), \"no such role\"})\n\t\t\t}\n\t\t}\n\t}\n\treturn p\n}\n\n// failedPlan is the plan for a job that did not produce a usable result.\nfunc failedPlan(j Job, reason string, logWithheld bool) Plan {\n\tn := j.target()\n\tp := Plan{Outcome: OutcomeFailed, Reason: reason, LogWithheld: logWithheld,\n\t\tTerminal: []Label{{n, labels.ExecutorFailed}},\n\t\tRemove:   []Label{{n, labels.Running(labels.Stage(j.Stage), j.Role)}}}\n\tif logWithheld {\n\t\tp.Terminal = append(p.Terminal, Label{n, labels.NeedsHuman})\n\t}\n\treturn p\n}\n\n// retryPlan is the plan for a job that failed for a transient cause and hands\n// off to one automatic retry. It removes only :running and leaves the request\n// label alone: a human who removed it to cancel stays cancelled.\nfunc retryPlan(j Job, reason string) Plan {\n\tn := j.target()\n\tst := labels.Stage(j.Stage)\n\treturn Plan{Outcome: OutcomeRetry, Reason: reason,\n\t\tRemove: []Label{{n, labels.Running(st, j.Role)}}}\n}\n\n// limitedPlan is the plan for a job that stopped at a usage limit. It has\n// retryPlan's labels: it removes only :running, leaves the request label alone\n// and adds no terminal label. What differs is the state change (FailLimited)\n// and that it does not touch the automatic retry.\nfunc limitedPlan(j Job, reason string) Plan {\n\tp := retryPlan(j, reason)\n\tp.Outcome = OutcomeLimited\n\treturn p\n}\n\n// needsHumanPlan is the plan for a job held back by the secret scan.\nfunc needsHumanPlan(j Job, status, reason string) Plan {\n\tn := j.target()\n\treturn Plan{Outcome: OutcomeNeedsHuman, Status: status, Reason: reason, LogWithheld: false,\n\t\tTerminal: []Label{{n, labels.NeedsHuman}},\n\t\tRemove:   []Label{{n, labels.Running(labels.Stage(j.Stage), j.Role)}}}\n}\n\nfunc (j Job) validate() error {\n\tswitch j.Stage {\n\tcase StageTriage, StageWorker, StageReview:\n\tdefault:\n\t\treturn fmt.Errorf(\"closeout job %s: stage %q is not triage, worker or review\", j.ID, j.Stage)\n\t}\n\tif j.ID == \"\" || j.Role == \"\" || j.Issue == 0 {\n\t\treturn fmt.Errorf(\"closeout job %q: id, role and issue are required\", j.ID)\n\t}\n\tif j.Cause.Kind != \"\" {\n\t\t// A job that ended for a known cause commits only its log: it needs\n\t\t// neither a base commit nor a branch (an empty branch puts the log on\n\t\t// main under .ard/<issue#>/logs/).\n\t\treturn nil\n\t}\n\tif j.ExitCode == 0 && j.BaseSHA == \"\" {\n\t\treturn fmt.Errorf(\"closeout job %s: BaseSHA is required to find the changed files\", j.ID)\n\t}\n\tif j.Stage == StageReview && j.PR == 0 {\n\t\treturn fmt.Errorf(\"closeout job %s: a review needs a PR\", j.ID)\n\t}\n\t// A worker that stops before its first push has no branch: its role file\n\t// and log go to main, as triage's do.\n\tif j.Stage == StageReview && j.Branch == \"\" {\n\t\treturn fmt.Errorf(\"closeout job %s: a review job needs a branch\", j.ID)\n\t}\n\treturn nil\n}\npackage closeout\n\nimport (\n\t\"fmt\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/gitx\"\n)\n\nconst (\n\tmaxInlineRunes   = 2000\n\tmaxBulletRunes   = 300\n\tmaxReviewRunes   = 60000\n\treviewFooterRoom = 2000 // runes kept free for the closing lines\n)\n\n// Review modes: how the review reached GitHub.\nconst (\n\tReviewInline  = \"inline\"  // one PR review with inline comments\n\tReviewBody    = \"body\"    // a PR review with every finding in its body\n\tReviewComment = \"comment\" // a plain PR comment (GitHub took no review)\n\tReviewFound   = \"found\"   // an earlier post was found; nothing was posted\n)\n\n// ReviewContext is what the reviewer loop knows that the role file cannot say.\n// Added is used by Prepare only and is not persisted: the plan keeps the\n// decided placement.\ntype ReviewContext struct {\n\t// MergeBase is the commit the diff was taken against.\n\tMergeBase string\n\t// Added is, per path, the head-side line ranges the PR added.\n\tAdded map[string][]gitx.LineRange `json:\"-\"`\n\t// HeadMoved is set when the PR gained code (anything outside .ard/) after\n\t// the commit the review pinned. An approve is then not a pass: the review\n\t// is posted but no label says done, so the request stays and runs again.\n\tHeadMoved bool\n}\n\n// ReviewPlan is the PR review close-out posts for a review job that reached a\n// verdict.\ntype ReviewPlan struct {\n\tCommitSHA string // the pinned commit the agent reviewed\n\tVerdict   string // after any downgrade\n\t// Downgraded: the role file said approve but carried a blocking finding.\n\tDowngraded bool\n\tHeadMoved  bool\n\tInline     []Finding // on lines the PR added: posted as inline comments\n\tOther      []Finding // everything else: listed in the review body\n\t// NoLines: the added lines were not known (a Reaper close-out after a\n\t// restart), so every finding is in Other.\n\tNoLines bool\n}\n\n// reviewPlan splits the findings of a review by whether their line is one the\n// PR added.\nfunc reviewPlan(j Job, verdict string, downgraded bool, fs []Finding) *ReviewPlan {\n\trp := &ReviewPlan{CommitSHA: j.BaseSHA, Verdict: verdict, Downgraded: downgraded}\n\tif j.Review == nil {\n\t\trp.NoLines, rp.HeadMoved = true, true\n\t\trp.Other = append(rp.Other, fs...)\n\t\treturn rp\n\t}\n\trp.HeadMoved = j.Review.HeadMoved\n\tfor _, f := range fs {\n\t\tif f.Line > 0 && inRanges(f.Line, j.Review.Added[f.File]) {\n\t\t\trp.Inline = append(rp.Inline, f)\n\t\t} else {\n\t\t\trp.Other = append(rp.Other, f)\n\t\t}\n\t}\n\treturn rp\n}\n\nfunc inRanges(line int, rs []gitx.LineRange) bool {\n\tfor _, r := range rs {\n\t\tif line >= r.From && line <= r.To {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc findingTag(f Finding) string {\n\tb := \"non-blocking\"\n\tif f.Blocking {\n\t\tb = \"blocking\"\n\t}\n\treturn fmt.Sprintf(\"**%s · %s**\", f.Severity, b)\n}\n\n// inlineBody is the text of one inline comment.\nfunc inlineBody(f Finding) string {\n\treturn findingTag(f) + \"\\n\\n\" + sanitize(cutRunes(f.Message, maxInlineRunes))\n}\n\nfunc cutRunes(s string, n int) string {\n\tif r := []rune(s); len(r) > n {\n\t\treturn string(r[:n-1]) + \"…\"\n\t}\n\treturn s\n}\n\nfunc bullet(f Finding) string {\n\tloc := f.File\n\tif f.Line > 0 {\n\t\tloc = fmt.Sprintf(\"%s:%d\", f.File, f.Line)\n\t}\n\tfirst := strings.TrimSpace(strings.SplitN(strings.TrimSpace(f.Message), \"\\n\", 2)[0])\n\treturn fmt.Sprintf(\"- %s %s %s\", findingTag(f), codeSpan(loc, 340), sanitize(cutRunes(first, maxBulletRunes)))\n}\n\n// inlineComments builds the inline comments of a review plan.\nfunc inlineComments(rp *ReviewPlan) []github.InlineComment {\n\tout := make([]github.InlineComment, 0, len(rp.Inline))\n\tfor _, f := range rp.Inline {\n\t\tout = append(out, github.InlineComment{Path: f.File, Line: f.Line, Side: \"RIGHT\", Body: inlineBody(f)})\n\t}\n\treturn out\n}\n\n// RenderReview builds the body of the PR review (or of the plain comment that\n// replaces it). With allInBody every finding is listed in the body, for the\n// fallbacks that carry no inline comments. The body is at most 60,000 runes.\nfunc RenderReview(r Record, repo github.Repo, dryRun, allInBody bool) string {\n\tj, p := r.Job, r.Plan\n\trp := p.Review\n\tvar b strings.Builder\n\tb.WriteString(marker(j.ID, j.Attempt) + \"\\n\")\n\tfmt.Fprintf(&b, \"**ard · review:%s · %s**\\n\", j.Role, rp.Verdict)\n\tif s := strings.TrimSpace(p.Summary); s != \"\" {\n\t\tb.WriteString(\"\\n\" + sanitize(cutSummary(s)) + \"\\n\")\n\t}\n\tvar notes []string\n\tif rp.Downgraded {\n\t\tnotes = append(notes, \"The review approved but listed a blocking finding, so ard treats it as changes requested.\")\n\t}\n\tif rp.HeadMoved {\n\t\tnotes = append(notes, \"The branch gained code after this commit was reviewed. The review stays requested and runs again on the new head.\")\n\t}\n\tif len(notes) > 0 {\n\t\tb.WriteString(\"\\n\" + strings.Join(notes, \"\\n\") + \"\\n\")\n\t}\n\tlist, heading := rp.Other, \"Findings outside the changed lines:\"\n\tswitch {\n\tcase allInBody:\n\t\tlist = append(append([]Finding(nil), rp.Inline...), rp.Other...)\n\t\theading = \"Findings:\"\n\tcase rp.NoLines:\n\t\theading = \"Findings (line placement unavailable):\"\n\t}\n\tif len(list) > 0 {\n\t\tb.WriteString(\"\\n\" + heading + \"\\n\")\n\t\tused := len([]rune(b.String()))\n\t\tfor i, f := range list {\n\t\t\tline := bullet(f)\n\t\t\tif used+len([]rune(line))+1 > maxReviewRunes-reviewFooterRoom {\n\t\t\t\tfmt.Fprintf(&b, \"- … and %d more in the committed file\\n\", len(list)-i)\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tb.WriteString(line + \"\\n\")\n\t\t\tused += len([]rune(line)) + 1\n\t\t}\n\t}\n\tvar lines []string\n\tif sha := rp.CommitSHA; sha != \"\" {\n\t\tif len(sha) > 12 {\n\t\t\tsha = sha[:12]\n\t\t}\n\t\tlines = append(lines, fmt.Sprintf(\"Reviewed commit `%s`\", sha))\n\t}\n\tif out := outputLine(r, repo, dryRun); out != \"\" {\n\t\tlines = append(lines, out)\n\t}\n\tif len(lines) > 0 {\n\t\tb.WriteString(\"\\n\" + strings.Join(lines, \"\\n\") + \"\\n\")\n\t}\n\treturn b.String()\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_017kjAEA1znJ1yBBUqAxox4d","per