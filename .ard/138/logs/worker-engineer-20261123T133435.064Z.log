{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LdXRW1bCABhHXBMrDbmprb","type":"tool_result","content":"package committer\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"syscall\"\n)\n\n// File is one change in a Request. Exactly one of Data, Src or Delete is set.\ntype File struct {\n\tPath   string // repo-relative, slash-separated, canonical: \".ard/12/issue.md\"\n\tData   []byte // literal contents\n\tSrc    string // absolute host path; read into memory before the request waits on the lane\n\tDelete bool   // remove the path; a path already absent is fine\n}\n\n// Request is one commit: one issue, one stage:role, one summary, a file set.\ntype Request struct {\n\tIssue   int    // > 0; < 0 only in dry-run (synthetic issue)\n\tStage   string // matches ^[a-z][a-z0-9-]*$\n\tRole    string // matches ^[a-z0-9][a-z0-9-]*$\n\tSummary string // untrusted; sanitised by Message\n\tJobID   string // optional; adds an \"Ard-Job: <id>\" trailer\n\tFiles   []File // 1..MaxFiles entries, unique paths\n}\n\n// Result is the outcome of a Commit.\ntype Result struct {\n\tSHA       string // the new commit; for NoOp, the upstream head\n\tNoOp      bool   // the tree already matched: nothing was committed or pushed\n\tSynthetic bool   // dry-run: SHA is synthetic and nothing reached the remote\n\tAttempts  int    // pushes tried\n}\n\n// MaxFiles bounds one request.\nconst MaxFiles = 256\n\nvar (\n\tstageRe = regexp.MustCompile(`^[a-z][a-z0-9-]*$`)\n\troleRe  = regexp.MustCompile(`^[a-z0-9][a-z0-9-]*$`)\n\tjobRe   = regexp.MustCompile(`^[0-9A-Za-z]{1,64}$`)\n)\n\n// snapshot validates req against issue (the number the paths must carry) and\n// returns a copy whose Src files have been read into memory. Every path\n// violation is reported in one *GuardError.\nfunc snapshot(req Request, issue int) (Request, error) {\n\tswitch {\n\tcase !stageRe.MatchString(req.Stage):\n\t\treturn req, fmt.Errorf(\"%w: bad stage %q\", ErrInvalid, req.Stage)\n\tcase !roleRe.MatchString(req.Role):\n\t\treturn req, fmt.Errorf(\"%w: bad role %q\", ErrInvalid, req.Role)\n\tcase req.JobID != \"\" && !jobRe.MatchString(req.JobID):\n\t\treturn req, fmt.Errorf(\"%w: bad job id\", ErrInvalid)\n\tcase len(req.Files) == 0:\n\t\treturn req, fmt.Errorf(\"%w: no files\", ErrInvalid)\n\tcase len(req.Files) > MaxFiles:\n\t\treturn req, fmt.Errorf(\"%w: %d files, max %d\", ErrInvalid, len(req.Files), MaxFiles)\n\t}\n\tge := &GuardError{}\n\tout := req\n\tout.Files = make([]File, len(req.Files))\n\tseen := map[string]bool{}\n\tfor i, f := range req.Files {\n\t\tout.Files[i] = f\n\t\tif err := CheckPath(issue, f.Path); err != nil {\n\t\t\tge.add(f.Path, err.Error())\n\t\t\tcontinue\n\t\t}\n\t\tif seen[f.Path] {\n\t\t\treturn req, fmt.Errorf(\"%w: duplicate path %q\", ErrInvalid, f.Path)\n\t\t}\n\t\tseen[f.Path] = true\n\t\tkinds := 0\n\t\tif f.Data != nil {\n\t\t\tkinds++\n\t\t}\n\t\tif f.Src != \"\" {\n\t\t\tkinds++\n\t\t}\n\t\tif f.Delete {\n\t\t\tkinds++\n\t\t}\n\t\tif kinds > 1 || (kinds == 0 && f.Data == nil) {\n\t\t\treturn req, fmt.Errorf(\"%w: %q needs exactly one of Data, Src, Delete\", ErrInvalid, f.Path)\n\t\t}\n\t\tswitch {\n\t\tcase len(f.Data) > MaxFileBytes:\n\t\t\tge.add(f.Path, \"larger than 1 MiB\")\n\t\tcase f.Src != \"\":\n\t\t\tb, err := readSrc(f.Src)\n\t\t\tvar pe *guardReason\n\t\t\tswitch {\n\t\t\tcase errors.As(err, &pe):\n\t\t\t\tge.add(f.Path, pe.msg)\n\t\t\tcase err != nil:\n\t\t\t\treturn req, fmt.Errorf(\"%w: src %q: %v\", ErrInvalid, f.Src, err)\n\t\t\tdefault:\n\t\t\t\tout.Files[i].Data, out.Files[i].Src = b, \"\"\n\t\t\t}\n\t\t}\n\t}\n\tif len(ge.Paths) > 0 {\n\t\treturn req, ge\n\t}\n\treturn out, nil\n}\n\ntype guardReason struct{ msg string }\n\nfunc (g *guardReason) Error() string { return g.msg }\n\n// readSrc reads a host file without following symlinks, in the path or at the\n// end of it, and without trusting an earlier Lstat.\nfunc readSrc(src string) ([]byte, error) {\n\treal, err := filepath.EvalSymlinks(src)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif real != filepath.Clean(src) {\n\t\treturn nil, &guardReason{\"src path involves a symlink\"}\n\t}\n\tf, err := os.OpenFile(src, os.O_RDONLY|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0)\n\tif err != nil {\n\t\tif errors.Is(err, syscall.ELOOP) {\n\t\t\treturn nil, &guardReason{\"src is a symlink\"}\n\t\t}\n\t\treturn nil, err\n\t}\n\tdefer f.Close()\n\tfi, err := f.Stat()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif !fi.Mode().IsRegular() {\n\t\treturn nil, &guardReason{\"src is not a regular file\"}\n\t}\n\tb, err := io.ReadAll(io.LimitReader(f, MaxFileBytes+1))\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif len(b) > MaxFileBytes {\n\t\treturn nil, &guardReason{\"larger than 1 MiB\"}\n\t}\n\tif b == nil {\n\t\tb = []byte{}\n\t}\n\treturn b, nil\n}\npackage committer\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"strings\"\n)\n\nvar (\n\t// ErrInvalid is a malformed request.\n\tErrInvalid = errors.New(\"committer: invalid request\")\n\t// ErrGuard is a path outside .ard/<issue#>/ (or an unsafe file kind).\n\tErrGuard = errors.New(\"committer: path guard\")\n\t// ErrConflict means upstream changed one of the request's paths since the\n\t// base the request was applied to. It is never retried or overwritten.\n\tErrConflict = errors.New(\"committer: upstream changed a requested path\")\n\t// ErrBranchGone means the remote branch does not exist.\n\tErrBranchGone = errors.New(\"committer: remote branch does not exist\")\n\t// ErrInitExists means the ard-init branch already exists on the remote, so\n\t// ard init refuses to propose again.\n\tErrInitExists = errors.New(\"committer: branch ard-init already exists on the remote\")\n\t// ErrClosed means Commit was called after Close.\n\tErrClosed = errors.New(\"committer: closed\")\n)\n\n// GuardError lists every offending path of a request.\ntype GuardError struct {\n\tPaths   []string\n\tReasons []string\n}\n\nfunc (e *GuardError) Error() string {\n\tparts := make([]string, len(e.Paths))\n\tfor i := range e.Paths {\n\t\tparts[i] = fmt.Sprintf(\"%q: %s\", e.Paths[i], e.Reasons[i])\n\t}\n\treturn \"committer: path guard: \" + strings.Join(parts, \"; \")\n}\n\nfunc (e *GuardError) Unwrap() error { return ErrGuard }\n\nfunc (e *GuardError) add(p, reason string) {\n\te.Paths = append(e.Paths, p)\n\te.Reasons = append(e.Reasons, reason)\n}\n190:\tres, err = l.run(ctx, snapOf(snap, msg))\n197:// snapFile is one validated change, ready to apply.\n198:type snapFile struct {\n208:\tfiles    []snapFile\n229:// snapOf converts a validated .ard Request. Its files are never executable.\n230:func snapOf(req Request, msg string) snap {\n234:\t\ts.files = append(s.files, snapFile{path: f.Path, data: f.Data, del: f.Delete})\n297:func (l *lane) attempt(ctx context.Context, s snap, base string, create bool) (res Result, retry bool, err error) {\n328:\t\tif err := os.WriteFile(full, f.data, 0o644); err != nil {\npackage closeout\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"sort\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/agent\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n)\n\n// Writable is what one job may change under .ard/<n>/. Close-out never\n// collects logs/, so it is not listed.\ntype Writable struct {\n\tRoleFile string   // .ard/<n>/<stage>-<role>.md\n\tPrefixes []string // directory prefixes ending in \"/\", e.g. \".ard/7/design/\"\n\tSection  string   // the plan.md heading this role owns, without \"## \"; \"\" = plan.md not writable\n}\n\n// WritableFor returns the write allowlist of a job. n must already be\n// positive (Prepare passes the dry-run-adjusted number). section is the\n// plan.md heading the role owns (config.Role.PlanSection); it is granted only\n// to triage roles.\nfunc WritableFor(n int, stage, role, section string) Writable {\n\tw := Writable{RoleFile: agent.RoleFilePath(n, stage, role)}\n\tif stage != StageTriage {\n\t\treturn w\n\t}\n\tw.Section = section\n\tif role == \"designer\" {\n\t\tw.Prefixes = []string{fmt.Sprintf(\".ard/%d/design/\", n)}\n\t}\n\treturn w\n}\n\n// sectionOf finds the plan.md section of a triage role in the loaded config.\nfunc sectionOf(rs RoleSet, stage, role string) string {\n\tif stage != StageTriage || rs == nil {\n\t\treturn \"\"\n\t}\n\tr, ok := rs.Role(config.KindTriage, role)\n\tif !ok {\n\t\treturn \"\"\n\t}\n\treturn r.PlanSection\n}\n\n// checkWrites returns \"\" when every candidate is allowed, or a reason that\n// names the first denied paths. Only a context error is returned as an error.\nfunc checkWrites(ctx context.Context, j Job, d Deps, n int, cands []candidate) (string, error) {\n\tw := WritableFor(n, j.Stage, j.Role, sectionOf(d.Roles, j.Stage, j.Role))\n\tplanPath := fmt.Sprintf(\".ard/%d/plan.md\", n)\n\tsorted := append([]candidate(nil), cands...)\n\tsort.Slice(sorted, func(a, b int) bool { return sorted[a].path < sorted[b].path })\n\n\ttype denial struct{ path, why string }\n\tvar denied []denial\n\tfor _, c := range sorted {\n\t\tif err := ctx.Err(); err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\tswitch {\n\t\tcase c.path == w.RoleFile:\n\t\tcase underPrefix(c.path, w.Prefixes):\n\t\tcase c.path == planPath && w.Section != \"\":\n\t\t\tif c.delete {\n\t\t\t\tdenied = append(denied, denial{c.path, \"deleted\"})\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tbase, ok, err := d.BaseFile(ctx, j.Worktree, j.BaseSHA, c.path, maxFileBytes)\n\t\t\tif err != nil {\n\t\t\t\tif cerr := ctx.Err(); cerr != nil {\n\t\t\t\t\treturn \"\", cerr\n\t\t\t\t}\n\t\t\t\tdenied = append(denied, denial{c.path, \"could not read it at base: \" + err.Error()})\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif why := checkPlan(base, ok, c.data, w.Section); why != \"\" {\n\t\t\t\tdenied = append(denied, denial{c.path, why})\n\t\t\t}\n\t\tdefault:\n\t\t\tdenied = append(denied, denial{c.path, fmt.Sprintf(\"not writable by %s:%s\", j.Stage, j.Role)})\n\t\t}\n\t}\n\tif len(denied) == 0 {\n\t\treturn \"\", nil\n\t}\n\