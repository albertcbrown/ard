 writes it, through the committer, not close-out), another role's file, any other file, or delete `plan.md`. A job that owns a `plan.md` section may add, replace in place, move or remove that section; a change to the text before the first `##` heading is allowed only when the job creates the file. Headings match exactly (case-sensitive), and `##` lines inside a fenced code block are text, not headings. A change outside the allowlist fails the job as `needs-human`: the comment names up to three offending paths, and only the redacted log is committed, never the offending files. A job with no valid role file still fails as `failed`, because the allowlist is checked after the role file parses. `logs/` is the controller's: files an agent writes there are ignored, not committed. `costs/` is the controller's too, but stricter: no role may write it, so an agent write there breaks the allowlist like any other path and fails the job as `needs-human`; the controller stages its own `costs/<job-id>.json` after that check, and it is never on `closeout.WritableFor`. The allowlist is code (`closeout.WritableFor`), not config; `plan_section` only names the heading a role owns. Workers and reviewers get their inputs outside `.ard/<issue#>/` (for example `.ard-input/<issue#>/`), because anything they write under it counts as their change. `issue.md` is the issue body without ard's cost block (see Guardrails), so the table never reaches an agent; the reviewer's untrusted `.ard/<issue#>/` input includes `costs/*.json`, which is controller-written and holds no free text.\n \n+Close-out checks `plan.md` against the job's base commit, but the committer writes it onto the latest `main`. So at commit time the committer replaces only the job's own `##` section in the current `main` copy (adding it at the end if absent, dropping it if the job removed it) and keeps every other section as `main` has it; a section another role committed after the job's base is not reverted. This runs again on each push retry. If the `main` copy cannot be merged (the job's heading appears twice, or its section holds a heading-like line), the job fails closed as `needs-human` with a `plan.md conflict` reason and only the log is committed.\n+\n The stage in a role file's name is the label stage (`triage`, `worker`, `review`; `config.Kind` and the role directory spell the last one `reviewer`), so a triage and a worker role with the same name never share a file.\n \n Every `<stage>-<role>.md` starts with frontmatter the controller reads, so the agent reports its outcome without touching GitHub:\ndiff --git a/internal/closeout/closeout.go b/internal/closeout/closeout.go\nindex ecb624f..9b620cc 100644\n--- a/internal/closeout/closeout.go\n+++ b/internal/closeout/closeout.go\n@@ -499,10 +499,15 @@ func (c *Closer) commit(ctx context.Context, rec *Record) error {\n \t}\n \treq := committer.Request{Issue: rec.Job.Issue, Stage: rec.Job.Stage, Role: rec.Job.Role,\n \t\tSummary: commitSummary(*p), JobID: rec.Job.ID}\n+\tsec := sectionOf(c.d.Roles, rec.Job.Stage, rec.Job.Role)\n+\tplanPath := fmt.Sprintf(\".ard/%d/plan.md\", rec.Job.Issue)\n \tfor _, f := range p.Files {\n \t\tcf := committer.File{Path: f.Path, Delete: f.Delete}\n \t\tif !f.Delete {\n \t\t\tcf.Src = f.Staged\n+\t\t\tif sec != \"\" && f.Path == planPath && rec.Job.Branch == \"\" {\n+\t\t\t\tcf.Merge = mergeOwnSection(sec)\n+\t\t\t}\n \t\t}\n \t\treq.Files = append(req.Files, cf)\n \t}\n@@ -524,7 +529,11 @@ func (c *Closer) commit(ctx context.Context, rec *Record) error {\n \t\treturn nil\n \t}\n \ttail, tailWithheld, keep := p.Tail, p.TailWithheld, p.KeepUntil\n-\t*p = failedPlan(rec.Job, \"commit failed: \"+err.Error(), p.LogWithheld)\n+\tif errors.Is(err, committer.ErrMerge) {\n+\t\t*p = needsHumanPlan(rec.Job, p.Status, \"plan.md conflict: \"+err.Error())\n+\t} else {\n+\t\t*p = failedPlan(rec.Job, \"commit failed: \"+err.Error(), p.LogWithheld)\n+\t}\n \tp.Tail, p.TailWithheld, p.KeepUntil = tail, tailWithheld, keep\n \treturn nil\n }\ndiff --git a/internal/closeout/closer_test.go b/internal/closeout/closer_test.go\nindex 0e63264..3c4bf56 100644\n--- a/internal/closeout/closer_test.go\n+++ b/internal/closeout/closer_test.go\n@@ -507,3 +507,51 @@ func TestRunWriteDenied(t *testing.T) {\n \t\tt.Errorf(\"comment not sanitised: %s\", b)\n \t}\n }\n+\n+// The plan.md of a triage job carries a merge func that keeps the sections\n+// other roles committed to main after the job's base.\n+func TestCommitMergesPlanSectionOntoMain(t *testing.T) {\n+\te := newEnv(t)\n+\te.write(\".ard/7/triage-engineer.md\", roleFile(\"engineer\", \"done\"))\n+\te.write(\".ard/7/plan.md\", \"## Implementation\\nsteps\\n\")\n+\tj := e.claim(StageTriage, \"engineer\")\n+\tif oc, err := New(e.d).Run(context.Background(), j); err != nil || oc != OutcomeDone {\n+\t\tt.Fatalf(\"outcome %q, err %v\", oc, err)\n+\t}\n+\tvar merge func([]byte, bool, []byte) ([]byte, error)\n+\tfor _, r := range e.cm.reqs {\n+\t\tfor _, f := range r.Files {\n+\t\t\tif f.Path == \".ard/7/plan.md\" {\n+\t\t\t\tmerge = f.Merge\n+\t\t\t}\n+\t\t}\n+\t}\n+\tif merge == nil {\n+\t\tt.Fatal(\"plan.md has no Merge func\")\n+\t}\n+\tgot, err := merge([]byte(\"## Requirements\\nv2\\n\"), true, []byte(\"## Implementation\\nsteps\\n\"))\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif !strings.Contains(string(got), \"v2\") || !strings.Contains(string(got), \"steps\") {\n+\t\tt.Errorf(\"merged = %q\", got)\n+\t}\n+}\n+\n+func TestCommitPlanConflictNeedsHuman(t *testing.T) {\n+\te := newEnv(t)\n+\te.cm.err = fmt.Errorf(\"%w: .ard/7/plan.md: section twice\", committer.ErrMerge)\n+\te.write(\".ard/7/triage-engineer.md\", roleFile(\"engineer\", \"done\"))\n+\te.write(\".ard/7/plan.md\", \"## Implementation\\nsteps\\n\")\n+\tj := e.claim(StageTriage, \"engineer\")\n+\trec, err := Prepare(context.Background(), j, e.d)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif err := New(e.d).commit(context.Background(), &rec); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif rec.Plan.Outcome != OutcomeNeedsHuman || !strings.Contains(rec.Plan.Reason, \"plan.md conflict\") {\n+\t\tt.Errorf(\"plan = %s: %s\", rec.Plan.Outcome, rec.Plan.Reason)\n+\t}\n+}\ndiff --git a/internal/closeout/plan_merge.go b/internal/closeout/plan_merge.go\nnew file mode 100644\nindex 0000000..70e9b09\n--- /dev/null\n+++ b/internal/closeout/plan_merge.go\n@@ -0,0 +1,61 @@\n+package closeout\n+\n+import (\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"strings\"\n+)\n+\n+// mergeOwnSection returns a committer merge func that puts the job's own\n+// plan.md section (own, without \"## \") into the copy at the latest head and\n+// keeps every other part of that copy, so a section another role committed\n+// after the job's base is not reverted. It fails closed when the head copy\n+// is ambiguous.\n+func mergeOwnSection(own string) func(cur []byte, exists bool, mine []byte) ([]byte, error) {\n+\treturn func(cur []byte, exists bool, mine []byte) ([]byte, error) {\n+\t\tif !exists {\n+\t\t\treturn mine, nil\n+\t\t}\n+\t\tvar mineSec string\n+\t\tfor _, s := range parsePlan(mine).sections {\n+\t\t\tif s.heading == own {\n+\t\t\t\tmineSec = s.text\n+\t\t\t\tbreak\n+\t\t\t}\n+\t\t}\n+\t\tc := parsePlan(cur)\n+\t\tn := 0\n+\t\tfor _, s := range c.sections {\n+\t\t\tif s.heading == own {\n+\t\t\t\tn++\n+\t\t\t\tif hasSetext(s.text) {\n+\t\t\t\t\treturn nil, errors.New(\"heading-like line in own section on main\")\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\t\tif n > 1 {\n+\t\t\treturn nil, fmt.Errorf(\"section ## %s appears twice on main\", clip(own, 80))\n+\t\t}\n+\t\tvar b strings.Builder\n+\t\temit := func(t string) {\n+\t\t\tb.WriteString(t)\n+\t\t\tif t != \"\" && !strings.HasSuffix(t, \"\\n\") && !strings.HasSuffix(t, \"\\r\") {\n+\t\t\t\tb.WriteString(\"\\n\")\n+\t\t\t}\n+\t\t}\n+\t\temit(c.pre)\n+\t\tfor _, s := range c.sections {\n+\t\t\tswitch {\n+\t\t\tcase s.heading != own:\n+\t\t\t\temit(s.text)\n+\t\t\tcase mineSec != \"\":\n+\t\t\t\temit(mineSec)\n+\t\t\t\tmineSec = \"\"\n+\t\t\t}\n+\t\t}\n+\t\tif mineSec != \"\" {\n+\t\t\temit(mineSec)\n+\t\t}\n+\t\treturn []byte(b.String()), nil\n+\t}\n+}\ndiff --git a/internal/closeout/plan_merge_test.go b/internal/closeout/plan_merge_test.go\nnew file mode 100644\nindex 0000000..fef15a8\n--- /dev/null\n+++ b/internal/closeout/plan_merge_test.go\n@@ -0,0 +1,35 @@\n+package closeout\n+\n+import \"testing\"\n+\n+func TestMergeOwnSection(t *testing.T) {\n+\tconst own = \"Implementation\"\n+\ttests := []struct {\n+\t\tname, cur, mine, want string\n+\t\texists, err           bool\n+\t}{\n+\t\t{\"other_section_changed_on_main\", \"## Requirements\\nv2\\n\", \"## Requirements\\nv1\\n## Implementation\\nnew\\n\",\n+\t\t\t\"## Requirements\\nv2\\n## Implementation\\nnew\\n\", true, false},\n+\t\t{\"own_replaced_in_place\", \"## Implementation\\nold\\n## Risk\\nr\\n\", \"## Implementation\\nnew\\n\",\n+\t\t\t\"## Implementation\\nnew\\n## Risk\\nr\\n\", true, false},\n+\t\t{\"own_removed_by_job\", \"## A\\na\\n## Implementation\\nold\\n\", \"## A\\na\\n\", \"## A\\na\\n\", true, false},\n+\t\t{\"cur_missing\", \"\", \"## Implementation\\nnew\\n\", \"## Implementation\\nnew\\n\", false, false},\n+\t\t{\"cur_unchanged\", \"## A\\na\\n## Implementation\\nold\\n\", \"## A\\na\\n## Implementation\\nnew\\n\",\n+\t\t\t\"## A\\na\\n## Implementation\\nnew\\n\", true, false},\n+\t\t{\"fenced_heading\", \"## A\\n```\\n## Implementation\\n```\\n\", \"## Implementation\\nnew\\n\",\n+\t\t\t\"## A\\n```\\n## Implementation\\n```\\n## Implementation\\nnew\\n\", true, false},\n+\t\t{\"missing_newline\", \"## A\\na\", \"## Implementation\\nnew\\n\", \"## A\\na\\n## Implementation\\nnew\\n\", true, false},\n+\t\t{\"duplicate_own_in_cur\", \"## Implementation\\nx\\n## Implementation\\ny\\n\", \"## Implementation\\nnew\\n\", \"\", true, true},\n+\t}\n+\tfor _, tc := range tests {\n+\t\tt.Run(tc.name, func(t *testing.T) {\n+\t\t\tgot, err := mergeOwnSection(own)([]byte(tc.cur), tc.exists, []byte(tc.mine))\n+\t\t\tif (err != n