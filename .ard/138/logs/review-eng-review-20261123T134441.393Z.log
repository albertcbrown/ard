err)\n \t\t}\n \t\t// WriteFile keeps the mode of an existing file, so set it explicitly.\ndiff --git a/internal/committer/committer_test.go b/internal/committer/committer_test.go\nindex f54b4c9..de8081a 100644\n--- a/internal/committer/committer_test.go\n+++ b/internal/committer/committer_test.go\n@@ -590,3 +590,38 @@ func TestWorktreeAdminSharedWithExecutor(t *testing.T) {\n \t}\n \tonlyClone(t, e.clone)\n }\n+\n+func TestCommitMergeSeesLatestHead(t *testing.T) {\n+\te := newEnv(t)\n+\tc := e.main(t, e.live())\n+\tif _, err := c.Commit(context.Background(), req(12, \"plan.md\", \"head\")); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tr := req(12, \"plan.md\", \"mine\")\n+\tr.Files[0].Merge = func(cur []byte, exists bool, mine []byte) ([]byte, error) {\n+\t\tif !exists || string(cur) != \"head\" {\n+\t\t\tt.Errorf(\"cur = %q exists %v\", cur, exists)\n+\t\t}\n+\t\treturn append(append([]byte{}, cur...), mine...), nil\n+\t}\n+\tif _, err := c.Commit(context.Background(), r); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif out := gittest.Run(t, e.bare, \"show\", \"main:.ard/12/plan.md\"); out != \"headmine\" {\n+\t\tt.Fatalf(\"content %q\", out)\n+\t}\n+}\n+\n+func TestCommitMergeError(t *testing.T) {\n+\te := newEnv(t)\n+\tc := e.main(t, e.live())\n+\tbefore := e.head(t, \"main\")\n+\tr := req(12, \"plan.md\", \"mine\")\n+\tr.Files[0].Merge = func([]byte, bool, []byte) ([]byte, error) { return nil, errors.New(\"no\") }\n+\tif _, err := c.Commit(context.Background(), r); !errors.Is(err, ErrMerge) {\n+\t\tt.Fatalf(\"err = %v\", err)\n+\t}\n+\tif e.head(t, \"main\") != before {\n+\t\tt.Fatal(\"main moved\")\n+\t}\n+}\ndiff --git a/internal/committer/errors.go b/internal/committer/errors.go\nindex 471432e..bfb9a24 100644\n--- a/internal/committer/errors.go\n+++ b/internal/committer/errors.go\n@@ -14,6 +14,8 @@ var (\n \t// ErrConflict means upstream changed one of the request's paths since the\n \t// base the request was applied to. It is never retried or overwritten.\n \tErrConflict = errors.New(\"committer: upstream changed a requested path\")\n+\t// ErrMerge means a File's Merge func rejected the current contents.\n+\tErrMerge = errors.New(\"committer: merge failed\")\n \t// ErrBranchGone means the remote branch does not exist.\n \tErrBranchGone = errors.New(\"committer: remote branch does not exist\")\n \t// ErrInitExists means the ard-init branch already exists on the remote, so\ndiff --git a/internal/committer/request.go b/internal/committer/request.go\nindex 0586bab..3305087 100644\n--- a/internal/committer/request.go\n+++ b/internal/committer/request.go\n@@ -16,6 +16,11 @@ type File struct {\n \tData   []byte // literal contents\n \tSrc    string // absolute host path; read into memory before the request waits on the lane\n \tDelete bool   // remove the path; a path already absent is fine\n+\t// Merge, optional, is called at apply time with the contents of the path\n+\t// at the latest head (exists false: absent) and the file's own bytes. Its\n+\t// result is committed instead. An error fails the commit with ErrMerge.\n+\t// It may run again on a push retry, against a newer head.\n+\tMerge func(current []byte, exists bool, mine []byte) ([]byte, error)\n }\n \n // Request is one commit: one issue, one stage:role, one summary, a file set.\n","numLines":344,"startLine":1,"totalLines":344}},"tool_result_meta":[{"id":"toolu_019vtaeaY8xAYXVBWAkj98Le","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011ChKxeCwuWVFP5GBGHZELS","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014mD55y8jCwiCPX5nEsmFuG","name":"Bash","input":{"command":"cd /work; ls .ard/138; cat .ard-input/138/issue.md | head -50; cat .ard/138/plan.md"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":891,"cache_read_input_tokens":9903,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":891},"output_tokens":21,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"592332b3-4565-4375-be9e-4244cd387ad3","uuid":"00567ed6-6356-4ee5-a4cb-9999bb154256","timestamp":"2026-11-23T13:44:43.650Z","request_id":"req_011ChKxeCnjnCk9qbfjrSYCR"}
