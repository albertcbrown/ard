/\" is a prefix from the root; no \"/\" matches the base name; anything else\n+# is a glob on the whole path (\"*\" and \"?\" stop at \"/\", \"**\" does not).\n+def g2re:\n+  if endswith(\"/\") then \"^\" + esc + \".*\"\n+  elif contains(\"/\") then \"^\" + globbody + \"$\"\n+  else \"^(?:.*/)?\" + globbody + \"$\" end;\n+\n+def compiles($what): . as $re | try (\"\" | test($re)) catch fail($what + \" does not compile\");\n+\n+def strlist($k):\n+  if type != \"array\" then fail($k + \" must be a list of strings\")\n+  elif length > 100 then fail($k + \" has more than 100 entries\")\n+  elif any(.[]; (type != \"string\") or . == \"\" or length > 512) then fail($k + \" must hold non-empty strings of at most 512 characters\")\n+  else map(g2re) end;\n+\n+def settings:\n+  $ARGS.named.s[0] as $c\n+  | if ($c | type) != \"object\" then fail(\"must be a JSON object\") else . end\n+  | ($c | keys - [\"pattern\", \"registry\", \"entry\", \"docs\", \"sources\", \"exclude\"]) as $u\n+  | if ($u | length) > 0 then fail(\"unknown key \" + ($u | join(\", \"))) else . end\n+  | if ($c.pattern | type) != \"string\" or $c.pattern == \"\" or ($c.pattern | length) > 512\n+    then fail(\"pattern must be a non-empty string of at most 512 characters\") else . end\n+  | (\"(?<![A-Za-z0-9_])(?:\" + $c.pattern + \")(?![A-Za-z0-9_])\") as $re\n+  | ($re | compiles(\"pattern\"))\n+  | (\"^(?:\" + $c.pattern + \")$\" | compiles(\"pattern\")) as $_\n+  | if (\"\" | test(\"^(?:\" + $c.pattern + \")$\")) then fail(\"pattern matches the empty string\") else . end\n+  | if ($c.registry | type) != \"array\" or ($c.registry | length) == 0 then fail(\"registry must be a non-empty list of path patterns\") else . end\n+  | if ($c | has(\"entry\")) and (($c.entry | type) != \"string\" or $c.entry == \"\" or ($c.entry | length) > 512) then fail(\"entry must be a non-empty string of at most 512 characters\") else . end\n+  | ($c.entry // null) as $entry\n+  | (if $entry != null then ($entry | compiles(\"entry\")) else null end) as $_\n+  | {\n+      pattern: $c.pattern,\n+      re: $re,\n+      entry: $entry,\n+      registry: ($c.registry | strlist(\"registry\")),\n+      docs: (($c.docs // []) | strlist(\"docs\")),\n+      sources: (if $c | has(\"sources\") then ($c.sources | strlist(\"sources\")) else null end),\n+      exclude: (($c.exclude // []) | strlist(\"exclude\"))\n+    };\n+\n+def anyre($l): . as $p | any($l[]; . as $r | $p | test($r));\n+\n+def classify:\n+  . as $line\n+  | ltrimstr(\"./\") as $p\n+  | $ARGS.named.s[0] as $c\n+  | ($p | anyre($c.registry)) as $r\n+  | ($p | anyre($c.docs)) as $d\n+  | if $r and $d then error(\"file matches both registry and docs: \" + $p)\n+    elif ($ARGS.named.class == \"r\" and $r) or ($ARGS.named.class == \"d\" and $d) then $line\n+    elif $ARGS.named.class == \"s\" and ($r | not) and ($d | not)\n+         and ($c.sources == null or ($p | anyre($c.sources)))\n+         and (($p | anyre($c.exclude)) | not) then $line\n+    else empty end;\n+\n+def matchline:\n+  $ARGS.named.s[0] as $c\n+  | (capture(\"^(?<p>[^\\t]*)\\t(?<l>[0-9]+)\\t(?<t>.*)$\") // error(\"malformed line from awk\")) as $ln\n+  | select($ARGS.named.class != \"r\" or $c.entry == null or ($ln.t | test($c.entry)))\n+  | ($ln.t | [match($c.re; \"g\").string | select(length > 0)] | unique)[] as $code\n+  | if $code | test(\"^[A-Za-z0-9_.:/+=-]{1,128}$\")\n+    then {c: $ARGS.named.class, p: ($ln.p | ltrimstr(\"./\")), l: ($ln.l | tonumber), code: $code}\n+    else {skip: \"code\"} end;\n+\n+def safe: gsub(\"[`\\r\\n<>]\"; \"\");\n+\n+def locs:\n+  length as $n\n+  | ((.[:50] | map(\"\\(.p | safe):\\(.l)\") | join(\"\\n\"))\n+     + (if $n > 50 then \"\\n… and \\($n - 50) more\" else \"\" end));\n+\n+def mk($kind; $sev; $grp; $title; $sentence):\n+  {\n+    fingerprint: \"error-codes:\\($kind):\\(.key)\",\n+    title: (\"`\\(.key)` \" + $title),\n+    severity: $sev,\n+    group: $grp,\n+    files: (.value | map(.p) | unique | .[:20]),\n+    body: ($sentence + \"\\n\\nLocations:\\n\\n```text\\n\" + (.value | locs) + \"\\n```\\n\")\n+  };\n+\n+def bycode($c): [$ARGS.named.m[] | select(.c == $c)] | group_by(.code)\n+  | map({key: .[0].code, value: (map({p, l}) | unique)});\n+\n+def findings:\n+  $ARGS.named.s[0] as $c\n+  | (bycode(\"r\") | from_entries) as $R\n+  | (bycode(\"s\")) as $S\n+  | ([$ARGS.named.m[] | select(.c == \"d\") | .code] | unique) as $D\n+  | [ ($R | to_entries[] | select(.value | length >= 2)\n+       | mk(\"duplicated\"; \"high\"; \"duplicate codes\"; \"is defined more than once in the registry\";\n+            \"This code is defined on two or more registry lines. Give each definition its own code.\")),\n+      ($S[] | select(.key as $k | $R | has($k) | not)\n+       | mk(\"unregistered\"; \"medium\"; \"unregistered codes\"; \"is used but not in the registry\";\n+            \"This code appears in the repository but no registry file defines it. Add it to the registry or remove the use.\")),\n+      (if ($c.docs | length) > 0\n+       then ($R | to_entries[] | select(.key as $k | $D | index($k) | not)\n+             | mk(\"undocumented\"; \"low\"; \"undocumented codes\"; \"is in the registry but not documented\";\n+                  \"This code is defined in the registry but no docs file mentions it. Document it.\"))\n+       else empty end) ]\n+  | sort_by(.fingerprint)\n+  | if length > 5000 then error(\"more than 5000 findings: the pattern is too broad\") else . end\n+  | .[];\n+\n+if $mode == \"settings\" then settings\n+elif $mode == \"classify\" then classify\n+elif $mode == \"match\" then matchline\n+elif $mode == \"findings\" then findings\n+else error(\"unknown mode \" + $mode) end\ndiff --git a/internal/roles/scanners/error-codes/scan b/internal/roles/scanners/error-codes/scan\nnew file mode 100755\nindex 0000000..2b8b31f\n--- /dev/null\n+++ b/internal/roles/scanners/error-codes/scan\n@@ -0,0 +1,111 @@\n+#!/bin/sh\n+# error-codes scanner: error codes that are duplicated, undocumented or missing\n+# from the registry, as ard findings.\n+#\n+# Contract (see docs/proposal.md, Scanners):\n+#   - cwd is a read-only worktree of origin/main. This script finds its siblings\n+#     (codes.json, errcodes.jq) from its own path, never from cwd or /role.\n+#   - Prints findings as JSON lines on stdout, and only as its very last action:\n+#     any failure exits non-zero with nothing on stdout, and the controller\n+#     discards the run. It never prints partial results.\n+#   - Writes nothing outside a mktemp dir that is removed on exit. It holds no\n+#     GitHub token and needs none.\n+#   - stderr is the job log: jq version, file counts, skip counts, finding counts.\n+#\n+# codes.json (human-owned, optional, next to this script) says what a code looks\n+# like and where the registry and docs are; see docs/proposal.md. Without it\n+# the scan logs \"not configured\" and succeeds with no output.\n+#\n+# The scan is autoclose: anything that could make it see less than it should\n+# fails the run instead of returning a shorter list.\n+#\n+# Tools (pinned in ./Dockerfile): jq, plus find, awk, grep, xargs, sort.\n+# Exit codes: 0 success, 1 failure, 2 a required tool is missing.\n+set -eu\n+\n+dir=$(CDPATH= cd -- \"$(dirname -- \"$0\")\" && pwd)\n+\n+die() { echo \"error-codes: $*\" >&2; exit 1; }\n+need() { command -v \"$1\" >/dev/null 2>&1 || { echo \"error-codes: $1 not found\" >&2; exit 2; }; }\n+\n+need jq\n+need find\n+need awk\n+need grep\n+need xargs\n+need sort\n+\n+if [ ! -e \"$dir/codes.json\" ]; then\n+  echo \"error-codes: not configured (no codes.json); nothing to scan\" >&2\n+  exit 0\n+fi\n+[ -f \"$dir/codes.json\" ] || die \"codes.json is not a regular file\"\n+[ -f \"$dir/errcodes.jq\" ] || die \"errcodes.jq is missing\"\n+\n+tmp=$(mktemp -d \"${TMPDIR:-/tmp}/ard-errcodes.XXXXXX\")\n+cleanup() { rm -rf \"$tmp\"; }\n+trap cleanup EXIT\n+trap 'exit 130' INT\n+trap 'exit 143' TERM\n+\n+prog=$dir/errcodes.jq\n+echo \"jq: $(jq --version 2>&1 || true)\" >&2\n+\n+jq -n --arg mode settings --slurpfile s \"$dir/codes.json\" -f \"$prog\" \\\n+  > \"$tmp/settings.json\" 2> \"$tmp/err\" || { cat \"$tmp/err\" >&2; die \"invalid codes.json\"; }\n+\n+ncntrl=$(find . -name '*[[:cntrl:]]*' -print 2>/dev/null | grep -c '' || true)\n+[ \"$ncntrl\" = 0 ] || echo \"error-codes: skipped $ncntrl path(s) with control characters\" >&2\n+\n+# Regular files only: find does not follow symlinks, so a planted link cannot\n+# make a host-mode scan read outside the worktree.\n+LC_ALL=C find . \\( -path ./.git -o -path ./.ard -o -name .git -o -name vendor \\\n+    -o -name node_modules -o -name testdata -o -name '*[[:cntrl:]]*' \\) -prune \\\n+  -o -type f -size -1025k -print > \"$tmp/files.raw\" || die \"find failed\"\n+LC_ALL=C sort \"$tmp/files.raw\" > \"$tmp/files.txt\" || die \"sort failed\"\n+\n+: > \"$tmp/matches.jsonl\"\n+docs_set=$(jq -r '.docs | length' \"$tmp/settings.json\") || die \"cannot read settings\"\n+\n+for c in r d s; do\n+  if [ \"$c\" = d ] && [ \"$docs_set\" = 0 ]; then continue; fi\n+  jq -R -r --arg mode classify --arg class \"$c\" --slurpfile s \"$tmp/settings.json\" \\\n+    -f \"$prog\" \"$tmp/files.txt\" > \"$tmp/$c.all\" 2> \"$tmp/err\" || { cat \"$tmp/err\" >&2; die \"classify failed\"; }\n+  # Keep non-empty text files. Any grep complaint (unreadable file) fails.\n+  : > \"$tmp/$c.list\"\n+  if [ -s \"$tmp/$c.all\" ]; then\n+    tr '\\n' '\\0' < \"$tmp/$c.all\" > \"$tmp/$c.nul\"\n+    rc=0\n+    LC_ALL=C xargs -0 grep -I -l -e '' -- < \"$tmp/$c.nul\" > \"$tmp/$c.list\" 2> \"$tmp/err\" || rc=$?\n+    case $rc in 0|1|123) ;; *) die \"grep failed with exit status $rc\" ;; esac\n+    if [ -s \"$tmp/err\" ]; then cat \"$tmp/err\" >&2; die \"grep could not read every file\"; fi\n+  fi\n+  if [ ! -s \"$tmp/$c.list\" ]; then\n+    case $c in\n+      r) die \"registry matches no file (renamed or moved?)\" ;;\n+      d) die \"docs matches no file (renamed or moved?)\" ;;\n+    esac\n+  fi\n+  n=$(grep -c '' \"$tmp/$c.list\" || true)\n+  echo \"error-codes: class $c: $n file(s)\" >&2\n+  [ \"$n\" != 0 ] || continue\n+  tr '\\n' '\\0' < \"$tmp/$c.list\" > \"$tmp/$c.nul\"\n+  rc=0\n+  LC_ALL=C xargs -0 env LC_ALL=C awk \\\n+    'length($0)<=16384{print FILENAME \"\\t\" FNR \"\\t\" $0; next}{n++} END{if(n) printf \"skipped %d long lines\\n\", n > \"/dev/stderr\"}' \\\n+    < \"$tmp/$c.nul\" > \"$tmp/$c.lines\" || rc=$?\n+  [ \"$rc\" = 0 ] || die \"reading files failed with exit status $rc\"\n+  jq -R -c --arg mode match --arg class \"$c\" --slurpfile s \"$tmp/settings.json\" \\\n+    -f \"$prog\" \"$tmp/$c.lines\" >> \"$tmp/matches.jsonl\" 2> \"$tmp/err\" || { cat \"$tmp/err\" >&2; die \"match failed\"; }\n+done\n+\n+jq -n -c --arg mode findings --slurpfile m \"$tmp/matches.jsonl\" --slurpfile s \"$tmp/settings.json\" \\\n+  -f \"$prog\" > \"$tmp/out.jsonl\" 2> \"$tmp/err\" || { cat \"$tmp/err\" >&2; die \"findings failed\"; }\n+\n+nskip=$(grep -c '\"skip\"' \"$tmp/matches.jsonl\" || true)\n+[ \"$nskip\" = 0 ] || echo \"error-codes: dropped $nskip match(es) outside the allowed code characters\" >&2\n+for k in duplicated unregistered undocumented; do\n+  n=$(grep -c \"\\\"fingerprint\\\":\\\"error-codes:$k:\" \"$tmp/out.jsonl\" || true)\n+  echo \"error-codes: $k: $n finding(s)\" >&2\n+done\n+cat \"$tmp/out.jsonl\"\n","numLines":916,"startLine":1,"totalLines":916}},"tool_result_meta":[{"id":"toolu_01Szu3764XWLcJHMgHjrCoEw","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
