4}\" ;; \\\n38:    echo \"${osv_sha}  /out/osv-scanner\" | sha256sum -c -; \\\n40:    echo \"${jq_sha}  /out/jq\" | sha256sum -c -; \\\n44:FROM ${GO_IMAGE}","is_error":false}]},"parent_tool_use_id":null,"session_id":"2b8a1874-954a-4bf0-bea4-ff4d06e0743b","uuid":"323ef96b-80c8-4ccd-afc3-d7ad1f846efb","timestamp":"2026-11-23T15:56:21.762Z","tool_use_result":{"stdout":"config.yaml\ncve_docker_integration_test.go\ncve_integration_test.go\ncve_test.go\neng_review_test.go\nengineer_test.go\nlead_test.go\nreviewers\nroles.go\nroles_test.go\nscanners\ntestdata\ntriage\nworker_engineer_test.go\nworkers\n\ninternal/roles/reviewers:\neng-review\n\ninternal/roles/reviewers/eng-review:\nprompt.txt\n\ninternal/roles/scanners:\ncve\n\ninternal/roles/scanners/cve:\nDockerfile\nmerge.jq\nscan\n\ninternal/roles/testdata:\ncve\n\ninternal/roles/testdata/cve:\nboth_tools\ncve_only\nempty\nexcluded_manifests\ngv_only\nnested_module\n# ard configuration for albertcbrown/ard (dogfooding). Started from `ard init`'s\n# template; human-owned. ard serve reads it from origin/main.\n# Anything unset takes its built-in default (docs/proposal.md, Configuration).\n# Validate with `ard config check`. ard serve reads this file from origin/main.\n\n# label: only issues a maintainer labels for triage enter the pipeline.\n# all: every human-filed issue enters.\nintake: { mode: label }\n\nmerge:\n  # A PR touching any of these waits for a human approval. There is no\n  # built-in list: removing an entry removes its gate. An entry ending in /\n  # is a directory prefix; anything else is a glob (quote globs starting with *).\n  protected_paths:\n    - .github/\n    - .ard/config.yaml\n    - .ard/scanners/\n    - .ard/triage/\n    - .ard/workers/\n    - .ard/reviewers/\n    - \"**/CODEOWNERS\"\n    # Agent instructions a PR could plant to steer later agents.\n    - CLAUDE.md\n    - \"**/CLAUDE.md\"\n    - AGENTS.md\n    - \"**/AGENTS.md\"\n    - .claude/\n    - .mcp.json\n    # What builds, signs and deploys ard itself (docs/proposal.md, Delivery).\n    - \"Jenkinsfile*\"\n    - Dockerfile\n    - .dockerignore\n    - deploy/\n\noverrides:\n  scanners/cve: { every: 6h, max_open: 10, group_size: 1, autoclose: true }\n  # Phase 1 agent roles (the ard init starter set, #39 Gate 2).\n  triage/lead:  { model: claude-opus-5-5, timeout: 15m }\n  triage/engineer: { model: claude-sonnet-5-5 }\n  workers/engineer: { model: claude-sonnet-5-5, timeout: 60m, tests: make test }\n  reviewers/eng-review: { model: claude-sonnet-5-5 }\n# ard configuration, proposed by `ard init`. Edit freely; this file is yours.\n# Anything unset takes its built-in default (docs/proposal.md, Configuration).\n# Validate with `ard config check`. ard serve reads this file from origin/main.\n\n# label: only issues a maintainer labels for triage enter the pipeline.\n# all: every human-filed issue enters.\nintake: { mode: label }\n\nmerge:\n  # A PR touching any of these waits for a human approval. There is no\n  # built-in list: removing an entry removes its gate. An entry ending in /\n  # is a directory prefix; anything else is a glob (quote globs starting with *).\n  protected_paths:\n    - .github/\n    - .ard/config.yaml\n    - .ard/scanners/\n    - .ard/triage/\n    - .ard/workers/\n    - .ard/reviewers/\n    - \"**/CODEOWNERS\"\n    # Agent instructions a PR could plant to steer later agents.\n    - CLAUDE.md\n    - \"**/CLAUDE.md\"\n    - AGENTS.md\n    - \"**/AGENTS.md\"\n    - .claude/\n    - .mcp.json\n\noverrides:\n  scanners/cve: { every: 6h, max_open: 10, group_size: 1, autoclose: true }\n  triage/lead:  { model: claude-opus-5-5, timeout: 15m }\n  triage/engineer: { model: claude-sonnet-5-5 }\n  # timeout covers the whole worker job (agent, tests, fix rounds). tests is your\n  # repo's test command; \"\" turns the test step off.\n  workers/engineer: { model: claude-sonnet-5-5, timeout: 60m, tests: make test }\n  reviewers/eng-review: { model: claude-sonnet-5-5 }\ninternal/config/discover.go:119