{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SfbqnqNDaaVWa5gmZDJqhV","type":"tool_result","content":"// Package roles holds the starter .ard/ tree that `ard init` (#27) proposes\n// to a target repo. Paths in FS are relative to .ard/ (for example\n// \"config.yaml\" or \"scanners/cve/scan\"). embed.FS reports every file as 0444,\n// so the writer must commit files named in ExecutableNames as 100755.\npackage roles\n\nimport \"embed\"\n\n// FS is the starter .ard/ tree `ard init` proposes: config.yaml plus the role\n// directories (scanners/cve, triage/lead, triage/engineer, workers/engineer and reviewers/eng-review); paths are relative to .ard/.\n//\n//go:embed config.yaml reviewers scanners triage workers\nvar FS embed.FS\n\n// ExecutableNames lists base names that must be written 0755.\nvar ExecutableNames = []string{\"scan\"}\npackage roles\n\nimport (\n\t\"io/fs\"\n\t\"os\"\n\t\"path\"\n\t\"slices\"\n\t\"sort\"\n\t\"strings\"\n\t\"testing\"\n\t\"testing/fstest\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n)\n\nfunc TestFSContents(t *testing.T) {\n\tvar got []string\n\terr := fs.WalkDir(FS, \".\", func(p string, d fs.DirEntry, err error) error {\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif !d.IsDir() {\n\t\t\tgot = append(got, p)\n\t\t}\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsort.Strings(got)\n\twant := []string{\"config.yaml\", \"reviewers/eng-review/prompt.txt\", \"scanners/cve/Dockerfile\", \"scanners/cve/merge.jq\", \"scanners/cve/scan\", \"triage/engineer/prompt.txt\", \"triage/lead/prompt.txt\", \"workers/engineer/prompt.txt\"}\n\tif strings.Join(got, \",\") != strings.Join(want, \",\") {\n\t\tt.Fatalf(\"embedded files = %v, want %v\", got, want)\n\t}\n\tfor _, p := range got {\n\t\tif strings.HasSuffix(p, \"_test.go\") || strings.Contains(p, \"testdata\") {\n\t\t\tt.Errorf(\"%s must not be embedded: ard init would copy it into target repos\", p)\n\t\t}\n\t}\n}\n\n// embed.FS reports 0444 for everything, so the exec bit must be checked on disk\n// to catch a mode lost in git.\nfunc TestScanIsExecutableOnDisk(t *testing.T) {\n\tfi, err := os.Stat(\"scanners/cve/scan\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif fi.Mode()&0o111 == 0 {\n\t\tt.Fatalf(\"scanners/cve/scan mode %v has no exec bit\", fi.Mode())\n\t}\n}\n\nfunc TestExecutableNames(t *testing.T) {\n\tif len(ExecutableNames) != 1 || ExecutableNames[0] != \"scan\" {\n\t\tt.Fatalf(\"ExecutableNames = %v\", ExecutableNames)\n\t}\n}\n\n// This is what #27's writer must do: embed.FS drops modes (everything is 0444),\n// so files named in ExecutableNames are written 0755.\nfunc TestEmbeddedCveRoleLoadsAsScanner(t *testing.T) {\n\t// Without the chmod, config rejects the role: the exec bit really is needed.\n\tif _, err := config.LoadFS(starterFS(t, false), \"/repo\"); err == nil || !strings.Contains(err.Error(), \"executable\") {\n\t\tt.Fatalf(\"want an 'executable' error without chmod, got %v\", err)\n\t}\n\n\tres, err := config.LoadFS(starterFS(t, true), \"/repo\")\n\tif err != nil {\n\t\tt.Fatalf(\"LoadFS: %v\", err)\n\t}\n\tvar found *config.Role\n\tfor i := range res.Roles {\n\t\tif res.Roles[i].Kind == config.KindScanner && res.Roles[i].Name == \"cve\" {\n\t\t\tfound = &res.Roles[i]\n\t\t}\n\t}\n\tif found == nil {\n\t\tt.Fatalf(\"no scanner role cve in %+v\", res.Roles)\n\t}\n\tif found.ScanPath != \".ard/scanners/cve/scan\" || found.PromptPath != \"\" || !found.Autoclose {\n\t\tt.Errorf(\"unexpected role: %+v\", found)\n\t}\n\tif found.Every != 6*time.Hour || found.MaxOpen != 10 || found.GroupSize != 1 {\n\t\tt.Errorf(\"cve overrides: every=%v max_open=%d group_size=%d, want 6h, 10, 1\", found.Every, found.MaxOpen, found.GroupSize)\n\t}\n\tif found.Dockerfile != \".ard/scanners/cve/Dockerfile\" {\n\t\tt.Errorf(\"Dockerfile = %q\", found.Dockerfile)\n\t}\n\tif !slices.Equal(found.Extra, []string{\"merge.jq\"}) {\n\t\tt.Errorf(\"Extra = %v, want [merge.jq]\", found.Extra)\n\t}\n}\n\n// starterFS lays the embedded starter out as a repo's .ard/ directory.\nfunc starterFS(t *testing.T, chmod bool) fstest.MapFS {\n\tt.Helper()\n\tm := fstest.MapFS{}\n\terr := fs.WalkDir(FS, \".\", func(p string, d fs.DirEntry, err error) error {\n\t\tif err != nil || d.IsDir() {\n\t\t\treturn err\n\t\t}\n\t\tb, err := FS.ReadFile(p)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tmode := fs.FileMode(0o644)\n\t\tif chmod && slices.Contains(ExecutableNames, path.Base(p)) {\n\t\t\tmode = 0o755\n\t\t}\n\t\tm[\".ard/\"+p] = &fstest.MapFile{Data: b, Mode: mode}\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn m\n}\npackage roles\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"reflect\"\n\t\"sort\"\n\t\"strings\"\n\t\"testing\"\n)\n\nfunc needTools(t *testing.T, names ...string) {\n\tt.Helper()\n\tfor _, n := range names {\n\t\tif _, err := exec.LookPath(n); err != nil {\n\t\t\tt.Skipf(\"%s not available\", n)\n\t\t}\n\t}\n}\n\nfunc readFixture(t *testing.T, path, root string) []byte {\n\tt.Helper()\n\tb, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn bytes.ReplaceAll(b, []byte(\"@ROOT@\"), []byte(root))\n}\n\n// runMerge runs merge.jq the way scan does.\nfunc runMerge(t *testing.T, osvJSON, gvJSONL []byte) []byte {\n\tt.Helper()\n\tdir := t.TempDir()\n\tosvPath, gvPath := filepath.Join(dir, \"osv.json\"), filepath.Join(dir, \"gv.jsonl\")\n\tif err := os.WriteFile(osvPath, osvJSON, 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(gvPath, gvJSONL, 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tcmd := exec.Command(\"jq\", \"-c\", \"-n\", \"--arg\", \"root\", \"/R\", \"--arg\", \"lroot\", \"/L\",\n\t\t\"--slurpfile\", \"osv\", osvPath, \"--slurpfile\", \"gv\", gvPath,\n\t\t\"-f\", \"scanners/cve/merge.jq\")\n\tvar stderr bytes.Buffer\n\tcmd.Stderr = &stderr\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"jq: %v\\n%s\", err, stderr.String())\n\t}\n\treturn out\n}\n\n// Fixtures in testdata/cve: realCases are regenerated from the tools pinned\n// in scanners/cve/Dockerfile by `make cve-fixtures` (testdata/cve/regen.sh,\n// needs Docker and network). Review every want.jsonl diff by hand: the golden\n// test cannot tell a correct change from a regression. syntheticCases are\n// hand-written and never regenerated.\nvar realCases = []string{\"both_tools\", \"osv_only\", \"not_called\", \"nested_module\", \"scoped_npm\"}\n\n// syntheticCases are hand-written: real tools can't produce them on demand.\nvar syntheticCases = map[string]string{\n\t\"empty\":              \"what scan writes when osv-scanner exits 128\",\n\t\"gv_only\":            \"stdlib-only govulncheck finding; needs an old toolchain\",\n\t\"toolchain_switch\":   \"govulncheck ran with a switched toolchain (wrapper carries toolchain)\",\n\t\"symbol_called\":      \"critical and reachable\",\n\t\"severity_fallbacks\": \"CVSS missing, database severity per level\",\n\t\"two_ghsa\":           \"two GHSA ids for one vulnerability\",\n\t\"cve_only\":           \"no GHSA id\",\n\t\"excluded_manifests\": \"testdata/vendor/node_modules manifests\",\n\t\"untrusted_summary\":  \"hostile advisory summary\",\n}\n\nvar cases = allCases()\n\nfunc allCases() []string {\n\tout := append([]string(nil), realCases...)\n\tvar syn []string\n\tfor k := range syntheticCases {\n\t\tsyn = append(syn, k)\n\t}\n\tsort.Strings(syn)\n\treturn append(out, syn...)\n}\n\nfunc TestFixtureCasesListed(t *testing.T) {\n\tents, err := os.ReadDir(filepath.Join(\"testdata\", \"cve\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\thave := map[string]bool{}\n\tfor _, e := range ents {\n\t\tif e.IsDir() {\n\t\t\thave[e.Name()] = true\n\t\t}\n\t}\n\twant := map[string]bool{}\n\tfor _, c := range realCases {\n\t\twant[c] = true\n\t}\n\tfor c := range syntheticCases {\n\t\tif want[c] {\n\t\t\tt.Errorf(\"%s is both real and synthetic\", c)\n\t\t}\n\t\twant[c] = true\n\t}\n\tif !reflect.DeepEqual(have, want) {\n\t\tt.Errorf(\"fixture dirs %v != listed cases %v\", have, want)\n\t}\n}\n\nfunc TestMergeGolden(t *testing.T) {\n\tneedTools(t, \"jq\")\n\tfor _, c := range cases {\n\t\tt.Run(c, func(t *testing.T) {\n\t\t\td := filepath.Join(\"testdata\", \"cve\", c)\n\t\t\tgot := runMerge(t, readFixture(t, filepath.Join(d, \"osv.json\"), \"/R\"),\n\t\t\t\treadFixture(t, filepath.Join(d, \"gv.jsonl\"), \"/R\"))\n\t\t\twant, err := os.ReadFile(filepath.Join(d, \"want.jsonl\"))\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tif !bytes.Equal(got, want) {\n\t\t\t\tt.Fatalf(\"output mismatch\\n got: %s\\nwant: %s\", got, want)\n\t\t\t}\n\t\t})\n\t}\n}\n\ntype finding struct {\n\tFingerprint, Title, Severity, Group string\n\tFiles                               []string\n\tBody                                string\n}\n\nfunc decode(t *testing.T, b []byte) []finding {\n\tt.Helper()\n\tvar out []finding\ninternal/scanner/finding.go:60:type Finding struct {\ninternal/scanner/finding.go-61-\tFingerprint string   `json:\"fingerprint\"` // required; stable across runs\ninternal/scanner/finding.go-62-\tTitle       string   `json:\"title\"`       // required; one line\ninternal/scanner/finding.go-63-\tSeverity    Severity `json:\"severity\"`    // required\ninternal/scanner/finding.go-64-\tGroup       string   `json:\"group\"`       // optional; \"\" = one issue per finding\ninternal/scanner/finding.go-65-\tFiles       []string `json:\"files\"`       // optional; repo-relative\ninternal/scanner/finding.go-66-\tBody        string   `json:\"body\"`        // optional markdown\ninternal/scanner/finding.go-67-}\ninternal/scanner/finding.go-68-\ninternal/scanner/finding.go-69-// DecodeError is one invalid line of scanner output.\ninternal/scanner/finding.go-70-type DecodeError struct {\ninternal/scanner/finding.go-71-\tLine int\ninternal/scanner/finding.go-72-\tMsg  string\ninternal/scanner/finding.go-73-}\ninternal/scanner/finding.go-74-\ninternal/scanner/finding.go-75-func (e DecodeError) Error() string { return fmt.Sprintf(\"line %d: %s\", e.Line, e.Msg) }\ninternal/scanner/finding.go-76-\ninternal/scanner/finding.go-77-// DecodeErrors lists the invalid lines of a scanner's output, at most 20.\ninternal/scanner/finding.go-78-type DecodeErrors []DecodeError\ninternal/scanner/finding.go-79-\ninternal/scanner/finding.go-80-func (e DecodeErrors) Error() string {\ninternal/scanner/finding.go-81-\tparts := make([]string, 0, len(e))\ninternal/scanner/finding.go-82-\tfor _, d := range e {\ninternal/scanner/finding.go-83-\t\tparts = append(parts, d.Error())\ninternal/scanner/finding.go-84-\t}\ninternal/scanner/finding.go-85-\treturn \"invalid scanner output: \" + strings.Join(parts, \"; \")\n# merge.jq: map osv-scanner and govulncheck output to ard findings (JSONL).\n#\n# Inputs (all via scan, see its header):\n#   --arg root <physical abs path of the scanned repo> --arg lroot <logical one>\n#   --slurpfile osv <osv-scanner --format json output>     ([] or [{\"results\":[...]}])\n#   --slurpfile gv  <JSONL, one {manifest, messages[, toolchain]} per Go module> ([] when absent;\n#     toolchain is set only when scan switched Go toolchains for that module)\n# Output: one compact JSON object per finding, sorted by fingerprint, keys in\n# the order fingerprint,title,severity,group,files,body. Pure and deterministic:\n# no timestamps, no tool versions. Written for jq 1.6+.\n\n# osv-scanner builds absolute paths from the logical cwd ($lroot), while $root\n# is the physical one; strip whichever matches.\ndef rel:\n  (if startswith($root + \"/\") then .[($root | length) + 1:]\n   elif startswith($lroot + \"/\") then .[($lroot | length) + 1:]\n   else . end)\n  | sub(\"^\\\\./\"; \"\");\n\ndef excluded:\n  split(\"/\") | .[:-1] | any(. == \"testdata\" or . == \"vendor\" or . == \"node_modules\");\n\ndef sevrank: {\"low\": 1, \"medium\": 2, \"high\": 3, \"critical\": 4}[.] // 0;\n\ndef dbsev:\n  if type != \"string\" then null\n  else ascii_downcase\n    | if . == \"critical\" or . == \"high\" or . == \"low\" then .\n      elif . == \"moderate\" or . == \"medium\" then \"medium\"\n      else null end\n  end;\n\ndef maxsev: map(select(. != null)) | if length == 0 then null else max_by(sevrank) end;\n\ndef firstnn: map(select(. != null and . != \"\")) | .[0];\n\n# ---- candidates ----\n\ndef osv_cands:\n  [ $osv[] | (.results // [])[]\n    | ((.source.path // \"\") | rel) as $m\n    | (if ($m | startswith(\"/\")) then error(\"cve: absolute manifest \" + $m) else . end)\n    | (.packages // [])[]\n    | .package as $p\n    | (.vulnerabilities // []) as $vs\n    | (.groups // [])[] as $g\n    | ($vs | map(select(.id as $i | any(($g.ids // [])[]; . == $i)))) as $mv\n    | {\n        tools: [\"osv-scanner\"],\n        manifest: $m,\n        package: $p.name,\n        ids: (([($g.ids // [])[], ($g.aliases // [])[], ($mv[] | (.aliases // [])[])]) | unique),\n        score: (($g.max_severity // null)\n                | if type == \"number\" then .\n                  elif type == \"string\" then (try tonumber catch null)\n                  else null end),\n        dbsev: ([$mv[] | .database_specific.severity | dbsev] | maxsev),\n        installed: ($p.version // null),\n        fixed: ([$mv[] | (.affected // [])[] | select(.package.name == $p.name)\n                 | (.ranges // [])[] | (.events // [])[] | .fixed | select(. != null)] | unique),\njq-1.8.2\n\t\t}\n\t\tm[rel] = string(b)\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn m\n}\n\nvar starterTree = []string{\".ard/config.yaml\", \".ard/reviewers/eng-review/prompt.txt\", \".ard/scanners/cve/Dockerfile\", \".ard/scanners/cve/merge.jq\", \".ard/scanners/cve/scan\", \".ard/triage/engineer/prompt.txt\", \".ard/triage/lead/prompt.txt\", \".ard/workers/engineer/prompt.txt\"}\n\nfunc TestInitOpensPR(t *testing.T) {\n\th := newHarness(t)\n\tbefore := snapshot(t, h.clone)\n\tout, err := h.run(t, false, false)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif got := h.tree(t, \"ard-init\"); !reflect.DeepEqual(got, starterTree) {\n\t\tt.Errorf(\"ard-init tree = %v, want %v\", got, starterTree)\n\t}\n\tif got := strings.TrimSpace(gittest.Run(t, h.bare, \"ls-tree\", \"-r\", \"ard-init\", \"--\", \".ard/scanners/cve/scan\")); !strings.HasPrefix(got, \"100755 \") {\n\t\tt.Errorf(\"scan = %q, want mode 100755\", got)\n\t}\n\tif !reflect.DeepEqual(snapshot(t, h.clone), before) {","is_error":false}]},"parent_tool_use_id":null,"session_id":"355a0ab6-c8a5-4d7c-9d9f-305e312d33f2","uuid":"5b2e5e1d-f411-4f0a-b635-6342d76d4c4d","timestamp":"2026-11-23T15:58:44.200Z","tool_use_result":{"stdout":"// Package roles holds the starter .ard/ tree that `ard init` (#27) proposes\n// to a target repo. Paths in FS are relative to .ard/ (for example\n// \"config.yaml\" or \"scanners/cve/scan\"). embed.FS reports every file as 0444,\n// so the writer must commit files named in ExecutableNames as 100755.\npackage roles\n\nimport \"embed\"\n\n// FS is the starter .ard/ tree `ard init` proposes: config.yaml plus the role\n// directories (scanners/cve, triage/lead, triage/engineer, workers/engineer and reviewers/eng-review); paths are relative to .ard/.\n//\n//go:embed config.yaml reviewers scanners triage workers\nvar FS embed.FS\n\n// ExecutableNames lists base names that must be written 0755.\nvar ExecutableNames = []string{\"scan\"}\npackage roles\n\nimport (\n\t\"io/fs\"\n\t\"os\"\n\t\"path\"\n\t\"slices\"\n\t\"sort\"\n\t\"strings\"\n\t\"testing\"\n\t\"testing/fstest\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n)\n\nfunc TestFSContents(t *testing.T) {\n\tvar got []string\n\terr := fs.WalkDir(FS, \".\", func(p string, d fs.DirEntry, err error) error {\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif !d.IsDir() {\n\t\t\tgot = append(got, p)\n\t\t}\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsort.Strings(got)\n\twant := []string{\"config.yaml\", \"reviewers/eng-review/prompt.txt\", \"scanners/cve/Dockerfile\", \"scanners/cve/merge.jq\", \"scanners/cve/scan\", \"triage/engineer/prompt.txt\", \"triage/lead/prompt.txt\", \"workers/engineer/prompt.txt\"}\n\tif strings.Join(got, \",\") != strings.Join(want, \",\") {\n\t\tt.Fatalf(\"embedded files = %v, want %v\", got, want)\n\t}\n\tfor _, p := range got {\n\t\tif strings.HasSuffix(p, \"_test.go\") || strings.Contains(p, \"testdata\") {\n\t\t\tt.Errorf(\"%s must not be embedded: ard init would copy it into target repos\", p)\n\t\t}\n\t}\n}\n\n// embed.FS reports 0444 for everything, so the exec bit must be checked on disk\n// to catch a mode lost in git.\nfunc TestScanIsExecutableOnDisk(t *testing.T) {\n\tfi, err := os.Stat(\"scanners/cve/scan\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif fi.Mode()&0o111 == 0 {\n\t\tt.Fatalf(\"scanners/cve/scan mode %v has no exec bit\", fi.Mode())\n\t}\n}\n\nfunc TestExecutableNames(t *testing.T) {\n\tif len(ExecutableNames) != 1 || ExecutableNames[0] != \"scan\" {\n\t\tt.Fatalf(\"ExecutableNames = %v\", ExecutableNames)\n\t}\n}\n\n// This is what #27's writer must do: embed.FS drops modes (everything is 0444),\n// so files named in ExecutableNames are written 0755.\nfunc TestEmbeddedCveRoleLoadsAsScanner(t *testing.T) {\n\t// Without the chmod, config rejects the role: the exec bit really is needed.\n\tif _, err := config.LoadFS(starterFS(t, false), \"/repo\"); err == nil || !strings.Contains(err.Error(), \"executable\") {\n\t\tt.Fatalf(\"want an 'executable' error without chmod, got %v\", err)\n\t}\n\n\tres, err := config.LoadFS(starterFS(t, true), \"/repo\")\n\tif err != nil {\n\t\tt.Fatalf(\"LoadFS: %v\", err)\n\t}\n\tvar found *config.Role\n\tfor i := range res.Roles {\n\t\tif res.Roles[i].Kind == config.KindScanner && res.Roles[i].Name == \"cve\" {\n\t\t\tfound = &res.Roles[i]\n\t\t}\n\t}\n\tif found == nil {\n\t\tt.Fatalf(\"no scanner role cve in %+v\", res.Roles)\n\t}\n\tif found.ScanPath != \".ard/scanners/cve/scan\" || found.PromptPath != \"\" || !found.Autoclose {\n\t\tt.Errorf(\"unexpected role: %+v\", found)\n\t}\n\tif found.Every != 6*time.Hour || found.MaxOpen != 10 || found.GroupSize != 1 {\n\t\tt.Errorf(\"cve overrides: every=%v max_open=%d group_size=%d, want 6h, 10, 1\", found.Every, found.MaxOpen, found.GroupSize)\n\t}\n\tif found.Dockerfile != \".ard/scanners/cve/Dockerfile\" {\n\t\tt.Errorf(\"Dockerfile = %q\", found.Dockerfile)\n\t}\n\tif !slices.Equal(found.Extra, []string{\"merge.jq\"}) {\n\t\tt.Errorf(\"Extra = %v, want [merge.jq]\", found.Extra)\n\t}\n}\n\n// starterFS lays the embedded starter out as a repo's .ard/ directory.\nfunc starterFS(t *testing.T, chmod bool) fstest.MapFS {\n\tt.Helper()\n\tm := fstest.MapFS{}\n\terr := fs.WalkDir(FS, \".\", func(p string, d fs.DirEntry, err error) error {\n\t\tif err != nil || d.IsDir() {\n\t\t\treturn err\n\t\t}\n\t\tb, err := FS.ReadFile(p)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tmode := fs.FileMode(0o644)\n\t\tif chmod && slices.Contains(ExecutableNames, path.Base(p)) {\n\t\t\tmode = 0o755\n\t\t}\n\t\tm[\".ard/\"+p] = &fstest.MapFile{Data: b, Mode: mode}\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn m\n}\npackage roles\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"reflect\"\n\t\"sort\"\n\t\"strings\"\n\t\"testing\"\n)\n\nfunc needTools(t *testing.T, names ...string) {\n\tt.Helper()\n\tfor _, n := range names {\n\t\tif _, err := exec.LookPath(n); err != nil {\n\t\t\tt.Skipf(\"%s not available\", n)\n\t\t}\n\t}\n}\n\nfunc readFixture(t *testing.T, path, root string) []byte {\n\tt.Helper()\n\tb, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn bytes.ReplaceAll(b, []byte(\"@ROOT@\"), []byte(root))\n}\n\n// runMerge runs merge.jq the way scan does.\nfunc runMerge(t *testing.T, osvJSON, gvJSONL []byte) []byte {\n\tt.Helper()\n\tdir := t.TempDir()\n\tosvPath, gvPath := filepath.Join(dir, \"osv.json\"), filepath.Join(dir, \"gv.jsonl\")\n\tif err := os.WriteFile(osvPath, osvJSON, 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(gvPath, gvJSONL, 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tcmd := exec.Command(\"jq\", \"-c\", \"-n\", \"--arg\", \"root\", \"/R\", \"--arg\", \"lroot\", \"/L\",\n\t\t\"--slurpfile\", \"osv\", osvPath, \"--slurpfile\", \"gv\", gvPath,\n\t\t\"-f\", \"scanners/cve/merge.jq\")\n\tvar stderr bytes.Buffer\n\tcmd.Stderr = &stderr\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"jq: %v\\n%s\", err, stderr.String())\n\t}\n\treturn out\n}\n\n// Fixtures in testdata/cve: realCases are regenerated from the tools pinned\n// in scanners/cve/Dockerfile by `make cve-fixtures` (testdata/cve/regen.sh,\n// needs Docker and network). Review every want.jsonl diff by hand: the golden\n// test cannot tell a correct change from a regression. syntheticCases are\n// hand-written and never regenerated.\nvar realCases = []string{\"both_tools\", \"osv_only\", \"not_called\", \"nested_module\", \"scoped_npm\"}\n\n// syntheticCases are hand-written: real tools can't produce them on demand.\nvar syntheticCases = map[string]string{\n\t\"empty\":              \"what scan writes when osv-scanner exits 128\",\n\t\"gv_only\":            \"stdlib-only govulncheck finding; needs an old toolchain\",\n\t\"toolchain_switch\":   \"govulncheck ran with a switched toolchain (wrapper carries toolchain)\",\n\t\"symbol_called\":      \"critical and reachable\",\n\t\"severity_fallbacks\": \"CVSS missing, database severity per level\",\n\t\"two_ghsa\":           \"two GHSA ids for one vulnerability\",\n\t\"cve_only\":           \"no GHSA id\",\n\t\"excluded_manifests\": \"testdata/vendor/node_modules manifests\",\n\t\"untrusted_summary\":  \"hostile advisory summary\",\n}\n\nvar cases = allCases()\n\nfunc allCases() []string {\n\tout := append([]string(nil), realCases...)\n\tvar syn []string\n\tfor k := range syntheticCases {\n\t\tsyn = append(syn, k)\n\t}\n\tsort.Strings(syn)\n\treturn append(out, syn...)\n}\n\nfunc TestFixtureCasesListed(t *testing.T) {\n\tents, err := os.ReadDir(filepath.Join(\"testdata\", \"cve\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\thave := map[string]bool{}\n\tfor _, e := range ents {\n\t\tif e.IsDir() {\n\t\t\thave[e.Name()] = true\n\t\t}\n\t}\n\twant := map[string]bool{}\n\tfor _, c := range realCases {\n\t\twant[c] = true\n\t}\n\tfor c := range syntheticCases {\n\t\tif want[c] {\n\t\t\tt.Errorf(\"%s is both real and synthetic\", c)\n\t\t}\n\t\twant[c] = true\n\t}\n\tif !reflect.DeepEqual(have, want) {\n\t\tt.Errorf(\"fixture dirs %v != listed cases %v\", have, want)\n\t}\n}\n\nfunc TestMergeGolden(t *testing.T) {\n\tneedTools(t, \"jq\")\n\tfor _, c := range cases {\n\t\tt.Run(c, func(t *testing.T) {\n\t\t\td := filepath.Join(\"testdata\", \"cve\", c)\n\t\t\tgot := runMerge(t, readFixture(t, filepath.Join(d, \"osv.json\"), \"/R\"),\n\t\t\t\treadFixture(t, filepath.Join(d, \"gv.jsonl\"), \"/R\"))\n\t\t\twant, err := os.ReadFile(filepath.Join(d, \"want.jsonl\"))\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tif !bytes.Equal(got, want) {\n\t\t\t\tt.Fatalf(\"output mismatch\\n got: %s\\nwant: %s\", got, want)\n\t\t\t}\n\t\t})\n\t}\n}\n\ntype finding struct {\n\tFingerprint, Title, Severity, Group string\n\tFiles                               []string\n\tBody                                string\n}\n\nfunc decode(t *testing.T, b []byte) []finding {\n\tt.Helper()\n\tvar out []finding\ninternal/scanner/finding.go:60:type Finding struct {\ninternal/scanner/finding.go-61-\tFingerprint string   `json:\"fingerprint\"` // required; stable across runs\ninternal/scanner/finding.go-62-\tTitle       string   `json:\"title\"`       // required; one line\ninternal/scanner/finding.go-63-\tSeverity    Severity `json:\"severity\"`    // required\ninternal/scanner/finding.go-64-\tGroup       string   `json:\"group\"`       // optional; \"\" = one issue per finding\ninternal/scanner/finding.go-65-\tFiles       []string `json:\"files\"`       // optional; repo-relative\ninternal/scanner/finding.go-66-\tBody        string   `json:\"body\"`        // optional markdown\ninternal/scanner/finding.go-67-}\ninternal/scanner/finding.go-68-\ninternal/scanner/finding.go-69-// DecodeError is one invalid line of scanner output.\ninternal/scanner/finding.go-70-type DecodeError struct {\ninternal/scanner/finding.go-71-\tLine int\ninternal/scanner/finding.go-72-\tMsg  string\ninternal/scanner/finding.go-73-}\ninternal/scanner/finding.go-74-\ninternal/scanner/finding.go-75-func (e DecodeError) Error() string { return fmt.Sprintf(\"line %d: %s\", e.Line, e.Msg) }\ninternal/scanner/finding.go-76-\ninternal/scanner/finding.go-77-// DecodeErrors lists the invalid lines of a scanner's output, at most 20.\ninternal/scanner/finding.go-78-type DecodeErrors []DecodeError\ninternal/scanner/finding.go-79-\ninternal/scanner/finding.go-80-func (e DecodeErrors) Error() string {\ninternal/scanner/finding.go-81-\tparts := make([]string, 0, len(e))\ninternal/scanner/finding.go-82-\tfor _, d := range e {\ninternal/scanner/finding.go-83-\t\tparts = append(parts, d.Error())\ninternal/scanner/finding.go-84-\t}\ninternal/scanner/finding.go-85-\treturn \"invalid scanner output: \" + strings.Join(parts, \"; \")\n# merge.jq: map osv-scanner and govulncheck output to ard findings (JSONL).\n#\n# Inputs (all via scan, see its header):\n#   --arg root <physical abs path of the scanned repo> --arg lroot <logical one>\n#   --slurpfile osv <osv-scanner --format json output>     ([] or [{\"results\":[...]}])\n#   --slurpfile gv  <JSONL, one {manifest, messages[, toolchain]} per Go module> ([] when absent;\n#     toolchain is set only when scan switched Go toolchains for that module)\n# Output: one compact JSON object per finding, sorted by fingerprint, keys in\n# the order fingerprint,title,severity,group,files,body. Pure and deterministic:\n# no timestamps, no tool versions. Written for jq 1.6+.\n\n# osv-scanner builds absolute paths from the logical cwd ($lroot), while $root\n# is the physical one; strip whichever matches.\ndef rel:\n  (if startswith($root + \"/\") then .[($root | length) + 1:]\n   elif startswith($lroot + \"/\") then .[($lroot | length) + 1:]\n   else . end)\n  | sub(\"^\\\\./\"; \"\");\n\ndef excluded:\n  split(\"/\") | .[:-1] | any(. == \"testdata\" or . == \"vendor\" or . == \"node_modules\");\n\ndef sevrank: {\"low\": 1, \"medium\": 2, \"high\": 3, \"critical\": 4}[.] // 0;\n\ndef dbsev:\n  if type != \"string\" then null\n  else ascii_downcase\n    | if . == \"critical\" or . == \"high\" or . == \"low\" then .\n      elif . == \"moderate\" or . == \"medium\" then \"medium\"\n      else null end\n  end;\n\ndef maxsev: map(select(. != null)) | if length == 0 then null else max_by(sevrank) end;\n\ndef firstnn: map(select(. != null and . != \"\")) | .[0];\n\n# ---- candidates ----\n\ndef osv_cands:\n  [ $osv[] | (.results // [])[]\n    | ((.source.path // \"\") | rel) as $m\n    | (if ($m | startswith(\"/\")) then error(\"cve: absolute manifest \" + $m) else . end)\n    | (.packages // [])[]\n    | .package as $p\n    | (.vulnerabilities // []) as $vs\n    | (.groups // [])[] as $g\n    | ($vs | map(select(.id as $i | any(($g.ids // [])[]; . == $i)))) as $mv\n    | {\n        tools: [\"osv-scanner\"],\n        manifest: $m,\n        package: $p.name,\n        ids: (([($g.ids // [])[], ($g.aliases // [])[], ($mv[] | (.aliases // [])[])]) | unique),\n        score: (($g.max_severity // null)\n                | if type == \"number\" then .\n                  elif type == \"string\" then (try tonumber catch null)\n                  else null end),\n        dbsev: ([$mv[] | .database_specific.severity | dbsev] | maxsev),\n        installed: ($p.version // null),\n        fixed: ([$mv[] | (.affected // [])[] | select(.package.name == $p.name)\n                 | (.ranges // [])[] | (.events // [])[] | .fixed | select(. != null)] | unique),\njq-1.8.2\n\t\t}\n\t\tm[rel] = string(b)\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn m\n}\n\nvar starterTree = []string{\".ard/config.yaml\", \".ard/reviewers/eng-review/prompt.txt\", \".ard/scanners/cve/Dockerfile\", \".ard/scanners/cve/merge.jq\", \".ard/scanners/cve/scan\", \".ard/triage/engineer/prompt.txt\", \".ard/triage/lead/prompt.txt\", \".ard/workers/engineer/prompt.txt\"}\n\nfunc TestInitOpensPR(t *testing.T) {\n\th := newHarness(t)\n\tbefore := snapshot(t, h.clone)\n\tout, err := h.run(t, false, false)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif got := h.tree(t, \"ard-init\"); !reflect.DeepEqual(got, starterTree) {\n\t\tt.Errorf(\"ard-init tree = %v, want %v\", got, starterTree)\n\t}\n\tif got := strings.TrimSpace(gittest.Run(t, h.bare, \"ls-tree\", \"-r\", \"ard-init\", \"--\", \".ard/scanners/cve/scan\")); !strings.HasPrefix(got, \"100755 \") {\n\t\tt.Errorf(\"scan = %q, want mode 100755\", got)\n\t}\n\tif !reflect.DeepEqual(snapshot(t, h.clone), before) {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01SfbqnqNDaaVWa5gmZDJqhV","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
