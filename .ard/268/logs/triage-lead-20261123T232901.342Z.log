odel: claude-sonnet-5-5, timeout: 60m, tests: make test }\n  reviewers/eng-review: { model: claude-sonnet-5-5 }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Y2tvV9NXCRdfE1TinERm8P","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
