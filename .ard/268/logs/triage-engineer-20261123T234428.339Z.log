l, \"/\")\n\tfor _, seg := range parts[:len(parts)-1] {\n\t\tdir = filepath.Join(dir, seg)\n\t\tfi, err := os.Lstat(dir)\n\t\tif errors.Is(err, os.ErrNotExist) {\n\t\t\treturn nil\n\t\t}\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"lstat %s: %w\", dir, err)\n\t\t}\n\t\tif fi.Mode()&os.ModeSymlink != 0 || !fi.IsDir() {\n\t\t\tge := &GuardError{}\n\t\t\tge.add(rel, \"parent directory is a symlink or not a directory\")\n\t\t\treturn ge\n\t\t}\n\t}\n\tif fi, err := os.Lstat(filepath.Join(root, filepath.FromSlash(rel))); err == nil && fi.Mode()&os.ModeSymlink != 0 {\n\t\tge := &GuardError{}\n\t\tge.add(rel, \"target is a symlink\")\n\t\treturn ge\n\t}\n\treturn nil\n}\n\nc925c4b feat: Janitor: prune old .ard/<issue#>/ directories (#61) (#229)\n71de398 feat: Reviewer selection rules (#42) (#209)\na0897e2 merger: squash-merge worker PRs that clear every gate (#46, part 2) (#207)\n1d7570d feat: serve: refuse to start on a git too old for the committer (#165) (#180)\n4105bd0 Add gitx Diff, AddedLinesBetween and CodeChanged for reviews","is_error":false}]},"parent_tool_use_id":null,"session_id":"3dda4cca-48ae-4b70-a658-6272e82e9dd4","uuid":"85ef91a0-3399-470f-b3aa-3d4cafe17ba1","timestamp":"2026-11-23T23:44:35.840Z","tool_use_result":{"stdout":"local.go:20:// worktreeAdminTimeout bounds each worktree add, remove and prune that runs\nlocal.go:24:// worktreeLock takes the process-wide worktree-administration lock for the\nlocal.go:26:func (g *Git) worktreeLock(ctx context.Context, repoDir string) (func(), error) {\nlocal.go:35:\tunlock, err := wtlock.Lock(ctx, dir)\nlocal.go:78:// WorktreeAdd checks ref out detached at path. Detached, because the branch\nlocal.go:82:func (g *Git) WorktreeAdd(ctx context.Context, repoDir, path, ref string) error {\nlocal.go:85:\tunlock, err := g.worktreeLock(ctx, repoDir)\nlocal.go:96:// WorktreeRemove deletes the worktree at path, whatever state it is in, and\nlocal.go:97:// prunes stale registrations. A missing worktree is not an error. It 