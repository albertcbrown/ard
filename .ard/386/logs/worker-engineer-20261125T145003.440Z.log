text(ctx, `INSERT INTO events(ts, kind, job_id, issue, stage, role, data)\n\t\tVALUES(?,?,?,?,?,?,?)`, e.At.Unix(), e.Kind, job, issue, stage, role, data); err != nil {\n\t\treturn fmt.Errorf(\"append event %s: %w\", e.Kind, err)\n\t}\n\treturn nil\n}\n\n// AppendEvent appends e; a zero At means now.\nfunc (s *Store) AppendEvent(ctx context.Context, e Event) error {\n\tif e.Kind == \"\" {\n\t\treturn fmt.Errorf(\"append event: empty kind\")\n\t}\n\tif e.At.IsZero() {\n\t\te.At = s.now()\n\t}\n\treturn insertEvent(ctx, s.db, e)\n}\n\n// Events returns matching events in ascending id order.\nfunc (s *Store) Events(ctx context.Context, f EventFilter) ([]Event, error) {\n\tq := `SELECT id, ts, kind, job_id, issue, stage, role, data FROM events WHERE 1=1`\n\tvar args []any\n\tif !f.Since.IsZero() {\n\t\tq += ` AND ts >= ?`\n\t\targs = append(args, f.Since.Unix())\n\t}\n\tif !f.Until.IsZero() {\n\t\tq += ` AND ts <= ?`\n\t\targs = append(args, f.Until.Unix())\n\t}\n\tif f.Kind != \"\" {\n\t\tq += ` AND kind = ?`\n\t\targs = append(args, f.Kind)\n\t}\n\tif f.Issue != 0 {\n\t\tq += ` AND issue = ?`\n\t\targs = append(args, f.Issue)\n\t}\n\tif f.Stage != \"\" {\n\t\tq += ` AND stage = ?`\n\n// gateHarness is a harness with a worker role engineer, an engineer triage role\n// and require_approval as given.\nfunc gateHarness(t *testing.T, approval bool, opts ...option) *harness {\n\tt.Helper()\n\th := newHarness(t, opts...)\n\th.cfg.RequireApproval = approval\n\th.cfg.Roles = append(h.cfg.Roles,\n\t\tconfig.Role{Kind: config.KindWorker, Name: \"engineer\", Dir: \".ard/workers/engineer\", Agent: \"claude\", Timeout: time.Minute},\n\t\tconfig.Role{Kind: config.KindTriage, Name: \"engineer\", Dir: \".ard/triage/engineer\", Agent: \"claude\", Timeout: time.Minute})\n\treturn h\n}\n\nvar (\n\tleadDone = labels.Done(labels.StageTriage, \"lead\")\n\ttDone    = t0.Add(time.Hour) // when the last triage :done was added\n)\n\n// seedLead records the lead's closed close-out with the given