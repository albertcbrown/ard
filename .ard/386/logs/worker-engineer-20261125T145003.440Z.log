{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0165tonUrEkp9SWpd1eqAtat","type":"tool_result","content":"package digest\n\nimport (\n\t\"fmt\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\n// Data is what one digest reports. Day is the UTC day covered (2006-01-02).\ntype Data struct {\n\tDay   string\n\tQueue map[string]int\n\tJobs  map[state.RoleKey]state.JobCounts\n\tSpend map[state.RoleKey]state.Spend\n\tTotal state.Spend\n}\n\nfunc (d Data) counts() (jobs, failed int) {\n\tfor _, c := range d.Jobs {\n\t\tjobs += c.Done + c.Failed\n\t\tfailed += c.Failed\n\t}\n\treturn\n}\n\nvar safeName = regexp.MustCompile(`^[a-z0-9._/:-]+$`)\n\nfunc safe(s string) string {\n\tif safeName.MatchString(s) {\n\t\treturn s\n\t}\n\treturn \"?\"\n}\n\n// Render is the digest comment. It holds only numbers, the day and label and\n// role names; no agent text, no issue titles and no \"@\".\nfunc Render(d Data) string {\n\tvar b strings.Builder\n\tfmt.Fprintf(&b, \"<!-- ard:digest day=%s -->\\n\", safe(d.Day))\n\tfmt.Fprintf(&b, \"**ard · daily digest for %s (UTC)**\\n\\n\", safe(d.Day))\n\n\tb.WriteString(\"**Queue depth** (open issues by label)\\n\\n\")\n\tif len(d.Queue) == 0 {\n\t\tb.WriteString(\"No open issue carries an `ard:` label.\\n\")\n\t} else {\n\t\tb.WriteString(\"| Label | Issues |\\n|---|---|\\n\")\n\t\tnames := make([]string, 0, len(d.Queue))\n\t\tfor n := range d.Queue {\n\t\t\tnames = append(names, n)\n\t\t}\n\t\tsort.Strings(names)\n\t\tfor _, n := range names {\n\t\t\tfmt.Fprintf(&b, \"| `%s` | %d |\\n\", safe(n), d.Queue[n])\n\t\t}\n\t}\n\n\tjobs, failed := d.counts()\n\tfmt.Fprintf(&b, \"\\n**Jobs run:** %d\\n\\n**Failures:** %d\\n\", jobs, failed)\n\tkeys := make([]state.RoleKey, 0, len(d.Jobs))\n\tfor k, c := range d.Jobs {\n\t\tif c.Failed > 0 {\n\t\t\tkeys = append(keys, k)\n\t\t}\n\t}\n\tsort.Slice(keys, func(i, j int) bool {\n\t\tif keys[i].Stage != keys[j].Stage {\n\t\t\treturn keys[i].Stage < keys[j].Stage\n\t\t}\n\t\treturn keys[i].Role < keys[j].Role\n\t})\n\tif len(keys) > 0 {\n\t\tb.WriteString(\"\\n| Role | Failed |\\n|---|---|\\n\")\n\t\tfor _, k := range keys {\n\t\t\tfmt.Fprintf(&b, \"| %s/%s | %d |\\n\", safe(k.Stage), safe(k.Role), d.Jobs[k].Failed)\n\t\t}\n\t}\n\n119:\t\t\tif strings.HasPrefix(lb, labels.Prefix) {\n132:\tdata := Data{Day: day, Queue: queue, Jobs: jobs, Spend: perSpend, Total: spend}\n\tn := is.Number\n\tif !strings.EqualFold(is.Author, t.self) {\n\t\tstored, err := l.d.Store.Admission(ctx, n)\n\t\tif err != nil {\n\t\t\tif errors.Is(err, state.ErrNotFound) {\n\t\t\t\tt.log.Info(\"triage.not_admitted\", \"issue\", n, \"role\", leadRole)\n\t\t\t\treturn nil\n\t\t\t}\n\t\t\treturn fmt.Errorf(\"triage gate issue %d: read admission: %w\", n, err)\n\t\t}\n\t\tif hash := agentjob.BodyHash(is); stored.BodyHash != hash {\n\t\t\treturn t.regateAfterTriage(ctx, is, hash, worker)\n\t\t}\n\t}\n\t// A network round always needs a fresh approval, whatever require_approval\n\t// says and even when the engineer removed every network need.\n\tif t.cfg.RequireApproval || rounds > 0 {\n\t\tok, err := t.approved(ctx, is, jobID, worker, rounds)\n\t\tif err != nil || !ok {\n\t\t\treturn err\n\t\t}\n\t}\n\tif err := l.d.Effects.AddLabels(ctx, n, labels.Request(labels.StageWorker, worker)); err != nil {\n\t\treturn fmt.Errorf(\"triage gate issue %d: add worker label: %w\", n, err)\n\t}\n\tt.gateEvent(ctx, n, \"start\", rStart, worker)\ninternal/triage/fanin_test.go:106:// gateHarness is a harness with a worker role engineer, an engineer triage role\ninternal/triage/fanin_test.go:108:func gateHarness(t *testing.T, approval bool, opts ...option) *harness {\ninternal/triage/fanin_test.go:145:func (h *harness) ready(extra ...string) int {\ninternal/triage/fanin_test.go:164:func commentsWith(h *harness, n int, sub string) int {\ninternal/triage/fanin_test.go:175:\th := gateHarness(t, false)\ninternal/triage/fanin_test.go:193:\t\th := gateHar