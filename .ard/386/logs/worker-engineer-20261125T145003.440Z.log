irect"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":813,"cache_read_input_tokens":95455,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":813},"output_tokens":39,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2f1a6b2e-e8cb-4137-ab71-597118ce4930","uuid":"7f5ce641-ba99-4100-ae45-1d4ae874b30c","timestamp":"2026-11-25T14:54:32.467Z","request_id":"req_011ChPqaa4FbrePz2cp54NKY"}
