t)\n\t}\n\tfiles := gittest.Run(t, bare, \"ls-tree\", \"-r\", \"--name-only\", \"main\")\n\tif !strings.Contains(files, \"logs/\") {\n\t\tt.Fatalf(\"no log was committed:\\n%s\", files)\n\t}\n\tfor _, f := range strings.Fields(files) {\n\t\tif got := gittest.Run(t, bare, \"show\", \"main:\"+f); strings.Contains(got, tok) {\n\t\t\tt.Fatalf(\"%s in the commit holds the token\", f)\n\t\t}\n\t}\n}\n400:func (c *Closer) Run(ctx context.Context, j Job) (Outcome, error) {\n441:func (c *Closer) ResumeJob(ctx context.Context, id string) (Outcome, error) {\n466:func (c *Closer) Resume(ctx context.Context) error {","is_error":false}]},"parent_tool_use_id":null,"session_id":"2f1a6b2e-e8cb-4137-ab71-597118ce4930","uuid":"1eb1982b-8bab-4ffe-9ea5-55708fba9956","timestamp":"2026-11-25T14:54:41.059Z","tool_use_result":{"stdout":"\thome, _ := os.UserHomeDir()\n\tst, err := state.Open(context.Background(), t.TempDir(), state.Options{})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Cleanup(func() { st.Close() })\n\tw := &wiring{\n\t\tLog: slog.New(slog.NewTextHandler(io.Discard, nil)), Repo: github.Repo{Owner: \"o\", Name: \"r\"},\n\t\tRoot: t.TempDir(), Home: home, Store: st, Reader: fake.New(), StateDir: t.TempDir(),\n\t}\n\tt.Cleanup(w.closeAll)\n\treturn w\n}\n\n// One Closer, one main committer, one executor, one Finisher: the loops, the\n// scanners and the Reaper must share them.\nfunc TestSharedParts(t *testing.T) {\n\tw := newTestWiring(t)\n\tif w.closer() != w.closer() {\n\t\tt.Error(\"closer is not shared\")\n\t}\n\tif w.mainCommitter() != w.mainCommitter() || w.branchCommitter() != w.branchCommitter() {\n\t\tt.Error(\"committers are not shared\")\n\t}\n\ta, err := w.newExecutor()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif b, _ := w.newExecutor(); a != b {\n\t\tt.Error(\"executor is not shared\")\n\t}\n\tf1, err := w.finisher()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf2, _ := w.finisher()\n\tn := gh.SeedIssue(github.Issue{Title: \"t\", Labels: []string{labels.Pend