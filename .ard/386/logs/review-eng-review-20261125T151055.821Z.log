0\t+\t}\n221\t+\tfor _, r := range recs {\n222\t+\t\tif r.Job.Role == \"lead\" && r.Plan.Outcome == OutcomeDone && r.Job.ID > rearm.Job.ID {\n223\t+\t\t\treturn nil, nil\n224\t+\t\t}\n225\t+\t}\n226\t+\treturn rearm.Plan.Rerun, nil\n227\t+}\n228\t+\n229\t+// InputsOf returns the inputs: list of the newest triage engineer done\n230\t+// close-out of issue. ok is false when there is none.\n231\t+func InputsOf(ctx context.Context, s closeoutsOf, issue int) ([]Input, bool, error) {\n232\t+\trecs, err := triageRecords(ctx, s, issue)\n233\t+\tif err != nil {\n234\t+\t\treturn nil, false, err\n235\t+\t}\n236\t+\tvar best *Record\n237\t+\tfor i := range recs {\n238\t+\t\tr := &recs[i]\n239\t+\t\tif r.Job.Role == \"engineer\" && r.Plan.Outcome == OutcomeDone && (best == nil || r.Job.ID > best.Job.ID) {\n240\t+\t\t\tbest = r\n241\t+\t\t}\n242\t+\t}\n243\t+\tif best == nil {\n244\t+\t\treturn nil, false, nil\n245\t \t}\n246\t-\treturn n, nil\n247\t+\treturn best.Plan.Inputs, true, nil\n248\t }\n249\t \n250\t // NetworkRequest returns the redacted network list of the newest closed worker\n251\tdiff --git a/internal/closeout/network_test.go b/internal/closeout/network_test.go\n252\tindex 1ec6da9..8791b8e 100644\n253\t--- a/internal/closeout/network_test.go\n254\t+++ b/internal/closeout/network_test.go\n255\t@@ -78,8 +78,10 @@ func TestNetworkRoundsAndRequest(t *testing.T) {\n256\t \t\tnetRecord(t, \"a\", PhaseCommented, OutcomeNeedsNetwork, true),\n257\t \t\tnetRecord(t, \"b\", PhaseClosed, OutcomeDone, false),\n258\t \t}}\n259\t-\tif n, err := NetworkRounds(ctx, none, 7); err != nil || n != 0 {\n260\t-\t\tt.Errorf(\"rounds = %d, %v; want 0\", n, err)\n261\t+\t// A record that is not closed yet still counts: the plan never changes\n262\t+\t// after Prepare, and a crash must not make a round read as not open.\n263\t+\tif n, err := NetworkRounds(ctx, none, 7); err != nil || n != 1 {\n264\t+\t\tt.Errorf(\"rounds = %d, %v; want 1\", n, err)\n265\t \t}\n266\t \tif _, ok, err := Netwo