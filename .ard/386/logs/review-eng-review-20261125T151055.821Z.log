t.Fatal(err)\n653\t+\t}\n654\t+\tb, err := json.Marshal(Record{Version: recordVersion, Phase: phase, Job: Job{ID: sj.ID, Stage: stage, Role: role, Issue: e.issue}, Plan: p})\n655\t+\tif err != nil {\n656\t+\t\te.t.Fatal(err)\n657\t+\t}\n658\t+\tif err := e.store.SetCloseout(ctx, sj.ID, string(phase), b); err != nil {\n659\t+\t\te.t.Fatal(err)\n660\t+\t}\n661\t+\tif phase == PhaseClosed {\n662\t+\t\tif err := e.store.Complete(ctx, sj.ID, nil); err != nil {\n663\t+\t\t\te.t.Fatal(err)\n664\t+\t\t}\n665\t+\t}\n666\t+\treturn sj.ID\n667\t+}\n668\t+\n669\t+func (e *env) storedRecord(id string) Record {\n670\t+\te.t.Helper()\n671\t+\trec, err := decode(e.sjob(id))\n672\t+\tif err != nil {\n673\t+\t\te.t.Fatal(err)\n674\t+\t}\n675\t+\treturn rec\n676\t+}\n677\t+\n678\t+// openRound seeds a lead and architect done, then a bounced worker record in\n679\t+// the given phase.\n680\t+func (e *env) openRound(phase Phase) {\n681\t+\te.seedRecord(StageTriage, \"lead\", PhaseClosed, Plan{Outcome: OutcomeDone})\n682\t+\te.seedRecord(StageTriage, \"architect\", PhaseClosed, Plan{Outcome: OutcomeDone})\n683\t+\te.seedRecord(StageWorker, \"engineer\", phase, Plan{Outcome: OutcomeNeedsNetwork, Bounced: true, Network: needSpec})\n684\t+}\n685\t+\n686\t+func TestPrepareRoundOpen(t *testing.T) {\n687\t+\t// A worker record that never closed (phase prepared) still opens the round.\n688\t+\tfor _, phase := range []Phase{PhaseClosed, PhasePrepared} {\n689\t+\t\te := newEnv(t)\n690\t+\t\te.d.Network = e.store\n691\t+\t\te.openRound(phase)\n692\t+\t\te.write(\".ard/7/triage-engineer.md\", roleFile(\"engineer\", \"done\",\n693\t+\t\t\t\"inputs:\\n  - path: data/spec.txt\\n    provider: human\"))\n694\t+\t\tj := e.claim(StageTriage, \"engineer\")\n695\t+\t\tif out, err := New(e.d).Run(context.Background(), j); err != nil || out != OutcomeDone {\n696\t+\t\t\tt.Fatalf(\"phase %s: Run = %s, %v\", phase, out, err)\n697\t+\t\t}\n698\t+\t\trec := e.storedRecord(j.ID)\n699\t+\t\tif rec.Job.Network == nil || !rec.Job.Network.Round || !reflect.DeepEqual(rec.Job.Network.Done, []string{\"architect\"}) {\n700\t+\t\t\tt.Fatalf(\"phase %s: persisted network state = %+v\", phase, rec.Job.Network)\n701\t+\t\t}\n702\t+\t\tif !rec.Plan.Rearmed || !reflect.DeepEqual(rec.Plan.Rerun, []string{\"architect\"}) ||\n703\t+\t\t\t!reflect.DeepEqual(rec.Plan.Inputs, []Input{{Path: \"data/spec.txt\", Provider: \"human\"}}) {\n704\t+\t\t\tt.Errorf(\"phase %s: plan = %+v\", phase, rec.Plan)\n705\t+\t\t}\n706\t+\t\tl := e.labels(7)\n707\t+\t\tif !l[\"ard:pending\"] || l[\"ard:triage:lead:done\"] || !l[\"ard:triage:engineer:done\"] {\n708\t+\t\t\tt.Errorf(\"phase %s: labels = %v\", phase, l)\n709\t+\t\t}\n710\t+\t}\n711\t+}\n712\t+\n713\t+func TestPrepareNoRoundNoRearm(t *testing.T) {\n714\t+\te := newEnv(t)\n715\t+\te.d.Network = e.store\n716\t+\te.seedRecord(StageTriage, \"lead\", PhaseClosed, Plan{Outcome: OutcomeDone})\n717\t+\te.write(\".ard/7/triage-engineer.md\", roleFile(\"engineer\", \"done\"))\n718\t+\tj := e.claim(StageTriage, \"engineer\")\n719\t+\tif _, err := New(e.d).Run(context.Background(), j); err != nil {\n720\t+\t\tt.Fatal(err)\n721\t+\t}\n722\t+\tif rec := e.storedRecord(j.ID); rec.Plan.Rearmed || (rec.Job.Network != nil && rec.Job.Network.Round) {\n723\t+\t\tt.Errorf(\"rearmed without a round: %+v %+v\", rec.Plan, rec.Job.Network)\n724\t+\t}\n725\t+}\n726\t+\n727\t+func TestRearmConsumedByFirstEngineerDone(t *testing.T) {\n728\t+\te := newEnv(t)\n729\t+\te.d.Network = e.store\n730\t+\te.openRound(PhaseClosed)\n731\t+\te.write(\".ard/7/triage-engineer.md\", roleFile(\"engineer\", \"done\"))\n732\t+\tfirst := e.claim(StageTriage, \"engineer\")\n733\t+\tif _, err := New(e.d).Run(context.Background(), first); err != nil {\n734\t+\t\tt.Fatal(err)\n735\t+\t}\n736\t+\t// A human re-requests the engineer: no open round, no second re-arm.\n737\t+\tsecond := e.claim(StageTriage, \"engineer\")\n738\t+\tif _, err := New(e.d).Run(context.Background(), second); err != nil {\n739\t+\t\tt.Fatal(err)\n740\t+\t}\n741\t+\tif rec := e.storedRecord(second.ID); rec.Plan.Rearmed || rec.Job.Network != nil && rec.Job.Network.Round {\n742\t+\t\tt.Errorf(\"second engineer done re-armed: %+v\", rec.Plan)\n743\t+\t}\n744\t+}\n745\t+\n746\t+func TestResumeReplaysRound(t *testing.T) {\n747\t+\te := newEnv(t)\n748\t+\te.d.Network = e.store\n749\t+\te.seedRecord(StageTriage, \"architect\", PhaseClosed, Plan{Outcome: OutcomeDone})\n750\t+\te.seedRecord(StageTriage, \"engineer\", PhaseClosed, Plan{Outcome: OutcomeDone, Rearmed: true, Rerun: []string{\"architect\"}})\n751\t+\te.write(\".ard/7/triage-lead.md\", roleFile(\"lead\", \"done\", \"worker: engineer\"))\n752\t+\tj := e.claim(StageTriage, \"lead\")\n753\t+\te.d = e.deps(0)\n754\t+\te.d.Network = e.store\n755\t+\te.fstore.failAt = 3 // prepared, committed, then fail while saving \"requested\"\n756\t+\tc := New(e.d)\n757\t+\tif _, err := c.Run(context.Background(), j); err == nil {\n758\t+\t\tt.Fatal(\"expected the injected store failure\")\n759\t+\t}\n760\t+\te.fstore.failAt = 0\n761\t+\trec := e.storedRecord(j.ID)\n762\t+\tif rec.Job.Network == nil || !reflect.DeepEqual(rec.Job.Network.Rerun, []string{\"architect\"}) {\n763\t+\t\tt.Fatalf(\"persisted network state = %+v\", rec.Job.Network)\n764\t+\t}\n765\t+\t// The store changes: a newer re-arm names another role, so a fresh\n766\t+\t// LeadRerun would say designer, not architect.\n767\t+\te.seedRecord(StageTriage, \"engineer\", PhaseClosed, Plan{Outcome: OutcomeDone, Rearmed: true, Rerun: []string{\"designer\"}})\n768\t+\tif got, _ := LeadRerun(context.Background(), e.store, 7); !reflect.DeepEqual(got, []string{\"designer\"}) {\n769\t+\t\tt.Fatalf(\"LeadRerun after the change = %v\", got)\n770\t+\t}\n771\t+\tif out, err := c.ResumeJob(context.Background(), j.ID); err != nil || out != OutcomeDone {\n772\t+\t\tt.Fatalf(\"ResumeJob = %s, %v\", out, err)\n773\t+\t}\n774\t+\tl := e.labels(7)\n775\t+\tif !l[\"ard:triage:architect\"] || l[\"ard:triage:architect:done\"] || l[\"ard:triage:designer\"] || !l[\"ard:triage:lead:done\"] {\n776\t+\t\tt.Errorf(\"replay did not use the stored plan: labels %v\", l)\n777\t+\t}\n778\t+}\n779\t+\n780\t+func TestInputsRedacted(t *testing.T) {\n781\t+\te := newEnv(t)\n782\t+\te.d.Network = e.store\n783\t+\te.write(\".ard/7/triage-engineer.md\", roleFile(\"engineer\", \"done\",\n784\t+\t\t\"inputs:\\n  - path: a.txt\\n    provider: worker\\n    url: https://example.com/x?key=\"+secretValue))\n785\t+\tj := e.claim(StageTriage, \"engineer\")\n786\t+\tif out, err := New(e.d).Run(context.Background(), j); err != nil || out != OutcomeDone {\n787\t+\t\tt.Fatalf(\"Run = %s, %v\", out, err)\n788\t+\t}\n789\t+\trec := e.storedRecord(j.ID)\n790\t+\tb, _ := json.Marshal(rec.Plan)\n791\t+\tif strings.Contains(string(b), secretValue) || len(rec.Plan.Inputs) != 1 || !strings.Contains(rec.Plan.Inputs[0].URL, \"[REDACTED\") {\n792\t+\t\tt.Errorf(\"stored inputs not redacted: %s\", b)\n793\t+\t}\n794\t+}\n795\t+\n796\t+// An input list that no longer parses after redaction ends needs-human.\n797\t+func TestInputsLostNeedsHuman(t *testing.T) {\n798\t+\te := newEnv(t)\n799\t+\te.d.Network = e.store\n800\t+\te.write(\".ard/7/triage-engineer.md\", roleFile(\"engineer\", \"done\",\n801\t+\t\t\"inputs:\\n  - path: \"+secretValue+\"\\n    provider: human\"))\n802\t+\tj := e.claim(StageTriage, \"engineer\")\n803\t+\tif out, err := New(e.d).Run(context.Background(), j); err != nil || out != OutcomeNeedsHuman {\n804\t+\t\tt.Fatalf(\"Run = %s, %v\", out, err)\n805\t+\t}\n806\t+\trec := e.storedRecord(j.ID)\n807\t+\tif !strings.Contains(rec.Plan.Reason, \"inputs list unreadable\") || len(rec.Plan.Inputs) != 0 {\n808\t+\t\tt.Errorf(\"plan = %+v\", rec.Plan)\n809\t+\t}\n810\t+}\n811\t+\n812\t+func TestInputsOfAndNetworkRoundCount(t *testing.T) {\n813\t+\tctx := context.Background()\n814\t+\ts := stageStore{\n815\t+\t\tStageWorker: {netRecord(t, \"03\", PhaseCommented, OutcomeNeedsNetwork, true)},\n816\t+\t\tStageTriage: