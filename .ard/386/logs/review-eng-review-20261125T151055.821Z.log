cord, error) {\n \t\t\t}\n \t\t\tj.Network = &NetworkState{Prior: prior}\n \t\t}\n+\t\trf.Inputs = inputs\n \t\tplan = Build(j, rf, d.Roles)\n \t\tif plan.Outcome == OutcomeNeedsNetwork {\n \t\t\tplan.Network = network\ndiff --git a/internal/closeout/rolefile.go b/internal/closeout/rolefile.go\nindex 90313b1..d3c1da2 100644\n--- a/internal/closeout/rolefile.go\n+++ b/internal/closeout/rolefile.go\n@@ -89,6 +89,21 @@ type RoleFile struct {\n \t// Network are the inputs a needs-network worker asks for, in file order.\n \t// Only a needs-network worker has them (Parse, check).\n \tNetwork []NetworkNeed\n+\t// Inputs are the inputs a triage engineer declares for the worker. Only\n+\t// the triage engineer may have them (check).\n+\tInputs []Input\n+}\n+\n+// MaxInputs bounds the inputs of one engineer role file.\n+const (\n+\tMaxInputs    = 10\n+\tMaxInputPath = 200\n+)\n+\n+// Input is one input the engineer declares: a repo path on main, who provides\n+// it (\"human\" or \"worker\") and an optional https URL it comes from.\n+type Input struct {\n+\tPath, Provider, URL string\n }\n \n // NetworkNeed is one network input a worker could not fetch itself.\n@@ -161,6 +176,12 @@ type rawNetwork struct {\n \tVerify *string `yaml:\"verify\"`\n }\n \n+type rawInput struct {\n+\tPath     *string `yaml:\"path\"`\n+\tProvider *string `yaml:\"provider\"`\n+\tURL      *string `yaml:\"url\"`\n+}\n+\n type rawFront struct {\n \tRole    *string   `yaml:\"role\"`\n \tStatus  *string   `yaml:\"status\"`\n@@ -172,6 +193,7 @@ type rawFront struct {\n \tFindings *[]rawFinding `yaml:\"findings\"`\n \tFetched  *[]rawFetched `yaml:\"fetched\"`\n \tNetwork  *[]rawNetwork `yaml:\"network\"`\n+\tInputs   *[]rawInput   `yaml:\"inputs\"`\n }\n \n func malformed(format string, a ...any) error {\n@@ -258,6 +280,11 @@ func Parse(b []byte) (RoleFile, error) {\n \t\t\treturn RoleFile{}, err\n \t\t}\n \t}\n+\tif raw.Inputs != nil {\n+\t\tif rf.Inputs, err = inputsOf(*raw.Inputs); err != nil {\n+\t\t\treturn RoleFile{}, err\n+\t\t}\n+\t}\n \tswitch rf.Status {\n \tcase StatusDone, StatusBlocked, StatusNeedsHuman, StatusNeedsNetwork:\n \tdefault:\n@@ -299,6 +326,9 @@ func (rf RoleFile) check(j Job) error {\n \tif len(rf.Fetched) > 0 && j.Stage != StageWorker {\n \t\treturn malformed(\"fetched is allowed only on a worker\")\n \t}\n+\tif len(rf.Inputs) > 0 && !(j.Stage == StageTriage && j.Role == \"engineer\") {\n+\t\treturn malformed(\"inputs is allowed only for triage:engineer\")\n+\t}\n \tif rf.Status == StatusNeedsNetwork && j.Stage != StageWorker {\n \t\treturn malformed(\"needs-network is allowed only on a worker\")\n \t}\n@@ -444,6 +474,38 @@ func networkOf(raw []rawNetwork) ([]NetworkNeed, error) {\n \treturn out, nil\n }\n \n+// inputsOf validates the inputs of a triage engineer.\n+func inputsOf(raw []rawInput) ([]Input, error) {\n+\tif len(raw) > MaxInputs {\n+\t\treturn nil, malformed(\"%d inputs, max %d\", len(raw), MaxInputs)\n+\t}\n+\tout := make([]Input, 0, len(raw))\n+\tfor i, r := range raw {\n+\t\tn := i + 1\n+\t\tif r.Path == nil || strings.TrimSpace(*r.Path) == \"\" {\n+\t\t\treturn nil, malformed(\"input %d: missing path\", n)\n+\t\t}\n+\t\tif r.Provider == nil || (*r.Provider != \"human\" && *r.Provider != \"worker\") {\n+\t\t\treturn nil, malformed(\"input %d: provider is not human or worker\", n)\n+\t\t}\n+\t\tv := Input{Path: *r.Path, Provider: *r.Provider}\n+\t\tif len(v.Path) > MaxInputPath {\n+\t\t\treturn nil, malformed(\"input %d: path is over %d bytes\", n, MaxInputPath)\n+\t\t}\n+\t\tif r.URL != nil {\n+\t\t\tv.URL = *r.URL\n+\t\t\tif len(v.URL) > MaxNetworkURL {\n+\t\t\t\treturn nil, malformed(\"input %d: url is %d bytes, max %d\", n, len(v.URL), MaxNetworkURL)\n+\t\t\t}\n+\t\t\tif err := checkHTTPS(v.URL); err != nil {\n+\t\t\t\treturn nil, malformed(\"input %d: url %v\", n, err)\n+\t\t\t}\n+\t\t}\n+\t\tout = append(out, v)\n+\t}\n+\treturn out, nil\n+}\n+\n func isSHA256(s string) bool {\n \tif len(s) != 64 {\n \t\treturn false\ndiff --git a/internal/closeout/round_test.go b/internal/closeout/round_test.go\nnew file mode 100644\nindex 0000000..445c21d\n--- /dev/null\n+++ b/internal/closeout/round_test.go\n@@ -0,0 +1,200 @@\n+package closeout\n+\n+import (\n+\t\"context\"\n+\t\"encoding/json\"\n+\t\"reflect\"\n+\t\"strings\"\n+\t\"testing\"\n+\n+\t\"github.com/albertcbrown/ard/internal/state\"\n+)\n+\n+// seedRecord stores a close-out record for a job of the env's issue, created\n+// now, so later claims sort after it by ID.\n+func (e *env) seedRecord(stage, role string, phase Phase, p Plan) string {\n+\te.t.Helper()\n+\tctx := context.Background()\n+\tsj, err := e.store.CreateJob(ctx, state.NewJob{Stage: stage, Role: role, Issue: e.issue})\n+\tif err != nil {\n+\t\te.t.Fatal(err)\n+\t}\n+\tb, err := json.Marshal(Record{Version: recordVersion, Phase: phase, Job: Job{ID: sj.ID, Stage: stage, Role: role, Issue: e.issue}, Plan: p})\n+\tif err != nil {\n+\t\te.t.Fatal(err)\n+\t}\n+\tif err := e.store.SetCloseout(ctx, sj.ID, string(phase), b); err != nil {\n+\t\te.t.Fatal(err)\n+\t}\n+\tif phase == PhaseClosed {\n+\t\tif err := e.store.Complete(ctx, sj.ID, nil); err != nil {\n+\t\t\te.t.Fatal(err)\n+\t\t}\n+\t}\n+\treturn sj.ID\n+}\n+\n+func (e *env) storedRecord(id string) Record {\n+\te.t.Helper()\n+\trec, err := decode(e.sjob(id))\n+\tif err != nil {\n+\t\te.t.Fatal(err)\n+\t}\n+\treturn rec\n+}\n+\n+// openRound seeds a lead and architect done, then a bounced worker record in\n+// the given phase.\n+func (e *env) openRound(phase Phase) {\n+\te.seedRecord(StageTriage, \"lead\", PhaseClosed, Plan{Outcome: OutcomeDone})\n+\te.seedRecord(StageTriage, \"architect\", PhaseClosed, Plan{Outcome: OutcomeDone})\n+\te.seedRecord(StageWorker, \"engineer\", phase, Plan{Outcome: OutcomeNeedsNetwork, Bounced: true, Network: needSpec})\n+}\n+\n+func TestPrepareRoundOpen(t *testing.T) {\n+\t// A worker record that never closed (phase prepared) still opens the round.\n+\tfor _, phase := range []Phase{PhaseClosed, PhasePrepared} {\n+\t\te := newEnv(t)\n+\t\te.d.Network = e.store\n+\t\te.openRound(phase)\n+\t\te.write(\".ard/7/triage-engineer.md\", roleFile(\"engineer\", \"done\",\n+\t\t\t\"inputs:\\n  - path: data/spec.txt\\n    provider: human\"))\n+\t\tj := e.claim(StageTriage, \"engineer\")\n+\t\tif out, err := New(e.d).Run(context.Background(), j); err != nil || out != OutcomeDone {\n+\t\t\tt.Fatalf(\"phase %s: Run = %s, %v\", phase, out, err)\n+\t\t}\n+\t\trec := e.storedRecord(j.ID)\n+\t\tif rec.Job.Network == nil || !rec.Job.Network.Round || !reflect.DeepEqual(rec.Job.Network.Done, []string{\"architect\"}) {\n+\t\t\tt.Fatalf(\"phase %s: persisted network state = %+v\", phase, rec.Job.Network)\n+\t\t}\n+\t\tif !rec.Plan.Rearmed || !reflect.DeepEqual(rec.Plan.Rerun, []string{\"architect\"}) ||\n+\t\t\t!reflect.DeepEqual(rec.Plan.Inputs, []Input{{Path: \"data/spec.txt\", Provider: \"human\"}}) {\n+\t\t\tt.Errorf(\"phase %s: plan = %+v\", phase, rec.Plan)\n+\t\t}\n+\t\tl := e.labels(7)\n+\t\tif !l[\"ard:pending\"] || l[\"ard:triage:lead:done\"] || !l[\"ard:triage:engineer:done\"] {\n+\t\t\tt.Errorf(\"phase %s: labels = %v\", phase, l)\n+\t\t}\n+\t}\n+}\n+\n+func TestPrepareNoRoundNoRearm(t *testing.T) {\n+\te := newEnv(t)\n+\te.d.Network = e.store\n+\te.seedRecord(StageTriage, \"lead\", PhaseClosed, Plan{Outcome: OutcomeDone})\n+\te.write(\".ard/7/triage-engineer.md\", roleFile(\"engineer\", \"done\"))\n+\tj := e.claim(StageTriage, \"engineer\")\n+\tif _, err := New(e.d).Run(context.Background(), j); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif rec := e.storedRecord(j.ID); rec.Plan.Rearmed || (rec.Job.Network != nil && rec.Job.Network.Round) {\n+\t\tt.Errorf(\"rearmed without a round: %+v %+v\", rec.Plan, rec.Job.Network)\n+\t}\n+}\n+\n+func TestRearmConsumedByFirstEngineerDone(t *testing.T) {\n+\te := newEnv(t)\n+\te.d.Network = e.store\n+\te.openRound(PhaseClosed)\n+\te.write(\".ard/7/triage-engineer.md\", roleFile(\"engineer\", \"done\"))\n+\tfirst := e.claim(StageTriage, \"engineer\")\n+\tif _, err := New(e.d).Run(context.Background(), first); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\t// A human re-requests the engineer: no open round, no second re-arm.\n+\tsecond := e.claim(StageTriage, \"engineer\")\n+\tif _, err := New(e.d).Run(context.Background(), second); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif rec := e.storedRecord(second.ID); rec.Plan.Rearmed || rec.Job.Network != nil && rec.Job.Network.Round {\n+\t\tt.Errorf(\"second engineer done re-armed: %+v\", rec.Plan)\n+\t}\n+}\n+\n+func TestResumeReplaysRound(t *testing.T) {\n+\te := newEnv(t)\n+\te.d.Network = e.store\n+\te.seedRecord(StageTriage, \"architect\", PhaseClosed, Plan{Outcome: OutcomeDone})\n+\te.seedRecord(StageTriage, \"engineer\", PhaseClosed, Plan{Outcome: OutcomeDone, Rearmed: true, Rerun: []string{\"architect\"}})\n+\te.write(\".ard/7/triage-lead.md\", roleFile(\"lead\", \"done\", \"worker: engineer\"))\n+\tj := e.claim(StageTriage, \"lead\")\n+\te.d = e.deps(0)\n+\te.d.Network = e.store\n+\te.fstore.failAt = 3 // prepared, committed, then fail while saving \"requested\"\n+\tc := New(e.d)\n+\tif _, err := c.Run(context.Background(), j); err == nil {\n+\t\tt.Fatal(\"expected the injected store failure\")\n+\t}\n+\te.fstore.failAt = 0\n+\trec := e.storedRecord(j.ID)\n+\tif rec.Job.Network == nil || !reflect.DeepEqual(rec.Job.Network.Rerun, []string{\"architect\"}) {\n+\t\tt.Fatalf(\"persisted network state = %+v\", rec.Job.Network)\n+\t}\n+\t// The store changes: a newer re-arm names another role, so a fresh\n+\t// LeadRerun would say designer, not architect.\n+\te.seedRecord(StageTriage, \"engineer\", PhaseClosed, Plan{Outcome: OutcomeDone, Rearmed: true, Rerun: []string{\"designer\"}})\n+\tif got, _ := LeadRerun(context.Background(), e.store, 7); !reflect.DeepEqual(got, []string{\"designer\"}) {\n+\t\tt.Fatalf(\"LeadRerun after the change = %v\", got)\n+\t}\n+\tif out, err := c.ResumeJob(context.Background(), j.ID); err != nil || out != OutcomeDone {\n+\t\tt.Fatalf(\"ResumeJob = %s, %v\", out, err)\n+\t}\n+\tl := e.labels(7)\n+\tif !l[\"ard:triage:architect\"] || l[\"ard:triage:architect:done\"] || l[\"ard:triage:designer\"] || !l[\"ard:triage:lead:done\"] {\n+\t\tt.Errorf(\"replay did not use the stored plan: labels %v\", l)\n+\t}\n+}\n+\n+func TestInputsRedacted(t *testing.T) {\n+\te := newEnv(t)\n+\te.d.Network = e.store\n+\te.write(\".ard/7/triage-engineer.md\", roleFile(\"engineer\", \"done\",\n+\t\t\"inputs:\\n  - path: a.txt\\n    provider: worker\\n    url: https://example.com/x?key=\"+secretValue))\n+\tj := e.claim(StageTriage, \"engineer\")\n+\tif out, err := New(e.d).Run(context.Background(), j); err != nil || out != OutcomeDone {\n+\t\tt.Fatalf(\"Run = %s, %v\", out, err)\n+\t}\n+\trec := e.storedRecord(j.ID)\n+\tb, _ := json.Marshal(rec.Plan)\n+\tif strings.Contains(string(b), secretValue) || len(rec.Plan.Inputs) != 1 || !strings.Contains(rec.Plan.Inputs[0].URL, \"[REDACTED\") {\n+\t\tt.Errorf(\"stored inputs not redacted: %s\", b)\n+\t}\n+}\n+\n+// An input list that no longer parses after redaction ends needs-human.\n+func TestInputsLostNeedsHuman(t *testing.T) {\n+\te := newEnv(t)\n+\te.d.Network = e.store\n+\te.write(\".ard/7/triage-engineer.md\", roleFile(\"engineer\", \"done\",\n+\t\t\"inputs:\\n  - path: \"+secretValue+\"\\n    provider: human\"))\n+\tj := e.claim(StageTriage, \"engineer\")\n+\tif out, err := New(e.d).Run(context.Background(), j); err != nil || out != OutcomeNeedsHuman {\n+\t\tt.Fatalf(\"Run = %s, %v\", out, err)\n+\t}\n+\trec := e.storedRecord(j.ID)\n+\tif !strings.Contains(rec.Plan.Reason, \"inputs list unreadable\") || len(rec.Plan.Inputs) != 0 {\n+\t\tt.Errorf(\"plan = %+v\", rec.Plan)\n+\t}\n+}\n+\n+func TestInputsOfAndNetworkRoundCount(t *testing.T) {\n+\tctx := context.Background()\n+\ts := stageStore{\n+\t\tStageWorker: {netRecord(t, \"03\", PhaseCommented, OutcomeNeedsNetwork, true)},\n+\t\tStageTriage: {\n+\t\t\ttriageRec(t, \"01\", \"engineer\", OutcomeDone, Plan{Inputs: []Input{{Path: \"old.txt\", Provider: \"human\"}}}),\n+\t\t\ttriageRec(t, \"04\", \"engineer\", OutcomeDone, Plan{Inputs: []Input{{Path: \"new.txt\", Provider: \"human\"}}}),\n+\t\t\ttriageRec(t, \"05\", \"lead\", OutcomeDone, Plan{}),\n+\t\t},\n+\t}\n+\tgot, ok, err := InputsOf(ctx, s, 7)\n+\tif err != nil || !ok || len(got) != 1 || got[0].Path != \"new.txt\" {\n+\t\tt.Errorf(\"InputsOf = %v, %v, %v\", got, ok, err)\n+\t}\n+\tif _, ok, err := InputsOf(ctx, stageStore{}, 7); err != nil || ok {\n+\t\tt.Errorf(\"InputsOf none = %v, %v\", ok, err)\n+\t}\n+\tif n, err := NetworkRoundCount(ctx, s, 7); err != nil || n != 1 {\n+\t\tt.Errorf(\"NetworkRoundCount = %d, %v\", n, err)\n+\t}\n+}\ndiff --git a/internal/digest/digest.go b/internal/digest/digest.go\nindex d632749..6b201d3 100644\n--- a/internal/digest/digest.go\n+++ b/internal/digest/digest.go\n@@ -111,10 +111,18 @@ func (l *Loop) Tick(ctx context.Context, _ controller.Env) error {\n \t\treturn fmt.Errorf(\"digest: list issues: %w\", err)\n \t}\n \tqueue := map[string]int{}\n+\twaiting, err := l.waitingInputs(ctx)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tnWaiting := 0\n \tfor _, is := range issues {\n \t\tif is.IsPR {\n \t\t\tcontinue\n \t\t}\n+\t\tif waiting[is.Number] {\n+\t\t\tnWaiting++\n+\t\t}\n \t\tfor _, lb := range is.Labels {\n \t\t\tif strings.HasPrefix(lb, labels.Prefix) {\n \t\t\t\tqueue[lb]++\n@@ -129,7 +137,7 @@ func (l *Loop) Tick(ctx context.Context, _ controller.Env) error {\n \tif err != nil {\n \t\treturn fmt.Errorf(\"digest: read spend: %w\", err)\n \t}\n-\tdata := Data{Day: day, Queue: queue, Jobs: jobs, Spend: perSpend, Total: spend}\n+\tdata := Data{Day: day, Queue: queue, WaitingInputs: nWaiting, Jobs: jobs, Spend: perSpend, Total: spend}\n \tif l.d.Effects.DryRun() {\n \t\tl.d.Log.Info(\"digest.notice\", \"day\", day)\n \t\treturn nil\n@@ -147,3 +155,21 @@ func (l *Loop) Tick(ctx context.Context, _ controller.Env) error {\n \t}\n \treturn nil\n }\n+\n+// waitingInputs returns the issues whose newest gate event says the triage gate\n+// is waiting for human-provided inputs.\n+func (l *Loop) waitingInputs(ctx context.Context) (map[int]bool, error) {\n+\tes, err := l.d.Store.Events(ctx, state.EventFilter{Kind: state.EventGate})\n+\tif err != nil {\n+\t\treturn nil, fmt.Errorf(\"digest: read gate events: %w\", err)\n+\t}\n+\twaiting := map[int]bool{}\n+\tfor _, e := range es {\n+\t\tvar d struct {\n+\t\t\tReason string `json:\"reason\"`\n+\t\t}\n+\t\t_ = json.Unmarshal(e.Data, &d)\n+\t\twaiting[e.Issue] = d.Reason == \"waiting-for-inputs\"\n+\t}\n+\treturn waiting, nil\n+}\ndiff --git a/internal/digest/digest_test.go b/internal/digest/digest_test.go\nindex f9faac1..b3f10dc 100644\n--- a/internal/digest/digest_test.go\n+++ b/internal/digest/digest_test.go\n@@ -199,3 +199,30 @@ func TestIntervalAndClaims(t *testing.T) {\n }\n \n func controllerEnv() controller.Env { return controller.Env{} }\n+\n+func TestWaitingForInputsCounter(t *testing.T) {\n+\tgate := func(issue int, reason string) state.Event {\n+\t\treturn state.Event{Kind: state.EventGate, Issue: issue, At: noon.Add(-time.Hour), Data: []byte(`{\"verdict\":\"x\",\"reason\":\"` + reason + `\"}`)}\n+\t}\n+\tnow := noon\n+\tl, st, fx, rd := setup(&now)\n+\trd.issues = []github.Issue{{Number: 2}, {Number: 3}, {Number: 4}, {Number: 9, IsPR: true}}\n+\tst.events = []state.Event{\n+\t\tgate(2, \"waiting-for-inputs\"),\n+\t\tgate(3, \"waiting-for-inputs\"), gate(3, \"inputs-ready\"), // landed: not counted\n+\t\tgate(4, \"waiting-for-inputs\"),\n+\t\tgate(5, \"waiting-for-inputs\"), // closed issue: not listed\n+\t\tgate(9, \"waiting-for-inputs\"), // a PR is not an issue\n+\t}\n+\t_ = l.Tick(context.Background(), controllerEnv())\n+\tif b := fx.bodies[0]; !strings.Contains(b, \"**Waiting for inputs:** 2\") {\n+\t\tt.Errorf(\"body = %s\", b)\n+\t}\n+\t// None waiting: the line is absent.\n+\tnow2 := noon.Add(24 * time.Hour)\n+\tl2, _, fx2, _ := setup(&now2)\n+\t_ = l2.Tick(context.Background(), controllerEnv())\n+\tif strings.Contains(fx2.bodies[0], \"Waiting for inputs\") {\n+\t\tt.Errorf(\"counter shown with nothing waiting: %s\", fx2.bodies[0])\n+\t}\n+}\ndiff --git a/internal/digest/render.go b/internal/digest/render.go\nindex 130b5d9..27bc482 100644\n--- a/internal/digest/render.go\n+++ b/internal/digest/render.go\n@@ -13,9 +13,11 @@ import (\n type Data struct {\n \tDay   string\n \tQueue map[string]int\n-\tJobs  map[state.RoleKey]state.JobCounts\n-\tSpend map[state.RoleKey]state.Spend\n-\tTotal state.Spend\n+\t// WaitingInputs counts open issues held for human-provided inputs.\n+\tWaitingInputs int\n+\tJobs          map[state.RoleKey]state.JobCounts\n+\tSpend         map[state.RoleKey]state.Spend\n+\tTotal         state.Spend\n }\n \n func (d Data) counts() (jobs, failed int) {\n@@ -57,6 +59,10 @@ func Render(d Data) string {\n \t\t}\n \t}\n \n+\tif d.WaitingInputs > 0 {\n+\t\tfmt.Fprintf(&b, \"\\n**Waiting for inputs:** %d\\n\", d.WaitingInputs)\n+\t}\n+\n \tjobs, failed := d.counts()\n \tfmt.Fprintf(&b, \"\\n**Jobs run:** %d\\n\\n**Failures:** %d\\n\", jobs, failed)\n \tkeys := make([]state.RoleKey, 0, len(d.Jobs))\ndiff --git a/internal/gitx/local.go b/internal/gitx/local.go\nindex fc71474..ea34529 100644\n--- a/internal/gitx/local.go\n+++ b/internal/gitx/local.go\n@@ -607,3 +607,41 @@ func (g *Git) CheckoutTree(ctx context.Context, gitDir, workTree, sha string) er\n \t}\n \treturn nil\n }\n+\n+// TreeEntry is one ls-tree record of a path at a revision.\n+type TreeEntry struct {\n+\tMode, Type string\n+\tSize       int64 // blob size, 0 for other types\n+}\n+\n+// EntryAt reports the tree entry of path at rev in dir without reading any\n+// content. ok is false when the path does not exist there. dir must be the\n+// controller's own repository.\n+func (g *Git) EntryAt(ctx context.Context, dir, rev, path string) (TreeEntry, bool, error) {\n+\tif path == \"\" || strings.HasPrefix(path, \"/\") || slices.Contains(strings.Split(path, \"/\"), \"..\") {\n+\