{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Jm3Zc6Y4ghkyuENhYf67mD","type":"tool_result","content":"\t// the path does not exist there. Prepare uses it to compare plan.md with\n\t// its base.\n\tBaseFile func(ctx context.Context, worktree, rev, path string, maxBytes int64) (data []byte, ok bool, err error)\n\t// PR reads a pull request (github.Reader.GetPR). Optional: a review's\n\t// close-out uses it to notice a PR merged or closed mid-review. nil skips\n\t// the check.\n\tPR         func(ctx context.Context, n int) (github.PullRequest, error)\n\tRepo       github.Repo\n\tStagingDir string\n\tLog        *slog.Logger\n\tNow        func() time.Time\n\t// Network enables the network bounce (#385): a first-job needs-network\n\t// worker is sent to the triage engineer. nil leaves it off and the worker\n\t// ends needs-human. Prepare reads it for the one-round loop guard.\n\tNetwork interface {\n\t\tCloseoutsOf(ctx context.Context, issue int, stage string) ([]state.Job, error)\n\t}\n}\n\nfunc (d Deps) log() *slog.Logger {\n\tif d.Log != nil {\n\t\treturn d.Log\n\t}\n\treturn slog.Default()\n}\n\n\t\tp.Files, p.LogPath = logFiles, logPath\n\t\trec.SHA, rec.Synthetic = res.SHA, res.Synthetic\n\t\treturn nil\n\tcase errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded):\n\t\treturn err\n\t}\n\tc.d.log().Warn(\"closeout: commit log after plan conflict failed\", \"job\", rec.Job.ID, \"error\", err)\n\tp.Reason += \"; log not committed: \" + err.Error()\n\treturn nil\n}\n\nfunc commitSummary(p Plan) string {\n\tfor _, s := range []string{p.Summary, p.Reason} {\n\t\tif l := strings.TrimSpace(strings.SplitN(strings.TrimSpace(s), \"\\n\", 2)[0]); l != \"\" {\n\t\t\treturn l\n\t\t}\n\t}\n\treturn \"close-out \" + string(p.Outcome)\n}\n\n// request applies the next labels, grouped by target number.\nfunc (c *Closer) request(ctx context.Context, rec Record) error {\n\treturn c.addGrouped(ctx, rec.Plan.Requests)\n}\n\nfunc (c *Closer) addGrouped(ctx context.Context, ls []Label) error {\n\tvar order []int\n\tby := map[int][]string{}\n\tfor _, l := range ls {\n\t\tif _, ok := by[l.Number]; !ok {\n\t\t\torder = append(order, l.Number)\n\t\t}\n\t\tby[l.Number] = append(by[l.Number], l.Name)\n\t}\n\tfor _, n := range order {\n\t\tif err := c.d.Effects.AddLabels(ctx, n, by[n]...); err != nil {\n\t\t\treturn fmt.Errorf(\"add labels on #%d: %w\", n, err)\n\t\t}\n\t}\n\treturn nil\n}\n\n// comment posts the summary once; the marker makes a replay find it.\nfunc (c *Closer) comment(ctx context.Context, rec *Record) error {\n\tif rec.Plan.Review != nil {\n\t\treturn c.postReview(ctx, rec)\n\t}\n\tn := rec.Job.target()\n\tif n > 0 && c.d.Comments != nil {\n\t\tcs, err := c.d.Comments.ListComments(ctx, n, time.Time{})\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"list comments on #%d: %w\", n, err)\n\t\t}\n\t\tfor _, cm := range cs {\n\t\t\tif strings.HasPrefix(cm.Body, markerFor(rec.Job.ID)) {\n\t\t\t\trec.CommentID = cm.ID\n\t\t\t\treturn nil\n\t\t\t}\n\t\t}\n\t}\n\tcm, err := c.d.Effects.CreateComment(ctx, n, RenderComment(*rec, c.d.Repo, c.d.Effects.DryRun()))\n\t\trec.CommentID, rec.ReviewMode = rid, ReviewBody\n\t\treturn nil\n\t}\n\tif !rejected(err) {\n\t\treturn c.postFailed(rec, fmt.Errorf(\"review on #%d: %w\", n, err))\n\t}\n\tc.d.log().Warn(\"closeout.review_rejected\", \"job\", j.ID, \"pr\", n, \"error\", err)\n\tcm, err := c.d.Effects.CreateComment(ctx, n, body)\n\tif err != nil {\n\t\treturn c.postFailed(rec, fmt.Errorf(\"comment on #%d: %w\", n, err))\n\t}\n\trec.CommentID, rec.ReviewMode = cm.ID, ReviewComment\n\treturn nil\n}\n\n// postFailed passes a review-post error on, except for a stale review of a\n// gone PR: posting there is best-effort, so the error is logged and dropped.\nfunc (c *Closer) postFailed(rec *Record, err error) error {\n\tif rp := rec.Plan.Review; rp != nil && rp.PRGone != \"\" {\n\t\tc.d.log().Warn(\"closeout: review not posted on gone PR\", \"job\", rec.Job.I