ext, e *cli.Env, build builder, wantLoops []stri\n581\t \tif err != nil {\n582\t \t\treturn fmt.Errorf(\"ard serve: %w\", err)\n583\t \t}\n584\t+\tw.snap = w.newSnapshotTaker(cc, events)\n585\t \tw.ctl.Store(cc)\n586\t \tstartSHA := \"\"\n587\t \tif cfg != nil {\n588\t@@ -425,6 +430,8 @@ type wiring struct {\n589\t \trp               *reaper.Reaper\n590\t \tlim              *limits.Book\n591\t \tbgt              *budget.Gate\n592\t+\t// snap takes snapshots for the command center (#413); nothing renders it yet.\n593\t+\tsnap *snapshot.Taker\n594\t \t// budgetNow is the budget gate's clock; nil means time.Now (tests set it).\n595\t \tbudgetNow func() time.Time\n596\t \n597\tdiff --git a/internal/servecmd/snapshot.go b/internal/servecmd/snapshot.go\n598\tnew file mode 100644\n599\tindex 0000000..81b74fb\n600\t--- /dev/null\n601\t+++ b/internal/servecmd/snapshot.go\n602\t@@ -0,0 +1,38 @@\n603\t+package servecmd\n604\t+\n605\t+import (\n606\t+\t\"github.com/albertcbrown/ard/internal/config\"\n607\t+\t\"github.com/albertcbrown/ard/internal/controller\"\n608\t+\t\"github.com/albertcbrown/ard/internal/snapshot\"\n609\t+)\n610\t+\n611\t+// snapshotEvents is how many recent log records the command center keeps.\n612\t+const snapshotEvents = 200\n613\t+\n614\t+// newSnapshotTaker builds the command center's Snapshot source. The pool and\n615\t+// the limits book exist only after the startup hooks, so they are looked up\n616\t+// at Take time; a Take before that sees them as absent. It makes no GitHub\n617\t+// call: the kill-switch state comes from the controller's last tick.\n618\t+func (w *wiring) newSnapshotTaker(c *controller.Controller, events *snapshot.Ring) *snapshot.Taker {\n619\t+\treturn snapshot.New(snapshot.Sources{\n620\t+\t\tPool: func() snapshot.PoolSource {\n621\t+\t\t\tif p := w.pool.Load(); p != nil {\n622\t+\t\t\t\treturn p\n623\t+\t\t\t}\n624\t+\t\t\treturn nil\n625\t+\t\t},\n626\t+\t\tLimits: func() snapshot.LimitSource {\n627\t+\t\t\tw.initMu.Lock()\n628\t+\t\t\tdefer w.initMu.Unlock()\n629\t+\t\t\tif w.lim != nil {\n630\t+\t\t\t\treturn w.lim\n631\t+\t\t\t}\n632\t+\t\t\treturn nil\n633\t+\t\t},\n634\t+\t\tState:   w.Store,\n635\t+\t\tControl: c,\n636\t+\t\tCaps:    w.budgetGate(),\n637\t+\t\tConfig:  func() *config.Resolved { return w.cfg.Load() },\n638\t+\t\tRing:    events,\n639\t+\t})\n640\t+}\n641\tdiff --git a/internal/snapshot/events.go b/internal/snapshot/events.go\n642\tnew file mode 100644\n643\tindex 0000000..883cdf6\n644\t--- /dev/null\n645\t+++ b/internal/snapshot/events.go\n646\t@@ -0,0 +1,133 @@\n647\t+package snapshot\n648\t+\n649\t+import (\n650\t+\t\"context\"\n651\t+\t\"log/slog\"\n652\t+\t\"strings\"\n653\t+\t\"sync\"\n654\t+\t\"time\"\n655\t+)\n656\t+\n657\t+// Event is one recent log record.\n658\t+type Event struct {\n659\t+\tTime  time.Time\n660\t+\tLevel slog.Level\n661\t+\tMsg   string\n662\t+\tAttrs string // flattened \"k=v k=v\", groups as \"g.k=v\"\n663\t+}\n664\t+\n665\t+// Ring is a fixed-size, concurrency-safe buffer of the newest events.\n666\t+type Ring struct {\n667\t+\tmu   sync.Mutex\n668\t+\tbuf  []Event\n669\t+\tnext int\n670\t+\tfull bool\n671\t+}\n672\t+\n673\t+// NewRing returns a ring holding the newest n events (n < 1 is treated as 1).\n674\t+func NewRing(n int) *Ring { return &Ring{buf: make([]Event, max(1, n))} }\n675\t+\n676\t+// Append adds e, dropping the oldest event when the ring is full.\n677\t+func (r *Ring) Append(e Event) {\n678\t+\tr.mu.Lock()\n679\t+\tdefer r.mu.Unlock()\n680\t+\tr.buf[r.next] = e\n681\t+\tr.next = (r.next + 1) % len(r.buf)\n682\t+\tif r.next == 0 {\n683\t+\t\tr.full = true\n684\t+\t}\n685\t+}\n686\t+\n687\t+// Events returns a copy of the buffered events, oldest first.\n688\t+func (r *Ring) Events() []Event {\n689\t+\tr.mu.Lock()\n690\t+\tdefer r.mu.Unlock()\n691\t+\tif !r.full {\n692\t+\t\treturn append([]Event(nil), r.buf[:r.next]...)\n693\t+\t}\n694\t+\tout := make([]Event, 0, len(r.buf))\n695\t+\tout = append(out, r.buf[r.next:]...)\n696\t+\treturn append(out, r.buf[:r.next]...)\n697\t+}\n698\t+\n699\t+type tee struct {\n700\t+\tnext   slog.Handler\n701\t+\tring   *Ring\n702\t+\tredact func(string) string\n703\t+\tattrs  string // pre-flattened WithAttrs, already prefixed by groups\n704\t+\tgroups []string\n705\t+}\n706\t+\n707\t+// NewTee returns a handler that passes every record to next unchanged and\n708\t+// also records it in ring. redact, when non-nil, is applied to the recorded\n709\t+// text only; next's output is never altered.\n710\t+func NewTee(next slog.Handler, ring *Ring, redact func(string) string) slog.Handler {\n711\t+\treturn &tee{next: next, ring: ring, redact: redact}\n712\t+}\n713\t+\n714\t+func (t *tee) Enabled(ctx context.Context, l slog.Level) bool { return t.next.Enabled(ctx, l) }\n715\t+\n716\t+func (t *tee) Handle(ctx context.Context, r slog.Record) error {\n717\t+\tvar b strings.Builder\n718\t+\tb.WriteString(t.attrs)\n719\t+\tprefix := strings.Join(t.groups, \".\")\n720\t+\tr.Attrs(func(a slog.Attr) bool {\n721\t+\t\tflatten(&b, prefix, a)\n722\t+\t\treturn true\n723\t+\t})\n724\t+\tmsg, attrs := r.Message, strings.TrimSpace(b.String())\n725\t+\tif t.redact != nil {\n726\t+\t\tmsg, attrs = t.redact(msg), t.redact(attrs)\n727\t+\t}\n728\t+\tt.ring.Append(Event{Time: r.Time, Level: r.Level, Msg: msg, Attrs: attrs})\n729\t+\treturn t.next.Handle(ctx, r)\n730\t+}\n731\t+\n732\t+func (t *tee) WithAttrs(as []slog.Attr) slog.Handler {\n733\t+\tvar b strings.Builder\n734\t+\tb.WriteString(t.attrs)\n735\t+\tprefix := strings.Join(t.groups, \".\")\n736\t+\tfor _, a := range as {\n737\t+\t\tflatten(&b, prefix, a)\n738\t+\t}\n739\t+\tc := *t\n740\t+\tc.next = t.next.WithAttrs(as)\n741\t+\tc.attrs = b.String()\n742\t+\treturn &c\n743\t+}\n744\t+\n745\t+func (t *tee) WithGroup(name string) slog.Handler {\n746\t+\tc := *t\n747\t+\tc.next = t.next.WithGroup(name)\n748\t+\tif name != \"\" {\n749\t+\t\tc.groups = append(append([]string(nil), t.groups...), name)\n750\t+\t}\n751\t+\treturn &c\n752\t+}\n753\t+\n754\t+func flatten(b *strings.Builder, prefix string, a slog.Attr) {\n755\t+\ta.Value = a.Value.Resolve()\n756\t+\tif a.Equal(slog.Attr{}) {\n757\t+\t\treturn\n758\t+\t}\n759\t+\tkey := a.Key\n760\t+\tif a.Value.Kind() == slog.KindGroup {\n761\t+\t\tif key != \"\" {\n762\t+\t\t\tif prefix != \"\" {\n763\t+\t\t\t\tprefix += \".\"\n764\t+\t\t\t}\n765\t+\t\t\tprefix += key\n766\t+\t\t}\n767\t+\t\tfor _, g := range a.Value.Group() {\n768\t+\t\t\tflatten(b, prefix, g)\n769\t+\t\t}\n770\t+\t\treturn\n771\t+\t}\n772\t+\tif prefix != \"\" {\n773\t+\t\tkey = prefix + \".\" + key\n774\t+\t}\n775\t+\tb.WriteString(key)\n776\t+\tb.WriteByte('=')\n777\t+\tb.WriteString(a.Value.String())\n778\t+\tb.WriteByte(' ')\n779\t+}\n780\tdiff --git a/internal/snapshot/events_test.go b/internal/snapshot/events_test.go\n781\tnew file mode 100644\n782\tindex 0000000..132afdc\n783\t--- /dev/null\n784\t+++ b/internal/snapshot/events_test.go\n785\t@@ -0,0 +1,93 @@\n786\t+package snapshot\n787\t+\n788\t+import (\n789\t+\t\"bytes\"\n790\t+\t\"fmt\"\n791\t+\t\"log/slog\"\n792\t+\t\"strings\"\n793\t+\t\"sync\"\n794\t+\t\"testing\"\n795\t+)\n796\t+\n797\t+func TestRingKeepsNewestInOrder(t *testing.T) {\n798\t+\tr := NewRing(3)\n799\t+\tif len(r.Events()) != 0 {\n800\t+\t\tt.Fatal(\"new ring not empty\")\n801\t+\t}\n802\t+\tfor i := 1; i <= 5; i++ {\n803\t+\t\tr.Append(Event{Msg: fmt.Sprint(i)})\n804\t+\t\tif i == 2 {\n805\t+\t\t\tif got := r.Events(); len(got) != 2 || got[0].Msg != \"1\" || got[1].Msg != \"2\" {\n806\t+\t\t\t\tt.Fatalf(\"partial = %+v\", got)\n807\t+\t\t\t}\n808\t+\t\t}\n809\t+\t}\n810\t+\tgot := r.Events()\n811\t+\tif len(got) != 3 || got[0].Msg != \"3\" || got[1].Msg != \"4\" || got[2].Msg != \"5\" {\n812\t+\t\tt.Fatalf(\"events = %+v\", got)\n813\t+\t}\n814\t+\tgot[0].Msg = \"x\" // a copy\n815\t+\tif r.Events()[0].Msg != \"3\" {\n816\t+\t\tt.Error(\"Events returned the internal buffer\")\n817\t+\t}\n818\t+}\n819\t+\n820\t+func TestRingConcurrentAppend(t *testing.T) {\n821\t+\tr := NewRing(8)\n822\t+\tvar wg sync.WaitGroup\n823\t+\tfor g := 0; g < 8; g++ {\n824\t+\t\twg.Add(1)\n825\t+\t\tgo func() {\n826\t+\t\t\tdefer wg.Done()\n827\t+\t\t\tfor i := 0; i < 200; i++ {\n828\t+\t\t\t\tr.Append(Event{Msg: \"m\"})\n829\t+\t\t\t\t_ = r.Events()\n830\t+\t\t\t}\n831\t+\t\t}()\n832\t+\t}\n833\t+\twg.Wait()\n834\t+\tif n := len(r.Events()); n != 8 {\n835\t+\t\tt.Errorf(\"len = %d, want 8\", n)\n836\t+\t}\n837\t+}\n838\t+\n839\t+func TestTeeForwardsByteIdentically(t *testing.T) {\n840\t+\tdrive := func(h slog.Handler) {\n841\t+\t\tl := slog.New(h).With(\"loop\", \"worker\").WithGroup(\"g\").With(\"a\", 1)\n842\t+\t\tl.Info(\"hello\", \"k\", \"v\", slog.Group(\"inner\", \"x\", 2))\n843\t+\t\tl.Warn(\"second\", \"err\", fmt.Errorf(\"boom\"))\n844\t+\t}\n845\t+\tvar plain, teed bytes.Buffer\n846\t+\topts := &slog.HandlerOptions{ReplaceAttr: func(_ []string, a slog.Attr) slog.Attr {\n847\t+\t\tif a.Key == slog.TimeKey {\n848\t+\t\t\treturn slog.Attr{}\n849\t+\t\t}\n850\t+\t\treturn a\n851\t+\t}}\n852\t+\tdrive(slog.NewTextHandler(&plain, opts))\n853\t+\tring := NewRing(10)\n854\t+\tdrive(NewTee(slog.NewTextHandler(&teed, opts), ring, nil))\n855\t+\tif plain.String() != teed.String() {\n856\t+\t\tt.Fatalf(\"output differs:\\n%s\\n---\\n%s\", plain.String(), teed.String())\n857\t+\t}\n858\t+\tev := ring.Events()\n859\t+\tif len(ev) != 2 || ev[0].Msg != \"hello\" || ev[0].Level != slog.LevelInfo {\n860\t+\t\tt.Fatalf(\"events = %+v\", ev)\n861\t+\t}\n862\t+\tif want := \"loop=worker g.a=1 g.k=v g.inner.x=2\"; ev[0].Attrs != want {\n863\t+\t\tt.Errorf(\"attrs = %q, want %q\", ev[0].Attrs, want)\n864\t+\t}\n865\t+}\n866\t+\n867\t+func TestTeeRedactsRecordedTextOnly(t *testing.T) {\n868\t+\tvar out bytes.Buffer\n869\t+\tring := NewRing(2)\n870\t+\tl := slog.New(NewTee(slog.NewTextHandler(&out, nil), ring, func(s string) string { return strings.ReplaceAll(s, \"secret\", \"[redacted]\") }))\n871\t+\tl.Info(\"secret\", \"k\", \"secret\")\n872\t+\tif e := ring.Events()[0]; e.Msg != \"[redacted]\" || e.Attrs != \"k=[redacted]\" {\n873\t+\t\tt.Errorf(\"event = %+v\", e)\n874\t+\t}\n875\t+\tif !bytes.Contains(out.Bytes(), []byte(\"msg=secret\")) {\n876\t+\t\tt.Errorf(\"downstream output was altered: %s\", out.String())\n877\t+\t}\n878\t+}\n879\tdiff --git a/internal/snapshot/snapshot.go b/internal/snapshot/snapshot.go\n880\tnew file mode 100644\n881\tindex 0000000..c1e199b\n882\t--- /dev/null\n883\t+++ b/internal/snapshot/snapshot.go\n884\t@@ -0,0 +1,471 @@\n885\t+// Package snapshot builds the in-process Snapshot behind the `ard serve`\n886\t+// command center (and a later `ard top`): pool, running jobs, kill switches,\n887\t+// usage limits, today's issues and spend, and recent log events.\n888\t+//\n889\t+// Taking a snapshot is cheap and local. It reads memory (pool, limits book,\n890\t+// controller) and the SQLite state only; it makes no GitHub call and the\n891\t+// package must not import internal/github (an import test enforces it).\n892\t+package snapshot\n893\t+\n894\t+import (\n895\t+\t\"context\"\n896\t+\t\"fmt\"\n897\t+\t\"math\"\n898\t+\t\"sort\"\n899\t+\t\"sync\"\n900\t+\t\"time\"\n901\t+\n902\t+\t\"github.com/albertcbrown/ard/internal/budget\"\n903\t+\t\"github.com/albertcbrown/ard/internal/config\"\n904\t+\t\"github.com/albertcbrown/ard/internal/controller\"\n905\t+\t\"github.com/albertcbrown/ard/internal/limits\"\n906\t+\t\"github.com/albertcbrown/ard/internal/pool\"\n907\t+\t\"github.com/albertcbrown/ard/internal/state\"\n908\t+)\n909\t+\n910\t+// Waiting reasons.\n911\t+const (\n912\t+\tReasonSlot    = \"slot\"    // ready, waiting for a free slot\n913\t+\tReasonLimited = \"limited\" // account or model family is out of quota\n914\t+\tReasonBudget  = \"budget\"  // a daily cap is reached\n915\t+)\n916\t+\n917\t+// Snapshot is a point-in-time view. Errors holds one line per source that\n918\t+// failed; the other fields are still filled.\n919\t+type Snapshot struct {\n920\t+\tTakenAt time.Time\n921\t+\tDayFrom time.Time // 00:00 UTC of TakenAt's day\n922\t+\tPool    PoolView\n923\t+\tRunning []RunningJob\n924\t+\tPause   []PauseView\n925\t+\tTicks   []TickView\n926\t+\tLimits  LimitsView\n927\t+\tIssues  []IssueView\n928\t+\tSpend   SpendView\n929\t+\tEvents  []Event\n930\t+\tErrors  []string\n931\t+}\n932\t+\n933\t+// PoolView is the slot pool.\n934\t+type PoolView struct {\n935\t+\tUsed, Max int\n936\t+\tWaiting   []Waiting\n937\t+}\n938\t+\n939\t+// Waiting is demand or refused candidates of one role with the reason.\n940\t+type Waiting struct {\n941\t+\tClass  string\n942\t+\tRole   string\n943\t+\tReason string // ReasonSlot, ReasonLimited or ReasonBudget\n944\t+\tCount  int\n945\t+\tOldest time.Duration // slot waits only\n946\t+}\n947\t+\n948\t+// RunningJob is one job holding a slot.\n949\t+type RunningJob struct {\n950\t+\tJobID   string\n951\t+\tIssue   int // 0 for a scanner run\n952\t+\tPR      int\n953\t+\tStage   string\n954\t+\tRole    string\n955\t+\tModel   string        // from the role config; \"\" is the agent's default\n956\t+\tElapsed time.Duration // since the job was created\n957\t+\tTimeout time.Duration // from the role config; 0 when unknown\n958\t+\t// FinishedCostUSD is the cost of finished steps only; nil when no finished\n959\t+\t// step reported a cost. The running step contributes nothing.\n960\t+\tFinishedCostUSD *float64\n961\t+}\n962\t+\n963\t+// PauseView is one active kill switch for one claiming loop.\n964\t+type PauseView struct {\n965\t+\tLoop   string\n966\t+\tReason controller.Reason\n967\t+\tErr    string\n968\t+}\n969\t+\n970\t+// TickView is the last tick of a loop.\n971\t+type TickView struct {\n972\t+\tLoop       string\n973\t+\tCount      int\n974\t+\tStart, End time.Time\n975\t+\tErr        string\n976\t+}\n977\t+\n978\t+// LimitsView holds the usage-limit readings and active blocks.\n979\t+type LimitsView struct {\n980\t+\tWindows []WindowView\n981\t+\tBlocks  []BlockView\n982\t+}\n983\t+\n984\t+// WindowView is the latest reading of one subscription window.\n985\t+type WindowView struct {\n986\t+\tWindow      string\n987\t+\tUtilization float64 // normalised to 0..1\n988\t+\tStatus      string\n989\t+\tResetsAt    time.Time\n990\t+\tAge         time.Duration // now minus when it was observed\n991\t+}\n992\t+\n993\t+// BlockView is an active exhaustion block for a model family (\"\" = unknown).\n994\t+type BlockView struct {\n995\t+\tFamily string\n996\t+\tUntil  time.Time\n997\t+}\n998\t+\n999\t+// IssueView is an issue with ard activity today.\n1000\t+type IssueView struct {\n1001\t+\tIssue   int\n1002\t+\tState   string // \"<stage>:<role> running\" or \"<stage>:<role> done|failed\" of the latest job\n1003\t+\tJobs    int\n1004\t+\tCostUSD *float64 // total of all recorded steps; nil when none priced\n1005\t+}\n1006\t+\n1007\t+// SpendView is today's spend against the daily caps.\n1008\t+type SpendView struct {\n1009\t+\tRepoUSD   float64\n1010\t+\tRepoCap   float64 // 0 when no config\n1011\t+\tUnpriced  int\n1012\t+\tRoles     []RoleSpend\n1013\t+\tCappedNow []budget.Cap\n1014\t+}\n1015\t+\n1016\t+// RoleSpend is one role's spend today.\n1017\t+type RoleSpend struct {\n1018\t+\tStage, Role string\n1019\t+\tUSD         float64\n1020\t+}\n1021\t+\n1022\t+// PoolSource is the slot pool; *pool.Pool satisfies it.\n1023\t+type PoolSource interface {\n1024\t+\tStats() pool.Stats\n1025\t+\tHeldSlots() []pool.HeldInfo\n1026\t+}\n1027\t+\n1028\t+// LimitSource is the limits book; *limits.Book satisfies it.\n1029\t+type LimitSource interface {\n1030\t+\tReadings() []limits.Reading\n1031\t+\tUntil(family string) time.Time\n1032\t+}\n1033\t+\n1034\t+// StateSource is the state store; *state.Store satisfies it.\n1035\t+type StateSource interface {\n1036\t+\tRunningJobs(ctx context.Context) ([]state.Job, error)\n1037\t+\tEndedSince(ctx context.Context, since time.Time) ([]state.Job, error)\n1038\t+\tJobUsage(ctx context.Context, jobID string) (state.JobUsage, error)\n1039\t+\tIssueUsage(ctx context.Context, issue int) (map[string]state.JobUsage, error)\n1040\t+\tSpendSince(ctx context.Context, dayStart time.Time) (map[state.RoleKey]state.Spend, state.Spend, error)\n1041\t+}\n1042\t+\n1043\t+// ControlSource is the controller; *controller.Controller satisfies it.\n1044\t+type ControlSource interface {\n1045\t+\tPauseStates() map[string]controller.PauseState\n1046\t+\tTicks() []controller.TickInfo\n1047\t+}\n1048\t+\n1049\t+// CapSource lists the caps reached today; *budget.Gate satisfies it.\n1050\t+type CapSource interface {\n1051\t+\tCapped(ctx context.Context) ([]budget.Cap, time.Time, error)\n1052\t+}\n1053\t+\n1054\t+// Sources are what a Taker reads. Pool, Limits, Control and Caps may be nil\n1055\t+// (or return nil), for example before startup hooks have run; Config may\n1056\t+// return nil.\n1057\t+type Sources struct {\n1058\t+\tPool    func() PoolSource\n1059\t+\tLimits  func() LimitSource\n1060\t+\tState   StateSource\n1061\t+\tControl ControlSource\n1062\t+\tCaps    CapSource\n1063\t+\tConfig  func() *config.Resolved\n1064\t+\tRing    *Ring\n1065\t+\tNow     func() time.Time\n1066\t+}\n1067\t+\n1068\t+// Taker takes snapshots. It is safe for concurrent use.\n1069\t+type Taker struct {\n1070\t+\ts Sources\n1071\t+\n1072\t+\tmu    sync.Mutex\n1073\t+\tcache map[int]cachedUsage\n1074\t+}\n1075\t+\n1076\t+type cachedUsage struct {\n1077\t+\tkey   string\n1078\t+\ttotal *float64\n1079\t+}\n1080\t+\n1081\t+// New returns a Taker over s.\n1082\t+func New(s Sources) *Taker {\n1083\t+\tif s.Now == nil {\n1084\t+\t\ts.Now = time.Now\n1085\t+\t}\n1086\t+\treturn &Taker{s: s, cache: map[int]cachedUsage{}}\n1087\t+}\n1088\t+\n1089\t+// Invalidate drops the cached cost of issue (close-out may call it). The\n1090\t+// cache also invalidates itself when the issue's jobs change.\n1091\t+func (t *Taker) Invalidate(issue int) {\n1092\t+\tt.mu.Lock()\n1093\t+\tdelete(t.cache, issue)\n1094\t+\tt.mu.Unlock()\n1095\t+}\n1096\t+\n1097\t+// Take builds a snapshot. It makes no GitHub call.\n1098\t+func (t *Taker) Take(ctx context.Context) Snapshot {\n1099\t+\tnow := t.s.Now().UTC()\n1100\t+\tsnap := Snapshot{TakenAt: now, DayFrom: time.Date(now.Year(), now.Month(), now.Day(), 0, 0, 0, 0, time.UTC)}\n1101\t+\tcfg := (*config.Resolved)(nil)\n1102\t+\tif t.s.Config != nil {\n1103\t+\t\tcfg = t.s.Config()\n1104\t+\t}\n1105\t+\tfail := func(what string, err error) { snap.Errors = append(snap.Errors, fmt.Sprintf(\"%s: %v\", what, err)) }\n1106\t+\n1107\t+\tvar held []pool.HeldInfo\n1108\t+\tif t.s.Pool != nil {\n1109\t+\t\tif p := t.s.Pool(); p != nil {\n1110\t+\t\t\tsnap.Pool, held = poolView(p.Stats()), p.HeldSlots()\n1111\t+\t\t\tsnap.Pool.Used = len(held)\n1112\t+\t\t}\n1113\t+\t}\n1114\t+\tif t.s.Control != nil {\n1115\t+\t\tsnap.Pause = pauseViews(t.s.Control.PauseStates())\n1116\t+\t\tfor _, k := range t.s.Control.Ticks() {\n1117\t+\t\t\tsnap.Ticks = append(snap.Ticks, TickView{Loop: k.Loop, Count: k.Count, Start: k.Start, End: k.End, Err: k.Err})\n1118\t+\t\t}\n1119\t+\t}\n1120\t+\tif t.s.Limits != nil {\n1121\t+\t\tif l := t.s.Limits(); l != nil {\n1122\t+\t\t\tsnap.Limits = limitsView(l, now)\n1123\t+\t\t}\n1124\t+\t}\n1125\t+\tif t.s.Ring != nil {\n1126\t+\t\tsnap.Events = t.s.Ring.Events()\n1127\t+\t}\n1128\t+\tif t.s.State == nil {\n1129\t+\t\treturn snap\n1130\t+\t}\n1131\t+\n1132\t+\trunning, err := t.s.State.RunningJobs(ctx)\n1133\t+\tif err != nil {\n1134\t+\t\tfail(\"running jobs\", err)\n1135\t+\t}\n1136\t+\tsnap.Running = t.runningViews(ctx, running, held, cfg, now, fail)\n1137\t+\n1138\t+\tended, err := t.s.State.EndedSince(ctx, snap.DayFrom)\n1139\t+\tif err != nil {\n1140\t+\t\tfail(\"ended jobs\", err)\n1141\t+\t}\n1142\t+\tsnap.Issues = t.issueViews(ctx, running, ended, fail)\n1143\t+\n1144\t+\tper, repo, err := t.s.State.SpendSince(ctx, snap.DayFrom)\n1145\t+\tif err != nil {\n1146\t+\t\tfail(\"spend\", err)\n1147\t+\t} else {\n1148\t+\t\tsnap.Spend = spendView(per, repo, cfg)\n1149