+\n+// Event is one recent log record.\n+type Event struct {\n+\tTime  time.Time\n+\tLevel slog.Level\n+\tMsg   string\n+\tAttrs string // flattened \"k=v k=v\", groups as \"g.k=v\"\n+}\n+\n+// Ring is a fixed-size, concurrency-safe buffer of the newest events.\n+type Ring struct {\n+\tmu   sync.Mutex\n+\tbuf  []Event\n+\tnext int\n+\tfull bool\n+}\n+\n+// NewRing returns a ring holding the newest n events (n < 1 is treated as 1).\n+func NewRing(n int) *Ring { return &Ring{buf: make([]Event, max(1, n))} }\n+\n+// Append adds e, dropping the oldest event when the ring is full.\n+func (r *Ring) Append(e Event) {\n+\tr.mu.Lock()\n+\tdefer r.mu.Unlock()\n+\tr.buf[r.next] = e\n+\tr.next = (r.next + 1) % len(r.buf)\n+\tif r.next == 0 {\n+\t\tr.full = true\n+\t}\n+}\n+\n+// Events returns a copy of the buffered events, oldest first.\n+func (r *Ring) Events() []Event {\n+\tr.mu.Lock()\n+\tdefer r.mu.Unlock()\n+\tif !r.full {\n+\t\treturn append([]Event(nil), r.buf[:r.next]...)\n+\t}\n+\tout := make([]Event, 0, len(r.buf))\n+\tout = append(out, r.buf[r.next:]...)\n+\treturn append(out, r.buf[:r.next]...)\n+}\n+\n+type tee struct {\n+\tnext   slog.Handler\n+\tring   *Ring\n+\tredact func(string) string\n+\tattrs  string // pre-flattened WithAttrs, already prefixed by groups\n+\tgroups []string\n+}\n+\n+// NewTee returns a handler that passes every record to next unchanged and\n+// also records it in ring. redact, when non-nil, is applied to the recorded\n+// text only; next's output is never altered.\n+func NewTee(next slog.Handler, ring *Ring, redact func(string) string) slog.Handler {\n+\treturn &tee{next: next, ring: ring, redact: redact}\n+}\n+\n+func (t *tee) Enabled(ctx context.Context, l slog.Level) bool { return t.next.Enabled(ctx, l) }\n+\n+func (t *tee) Handle(ctx context.Context, r slog.Record) error {\n+\tvar b strings.Builder\n+\tb.WriteString(t.attrs)\n+\tprefix := strings.Join(t.groups, \".\")\n+\tr.Attrs(func(a slog.Attr) bool {\n+\t\tflatten(&b, prefix, a)\n+\t\treturn true\n+\t})\n+\tmsg, attrs := r.Message, strings.TrimSpace(b.String())\n+\tif t.redact != nil {\n+\t\tmsg, attrs = t.redact(msg), t.redact(attrs)\n+\t}\n+\tt.ring.Append(Event{Time: r.Time, Level: r.Level, Msg: msg, Attrs: attrs})\n+\treturn t.next.Handle(ctx, r)\n+}\n+\n+func (t *tee) WithAttrs(as []slog.Attr) slog.Handler {\n+\tvar b strings.Builder\n+\tb.WriteString(t.attrs)\n+\tprefix := strings.Join(t.groups, \".\")\n+\tfor _, a := range as {\n+\t\tflatten(&b, prefix, a)\n+\t}\n+\tc := *t\n+\tc.next = t.next.WithAttrs(as)\n+\tc.attrs = b.String()\n+\treturn &c\n+}\n+\n+func (t *tee) WithGroup(name string) slog.Handler {\n+\tc := *t\n+\tc.next = t.next.WithGroup(name)\n+\tif name != \"\" {\n+\t\tc.groups = append(append([]string(nil), t.groups...), name)\n+\t}\n+\treturn &c\n+}\n+\n+func flatten(b *strings.Builder, prefix string, a slog.Attr) {\n+\ta.Value = a.Value.Resolve()\n+\tif a.Equal(slog.Attr{}) {\n+\t\treturn\n+\t}\n+\tkey := a.Key\n+\tif a.Value.Kind() == slog.KindGroup {\n+\t\tif key != \"\" {\n+\t\t\tif prefix != \"\" {\n+\t\t\t\tprefix += \".\"\n+\t\t\t}\n+\t\t\tprefix += key\n+\t\t}\n+\t\tfor _, g := range a.Value.Group() {\n+\t\t\tflatten(b, prefix, g)\n+\t\t}\n+\t\treturn\n+\t}\n+\tif prefix != \"\" {\n+\t\tkey = prefix + \".\" + key\n+\t}\n+\tb.WriteString(key)\n+\tb.WriteByte('=')\n+\tb.WriteString(a.Value.String())\n+\tb.WriteByte(' ')\n+}\ndiff --git a/internal/snapshot/events_test.go b/internal/snapshot/events_test.go\nnew file mode 100644\nindex 0000000..132afdc\n--- /dev/null\n@@ -0,0 +1,93 @@\n+package snapshot\n+\n+import (\n+\t\"bytes\"\n+\t\"fmt\"\n+\t\"log/slog\"\n+\t\"strings\"\n+\t\"sync\"\n+\t\"testing\"\n+)\n+\n+func TestRingKeepsNewestInOrder(t *testing.T) {\n+\tr := NewRing(3)\n+\tif len(r.Events()) != 0 {\n+\t\tt.Fatal(\"new ring not empty\")\n+\t}\n+\tfor i := 1; i <= 5; i++ {\n+\t\tr.Append(Event{Msg: fmt.Sprint(i)})\n+\t\tif i == 2 {\n+\t\t\tif got := r.Events(); len(got) != 2 || got[0].Msg != \"1\" || got[1].Msg != \"2\" {\n+\t\t\t\tt.Fatalf(\"partial = %+v\", got)\n+\t\t\t}\n+\t\t}\n+\t}\n+\tgot := r.Events()\n+\tif len(got) != 3 || got[0].Msg != \"3\" || got[1].Msg != \"4\" || got[2].Msg != \"5\" {\n+\t\tt.Fatalf(\"events = %+v\", got)\n+\t}\n+\tgot[0].Msg = \"x\" // a copy\n+\tif r.Events()[0].Msg != \"3\" {\n+\t\tt.Error(\"Events returned the internal buffer\")\n+\t}\n+}\n+\n+func TestRingConcurrentAppend(t *testing.T) {\n+\tr := NewRing(8)\n+\tvar wg sync.WaitGroup\n+\tfor g := 0; g < 8; g++ {\n+\t\twg.Add(1)\n+\t\tgo func() {\n+\t\t\tdefer wg.Done()\n+\t\t\tfor i := 0; i < 200; i++ {\n+\t\t\t\tr.Append(Event{Msg: \"m\"})\n+\t\t\t\t_ = r.Events()\n+\t\t\t}\n+\t\t}()\n+\t}\n+\twg.Wait()\n+\tif n := len(r.Events()); n != 8 {\n+\t\tt.Errorf(\"len = %d, want 8\", n)\n+\t}\n+}\n+\n+func TestTeeForwardsByteIdentically(t *testing.T) {\n+\tdrive := func(h slog.Handler) {\n+\t\tl := slog.New(h).With(\"loop\", \"worker\").WithGroup(\"g\").With(\"a\", 1)\n+\t\tl.Info(\"hello\", \"k\", \"v\", slog.Group(\"inner\", \"x\", 2))\n+\t\tl.Warn(\"second\", \"err\", fmt.Errorf(\"boom\"))\n+\t}\n+\tvar plain, teed bytes.Buffer\n+\topts := &slog.HandlerOptions{ReplaceAttr: func(_ []string, a slog.Attr) slog.Attr {\n+\t\tif a.Key == slog.TimeKey {\n+\t\t\treturn slog.Attr{}\n+\t\t}\n+\t\treturn a\n+\t}}\n+\tdrive(slog.NewTextHandler(&plain, opts))\n+\tring := NewRing(10)\n+\tdrive(NewTee(slog.NewTextHandler(&teed, opts), ring, nil))\n+\tif plain.String() != teed.String() {\n+\t\tt.Fatalf(\"output differs:\\n%s\\n---\\n%s\", plain.String(), teed.String())\n+\t}\n+\tev := ring.Events()\n+\tif len(ev) != 2 || ev[0].Msg != \"hello\" || ev[0].Level != slog.LevelInfo {\n+\t\tt.Fatalf(\"events = %+v\", ev)\n+\t}\n+\tif want := \"loop=worker g.a=1 g.k=v g.inner.x=2\"; ev[0].Attrs != want {\n+\t\tt.Errorf(\"attrs = %q, want %q\", ev[0].Attrs, want)\n+\t}\n+}\n+\n+func TestTeeRedactsRecordedTextOnly(t *testing.T) {\n+\tvar out bytes.Buffer\n+\tring := NewRing(2)\n+\tl := slog.New(NewTee(slog.NewTextHandler(&out, nil), ring, func(s string) string { return strings.ReplaceAll(s, \"secret\", \"[redacted]\") }))\n+\tl.Info(\"secret\", \"k\", \"secret\")\n+\tif e := ring.Events()[0]; e.Msg != \"[redacted]\" || e.Attrs != \"k=[redacted]\" {\n+\t\tt.Errorf(\"event = %+v\", e)\n+\t}\n+\tif !bytes.Contains(out.Bytes(), []byte(\"msg=secret\")) {\n+\t\tt.Errorf(\"downstream output was altered: %s\", out.String())\n+\t}\n+}\ndiff --git a/internal/snapshot/snapshot.go b/internal/snapshot/snapshot.go\nnew file mode 100644\nindex 0000000..c1e199b\n--- /dev/null\n+++ b/internal/snapshot/snapshot.go\n@@ -0,0 +1,471 @@\n+// Package snapshot builds the in-process Snapshot behind the `ard serve`\n+// command center (and a later `ard top`): pool, running jobs, kill switches,\n+// usage limits, today's issues and spend, and recent log events.\n+//\n+// Taking a snapshot is cheap and local. It reads memory (pool, limits book,\n+// controller) and the SQLite state only; it makes no GitHub call and the\n+// package must not import internal/github (an import test enforces it).\n+package snapshot\n+\n+import (\n+\t\"context\"\n+\t\"fmt\"\n+\t\"math\"\n+\t\"sort\"\n+\t\"sync\"\n+\t\"time\"\n+\n+\t\"github.com/albertcbrown/ard/internal/budget\"\n+\t\"github.com/albertcbrown/ard/internal/config\"\n+\t\"github.com/albertcbrown/ard/internal/controller\"\n+\t\"github.com/albertcbrown/ard/internal/limits\"\n+\t\"github.com/albertcbrown/ard/internal/pool\"\n+\t\"github.com/albertcbrown/ard/internal/state\"\n+)\n+\n+// Waiting reasons.\n+const (\n+\tReasonSlot    = \"slot\"    // ready, waiting for a free slot\n+\tReasonLimited = \"limited\" // account or model family is out of quota\n+\tReasonBudget  = \"budget\"  // a daily cap is reached\n+)\n+\n+// Snapshot is a point-in-time view. Errors holds one line per source that\n+// failed; the other fields are still filled.\n+type Snapshot struct {\n+\tTakenAt time.Time\n+\tDayFrom time.Time // 00:00 UTC of TakenAt's day\n+\tPool    PoolView\n+\tRunning []RunningJob\n+\tPause   []PauseView\n+\tTicks   []TickView\n+\tLimits  LimitsView\n+\tIssues  []IssueView\n+\tSpend   SpendView\n+\tEvents  []Event\n+\tErrors  []string\n+}\n+\n+// PoolView is the slot pool.\n+type PoolView struct {\n+\tUsed, Max int\n+\tWaiting   []Waiting\n+}\n+\n+// Waiting is demand or refused candidates of one role with the reason.\n+type Waiting struct {\n+\tClass  string\n+\tRole   string\n+\tReason string // ReasonSlot, ReasonLimited or ReasonBudget\n+\tCount  int\n+\tOldest time.Duration // slot waits only\n+}\n+\n+// RunningJob is one job holding a slot.\n+type RunningJob struct {\n+\tJobID   string\n+\tIssue   int // 0 for a scanner run\n+\tPR      int\n+\tStage   string\n+\tRole    string\n+\tModel   string        // from the role config; \"\" is the agent's default\n+\tElapsed time.Duration // since the job was created\n+\tTimeout time.Duration // from the role config; 0 when unknown\n+\t// FinishedCostUSD is the cost of finished steps only; nil when no finished\n+\t// step reported a cost. The running step contributes nothing.\n+\tFinishedCostUSD *float64\n+}\n+\n+// PauseView is one active kill switch for one claiming loop.\n+type PauseView struct {\n+\tLoop   string\n+\tReason controller.Reason\n+\tErr    string\n+}\n+\n+// TickView is the last tick of a loop.\n+type TickView struct {\n+\tLoop       string\n+\tCount      int\n+\tStart, End time.Time\n+\tErr        string\n+}\n+\n+// LimitsView holds the usage-limit readings and active blocks.\n+type LimitsView struct {\n+\tWindows []WindowView\n+\tBlocks  []BlockView\n+}\n+\n+// WindowView is the latest reading of one subscription window.\n+type WindowView struct {\n+\tWindow      string\n+\tUtilization float64 // normalised to 0..1\n+\tStatus      string\n+\tResetsAt    time.Time\n+\tAge         time.Duration // now minus when it was observed\n+}\n+\n+// BlockView is an active exhaustion block for a model family (\"\" = unknown).\n+type BlockView struct {\n+\tFamily string\n+\tUntil  time.Time\n+}\n+\n+// IssueView is an issue with ard activity today.\n+type IssueView struct {\n+\tIssue   int\n---\nrole: engineer\nstatus: done\nattempt: 1\n---\nAdds the in-process `Snapshot` model (no UI) in a new `internal/snapshot` package, plus the pool and controller data it needs. Taking a snapshot reads memory and SQLite only and never calls GitHub.\n\n## Changes\n- `internal/pool`: `Stats` gains `RefusedBy` (recent `limited` and `budget` refusals per role, 2 min TTL, display only) and `WaitingRoles` (slot demand per role). New `HeldSlots()`. Offer only records the refusal after the verdict is set, so grant decisions, `items` and demand are untouched.\n- `internal/controller`: records each claiming loop's last `PauseState` and each loop's last tick (start, end, error). New `PauseStates()` and `Ticks()` return copies and never call the `PauseGate`.\n- `internal/snapshot`: `Snapshot`, `Taker.Take` and `Invalidate`, source interfaces for fakes, utilization normalisation (fraction or percent), and a per-issue cost cache. Also `Ring` and the slog `NewTee` (forwards unchanged; optional redact func applies to the recorded copy only).\n- `internal/servecmd`: wraps the serve logger with the tee and builds the Taker (`snapshot.go`), held on the wiring for #414. Nothing renders it, so serve output is unchanged.\n- `docs/layout.md`: new package line and pool note.\n\n## Testing\n`go test ./...` passes; `go test -race ./internal/snapshot` passes. `go vet ./...` is clean for the changed packages. Added tests: pool refusals (reasons, no double count, expiry, no demand reserved), `HeldSlots`, `WaitingRoles`; controller pause/tick recording; snapshot table tests for every field, the finished-steps-only cost rule, the 00:00 UTC cut, the cache and `Invalidate`, source errors, nil sources; ring and tee (byte-identical output); a zero-GetIssue test through a real controller and `PauseGate`; an import test that the package does not import `internal/github`.\n\n## Open issues\n- `make lint` fails on `gofmt -l .` because of a parse error in `internal/roles/testdata/docs/skips/src/_x.go`, which this change does not touch. The changed files are gofmt-clean.\n- The parent design (#407) was not available. \"Open `ard:` state\" needs GitHub labels, so issues come from state only: running jobs plus jobs ended since 00:00 UTC. The state is the latest job's stage, role and status.\n- Cache key is the issue's job ids and update times, and running issues are never cached, so close-out code is untouched. `Invalidate` exists for an explicit hook.\n- The tee is wired with no redact function. Log lines already go to stderr unredacted, but a maintainer may want one added for the recorded copy.\n- `snapshot` does not import `internal/github` directly. It imports `controller`, which does for its gate.","is_error":false}]},"parent_tool_use_id":null,"session_id":"5c2f5cb3-5651-4cd3-9b20-498ac3b29a58","uuid":"404b33a4-5bc9-4981-adf6-897ee5a347b5","timestamp":"2026-11-25T14:32:53.931Z","tool_use_result":{"stdout":" // Stats returns a snapshot of the pool.\n@@ -24,6 +40,11 @@ func (p *Pool) Stats() Stats {\n \t\tHeldBy:     map[Class]int{},\n \t\tWaitingBy:  map[Class]int{},\n \t\tOldestWait: map[Class]time.Duration{},\n+\t\tRefusedBy:  map[Class][]Refusal{},\n+\t}\n+\tst.WaitingRoles = p.waitingRolesLocked(now)\n+\tfor c, rs := range p.refusalsLocked(now) {\n+\t\tst.RefusedBy[c] = rs\n \t}\n \tfor _, s := range p.held {\n \t\tst.HeldBy[s.cand.Class]++\n@@ -34,3 +55,138 @@ func (p *Pool) Stats() Stats {\n \t}\n \treturn st\n }\n+\n+// refusalTTL is how long a limited or budget refusal is reported after the\n+// candidate was last refused. Loops offer every tick, so a live refusal is\n+// refreshed well inside it.\n+const refusalTTL = 2 * time.Minute\n+\n+// Refusal aggregates the live limited or budget refusals of one role. Such a\n+// candidate takes no slot and reserves no demand; this is for display only\n+// and never feeds a grant decision.\n+type Refusal struct {\n+\tRole   string\n+\tReason Verdict // DeniedLimited or DeniedBudget\n+\tCount  int     // distinct candidates refused\n+\tSince  time.Time\n+}\n+\n+type refusalKey struct {\n+\tcand    string\n+\tverdict Verdict\n+}\n+\n+type refusal struct {\n+\tclass        Class\n+\trole         string\n+\tfirst, taken time.Time\n+}\n+\n+// noteRefusalLocked records that c was refused for v at now.\n+func (p *Pool) noteRefusalLocked(c Candidate, v Verdict, now time.Time) {\n+\tk := refusalKey{c.Key(), v}\n+\tif r := p.refused[k]; r != nil {\n+\t\tr.taken = now\n+\t\treturn\n+\t}\n+\tp.refused[k] = &refusal{class: c.Class, role: c.Role, first: now, taken: now}\n+}\n+\n+// refusalsLocked returns the live refusals per class, sorted by role then reason.\n+func (p *Pool) refusalsLocked(now time.Time) map[Class][]Refusal {\n+\ttype agg struct {\n+\t\tclass Class\n+\t\trole  string\n+\t\tv     Verdict\n+\t}\n+\tgot := map[agg]*Refusal{}\n+\tfor k, r := range p.refused {\n+\t\tif now.Sub(r.taken) >= refusalTTL {\n+\t\t\tcontinue\n+\t\t}\n+\t\ta := agg{r.class, r.role, k.verdict}\n+\t\tg := got[a]\n+\t\tif g == nil {\n+\t\t\tg = &Refusal{Role: r.role, Reason: k.verdict, Since: r.first}\n+\t\t\tgot[a] = g\n+\t\t}\n+\t\tg.Count++\n+\t\tif r.first.Before(g.Since) {\n+\t\t\tg.Since = r.first\n+\t\t}\n+\t}\n+\tout := map[Class][]Refusal{}\n+\tfor a, g := range got {\n+\t\tout[a.class] = append(out[a.class], *g)\n+\t}\n+\tfor _, rs := range out {\n+\t\tsort.Slice(rs, func(i, j int) bool {\n+\t\t\tif rs[i].Role != rs[j].Role {\n+\t\t\t\treturn rs[i].Role < rs[j].Role\n+\t\t\t}\n+\t\t\treturn rs[i].Reason < rs[j].Reason\n+\t\t})\n+\t}\n+\treturn out\n+}\n+\n+// HeldInfo describes one held slot.\n+type HeldInfo struct {\n+\tKey       string\n+\tCandidate Candidate\n+\tJobID     string\n+\tGrantedAt time.Time\n+\tAdopted   bool\n+}\n+\n+// HeldSlots lists the held slots, sorted by grant time then key.\n+func (p *Pool) HeldSlots() []HeldInfo {\n+\tp.mu.Lock()\n+\tdefer p.mu.Unlock()\n+\tout := make([]HeldInfo, 0, len(p.held))\n+\tfor k, s := range p.held {\n+\t\tout = append(out, HeldInfo{Key: k, Candidate: s.cand, JobID: s.jobID, GrantedAt: s.grantedAt, Adopted: s.adopted})\n+\t}\n+\tsort.Slice(out, func(i, j int) bool {\n+\t\tif !out[i].GrantedAt.Equal(out[j].GrantedAt) {\n+\t\t\treturn out[i].GrantedAt.Before(out[j].GrantedAt)\n+\t\t}\n+\t\treturn out[i].Key < out[j].Key\n+\t})\n+\treturn out\n+}\n+\n+func (p *Pool) waitingRolesLocked(now time.Time) []RoleWait {\n+\ttype rk struct {\n+\t\tc    Class\n+\t\trole string\n+\t}\n+\tgot := map[rk]*RoleWait{}\n+\tfor _, d := range p.demand {\n+\t\tif !now.Before(d.expires) {\n+\t\t\tcontinue\n+\t\t}\n+\t\tfor k, c := range d.cands {\n+\t\t\tg := got[rk{c.Class, c.Role}]\n+\t\t\tif g == nil {\n+\t\t\t\tg = &RoleWait{Class: c.Class, Role: c.Role}\n+\t\t\t\tgot[rk{c.Class, c.Role}] = g\n+\t\t\t}\n+\t\t\tg.Count++\n+\t\t\tif t, ok := p.firstDenied[k]; ok {\n+\t\t\t\tg.Oldest = max(g.Oldest, now.Sub(t))\n+\t\t\t}\n+\t\t}\n+\t}\n+\tout := make([]RoleWait, 0, len(got))\n+\tfor _, g := range got {\n+\t\tout = append(out, *g)\n+\t}\n+\tsort.Slice(out, func(i, j int) bool {\n+\t\tif out[i].Class != out[j].Class {\n+\t\t\treturn out[i].Class < out[j].Class\n+\t\t}\n+\t\treturn out[i].Role < out[j].Role\n+\t})\n+\treturn out\n+}\ndiff --git a/internal/servecmd/serve.go b/internal/servecmd/serve.go\nindex 0a7200c..94e9388 100644\n--- a/internal/servecmd/serve.go\n+++ b/internal/servecmd/serve.go\n@@ -44,6 +44,7 @@ import (\n \t\"github.com/albertcbrown/ard/internal/redact\"\n \t\"github.com/albertcbrown/ard/internal/repopath\"\n \t\"github.com/albertcbrown/ard/internal/scanner/stale\"\n+\t\"github.com/albertcbrown/ard/internal/snapshot\"\n \t\"github.com/albertcbrown/ard/internal/state\"\n \t\"github.com/albertcbrown/ard/internal/state/scannerdb\"\n )\n@@ -178,7 +179,10 @@ func serveLoops(ctx context.Context, e *cli.Env, build builder, wantLoops []stri\n \t\tdefer d.Close()\n \t}\n \n-\tlog := e.Log\n+\t// The ring keeps the newest log records for the command center; the tee\n+\t// passes every record to the existing handler unchanged.\n+\tevents := snapshot.NewRing(snapshotEvents)\n+\tlog := slog.New(snapshot.NewTee(e.Log.Handler(), events, nil))\n \t// The controller's own bare clone: every config fetch, committer lane and\n \t// executor worktree uses it, never the operator's checkout (#113).\n \tclone, err := openClone(ctx, gitx.New(\"\"), home, repo, d.RemoteURL, d.Token, log)\n@@ -336,6 +340,7 @@ func serveLoops(ctx context.Context, e *cli.Env, build builder, wantLoops []stri\n \tif err != nil {\n \t\treturn fmt.Errorf(\"ard serve: %w\", err)\n \t}\n+\tw.snap = w.newSnapshotTaker(cc, events)\n \tstartSHA := \"\"\n \tif cfg != nil {\n \t\tstartSHA = cfg.SHA\n@@ -390,7 +395,9 @@ type wiring struct {\n \tfin    *reaper.Finisher\n \trp     *reaper.Reaper\n \tlim    *limits.Book\n-\tbgt    *budget.Gate\n+\t// snap takes snapshots for the command center (#413); nothing renders it yet.\n+\tsnap *snapshot.Taker\n+\tbgt  *budget.Gate\n \t// budgetNow is the budget gate's clock; nil means time.Now (tests set it).\n \tbudgetNow func() time.Time\n \ndiff --git a/internal/servecmd/snapshot.go b/internal/servecmd/snapshot.go\nnew file mode 100644\nindex 0000000..81b74fb\n--- /dev/null\n+++ b/internal/servecmd/snapshot.go\n@@ -0,0 +1,38 @@\n+package servecmd\n+\n+import (\n+\t\"github.com/albertcbrown/ard/internal/config\"\n+\t\"github.com/albertcbrown/ard/internal/controller\"\n+\t\"github.com/albertcbrown/ard/internal/snapshot\"\n+)\n+\n+// snapshotEvents is how many recent log records the command center keeps.\n+const snapshotEvents = 200\n+\n+// newSnapshotTaker builds the command center's Snapshot source. The pool and\n+// the limits book exist only after the startup hooks, so they are looked up\n+// at Take time; a Take before that sees them as absent. It makes no GitHub\n+// call: the kill-switch state comes from the controller's last tick.\n+func (w *wiring) newSnapshotTaker(c *controller.Controller, events *snapshot.Ring) *snapshot.Taker {\n+\treturn snapshot.New(snapshot.Sources{\n+\t\tPool: func() snapshot.PoolSource {\n+\t\t\tif p := w.pool.Load(); p != nil {\n+\t\t\t\treturn p\n+\t\t\t}\n+\t\t\treturn nil\n+\t\t},\n+\t\tLimits: func() snapshot.LimitSource {\n+\t\t\tw.initMu.Lock()\n+\t\t\tdefer w.initMu.Unlock()\n+\t\t\tif w.lim != nil {\n+\t\t\t\treturn w.lim\n+\t\t\t}\n+\t\t\treturn nil\n+\t\t},\n+\t\tState:   w.Store,\n+\t\tControl: c,\n+\t\tCaps:    w.budgetGate(),\n+\t\tConfig:  func() *config.Resolved { return w.cfg.Load() },\n+\t\tRing:    events,\n+\t})\n+}\ndiff --git a/internal/snapshot/events.go b/internal/snapshot/events.go\nnew file mode 100644\nindex 0000000..883cdf6\n--- /dev/null\n+++ b/internal/snapshot/events.go\n@@ -0,0 +1,133 @@\n+package snapshot\n+\n+import (\n+\t\"context\"\n+\t\"log/slog\"\n+\t\"strings\"\n+\t\"sync\"\n+\t\"time\"\n+)\n+\n+// Event is one recent log record.\n+type Event struct {\n+\tTime  time.Time\n+\tLevel slog.Level\n+\tMsg   string\n+\tAttrs string // flattened \"k=v k=v\", groups as \"g.k=v\"\n+}\n+\n+// Ring is a fixed-size, concurrency-safe buffer of the newest events.\n+type Ring struct {\n+\tmu   sync.Mutex\n+\tbuf  []Event\n+\tnext int\n+\tfull bool\n+}\n+\n+// NewRing returns a ring holding the newest n events (n < 1 is treated as 1).\n+func NewRing(n int) *Ring { return &Ring{buf: make([]Event, max(1, n))} }\n+\n+// Append adds e, dropping the oldest event when the ring is full.\n+func (r *Ring) Append(e Event) {\n+\tr.mu.Lock()\n+\tdefer r.mu.Unlock()\n+\tr.buf[r.next] = e\n+\tr.next = (r.next + 1) % len(r.buf)\n+\tif r.next == 0 {\n+\t\tr.full = true\n+\t}\n+}\n+\n+// Events returns a copy of the buffered events, oldest first.\n+func (r *Ring) Events() []Event {\n+\tr.mu.Lock()\n+\tdefer r.mu.Unlock()\n+\tif !r.full {\n+\t\treturn append([]Event(nil), r.buf[:r.next]...)\n+\t}\n+\tout := make([]Event, 0, len(r.buf))\n+\tout = append(out, r.buf[r.next:]...)\n+\treturn append(out, r.buf[:r.next]...)\n+}\n+\n+type tee struct {\n+\tnext   slog.Handler\n+\tring   *Ring\n+\tredact func(string) string\n+\tattrs  string // pre-flattened WithAttrs, already prefixed by groups\n+\tgroups []string\n+}\n+\n+// NewTee returns a handler that passes every record to next unchanged and\n+// also records it in ring. redact, when non-nil, is applied to the recorded\n+// text only; next's output is never altered.\n+func NewTee(next slog.Handler, ring *Ring, redact func(string) string) slog.Handler {\n+\treturn &tee{next: next, ring: ring, redact: redact}\n+}\n+\n+func (t *tee) Enabled(ctx context.Context, l slog.Level) bool { return t.next.Enabled(ctx, l) }\n+\n+func (t *tee) Handle(ctx context.Context, r slog.Record) error {\n+\tvar b strings.Builder\n+\tb.WriteString(t.attrs)\n+\tprefix := strings.Join(t.groups, \".\")\n+\tr.Attrs(func(a slog.Attr) bool {\n+\t\tflatten(&b, prefix, a)\n+\t\treturn true\n+\t})\n+\tmsg, attrs := r.Message, strings.TrimSpace(b.String())\n+\tif t.redact != nil {\n+\t\tmsg, attrs = t.redact(msg), t.redact(attrs)\n+\t}\n+\tt.ring.Append(Event{Time: r.Time, Level: r.Level, Msg: msg, Attrs: attrs})\n+\treturn t.next.Handle(ctx, r)\n+}\n+\n+func (t *tee) WithAttrs(as []slog.Attr) slog.Handler {\n+\tvar b strings.Builder\n+\tb.WriteString(t.attrs)\n+\tprefix := strings.Join(t.groups, \".\")\n+\tfor _, a := range as {\n+\t\tflatten(&b, prefix, a)\n+\t}\n+\tc := *t\n+\tc.next = t.next.WithAttrs(as)\n+\tc.attrs = b.String()\n+\treturn &c\n+}\n+\n+func (t *tee) WithGroup(name string) slog.Handler {\n+\tc := *t\n+\tc.next = t.next.WithGroup(name)\n+\tif name != \"\" {\n+\t\tc.groups = append(append([]string(nil), t.groups...), name)\n+\t}\n+\treturn &c\n+}\n+\n+func flatten(b *strings.Builder, prefix string, a slog.Attr) {\n+\ta.Value = a.Value.Resolve()\n+\tif a.Equal(slog.Attr{}) {\n+\t\treturn\n+\t}\n+\tkey := a.Key\n+\tif a.Value.Kind() == slog.KindGroup {\n+\t\tif key != \"\" {\n+\t\t\tif prefix != \"\" {\n+\t\t\t\tprefix += \".\"\n+\t\t\t}\n+\t\t\tprefix += key\n+\t\t}\n+\t\tfor _, g := range a.Value.Group() {\n+\t\t\tflatten(b, prefix, g)\n+\t\t}\n+\t\treturn\n+\t}\n+\tif prefix != \"\" {\n+\t\tkey = prefix + \".\" + key\n+\t}\n+\tb.WriteString(key)\n+\tb.WriteByte('=')\n+\tb.WriteString(a.Value.String())\n+\tb.WriteByte(' ')\n+}\ndiff --git a/internal/snapshot/events_test.go b/internal/snapshot/events_test.go\nnew file mode 100644\nindex 0000000..132afdc\n--- /dev/null\n@@ -0,0 +1,93 @@\n+package snapshot\n+\n+import (\n+\t\"bytes\"\n+\t\"fmt\"\n+\t\"log/slog\"\n+\t\"strings\"\n+\t\"sync\"\n+\t\"testing\"\n+)\n+\n+func TestRingKeepsNewestInOrder(t *testing.T) {\n+\tr := NewRing(3)\n+\tif len(r.Events()) != 0 {\n+\t\tt.Fatal(\"new ring not empty\")\n+\t}\n+\tfor i := 1; i <= 5; i++ {\n+\t\tr.Append(Event{Msg: fmt.Sprint(i)})\n+\t\tif i == 2 {\n+\t\t\tif got := r.Events(); len(got) != 2 || got[0].Msg != \"1\" || got[1].Msg != \"2\" {\n+\t\t\t\tt.Fatalf(\"partial = %+v\", got)\n+\t\t\t}\n+\t\t}\n+\t}\n+\tgot := r.Events()\n+\tif len(got) != 3 || got[0].Msg != \"3\" || got[1].Msg != \"4\" || got[2].Msg != \"5\" {\n+\t\tt.Fatalf(\"events = %+v\", got)\n+\t}\n+\tgot[0].Msg = \"x\" // a copy\n+\tif r.Events()[0].Msg != \"3\" {\n+\t\tt.Error(\"Events returned the internal buffer\")\n+\t}\n+}\n+\n+func TestRingConcurrentAppend(t *testing.T) {\n+\tr := NewRing(8)\n+\tvar wg sync.WaitGroup\n+\tfor g := 0; g < 8; g++ {\n+\t\twg.Add(1)\n+\t\tgo func() {\n+\t\t\tdefer wg.Done()\n+\t\t\tfor i := 0; i < 200; i++ {\n+\t\t\t\tr.Append(Event{Msg: \"m\"})\n+\t\t\t\t_ = r.Events()\n+\t\t\t}\n+\t\t}()\n+\t}\n+\twg.Wait()\n+\tif n := len(r.Events()); n != 8 {\n+\t\tt.Errorf(\"len = %d, want 8\", n)\n+\t}\n+}\n+\n+func TestTeeForwardsByteIdentically(t *testing.T) {\n+\tdrive := func(h slog.Handler) {\n+\t\tl := slog.New(h).With(\"loop\", \"worker\").WithGroup(\"g\").With(\"a\", 1)\n+\t\tl.Info(\"hello\", \"k\", \"v\", slog.Group(\"inner\", \"x\", 2))\n+\t\tl.Warn(\"second\", \"err\", fmt.Errorf(\"boom\"))\n+\t}\n+\tvar plain, teed bytes.Buffer\n+\topts := &slog.HandlerOptions{ReplaceAttr: func(_ []string, a slog.Attr) slog.Attr {\n+\t\tif a.Key == slog.TimeKey {\n+\t\t\treturn slog.Attr{}\n+\t\t}\n+\t\treturn a\n+\t}}\n+\tdrive(slog.NewTextHandler(&plain, opts))\n+\tring := NewRing(10)\n+\tdrive(NewTee(slog.NewTextHandler(&teed, opts), ring, nil))\n+\tif plain.String() != teed.String() {\n+\t\tt.Fatalf(\"output differs:\\n%s\\n---\\n%s\", plain.String(), teed.String())\n+\t}\n+\tev := ring.Events()\n+\tif len(ev) != 2 || ev[0].Msg != \"hello\" || ev[0].Level != slog.LevelInfo {\n+\t\tt.Fatalf(\"events = %+v\", ev)\n+\t}\n+\tif want := \"loop=worker g.a=1 g.k=v g.inner.x=2\"; ev[0].Attrs != want {\n+\t\tt.Errorf(\"attrs = %q, want %q\", ev[0].Attrs, want)\n+\t}\n+}\n+\n+func TestTeeRedactsRecordedTextOnly(t *testing.T) {\n+\tvar out bytes.Buffer\n+\tring := NewRing(2)\n+\tl := slog.New(NewTee(slog.NewTextHandler(&out, nil), ring, func(s string) string { return strings.ReplaceAll(s, \"secret\", \"[redacted]\") }))\n+\tl.Info(\"secret\", \"k\", \"secret\")\n+\tif e := ring.Events()[0]; e.Msg != \"[redacted]\" || e.Attrs != \"k=[redacted]\" {\n+\t\tt.Errorf(\"event = %+v\", e)\n+\t}\n+\tif !bytes.Contains(out.Bytes(), []byte(\"msg=secret\")) {\n+\t\tt.Errorf(\"downstream output was altered: %s\", out.String())\n+\t}\n+}\ndiff --git a/internal/snapshot/snapshot.go b/internal/snapshot/snapshot.go\nnew file mode 100644\nindex 0000000..c1e199b\n--- /dev/null\n+++ b/internal/snapshot/snapshot.go\n@@ -0,0 +1,471 @@\n+// Package snapshot builds the in-process Snapshot behind the `ard serve`\n+// command center (and a later `ard top`): pool, running jobs, kill switches,\n+// usage limits, today's issues and spend, and recent log events.\n+//\n+// Taking a snapshot is cheap and local. It reads memory (pool, limits book,\n+// controller) and the SQLite state only; it makes no GitHub call and the\n+// package must not import internal/github (an import test enforces it).\n+package snapshot\n+\n+import (\n+\t\"context\"\n+\t\"fmt\"\n+\t\"math\"\n+\t\"sort\"\n+\t\"sync\"\n+\t\"time\"\n+\n+\t\"github.com/albertcbrown/ard/internal/budget\"\n+\t\"github.com/albertcbrown/ard/internal/config\"\n+\t\"github.com/albertcbrown/ard/internal/controller\"\n+\t\"github.com/albertcbrown/ard/internal/limits\"\n+\t\"github.com/albertcbrown/ard/internal/pool\"\n+\t\"github.com/albertcbrown/ard/internal/state\"\n+)\n+\n+// Waiting reasons.\n+const (\n+\tReasonSlot    = \"slot\"    // ready, waiting for a free slot\n+\tReasonLimited = \"limited\" // account or model family is out of quota\n+\tReasonBudget  = \"budget\"  // a daily cap is reached\n+)\n+\n+// Snapshot is a point-in-time view. Errors holds one line per source that\n+// failed; the other fields are still filled.\n+type Snapshot struct {\n+\tTakenAt time.Time\n+\tDayFrom time.Time // 00:00 UTC of TakenAt's day\n+\tPool    PoolView\n+\tRunning []RunningJob\n+\tPause   []PauseView\n+\tTicks   []TickView\n+\tLimits  LimitsView\n+\tIssues  []IssueView\n+\tSpend   SpendView\n+\tEvents  []Event\n+\tErrors  []string\n+}\n+\n+// PoolView is the slot pool.\n+type PoolView struct {\n+\tUsed, Max int\n+\tWaiting   []Waiting\n+}\n+\n+// Waiting is demand or refused candidates of one role with the reason.\n+type Waiting struct {\n+\tClass  string\n+\tRole   string\n+\tReason string // ReasonSlot, ReasonLimited or ReasonBudget\n+\tCount  int\n+\tOldest time.Duration // slot waits only\n+}\n+\n+// RunningJob is one job holding a slot.\n+type RunningJob struct {\n+\tJobID   string\n+\tIssue   int // 0 for a scanner run\n+\tPR      int\n+\tStage   string\n+\tRole    string\n+\tModel   string        // from the role config; \"\" is the agent's default\n+\tElapsed time.Duration // since the job was created\n+\tTimeout time.Duration // from the role config; 0 when unknown\n+\t// FinishedCostUSD is the cost of finished steps only; nil when no finished\n+\t// step reported a cost. The running step contributes nothing.\n+\tFinishedCostUSD *float64\n+}\n+\n+// PauseView is one active kill switch for one claiming loop.\n+type PauseView struct {\n+\tLoop   string\n+\tReason controller.Reason\n+\tErr    string\n+}\n+\n+// TickView is the last tick of a loop.\n+type TickView struct {\n+\tLoop       string\n+\tCount      int\n+\tStart, End time.Time\n+\tErr        string\n+}\n+\n+// LimitsView holds the usage-limit readings and active blocks.\n+type LimitsView struct {\n+\tWindows []WindowView\n+\tBlocks  []BlockView\n+}\n+\n+// WindowView is the latest reading of one subscription window.\n+type WindowView struct {\n+\tWindow      string\n+\tUtilization float64 // normalised to 0..1\n+\tStatus      string\n+\tResetsAt    time.Time\n+\tAge         time.Duration // now minus when it was observed\n+}\n+\n+// BlockView is an active exhaustion block for a model family (\"\" = unknown).\n+type BlockView struct {\n+\tFamily string\n+\tUntil  time.Time\n+}\n+\n+// IssueView is an issue with ard activity today.\n+type IssueView struct {\n+\tIssue   int\n---\nrole: engineer\nstatus: done\nattempt: 1\n---\nAdds the in-process `Snapshot` model (no UI) in a new `internal/snapshot` package, plus the pool and controller data it needs. Taking a snapshot reads memory and SQLite only and never calls GitHub.\n\n## Changes\n- `internal/pool`: `Stats` gains `RefusedBy` (recent `limited` and `budget` refusals per role, 2 min TTL, display only) and `WaitingRoles` (slot demand per role). New `HeldSlots()`. Offer only records the refusal after the verdict is set, so grant decisions, `items` and demand are untouched.\n- `internal/controller`: records each claiming loop's last `PauseState` and each loop's last tick (start, end, error). New `PauseStates()` and `Ticks()` return copies and never call the `PauseGate`.\n- `internal/snapshot`: `Snapshot`, `Taker.Take` and `Invalidate`, source interfaces for fakes, utilization normalisation (fraction or percent), and a per-issue cost cache. Also `Ring` and the slog `NewTee` (forwards unchanged; optional redact func applies to the recorded copy only).\n- `internal/servecmd`: wraps the serve logger with the tee and builds the Taker (`snapshot.go`), held on the wiring for #414. Nothing renders it, so serve output is unchanged.\n- `docs/layout.md`: new package line and pool note.\n\n## Testing\n`go test ./...` passes; `go test -race ./internal/snapshot` passes. `go vet ./...` is clean for the changed packages. Added tests: pool refusals (reasons, no double count, expiry, no demand reserved), `HeldSlots`, `WaitingRoles`; controller pause/tick recording; snapshot table tests for every field, the finished-steps-only cost rule, the 00:00 UTC cut, the cache and `Invalidate`, source errors, nil sources; ring and tee (byte-identical output); a zero-GetIssue test through a real controller and `PauseGate`; an import test that the package does not import `internal/github`.\n\n## Open issues\n- `make lint` fails on `gofmt -l .` because of a parse error in `internal/roles/testdata/docs/skips/src/_x.go`, which this change does not touch. The changed files are gofmt-clean.\n- The parent design (#407) was not available. \"Open `ard:` state\" needs GitHub labels, so issues come from state only: running jobs plus jobs ended since 00:00 UTC. The state is the latest job's stage, role and status.\n- Cache key is the issue's job ids and update times, and running issues are never cached, so close-out code is untouched. `Invalidate` exists for an explicit hook.\n- The tee is wired with no redact function. Log lines already go to stderr unredacted, but a maintainer may want one added for the recorded copy.\n- `snapshot` does not import `internal/github` directly. It imports `controller`, which does for its gate.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01UYEo5qgVhnZoqnCrWEhpdf","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
