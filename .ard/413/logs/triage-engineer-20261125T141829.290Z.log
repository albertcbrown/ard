{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0185NQuAUxEgj6LFTViBG4Vj","type":"tool_result","content":"package pool\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"io\"\n\t\"log/slog\"\n\t\"sort\"\n\t\"sync\"\n\t\"time\"\n)\n\ntype Verdict int\n\nconst (\n\tGranted         Verdict = iota\n\tDeniedFull              // no slot was free for it, and no other loop reserved one\n\tDeniedOutranked         // higher-ranked live demand from another loop reserved the free slots\n\tDeniedIssueBusy         // triage only: a triage job on the same issue is held or granted earlier in the batch\n\tDeniedDuplicate         // same key already held, or earlier in this batch\n\tDeniedInvalid           // malformed candidate (caller bug)\n\tDeniedLimited           // its account or model family is out of quota until a reset time\n\tDeniedBudget            // a daily dollar or token cap is reached\n)\n\nvar verdictNames = [...]string{\"granted\", \"full\", \"outranked\", \"issue-busy\", \"duplicate\", \"invalid\", \"limited\", \"budget\"}\n\nfunc (v Verdict) String() string {\n\tif v >= 0 && int(v) < len(verdictNames) {\n\t\treturn verdictNames[v]\n\t}\n\treturn fmt.Sprintf(\"verdict(%d)\", int(v))\n}\n\ntype Decision struct {\n\tCandidate Candidate\n\tVerdict   Verdict\n\tSlot      *Slot  // non-nil if and only if Verdict == Granted\n\tReason    string // human-readable, for logs and the status issue\n}\n\ntype Held struct {\n\tCandidate Candidate\n\tJobID     string\n}\n\ntype Options struct {\n\tMax         int              // cfg.MaxPods; values < 1 are treated as 1\n\tNow         func() time.Time // nil means time.Now\n\tLog         *slog.Logger     // nil means discard\n\tHeld        []Held           // running jobs from state; held even if they exceed Max\n\tStarveAfter time.Duration    // 0 means 24h\n\tLimited func(c Candidate) time.Time\n\tBudget func(c Candidate) (denied bool, reason string)\n}\n\ntype Pool struct {\n\tmu          sync.Mutex\n\tmax         int\n\tnow         func() time.Time\n\tlog         *slog.Logger\n\tstarveAfter time.Duration\n\tlimited     func(c Candidate) time.Time\n\tbudget      func(c Candidate) (bool, string)\n\theld        map[string]*Slot\n\tdemand      map[string]*loopDemand\n\tfirstDenied map[string]time.Time\n\tstarved     map[Class]bool\n\tfreed       chan struct{}\n}\n\nfunc New(o Options) *Pool {\n\tp := &Pool{\n\t\tmax:         max(1, o.Max),\n\t\tnow:         o.Now,\n\t\tlog:         o.Log,\n\t\tstarveAfter: o.StarveAfter,\n\t\tlimited:     o.Limited,\n\t\tbudget:      o.Budget,\n\t\theld:        map[string]*Slot{},\n\t\tdemand:      map[string]*loopDemand{},\n\t\tfirstDenied: map[string]time.Time{},\n\t\tstarved:     map[Class]bool{},\n\t\tfreed:       make(chan struct{}, 1),\n\t}\n\tif p.now == nil {\n\t\tp.now = time.Now\n\t}\n\tif p.log == nil {\n\t\tp.log = slog.New(slog.NewTextHandler(io.Discard, nil))\n\t}\n\tif p.starveAfter == 0 {\n\t\tp.starveAfter = 24 * time.Hour\n\t}\n\tfor _, h := range o.Held {\n\t\tk := h.Candidate.Key()\n\t\tif p.held[k] != nil {\n\t\t\tp.log.Warn(\"pool.adopt_duplicate\", \"key\", k, \"job_id\", h.JobID)\n\t\t\tcontinue\n\t\t}\n\t\tp.held[k] = &Slot{pool: p, cand: h.Candidate, jobID: h.JobID, grantedAt: p.now(), adopted: true}\n\t}\n\tif len(p.held) > p.max {\n\t\tp.log.Warn(\"pool.adopt_over_max\", \"held\", len(p.held), \"max\", p.max)\n\t}\n\treturn p\n}\n\nfunc (p *Pool) SetMax(n int) {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\told := p.max\n\tp.max = max(1, n)\n\tif p.max > old {\n\t\tp.signalLocked()\n\t}\n}\n\nfunc (p *Pool) Freed() <-chan struct{} { return p.freed }\n\nfunc (p *Pool) signalLocked() {\n\tselect {\n\tcase p.freed <- struct{}{}:\n\tdefault:\n\t}\n}\n\nfunc (p *Pool) Lookup(key string) (*Slot, bool) {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\ts, ok := p.held[key]\n\treturn s, ok\n}\n\ntype item struct {\n\tcand Candidate\n\tidx  int // index into decisions; -1 for foreign demand\n}\n\nfunc (p *Pool) Offer(loop string, ttl time.Duration, cands []Candidate) []Decision {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\tnow := p.now()\n\tp.purgeLocked(now)\n\n\tfree0 := max(0, p.max-len(p.held))\n\tfree := free0\n\tdecisions := make([]Decision, len(cands))\n\ttriageHeld := map[int]bool{}\n\tfor _, s := range p.held {\n\t\tif s.cand.Class == ClassTriage {\n\t\t\ttriageHeld[s.cand.Number] = true\n\t\t}\n\t}\n\n\tinBatch := map[string]bool{}\n\tvar items []item\n\tfor i, c := range cands {\n\t\tdecisions[i].Candidate = c\n\t\tif why := c.invalid(); why != \"\" {\n\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedInvalid, why\n\t\t\tp.log.Warn(\"pool.invalid\", \"loop\", loop, \"class\", c.Class.String(), \"role\", c.Role, \"number\", c.Number, \"reason\", why)\n\t\t\tcontinue\n\t\t}\n\t\tk := c.Key()\n\t\tif p.held[k] != nil || inBatch[k] {\n\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedDuplicate, \"already held or offered earlier in this batch\"\n\t\t\tcontinue\n\t\t}\n\t\tif p.limited != nil {\n\t\t\tif until := p.limited(c); now.Before(until) {\n\t\t\t\tdecisions[i].Verdict = DeniedLimited\n\t\t\t\tdecisions[i].Reason = \"usage limit until \" + until.UTC().Format(\"15:04\") + \" UTC\"\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tif p.budget != nil {\n\t\t\tif denied, why := p.budget(c); denied {\n\t\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedBudget, why\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tinBatch[k] = true\n\t\titems = append(items, item{c, i})\n\t}\n\tfor _, c := range p.foreignLocked(loop, now, inBatch, triageHeld) {\n\t\titems = append(items, item{c, -1})\n\t}\n\tsort.Slice(items, func(a, b int) bool { return less(items[a].cand, items[b].cand) })\n\n\treserved := 0\n\ttriageGranted := map[int]bool{}\n\tvar denied []Candidate\n\tcapDenied := 0\n\tfor _, it := range items {\n\t\tif it.idx < 0 {\n\t\t\tif free > 0 {\n\t\t\t\tfree--\n\t\t\t\treserved++\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\td := &decisions[it.idx]\n\t\tc := it.cand\n\t\tswitch {\n\t\tcase c.Class == ClassTriage && (triageHeld[c.Number] || triageGranted[c.Number]):\n\t\t\td.Verdict, d.Reason = DeniedIssueBusy, fmt.Sprintf(\"a triage job on #%d is already held\", c.Number)\n\t\tcase free > 0:\n\t\t\tfree--\n\t\t\ts := &Slot{pool: p, cand: c, grantedAt: now}\n\t\t\tp.held[c.Key()] = s\n\t\t\tif c.Class == ClassTriage {\n\t\t\t\ttriageGranted[c.Number] = true\n\t\t\t}\n\t\t\tdelete(p.firstDenied, c.Key())\n\t\t\td.Verdict, d.Slot = Granted, s\n\t\t\tp.log.Debug(\"pool.grant\", \"loop\", loop, \"key\", c.Key(), \"class\", c.Class.String(), \"role\", c.Role, \"number\", c.Number)\n\t\tcase capDenied < reserved:\n\t\t\tcapDenied++\n\t\t\td.Verdict, d.Reason = DeniedOutranked, fmt.Sprintf(\"outranked by %d higher-ranked waiting job(s)\", reserved)\n\t\t\tdenied = append(denied, c)\n\t\tdefault:\n\t\t\tcapDenied++\n\t\t\td.Verdict, d.Reason = DeniedFull, \"no free slot\"\n\t\t\tdenied = append(denied, c)\n\t\t}\n\t}\n\tp.setDemandLocked(loop, now, ttl, denied)\n\tp.checkStarvationLocked(now)\n\n\tif p.log.Enabled(context.Background(), slog.LevelDebug) {\n\t\tcounts := map[string]int{}\n\t\tfor _, d := range decisions {\n\t\t\tcounts[d.Verdict.String()]++\n\t\t}\n\t\tp.log.Debug(\"pool.offer\", \"loop\", loop, \"verdicts\", fmt.Sprint(counts), \"free_before\", free0, \"free_after\", max(0, p.max-len(p.held)))\n\t}\n\treturn decisions\n}\npackage pool\n\nimport \"time\"\n\ntype Stats struct {\n\tMax, Held, Free int\n\tHeldBy          map[Class]int\n\tWaitingBy map[Class]int\n\tOldestWait map[Class]time.Duration\n}\n\nfunc (p *Pool) Stats() Stats {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\tnow := p.now()\n\tst := Stats{\n\t\tMax:        p.max,\n\t\tHeld:       len(p.held),\n\t\tFree:       max(0, p.max-len(p.held)),\n\t\tHeldBy:     map[Class]int{},\n\t\tWaitingBy:  map[Class]int{},\n\t\tOldestWait: map[Class]time.Duration{},\n\t}\n\tfor _, s := range p.held {\n\t\tst.HeldBy[s.cand.Class]++\n\t}\n\tfor c, n := range p.waitingLocked(now) {\n\t\tst.WaitingBy[c] = n.count\n\t\tst.OldestWait[c] = n.oldest\n\t}\n\treturn st\n}\npackage pool\n\nimport (\n\t\"sort\"\n\t\"time\"\n)\n\ntype loopDemand struct {\n\texpires time.Time\n\tcands   map[string]Candidate\n}\n\ntype waiting struct {\n\tcount  int\n\toldest time.Duration\n\tkey      string\n\tpriority int\n}\n\nfunc (p *Pool) purgeLocked(now time.Time) {\n\tfor loop, d := range p.demand {\n\t\tif !now.Before(d.expires) {\n\t\t\tfor k := range d.cands {\n\t\t\t\tdelete(p.firstDenied, k)\n\t\t\t}\n\t\t\tdelete(p.demand, loop)\n\t\t}\n\t}\n}\n\nfunc (p *Pool) foreignLocked(loop string, now time.Time, batch map[string]bool, triageHeld map[int]bool) []Candidate {\n\tvar out []Candidate\n\tfor l, d := range p.demand {\n\t\tif l == loop || !now.Before(d.expires) {\n\t\t\tcontinue\n\t\t}\n\t\tfor k, c := range d.cands {\n\t\t\tif p.held[k] != nil || batch[k] {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif c.Class == ClassTriage && triageHeld[c.Number] {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tout = append(out, c)\n\t\t}\n\t}\n\tbest := map[int]Candidate{}\n\tfor _, c := range out {\n\t\tif c.Class == ClassTriage {\n\t\t\tif b, ok := best[c.Number]; !ok || less(c, b) {\n\t\t\t\tbest[c.Number] = c\n\t\t\t}\n\t\t}\n\t}\n\tkept := out[:0]\n\tfor _, c := range out {\n\t\tif c.Class == ClassTriage && best[c.Number] != c {\n\t\t\tcontinue\n\t\t}\n\t\tkept = append(kept, c)\n\t}\n\treturn kept\n}\n\nfunc (p *Pool) setDemandLocked(loop string, now time.Time, ttl time.Duration, denied []Candidate) {\n\told := p.demand[loop]\n\tdelete(p.demand, loop)\n\td := &loopDemand{expires: now.Add(ttl), cands: map[string]Candidate{}}\n\tif ttl > 0 {\n\t\tfor _, c := range denied {\n\t\t\td.cands[c.Key()] = c\n\t\t}\n\t}\n\tif old != nil {\n\t\tfor k := range old.cands {\n\t\t\tif _, ok := d.cands[k]; !ok {\n\t\t\t\tdelete(p.firstDenied, k)\n\t\t\t}\n\t\t}\n\t}\n\tif len(d.cands) == 0 {\n\t\treturn\n\t}\n\tfor k := range d.cands {\n\t\tif _, ok := p.firstDenied[k]; !ok {\n\t\t\tp.firstDenied[k] = now\n\t\t}\n\t}\n\tp.demand[loop] = d\n}\n\nfunc (p *Pool) waitingLocked(now time.Time) map[Class]waiting {\n\tout := map[Class]waiting{}\n\tfor _, d := range p.demand {\n\t\tif !now.Before(d.expires) {\n\t\t\tcontinue\n\t\t}\n\t\tfor k, c := range d.cands {\n\t\t\tw := out[c.Class]\n\t\t\tw.count++\n\t\t\tif t, ok := p.firstDenied[k]; ok && now.Sub(t) > w.oldest {\n\t\t\t\tw.oldest = now.Sub(t)\n\t\t\t\tw.key, w.priority = k, c.Priority\n\t\t\t}\n\t\t\tout[c.Class] = w\n\t\t}\n\t}\n\treturn out\n}\n\nfunc (p *Pool) checkStarvationLocked(now time.Time) {\n\tw := p.waitingLocked(now)\n\tfor c := ClassReview; c <= ClassScanner; c++ {\n\t\tws, ok := w[c]\n\t\tif !ok {\n\t\t\tp.starved[c] = false\n\t\t\tcontinue\n\t\t}\n\t\tif ws.oldest < p.starveAfter {\n\t\t\tp.starved[c] = false\n\t\t\tcontinue\n\t\t}\n\t\tif !p.starved[c] {\n\t\t\tp.starved[c] = true\n\t\t\tp.log.Warn(\"pool.starved\", \"class\", c.String(), \"waiting\", ws.count, \"oldest_wait\", ws.oldest.String(), \"key\", ws.key, \"priority\", ws.priority)\n\t\t}\n\t}\n}\n\nfunc (p *Pool) DemandLoops(now time.Time) []string {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\tvar out []string\n\tfor l, d := range p.demand {\n\t\tif !now.Before(d.expires) {\n\t\t\tcontinue\n\t\t}\n\t\tfor k, c := range d.cands {\n\t\t\tif c.Class != ClassScanner && p.held[k] == nil {\n\t\t\t\tout = append(out, l)\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t}\n\tsort.Strings(out)\n\treturn out\n}\npackage limits\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"sort\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/agent\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\nconst readingsKey = \"limits.readings\"\n\nconst maxReadings = 16\n\ntype Reading struct {\n\tWindow      string    `json:\"window\"`\n\tUtilization float64   `json:\"utilization\"` // as the stream reports it\n\tStatus      string    `json:\"status\"`\n\tResetsAt    time.Time `json:\"resets_at\"`\n\tObservedAt  time.Time `json:\"observed_at\"`\n}\n\nfunc (b *Book) loadReadings(ctx context.Context) error {\n\tv, err := b.meta.Meta(ctx, readingsKey)\n\tswitch {\n\tcase errors.Is(err, state.ErrNotFound):\n\t\treturn nil\n\tcase err != nil:\n\t\treturn fmt.Errorf(\"open limits readings: %w\", err)\n\t}\n\tvar got map[string]Reading\n\tif err := json.Unmarshal([]byte(v), &got); err != nil {\n\t\tb.log.Warn(\"limits.corrupt\", \"key\", readingsKey, \"error\", err)\n\t\treturn nil\n\t}\n\tif got != nil {\n\t\tb.readings = got\n\t}\n\treturn nil\n}\n\nfunc (b *Book) Observe(ctx context.Context, ws []agent.Window) error {\n\tif len(ws) == 0 {\n\t\treturn nil\n\t}\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tnow := b.now().UTC()\n\tnext := make(map[string]Reading, len(b.readings)+len(ws))\n\tfor k, r := range b.readings {\n\t\tnext[k] = r\n\t}\n\tvar changed []Reading\n\tfor _, w := range ws {\n\t\tr := Reading{Window: w.Type, Utilization: w.Utilization, Status: w.Status, ResetsAt: w.ResetsAt.UTC(), ObservedAt: now}\n\t\told, ok := next[w.Type]\n\t\tif !ok && len(next) >= maxReadings {\n\t\t\tcontinue\n\t\t}\n\t\tif ok && old.Utilization == r.Utilization && old.Status == r.Status && old.ResetsAt.Equal(r.ResetsAt) {\n\t\t\tcontinue\n\t\t}\n\t\tnext[w.Type] = r\n\t\tchanged = append(changed, r)\n\t}\n\tif len(changed) == 0 {\n\t\treturn nil\n\t}\n\traw, err := json.Marshal(next)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"encode limits readings: %w\", err)\n\t}\n\tif err := b.meta.SetMeta(ctx, readingsKey, string(raw)); err != nil {\n\t\treturn fmt.Errorf(\"persist limits readings: %w\", err)\n\t}\n\tb.readings = next\n\tfor _, r := range changed {\n\t\tb.log.Info(\"limits.reading\", \"window\", r.Window, \"utilization\", r.Utilization, \"status\", r.Status, \"resets_at\", r.ResetsAt)\n\t}\n\treturn nil\n}\n\nfunc (b *Book) Readings() []Reading {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tout := make([]Reading, 0, len(b.readings))\n\tfor _, r := range b.readings {\n\t\tout = append(out, r)\n\t}\n\tsort.Slice(out, func(i, j int) bool { return out[i].Window < out[j].Window })\n\treturn out\n}\npackage controller\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\nconst (\n\tStatusTitle  = \"ard status\"\n\tStatusMarker = \"<!-- ard:status -->\"\n)\n\nconst StatusIssueKey = \"status_issue\"\n\ntype StatusReader interface {\n\tGetIssue(ctx context.Context, n int) (github.Issue, error)\n\tSearchIssues(ctx context.Context, q string, o github.SearchOpts) ([]github.Issue, error)\n}\n\ntype StatusCache interface {\n\tMeta(ctx context.Context, key string) (string, error)\n\tSetMeta(ctx context.Context, key, value string) error\n}\n\nvar _ StatusCache = (*state.Store)(nil)\n\ntype StatusEffects interface {\n\tCreateIssue(ctx context.Context, in github.NewIssue) (github.Issue, error)\n\tPinIssue(ctx context.Context, n int) error\n}\n\nconst statusBody = StatusMarker + \"\\n\\nManaged by ard. Add the `\" + labels.Pause +\n\t\"` label to stop new claims; remove it to resume.\\n\"\n\nfunc ownStatusIssue(is github.Issue, author string) bool {\n\treturn !is.IsPR && is.State == github.StateOpen && is.Title == StatusTitle &&\n\t\tstrings.EqualFold(is.Author, author) && strings.Contains(is.Body, StatusMarker)\n}\n\nfunc EnsureStatusIssue(ctx context.Context, gh StatusReader, fx StatusEffects, cache StatusCache, author string, log *slog.Logger) (int, error) {\n\tif log == nil {\n\t\tlog = slog.Default()\n\t}\n\tprev := 0\n\tif cache != nil {\n\t\tprev = cachedStatusNumber(ctx, cache, log)\n\t}\n\tif prev > 0 {\n\t\tn, ok := adoptCached(ctx, gh, prev, author, log)\n\t\tif ok {\n\t\t\treturn n, nil\n\t\t}\n\t}\n\tq := fmt.Sprintf(`is:issue is:open in:title \"%s\"`, StatusTitle)\n\tfound, err := gh.SearchIssues(ctx, q, github.SearchOpts{Sort: \"created\", Order: \"asc\"})\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"find status issue: %w\", err)\n\t}\n\tvar nums []int\n\tfor _, is := range found {\n\t\tif ownStatusIssue(is, author) {\n\t\t\tnums = append(nums, is.Number)\n\t\t}\n\t}\n\tsort.Ints(nums)\n\tswitch {\n\tcase len(nums) == 1:\n\t\tremember(ctx, cache, nums[0], prev, log)\n\t\treturn nums[0], nil\n\tcase len(nums) > 1:\n\t\tlog.Warn(\"status.duplicate\", \"using\", nums[0], \"all\", nums)\n\t\tremember(ctx, cache, nums[0], prev, log)\n\t\treturn nums[0], nil\n\t}\n\tis, err := fx.CreateIssue(ctx, github.NewIssue{Title: StatusTitle, Body: statusBody})\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"create status issue: %w\", err)\n\t}\n\tremember(ctx, cache, is.Number, prev, log)\n\tif err := fx.PinIssue(ctx, is.Number); err != nil {\n\t\tlog.Warn(\"status.pin_failed\", \"issue\", is.Number, \"error\", err,\n\t\t\t\"hint\", \"pin the status issue manually\")\n\t}\n\tlog.Info(\"status.created\", \"issue\", is.Number)\n\treturn is.Number, nil\n}\n\nfunc cachedStatusNumber(ctx context.Context, cache StatusCache, log *slog.Logger) int {\n\tv, err := cache.Meta(ctx, StatusIssueKey)\n\tif errors.Is(err, state.ErrNotFound) {\n\t\treturn 0\n\t}\n\tif err != nil {\n\t\tlog.Warn(\"status.cache_read_failed\", \"error\", err)\n\t\treturn 0\n\t}\n\tn, err := strconv.Atoi(v)\n\tif err != nil || n <= 0 {\n\t\tlog.Warn(\"status.cache_invalid\", \"value\", v)\n\t\treturn 0\n\t}\n\treturn n\n}\n\nfunc adoptCached(ctx context.Context, gh StatusReader, n int, author string, log *slog.Logger) (int, bool) {\n\tis, err := gh.GetIssue(ctx, n)\n\tswitch {\n\tcase errors.Is(err, github.ErrNotFound):\n\t\tlog.Info(\"status.cache_stale\", \"issue\", n, \"reason\", \"not_found\")\n\t\treturn 0, false\n\tcase err != nil:\n\t\tlog.Warn(\"status.cache_unreadable\", \"issue\", n, \"error\", err)\n\t\treturn 0, false\n\t}\n\tif is.Number == n && ownStatusIssue(is, author) {\n\t\treturn n, true\n\t}\n\treason := \"foreign\"\n\tif is.State == github.StateClosed {\n\t\treason = \"closed\"\n\t}\n\tlog.Info(\"status.cache_stale\", \"issue\", n, \"reason\", reason)\n\treturn 0, false\n}\n\nfunc remember(ctx context.Context, cache StatusCache, n, prev int, log *slog.Logger) {\n\tif cache == nil || n <= 0 || n == prev {\n\t\treturn\n\t}\n\tif err := cache.SetMeta(ctx, StatusIssueKey, strconv.Itoa(n)); err != nil {\n\t\tlog.Warn(\"status.cache_write_failed\", \"issue\", n, \"error\", err)\n\t}\n}\npackage controller\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"runtime/debug\"\n\t\"sort\"\n\t\"sync\"\n)\n\nvar ErrStopping = errors.New(\"controller is stopping\")\n\ntype Inflight struct {\n\tlog *slog.Logger\n\tctx context.Context\n\n\tmu     sync.Mutex\n\tn      uint64\n\tnames  map[uint64]string\n\tclosed bool\n\twg     sync.WaitGroup\n}\n\nfunc NewInflight(ctx context.Context, log *slog.Logger) *Inflight {\n\treturn &Inflight{log: log, ctx: ctx, names: map[uint64]string{}}\n}\n\nfunc (i *Inflight) Go(name string, fn func(ctx context.Context)) error {\n\ti.mu.Lock()\n\tif i.closed {\n\t\ti.mu.Unlock()\n\t\treturn fmt.Errorf(\"inflight %s: %w\", name, ErrStopping)\n\t}\n\ti.n++\n\tid := i.n\n\ti.names[id] = name\n\ti.wg.Add(1)\n\ti.mu.Unlock()\n\n\tgo func() {\n\t\tdefer func() {\n\t\t\tif r := recover(); r != nil {\n\t\t\t\ti.log.Error(\"inflight.panic\", \"name\", name, \"panic\", fmt.Sprint(r), \"stack\", string(debug.Stack()))\n\t\t\t}\n\t\t\ti.mu.Lock()\n\t\t\tdelete(i.names, id)\n\t\t\ti.mu.Unlock()\n\t\t\ti.wg.Done()\n\t\t}()\n\t\tfn(i.ctx)\n\t}()\n\treturn nil\n}\n\nfunc (i *Inflight) Pending() []string {\n\ti.mu.Lock()\n\tdefer i.mu.Unlock()\n\tout := make([]string, 0, len(i.names))\n\tfor _, n := range i.names {\n\t\tout = append(out, n)\n\t}\n\tsort.Strings(out)\n\treturn out\n}\n\nfunc (i *Inflight) close() {\n\ti.mu.Lock()\n\ti.closed = true\n\ti.mu.Unlock()\n}\n\nfunc (i *Inflight) Wait() <-chan struct{} {\n\tch := make(chan struct{})\n\tgo func() { i.wg.Wait(); close(ch) }()\n\treturn ch\n}\npackage controller\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"log/slog\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"slices\"\n\t\"sync\"\n\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n\t\"github.com/albertcbrown/ard/internal/repopath\"\n)\n\ntype Reason string\n\nconst (\n\tReasonNone          Reason = \"\"\n\tReasonConfig        Reason = \"config\"         // cfg.Paused (paused: true on origin/main)\n\tReasonConfigInvalid Reason = \"config-invalid\" // reload failed (set by the scheduler)\n\tReasonLabel         Reason = \"label\"          // ard:pause on the status issue\n\tReasonUnreadable    Reason = \"status-unreadable\"\n\tReasonPauseFile Reason = \"pause-file\"\n\tReasonPauseFileUnreadable Reason = \"pause-file-unreadable\"\n\tReasonLocalConfig Reason = \"local-config\"\n)\n\ntype PauseState struct {\n\tPaused bool\n\tReason Reason\n\tErr    error // set for ReasonUnreadable and ReasonPauseFileUnreadable\n}\n\ntype Pauser interface {\n\tCheck(ctx context.Context, cfg *config.Resolved) PauseState\n}\n\ntype IssueGetter interface {\n\tGetIssue(ctx context.Context, n int) (github.Issue, error)\n}\n\ntype PauseGate struct {\n\tgh  IssueGetter\n\tlog *slog.Logger\n\n\tmu          sync.Mutex\n\tissue       int\n\tpauseFile   string // \"\" = no pause file check\n\tlocalRoot   string // \"\" = no local working-tree check\n\tunreadable  bool   // status issue: last check failed; for once-per-transition logging\n\tfileErr     bool   // pause file: last check failed\n\tlocalErr    bool   // local config: last read failed\n\twarnedClose bool\n}\n\nfunc PauseFilePath(home, owner, repo string) (string, error) {\n\tp, err := repopath.Join(filepath.Join(home, \".ard\", \"pause\"), owner+\"/\"+repo)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"pause file: %w\", err)\n\t}\n\treturn p, nil\n}\n\nfunc (g *PauseGate) SetPauseFile(path string) {\n\tg.mu.Lock()\n\tg.pauseFile = path\n\tg.fileErr = false\n\tg.mu.Unlock()\n}\n\nfunc (g *PauseGate) SetLocalConfig(root string) {\n\tg.mu.Lock()\n\tg.localRoot = root\n\tg.localErr = false\n\tg.mu.Unlock()\n}\n\nfunc NewPauseGate(gh IssueGetter, log *slog.Logger) *PauseGate {\n\tif log == nil {\n\t\tlog = slog.Default()\n\t}\n\treturn &PauseGate{gh: gh, log: log}\n}\n\nfunc (g *PauseGate) SetStatusIssue(n int) {\n\tg.mu.Lock()\n\tg.issue = n\n\tg.unreadable, g.warnedClose = false, false\n\tg.mu.Unlock()\n}\n\nfunc (g *PauseGate) Check(ctx context.Context, cfg *config.Resolved) PauseState {\n\tif st := g.checkLocal(); st.Paused {\n\t\treturn st\n\t}\n\tif cfg != nil && cfg.Paused {\n\t\treturn PauseState{Paused: true, Reason: ReasonConfig}\n\t}\n\tg.mu.Lock()\n\tn := g.issue\n\tg.mu.Unlock()\n\tif n <= 0 {\n\t\treturn PauseState{}\n\t}\n\tis, err := g.gh.GetIssue(ctx, n)\n\tif err != nil {\n\t\tg.mu.Lock()\n\t\tfirst := !g.unreadable\n\t\tg.unreadable = true\n\t\tg.mu.Unlock()\n\t\tif first {\n\t\t\tif errors.Is(err, github.ErrNotFound) {\n\t\t\t\tg.log.Warn(\"pause.status_issue_unreadable\", \"issue\", n, \"error\", err,\n\t\t\t\t\t\"hint\", \"status issue is gone; restart ard serve to recreate it\")\n\t\t\t} else {\n\t\t\t\tg.log.Warn(\"pause.status_issue_unreadable\", \"issue\", n, \"error\", err)\n\t\t\t}\n\t\t}\n\t\treturn PauseState{Paused: true, Reason: ReasonUnreadable, Err: err}\n\t}\n\tg.mu.Lock()\n\tif g.unreadable {\n\t\tg.log.Info(\"pause.status_issue_readable\", \"issue\", n)\n\t}\n\tg.unreadable = false\n\twarn := is.State == github.StateClosed && !g.warnedClose\n\tif warn {\n\t\tg.warnedClose = true\n\t}\n\tg.mu.Unlock()\n\tif warn {\n\t\tg.log.Warn(\"pause.status_issue_closed\", \"issue\", n)\n\t}\n\tif slices.Contains(is.Labels, labels.Pause) {\n\t\treturn PauseState{Paused: true, Reason: ReasonLabel}\n\t}\n\treturn PauseState{}\n}\n\nfunc (g *PauseGate) checkLocal() PauseState {\n\tg.mu.Lock()\n\tpath, root := g.pauseFile, g.localRoot\n\tg.mu.Unlock()\n\tif path != \"\" {\n\t\t_, err := os.Lstat(path)\n\t\tswitch {\n\t\tcase err == nil:\n\t\t\treturn PauseState{Paused: true, Reason: ReasonPauseFile}\n\t\tcase errors.Is(err, fs.ErrNotExist):\n\t\t\tg.setFlag(&g.fileErr, false, func() { g.log.Info(\"pause.file_readable\", \"path\", path) })\n\t\tdefault:\n\t\t\tg.setFlag(&g.fileErr, true, func() { g.log.Warn(\"pause.file_unreadable\", \"path\", path, \"error\", err) })\n\t\t\treturn PauseState{Paused: true, Reason: ReasonPauseFileUnreadable, Err: err}\n\t\t}\n\t}\n\tif root != \"\" {\n\t\tpaused, err := config.LocalPaused(os.DirFS(root))\n\t\tif err != nil {\n\t\t\tg.setFlag(&g.localErr, true, func() { g.log.Warn(\"pause.local_config_unreadable\", \"root\", root, \"error\", err) })\n\t\t} else {\n\t\t\tg.setFlag(&g.localErr, false, nil)\n\t\t}\n\t\tif paused {\n\t\t\treturn PauseState{Paused: true, Reason: ReasonLocalConfig}\n\t\t}\n\t}\n\treturn PauseState{}\n}\n\nfunc (g *PauseGate) setFlag(flag *bool, v bool, onChange func()) {\n\tg.mu.Lock()\n\tchanged := *flag != v\n\t*flag = v\n\tg.mu.Unlock()\n\tif changed && onChange != nil {\n\t\tonChange()\n\t}\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"1aa6b73b-f549-4a46-91a5-3ff10f06203e","uuid":"247b16fa-a981-4ce0-980a-15290b2cf82e","timestamp":"2026-11-25T14:18:34.955Z","tool_use_result":{"stdout":"package pool\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"io\"\n\t\"log/slog\"\n\t\"sort\"\n\t\"sync\"\n\t\"time\"\n)\n\ntype Verdict int\n\nconst (\n\tGranted         Verdict = iota\n\tDeniedFull              // no slot was free for it, and no other loop reserved one\n\tDeniedOutranked         // higher-ranked live demand from another loop reserved the free slots\n\tDeniedIssueBusy         // triage only: a triage job on the same issue is held or granted earlier in the batch\n\tDeniedDuplicate         // same key already held, or earlier in this batch\n\tDeniedInvalid           // malformed candidate (caller bug)\n\tDeniedLimited           // its account or model family is out of quota until a reset time\n\tDeniedBudget            // a daily dollar or token cap is reached\n)\n\nvar verdictNames = [...]string{\"granted\", \"full\", \"outranked\", \"issue-busy\", \"duplicate\", \"invalid\", \"limited\", \"budget\"}\n\nfunc (v Verdict) String() string {\n\tif v >= 0 && int(v) < len(verdictNames) {\n\t\treturn verdictNames[v]\n\t}\n\treturn fmt.Sprintf(\"verdict(%d)\", int(v))\n}\n\ntype Decision struct {\n\tCandidate Candidate\n\tVerdict   Verdict\n\tSlot      *Slot  // non-nil if and only if Verdict == Granted\n\tReason    string // human-readable, for logs and the status issue\n}\n\ntype Held struct {\n\tCandidate Candidate\n\tJobID     string\n}\n\ntype Options struct {\n\tMax         int              // cfg.MaxPods; values < 1 are treated as 1\n\tNow         func() time.Time // nil means time.Now\n\tLog         *slog.Logger     // nil means discard\n\tHeld        []Held           // running jobs from state; held even if they exceed Max\n\tStarveAfter time.Duration    // 0 means 24h\n\tLimited func(c Candidate) time.Time\n\tBudget func(c Candidate) (denied bool, reason string)\n}\n\ntype Pool struct {\n\tmu          sync.Mutex\n\tmax         int\n\tnow         func() time.Time\n\tlog         *slog.Logger\n\tstarveAfter time.Duration\n\tlimited     func(c Candidate) time.Time\n\tbudget      func(c Candidate) (bool, string)\n\theld        map[string]*Slot\n\tdemand      map[string]*loopDemand\n\tfirstDenied map[string]time.Time\n\tstarved     map[Class]bool\n\tfreed       chan struct{}\n}\n\nfunc New(o Options) *Pool {\n\tp := &Pool{\n\t\tmax:         max(1, o.Max),\n\t\tnow:         o.Now,\n\t\tlog:         o.Log,\n\t\tstarveAfter: o.StarveAfter,\n\t\tlimited:     o.Limited,\n\t\tbudget:      o.Budget,\n\t\theld:        map[string]*Slot{},\n\t\tdemand:      map[string]*loopDemand{},\n\t\tfirstDenied: map[string]time.Time{},\n\t\tstarved:     map[Class]bool{},\n\t\tfreed:       make(chan struct{}, 1),\n\t}\n\tif p.now == nil {\n\t\tp.now = time.Now\n\t}\n\tif p.log == nil {\n\t\tp.log = slog.New(slog.NewTextHandler(io.Discard, nil))\n\t}\n\tif p.starveAfter == 0 {\n\t\tp.starveAfter = 24 * time.Hour\n\t}\n\tfor _, h := range o.Held {\n\t\tk := h.Candidate.Key()\n\t\tif p.held[k] != nil {\n\t\t\tp.log.Warn(\"pool.adopt_duplicate\", \"key\", k, \"job_id\", h.JobID)\n\t\t\tcontinue\n\t\t}\n\t\tp.held[k] = &Slot{pool: p, cand: h.Candidate, jobID: h.JobID, grantedAt: p.now(), adopted: true}\n\t}\n\tif len(p.held) > p.max {\n\t\tp.log.Warn(\"pool.adopt_over_max\", \"held\", len(p.held), \"max\", p.max)\n\t}\n\treturn p\n}\n\nfunc (p *Pool) SetMax(n int) {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\told := p.max\n\tp.max = max(1, n)\n\tif p.max > old {\n\t\tp.signalLocked()\n\t}\n}\n\nfunc (p *Pool) Freed() <-chan struct{} { return p.freed }\n\nfunc (p *Pool) signalLocked() {\n\tselect {\n\tcase p.freed <- struct{}{}:\n\tdefault:\n\t}\n}\n\nfunc (p *Pool) Lookup(key string) (*Slot, bool) {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\ts, ok := p.held[key]\n\treturn s, ok\n}\n\ntype item struct {\n\tcand Candidate\n\tidx  int // index into decisions; -1 for foreign demand\n}\n\nfunc (p *Pool) Offer(loop string, ttl time.Duration, cands []Candidate) []Decision {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\tnow := p.now()\n\tp.purgeLocked(now)\n\n\tfree0 := max(0, p.max-len(p.held))\n\tfree := free0\n\tdecisions := make([]Decision, len(cands))\n\ttriageHeld := map[int]bool{}\n\tfor _, s := range p.held {\n\t\tif s.cand.Class == ClassTriage {\n\t\t\ttriageHeld[s.cand.Number] = true\n\t\t}\n\t}\n\n\tinBatch := map[string]bool{}\n\tvar items []item\n\tfor i, c := range cands {\n\t\tdecisions[i].Candidate = c\n\t\tif why := c.invalid(); why != \"\" {\n\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedInvalid, why\n\t\t\tp.log.Warn(\"pool.invalid\", \"loop\", loop, \"class\", c.Class.String(), \"role\", c.Role, \"number\", c.Number, \"reason\", why)\n\t\t\tcontinue\n\t\t}\n\t\tk := c.Key()\n\t\tif p.held[k] != nil || inBatch[k] {\n\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedDuplicate, \"already held or offered earlier in this batch\"\n\t\t\tcontinue\n\t\t}\n\t\tif p.limited != nil {\n\t\t\tif until := p.limited(c); now.Before(until) {\n\t\t\t\tdecisions[i].Verdict = DeniedLimited\n\t\t\t\tdecisions[i].Reason = \"usage limit until \" + until.UTC().Format(\"15:04\") + \" UTC\"\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tif p.budget != nil {\n\t\t\tif denied, why := p.budget(c); denied {\n\t\t\t\tdecisions[i].Verdict, decisions[i].Reason = DeniedBudget, why\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tinBatch[k] = true\n\t\titems = append(items, item{c, i})\n\t}\n\tfor _, c := range p.foreignLocked(loop, now, inBatch, triageHeld) {\n\t\titems = append(items, item{c, -1})\n\t}\n\tsort.Slice(items, func(a, b int) bool { return less(items[a].cand, items[b].cand) })\n\n\treserved := 0\n\ttriageGranted := map[int]bool{}\n\tvar denied []Candidate\n\tcapDenied := 0\n\tfor _, it := range items {\n\t\tif it.idx < 0 {\n\t\t\tif free > 0 {\n\t\t\t\tfree--\n\t\t\t\treserved++\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\td := &decisions[it.idx]\n\t\tc := it.cand\n\t\tswitch {\n\t\tcase c.Class == ClassTriage && (triageHeld[c.Number] || triageGranted[c.Number]):\n\t\t\td.Verdict, d.Reason = DeniedIssueBusy, fmt.Sprintf(\"a triage job on #%d is already held\", c.Number)\n\t\tcase free > 0:\n\t\t\tfree--\n\t\t\ts := &Slot{pool: p, cand: c, grantedAt: now}\n\t\t\tp.held[c.Key()] = s\n\t\t\tif c.Class == ClassTriage {\n\t\t\t\ttriageGranted[c.Number] = true\n\t\t\t}\n\t\t\tdelete(p.firstDenied, c.Key())\n\t\t\td.Verdict, d.Slot = Granted, s\n\t\t\tp.log.Debug(\"pool.grant\", \"loop\", loop, \"key\", c.Key(), \"class\", c.Class.String(), \"role\", c.Role, \"number\", c.Number)\n\t\tcase capDenied < reserved:\n\t\t\tcapDenied++\n\t\t\td.Verdict, d.Reason = DeniedOutranked, fmt.Sprintf(\"outranked by %d higher-ranked waiting job(s)\", reserved)\n\t\t\tdenied = append(denied, c)\n\t\tdefault:\n\t\t\tcapDenied++\n\t\t\td.Verdict, d.Reason = DeniedFull, \"no free slot\"\n\t\t\tdenied = append(denied, c)\n\t\t}\n\t}\n\tp.setDemandLocked(loop, now, ttl, denied)\n\tp.checkStarvationLocked(now)\n\n\tif p.log.Enabled(context.Background(), slog.LevelDebug) {\n\t\tcounts := map[string]int{}\n\t\tfor _, d := range decisions {\n\t\t\tcounts[d.Verdict.String()]++\n\t\t}\n\t\tp.log.Debug(\"pool.offer\", \"loop\", loop, \"verdicts\", fmt.Sprint(counts), \"free_before\", free0, \"free_after\", max(0, p.max-len(p.held)))\n\t}\n\treturn decisions\n}\npackage pool\n\nimport \"time\"\n\ntype Stats struct {\n\tMax, Held, Free int\n\tHeldBy          map[Class]int\n\tWaitingBy map[Class]int\n\tOldestWait map[Class]time.Duration\n}\n\nfunc (p *Pool) Stats() Stats {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\tnow := p.now()\n\tst := Stats{\n\t\tMax:        p.max,\n\t\tHeld:       len(p.held),\n\t\tFree:       max(0, p.max-len(p.held)),\n\t\tHeldBy:     map[Class]int{},\n\t\tWaitingBy:  map[Class]int{},\n\t\tOldestWait: map[Class]time.Duration{},\n\t}\n\tfor _, s := range p.held {\n\t\tst.HeldBy[s.cand.Class]++\n\t}\n\tfor c, n := range p.waitingLocked(now) {\n\t\tst.WaitingBy[c] = n.count\n\t\tst.OldestWait[c] = n.oldest\n\t}\n\treturn st\n}\npackage pool\n\nimport (\n\t\"sort\"\n\t\"time\"\n)\n\ntype loopDemand struct {\n\texpires time.Time\n\tcands   map[string]Candidate\n}\n\ntype waiting struct {\n\tcount  int\n\toldest time.Duration\n\tkey      string\n\tpriority int\n}\n\nfunc (p *Pool) purgeLocked(now time.Time) {\n\tfor loop, d := range p.demand {\n\t\tif !now.Before(d.expires) {\n\t\t\tfor k := range d.cands {\n\t\t\t\tdelete(p.firstDenied, k)\n\t\t\t}\n\t\t\tdelete(p.demand, loop)\n\t\t}\n\t}\n}\n\nfunc (p *Pool) foreignLocked(loop string, now time.Time, batch map[string]bool, triageHeld map[int]bool) []Candidate {\n\tvar out []Candidate\n\tfor l, d := range p.demand {\n\t\tif l == loop || !now.Before(d.expires) {\n\t\t\tcontinue\n\t\t}\n\t\tfor k, c := range d.cands {\n\t\t\tif p.held[k] != nil || batch[k] {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif c.Class == ClassTriage && triageHeld[c.Number] {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tout = append(out, c)\n\t\t}\n\t}\n\tbest := map[int]Candidate{}\n\tfor _, c := range out {\n\t\tif c.Class == ClassTriage {\n\t\t\tif b, ok := best[c.Number]; !ok || less(c, b) {\n\t\t\t\tbest[c.Number] = c\n\t\t\t}\n\t\t}\n\t}\n\tkept := out[:0]\n\tfor _, c := range out {\n\t\tif c.Class == ClassTriage && best[c.Number] != c {\n\t\t\tcontinue\n\t\t}\n\t\tkept = append(kept, c)\n\t}\n\treturn kept\n}\n\nfunc (p *Pool) setDemandLocked(loop string, now time.Time, ttl time.Duration, denied []Candidate) {\n\told := p.demand[loop]\n\tdelete(p.demand, loop)\n\td := &loopDemand{expires: now.Add(ttl), cands: map[string]Candidate{}}\n\tif ttl > 0 {\n\t\tfor _, c := range denied {\n\t\t\td.cands[c.Key()] = c\n\t\t}\n\t}\n\tif old != nil {\n\t\tfor k := range old.cands {\n\t\t\tif _, ok := d.cands[k]; !ok {\n\t\t\t\tdelete(p.firstDenied, k)\n\t\t\t}\n\t\t}\n\t}\n\tif len(d.cands) == 0 {\n\t\treturn\n\t}\n\tfor k := range d.cands {\n\t\tif _, ok := p.firstDenied[k]; !ok {\n\t\t\tp.firstDenied[k] = now\n\t\t}\n\t}\n\tp.demand[loop] = d\n}\n\nfunc (p *Pool) waitingLocked(now time.Time) map[Class]waiting {\n\tout := map[Class]waiting{}\n\tfor _, d := range p.demand {\n\t\tif !now.Before(d.expires) {\n\t\t\tcontinue\n\t\t}\n\t\tfor k, c := range d.cands {\n\t\t\tw := out[c.Class]\n\t\t\tw.count++\n\t\t\tif t, ok := p.firstDenied[k]; ok && now.Sub(t) > w.oldest {\n\t\t\t\tw.oldest = now.Sub(t)\n\t\t\t\tw.key, w.priority = k, c.Priority\n\t\t\t}\n\t\t\tout[c.Class] = w\n\t\t}\n\t}\n\treturn out\n}\n\nfunc (p *Pool) checkStarvationLocked(now time.Time) {\n\tw := p.waitingLocked(now)\n\tfor c := ClassReview; c <= ClassScanner; c++ {\n\t\tws, ok := w[c]\n\t\tif !ok {\n\t\t\tp.starved[c] = false\n\t\t\tcontinue\n\t\t}\n\t\tif ws.oldest < p.starveAfter {\n\t\t\tp.starved[c] = false\n\t\t\tcontinue\n\t\t}\n\t\tif !p.starved[c] {\n\t\t\tp.starved[c] = true\n\t\t\tp.log.Warn(\"pool.starved\", \"class\", c.String(), \"waiting\", ws.count, \"oldest_wait\", ws.oldest.String(), \"key\", ws.key, \"priority\", ws.priority)\n\t\t}\n\t}\n}\n\nfunc (p *Pool) DemandLoops(now time.Time) []string {\n\tp.mu.Lock()\n\tdefer p.mu.Unlock()\n\tvar out []string\n\tfor l, d := range p.demand {\n\t\tif !now.Before(d.expires) {\n\t\t\tcontinue\n\t\t}\n\t\tfor k, c := range d.cands {\n\t\t\tif c.Class != ClassScanner && p.held[k] == nil {\n\t\t\t\tout = append(out, l)\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t}\n\tsort.Strings(out)\n\treturn out\n}\npackage limits\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"sort\"\n\t\"time\"\n\n\t\"github.com/albertcbrown/ard/internal/agent\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\nconst readingsKey = \"limits.readings\"\n\nconst maxReadings = 16\n\ntype Reading struct {\n\tWindow      string    `json:\"window\"`\n\tUtilization float64   `json:\"utilization\"` // as the stream reports it\n\tStatus      string    `json:\"status\"`\n\tResetsAt    time.Time `json:\"resets_at\"`\n\tObservedAt  time.Time `json:\"observed_at\"`\n}\n\nfunc (b *Book) loadReadings(ctx context.Context) error {\n\tv, err := b.meta.Meta(ctx, readingsKey)\n\tswitch {\n\tcase errors.Is(err, state.ErrNotFound):\n\t\treturn nil\n\tcase err != nil:\n\t\treturn fmt.Errorf(\"open limits readings: %w\", err)\n\t}\n\tvar got map[string]Reading\n\tif err := json.Unmarshal([]byte(v), &got); err != nil {\n\t\tb.log.Warn(\"limits.corrupt\", \"key\", readingsKey, \"error\", err)\n\t\treturn nil\n\t}\n\tif got != nil {\n\t\tb.readings = got\n\t}\n\treturn nil\n}\n\nfunc (b *Book) Observe(ctx context.Context, ws []agent.Window) error {\n\tif len(ws) == 0 {\n\t\treturn nil\n\t}\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tnow := b.now().UTC()\n\tnext := make(map[string]Reading, len(b.readings)+len(ws))\n\tfor k, r := range b.readings {\n\t\tnext[k] = r\n\t}\n\tvar changed []Reading\n\tfor _, w := range ws {\n\t\tr := Reading{Window: w.Type, Utilization: w.Utilization, Status: w.Status, ResetsAt: w.ResetsAt.UTC(), ObservedAt: now}\n\t\told, ok := next[w.Type]\n\t\tif !ok && len(next) >= maxReadings {\n\t\t\tcontinue\n\t\t}\n\t\tif ok && old.Utilization == r.Utilization && old.Status == r.Status && old.ResetsAt.Equal(r.ResetsAt) {\n\t\t\tcontinue\n\t\t}\n\t\tnext[w.Type] = r\n\t\tchanged = append(changed, r)\n\t}\n\tif len(changed) == 0 {\n\t\treturn nil\n\t}\n\traw, err := json.Marshal(next)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"encode limits readings: %w\", err)\n\t}\n\tif err := b.meta.SetMeta(ctx, readingsKey, string(raw)); err != nil {\n\t\treturn fmt.Errorf(\"persist limits readings: %w\", err)\n\t}\n\tb.readings = next\n\tfor _, r := range changed {\n\t\tb.log.Info(\"limits.reading\", \"window\", r.Window, \"utilization\", r.Utilization, \"status\", r.Status, \"resets_at\", r.ResetsAt)\n\t}\n\treturn nil\n}\n\nfunc (b *Book) Readings() []Reading {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tout := make([]Reading, 0, len(b.readings))\n\tfor _, r := range b.readings {\n\t\tout = append(out, r)\n\t}\n\tsort.Slice(out, func(i, j int) bool { return out[i].Window < out[j].Window })\n\treturn out\n}\npackage controller\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/github\"\n\t\"github.com/albertcbrown/ard/internal/labels\"\n\t\"github.com/albertcbrown/ard/internal/state\"\n)\n\nconst (\n\tStatusTitle  = \"ard status\"\n\tStatusMarker = \"<!-- ard:status -->\"\n)\n\nconst StatusIssueKey = \"status_issue\"\n\ntype StatusReader interface {\n\tGetIssue(ctx context.Context, n int) (github.Issue, error)\n\tSearchIssues(ctx context.Context, q string, o github.SearchOpts) ([]github.Issue, error)\n}\n\ntype StatusCache interface {\n\tMeta(ctx context.Context, key string) (string, error)\n\tSetMeta(ctx context.Context, key, value string) error\n}\n\nvar _ StatusCache = (*state.Store)(nil)\n\ntype StatusEffects interface {\n\tCreateIssue(ctx context.Context, in github.NewIssue) (github.Issue, error)\n\tPinIssue(ctx context.Context, n int) error\n}\n\nconst statusBody = StatusMarker + \"\\n\\nManaged by ard. Add the `\" + labels.Pause +\n\t\"` label to stop new claims; remove it to resume.\\n\"\n\nfunc ownStatusIssue(is github.Issue, author string) bool {\n\treturn !is.IsPR && is.State == github.StateOpen && is.Title == StatusTitle &&\n\t\tstrings.EqualFold(is.Author, author) && strings.Contains(is.Body, StatusMarker)\n}\n\nfunc EnsureStatusIssue(ctx context.Context, gh StatusReader, fx StatusEffects, cache StatusCache, author string, log *slog.Logger) (int, error) {\n\tif log == nil {\n\t\tlog = slog.Default()\n\t}\n\tprev := 0\n\tif cache != nil {\n\t\tprev = cachedStatusNumber(ctx, cache, log)\n\t}\n\tif prev > 0 {\n\t\tn, ok := adoptCached(ctx, gh, prev, author, log)\n\t\tif ok {\n\t\t\treturn n, nil\n\t\t}\n\t}\n\tq := fmt.Sprintf(`is:issue is:open in:title \"%s\"`, StatusTitle)\n\tfound, err := gh.SearchIssues(ctx, q, github.SearchOpts{Sort: \"created\", Order: \"asc\"})\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"find status issue: %w\", err)\n\t}\n\tvar nums []int\n\tfor _, is := range found {\n\t\tif ownStatusIssue(is, author) {\n\t\t\tnums = append(nums, is.Number)\n\t\t}\n\t}\n\tsort.Ints(nums)\n\tswitch {\n\tcase len(nums) == 1:\n\t\tremember(ctx, cache, nums[0], prev, log)\n\t\treturn nums[0], nil\n\tcase len(nums) > 1:\n\t\tlog.Warn(\"status.duplicate\", \"using\", nums[0], \"all\", nums)\n\t\tremember(ctx, cache, nums[0], prev, log)\n\t\treturn nums[0], nil\n\t}\n\tis, err := fx.CreateIssue(ctx, github.NewIssue{Title: StatusTitle, Body: statusBody})\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"create status issue: %w\", err)\n\t}\n\tremember(ctx, cache, is.Number, prev, log)\n\tif err := fx.PinIssue(ctx, is.Number); err != nil {\n\t\tlog.Warn(\"status.pin_failed\", \"issue\", is.Number, \"error\", err,\n\t\t\t\"hint\", \"pin the status issue man