ts are cancelled and Run returns an error\n// naming what was abandoned.\nfunc (c *Controller) Run(ctx context.Context) error {\n\treturn nil\n}\n\n// Until returns the time a role on family may next start, or zero when it may\n// start now. It is the later of the whole-account entry and the family's own.\n// An unknown family (\"\", for example a role on the CLI default model) is\n// blocked by any entry, so it fails closed. Blocked means now is before the\n// returned time; at that time the role is free.\nfunc (b *Book) Until(family string) time.Time {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tnow := b.now()\n\tvar latest time.Time\n\tfor k, e := range b.entries {\n\t\tif family != \"\" && k != \"\" && k != family {\n\t\t\tcontinue\n\t\t}\n\t\tif t := time.Unix(e.Until, 0); now.Before(t) && t.After(latest) {\n\t\t\tlatest = t\n\t\t}\n\t}\n\tif latest.IsZero() {\n\t\treturn latest\n\t}\n\treturn latest.UTC()\n}\n\n// FamilyOf maps a model name to its limit family: \"opus\", \"sonnet\" or\n// \"haiku\" by case-insensitive substring, otherwise \"\".\nfunc FamilyOf(model string) string {\n\tm := strings.ToLower(model)\n\tfor _, f := range []string{\"opus\", \"sonnet\", \"haiku\"} {\n\t\tif strings.Contains(m, f) {\n\t\t\treturn f\n\t\t}\n\t}\n\treturn \"\"\n}\npackage cli\n\nimport (\n\t\"fmt\"\n\t\"io\"\n\t\"log/slog\"\n\t\"strings\"\n)\n\n// NewLogger returns a slog text handler writing to w at the named level.\n// An empty level means info; anything else is a usage error.\nfunc NewLogger(level string, w io.Writer) (*slog.Logger, error) {\n\tvar lv slog.Level\n\tswitch strings.ToLower(strings.TrimSpace(level)) {\n\tcase \"debug\":\n\t\tlv = slog.LevelDebug\n\tcase \"\", \"info\":\n\t\tlv = slog.LevelInfo\n\tcase \"warn\":\n\t\tlv = slog.LevelWarn\n\tcase \"error\":\n\t\tlv = slog.LevelError\n\tdefault:\n\t\treturn nil, fmt.Errorf(\"unknown log level %q (want debug, info, warn or error)\", level)\n\t}\n\treturn slog.New(slog.NewTextHandler(w, &slog.HandlerOptions{Level: lv})), nil\n}\ninternal/cli/log.go:10:// NewLogger returns a slog text handler writing to w at the named level.\ninternal/cli/log.go:12:func NewLogger(level string, w io.Writer) (*slog.Logger, error) {\ninternal/cli/root.go:63:\tlog, err := NewLogger(a.Globals.LogLevel, cmd.ErrOrStderr())\ninternal/jobpost/post.go:84:\t\tErrorLog:          slog.NewLogLogger(slog.DiscardHandler, slog.LevelError),","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_015rinYjwFY6Jgm1gsr5RaWk","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
