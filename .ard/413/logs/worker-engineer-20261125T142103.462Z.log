{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01De6Y8JrmPubdKsJ6jGMVxF","type":"tool_result","content":"\t\treturn nil, errors.New(\"controller: nil Config\")\n\tcase d.Pause == nil:\n\t\treturn nil, errors.New(\"controller: nil Pause\")\n\t}\n\tseen := map[string]bool{}\n\tfor _, l := range loops {\n\t\tn := l.Name()\n\t\tif n == \"\" {\n\t\t\treturn nil, errors.New(\"controller: loop with empty name\")\n\t\t}\n\t\tif seen[n] {\n\t\t\treturn nil, fmt.Errorf(\"controller: duplicate loop name %q\", n)\n\t\t}\n\t\tseen[n] = true\n\t}\n\treturn &Controller{deps: d, loops: loops, active: map[string]bool{}}, nil\n}\n\nfunc (c *Controller) rand() float64 {\n\tif c.deps.Rand != nil {\n\t\treturn c.deps.Rand()\n\t}\n\treturn rand.Float64()\n}\n\nfunc (c *Controller) setActive(name string, on bool) {\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\tif on {\n\t\tc.active[name] = true\n\t} else {\n\tconfigTimeout = 2 * time.Minute\n)\n\n// runner drives one Loop. Ticks of one loop never overlap and a slow tick\n// never queues a second one; different loops run concurrently.\ntype runner struct {\n\tc    *Controller\n\tloop Loop\n\tlog  *slog.Logger\n\n\tcfg       *config.Resolved // last good config; nil until one has loaded\n\tcfgBroken bool             // last reload failed\n\tpaused    PauseState       // last pause state, for transition logs\n\tclamped   bool\n\tn         int // tick counter\n\terrs      int // consecutive tick errors\n\twake      chan struct{}\n}\n\n// jitter maps r in [0,1) to a factor in [0.9, 1.1).\nfunc jitter(r float64) float64 { return 0.9 + 0.2*r }\n\n// interval returns the loop's interval clamped to MinInterval.\nfunc (r *runner) interval() time.Duration {\n\tif r.cfg == nil { // no config yet: retry at the floor\n\t\treturn MinInterval\n\t}\n\td := r.loop.Interval(r.cfg)\n\tif d < MinInterval {\n\t\tif !r.clamped {\n\t\t\tr.clamped = true\n\t\t\tr.log.Warn(\"loop.interval_clamped\", \"requested\", d.String(), \"using\", MinInterval.String())\n\t\t}\n\t\treturn MinInterval\n\t}\n\treturn d\n}\n\n// run is the loop goroutine. It returns when stopping is closed.\nfunc (r *runner) run(workCtx context.Context, stopping <-chan struct{}) {\n\twait := time.Duration(r.c.rand() * 0.1 * float64(r.interval()))\n\tfor {\n\t\tt := time.NewTimer(wait)\n\t\tselect {\n\t\tcase <-stopping:\n\t\t\tt.Stop()\n\t\t\treturn\n\t\tcase <-t.C:\n\t\tcase <-r.wake:\n\t\t\tt.Stop()\n\t\t}\n\t\tselect { // a tick must not start once shutdown has begun\n\t\tcase <-stopping:\n\t\t\treturn\n\t\tdefault:\n\t\t}\n\t\twait = r.tick(workCtx, stopping)\n\t}\n}\n\n// tick runs one poll and returns how long to wait before the next one.\nfunc (r *runner) tick(workCtx context.Context, stopping <-chan struct{}) time.Duration {\n\tr.n++\n\tlog := r.log.With(\"tick\", r.n)\n\tr.reload(workCtx, log)\n\n\tif r.cfg == nil { // never loaded: nothing can run, and claiming loops are paused\n\t\tif r.loop.Claims() {\n\t\t\tr.transition(log, PauseState{Paused: true, Reason: ReasonConfigInvalid})\n\t\t}\n\t\treturn r.nextWait(nil)\n\t}\n\n\tif r.loop.Claims() {\n\t\tst := r.c.deps.Pause.Check(workCtx, r.cfg)\n\t\tif r.cfgBroken {\n\t\t\tst = PauseState{Paused: true, Reason: ReasonConfigInvalid}\n\t\t}\n\t\tr.transition(log, st)\n\t\tif st.Paused {\n\t\t\treturn r.nextWait(nil)\n\t\t}\n\t}\n\n\tinterval := r.interval()\n\ttimeout := interval\n\tif tt, ok := r.loop.(TickTimeouter); ok {\n\t\tif d := tt.TickTimeout(r.cfg); d > 0 {\n\t\t\ttimeout = max(d, time.Second)\n\t\t}\n\t}\n\tctx, cancel := context.WithTimeout(workCtx, timeout)\n\tdefer cancel()\n\n\tr.c.setActive(r.loop.Name(), true)\n\tstart := time.Now()\n\terr := r.safeTick(ctx, Env{Log: log, Cfg: r.cfg, Inflight: r.c.inflight, Stopping: stopping})\n\tr.c.setActive(r.loop.Name(), false)\n\tlog.Debug(\"loop.tick\", \"duration\", time.Since(start).String())\n\n\tif err != nil {\n\t\tr.errs++\n\t\tlog.Error(\"loop.error\", \"error\", err, \"consecutive\", r.errs)\n\t} else {\n\t\tr.errs = 0\n\t}\n\treturn r.nextWait(err)\n}\n\n// reload refreshes the config snapshot, keeping the last good one on error.\nfunc (r *runner) reload(ctx context.Context, log *slog.Logger) {\n// safeTick turns a panic into an error carrying the stack.\nfunc (r *runner) safeTick(ctx context.Context, env Env) (err error) {\n\tdefer func() {\n\t\tif p := recover(); p != nil {\n\t\t\terr = fmt.Errorf(\"panic in %s tick: %v\\n%s\", r.loop.Name(), p, debug.Stack())\n\t\t}\n\t}()\n\treturn r.loop.Tick(ctx, env)\n}\n\n// nextWait is the interval with jitter, or the backed-off interval after\n// backoffAfter consecutive errors, or at least until a rate limit resets.\nfunc (r *runner) nextWait(err error) time.Duration {\n\tinterval := r.interval()\n\tbase := interval\n\tif r.errs >= backoffAfter {\n\t\tlimit := max(interval, backoffCap)\n\t\tbase = interval\n\t\tfor i := 0; i < r.errs-backoffAfter+1 && base < limit; i++ {\n\t\t\tbase = min(base*2, limit)\n\t\t}\n\t}\n\twait := time.Duration(float64(base) * jitter(r.c.rand()))\n\tvar rl *github.RateLimitError\n\tif errors.As(err, &rl) && !rl.ResetAt.IsZero() {\n\t\twait = max(wait, time.Until(rl.ResetAt))\n\t}\n\treturn wait\n}\n\n// Status is a job's lifecycle state.\ntype Status string\n\nconst (\n\tStatusRunning Status = \"running\"\n\tStatusDone    Status = \"done\"\n\tStatusFailed  Status = \"failed\"\n)\n\n// roleRE mirrors the role-name pattern of the config package (#11); keep in sync.\nvar roleRE = regexp.MustCompile(`^[a-z0-9][a-z0-9-]*$`)\n\nvar stages = map[string]bool{\"scanner\": true, \"triage\": true, \"worker\": true, \"review\": true}\n\n// Job is one claimed unit of work.\ntype Job struct {\n\tID            string\n\tStage, Role   string\n\tIssue, PR     int // Issue is 0 only for stage scanner; PR 0 means none\n\tStatus        Status\n\tAttempt       int\n\tHandle        json.RawMessage // opaque executor handle (#18)\n\tCloseoutPhase string\n\tCloseoutPlan  json.RawMessage\n\tFailReason    string\n\tKeepUntil     time.Time\n\tCleanedAt     time.Time\n\tCostUSD       *float64\n\tCreatedAt     time.Time\n\tUpdatedAt     time.Time\n\tEndedAt       time.Time\n\t// Branch is the branch close-out commits to (worker and review jobs).\n\tBranch string\n\t// RetryOf is the id of the failed job this job is the automatic retry of.\n\tRetryOf string\n\t// AutoRetry is true when this failed job handed off to one automatic retry.\n\tAutoRetry bool\n\t// KillReason is why the Reaper killed the job, set before the kill.\n\tKillReason string\n\t// LimitStop is true when this failed job stopped at a usage limit. It is\n\t// not a failure and uses up no retry: count failures by the \"failure\"\n\t// event, not the status.\n\tLimitStop bool\n\t// AfterLimit is the id of the usage-limited job this job re-runs.\n\tAfterLimit string\n}\n\n// NewJob describes a claim. Data goes on the claim event.\ntype NewJob struct {\n\tStage, Role string\n\tIssue, PR   int\n\tBranch      string // branch close-out commits to; \"\" for triage\n\tData        json.RawMessage\n}\n\nconst jobCols = `id, stage, role, issue, pr, status, attempt, handle, closeout_phase, closeout_plan,\ntype Tokens struct{ Input, Output, CacheWrite, CacheRead int64 }\n\n// StepUsage is what one agent run reported.\ntype StepUsage struct {\n\tModels  []string // validated model ids; nil when none\n\tTokens  *Tokens  // nil: not reported\n\tCostUSD *float64 // nil: not reported\n}\n\n// JobUsage is a job's usage summed over its steps.\ntype JobUsage struct {\n\tModels  []string // union, sorted\n\tTokens  *Tokens  // nil when no step reported tokens\n\tCostUSD *float64 // nil when no step reported a cost\n\tSteps   int\n}\n\nvar (\n\tstepRE  = regexp.MustCompile(`^[0-9A-Za-z]{1,64}$`)\n\tmodelRE = regexp.MustCompile(`^[A-Za-z0-9._:\\[\\]/-]{1,100}$`)\n)\n\nconst maxModels = 8\n\n// ValidModel reports whether s may be stored as a model id.\nfunc ValidModel(s string) bool { return modelRE.MatchString(s) }\n\t}\n\tsort.Strings(out.Models)\n\treturn out, nil\n}\n\n// IssueUsage sums the recorded steps of every non-scanner job of an issue, by\n// job id, in one query. A job with no steps is absent.\nfunc (s *Store) IssueUsage(ctx context.Context, issue int) (map[string]JobUsage, error) {\n\trows, err := s.db.QueryContext(ctx, `SELECT u.job_id, u.models, u.tokens_in, u.tokens_out, u.tokens_cache_write, u.tokens_cache_read, u.cost_usd\n\t\tFROM step_usage u JOIN jobs j ON j.id = u.job_id WHERE j.issue = ? AND j.stage != 'scanner' ORDER BY u.job_id, u.step`, issue)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"issue usage %d: %w\", issue, err)\n\t}\n\tdefer rows.Close()\n\tout := map[string]JobUsage{}\n\tseen := map[string]map[string]bool{}\n\tfor rows.Next() {\n\t\tvar id string\n\t\tvar r usageRow\n\t\tif err := rows.Scan(&id, &r.models, &r.ti, &r.to, &r.tw, &r.tr, &r.cost); err != nil {\n\t\t\treturn nil, fmt.Errorf(\"issue usage %d: %w\", issue, err)\n\t\t}\n\t\tif seen[id] == nil {\n\t\t\tseen[id] = map[string]bool{}\n\t\t}\n\t\tu := out[id]\n\t\tu.add(r, seen[id])\n\t\tout[id] = u\n\t}\n\tif err := rows.Err(); err != nil {\n\t\treturn nil, fmt.Errorf(\"issue usage %d: %w\", issue, err)\n\t}\n\tfor id, u := range out {\n\t\tsort.Strings(u.Models)\n\t\tout[id] = u\n\t}\n\treturn out, nil\n}\n\n// Spend is money spent over a period: USD sums the priced steps; Unpriced\n// counts steps that reported no cost (they add nothing to USD).\ntype Spend struct {\n\tUSD      float64\n\tUnpriced int\n}\n\n// RoleKey names a role in spend totals. The stage is part of the key because\n// a role name can be shared by a triage role and a worker role.\ntype RoleKey struct{ Stage, Role string }\n\n// SpendSince sums step usage recorded at or after dayStart, per (stage, role)\n// and for the whole repo.\nfunc (s *Store) SpendSince(ctx context.Context, dayStart time.Time) (map[RoleKey]Spend, Spend, error) {\n\treturn s.spendBetween(ctx, dayStart, time.Time{})\n}\n\n\n// RunningJobs returns all running jobs ordered by created_at, id.\nfunc (s *Store) RunningJobs(ctx context.Context) ([]Job, error) {\n\trows, err := s.db.QueryContext(ctx, `SELECT `+jobCols+` FROM jobs WHERE status = 'running' ORDER BY created_at, id`)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"list running jobs: %w\", err)\n\t}\n\tdefer rows.Close()\n\tvar out []Job\n\tfor rows.Next() {\n\t\tj, err := scanJob(rows)\n\t\tif err != nil {\n\t\t\treturn nil, fmt.Errorf(\"scan running job: %w\", err)\n\t\t}\n\t\tout = append(out, j)\n\t}\n\tif err := rows.Err(); err != nil {\n\t\treturn nil, fmt.Errorf(\"list running jobs: %w\", err)\n\t}\n\treturn out, nil\n}\n\nfunc (s *Store) update(ctx context.Context, op, id, set string, args ...any) error {\n\n// EndedSince returns the jobs that ended at or after since.\nfunc (s *Store) EndedSince(ctx context.Context, since time.Time) ([]Job, error) {\n\trows, err := s.db.QueryContext(ctx, `SELECT `+jobCols+` FROM jobs\n\t\tWHERE status != 'running' AND ended_at >= ? ORDER BY ended_at, id`, since.Unix())\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"list jobs ended since %s: %w\", since.UTC().Format(time.RFC3339), err)\n\t}\n\treturn collectJobs(rows, \"ended\")\n}\n\n// JobCounts counts ended jobs by outcome: Done is every ended job that is not\n// failed.","is_error":false}]},"parent_tool_use_id":null,"session_id":"57b1ced3-9a2b-47af-bdf0-bb815e19770b","uuid":"47ad1b2c-285e-47b9-aa7a-6d5978e12274","timestamp":"2026-11-25T14:21:12.522Z","tool_use_result":{"stdout":"\t\treturn nil, errors.New(\"controller: nil Config\")\n\tcase d.Pause == nil:\n\t\treturn nil, errors.New(\"controller: nil Pause\")\n\t}\n\tseen := map[string]bool{}\n\tfor _, l := range loops {\n\t\tn := l.Name()\n\t\tif n == \"\" {\n\t\t\treturn nil, errors.New(\"controller: loop with empty name\")\n\t\t}\n\t\tif seen[n] {\n\t\t\treturn nil, fmt.Errorf(\"controller: duplicate loop name %q\", n)\n\t\t}\n\t\tseen[n] = true\n\t}\n\treturn &Controller{deps: d, loops: loops, active: map[string]bool{}}, nil\n}\n