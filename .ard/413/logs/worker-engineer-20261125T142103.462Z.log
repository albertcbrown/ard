Reading{Window: w.Type, Utilization: w.Utilization, Status: w.Status, ResetsAt: w.ResetsAt.UTC(), ObservedAt: now}\n\t\told, ok := next[w.Type]\n\t\tif !ok && len(next) >= maxReadings {\n\t\t\tcontinue\n\t\t}\n\t\tif ok && old.Utilization == r.Utilization && old.Status == r.Status && old.ResetsAt.Equal(r.ResetsAt) {\n\t\t\tcontinue\n\t\t}\n\t\tnext[w.Type] = r\n\t\tchanged = append(changed, r)\n\t}\n\tif len(changed) == 0 {\n\t\treturn nil\n\t}\n\traw, err := json.Marshal(next)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"encode limits readings: %w\", err)\n\t}\n\tif err := b.meta.SetMeta(ctx, readingsKey, string(raw)); err != nil {\n\t\treturn fmt.Errorf(\"persist limits readings: %w\", err)\n\t}\n\tb.readings = next\n\tfor _, r := range changed {\n\t\tb.log.Info(\"limits.reading\", \"window\", r.Window, \"utilization\", r.Utilization, \"status\", r.Status, \"resets_at\", r.ResetsAt)\n\t}\n\treturn nil\n}\n\n// Readings returns a copy of the latest reading per window, sorted by window.\nfunc (b *Book) Readings() []Reading {\n\tb.mu.Lock()\n\tdefer b.mu.Unlock()\n\tout := make([]Reading, 0, len(b.readings))\n\tfor _, r := range b.readings {\n\t\tout = append(out, r)\n\t}\n\tsort.Slice(out, func(i, j int) bool { return out[i].Window < out[j].Window })\n\treturn out\n}\n63:func Open(ctx context.Context, m Meta, now func() time.Time, log *slog.Logger) (*Book, error) {\n90:func backoff(step int) time.Duration {\n108:func (b *Book) Exhaust(ctx context.Context, family string, resetsAt time.Time) (time.Time, error) {\n148:func (b *Book) Succeeded(ctx context.Context, family string) error {\n173:func (b *Book) pruned(now time.Time) map[string]entry {\n177:func pruneExpired(in map[string]entry, now time.Time) map[string]entry {\n187:func (b *Book) persist(ctx context.Context, m map[string]entry) error {\n203:func (b *Book) Until(family string) time.Time {\n224:func FamilyOf(model string) string {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool