\t+\t\tst.WaitingRoles[1].Count != 2 || st.WaitingRoles[1].Oldest != 10*time.Second || st.WaitingBy[ClassTriage] != 3 {\n364\t+\t\tt.Fatalf(\"WaitingRoles = %+v\", st.WaitingRoles)\n365\t+\t}\n366\t+}\n367\tdiff --git a/internal/pool/stats.go b/internal/pool/stats.go\n368\tindex e40d2ba..70b34cd 100644\n369\t--- a/internal/pool/stats.go\n370\t+++ b/internal/pool/stats.go\n371\t@@ -1,6 +1,9 @@\n372\t package pool\n373\t \n374\t-import \"time\"\n375\t+import (\n376\t+\t\"sort\"\n377\t+\t\"time\"\n378\t+)\n379\t \n380\t // Stats is a point-in-time snapshot; the maps are fresh copies.\n381\t type Stats struct {\n382\t@@ -10,6 +13,19 @@ type Stats struct {\n383\t \tWaitingBy map[Class]int\n384\t \t// OldestWait is now minus the earliest first-denied time in each class.\n385\t \tOldestWait map[Class]time.Duration\n386\t+\t// RefusedBy lists recent limited and budget refusals per class. These\n387\t+\t// candidates reserve no demand, so they are not in WaitingBy.\n388\t+\tRefusedBy map[Class][]Refusal\n389\t+\t// WaitingRoles breaks WaitingBy down by role, sorted by class then role.\n390\t+\tWaitingRoles []RoleWait\n391\t+}\n392\t+\n393\t+// RoleWait is the live slot demand of one role.\n394\t+type RoleWait struct {\n395\t+\tClass  Class\n396\t+\tRole   string\n397\t+\tCount  int\n398\t+\tOldest time.Duration\n399\t }\n400\t \n401\t // Stats returns a snapshot of the pool.\n402\t@@ -24,6 +40,11 @@ func (p *Pool) Stats() Stats {\n403\t \t\tHeldBy:     map[Class]int{},\n404\t \t\tWaitingBy:  map[Class]int{},\n405\t \t\tOldestWait: map[Class]time.Duration{},\n406\t+\t\tRefusedBy:  map[Class][]Refusal{},\n407\t+\t}\n408\t+\tst.WaitingRoles = p.waitingRolesLocked(now)\n409\t+\tfor c, rs := range p.refusalsLocked(now) {\n410\t+\t\tst.RefusedBy[c] = rs\n411\t \t}\n412\t \tfor _, s := range p.held {\n413\t \t\tst.HeldBy[s.cand.Class]++\n414\t@@ -34,3 +55,138 @@ func (p *Pool) Stats() Stats {\n415\t \t}\n416\t \treturn st\n417\t }\n418\t+\n419\t+// refusalTTL is how long a limited or budget refusal is reported after the\n420\t+// candidate was last refused. Loops offer every tick, so a live refusal is\n421\t+// refreshed well inside it.\n422\t+const refusalTTL = 2 * time.Minute\n423\t+\n424\t+// Refusal aggregates the live limited or budget refusals of one role. Such a\n425\t+// candidate takes no slot and reserves no demand; this is for display only\n426\t+// and never feeds a grant decision.\n427\t+type Refusal struct {\n428\t+\tRole   string\n429\t+\tReason Verdict // DeniedLimited or DeniedBudget\n430\t+\tCount  int     // distinct candidates refused\n431\t+\tSince  time.Time\n432\t+}\n433\t+\n434\t+type refusalKey struct {\n435\t+\tcand    string\n436\t+\tverdict Verdict\n437\t+}\n438\t+\n439\t+type refusal struct {\n440\t+\tclass        Class\n441\t+\trole         string\n442\t+\tfirst, taken time.Time\n443\t+}\n444\t+\n445\t+// noteRefusalLocked records that c was refused for v at now.\n446\t+func (p *Pool) noteRefusalLocked(c Candidate, v Verdict, now time.Time) {\n447\t+\tk := refusalKey{c.Key(), v}\n448\t+\tif r := p.refused[k]; r != nil {\n449\t+\t\tr.taken = now\n450\t+\t\treturn\n451\t+\t}\n452\t+\tp.refused[k] = &refusal{class: c.Class, role: c.Role, first: now, taken: now}\n453\t+}\n454\t+\n455\t+// refusalsLocked returns the live refusals per class, sorted by role then reason.\n456\t+func (p *Pool) refusalsLocked(now time.Time) map[Class][]Refusal {\n457\t+\ttype agg struct {\n458\t+\t\tclass Class\n459\t+\t\trole  string\n460\t+\t\tv     Verdict\n461\t+\t}\n462\t+\tgot := map[agg]*Refusal{}\n463\t+\tfor k, r := range p.refused {\n464\t+\t\tif now.Sub(r.taken) >= refusalTTL {\n465\t+\t\t\tcontinue\n466\t+\t\t}\n467\t+\t\ta := agg{r.class, r.role, k.verdict}\n468\t+\t\tg := got[a]\n469\t+\t\tif g == nil {\n470\t+\t\t\tg = &Refusal{Role: r.role, Reason: k.verdict, Since: r.first}\n471\t+\t\t\tgot[a] = g\n472\t+\t\t}\n473\t+\t\tg.Count++\n474\t+\t\tif r.first.Before(g.Since) {\n475\t+\t\t\tg.Since = r.first\n476\t+\t\t}\n477\t+\t}\n478\t+\tout := map[Class][]Refusal{}\n479\t+\tfor a, g := range got {\n480\t+\t\tout[a.class] = append(out[a.class], *g)\n481\t+\t}\n482\t+\tfor _, rs := range out {\n483\t+\t\tsort.Slice(rs, func(i, j int) bool {\n484\t+\t\t\tif rs[i].Role != rs[j].Role {\n485\t+\t\t\t\treturn rs[i].Role < rs[j].Role\n486\t+\t\t\t}\n487\t+\t\t\treturn rs[i].Reason < rs[j].Reason\n488\t+\t\t})\n489\t+\t}\n490\t+\treturn out\n491\t+}\n492\t+\n493\t+// HeldInfo describes one held slot.\n494\t+type HeldInfo struct {\n495\t+\tKey       string\n496\t+\tCandidate Candidate\n497\t+\tJobID     string\n498\t+\tGrantedAt time.Time\n499\t+\tAdopted   bool\n500\t+}\n501\t+\n502\t+// HeldSlots lists the held slots, sorted by grant time then key.\n503\t+func (p *Pool) HeldSlots() []HeldInfo {\n504\t+\tp.mu.Lock()\n505\t+\tdefer p.mu.Unlock()\n506\t+\tout := make([]HeldInfo, 0, len(p.held))\n507\t+\tfor k, s := range p.held {\n508\t+\t\tout = append(out, HeldInfo{Key: k, Candidate: s.cand, JobID: s.jobID, GrantedAt: s.grantedAt, Adopted: s.adopted})\n509\t+\t}\n510\t+\tsort.Slice(out, func(i, j int) bool {\n511\t+\t\tif !out[i].GrantedAt.Equal(out[j].GrantedAt) {\n512\t+\t\t\treturn out[i].GrantedAt.Before(out[j].GrantedAt)\n513\t+\t\t}\n514\t+\t\treturn out[i].Key < out[j].Key\n515\t+\t})\n516\t+\treturn out\n517\t+}\n518\t+\n519\t+func (p *Pool) waitingRolesLocked(now time.Time) []RoleWait {\n520\t+\ttype rk struct {\n521\t+\t\tc    Class\n522\t+\t\trole string\n523\t+\t}\n524\t+\tgot := map[rk]*RoleWait{}\n525\t+\tfor _, d := range p.demand {\n526\t+\t\tif !now.Before(d.expires) {\n527\t+\t\t\tcontinue\n528\t+\t\t}\n529\t+\t\tfor k, c := range d.cands {\n530\t+\t\t\tg := got[rk{c.Class, c.Role}]\n531\t+\t\t\tif g == nil {\n532\t+\t\t\t\tg = &RoleWait{Class: c.Class, Role: c.Role}\n533\t+\t\t\t\tgot[rk{c.Class, c.Role}] = g\n534\t+\t\t\t}\n535\t+\t\t\tg.Count++\n536\t+\t\t\tif t, ok := p.firstDenied[k]; ok {\n537\t+\t\t\t\tg.Oldest = max(g.Oldest, now.Sub(t))\n538\t+\t\t\t}\n539\t+\t\t}\n540\t+\t}\n541\t+\tout := make([]RoleWait, 0, len(got))\n542\t+\tfor _, g := range got {\n543\t+\t\tout = append(out, *g)\n544\t+\t}\n545\t+\tsort.Slice(out, func(i, j int) bool {\n546\t+\t\tif out[i].Class != out[j].Class {\n547\t+\t\t\treturn out[i].Class < out[j].Class\n548\t+\t\t}\n549\t+\t\treturn out[i].Role < out[j].Role\n550\t+\t})\n551\t+\treturn out\n552\t+}\n553\tdiff --git a/internal/servecmd/serve.go b/internal/servecmd/serve.go\n554\tindex c1cdf92..068c237 100644\n555\t--- a/internal/servecmd/serve.go\n556\t+++ b/internal/servecmd/serve.go\n557\t@@ -47,6 +47,7 @@ import (\n558\t \t\"github.com/albertcbrown/ard/internal/redact\"\n559\t \t\"github.com/albertcbrown/ard/internal/repopath\"\n560\t \t\"github.com/albertcbrown/ard/internal/scanner/stale\"\n561\t+\t\"github.com/albertcbrown/ard/internal/snapshot\"\n562\t \t\"github.com/albertcbrown/ard/internal/state\"\n563\t \t\"github.com/albertcbrown/ard/internal/state/scannerdb\"\n564\t )\n565\t@@ -184,7 +185,10 @@ func serveLoops(ctx context.Context, e *cli.Env, build builder, wantLoops []stri\n566\t \t\tdefer d.Close()\n567\t \t}\n568\t \n569\t-\tlog := e.Log\n570\t+\t// The ring keeps the newest log records for the command center; the tee\n571\t+\t// passes every record to the existing handler unchanged.\n572\t+\tevents := snapshot.NewRing(snapshotEvents)\n573\t+\tlog := slog.New(snapshot.NewTee(e.Log.Handler(), events, nil))\n574\t \t// The controller's own bare clone: every config fetch, committer lane and\n575\t \t// executor worktree uses it, never the operator's checkout (#113).\n576\t \tclone, err := openClone(ctx, gitx.New(\"\"), home, repo, d.RemoteURL, d.Token, log)\n577\t@@ -355,6 +359,7 @@ func serveLoops(ctx context.Context, e *cli.Env, build builder, wantLoops []stri\n578\t \tif err != nil {\n579\t \t\treturn fmt.Errorf(\"ard serve: %w\", err)\n580\t \t}\n581\t+\tw.snap = w.newSnapshotTaker(cc, events)\n582\t \tstartSHA := \"\"\n583\t \tif cfg != nil {\n584\t \t\tstartSHA = cfg.SHA\n585\t@@ -420,6 +425,8 @@ type wiring struct {\n586\t \trp               *reaper.Reaper\n587\t \tlim              *limits.Book\n588\t \tbgt              *budget.Gate\n589\t+\t// snap takes snapshots for the command center (#413); nothing renders it yet.\n590\t+\tsnap *snapshot.Taker\n591\t \t// budgetNow is the budget gate's clock; nil means time.Now (tests set it).\n592\t \tbudgetNow func() time.Time\n593\t \n594\tdiff --git a/internal/servecmd/snapshot.go b/internal/servecmd/snapshot.go\n595\tnew file mode 100644\n596\tindex 0000000..81b74fb\n597\t--- /dev/null\n598\t+++ b/internal/servecmd/snapshot.go\n599\t@@ -0,0 +1,38 @@\n600\t+package servecmd\n601\t+\n602\t+import (\n603\t+\t\"github.com/albertcbrown/ard/internal/config\"\n604\t+\t\"github.com/albertcbrown/ard/internal/controller\"\n605\t+\t\"github.com/albertcbrown/ard/internal/snapshot\"\n606\t+)\n607\t+\n608\t+// snapshotEvents is how many recent log records the command center keeps.\n609\t+const snapshotEvents = 200\n610\t+\n611\t+// newSnapshotTaker builds the command center's Snapshot source. The pool and\n612\t+// the limits book exist only after the startup hooks, so they are looked up\n613\t+// at Take time; a Take before that sees them as absent. It makes no GitHub\n614\t+// call: the kill-switch state comes from the controller's last tick.\n615\t+func (w *wiring) newSnapshotTaker(c *controller.Controller, events *snapshot.Ring) *snapshot.Taker {\n616\t+\treturn snapshot.New(snapshot.Sources{\n617\t+\t\tPool: func() snapshot.PoolSource {\n618\t+\t\t\tif p := w.pool.Load(); p != nil {\n619\t+\t\t\t\treturn p\n620\t+\t\t\t}\n621\t+\t\t\treturn nil\n622\t+\t\t},\n623\t+\t\tLimits: func() snapshot.LimitSource {\n624\t+\t\t\tw.initMu.Lock()\n625\t+\t\t\tdefer w.initMu.Unlock()\n626\t+\t\t\tif w.lim != nil {\n627\t+\t\t\t\treturn w.lim\n628\t+\t\t\t}\n629\t+\t\t\treturn nil\n630\t+\t\t},\n631\t+\t\tState:   w.Store,\n632\t+\t\tControl: c,\n633\t+\t\tCaps:    w.budgetGate(),\n634\t+\t\tConfig:  func() *config.Resolved { return w.cfg.Load() },\n635\t+\t\tRing:    events,\n636\t+\t})\n637\t+}\n638\tdiff --git a/internal/snapshot/events.go b/internal/snapshot/events.go\n639\tnew file mode 100644\n640\tindex 0000000..883cdf6\n641\t--- /dev/null\n642\t+++ b/internal/snapshot/events.go\n643\t@@ -0,0 +1,133 @@\n644\t+package snapshot\n645\t+\n646\t+import (\n647\t+\t\"context\"\n648\t+\t\"log/slog\"\n649\t+\t\"strings\"\n650\t+\t\"sync\"\n651\t+\t\"time\"\n652\t+)\n653\t+\n654\t+// Event is one recent log record.\n655\t+type Event struct {\n656\t+\tTime  time.Time\n657\t+\tLevel slog.Level\n658\t+\tMsg   string\n659\t+\tAttrs string // flattened \"k=v k=v\", groups as \"g.k=v\"\n660\t+}\n661\t+\n662\t+// Ring is a fixed-size, concurrency-safe buffer of the newest events.\n663\t+type Ring struct {\n664\t+\tmu   sync.Mutex\n665\t+\tbuf  []Event\n666\t+\tnext int\n667\t+\tfull bool\n668\t+}\n669\t+\n670\t+// NewRing returns a ring holding the newest n events (n < 1 is treated as 1).\n671\t+func NewRing(n int) *Ring { return &Ring{buf: make([]Event, max(1, n))} }\n672\t+\n673\t+// Append adds e, dropping the oldest event when the ring is full.\n674\t+func (r *Ring) Append(e Event) {\n675\t+\tr.mu.Lock()\n676\t+\tdefer r.mu.Unlock()\n677\t+\tr.buf[r.next] = e\n678\t+\tr.next = (r.next + 1) % len(r.buf)\n679\t+\tif r.next == 0 {\n680\t+\t\tr.full = true\n681\t+\t}\n682\t+}\n683\t+\n684\t+// Events returns a copy of the buffered events, oldest first.\n685\t+func (r *Ring) Events() []Event {\n686\t+\tr.mu.Lock()\n687\t+\tdefer r.mu.Unlock()\n688\t+\tif !r.full {\n689\t+\t\treturn append([]Event(nil), r.buf[:r.next]...)\n690\t+\t}\n691\t+\tout := make([]Event, 0, len(r.buf))\n692\t+\tout = append(out, r.buf[r.next:]...)\n693\t+\treturn append(out, r.buf[:r.next]...)\n694\t+}\n695\t+\n696\t+type tee struct {\n697\t+\tnext   slog.Handler\n698\t+\tring   *Ring\n699\t+\tredact func(string) string\n700\t+\tattrs  string // pre-flattened WithAttrs, already prefixed by groups\n701\t+\tgroups []string\n702\t+}\n703\t+\n704\t+// NewTee returns a handler that passes every record to next unchanged and\n705\t+// also records it in ring. redact, when non-nil, is applied to the recorded\n706\t+// text only; next's output is never altered.\n707\t+func NewTee(next slog.Handler, ring *Ring, redact func(string) string) slog.Handler {\n708\t+\treturn &tee{next: next, ring: ring, redact: redact}\n709\t+}\n710\t+\n711\t+func (t *tee) Enabled(ctx context.Context, l slog.Level) bool { return t.next.Enabled(ctx, l) }\n712\t+\n713\t+func (t *tee) Handle(ctx context.Context, r slog.Record) error {\n714\t+\tvar b strings.Builder\n715\t+\tb.WriteString(t.attrs)\n716\t+\tprefix := strings.Join(t.groups, \".\")\n717\t+\tr.Attrs(func(a slog.Attr) bool {\n718\t+\t\tflatten(&b, prefix, a)\n719\t+\t\treturn true\n720\t+\t})\n721\t+\tmsg, attrs := r.Message, strings.TrimSpace(b.String())\n722\t+\tif t.redact != nil {\n723\t+\t\tmsg, attrs = t.redact(msg), t.redact(attrs)\n724\t+\t}\n725\t+\tt.ring.Append(Event{Time: r.Time, Level: r.Level, Msg: msg, Attrs: attrs})\n726\t+\treturn t.next.Handle(ctx, r)\n727\t+}\n728\t+\n729\t+func (t *tee) WithAttrs(as []slog.Attr) slog.Handler {\n730\t+\tvar b strings.Builder\n731\t+\tb.WriteString(t.attrs)\n732\t+\tprefix := strings.Join(t.groups, \".\")\n733\t+\tfor _, a := range as {\n734\t+\t\tflatten(&b, prefix, a)\n735\t+\t}\n736\t+\tc := *t\n737\t+\tc.next = t.next.WithAttrs(as)\n738\t+\tc.attrs = b.String()\n739\t+\treturn &c\n740\t+}\n741\t+\n742\t+func (t *tee) WithGroup(name string) slog.Handler {\n743\t+\tc := *t\n744\t+\tc.next = t.next.WithGroup(name)\n745\t+\tif name != \"\" {\n746\t+\t\tc.groups = append(append([]string(nil), t.groups...), name)\n747\t+\t}\n748\t+\treturn &c\n749\t+}\n750\t+\n751\t+func flatten(b *strings.Builder, prefix string, a slog.Attr) {\n752\t+\ta.Value = a.Value.Resolve()\n753\t+\tif a.Equal(slog.Attr{}) {\n754\t+\t\treturn\n755\t+\t}\n756\t+\tkey := a.Key\n757\t+\tif a.Value.Kind() == slog.KindGroup {\n758\t+\t\tif key != \"\" {\n759\t+\t\t\tif prefix != \"\" {\n760\t+\t\t\t\tprefix += \".\"\n761\t+\t\t\t}\n762\t+\t\t\tprefix += key\n763\t+\t\t}\n764\t+\t\tfor _, g := range a.Value.Group() {\n765\t+\t\t\tflatten(b, prefix, g)\n766\t+\t\t}\n767\t+\t\treturn\n768\t+\t}\n769\t+\tif prefix != \"\" {\n770\t+\t\tkey = prefix + \".\" + key\n771\t+\t}\n772\t+\tb.WriteString(key)\n773\t+\tb.WriteByte('=')\n774\t+\tb.WriteString(a.Value.String())\n775\t+\tb.WriteByte(' ')\n776\t+}\n777\tdiff --git a/internal/snapshot/events_test.go b/internal/snapshot/events_test.go\n778\tnew file mode 100644\n779\tindex 0000000..132afdc\n780\t--- /dev/null\n781\t+++ b/internal/snapshot/events_test.go\n782\t@@ -0,0 +1,93 @@\n783\t+package snapshot\n784\t+\n785\t+import (\n786\t+\t\"bytes\"\n787\t+\t\"fmt\"\n788\t+\t\"log/slog\"\n789\t+\t\"strings\"\n790\t+\t\"sync\"\n791\t+\t\"testing\"\n792\t+)\n793\t+\n794\t+func TestRingKeepsNewestInOrder(t *testing.T) {\n795\t+\tr := NewRing(3)\n796\t+\tif len(r.Events()) != 0 {\n797\t+\t\tt.Fatal(\"new ring not empty\")\n798\t+\t}\n799\t+\tfor i := 1; i <= 5; i++ {\n800\t+\t\tr.Append(Event{Msg: fmt.Sprint(i)})\n801\t+\t\tif i == 2 {\n802\t+\t\t\tif got := r.Events(); len(got) != 2 || got[0].Msg != \"1\" || got[1].Msg != \"2\" {\n803\t+\t\t\t\tt.Fatalf(\"partial = %+v\", got)\n804\t+\t\t\t}\n805\t+\t\t}\n806\t+\t}\n807\t+\tgot := r.Events()\n808\t+\tif len(got) != 3 || got[0].Msg != \"3\" || got[1].Msg != \"4\" || got[2].Msg != \"5\" {\n809\t+\t\tt.Fatalf(\"events = %+v\", got)\n810\t+\t}\n811\t+\tgot[0].Msg = \"x\" // a copy\n812\t+\tif r.Events()[0].Msg != \"3\" {\n813\t+\t\tt.Error(\"Events returned the internal buffer\")\n814\t+\t}\n815\t+}\n816\t+\n817\t+func TestRingConcurrentAppend(t *testing.T) {\n818\t+\tr := NewRing(8)\n819\t+\tvar wg sync.WaitGroup\n820\t+\tfor g := 0; g < 8; g++ {\n821\t+\t\twg.Add(1)\n822\t+\t\tgo func() {\n823\t+\t\t\tdefer wg.Done()\n824\t+\t\t\tfor i := 0; i < 200; i++ {\n825\t+\t\t\t\tr.Append(Event{Msg: \"m\"})\n826\t+\t\t\t\t_ = r.Events()\n827\t+\t\t\t}\n828\t+\t\t}()\n829\t+\t}\n830\t+\twg.Wait()\n831\t+\tif n := len(r.Events()); n != 8 {\n832\t+\t\tt.Errorf(\"len = %d, want 8\", n)\n833\t+\t}\n834\t+}\n835\t+\n836\t+func TestTeeForwardsByteIdentically(t *testing.T) {\n837\t+\tdrive := func(h slog.Handler) {\n838\t+\t\tl := slog.New(h).With(\"loop\", \"worker\").WithGroup(\"g\").With(\"a\", 1)\n839\t+\t\tl.Info(\"hello\", \"k\", \"v\", slog.Group(\"inner\", \"x\", 2))\n840\t+\t\tl.Warn(\"second\", \"err\", fmt.Errorf(\"boom\"))\n841\t+\t}\n842\t+\tvar plain, teed bytes.Buffer\n843\t+\topts := &slog.HandlerOptions{ReplaceAttr: func(_ []string, a slog.Attr) slog.Attr {\n844\t+\t\tif a.Key == slog.TimeKey {\n845\t+\t\t\treturn slog.Attr{}\n846\t+\t\t}\n847\t+\t\treturn a\n848\t+\t}}\n849\t+\tdrive(slog.NewTextHandler(&plain, opts))\n850\t+\tring := NewRing(10)\n851\t+\tdrive(NewTee(slog.NewTextHandler(&teed, opts), ring, nil))\n852\t+\tif plain.String() != teed.String() {\n853\t+\t\tt.Fatalf(\"output differs:\\n%s\\n---\\n%s\", plain.String(), teed.String())\n854\t+\t}\n855\t+\tev := ring.Events()\n856\t+\tif len(ev) != 2 || ev[0].Msg != \"hello\" || ev[0].Level != slog.LevelInfo {\n857\t+\t\tt.Fatalf(\"events = %+v\", ev)\n858\t+\t}\n859\t+\tif want := \"loop=worker g.a=1 g.k=v g.inner.x=2\"; ev[0].Attrs != want {\n860\t+\t\tt.Errorf(\"attrs = %q, want %q\", ev[0].Attrs, want)\n861\t+\t}\n862\t+}\n863\t+\n864\t+func TestTeeRedactsRecordedTextOnly(t *testing.T) {\n865\t+\tvar out bytes.Buffer\n866\t+\tring := NewRing(2)\n867\t+\tl := slog.New(NewTee(slog.NewTextHandler(&out, nil), ring, func(s string) string { return strings.ReplaceAll(s, \"secret\", \"[redacted]\") }))\n868\t+\tl.Info(\"secret\", \"k\", \"secret\")\n869\t+\tif e := ring.Events()[0]; e.Msg != \"[redacted]\" || e.Attrs != \"k=[redacted]\" {\n870\t+\t\tt.Errorf(\"event = %+v\", e)\n871\t+\t}\n872\t+\tif !bytes.Contains(out.Bytes(), []byte(\"msg=secret\")) {\n873\t+\t\tt.Errorf(\"downstream output was altered: %s\", out.String())\n874\t+\t}\n875\t+}\n876\tdiff --git a/internal/snapshot/snapshot.go b/internal/snapshot/snapshot.go\n877\tnew file mode 100644\n878\tindex 0000000..c1e199b\n879\t--- /dev/null\n880\t+++ b/internal/snapshot/snapshot.go\n881\t@@ -0,0 +1,471 @@\n882\t+// Package snapshot builds the in-process Snapshot behind the `ard serve`\n883\t+// command center (and a later `ard top`): pool, running jobs, kill switches,\n884\t+// usage limits, today's issues and spend, and recent log events.\n885\t+//\n886\t+// Taking a snapshot is cheap and local. It reads memory (pool, limits book,\n887\t+// controller) and the SQLite state only; it makes no GitHub call and the\n888\t+// package must not import internal/github (an import test enforces it).\n889\t+package snapshot\n890\t+\n891\t+import (\n892\t+\t\"context\"\n893\t+\t\"fmt\"\n894\t+\t\"math\"\n895\t+\t\"sort\"\n896\t+\t\"sync\"\n897\t+\t\"time\"\n898\t+\n899\t+\t\"github.com/albertcbrown/ard/internal/budget\"\n900\t+\t\"github.com/albertcbrown/ard/internal/config\"\n901\t+\t\"github.com/albertcbrown/ard/internal/controller\"\n902\t+\t\"github.com/albertcbrown/ard/internal/limits\"\n903\t+\t\"github.com/albertcbrown/ard/internal/pool\"\n904\t+\t\"github.com/albertcbrown/ard/internal/state\"\n905\t+)\n906\t+\n907\t+// Waiting reasons.\n908\t+const (\n909\t+\tReasonSlot    = \"slot\"    // ready, waiting for a free slot\n910\t+\tReasonLimited = \"limited\" // account or model family is out of quota\n911\t+\tReasonBudget  = \"budget\"  // a daily cap is reached\n912\t+)\n913\t+\n914\t+// Snapshot is a point-in-time view. Errors holds one line per source that\n915\t+// failed; the other fields are still filled.\n916\t+type Snapshot struct {\n917\t+\tTakenAt time.Time\n918\t+\tDayFrom time.Time // 00:00 UTC of TakenAt's day\n919\t+\tPool    PoolView\n920\t+\tRunning []RunningJob\n921\t+\tPause   []PauseView\n922\t+\tTicks   []TickView\n923\t+\tLimits  LimitsView\n924\t+\tIssues  []IssueView\n925\t+\tSpend   SpendView\n926\t+\tEvents  []Event\n927\t+\tErrors  []string\n928\t+}\n929\t+\n930\t+// PoolView is the slot pool.\n931\t+type PoolView struct {\n932\t+\tUsed, Max int\n933\t+\tWaiting   []Waiting\n934\t+}\n935\t+\n936\t+// Waiting is demand or refused candidates of one role with the reason.\n937\t+type Waiting struct {\n938\t+\tClass  string\n939\t+\tRole   string\n940\t+\tReason string // ReasonSlot, ReasonLimited or ReasonBudget\n941\t+\tCount  int\n942\t+\tOldest time.Duration // slot waits only\n943\t+}\n944\t+\n945\t+// RunningJob is one job holding a slot.\n946\t+type RunningJob struct {\n947\t+\tJobID   string\n948\t+\tIssue   int // 0 for a scanner run\n949\t+\tPR      int\n950\t+\tStage   string\n951\t+\tRole    string\n952\t+\tModel   string        // from the role config; \"\" is the agent's default\n953\t+\tElapsed time.Duration // since the job was created\n954\t+\tTimeout time.Duration // from the role config; 0 when unknown\n955\t+\t// FinishedCostUSD is the cost of finished steps only; nil when no finished\n956\t+\t// step reported a cost. The running step contributes nothing.\n957\t+\tFinishedCostUSD *float64\n958\t+}\n959\t+\n960\t+// PauseView is one active kill switch for one claiming loop.\n961\t+type PauseView struct {\n962\t+\tLoop   string\n963\t+\tReason controller.Reason\n964\t+\tErr    string\n965\t+}\n966\t+\n967\t+// TickView is the last tick of a loop.\n968\t+type TickView struct {\n969\t+\tLoop       string\n970\t+\tCount      int\n971\t+\tStart, End time.Time\n972\t+\tErr        string\n973\t+}\n974\t+\n975\t+// LimitsView holds the usage-limit readings and active blocks.\n976\t+type LimitsView struct {\n977\t+\tWindows []WindowView\n978\t+\tBlocks  []BlockView\n979\t+}\n980\t+\n981\t+// WindowView is the latest reading of one subscription window.\n982\t+type WindowView struct {\n983\t+\tWindow      string\n984\t+\tUtilization float64 // normalised to 0..1\n985\t+\tStatus      string\n986\t+\tResetsAt    time.Time\n987\t+\tAge         time.Duration // now minus when it was observed\n988\t+}\n989\t+\n990\t+// BlockView is an active exhaustion block for a model family (\"\" = unknown).\n991\t+type BlockView struct {\n992\t+\tFamily string\n993\t+\tUntil  time.Time\n994\t+}\n995\t+\n996\t+// IssueView is an issue with ard activity today.\n997\t+type IssueView struct {\n998\t+\tIssue   int\n999\t+\tState   string // \"<stage>:<role> running\" or \"<stage>:<role> done|failed\" of the latest job\n1000\t+\tJobs    int\n1001\t+\tCostUSD *float64 // total of all recorded steps; nil when none priced\n1002\t+}\n1003\t+\n1004\t+// SpendView is today's spend against the daily caps.\n1005\t+type SpendView struct {\n1006\t+\tRepoUSD   float64\n1007\t+\tRepoCap   float64 // 0 when no config\n1008\t+\tUnpriced  int\n1009\t+\tRoles     []RoleSpend\n1010\t+\tCappedNow []budget.Cap\n1011\t+}\n1012\t+\n1013\t+// RoleSpend is one role's spend today.\n1014\t+type RoleSpend struct {\n1015\t+\tStage, Role string\n1016\t+\tUSD         float64\n1017\t+}\n1018\t+\n1019\t+// PoolSource is the slot pool; *pool.Pool satisfies it.\n1020\t+type PoolSource interface {\n1021\t+\tStats() pool.Stats\n1022\t+\tHeldSlots() []pool.HeldInfo\n1023\t+}\n1024\t+\n1025\t+// LimitSource is the limits book; *limits.Book satisfies it.\n1026\t+type LimitSource interface {\n1027\t+\tReadings() []limits.Reading\n1028\t+\tUntil(family string) time.Time\n1029\t+}\n1030\t+\n1031\t+// StateSource is the state store; *state.Store satisfies it.\n1032\t+type StateSource interface {\n1033\t+\tRunningJobs(ctx context.Context) ([]state.Job, error)\n1034\t+\tEndedSince(ctx context.Context, since time.Time) ([]state.Job, error)\n1035\t+\tJobUsage(ctx context.Context, jobID string) (state.JobUsage, error)\n1036\t+\tIssueUsage(ctx context.Context, issue int) (map[string]state.JobUsage, error)\n1037\t+\tSpendSince(ctx context.Context, dayStart time.Time) (map[state.RoleKey]state.Spend, state.Spend, error)\n1038\t+}\n1039\t+\n1040\t+// ControlSource is the controller; *controller.Controller satisfies it.\n1041\t+type ControlSource interface {\n1042\t+\tPauseStates() map[string]controller.PauseState\n1043\t+\tTicks() []controller.TickInfo\n1044\t+}\n1045\t+\n1046\t+// CapSource lists the caps reached today; *budget.Gate satisfies it.\n1047\t+type CapSource interface {\n1048\t+\tCapped(ctx context.Context) ([]budget.Cap, time.Time, error)\n1049\t+}\n1050\t+\n1051\t+// Sources are what a Taker reads. Pool, Limits, Control and Caps may be nil\n1052\t+// (or return nil), for example before startup hooks have run; Config may\n1053\t+// return nil.\n1054\t+type Sources struct {\n1055\t+\tPool    func() PoolSource\n1056\t+\tLimits  func() LimitSource\n1057\t+\tState   StateSource\n1058\t+\tControl ControlSource\n1059\t+\tCaps    CapSource\n1060\t+\tConfig  func() *config.Resolved\n1061\t+\tRing    *Ring\n1062\t+\tNow     func() time.Time\n1063\t+}\n1064\t+\n1065\t+// Taker takes snapshots. It is safe for concurrent use.\n1066\t+type Taker struct {\n1067\t+\ts Sources\n1068\t+\n1069\t+\tmu    sync.Mutex\n1070\t+\tcache map[int]cachedUsage\n1071\t+}\n1072\t+\n1073\t+type cachedUsage struct {\n1074\t+\tkey   string\n1075\t+\ttotal *float64\n1076\t+}\n1077\t+\n1078\t+// New returns a Taker over s.\n1079\t+func New(s Sources) *Taker {\n1080\t+\tif s.Now == nil {\n1081\t+\t\ts.Now = time.Now\n1082\t+\t}\n1083\t+\treturn &Taker{s: s, cache: map[int]cachedUsage{}}\n1084\t+}\n1085\t+\n1086\t+// Invalidate drops the cached cost of issue (close-out may call it). The\n1087\t+// cache also invalidates itself when the issue's jobs change.\n1088\t+func (t *Taker) Invalidate(issue int) {\n1089\t+\tt.mu.Lock()\n1090\t+\tdelete(t.cache, issue)\n1091\t+\tt.mu.Unlock()\n1092\t+}\n1093\t+\n1094\t+// Take builds a snapshot. It makes no GitHub call.\n1095\t+func (t *Taker) Take(ctx context.Context) Snapshot {\n1096\t+\tnow := t.s.Now().UTC()\n1097\t+\tsnap := Snapshot{TakenAt: now, DayFrom: time.Date(now.Year(), now.Month(), now.Day(), 0, 0, 0, 0, time.UTC)}\n1098\t+\tcfg :