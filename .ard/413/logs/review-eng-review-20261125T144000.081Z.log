e([]RoleWait, 0, len(got))\n+\tfor _, g := range got {\n+\t\tout = append(out, *g)\n+\t}\n+\tsort.Slice(out, func(i, j int) bool {\n+\t\tif out[i].Class != out[j].Class {\n+\t\t\treturn out[i].Class < out[j].Class\n+\t\t}\n+\t\treturn out[i].Role < out[j].Role\n+\t})\n+\treturn out\n+}\ndiff --git a/internal/servecmd/serve.go b/internal/servecmd/serve.go\nindex c1cdf92..068c237 100644\n--- a/internal/servecmd/serve.go\n+++ b/internal/servecmd/serve.go\n@@ -47,6 +47,7 @@ import (\n \t\"github.com/albertcbrown/ard/internal/redact\"\n \t\"github.com/albertcbrown/ard/internal/repopath\"\n \t\"github.com/albertcbrown/ard/internal/scanner/stale\"\n+\t\"github.com/albertcbrown/ard/internal/snapshot\"\n \t\"github.com/albertcbrown/ard/internal/state\"\n \t\"github.com/albertcbrown/ard/internal/state/scannerdb\"\n )\n@@ -184,7 +185,10 @@ func serveLoops(ctx context.Context, e *cli.Env, build builder, wantLoops []stri\n \t\tdefer d.Close()\n \t}\n \n-\tlog := e.Log\n+\t// The ring keeps the newest log records for the command center; the tee\n+\t// passes every record to the existing handler unchanged.\n+\tevents := snapshot.NewRing(snapshotEvents)\n+\tlog := slog.New(snapshot.NewTee(e.Log.Handler(), events, nil))\n \t// The controller's own bare clone: every config fetch, committer lane and\n \t// executor worktree uses it, never the operator's checkout (#113).\n \tclone, err := openClone(ctx, gitx.New(\"\"), home, repo, d.RemoteURL, d.Token, log)\n@@ -355,6 +359,7 @@ func serveLoops(ctx context.Context, e *cli.Env, build builder, wantLoops []stri\n \tif err != nil {\n \t\treturn fmt.Errorf(\"ard serve: %w\", err)\n \t}\n+\tw.snap = w.newSnapshotTaker(cc, events)\n \tstartSHA := \"\"\n \tif cfg != nil {\n \t\tstartSHA = cfg.SHA\n@@ -420,6 +425,8 @@ type wiring struct {\n \trp               *reaper.Reaper\n \tlim              *limits.Book\n \tbgt              *budget.Gate\n+\t// snap takes snapshots for the command center (#413); nothing renders it yet.\n+\tsnap *snapshot.Taker\n \t// budgetNow is the budget gate's clock; nil means time.Now (tests set it).\n \tbudgetNow func() time.Time\n \ndiff --git a/internal/servecmd/snapshot.go b/internal/servecmd/snapshot.go\nnew file mode 100644\nindex 0000000..81b74fb\n--- /dev/null\n+++ b/internal/servecmd/snapshot.go\n@@ -0,0 +1,38 @@\n+package servecmd\n+\n+import (\n+\t\"github.com/albertcbrown/ard/internal/config\"\n+\t\"github.com/albertcbrown/ard/internal/controller\"\n+\t\"github.com/albertcbrown/ard/internal/snapshot\"\n+)\n+\n+// snapshotEvents is how many recent log records the command center keeps.\n+const snapshotEvents = 200\n+\n+// newSnapshotTaker builds the command center's Snapshot source. The pool and\n+// the limits book exist only after the startup hooks, so they are looked up\n+// at Take time; a Take before that sees them as absent. It makes no GitHub\n+// call: the kill-switch state comes from the controller's last tick.\n+func (w *wiring) newSnapshotTaker(c *controller.Controller, events *snapshot.Ring) *snapshot.Taker {\n+\treturn snapshot.New(snapshot.Sources{\n+\t\tPool: func() snapshot.PoolSource {\n+\t\t\tif p := w.pool.Load(); p != nil {\n+\t\t\t\treturn p\n+\t\t\t}\n+\t\t\treturn nil\n+\t\t},\n+\t\tLimits: func() snapshot.LimitSource {\n+\t\t\tw.initMu.Lock()\n+\t\t\tdefer w.initMu.Unlock()\n+\t\t\tif w.lim != nil {\n+\t\t\t\treturn w.lim\n+\t\t\t}\n+\t\t\treturn nil\n+\t\t},\n+\t\tState:   w.Store,\n+\t\tControl: c,\n+\t\tCaps:    w.budgetGate(),\n+\t\tConfig:  func() *config.Resolved { return w.cfg.Load() },\n+\t\tRing:    events,\n+\t})\n+}\ndiff --git a/internal/snapshot/events.go b/internal/snapshot/events.go\nnew file mode 100644\nindex 0000000..883cdf6\n--- /dev/null\n+++ b/internal/snapshot/events.go\n@@ -0,0 +1,133 @@\n+package snapshot\n+\n+import (\n+\t\"context\"\n+\t\"log/slog\"\n+\t\"strings\"\n+\t\"sync\"\n+\t\"time\"\n+)\n+\n+// Event is one recent log record.\n+type Event struct {\n+\tTime  time.Time\n+\tLevel slog.Level\n+\tMsg   string\n+\tAttrs string // flattened \"k=v k=v\", groups as \"g.k=v\"\n+}\n+\n+// Ring is a fixed-size, concurrency-safe buffer of the newest events.\n+type Ring struct {\n+\tmu   sync.Mutex\n+\tbuf  []Event\n+\tnext int\n+\tfull bool\n+}\n+\n+// NewRing returns a ring holding the newest n events (n < 1 is treated as 1).\n+func NewRing(n int) *Ring { return &Ring{buf: make([]Event, max(1, n))} }\n+\n+// Append adds e, dropping the oldest event when the ring is full.\n+func (r *Ring) Append(e Event) {\n+\tr.mu.Lock()\n+\tdefer r.mu.Unlock()\n+\tr.buf[r.next] = e\n+\tr.next = (r.next + 1) % len(r.buf)\n+\tif r.next == 0 {\n+\t\tr.full = true\n+\t}\n+}\n+\n+// Events returns a copy of the buffered events, oldest first.\n+func (r *Ring) Events() []Event {\n+\tr.mu.Lock()\n+\tdefer r.mu.Unlock()\n+\tif !r.full {\n+\t\treturn append([]Event(nil), r.buf[:r.next]...)\n+\t}\n+\tout := make([]Event, 0, len(r.buf))\n+\tout = append(out, r.buf[r.next:]...)\n+\treturn append(out, r.buf[:r.next]...)\n+}\n+\n+type tee struct {\n+\tnext   slog.Handler\n+\tring   *Ring\n+\tredact func(string) string\n+\tattrs  string // pre-flattened WithAttrs, already prefixed by groups\n+\tgroups []string\n+}\n+\n+// NewTee returns a handler that passes every record to next unchanged and\n+// also records it in ring. redact, when non-nil, is applied to the recorded\n+// text only; next's output is never altered.\n+func NewTee(next slog.Handler, ring *Ring, redact func(string) string) slog.Handler {\n+\treturn &tee{next: next, ring: ring, redact: redact}\n+}\n+\n+func (t *tee) Enabled(ctx context.Context, l slog.Level) bool { return t.next.Enabled(ctx, l) }\n+\n+func (t *tee) Handle(ctx context.Context, r slog.Record) error {\n+\tvar b strings.Builder\n+\tb.WriteString(t.attrs)\n+\tprefix := strings.Join(t.groups, \".\")\n+\tr.Attrs(func(a slog.Attr) bool {\n+\t\tflatten(&b, prefix, a)\n+\t\treturn true\n+\t})\n+\tmsg, attrs := r.Message, strings.TrimSpace(b.String())\n+\tif t.redact != nil {\n+\t\tmsg, attrs = t.redact(msg), t.redact(attrs)\n+\t}\n+\tt.ring.Append(Event{Time: r.Time, Level: r.Level, Msg: msg, Attrs: attrs})\n+\treturn t.next.Handle(ctx, r)\n+}\n+\n+func (t *tee) WithAttrs(as []slog.Attr) slog.Handler {\n+\tvar b strings.Builder\n+\tb.WriteString(t.attrs)\n+\tprefix := strings.Join(t.groups, \".\")\n+\tfor _, a := range as {\n+\t\tflatten(&b, prefix, a)\n+\t}\n+\tc := *t\n+\tc.next = t.next.WithAttrs(as)\n+\tc.attrs = b.String()\n+\treturn &c\n+}\n+\n+func (t *tee) WithGroup(name string) slog.Handler {\n+\tc := *t\n+\tc.next = t.next.WithGroup(name)\n+\tif name != \"\" {\n+\t\tc.groups = append(append([]string(nil), t.groups...), name)\n+\t}\n+\treturn &c\n+}\n+\n+func flatten(b *strings.Builder, prefix string, a slog.Attr) {\n+\ta.Value = a.Value.Resolve()\n+\tif a.Equal(slog.Attr{}) {\n+\t\treturn\n+\t}\n+\tkey := a.Key\n+\tif a.Value.Kind() == slog.KindGroup {\n+\t\tif key != \"\" {\n+\t\t\tif prefix != \"\" {\n+\t\t\t\tprefix += \".\"\n+\t\t\t}\n+\t\t\tprefix += key\n+\t\t}\n+\t\tfor _, g := range a.Value.Group() {\n+\t\t\tflatten(b, prefix, g)\n+\t\t}\n+\t\treturn\n+\t}\n+\tif prefix != \"\" {\n+\t\tkey = prefix + \".\" + key\n+\t}\n+\tb.WriteString(key)\n+\tb.WriteByte('=')\n+\tb.WriteString(a.Value.String())\n+\tb.WriteByte(' ')\n+}\ndiff --git a/internal/snapshot/events_test.go b/internal/snapshot/events_test.go\nnew file mode 100644\nindex 0000000..132afdc\n--- /dev/null\n+++ b/internal/snapshot/events_test.go\n@@ -0,0 +1,93 @@\n+package snapshot\n+\n+import (\n+\t\"bytes\"\n+\t\"fmt\"\n+\t\"log/slog\"\n+\t\"strings\"\n+\t\"sync\"\n+\t\"testing\"\n+)\n+\n+func TestRingKeepsNewestInOrder(t *testing.T) {\n+\tr := NewRing(3)\n+\tif len(r.Events()) != 0 {\n+\t\tt.Fatal(\"new ring not empty\")\n+\t}\n+\tfor i := 1; i <= 5; i++ {\n+\t\tr.Append(Event{Msg: fmt.Sprint(i)})\n+\t\tif i == 2 {\n+\t\t\tif got := r.Events(); len(got) != 2 || got[0].Msg != \"1\" || got[1].Msg != \"2\" {\n+\t\t\t\tt.Fatalf(\"partial = %+v\", got)\n+\t\t\t}\n+\t\t}\n+\t}\n+\tgot := r.Events()\n+\tif len(got) != 3 || got[0].Msg != \"3\" || got[1].Msg != \"4\" || got[2].Msg != \"5\" {\n+\t\tt.Fatalf(\"events = %+v\", got)\n+\t}\n+\tgot[0].Msg = \"x\" // a copy\n+\tif r.Events()[0].Msg != \"3\" {\n+\t\tt.Error(\"Events returned the internal buffer\")\n+\t}\n+}\n+\n+func TestRingConcurrentAppend(t *testing.T) {\n+\tr := NewRing(8)\n+\tvar wg sync.WaitGroup\n+\tfor g := 0; g < 8; g++ {\n+\t\twg.Add(1)\n+\t\tgo func() {\n+\t\t\tdefer wg.Done()\n+\t\t\tfor i := 0; i < 200; i++ {\n+\t\t\t\tr.Append(Event{Msg: \"m\"})\n+\t\t\t\t_ = r.Events()\n+\t\t\t}\n+\t\t}()\n+\t}\n+\twg.Wait()\n+\tif n := len(r.Events()); n != 8 {\n+\t\tt.Errorf(\"len = %d, want 8\", n)\n+\t}\n+}\n+\n+func TestTeeForwardsByteIdentically(t *testing.T) {\n+\tdrive := func(h slog.Handler) {\n+\t\tl := slog.New(h).With(\"loop\", \"worker\").WithGroup(\"g\").With(\"a\", 1)\n+\t\tl.Info(\"hello\", \"k\", \"v\", slog.Group(\"inner\", \"x\", 2))\n+\t\tl.Warn(\"second\", \"err\", fmt.Errorf(\"boom\"))\n+\t}\n+\tvar plain, teed bytes.Buffer\n+\topts := &slog.HandlerOptions{ReplaceAttr: func(_ []string, a slog.Attr) slog.Attr {\n+\t\tif a.Key == slog.TimeKey {\n+\t\t\treturn slog.Attr{}\n+\t\t}\n+\t\treturn a\n+\t}}\n+\tdrive(slog.NewTextHandler(&plain, opts))\n+\tring := NewRing(10)\n+\tdrive(NewTee(slog.NewTextHandler(&teed, opts), ring, nil))\n+\tif plain.String() != teed.String() {\n+\t\tt.Fatalf(\"output differs:\\n%s\\n---\\n%s\", plain.String(), teed.String())\n+\t}\n+\tev := ring.Events()\n+\tif len(ev) != 2 || ev[0].Msg != \"hello\" || ev[0].Level != slog.LevelInfo {\n+\t\tt.Fatalf(\"events = %+v\", ev)\n+\t}\n+\tif want := \"loop=worker g.a=1 g.k=v g.inner.x=2\"; ev[0].Attrs != want {\n+\t\tt.Errorf(\"attrs = %q, want %q\", ev[0].Attrs, want)\n+\t}\n+}\n+\n+func TestTeeRedactsRecordedTextOnly(t *testing.T) {\n+\tvar out bytes.Buffer\n+\tring := NewRing(2)\n+\tl := slog.New(NewTee(slog.NewTextHandler(&out, nil), ring, func(s string) string { return strings.ReplaceAll(s, \"secret\", \"[redacted]\") }))\n+\tl.Info(\"secret\", \"k\", \"secret\")\n+\tif e := ring.Events()[0]; e.Msg != \"[redacted]\" || e.Attrs != \"k=[redacted]\" {\n+\t\tt.Errorf(\"event = %+v\", e)\n+\t}\n+\tif !bytes.Contains(out.Bytes(), []byte(\"msg=secret\")) {\n+\t\tt.Errorf(\"downstream output was altered: %s\", out.String())\n+\t}\n+}\ndiff --git a/internal/snapshot/snapshot.go b/internal/snapshot/snapshot.go\nnew file mode 100644\nindex 0000000..c1e199b\n--- /dev/null\n+++ b/internal/snapshot/snapshot.go\n@@ -0,0 +1,471 @@\n+// Package snapshot builds the in-process Snapshot behind the `ard serve`\n+// command center (and a later `ard top`): pool, running jobs, kill switches,\n+// usage limits, today's issues and spend, and recent log events.\n+//\n+// Taking a snapshot is cheap and local. It reads memory (pool, limits book,\n+// controller) and the SQLite state only; it makes no GitHub call and the\n+// package must not import internal/github (an import test enforces it).\n+package snapshot\n+\n+import (\n+\t\"context\"\n+\t\"fmt\"\n+\t\"math\"\n+\t\"sort\"\n+\t\"sync\"\n+\t\"time\"\n+\n+\t\"github.com/albertcbrown/ard/internal/budget\"\n+\t\"github.com/albertcbrown/ard/internal/config\"\n+\t\"github.com/albertcbrown/ard/internal/controller\"\n+\t\"github.com/albertcbrown/ard/internal/limits\"\n+\t\"github.com/albertcbrown/ard/internal/pool\"\n+\t\"github.com/albertcbrown/ard/internal/state\"\n+)\n+\n+// Waiting reasons.\n+const (\n+\tReasonSlot    = \"slot\"    // ready, waiting for a free slot\n+\tReasonLimited = \"limited\" // account or model family is out of quota\n+\tReasonBudget  = \"budget\"  // a daily cap is reached\n+)\n+\n+// Snapshot is a point-in-time view. Errors holds one line per source that\n+// failed; the other fields are still filled.\n+type Snapshot struct {\n+\tTakenAt time.Time\n+\tDayFrom time.Time // 00:00 UTC of TakenAt's day\n+\tPool    PoolView\n+\tRunning []RunningJob\n+\tPause   []PauseView\n+\tTicks   []TickView\n+\tLimits  LimitsView\n+\tIssues  []IssueView\n+\tSpend   SpendView\n+\tEvents  []Event\n+\tErrors  []string\n+}\n+\n+// PoolView is the slot pool.\n+type PoolView struct {\n+\tUsed, Max int\n+\tWaiting   []Waiting\n+}\n+\n+// Waiting is demand or refused candidates of one role with the reason.\n+type Waiting struct {\n+\tClass  string\n+\tRole   string\n+\tReason string // ReasonSlot, ReasonLimited or ReasonBudget\n+\tCount  int\n+\tOldest time.Duration // slot waits only\n+}\n+\n+// RunningJob is one job holding a slot.\n+type RunningJob struct {\n+\tJobID   string\n+\tIssue   int // 0 for a scanner run\n+\tPR      int\n+\tStage   string\n+\tRole    string\n+\tModel   string        // from the role config; \"\" is the agent's default\n+\tElapsed time.Duration // since the job was created\n+\tTimeout time.Duration // from the role config; 0 when unknown\n+\t// FinishedCostUSD is the cost of finished steps only; nil when no finished\n+\t// step reported a cost. The running step contributes nothing.\n+\tFinishedCostUSD *float64\n+}\n+\n+// PauseView is one active kill switch for one claiming loop.\n+type PauseView struct {\n+\tLoop   string\n+\tReason controller.Reason\n+\tErr    string\n+}\n+\n+// TickView is the last tick of a loop.\n+type TickView struct {\n+\tLoop       string\n+\tCount      int\n+\tStart, End time.Time\n+\tErr        string\n+}\n+\n+// LimitsView holds the usage-limit readings and active blocks.\n+type LimitsView struct {\n+\tWindows []WindowView\n+\tBlocks  []BlockView\n+}\n+\n+// WindowView is the latest reading of one subscription window.\n+type WindowView struct {\n+\tWindow      string\n+\tUtilization float64 // normalised to 0..1\n+\tStatus      string\n+\tResetsAt    time.Time\n+\tAge         time.Duration // now minus when it was observed\n+}\n+\n+// BlockView is an active exhaustion block for a model family (\"\" = unknown).\n+type BlockView struct {\n+\tFamily string\n+\tUntil  time.Time\n+}\n+\n+// IssueView is an issue with ard activity today.\n+type IssueView struct {\n+\tIssue   int\n+\tState   string // \"<stage>:<role> running\" or \"<stage>:<role> done|failed\" of the latest job\n+\tJobs    int\n+\tCostUSD *float64 // total of all recorded steps; nil when none priced\n+}\n+\n+// SpendView is today's spend against the daily caps.\n+type SpendView struct {\n+\tRepoUSD   float64\n+\tRepoCap   float64 // 0 when no config\n+\tUnpriced  int\n+\tRoles     []RoleSpend\n+\tCappedNow []budget.Cap\n+}\n+\n+// RoleSpend is one role's spend today.\n+type RoleSpend struct {\n+\tStage, Role string\n+\tUSD         float64\n+}\n+\n+// PoolSource is the slot pool; *pool.Pool satisfies it.\n+type PoolSource interface {\n+\tStats() pool.Stats\n+\tHeldSlots() []pool.HeldInfo\n+}\n+\n+// LimitSource is the limits book; *limits.Book satisfies it.\n+type LimitSource interface {\n+\tReadings() []limits.Reading\n+\tUntil(family string) time.Time\n+}\n+\n+// StateSource is the state store; *state.Store satisfies it.\n+type StateSource interface {\n+\tRunningJobs(ctx context.Context) ([]state.Job, error)\n+\tEndedSince(ctx context.Context, since time.Time) ([]state.Job, error)\n+\tJobUsage(ctx context.Context, jobID string) (state.JobUsage, error)\n+\tIssueUsage(ctx context.Context, issue int) (map[string]state.JobUsage, error)\n+\tSpendSince(ctx context.Context, dayStart time.Time) (map[state.RoleKey]state.Spend, state.Spend, error)\n+}\n+\n+// ControlSource is the controller; *controller.Controller satisfies it.\n+type ControlSource interface {\n+\tPauseStates() map[string]controller.PauseState\n+\tTicks() []controller.TickInfo\n+}\n+\n+// CapSource lists the caps reached today; *budget.Gate satisfies it.\n+type CapSource interface {\n+\tCapped(ctx context.Context) ([]budget.Cap, time.Time, error)\n+}\n+\n+// Sources are what a Taker reads. Pool, Limits, Control and Caps may be nil\n+// (or return nil), for example before startup hooks have run; Config may\n+// return nil.\n+type Sources struct {\n+\tPool    func() PoolSource\n+\tLimits  func() LimitSource\n+\tState   StateSource\n+\tControl ControlSource\n+\tCaps    CapSource\n+\tConfig  func() *config.Resolved\n+\tRing    *Ring\n+\tNow     func() time.Time\n+}\n+\n+// Taker takes snapshots. It is safe for concurrent use.\n+type Taker struct {\n+\ts Sources\n+\n+\tmu    sync.Mutex\n+\tcache map[int]cachedUsage\n+}\n+\n+type cachedUsage struct {\n+\tkey   string\n+\ttotal *float64\n+}\n+\n+// New returns a Taker over s.\n+func New(s Sources) *Taker {\n+\tif s.Now == nil {\n+\t\ts.Now = time.Now\n+\t}\n+\treturn &Taker{s: s, cache: map[int]cachedUsage{}}\n+}\n+\n+// Invalidate drops the cached cost of issue (close-out may call it). The\n+// cache also invalidates itself when the issue's jobs change.\n+func (t *Taker) Invalidate(issue int) {\n+\tt.mu.Lock()\n+\tdelete(t.cache, issue)\n+\tt.mu.Unlock()\n+}\n+\n+// Take builds a snapshot. It makes no GitHub call.\n+func (t *Taker) Take(ctx context.Context) Snapshot {\n+\tnow := t.s.Now().UTC()\n+\tsnap := Snapshot{TakenAt: now, DayFrom: time.Date(now.Year(), now.Month(), now.Day(), 0, 0, 0, 0, time.UTC)}\n+\tcfg := (*config.Resolved)(nil)\n+\tif t.s.Config != nil {\n+\t\tcfg = t.s.Config()\n+\t}\n+\tfail := func(what string, err error) { snap.Errors = append(snap.Errors, fmt.Sprintf(\"%s: %v\", what, err)) }\n+\n+\tvar held []pool.HeldInfo\n+\tif t.s.Pool != nil {\n+\t\tif p := t.s.Pool(); p != nil {\n+\t\t\tsnap.Pool, held = poolView(p.Stats()), p.HeldSlots()\n+\t\t\tsnap.Pool.Used = len(held)\n+\t\t}\n+\t}\n+\tif t.s.Control != nil {\n+\t\tsnap.Pause = pauseViews(t.s.Control.PauseStates())\n+\t\tfor _, k := range t.s.Control.Ticks() {\n+\t\t\tsnap.Ticks = append(snap.Ticks, TickView{Loop: k.Loop, Count: k.Count, Start: k.Start, End: k.End, Err: k.Err})\n+\t\t}\n+\t}\n+\tif t.s.Limits != nil {\n+\t\tif l := t.s.Limits(); l != nil {\n+\t\t\tsnap.Limits = limitsView(l, now)\n+\t\t}\n+\t}\n+\tif t.s.Ring != nil {\n+\t\tsnap.Events = t.s.Ring.Events()\n+\t}\n+\tif t.s.State == nil {\n+\t\treturn snap\n+\t}\n+\n+\trunning, err := t.s.State.RunningJobs(ctx)\n+\tif err != nil {\n+\t\tfail(\"running jobs\", err)\n+\t}\n+\tsnap.Running = t.runningViews(ctx, running, held, cfg, now, fail)\n+\n+\tended, err := t.s.State.EndedSince(ctx, snap.DayFrom)\n+\tif err != nil {\n+\t\tfail(\"ended jobs\", err)\n+\t}\n+\tsnap.Issues = t.issueViews(ctx, running, ended, fail)\n+\n+\tper, repo, err := t.s.State.SpendSince(ctx, snap.DayFrom)\n+\tif err != nil {\n+\t\tfail(\"spend\", err)\n+\t} else {\n+\t\tsnap.Spend = spendView(per, repo, cfg)\n+\t}\n+\tif t.s.Caps != nil {\n+\t\tcaps, _, err := t.s.Caps.Capped(ctx)\n+\t\tif err != nil {\n+\t\t\tfail(\"caps\", err)\n+\t\t}\n+\t\tsnap.Spend.CappedNow = caps\n+\t}\n+\treturn snap\n+}\n+\n+func poolView(st pool.Stats) PoolView {\n+\tv := PoolView{Used: st.Held, Max: st.Max}\n+\tfor _, w := range st.WaitingRoles {\n+\t\tv.Waiting = append(v.Waiting, Waiting{Class: w.Class.String(), Role: w.Role, Reason: ReasonSlot, Count: w.Count, Oldest: w.Oldest})\n+\t}\n+\tfor c, rs := range st.RefusedBy {\n+\t\tfor _, r := range rs {\n+\t\t\treason := ReasonLimited\n+\t\t\tif r.Reason == pool.DeniedBudget {\n+\t\t\t\treason = ReasonBudget\n+\t\t\t}\n+\t\t\tv.Waiting = append(v.Waiting, Waiting{Class: c.String(), Role: r.Role, Reason: reason, Count: r.Count})\n+\t\t}\n+\t}\n+\tsort.Slice(v.Waiting, func(i, j int) bool {\n+\t\ta, b := v.Waiting[i], v.Waiting[j]\n+\t\tif a.Class != b.Class {\n+\t\t\treturn a.Class < b.Class\n+\t\t}\n+\t\tif a.Role != b.Role {\n+\t\t\treturn a.Role < b.Role\n+\t\t}\n+\t\treturn a.Reason < b.Reason\n+\t})\n+\treturn v\n+}\n+\n+func pauseViews(m map[string]controller.PauseState) []PauseView {\n+\tvar out []PauseView\n+\tfor loop, st := range m {\n+\t\tif !st.Paused {\n+\t\t\tcontinue\n+\t\t}\n+\t\tv := PauseView{Loop: loop, Reason: st.Reason}\n+\t\tif st.Err != nil {\n+\t\t\tv.Err = st.Err.Error()\n+\t\t}\n+\t\tout = append(out, v)\n+\t}\n+\tsort.Slice(out, func(i, j int) bool { return out[i].Loop < out[j].Loop })\n+\treturn out\n+}\n+\n+// NormalizeUtilization maps a reported utilization to 0..1. Streams report\n+// either a fraction or a percentage; values above 1 are read as percent.\n+func NormalizeUtilization(u float64) float64 {\n+\tif u > 1 {\n+\t\tu /= 100\n+\t}\n+\treturn math.Min(math.Max(u, 0), 1)\n+}\n+\n+func limitsView(l LimitSource, now time.Time) LimitsView {\n+\tvar v LimitsView\n+\tfor _, r := range l.Readings() {\n+\t\tv.Windows = append(v.Windows, WindowView{Window: r.Window, Utilization: NormalizeUtilization(r.Utilization),\n+\t\t\tStatus: r.Status, ResetsAt: r.ResetsAt, Age: max(0, now.Sub(r.ObservedAt))})\n+\t}\n+\t// Until(\"\") is blocked by every entry; named families only by their own\n+\t// and by unknown-family entries, so check each.\n+\tfor _, fam := range []string{\"opus\", \"sonnet\", \"haiku\", \"\"} {\n+\t\tif u := l.Until(fam); now.Before(u) {\n+\t\t\tv.Blocks = append(v.Blocks, BlockView{Family: fam, Until: u})\n+\t\t}\n+\t}\n+\treturn v\n+}\n+\n+func (t *Taker) runningViews(ctx context.Context, jobs []state.Job, held []pool.HeldInfo, cfg *config.Resolved, now time.Time, fail func(string, error)) []RunningJob {\n+\t_ = held // the state record is the source of truth; held slots only drive Pool.Used\n+\tvar out []RunningJob\n+\tfor _, j := range jobs {\n+\t\trj := RunningJob{JobID: j.ID, Issue: j.Issue, PR: j.PR, Stage: j.Stage, Role: j.Role, Elapsed: max(0, now.Sub(j.CreatedAt))}\n+\t\tif cfg != nil {\n+\t\t\tfor _, r := range cfg.Roles {\n+\t\t\t\tif r.Name == j.Role && stageMatches(r.Kind, j.Stage) {\n+\t\t\t\t\trj.Model, rj.Timeout = r.Model, r.Timeout\n+\t\t\t\t\tbreak\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\t\tu, err := t.s.State.JobUsage(ctx, j.ID)\n+\t\tif err != nil {\n+\t\t\tfail(\"job usage \"+j.ID, err)\n+\t\t} else {\n+\t\t\trj.FinishedCostUSD = u.CostUSD\n+\t\t}\n+\t\tout = append(out, rj)\n+\t}\n+\treturn out\n+}\n+\n+func stageMatches(k config.Kind, stage string) bool {\n+\tswitch k {\n+\tcase config.KindScanner:\n+\t\treturn stage == \"scanner\"\n+\tcase config.KindTriage:\n+\t\treturn stage == \"triage\"\n+\tcase config.KindWorker:\n+\t\treturn stage == \"worker\"\n+\tcase config.KindReviewer:\n+\t\treturn stage == \"review\"\n+\t}\n+\treturn false\n+}\n+\n+// issueViews lists issues with a running job or a job that ended today (UTC).\n+func (t *Taker) issueViews(ctx context.Context, running, ended []state.Job, fail func(string, error)) []IssueView {\n+\ttype agg struct {\n+\t\tjobs   int\n+\t\tlatest state.Job\n+\t\tkey    string\n+\t}","numLines":1269,"startLine":1,"totalLines":1752,"truncatedByTokenCap":true}},"tool_result_meta":[{"id":"toolu_01Nte2i6naj2Hje7L722GNZQ","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
