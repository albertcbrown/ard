{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011ChLEkMW9FEezXm1oj2xjV","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LcuJBqhxdYMGa4XaP87Y4Q","name":"Bash","input":{"command":"cd /work; mkdir -p internal/roles/scanners/missing-tests; cat > internal/roles/scanners/missing-tests/missingtests.go <<'EOF'\n//go:build ignore\n\n// missingtests reports Go functions that the module's tests never run or never\n// name. It is the helper of the missing-tests scanner: the scan driver (added\n// in a later change) builds it with an explicit `go build missingtests.go` and\n// runs it once per Go module. `go vet ./...` and `go build ./...` skip it\n// because of the build constraint above.\n//\n// It reads `go list -json ./...` output and, unless -no-coverage is set, a\n// `go test -coverprofile` profile, and prints one JSON finding per line in\n// the scanner schema, sorted by fingerprint. On any error it prints\n// \"missing-tests: <what>\" to stderr, exits 1 and writes nothing to stdout.\n// It uses the standard library only.\npackage main\n\nimport (\n\t\"bytes\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"flag\"\n\t\"fmt\"\n\t\"go/ast\"\n\t\"go/parser\"\n\t\"go/token\"\n\t\"io\"\n\t\"os\"\n\t\"path\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n)\n\nconst (\n\tmaxFindings    = 10000\n\tmaxFingerprint = 512\n\tmaxGroup       = 256\n\tmaxTitleRunes  = 200\n\tmaxBodyChars   = 1900\n)\n\n// listedPackage is the subset of `go list -json` that the helper reads.\ntype listedPackage struct {\n\tImportPath, Name, Dir              string\n\tGoFiles, TestGoFiles, XTestGoFiles []string\n}\n\ntype block struct {\n\tStartLine, StartCol, EndLine, EndCol, NumStmt int\n\tCovered                                       bool\n}\n\ntype funcInfo struct {\n\tPkg        *listedPackage\n\tFile       string // repo-relative slash path\n\tLine       int\n\tSymbol     string // \"F\" or \"T.M\"\n\tMethod     string // \"M\" for methods, \"\" for functions\n\tExported   bool\n\tStart, End token.Position\n\tHasStmts   bool\n}\n\n// finding's field order is the scanner schema order.\ntype finding struct {\n\tFingerprint string   `json:\"fingerprint\"`\n\tTitle       string   `json:\"title\"`\n\tSeverity    string   `json:\"severity\"`\n\tGroup       string   `json:\"group\"`\n\tFiles       []string `json:\"files\"`\n\tBody        string   `json:\"body\"`\n}\n\n// implicitMethods are called implicitly by the standard library, so a test\n// need not name them. They count as named whenever they are covered.\nvar implicitMethods = map[string]bool{\n\t\"Error\": true, \"Unwrap\": true, \"Is\": true, \"As\": true, \"String\": true,\n\t\"GoString\": true, \"Format\": true, \"MarshalJSON\": true, \"UnmarshalJSON\": true,\n\t\"MarshalText\": true, \"UnmarshalText\": true, \"MarshalYAML\": true,\n\t\"UnmarshalYAML\": true, \"MarshalBinary\": true, \"UnmarshalBinary\": true,\n\t\"LogValue\": true, \"ServeHTTP\": true,\n}\n\nfunc main() {\n\tout, err := run(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"missing-tests: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n\tos.Stdout.Write(out)\n}\n\nfunc run(args []string) ([]byte, error) {\n\tfs := flag.NewFlagSet(\"missingtests\", flag.ContinueOnError)\n\tfs.SetOutput(io.Discard)\n\tmodule := fs.String(\"module\", \"\", \"module path\")\n\tprefix := fs.String(\"prefix\", \"\", \"repo-relative module directory\")\n\tpkgsFile := fs.String(\"packages\", \"\", \"`go list -json ./...` output\")\n\tgoVer := fs.String(\"go\", \"\", \"Go version used for the measurement\")\n\tprofile := fs.String(\"profile\", \"\", \"coverage profile\")\n\tnoCov := fs.Bool(\"no-coverage\", false, \"static rule only\")\n\tignoreFile := fs.String(\"ignore\", \"\", \"optional ignore file\")\n\tmax := fs.Int(\"max\", maxFindings, \"maximum findings (hidden; for tests)\")\n\tif err := fs.Parse(args); err != nil {\n\t\treturn nil, err\n\t}\n\tfor name, v := range map[string]string{\"-module\": *module, \"-prefix\": *prefix, \"-packages\": *pkgsFile, \"-go\": *goVer} {\n\t\tif v == \"\" {\n\t\t\treturn nil, fmt.Errorf(\"%s is required\", name)\n\t\t}\n\t}\n\tif (*profile == \"\") == !*noCov {\n\t\treturn nil, errors.New(\"exactly one of -profile and -no-coverage is required\")\n\t}\n\tpkgs, err := readPackages(*pkgsFile)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tvar blocks map[string][]block\n\tif !*noCov {\n\t\tif blocks, err = readProfile(*profile); err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t}\n\tvar rules []ignoreRule\n\tif *ignoreFile != \"\" {\n\t\tif rules, err = readIgnore(*ignoreFile); err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t}\n\tfset := token.NewFileSet()\n\tfuncs, err := collectFuncs(pkgs, *module, *prefix, fset)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\trefs, err := collectTestRefs(pkgs, fset)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tused := make([]bool, len(rules))\n\tvar found []finding\n\tseen := map[string]bool{}\n\tfor _, f := range funcs {\n\t\tif ignored(rules, used, f) {\n\t\t\tcontinue\n\t\t}\n\t\tcovered, run, total := true, 0, 0\n\t\tif !*noCov {\n\t\t\tcovered, run, total = coverage(f, blocks[f.Pkg.ImportPath+\"/\"+path.Base(f.File)])\n\t\t}\n\t\tsev, kind, ok := decide(f, covered, refs.named(f), *noCov)\n\t\tif !ok {\n\t\t\tcontinue\n\t\t}\n\t\tfd := makeFinding(f, sev, kind, *module, *prefix, *goVer, *noCov, run, total, refs.named(f))\n\t\tif !seen[fd.Fingerprint] {\n\t\t\tseen[fd.Fingerprint] = true\n\t\t\tfound = append(found, fd)\n\t\t}\n\t}\n\tfor i, r := range rules {\n\t\tif !used[i] {\n\t\t\tfmt.Fprintf(os.Stderr, \"missing-tests: warning: ignore pattern %q matches nothing\\n\", r.raw)\n\t\t}\n\t}\n\tif len(found) > *max {\n\t\treturn nil, fmt.Errorf(\"too many findings (%d, limit %d): add an ignore file or no-coverage\", len(found), *max)\n\t}\n\tsort.Slice(found, func(i, j int) bool { return found[i].Fingerprint < found[j].Fingerprint })\n\tvar buf bytes.Buffer\n\tenc := json.NewEncoder(&buf)\n\tenc.SetEscapeHTML(false)\n\tfor _, f := range found {\n\t\tif err := enc.Encode(f); err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t}\n\treturn buf.Bytes(), nil\n}\n\nfunc readPackages(p string) ([]*listedPackage, error) {\n\tf, err := os.Open(p)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tdefer f.Close()\n\tdec := json.NewDecoder(f)\n\tvar out []*listedPackage\n\tfor {\n\t\tvar lp listedPackage\n\t\tif err := dec.Decode(&lp); err == io.EOF {\n\t\t\treturn out, nil\n\t\t} else if err != nil {\n\t\t\treturn nil, fmt.Errorf(\"reading packages: %v\", err)\n\t\t}\n\t\tout = append(out, &lp)\n\t}\n}\n\n// readProfile returns the blocks per \"importpath/file.go\". Duplicate blocks\n// (one per test binary under -coverpkg) are merged with OR.\nfunc readProfile(p string) (map[string][]block, error) {\n\tdata, err := os.ReadFile(p)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\ttype key struct{ file string; b block }\n\tmerged := map[key]bool{}\n\tvar order []key\n\tsawMode := false\n\tfor i, line := range strings.Split(string(data), \"\\n\") {\n\t\tline = strings.TrimSpace(line)\n\t\tif line == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tbad := func() error { return fmt.Errorf(\"malformed coverage profile line %d\", i+1) }\n\t\tif !sawMode {\n\t\t\tif !strings.HasPrefix(line, \"mode:\") {\n\t\t\t\treturn nil, bad()\n\t\t\t}\n\t\t\tsawMode = true\n\t\t\tcontinue\n\t\t}\n\t\tcolon := strings.LastIndex(line, \":\")\n\t\tfields := strings.Fields(line[max(colon, 0)+1:])\n\t\tif colon < 1 || len(fields) != 3 {\n\t\t\treturn nil, bad()\n\t\t}\n\t\tpos := strings.SplitN(fields[0], \",\", 2)\n\t\tif len(pos) != 2 {\n\t\t\treturn nil, bad()\n\t\t}\n\t\ts, e := strings.SplitN(pos[0], \".\", 2), strings.SplitN(pos[1], \".\", 2)\n\t\tif len(s) != 2 || len(e) != 2 {\n\t\t\treturn nil, bad()\n\t\t}\n\t\tvar n [6]int\n\t\tfor j, v := range []string{s[0], s[1], e[0], e[1], fields[1], fields[2]} {\n\t\t\tx, err := strconv.Atoi(v)\n\t\t\tif err != nil || x < 0 {\n\t\t\t\treturn nil, bad()\n\t\t\t}\n\t\t\tn[j] = x\n\t\t}\n\t\tk := key{line[:colon], block{n[0], n[1], n[2], n[3], n[4], false}}\n\t\tif _, ok := merged[k]; !ok {\n\t\t\torder = append(order, k)\n\t\t}\n\t\tmerged[k] = merged[k] || n[5] > 0\n\t}\n\tif !sawMode {\n\t\treturn nil, errors.New(\"malformed coverage profile: empty\")\n\t}\n\tout := map[string][]block{}\n\tfor _, k := range order {\n\t\tb := k.b\n\t\tb.Covered = merged[k]\n\t\tout[k.file] = append(out[k.file], b)\n\t}\n\treturn out, nil\n}\n\nfunc recvName(e ast.Expr) string {\n\tfor {\n\t\tswitch t := e.(type) {\n\t\tcase *ast.StarExpr:\n\t\t\te = t.X\n\t\tcase *ast.ParenExpr:\n\t\t\te = t.X\n\t\tcase *ast.IndexExpr:\n\t\t\te = t.X\n\t\tcase *ast.IndexListExpr:\n\t\t\te = t.X\n\t\tcase *ast.Ident:\n\t\t\treturn t.Name\n\t\tdefault:\n\t\t\treturn \"\"\n\t\t}\n\t}\n}\n\n// pkgDir is the repo-relative directory of a package.\nfunc pkgDir(p *listedPackage, module, prefix string) string {\n\trel := strings.TrimPrefix(strings.TrimPrefix(p.ImportPath, module), \"/\")\n\treturn path.Join(filepath.ToSlash(prefix), rel)\n}\n\nfunc collectFuncs(pkgs []*listedPackage, module, prefix string, fset *token.FileSet) ([]funcInfo, error) {\n\tvar out []funcInfo\n\tfor _, p := range pkgs {\n\t\tfor _, name := range p.GoFiles {\n\t\t\tfile, err := parser.ParseFile(fset, filepath.Join(p.Dir, name), nil, parser.ParseComments|parser.SkipObjectResolution)\n\t\t\tif err != nil {\n\t\t\t\treturn nil, fmt.Errorf(\"parsing %s: %v\", path.Join(pkgDir(p, module, prefix), name), err)\n\t\t\t}\n\t\t\tif ast.IsGenerated(file) {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tfor _, d := range file.Decls {\n\t\t\t\tfd, ok := d.(*ast.FuncDecl)\n\t\t\t\tif !ok || fd.Body == nil || len(fd.Body.List) == 0 {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tn := fd.Name.Name\n\t\t\t\tif n == \"main\" || n == \"init\" || n == \"_\" {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tfi := funcInfo{\n\t\t\t\t\tPkg: p, File: path.Join(pkgDir(p, module, prefix), name),\n\t\t\t\t\tLine: fset.Position(fd.Pos()).Line, Symbol: n, Exported: ast.IsExported(n),\n\t\t\t\t\tStart: fset.Position(fd.Pos()), End: fset.Position(fd.End()), HasStmts: true,\n\t\t\t\t}\n\t\t\t\tif fd.Recv != nil && len(fd.Recv.List) == 1 {\n\t\t\t\t\tr := recvName(fd.Recv.List[0].Type)\n\t\t\t\t\tfi.Symbol, fi.Method = r+\".\"+n, n\n\t\t\t\t\tfi.Exported = fi.Exported && ast.IsExported(r)\n\t\t\t\t}\n\t\t\t\tout = append(out, fi)\n\t\t\t}\n\t\t}\n\t}\n\treturn out, nil\n}\n\ntype testRefs struct {\n\tinternal  map[string]map[string]bool // import path -> idents in its TestGoFiles\n\tqualified map[string]map[string]bool // import path -> names used as X.Name\n\tselectors map[string]bool            // every Sel.Name in any test file\n}\n\nfunc collectTestRefs(pkgs []*listedPackage, fset *token.FileSet) (testRefs, error) {\n\tr := testRefs{map[string]map[string]bool{}, map[string]map[string]bool{}, map[string]bool{}}\n\tnames := map[string]string{} // import path -> package name\n\tfor _, p := range pkgs {\n\t\tnames[p.ImportPath] = p.Name\n\t}\n\tscan := func(p *listedPackage, name string, internal bool) error {\n\t\tfile, err := parser.ParseFile(fset, filepath.Join(p.Dir, name), nil, parser.SkipObjectResolution)\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"parsing %s: %v\", name, err)\n\t\t}\n\t\tlocal := map[string]string{} // import name -> import path\n\t\tfor _, im := range file.Imports {\n\t\t\tip, err := strconv.Unquote(im.Path.Value)\n\t\t\tif err != nil {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tn, ok := names[ip]\n\t\t\tif im.Name != nil {\n\t\t\t\tn, ok = im.Name.Name, true\n\t\t\t}\n\t\t\tif ok {\n\t\t\t\tlocal[n] = ip\n\t\t\t}\n\t\t}\n\t\tast.Inspect(file, func(n ast.Node) bool {\n\t\t\tswitch t := n.(type) {\n\t\t\tcase *ast.SelectorExpr:\n\t\t\t\tr.selectors[t.Sel.Name] = true\n\t\t\t\tif x, ok := t.X.(*ast.Ident); ok {\n\t\t\t\t\tif ip, ok := local[x.Name]; ok {\n\t\t\t\t\t\tif r.qualified[ip] == nil {\n\t\t\t\t\t\t\tr.qualified[ip] = map[string]bool{}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tr.qualified[ip][t.Sel.Name] = true\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\tcase *ast.Ident:\n\t\t\t\tif internal {\n\t\t\t\t\tif r.internal[p.ImportPath] == nil {\n\t\t\t\t\t\tr.internal[p.ImportPath] = map[string]bool{}\n\t\t\t\t\t}\n\t\t\t\t\tr.internal[p.ImportPath][t.Name] = true\n\t\t\t\t}\n\t\t\t}\n\t\t\treturn true\n\t\t})\n\t\treturn nil\n\t}\n\tfor _, p := range pkgs {\n\t\tfor _, n := range p.TestGoFiles {\n\t\t\tif err := scan(p, n, true); err != nil {\n\t\t\t\treturn r, err\n\t\t\t}\n\t\t}\n\t\tfor _, n := range p.XTestGoFiles {\n\t\t\tif err := scan(p, n, false); err != nil {\n\t\t\t\treturn r, err\n\t\t\t}\n\t\t}\n\t}\n\treturn r, nil\n}\n\nfunc (r testRefs) named(f funcInfo) bool {\n\tip := f.Pkg.ImportPath\n\tif f.Method != \"\" {\n\t\treturn r.selectors[f.Method] || r.internal[ip][f.Method]\n\t}\n\treturn r.internal[ip][f.Symbol] || r.qualified[ip][f.Symbol]\n}\n\nfunc before(l1, c1, l2, c2 int) bool { return l1 < l2 || (l1 == l2 && c1 < c2) }\n\n// coverage reports whether any block inside the function ran, and the\n// statements run and total in those blocks.\nfunc coverage(f funcInfo, blocks []block) (covered bool, run, total int) {\n\tfor _, b := range blocks {\n\t\tif before(b.StartLine, b.StartCol, f.Start.Line, f.Start.Column) || before(f.End.Line, f.End.Column, b.EndLine, b.EndCol) {\n\t\t\tcontinue\n\t\t}\n\t\ttotal += b.NumStmt\n\t\tif b.Covered {\n\t\t\tcovered = true\n\t\t\trun += b.NumStmt\n\t\t}\n\t}\n\treturn\n}\n\ntype ignoreRule struct {\n\traw     string\n\tpkg     string\n\ttree    bool\n\tsymGlob string\n}\n\nfunc readIgnore(p string) ([]ignoreRule, error) {\n\tdata, err := os.ReadFile(p)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tvar rules []ignoreRule\n\tfor i, line := range strings.Split(string(data), \"\\n\") {\n\t\tline = strings.TrimSpace(line)\n\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\n\t\t\tcontinue\n\t\t}\n\t\tr := ignoreRule{raw: line, pkg: line}\n\t\tif a, b, ok := strings.Cut(lin