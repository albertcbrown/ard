   |  11 +\n .../testdata/missing-tests/ignore/b/b_test.go      |   5 +\n .../roles/testdata/missing-tests/ignore/go.mod     |   3 +\n .../roles/testdata/missing-tests/ignore/ignore     |   6 +\n .../testdata/missing-tests/ignore/tree/x/x.go      |   3 +\n .../testdata/missing-tests/ignore/tree/y/y.go      |   3 +\n .../roles/testdata/missing-tests/ignore/want.jsonl |   1 +\n .../testdata/missing-tests/implicit_methods/go.mod |   3 +\n .../testdata/missing-tests/implicit_methods/m/m.go |  17 +\n .../missing-tests/implicit_methods/m/m_test.go     |  12 +\n .../missing-tests/implicit_methods/want.jsonl      |   3 +\n .../testdata/missing-tests/no_coverage/go.mod      |   3 +\n .../testdata/missing-tests/no_coverage/n/n.go      |  13 +\n .../testdata/missing-tests/no_coverage/n/n_test.go |   9 +\n .../testdata/missing-tests/no_coverage/no-coverage |   0\n .../testdata/missing-tests/no_coverage/want.jsonl  |   2 +\n .../testdata/missing-tests/no_test_files/go.mod    |   3 +\n .../testdata/missing-tests/no_test_files/n/n.go    |   5 +\n .../testdata/missing-tests/no_test_files/t/t.go    |   3 +\n .../missing-tests/no_test_files/t/t_test.go        |   9 +\n .../missing-tests/no_test_files/want.jsonl         |   2 +\n internal/roles/testdata/missing-tests/xtest/a/a.go |   7 +\n .../roles/testdata/missing-tests/xtest/a/a_test.go |  13 +\n internal/roles/testdata/missing-tests/xtest/b/b.go |   3 +\n .../roles/testdata/missing-tests/xtest/b/b_test.go |  13 +\n internal/roles/testdata/missing-tests/xtest/go.mod |   3 +\n .../roles/testdata/missing-tests/xtest/want.jsonl  |   1 +\n 43 files changed, 1105 insertions(+), 1 deletion(-)\n\ndiff --git a/internal/roles/missing_tests_test.go b/internal/roles/missing_tests_test.go\nnew file mode 100644\nindex 0000000..d44b09b\n--- /dev/null\n+++ b/internal/roles/missing_tests_test.go\n@@ -0,0 +1,305 @@\n+package roles\n+\n+import (\n+\t\"bytes\"\n+\t\"os\"\n+\t\"os/exec\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+\t\"unicode/utf8\"\n+\n+\t\"github.com/albertcbrown/ard/internal/scanner\"\n+)\n+\n+const mtFixtures = \"testdata/missing-tests\"\n+\n+// mtBuild builds the helper into a temp dir. It builds from the temp dir, so\n+// the repo's go.mod is not consulted.\n+func mtBuild(t *testing.T) string {\n+\tt.Helper()\n+\tneedTools(t, \"go\")\n+\tsrc, err := filepath.Abs(\"scanners/missing-tests/missingtests.go\")\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tbin := filepath.Join(t.TempDir(), \"missingtests\")\n+\tcmd := exec.Command(\"go\", \"build\", \"-o\", bin, src)\n+\tcmd.Dir = t.TempDir()\n+\tcmd.Env = append(goEnv(), \"CGO_ENABLED=0\")\n+\tif out, err := cmd.CombinedOutput(); err != nil {\n+\t\tt.Fatalf(\"go build: %v\\n%s\", err, out)\n+\t}\n+\treturn bin\n+}\n+\n+func mtGo(t *testing.T, dir string, args ...string) []byte {\n+\tt.Helper()\n+\tcmd := exec.Command(\"go\", args...)\n+\tcmd.Dir = dir\n+\tcmd.Env = goEnv()\n+\tvar so, se bytes.Buffer\n+\tcmd.Stdout, cmd.Stderr = &so, &se\n+\tif err := cmd.Run(); err != nil {\n+\t\tt.Fatalf(\"go %s: %v\\n%s\", strings.Join(args, \" \"), err, se.String())\n+\t}\n+\treturn so.Bytes()\n+}\n+\n+// mtMeasure runs go list and, unless noCover, go test with coverage in dir. It\n+// returns the helper's common arguments.\n+func mtMeasure(t *testing.T, dir string, noCover bool) []string {\n+\tt.Helper()\n+\taux := t.TempDir()\n+\tpkgs := filepath.Join(aux, \"pkgs.json\")\n+\tif err := os.WriteFile(pkgs, mtGo(t, dir, \"list\", \"-json\", \"./...\"), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\targs := []string{\"-module\", \"example.com/mt\", \"-prefix\", \".\", \"-packages\", pkgs, \"-go\", \"go1.test\"}\n+\tif noCover {\n+\t\treturn append(args, \"-no-coverage\")\n+\t}\n+\tprof := filepath.Join(aux, \"cover.out\")\n+\tmtGo(t, dir, \"test\", \"-count=1\", \"-covermode=set\", \"-coverpkg=./...\", \"-coverprofile=\"+prof, \"./...\")\n+\treturn append(args, \"-profile\", prof)\n+}\n+\n+func mtRun(t *testing.T, bin string, args ...string) (stdout, stderr string, code int) {\n+\tt.Helper()\n+\tcmd := exec.Command(bin, args...)\n+\tcmd.Env = goEnv()\n+\tvar so, se bytes.Buffer\n+\tcmd.Stdout, cmd.Stderr = &so, &se\n+\tif err := cmd.Run(); err != nil {\n+\t\tee, ok := err.(*exec.ExitError)\n+\t\tif !ok {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tcode = ee.ExitCode()\n+\t}\n+\treturn so.String(), se.String(), code\n+}\n+\n+// mtModule writes files (and a go.mod) to a new temp module.\n+func mtModule(t *testing.T, files map[string]string) string {\n+\tt.Helper()\n+\tdir := t.TempDir()\n+\tfiles[\"go.mod\"] = \"module example.com/mt\\n\\ngo 1.22\\n\"\n+\tfor name, content := range files {\n+\t\tp := filepath.Join(dir, name)\n+\t\tif err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tif err := os.WriteFile(p, []byte(content), 0o644); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\treturn dir\n+}\n+\n+func mtCases(t *testing.T) []string {\n+\tt.Helper()\n+\tents, err := os.ReadDir(mtFixtures)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tvar out []string\n+\tfor _, e := range ents {\n+\t\tif e.IsDir() {\n+\t\t\tout = append(out, e.Name())\n+\t\t}\n+\t}\n+\tif len(out) != 7 {\n+\t\tt.Fatalf(\"fixture cases: %v\", out)\n+\t}\n+\treturn out\n+}\n+\n+func TestMissingTestsHelper(t *testing.T) {\n+\tbin := mtBuild(t)\n+\tfor _, name := range mtCases(t) {\n+\t\tt.Run(name, func(t *testing.T) {\n+\t\t\tdir := t.TempDir()\n+\t\t\tcopyTree(t, filepath.Join(mtFixtures, name), dir)\n+\t\t\t_, err := os.Stat(filepath.Join(dir, \"no-coverage\"))\n+\t\t\targs := mtMeasure(t, dir, err == nil)\n+\t\t\tif _, err := os.Stat(filepath.Join(dir, \"ignore\")); err == nil {\n+\t\t\t\targs = append(args, \"-ignore\", filepath.Join(dir, \"ignore\"))\n+\t\t\t}\n+\t\t\tgot, se, code := mtRun(t, bin, args...)\n+\t\t\tif code != 0 {\n+\t\t\t\tt.Fatalf(\"exit %d: %s\", code, se)\n+\t\t\t}\n+\t\t\twant, err := os.ReadFile(filepath.Join(mtFixtures, name, \"want.jsonl\"))\n+\t\t\tif err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t\tif got != string(want) {\n+\t\t\t\tt.Errorf(\"output differs\\n--- got\\n%s--- want\\n%s\", got, want)\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+func TestMissingTestsHelperOutputDecodes(t *testing.T) {\n+\tfor _, name := range mtCases(t) {\n+\t\tt.Run(name, func(t *testing.T) {\n+\t\t\tb, err := os.ReadFile(filepath.Join(mtFixtures, name, \"want.jsonl\"))\n+\t\t\tif err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t\tfound, err := scanner.DecodeFindings(bytes.NewReader(b))\n+\t\t\tif err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t\tseen := map[string]bool{}\n+\t\t\tfor _, f := range found {\n+\t\t\t\tif seen[f.Fingerprint] {\n+\t\t\t\t\tt.Errorf(\"duplicate fingerprint %s\", f.Fingerprint)\n+\t\t\t\t}\n+\t\t\t\tseen[f.Fingerprint] = true\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+func TestMissingTestsFingerprintStable(t *testing.T) {\n+\tbin := mtBuild(t)\n+\tconst fp = \"missing-tests:go:example.com/mt/p:F\"\n+\t// F is never run, then moved to another file with a new body and run by a\n+\t// test that does not name it, then named by a test.\n+\tsteps := []struct {\n+\t\tname  string\n+\t\tfiles map[string]string\n+\t\tsev   string\n+\t}{\n+\t\t{\"uncovered\", map[string]string{\n+\t\t\t\"p/a.go\":      \"package p\\n\\nfunc F() int { return 1 }\\n\",\n+\t\t\t\"p/a_test.go\": \"package p\\n\\nimport \\\"testing\\\"\\n\\nfunc TestA(t *testing.T) {}\\n\",\n+\t\t}, \"medium\"},\n+\t\t{\"moved and run unnamed\", map[string]string{\n+\t\t\t\"p/b.go\":      \"package p\\n\\nfunc F() int {\\n\\tx := 2\\n\\treturn x + 1\\n}\\n\\nfunc G() int { return F() }\\n\",\n+\t\t\t\"p/a_test.go\": \"package p\\n\\nimport \\\"testing\\\"\\n\\nfunc TestA(t *testing.T) { G() }\\n\",\n+\t\t}, \"low\"},\n+\t}\n+\tfor _, s := range steps {\n+\t\tt.Run(s.name, func(t *testing.T) {\n+\t\t\tdir := mtModule(t, s.files)\n+\t\t\tout, se, code := mtRun(t, bin, mtMeasure(t, dir, false)...)\n+\t\t\tif code != 0 {\n+\t\t\t\tt.Fatalf(\"exit %d: %s\", code, se)\n+\t\t\t}\n+\t\t\tfound, err := scanner.DecodeFindings(strings.NewReader(out))\n+\t\t\tif err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t\tfor _, f := range found {\n+\t\t\t\tif f.Fingerprint == fp {\n+\t\t\t\t\tif string(f.Severity) != s.sev {\n+\t\t\t\t\t\tt.Errorf(\"severity %s, want %s\", f.Severity, s.sev)\n+\t\t\t\t\t}\n+\t\t\t\t\treturn\n+\t\t\t\t}\n+\t\t\t}\n+\t\t\tt.Errorf(\"no finding with fingerprint %s in %s\", fp, out)\n+\t\t})\n+\t}\n+}\n+\n+func TestMissingTestsHelperLimits(t *testing.T) {\n+\tbin := mtBuild(t)\n+\tlong := \"X\" + strings.Repeat(\"a\", 599)\n+\tdir := mtModule(t, map[string]string{\"p/p.go\": \"package p\\n\\nfunc \" + long + \"() int { return 1 }\\n\\nfunc A() int { return 1 }\\n\\nfunc B() int { return 1 }\\n\"})\n+\targs := mtMeasure(t, dir, true)\n+\tt.Run(\"long symbol\", func(t *testing.T) {\n+\t\tout, se, code := mtRun(t, bin, args...)\n+\t\tif code != 0 {\n+\t\t\tt.Fatalf(\"exit %d: %s\", code, se)\n+\t\t}\n+\t\tfound, err := scanner.DecodeFindings(strings.NewReader(out))\n+\t\tif err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tif len(found) != 3 {\n+\t\t\tt.Fatalf(\"%d findings\", len(found))\n+\t\t}\n+\t\thashed := 0\n+\t\tfor _, f := range found {\n+\t\t\tif strings.HasPrefix(f.Fingerprint, \"missing-tests:go:sha256:\") {\n+\t\t\t\thashed++\n+\t\t\t}\n+\t\t\tif n := utf8.RuneCountInString(f.Title); n > 200 {\n+\t\t\t\tt.Errorf(\"title has %d runes\", n)\n+\t\t\t}\n+\t\t}\n+\t\tif hashed != 1 {\n+\t\t\tt.Errorf(\"%d hashed fingerprints, want 1\", hashed)\n+\t\t}\n+\t\tfor _, f := range found {\n+\t\t\tif len(f.Title) > 200 && !strings.HasSuffix(f.Title, \"…\") {\n+\t\t\t\tt.Errorf(\"cut title %q lacks ellipsis\", f.Title)\n+\t\t\t}\n+\t\t}\n+\t})\n+\tt.Run(\"too many\", func(t *testing.T) {\n+\t\tout, se, code := mtRun(t, bin, append([]string{\"-max\", \"2\"}, args...)...)\n+\t\tif code != 1 || out != \"\" || !strings.Contains(se, \"too many findings\") {\n+\t\t\tt.Fatalf(\"exit %d, stdout %q, stderr %q\", code, out, se)\n+\t\t}\n+\t})\n+}\n+\n+func TestMissingTestsHelperErrors(t *testing.T) {\n+\tbin := mtBuild(t)\n+\tgood := mtModule(t, map[string]string{\"p/p.go\": \"package p\\n\\nfunc F() int { return 1 }\\n\", \"p/p_test.go\": \"package p\\n\\nimport \\\"testing\\\"\\n\\nfunc TestF(t *testing.T) { F() }\\n\"})\n+\tgargs := mtMeasure(t, good, false)\n+\tprof := gargs[len(gargs)-1]\n+\tpkgs := gargs[5]\n+\taux := t.TempDir()\n+\twrite := func(name, content string) string {\n+\t\tp := filepath.Join(aux, name)\n+\t\tif err := os.WriteFile(p, []byte(content), 0o644); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\treturn p\n+\t}\n+\tbadProf := write(\"bad.out\", \"mode: set\\nnot a profile line\\n\")\n+\tbadIgnore := write(\"ignore\", \"# ok\\n\\nexample.com/mt/p\\nexample.com/mt/p:\\n\")\n+\tbroken := mtModule(t, map[string]string{\"p/p.go\": \"package p\\n\\nfunc F( {\\n\"})\n+\tbrokenArgs := mtMeasure(t, broken, true)\n+\tbase := []string{\"-module\", \"example.com/mt\", \"-prefix\", \".\", \"-go\", \"go1.test\"}\n+\tcases := []struct {\n+\t\tname string\n+\t\targs []string\n+\t\twant string\n+\t}{\n+\t\t{\"no packages flag\", append(append([]string{}, base...), \"-no-coverage\"), \"-packages\"},\n+\t\t{\"profile and no-coverage\", append(append([]string{}, base...), \"-packages\", pkgs, \"-profile\", prof, \"-no-coverage\"), \"exactly one\"},\n+\t\t{\"neither\", append(append([]string{}, base...), \"-packages\", pkgs), \"exactly one\"},\n+\t\t{\"malformed profile\", append(append([]string{}, base...), \"-packages\", pkgs, \"-profile\", badProf), \"bad.out:2\"},\n+\t\t{\"syntax error\", brokenArgs, \"p.go\"},\n+\t\t{\"malformed ignore\", append(append([]string{}, base...), \"-packages\", pkgs, \"-profile\", prof, \"-ignore\", badIgnore), \"ignore:4\"},\n+\t\t{\"missing profile file\", append(append([]string{}, base...), \"-packages\", pkgs, \"-profile\", filepath.Join(aux, \"nope\")), \"nope\"},\n+\t}\n+\tfor _, c := range cases {\n+\t\tt.Run(c.name, func(t *testing.T) {\n+\t\t\tout, se, code := mtRun(t, bin, c.args...)\n+\t\t\tif code != 1 || out != \"\" || !strings.HasPrefix(se, \"missing-tests: \") || !strings.Contains(se, c.want) {\n+\t\t\t\tt.Fatalf(\"exit %d, stdout %q, stderr %q (want it to contain %q)\", code, out, se, c.want)\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+func TestMissingTestsHelperVets(t *testing.T) {\n+\tneedTools(t, \"go\", \"gofmt\")\n+\tcmd := exec.Command(\"go\", \"vet\", \"scanners/missing-tests/missingtests.go\")\n+\tcmd.Env = goEnv()\n+\tif out, err := cmd.CombinedOutput(); err != nil {\n+\t\tt.Fatalf(\"go vet: %v\\n%s\", err, out)\n+\t}\n+\tout, err := exec.Command(\"gofmt\", \"-l\", \"scanners/missing-tests/missingtests.go\").CombinedOutput()\n+\tif err != nil || len(out) != 0 {\n+\t\tt.Fatalf(\"gofmt -l: %v %s\", err, out)\n+\t}\n+}\ndiff --git a/internal/roles/roles.go b/internal/roles/roles.go\nindex 51f159f..7f2526f 100644\n--- a/internal/roles/roles.go\n+++ b/internal/roles/roles.go\n@@ -9,7 +9,9 @@ import \"embed\"\n // FS is the starter .ard/ tree `ard init` proposes: config.yaml plus the role\n // directories (scanners/cve, scanners/docs, scanners/error-codes, triage/lead, triage/engineer, workers/engineer, reviewers/eng-review, reviewers/license-review and reviewers/security-review); paths are relative to .ard/.\n //\n-//go:embed config.yaml reviewers scanners triage workers\n+// scanners/missing-tests is left out until its scan driver exists; re-add it when wiring it in.\n+//\n+//go:embed config.yaml reviewers scanners/cve scanners/docs scanners/error-codes triage workers\n var FS embed.FS\n \n // ExecutableNames lists base names that must be written 0755.\ndiff --git a/internal/roles/scanners/missing-tests/missingtests.go b/internal/roles/scanners/missing-tests/missingtests.go\nnew file mode 100644\nindex 0000000..9ab6123\n--- /dev/null\n+++ b/internal/roles/scanners/missing-tests/missingtests.go\n@@ -0,0 +1,554 @@\n+//go:build ignore\n+\n+// missingtests lists Go functions that the module's tests do not run, or that\n+// no test calls by name, as ard scanner findings (JSON lines on stdout).\n+//\n+// It is built by the missing-tests scan driver (added in a later change). It\n+// carries the ignore build tag, so go vet ./... and go build ./... skip it.\n+// It reads `go list -json` output and a coverage profile that the driver\n+// produced; it never runs repository code, and uses only the standard\n+// library. It fails closed: on any error it prints \"missing-tests: <what>\" to\n+// stderr, nothing on stdout, and exits 1.\n+package main\n+\n+import (\n+\t\"bufio\"\n+\t\"crypto/sha256\"\n+\t\"encoding/hex\"\n+\t\"encoding/json\"\n+\t\"errors\"\n+\t\"flag\"\n+\t\"fmt\"\n+\t\"go/ast\"\n+\t\"go/parser\"\n+\t\"go/token\"\n+\t\"io\"\n+\t\"os\"\n+\t\"path\"\n+\t\"path/filepath\"\n+\t\"regexp\"\n+\t\"sort\"\n+\t\"strconv\"\n+\t\"strings\"\n+)\n+\n+const (\n+\tmaxFindings    = 10000\n+\tmaxFingerprint = 512\n+\tmaxTitleRunes  = 200\n+\tmaxGroupBytes  = 256\n+\tmaxBodyRunes   = 1900\n+)\n+\n+// implicitMethods are called implicitly by the standard library, so a test\n+// need not name them: a covered one is never reported.\n+var implicitMethods = map[string]bool{\n+\t\"Error\": true, \"Unwrap\": true, \"Is\": true, \"As\": true, \"String\": true,\n+\t\"GoString\": true, \"Format\": true, \"MarshalJSON\": true, \"UnmarshalJSON\": true,\n+\t\"MarshalText\": true, \"UnmarshalText\": true, \"MarshalYAML\": true,\n+\t\"UnmarshalYAML\": true, \"MarshalBinary\": true, \"UnmarshalBinary\": true,\n+\t\"LogValue\": true, \"ServeHTTP\": true,\n+}\n+\n+// listedPackage is the subset of `go list -json` that the helper reads.\n+type listedPackage struct {\n+\tImportPath, Name, Dir              string\n+\tGoFiles, TestGoFiles, XTestGoFiles []string\n+}\n+\n+// block is one coverage block of the profile.\n+type block struct {\n+\tStartLine, StartCol, EndLine, EndCol, NumStmt int\n+\tCovered                                       bool\n+}\n+\n+type funcInfo struct {\n+\tPkg        *listedPackage\n+\tFile       string // repo-relative slash path\n+\tLine       int\n+\tSymbol     string // \"F\" or \"T.M\"\n+\tMethod     string // \"M\" for methods, \"\" for functions\n+\tExported   bool\n+\tStart, End token.Position\n+\tHasStmts   bool\n+}\n+\n+// finding matches scanner.Finding's JSON shape; field order is the schema order.\n+type finding struct {\n+\tFingerprint string   `json:\"fingerprint\"`\n+\tTitle       string   `json:\"title\"`\n+\tSeverity    string   `json:\"severity\"`\n+\tGroup       string   `json:\"group\"`\n+\tFiles       []string `json:\"files\"`\n+\tBody        string   `json:\"body\"`\n+}\n+\n+type testRefs struct {\n+\tinternal  map[string]map[string]bool // import path -> idents in its TestGoFiles\n+\tqualified map[string]map[string]bool // import path -> names used as X.Name, X being that package's import name\n+\tselectors map[string]bool            // every Sel.Name in any test file\n+}\n+\n+type ignoreRule struct {\n+\traw     string\n+\tpkg     string\n+\ttree    bool\n+\tsymGlob string\n+}\n+\n+type config struct {\n+\tmodule, prefix, goVersion string\n+\tnoCoverage                bool\n+\tmax                       int\n+}\n+\n+func main() {\n+\tout, err := run(os.Args[1:], os.Stderr)\n+\tif err != nil {\n+\t\tfmt.Fprintf(os.Stderr, \"missing-tests: %v\\n\", err)\n+\t\tos.Exit(1)\n+\t}\n+\tif _, err := os.Stdout.Write(out); err != nil {\n+\t\tfmt.Fprintf(os.Stderr, \"missing-tests: %v\\n\", err)\n+\t\tos.Exit(1)\n+\t}\n+}\n+\n+func run(args []string, stderr io.Writer) ([]byte, error) {\n+\tfs := flag.NewFlagSet(\"missingtests\", flag.ContinueOnError)\n+\tfs.SetOutput(io.Discard)\n+\tvar cfg config\n+\tvar packages, profile, ignore string\n+\tfs.StringVar(&cfg.module, \"module\", \"\", \"module path\")\n+\tfs.StringVar(&cfg.prefix, \"prefix\", \"\", \"repo-relative module directory, . for the root\")\n+\tfs.StringVar(&packages, \"packages\", \"\", \"file with `go list -json ./...` output\")\n+\tfs.StringVar(&cfg.goVersion, \"go\", \"\", \"Go version used for the measurement\")\n+\tfs.StringVar(&profile, \"profile\", \"\", \"coverage profile\")\n+\tfs.BoolVar(&cfg.noCoverage, \"no-coverage\", false, \"static rule only\")\n+\tfs.StringVar(&ignore, \"ignore\", \"\", \"optional ignore file\")\n+\tfs.IntVar(&cfg.max, \"max\", maxFindings, \"finding limit (for tests)\")\n+\tif err := fs.Parse(args); err != nil {\n+\t\treturn nil, err\n+\t}\n+\tif fs.NArg() > 0 {\n+\t\treturn nil, fmt.Errorf(\"unexpected argument %q\", fs.Arg(0))\n+\t}\n+\tfor name, v := range map[string]string{\"-module\": cfg.module, \"-prefix\": cfg.prefix, \"-packages\": packages, \"-go\": cfg.goVersion} {\n+\t\tif v == \"\" {\n+\t\t\treturn nil, fmt.Errorf(\"%s is required\", name)\n+\t\t}\n+\t}\n+\tif (profile == \"\") == !cfg.noCoverage {\n+\t\treturn nil, errors.New(\"exactly one of -profile and -no-coverage is required\")\n+\t}\n+\tpkgs, err := readPackages(packages)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tvar blocks map[string][]block\n+\tif profile != \"\" {\n+\t\tif blocks, err = readProfile(profile); err != nil {\n+\t\t\treturn nil, err\n+\t\t}\n+\t}\n+\tvar rules []ignoreRule\n+\tif ignore != \"\" {\n+\t\tif rules, err = readIgnore(ignore); err != nil {\n+\t\t\treturn nil, err\n+\t\t}\n+\t}\n+\tfset := token.NewFileSet()\n+\tfuncs, err := collectFuncs(pkgs, cfg.prefix, cfg.module, fset)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\trefs, err := collectTestRefs(pkgs, fset)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tused := make([]bool, len(rules))\n+\tvar found []finding\n+\tfor _, f := range funcs {\n+\t\tignored := false\n+\t\tfor i, r := range rules {\n+\t\t\tif r.match(f.Pkg.ImportPath, f.Symbol) {\n+\t\t\t\tused[i], ignored = true, true\n+\t\t\t}\n+\t\t}\n+\t\tif ignored {\n+\t\t\tcontinue\n+\t\t}\n+\t\tcovered, run, total := false, 0, 0\n+\t\tif !cfg.noCoverage {\n+\t\t\tcovered, run, total = coverage(f, blocks[f.Pkg.ImportPath+\"/\"+path.Base(f.File)])\n+\t\t}\n+\t\tnamed := refs.named(f)\n+\t\tsev, kind, ok := decide(f, covered, named, cfg.noCoverage)\n+\t\tif !ok {\n+\t\t\tcontinue\n+\t\t}\n+\t\tfound = append(found, makeFinding(f, cfg, sev, kind, named, run, total))\n+\t}\n+\tfor i, r := range rules {\n+\t\tif !used[i] {\n+\t\t\tfmt.Fprintf(stderr, \"missing-tests: warning: ignore pattern %q matches nothing\\n\", r.raw)\n+\t\t}\n+\t}\n+\tif len(found) > cfg.max {\n+\t\treturn nil, fmt.Errorf(\"too many findings (%d, limit %d): add an ignore file or no-coverage\", len(found), cfg.max)\n+\t}\n+\tsort.Slice(found, func(i, j int) bool { return found[i].Fingerprint < found[j].Fingerprint })\n+\tvar out []byte\n+\tfor _, f := range found {\n+\t\tb, err := json.Marshal(f)\n+\t\tif err != nil {\n+\t\t\treturn nil, err\n+\t\t}\n+\t\tout = append(append(out, b...), '\\n')\n+\t}\n+\treturn out, nil\n+}\n+\n+// readPackages decodes the concatenated JSON objects of `go list -json`.\n+func readPackages(file string) ([]*listedPackage, error) {\n+\tfh, err := os.Open(file)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tdefer fh.Close()\n+\tdec := json.NewDecoder(bufio.NewReader(fh))\n+\tvar pkgs []*listedPackage\n+\tfor {\n+\t\tvar p listedPackage\n+\t\tif err := dec.Decode(&p); err == io.EOF {\n+\t\t\tbreak\n+\t\t} else if err != nil {\n+\t\t\treturn nil, fmt.Errorf(\"%s: %v\", file, err)\n+\t\t}\n+\t\tif p.ImportPath == \"\" || p.Dir == \"\" {\n+\t\t\treturn nil, fmt.Errorf(\"%s: package without import path or directory\", file)\n+\t\t}\n+\t\tpkgs = append(pkgs, &p)\n+\t}\n+\treturn pkgs, nil\n+}\n+\n+var profileLine = regexp.MustCompile(`^(.+):(\\d+)\\.(\\d+),(\\d+)\\.(\\d+) (\\d+) (\\d+)$`)\n+\n+// readProfile reads a coverage profile. Blocks are keyed by \"importpath/file.go\".\n+// The same block appears once per test binary under -coverpkg; they merge with OR.\n+func readProfile(file string) (map[string][]block, error) {\n+\tfh, err := os.Open(file)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tdefer fh.Close()\n+\tsc := bufio.NewScanner(fh)\n+\tsc.Buffer(nil, 1<<20)\n+\ttype key struct {\n+\t\tfile string\n+\t\tb    block\n+\t}\n+\tmerged := map[key]bool{}\n+\tn := 0\n+\tfor sc.Scan() {\n+\t\tn++\n+\t\tline := sc.Text()\n+\t\tif n == 1 {\n+\t\t\tif line != \"mode: set\" && line != \"mode: count\" && line != \"mode: atomic\" {\n+\t\t\t\treturn nil, fmt.Errorf(\"%s:1: malformed mode line %q\", file, line)\n+\t\t\t}\n+\t\t\tcontinue\n+\t\t}\n+\t\tm := profileLine.FindStringSubmatch(line)\n+\t\tif m == nil {\n+\t\t\treturn nil, fmt.Errorf(\"%s:%d: malformed profile line %q\", file, n, line)\n+\t\t}\n+\t\tvar v [6]int\n+\t\tfor i := range v {\n+\t\t\tv[i], _ = strconv.Atoi(m[i+2])\n+\t\t}\n+\t\tk := key{m[1], block{StartLine: v[0], StartCol: v[1], EndLine: v[2], EndCol: v[3], NumStmt: v[4]}}\n+\t\tmerged[k] = merged[k] || v[5] > 0\n+\t}\n+\tif err := sc.Err(); err != nil {\n+\t\treturn nil, err\n+\t}\n+\tif n == 0 {\n+\t\treturn nil, fmt.Errorf(\"%s: empty profile\", file)\n+\t}\n+\tout := map[string][]block{}\n+\tfor k, cov := range merged {\n+\t\tk.b.Covered = cov\n+\t\tout[k.file] = append(out[k.file], k.b)\n+\t}\n+\treturn out, nil\n+}\n+\n+// relPkg is the package directory relative to the repository root, or the\n+// module path when the package is at the repository root.\n+func relPkg(p *listedPackage, module, prefix string) string {\n+\trel := strings.TrimPrefix(strings.TrimPrefix(p.ImportPath, module), \"/\")\n+\tdir := path.Join(prefix, rel)\n+\tif dir == \".\" || dir == \"\" {\n+\t\treturn module\n+\t}\n+\treturn dir\n+}\n+\n+func collectFuncs(pkgs []*listedPackage, prefix, module string, fset *token.FileSet) ([]funcInfo, error) {\n+\tvar out []funcInfo\n+\tfor _, p := range pkgs {\n+\t\tdir := path.Join(prefix, strings.TrimPrefix(strings.TrimPrefix(p.ImportPath, module), \"/\"))\n+\t\tfor _, name := range p.GoFiles {\n+\t\t\tfile, err := parser.ParseFile(fset, filepath.Join(p.Dir, name), nil, parser.ParseComments|parser.SkipObjectResolution)\n+\t\t\tif err != nil {\n+\t\t\t\treturn nil, err\n+\t\t\t}\n+\t\t\tif ast.IsGenerated(file) {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tfor _, d := range file.Decls {\n+\t\t\t\tfd, ok := d.(*ast.FuncDecl)\n+\t\t\t\tif !ok || fd.Body == nil || len(fd.Body.List) == 0 {\n+\t\t\t\t\tcontinue\n+\t\t\t\t}\n+\t\t\t\tfn := fd.Name.Name\n+\t\t\t\tif fn == \"_\" || (fd.Recv == nil && (fn == \"main\" || fn == \"init\")) {\n+\t\t\t\t\tcontinue\n+\t\t\t\t}\n+\t\t\t\tfi := funcInfo{Pkg: p, File: path.Join(dir, name), Symbol: fn, Exported: ast.IsExported(fn), HasStmts: true,\n+\t\t\t\t\tStart: fset.Position(fd.Pos()), End: fset.Position(fd.End())}\n+\t\t\t\tfi.Line = fi.Start.Line\n+\t\t\t\tif fd.Recv != nil && len(fd.Recv.List) > 0 {\n+\t\t\t\t\trecv := baseType(fd.Recv.List[0].Type)\n+\t\t\t\t\tfi.Method = fn\n+\t\t\t\t\tfi.Symbol = recv + \".\" + fn\n+\t\t\t\t\tfi.Exported = fi.Exported && ast.IsExported(recv)\n+\t\t\t\t}\n+\t\t\t\tout = append(out, fi)\n+\t\t\t}\n+\t\t}\n+\t}\n+\treturn out, nil\n+}\n+\n+// baseType is a receiver's type name with * and type parameters stripped.\n+func baseType(e ast.Expr) string {\n+\tfor {\n+\t\tswitch t := e.(type) {\n+\t\tcase *ast.StarExpr:\n+\t\t\te = t.X\n+\t\tcase *ast.ParenExpr:\n+\t\t\te = t.X\n+\t\tcase *ast.IndexExpr:\n+\t\t\te = t.X\n+\t\tcase *ast.IndexListExpr:\n+\t\t\te = t.X\n+\t\tcase *ast.Ident:\n+\t\t\treturn t.Name\n+\t\tdefault:\n+\t\t\treturn \"?\"\n+\t\t}\n+\t}\n+}\n+\n+func collectTestRefs(pkgs []*listedPackage, fset *token.FileSet) (testRefs, error) {\n+\tr := testRefs{internal: map[string]map[string]bool{}, qualified: map[string]map[string]bool{}, selectors: map[string]bool{}}\n+\tnames := map[string]string{} // import path -> package name\n+\tfor _, p := range pkgs {\n+\t\tnames[p.ImportPath] = p.Name\n+\t}\n+\tfor _, p := range pkgs {\n+\t\tfor _, set := range []struct {\n+\t\t\tfiles    []string\n+\t\t\tinternal bool\n+\t\t}{{p.TestGoFiles, true}, {p.XTestGoFiles, false}} {\n+\t\t\tfor _, name := range set.files {\n+\t\t\t\tfile, err := parser.ParseFile(fset, filepath.Join(p.Dir, name), nil, parser.SkipObjectResolution)\n+\t\t\t\tif err != nil {\n+\t\t\t\t\treturn r, err\n+\t\t\t\t}\n+\t\t\t\timports := map[string]string{} // local name -> import path\n+\t\t\t\tfor _, im := range file.Imports {\n+\t\t\t\t\tip, err := strconv.Unquote(im.Path.Value)\n+\t\t\t\t\tif err != nil {\n+\t\t\t\t\t\tcontinue\n+\t\t\t\t\t}\n+\t\t\t\t\tlocal := names[ip]\n+\t\t\t\t\tif im.Name != nil {\n+\t\t\t\t\t\tlocal = im.Name.Name\n+\t\t\t\t\t}\n+\t\t\t\t\tif _, inModule := names[ip]; inModule && local != \"_\" && local != \".\" {\n+\t\t\t\t\t\timports[local] = ip\n+\t\t\t\t\t}\n+\t\t\t\t}\n+\t\t\t\tast.Inspect(file, func(n ast.Node) bool {\n+\t\t\t\t\tswitch x := n.(type) {\n+\t\t\t\t\tcase *ast.Ident:\n+\t\t\t\t\t\tif set.internal {\n+\t\t\t\t\t\t\tadd(r.internal, p.ImportPath, x.Name)\n+\t\t\t\t\t\t}\n+\t\t\t\t\tcase *ast.SelectorExpr:\n+\t\t\t\t\t\tr.selectors[x.Sel.Name] = true\n+\t\t\t\t\t\tif id, ok := x.X.(*ast.Ident); ok {\n+\t\t\t\t\t\t\tif ip, ok := imports[id.Name]; ok {\n+\t\t\t\t\t\t\t\tadd(r.qualified, ip, x.Sel.Name)\n+\t\t\t\t\t\t\t}\n+\t\t\t\t\t\t}\n+\t\t\t\t\t}\n+\t\t\t\t\treturn true\n+\t\t\t\t})\n+\t\t\t}\n+\t\t}\n+\t}\n+\treturn r, nil\n+}\n+\n+func add(m map[string]map[string]bool, k, v string) {\n+\tif m[k] == nil {\n+\t\tm[k] = map[string]bool{}\n+\t}\n+\tm[k][v] = true\n+}\n+\n+// named reports whether a test names f. For a method the receiver is not\n+// checked, so this can only miss findings, never invent one.\n+func (r testRefs) named(f funcInfo) bool {\n+\tip := f.Pkg.ImportPath\n+\tif f.Method != \"\" {\n+\t\treturn r.selectors[f.Method] || r.internal[ip][f.Method]\n+\t}\n+\treturn r.internal[ip][f.Symbol] || r.qualified[ip][f.Symbol]\n+}\n+\n+// coverage reports whether any block inside f ran, and the statements run and total.\n+func coverage(f funcInfo, blocks []block) (covered bool, run, total int) {\n+\tfor _, b := range blocks {\n+\t\tif before(b.StartLine, b.StartCol, f.Start.Line, f.Start.Column) || before(f.End.Line, f.End.Column, b.EndLine, b.EndCol) {\n+\t\t\tcontinue\n+\t\t}\n+\t\ttotal += b.NumStmt\n+\t\tif b.Covered {\n+\t\t\tcovered = true\n+\t\t\trun += b.NumStmt\n+\t\t}\n+\t}\n+\treturn\n+}\n+\n+func before(l1, c1, l2, c2 int) bool { return l1 < l2 || (l1 == l2 && c1 < c2) }\n+\n+// readIgnore reads the optional ignore file. A malformed line is an error.\n+func readIgnore(file string) ([]ignoreRule, error) {\n+\tb, err := os.ReadFile(file)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tvar rules []ignoreRule\n+\tfor i, line := range strings.Split(string(b), \"\\n\") {\n+\t\tline = strings.TrimSpace(line)\n+\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\n+\t\t\tcontinue\n+\t\t}\n+\t\tbad := func(why string) error { return fmt.Errorf(\"%s:%d: %s: %q\", file, i+1, why, line) }\n+\t\tif strings.ContainsAny(line, \" \\t\") {\n+\t\t\treturn nil, bad(\"pattern contains whitespace\")\n+\t\t}\n+\t\tr := ignoreRule{raw: line, pkg: line}\n+\t\tif pkg, glob, ok := strings.Cut(line, \":\"); ok {\n+\t\t\tif pkg == \"\" || glob == \"\" {\n+\t\t\t\treturn nil, bad(\"empty package or symbol\")\n+\t\t\t}\n+\t\t\tif _, err := path.Match(glob, \"\"); err != nil {\n+\t\t\t\treturn nil, bad(\"bad glob\")\n+\t\t\t}\n+\t\t\tr.pkg, r.symGlob = pkg, glob\n+\t\t} else if strings.HasSuffix(line, \"/...\") {\n+\t\t\tr.pkg, r.tree = strings.TrimSuffix(line, \"/...\"), true\n+\t\t}\n+\t\tif r.pkg == \"\" || strings.Contains(r.pkg, \"...\") {\n+\t\t\treturn nil, bad(\"bad package pattern\")\n+\t\t}\n+\t\trules = append(rules, r)\n+\t}\n+\treturn rules, nil\n+}\n+\n+func (r ignoreRule) match(pkg, symbol string) bool {\n+\tif pkg != r.pkg && !(r.tree && strings.HasPrefix(pkg, r.pkg+\"/\")) {\n+\t\treturn false\n+\t}\n+\tif r.symGlob == \"\" {\n+\t\treturn true\n+\t}\n+\tok, _ := path.Match(r.symGlob, symbol)\n+\treturn ok\n+}\n+\n+// decide applies the severity table. kind is \"never\" (never run by tests) or\n+// \"uncalled\" (no test calls it).\n+func decide(f funcInfo, covered, named, noCoverage bool) (sev, kind string, ok bool) {\n+\timplicit := f.Method != \"\" && implicitMethods[f.Method]\n+\tif noCoverage {\n+\t\tif f.Exported && !implicit && !named {\n+\t\t\treturn \"low\", \"uncalled\", true\n+\t\t}\n+\t\treturn \"\", \"\", false\n+\t}\n+\tswitch {\n+\tcase f.Exported && !covered:\n+\t\treturn \"medium\", \"never\", true\n+\tcase f.Exported && !named && !implicit:\n+\t\treturn \"low\", \"uncalled\", true\n+\tcase !f.Exported && !covered:\n+\t\treturn \"low\", \"never\", true\n+\t}\n+\treturn \"\", \"\", false\n+}\n+\n+func makeFinding(f funcInfo, cfg config, sev, kind string, named bool, run, total int) finding {\n+\tip := f.Pkg.ImportPath\n+\tfp := \"missing-tests:go:\" + ip + \":\" + f.Symbol\n+\tif len(fp) > maxFingerprint {\n+\t\tsum := sha256.Sum256([]byte(ip + \":\" + f.Symbol))\n+\t\tfp = \"missing-tests:go:sha256:\" + hex.EncodeToString(sum[:])\n+\t}\n+\tgroup := \"go:\" + ip\n+\tif len(group) > maxGroupBytes {\n+\t\tsum := sha256.Sum256([]byte(ip))\n+\t\tgroup = \"go:sha256:\" + hex.EncodeToString(sum[:])\n+\t}\n+\twhat := \"is never run by tests\"\n+\tif kind == \"uncalled\" {\n+\t\twhat = \"has no test that calls it\"\n+\t}\n+\ttitle := cut(relPkg(f.Pkg, cfg.module, cfg.prefix)+\": \"+f.Symbol+\" \"+what, maxTitleRunes)\n+\texp, fixed := \"unexported\", \"the module's tests execute it\"\n+\tif f.Exported {\n+\t\texp, fixed = \"exported\", \"a test in this module calls it by name, and the module's tests execute it\"\n+\t}\n+\tstmts := fmt.Sprintf(\"%d of %d\", run, total)\n+\tif cfg.noCoverage {\n+\t\tstmts = \"coverage not measured, `no-","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/ard-home/.claude/projects/-Users-al--ard-work-albertcbrown-ard-01M85048YYEY7FGCJ105YRH1T2/d857d468-81db-49de-8e45-f667c7b20c80/tool-results/b8cd5jv9t.txt","persistedOutputSize":33279},"tool_result_meta":[{"id":"toolu_01UXfxFRiwK1qSRQ7hBYFBP8","permission_decision":{"decision":"accept","source":"config","reaso