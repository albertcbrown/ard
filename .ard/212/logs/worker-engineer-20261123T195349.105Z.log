\t\tif err != nil {\n\t\t\tt.Skipf(\"%s not available\", n)\n\t\t}\n\t\tif err := os.Symlink(p, filepath.Join(e.bin, n)); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tfor _, f := range []string{\"scan\", \"errcodes.jq\"} {\n\t\tb, err := FS.ReadFile(\"scanners/error-codes/\" + f)\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tmode := os.FileMode(0o644)\n\t\tif f == \"scan\" {\n\t\t\tmode = 0o755\n\t\t}\n\t\tif err := os.WriteFile(filepath.Join(e.role, f), b, mode); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tif codes != \"\" {\n\t\tif err := os.WriteFile(filepath.Join(e.role, \"codes.json\"), []byte(codes), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\treturn e\n}\n\nfunc (e *ecEnv) write(t *testing.T, rel, content string) {\n\tt.Helper()\n\tp := filepath.Join(e.repo, rel)\n\tif err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(p, []byte(content), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n\nfunc (e *ecEnv) runIn(t *testing.T, cwd string) (stdout, stderr string, code int) {\n\tt.Helper()\n\tcmd := exec.Command(filepath.Join(e.role, \"scan\"))\n\tcmd.Dir = cwd\n\tcmd.Env = []string{\"PATH=\" + e.bin, \"HOME=/nonexistent\", \"TMPDIR=\" + e.tmp}\n\tvar so, se bytes.Buffer\n\tcmd.Stdout, cmd.Stderr = &so, &se\n\tif err := cmd.Run(); err != nil {\n\t\tee, ok := err.(*exec.ExitError)\n\t\tif !ok {\n\t\t\tt.Fatal(err)\n\t\t}\ninternal/roles/docs_test.go:315:func TestMain(m *testing.M) {\n---\nrole: engineer\nstatus: needs-human\nattempt: 1\n---\nThe full scanner is still size XL (well over 1,000 changed lines), so no implementation plan was written for this issue. A comment records that the work has already been split into two smaller issues, #212 (the Go helper) and #213 (the scan driver, Dockerfile and starter wiring), and this issue stays open only as a tracker.\n\n## Open issues\n- Plan and implement the work under #212 and #213, not here. Ask for engineer triage on those issues if it h