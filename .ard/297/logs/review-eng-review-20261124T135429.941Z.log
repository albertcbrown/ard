\t*errs = append(*errs, &Error{File: cfgPath, Key: keyRef + \".autoclose\", Msg: \"an LLM scanner never closes an issue for absence; autoclose is valid only for a scanner with a scan executable\"})\ndiff --git a/internal/config/network_test.go b/internal/config/network_test.go\nnew file mode 100644\n--- /dev/null\n+++ b/internal/config/network_test.go\n@@ -0,0 +1,25 @@\n+package config\n+\n+import (\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+func TestNetworkDefaultAndOverride(t *testing.T) {\n+\tres := mustLoad(t, withConfig(t, \"agent: kimi\\noverrides:\\n  scanners/cve: {network: false}\\n  triage/lead: {network: false}\\n  workers/engineer: {network: false}\\n\"))\n+\tfor _, r := range res.Roles {\n+\t\twant := !(r.Kind == KindScanner && r.Name == \"cve\" || r.Kind == KindTriage && r.Name == \"lead\" || r.Kind == KindWorker && r.Name == \"engineer\")\n+\t\tif r.Network != want {\n+\t\t\tt.Errorf(\"%s/%s network = %v, want %v\", r.Kind, r.Name, r.Network, want)\n+\t\t}\n+\t}\n+}\n+\n+func TestNetworkRejectsNonBool(t *testing.T) {\n+\tfor _, v := range []string{`\"maybe\"`, \"3\"} {\n+\t\t_, err := LoadFS(withConfig(t, \"agent: kimi\\noverrides:\\n  scanners/cve: {network: \"+v+\"}\\n\"), \"/repo\")\n+\t\tif err == nil || !strings.Contains(err.Error(), \"network\") {\n+\t\t\tt.Errorf(\"network: %s: err = %v\", v, err)\n+\t\t}\n+\t}\n+}\ndiff --git a/internal/config/render.go b/internal/config/render.go\n--- a/internal/config/render.go\n+++ b/internal/config/render.go\n@@ -92,6 +92,9 @@ type roleYAML struct {\n \tModel   string   `yaml:\"model,omitempty\"`\n \tTimeout Duration `yaml:\"timeout\"`\n \tSidecar string   `yaml:\"sidecar,omitempty\"`\n+\t// Network is the bool true, or the string \"false (advisory)\" or\n+\t// \"false (advisory, host)\".\n+\tNetwork any `yaml:\"network\"`\n \n \tEvery     Duration `yaml:\"every,omitempty\"`\n \tMaxOpen   int      `yaml:\"max_open,omitempty\"`\n@@ -169,6 +172,7 @@ func (r *Resolved) render() resolvedYAML {\n \t\t\tModel:    