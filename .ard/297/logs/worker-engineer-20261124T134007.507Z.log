ist\", executor.ErrForbiddenEnv, name)\n\t\t}\n\t}\n\treturn nil\n}\n\n// checkConfigDir keeps a job on its own config dir. A Fixed entry for the\n// config-dir variable must equal View.ConfigDir, and a prepared dir must\n// still be the empty 0700 directory Prepare made.\nfunc (l *Local) checkConfigDir(h executor.Handle, fixed []string) error {\n\tfor _, kv := range fixed {\n\t\tname, val, _ := strings.Cut(kv, \"=\")\n\t\tif name == l.configDirEnv && (h.View.ConfigDir == \"\" || val != h.View.ConfigDir) {\n\t\t\treturn fmt.Errorf(\"%w: %s must be the job config dir\", executor.ErrForbiddenEnv, name)\n\t\t}\n\t}\n\tif h.View.ConfigDir == \"\" {\n\t\treturn nil\n\t}\n\tp := filepath.Join(h.Home, configDirName)\n\twant := p\n\tif h.Kind == \"docker\" {\n\t\twant = \"/ard-config\"\n\t}\n\tif h.View.ConfigDir != want {\n\t\treturn fmt.Errorf(\"%w: config dir %q, want %q\", executor.ErrNotPrepared, h.View.ConfigDir, want)\n\t}\n\tif rel, err := filepath.Rel(l.root, h.Home); err != nil || rel == \"..\" || strings.HasPrefix(rel, \"../\") || rel == \".\" {\n\t\treturn fmt.Errorf(\"%w: job home %s is not under %s\", executor.ErrNotPrepared, h.Home, l.root)\n\t}\n\tif hst, err := os.Lstat(h.Home); err != nil || !hst.IsDir() {\n\t\treturn fmt.Errorf(\"%w: job home %s is not a directory\", executor.ErrNotPrepared, h.Home)\n\t}\n\tfail := func(why string) error {\n\t\treturn fmt.Errorf(\"%w: config dir %s: %s\", executor.ErrNotPrepared, p, why)\n\t}\n\tst, err := os.Lstat(p)\n\tswitch {\n\tcase err != nil:\n\t\treturn fail(err.Error())\n\tcase !st.IsDir():\n\t\treturn fail(\"not a directory\")\n\tcase st.Mode().Perm() != 0o700:\n\t\treturn fail(fmt.Sprintf(\"mode %o, want 700\", st.Mode().Perm()))\n\t}\n\tents, err := os.ReadDir(p)\n\tif err != nil {\n\t\treturn fail(err.Error())\n\t}\n\tif len(ents) != 0 {\n\t\treturn fail(\"not empty\")\n\t}\n\treturn nil\n}\npackage local\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"log/slog\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/executor\"\n)\n\n// EventHostUntrusted is the slog message of every host-mode warning.\nconst EventHostUntrusted = \"executor.host_untrusted\"\n\nconst hostHint = \"add a Dockerfile to the role directory to run it under Docker\"\n\n// HostReach lists what a host-mode job can reach as the controller's uid.\n// It returns a fresh slice.\nfunc HostReach() []string {\n\treturn []string{\n\t\t\"the GitHub App private key file (ARD_GITHUB_PRIVATE_KEY_FILE) by absolute path\",\n\t\t\"~/.config/gh\",\n\t\t\"write access to the controller's clone (~/.ard/repos/<owner>/<repo>.git)\",\n\t\t\"~/.ard: controller state, config snapshots, the pause file and other jobs' worktrees and logs\",\n\t\t\"undoing chmod a-w on a read-only worktree\",\n\t}\n}\n\n// WarnHostRole logs one WARN for a role that reads untrusted input and has\n// no Dockerfile. kind and name come from config.Role; this package does not\n// import config.\nfunc WarnHostRole(log *slog.Logger, kind, name string) {\n\tlog.Warn(EventHostUntrusted, \"kind\", kind, \"role\", name,\n\t\t\"reaches\", strings.Join(HostReach(), \"; \"), \"hint\", hostHint)\n}\n\n// HostRoleText is the plain-text form of the warning, for writing straight to\n// stderr so it survives --log-level. It ends in a newline.\nfunc HostRoleText(kind, name string) string {\n\treturn fmt.Sprintf(\"WARNING: %s role %q reads untrusted input but has no Dockerfile, so its jobs run as a host subprocess \"+\n\t\t\"under the controller's uid and can reach: %s. Hint: %s.\\n\",\n\t\tkind, name, strings.Join(HostReach(), \"; \"), hostHint)\n}\n\n// hostUntrusted reports whether a started job should warn: host mode and\n// not marked TrustedInput.\nfunc hostUntrusted(h executor.Handle) bool { return h.Kind == \"host\" && !h.TrustedInput }\n\n// warnHostJob logs the per-job WARN and calls OnHostUntrusted. A hook error\n// is logged and does not fail Start: the job is already running.\nfunc (l *Local) warnHostJob(ctx context.Context, h executor.Handle) {\n\tl.log.Warn(EventHostUntrusted, \"job\", h.JobID, \"issue\", h.Issue, \"stage\", h.Stage, \"role\", h.Role,\n\t\t\"reaches\", strings.Join(HostReach(), \"; \"), \"hint\", hostHint)\n\tif l.onHostUntrusted == nil {\n\t\treturn\n\t}\n\tif err := l.onHostUntrusted(ctx, h); err != nil {\n\t\tl.log.Error(\"executor.host_untrusted_not_recorded\", \"job\", h.JobID, \"error\", err)\n\t}\n}\n84-\tif st, err := os.Stat(h.Worktree); err != nil || !st.IsDir() {\n85-\t\treturn h, executor.ErrNotPrepared\n86-\t}\n87:\tif err := l.checkEnv(c.Env); err != nil {\n88-\t\treturn h, err\n89-\t}\n90-\tif err := l.checkFixed(c.Fixed); err != nil {\n91-\t\treturn h, err\n92-\t}\n93-\tif err := l.checkConfigDir(h, c.Fixed); err != nil {\n94-\t\treturn h, err\n95-\t}\n--\n141-\tl.mu.Unlock()\n142-\tl.log.Info(\"executor job started\", \"job\", h.JobID, \"issue\", h.Issue, \"stage\", h.Stage,\n143-\t\t\"role\", h.Role, \"kind\", h.Kind, \"pid\", h.PID, \"deadline\", h.Deadline)\n144:\tif hostUntrusted(h) {\n145:\t\tl.warnHostJob(ctx, h)\n146-\t}\n147-\n148-\thh := h\n149-\ttr.timer = time.AfterFunc(h.Timeout, func() {\n150-\t\ttr.mu.Lock()\n151-\t\tif tr.exited {\n152-\t\t\ttr.mu.Unlock()\n153-\t\t\treturn","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01WPgpLhJZ1TDgnwDzSyGK1a","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
