{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Vac8g7fW4bE5suW5JBU5gV","type":"tool_result","content":"type Job struct {\n\tID         string  // ULID minted at claim; ^[0-9A-Za-z]{1,64}$\n\tRepo       string  // \"owner/repo\"\n\tIssue      int     // 0 = scanner run with no issue\n\tStage      string  // \"scanner\" | \"triage\" | \"worker\" | \"review\"\n\tRole       string  // ^[a-z0-9][a-z0-9-]*$\n\tRepoDir    string  // abs path of the controller's clone, already fetched\n\tRef        string  // commit-ish resolved in RepoDir; the worktree is detached at it\n\tRoleDir    string  // abs host path of the role directory\n\tDockerfile string  // abs host path; \"\" = host subprocess\n\tSidecar    Sidecar // zero = none; the executor clones, pins and mounts it read-only\n\tReadOnly   bool    // worktree read-only: Docker mounts :ro, host chmod -R a-w after Prepare\n\tInputs     []File  // written into the worktree by Prepare\n\t// Scrub lists repo-relative paths Prepare removes from the worktree after\n\t// checkout and before Start, so a file at Ref cannot pass for this job's\n\t// own output. Use it for the job's role file: close-out then trusts that\n\t// file only if it exists, because the agent wrote it. Each path must be a\n\t// file directly under .ard/<Issue>/ (Issue >= 1).\n\tScrub   []string\n\tTimeout time.Duration // > 0\n\t// TrustedInput: the job reads no untrusted input (a deterministic\n\tBaseSHA             string\n\tLogPath, StdoutPath string\n\tView                Paths\n\tImage, Container    string\n\tPID                 int\n\tProcStart           string\n\tPreparedAt          time.Time\n\tStartedAt, Deadline time.Time\n\tReadOnly            bool\n\tTimeout             time.Duration\n\tRoleDir, SidecarDir string  // host paths; SidecarDir is the executor's output (<Home>/sidecar), \"\" = none\n\tSidecar             Sidecar // copied from Job; zero on a handle stored before sidecars\n\tSidecarSHA          string  // the commit the job sees; \"\" = no sidecar\n\tTrustedInput        bool    // copied from Job by Prepare\n\tHistoryDir          string  // host path of the git history mounted read-only, \"\" = none\n\t// Scrubbed lists the Job.Scrub paths Prepare removed from the worktree.\npackage executor\n\nimport (\n\t\"fmt\"\n\t\"path\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"strings\"\n\n\t\"github.com/albertcbrown/ard/internal/gitref\"\n\t\"github.com/albertcbrown/ard/internal/repopath\"\n)\n\nvar (\n\tidRE   = regexp.MustCompile(`^[0-9A-Za-z]{1,64}$`)\n\troleRE = regexp.MustCompile(`^[a-z0-9][a-z0-9-]*$`)\n)\n\nvar stages = map[string]bool{\"scanner\": true, \"triage\": true, \"worker\": true, \"review\": true}\n\n// Validate checks the job's fields.\nfunc (j Job) Validate() error {\n\tbad := func(format string, a ...any) error {\n\t\treturn fmt.Errorf(\"%w: %s\", ErrInvalidJob, fmt.Sprintf(format, a...))\n\t}\n\tswitch {\n\tcase !idRE.MatchString(j.ID):\n\t\treturn bad(\"id %q\", j.ID)\n\tcase !validRepo(j.Repo):\n\t\treturn bad(\"repo %q\", j.Repo)\n\tcase j.Issue < 0:\n\t\treturn bad(\"issue %d\", j.Issue)\n\tcase !stages[j.Stage]:\n\t\treturn bad(\"stage %q\", j.Stage)\n\tcase !roleRE.MatchString(j.Role):\n\t\treturn bad(\"role %q\", j.Role)\n\tcase j.Ref == \"\" || strings.HasPrefix(j.Ref, \"-\"):\n\t\treturn bad(\"ref %q\", j.Ref)\n\tcase j.TrustedInput && j.Stage != \"scanner\":\n\t\treturn bad(\"trusted input is only valid for a scanner job\")\n\tcase j.History && j.Stage != \"scanner\":\n\t\treturn bad(\"history is only valid for a scanner job\")\n\tcase j.Timeout <= 0:\n\t\treturn bad(\"timeout %s\", j.Timeout)\n\t}\n\tfor name, p := range map[string]string{\"repo dir\": j.RepoDir, \"role dir\": j.RoleDir} {\n\t\tif !filepath.IsAbs(p) {\n\t\t\treturn bad(\"%s %q is not absolute\", name, p)\n\t\t}\n\t}\n\tfor name, p := range map[string]string{\"dockerfile\": j.Dockerfile} {\n\t\tif p != \"\" && !filepath.IsAbs(p) {\n\t\t\treturn bad(\"%s %q is not absolute\", name, p)\n\t\t}\n\t}\n\tif j.Sidecar != (Sidecar{}) {\n\t\tif !validRepo(j.Sidecar.Repo) {\n\t\t\treturn bad(\"sidecar repo %q\", j.Sidecar.Repo)\n\t\t}\n\t\tif err := gitref.Check(j.Sidecar.Ref); err != nil {\n\tif err != nil {\n\t\treturn h, fmt.Errorf(\"prepare %s: %w\", j.ID, err)\n\t}\n\th = executor.Handle{\n\t\tJobID: j.ID, Kind: \"host\", Issue: j.Issue, Stage: j.Stage, Role: j.Role,\n\t\tWorktree: wt, Home: home, RepoDir: j.RepoDir, BaseSHA: sha,\n\t\tLogPath: filepath.Join(logDir, base+\".log\"), StdoutPath: filepath.Join(logDir, base+\".stdout\"),\n\t\tView:    executor.Paths{Work: wt, Role: j.RoleDir},\n\t\tRoleDir: j.RoleDir, ReadOnly: j.ReadOnly,\n\t\tTrustedInput: j.TrustedInput, PreparedAt: now, Timeout: j.Timeout,\n\t}\n\tvar created []string // paths to remove on failure\n\tworktreeAdded := false\npackage agentjob\n\nimport (\n\t\"fmt\"\n\t\"path/filepath\"\n\t\"sort\"\n\n\t\"github.com/albertcbrown/ard/internal/agent\"\n\t\"github.com/albertcbrown/ard/internal/config\"\n\t\"github.com/albertcbrown/ard/internal/executor\"\n\t\"github.com/albertcbrown/ard/internal/modelauth\"\n)\n\n// Command maps an agent invocation to an executor command. It is pure. The\n// adapter must ask for exactly the credential the controller holds.\nfunc Command(ac agent.Command, cred modelauth.Credential) (executor.Command, error) {\n\tif len(ac.Argv) == 0 {\n\t\treturn executor.Command{}, fmt.Errorf(\"agent command has no argv: %w\", agent.ErrInvalidSpec)\n\t}\n\tif len(ac.PassEnv) != 1 || cred.IsZero() || ac.PassEnv[0] != cred.Name {\n\t\treturn executor.Command{}, fmt.Errorf(\"agent wants a credential other than the one set: %w\", agent.ErrInvalidSpec)\n\t}\n\tfixed := make([]string, 0, len(ac.Env))\n\tfor k, v := range ac.Env {\n\t\tfixed = append(fixed, k+\"=\"+v)\n\t}\n\tsort.Strings(fixed)\n\treturn executor.Command{Path: ac.Argv[0], Args: ac.Argv[1:], Fixed: fixed, Env: cred.Env()}, nil\n}\n\n// AgentCommand builds the agent invocation for a prepared job of the given\n//