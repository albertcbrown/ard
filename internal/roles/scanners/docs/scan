#!/bin/sh
# docs scanner: undocumented exported Go identifiers and missing package
# comments, as ard findings.
#
# Contract (see docs/proposal.md, Scanners):
#   - cwd is a read-only worktree of origin/main. This script finds its siblings
#     (docscan.go, exclude) from its own path, never from cwd or /role.
#   - Prints findings as JSON lines on stdout, and only as its very last action:
#     any failure exits non-zero with nothing on stdout, and the controller
#     discards the run. It never prints partial results.
#   - Writes nothing outside a mktemp dir that is removed on exit. HOME may be
#     unwritable. It holds no GitHub token and needs none.
#   - stderr is the job log: the Go version and the final count.
#
# docscan.go is stdlib-only and is built here with the job's own Go. It only
# parses repository files; it never runs repository code and needs no network.
# Exit codes: 0 success, 1 failure, 2 go is missing.
#
# Opt-out: a human-owned file named "exclude" next to this script lists package
# dirs to skip, one per line ("dir/" = dir and below, else a path.Match glob).
# Excluded findings vanish, so autoclose closes their issues.
set -eu

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

die() { echo "docs: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || { echo "docs: $1 not found" >&2; exit 2; }; }

need go

tmp=$(mktemp -d "${TMPDIR:-/tmp}/ard-docs.XXXXXX")
# Go's module cache is read-only on disk; make it removable first.
cleanup() { chmod -R u+w "$tmp" 2>/dev/null || true; rm -rf "$tmp"; }
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Keep Go's caches off an unwritable HOME and out of the worktree.
for v in GOCACHE GOMODCACHE GOPATH; do
  eval "cur=\${$v:-}"
  if [ -z "$cur" ] || [ ! -w "$cur" ]; then
    eval "$v=\$tmp/$v; export $v"
  fi
done
GOWORK=off GOTOOLCHAIN=local GOPROXY=off GOFLAGS= CGO_ENABLED=0
export GOWORK GOTOOLCHAIN GOPROXY GOFLAGS CGO_ENABLED

# Build from the temp dir so the target repo's go.mod is never consulted.
echo "docs: $(cd -- "$tmp" && go version)" >&2
(cd -- "$tmp" && go build -o "$tmp/docscan" "$dir/docscan.go") || die "cannot build docscan"

if [ -e "$dir/exclude" ]; then
  "$tmp/docscan" -root . -exclude "$dir/exclude" > "$tmp/out.jsonl" || die "docscan failed"
else
  "$tmp/docscan" -root . > "$tmp/out.jsonl" || die "docscan failed"
fi

echo "docs: $(wc -l < "$tmp/out.jsonl" | tr -d ' ') finding(s)" >&2
cat "$tmp/out.jsonl"
