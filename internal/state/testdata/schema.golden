CREATE INDEX events_ts ON events(ts);
CREATE INDEX jobs_cleanup ON jobs(status, cleaned_at);
CREATE INDEX jobs_issue ON jobs(issue);
CREATE UNIQUE INDEX jobs_one_running ON jobs(stage, role, issue) WHERE status = 'running';
CREATE INDEX jobs_status ON jobs(status, created_at);
CREATE TABLE admissions(
  issue INTEGER PRIMARY KEY,
  mode TEXT NOT NULL,
  reason TEXT NOT NULL,
  labeled_by TEXT,
  labeled_at INTEGER NOT NULL,
  body_hash TEXT NOT NULL,
  admitted_at INTEGER NOT NULL,
  job_id TEXT,
  regated_at INTEGER,
  regated_hash TEXT
);
CREATE TABLE attempts(
  job_id TEXT NOT NULL REFERENCES jobs(id) ON DELETE CASCADE,
  n INTEGER NOT NULL,
  started_at INTEGER NOT NULL, ended_at INTEGER,
  exit_code INTEGER, cause TEXT, transient INTEGER NOT NULL DEFAULT 0, cost_usd REAL,
  PRIMARY KEY(job_id, n));
CREATE TABLE events(
  id INTEGER PRIMARY KEY,
  ts INTEGER NOT NULL, kind TEXT NOT NULL,
  job_id TEXT, issue INTEGER, stage TEXT, role TEXT,
  data TEXT);
CREATE TABLE jobs(
  id TEXT PRIMARY KEY,
  stage TEXT NOT NULL CHECK(stage IN ('scanner','triage','worker','review')),
  role TEXT NOT NULL,
  issue INTEGER NOT NULL,
  pr INTEGER,
  status TEXT NOT NULL CHECK(status IN ('running','done','failed')),
  attempt INTEGER NOT NULL DEFAULT 0,
  handle TEXT,
  closeout_phase TEXT,
  closeout_plan TEXT,
  fail_reason TEXT,
  keep_until INTEGER,
  cleaned_at INTEGER,
  cost_usd REAL,
  created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL, ended_at INTEGER, branch TEXT, retry_of TEXT, auto_retry INTEGER NOT NULL DEFAULT 0, kill_reason TEXT, limit_stop INTEGER NOT NULL DEFAULT 0, after_limit TEXT);
CREATE TABLE meta(key TEXT PRIMARY KEY, value TEXT NOT NULL);
CREATE TABLE schema_version(
		version INTEGER PRIMARY KEY, name TEXT NOT NULL, applied_at INTEGER NOT NULL);
